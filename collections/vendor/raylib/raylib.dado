        @c("BLEND_CUSTOM_SEPARATE") CUSTOM_SEPARATE,

    enum @c("Gesture") gesture:
        @c("GESTURE_NONE") NONE,
        @c("GESTURE_TAP") TAP,
        @c("GESTURE_DOUBLETAP") DOUBLETAP,
        @c("GESTURE_HOLD") HOLD,
        @c("GESTURE_DRAG") DRAG,
        @c("GESTURE_SWIPE_RIGHT") SWIPE_RIGHT,
        @c("GESTURE_SWIPE_LEFT") SWIPE_LEFT,
        @c("GESTURE_SWIPE_UP") SWIPE_UP,
        @c("GESTURE_SWIPE_DOWN") SWIPE_DOWN,
        @c("GESTURE_PINCH_IN") PINCH_IN,
        @c("GESTURE_PINCH_OUT") PINCH_OUT,

    enum @c("CameraMode") camera_mode:
        @c("CAMERA_CUSTOM") CUSTOM,
        @c("CAMERA_FREE") FREE,
        @c("CAMERA_ORBITAL") ORBITAL,
        @c("CAMERA_FIRST_PERSON") FIRST_PERSON,
        @c("CAMERA_THIRD_PERSON") THIRD_PERSON,

    enum @c("CameraProjection") camera_projection:
        @c("CAMERA_PERSPECTIVE") PERSPECTIVE,
        @c("CAMERA_ORTHOGRAPHIC") ORTHOGRAPHIC,

    enum @c("NPatchLayout") npatch_layout:
        @c("NPATCH_NINE_PATCH") NINE_PATCH,
        @c("NPATCH_THREE_PATCH_VERTICAL") THREE_PATCH_VERTICAL,
        @c("NPATCH_THREE_PATCH_HORIZONTAL") THREE_PATCH_HORIZONTAL,

    // ── Types ─────────────────────────────────────────────────────────────
    type Vector2:
        f32 x,
        f32 y,

    type Vector3:
        f32 x,
        f32 y,
        f32 z,

    type Vector4:
        f32 x,
        f32 y,
        f32 z,
        f32 w,

    type Matrix:
        f32 m0,
        f32 m4,
        f32 m8,
        f32 m12,
        f32 m1,
        f32 m5,
        f32 m9,
        f32 m13,
        f32 m2,
        f32 m6,
        f32 m10,
        f32 m14,
        f32 m3,
        f32 m7,
        f32 m11,
        f32 m15,

    type Color:
        u8 r,
        u8 g,
        u8 b,
        u8 a,

    type Rectangle:
        f32 x,
        f32 y,
        f32 width,
        f32 height,

    type Image:
        rawptr data,
        i32    width,
        i32    height,
        i32    mipmaps,
        i32    format,

    type Texture2D:
        u32 id,
        i32 width,
        i32 height,
        i32 mipmaps,
        i32 format,

    type RenderTexture2D:
        u32       id,
        Texture2D texture,
        Texture2D depth,

    type NPatchInfo:
        Rectangle source,
        i32       left,
        i32       top,
        i32       right,
        i32       bottom,
        i32       layout,

    type GlyphInfo:
        i32   value,
        i32   offsetX,
        i32   offsetY,
        i32   advanceX,
        Image image,

    type Font:
        i32        baseSize,
        i32        glyphCount,
        i32        glyphPadding,
        Texture2D  texture,
        ^Rectangle recs,
        ^GlyphInfo glyphs,

    type Camera3D:
        Vector3 position,
        Vector3 target,
        Vector3 up,
        f32     fovy,
        i32     projection,

    type Camera2D:
        Vector2 offset,
        Vector2 target,
        f32     rotation,
        f32     zoom,

    type Mesh:
        i32  vertexCount,
        i32  triangleCount,
        ^f32 vertices,
        ^f32 texcoords,
        ^f32 texcoords2,
        ^f32 normals,
        ^f32 tangents,
        ^u8  colors,
        ^u16 indices,
        i32  boneCount,
        ^u8  boneIndices,
        ^f32 boneWeights,
        ^f32 animVertices,
        ^f32 animNormals,
        u32  vaoId,
        ^u32 vboId,

    type Shader:
        u32  id,
        ^i32 locs,

    type MaterialMap:
        Texture2D texture,
        Color     color,
        f32       value,

    type Material:
        Shader       shader,
        ^MaterialMap maps,
        [4]f32       params,

    type Transform:
        Vector3 translation,
        Vector4 rotation,
        Vector3 scale,

    type BoneInfo:
        [32]#c.char name,
        i32         parent,

    type ModelSkeleton:
        i32        boneCount,
        ^BoneInfo  bones,
        ^Transform bindPose,

    type Model:
        Matrix        transform,
        i32           meshCount,
        i32           materialCount,
        ^Mesh         meshes,
        ^Material     materials,
        ^i32          meshMaterial,
        ModelSkeleton skeleton,
        ^Transform    currentPose,
        ^Matrix       boneMatrices,

    type ModelAnimation:
        [32]#c.char name,
        i32         boneCount,
        i32         keyframeCount,
        ^^Transform keyframePoses,

    type Ray:
        Vector3 position,
        Vector3 direction,

    type RayCollision:
        bool    hit,
        f32     distance,
        Vector3 point,
        Vector3 normal,

    type BoundingBox:
        Vector3 min,
        Vector3 max,

    type Wave:
        u32    frameCount,
        u32    sampleRate,
        u32    sampleSize,
        u32    channels,
        rawptr data,

    type @incomplete rAudioBuffer
    type @incomplete rAudioProcessor
    type AudioStream:
        ^rAudioBuffer    buffer,
        ^rAudioProcessor processor,
        u32              sampleRate,
        u32              sampleSize,
        u32              channels,

    type Sound:
        AudioStream stream,
        u32         frameCount,

    type Music:
        AudioStream stream,
        u32         frameCount,
        bool        looping,
        i32         ctxType,
        rawptr      ctxData,

    type VrDeviceInfo:
        i32    hResolution,
        i32    vResolution,
        f32    hScreenSize,
        f32    vScreenSize,
        f32    eyeToScreenDistance,
        f32    lensSeparationDistance,
        f32    interpupillaryDistance,
        [4]f32 lensDistortionValues,
        [4]f32 chromaAbCorrection,

    type VrStereoConfig:
        [2]Matrix projection,
        [2]Matrix viewOffset,
        [2]f32    leftLensCenter,
        [2]f32    rightLensCenter,
        [2]f32    leftScreenCenter,
        [2]f32    rightScreenCenter,
        [2]f32    scale,
        [2]f32    scaleIn,

    type FilePathList:
        u32       count,
        ^^#c.char paths,

    type AutomationEvent:
        u32            frame,
        u32 @c("type") type_,
        [4]i32         params,

    type AutomationEventList:
        u32              capacity,
        u32              count,
        ^AutomationEvent events,

