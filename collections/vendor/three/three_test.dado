@test
package three

// The generated wrappers over three's math and scene graph; no DOM, so it runs
// natively and on the web.
class ThreeCheck:
    int ready():
        Vector3 a = Vector3(1.0, 2.0, 3.0)
        Vector3 same = a.add(Vector3(1.0, 1.0, 1.0))
        assert same.x() == 2.0 && a.z() == 4.0, "add is in place and answers its receiver"
        Mesh m = Mesh(BoxGeometry(1.0, 1.0, 1.0), MeshStandardMaterial({"roughness": 0.25}))
        m.position().set_y(2.0)
        assert m.position().y() == 2.0, "position() wraps the live vector"
        Scene s = Scene()
        s.add(m)
        assert m.has_parent() && m.parent().uuid() == s.uuid(), "parent() adopts the scene"
        assert s.children().len() == 1, "children() wraps each child"
        bool kept = globalThis.Object.is(s.children()[0], m)
        assert kept, "an object three answers is the wrapper that made it"
        bool once = globalThis.Object.is(m.position(), m.position())
        assert once, "an adopted object keeps its wrapper"
        Color c = Color(1.0, 0.0, 0.0)
        assert c.getHexString() == "ff0000", "Color(r, g, b)"
        assert PCFShadowMap() == 1, "constants are Dado functions"
        return 0

i32 test():
    try VM vm = #script_vm() else:
        return 1
    try ThreeCheck t = #script_new(vm, ThreeCheck) else:
        return 2
    return i32(#script_run(t))
