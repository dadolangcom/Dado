@test
// Where the library allocates, and what it answers when that fails.
//
//   * `open_headless` keeps the `#default` it sees: under an allocator that
//     refuses everything it still opens (nothing is allocated yet), a frame
//     whose grid cannot be allocated is skipped rather than drawn on nothing,
//     and `snapshot` then answers an empty frame;
//   * `snapshot` answers `nil` when its own allocation fails;
//   * `log_open` under a refusing allocator answers a log that takes nothing;
//   * with a working allocator, all three do their job and the snapshot is
//     the caller's to `#delete`.
package tui

import "core:strings"

// An allocator that refuses everything.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

private i32 ran = 0

private void frame():
    ran += 1
    text("hello")

i32 test():
    bool ok = true

    // A UI over a refusing allocator: opens, skips its frame, closes.
    bool opened = open_headless(12, 3) using (refuses, nil)
    ok = #expect(opened, "a headless open allocates nothing, so it does not fail") && ok
    compose(frame)
    ok = #expect(ran == 0, "a frame ran with no grid to draw on") && ok
    ref []char8 blank = snapshot()
    ok = #expect(blank != nil && #len(blank) == 0, "a frame never drawn is not an empty snapshot") && ok
    #delete(blank)
    close()

    // A working UI: the frame runs, and the snapshot is the caller's.
    ok = #expect(open_headless(12, 3, 0), "headless open") && ok
    compose(frame)
    ok = #expect(ran == 1, "the frame did not run") && ok
    ref []char8 refused = snapshot() using (refuses, nil)
    ok = #expect(refused == nil, "snapshot under a refusing allocator is not nil") && ok
    ref []char8 shot = snapshot()
    string8 seen = shot
    ok = #expect(strings.starts_with(seen, "hello"), "the snapshot does not start with the frame's text: ", seen) && ok
    ok = #expect(strings.count(seen, "\n") == 3, "the snapshot is not 3 lines") && ok
    #delete(shot)
    close()

    // A log that could not allocate takes nothing; one that could keeps lines.
    Log dead = log_open() using (refuses, nil)
    log_say(&dead, "dropped")
    log_feed(&dead, Bytes("also dropped\n"))
    ok = #expect(log_lines(dead) == 0, "a log with no storage kept a line") && ok
    log_close(&dead)

    Log live = log_open(budget: 64)
    log_say(&live, "one")
    log_feed(&live, Bytes("two\nthr"))
    log_feed(&live, Bytes("ee\n"))
    ok = #expect(log_lines(live) == 3, "the log does not hold 3 lines: ", log_lines(live)) && ok
    ok = #expect(log_at(&live, 2) == "three", "a line split across two feeds is not whole: ", log_at(&live, 2)) && ok
    ok = #expect(log_at(&live, 3) == "", "a line past the end is not empty") && ok
    log_clear(&live)
    ok = #expect(log_lines(live) == 0, "log_clear left lines") && ok
    log_close(&live)

    if ok: return 0
    return 1
