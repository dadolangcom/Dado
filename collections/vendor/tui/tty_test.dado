@test
// The platform arm with no terminal: what `tty.dado` answers when the test is
// run with its streams on pipes, as every harness runs it. A real terminal is
// the pty harness's to drive; this is the half that runs headless, on every
// OS, Wine included.
//
//   * **No terminal is an answer, not a failure.** `is_terminal` is false,
//     `open` refuses, `tty_raw(1)` is -1 and changes nothing, and
//     `tty_raw(0)` with nothing saved is a no-op.
//   * **The size falls back to 80x24** when the output is no terminal, and a
//     second reading of an unchanged size says so.
//   * **On Windows, a console's UTF-16 reaches the decoder as UTF-8**,
//     including a surrogate pair whose halves arrive in two reads.
package tui

i32 test():
    bool ok = true
    bool terminal = tty_is_terminal() != 0
    if !terminal:
        ok = #expect(!is_terminal(), "is_terminal() disagreed with tty_is_terminal()") && ok
        ok = #expect(!open(), "open() succeeded with no terminal") && ok
        ok = #expect(tty_raw(1) == 0 - 1, "tty_raw(1) succeeded with no terminal") && ok
        ok = #expect(tty_raw(0) == 0, "tty_raw(0) with nothing saved was not a no-op") && ok

    _ = tty_measure()
    ok = #expect(tty_cols() > 0 && tty_rows() > 0, "the size read ", tty_cols(), "x", tty_rows()) && ok
    ok = #expect(tty_measure() == 0, "an unchanged size was reported as a change") && ok
    if !output_is_terminal():
        ok = #expect(tty_cols() == 80 && tty_rows() == 24, "no terminal measured ", tty_cols(), "x", tty_rows(), ", not 80x24") && ok

    ok = platform_checks() && ok
    if ok: return 0
    return 1

when #OS == #WINDOWS:
    private bool output_is_terminal():
        rawptr out = tty_handle(STD_OUTPUT_HANDLE)
        #c.ulong mode = 0
        return out != nil && GetConsoleMode(out, &mode) != 0

    private bool utf8_is(u16 unit, []u8 want):
        [8]#c.char bytes
        i32 n = tty_utf8(unit, &bytes[0], 8)
        bool same = i64(n) == #len(want)
        for i in 0..<#len(want):
            if same && u8(#c.uchar(bytes[i])) != want[i]: same = false
        return #expect(same, "U+", u32(unit), " converted to ", n, " bytes, not ", #len(want))

    private bool platform_checks():
        bool ok = true
        [8]u8 want
        want[0] = 0x41
        ok = utf8_is(0x41, want[0..<1]) && ok
        want[0] = 0xC3
        want[1] = 0xA9
        ok = utf8_is(0xE9, want[0..<2]) && ok
        want[0] = 0xE2
        want[1] = 0x82
        want[2] = 0xAC
        ok = utf8_is(0x20AC, want[0..<3]) && ok
        // U+1F600, as the two records a console delivers it in: the high
        // half alone writes nothing, and the low half writes all four bytes.
        ok = utf8_is(0xD83D, want[0..<0]) && ok
        want[0] = 0xF0
        want[1] = 0x9F
        want[2] = 0x98
        want[3] = 0x80
        ok = utf8_is(0xDE00, want[0..<4]) && ok
        // A low half with no high half before it is dropped.
        ok = utf8_is(0xDE00, want[0..<0]) && ok
        // Too little room is -1, and nothing is held back.
        [2]#c.char small
        ok = #expect(tty_utf8(0x20AC, &small[0], 2) == 0 - 1, "a three-byte character fit in two") && ok

        // No console: the timed read refuses rather than blocking.
        if tty_is_terminal() == 0:
            [16]u8 buf
            ok = #expect(tty_read(rawptr(&buf[0]), 16, 10) == 0 - 2, "tty_read on no console did not refuse") && ok
        // No job control: stopping returns, and nothing was continued.
        tty_stop()
        ok = #expect(tty_continued_since() == 0, "a stop was continued on Windows") && ok
        return ok
else:
    private bool output_is_terminal():
        return isatty(STDOUT_FILENO) != 0

    private bool platform_checks():
        return #expect(tty_continued_since() == 0, "a SIGCONT was reported with none sent")
