@test
package tui

import "core:fmt"

// Compose a frame with no terminal and look at it. This is the whole point of
// the compositor writing to a `Sink` and of `open_headless` existing.

private bool on = true
private i32 which = 1

private void demo():
    title("vendor:tui")
    for row(height: 1):
        text("left")
        align(RIGHT)
        text("right")
    for panel(title: "Options", height: 7):
        checkbox("release", &on)
        radio("O2", &which, 2)
        rule()
        kv("clicks", i32(41))

i32 test():
    bool ok = true
    ok = #expect(open_headless(44, 16), "headless open") && ok
    compose(demo)
    string8 shot = snapshot(#heap)
    fmt.println(shot)
    close()
    if ok: return 0
    return 1
