@test
// The colour depths, as the bytes a terminal is sent. One frame of copper
// text on a dark ground is composed headless and presented into a buffer at
// each depth:
//
//   * **24-bit** writes `38;2;r;g;b`;
//   * **256** writes `38;5;n`, never `38;2`;
//   * **16** writes only the basic SGR numbers (30–37, 90–97, 40–47,
//     100–107), never `38;` or `48;` — what a `TERM=xterm` or a Linux
//     console can parse;
//   * **none** writes no colour at all, and still writes the bold;
//   * a palette index below 16 goes out as its basic number at every depth.
//
// And every presented frame left in one write, which is the counter
// `frame_output` keeps.
package tui

import "core:fmt"
import "core:strings"

private void copper():
    text(s: "Dado", color: hex(0xE58B57), attr: Attr.BOLD)
    text(s: "slate", color: ansi(8))

private (bool ok, string8 bytes) frame_at(i32 depth):
    ref []char8 run = #make([]char8, 0, #heap)
    sink(fmt.to_run(&run))
    colors(depth)
    compose(copper)
    present()
    (i32 _, i32 writes) = frame_output()
    string8 got = run
    return (writes == 1, got)

// Whether `b` holds an SGR sequence that is one colour number: 30–49 or
// 90–107. A cursor move (`\x1b[3;1H`) is not one, which is why this reads
// the number to its final byte instead of matching a prefix.
private bool basic_colour(string8 b):
    i64 n = #len(b)
    i64 i = 0
    for i + 2 < n:
        if b[i] == '\x1b' && b[i + 1] == '[':
            i64 j = i + 2
            i32 v = 0
            for j < n && b[j] >= '0' && b[j] <= '9':
                v = (v * 10) + (i32(b[j]) - i32('0'))
                j = j + 1
            if j < n && b[j] == 'm' && j > i + 2:
                if (v >= 30 && v <= 49) || (v >= 90 && v <= 107): return true
            i = j
            continue
        i = i + 1
    return false

i32 test():
    bool ok = true
    ok = #expect(open_headless(20, 4), "headless open") && ok
    (bool one24, string8 b24) = frame_at(COLORS_TRUE)
    ok = #expect(one24, "a 24-bit frame was not one write") && ok
    ok = #expect(strings.contains(b24, "38;2;229;139;87"), "24-bit copper is not 38;2;229;139;87") && ok

    (bool one256, string8 b256) = frame_at(COLORS_256)
    ok = #expect(one256, "a 256-colour frame was not one write") && ok
    ok = #expect(!strings.contains(b256, ";2;"), "a 256-colour frame wrote a 24-bit colour") && ok
    ok = #expect(strings.contains(b256, "38;5;"), "a 256-colour frame wrote no 38;5;") && ok
    ok = #expect(strings.contains(b256, "\x1b[90m"), "ansi(8) did not go out as 90 at 256 colours") && ok

    (bool one16, string8 b16) = frame_at(COLORS_16)
    ok = #expect(one16, "a 16-colour frame was not one write") && ok
    ok = #expect(!strings.contains(b16, "38;") && !strings.contains(b16, "48;"), "a 16-colour frame wrote an extended colour") && ok
    ok = #expect(strings.contains(b16, "\x1b[93m") || strings.contains(b16, "\x1b[33m") || strings.contains(b16, "\x1b[91m") || strings.contains(b16, "\x1b[31m"), "copper did not land on a warm basic colour") && ok

    (bool one0, string8 b0) = frame_at(COLORS_NONE)
    ok = #expect(one0, "a colourless frame was not one write") && ok
    ok = #expect(!strings.contains(b0, "38;") && !strings.contains(b0, "48;") && !basic_colour(b0), "a colourless frame wrote a colour") && ok
    ok = #expect(strings.contains(b0, "\x1b[1m"), "a colourless frame lost the bold") && ok

    ok = #expect(mix(ansi(0), ansi(3), 16) == ansi(0), "a palette hover tint did not stay on the ground") && ok
    ok = #expect(mix(ansi(0), ansi(3), 40) == ansi(3), "a palette selection tint did not take the accent") && ok
    close()
    if ok: return 0
    return 1
