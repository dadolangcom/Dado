// vendor:tui — the widgets.
//
// Every one of them answers `bool`, and it means **activated or changed on
// this frame**. One rule, which is what makes the idiom one line:
//
//     if tui.button("Save"): save()
//
// Everything else a caller might want to know is a question about the widget
// just placed — `hovered()`, `focused()`, `rect_of()` — which keeps that one
// line intact instead of widening every return into a tuple.
package tui

import "core:chars"
import "core:fmt"

// ── what the last widget did ───────────────────────────────────────────────

private Rect g_last
private bool g_last_hot
private bool g_last_focus

Rect rect_of():
    return g_last

bool hovered():
    return g_last_hot

bool focused():
    return g_last_focus

// Was the last widget placed clicked on this frame? The companion to
// `hovered()`, for making a whole row or a whole cell a hit target without
// giving it a control of its own.
bool clicked():
    return clicked_in(g_last)

private void record(Rect r, bool hot, bool foc):
    g_last = r
    g_last_hot = hot
    g_last_focus = foc

// A widget answered `true`. Anything the frame drew *before* it is showing the
// value from before it fired — which is inherent to immediate mode and is
// exactly one frame of lag. So ask for one more frame: the correction lands in
// milliseconds and nobody ever sees the stale value.
private void acted():
    g_dirty = true

// ── static ─────────────────────────────────────────────────────────────────

private Style body():
    return (g_theme.text, surface_here(), Attr.NONE)

// The background a widget sits on: the innermost enclosing region that painted
// one, and the window's own otherwise.
//
// It is a *walk* and not a flag because backgrounds nest — a table row inside a
// panel inside the window — and a widget that guesses "panel surface" paints
// over the row it is in. Getting this wrong is what makes a zebra stripe have
// holes in it exactly where the text is.
private Color surface_here():
    for d in 0..<(g_depth + 1):
        Region r = g_stack[g_depth - d]
        if r.has_bg: return r.bg
    return g_theme.base

// One line of text, clipped to the region.
//
// `anchor` is where the text sits *within its own cell*, which is a different
// question from `align`'s — that one decides where the cell goes. A number in a
// table column wants `END` and the column still wants `START`, and there is no
// way to say that with one control.
void text(string8 s, Color color = DEFAULT, Attr attr = Attr.NONE, Anchor anchor = Anchor.START):
    i32 nat = measure(s)
    Rect r = place(FLOW, 1, nat, 1)
    if empty(r): return
    Color fg = color
    if is_default(fg): fg = g_theme.text
    Style st = (fg, surface_here(), attr)
    i32 pad = 0
    if anchor == Anchor.END: pad = r.w - nat
    else if anchor == Anchor.MIDDLE: pad = (r.w - nat) / 2
    if pad < 0: pad = 0
    fill_rect(r, st)
    _ = draw_text(r.x + pad, r.y, s, st, r.w - pad)
    record(r, hovering(r), false)

// A heading. Bold, in the theme's loudest text, with a blank line under it —
// the spacing is the point: a title that touches the thing below it does not
// read as a title.
void title(string8 s):
    text(s, g_theme.text, Attr.BOLD)
    space(1)

// Quieter than `text`. Captions, units, the second half of a sentence.
void label(string8 s):
    text(s, g_theme.subtext, Attr.NONE)

void muted(string8 s):
    text(s, g_theme.muted, Attr.NONE)

// Word-wrapped to the region's width. Answers how many rows it took.
i32 paragraph(string8 s, Color color = DEFAULT):
    Rect box = available()
    if empty(box): return 0
    Color fg = color
    if is_default(fg): fg = g_theme.subtext
    Style st = (fg, surface_here(), Attr.NONE)

    i32 n = i32(#len(s))
    i32 at = 0
    i32 rows_used = 0
    for at < n:
        (i32 cut, i32 next) = wrap_point(s, at, box.w)
        if cut <= at && next <= at: break
        Rect line = place(FLOW, 1, box.w, 1)
        if empty(line): break
        _ = draw_text_fill(line.x, line.y, s[at..<cut], st, line.w)
        rows_used = rows_used + 1
        at = next
    return rows_used

// Where the next line ends, and where the one after it starts. Breaks on a
// space when there is one and mid-word when there is not, because a word wider
// than the box has to break somewhere and refusing to draw it is worse.
private (i32 cut, i32 next) wrap_point(string8 s, i32 from, i32 width):
    i32 n = i32(#len(s))
    i32 at = from
    i32 used = 0
    i32 last_space = 0 - 1
    for at < n:
        char8 c = s[at]
        if c == '\n': return (at, at + 1)
        if c == ' ': last_space = at
        i32 step = 1
        i32 w = 1
        if u32(c) >= 0x80:
            (char32 cp, i32 size) = chars.decode(s, at)
            step = size
            w = chars.width(cp)
        if used + w > width:
            if last_space > from: return (last_space, last_space + 1)
            if at == from: return (at + step, at + step)
            return (at, at)
        used = used + w
        at = at + step
    return (n, n)

// An aligned key/value line: the key in the quiet text colour, a run of dots,
// the value against the right edge. Generic over the value, so anything Dado
// can render goes here with no conversion written.
//
//     tui.kv("target", triple)
//     tui.kv("ratio", 0.75)
//     tui.kv("size", (w, h))
//
// This is the answer to "there is no string interpolation": you rarely need
// one, because the renderer already knows how to write every type.
void kv(string8 key, $T value):
    kv_text(key, #format(value, mem))

// The same, when the value is already a string.
void kv_text(string8 key, string8 value):
    Rect r = place(FLOW, 1, measure(key) + measure(value) + 3, 1)
    if empty(r): return
    Color bg = surface_here()
    i32 kw = draw_text(r.x, r.y, key, (g_theme.subtext, bg, Attr.NONE), r.w)
    i32 vw = measure(value)
    if kw + vw + 2 > r.w:
        // No room for the leader: the value still wins the right edge.
        i32 room = r.w - kw - 1
        if room > 0:
            _ = draw_text(r.x + r.w - room, r.y, value, (g_theme.text, bg, Attr.NONE), room)
        record(r, hovering(r), false)
        return
    // A leader, not a run of spaces: the eye needs something to travel along
    // for the value at the far end to read as belonging to the key.
    i32 dots = r.w - kw - vw - 2
    for i in 0..<dots:
        u32 g = 32
        if (i % 2) == 1: g = 0x00B7        // MIDDLE DOT
        put_cell(r.x + kw + 1 + i, r.y, g, (g_theme.faint, bg, Attr.NONE), false)
    _ = draw_text(r.x + r.w - vw, r.y, value, (g_theme.text, bg, Attr.NONE), vw)
    record(r, hovering(r), false)

// A key/value line whose value is a number written to a fixed number of
// decimals. `kv` renders a float in full, which is right for a value and wrong
// for a dashboard: `1.06493` where `1.06` was meant is five characters of
// noise that move every frame.
void kv_float(string8 key, $T value, i32 decimals = 2) where T is float:
    ref []char8 run = #make([]char8, 0, mem)
    if run == nil: return
    Sink into = fmt.to_run(&run)
    _ = fmt.put_float(value, decimals, into)
    kv_text(key, run)

// A pill. Reads as a status rather than as a word, which is what a colour on
// its own does not manage.
void badge(string8 s, Color color = DEFAULT):
    Color c = color
    if is_default(c): c = g_theme.accent
    i32 nat = measure(s) + 2
    Rect r = place(nat, 1, nat, 1)
    if empty(r): return
    // The text on a badge is the *base*, not the theme's text colour: a pill
    // is a solid of its colour and the label is punched out of it.
    Style st = (g_theme.base, c, Attr.BOLD)
    put_cell(r.x, r.y, 32, st, false)
    i32 used = draw_text(r.x + 1, r.y, s, st, r.w - 2)
    put_cell(r.x + 1 + used, r.y, 32, st, false)
    record(r, hovering(r), false)

// A badge for a state that is not news: the surface ramp rather than a hue,
// so an idle status does not shout as loudly as a failing one.
void badge_quiet(string8 s):
    Color c = mix(g_theme.overlay, g_theme.text, 16)
    i32 nat = measure(s) + 2
    Rect r = place(nat, 1, nat, 1)
    if empty(r): return
    Style st = (g_theme.muted, c, Attr.NONE)
    put_cell(r.x, r.y, 32, st, false)
    i32 used = draw_text(r.x + 1, r.y, s, st, r.w - 2)
    put_cell(r.x + 1 + used, r.y, 32, st, false)
    record(r, hovering(r), false)

// A status pip. Two cells: the dot and the space after it, so a row of them
// lines up whether or not each has a label.
void dot(Color color):
    Rect r = place(2, 1, 2, 1)
    if empty(r): return
    Style st = (color, surface_here(), Attr.NONE)
    draw_glyph(r.x, r.y, marker_dot(), st)
    put_cell(r.x + 1, r.y, 32, (g_theme.text, surface_here(), Attr.NONE), false)
    record(r, hovering(r), false)

private string8 marker_dot():
    if g_theme.wide_glyphs: return "●"
    return "*"

// ── indicators ─────────────────────────────────────────────────────────────

private const [10]string8 SPIN_WIDE = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
private const [4]string8 SPIN_ASCII = ["|", "/", "-", "\\"]

// A spinner, optionally captioned. Registers an animation, so the loop stops
// sleeping while one is on screen and goes back to sleeping when it is not.
void spinner(string8 caption = ""):
    animate()
    i32 nat = 2 + measure(caption)
    Rect r = place(FLOW, 1, nat, 1)
    if empty(r): return
    Color bg = surface_here()
    string8 g = SPIN_ASCII[anim_frame(clock(), 8.0, 4)]
    if g_theme.wide_glyphs: g = SPIN_WIDE[anim_frame(clock(), 12.0, 10)]
    draw_glyph(r.x, r.y, g, (g_theme.accent, bg, Attr.NONE))
    if #len(caption) > 0:
        _ = draw_text_fill(r.x + 2, r.y, caption, (g_theme.subtext, bg, Attr.NONE), r.w - 2)
    record(r, false, false)

private const [8]string8 BAR_EIGHTHS = ["", "▏", "▎", "▍", "▌", "▋", "▊", "▉"]

// A progress bar. Sub-cell resolution when the theme allows wide glyphs, which
// is the difference between a bar that moves smoothly and one that jumps a
// whole column at a time.
void progress(f32 value, string8 caption = "", i32 width = REST):
    f32 v = value
    if v < 0.0: v = 0.0
    if v > 1.0: v = 1.0
    Rect r = place(width, 1, 20, 1)
    if empty(r): return
    Color bg = surface_here()

    i32 track = r.w
    i32 capw = 0
    if #len(caption) > 0:
        capw = measure(caption) + 1
        track = r.w - capw
    if track < 1: return

    f32 exact = f32(track) * v
    i32 whole = i32(exact)
    i32 eighth = i32((exact - f32(whole)) * 8.0)

    // The empty part of the track is a *block* in a dim colour, not a rule.
    // A `─` reads as a separator and makes the bar look like a line with a
    // coloured stub on it; a dim block reads as the trough the fill sits in.
    Color trough = mix(g_theme.surface, g_theme.faint, 110)
    for i in 0..<track:
        if i < whole:
            draw_glyph(r.x + i, r.y, "█", (g_theme.accent, bg, Attr.NONE))
        else if i == whole && eighth > 0 && g_theme.wide_glyphs:
            // The partial cell is the accent *over* the trough, so the bar has
            // no gap in it at any fraction.
            draw_glyph(r.x + i, r.y, BAR_EIGHTHS[eighth], (g_theme.accent, trough, Attr.NONE))
        else:
            draw_glyph(r.x + i, r.y, "█", (trough, bg, Attr.NONE))
    if capw > 0:
        _ = draw_text(r.x + track + 1, r.y, caption, (g_theme.subtext, bg, Attr.NONE), capw)
    record(r, hovering(r), false)

// ── controls ───────────────────────────────────────────────────────────────

// A button. `true` on the frame it is activated, by a click or by Enter or
// Space while it has focus.
bool button(string8 label, i32 width = AUTO, bool enabled = true, string8 hint = ""):
    u32 id = slot_id(label)
    i32 nat = measure(label) + 4
    Rect r = place(width, 1, nat, 1)
    if empty(r): return false
    if enabled: register_focus(id, false)

    bool hot = hovering(r)
    bool foc = enabled && has_focus(id)
    bool fired = false
    if enabled:
        if clicked_in(r):
            take_focus(id)
            fired = true
        if foc && (key("enter") || key("space")): fired = true

    // A button has to read as a raised, pressable thing on its own — one step
    // of surface is not enough, so the idle state is `overlay` lifted toward
    // the text colour, and the ends are half-blocks in the *panel's*
    // background, which is what gives it rounded caps a terminal cannot draw.
    Color bg = mix(g_theme.overlay, g_theme.text, 22)
    Color fg = g_theme.text
    Attr at = Attr.NONE
    if !enabled:
        bg = mix(g_theme.surface, g_theme.text, 8)
        fg = g_theme.faint
    else if foc:
        bg = g_theme.accent
        fg = g_theme.on_accent
        at = Attr.BOLD
    else if hot:
        bg = mix(g_theme.overlay, g_theme.accent, 55)

    Color under = surface_here()
    fill_rect(r, (fg, bg, at))
    if g_theme.wide_glyphs && r.w >= 3:
        put_cell(r.x, r.y, 0x0000E2B4, (under, under, Attr.NONE), false)
        draw_glyph(r.x, r.y, "▐", (bg, under, Attr.NONE))
        draw_glyph(r.x + r.w - 1, r.y, "▌", (bg, under, Attr.NONE))
    i32 tw = measure(label)
    i32 pad = (r.w - tw) / 2
    if pad < 0: pad = 0
    _ = draw_text(r.x + pad, r.y, label, (fg, bg, at), r.w - pad)
    record(r, hot, foc)
    if #len(hint) > 0: note_hint(hint, label)
    if fired: acted()
    return fired

// A checkbox. `on` is yours; the answer is whether it changed on this frame.
bool checkbox(string8 label, ^bool on):
    u32 id = slot_id(label)
    i32 nat = 4 + measure(label)
    Rect r = place(FLOW, 1, nat, 1)
    if empty(r): return false
    register_focus(id, false)

    bool hot = hovering(r)
    bool foc = has_focus(id)
    bool changed = false
    if clicked_in(r):
        take_focus(id)
        changed = true
    if foc && (key("space") || key("enter")): changed = true
    if changed: on^ = !on^

    Color bg = surface_here()
    if hot: bg = mix(bg, g_theme.accent, 18)
    if foc: bg = mix(bg, g_theme.accent, 28)
    fill_rect(r, (g_theme.text, bg, Attr.NONE))

    Color mark = g_theme.faint
    string8 glyph = " "
    if on^:
        mark = g_theme.accent
        glyph = check_glyph()
    draw_glyph(r.x, r.y, "[", (g_theme.faint, bg, Attr.NONE))
    draw_glyph(r.x + 1, r.y, glyph, (mark, bg, Attr.NONE))
    draw_glyph(r.x + 2, r.y, "]", (g_theme.faint, bg, Attr.NONE))
    Color fg = g_theme.text
    if !on^: fg = g_theme.subtext
    _ = draw_text(r.x + 4, r.y, label, (fg, bg, Attr.NONE), r.w - 4)
    record(r, hot, foc)
    if changed: acted()
    return changed

private string8 check_glyph():
    if g_theme.wide_glyphs: return "✓"
    return "x"

// One of a set. `choice` is yours and holds the selected `value`.
bool radio(string8 label, ^i32 choice, i32 value):
    u32 id = slot_id(label)
    i32 nat = 4 + measure(label)
    Rect r = place(FLOW, 1, nat, 1)
    if empty(r): return false
    register_focus(id, false)

    bool hot = hovering(r)
    bool foc = has_focus(id)
    bool fired = false
    if clicked_in(r):
        take_focus(id)
        fired = true
    if foc && (key("space") || key("enter")): fired = true
    if fired: choice^ = value

    bool on = choice^ == value
    Color bg = surface_here()
    if hot: bg = mix(bg, g_theme.accent, 18)
    if foc: bg = mix(bg, g_theme.accent, 28)
    fill_rect(r, (g_theme.text, bg, Attr.NONE))

    string8 glyph = " "
    Color mark = g_theme.faint
    if on:
        glyph = radio_glyph()
        mark = g_theme.accent
    draw_glyph(r.x, r.y, "(", (g_theme.faint, bg, Attr.NONE))
    draw_glyph(r.x + 1, r.y, glyph, (mark, bg, Attr.NONE))
    draw_glyph(r.x + 2, r.y, ")", (g_theme.faint, bg, Attr.NONE))
    Color fg = g_theme.text
    if !on: fg = g_theme.subtext
    _ = draw_text(r.x + 4, r.y, label, (fg, bg, Attr.NONE), r.w - 4)
    record(r, hot, foc)
    if fired: acted()
    return fired

private string8 radio_glyph():
    if g_theme.wide_glyphs: return "●"
    return "*"

// ── the hints bar ──────────────────────────────────────────────────────────

private void note_hint(string8 spec, string8 describe):
    if g_nhints >= MAX_HINTS: return
    g_hint_key[g_nhints] = spec
    g_hint_what[g_nhints] = describe
    g_nhints = g_nhints + 1

// Every binding registered this frame, along one row. A program that binds its
// keys gets its own help bar, and the bar cannot drift from the bindings
// because it is made out of them.
void hints():
    Rect r = place(FLOW, 1, 0, 1)
    if empty(r): return
    Color bg = g_theme.mantle
    fill_rect(r, (g_theme.muted, bg, Attr.NONE))
    i32 at = 0
    for i in 0..<g_nhints:
        string8 k = g_hint_key[i]
        string8 w = g_hint_what[i]
        i32 need = measure(k) + measure(w) + 3
        if at + need > r.w: break
        at = at + draw_text(r.x + at, r.y, k, (g_theme.accent, bg, Attr.BOLD), r.w - at)
        at = at + 1
        at = at + draw_text(r.x + at, r.y, w, (g_theme.muted, bg, Attr.NONE), r.w - at)
        at = at + 2
    record(r, false, false)
