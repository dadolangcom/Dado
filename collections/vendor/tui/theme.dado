// vendor:tui — colour, attributes, style and themes.
//
// The opinion this file exists to hold: **a terminal UI looks shoddy for two
// reasons, and both are palette decisions rather than layout ones.** Flat
// surfaces, because everything sits on one background and nothing reads as
// raised. And loud idle borders, because a box drawn in white shouts as
// loudly as the text inside it.
//
// So a theme here is not a foreground and a background. It is two ramps:
//
//   * a **surface ramp** — base, mantle, surface, overlay — four steps of
//     "how raised is this", so a panel on a panel is visible without a border
//     doing the work;
//   * a **text ramp** — text, subtext, muted, faint — four steps of "how much
//     does this matter", which is what lets a dense screen stay legible.
//
// Plus one accent, its readable counterpart, and four semantic colours. Idle
// borders come out of the *surface* ramp and are meant to be barely there; the
// focused border is the accent, and that contrast is the whole focus
// indicator.
package tui

// ── colour ─────────────────────────────────────────────────────────────────
//
// One `u32`, tagged so it cannot be confused with a number, carrying three
// possible kinds in its top byte:
//
//     0x00_000000   the terminal's own default
//     0x01_0000ii   a 256-colour palette index
//     0x02_rrggbb   24-bit truecolour
//
// A program writes `rgb`/`hex`/`ansi` and never sees the encoding. The
// compositor downgrades truecolour to the nearest palette index when the
// terminal cannot do better, so no program writes that branch.
distinct type Color: u32

private const u32 KIND_MASK = 0x0F000000
private const u32 KIND_NONE = 0x00000000
private const u32 KIND_ANSI = 0x01000000
private const u32 KIND_RGB = 0x02000000
// The same bit, spelled for the theme tables below. A `const` folds and a call
// does not, so a theme's colours are written `Color(RGB | 0x89B4FA)` rather
// than `hex(0x89B4FA)` — the one place in the library where the encoding shows,
// and the price of the palette being a compile-time constant.
const u32 RGB = 0x02000000
private const u32 VALUE_MASK = 0x00FFFFFF

// The terminal's own foreground or background — whatever the user configured.
// Distinct from any explicit colour: it is what `\x1b[39m` and `\x1b[49m` mean.
const Color DEFAULT = Color(KIND_NONE)

// A 24-bit colour from three components.
Color rgb(u32 r, u32 g, u32 b):
    return Color(KIND_RGB | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF))

// A 24-bit colour written the way a designer writes one: `hex(0x89B4FA)`.
Color hex(u32 v):
    return Color(KIND_RGB | (v & VALUE_MASK))

// A 256-colour palette index. 0..7 are the terminal's own eight, 8..15 their
// bright forms, 16..231 the cube, 232..255 the greyscale ramp — so a theme
// that wants to inherit the user's terminal colours uses these.
Color ansi(u32 i):
    return Color(KIND_ANSI | (i & 0xFF))

bool is_default(Color c):
    return (u32(c) & KIND_MASK) == KIND_NONE

private bool is_rgb(Color c):
    return (u32(c) & KIND_MASK) == KIND_RGB

// Blend two colours, `t` in 0..255 parts of `b`. Used for the surface ramp's
// hover and selection tints, so a theme states four surfaces and gets the
// in-between states for free rather than naming twelve.
//
// Two palette colours cannot be blended, so the blend is whichever side
// dominates — with the line drawn at 24 parts, not at half: below it the
// widgets ask for a hover hint, and at or above it for a selection or a focus
// tint, which on a 16-colour theme must still show.
Color mix(Color a, Color b, u32 t):
    if !is_rgb(a) || !is_rgb(b):
        if t < 24: return a
        return b
    u32 av = u32(a)
    u32 bv = u32(b)
    u32 inv = 255 - t
    u32 r = ((((av >> 16) & 0xFF) * inv) + (((bv >> 16) & 0xFF) * t)) / 255
    u32 g = ((((av >> 8) & 0xFF) * inv) + (((bv >> 8) & 0xFF) * t)) / 255
    u32 bl = (((av & 0xFF) * inv) + ((bv & 0xFF) * t)) / 255
    return rgb(r, g, bl)

// ── attributes ─────────────────────────────────────────────────────────────
//
// A flag set needs no new mechanism: a `distinct enum` inherits its backing
// type's operators within its own tag, so `Attr.BOLD | Attr.DIM` is an `Attr`
// and `at & Attr.BOLD` is the test.
distinct enum u16 Attr: (
    NONE = 0,
    BOLD = 1,
    DIM = 2,
    ITALIC = 4,
    UNDER = 8,
    BLINK = 16,
    REVERSE = 32,
    STRIKE = 64,
)

bool has_attr(Attr set, Attr one):
    return (set & one) != Attr.NONE

// ── style ──────────────────────────────────────────────────────────────────
//
// What a cell is painted with. A widget rarely writes one: it asks the theme.
type Style: (
    Color fg,
    Color bg,
    Attr attr,
)

const Style PLAIN = (DEFAULT, DEFAULT, Attr.NONE)

Style styled(Color fg, Color bg = DEFAULT, Attr attr = Attr.NONE):
    return (fg, bg, attr)

// ── borders ────────────────────────────────────────────────────────────────
//
// Eleven glyphs, because a border that can only draw a rectangle cannot draw a
// table, and a table drawn out of two different vocabularies looks like two
// programs. The tees and the cross are here so `panel`, `rule` and `table`
// share one line weight.
type BorderSet: (
    string8 tl, string8 tr, string8 bl, string8 br,
    string8 h, string8 v,
    string8 ltee, string8 rtee, string8 ttee, string8 btee, string8 cross,
)

// Rounded corners, light weight. The default, because a 1px-looking box with
// soft corners is the single cheapest thing that makes a terminal UI read as
// designed rather than as output.
const BorderSet ROUND = ("╭", "╮", "╰", "╯", "─", "│", "├", "┤", "┬", "┴", "┼")
const BorderSet SINGLE = ("┌", "┐", "└", "┘", "─", "│", "├", "┤", "┬", "┴", "┼")
const BorderSet DOUBLE = ("╔", "╗", "╚", "╝", "═", "║", "╠", "╣", "╦", "╩", "╬")
const BorderSet THICK = ("┏", "┓", "┗", "┛", "━", "┃", "┣", "┫", "┳", "┻", "╋")
// For a terminal whose font has no box drawing, and for `TERM=dumb`.
const BorderSet ASCII = ("+", "+", "+", "+", "-", "|", "+", "+", "+", "+", "+")

// ── the theme ──────────────────────────────────────────────────────────────
//
// A structural tuple, so a program tweaks one by copying and overwriting a
// slot. There is no builder and no registry, because `type X: T` creates no
// new type and a tuple already destructures.
//
//     Theme t = tui.DARK
//     t.accent = tui.hex(0xF5A97F)
//     tui.theme(t)
type Theme: (
    // the surface ramp, deepest to most raised
    Color base,       // the window's own background
    Color mantle,     // deeper than base — gutters, inactive tabs, the footer
    Color surface,    // a raised panel
    Color overlay,    // a modal, a popup, a menu

    // the text ramp, loudest to quietest
    Color text,       // body text
    Color subtext,    // labels, captions
    Color muted,      // disabled, placeholders, secondary numbers
    Color faint,      // hairlines, inactive glyphs, the parts you read past

    // accent and semantics
    Color accent,     // focus, selection, the primary action
    Color on_accent,  // text that sits *on* accent — contrast, not a hue
    Color ok,
    Color warn,
    Color err,
    Color info,

    // structure
    Color border,        // idle. Comes out of the surface ramp on purpose.
    Color border_focus,  // the focus ring
    BorderSet frame,
    bool wide_glyphs,    // may widgets use ◆ ● ▏▎▌ █ ▁▃▅ and friends
)

// The default. A cool, low-chroma dark palette with a genuine four-step
// surface ramp — the steps are close enough to read as one material and far
// enough apart to read as layered, which is the whole trick.
const Theme DARK = (
    Color(RGB | 0x11111B),   // base
    Color(RGB | 0x0D0D14),   // mantle
    Color(RGB | 0x181825),   // surface
    Color(RGB | 0x1E1E2E),   // overlay

    Color(RGB | 0xCDD6F4),   // text
    Color(RGB | 0xA6ADC8),   // subtext
    Color(RGB | 0x7F849C),   // muted
    Color(RGB | 0x45475A),   // faint

    Color(RGB | 0x89B4FA),   // accent
    Color(RGB | 0x11111B),   // on_accent
    Color(RGB | 0xA6E3A1),   // ok
    Color(RGB | 0xF9E2AF),   // warn
    Color(RGB | 0xF38BA8),   // err
    Color(RGB | 0x94E2D5),   // info

    Color(RGB | 0x313244),   // border — one step above `faint`, deliberately quiet
    Color(RGB | 0x89B4FA),   // border_focus
    ROUND,
    true,
)

// The same ramp inverted, for a light terminal. Not an afterthought: the
// surface ramp goes *down* in lightness as it goes up in elevation, which is
// how paper works, and a light theme that copies a dark theme's ordering is
// the other way TUIs look wrong.
const Theme LIGHT = (
    Color(RGB | 0xEFF1F5),   // base
    Color(RGB | 0xE6E9EF),   // mantle
    Color(RGB | 0xFFFFFF),   // surface
    Color(RGB | 0xFFFFFF),   // overlay

    Color(RGB | 0x4C4F69),   // text
    Color(RGB | 0x5C5F77),   // subtext
    Color(RGB | 0x8C8FA1),   // muted
    Color(RGB | 0xBCC0CC),   // faint

    Color(RGB | 0x1E66F5),   // accent
    Color(RGB | 0xFFFFFF),   // on_accent
    Color(RGB | 0x40A02B),   // ok
    Color(RGB | 0xDF8E1D),   // warn
    Color(RGB | 0xD20F39),   // err
    Color(RGB | 0x179299),   // info

    Color(RGB | 0xCCD0DA),   // border
    Color(RGB | 0x1E66F5),   // border_focus
    ROUND,
    true,
)

// No colour at all. For a pipe, for CI, for `TERM=dumb`, and for anybody who
// asked. Attributes still work, so structure survives — reverse video is the
// selection and bold is the emphasis.
const Theme MONO = (
    DEFAULT, DEFAULT, DEFAULT, DEFAULT,
    DEFAULT, DEFAULT, DEFAULT, DEFAULT,
    DEFAULT, DEFAULT, DEFAULT, DEFAULT, DEFAULT, DEFAULT,
    DEFAULT, DEFAULT,
    ASCII,
    false,
)

private Theme g_theme = DARK

// Install a theme. Takes effect on the next frame.
void theme(Theme t):
    g_theme = t
    g_force = true

// The theme in force, for a widget or a program that wants one of its colours.
Theme now():
    return g_theme
