@test
package tui

// `anim_frame` is where an animation's clock becomes an index, and the index
// is into a fixed array, so every answer has to be in `0 ..< frames`. The
// cases are the ones an `i32` conversion got wrong: a time past the `i32`'s
// end, where it saturated and the spinner froze, and the inputs a clock should
// never give but a conversion still has to answer.

i32 test():
    bool ok = true

    // The ordinary answers.
    ok = #expect(anim_frame(0.0, 8.0, 4) == 0, "frame at t=0 is ", anim_frame(0.0, 8.0, 4)) && ok
    ok = #expect(anim_frame(0.375, 8.0, 4) == 3, "frame at t=0.375 is ", anim_frame(0.375, 8.0, 4)) && ok
    ok = #expect(anim_frame(0.5, 8.0, 4) == 0, "frame at t=0.5 is ", anim_frame(0.5, 8.0, 4)) && ok

    // Ten years in, at 8 a second, is 2,524,608,000 frames, which is past
    // 2^31. The spinner has to keep turning: consecutive eighths of a second
    // are consecutive frames, which a saturated count cannot be.
    f64 decade = 315576000.0
    i32 a = anim_frame(decade, 8.0, 4)
    i32 b = anim_frame(decade + 0.125, 8.0, 4)
    ok = #expect(a == 0 && b == 1, "ten years in, the spinner is on ", a, " then ", b) && ok
    // The caret, at 2 a second, 40 years in: past 2^31 half-seconds too.
    f64 forty = 4.0 * decade
    ok = #expect(anim_frame(forty, 2.0, 2) != anim_frame(forty + 0.5, 2.0, 2),
                 "forty years in, the caret stopped blinking") && ok

    // NaN is frame 0, and a negative time still lands inside the array.
    f64 zero = 0.0
    f64 nan = zero / zero
    ok = #expect(anim_frame(nan, 8.0, 4) == 0, "a NaN time is frame ", anim_frame(nan, 8.0, 4)) && ok
    i32 back = anim_frame(0.0 - 0.125, 8.0, 4)
    ok = #expect(back >= 0 && back < 4, "a negative time is frame ", back) && ok

    if ok: return 0
    return 1
