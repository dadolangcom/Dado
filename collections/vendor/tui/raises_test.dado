@test
// What raises into a script, for the two templates. A promise written on
// `kv` or `kv_float` would bind every instantiation a program makes, so it is
// made here, at the types a script holds (`i64`, `f64`, `bool`, `string8`, and
// `f32` for `kv_float`), and the build refuses (ERR1227) if any of them reaches
// something a script cannot run. Every other public function carries its own
// `#assert_raises`, or says in its doc comment why it cannot.
package tui

import "core:strings"

#assert_raises
private void key_values():
    kv("count", i64(3))
    kv("ratio", f64(0.75))
    kv("on", true)
    string8 name = "dado"
    kv("name", name)
    kv_float("mean", 1.06493)
    kv_float("small", f32(0.5), 1)

private void frame():
    key_values()

i32 test():
    bool ok = #expect(open_headless(40, 8, 0), "headless open")
    compose(frame)
    ref []char8 shot = snapshot()
    string8 seen = shot
    ok = #expect(cell_at(0, 0).glyph == u32('c'), "the first kv did not draw") && ok
    ok = #expect(strings.contains(seen, "0.75") && strings.contains(seen, "dado"), "a kv value is missing: ", seen) && ok
    ok = #expect(strings.contains(seen, "1.06") && !strings.contains(seen, "1.064"), "kv_float did not round to 2 places: ", seen) && ok
    ok = #expect(strings.contains(seen, "0.5"), "kv_float at f32 is missing: ", seen) && ok
    #delete(shot)
    close()
    return 0 if ok else 1
