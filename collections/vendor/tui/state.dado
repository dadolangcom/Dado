// vendor:tui — the little that has to survive a frame.
//
// Immediate mode's bargain is that the app owns the value and the library owns
// the interaction. This file is the library's half: where a scroll pane sits,
// where the caret is in a line edit, how tall a scroll region's content turned
// out to be. None of it is anything a program should have to hold, and all of
// it is keyed by the widget's id rather than by anything the program passes.
//
// It is a fixed open-addressed table, not a map, for one reason: `#delete` on a
// map key while iterating is refused, and this table wants to *forget* entries
// whose widget stopped being drawn. A frame counter and a linear probe are
// smaller than the machinery avoiding that would be.
//
// Forgetting matters. A `push_id` loop over a list that changes every frame
// mints new ids constantly, and a table that only ever grows would fill up and
// start refusing state to widgets that are still on screen. An entry not
// touched for `STALE_AFTER` frames is free for reuse.
package tui

private const i32 MAX_STATE = 1024
private const i32 STALE_AFTER = 240

// Four `i32` slots and one `f64`. Deliberately anonymous: what `a` means is the
// widget's business, and naming them `scroll`/`caret` here would be one file
// knowing what every other file is doing.
private type Slot: (
    u32 id,
    bool live,
    i32 a, i32 b, i32 c, i32 d,
    f64 t,
    i32 seen,        // the frame this entry was last asked for
)

private [MAX_STATE]Slot g_slots
private i32 g_frame_no

private void tick_state():
    g_frame_no = g_frame_no + 1

// The entry for `id`, minting one if there is none. Never nil: a full table
// answers the probe's last slot rather than failing, because a widget that
// cannot get its state should misbehave slightly rather than crash — and the
// table is sized so that reaching this is a bug in the program's id discipline
// rather than an ordinary event.
private ^Slot state_of(u32 id):
    i32 mask = MAX_STATE - 1
    i32 at = i32(id) & mask
    if at < 0: at = 0 - at
    for probe in 0..<MAX_STATE:
        i32 k = (at + probe) & mask
        if g_slots[k].live && g_slots[k].id == id:
            g_slots[k].seen = g_frame_no
            return &g_slots[k]
        bool stale = g_slots[k].live && (g_frame_no - g_slots[k].seen) > STALE_AFTER
        if !g_slots[k].live || stale:
            g_slots[k] = (id, true, 0, 0, 0, 0, 0.0, g_frame_no)
            return &g_slots[k]
    return &g_slots[at]

// Drop every entry. `open` calls it, so a second UI in one process — which is
// refused anyway — could not inherit the first one's caret positions.
private void reset_state():
    for i in 0..<MAX_STATE:
        g_slots[i].live = false
    g_frame_no = 0
