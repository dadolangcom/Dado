// vendor:sokol/sokol_glue — bridges sokol_app's window to sokol_gfx's swapchain.
package sokol_glue

import "vendor:sokol/sokol_gfx"
import "vendor:sokol/sokol_app"

// bindgen:begin enums — regenerated; edits between the markers are lost
// bindgen:end enums

// ── Include order is this package's whole difficulty ──────────────────────
//
// `sokol_glue.h` refuses to be read out of order, twice, in its own words:
//
//     #error "Please include sokol_gfx.h before sokol_glue.h"
//     #error "Please include sokol_app.h before the sokol_glue.h implementation"
//
// A header is emitted in the order its `foreign` block is written, and a
// package's blocks in the order its file writes them, so the two clause-only
// lines below put gfx and app above glue whatever order a program's own
// `import` lines happen to take. That is what the deleted `sokol_glue.c`
// sidecar did with two bare `#include`s at the top of its own translation unit;
// there is one translation unit now, and this is where the ordering lives.
//
// `SOKOL_IMPL` and `SOKOL_NO_ENTRY` are stated here as well as on the two
// bindings themselves. A `define` clause is deduplicated by exact text across
// the whole program, so saying it twice costs one `#define` — and saying it
// here is what keeps this package's own two `#include`s honest rather than
// dependent on which other packages a program happened to make live.
//
// **The backend macro is not restated here**, because there is only one place
// it can be decided and this is not it: `sokol_gfx.BACKEND` and the `when`
// chain beside it. A program that reaches for `sokol_glue` calls `sg_setup` and
// `sapp_run` too, so both packages are live and the chain has run. A program
// that somehow imported only this one would get sokol_gfx.h's own *"Please
// select a backend"* — the same sentence, from the header that owns the choice.
foreign "sokol_gfx.h" define "SOKOL_IMPL"
foreign "sokol_app.h" define "SOKOL_IMPL" define "SOKOL_NO_ENTRY"

foreign "sokol_glue.h":
    // bindgen:begin declarations — regenerated; edits between the markers are lost
    // ── Functions ─────────────────────────────────────────────────────────
    sokol_gfx.sg_environment sglue_environment()
    sokol_gfx.sg_swapchain sglue_swapchain()

// bindgen: emitted 2 declarations (0 enum, 0 type, 0 const, 2 fn); skipped 0.
// bindgen:end declarations
