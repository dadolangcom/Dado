// bindgen: emitted 105 declarations (9 enum, 28 type, 11 const, 57 fn); skipped 0.
// bindgen:end declarations

// ── What sokol_app costs, per platform and per backend ────────────────────
//
// Two `when` chains rather than one, because the two costs are keyed on
// different things: the windowing libraries are the platform's and are the same
// whichever backend runs, while the 3D library follows `sokol_gfx.BACKEND`.
// The clause-only `foreign` form declares nothing — `sokol_app.h` is already
// declared above and this adds no second `#include` — so each arm is one line.
//
// `-framework` is not an option gcc has at all, so the macOS arm must be
// conditional or a Linux build dies before the linker is reached.
//
// `flags "-x objective-c"` on the macOS arm is what makes a Cocoa build go
// through at all: sokol_app's macOS implementation is Objective-C and it now
// compiles inside Dado's own generated `.c`, which is valid Objective-C. It sits
// on the platform chain, not the backend chain, because Cocoa is Objective-C
// under every backend.
when #OS == #DARWIN:
    foreign "sokol_app.h" flags "-x objective-c" link "-framework Cocoa -framework QuartzCore"
else when #OS == #WINDOWS:
    // `./dado` builds Windows through MinGW gcc, which reads none of the
    // header's `#pragma comment(lib, …)` lines.
    //
    // `flags "-Wno-pedantic"` for the reason the Linux GLCORE arms carry it —
    // *ISO C forbids conversion of object pointer to function pointer type* —
    // except that on Windows it is not the GL loader that does it and the cost
    // is therefore the platform's rather than a backend's. `_sapp_win32_dpi_
    // changed` and `_sapp_win32_init_dpi` each resolve `user32.dll` and
    // `shcore.dll` entry points through `GetProcAddress` and cast the result
    // through `(void*)`, and both run under **every** Windows backend,
    // D3D11 included. Unmeasured — there is no MinGW toolchain in the sandbox
    // this was written in — so it rests on the header's text and not on a
    // build; what is measured is that the same idiom is exactly what gcc
    // refuses on Linux.
    foreign "sokol_app.h" flags "-Wno-pedantic" link "-lkernel32 -luser32 -lshell32 -lgdi32"
else when #OS == #LINUX:
    foreign "sokol_app.h" link "-lX11 -lXi -lXcursor -lm -ldl -lpthread"

// The 3D API. `sokol_app` deliberately declares no `BACKEND` of its own: the
// window and the renderer create and draw into the same context, so one
// constant decides for both — and `ERR0903` refuses a bare `BACKEND` in a
// `when` the moment two packages in one compilation declare that name.
//
// **There is no sokol_app under `BACKEND = "dummy"`.** The dummy renderer is
// headless and sokol_app has no headless mode, so `"dummy"` matches no arm
// below, no backend macro is defined, and `sokol_app.h` says so itself:
// *"sokol_app.h: unknown 3D API selected for Linux, must be SOKOL_GLCORE,
// SOKOL_GLES3, SOKOL_WGPU or SOKOL_VULKAN"*. A headless program imports
// `sokol_gfx` and not this package. A misspelt `BACKEND` lands in the same
// place and gets the same sentence, which is the reason the chain ends on
// `== "auto"` and not on a bare `else` that would quietly pick one.
//
// ── `flags "-Wno-pedantic"`, and why it sits on exactly these two arms ────
//
// sokol_app's GLX loader resolves nineteen entry points with `dlsym` and
// `glXGetProcAddress` and casts each between an object pointer and a function
// pointer, which is what those two calls are **for** and which ISO C does not
// define. gcc refuses every one under `-Werror=pedantic`, which `./dado` passes
// by default; clang does not diagnose it at all, even under `-Weverything`.
// Measured on a program whose only import is this package: 19 errors under
// gcc, 0 under clang. It is vendor code and the conversion is correct, so the
// clause is the fix and an edit to the header is not.
//
// **There is no narrower flag.** gcc names the diagnostic `[-Wpedantic]`
// itself — there is no per-conversion option to switch off — and neither
// `-std=gnu99` nor `-Wno-error=pedantic` is an improvement: the first still
// errors 19 times (`-pedantic` outranks the dialect), and the second turns the
// errors into 19 warnings printed on every build, which buys a weaker warning
// bar *and* noise. What would be genuinely narrow is `-isystem` on this
// directory rather than `-I` — the emitted include is `<sokol_app.h>`, so gcc
// would treat the header as a system header and suppress its warnings while
// Dado's own emitted C stayed fully pedantic (measured: 0 diagnostics, and the
// program's own C still held). That is a `./dado` change, not a clause one: a
// `flags` string is a literal and this package cannot spell its own absolute
// path.
//
// So the narrowing available here is by **configuration**, and it is taken:
// only a GLCORE build loses `-pedantic`. Measured on Linux under gcc —
// `BACKEND=gl` and `BACKEND=auto` are 19 errors without the clause and 0 with
// it; **`BACKEND=gles3` is 0 either way**, because the EGL loader casts
// nothing, so that arm keeps `-pedantic` and does not carry the clause. Metal,
// D3D11, WGPU and Vulkan keep it for the same reason. The macOS GLCORE arm
// does not carry it either: Cocoa's `NSOpenGL` is called directly, there is no
// loader to cast through, and that arm compiles as Objective-C under clang.
//
// **The blast radius was the whole translation unit and is now this line's own
// `#include`.** It was stated plainly here and it was the hole in the project's
// warning-free C11 claim: a program that reached this package under a GLCORE
// backend compiled its whole translation unit — Dado's emitted C included —
// without `-pedantic`, so it was warning-clean because something it imported
// turned the warning off, and nothing in that program said so.
//
// The clause no longer reaches the `cc` line at all. A warning flag becomes a
// `#pragma GCC diagnostic push` / `ignored "-Wpedantic"` / `pop` around the
// `#include` of the header the declaring package named, and the emitted C
// around it stays fully pedantic. Measured, `example/hellotext` under this
// backend: all **19** diagnostics come out of `sokol_app.h` and none out of
// the emitted C, and the program builds clean under gcc 13.3.0 and clang
// 18.1.3 at `-pedantic -Werror` with no `-Wno-pedantic` anywhere on the
// command line.
//
// `-Wall -Wextra -Werror` and the two interop `-Werror=` flags were unaffected
// before and are unaffected now, and every `collections/` package still
// compiles pedantically under both compilers — this one included.
when sokol_gfx.BACKEND == "gl":
    when #OS == #DARWIN:
        foreign "sokol_app.h" define "SOKOL_GLCORE" link "-framework OpenGL"
    else when #OS == #WINDOWS:
        // The platform arm above already carries `-Wno-pedantic` for Windows,
        // where the DPI code needs it under every backend.
        foreign "sokol_app.h" define "SOKOL_GLCORE"
    else:
        foreign "sokol_app.h" define "SOKOL_GLCORE" flags "-Wno-pedantic" link "-lGL"
else when sokol_gfx.BACKEND == "gles3":
    foreign "sokol_app.h" define "SOKOL_GLES3" link "-lGLESv2"
else when sokol_gfx.BACKEND == "metal":
    foreign "sokol_app.h" define "SOKOL_METAL" link "-framework Metal"
else when sokol_gfx.BACKEND == "d3d11":
    foreign "sokol_app.h" define "SOKOL_D3D11" link "-ld3d11 -ldxgi"
else when sokol_gfx.BACKEND == "wgpu":
    foreign "sokol_app.h" define "SOKOL_WGPU"
else when sokol_gfx.BACKEND == "vulkan":
    foreign "sokol_app.h" define "SOKOL_VULKAN" link "-lvulkan"
else when sokol_gfx.BACKEND == "auto":
    when #OS == #DARWIN:
        foreign "sokol_app.h" define "SOKOL_METAL" link "-framework Metal"
    else when #OS == #WINDOWS:
        foreign "sokol_app.h" define "SOKOL_D3D11" link "-ld3d11 -ldxgi"
    else when #OS == #EMSCRIPTEN:
        foreign "sokol_app.h" define "SOKOL_GLES3"
    else:
        // The other GLCORE arm, and the one every Linux build without a `-D`
        // lands on. See the block above the chain for what the clause costs.
        foreign "sokol_app.h" define "SOKOL_GLCORE" flags "-Wno-pedantic" link "-lGL"
