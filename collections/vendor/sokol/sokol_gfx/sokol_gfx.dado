// Generated by Dado's binding generator from sokol_gfx.h.
// A restatement of the header's C declarations.
// Review before trusting: a binding generator drafts, it does not certify.
//
// **Hand-edited past the generator, and a regeneration keeps the edits.**
// Everything outside the declaration lists — the `define`, `link` and `flags`
// clauses, the `when` chains that carry them, the `@const` above them — is
// written by hand, and the binding generator cannot derive any of it: which
// macro a header wants defined and which library it costs on which platform are
// facts about the *system*, not about the header. So the generator does not own
// this file, it owns the two regions between `// bindgen:begin …` and `//
// bindgen:end …`, and it rewrites exactly those, reading the header, the
// package and `merge = true` from the `bindgen.toml` beside this file.
//
// Without `--merge` it writes a whole file and the hand-written half is gone —
// without `define "SOKOL_IMPL"` the binding declares functions nothing defines
// and the link fails, and without the backend chain the header refuses to
// compile at all.
package sokol_gfx

// ── The render backend, as a Dado value ────────────────────────────────────
//
// This is **the** backend knob for the whole of `vendor:sokol`. `sokol_app`
// reads `sokol_gfx.BACKEND` rather than declaring one of its own, because the
// window and the renderer have to agree — sokol_app creates the 3D context
// sokol_gfx then draws into, and two constants could disagree. It is also what
// the compiler requires: `ERR0903` refuses a bare `BACKEND` in a `when` the
// moment two packages in one compilation declare that name, so a second
// declaration would not merely be redundant, it would not compile.
//
// Override it at the build, either way:
//
//     ./dado run example/gfxsmoke -D BACKEND=dummy
//     ./dado run example/gfxsmoke -D sokol_gfx.BACKEND=dummy
//
// The bare form works because this is the only `@const` named `BACKEND` in the
// tree; the qualified form always works and is what to write if that stops
// being true (`ERR1103` says so, and names both declarations).
//
// `"auto"` is the default and picks by `#OS`: Metal on Apple, D3D11 on Windows,
// GLES3 under Emscripten, GL elsewhere — the same choice the deleted `.c`
// sidecar made with a `#if defined(__APPLE__)` cascade, moved to where a `when`
// can see it. The chain ends on `== "auto"` rather than on a bare `else`, so a
// value it does not know defines no backend macro at all and sokol_gfx.h
// answers for itself: *"Please select a backend with SOKOL_GLCORE, SOKOL_GLES3,
// SOKOL_D3D11, SOKOL_METAL, SOKOL_WGPU, SOKOL_VULKAN or SOKOL_DUMMY_BACKEND"*.
// A misspelt backend picking GL in silence is the failure this shape refuses.
@const string8 BACKEND = "auto"

// The backend macro, the libraries it costs, and — on Apple — the one compiler
// flag it needs. All three travel together on one arm, because they are one
// decision: `-framework Metal` under a GL build is a link nobody asked for, and
// `-lGL` under a dummy build is what made `example/gfxsmoke` need a GL runtime
// it never calls.
//
// **`flags "-x objective-c"` is the Apple arm's whole story.** sokol_gfx's Metal
// implementation is Objective-C, and it now compiles inside Dado's own generated
// `.c` — which is valid Objective-C — so telling the compiler to read the
// translation unit as Objective-C is all it takes. There is no sidecar left to
// have the wrong extension.
when BACKEND == "dummy":
    // No GPU, no window, no libraries: the headless build the smoke tests use.
    foreign "sokol_gfx.h" define "SOKOL_DUMMY_BACKEND"
else when BACKEND == "gl":
    when #OS == #DARWIN:
        foreign "sokol_gfx.h" define "SOKOL_GLCORE" flags "-x objective-c" link "-framework OpenGL -framework Foundation"
    else when #OS == #WINDOWS:
        // sokol_gfx.h carries its own GL loader on Windows: nothing to link.
        foreign "sokol_gfx.h" define "SOKOL_GLCORE"
    else:
        foreign "sokol_gfx.h" define "SOKOL_GLCORE" link "-lGL"
else when BACKEND == "gles3":
    foreign "sokol_gfx.h" define "SOKOL_GLES3" link "-lGLESv2"
else when BACKEND == "metal":
    foreign "sokol_gfx.h" define "SOKOL_METAL" flags "-x objective-c" link "-framework Metal -framework Foundation"
else when BACKEND == "d3d11":
    // On MSVC and on Apple clang the libraries arrive through the header's own
    // `#pragma comment(lib, …)`; `./dado` builds Windows through MinGW gcc,
    // which reads no such pragma, so they are named here.
    foreign "sokol_gfx.h" define "SOKOL_D3D11" link "-ld3d11 -ldxgi"
else when BACKEND == "wgpu":
    // The WebGPU implementation library is the program's to choose (Emscripten
    // wants `--use-port=emdawnwebgpu`, a native build wants Dawn): no `link`.
    foreign "sokol_gfx.h" define "SOKOL_WGPU"
else when BACKEND == "vulkan":
    foreign "sokol_gfx.h" define "SOKOL_VULKAN" link "-lvulkan"
else when BACKEND == "auto":
    when #OS == #DARWIN:
        foreign "sokol_gfx.h" define "SOKOL_METAL" flags "-x objective-c" link "-framework Metal -framework Foundation"
    else when #OS == #WINDOWS:
        foreign "sokol_gfx.h" define "SOKOL_D3D11" link "-ld3d11 -ldxgi"
    else when #OS == #EMSCRIPTEN:
        foreign "sokol_gfx.h" define "SOKOL_GLES3"
    else:
        foreign "sokol_gfx.h" define "SOKOL_GLCORE" link "-lGL"

// bindgen:begin enums — regenerated; edits between the markers are lost
// bindgen:end enums

// The `enums` region above is empty and stays empty. It was written before
// `foreign enum` existed, when a C enum's grouped names could only be an
// ordinary Dado `enum` with every value transcribed — which put it outside the
// `foreign` block, which is why the marker pair sits up here. A `foreign enum`
// has to be INSIDE the block, so the enums are generated into the
// `declarations` region below with everything else and this pair renders empty.
// The markers do not move: `merge` reads each region's indent off the file, so
// relocating one would be a hand edit to every binding in the tree.

// sokol is header-only: the header is both the API and the implementation, and
// `SOKOL_IMPL` is what turns the second one on. A `define` clause is emitted
// above *every* `#include` in the generated C, so the implementation compiles
// inside Dado's own translation unit. That is why there is no `.c` beside this
// file: nothing else has to be compiled or linked in, and `--emit=build` shows
// no `source` line for this package.
//
// The feature-test macros below are glibc's and are wrong on Apple and on
// Windows, where `_POSIX_C_SOURCE` alone *hides* the platform APIs sokol
// reaches for. `<features.h>` fixes the whole feature set the first time any
// header pulls it in, which is why `define` is emitted above every include and
// not merely before its own.
when #OS != #DARWIN && #OS != #WINDOWS:
    foreign "sokol_gfx.h" define "_POSIX_C_SOURCE=200809L" define "_DEFAULT_SOURCE=1"

foreign "sokol_gfx.h" define "SOKOL_IMPL":
