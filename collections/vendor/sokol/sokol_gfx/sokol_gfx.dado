    // ── Types ─────────────────────────────────────────────────────────────
    type sg_buffer:
        u32 id,

    type sg_image:
        u32 id,

    type sg_sampler:
        u32 id,

    type sg_shader:
        u32 id,

    type sg_pipeline:
        u32 id,

    type sg_view:
        u32 id,

    type sg_range:
        const rawptr ptr,
        #c.size_t    size,

    type sg_color:
        f32 r,
        f32 g,
        f32 b,
        f32 a,

    type sg_pixelformat_info:
        bool sample,
        bool filter,
        bool render,
        bool blend,
        bool msaa,
        bool depth,
        bool compressed,
        bool read,
        bool write,
        i32  bytes_per_pixel,

    type sg_features:
        bool origin_top_left,
        bool image_clamp_to_border,
        bool mrt_independent_blend_state,
        bool mrt_independent_write_mask,
        bool compute,
        bool msaa_texture_bindings,
        bool separate_buffer_types,
        bool draw_base_vertex,
        bool draw_base_instance,
        bool dual_source_blending,
        bool vertexformat_int10_n2,
        bool gl_texture_views,

    type sg_limits:
        i32 max_image_size_2d,
        i32 max_image_size_cube,
        i32 max_image_size_3d,
        i32 max_image_size_array,
        i32 max_image_array_layers,
        i32 max_vertex_attrs,
        i32 max_color_attachments,
        i32 max_texture_bindings_per_stage,
        i32 max_storage_buffer_bindings_per_stage,
        i32 max_storage_image_bindings_per_stage,
        i32 gl_max_vertex_uniform_components,
        i32 gl_max_combined_texture_image_units,
        i32 d3d11_max_unordered_access_views,
        i32 vk_min_uniform_buffer_offset_alignment,

    type sg_color_attachment_action:
        sg_load_action  load_action,
        sg_store_action store_action,
        sg_color        clear_value,

    type sg_depth_attachment_action:
        sg_load_action  load_action,
        sg_store_action store_action,
        f32             clear_value,

    type sg_stencil_attachment_action:
        sg_load_action  load_action,
        sg_store_action store_action,
        u8              clear_value,

    type sg_pass_action:
        [8]sg_color_attachment_action colors,
        sg_depth_attachment_action    depth,
        sg_stencil_attachment_action  stencil,

    type sg_metal_swapchain:
        const rawptr current_drawable,
        const rawptr depth_stencil_texture,
        const rawptr msaa_color_texture,

    type sg_d3d11_swapchain:
        const rawptr render_view,
        const rawptr resolve_view,
        const rawptr depth_stencil_view,

    type sg_wgpu_swapchain:
        const rawptr render_view,
        const rawptr resolve_view,
        const rawptr depth_stencil_view,

    type sg_vulkan_swapchain:
        const rawptr render_image,
        const rawptr render_view,
        const rawptr resolve_image,
        const rawptr resolve_view,
        const rawptr depth_stencil_image,
        const rawptr depth_stencil_view,
        const rawptr render_finished_semaphore,
        const rawptr present_complete_semaphore,

    type sg_gl_swapchain:
        u32 framebuffer,

    type sg_swapchain:
        bool                invalid,
        i32                 width,
        i32                 height,
        i32                 sample_count,
        sg_pixel_format     color_format,
        sg_pixel_format     depth_format,
        sg_metal_swapchain  metal,
        sg_d3d11_swapchain  d3d11,
