        [32]sg_view    views,
        [12]sg_sampler samplers,
        u32            _end_canary,

    type sg_buffer_usage:
        bool vertex_buffer,
        bool index_buffer,
        bool storage_buffer,
        bool immutable,
        bool dynamic_update,
        bool stream_update,
        bool write_unsealed,

    type sg_buffer_desc:
