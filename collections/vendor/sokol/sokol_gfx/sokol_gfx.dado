        i32 y,
        i32 z,

    type sg_shader_desc:
        u32                                   _start_canary,
        sg_shader_function                    vertex_func,
        sg_shader_function                    fragment_func,
        sg_shader_function                    compute_func,
        [16]sg_shader_vertex_attr             attrs,
        [8]sg_shader_uniform_block            uniform_blocks,
        [32]sg_shader_view                    views,
        [12]sg_shader_sampler                 samplers,
        [32]sg_shader_texture_sampler_pair    texture_sampler_pairs,
        sg_mtl_shader_threads_per_threadgroup mtl_threads_per_threadgroup,
        cstring                               label,
        u32                                   _end_canary,

    type sg_vertex_buffer_layout_state:
