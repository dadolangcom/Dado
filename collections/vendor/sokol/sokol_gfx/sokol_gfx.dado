        cstring                    glsl_name,

    type sg_shader_uniform_block:
        sg_shader_stage            stage,
        u32                        size,
        u8                         hlsl_register_b_n,
        u8                         msl_buffer_n,
        u8                         wgsl_group0_binding_n,
        u8                         spirv_set0_binding_n,
        sg_uniform_layout          layout,
        [16]sg_glsl_shader_uniform glsl_uniforms,

    type sg_shader_texture_view:
        sg_shader_stage      stage,
        sg_image_type        image_type,
        sg_image_sample_type sample_type,
        bool                 multisampled,
        u8                   hlsl_register_t_n,
        u8                   msl_texture_n,
        u8                   wgsl_group1_binding_n,
        u8                   spirv_set1_binding_n,

    type sg_shader_storage_buffer_view:
        sg_shader_stage stage,
        bool            readonly,
        u8              hlsl_register_t_n,
        u8              hlsl_register_u_n,
        u8              msl_buffer_n,
        u8              wgsl_group1_binding_n,
        u8              spirv_set1_binding_n,
        u8              glsl_binding_n,

    type sg_shader_storage_image_view:
        sg_shader_stage stage,
        sg_image_type   image_type,
        sg_pixel_format access_format,
        bool            writeonly,
        u8              hlsl_register_u_n,
        u8              msl_texture_n,
        u8              wgsl_group1_binding_n,
        u8              spirv_set1_binding_n,
        u8              glsl_binding_n,

    type sg_shader_view:
        sg_shader_texture_view        texture,
        sg_shader_storage_buffer_view storage_buffer,
        sg_shader_storage_image_view  storage_image,

    type sg_shader_sampler:
        sg_shader_stage stage,
        sg_sampler_type sampler_type,
        u8              hlsl_register_s_n,
