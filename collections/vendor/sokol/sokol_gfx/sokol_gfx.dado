        sg_range  data,
        #c.size_t offset,

    type sg_write_buffer_desc:
        sg_write_buffer_source src,
        sg_buffer_location     dst,
        #c.size_t              size,

    type sg_image_desc:
        u32                      _start_canary,
        sg_image_type @c("type") type_,
