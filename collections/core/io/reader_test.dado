@test
// `Reader`, `Cursor`, `read_all` and `copy`, over memory, so every claim here
// runs the same on every target:
//
//   * **a cursor hands out its bytes in order and then answers 0**, however
//     the reads are sized;
//   * **`read_all` takes everything that is left**, across more than one
//     chunk, fails with the reader's own reason when a read fails partway,
//     and `NO_MEMORY` when the text cannot grow;
//   * **`copy` moves every byte into a sink** and answers the count, and fails
//     `IO` when the sink takes fewer than it was handed;
//   * **a program's own type is a reader** by taking `Reader` on.
//
// What raises into a script is promised here too: `read_all` over a cursor,
// through `drains` below, since a promise on the template would bind every
// `Reader` a program passes.
package io

import "core:os"

// A sink that keeps what it is handed, up to `limit` bytes a call.
private type Keep: ([10000]char8 bytes, i64 used, i64 limit)

private i64 keep(rawptr data, rawptr bytes, i64 count):
    ^Keep k = ^Keep(data)
    Raw from = Raw(bytes)
    i64 n = count
    if k^.limit > 0 && n > k^.limit: n = k^.limit
    []char8 src = from[0..<n]
    for i in i64(0)..<n:
        k^.bytes[k^.used + i] = src[i]
    k^.used = k^.used + n
    return n

// A reader that answers one byte, then fails with `BUSY`.
private type OneThenFail using Reader:
    i32 calls
    i32 pad

    os.Error!i64 read(^self, []char8 into):
        self.calls = self.calls + 1
        if self.calls > 1: fail os.Error.BUSY
        into[0] = 'x'
        return 1

private type Big: [9000]char8

// An allocator that refuses everything.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

// The promise: a cursor's reads and `read_all` over one reach nothing a
// script cannot run.
#assert_raises
private os.Error!i64 drains([]char8 bytes):
    Cursor c = cursor(bytes)
    [4]char8 some
    try i64 first = c.read(some[0..<4])
    try ref []char8 rest = read_all(&c)
    i64 n = first + #len(rest)
    #delete(rest)
    return n

i32 test():
    bool ok = true

    // ── a cursor ─────────────────────────────────────────────────────────────
    [5]char8 hello = ['h', 'e', 'l', 'l', 'o']
    Cursor c = cursor(hello[0..<5])
    [2]char8 two
    try i64 r1 = c.read(two[0..<2]) else why:
        _ = #expect(false, "a cursor failed: ", os.message(why))
        return 1
    ok = #expect(r1 == 2 && two[0] == 'h' && two[1] == 'e', "the first read was not \"he\"") && ok
    try i64 r0 = c.read(two[0..<0]) else why0:
        _ = #expect(false, "a cursor failed: ", os.message(why0))
        return 1
    ok = #expect(r0 == 0 && c.at == 2, "an empty read moved the cursor") && ok
    try i64 r2 = c.read(two[0..<2]) else why2:
        _ = #expect(false, "a cursor failed: ", os.message(why2))
        return 1
    ok = #expect(r2 == 2 && two[0] == 'l', "the second read was not \"ll\"") && ok
    try i64 r3 = c.read(two[0..<2]) else why3:
        _ = #expect(false, "a cursor failed: ", os.message(why3))
        return 1
    ok = #expect(r3 == 1 && two[0] == 'o', "the last read was not \"o\" alone") && ok
    try i64 r4 = c.read(two[0..<2]) else why4:
        _ = #expect(false, "a cursor failed: ", os.message(why4))
        return 1
    ok = #expect(r4 == 0, "a cursor at its end did not answer 0") && ok

    // ── read_all, across chunks ──────────────────────────────────────────────
    Big big
    for i in i64(0)..<9000:
        big[i] = char8(i64('a') + i % 26)
    Cursor bc = cursor(big[0..<9000])
    try ref []char8 all = read_all(&bc) else why5:
        _ = #expect(false, "read_all failed: ", os.message(why5))
        return 1
    ok = #expect(#len(all) == 9000 && all[0] == 'a' && all[8999] == big[8999], "read_all did not answer the 9000 bytes") && ok
    #delete(all)

    // The reader's own reason passes through `read_all` and `copy`.
    OneThenFail failing = (0, 0)
    ref []char8 partial = nil
    try partial = read_all(&failing) else why6:
        ok = #expect(why6 == os.Error.BUSY, "a failing read made read_all fail ", os.message(why6), ", not BUSY") && ok
    ok = #expect(partial == nil, "read_all over a failing reader answered text") && ok

    // No memory is `NO_MEMORY`.
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) nothing = (refuses, nil)
    Cursor nc = cursor(big[0..<9000])
    using nothing:
        ref []char8 none = nil
        try none = read_all(&nc) else why7:
            ok = #expect(why7 == os.Error.NO_MEMORY, "read_all without memory failed ", os.message(why7)) && ok
        ok = #expect(none == nil, "read_all without memory answered text") && ok

    // ── copy ─────────────────────────────────────────────────────────────────
    Keep k
    Cursor cc = cursor(big[0..<9000])
    try i64 moved = copy(&cc, (keep, rawptr(&k))) else why8:
        _ = #expect(false, "copy failed: ", os.message(why8))
        return 1
    ok = #expect(moved == 9000 && k.used == 9000 && string8(k.bytes[0..<9000]) == string8(big[0..<9000]), "copy did not move the 9000 bytes") && ok

    Keep short
    short.limit = 10
    Cursor sc = cursor(big[0..<9000])
    try _ = copy(&sc, (keep, rawptr(&short))) else why9:
        ok = #expect(why9 == os.Error.IO, "a short sink made copy fail ", os.message(why9)) && ok

    OneThenFail failing2 = (0, 0)
    Keep k2
    try _ = copy(&failing2, (keep, rawptr(&k2))) else why10:
        ok = #expect(why10 == os.Error.BUSY && k2.used == 1, "a failing reader made copy fail ", os.message(why10)) && ok

    // ── the promise, run ─────────────────────────────────────────────────────
    try i64 drained = drains(hello[0..<5]) else why11:
        _ = #expect(false, "drains failed: ", os.message(why11))
        return 1
    ok = #expect(drained == 5, "drains answered ", drained) && ok

    return 0 if ok else 1
