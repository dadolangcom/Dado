@test
// This package is a thin skin over `<stdio.h>`, and testing that `fwrite`
// writes bytes would be testing the C library. What is worth testing is the
// part that is **this package's own judgement**:
//
//   * **the line rules**, written once in the header over `read_line` and
//     `read_line_into`: the `\n` is not kept; a `\r` immediately before it is
//     dropped, so a CRLF file reads the same as an LF one; a line longer than
//     `read_line_into`'s buffer is truncated **and the rest of it consumed**;
//     a blank line is an empty one; and **the end of input fails
//     `os.Error.END`**, which is what tells a blank line from the end.
//   * **`read_line` owns what it answers**: two lines read and held are two
//     lines, each the caller's to `#delete` (the static buffer that used to
//     make the second clobber the first is gone).
//   * **`open` fails with the reason**, `core:os`'s code read at the failure:
//     a missing file is `NOT_FOUND`, and on the web every open is
//     `UNSUPPORTED`.
//   * **`read_bytes`/`write_bytes`' zero-length guard**, which exists because a
//     zero-length slice has no element 0 to take the address of.
//   * **The Windows arm's own claims**, which run under Wine: a path with
//     characters outside ASCII opens, because paths cross as UTF-16; the
//     standard streams are in binary mode once handed out; and a UTF-8 line
//     written to a console sink in pieces that split its characters arrives as
//     the right UTF-16. The splitting and holding is portable Dado and is
//     checked on every platform; only the conversion is Windows'.
//   * **`seek` and `tell`**, from each end.
//
// The files it works on live in `/tmp` on POSIX, and in the working directory
// on Windows, which has no `/tmp`; each has a name of this package's own, is
// rewritten from scratch on every run, and is removed at the end.
package io

import "core:mem/libc"
import "core:os"
import "core:strings"

private const i64 SMALL = 8
private type Small: [8]char8

private const i64 ROOM = 64
private type Room: [64]char8

when #OS == #WINDOWS:
    private const string8 PATH = "dado_core_io_test.txt"
    private const string8 MISSING = "dado_core_io_test.does_not_exist"
    private const string8 WIDE = "dado_core_io_test_été€日.txt"
else:
    private const string8 PATH = "/tmp/dado_core_io_test.txt"
    private const string8 MISSING = "/tmp/dado_core_io_test.does_not_exist"
    private const string8 WIDE = "/tmp/dado_core_io_test_été€日.txt"

// Removing a file is `core:os/fs`'s, which imports this package, so the test
// removes what it made through C's own call (the `W` one on Windows, where the
// name is UTF-16).
when #OS == #WINDOWS:
    private foreign tdel "stdio.h":
        i32 _wremove(^const u16 path)

    private bool remove_file(string8 path):
        ref []u16 w = widen(path)
        defer #delete(w)
        return #len(w) > 0 && tdel._wremove(&w[0]) == 0
else when #OS != #WEB:
    private foreign tdel "stdio.h":
        i32 remove(cstring path)

    private bool remove_file(string8 path):
        ref []char8 c = terminated(path)
        defer #delete(c)
        return tdel.remove(cstring(c)) == 0
else:
    private bool remove_file(string8 path):
        return false

// A line with a character of each UTF-8 length: ASCII, two bytes (é), three
// (€) and four (U+1D11E, the G clef, which is a surrogate pair in UTF-16).
private const string8 LINE = "héllo €𝄞"

// An allocator that refuses everything, to reach `read_line`'s `NO_MEMORY`.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

i32 test():
    bool ok = true
    using libc.allocator():
        when #OS == #WEB:
            ok = web_streams()
        else:
            ok = files()
        ok = whole_characters() && ok
    return 0 if ok else 1

// The next line through `read_line_into`, as a count, or -1 at the end of
// input (`END`), or -2 for any other failure.
private i64 line_into(^FILE f, []char8 window):
    try i64 n = read_line_into(f, window) else why:
        if why == os.Error.END: return 0 - 1
        return 0 - 2
    return n

// Everything over a file, which a hosted target opens and the web does not
// yet. It compiles on every target, which is itself a claim: every name the
// hosted arm declares, the web arm declares too.
private bool files():
    bool ok = true

    // ── the streams a program already has ────────────────────────────────────
    //
    // Three different streams, which a shim that returned the same one for all
    // three would fail. (The invariant that each is non-nil is the `#assert`
    // below: an `#expect` on it makes gcc prove the failing branch writes to a
    // null stream, and warn about the branch that cannot happen.)
    ok = #expect(stdout() != stderr(), "stdout() and stderr() were the same stream") && ok
    ok = #expect(stdin() != stdout(), "stdin() and stdout() were the same stream") && ok
    #assert(stdout() != nil && stderr() != nil && stdin() != nil)

    // ── opening, and the reason it failed ────────────────────────────────────
    ^FILE missing = nil
    try missing = open_read(MISSING) else why:
        ok = #expect(why == os.Error.NOT_FOUND, "opening a file that is not there failed ", os.message(why), ", not NOT_FOUND") && ok
    ok = #expect(missing == nil, "opening a file that is not there answered a stream") && ok
    ^FILE bad_mode = nil
    try bad_mode = open(PATH, "") else why2:
        ok = #expect(why2 == os.Error.INVALID, "an empty mode failed ", os.message(why2), ", not INVALID") && ok
    ok = #expect(bad_mode == nil, "an empty mode opened a stream") && ok

    // ── writing ──────────────────────────────────────────────────────────────
    //
    // The file is built here, and every line in it is chosen for a claim
    // further down:
    //
    //     one\r\n      a CRLF line — the \r must be dropped
    //     two\n        an ordinary line
    //     \n           a blank line — empty, not the end
    //     0123456789\n longer than the 8-byte buffer below — truncated, and the
    //                  tail consumed rather than left to arrive as a phantom
    //     last         a last line with no `\n` is still a line
    try ^FILE w = open_write(PATH) else why3:
        return #expect(false, "could not open the test file for writing: ", os.message(why3))
    ok = #expect(write(w, "one") == 0, "write reported a failure") && ok
    _ = write_byte(w, '\r')
    _ = write_byte(w, '\n')
    ok = #expect(write_line(w, "two") == 0, "write_line reported a failure") && ok
    _ = write_byte(w, '\n')
    _ = write_line(w, "0123456789")
    _ = write(w, "last")
    ok = #expect(flush(w) == 0, "flush reported a failure") && ok
    ok = #expect(close(w) == 0, "close reported a failure") && ok

    // ── read_line_into: the rules ────────────────────────────────────────────
    //
    // An 8-byte buffer, which is what makes the fourth line a truncation.
    try ^FILE r = open_read(PATH) else why4:
        return #expect(false, "could not reopen the test file: ", os.message(why4))
    Small small
    []char8 window = small[0..<SMALL]

    // The `\n` is not stored, and a `\r` immediately before it is dropped.
    i64 n1 = line_into(r, window)
    ok = #expect(n1 == 3 && window[0] == 'o' && window[2] == 'e', "the CRLF line was ", n1, " bytes, not \"one\"") && ok
    i64 n2 = line_into(r, window)
    ok = #expect(n2 == 3 && window[0] == 't' && window[2] == 'o', "the LF line was ", n2, " bytes, not \"two\"") && ok
    // **A blank line is empty, not the end.**
    i64 n3 = line_into(r, window)
    ok = #expect(n3 == 0, "a blank line answered ", n3) && ok
    // **Truncated, and the rest consumed.**
    i64 n4 = line_into(r, window)
    ok = #expect(n4 == 8 && window[0] == '0' && window[7] == '7', "the long line answered ", n4, " bytes, not the first eight") && ok
    // The line after the truncated one is `last`, not `89`; and it has no `\n`.
    i64 n5 = line_into(r, window)
    ok = #expect(n5 == 4 && window[0] == 'l' && window[3] == 't', "the line after the truncated one was ", n5, " bytes, not \"last\"") && ok
    // **The end of input is `END`**, and only here.
    i64 n6 = line_into(r, window)
    ok = #expect(n6 == 0 - 1, "the end of input answered ", n6, ", not END") && ok

    // ── at_end, failed, clear_errors ─────────────────────────────────────────
    //
    // A read that hits the end **latches** the EOF flag, which is why clearing
    // it is the one call that makes tailing a growing file possible.
    ok = #expect(at_end(r), "the stream did not report end of file after reading past it") && ok
    ok = #expect(!failed(r), "reading a file to its end reported an error") && ok
    ok = #expect(read_byte(r) == end_of_file(), "a read past the end did not answer EOF") && ok
    clear_errors(r)
    ok = #expect(!at_end(r), "clear_errors did not clear the end-of-file flag") && ok
    _ = close(r)

    // ── read_line: owned lines ───────────────────────────────────────────────
    try ^FILE lr = open_read(PATH) else why5:
        return #expect(false, "could not reopen the test file: ", os.message(why5))
    try ref []char8 a = read_line(lr) else why6:
        return #expect(false, "the first line did not arrive: ", os.message(why6))
    try ref []char8 b = read_line(lr) else why7:
        return #expect(false, "the second line did not arrive: ", os.message(why7))
    // Two lines held at once are two lines: nothing is shared.
    ok = #expect(string8(a[:]) == "one" && string8(b[:]) == "two", "read_line answered '", string8(a[:]), "' and '", string8(b[:]), "'") && ok
    #delete(a)
    #delete(b)
    try ref []char8 blank = read_line(lr) else why8:
        return #expect(false, "a blank line failed: ", os.message(why8))
    ok = #expect(#len(blank) == 0, "a blank line was ", #len(blank), " bytes") && ok
    #delete(blank)
    // A line longer than any buffer `read_line_into` was handed is whole here.
    try ref []char8 long = read_line(lr) else why9:
        return #expect(false, "the long line failed: ", os.message(why9))
    ok = #expect(string8(long[:]) == "0123456789", "the long line was '", string8(long[:]), "'") && ok
    #delete(long)
    // **No memory is `NO_MEMORY`**, not the end.
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) nothing = (refuses, nil)
    using nothing:
        ref []char8 none = nil
        try none = read_line(lr) else why10:
            ok = #expect(why10 == os.Error.NO_MEMORY, "read_line without memory failed ", os.message(why10)) && ok
        ok = #expect(none == nil, "read_line without memory answered a line") && ok
    // The refused read took nothing: `last` is read now, then the end.
    try ref []char8 last = read_line(lr) else why11:
        return #expect(false, "the line after a refused read failed: ", os.message(why11))
    ok = #expect(string8(last[:]) == "last", "the line after a refused read was '", string8(last[:]), "'") && ok
    #delete(last)
    ref []char8 end = nil
    try end = read_line(lr) else why12:
        ok = #expect(why12 == os.Error.END, "the end of input failed ", os.message(why12), ", not END") && ok
    ok = #expect(end == nil, "there was a line after the last one") && ok
    _ = close(lr)

    // ── read_bytes and write_bytes ───────────────────────────────────────────
    try ^FILE bw = open_write(PATH) else why13:
        return #expect(false, "could not open the test file for a byte write: ", os.message(why13))
    Room out
    []char8 payload = out[0..<10]
    for i in i64(0)..<#len(payload):
        payload[i] = char8(i64('A') + i)
    ok = #expect(write_bytes(bw, payload) == 10, "write_bytes did not write ten bytes") && ok
    // **The zero-length guard**: a zero-length slice has no element 0 to take
    // the address of, so it answers 0 without touching the stream.
    []char8 none_bytes = out[0..<0]
    ok = #expect(write_bytes(bw, none_bytes) == 0, "write_bytes of an empty slice did not answer 0") && ok
    _ = close(bw)
    try ^FILE br = open_read(PATH) else why14:
        return #expect(false, "could not reopen the test file for a byte read: ", os.message(why14))
    ok = #expect(read_bytes(br, none_bytes) == 0, "read_bytes into an empty slice did not answer 0") && ok
    []char8 into = out[16..<26]
    ok = #expect(read_bytes(br, into) == 10, "read_bytes did not read ten bytes back") && ok
    ok = #expect(into[0] == 'A' && into[9] == 'J', "the bytes did not round trip: ", into[0], "..", into[9]) && ok
    // **Short means end of file**, which `at_end`/`failed` tell from an error.
    []char8 more = out[32..<48]
    ok = #expect(read_bytes(br, more) == 0, "a read past the end returned bytes") && ok
    ok = #expect(at_end(br) && !failed(br), "a short read at the end was not the end") && ok
    _ = close(br)

    // ── a stream as a Reader ─────────────────────────────────────────────────
    try ^FILE rr = open_read(PATH) else why15:
        return #expect(false, "could not reopen the test file for a reader: ", os.message(why15))
    StreamReader sr = reader(rr)
    try ref []char8 whole = read_all(&sr) else why16:
        _ = close(rr)
        return #expect(false, "read_all over a stream failed: ", os.message(why16))
    ok = #expect(string8(whole[:]) == "ABCDEFGHIJ", "read_all over a stream read '", string8(whole[:]), "'") && ok
    #delete(whole)
    _ = close(rr)
    StreamReader from_stdin = stdin_reader()
    ok = #expect(from_stdin == stdin(), "stdin_reader does not read stdin") && ok

    // ── read_byte ────────────────────────────────────────────────────────────
    //
    // Keeps its `i32` deliberately: the sentinel has to be a value no byte can
    // be, so the check is against `end_of_file()` **first**, and `char8(c)`
    // after.
    try ^FILE cw = open_write(PATH) else why17:
        return #expect(false, "could not open the test file: ", os.message(why17))
    _ = write(cw, "Xy")
    _ = close(cw)
    try ^FILE cr = open_read(PATH) else why18:
        return #expect(false, "could not reopen the test file: ", os.message(why18))
    i32 first_byte = read_byte(cr)
    ok = #expect(first_byte != end_of_file() && char8(first_byte) == 'X', "the first byte was ", first_byte) && ok
    ok = #expect(char8(read_byte(cr)) == 'y', "the second byte was wrong") && ok
    ok = #expect(read_byte(cr) == end_of_file(), "the third read was not EOF") && ok
    _ = close(cr)

    // ── streams as sinks ────────────────────────────────────────────────────
    //
    // `sink` is what connects `#render` to a file, so the claim is that bytes
    // rendered into one arrive in the stream — checked by reading them back.
    try ^FILE sw = open_write(PATH) else why19:
        return #expect(false, "the sink's file did not open for writing: ", os.message(why19))
    Sink into_file = sink(sw)
    i64 rendered = #render("n=", into_file)
    i32 seven = 7
    rendered = rendered + #render(seven, into_file)
    ok = #expect(rendered == 3, "rendering into a stream reported ", rendered, " bytes and wrote 3") && ok
    _ = close(sw)
    try ^FILE sback = open_read(PATH) else why20:
        return #expect(false, "the sink's file did not reopen: ", os.message(why20))
    [ROOM]char8 line_buffer
    i64 back = line_into(sback, line_buffer[0..<ROOM])
    ok = #expect(back == 3 && string8(line_buffer[0..<3]) == "n=7", "a rendered stream held ", back, " bytes") && ok
    _ = close(sback)

    // The two the process already has are sinks; nothing is written to them,
    // because a test's result is its exit status.
    Sink to_out = stdout_sink()
    Sink to_err = stderr_sink()
    ok = #expect(to_out.proc != nil && to_err.proc != nil, "the standard sinks are not sinks") && ok
    Sink nowhere = sink(nil)
    ok = #expect(#render("", nowhere) == 0, "a sink over a nil stream took bytes") && ok
    ok = #expect(#render("", to_out) == 0, "rendering nothing to stdout took bytes") && ok

    ok = unicode_paths() && ok
    ok = file_sink_bytes() && ok
    ok = positions() && ok
    ok = platform_checks() && ok

    // ── the files left behind ────────────────────────────────────────────────
    ok = #expect(remove_file(PATH), "the test file could not be removed") && ok
    ^FILE gone = nil
    try gone = open_read(PATH) else why21:
        ok = #expect(why21 == os.Error.NOT_FOUND, "a removed file failed ", os.message(why21)) && ok
    ok = #expect(gone == nil, "the test file was still there after removing it") && ok
    return ok

// ── seek and tell ───────────────────────────────────────────────────────────
//
// A position is a byte offset from the start, whichever end it was counted
// from, and seeking clears the end-of-file flag as C's does.
private bool positions():
    bool ok = true
    try ^FILE w = open_write(PATH) else why:
        return #expect(false, "the seek file did not open: ", os.message(why))
    _ = write(w, "0123456789")
    ok = #expect(tell(w) == 10, "tell after ten bytes was ", tell(w)) && ok
    _ = close(w)
    try ^FILE r = open_read(PATH) else why2:
        return #expect(false, "the seek file did not reopen: ", os.message(why2))
    ok = #expect(seek(r, 4, Whence.Start) && tell(r) == 4, "seek to 4 from the start went to ", tell(r)) && ok
    ok = #expect(char8(read_byte(r)) == '4', "the byte at 4 was not '4'") && ok
    ok = #expect(seek(r, 2, Whence.Current) && tell(r) == 7, "seek by 2 went to ", tell(r)) && ok
    ok = #expect(seek(r, -1, Whence.End) && char8(read_byte(r)) == '9', "seek to the last byte did not read '9'") && ok
    ok = #expect(read_byte(r) == end_of_file() && at_end(r), "the read past the end did not set the flag") && ok
    ok = #expect(seek(r, 0, Whence.Start) && !at_end(r), "seek did not clear the end-of-file flag") && ok
    _ = close(r)
    ok = #expect(!seek(nil, 0, Whence.Start) && tell(nil) == -1, "a nil stream had a position") && ok
    // `open_append` writes at the end.
    try ^FILE a = open_append(PATH) else why3:
        return #expect(false, "open_append failed: ", os.message(why3))
    _ = write(a, "!")
    _ = close(a)
    try ^FILE ar = open_read(PATH) else why4:
        return #expect(false, "the appended file did not reopen: ", os.message(why4))
    [16]char8 back
    ok = #expect(read_bytes(ar, back[0..<16]) == 11 && back[10] == '!', "open_append did not write at the end") && ok
    _ = close(ar)
    return ok

// ── the web's streams ───────────────────────────────────────────────────────
//
// The page writes standard output and error and reads an empty standard
// input; nothing opens, and the open says why.
private bool web_streams():
    bool ok = true
    ok = #expect(stdout() != stderr() && stdin() != stdout(), "the web's standard streams were not three") && ok
    ok = #expect(write(stdout(), "") == 0 && flush(stdout()) == 0, "an empty write to stdout failed") && ok
    ok = #expect(read_byte(stdin()) == end_of_file() && at_end(stdin()), "the web's stdin was not empty") && ok
    clear_errors(stdin())
    ok = #expect(!at_end(stdin()), "clear_errors did not clear stdin's end") && ok
    ok = #expect(!seek(stdout(), 0, Whence.Start) && tell(stdout()) == -1, "stdout had a position on the web") && ok
    ref []char8 l = nil
    try l = read_line(stdin()) else why0:
        ok = #expect(why0 == os.Error.END, "read_line of the web's stdin failed ", os.message(why0)) && ok
    ok = #expect(l == nil, "the web's stdin held a line") && ok
    try ^FILE f = open_read(PATH) else why:
        ok = #expect(why == os.Error.UNSUPPORTED, "open_read on the web failed ", os.message(why)) && ok
        try ^FILE g = open(PATH, "wb") else why2:
            return #expect(why2 == os.Error.UNSUPPORTED, "open on the web failed ", os.message(why2)) && ok
        _ = close(g)
        return #expect(false, "open succeeded on the web")
    _ = close(f)
    return #expect(false, "open_read succeeded on the web")

// ── paths outside ASCII ─────────────────────────────────────────────────────
//
// On POSIX a path is bytes and this is a check that nothing on the way mangles
// them. On Windows it is the claim that a path is UTF-8 in Dado and UTF-16 at
// the call: `fopen` reads a path in the ANSI code page, where `€` and `日`
// are not, so only `_wfopen` gets this right.
private bool unicode_paths():
    bool ok = true
    try ^FILE a = open_write(WIDE) else why:
        return #expect(false, "a UTF-8 path did not open for writing: ", os.message(why))
    _ = write(a, "new!")
    _ = close(a)
    try ^FILE r = open_read(WIDE) else why2:
        return #expect(false, "a UTF-8 path did not reopen: ", os.message(why2))
    [16]char8 back
    i64 n = line_into(r, back[0..<16])
    ok = #expect(n == 4 && string8(back[0..<4]) == "new!", "the UTF-8 file held ", n, " bytes") && ok
    _ = close(r)
    ok = #expect(remove_file(WIDE), "a UTF-8 path did not remove") && ok
    return ok

// ── whole characters ────────────────────────────────────────────────────────
//
// `write_characters` is what a Windows console sink hands its bytes through,
// and it is portable Dado, so it is checked here on every platform with a
// recorder in place of the console. The line goes in five writes, four of
// which end inside a character — after `é`'s lead byte, after `€`'s lead, in
// the middle of `€`, and inside the G clef — and the claims are that **no
// piece handed on ends inside a character**, that the pieces put back
// together are the line exactly, and that nothing is left held at the end.
private type Recorder: ([64]char8 bytes, i64 used, i64 pieces, bool split)

private bool record_piece(rawptr target, []char8 piece):
    ^Recorder r = ^Recorder(target)
    if utf8_complete(piece) != #len(piece): r^.split = true
    for c in piece:
        if r^.used >= 64: return false
        r^.bytes[r^.used] = c
        r^.used = r^.used + 1
    r^.pieces = r^.pieces + 1
    return true

private bool whole_characters():
    bool ok = true
    []char8 bytes = strings.bytes(LINE)
    ok = #expect(#len(bytes) == 14, "the test line is ", #len(bytes), " bytes, not 14") && ok
    Recorder rec
    Carry carry
    // Bytes: h 0, é 1-2, llo 3-5, space 6, € 7-9, the clef 10-13. Cuts at
    // 2, 8, 9 and 12: inside é, inside €, inside € again, inside the clef.
    i64 total = 0
    total = total + write_characters(record_piece, rawptr(&rec), &carry, rawptr(&bytes[0]), 2)
    total = total + write_characters(record_piece, rawptr(&rec), &carry, rawptr(&bytes[2]), 6)
    total = total + write_characters(record_piece, rawptr(&rec), &carry, rawptr(&bytes[8]), 1)
    total = total + write_characters(record_piece, rawptr(&rec), &carry, rawptr(&bytes[9]), 3)
    total = total + write_characters(record_piece, rawptr(&rec), &carry, rawptr(&bytes[12]), 2)
    ok = #expect(total == 14, "write_characters took ", total, " of 14 bytes") && ok
    ok = #expect(!rec.split, "a piece handed on ended inside a character") && ok
    ok = #expect(carry.count == 0, "bytes were still held after the last write: ", carry.count) && ok
    ok = #expect(string8(rec.bytes[0..<rec.used]) == LINE, "the pieces put back together were \"", string8(rec.bytes[0..<rec.used]), "\"") && ok

    // A write that is only the start of a character takes it all and hands
    // nothing on; a byte that does not continue it releases it, as is, for the
    // conversion to replace, and is then written itself.
    Recorder rec2
    Carry carry2
    []char8 lone = strings.bytes("€!")
    ok = #expect(write_characters(record_piece, rawptr(&rec2), &carry2, rawptr(&lone[0]), 1) == 1, "a lone lead byte was not taken") && ok
    ok = #expect(rec2.pieces == 0 && carry2.count == 1, "a lone lead byte was handed on rather than held") && ok
    ok = #expect(write_characters(record_piece, rawptr(&rec2), &carry2, rawptr(&lone[3]), 1) == 1, "the byte after a held lead was not taken") && ok
    ok = #expect(rec2.used == 2 && carry2.count == 0, "an interrupted character was not released: ", rec2.used, " bytes, ", carry2.count, " held") && ok

    // With no carry the tail is handed on as it is: nothing is ever kept back
    // where there is nowhere to keep it.
    Recorder rec3
    ok = #expect(write_characters(record_piece, rawptr(&rec3), nil, rawptr(&bytes[0]), 2) == 2, "a carry-less write was short") && ok
    ok = #expect(rec3.used == 2, "a carry-less write held bytes back") && ok

    // The boundary rule itself, at each length and at the edges.
    ok = #expect(utf8_complete(bytes[0..<0]) == 0, "an empty run is not complete") && ok
    ok = #expect(utf8_complete(bytes[0..<1]) == 1, "ASCII is not complete") && ok
    ok = #expect(utf8_complete(bytes[0..<2]) == 1, "a lone two-byte lead was kept") && ok
    ok = #expect(utf8_complete(bytes[0..<3]) == 3, "a whole two-byte character was cut") && ok
    ok = #expect(utf8_complete(bytes[0..<9]) == 7, "two-thirds of a three-byte character was kept") && ok
    ok = #expect(utf8_complete(bytes[0..<13]) == 10, "three-quarters of a four-byte character was kept") && ok
    ok = #expect(utf8_complete(bytes[0..<14]) == 14, "the whole line was cut") && ok
    ok = #expect(utf8_complete(bytes[11..<14]) == 3, "stray continuation bytes were held back") && ok
    ok = #expect(utf8_length(bytes[0]) == 1 && utf8_length(bytes[1]) == 2 && utf8_length(bytes[7]) == 3 && utf8_length(bytes[10]) == 4, "a lead byte's length was wrong") && ok
    return ok

// ── a sink over a file writes the bytes ─────────────────────────────────────
//
// On Windows a sink checks for a console and, finding a file, writes what it
// was handed unchanged: the UTF-8 line and its `\n` come back byte for byte,
// with no `\r` added and nothing converted.
private bool file_sink_bytes():
    bool ok = true
    try ^FILE w = open_write(PATH) else why:
        return #expect(false, "the sink's file did not open: ", os.message(why))
    Sink to_file = sink(w)
    i64 n = #render(LINE, to_file) + #render("\n", to_file)
    _ = close(w)
    ok = #expect(n == 15, "rendering the line took ", n, " bytes") && ok
    try ^FILE r = open_read(PATH) else why2:
        return #expect(false, "the sink's file did not reopen: ", os.message(why2))
    [32]char8 back
    i64 got = read_bytes(r, back[0..<32])
    _ = close(r)
    ok = #expect(got == 15, "the file held ", got, " bytes, not 15") && ok
    ok = #expect(got == 15 && string8(back[0..<14]) == LINE && back[14] == '\n', "the file did not hold the line byte for byte") && ok
    return ok

// ── what only Windows has ───────────────────────────────────────────────────
when #OS == #WINDOWS:
    // The package's own bindings are its file's, so the calls this file makes
    // are declared again here, under names of this file's.
    private foreign twin "windows.h" define "WIN32_LEAN_AND_MEAN=1":
        const #c.uint CP_UTF8
        #c.int MultiByteToWideChar(#c.uint code_page, #c.ulong flags, cstring from, #c.int from_count, ^u16 into, #c.int into_count)

    private foreign tcrt "stdio.h":
        i32 _fileno(^FILE stream)

    private foreign tcrt "io.h":
        i32 _setmode(i32 fd, i32 mode)

    private type WideRecord: ([32]u16 units, i64 used)

    // The conversion a console sink makes, into a buffer instead of onto a
    // screen: the same `MultiByteToWideChar` call `console_put` makes.
    private bool record_wide(rawptr target, []char8 piece):
        ^WideRecord r = ^WideRecord(target)
        i64 room = 32 - r^.used
        if #len(piece) == 0: return true
        #c.int units = twin.MultiByteToWideChar(twin.CP_UTF8, 0, cstring(rawptr(&piece[0])), #c.int(#len(piece)), &r^.units[r^.used], #c.int(room))
        if units <= 0: return false
        r^.used = r^.used + i64(units)
        return true

    private bool platform_checks():
        bool ok = true

        // A UTF-8 line through the console path in pieces that split its
        // characters arrives as exactly its UTF-16: no U+FFFD anywhere, and
        // the G clef as its surrogate pair.
        []char8 bytes = strings.bytes(LINE)
        WideRecord rec
        Carry carry
        _ = write_characters(record_wide, rawptr(&rec), &carry, rawptr(&bytes[0]), 2)
        _ = write_characters(record_wide, rawptr(&rec), &carry, rawptr(&bytes[2]), 6)
        _ = write_characters(record_wide, rawptr(&rec), &carry, rawptr(&bytes[8]), 4)
        _ = write_characters(record_wide, rawptr(&rec), &carry, rawptr(&bytes[12]), 2)
        ok = #expect(rec.used == 9, "the line came out as ", rec.used, " UTF-16 units, not 9") && ok
        if rec.used == 9:
            ok = #expect(rec.units[0] == 0x68 && rec.units[1] == 0xE9 && rec.units[5] == 0x20, "the ASCII and é units were wrong") && ok
            ok = #expect(rec.units[6] == 0x20AC, "€ came out as ", rec.units[6]) && ok
            ok = #expect(rec.units[7] == 0xD834 && rec.units[8] == 0xDD1E, "the G clef was not its surrogate pair") && ok

        // `widen` ends in the terminator the `W` functions read to.
        ref []u16 wide = widen("é")
        ok = #expect(#len(wide) == 2 && wide[0] == 0xE9 && wide[1] == 0, "widen(\"é\") was not é and a terminator") && ok
        #delete(wide)

        // The standard streams are in binary mode once handed out: `_setmode`
        // answers the mode it replaces, so setting binary again answers binary.
        Sink to_out = stdout_sink()
        ok = #expect(to_out.proc != nil, "stdout_sink() is not a sink") && ok
        ok = #expect(tcrt._setmode(tcrt._fileno(stdout()), O_BINARY) == O_BINARY, "stdout was not in binary mode") && ok
        ok = #expect(tcrt._setmode(tcrt._fileno(stderr()), O_BINARY) == O_BINARY, "stderr was not in binary mode") && ok
        ok = #expect(tcrt._setmode(tcrt._fileno(stdin()), O_BINARY) == O_BINARY, "stdin was not in binary mode") && ok
        return ok
else:
    private bool platform_checks():
        return true
