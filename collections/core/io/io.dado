// core:io — files and the standard streams, through C's `<stdio.h>` where
// there is one, and through the host where there is not.
//
//     try ^io.FILE f = io.open_read("notes.txt") else why:
//         println("notes.txt: ", os.message(why))
//         return 1
//     defer _ = io.close(f)
//     for:
//         try ref []char8 line = io.read_line(f) else why:
//             break                               // os.Error.END, or a failure
//         defer #delete(line)
//         ...
//
// **Tier W H; N in part. Script class H.** Every public name exists on Linux,
// macOS, the BSDs, Windows and the web. What each target can do differs:
//
// * **Hosted** (Linux, macOS, the BSDs, Windows): the C library's streams, the
//   file system, and everything below.
// * **The web** (`#WEB`): standard output and standard error write through the
//   host's console, and standard input is empty. **A file cannot be opened
//   there yet**: `open` and its kin fail `UNSUPPORTED`, and `seek` and `tell`
//   answer failure. The arm is written over a handful of private `host_`
//   functions so that host calls for a file system, when the runtime has them,
//   replace those functions and nothing else.
// * **Freestanding** (`#NONE`): no streams at all, since there is no C library
//   and no host to write to, so `FILE` and every function over one are not
//   declared there and a call names the missing function. What is arithmetic
//   over memory stays: `Reader`, `Cursor`, `read_all` and `copy`, over
//   whatever reader and sink the program builds itself. That is deliberate,
//   and it is why this package refuses `#NONE` by absence rather than with a
//   `#static_assert`: `core:fmt` imports it, and builds freestanding.
//
// `FILE` is the case a **bodiless foreign type** exists for: the standard
// says a program may hold a `FILE *` and says nothing a program may do with
// what it points at. Dado declares the name and nothing else, and that is
// enough — `<stdio.h>` defines the type, so C spells it and C sizes it, and
// this package simply never has a reason to hold one by value. On the web,
// where there is no `<stdio.h>`, `FILE` is a small type of this package's own
// holding a descriptor and two flags; a program holds a `^FILE` the same way.
//
// **Readers and sinks.** A `Sink` (the builtin `(proc, data)` pair `#render`
// writes into) is the write side. A `Reader` is the read side, a trait:
// `Cursor` reads bytes already in memory, `StreamReader` (from `reader` and
// `stdin_reader`) reads a stream, and a program's own type takes it on with
// `using`. `read_all` drains a reader into new text, and `copy` pumps a reader
// into a sink.
//
// **Failure is `os.Error`**, the one code space `core:os`, `core:os/fs` and
// `core:os/proc` share (`os.Error.NOT_FOUND`, `os.Error.PERMISSION`, …), read
// from `errno` or `GetLastError()` at the moment of failure, and
// `os.message(why)` is the sentence. `open` and its kin, `read_line`,
// `read_line_into`, `read_all` and a reader's `read` are failable; the rest
// answer C's own shape — a short count, `end_of_file()`, `at_end` and
// `failed` — because that is what the C library knows. To delete or move a
// file, `core:os/fs` has `remove_file` and `rename`.
//
// **What raises into a script.** `cursor` and a `Cursor`'s `read`, each
// promised on the line above it, and `read_all` over a cursor, promised in
// `reader_test.dado` at that instantiation (a promise on the template would
// bind every `Reader` a program passes). Nothing else here
// can be: this package is the boundary with C's streams, so every other
// function reaches a `foreign` call or holds a `^FILE` (an opaque C type) or
// the `rawptr` of a `Sink`. A script has its own `print`, and reads files
// through its host.
//
// **Thread-safety.** The C library locks each stream for each call, so two
// threads may write one stream and each call's bytes stay together. Nothing
// here keeps state of its own beyond the Windows console's held bytes, which
// belong to the standard output and error they stand for.
//
// **Dado writes `\n`, on every platform.** A line ends in one byte, and no
// function here turns it into `\r\n`: files are opened in binary mode, and on
// Windows the three standard streams are switched to binary mode the first
// time this package hands one out, so a file or a pipe receives exactly the
// bytes written. A reader that wants `\r\n` asks for it by writing it.
//
// **On Windows, text is UTF-8 in Dado and UTF-16 at the system call.** A path
// is converted with `MultiByteToWideChar(CP_UTF8, …)` and opened through
// `_wfopen`, so a name outside the ANSI code page works. A sink over a
// console converts what it is handed and writes it with `WriteConsoleW`, so
// UTF-8 output reads as itself on screen whatever the console's code page is;
// a sink over a file or a pipe writes the bytes unchanged. `write`,
// `write_line`, `write_byte` and `write_bytes` are the C library's own and
// write bytes, which a console shows in its code page — reach for a sink to
// put text on a Windows console.
package io

import "core:os"

// ── readers ─────────────────────────────────────────────────────────────────
//
// Plain Dado over memory, so on every target, `#NONE` included.

// A source of bytes: the read side of a `Sink`. A type takes it on with
// `using` and writes `read`; `Cursor` and `StreamReader` are this package's.
trait Reader:
    // Up to `#len(into)` bytes into `into`, answering how many arrived: more
    // than zero while there are bytes, zero at the end (and for an empty
    // `into`). Fails with the reason when the read failed (`os.Error.IO`).
    os.Error!i64 read(^self, []char8 into)

// Bytes already in memory, read from the front: `at` is how many have been
// read. The bytes are borrowed and must outlive the reads.
type Cursor using Reader:
    []char8 bytes
    i64 at

    // The next bytes, up to `#len(into)`; zero at the end. Never fails.
    #assert_raises
    os.Error!i64 read(^self, []char8 into):
        i64 left = #len(self.bytes) - self.at
        if left <= 0:
            return 0
        i64 n = #len(into)
        if n > left: n = left
        for i in i64(0)..<n:
            into[i] = self.bytes[self.at + i]
        self.at = self.at + n
        return n

// A cursor at the start of `bytes`.
#assert_raises
Cursor cursor([]char8 bytes):
    return (bytes, 0)

// Everything `r` has left, as new text on the ambient allocator, which the
// caller `#delete`s. Fails with the reader's reason when a read fails partway
// (what was read is freed) and `NO_MEMORY` when the text cannot grow.
os.Error!ref []char8 read_all(^Reader r):
    ref []char8 out = #make([]char8, 0)
    if out == nil: fail os.Error.NO_MEMORY
    Chunk chunk
    for:
        i64 n = 0
        try n = r.read(chunk[0..<CHUNK]) else why:
            #delete(out)
            fail why
        if n == 0: break
        if !#reserve(out, #len(out) + n):
            #delete(out)
            fail os.Error.NO_MEMORY
        for i in i64(0)..<n:
            _ = #append(out, chunk[i])
    return out

// Every byte `from` has left, written to `to`, answering how many were
// copied. Fails with the reader's reason when a read fails, and `IO` when the
// sink takes fewer bytes than it was handed; the bytes already copied stay
// copied.
os.Error!i64 copy(^Reader from, Sink to):
    Chunk chunk
    i64 total = 0
    for:
        try i64 n = from.read(chunk[0..<CHUNK])
        if n == 0: break
        if to.proc == nil:
            fail os.Error.IO
        i64 wrote = to.proc(to.data, rawptr(&chunk[0]), n)
        if wrote != n:
            fail os.Error.IO
        total = total + n
    return total

// The bytes `read_all` and `copy` move per read.
private const i64 CHUNK = 4096
private type Chunk: [CHUNK]char8

// Where `seek` counts an offset from: the start of the stream, the current
// position, or the end.
enum i32 Whence: (Start, Current, End)

// ── whole characters, for a writer that converts ─────────────────────────
//
// Plain arithmetic over bytes, used by the Windows console path and written
// outside it so every platform's tests check it: the only Windows-specific
// part of a console write is `console_put`, which is handed whole
// characters by what follows.

// Hand up to `count` bytes to `put` in pieces of at most `CONSOLE_CHUNK`
// that each end on a character boundary, and answer how many were taken.
//
// **A character split between two writes is held, not mangled.** A render
// may end partway through a multi-byte character, and converting the half
// alone would put U+FFFD on screen twice. So the incomplete tail of a write
// — at most three bytes — waits in `carry` and is finished from the front
// of the next write. With no `carry` the tail is handed over as it is.
// Bytes that are not UTF-8 at all are passed on for the conversion to turn
// into U+FFFD, never dropped.
private i64 write_characters(Put put, rawptr target, ^Carry carry, rawptr bytes, i64 count):
    Raw src = Raw(bytes)
    []char8 from = src[0..<count]
    i64 at = 0
    if carry != nil && carry^.count > 0:
        i64 need = utf8_length(carry^.bytes[0])
        for carry^.count < need && at < count && utf8_continues(from[at]):
            carry^.bytes[carry^.count] = from[at]
            carry^.count = carry^.count + 1
            at = at + 1
        if carry^.count < need && at == count:
            return count
        // Complete, or cut short by a byte that does not continue it, in
        // which case the conversion replaces it.
        i64 held = carry^.count
        carry^.count = 0
        if !put(target, carry^.bytes[0..<held]):
            return 0
    for at < count:
        i64 take = count - at
        if take > CONSOLE_CHUNK: take = CONSOLE_CHUNK
        i64 keep = utf8_complete(from[at..<at + take])
        if keep < take && at + take == count && carry != nil:
            i64 tail = take - keep
            for i in i64(0)..<tail:
                carry^.bytes[i] = from[at + keep + i]
            carry^.count = tail
            if keep > 0 && !put(target, from[at..<at + keep]):
                return at
            return count
        if keep == 0: keep = take
        if !put(target, from[at..<at + keep]):
            return at
        at = at + keep
    return count

// What `write_characters` hands each piece to: the target it was given, and
// whole characters. False stops the write.
private type Put: bool(rawptr, []char8)

private const i64 CONSOLE_CHUNK = 1024
private type Raw: ^char8
private type Pending: [4]char8
private type Carry: (Pending bytes, i64 count)

// How many bytes the character starting with `lead` takes: 1 for ASCII and
// for a byte that cannot start one (a stray continuation, or 0xF8 and up),
// which is then converted on its own as invalid.
private i64 utf8_length(char8 lead):
    u8 b = u8(lead)
    if b < 0xC0: return 1
    if b < 0xE0: return 2
    if b < 0xF0: return 3
    if b < 0xF8: return 4
    return 1

private bool utf8_continues(char8 c):
    u8 b = u8(c)
    return b >= 0x80 && b < 0xC0

// The longest prefix of `text` that does not end partway through a
// character: all of it, or all but an incomplete final sequence of at most
// three bytes. Only the last character is examined, so invalid bytes
// earlier on are kept for the conversion to replace.
private i64 utf8_complete([]char8 text):
    i64 n = #len(text)
    i64 i = n - 1
    i64 back = 0
    for i >= 0 && back < 3 && utf8_continues(text[i]):
        i = i - 1
        back = back + 1
    if i < 0: return n
    if i + utf8_length(text[i]) > n: return i
    return n

// ── the web ─────────────────────────────────────────────────────────────────
//
// **A web program has the standard streams, and no files yet.** `#WEB` has no
// C library, so no `<stdio.h>` and no `FILE` of C's: what a page has in their
// place is a host on the other side of the module's imports. Standard output
// and standard error write through the runtime's `dado_rt__web_fd_write` —
// which the compiler emits into every `#WEB` program that calls it, buffered:
// standard output is handed to the host when its buffer fills, when `main`
// returns and before a trap, and standard error at each newline.
// Standard input has nothing behind it, so it reads as empty.
//
// Every function the hosted arm declares is declared here too, with the same
// signature, so a program that names one builds for the web and decides at
// run time, by the answer, what the page could not do: an open fails
// `UNSUPPORTED`. What a host would have to offer for
// files is confined to the private `host_` functions at the end of this arm,
// which answer "unsupported" today; giving them host calls is the whole of
// the change that gives the web files.
//
// `dado/web.h` is not a C header. It names the runtime the compiler emits into
// a `#WEB` translation unit, which declares these functions with the C types
// restated here, so the restatement is checked like any other.
when #OS == #WEB:
    private foreign "dado/web.h":
        i64 dado_rt__web_fd_write(i32 fd, rawptr bytes, i64 count)

    // A stream: the descriptor it reads or writes (0, 1 and 2 are the
    // standard three) and the end-of-file and error flags C's `FILE` keeps.
    // A program holds a `^FILE` and never one by value, as on a hosted target.
    type FILE: (i32 fd, bool eof, bool err)

    private FILE web_in
    private FILE web_out
    private FILE web_err

    // The page's standard input, which reads as empty.
    ^FILE stdin():
        web_in.fd = 0
        return &web_in

    // The page's standard output: the host's console, or node's stdout.
    ^FILE stdout():
        web_out.fd = 1
        return &web_out

    // The page's standard error.
    ^FILE stderr():
        web_err.fd = 2
        return &web_err

    // Open `path` with C's `mode`: on the web, which has no file system to
    // open in yet, it fails `UNSUPPORTED`.
    os.Error!^FILE open(string8 path, string8 mode):
        try ^FILE f = host_open(path, mode)
        return f

    // Close a stream: 0, or `end_of_file()` for `nil`. Closing a standard
    // stream leaves it usable, as nothing else could reopen it.
    i32 close(^FILE stream):
        if stream == nil:
            return WEB_EOF
        if stream^.fd <= 2:
            return 0
        return host_close(stream)

    // Write `text`: 0, or `end_of_file()` when the stream cannot take it.
    i32 write(^FILE stream, string8 text):
        []char8 b = Bytes(text)
        i64 n = #len(b)
        if n == 0:
            return 0
        if put_bytes(stream, rawptr(&b[0]), n) != n:
            return WEB_EOF
        return 0

    // Write one byte, answering it, or `end_of_file()` when it was not taken.
    i32 write_byte(^FILE stream, char8 byte):
        [1]char8 one = [byte]
        if put_bytes(stream, rawptr(&one[0]), 1) != 1:
            return WEB_EOF
        return i32(u8(byte))

    // 0, and nothing more yet. The runtime holds standard output until its
    // buffer fills, `main` returns or the program traps, and standard error
    // until a newline, and it offers no call for a package to hand the held
    // bytes over sooner: its flush is named as only the compiler's own
    // functions may be. A line written to standard error arrives at its `\n`.
    i32 flush(^FILE stream):
        return 0

    // One byte, or `end_of_file()` when there are none left — which on the web
    // is at once: standard input is empty and no file is open.
    i32 read_byte(^FILE stream):
        [1]char8 one
        if take_bytes(stream, rawptr(&one[0]), 1) != 1:
            return WEB_EOF
        return i32(u8(one[0]))

    // The value `read_byte` answers at the end: -1, as C's `EOF` is on every
    // C library this package runs on.
    i32 end_of_file():
        return WEB_EOF

    // Read up to `#len(into)` bytes, answering how many arrived; short means
    // end of file or an error, which `at_end` and `failed` tell apart.
    i64 read_bytes(^FILE stream, []char8 into):
        i64 count = #len(into)
        if count <= 0:
            return 0
        return take_bytes(stream, rawptr(&into[0]), count)

    // Write a slice's bytes, answering how many were written.
    i64 write_bytes(^FILE stream, []char8 from):
        i64 count = #len(from)
        if count <= 0:
            return 0
        return put_bytes(stream, rawptr(&from[0]), count)

    // Whether a read has reached the end of the stream.
    bool at_end(^FILE stream):
        return stream != nil && stream^.eof

    // Whether a read or a write on the stream has failed.
    bool failed(^FILE stream):
        return stream == nil || stream^.err

    // Clear the end-of-file and error flags.
    void clear_errors(^FILE stream):
        if stream == nil: return
        stream^.eof = false
        stream^.err = false

    // Move the stream's position: `false` on the web, where no stream can.
    bool seek(^FILE stream, i64 offset, Whence from):
        if stream == nil: return false
        return host_seek(stream, offset, from) >= 0

    // The stream's position, or -1 — always, on the web.
    i64 tell(^FILE stream):
        if stream == nil: return -1
        return host_seek(stream, 0, Whence.Current)

    // A sink that writes to `stream`, borrowed for as long as the sink is used.
    Sink sink(^FILE stream):
        return (stream_write, rawptr(stream))

    // The page's standard output, as a sink.
    Sink stdout_sink():
        return sink(stdout())

    // The page's standard error, as a sink.
    Sink stderr_sink():
        return sink(stderr())

    private const i32 WEB_EOF = -1

    // `string ⇄ []char8` is free, and reachable through a named alias.
    private type Bytes: []char8

    private i64 stream_write(rawptr data, rawptr bytes, i64 count):
        if data == nil || bytes == nil || count <= 0:
            return 0
        return put_bytes(^FILE(data), bytes, count)

    // Every write: standard output and error to the console, anything else
    // to the host. A short write sets the error flag.
    private i64 put_bytes(^FILE stream, rawptr bytes, i64 count):
        if stream == nil:
            return 0
        i64 n = 0
        if stream^.fd == 1 || stream^.fd == 2:
            n = dado_rt__web_fd_write(stream^.fd, bytes, count)
        else:
            n = host_write(stream, bytes, count)
        if n != count:
            stream^.err = true
        if n < 0:
            return 0
        return n

    // Every read. Zero sets the end-of-file flag; a failure, the error flag.
    private i64 take_bytes(^FILE stream, rawptr into, i64 count):
        if stream == nil:
            return 0
        i64 n = host_read(stream, into, count)
        if n < 0:
            stream^.err = true
            return 0
        if n == 0:
            stream^.eof = true
        return n

    // ── what a host would supply ─────────────────────────────────────────────
    //
    // Each of these answers what C would when the operation is not supported,
    // and each is the one place its operation reaches the host. Host calls for
    // a file system (node's `fs`, or a page's own store) would replace their
    // bodies: `host_open` would allocate a `FILE` for the descriptor the host
    // answers, `host_read` would read descriptor 0 as standard input too, and
    // nothing above them would change.

    private os.Error!^FILE host_open(string8 path, string8 mode):
        fail os.Error.UNSUPPORTED

    private i32 host_close(^FILE stream):
        return WEB_EOF

    private i64 host_read(^FILE stream, rawptr into, i64 count):
        if stream^.fd == 1 || stream^.fd == 2:
            return -1
        return 0

    private i64 host_write(^FILE stream, rawptr bytes, i64 count):
        return -1

    private i64 host_seek(^FILE stream, i64 offset, Whence from):
        return -1

else when #OS != #NONE:

    // The handle is this package's **surface**: `open` returns one and every other
    // function takes one, so a program that uses this package has to be able to
    // name it. Its block is therefore public.
    //
    // A member may *narrow* a block's visibility and not widen it, which is
    // why this is a block of its own rather than one public line inside the
    // private one below. Two blocks naming one header is fine — it is included
    // once — and the split says something true: the type is the API, the functions
    // are the machinery.
    foreign "stdio.h":
        // A C stream: what `open` answers and every function here takes, held
        // through a `^FILE` and never by value.
        type FILE

    // The three standard streams, and bytes rather than lines.
    //
    // **This was a C shim beside this file — `streams.c` and `streams.h` — and both
    // are deleted.** It argued two reasons and neither survives.
    //
    // The first was that C's `stdin` is a **macro** and `foreign` binds a name. It
    // does bind names, and a `foreign` **constant** is exactly the member form for
    // this: it declares the type only and emits the identifier, so the preprocessor
    // expands whatever the platform's `<stdio.h>` says `stdin` is — `stdin` on
    // glibc, `__stdinp` on Apple's — and this file never has to know which. That is
    // the same mechanism `const i32 EOF` below has always used; nothing new was
    // needed, and the shim was solving a problem the member form already solved.
    //
    // The second was that `fread`'s `size_t` is not `u64` on every target, and
    // that is right, though not for the reason it was first given. The width is
    // the same on every target Dado supports; the **type** is not. `u64` is emitted
    // `uint64_t`, which glibc makes `unsigned long` — `size_t`'s type — and Darwin
    // makes `unsigned long long`, and the emitter asserts every restatement's C
    // type with `_Generic`, so a `u64` here built on Linux and was a build error
    // on every Mac. `#c.size_t` is `size_t` on both, which is what it is for; the
    // callers below convert at the call, where Dado's own counts are `i64`.
    //
    // The block is **bound** as `sys` because the three constants carry C's own
    // spellings and this package already declares functions called `stdin`,
    // `stdout` and `stderr`. A binding is what keeps one name from having to be two
    // things; the emitted C is still the bare identifier.
    private foreign sys "stdio.h":
        const ^FILE stdin
        const ^FILE stdout
        const ^FILE stderr
        #c.size_t fread(rawptr into, #c.size_t size, #c.size_t count, ^FILE stream)
        #c.size_t fwrite(rawptr from, #c.size_t size, #c.size_t count, ^FILE stream)

    private foreign "stdio.h":
        ^FILE fopen(cstring path, cstring mode)
        i32 fclose(^FILE stream)
        i32 fgetc(^FILE stream)
        i32 fputc(i32 byte, ^FILE stream)
        i32 fflush(^FILE stream)
        // FreeBSD's `<stdio.h>` defines these three as macros too (each over
        // the function of the same name when the program is threaded), so
        // they are marked as names that may be spelled as macros.
        @macro i32 feof(^FILE stream)
        @macro i32 ferror(^FILE stream)
        @macro void clearerr(^FILE stream)

        const i32 EOF

    // ── Windows ───────────────────────────────────────────────────────────────
    //
    // Win32 through `<windows.h>` and the C runtime's `<io.h>` and `<fcntl.h>`,
    // as MinGW-w64 ships them — the headers `zig cc -target x86_64-windows-gnu`
    // compiles against. `DWORD` is `unsigned long` (32 bits there), `BOOL` is
    // `int`, a `HANDLE` is a `void *`, and a `WCHAR` is a 16-bit `wchar_t`,
    // which is `unsigned short` in C and so is `u16` here.
    when #OS == #WINDOWS:
        private foreign win "windows.h" define "WIN32_LEAN_AND_MEAN=1":
            const #c.uint CP_UTF8
            const #c.ulong STD_OUTPUT_HANDLE
            const #c.ulong STD_ERROR_HANDLE
            rawptr GetStdHandle(#c.ulong which)
            #c.int MultiByteToWideChar(#c.uint code_page, #c.ulong flags, cstring from, #c.int from_count, ^u16 into, #c.int into_count)
            #c.int GetConsoleMode(rawptr console, ^#c.ulong mode)
            #c.int WriteConsoleW(rawptr console, const rawptr from, #c.ulong count, ^#c.ulong written, rawptr reserved)

        private foreign crt "stdio.h":
            i32 _fileno(^FILE stream)
            ^FILE _wfopen(^const u16 path, ^const u16 mode)

        private foreign crt "io.h":
            i32 _setmode(i32 fd, i32 mode)

        // `_O_BINARY`, the C runtime's binary-mode flag. Its name lives in
        // `<fcntl.h>`, which on Windows is the C runtime's header — but a
        // `foreign` block naming it is read as POSIX by its name (WRN0923)
        // whatever arm it stands in, so the value is restated here. It is the
        // runtime's ABI and has been 0x8000 since the first Microsoft C
        // runtime; a wrong one fails the binary-mode test under Wine.
        private const i32 O_BINARY = 0x8000

    // ── the streams a program already has ─────────────────────────────────────
    //
    // Until 2026-08-14 this package could not reach them at all, so **a program
    // could not read its own standard input through `core:io`**. Every other
    // function here takes a `^FILE`, so these three are the only thing that was
    // missing — `read_line(io.stdin())` is a line from the terminal or from a pipe,
    // and `write(io.stderr(), …)` is a diagnostic that survives `> /dev/null`.
    //
    // Functions and not constants, because on a conforming implementation each is a
    // macro (C99 §7.19.1) whose expansion is the platform's business: glibc says
    // `stdin`, Apple's `<stdio.h>` says `__stdinp`. The `foreign` constants above
    // leave that to the preprocessor, so no line here has to know it.
    //
    // Never `nil` on a hosted implementation. There is no `opened()` check to write
    // here, and one would be checking a promise C already made.
    //
    // **On Windows each is in binary mode** from the first call of any of the
    // three (or of a sink over one): the C runtime opens them in text mode,
    // which writes every `\n` as `\r\n` and reads a `\x1A` as the end, and a
    // file or a pipe should receive exactly the bytes written.
    when #OS == #WINDOWS:
        // The process's standard input. In binary mode from the first call.
        ^FILE stdin():
            binary_streams()
            return sys.stdin

        // The process's standard output. In binary mode from the first call.
        ^FILE stdout():
            binary_streams()
            return sys.stdout

        // The process's standard error. In binary mode from the first call.
        ^FILE stderr():
            binary_streams()
            return sys.stderr

        // Once per process. Each stream is flushed first, because changing a
        // stream's mode with text already buffered in it is the C runtime's
        // undefined corner.
        private void binary_streams():
            if streams_binary: return
            streams_binary = true
            _ = fflush(sys.stdout)
            _ = fflush(sys.stderr)
            _ = crt._setmode(crt._fileno(sys.stdin), O_BINARY)
            _ = crt._setmode(crt._fileno(sys.stdout), O_BINARY)
            _ = crt._setmode(crt._fileno(sys.stderr), O_BINARY)

        private bool streams_binary
    else:
        // The process's standard input. POSIX has no text mode: a stream is
        // bytes already.
        ^FILE stdin():
            return sys.stdin

        // The process's standard output.
        ^FILE stdout():
            return sys.stdout

        // The process's standard error.
        ^FILE stderr():
            return sys.stderr

    // ── opening and closing ───────────────────────────────────────────────────

    // Open a file with C's `mode` (`"rb"`, `"wb"`, `"ab"`, and their `+`
    // forms), failing with the reason: `NOT_FOUND`, `PERMISSION`, `IS_DIR`,
    // `BUSY` and the rest of `os.Error`, read from `errno` (POSIX) or the
    // thread's last error (Windows, where `_wfopen` sets it) as the call
    // returns.
    //
    // **On Windows the path is UTF-8 and is opened as UTF-16**, through
    // `_wfopen`, so a name outside the ANSI code page opens; `fopen` would read
    // the bytes in that code page instead.
    when #OS == #WINDOWS:
        os.Error!^FILE open(string8 path, string8 mode):
            ref []u16 wide_path = widen(path)
            defer #delete(wide_path)
            ref []u16 wide_mode = widen(mode)
            defer #delete(wide_mode)
            if #len(wide_path) == 0 || #len(wide_mode) == 0: fail os.Error.INVALID
            ^FILE f = crt._wfopen(&wide_path[0], &wide_mode[0])
            if f == nil: try os.fail_last()
            return f

        // `text` as UTF-16 with its terminator, from `#heap`; empty when it
        // could not be converted or the allocation failed, which every caller
        // treats as the call failing. The first `MultiByteToWideChar`
        // measures, the second writes.
        private ref []u16 widen(string8 text):
            ref []u16 none = #make([]u16, 0, #heap)
            i64 n = #len(text)
            if n == 0: return none
            []char8 bytes = Bytes(text)
            #c.int units = win.MultiByteToWideChar(win.CP_UTF8, 0, cstring(rawptr(&bytes[0])), #c.int(n), nil, 0)
            if units <= 0: return none
            #delete(none)
            ref []u16 wide = #make([]u16, i64(units) + 1, #heap)
            if #len(wide) != i64(units) + 1: return wide
            #c.int wrote = win.MultiByteToWideChar(win.CP_UTF8, 0, cstring(rawptr(&bytes[0])), #c.int(n), &wide[0], units)
            if wrote != units:
                #delete(wide)
                return #make([]u16, 0, #heap)
            wide[i64(units)] = 0
            return wide

        // `string8 ⇄ []char8` is free, and reachable through a named alias.
        private type Bytes: []char8
    else:
        os.Error!^FILE open(string8 path, string8 mode):
            ref []char8 cpath = terminated(path)
            defer #delete(cpath)
            ref []char8 cmode = terminated(mode)
            defer #delete(cmode)
            if cpath == nil || cmode == nil: fail os.Error.NO_MEMORY
            ^FILE f = fopen(cstring(cpath), cstring(cmode))
            if f == nil: try os.fail_last()
            return f

        // `s` with a `\0` after it, for `fopen`, or `nil` when it could not be
        // allocated; the caller deletes it.
        private ref []char8 terminated(string8 s):
            i64 n = #len(s)
            ref []char8 out = #make([]char8, n + 1)
            if out == nil: return out
            for i in 0..<n:
                out[i] = s[i]
            out[n] = '\0'
            return out

    // Flush and close `stream`: 0, or `end_of_file()` when the flush or the
    // close failed. The stream is gone either way.
    i32 close(^FILE stream):
        return fclose(stream)

    // ── writing ───────────────────────────────────────────────────────────────

    // Write `text`: 0, or `end_of_file()` when the stream did not take all of
    // it. `write_bytes` is the same write answering the count.
    i32 write(^FILE stream, string8 text):
        i64 n = #len(text)
        if n == 0: return 0
        []char8 bytes = Text(text)
        if i64(sys.fwrite(rawptr(&bytes[0]), 1, #c.size_t(n), stream)) != n:
            return EOF
        return 0

    // `string8 ⇄ []char8` is free, and reachable through a named alias.
    private type Text: []char8

    // `fputc` takes an `int` and always has: C's character functions are written
    // in terms of the type `getc` needs for its sentinel, not the type a byte is.
    // A written conversion is what lets a `char8` reach it. Answers the byte
    // written, or `end_of_file()` when it was not.
    i32 write_byte(^FILE stream, char8 byte):
        return fputc(i32(byte), stream)

    // Hand what the C library holds for `stream` to the system: 0, or
    // `end_of_file()` when the write failed. `nil` flushes every output stream.
    i32 flush(^FILE stream):
        return fflush(stream)

    // ── reading ───────────────────────────────────────────────────────────────

    // One byte, or `end_of_file()` when there are none left.
    //
    // This one keeps its `i32`, and deliberately: C returns an `int` because the
    // sentinel has to be a value no byte can be, and narrowing it to `char8` here
    // would fold EOF into a real byte and lose the only way to tell the stream
    // ended. Check it against `end_of_file()` first, then `char8(c)` — a written
    // conversion, which is allowed — to get the byte.
    i32 read_byte(^FILE stream):
        return fgetc(stream)

    // The value `read_byte` answers at the end: C's `EOF`, a negative `int`
    // no byte can be.
    i32 end_of_file():
        return EOF

    // ── bytes ─────────────────────────────────────────────────────────────────

    // Read up to `#len(into)` bytes into the caller's slice, and answer how many
    // arrived. Short means end of file or an error, which `at_end` and
    // `failed` tell apart — `fread` cannot, and neither can this.
    //
    // **The bytes are the caller's**, which is the whole difference between this
    // and `read_line`: nothing here is shared, nothing is overwritten by the next
    // call, and two of these may be in flight over two streams. It is also the only
    // route in this package that does not read one byte per call.
    //
    // A `[]char8` and not a `^char8` and a count: a slice *is* the pointer and the
    // count, so passing one cannot get the pair out of step. The
    // `rawptr(&into[0])` below is the conversion at the boundary, and it is guarded
    // because a zero-length slice has no element 0 to take the address of.
    // The count is **bound to an `i64` first**, and that is not decoration: a bare
    // `#len(into) <= 0` meets an untyped `0`, so the count adapts to the
    // default width and the comparison is emitted as `((int32_t)into.len) <= 0` —
    // which is the wrong answer for a slice whose length does not fit in 32 bits.
    // Naming the width once is what makes both uses of it that width.
    i64 read_bytes(^FILE stream, []char8 into):
        i64 count = #len(into)
        if count <= 0:
            return 0
        return i64(sys.fread(rawptr(&into[0]), 1, #c.size_t(count), stream))

    // Write a slice's bytes, and answer how many were written. Short means the
    // write failed partway.
    //
    // Every byte, embedded `\0` included. That is the pair `read_bytes`
    // needs — bytes that can be read and not written back are half an answer —
    // and it is how a program copies a stream without deciding what a line is.
    i64 write_bytes(^FILE stream, []char8 from):
        i64 count = #len(from)
        if count <= 0:
            return 0
        return i64(sys.fwrite(rawptr(&from[0]), 1, #c.size_t(count), stream))

    // Whether a read has reached the end of `stream`: the end-of-file flag,
    // which stays set until `clear_errors` or `seek`.
    bool at_end(^FILE stream):
        return feof(stream) != 0

    // Whether a read or a write on `stream` has failed: the error flag, which
    // stays set until `clear_errors`.
    bool failed(^FILE stream):
        return ferror(stream) != 0

    // Clear the end-of-file and error flags.
    //
    // This is the one call that makes **tailing a growing file** possible with
    // nothing else: a read that hits the end latches the EOF flag, and every
    // later read then returns `end_of_file()` without asking the filesystem, even
    // after somebody has appended. Clearing the flag is how you ask again.
    // `example/dashboard` read a build's log this way while the build was still
    // writing it — the one worked example of the call, retired with `example/` at
    // its retirement and not replaced; `io_test.dado` covers this function now.
    void clear_errors(^FILE stream):
        clearerr(stream)

    // ── streams as sinks ──────────────────────────────────────────────────────
    //
    // A `Sink` is `(i64(rawptr, rawptr, i64) proc, rawptr data)` — the shape
    // `#render` writes into, and the same `(proc, data)` pair an `Allocator` is.
    // These three turn a stream into one, which is what connects `core:fmt`'s
    // putters and `#render` itself to a file, a pipe, or the terminal.
    //
    // **They are here and not in `core:fmt` for one reason, and it is the header.**
    // `stdout` is `<stdio.h>`, a `foreign` block's `#include` is emitted for every
    // importer of the package holding it, and `core:fmt` holds none — so a
    // `fmt.out()` would have put `<stdio.h>` into every program that formatted a
    // number into its own buffer, and no `#NONE` program could have imported the
    // formatting library at all. This package already declares `FILE`, so a sink
    // over one costs its importers nothing they were not already paying.
    //
    //     Sink o = io.stdout_sink()
    //     _ = fmt.put_string("n = ", o)
    //     _ = fmt.put(count, o)
    //     _ = fmt.put_string("\n", o)
    //
    // Each of those is one `#render` into a stream, and none of them allocates.

    // A sink that writes to `stream`. The stream is borrowed and must outlive
    // every render through the sink, which is the ordinary raw-pointer bargain: a
    // sink is two words and holds no lifetime.
    Sink sink(^FILE stream):
        return (stream_write, rawptr(stream))

    // The process's standard output, as a sink.
    //
    // **Named `stdout_sink` and not `out`**, which is `core:log`'s spelling for the
    // same thing and is worth matching for a duller reason than consistency: `out`
    // is one of the commonest local names there is, a local shadows a package
    // binding, and a package function called `out` is one a caller cannot reach
    // from any scope that happens to have a buffer by that name. This package's own
    // test had one, and that is how the collision was found.
    Sink stdout_sink():
        return sink(stdout())

    // The process's standard error, as a sink — a diagnostic that survives
    // `> /dev/null`.
    Sink stderr_sink():
        return sink(stderr())

    private type Stream: ^FILE

    // The procedure. It answers what the write reported, so a short count is a
    // short answer and `#render`'s total is the truth about what reached the
    // stream rather than about what was offered to it.
    when #OS == #WINDOWS:
        // The standard output or error, when it is a console (`GetConsoleMode`
        // succeeds on its handle), takes UTF-16 through `console_put`;
        // anything else — a file, a pipe, `NUL`, a stream `open` returned —
        // takes the bytes.
        private i64 stream_write(rawptr data, rawptr bytes, i64 count):
            if data == nil || bytes == nil || count <= 0:
                return 0
            Stream s = Stream(data)
            i32 fd = crt._fileno(s)
            if fd == 1 || fd == 2:
                rawptr handle = win.GetStdHandle(win.STD_OUTPUT_HANDLE)
                ^Carry carry = &out_carry
                if fd == 2:
                    handle = win.GetStdHandle(win.STD_ERROR_HANDLE)
                    carry = &err_carry
                #c.ulong mode = 0
                if handle != nil && win.GetConsoleMode(handle, &mode) != 0:
                    // Whatever the C runtime holds for this stream goes first,
                    // so a `write` before a render still arrives before it.
                    _ = fflush(s)
                    return write_characters(console_put, handle, carry, bytes, count)
            return i64(sys.fwrite(bytes, 1, #c.size_t(count), s))

        // One conversion and the `WriteConsoleW` calls that drain it. A chunk
        // of at most `CONSOLE_CHUNK` bytes converts to at most that many UTF-16
        // units — a byte never becomes more than one unit, and a four-byte
        // character becomes two — so the buffer cannot overflow.
        private bool console_put(rawptr handle, []char8 text):
            i64 n = #len(text)
            if n <= 0: return true
            Wide wide
            #c.int units = win.MultiByteToWideChar(win.CP_UTF8, 0, cstring(rawptr(&text[0])), #c.int(n), &wide[0], #c.int(CONSOLE_CHUNK))
            if units <= 0: return false
            i64 done = 0
            for done < i64(units):
                #c.ulong wrote = 0
                if win.WriteConsoleW(handle, rawptr(&wide[done]), #c.ulong(i64(units) - done), &wrote, nil) == 0:
                    return false
                if wrote == 0: return false
                done = done + i64(wrote)
            return true

        private type Wide: [CONSOLE_CHUNK]u16

        // The held tails of the standard output's and standard error's last
        // console writes.
        private Carry out_carry
        private Carry err_carry
    else:
        private i64 stream_write(rawptr data, rawptr bytes, i64 count):
            if data == nil || bytes == nil || count <= 0:
                return 0
            Stream s = Stream(data)
            return i64(sys.fwrite(bytes, 1, #c.size_t(count), s))

    // ── position ──────────────────────────────────────────────────────────────
    //
    // `fseek` and `ftell` take and answer C's `long`, which is 64 bits on
    // Linux, macOS and the BSDs and 32 on Windows, where `_fseeki64` and
    // `_ftelli64` are the 64-bit pair. On a 32-bit POSIX target `long` is 32
    // bits too, so a position there is limited to 2 GiB.
    private foreign "stdio.h":
        const i32 SEEK_SET
        const i32 SEEK_CUR
        const i32 SEEK_END

    when #OS == #WINDOWS:
        private foreign crt "stdio.h":
            i32 _fseeki64(^FILE stream, #c.llong offset, i32 whence)
            #c.llong _ftelli64(^FILE stream)

        private i32 seek_to(^FILE stream, i64 offset, i32 whence):
            return crt._fseeki64(stream, #c.llong(offset), whence)

        private i64 position(^FILE stream):
            return i64(crt._ftelli64(stream))
    else:
        private foreign "stdio.h":
            i32 fseek(^FILE stream, #c.long offset, i32 whence)
            #c.long ftell(^FILE stream)

        private i32 seek_to(^FILE stream, i64 offset, i32 whence):
            return fseek(stream, #c.long(offset), whence)

        private i64 position(^FILE stream):
            return i64(ftell(stream))

    // Move the stream's position to `offset` bytes from `from`, answering
    // whether it moved. It clears the end-of-file flag, as C's does, and
    // fails on a stream that cannot seek: a pipe, a terminal, `nil`.
    bool seek(^FILE stream, i64 offset, Whence from):
        if stream == nil: return false
        i32 whence = SEEK_SET
        if from == Whence.Current: whence = SEEK_CUR
        if from == Whence.End: whence = SEEK_END
        return seek_to(stream, offset, whence) == 0

    // The stream's position in bytes from its start, or -1 when it has none
    // (a pipe, a terminal, `nil`).
    i64 tell(^FILE stream):
        if stream == nil: return -1
        return position(stream)

// ── on every target with streams ────────────────────────────────────────────
//
// Written once over the functions each arm above declares, so the web and a
// hosted build cannot disagree about what a line is.
when #OS != #NONE:
    // Open `path` for reading, as bytes: `open(path, "rb")`.
    os.Error!^FILE open_read(string8 path):
        try ^FILE f = open(path, "rb")
        return f

    // Open `path` for writing, created if absent and emptied if present:
    // `open(path, "wb")`.
    os.Error!^FILE open_write(string8 path):
        try ^FILE f = open(path, "wb")
        return f

    // Open `path` for writing at its end, created if absent: `open(path, "ab")`.
    os.Error!^FILE open_append(string8 path):
        try ^FILE f = open(path, "ab")
        return f

    // Write `text`, then a `\n`: 0, or `end_of_file()` when either failed.
    i32 write_line(^FILE stream, string8 text):
        i32 wrote = write(stream, text)
        if wrote < 0:
            return wrote
        if write_byte(stream, '\n') < 0:
            return end_of_file()
        return 0

    // ── streams as readers ────────────────────────────────────────────────────

    // A stream, read as a `Reader`. The stream is borrowed and must outlive
    // the reader.
    type StreamReader using Reader:
        ^FILE stream

        // What `read_bytes` reads; fails `IO` when the read failed with
        // nothing read (the stream's error flag says so).
        os.Error!i64 read(^self, []char8 into):
            // A one-slot type is its slot, so `self^` is the stream.
            ^FILE s = self^
            if s == nil || #len(into) == 0:
                return 0
            i64 n = read_bytes(s, into)
            if n == 0 && failed(s):
                fail os.Error.IO
            return n

    // A reader over `stream`, which is borrowed and must outlive the reader.
    StreamReader reader(^FILE stream):
        return (stream)

    // The process's standard input, as a reader (empty on the web).
    StreamReader stdin_reader():
        return reader(stdin())

    // ── reading a line ────────────────────────────────────────────────────────
    //
    // **The line rules, stated once**, which both readers follow:
    //
    //   * the `\n` is not kept, and a `\r` immediately before it is dropped, so
    //     a CRLF file reads the same as an LF one;
    //   * a last line with no `\n` is a line;
    //   * a blank line is an empty one, and **the end of input is a failure,
    //     `os.Error.END`**, which is what tells the two apart; a stream that
    //     failed instead fails `IO`.

    // The next line of `stream`, as new text on the ambient allocator, which
    // the caller `#delete`s. Fails `END` at the end of input, `IO` when the
    // stream failed, and `NO_MEMORY` when the line cannot be made (nothing is
    // read) or cannot grow (the rest of the line is left unread).
    os.Error!ref []char8 read_line(^FILE stream):
        ref []char8 out = #make([]char8, 0)
        if out == nil: fail os.Error.NO_MEMORY
        i32 c = read_byte(stream)
        if c == end_of_file():
            #delete(out)
            if failed(stream): fail os.Error.IO
            fail os.Error.END
        for c != end_of_file() && c != i32('\n'):
            if !#append(out, char8(c)):
                #delete(out)
                fail os.Error.NO_MEMORY
            c = read_byte(stream)
        if c == end_of_file() && failed(stream):
            #delete(out)
            fail os.Error.IO
        i64 n = #len(out)
        if n > 0 && out[n - 1] == '\r':
            #truncate(out, n - 1)
        return out

    // The next line of `stream`, into the caller's own `into`, answering how
    // many bytes landed there. Nothing is allocated, and nothing is shared
    // between two calls. Fails as `read_line` does, `END` at the end.
    //
    // A line longer than `#len(into)` is truncated and the rest of it is
    // **consumed**: the read does not stop mid-line and leave the tail to
    // arrive as a phantom next line. No terminator is written.
    os.Error!i64 read_line_into(^FILE stream, []char8 into):
        i32 c = read_byte(stream)
        if c == end_of_file():
            if failed(stream): fail os.Error.IO
            fail os.Error.END
        i64 cap = #len(into)
        i64 n = 0
        for c != end_of_file() && c != i32('\n'):
            if n < cap:
                into[n] = char8(c)
                n = n + 1
            c = read_byte(stream)
        if c == end_of_file() && failed(stream):
            fail os.Error.IO
        if n > 0 && into[n - 1] == '\r':
            n = n - 1
        return n
