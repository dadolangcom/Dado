// The Windows arm: Winsock 2. The calls are BSD sockets' with Windows'
// types, and four things differ from POSIX:
//
//   * A process starts Winsock before its first socket call (`WSAStartup`).
//     The first `sys_open` or `sys_resolve` does it and records that it did;
//     it is never undone, and Windows ends it with the process.
//   * A socket is a `SOCKET`, `UINT_PTR`: 64 bits on the 64-bit Windows Dado
//     builds for, with `INVALID_SOCKET` (all ones) for none. A real one is a
//     small number, which `Socket` holds as an `i64`. It is closed with
//     `closesocket`, made nonblocking with `ioctlsocket`, and its failures are
//     read from `WSAGetLastError`.
//   * `struct in_addr` is a union, `S_un`, whose 32-bit arm is
//     `u_long S_addr` (`s_addr` is a macro for it); `in6_addr` is a union
//     `u` whose byte arm is `Byte`; `sockaddr_in6`'s scope id sits in an
//     unnamed union. Each is restated by the member names C reaches.
//   * A timeout is a `DWORD` of milliseconds rather than a `timeval`, and a
//     receive that runs out fails `WSAETIMEDOUT`, which this arm answers as
//     `Error.WOULD_BLOCK`, as POSIX's `EAGAIN` is.
//
// No `SO_REUSEADDR`: on Windows it lets a second socket take a port another
// is listening on, which is not what it means elsewhere, and a closed
// listener's port is free at once anyway. `WIN32_LEAN_AND_MEAN` keeps
// `<windows.h>`, which other packages include, from pulling in the old
// `<winsock.h>` that conflicts with `<winsock2.h>`.
//
// Nothing in this file carries `#assert_raises`: every function here calls
// the system through a `foreign` declaration or holds a `#c.*` value or a
// `rawptr`, the C boundary a script does not cross.
package net

when #OS == #WINDOWS:
    private foreign "winsock2.h" define "WIN32_LEAN_AND_MEAN=1" define "NetSockAddr=struct sockaddr" define "NetWsaData=WSADATA" define "NetPollFd=WSAPOLLFD" define "NetInAddr=struct in_addr" define "NetSockAddrIn=struct sockaddr_in" link "-lws2_32":
        const #c.int AF_UNSPEC
        const #c.int AF_INET
        const #c.int AF_INET6
        const #c.int SOCK_STREAM
        const #c.int SOCK_DGRAM
        const #c.int SOL_SOCKET
        const #c.int SO_RCVTIMEO
        const #c.int SO_SNDTIMEO
        const #c.int SO_ERROR
        const #c.int IPPROTO_TCP
        const #c.int IPPROTO_IPV6
        const #c.int TCP_NODELAY
        const #c.int SD_RECEIVE
        const #c.int SD_SEND
        const #c.int SD_BOTH
        const #c.int POLLRDNORM
        const #c.int POLLWRNORM
        const #c.uintptr_t INVALID_SOCKET

        const #c.int WSAEWOULDBLOCK
        const #c.int WSAEINPROGRESS
        const #c.int WSAEALREADY
        const #c.int WSAEINTR
        const #c.int WSAECONNREFUSED
        const #c.int WSAECONNRESET
        const #c.int WSAECONNABORTED
        const #c.int WSAETIMEDOUT
        const #c.int WSAEADDRINUSE
        const #c.int WSAEADDRNOTAVAIL
        const #c.int WSAENETUNREACH
        const #c.int WSAEHOSTUNREACH
        const #c.int WSAENETDOWN
        const #c.int WSAENETRESET
        const #c.int WSAENOTCONN
        const #c.int WSAESHUTDOWN
        const #c.int WSAEACCES
        const #c.int WSAEMFILE
        const #c.int WSAENOBUFS
        const #c.int WSAEAFNOSUPPORT
        const #c.int WSAEPFNOSUPPORT
        const #c.int WSAEPROTONOSUPPORT
        const #c.int WSAEMSGSIZE
        const #c.int WSAEINVAL
        const #c.int WSAENOTSOCK
        const #c.int WSAEISCONN
        const #c.int WSAEOPNOTSUPP
        const #c.int WSANOTINITIALISED
        const #c.int WSAHOST_NOT_FOUND
        const #c.int WSATRY_AGAIN
        const #c.int WSANO_RECOVERY
        const #c.int WSANO_DATA

        // The 64-bit layout: `iMaxSockets`, `iMaxUdpDg` and `lpVendorInfo`
        // come before the two strings under `_WIN64`.
        type NetWsaData: (u16 wVersion, u16 wHighVersion, u16 iMaxSockets, u16 iMaxUdpDg,
                          ^#c.char lpVendorInfo, [257]#c.char szDescription,
                          [129]#c.char szSystemStatus)
        // Never a value here: only what a pointer to an address is passed as.
        type NetSockAddr
        type NetInAddr: ((#c.ulong S_addr) S_un)
        type NetSockAddrIn: (#c.short sin_family, u16 sin_port, NetInAddr sin_addr, [8]#c.char sin_zero)
        type NetPollFd: (#c.uintptr_t fd, #c.short events, #c.short revents)

    // The calls, bound as `wsock`, because this package declares `accept` and
    // `shutdown` of its own.
    private foreign wsock "winsock2.h" define "WIN32_LEAN_AND_MEAN=1":
        #c.int WSAStartup(u16 version, ^NetWsaData data)
        #c.int WSAGetLastError()
        #c.uintptr_t socket(#c.int af, #c.int kind, #c.int protocol)
        #c.int bind(#c.uintptr_t s, ^const NetSockAddr name, #c.int size)
        #c.int listen(#c.uintptr_t s, #c.int backlog)
        #c.uintptr_t accept(#c.uintptr_t s, ^NetSockAddr addr, ^#c.int size)
        #c.int connect(#c.uintptr_t s, ^const NetSockAddr name, #c.int size)
        #c.int recv(#c.uintptr_t s, ^#c.char into, #c.int count, #c.int flags)
        #c.int send(#c.uintptr_t s, ^const #c.char from, #c.int count, #c.int flags)
        #c.int recvfrom(#c.uintptr_t s, ^#c.char into, #c.int count, #c.int flags, ^NetSockAddr from, ^#c.int size)
        #c.int sendto(#c.uintptr_t s, ^const #c.char from, #c.int count, #c.int flags, ^const NetSockAddr to, #c.int size)
        #c.int shutdown(#c.uintptr_t s, #c.int how)
        #c.int closesocket(#c.uintptr_t s)
        #c.int ioctlsocket(#c.uintptr_t s, #c.long cmd, ^#c.ulong arg)
        #c.int setsockopt(#c.uintptr_t s, #c.int level, #c.int name, ^const #c.char value, #c.int size)
        #c.int getsockopt(#c.uintptr_t s, #c.int level, #c.int name, ^#c.char value, ^#c.int size)
        #c.int getsockname(#c.uintptr_t s, ^NetSockAddr name, ^#c.int size)
        #c.int getpeername(#c.uintptr_t s, ^NetSockAddr name, ^#c.int size)
        #c.int WSAPoll(^NetPollFd fds, #c.ulong count, #c.int timeout)
        u16 htons(u16 x)
        u16 ntohs(u16 x)
        #c.ulong htonl(#c.ulong x)
        #c.ulong ntohl(#c.ulong x)

    private foreign "ws2tcpip.h" define "NetIn6Addr=struct in6_addr" define "NetSockAddrIn6=struct sockaddr_in6" define "NetAddrInfo=struct addrinfo":
        const #c.int IPV6_V6ONLY
        type NetIn6Addr: (([16]u8 Byte) u)
        type NetSockAddrIn6: (#c.short sin6_family, u16 sin6_port, #c.ulong sin6_flowinfo,
                              NetIn6Addr sin6_addr, #c.ulong sin6_scope_id)
        type NetAddrInfo: (#c.int ai_flags, #c.int ai_family, #c.int ai_socktype, #c.int ai_protocol,
                           #c.size_t ai_addrlen, ^#c.char ai_canonname, ^NetSockAddr ai_addr,
                           ^NetAddrInfo ai_next)
        #c.int getaddrinfo(cstring host, cstring service, ^const NetAddrInfo hints, ^^NetAddrInfo found)
        void freeaddrinfo(^NetAddrInfo found)

    // `FIONBIO`, `_IOW('f', 126, u_long)`: 0x8004667E, whose top bit makes the
    // header's expression an `unsigned long` while `ioctlsocket` takes a
    // `long`. Written here as the `long` with the same bits.
    private const #c.long FIONBIO_CMD = -2147195266

    // The `(struct sockaddr *)` casts, and the views of the byte buffers the
    // calls read and write, spelled with types' names.
    private type SockAddrIn: ^const NetSockAddr
    private type SockAddrOut: ^NetSockAddr
    private type In4Ptr: ^NetSockAddrIn
    private type In6Ptr: ^NetSockAddrIn6
    private type CharIn: ^const #c.char
    private type CharOut: ^#c.char

    // Whether this process has started Winsock.
    private bool g_started

    // The most bytes one call hands Winsock, whose counts are `int`s.
    private const i64 CALL_MAX = 1073741824

    // ── errors ────────────────────────────────────────────────────────────

    // Fail with the `Error` a Winsock error means. It always fails.
    private Error!void fail_wsa(#c.int e):
        if e == WSAEWOULDBLOCK || e == WSAEINPROGRESS || e == WSAEALREADY:
            fail Error.WOULD_BLOCK
        if e == WSAECONNREFUSED: fail Error.REFUSED
        if e == WSAECONNRESET || e == WSAENETRESET: fail Error.RESET
        if e == WSAECONNABORTED: fail Error.ABORTED
        if e == WSAETIMEDOUT: fail Error.TIMED_OUT
        if e == WSAEADDRINUSE: fail Error.ADDRESS_IN_USE
        if e == WSAEADDRNOTAVAIL: fail Error.ADDRESS_UNAVAILABLE
        if e == WSAENETUNREACH || e == WSAEHOSTUNREACH || e == WSAENETDOWN:
            fail Error.UNREACHABLE
        if e == WSAENOTCONN: fail Error.NOT_CONNECTED
        if e == WSAESHUTDOWN: fail Error.CLOSED
        if e == WSAEACCES: fail Error.PERMISSION
        if e == WSAEMFILE || e == WSAENOBUFS || e == WSANOTINITIALISED:
            fail Error.NO_RESOURCES
        if e == WSAEAFNOSUPPORT || e == WSAEPFNOSUPPORT || e == WSAEPROTONOSUPPORT:
            fail Error.FAMILY_UNSUPPORTED
        if e == WSAEINTR: fail Error.INTERRUPTED
        if e == WSAEMSGSIZE: fail Error.TOO_LARGE
        if e == WSAEINVAL || e == WSAENOTSOCK || e == WSAEISCONN || e == WSAEOPNOTSUPP:
            fail Error.INVALID
        if e == WSAHOST_NOT_FOUND || e == WSANO_DATA: fail Error.NOT_FOUND
        if e == WSATRY_AGAIN || e == WSANO_RECOVERY: fail Error.DNS_FAILED
        fail Error.UNKNOWN

    // Fail with this thread's last Winsock error.
    private Error!void fail_last():
        try fail_wsa(wsock.WSAGetLastError())

    // Fail with the last error of a read or a write, where a timeout that ran
    // out is `Error.WOULD_BLOCK`, as it is on POSIX.
    private Error!void fail_io():
        #c.int e = wsock.WSAGetLastError()
        if e == WSAETIMEDOUT:
            fail Error.WOULD_BLOCK
        try fail_wsa(e)

    // Start Winsock 2.2 once per process.
    private Error!void start():
        if g_started:
            return
        NetWsaData data
        #c.int rc = wsock.WSAStartup(514, &data)
        if rc != 0:
            try fail_wsa(rc)
        g_started = true

    // ── addresses ─────────────────────────────────────────────────────────

    // The bytes of a buffer as the pointer a call takes; nil when empty.
    private rawptr bytes_of([]u8 b):
        if #len(b) == 0:
            return nil
        return rawptr(&b[0])

    // A byte count as the `int` Winsock takes, at most `CALL_MAX`.
    private #c.int count_of([]u8 b):
        i64 n = #len(b)
        if n > CALL_MAX:
            n = CALL_MAX
        return #c.int(n)

    // An IPv4 socket address.
    private NetSockAddrIn sockaddr4(Ip ip, u16 port):
        #c.ulong v = #c.ulong(u32(ip.bytes[0]) << 24 | u32(ip.bytes[1]) << 16 | u32(ip.bytes[2]) << 8 | u32(ip.bytes[3]))
        NetSockAddrIn a
        a.sin_family = #c.short(AF_INET)
        a.sin_port = wsock.htons(port)
        a.sin_addr.S_un.S_addr = wsock.htonl(v)
        return a

    // An IPv6 socket address.
    private NetSockAddrIn6 sockaddr6(Ip ip, u16 port):
        NetSockAddrIn6 a
        a.sin6_family = #c.short(AF_INET6)
        a.sin6_port = wsock.htons(port)
        a.sin6_addr.u.Byte = ip.bytes
        a.sin6_scope_id = #c.ulong(ip.zone)
        return a

    // The endpoint a `sockaddr_in6`-sized buffer holds, read as the
    // `sockaddr_in` it is when its family is IPv4.
    private Error!Endpoint endpoint_from(^NetSockAddrIn6 holder):
        #c.int family = #c.int(holder^.sin6_family)
        if family == AF_INET6:
            return (ipv6(holder^.sin6_addr.u.Byte, u32(holder^.sin6_scope_id)), wsock.ntohs(holder^.sin6_port))
        if family == AF_INET:
            ^NetSockAddrIn a = In4Ptr(rawptr(holder))
            u32 v = u32(wsock.ntohl(a^.sin_addr.S_un.S_addr))
            Ip ip = ipv4(u8(v >> 24), u8((v >> 16) & 255), u8((v >> 8) & 255), u8(v & 255))
            return (ip, wsock.ntohs(a^.sin_port))
        fail Error.FAMILY_UNSUPPORTED

    // Set an `int`-sized socket option; answers `setsockopt`'s status.
    private #c.int set_option(#c.uintptr_t s, #c.int level, #c.int name, #c.ulong value):
        #c.ulong v = value
        return wsock.setsockopt(s, level, name, CharIn(rawptr(&v)), #c.int(#size(#c.ulong)))

    // Make a socket blocking (`false`) or nonblocking (`true`).
    private Error!void nonblocking(#c.uintptr_t s, bool on):
        #c.ulong mode = 1 if on else 0
        if wsock.ioctlsocket(s, FIONBIO_CMD, &mode) != 0:
            try fail_last()

    // ── the calls ─────────────────────────────────────────────────────────

    private Error!i64 sys_open(Family family, bool stream):
        try start()
        #c.int af = AF_INET if family == Family.V4 else AF_INET6
        #c.int kind = SOCK_STREAM if stream else SOCK_DGRAM
        #c.uintptr_t s = wsock.socket(af, kind, 0)
        if s == INVALID_SOCKET:
            try fail_last()
            return -1
        if family == Family.V6:
            _ = set_option(s, IPPROTO_IPV6, IPV6_V6ONLY, 1)
        return i64(s)

    private void sys_close(i64 h):
        if h >= 0:
            _ = wsock.closesocket(#c.uintptr_t(h))

    // Nothing to do: see the file's comment.
    private Error!void sys_reuse(i64 h):
        _ = h

    private Error!void sys_bind(i64 h, Endpoint at):
        #c.int rc = 0
        if at.ip.family == Family.V4:
            NetSockAddrIn a = sockaddr4(at.ip, at.port)
            rc = wsock.bind(#c.uintptr_t(h), SockAddrIn(rawptr(&a)), #c.int(#size(NetSockAddrIn)))
        else:
            NetSockAddrIn6 a = sockaddr6(at.ip, at.port)
            rc = wsock.bind(#c.uintptr_t(h), SockAddrIn(rawptr(&a)), #c.int(#size(NetSockAddrIn6)))
        if rc != 0:
            try fail_last()

    private Error!void sys_listen(i64 h, i32 backlog):
        if wsock.listen(#c.uintptr_t(h), #c.int(backlog)) != 0:
            try fail_last()

    // Accept one connection, made blocking whatever the listener is: Winsock
    // copies the listener's mode, and this package answers the same on every
    // system.
    private Error!i64 sys_accept(i64 h):
        #c.uintptr_t c = wsock.accept(#c.uintptr_t(h), nil, nil)
        if c == INVALID_SOCKET:
            try fail_io()
            return -1
        try nonblocking(c, false) else why:
            _ = wsock.closesocket(c)
            fail why
        return i64(c)

    private Error!void sys_connect(i64 h, Endpoint to):
        #c.int rc = 0
        if to.ip.family == Family.V4:
            NetSockAddrIn a = sockaddr4(to.ip, to.port)
            rc = wsock.connect(#c.uintptr_t(h), SockAddrIn(rawptr(&a)), #c.int(#size(NetSockAddrIn)))
        else:
            NetSockAddrIn6 a = sockaddr6(to.ip, to.port)
            rc = wsock.connect(#c.uintptr_t(h), SockAddrIn(rawptr(&a)), #c.int(#size(NetSockAddrIn6)))
        if rc != 0:
            try fail_last()

    // How a nonblocking connect ended, once `wait` says it has. `WSAPoll`
    // before Windows 10 version 2004 does not report a refused connect, so
    // there a refusal shows as the timeout running out.
    private Error!void sys_connect_result(i64 h):
        #c.int err = 0
        #c.int size = #c.int(#size(#c.int))
        if wsock.getsockopt(#c.uintptr_t(h), SOL_SOCKET, SO_ERROR, CharOut(rawptr(&err)), &size) != 0:
            try fail_last()
        if err != 0:
            try fail_wsa(err)

    private Error!i64 sys_recv(i64 h, []u8 into):
        #c.int n = wsock.recv(#c.uintptr_t(h), CharOut(bytes_of(into)), count_of(into), 0)
        if n < 0:
            try fail_io()
        return i64(n)

    private Error!i64 sys_send(i64 h, []u8 from):
        #c.int n = wsock.send(#c.uintptr_t(h), CharIn(bytes_of(from)), count_of(from), 0)
        if n < 0:
            try fail_io()
        return i64(n)

    private Error!i64 sys_send_to(i64 h, []u8 data, Endpoint to):
        #c.int n = 0
        if to.ip.family == Family.V4:
            NetSockAddrIn a = sockaddr4(to.ip, to.port)
            n = wsock.sendto(#c.uintptr_t(h), CharIn(bytes_of(data)), count_of(data), 0, SockAddrIn(rawptr(&a)), #c.int(#size(NetSockAddrIn)))
        else:
            NetSockAddrIn6 a = sockaddr6(to.ip, to.port)
            n = wsock.sendto(#c.uintptr_t(h), CharIn(bytes_of(data)), count_of(data), 0, SockAddrIn(rawptr(&a)), #c.int(#size(NetSockAddrIn6)))
        if n < 0:
            try fail_io()
        return i64(n)

    private Error!Datagram sys_recv_from(i64 h, []u8 into):
        NetSockAddrIn6 from
        #c.int size = #c.int(#size(NetSockAddrIn6))
        #c.int n = wsock.recvfrom(#c.uintptr_t(h), CharOut(bytes_of(into)), count_of(into), 0, SockAddrOut(rawptr(&from)), &size)
        if n < 0:
            try fail_io()
        try Endpoint sender = endpoint_from(&from)
        return (i64(n), sender)

    private Error!void sys_shutdown(i64 h, Shut how):
        #c.int which = SD_BOTH
        if how == Shut.Read:
            which = SD_RECEIVE
        else if how == Shut.Write:
            which = SD_SEND
        if wsock.shutdown(#c.uintptr_t(h), which) != 0:
            try fail_last()

    private Error!Endpoint sys_name(i64 h, bool peer):
        NetSockAddrIn6 name
        #c.int size = #c.int(#size(NetSockAddrIn6))
        #c.int rc = 0
        if peer:
            rc = wsock.getpeername(#c.uintptr_t(h), SockAddrOut(rawptr(&name)), &size)
        else:
            rc = wsock.getsockname(#c.uintptr_t(h), SockAddrOut(rawptr(&name)), &size)
        if rc != 0:
            try fail_last()
        return endpoint_from(&name)

    private Error!void sys_set_nonblocking(i64 h, bool on):
        return nonblocking(#c.uintptr_t(h), on)

    private Error!void sys_set_timeout(i64 h, bool reading, i32 ms):
        if ms < 0:
            fail Error.INVALID
        #c.int name = SO_RCVTIMEO if reading else SO_SNDTIMEO
        if set_option(#c.uintptr_t(h), SOL_SOCKET, name, #c.ulong(ms)) != 0:
            try fail_last()

    private Error!void sys_set_nodelay(i64 h, bool on):
        #c.ulong value = 1 if on else 0
        if set_option(#c.uintptr_t(h), IPPROTO_TCP, TCP_NODELAY, value) != 0:
            try fail_last()

    // `WSAPoll` on one socket. An error or a hang-up counts as ready, so the
    // next call reports it.
    private Error!bool sys_wait(i64 h, Ready what, i32 timeout_ms):
        #c.int events = POLLRDNORM if what == Ready.Read else POLLWRNORM
        NetPollFd p = (#c.uintptr_t(h), #c.short(events), 0)
        #c.int rc = wsock.WSAPoll(&p, 1, #c.int(timeout_ms))
        if rc < 0:
            try fail_last()
        return rc > 0

    // Ask Windows' resolver for `host`'s addresses, one per address.
    private Error!ref []Ip sys_resolve(string8 host):
        try start()
        i64 n = #len(host)
        ref []char8 name = #make([]char8, n + 1)
        if name == nil:
            fail Error.NO_RESOURCES
        defer #delete(name)
        for i in 0..<n:
            name[i] = host[i]
        name[n] = 0

        NetAddrInfo hints
        hints.ai_family = AF_UNSPEC
        hints.ai_socktype = SOCK_STREAM
        ^NetAddrInfo found = nil
        #c.int rc = getaddrinfo(cstring(name), nil, &hints, &found)
        if rc != 0:
            try fail_wsa(rc)
        defer freeaddrinfo(found)

        ref []Ip list = #make([]Ip, 0)
        ^NetAddrInfo at = found
        for at != nil:
            ^NetAddrInfo here = at
            at = at^.ai_next
            if here^.ai_addr == nil:
                continue
            try Endpoint ep = endpoint_from(In6Ptr(rawptr(here^.ai_addr))) else:
                continue
            if !add_unique(&list, ep.ip):
                #delete(list)
                fail Error.NO_RESOURCES
        if #len(list) == 0:
            #delete(list)
            fail Error.NOT_FOUND
        return list
