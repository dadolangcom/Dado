// The layouts of macOS and the BSDs. They agree with each other on the
// address structs and disagree with Linux: `sockaddr_in` and `sockaddr_in6`
// open with a one-byte length and a one-byte family, and `in6_addr`'s bytes
// are the `__u6_addr8` arm of a union named `__u6_addr`. They disagree with
// each other on four smaller things, restated one arm per system below:
//
//   * `sin_zero` is `char` on macOS and FreeBSD and `int8_t` on OpenBSD and
//     NetBSD.
//   * `addrinfo` puts `ai_canonname` before `ai_addr` on macOS, FreeBSD and
//     NetBSD, and after it on OpenBSD (as glibc does).
//   * `timeval`'s seconds are `long` on macOS and `int64_t` on the BSDs; its
//     microseconds are `int` on macOS and NetBSD and `long` on FreeBSD and
//     OpenBSD. These are the 64-bit layouts, the ones Dado builds for.
//   * macOS has no `MSG_NOSIGNAL`, and keeps `SIGPIPE` away with
//     `SO_NOSIGPIPE` on each socket instead; the BSDs have the flag.
//
// `nfds_t` is `unsigned int` on all four. These arms are checked against each
// system's headers by the layout assertions the emitter writes; this package's
// tests run on Linux.
//
// Nothing in this file carries `#assert_raises`: every function here calls
// the system through a `foreign` declaration or holds a `#c.*` value or a
// `rawptr`, the C boundary a script does not cross.
package net

when #OS == #DARWIN || #OS == #FREEBSD || #OS == #OPENBSD || #OS == #NETBSD:
    private foreign "netinet/in.h" define "_DARWIN_C_SOURCE=1" define "NetInAddr=struct in_addr" define "NetIn6Addr=struct in6_addr" define "NetSockAddrIn6=struct sockaddr_in6":
        type NetInAddr: (u32 s_addr)
        type NetIn6Addr: (([16]u8 __u6_addr8) __u6_addr)
        type NetSockAddrIn6: (u8 sin6_len, u8 sin6_family, u16 sin6_port, u32 sin6_flowinfo,
                              NetIn6Addr sin6_addr, u32 sin6_scope_id)

    private foreign bpoll "poll.h" define "_DARWIN_C_SOURCE=1":
        #c.int poll(^NetPollFd fds, #c.uint count, #c.int timeout)

    // An IPv6 socket address; `port` is in network order.
    private NetSockAddrIn6 sockaddr6(NetIn6Addr addr, u16 port, u32 scope):
        return (u8(#size(NetSockAddrIn6)), u8(psock.AF_INET6), port, 0, addr, scope)

    // Sixteen bytes as an `in6_addr`.
    private NetIn6Addr in6_of([16]u8 bytes):
        NetIn6Addr a
        a.__u6_addr.__u6_addr8 = bytes
        return a

    // An `in6_addr`'s sixteen bytes.
    private [16]u8 in6_bytes(NetIn6Addr a):
        return a.__u6_addr.__u6_addr8

    // `poll` on one descriptor.
    private #c.int poll_one(^NetPollFd p, #c.int timeout_ms):
        return bpoll.poll(p, 1, timeout_ms)

when #OS == #DARWIN:
    private foreign "netinet/in.h" define "_DARWIN_C_SOURCE=1" define "NetSockAddrIn=struct sockaddr_in":
        type NetSockAddrIn: (u8 sin_len, u8 sin_family, u16 sin_port, NetInAddr sin_addr, [8]#c.char sin_zero)

    private foreign "netdb.h" define "_DARWIN_C_SOURCE=1" define "NetAddrInfo=struct addrinfo":
        type NetAddrInfo: (#c.int ai_flags, #c.int ai_family, #c.int ai_socktype, #c.int ai_protocol,
                           #c.uint ai_addrlen, ^#c.char ai_canonname, ^psock.NetSockAddr ai_addr,
                           ^NetAddrInfo ai_next)

    private foreign "sys/time.h" define "_DARWIN_C_SOURCE=1" define "NetTimeVal=struct timeval":
        type NetTimeVal: (#c.long tv_sec, #c.int tv_usec)

    private foreign "sys/socket.h" define "_DARWIN_C_SOURCE=1":
        const #c.int SO_NOSIGPIPE

    // An IPv4 socket address; `s_addr` and `port` are in network order.
    private NetSockAddrIn sockaddr4(u32 s_addr, u16 port):
        return (u8(#size(NetSockAddrIn)), u8(psock.AF_INET), port, NetInAddr(s_addr), [0, 0, 0, 0, 0, 0, 0, 0])

    // A timeout of `ms` milliseconds.
    private NetTimeVal timeval_ms(i32 ms):
        return (#c.long(ms / 1000), #c.int((ms % 1000) * 1000))

    // macOS's `send` has no flag for it; each socket carries the suppression.
    private #c.int send_flags():
        return 0

    private void suppress_sigpipe(#c.int fd):
        _ = set_int_option(fd, psock.SOL_SOCKET, SO_NOSIGPIPE, 1)

else when #OS == #FREEBSD:
    private foreign "netinet/in.h" define "NetSockAddrIn=struct sockaddr_in":
        type NetSockAddrIn: (u8 sin_len, u8 sin_family, u16 sin_port, NetInAddr sin_addr, [8]#c.char sin_zero)

    private foreign "netdb.h" define "NetAddrInfo=struct addrinfo":
        type NetAddrInfo: (#c.int ai_flags, #c.int ai_family, #c.int ai_socktype, #c.int ai_protocol,
                           #c.uint ai_addrlen, ^#c.char ai_canonname, ^psock.NetSockAddr ai_addr,
                           ^NetAddrInfo ai_next)

    private foreign "sys/time.h" define "NetTimeVal=struct timeval":
        type NetTimeVal: (i64 tv_sec, #c.long tv_usec)

    private foreign "sys/socket.h":
        const #c.int MSG_NOSIGNAL

    // An IPv4 socket address; `s_addr` and `port` are in network order.
    private NetSockAddrIn sockaddr4(u32 s_addr, u16 port):
        return (u8(#size(NetSockAddrIn)), u8(psock.AF_INET), port, NetInAddr(s_addr), [0, 0, 0, 0, 0, 0, 0, 0])

    // A timeout of `ms` milliseconds.
    private NetTimeVal timeval_ms(i32 ms):
        return (i64(ms / 1000), #c.long((ms % 1000) * 1000))

    // FreeBSD keeps `SIGPIPE` away on every `send`.
    private #c.int send_flags():
        return MSG_NOSIGNAL

    // Nothing to set on the socket: `send_flags` does it per call.
    private void suppress_sigpipe(#c.int fd):
        _ = fd

else when #OS == #OPENBSD:
    private foreign "netinet/in.h" define "NetSockAddrIn=struct sockaddr_in":
        type NetSockAddrIn: (u8 sin_len, u8 sin_family, u16 sin_port, NetInAddr sin_addr, [8]i8 sin_zero)

    private foreign "netdb.h" define "NetAddrInfo=struct addrinfo":
        type NetAddrInfo: (#c.int ai_flags, #c.int ai_family, #c.int ai_socktype, #c.int ai_protocol,
                           #c.uint ai_addrlen, ^psock.NetSockAddr ai_addr, ^#c.char ai_canonname,
                           ^NetAddrInfo ai_next)

    private foreign "sys/time.h" define "NetTimeVal=struct timeval":
        type NetTimeVal: (i64 tv_sec, #c.long tv_usec)

    private foreign "sys/socket.h":
        const #c.int MSG_NOSIGNAL

    // An IPv4 socket address; `s_addr` and `port` are in network order.
    private NetSockAddrIn sockaddr4(u32 s_addr, u16 port):
        return (u8(#size(NetSockAddrIn)), u8(psock.AF_INET), port, NetInAddr(s_addr), [0, 0, 0, 0, 0, 0, 0, 0])

    // A timeout of `ms` milliseconds.
    private NetTimeVal timeval_ms(i32 ms):
        return (i64(ms / 1000), #c.long((ms % 1000) * 1000))

    // OpenBSD keeps `SIGPIPE` away on every `send`.
    private #c.int send_flags():
        return MSG_NOSIGNAL

    // Nothing to set on the socket: `send_flags` does it per call.
    private void suppress_sigpipe(#c.int fd):
        _ = fd

else when #OS == #NETBSD:
    private foreign "netinet/in.h" define "NetSockAddrIn=struct sockaddr_in":
        type NetSockAddrIn: (u8 sin_len, u8 sin_family, u16 sin_port, NetInAddr sin_addr, [8]i8 sin_zero)

    private foreign "netdb.h" define "NetAddrInfo=struct addrinfo":
        type NetAddrInfo: (#c.int ai_flags, #c.int ai_family, #c.int ai_socktype, #c.int ai_protocol,
                           #c.uint ai_addrlen, ^#c.char ai_canonname, ^psock.NetSockAddr ai_addr,
                           ^NetAddrInfo ai_next)

    private foreign "sys/time.h" define "NetTimeVal=struct timeval":
        type NetTimeVal: (i64 tv_sec, #c.int tv_usec)

    private foreign "sys/socket.h":
        const #c.int MSG_NOSIGNAL

    // An IPv4 socket address; `s_addr` and `port` are in network order.
    private NetSockAddrIn sockaddr4(u32 s_addr, u16 port):
        return (u8(#size(NetSockAddrIn)), u8(psock.AF_INET), port, NetInAddr(s_addr), [0, 0, 0, 0, 0, 0, 0, 0])

    // A timeout of `ms` milliseconds.
    private NetTimeVal timeval_ms(i32 ms):
        return (i64(ms / 1000), #c.int((ms % 1000) * 1000))

    // NetBSD keeps `SIGPIPE` away on every `send`.
    private #c.int send_flags():
        return MSG_NOSIGNAL

    // Nothing to set on the socket: `send_flags` does it per call.
    private void suppress_sigpipe(#c.int fd):
        _ = fd
