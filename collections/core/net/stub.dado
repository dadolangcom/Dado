// The arm for targets with no sockets: `#WEB`, `#NONE`, and the bare WASI and
// Emscripten toolchains. Every function the rest of the package calls is here,
// and each fails `Error.UNSUPPORTED`. A browser page reaches the network
// through `fetch` and WebSocket, which carry HTTP and nothing a socket API
// could wrap; node has sockets, but gives none of them to a WebAssembly
// module; and bare metal has no network stack at all.
//
// Each stub is pure Dado, and promised with `#assert_raises` here. The public
// functions that call them are not promised, because on the other targets
// they reach the system.
package net

when #OS == #WEB || #OS == #NONE || #OS == #WASI || #OS == #EMSCRIPTEN:
    // No socket can be opened here.
    #assert_raises
    private Error!i64 sys_open(Family family, bool stream):
        _ = family
        _ = stream
        fail Error.UNSUPPORTED

    // Nothing to close: no socket was ever opened.
    #assert_raises
    private void sys_close(i64 h):
        _ = h

    // Never reached: `sys_open` failed first.
    #assert_raises
    private Error!void sys_reuse(i64 h):
        _ = h
        fail Error.UNSUPPORTED

    // Never reached: `sys_open` failed first.
    #assert_raises
    private Error!void sys_bind(i64 h, Endpoint at):
        _ = h
        _ = at
        fail Error.UNSUPPORTED

    // Never reached: `sys_open` failed first.
    #assert_raises
    private Error!void sys_listen(i64 h, i32 backlog):
        _ = h
        _ = backlog
        fail Error.UNSUPPORTED

    // No socket to accept on.
    #assert_raises
    private Error!i64 sys_accept(i64 h):
        _ = h
        fail Error.UNSUPPORTED

    // Never reached: `sys_open` failed first.
    #assert_raises
    private Error!void sys_connect(i64 h, Endpoint to):
        _ = h
        _ = to
        fail Error.UNSUPPORTED

    // Never reached: `sys_open` failed first.
    #assert_raises
    private Error!void sys_connect_result(i64 h):
        _ = h
        fail Error.UNSUPPORTED

    // No socket to read.
    #assert_raises
    private Error!i64 sys_recv(i64 h, []u8 into):
        _ = h
        _ = into
        fail Error.UNSUPPORTED

    // No socket to write.
    #assert_raises
    private Error!i64 sys_send(i64 h, []u8 from):
        _ = h
        _ = from
        fail Error.UNSUPPORTED

    // No socket to send from.
    #assert_raises
    private Error!i64 sys_send_to(i64 h, []u8 data, Endpoint to):
        _ = h
        _ = data
        _ = to
        fail Error.UNSUPPORTED

    // No socket to receive on.
    #assert_raises
    private Error!Datagram sys_recv_from(i64 h, []u8 into):
        _ = h
        _ = into
        fail Error.UNSUPPORTED

    // No connection to shut down.
    #assert_raises
    private Error!void sys_shutdown(i64 h, Shut how):
        _ = h
        _ = how
        fail Error.UNSUPPORTED

    // No socket to name.
    #assert_raises
    private Error!Endpoint sys_name(i64 h, bool peer):
        _ = h
        _ = peer
        fail Error.UNSUPPORTED

    // No socket to change.
    #assert_raises
    private Error!void sys_set_nonblocking(i64 h, bool on):
        _ = h
        _ = on
        fail Error.UNSUPPORTED

    // No socket to change.
    #assert_raises
    private Error!void sys_set_timeout(i64 h, bool reading, i32 ms):
        _ = h
        _ = reading
        _ = ms
        fail Error.UNSUPPORTED

    // No socket to change.
    #assert_raises
    private Error!void sys_set_nodelay(i64 h, bool on):
        _ = h
        _ = on
        fail Error.UNSUPPORTED

    // No socket to wait on.
    #assert_raises
    private Error!bool sys_wait(i64 h, Ready what, i32 timeout_ms):
        _ = h
        _ = what
        _ = timeout_ms
        fail Error.UNSUPPORTED

    // No resolver to ask. A literal never gets here: `resolve` answers it.
    #assert_raises
    private Error!ref []Ip sys_resolve(string8 host):
        _ = host
        fail Error.UNSUPPORTED
