@test
// core:net's sockets over loopback, in one thread: a TCP echo with end of
// stream, a refused connect, a UDP round trip, nonblocking calls and a read
// timeout, `wait`, DNS for "localhost", and IPv6 where the machine has it.
// Every listener binds port 0 and asks which port it got, so the test takes
// no fixed port. On `#WEB` and `#NONE` it checks that each call fails
// `Error.UNSUPPORTED` and that a literal still resolves.
package net

// `got` bytes of `buf` are the text `want`.
private bool bytes_are([]u8 buf, i64 got, string8 want):
    return string8(buf[0..<got]) == want

// Text viewed as the bytes a write takes: nothing copied.
private type Bytes: []u8

// A TCP exchange over `family`'s loopback: connect, write, read, echo, end
// of stream. `false` with a printed reason on any failure.
private bool tcp_echo(Family family):
    Endpoint any = (loopback(family), 0)
    try Socket listener = tcp_listen(any, 4) else why:
        return #expect(false, "tcp_listen: ", message(why))
    defer close(listener)
    try Endpoint at = local_endpoint(listener) else why:
        return #expect(false, "local_endpoint: ", message(why))
    bool ok = #expect(at.port != 0 && same_ip(at.ip, loopback(family)), "the listener is bound to loopback on a picked port")

    try Socket client = tcp_connect(at) else why:
        return #expect(false, "tcp_connect: ", message(why))
    defer close(client)
    try Socket server = accept(listener) else why:
        return #expect(false, "accept: ", message(why))
    defer close(server)

    try Endpoint peer = peer_endpoint(server) else why:
        return #expect(false, "peer_endpoint: ", message(why))
    try Endpoint mine = local_endpoint(client) else why:
        return #expect(false, "local_endpoint(client): ", message(why))
    ok = #expect(same_endpoint(peer, mine), "the server's peer is the client's own endpoint") && ok

    try set_nodelay(client, true) else why:
        ok = #expect(false, "set_nodelay: ", message(why)) && ok

    try write_all(client, Bytes("hello, net")) else why:
        return #expect(false, "write_all: ", message(why))
    [64]u8 buf
    try i64 got = read(server, buf[:]) else why:
        return #expect(false, "read (server): ", message(why))
    ok = #expect(bytes_are(buf[:], got, "hello, net"), "the server read what the client wrote") && ok

    try i64 wrote = write(server, buf[0..<got]) else why:
        return #expect(false, "write (server): ", message(why))
    ok = #expect(wrote == got, "the echo went whole") && ok
    try got = read(client, buf[:]) else why:
        return #expect(false, "read (client): ", message(why))
    ok = #expect(bytes_are(buf[:], got, "hello, net"), "the client read the echo") && ok

    try shutdown(client, Shut.Write) else why:
        return #expect(false, "shutdown: ", message(why))
    try got = read(server, buf[:]) else why:
        return #expect(false, "read after shutdown: ", message(why))
    ok = #expect(got == 0, "the server reads end of stream after the client's shutdown") && ok
    return ok

i32 test():
    bool ok = true

    // A literal resolves on every target: it asks no one.
    try ref []Ip lit = resolve("127.0.0.1") else why:
        _ = #expect(false, "resolve(\"127.0.0.1\"): ", message(why))
        return 1
    ok = #expect(#len(lit) == 1 && same_ip(lit[0], ipv4(127, 0, 0, 1)), "resolve of a literal answers the literal") && ok
    #delete(lit)

    when #OS == #WEB || #OS == #NONE:
        Endpoint any = (loopback(Family.V4), 0)
        try Socket s = tcp_listen(any, 1) else why:
            ok = #expect(why == Error.UNSUPPORTED, "tcp_listen fails UNSUPPORTED here") && ok
            try Socket u = udp_bind(any) else why2:
                ok = #expect(why2 == Error.UNSUPPORTED, "udp_bind fails UNSUPPORTED here") && ok
                try ref []Ip names = resolve("localhost") else why3:
                    ok = #expect(why3 == Error.UNSUPPORTED, "resolve of a name fails UNSUPPORTED here") && ok
                    return 0 if ok else 1
                #delete(names)
                return 1
            close(u)
            return 1
        close(s)
        return 1

    // TCP over IPv4, and over IPv6 where this machine has it.
    ok = tcp_echo(Family.V4) && ok
    Endpoint any6 = (loopback(Family.V6), 0)
    Socket probe = Socket(-1)
    try probe = tcp_listen(any6, 1) else why:
        bool absent = why == Error.FAMILY_UNSUPPORTED || why == Error.ADDRESS_UNAVAILABLE
        ok = #expect(absent, "tcp_listen([::1]:0): ", message(why)) && ok
        probe = Socket(-1)
    if i64(probe) >= 0:
        close(probe)
        ok = tcp_echo(Family.V6) && ok

    // A port nothing listens on refuses: bind one, learn it, close it.
    Endpoint any4 = (loopback(Family.V4), 0)
    try Socket gone = tcp_listen(any4, 1) else why:
        _ = #expect(false, "tcp_listen: ", message(why))
        return 1
    try Endpoint dead = local_endpoint(gone) else:
        return 1
    close(gone)
    Socket nobody = Socket(-1)
    try nobody = tcp_connect(dead) else why:
        ok = #expect(why == Error.REFUSED, "a connect to a closed port fails REFUSED, not ", message(why)) && ok
        nobody = Socket(-1)
    if i64(nobody) >= 0:
        ok = #expect(false, "a connect to a closed port succeeded") && ok
        close(nobody)

    // `dial` by literal and by a name: the first address that answers.
    Socket dialed = Socket(-1)
    try dialed = dial("127.0.0.1", dead.port, 2000) else why:
        ok = #expect(why == Error.REFUSED, "dial to a closed port fails REFUSED, not ", message(why)) && ok
        dialed = Socket(-1)
    if i64(dialed) >= 0:
        ok = #expect(false, "dial to a closed port succeeded") && ok
        close(dialed)

    // A connect with a timeout, to a listener that is there.
    try Socket listener = tcp_listen(any4, 1) else why:
        _ = #expect(false, "tcp_listen: ", message(why))
        return 1
    defer close(listener)
    try Endpoint at = local_endpoint(listener) else:
        return 1

    // A second listener on the same endpoint is refused.
    Socket twice = Socket(-1)
    try twice = tcp_listen(at, 1) else why:
        ok = #expect(why == Error.ADDRESS_IN_USE, "a second bind fails ADDRESS_IN_USE, not ", message(why)) && ok
        twice = Socket(-1)
    if i64(twice) >= 0:
        ok = #expect(false, "a second listener bound the same endpoint") && ok
        close(twice)
    // A listener has no peer.
    bool no_peer = false
    try _ = peer_endpoint(listener) else why:
        ok = #expect(why == Error.NOT_CONNECTED, "peer_endpoint of a listener fails NOT_CONNECTED, not ", message(why)) && ok
        no_peer = true
    ok = #expect(no_peer, "peer_endpoint of a listener failed") && ok

    // `dial` reaches it by name, and the connection is accepted and closed.
    try Socket by_name = dial("localhost", at.port, 2000) else why:
        _ = #expect(false, "dial(\"localhost\"): ", message(why))
        return 1
    try Socket taken = accept(listener) else why:
        _ = #expect(false, "accept after dial: ", message(why))
        return 1
    close(taken)
    close(by_name)
    try Socket quick = tcp_connect_timeout(at, 2000) else why:
        _ = #expect(false, "tcp_connect_timeout: ", message(why))
        return 1
    defer close(quick)

    // Nonblocking: a second accept finds nothing waiting, and `wait` says so.
    try Socket first = accept(listener) else why:
        _ = #expect(false, "accept: ", message(why))
        return 1
    defer close(first)
    try set_nonblocking(listener, true) else why:
        ok = #expect(false, "set_nonblocking: ", message(why)) && ok
    Socket none = Socket(-1)
    try none = accept(listener) else why:
        ok = #expect(why == Error.WOULD_BLOCK, "accept with nothing waiting fails WOULD_BLOCK, not ", message(why)) && ok
        none = Socket(-1)
    if i64(none) >= 0:
        close(none)
    bool ready = true
    try ready = wait(listener, Ready.Read, 0) else why:
        ok = #expect(false, "wait: ", message(why)) && ok
        ready = true
    ok = #expect(!ready, "wait answers false with no connection waiting") && ok
    bool writable = false
    try writable = wait(quick, Ready.Write, 1000) else:
        writable = false
    ok = #expect(writable, "a fresh connection is ready to write") && ok

    // A read timeout runs out with nothing to read.
    try set_read_timeout(first, 50) else why:
        ok = #expect(false, "set_read_timeout: ", message(why)) && ok
    [16]u8 buf
    i64 n = -1
    try n = read(first, buf[:]) else why:
        ok = #expect(why == Error.WOULD_BLOCK, "a read that times out fails WOULD_BLOCK, not ", message(why)) && ok
        n = -1
    ok = #expect(n == -1, "the read timed out instead of answering ", n) && ok

    // UDP: one datagram each way between two sockets.
    try Socket a = udp_bind(any4) else why:
        _ = #expect(false, "udp_bind: ", message(why))
        return 1
    defer close(a)
    try Socket b = udp_bind(any4) else why:
        _ = #expect(false, "udp_bind: ", message(why))
        return 1
    defer close(b)
    try Endpoint a_at = local_endpoint(a) else:
        return 1
    try Endpoint b_at = local_endpoint(b) else:
        return 1
    try set_read_timeout(b, 2000) else:
        ok = false
    try i64 sent = send_to(a, Bytes("ping"), b_at) else why:
        _ = #expect(false, "send_to: ", message(why))
        return 1
    ok = #expect(sent == 4, "send_to sent the whole datagram") && ok
    [32]u8 dgram
    try Datagram d = recv_from(b, dgram[:]) else why:
        _ = #expect(false, "recv_from: ", message(why))
        return 1
    ok = #expect(bytes_are(dgram[:], d.size, "ping"), "recv_from got the datagram") && ok
    ok = #expect(same_endpoint(d.from, a_at), "recv_from names the sender") && ok

    // DNS: "localhost" names a loopback address.
    try ref []Ip names = resolve("localhost") else why:
        _ = #expect(false, "resolve(\"localhost\"): ", message(why))
        return 1
    bool loop = #len(names) > 0
    for k in 0..<#len(names):
        loop = loop && is_loopback(names[k])
    ok = #expect(loop, "every address of localhost is loopback") && ok
    #delete(names)
    // A name under `.invalid` never resolves (RFC 6761); without a network
    // the resolver may say it could not ask instead.
    try ref []Ip nothing = resolve("no-such-host.invalid") else why:
        ok = #expect(why == Error.NOT_FOUND || why == Error.DNS_FAILED, "resolve(\"no-such-host.invalid\") fails NOT_FOUND, not ", message(why)) && ok
        return 0 if ok else 1
    #delete(nothing)
    ok = #expect(false, "no-such-host.invalid resolved") && ok

    return 0 if ok else 1
