// The POSIX arm: Linux, macOS and the BSDs. Everything they share is here;
// the layouts they disagree about (`sockaddr_in`'s first bytes, the order of
// `addrinfo`'s members, `timeval`'s widths, `nfds_t`, how a write is kept from
// raising `SIGPIPE`) are restated in `linux.dado` and `bsd.dado`, one arm per
// system, under the same names.
//
// Each C type is declared under a name of this package's (`NetSockAddr` for
// `struct sockaddr`, and so on) through a `define`, because a C type has one
// Dado name across a whole program and `core:http` declares some of the same
// structs under names of its own. `socklen_t` is `unsigned int` on every one
// of these systems, and `ssize_t` is `long`.
//
// Nothing in this file carries `#assert_raises`: every function here calls
// the system through a `foreign` declaration or holds a `#c.*` value or a
// `rawptr`, the C boundary a script does not cross.
package net

// Written as what it is not, so a build that names no target gets this arm,
// as it gets every other package's POSIX `else` arm.
when #OS != #WINDOWS && #OS != #WEB && #OS != #NONE && #OS != #WASI && #OS != #EMSCRIPTEN:
    // Bound as `psock`, because this package declares `accept`, `shutdown`
    // and `close` of its own.
    private foreign psock "sys/socket.h" define "_DARWIN_C_SOURCE=1" define "NetSockAddr=struct sockaddr":
        const #c.int AF_UNSPEC
        const #c.int AF_INET
        const #c.int AF_INET6
        const #c.int SOCK_STREAM
        const #c.int SOCK_DGRAM
        const #c.int SOL_SOCKET
        const #c.int SO_REUSEADDR
        const #c.int SO_RCVTIMEO
        const #c.int SO_SNDTIMEO
        const #c.int SO_ERROR
        const #c.int SHUT_RD
        const #c.int SHUT_WR
        const #c.int SHUT_RDWR
        // Never a value here: only what a pointer to an address is passed as.
        type NetSockAddr
        #c.int socket(#c.int domain, #c.int kind, #c.int protocol)
        #c.int setsockopt(#c.int fd, #c.int level, #c.int name, const rawptr value, #c.uint size)
        #c.int getsockopt(#c.int fd, #c.int level, #c.int name, rawptr value, ^#c.uint size)
        #c.int bind(#c.int fd, ^const psock.NetSockAddr addr, #c.uint size)
        #c.int listen(#c.int fd, #c.int backlog)
        #c.int accept(#c.int fd, ^psock.NetSockAddr addr, ^#c.uint size)
        #c.int connect(#c.int fd, ^const psock.NetSockAddr addr, #c.uint size)
        #c.long send(#c.int fd, const rawptr from, #c.size_t count, #c.int flags)
        #c.long recv(#c.int fd, rawptr into, #c.size_t count, #c.int flags)
        #c.long sendto(#c.int fd, const rawptr from, #c.size_t count, #c.int flags, ^const psock.NetSockAddr to, #c.uint size)
        #c.long recvfrom(#c.int fd, rawptr into, #c.size_t count, #c.int flags, ^psock.NetSockAddr from, ^#c.uint size)
        #c.int shutdown(#c.int fd, #c.int how)
        #c.int getsockname(#c.int fd, ^psock.NetSockAddr addr, ^#c.uint size)
        #c.int getpeername(#c.int fd, ^psock.NetSockAddr addr, ^#c.uint size)

    private foreign "netinet/in.h" define "_DARWIN_C_SOURCE=1":
        const #c.int IPPROTO_TCP
        const #c.int IPPROTO_IPV6
        const #c.int IPV6_V6ONLY

    private foreign "netinet/tcp.h" define "_DARWIN_C_SOURCE=1":
        const #c.int TCP_NODELAY

    // Function-like macros on these systems, at least when the C compiler
    // optimises; `@macro` says the header may spell them as one.
    private foreign "arpa/inet.h" define "_DARWIN_C_SOURCE=1":
        @macro u16 htons(u16 x)
        @macro u16 ntohs(u16 x)
        @macro u32 htonl(u32 x)
        @macro u32 ntohl(u32 x)

    private foreign "fcntl.h" define "_DARWIN_C_SOURCE=1":
        const #c.int F_GETFL
        const #c.int F_SETFL
        const #c.int F_SETFD
        const #c.int FD_CLOEXEC
        const #c.int O_NONBLOCK
        // C's variadic tail: the third argument is an `int` for the commands
        // used here.
        #c.int fcntl(#c.int fd, #c.int cmd, ...)

    private foreign punistd "unistd.h" define "_DARWIN_C_SOURCE=1":
        #c.int close(#c.int fd)

    private foreign "poll.h" define "_DARWIN_C_SOURCE=1" define "NetPollFd=struct pollfd":
        const #c.int POLLIN
        const #c.int POLLOUT
        // The same three members on every POSIX system.
        type NetPollFd: (#c.int fd, #c.short events, #c.short revents)

    private foreign "netdb.h" define "_DARWIN_C_SOURCE=1":
        const #c.int EAI_AGAIN
        const #c.int EAI_FAIL
        const #c.int EAI_FAMILY
        const #c.int EAI_MEMORY
        const #c.int EAI_NONAME
        const #c.int EAI_SERVICE
        const #c.int EAI_SYSTEM
        // `NetAddrInfo` is each system's own `struct addrinfo`.
        #c.int getaddrinfo(cstring host, cstring service, ^const NetAddrInfo hints, ^^NetAddrInfo found)
        void freeaddrinfo(^NetAddrInfo found)

    // `errno` is a macro for the calling thread's own lvalue. The numbers
    // differ between Linux and the BSDs, which is why they are named here and
    // compared rather than written down.
    private foreign perrno "errno.h":
        const i32 errno
        const i32 EAGAIN
        const i32 EWOULDBLOCK
        const i32 EINPROGRESS
        const i32 EALREADY
        const i32 EINTR
        const i32 ECONNREFUSED
        const i32 ECONNRESET
        const i32 ECONNABORTED
        const i32 ETIMEDOUT
        const i32 EADDRINUSE
        const i32 EADDRNOTAVAIL
        const i32 ENETUNREACH
        const i32 EHOSTUNREACH
        const i32 ENETDOWN
        const i32 ENOTCONN
        const i32 EPIPE
        const i32 EACCES
        const i32 EPERM
        const i32 EMFILE
        const i32 ENFILE
        const i32 ENOBUFS
        const i32 ENOMEM
        const i32 EAFNOSUPPORT
        const i32 EPROTONOSUPPORT
        const i32 EMSGSIZE
        const i32 EINVAL
        const i32 EBADF
        const i32 ENOTSOCK
        const i32 EISCONN
        const i32 EOPNOTSUPP

    // How an address reaches `bind`, `connect` and `sendto`, and how the
    // buffer `accept`'s relatives fill reaches them: the `(struct sockaddr *)`
    // cast every C caller writes, spelled with a type's name.
    private type SockAddrIn: ^const psock.NetSockAddr
    private type SockAddrOut: ^psock.NetSockAddr
    // How a `sockaddr_in6` buffer is read as the `sockaddr_in` it holds when
    // the family says IPv4, and how an `addrinfo`'s address is read.
    private type In4Ptr: ^NetSockAddrIn
    private type In6Ptr: ^NetSockAddrIn6

    // ── errors ────────────────────────────────────────────────────────────

    // Fail with the `Error` an `errno` value means. It always fails; a caller
    // writes `try fail_errno(e)` where C would `return -1`.
    private Error!void fail_errno(i32 e):
        if e == perrno.EAGAIN || e == perrno.EWOULDBLOCK || e == perrno.EINPROGRESS || e == perrno.EALREADY:
            fail Error.WOULD_BLOCK
        if e == perrno.ECONNREFUSED: fail Error.REFUSED
        if e == perrno.ECONNRESET: fail Error.RESET
        if e == perrno.ECONNABORTED: fail Error.ABORTED
        if e == perrno.ETIMEDOUT: fail Error.TIMED_OUT
        if e == perrno.EADDRINUSE: fail Error.ADDRESS_IN_USE
        if e == perrno.EADDRNOTAVAIL: fail Error.ADDRESS_UNAVAILABLE
        if e == perrno.ENETUNREACH || e == perrno.EHOSTUNREACH || e == perrno.ENETDOWN:
            fail Error.UNREACHABLE
        if e == perrno.ENOTCONN: fail Error.NOT_CONNECTED
        if e == perrno.EPIPE: fail Error.CLOSED
        if e == perrno.EACCES || e == perrno.EPERM: fail Error.PERMISSION
        if e == perrno.EMFILE || e == perrno.ENFILE || e == perrno.ENOBUFS || e == perrno.ENOMEM:
            fail Error.NO_RESOURCES
        if e == perrno.EAFNOSUPPORT || e == perrno.EPROTONOSUPPORT:
            fail Error.FAMILY_UNSUPPORTED
        if e == perrno.EINTR: fail Error.INTERRUPTED
        if e == perrno.EMSGSIZE: fail Error.TOO_LARGE
        if e == perrno.EINVAL || e == perrno.EBADF || e == perrno.ENOTSOCK || e == perrno.EISCONN || e == perrno.EOPNOTSUPP:
            fail Error.INVALID
        fail Error.UNKNOWN

    // Fail with the calling thread's last failure. Called straight after the
    // call that failed, before anything else can overwrite `errno`.
    private Error!void fail_last():
        try fail_errno(perrno.errno)

    // Fail with the `Error` a `getaddrinfo` result code means.
    private Error!void fail_resolve(#c.int rc):
        if rc == EAI_NONAME: fail Error.NOT_FOUND
        if rc == EAI_AGAIN || rc == EAI_FAIL: fail Error.DNS_FAILED
        if rc == EAI_MEMORY: fail Error.NO_RESOURCES
        if rc == EAI_FAMILY: fail Error.FAMILY_UNSUPPORTED
        if rc == EAI_SERVICE: fail Error.INVALID_ADDRESS
        if rc == EAI_SYSTEM:
            try fail_last()
        fail Error.UNKNOWN

    // ── addresses ─────────────────────────────────────────────────────────

    // The bytes of a buffer as the pointer a call takes; nil when it is empty.
    private rawptr bytes_of([]u8 b):
        if #len(b) == 0:
            return nil
        return rawptr(&b[0])

    // The endpoint a `sockaddr_in6`-sized buffer holds, read as the
    // `sockaddr_in` it is when its family is IPv4. Both layouts put the
    // family at the same offset, on every one of these systems.
    private Error!Endpoint endpoint_from(^NetSockAddrIn6 holder):
        #c.int family = #c.int(holder^.sin6_family)
        if family == psock.AF_INET6:
            return (ipv6(in6_bytes(holder^.sin6_addr), holder^.sin6_scope_id), ntohs(holder^.sin6_port))
        if family == psock.AF_INET:
            ^NetSockAddrIn a = In4Ptr(rawptr(holder))
            u32 v = ntohl(a^.sin_addr.s_addr)
            Ip ip = ipv4(u8(v >> 24), u8((v >> 16) & 255), u8((v >> 8) & 255), u8(v & 255))
            return (ip, ntohs(a^.sin_port))
        fail Error.FAMILY_UNSUPPORTED

    // The `s_addr` of an IPv4 address, in network order.
    private u32 in4_of(Ip ip):
        return htonl(u32(ip.bytes[0]) << 24 | u32(ip.bytes[1]) << 16 | u32(ip.bytes[2]) << 8 | u32(ip.bytes[3]))

    // ── the calls ─────────────────────────────────────────────────────────

    // Set an `int` socket option; answers `setsockopt`'s status. `bsd.dado`
    // calls this rather than `psock.setsockopt`: a call through a bound
    // `foreign` block's name resolves only in the file that binds it, though
    // its constants and types resolve from every file of the package.
    private #c.int set_int_option(#c.int fd, #c.int level, #c.int name, #c.int value):
        #c.int v = value
        return psock.setsockopt(fd, level, name, rawptr(&v), #c.uint(#size(#c.int)))

    // A new socket of a family, stream (TCP) or datagram (UDP). Closed across
    // `exec`, kept from raising `SIGPIPE` where that is a socket's property,
    // and IPv6-only for IPv6.
    private Error!i64 sys_open(Family family, bool stream):
        #c.int domain = psock.AF_INET if family == Family.V4 else psock.AF_INET6
        #c.int kind = psock.SOCK_STREAM if stream else psock.SOCK_DGRAM
        #c.int fd = psock.socket(domain, kind, 0)
        if fd < 0:
            try fail_last()
        _ = fcntl(fd, F_SETFD, FD_CLOEXEC)
        suppress_sigpipe(fd)
        if family == Family.V6:
            _ = set_int_option(fd, IPPROTO_IPV6, IPV6_V6ONLY, 1)
        return i64(fd)

    // Close a descriptor; a negative one is no socket and is left alone.
    private void sys_close(i64 h):
        if h >= 0:
            _ = punistd.close(#c.int(h))

    // Let a listener bind an address a previous one closed a moment ago.
    private Error!void sys_reuse(i64 h):
        if set_int_option(#c.int(h), psock.SOL_SOCKET, psock.SO_REUSEADDR, 1) != 0:
            try fail_last()

    private Error!void sys_bind(i64 h, Endpoint at):
        #c.int rc = 0
        if at.ip.family == Family.V4:
            NetSockAddrIn a = sockaddr4(in4_of(at.ip), htons(at.port))
            rc = psock.bind(#c.int(h), SockAddrIn(rawptr(&a)), #c.uint(#size(NetSockAddrIn)))
        else:
            NetSockAddrIn6 a = sockaddr6(in6_of(at.ip.bytes), htons(at.port), at.ip.zone)
            rc = psock.bind(#c.int(h), SockAddrIn(rawptr(&a)), #c.uint(#size(NetSockAddrIn6)))
        if rc != 0:
            try fail_last()

    private Error!void sys_listen(i64 h, i32 backlog):
        if psock.listen(#c.int(h), #c.int(backlog)) != 0:
            try fail_last()

    // Accept one connection, made blocking whatever the listener is: Linux
    // gives an accepted socket no `O_NONBLOCK` and the BSDs copy the
    // listener's, and this package answers the same on both.
    private Error!i64 sys_accept(i64 h):
        #c.int c = psock.accept(#c.int(h), nil, nil)
        if c < 0:
            try fail_last()
        _ = fcntl(c, F_SETFD, FD_CLOEXEC)
        suppress_sigpipe(c)
        #c.int fl = fcntl(c, F_GETFL, 0)
        if fl >= 0 && (fl & O_NONBLOCK) != 0:
            _ = fcntl(c, F_SETFL, fl & ~O_NONBLOCK)
        return i64(c)

    // Connect; a nonblocking socket answers `Error.WOULD_BLOCK` while the
    // connection is under way.
    private Error!void sys_connect(i64 h, Endpoint to):
        #c.int rc = 0
        if to.ip.family == Family.V4:
            NetSockAddrIn a = sockaddr4(in4_of(to.ip), htons(to.port))
            rc = psock.connect(#c.int(h), SockAddrIn(rawptr(&a)), #c.uint(#size(NetSockAddrIn)))
        else:
            NetSockAddrIn6 a = sockaddr6(in6_of(to.ip.bytes), htons(to.port), to.ip.zone)
            rc = psock.connect(#c.int(h), SockAddrIn(rawptr(&a)), #c.uint(#size(NetSockAddrIn6)))
        if rc != 0:
            try fail_last()

    // How a nonblocking connect ended, once `wait` says it has.
    private Error!void sys_connect_result(i64 h):
        #c.int err = 0
        #c.uint size = #c.uint(#size(#c.int))
        if psock.getsockopt(#c.int(h), psock.SOL_SOCKET, psock.SO_ERROR, rawptr(&err), &size) != 0:
            try fail_last()
        if err != 0:
            try fail_errno(i32(err))

    private Error!i64 sys_recv(i64 h, []u8 into):
        #c.long n = psock.recv(#c.int(h), bytes_of(into), #c.size_t(#len(into)), 0)
        if n < 0:
            try fail_last()
        return i64(n)

    private Error!i64 sys_send(i64 h, []u8 from):
        #c.long n = psock.send(#c.int(h), bytes_of(from), #c.size_t(#len(from)), send_flags())
        if n < 0:
            try fail_last()
        return i64(n)

    private Error!i64 sys_send_to(i64 h, []u8 data, Endpoint to):
        #c.long n = 0
        if to.ip.family == Family.V4:
            NetSockAddrIn a = sockaddr4(in4_of(to.ip), htons(to.port))
            n = psock.sendto(#c.int(h), bytes_of(data), #c.size_t(#len(data)), 0, SockAddrIn(rawptr(&a)), #c.uint(#size(NetSockAddrIn)))
        else:
            NetSockAddrIn6 a = sockaddr6(in6_of(to.ip.bytes), htons(to.port), to.ip.zone)
            n = psock.sendto(#c.int(h), bytes_of(data), #c.size_t(#len(data)), 0, SockAddrIn(rawptr(&a)), #c.uint(#size(NetSockAddrIn6)))
        if n < 0:
            try fail_last()
        return i64(n)

    private Error!Datagram sys_recv_from(i64 h, []u8 into):
        NetSockAddrIn6 from
        #c.uint size = #c.uint(#size(NetSockAddrIn6))
        #c.long n = psock.recvfrom(#c.int(h), bytes_of(into), #c.size_t(#len(into)), 0, SockAddrOut(rawptr(&from)), &size)
        if n < 0:
            try fail_last()
        try Endpoint sender = endpoint_from(&from)
        return (i64(n), sender)

    private Error!void sys_shutdown(i64 h, Shut how):
        #c.int which = psock.SHUT_RDWR
        if how == Shut.Read:
            which = psock.SHUT_RD
        else if how == Shut.Write:
            which = psock.SHUT_WR
        if psock.shutdown(#c.int(h), which) != 0:
            try fail_last()

    // The local (`peer` false) or remote end of a socket.
    private Error!Endpoint sys_name(i64 h, bool peer):
        NetSockAddrIn6 name
        #c.uint size = #c.uint(#size(NetSockAddrIn6))
        #c.int rc = 0
        if peer:
            rc = psock.getpeername(#c.int(h), SockAddrOut(rawptr(&name)), &size)
        else:
            rc = psock.getsockname(#c.int(h), SockAddrOut(rawptr(&name)), &size)
        if rc != 0:
            try fail_last()
        return endpoint_from(&name)

    private Error!void sys_set_nonblocking(i64 h, bool on):
        #c.int fl = fcntl(#c.int(h), F_GETFL, 0)
        if fl < 0:
            try fail_last()
        #c.int want = fl | O_NONBLOCK if on else fl & ~O_NONBLOCK
        if want != fl && fcntl(#c.int(h), F_SETFL, want) != 0:
            try fail_last()

    private Error!void sys_set_timeout(i64 h, bool reading, i32 ms):
        if ms < 0:
            fail Error.INVALID
        NetTimeVal tv = timeval_ms(ms)
        #c.int name = psock.SO_RCVTIMEO if reading else psock.SO_SNDTIMEO
        if psock.setsockopt(#c.int(h), psock.SOL_SOCKET, name, rawptr(&tv), #c.uint(#size(NetTimeVal))) != 0:
            try fail_last()

    private Error!void sys_set_nodelay(i64 h, bool on):
        if set_int_option(#c.int(h), IPPROTO_TCP, TCP_NODELAY, 1 if on else 0) != 0:
            try fail_last()

    // `poll` on one descriptor. An error or a hang-up counts as ready, so the
    // next call reports it.
    private Error!bool sys_wait(i64 h, Ready what, i32 timeout_ms):
        #c.int events = POLLIN if what == Ready.Read else POLLOUT
        NetPollFd p = (#c.int(h), #c.short(events), 0)
        #c.int rc = poll_one(&p, #c.int(timeout_ms))
        if rc < 0:
            try fail_last()
        return rc > 0

    // Ask the system's resolver for `host`'s addresses, one per address.
    private Error!ref []Ip sys_resolve(string8 host):
        i64 n = #len(host)
        ref []char8 name = #make([]char8, n + 1)
        if name == nil:
            fail Error.NO_RESOURCES
        defer #delete(name)
        for i in 0..<n:
            name[i] = host[i]
        name[n] = 0

        // One answer per address: asking for streams keeps the resolver from
        // repeating each for every socket type.
        NetAddrInfo hints
        hints.ai_family = psock.AF_UNSPEC
        hints.ai_socktype = psock.SOCK_STREAM
        ^NetAddrInfo found = nil
        #c.int rc = getaddrinfo(cstring(name), nil, &hints, &found)
        if rc != 0:
            try fail_resolve(rc)
        defer freeaddrinfo(found)

        ref []Ip list = #make([]Ip, 0)
        ^NetAddrInfo at = found
        for at != nil:
            ^NetAddrInfo here = at
            at = at^.ai_next
            if here^.ai_addr == nil:
                continue
            try Endpoint ep = endpoint_from(In6Ptr(rawptr(here^.ai_addr))) else:
                continue
            if !add_unique(&list, ep.ip):
                #delete(list)
                fail Error.NO_RESOURCES
        if #len(list) == 0:
            #delete(list)
            fail Error.NOT_FOUND
        return list
