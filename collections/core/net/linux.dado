// Linux's layouts and its one difference in behaviour. glibc's
// `sockaddr_in` opens with a two-byte family and has no length byte;
// `in6_addr`'s bytes are the `__u6_addr8` arm of a union named `__in6_u`
// (`s6_addr` is a macro for it); `addrinfo` puts `ai_addr` before
// `ai_canonname`; `timeval` is two `long`s; `nfds_t` is `unsigned long`. A
// write is kept from raising `SIGPIPE` with `MSG_NOSIGNAL` on each `send`.
//
// These are glibc's spellings, the C library a Linux build here links. musl
// names the union `__in6_union`, and a musl target would fail the layout
// check at `NetIn6Addr` by name rather than build wrong.
//
// Nothing in this file carries `#assert_raises`: every function here calls
// the system through a `foreign` declaration or holds a `#c.*` value or a
// `rawptr`, the C boundary a script does not cross.
package net

// Every POSIX target `bsd.dado` does not take, so a build that names no
// target gets Linux's layouts, as `posix.dado` gets it the POSIX arm.
when #OS != #WINDOWS && #OS != #DARWIN && #OS != #FREEBSD && #OS != #OPENBSD && #OS != #NETBSD && #OS != #WEB && #OS != #NONE && #OS != #WASI && #OS != #EMSCRIPTEN:
    private foreign "netinet/in.h" define "NetInAddr=struct in_addr" define "NetIn6Addr=struct in6_addr" define "NetSockAddrIn=struct sockaddr_in" define "NetSockAddrIn6=struct sockaddr_in6":
        type NetInAddr: (u32 s_addr)
        type NetIn6Addr: (([16]u8 __u6_addr8) __in6_u)
        type NetSockAddrIn: (u16 sin_family, u16 sin_port, NetInAddr sin_addr, [8]u8 sin_zero)
        type NetSockAddrIn6: (u16 sin6_family, u16 sin6_port, u32 sin6_flowinfo, NetIn6Addr sin6_addr,
                              u32 sin6_scope_id)

    // glibc declares `struct addrinfo` and `getaddrinfo` only from POSIX 2001
    // on, and a `-std=c11` build asks for no POSIX level at all until a
    // feature macro does. `core:time` and `core:threads` name the same level.
    private foreign "netdb.h" define "_POSIX_C_SOURCE=200809L" define "NetAddrInfo=struct addrinfo":
        type NetAddrInfo: (#c.int ai_flags, #c.int ai_family, #c.int ai_socktype, #c.int ai_protocol,
                           #c.uint ai_addrlen, ^psock.NetSockAddr ai_addr, ^#c.char ai_canonname,
                           ^NetAddrInfo ai_next)

    private foreign "sys/time.h" define "NetTimeVal=struct timeval":
        type NetTimeVal: (#c.long tv_sec, #c.long tv_usec)

    private foreign lpoll "poll.h":
        #c.int poll(^NetPollFd fds, #c.ulong count, #c.int timeout)

    private foreign "sys/socket.h":
        const #c.int MSG_NOSIGNAL

    // An IPv4 socket address; `s_addr` and `port` are in network order.
    private NetSockAddrIn sockaddr4(u32 s_addr, u16 port):
        return (u16(psock.AF_INET), port, NetInAddr(s_addr), [0, 0, 0, 0, 0, 0, 0, 0])

    // An IPv6 socket address; `port` is in network order.
    private NetSockAddrIn6 sockaddr6(NetIn6Addr addr, u16 port, u32 scope):
        return (u16(psock.AF_INET6), port, 0, addr, scope)

    // Sixteen bytes as an `in6_addr`.
    private NetIn6Addr in6_of([16]u8 bytes):
        NetIn6Addr a
        a.__in6_u.__u6_addr8 = bytes
        return a

    // An `in6_addr`'s sixteen bytes.
    private [16]u8 in6_bytes(NetIn6Addr a):
        return a.__in6_u.__u6_addr8

    // A timeout of `ms` milliseconds.
    private NetTimeVal timeval_ms(i32 ms):
        return (#c.long(ms / 1000), #c.long((ms % 1000) * 1000))

    // `poll` on one descriptor.
    private #c.int poll_one(^NetPollFd p, #c.int timeout_ms):
        return lpoll.poll(p, 1, timeout_ms)

    // Linux keeps `SIGPIPE` away on every `send`.
    private #c.int send_flags():
        return MSG_NOSIGNAL

    // Nothing to set on the socket: `send_flags` does it per call.
    private void suppress_sigpipe(#c.int fd):
        _ = fd
