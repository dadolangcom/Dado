@test
// core:net — proof the `Reliable`/`Unreliable` class surface actually moves
// bytes over `vendor:enet`, the same "a real client/server exchange, not a
// struct round-trip" standard `enet_test.dado` set for the layer underneath.
// A different loopback port from `vendor:enet`'s own test (17771) so the two
// never collide if a future harness ever ran them in the same process.
package net

private bool bytes_equal([]u8 a, []u8 b, i32 n):
    for i in 0..<n:
        if a[i] != b[i]:
            return false
    return true

i32 test():
    bool ok = true

    ok = #expect(init(), "net.init()") && ok
    if !ok:
        return 1
    defer shutdown()

    Host server = host_server(17772, 4)
    ok = #expect(host_valid(server), "host_server(17772) — port busy?") && ok
    if !ok:
        return 1
    defer host_destroy(server)

    Host client = host_client(1)
    ok = #expect(host_valid(client), "host_client(1)") && ok
    if !ok:
        return 1
    defer host_destroy(client)

    Peer client_peer = connect(client, "127.0.0.1", 17772)
    ok = #expect(client_peer != nil, "connect(\"127.0.0.1\", 17772)") && ok
    if !ok:
        return 1

    // ── drive both sides until each has its own Connect event ───────────
    bool client_connected = false
    bool server_connected = false
    Peer server_peer = nil
    i32 rounds = 0
    for rounds < 100 && !(client_connected && server_connected):
        Event cev = poll(client, 10, #default)
        if cev.kind == Kind.Connect:
            client_connected = true
        Event sev = poll(server, 10, #default)
        if sev.kind == Kind.Connect:
            server_connected = true
            server_peer = sev.peer
        rounds = rounds + 1
    ok = #expect(client_connected, "client saw Kind.Connect within 1s") && ok
    ok = #expect(server_connected, "server saw Kind.Connect within 1s") && ok
    ok = #expect(server_peer != nil, "server's Connect event named a peer") && ok

    // ── Reliable: client -> server, exact bytes ──────────────────────────
    [9]u8 reliable_payload = [112, 105, 110, 103, 45, 110, 101, 116, 49]  // "ping-net1"
    bool sent = send(client_peer, Class.Reliable, reliable_payload[:])
    ok = #expect(sent, "send(Reliable)") && ok
    flush(client)

    bool got_reliable = false
    rounds = 0
    for rounds < 100 && !got_reliable:
        Event sev = poll(server, 10, #default)
        if sev.kind == Kind.Receive:
            got_reliable = true
            ok = #expect(#len(sev.data) == 9, "Reliable payload length round-tripped, got ", #len(sev.data)) && ok
            ok = #expect(bytes_equal(sev.data[:], reliable_payload[:], 9), "Reliable payload bytes round-tripped exactly") && ok
            #delete(sev.data)
        rounds = rounds + 1
    ok = #expect(got_reliable, "server saw Kind.Receive (Reliable) within 1s") && ok

    // ── Unreliable: server -> client, exact bytes (loopback, so expected
    // to arrive — this is the channel/flag plumbing under test, not ENet's
    // own delivery guarantees) ───────────────────────────────────────────
    [7]u8 unreliable_payload = [112, 111, 110, 103, 45, 117, 49]  // "pong-u1"
    sent = send(server_peer, Class.Unreliable, unreliable_payload[:])
    ok = #expect(sent, "send(Unreliable)") && ok
    flush(server)

    bool got_unreliable = false
    rounds = 0
    for rounds < 100 && !got_unreliable:
        Event cev = poll(client, 10, #default)
        if cev.kind == Kind.Receive:
            got_unreliable = true
            ok = #expect(#len(cev.data) == 7, "Unreliable payload length round-tripped, got ", #len(cev.data)) && ok
            ok = #expect(bytes_equal(cev.data[:], unreliable_payload[:], 7), "Unreliable payload bytes round-tripped exactly") && ok
            #delete(cev.data)
        rounds = rounds + 1
    ok = #expect(got_unreliable, "client saw Kind.Receive (Unreliable) within 1s") && ok

    // ── broadcast: server -> every peer (just the one here) ─────────────
    [4]u8 broadcast_payload = [98, 99, 97, 115]  // "bcas"
    broadcast(server, Class.Reliable, broadcast_payload[:])
    flush(server)

    bool got_broadcast = false
    rounds = 0
    for rounds < 100 && !got_broadcast:
        Event cev = poll(client, 10, #default)
        if cev.kind == Kind.Receive:
            got_broadcast = true
            ok = #expect(bytes_equal(cev.data[:], broadcast_payload[:], 4), "broadcast payload bytes round-tripped exactly") && ok
            #delete(cev.data)
        rounds = rounds + 1
    ok = #expect(got_broadcast, "client saw the broadcast within 1s") && ok

    // ── graceful disconnect ───────────────────────────────────────────────
    disconnect(client_peer)
    bool client_saw_disconnect = false
    rounds = 0
    for rounds < 60 && !client_saw_disconnect:
        Event cev = poll(client, 10, #default)
        if cev.kind == Kind.Disconnect:
            client_saw_disconnect = true
        poll(server, 10, #default)
        rounds = rounds + 1
    ok = #expect(client_saw_disconnect, "client saw its own Kind.Disconnect within 600ms") && ok

    ok = #expect(host_peer_count(server) <= 1, "server peer count sane post-disconnect, got ", host_peer_count(server)) && ok

    if ok:
        return 0
    return 1
