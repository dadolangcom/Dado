// core:net: IPv4 and IPv6 addresses, DNS, and TCP and UDP sockets.
//
//     import "core:net"
//
//     try net.Endpoint at = net.parse_endpoint("127.0.0.1:8080") else why:
//         fmt.println(net.message(why))
//         return 1
//     try net.Socket listener = net.tcp_listen(at, 16)
//     defer net.close(listener)
//     try net.Socket conn = net.accept(listener)
//     defer net.close(conn)
//     [512]u8 buf
//     try i64 n = net.read(conn, buf[:])
//     try net.write_all(conn, buf[0..<n])
//
// An address is an `Ip`, IPv4 or IPv6 by its `family`, and a socket address
// is an `Endpoint`: an `Ip` and a port. `parse_ip`, `parse_endpoint`,
// `format_ip` and `format_endpoint` convert them to and from text, and
// `resolve` asks DNS for a name's addresses. A `Socket` is a TCP listener, a
// TCP connection or a UDP socket, opened by `tcp_listen`, `accept`,
// `tcp_connect`, `dial` (a name or an address, resolved and tried in turn)
// or `udp_bind`, and ended by `close`.
//
// Sockets block until they can finish, unless `set_nonblocking` says
// otherwise or a timeout from `set_read_timeout` or `set_write_timeout` runs
// out first; `wait` asks whether a socket is ready, and `tcp_connect_timeout`
// gives up on a peer that does not answer. An IPv6 socket here carries IPv6
// alone (`IPV6_V6ONLY` is set), so a program serving both families opens one
// socket for each, the same on every system.
//
// **Tier N W H; sockets H only.** The address types, their parsing and
// formatting, and `message` are pure Dado and work on every target. Sockets
// and DNS run on Linux, macOS, the BSDs and Windows, each with an arm of its
// own where the systems differ (`posix.dado`, `windows.dado`). On `#WEB` and
// `#NONE` every function builds, and every socket call and every DNS lookup
// fails `Error.UNSUPPORTED` (`stub.dado`): neither a page nor node gives a
// WebAssembly module raw TCP or UDP, and bare metal has no network stack.
// `resolve` of an address literal answers on every target, because it asks no
// one.
//
// **Errors.** Every failable function fails with a member of `Error`, the
// same member for the same cause on every system: each arm translates its
// own number (`errno`, a `getaddrinfo` code, `WSAGetLastError`) at the moment
// of failure, and a number the table does not know is `Error.UNKNOWN`.
// `message(why)` is a sentence for a person.
//
// **What raises into a script.** The pure half: `ipv4`, `ipv6`, `loopback`,
// `unspecified`, `is_loopback`, `same_ip`, `same_endpoint`, the parsers and
// formatters, and `message`, each promised by the `#assert_raises` above it.
// Every socket function and `resolve` calls the system through a `foreign`
// declaration, which is the C boundary a script does not cross; on the web,
// where they are Dado stubs, the promise still could not be made, because a
// promise holds for every target the package builds for.
//
// **Thread-safety.** No function here shares state but one: the first socket
// call on Windows starts Winsock (`WSAStartup`) and records it. Two threads
// doing that at once each start it, which Winsock counts and allows. A
// `Socket` may be read on one thread and written on another; two threads
// reading one socket get the bytes in an order nobody chose.
package net

// ── errors ────────────────────────────────────────────────────────────────

// Why a call failed. The numbers start at 1001, apart from `core:os`'s.
distinct enum i32 Error:
    // This target has no sockets: `#WEB` or `#NONE`.
    UNSUPPORTED = 1001,
    // The text is not an address, an endpoint or a port.
    INVALID_ADDRESS,
    // DNS has no address for the name.
    NOT_FOUND,
    // DNS did not answer: no server reached, or it failed for now.
    DNS_FAILED,
    // Nothing was listening at the endpoint.
    REFUSED,
    // The peer reset the connection.
    RESET,
    // The connection was aborted on this side, by the system.
    ABORTED,
    // The peer did not answer in time.
    TIMED_OUT,
    // The socket is nonblocking and the call would have had to wait, or a read
    // or write timeout ran out first.
    WOULD_BLOCK,
    // Another socket is bound to the endpoint.
    ADDRESS_IN_USE,
    // The address is not one of this machine's, so nothing can bind to it.
    ADDRESS_UNAVAILABLE,
    // No route to the network or the host.
    UNREACHABLE,
    // The socket is not connected.
    NOT_CONNECTED,
    // The connection is closed for writing: the peer went away, or this side
    // shut it down.
    CLOSED,
    // The system refused: a privileged port, or a firewall rule.
    PERMISSION,
    // The process or the system ran out of sockets, buffers or memory.
    NO_RESOURCES,
    // This machine does not do this address family (often: no IPv6).
    FAMILY_UNSUPPORTED,
    // A signal interrupted the call before it finished.
    INTERRUPTED,
    // The datagram is larger than the socket can send in one piece.
    TOO_LARGE,
    // The socket is not open, or the argument makes no sense for it.
    INVALID,
    // The system failed for a reason this table does not name.
    UNKNOWN = 1099,

// A sentence for `why`, for a person reading a tool's output.
#assert_raises
string8 message(Error why):
    if why == Error.UNSUPPORTED: return "this target has no sockets (a web page, node or bare metal)"
    if why == Error.INVALID_ADDRESS: return "not an IP address, endpoint or port"
    if why == Error.NOT_FOUND: return "DNS has no address for that name"
    if why == Error.DNS_FAILED: return "DNS did not answer: check the network, then try again"
    if why == Error.REFUSED: return "connection refused: nothing is listening there"
    if why == Error.RESET: return "the peer reset the connection"
    if why == Error.ABORTED: return "the connection was aborted on this machine"
    if why == Error.TIMED_OUT: return "the peer did not answer in time"
    if why == Error.WOULD_BLOCK: return "not ready: the socket would have had to wait, or its timeout ran out"
    if why == Error.ADDRESS_IN_USE: return "the address is already in use by another socket"
    if why == Error.ADDRESS_UNAVAILABLE: return "the address is not one of this machine's"
    if why == Error.UNREACHABLE: return "no route to that network or host"
    if why == Error.NOT_CONNECTED: return "the socket is not connected"
    if why == Error.CLOSED: return "the connection is closed for writing"
    if why == Error.PERMISSION: return "permission denied: a privileged port, or a firewall rule"
    if why == Error.NO_RESOURCES: return "out of sockets, buffers or memory"
    if why == Error.FAMILY_UNSUPPORTED: return "this machine does not support that address family (no IPv6?)"
    if why == Error.INTERRUPTED: return "a signal interrupted the call: try it again"
    if why == Error.TOO_LARGE: return "the datagram is too large to send in one piece"
    if why == Error.INVALID: return "the socket is not open, or the argument makes no sense for it"
    if why == Error.UNKNOWN: return "the network call failed for a reason this program does not recognise"
    return "not a core:net error"

// ── addresses ─────────────────────────────────────────────────────────────

// An address family.
enum i32 Family:
    V4,
    V6,

// An IP address, IPv4 or IPv6 by `family`. `bytes` are in network order: an
// IPv4 address is the first four (127.0.0.1 is 127, 0, 0, 1) and the other
// twelve are zero. `zone` is an IPv6 scope id, the `%3` of `fe80::1%3`, and 0
// for none; it is always 0 for IPv4. Build one with `ipv4`, `ipv6` or a
// parser, and compare two with `same_ip`.
type Ip: (Family family, [16]u8 bytes, u32 zone)

// An IP address and a port: where a socket is bound or connected.
type Endpoint: (Ip ip, u16 port)

// What `recv_from` answers: how many bytes arrived, and who sent them.
type Datagram: (i64 size, Endpoint from)

// The IPv4 address `a.b.c.d`.
#assert_raises
Ip ipv4(u8 a, u8 b, u8 c, u8 d):
    [16]u8 bytes
    bytes[0] = a
    bytes[1] = b
    bytes[2] = c
    bytes[3] = d
    return (Family.V4, bytes, 0)

// The IPv6 address of these sixteen bytes, in network order, in scope `zone`
// (0 for none).
#assert_raises
Ip ipv6([16]u8 bytes, u32 zone):
    return (Family.V6, bytes, zone)

// The loopback address of a family: 127.0.0.1 or ::1.
#assert_raises
Ip loopback(Family family):
    if family == Family.V4:
        return ipv4(127, 0, 0, 1)
    [16]u8 bytes
    bytes[15] = 1
    return ipv6(bytes, 0)

// The unspecified address of a family, 0.0.0.0 or ::. Bound, it means every
// local interface.
#assert_raises
Ip unspecified(Family family):
    [16]u8 bytes
    return (family, bytes, 0)

// Whether `ip` is a loopback address: anything in 127.0.0.0/8, or ::1.
#assert_raises
bool is_loopback(Ip ip):
    if ip.family == Family.V4:
        return ip.bytes[0] == 127
    for i in 0..<15:
        if ip.bytes[i] != 0:
            return false
    return ip.bytes[15] == 1

// Whether two addresses are the same: one family, the same bytes and, for
// IPv6, the same zone.
#assert_raises
bool same_ip(Ip a, Ip b):
    if a.family != b.family || a.zone != b.zone:
        return false
    i32 n = 4 if a.family == Family.V4 else 16
    for i in 0..<n:
        if a.bytes[i] != b.bytes[i]:
            return false
    return true

// Whether two endpoints are the same address and port.
#assert_raises
bool same_endpoint(Endpoint a, Endpoint b):
    return a.port == b.port && same_ip(a.ip, b.ip)

// ── parsing ───────────────────────────────────────────────────────────────

// The value of one decimal digit, or -1 for a byte that is not one.
#assert_raises
private i32 digit(char8 c):
    if c >= '0' && c <= '9':
        return i32(c - '0')
    return -1

// The value of one hex digit, either case, or -1 for a byte that is not one.
#assert_raises
private i32 hex_digit(char8 c):
    if c >= '0' && c <= '9':
        return i32(c - '0')
    if c >= 'a' && c <= 'f':
        return i32(c - 'a') + 10
    if c >= 'A' && c <= 'F':
        return i32(c - 'A') + 10
    return -1

// A dotted-quad IPv4 address: four decimal numbers from 0 to 255, separated by
// dots, with no leading zeros (`010` is refused, because some readers take it
// as octal). Fails `Error.INVALID_ADDRESS` for anything else.
#assert_raises
Error!Ip parse_ipv4(string8 text):
    [4]u8 parts
    i64 n = #len(text)
    i64 i = 0
    for p in 0..<4:
        if p > 0:
            if i >= n || text[i] != '.':
                fail Error.INVALID_ADDRESS
            i += 1
        i64 start = i
        i32 value = 0
        for i < n && digit(text[i]) >= 0:
            value = value * 10 + digit(text[i])
            i += 1
            if i - start > 3:
                fail Error.INVALID_ADDRESS
        i64 width = i - start
        if width == 0 || value > 255 || (width > 1 && text[start] == '0'):
            fail Error.INVALID_ADDRESS
        parts[p] = u8(value)
    if i != n:
        fail Error.INVALID_ADDRESS
    return ipv4(parts[0], parts[1], parts[2], parts[3])

// An IPv6 address in the text form of RFC 4291: eight groups of one to four
// hex digits separated by colons, one run of zero groups written `::`, and
// optionally the last 32 bits as a dotted quad (`::ffff:192.0.2.1`). A zone
// follows a `%` and is a number here (`fe80::1%3`); a zone named after an
// interface, `%eth0`, is refused, because naming it needs the system. Fails
// `Error.INVALID_ADDRESS` for anything else.
#assert_raises
Error!Ip parse_ipv6(string8 text):
    i64 n = #len(text)
    u32 zone = 0
    i64 end = n
    for i in 0..<n:
        if text[i] == '%':
            end = i
            break
    if end < n:
        if end + 1 == n || n - end - 1 > 10:
            fail Error.INVALID_ADDRESS
        u64 z = 0
        for i in end + 1..<n:
            if digit(text[i]) < 0:
                fail Error.INVALID_ADDRESS
            z = z * 10 + u64(digit(text[i]))
        if z > 4294967295:
            fail Error.INVALID_ADDRESS
        zone = u32(z)

    // Groups before the `::` go to `head`, groups after it to `tail`.
    [8]u16 head
    [8]u16 tail
    i32 hn = 0
    i32 tn = 0
    bool gap = false
    i64 i = 0
    if end >= 2 && text[0] == ':' && text[1] == ':':
        gap = true
        i = 2
    else if end >= 1 && text[0] == ':':
        fail Error.INVALID_ADDRESS
    for i < end:
        i64 j = i
        bool dotted = false
        for j < end && text[j] != ':':
            if text[j] == '.':
                dotted = true
            j += 1
        if j == i:
            fail Error.INVALID_ADDRESS
        if dotted:
            // The last 32 bits as a dotted quad, which ends the address.
            if j != end || hn + tn > 6:
                fail Error.INVALID_ADDRESS
            try Ip v4 = parse_ipv4(text[i..<j]) else:
                fail Error.INVALID_ADDRESS
            u16 hi = u16(v4.bytes[0]) << 8 | u16(v4.bytes[1])
            u16 lo = u16(v4.bytes[2]) << 8 | u16(v4.bytes[3])
            if gap:
                tail[tn] = hi
                tail[tn + 1] = lo
                tn += 2
            else:
                head[hn] = hi
                head[hn + 1] = lo
                hn += 2
            i = j
            break
        if j - i > 4 || hn + tn >= 8:
            fail Error.INVALID_ADDRESS
        u32 group = 0
        for k in i..<j:
            i32 h = hex_digit(text[k])
            if h < 0:
                fail Error.INVALID_ADDRESS
            group = group * 16 + u32(h)
        if gap:
            tail[tn] = u16(group)
            tn += 1
        else:
            head[hn] = u16(group)
            hn += 1
        if j == end:
            i = j
            break
        // text[j] is a colon: a second one opens the gap, once.
        if j + 1 < end && text[j + 1] == ':':
            if gap:
                fail Error.INVALID_ADDRESS
            gap = true
            i = j + 2
        else:
            i = j + 1
            if i == end:
                fail Error.INVALID_ADDRESS
    if gap && hn + tn > 7:
        fail Error.INVALID_ADDRESS
    if !gap && hn + tn != 8:
        fail Error.INVALID_ADDRESS

    [8]u16 groups
    for k in 0..<hn:
        groups[k] = head[k]
    for k in 0..<tn:
        groups[8 - tn + k] = tail[k]
    [16]u8 bytes
    for k in 0..<8:
        bytes[2 * k] = u8(groups[k] >> 8)
        bytes[2 * k + 1] = u8(groups[k] & 255)
    return ipv6(bytes, zone)

// An IPv4 or IPv6 address, told apart by whether the text has a colon. Fails
// `Error.INVALID_ADDRESS` for text that is neither.
#assert_raises
Error!Ip parse_ip(string8 text):
    for i in 0..<#len(text):
        if text[i] == ':':
            return parse_ipv6(text)
    return parse_ipv4(text)

// A port: a decimal number from 0 to 65535 with no sign and no spaces. Fails
// `Error.INVALID_ADDRESS` for anything else.
#assert_raises
Error!u16 parse_port(string8 text):
    i64 n = #len(text)
    if n == 0 || n > 5:
        fail Error.INVALID_ADDRESS
    u32 value = 0
    for i in 0..<n:
        if digit(text[i]) < 0:
            fail Error.INVALID_ADDRESS
        value = value * 10 + u32(digit(text[i]))
    if value > 65535:
        fail Error.INVALID_ADDRESS
    return u16(value)

// An endpoint: `192.0.2.1:80` for IPv4, `[2001:db8::1]:80` or
// `[fe80::1%3]:80` for IPv6, the brackets keeping the address's colons apart
// from the port's. Fails `Error.INVALID_ADDRESS` for anything else, an IPv6
// address without brackets included.
#assert_raises
Error!Endpoint parse_endpoint(string8 text):
    i64 n = #len(text)
    if n > 0 && text[0] == '[':
        i64 close = -1
        for i in 1..<n:
            if text[i] == ']':
                close = i
                break
        if close < 0 || close + 1 >= n || text[close + 1] != ':':
            fail Error.INVALID_ADDRESS
        try Ip ip = parse_ipv6(text[1..<close])
        try u16 port = parse_port(text[close + 2..<n])
        return (ip, port)
    i64 colon = -1
    for i in 0..<n:
        if text[i] == ':':
            if colon >= 0:
                fail Error.INVALID_ADDRESS
            colon = i
    if colon < 0:
        fail Error.INVALID_ADDRESS
    try Ip ip = parse_ipv4(text[0..<colon])
    try u16 port = parse_port(text[colon + 1..<n])
    return (ip, port)

// ── formatting ────────────────────────────────────────────────────────────

// The longest text `format_endpoint` writes: a bracketed IPv6 address with
// an embedded IPv4 tail and a ten-digit zone, and a five-digit port.
private const i64 TEXT_MAX = 64

private const string8 HEX = "0123456789abcdef"

// Write `v` in decimal into `out` at `at`; answer where the next byte goes.
#assert_raises
private i64 put_decimal([]char8 out, i64 at, u32 v):
    [10]char8 digits
    i64 n = 0
    u32 rest = v
    for:
        digits[n] = char8(u8('0') + u8(rest % 10))
        n += 1
        rest = rest / 10
        if rest == 0:
            break
    i64 w = at
    for k in 0..<n:
        out[w] = digits[n - 1 - k]
        w += 1
    return w

// Write one IPv6 group in lowercase hex, leading zeros dropped.
#assert_raises
private i64 put_group([]char8 out, i64 at, u16 g):
    i64 w = at
    bool started = false
    for shift in 0..<4:
        u16 nib = (g >> u16(12 - 4 * shift)) & 15
        if nib != 0 || started || shift == 3:
            out[w] = HEX[i64(nib)]
            w += 1
            started = true
    return w

// Write `ip` into `out` at `at` (with its `%zone` when it has one); answer
// where the next byte goes.
#assert_raises
private i64 put_ip([]char8 out, i64 at, Ip ip):
    i64 w = at
    if ip.family == Family.V4:
        for k in 0..<4:
            if k > 0:
                out[w] = '.'
                w += 1
            w = put_decimal(out, w, u32(ip.bytes[k]))
        return w
    [8]u16 g
    for k in 0..<8:
        g[k] = u16(ip.bytes[2 * k]) << 8 | u16(ip.bytes[2 * k + 1])
    // An IPv4-mapped address keeps its dotted tail, as RFC 5952 asks.
    bool mapped = g[5] == 65535
    for k in 0..<5:
        if g[k] != 0:
            mapped = false
    if mapped:
        string8 prefix = "::ffff:"
        for k in 0..<#len(prefix):
            out[w] = prefix[k]
            w += 1
        for k in 12..<16:
            if k > 12:
                out[w] = '.'
                w += 1
            w = put_decimal(out, w, u32(ip.bytes[k]))
    else:
        // The longest run of two or more zero groups becomes `::`, the first
        // such run on a tie (RFC 5952, section 4.2).
        i32 best = -1
        i32 best_len = 1
        i32 k = 0
        for k < 8:
            if g[k] != 0:
                k += 1
                continue
            i32 start = k
            for k < 8 && g[k] == 0:
                k += 1
            if k - start > best_len:
                best = start
                best_len = k - start
        k = 0
        for k < 8:
            if k == best:
                out[w] = ':'
                out[w + 1] = ':'
                w += 2
                k += best_len
                continue
            if k > 0 && k != best + best_len:
                out[w] = ':'
                w += 1
            w = put_group(out, w, g[k])
            k += 1
    if ip.zone != 0:
        out[w] = '%'
        w = put_decimal(out, w + 1, ip.zone)
    return w

// A copy of the first `n` bytes of `buf`, which the caller deletes.
#assert_raises
private Error!ref []char8 copy_text([]char8 buf, i64 n):
    ref []char8 text = #make([]char8, n)
    if text == nil:
        fail Error.NO_RESOURCES
    for k in 0..<n:
        text[k] = buf[k]
    return text

// `ip` as text: `192.0.2.1`, or IPv6 in the canonical form of RFC 5952
// (lowercase, zeros compressed, `::ffff:192.0.2.1` for a mapped address),
// with `%zone` when it has one. On `#default`; the caller deletes it. Fails
// `Error.NO_RESOURCES` when the allocation fails.
#assert_raises
Error!ref []char8 format_ip(Ip ip):
    [64]char8 buf
    i64 n = put_ip(buf[:], 0, ip)
    return copy_text(buf[:], n)

// `at` as text: `192.0.2.1:80`, or `[2001:db8::1]:80` for IPv6, which
// `parse_endpoint` reads back. On `#default`; the caller deletes it. Fails
// `Error.NO_RESOURCES` when the allocation fails.
#assert_raises
Error!ref []char8 format_endpoint(Endpoint at):
    [64]char8 buf
    i64 w = 0
    if at.ip.family == Family.V6:
        buf[0] = '['
        w = put_ip(buf[:], 1, at.ip)
        buf[w] = ']'
        w += 1
    else:
        w = put_ip(buf[:], 0, at.ip)
    buf[w] = ':'
    w = put_decimal(buf[:], w + 1, u32(at.port))
    return copy_text(buf[:], w)

// ── sockets ───────────────────────────────────────────────────────────────
//
// No function from here down carries `#assert_raises` but `add_unique`: each
// of the others reaches a `foreign` call in its system's arm (`posix.dado`,
// `windows.dado`) and holds `#c.*` values and `rawptr`s there, which is the C
// boundary a script does not cross. The promise is checked for every target
// a package builds for, so the web's Dado stubs (`stub.dado`) cannot make it
// on their own.

// An open socket: a TCP listener, a TCP connection or a UDP socket. It is the
// system's handle (a descriptor on POSIX, a `SOCKET` on Windows), kept apart
// from a bare number. End it with `close`.
distinct type Socket: i64

// Which half of a connection `shutdown` ends.
enum i32 Shut:
    // No more reading: what arrives after this is discarded.
    Read,
    // No more writing: the peer reads end of stream once it has the rest.
    Write,
    // Both.
    Both,

// What `wait` waits for.
enum i32 Ready:
    // Bytes to read, a connection to accept, or the peer's end of stream.
    Read,
    // Room to write, or a nonblocking connect finishing.
    Write,

// A TCP socket listening at `at`, with room for `backlog` connections that
// have arrived and not yet been accepted. Port 0 binds a port the system
// picks, which `local_endpoint` reports. On POSIX the address is reusable at
// once after a previous listener closes (`SO_REUSEADDR`). Fails
// `Error.ADDRESS_IN_USE` when another socket holds the endpoint,
// `Error.FAMILY_UNSUPPORTED` without IPv6, and `Error.UNSUPPORTED` on the web.
Error!Socket tcp_listen(Endpoint at, i32 backlog):
    try i64 h = sys_open(at.ip.family, true)
    try sys_reuse(h) else why:
        sys_close(h)
        fail why
    try sys_bind(h, at) else why:
        sys_close(h)
        fail why
    try sys_listen(h, backlog) else why:
        sys_close(h)
        fail why
    return Socket(h)

// The next connection waiting on `listener`, as a new socket. Blocks until one
// arrives, unless the listener is nonblocking (then `Error.WOULD_BLOCK`) or
// its read timeout runs out (also `Error.WOULD_BLOCK`).
Error!Socket accept(Socket listener):
    try i64 h = sys_accept(i64(listener))
    return Socket(h)

// A TCP connection to `to`. Blocks until the peer accepts or refuses, as long
// as the system waits for a connection (often more than a minute); use
// `tcp_connect_timeout` to wait less. Fails `Error.REFUSED` when nothing
// listens there, `Error.UNREACHABLE` or `Error.TIMED_OUT` when the peer cannot
// be reached.
Error!Socket tcp_connect(Endpoint to):
    try i64 h = sys_open(to.ip.family, true)
    try sys_connect(h, to) else why:
        sys_close(h)
        fail why
    return Socket(h)

// A TCP connection to `to`, giving up with `Error.TIMED_OUT` when the peer has
// not answered in `timeout_ms` milliseconds. The socket it answers blocks, as
// `tcp_connect`'s does.
Error!Socket tcp_connect_timeout(Endpoint to, i32 timeout_ms):
    try i64 h = sys_open(to.ip.family, true)
    try connect_within(h, to, timeout_ms) else why:
        sys_close(h)
        fail why
    return Socket(h)

// A TCP connection to `host:port`, where `host` is a name `resolve` looks up
// or an address literal: each address it names is tried in the resolver's
// order, each given `timeout_ms` milliseconds to answer, and the first that
// accepts is the connection, which blocks as `tcp_connect`'s does. Fails with
// the last address's reason (`Error.REFUSED`, `Error.TIMED_OUT`, …), or with
// `resolve`'s when the name has no address.
Error!Socket dial(string8 host, u16 port, i32 timeout_ms = 5000):
    try ref []Ip ips = resolve(host)
    defer #delete(ips)
    i64 n = #len(ips)
    if n == 0:
        fail Error.NOT_FOUND
    // Every address but the last is tried quietly; the last one's failure is
    // the answer.
    for k in 0..<n - 1:
        try Socket s = tcp_connect_timeout((ips[k], port), timeout_ms) else:
            continue
        return s
    return tcp_connect_timeout((ips[n - 1], port), timeout_ms)

// Connect `h` to `to`, nonblocking, and wait up to `timeout_ms` for it.
private Error!void connect_within(i64 h, Endpoint to, i32 timeout_ms):
    try sys_set_nonblocking(h, true)
    try sys_connect(h, to) else why:
        if why != Error.WOULD_BLOCK:
            fail why
        try bool ready = sys_wait(h, Ready.Write, timeout_ms)
        if !ready:
            fail Error.TIMED_OUT
        try sys_connect_result(h)
    try sys_set_nonblocking(h, false)

// Read what has arrived on `s` into `into`, up to its length, and answer how
// many bytes that was: 0 means the peer has finished sending (end of stream),
// or that `into` is empty. Blocks until something arrives, unless the socket
// is nonblocking or its read timeout runs out (`Error.WOULD_BLOCK` for both).
Error!i64 read(Socket s, []u8 into):
    if #len(into) == 0:
        return 0
    return sys_recv(i64(s), into)

// Write some of `from` to `s` and answer how many bytes went, which can be
// fewer than all of them; `write_all` loops. Fails `Error.CLOSED` when the
// peer has gone (no signal is raised), and `Error.WOULD_BLOCK` when the
// socket is nonblocking and full or its write timeout ran out.
Error!i64 write(Socket s, []u8 from):
    if #len(from) == 0:
        return 0
    return sys_send(i64(s), from)

// Write all of `from` to `s`, as many writes as it takes. On a failure, some
// of the bytes may have gone; the connection is then best closed.
Error!void write_all(Socket s, []u8 from):
    i64 done = 0
    i64 n = #len(from)
    for done < n:
        try i64 wrote = sys_send(i64(s), from[done..<n])
        done += wrote

// End one or both halves of a TCP connection while keeping the socket open:
// `Shut.Write` sends end of stream to the peer and is the usual way to say
// "that is all". Fails `Error.NOT_CONNECTED` on a socket with no connection.
Error!void shutdown(Socket s, Shut how):
    return sys_shutdown(i64(s), how)

// Close `s`, giving its handle back to the system. Every socket a function
// here answers is closed exactly once; a closed socket's handle may be reused
// by the next one opened.
void close(Socket s):
    sys_close(i64(s))

// A UDP socket bound to `at`; port 0 binds a port the system picks, which
// `local_endpoint` reports. Fails as `tcp_listen` does.
Error!Socket udp_bind(Endpoint at):
    try i64 h = sys_open(at.ip.family, false)
    try sys_bind(h, at) else why:
        sys_close(h)
        fail why
    return Socket(h)

// Send `data` to `to` as one datagram from the UDP socket `s`, and answer how
// many bytes went: all of them, or a failure. Fails `Error.TOO_LARGE` for a
// datagram the socket cannot send in one piece.
Error!i64 send_to(Socket s, []u8 data, Endpoint to):
    return sys_send_to(i64(s), data, to)

// Receive one datagram on the UDP socket `s` into `into`, and answer its size
// and its sender. A datagram longer than `into` is cut to fit, and the rest of
// it is lost. Blocks until one arrives, unless the socket is nonblocking or
// its read timeout runs out (`Error.WOULD_BLOCK` for both).
Error!Datagram recv_from(Socket s, []u8 into):
    return sys_recv_from(i64(s), into)

// The address and port `s` is bound to: how to find the port the system
// picked for port 0.
Error!Endpoint local_endpoint(Socket s):
    return sys_name(i64(s), false)

// The address and port of the peer `s` is connected to. Fails
// `Error.NOT_CONNECTED` on a socket with none.
Error!Endpoint peer_endpoint(Socket s):
    return sys_name(i64(s), true)

// Make `s` nonblocking (`true`) or blocking again (`false`). A call on a
// nonblocking socket that would have to wait fails `Error.WOULD_BLOCK` at
// once; `wait` says when to try again.
Error!void set_nonblocking(Socket s, bool on):
    return sys_set_nonblocking(i64(s), on)

// Give every read on `s` (and `accept` and `recv_from`) at most `ms`
// milliseconds to finish; one that runs out fails `Error.WOULD_BLOCK`. 0
// waits forever, which is how a socket starts.
Error!void set_read_timeout(Socket s, i32 ms):
    return sys_set_timeout(i64(s), true, ms)

// Give every write on `s` at most `ms` milliseconds; one that runs out fails
// `Error.WOULD_BLOCK`. 0 waits forever, which is how a socket starts.
Error!void set_write_timeout(Socket s, i32 ms):
    return sys_set_timeout(i64(s), false, ms)

// Send small writes on the TCP connection `s` at once (`true`), rather than
// holding them briefly to fill a packet (Nagle's algorithm, the default).
Error!void set_nodelay(Socket s, bool on):
    return sys_set_nodelay(i64(s), on)

// Wait up to `timeout_ms` milliseconds for `s` to be ready to read or to
// write, and answer whether it is: `false` means the time ran out. A negative
// timeout waits for as long as it takes; 0 asks and returns at once. A socket
// whose connection failed counts as ready, and the next call on it reports
// why.
Error!bool wait(Socket s, Ready what, i32 timeout_ms):
    return sys_wait(i64(s), what, timeout_ms)

// The addresses `host` names, in the order the system's resolver gives them
// (usually its preferred one first), each once. An IPv4 or IPv6 literal
// answers itself without asking anyone, on every target. The caller deletes
// the list. Fails `Error.NOT_FOUND` when DNS has no address for the name,
// `Error.DNS_FAILED` when it could not be asked, and `Error.UNSUPPORTED` for a
// name on the web.
Error!ref []Ip resolve(string8 host):
    try Ip literal = parse_ip(host) else:
        return sys_resolve(host)
    ref []Ip one = #make([]Ip, 1)
    if one == nil:
        fail Error.NO_RESOURCES
    one[0] = literal
    return one

// Append `ip` to `list` unless it is already there. `false` when the append
// could not allocate.
#assert_raises
private bool add_unique(^ref []Ip list, Ip ip):
    for k in 0..<#len(list^):
        if same_ip(list^[k], ip):
            return true
    return #append(list^, ip)
