@test
// The calendar, RFC 3339, `Stopwatch` and `Deadline`, all through their pure
// forms, so every claim here runs the same on every target and none waits on
// a clock.
//
//   * **The day count is exact**: known dates (the epoch, a leap day, the
//     year 2000, a date before the epoch), and a round trip through
//     `days_from_civil` and `civil_from_days` across two thousand years each
//     side of the epoch.
//   * **`utc` floors**, so a moment before the epoch is the second before it
//     and not the second after; and **`from_utc` checks every field**.
//   * **RFC 3339 reads the RFC's own examples**, applies an offset, reads a
//     leap second as the next second's start, and is exact at both ends of
//     what an `i64` of nanoseconds holds — and one nanosecond past either end
//     is `OUT_OF_RANGE`, not a wrapped moment.
//   * **The codes are `Error`, 2600 to 2699**, each with its own sentence, and
//     `format_rfc3339` under an allocator that refuses fails `NO_MEMORY`.
//   * **A `Stopwatch` banks what it ran for**, and a `Deadline` saturates.
package time

import "core:mem"

// An allocator that refuses everything.
private rawptr refuses_all(rawptr data, mem.AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

private (mem.Proc proc, rawptr data) refusing():
    return (refuses_all, nil)

private bool text_is(i64 nanos, string8 want):
    try ref []char8 got = format_rfc3339(nanos) else code:
        return #expect(false, "format_rfc3339(", nanos, ") failed: ", message(code))
    string8 s = got
    bool same = #expect(s == want, "format_rfc3339(", nanos, ") was ", s, ", not ", want)
    #delete(got)
    return same

private bool reads_as(string8 text, i64 want):
    try i64 got = parse_rfc3339(text) else code:
        return #expect(false, "parse_rfc3339(", text, ") failed: ", message(code))
    return #expect(got == want, "parse_rfc3339(", text, ") was ", got, ", not ", want)

private bool refuses(string8 text, Error want):
    try i64 got = parse_rfc3339(text) else code:
        return #expect(code == want, "parse_rfc3339(", text, ") failed ", message(code), ", not ", message(want))
    return #expect(false, "parse_rfc3339(", text, ") read ", got, " and should have failed")

i32 test():
    bool ok = true

    // ── the day count ────────────────────────────────────────────────────────
    ok = #expect(days_from_civil(1970, 1, 1) == 0, "the epoch is not day 0") && ok
    ok = #expect(days_from_civil(2000, 3, 1) == 11017, "2000-03-01 was ", days_from_civil(2000, 3, 1)) && ok
    ok = #expect(days_from_civil(1969, 12, 31) == -1, "the day before the epoch is not -1") && ok
    ok = #expect(days_from_civil(1600, 1, 1) == -135140, "1600-01-01 was ", days_from_civil(1600, 1, 1)) && ok
    (i64 ly, i32 lm, i32 ld) = civil_from_days(11016)
    ok = #expect(ly == 2000 && lm == 2 && ld == 29, "day 11016 was ", ly, "-", lm, "-", ld, ", not 2000-02-29") && ok

    i64 d = -730500
    bool round = true
    for d <= 730500:
        (i64 y, i32 m, i32 dd) = civil_from_days(d)
        if days_from_civil(y, m, dd) != d || m < 1 || m > 12 || dd < 1 || dd > days_in_month(y, m):
            round = #expect(false, "day ", d, " did not round trip: ", y, "-", m, "-", dd)
            break
        d = d + 37
    ok = round && ok

    ok = #expect(is_leap_year(2000) && is_leap_year(2024) && !is_leap_year(1900) && !is_leap_year(2023), "the leap-year rule is wrong") && ok
    ok = #expect(days_in_month(2024, 2) == 29 && days_in_month(2023, 2) == 28 && days_in_month(2023, 4) == 30 && days_in_month(2023, 13) == 0, "days_in_month is wrong") && ok
    ok = #expect(weekday_of_days(0) == Weekday.Thursday, "the epoch was not a Thursday") && ok
    ok = #expect(weekday_of_days(-1) == Weekday.Wednesday, "the day before the epoch was not a Wednesday") && ok
    DateTime today = (2026, 10, 8, 0, 0, 0, 0)
    ok = #expect(weekday(today) == Weekday.Thursday, "2026-10-08 was not a Thursday") && ok

    // ── utc and from_utc ─────────────────────────────────────────────────────
    DateTime before = utc(-1)
    ok = #expect(before.year == 1969 && before.month == 12 && before.day == 31 && before.hour == 23 && before.minute == 59 && before.second == 59 && before.nanosecond == 999999999, "utc(-1) is not the last nanosecond of 1969") && ok
    DateTime t = utc(1234567890123456789)
    ok = #expect(t.year == 2009 && t.month == 2 && t.day == 13 && t.hour == 23 && t.minute == 31 && t.second == 30 && t.nanosecond == 123456789, "utc(1234567890123456789) is wrong") && ok
    i64 back = 0
    try back = from_utc(t) else code:
        ok = #expect(false, "from_utc failed: ", message(code)) && ok
    ok = #expect(back == 1234567890123456789, "from_utc(utc(x)) was ", back) && ok
    DateTime feb = (2023, 2, 29, 0, 0, 0, 0)
    try _ = from_utc(feb) else code:
        ok = #expect(code == Error.INVALID_DATE, "2023-02-29 failed ", code) && ok
    DateTime far = (2263, 1, 1, 0, 0, 0, 0)
    try _ = from_utc(far) else code:
        ok = #expect(code == Error.OUT_OF_RANGE, "2263 failed ", code) && ok

    // ── RFC 3339 ─────────────────────────────────────────────────────────────
    ok = text_is(0, "1970-01-01T00:00:00Z") && ok
    ok = text_is(250000000, "1970-01-01T00:00:00.25Z") && ok
    ok = text_is(1234567890123456789, "2009-02-13T23:31:30.123456789Z") && ok
    ok = text_is(-1, "1969-12-31T23:59:59.999999999Z") && ok
    ok = text_is(I64_MAX, "2262-04-11T23:47:16.854775807Z") && ok
    ok = text_is(I64_MIN, "1677-09-21T00:12:43.145224192Z") && ok
    [8]char8 small
    try _ = put_rfc3339(0, small[0..<8]) else code:
        ok = #expect(code == Error.NO_ROOM, "a short buffer failed ", code) && ok

    // The RFC's own examples (section 5.8).
    ok = reads_as("1985-04-12T23:20:50.52Z", 482196050520000000) && ok
    ok = reads_as("1996-12-19T16:39:57-08:00", 851042397000000000) && ok
    ok = reads_as("1990-12-31T23:59:60Z", 662688000000000000) && ok
    ok = reads_as("1990-12-31T15:59:60-08:00", 662688000000000000) && ok
    ok = reads_as("1937-01-01T12:00:27.87+00:20", -1041337172130000000) && ok
    ok = reads_as("2009-02-13 23:31:30.1234567891z", 1234567890123456789) && ok
    ok = reads_as("2262-04-11T23:47:16.854775807Z", I64_MAX) && ok
    ok = reads_as("1677-09-21T00:12:43.145224192Z", I64_MIN) && ok
    ok = refuses("2262-04-11T23:47:16.854775808Z", Error.OUT_OF_RANGE) && ok
    ok = refuses("1677-09-21T00:12:43.145224191Z", Error.OUT_OF_RANGE) && ok
    ok = refuses("2023-02-29T00:00:00Z", Error.INVALID_DATE) && ok
    ok = refuses("2023-01-01T24:00:00Z", Error.INVALID_DATE) && ok
    ok = refuses("2023-01-01T00:00:00", Error.MALFORMED) && ok
    ok = refuses("2023-01-01T00:00:00.Z", Error.MALFORMED) && ok
    ok = refuses("2023-01-01X00:00:00Z", Error.MALFORMED) && ok
    ok = refuses("2023-01-01T00:00:00+0100", Error.MALFORMED) && ok
    ok = refuses("2023-01-01T00:00:00Zjunk", Error.MALFORMED) && ok
    ok = refuses("", Error.MALFORMED) && ok

    // ── Stopwatch and Deadline ───────────────────────────────────────────────
    Stopwatch w
    ok = #expect(i64(w.elapsed_at(Instant(100))) == 0, "a zero stopwatch was not at zero") && ok
    w.start_at(Instant(100))
    w.stop_at(Instant(400))
    w.stop_at(Instant(900))
    w.start_at(Instant(1000))
    ok = #expect(i64(w.elapsed_at(Instant(1050))) == 350, "the stopwatch read ", i64(w.elapsed_at(Instant(1050))), ", not 350") && ok
    w.reset()
    ok = #expect(!w.running && i64(w.elapsed_at(Instant(2000))) == 0, "reset did not stop and zero it") && ok

    Deadline soon = deadline_from(Instant(1000), nanoseconds(500))
    ok = #expect(!soon.passed_at(Instant(1499)) && soon.passed_at(Instant(1500)), "the deadline fell due at the wrong reading") && ok
    ok = #expect(i64(soon.left_at(Instant(1200))) == 300 && i64(soon.left_at(Instant(9000))) == 0, "left_at is wrong") && ok
    Deadline never = deadline_from(Instant(1000), Duration(I64_MAX))
    ok = #expect(i64(never.at) == I64_MAX, "a huge timeout did not saturate") && ok
    ok = #expect(as_seconds(minutes(2)) == 120 && as_seconds(hours(1)) == 3600, "minutes or hours is wrong") && ok

    // ── the codes ────────────────────────────────────────────────────────────
    ok = #expect(i32(Error.MALFORMED) == 2600 && i32(Error.NO_MEMORY) == 2604, "the codes left 2600 to 2699") && ok
    ok = #expect(message(Error.NO_ROOM) != message(Error.MALFORMED) && message(Error.NO_MEMORY) == "out of memory", "the sentences are wrong") && ok
    ok = #expect(message(Error(7)) == "not a core:time error code", "a foreign code was not refused") && ok
    using refusing():
        try ref []char8 none = format_rfc3339(0) else code:
            ok = #expect(code == Error.NO_MEMORY, "a refused allocation failed ", message(code)) && ok
            return 0 if ok else 1
        #delete(none)
        ok = #expect(false, "format_rfc3339 answered text under an allocator that refuses") && ok

    return 0 if ok else 1
