// core:time — measuring how long something took, and waiting.
//
//     import "core:time"
//
//     time.Instant started = time.instant()
//     build()
//     time.Duration took = time.elapsed(started)
//     println("took ", time.as_milliseconds(took), "ms")
//
//     time.sleep(time.milliseconds(250))
//
// Two clocks, and the difference between them is the whole package. The
// monotonic clock (`instant`) never goes backwards and has no meaningful
// origin, so **only differences mean anything** — it is what you measure with.
// The wall clock (`unix`, `unix_nanos`) can be set, stepped by NTP, and
// printed — it is what you stamp with. Using the second to measure is the bug
// this split exists to make hard to write.
//
// **`Duration` and `Instant` are integers of nanoseconds**, so an interval
// adds, subtracts and compares exactly, at any uptime, with no rounding. A
// reading in seconds or milliseconds is a conversion at the end:
// `as_seconds_f64(elapsed(started))`, `as_milliseconds(elapsed(started))`.
//
// **Tier W H; N in part. Script class S in part.** Built for the web, Linux,
// macOS, the BSDs and Windows, the whole package is here. Built freestanding
// (`#OS == #NONE`) there is no clock to read and nothing to wait on, so
// everything that reads one — `instant`, `elapsed`, `sleep`, `unix`,
// `unix_nanos`, `stopwatch`, `deadline` and the methods of `Stopwatch` and
// `Deadline` that read the clock — is not declared there, and a call names
// the missing function. What is arithmetic stays: `Duration`, `Instant`,
// `between`/`add`, `deadline_from`, the calendar and RFC 3339, which take
// their time as an argument.
//
// **The calendar is UTC and proleptic Gregorian**, with no time zones and no
// leap seconds, as Unix time itself has none. `utc` turns nanoseconds since
// the epoch into a `DateTime` and `from_utc` turns one back;
// `days_from_civil` and `civil_from_days` are the day count underneath, valid
// for any year an `i64` of days can hold. `format_rfc3339` and `put_rfc3339`
// write the timestamp form of RFC 3339 in UTC (`2026-10-08T14:03:07.25Z`),
// and `parse_rfc3339` reads one with any offset and answers it in UTC.
//
// **Measuring and timing out.** A `Stopwatch` adds up the intervals it ran
// for and can be stopped and started again; a `Deadline` is an `Instant` a
// timeout away, which a loop asks whether it has passed and how long is left.
// Each has `_at` forms that take the current `Instant` as an argument, so the
// arithmetic can be tested, and run in a script, without a clock.
//
// **Failure: `Error`, 2600 to 2699**, a range no other package's codes use.
// `from_utc`, `put_rfc3339`, `format_rfc3339` and `parse_rfc3339` are
// `Error!`, and `message(why)` answers a sentence for each code:
//
// * `MALFORMED` — the text is not an RFC 3339 timestamp.
// * `INVALID_DATE` — a field is out of its range: a 13th month, a 31st of
//   April, a 61st second.
// * `OUT_OF_RANGE` — the moment is outside what an `i64` of nanoseconds holds
//   (1677-09-21 to 2262-04-11), or a year RFC 3339 cannot write (0000 to 9999).
// * `NO_ROOM` — the buffer handed to `put_rfc3339` is too short; `RFC3339_MAX`
//   bytes always suffice.
// * `NO_MEMORY` — `format_rfc3339`'s allocation failed.
//
// **What raises into a script.** Everything written in Dado alone is promised
// by the `#assert_raises` on the line above it: the `Duration` constructors
// and readers, `between` and `add`, the calendar, RFC 3339 and `message`, and
// the `_at` methods of `Stopwatch` and `Deadline` and `Stopwatch.reset`. What
// reads a clock or waits is
// not: each platform's clock is a foreign call (`clock_gettime`,
// `QueryPerformanceCounter`, the web host's `performance.now()`), and a
// script reads its own clock.
//
// **Thread-safety.** No package state: every function is safe from any
// thread. A `Stopwatch` is a plain value, one thread at a time per value.
//
// **One arm per platform**, each written against that platform's own clock
// API: POSIX's `clock_gettime` and `nanosleep`, Win32's
// `QueryPerformanceCounter`, `GetSystemTimePreciseAsFileTime` and `Sleep`,
// and the web runtime's host calls. Each arm supplies the same three private
// primitives — `mono_ns`, `wall_ns` and `wait_ns` — and everything public is
// written once, below the arms, over those three.
//
// **No `.c` beside this file.** There used to be one — `sysclock.c`, with
// `sysclock.h` over it — and its stated reason was that `clock_gettime`,
// `nanosleep` and `CLOCK_MONOTONIC` are POSIX rather than C99, so under a
// strict `-std=` glibc declares none of them without a feature-test macro, and
// a feature-test macro had to live in a `.c`. The first half is still true and
// measured: with no macro, `-std=c11` gets `implicit declaration of function
// 'clock_gettime'` and `'CLOCK_MONOTONIC' undeclared`. The second half is not:
// a `define` clause on a `foreign` block is emitted above *every* `#include` in
// the generated translation unit, which is exactly where a feature-test macro
// has to be, because `<features.h>` fixes the whole feature set the first time
// any header pulls it in. So the macro is written here and the sidecar is gone.
package time

// ── the web ─────────────────────────────────────────────────────────────────
//
// The two clocks are the host's: the monotonic one is `dado.now_ns()` —
// `performance.now()`, which never goes backwards — and the wall clock is
// `dado.wall_ns()`, `Date.now()`. Both reach the module as host calls the
// compiler imports, through the runtime's `dado/web.h`, which is not a C header
// but the runtime the compiler emits into a `#WEB` program. A wait sleeps on
// the runtime's threads (`memory.atomic.wait32` with a timeout, on a word
// nothing wakes) where the thread may wait — a worker of a `--web-threads`
// module, or node's main thread — and elsewhere, a page's main thread or a
// module with one thread, it spins on the clock: it stops the page while it
// waits, as any long call does, so a page's frame loop yields instead.
when #OS == #WEB:
    private foreign "dado/web.h":
        i64 dado_rt__web_now_ns()
        i64 dado_rt__web_wall_ns()
        void dado_rt__web_thread_sleep(i64 nanoseconds)

    private i64 mono_ns():
        return dado_rt__web_now_ns()

    private i64 wall_ns():
        return dado_rt__web_wall_ns()

    // A wait here returns at its timeout or spins, so it never returns early.
    private void wait_ns(i64 nanoseconds):
        if nanoseconds <= 0: return
        i64 until = dado_rt__web_now_ns() + nanoseconds
        for:
            i64 left = until - dado_rt__web_now_ns()
            if left <= 0: return
            dado_rt__web_thread_sleep(left)

// ── Windows ─────────────────────────────────────────────────────────────────
//
// Win32 through `<windows.h>`, as MinGW-w64 ships it — which is the header
// `zig cc -target x86_64-windows-gnu` compiles against.
//
//   * **The monotonic clock is `QueryPerformanceCounter`**, in ticks of
//     `QueryPerformanceFrequency` per second. Microsoft documents both as
//     never failing on Windows XP and later, and the frequency as fixed at
//     boot, so neither result is checked and the frequency is read with the
//     counter rather than cached.
//   * **The wall clock is `GetSystemTimePreciseAsFileTime`** (Windows 8 and
//     later), a `FILETIME` of 100 ns intervals since 1601-01-01 UTC. The
//     epochs are 11,644,473,600 seconds apart, which `FILETIME_TO_UNIX` holds
//     in the file's own unit.
//   * **A wait is `Sleep`**, which takes whole milliseconds and is quantised to
//     the system timer's tick (15.6 ms unless a process asks for finer), so a
//     wait is rounded **up** to the next millisecond and may overrun by a tick.
//     It is not interrupted by anything a Dado program can send it, so unlike
//     POSIX's it does not return early — and `sleep` checks the clock anyway.
//
// `LARGE_INTEGER` is a union in the header; it is restated by its one member
// a program reads, `QuadPart`, which is at offset 0 and is the union's whole
// width, so the emitter's layout assertions hold it honest exactly as they
// would a struct. `DWORD` is `unsigned long`, which is 32 bits on Windows —
// `#c.ulong` and never `u64` — and `BOOL` is `int`.
//
// `WIN32_LEAN_AND_MEAN` keeps `<windows.h>` to its core headers, which is all
// this needs and keeps the rest of its macros out of the translation unit.
else when #OS == #WINDOWS:
    private foreign "windows.h" define "WIN32_LEAN_AND_MEAN=1":
        type LARGE_INTEGER: (#c.llong QuadPart)
        type FILETIME: (#c.ulong dwLowDateTime, #c.ulong dwHighDateTime)

        #c.int QueryPerformanceCounter(^LARGE_INTEGER count)
        #c.int QueryPerformanceFrequency(^LARGE_INTEGER frequency)
        void GetSystemTimePreciseAsFileTime(^FILETIME into)
        void Sleep(#c.ulong milliseconds)

    // The counter in nanoseconds. Whole seconds and the remainder are scaled
    // apart, because `ticks * 1e9` overflows an `i64` after fifteen minutes of
    // uptime at the common 10 MHz frequency; the remainder is below the
    // frequency, so its product stays in range for any frequency under 9 GHz.
    private i64 mono_ns():
        LARGE_INTEGER ticks
        LARGE_INTEGER frequency
        _ = QueryPerformanceCounter(&ticks)
        _ = QueryPerformanceFrequency(&frequency)
        i64 count = i64(ticks.QuadPart)
        i64 per_second = i64(frequency.QuadPart)
        if per_second <= 0: return 0
        i64 whole = count / per_second
        i64 rest = count % per_second
        return whole * NANOS_PER_SECOND_WHOLE + rest * NANOS_PER_SECOND_WHOLE / per_second

    private i64 wall_ns():
        FILETIME ft = (0, 0)
        GetSystemTimePreciseAsFileTime(&ft)
        i64 intervals = i64(ft.dwHighDateTime) * 4294967296 + i64(ft.dwLowDateTime)
        return (intervals - FILETIME_TO_UNIX) * 100

    // Rounded up to whole milliseconds, and split so that no single `Sleep`
    // is handed `INFINITE` (0xFFFFFFFF), which would never return.
    private void wait_ns(i64 nanoseconds):
        if nanoseconds <= 0: return
        i64 ms = (nanoseconds + NANOS_PER_MS - 1) / NANOS_PER_MS
        for ms > 0:
            i64 step = ms
            if step > LONGEST_SLEEP_MS: step = LONGEST_SLEEP_MS
            Sleep(#c.ulong(step))
            ms = ms - step

    // 100 ns intervals between 1601-01-01 and 1970-01-01, both UTC.
    private const i64 FILETIME_TO_UNIX = 116444736000000000

    // The longest wait handed to one `Sleep`: a day, far below `INFINITE`.
    private const i64 LONGEST_SLEEP_MS = 86400000

// ── WASI ────────────────────────────────────────────────────────────────────
//
// wasi-libc is POSIX in its names and not in its types: `time_t` is
// `long long` beside a 32-bit `long` `tv_nsec`, and a `clockid_t` is a pointer
// to an opaque `struct __clockid`, `CLOCK_MONOTONIC` being the address of one
// the library defines. So the restatements differ from the POSIX arm's in
// every type and in nothing else; the clocks are the same two.
else when #OS == #WASI:
    private foreign sys "time.h" define "_POSIX_C_SOURCE=200809L" define "TimeSpec=struct timespec" define "ClockId=struct __clockid":
        type TimeSpec:
            #c.llong tv_sec,
            #c.long tv_nsec,
        type ClockId

        const ^const sys.ClockId CLOCK_MONOTONIC
        const ^const sys.ClockId CLOCK_REALTIME
        i32 clock_gettime(^const sys.ClockId clock_id, ^sys.TimeSpec into)
        i32 nanosleep(^sys.TimeSpec request, ^sys.TimeSpec remaining)

    private i64 mono_ns():
        sys.TimeSpec ts = (0, 0)
        if sys.clock_gettime(sys.CLOCK_MONOTONIC, &ts) == 0:
            return i64(ts.tv_sec) * NANOS_PER_SECOND_WHOLE + i64(ts.tv_nsec)
        return wall_ns()

    private i64 wall_ns():
        sys.TimeSpec ts = (0, 0)
        if sys.clock_gettime(sys.CLOCK_REALTIME, &ts) == 0:
            return i64(ts.tv_sec) * NANOS_PER_SECOND_WHOLE + i64(ts.tv_nsec)
        return 0

    // One `nanosleep`, which may return early; `sleep` restarts it.
    private void wait_ns(i64 nanoseconds):
        if nanoseconds <= 0: return
        sys.TimeSpec request = (#c.llong(nanoseconds / NANOS_PER_SECOND_WHOLE), #c.long(nanoseconds % NANOS_PER_SECOND_WHOLE))
        sys.nanosleep(&request, nil)

// ── POSIX: Linux, macOS and the BSDs ────────────────────────────────────────
//
// `#NONE` has no arm, deliberately: a freestanding target has no clock this
// package could read, so the three primitives are not declared there, and
// neither is anything public that would call them (see the head of the file).
else when #OS != #NONE:
    // **`TimeSpec=struct timespec` is what `define` is for.** POSIX declares a
    // *tagged* struct and no typedef, and a `foreign` type emits under the name it
    // was written with — so there is no spelling of `struct timespec` for Dado to
    // use until a `define` gives it one. The same trick names `struct pollfd` in
    // `drain`, and this is the second user of it.
    //
    // **`#c.long` on both members, and no `when #OS` is owed between Linux and
    // macOS.** `time_t` and `tv_nsec` are both `long` on both, 64-bit on every
    // ABI either ships (x86-64 and arm64 on each — 32-bit macOS ended at 10.15).
    // Measured here under both gcc and clang: `sizeof(struct timespec)` 16,
    // `tv_sec` at offset 0 width 8, `tv_nsec` at offset 8 width 8. The emitter
    // writes a shadow struct and, per member, an `offsetof` **and** a `sizeof`
    // assertion against the real one, so a wrong width is a build error naming
    // the field rather than padding quietly absorbing it. That was checked by
    // flipping `tv_sec` to `i32` and watching it fail: `sizeof` still matched
    // (16 — the `i32` padded back up) and `offsetof` still matched, so the
    // **only** assertion that fired was the per-member `sizeof`. **They were
    // `i64`**, which is `long` on glibc and `long long` on Darwin: the same width
    // and a different type, and the emitter also asserts each member's (and each
    // function's) C type with `_Generic`, so an `i64` here is a build error at
    // macOS that no Linux build can see. **Windows is where this stops being
    // true** — `long` is 32 bits there and its `struct timespec` is a 64-bit
    // `time_t` beside a 32-bit `long` — which is one reason Windows has an arm of
    // its own above rather than this one.
    //
    // **`CLOCK_MONOTONIC` and `CLOCK_REALTIME` are `foreign const`s and not
    // numbers written out.** `CLOCK_MONOTONIC` is 1 on Linux and 6 on Darwin, so
    // a restated literal would be a silent wrong-clock on one of them; declared
    // here, the C compiler resolves it and the per-OS difference never reaches
    // Dado.
    //
    // **`time` is bound as `sys`** rather than declared bare, because this package
    // is *called* `time` and a callee spelled `time(...)` inside it reads as the
    // package. The emitted C is still the bare identifier. A binding covers the
    // block's *type* too, which is why the restatement below refers to its own
    // `TimeSpec` as `sys.TimeSpec`: inside a bound block the short name is not in
    // scope, and the qualified one is what resolves.
    //
    // **OpenBSD is the exception among the BSDs**: its `time_t` is `long long`
    // (`__int64_t`), on every architecture, so its arm restates `tv_sec` and
    // `time` with `#c.llong`; `tv_nsec` is still `long`.
    when #OS == #OPENBSD:
        private foreign sys "time.h" define "_POSIX_C_SOURCE=200809L" define "TimeSpec=struct timespec":
            type TimeSpec:
                #c.llong tv_sec,
                #c.long tv_nsec,

            i32 nanosleep(^sys.TimeSpec request, ^sys.TimeSpec remaining)
            #c.llong time(^#c.llong into)
    else:
        private foreign sys "time.h" define "_POSIX_C_SOURCE=200809L" define "TimeSpec=struct timespec":
            type TimeSpec:
                #c.long tv_sec,
                #c.long tv_nsec,

            i32 nanosleep(^sys.TimeSpec request, ^sys.TimeSpec remaining)
            #c.long time(^#c.long into)

    // **`clockid_t` is `int` on glibc and an `enum` on Darwin**, and it needs an
    // arm: the emitter asserts `clock_gettime`'s C type with `_Generic`, and an
    // `int` parameter is not the type of an enum one. gcc and clang make an enum
    // with no negative member compatible with `unsigned int`, so Darwin's
    // restates it `#c.uint`. The constants are declared in each arm at the type
    // its arm passes, so neither call converts.
    when #OS == #DARWIN:
        private foreign sys "time.h" define "_POSIX_C_SOURCE=200809L":
            const #c.uint CLOCK_MONOTONIC
            const #c.uint CLOCK_REALTIME
            i32 clock_gettime(#c.uint clock_id, ^sys.TimeSpec into)
    else:
        private foreign sys "time.h" define "_POSIX_C_SOURCE=200809L":
            const i32 CLOCK_MONOTONIC
            const i32 CLOCK_REALTIME
            i32 clock_gettime(i32 clock_id, ^sys.TimeSpec into)

    // **The wall-clock fallback is kept and is a runtime check, not a
    // compile-time one.** `CLOCK_MONOTONIC` is mandatory in POSIX.1-2008, so a
    // platform without the name fails to compile, and a platform that has the
    // name and refuses the clock at runtime falls back to wall time rather than
    // to zero, so a duration is still a duration even where it can be
    // perturbed.
    private i64 mono_ns():
        sys.TimeSpec ts = (0, 0)
        if sys.clock_gettime(sys.CLOCK_MONOTONIC, &ts) == 0:
            return i64(ts.tv_sec) * NANOS_PER_SECOND_WHOLE + i64(ts.tv_nsec)
        return wall_ns()

    // `CLOCK_REALTIME` is mandatory, and `time` is the answer of last resort
    // for a platform that refuses it anyway.
    private i64 wall_ns():
        sys.TimeSpec ts = (0, 0)
        if sys.clock_gettime(sys.CLOCK_REALTIME, &ts) == 0:
            return i64(ts.tv_sec) * NANOS_PER_SECOND_WHOLE + i64(ts.tv_nsec)
        return i64(sys.time(nil)) * NANOS_PER_SECOND_WHOLE

    // One `nanosleep`. **It may return early**: a signal interrupts it, and
    // this does not restart it — `sleep` is what restarts, by reading the
    // monotonic clock and waiting again for whatever is left, which also covers
    // a signal that arrives during the restart.
    private void wait_ns(i64 nanoseconds):
        if nanoseconds <= 0: return
        sys.TimeSpec request = (#c.long(nanoseconds / NANOS_PER_SECOND_WHOLE), #c.long(nanoseconds % NANOS_PER_SECOND_WHOLE))
        sys.nanosleep(&request, nil)

// ── Duration ────────────────────────────────────────────────────────────────

// An interval, in nanoseconds. `distinct`, so a `Duration` is not an `i64` a
// caller can hand in by accident — a count of milliseconds reaching a function
// that wanted nanoseconds is the bug — and it keeps the operators: two
// `Duration`s add, subtract and compare, and `d * 3` scales. An `i64` of
// nanoseconds spans 292 years either way, and may be negative: an interval
// read backwards is a negative `Duration`, not a wrapped one.
distinct type Duration: i64

// `n` nanoseconds.
#assert_raises
Duration nanoseconds(i64 n):
    return Duration(n)

// `n` microseconds. Like the three below, `n` is multiplied into nanoseconds,
// so it has to be one an `i64` of nanoseconds can hold (292 years).
#assert_raises
Duration microseconds(i64 n):
    return Duration(n * NANOS_PER_MICRO)

// `n` milliseconds.
#assert_raises
Duration milliseconds(i64 n):
    return Duration(n * NANOS_PER_MS)

// `n` whole seconds.
#assert_raises
Duration seconds(i64 n):
    return Duration(n * NANOS_PER_SECOND_WHOLE)

// `n` minutes.
#assert_raises
Duration minutes(i64 n):
    return Duration(n * NANOS_PER_SECOND_WHOLE * 60)

// `n` hours.
#assert_raises
Duration hours(i64 n):
    return Duration(n * NANOS_PER_SECOND_WHOLE * 3600)

// The interval as a count of nanoseconds: its own value.
#assert_raises
i64 as_nanoseconds(Duration d):
    return i64(d)

// The interval as whole microseconds, truncated toward zero.
#assert_raises
i64 as_microseconds(Duration d):
    return i64(d) / NANOS_PER_MICRO

// The interval as whole milliseconds, truncated toward zero.
#assert_raises
i64 as_milliseconds(Duration d):
    return i64(d) / NANOS_PER_MS

// The interval as whole seconds, truncated toward zero.
#assert_raises
i64 as_seconds(Duration d):
    return i64(d) / NANOS_PER_SECOND_WHOLE

// The interval in seconds, with its fraction, for printing.
#assert_raises
f64 as_seconds_f64(Duration d):
    return f64(i64(d)) / NANOS_PER_SECOND

// ── Instant ─────────────────────────────────────────────────────────────────

// A reading of the monotonic clock, in nanoseconds from an origin nobody
// specifies. `distinct`, so it does not pass for a `Duration`: subtract two
// with `between`, or measure from one with `elapsed`, and never read one.
distinct type Instant: i64

// From `earlier` to `later`. Negative when the two were passed the wrong way
// round, which is the caller's to notice.
#assert_raises
Duration between(Instant earlier, Instant later):
    return Duration(i64(later) - i64(earlier))

// `start` moved by `d` — a deadline, when `d` is a timeout. It does not
// saturate; `deadline_from` is the form that does.
#assert_raises
Instant add(Instant start, Duration d):
    return Instant(i64(start) + i64(d))

// One second, in nanoseconds, as an `f64` — because a bare float literal has no
// width and `as_seconds_f64` needs this one as a divisor rather than as an
// argument.
private const f64 NANOS_PER_SECOND = 1000000000.0

// One second, a millisecond and a microsecond, in nanoseconds, as whole
// numbers. Named rather than spelled inline so the factors cannot drift apart
// between the arms.
private const i64 NANOS_PER_SECOND_WHOLE = 1000000000
private const i64 NANOS_PER_MS = 1000000
private const i64 NANOS_PER_MICRO = 1000

// ── what reads the clock ────────────────────────────────────────────────────
//
// Everything below this line until the calendar reads a clock or waits on
// one, so none of it exists on `#NONE` (see the head of the file), and none
// of it is promised to raise: each reaches a platform's clock call.
when #OS != #NONE:
    // The monotonic clock, now. Never earlier than a reading taken before it.
    Instant instant():
        return Instant(mono_ns())

    // How long since `started`.
    Duration elapsed(Instant started):
        return between(started, instant())

    // ── waiting ─────────────────────────────────────────────────────────────

    // Wait at least `d`. **Never returns early**: each platform's one wait may
    // (a signal ends POSIX's `nanosleep`; a clock's resolution can round any of
    // them), so this measures what is left on the monotonic clock after every wait
    // and waits again until nothing is. A zero or negative `d` returns at once. It
    // may overrun by a scheduler's quantum, and on Windows by a timer tick. On a
    // page's main thread, or in a single-threaded web module, nothing may block,
    // so it spins on the clock and holds the page for the whole wait: a frame
    // loop there yields instead.
    void sleep(Duration d):
        if i64(d) <= 0: return
        Instant deadline = add(instant(), d)
        for:
            i64 left = i64(between(instant(), deadline))
            if left <= 0: return
            wait_ns(left)

    // ── the wall clock ──────────────────────────────────────────────────────

    // Nanoseconds since the Unix epoch, 1970-01-01 UTC. Wall time — settable, and
    // the wrong clock to measure an interval with. An `i64` of these lasts until
    // the year 2262.
    i64 unix_nanos():
        return wall_ns()

    // Whole seconds since the Unix epoch.
    i64 unix():
        return wall_ns() / NANOS_PER_SECOND_WHOLE

    // ── Stopwatch ───────────────────────────────────────────────────────────

    // An accumulating timer over the monotonic clock: it adds up the intervals
    // it ran for, so it can be stopped and started again and still answer the
    // total. The zero value is stopped at zero; `stopwatch()` is one already
    // running. Each method that reads the clock has an `_at` form that takes
    // the reading instead, and those are the ones a script can run.
    type Stopwatch:
        Instant started
        Duration banked
        bool running

        // Start it, or keep it running if it is already.
        void start(^self):
            self.start_at(instant())

        // Stop it, adding the interval since it started to its total. A
        // stopped one stays stopped.
        void stop(^self):
            self.stop_at(instant())

        // Stopped, at zero.
        #assert_raises
        void reset(^self):
            self.banked = Duration(0)
            self.running = false

        // At zero, and running from now.
        void restart(^self):
            self.reset()
            self.start()

        // The total it has run for, including the interval in progress.
        Duration elapsed(self):
            return self.elapsed_at(instant())

        // `start`, at the reading `now`.
        #assert_raises
        void start_at(^self, Instant now):
            if self.running: return
            self.started = now
            self.running = true

        // `stop`, at the reading `now`.
        #assert_raises
        void stop_at(^self, Instant now):
            if !self.running: return
            self.banked = self.banked + between(self.started, now)
            self.running = false

        // `elapsed`, at the reading `now`.
        #assert_raises
        Duration elapsed_at(self, Instant now):
            if !self.running: return self.banked
            return self.banked + between(self.started, now)

    // A stopwatch at zero, running from now.
    Stopwatch stopwatch():
        Stopwatch w
        w.start()
        return w

    // ── Deadline ────────────────────────────────────────────────────────────

    // A moment on the monotonic clock by which something has to be done: a
    // timeout turned into a point, so a loop that waits in pieces asks the
    // same deadline each time rather than subtracting what it already spent.
    type Deadline:
        Instant at

        // Whether the deadline has passed: true from the moment it falls due.
        bool passed(self):
            return self.passed_at(instant())

        // What is left before it falls due, and zero once it has — never
        // negative, so it can be handed straight to `sleep` or a wait.
        Duration left(self):
            return self.left_at(instant())

        // `passed`, at the reading `now`.
        #assert_raises
        bool passed_at(self, Instant now):
            return i64(now) >= i64(self.at)

        // `left`, at the reading `now`.
        #assert_raises
        Duration left_at(self, Instant now):
            Duration d = between(now, self.at)
            if i64(d) < 0: return Duration(0)
            return d

    // The deadline `timeout` from now.
    Deadline deadline(Duration timeout):
        return deadline_from(instant(), timeout)

    // The deadline `timeout` after `start`. A timeout too long for the clock
    // saturates to its end, so an enormous one means "never" and not a moment
    // in the past; a negative one is a deadline already passed.
    #assert_raises
    Deadline deadline_from(Instant start, Duration timeout):
        i64 s = i64(start)
        i64 t = i64(timeout)
        if t > 0 && s > I64_MAX - t: return Deadline(Instant(I64_MAX))
        if t < 0 && s < I64_MIN - t: return Deadline(Instant(I64_MIN))
        return Deadline(Instant(s + t))

private const i64 I64_MAX = 9223372036854775807
private const i64 I64_MIN = -9223372036854775807 - 1

// ── the calendar ────────────────────────────────────────────────────────────
//
// UTC, proleptic Gregorian, no leap seconds — the calendar Unix time counts
// in. The day arithmetic is Howard Hinnant's `days_from_civil` and
// `civil_from_days`, exact for every year and branch-light: the year is
// shifted to start in March, so the leap day is the last day of its year and
// a month's start is a straight line in its number.

// A moment as the calendar writes it, in UTC. `month` is 1 to 12, `day` 1 to
// the month's length, `hour` 0 to 23, `minute` and `second` 0 to 59, and
// `nanosecond` 0 to 999,999,999. `utc` makes one; `from_utc` checks each field
// on the way back.
type DateTime:
    i64 year
    i32 month
    i32 day
    i32 hour
    i32 minute
    i32 second
    i32 nanosecond

// The days of the week, in the order `weekday` counts them, Sunday first, as
// C's `tm_wday` and ISO C's `strftime("%w")` do.
enum i32 Weekday: (Sunday, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday)

// Whether `year` has a 29th of February.
#assert_raises
bool is_leap_year(i64 year):
    return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0

// How many days `month` (1 to 12) of `year` has; 0 for a month that is not one.
#assert_raises
i32 days_in_month(i64 year, i32 month):
    if month < 1 || month > 12: return 0
    if month == 2:
        return 29 if is_leap_year(year) else 28
    if month == 4 || month == 6 || month == 9 || month == 11: return 30
    return 31

// Days from 1970-01-01 to the date `year`-`month`-`day`, negative before it.
// The fields are not checked — `from_utc` is the checking form — and a day
// past its month's end runs on into the next month.
#assert_raises
i64 days_from_civil(i64 year, i32 month, i32 day):
    i64 y = year
    if month <= 2: y = y - 1
    i64 era = (y if y >= 0 else y - 399) / 400
    i64 yoe = y - era * 400
    i64 mp = i64(month) - 3 if month > 2 else i64(month) + 9
    i64 doy = (153 * mp + 2) / 5 + i64(day) - 1
    i64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

// The date `days` after 1970-01-01, or before it when negative.
#assert_raises
(i64 year, i32 month, i32 day) civil_from_days(i64 days):
    i64 z = days + 719468
    i64 era = (z if z >= 0 else z - 146096) / 146097
    i64 doe = z - era * 146097
    i64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    i64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    i64 mp = (5 * doy + 2) / 153
    i64 d = doy - (153 * mp + 2) / 5 + 1
    i64 m = mp + 3 if mp < 10 else mp - 9
    i64 y = yoe + era * 400
    if m <= 2: y = y + 1
    return (y, i32(m), i32(d))

// The day of the week of a count of days since 1970-01-01, which was a
// Thursday.
#assert_raises
Weekday weekday_of_days(i64 days):
    i64 w = (days + 4) % 7
    if w < 0: w = w + 7
    return Weekday(i32(w))

// The day of the week `t` falls on.
#assert_raises
Weekday weekday(DateTime t):
    return weekday_of_days(days_from_civil(t.year, t.month, t.day))

// The UTC calendar moment `nanos` nanoseconds after the Unix epoch — what
// `unix_nanos()` answers, or anything else counted the same way. Every `i64`
// has one, so this cannot fail.
#assert_raises
DateTime utc(i64 nanos):
    i64 secs = nanos / NANOS_PER_SECOND_WHOLE
    i64 frac = nanos % NANOS_PER_SECOND_WHOLE
    if frac < 0:
        frac = frac + NANOS_PER_SECOND_WHOLE
        secs = secs - 1
    i64 days = secs / 86400
    i64 rest = secs % 86400
    if rest < 0:
        rest = rest + 86400
        days = days - 1
    (i64 y, i32 m, i32 d) = civil_from_days(days)
    return (y, m, d, i32(rest / 3600), i32(rest / 60 % 60), i32(rest % 60), i32(frac))

// Nanoseconds since the Unix epoch at the UTC moment `t`: `utc` the other way.
// Fails `INVALID_DATE` when a field is out of its range, and `OUT_OF_RANGE`
// when the moment is outside what an `i64` of nanoseconds holds.
#assert_raises
Error!i64 from_utc(DateTime t):
    try check_fields(t)
    // Outside these years the seconds alone would not fit; inside them the
    // check below is exact.
    if t.year < 1600 || t.year > 2300: fail Error.OUT_OF_RANGE
    i64 secs = days_from_civil(t.year, t.month, t.day) * 86400 + i64(t.hour) * 3600 + i64(t.minute) * 60 + i64(t.second)
    return join_seconds(secs, i64(t.nanosecond))

// `INVALID_DATE` unless every field of `t` but the year is in its range:
// what `from_utc` and `parse_rfc3339` both check.
#assert_raises
private Error!void check_fields(DateTime t):
    if t.month < 1 || t.month > 12: fail Error.INVALID_DATE
    if t.day < 1 || t.day > days_in_month(t.year, t.month): fail Error.INVALID_DATE
    if t.hour < 0 || t.hour > 23 || t.minute < 0 || t.minute > 59: fail Error.INVALID_DATE
    if t.second < 0 || t.second > 59: fail Error.INVALID_DATE
    if t.nanosecond < 0 || i64(t.nanosecond) >= NANOS_PER_SECOND_WHOLE: fail Error.INVALID_DATE

// `secs` seconds and `nano` more nanoseconds as one `i64` of nanoseconds, or
// `OUT_OF_RANGE`. `nano` is 0 to 999,999,999.
#assert_raises
private Error!i64 join_seconds(i64 secs, i64 nano):
    i64 top = I64_MAX / NANOS_PER_SECOND_WHOLE
    i64 bottom = I64_MIN / NANOS_PER_SECOND_WHOLE - 1
    if secs > top || secs < bottom: fail Error.OUT_OF_RANGE
    if secs == top && nano > I64_MAX % NANOS_PER_SECOND_WHOLE: fail Error.OUT_OF_RANGE
    if secs == bottom && nano < NANOS_PER_SECOND_WHOLE + I64_MIN % NANOS_PER_SECOND_WHOLE: fail Error.OUT_OF_RANGE
    return secs * NANOS_PER_SECOND_WHOLE + nano

// ── RFC 3339 ────────────────────────────────────────────────────────────────

// The longest text `put_rfc3339` writes: `YYYY-MM-DDThh:mm:ss.nnnnnnnnnZ`.
const i64 RFC3339_MAX = 30

// The moment `nanos` after the Unix epoch as an RFC 3339 timestamp in UTC,
// written into `into`, answering how many bytes it took. The fraction is left
// off when it is zero and otherwise written with its trailing zeros dropped,
// so a whole second is `2026-10-08T14:03:07Z` and a quarter past it
// `2026-10-08T14:03:07.25Z`. Fails `OUT_OF_RANGE` for a year before 0000 or
// after 9999, which RFC 3339 cannot write — never, for an `i64` of
// nanoseconds — and `NO_ROOM` when `into` is too short; `RFC3339_MAX` bytes
// always suffice.
#assert_raises
Error!i64 put_rfc3339(i64 nanos, []char8 into):
    DateTime t = utc(nanos)
    if t.year < 0 || t.year > 9999: fail Error.OUT_OF_RANGE
    [30]char8 text
    put_digits(text[0..<4], t.year)
    text[4] = '-'
    put_digits(text[5..<7], i64(t.month))
    text[7] = '-'
    put_digits(text[8..<10], i64(t.day))
    text[10] = 'T'
    put_digits(text[11..<13], i64(t.hour))
    text[13] = ':'
    put_digits(text[14..<16], i64(t.minute))
    text[16] = ':'
    put_digits(text[17..<19], i64(t.second))
    i64 n = 19
    if t.nanosecond != 0:
        text[19] = '.'
        put_digits(text[20..<29], i64(t.nanosecond))
        n = 29
        for text[n - 1] == '0':
            n = n - 1
    text[n] = 'Z'
    n = n + 1
    if #len(into) < n: fail Error.NO_ROOM
    for i in i64(0)..<n:
        into[i] = text[i]
    return n

// `put_rfc3339` into new text on the ambient allocator. Fails as it does, and
// `NO_MEMORY` when the allocation fails; the caller `#delete`s the result.
#assert_raises
Error!ref []char8 format_rfc3339(i64 nanos):
    [30]char8 room
    try i64 n = put_rfc3339(nanos, room[0..<RFC3339_MAX])
    ref []char8 out = #make([]char8, n)
    if #len(out) != n:
        #delete(out)
        fail Error.NO_MEMORY
    for i in i64(0)..<n:
        out[i] = room[i]
    return out

// An RFC 3339 timestamp as nanoseconds since the Unix epoch, in UTC:
// `YYYY-MM-DD`, a `T` (or `t`, or a space, as RFC 3339 allows), `hh:mm:ss`,
// an optional fraction of one or more digits (past nine, the rest are read
// and dropped), and `Z`, `z` or an offset `+hh:mm` / `-hh:mm`, which is
// subtracted to give UTC. A leap second, `:60`, is read as the next second's
// start, as Unix time has no leap seconds to name it by. Fails `MALFORMED`
// when the text does not have the shape, `INVALID_DATE` when a field is out
// of its range, and `OUT_OF_RANGE` when the moment is outside what an `i64`
// of nanoseconds holds.
#assert_raises
Error!i64 parse_rfc3339(string8 text):
    i64 len = #len(text)
    if len < 20: fail Error.MALFORMED
    try i64 year = digits(text, 0, 4)
    if text[4] != '-' || text[7] != '-': fail Error.MALFORMED
    try i64 month = digits(text, 5, 2)
    try i64 day = digits(text, 8, 2)
    char8 t = text[10]
    if t != 'T' && t != 't' && t != ' ': fail Error.MALFORMED
    try i64 hour = digits(text, 11, 2)
    if text[13] != ':' || text[16] != ':': fail Error.MALFORMED
    try i64 minute = digits(text, 14, 2)
    try i64 second = digits(text, 17, 2)
    i64 at = 19
    i64 nano = 0
    if text[at] == '.':
        at = at + 1
        i64 first = at
        i64 scale = 100000000
        for at < len && is_digit(text[at]):
            nano = nano + i64(u8(text[at]) - u8('0')) * scale
            scale = scale / 10
            at = at + 1
        if at == first: fail Error.MALFORMED
    if at >= len: fail Error.MALFORMED
    i64 offset = 0
    char8 z = text[at]
    if z == 'Z' || z == 'z':
        at = at + 1
    else if z == '+' || z == '-':
        if at + 6 > len || text[at + 3] != ':': fail Error.MALFORMED
        try i64 oh = digits(text, at + 1, 2)
        try i64 om = digits(text, at + 4, 2)
        if oh > 23 || om > 59: fail Error.INVALID_DATE
        offset = oh * 3600 + om * 60
        if z == '-': offset = -offset
        at = at + 6
    else:
        fail Error.MALFORMED
    if at != len: fail Error.MALFORMED
    bool leap = second == 60
    if leap: second = 59
    DateTime when_utc = (year, i32(month), i32(day), i32(hour), i32(minute), i32(second), 0)
    // The fields are checked as `from_utc` checks them; the offset and a leap
    // second are applied after, in seconds, so 23:59:60 and an offset across
    // midnight are plain arithmetic rather than a second calendar.
    try check_fields(when_utc)
    i64 secs = days_from_civil(year, when_utc.month, when_utc.day) * 86400 + hour * 3600 + minute * 60 + second - offset
    if leap: secs = secs + 1
    return join_seconds(secs, nano)

// The `count` decimal digits of `text` from `at`, as a number; `MALFORMED`
// when any of them is not a digit.
#assert_raises
private Error!i64 digits(string8 text, i64 at, i64 count):
    i64 v = 0
    for i in at..<at + count:
        if !is_digit(text[i]): fail Error.MALFORMED
        v = v * 10 + i64(u8(text[i]) - u8('0'))
    return v

#assert_raises
private bool is_digit(char8 c):
    return c >= '0' && c <= '9'

// `v` as exactly `#len(into)` decimal digits, zero-padded on the left.
#assert_raises
private void put_digits([]char8 into, i64 v):
    i64 rest = v
    i64 i = #len(into) - 1
    for i >= 0:
        into[i] = char8(u8('0') + u8(rest % 10))
        rest = rest / 10
        i = i - 1

// ── failure codes ───────────────────────────────────────────────────────────

// Why a calendar or RFC 3339 function failed. The numbers are this package's,
// 2600 to 2699, apart from every other package's, so a code read anywhere
// never means two things.
distinct enum i32 Error:
    // The text is not an RFC 3339 timestamp.
    MALFORMED = 2600,
    // A field is out of its range: a 13th month, a 31st of April, a 61st second.
    INVALID_DATE,
    // The moment is outside what an `i64` of nanoseconds holds, or a year
    // RFC 3339 cannot write.
    OUT_OF_RANGE,
    // The buffer is too short for the text.
    NO_ROOM,
    // The allocation failed.
    NO_MEMORY,

// A sentence for each of this package's codes, and one for any other value.
// Never empty.
#assert_raises
string8 message(Error why):
    if why == Error.MALFORMED: return "not an RFC 3339 timestamp (YYYY-MM-DDThh:mm:ssZ)"
    if why == Error.INVALID_DATE: return "a date or time field is out of its range"
    if why == Error.OUT_OF_RANGE: return "the moment is outside the years this can represent (1677 to 2262)"
    if why == Error.NO_ROOM: return "the buffer is too short: RFC3339_MAX bytes always suffice"
    if why == Error.NO_MEMORY: return "out of memory"
    return "not a core:time error code"
