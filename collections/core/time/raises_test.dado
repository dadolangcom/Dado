@test
// What raises into a script, for the methods. `#assert_raises` stands only
// above a package-level function, so the `_at` methods of `Stopwatch` and
// `Deadline`, which take the clock's reading as an argument, are promised
// through the private functions below, and the build refuses (ERR1227) if any
// of them reaches something a script cannot run. The methods that read the
// clock themselves are not promised: the clock is a foreign call on every
// platform.
package time

#assert_raises
private Duration stopwatch_at(Instant a, Instant b):
    Stopwatch w
    w.start_at(a)
    w.stop_at(b)
    w.reset()
    w.start_at(a)
    return w.elapsed_at(b)

#assert_raises
private bool deadline_at(Instant a, Instant b):
    Deadline d = deadline_from(a, seconds(1))
    return d.passed_at(b) || i64(d.left_at(b)) > 0

i32 test():
    bool ok = true
    ok = #expect(as_seconds(stopwatch_at(Instant(0), Instant(2000000000))) == 2, "a stopwatch from 0 to 2 s read wrong") && ok
    ok = #expect(deadline_at(Instant(0), Instant(5)), "a deadline a second off had neither passed nor anything left") && ok
    return 0 if ok else 1
