@test
// The public surface, and what Go's tables (`path_rules_test.dado`) do not
// reach: every public function called once, answering what its private form
// answers for the target's style; `abs`, which Go's tests cannot pin because
// Go's asks the OS; the codes and their messages; and the answers that are
// this package's rather than Go's, each named in the package's doc block.
package path

private string8 style_name(Style st):
    if st == Style.Windows:
        return "windows"
    return "posix"

// A new text is `want`; it is freed.
private bool text_is(ref []char8 got, string8 want, string8 what):
    string8 g = string8(got[:])
    bool ok = #expect(g == want, what, " is \"", g, "\", not \"", want, "\"")
    #delete(got)
    return ok

// Two new texts equal; both are freed.
private bool both_are(ref []char8 got, ref []char8 want, string8 what):
    string8 g = string8(got[:])
    string8 w = string8(want[:])
    bool ok = #expect(g == w, what, " is \"", g, "\", not \"", w, "\"")
    #delete(got)
    #delete(want)
    return ok

private bool abs_is(string8 p, string8 from, string8 want, Style st):
    ref []char8 got = abs_in(p, from, st)
    string8 g = string8(got[:])
    bool ok = #expect(g == want, style_name(st), ": abs(\"", p, "\", \"", from, "\") is \"", g, "\", not \"", want, "\"")
    #delete(got)
    return ok

// The public `rel` and its private form agree on a pair that succeeds.
private bool rel_agrees(string8 from, string8 to):
    try ref []char8 got = rel(from, to) else code:
        return #expect(false, "rel(\"", from, "\", \"", to, "\") failed with ", code)
    try ref []char8 want = rel_in(from, to, TARGET) else code_in:
        #delete(got)
        return #expect(false, "rel_in(\"", from, "\", \"", to, "\") failed with ", code_in)
    return both_are(got, want, "rel")

private bool rel_fails_with(string8 from, string8 to, i32 want):
    try ref []char8 got = rel(from, to) else code:
        return #expect(code == want, "rel(\"", from, "\", \"", to, "\") failed with ", code, ", not ", want)
    #delete(got)
    return #expect(false, "rel(\"", from, "\", \"", to, "\") succeeded; wanted code ", want)

// `join(from, rel(from, to))` cleans to `clean(to)`, as the style compares.
private bool rel_round_trips(string8 from, string8 to, Style st):
    try ref []char8 up = rel_in(from, to, st) else code:
        return #expect(false, style_name(st), ": rel(\"", from, "\", \"", to, "\") failed with ", code)
    [2]string8 back = [from, string8(up[:])]
    ref []char8 joined = join_in(back[:], st)
    ref []char8 want = clean_in(to, st)
    string8 j = string8(joined[:])
    string8 w = string8(want[:])
    // Equal as the style compares names: on Windows, without regard to case.
    bool ok = #expect(same(j, w, st), style_name(st), ": join(\"", from, "\", rel) is \"", j, "\", not \"", w, "\"")
    #delete(up)
    #delete(joined)
    #delete(want)
    return ok

private bool public_match_is(string8 pattern, string8 name, bool want):
    try bool got = match(pattern, name) else code:
        return #expect(false, "match(\"", pattern, "\", \"", name, "\") failed with ", code)
    return #expect(got == want, "match(\"", pattern, "\", \"", name, "\") is ", got)

private bool public_match_bad(string8 pattern, string8 name):
    try bool got = match(pattern, name) else code:
        return #expect(code == BAD_PATTERN, "match(\"", pattern, "\", \"", name, "\") failed with ", code)
    return #expect(false, "match(\"", pattern, "\", \"", name, "\") answered ", got, " for a malformed pattern")

private bool match_is(string8 pattern, string8 name, bool want, Style st):
    try bool got = match_in(pattern, name, st) else code:
        return #expect(false, style_name(st), ": match(\"", pattern, "\", \"", name, "\") failed with ", code)
    return #expect(got == want, style_name(st), ": match(\"", pattern, "\", \"", name, "\") is ", got)

private bool match_bad(string8 pattern, string8 name, Style st):
    try bool got = match_in(pattern, name, st) else code:
        return #expect(code == BAD_PATTERN, style_name(st), ": match(\"", pattern, "\", \"", name, "\") failed with ", code)
    return #expect(false, style_name(st), ": match(\"", pattern, "\", \"", name, "\") answered ", got, " for a malformed pattern")

i32 test():
    bool ok = true

    // ── the public functions, in the target's style ──────────────────────
    [4]string8 parts = ["a", "b", "..", "c"]
    ok = both_are(join("a", "b", "..", "c"), join_in(parts[:], TARGET), "join") && ok
    ok = text_is(join(), "", "join of nothing") && ok
    ok = text_is(join("", ""), "", "join of empty parts") && ok
    ok = both_are(clean("a//b/./c/.."), clean_in("a//b/./c/..", TARGET), "clean") && ok
    (string8 d, string8 f) = split("x/y/z.txt")
    (string8 d2, string8 f2) = split_in("x/y/z.txt", TARGET)
    ok = #expect(d == d2 && f == f2 && f == "z.txt" && d == "x/y/", "split is (", d, ", ", f, ")") && ok
    ok = #expect(base("x/y/z.txt") == "z.txt", "base") && ok
    ok = both_are(dir("x/y/z.txt"), dir_in("x/y/z.txt", TARGET), "dir") && ok
    ok = #expect(ext("x/y/z.tar.gz") == ".gz", "ext") && ok
    ok = #expect(is_abs("/usr") == is_abs_in("/usr", TARGET), "is_abs") && ok
    ok = #expect(volume("C:/x") == volume_window("C:/x"), "volume") && ok
    ok = both_are(abs("b", "/a"), abs_in("b", "/a", TARGET), "abs") && ok
    ok = rel_agrees("/a/b", "/a/c/d") && ok
    ok = rel_fails_with("/a", "b", DIFFERENT_ROOTS) && ok
    ok = rel_fails_with("..", "a", UNCLIMBABLE) && ok
    ok = public_match_is("*.dado", "path.dado", true) && ok
    ok = public_match_is("*.dado", "dir/path.dado", false) && ok
    ok = public_match_bad("[", "x") && ok

    // The separator, and what counts as one.
    ok = #expect(SEPARATOR == sep_of(TARGET), "SEPARATOR is ", SEPARATOR) && ok
    ok = #expect(is_separator('/'), "/ is a separator everywhere") && ok
    ok = #expect(is_separator('\\') == (TARGET == Style.Windows), "\\ is a separator only on Windows") && ok
    ok = #expect(!is_separator(':') && !is_separator('a'), "neither : nor a is a separator") && ok
    ok = #expect(target_is_right(), "the target's style is the wrong one") && ok

    // ── the codes ─────────────────────────────────────────────────────────
    string8 m_bad_pattern = message(BAD_PATTERN)
    ok = #expect(#len(m_bad_pattern) > 0, "BAD_PATTERN has a message") && ok
    string8 m_different_roots = message(DIFFERENT_ROOTS)
    ok = #expect(#len(m_different_roots) > 0, "DIFFERENT_ROOTS has a message") && ok
    string8 m_unclimbable = message(UNCLIMBABLE)
    ok = #expect(#len(m_unclimbable) > 0, "UNCLIMBABLE has a message") && ok
    ok = #expect(message(BAD_PATTERN) != message(DIFFERENT_ROOTS), "BAD_PATTERN and DIFFERENT_ROOTS share a message") && ok
    ok = #expect(message(DIFFERENT_ROOTS) != message(UNCLIMBABLE), "DIFFERENT_ROOTS and UNCLIMBABLE share a message") && ok
    ok = #expect(message(BAD_PATTERN) != message(UNCLIMBABLE), "BAD_PATTERN and UNCLIMBABLE share a message") && ok
    ok = #expect(message(0) == "not a code of core:path", "a code that is not this package's") && ok

    // ── abs, POSIX ────────────────────────────────────────────────────────
    ok = abs_is("a/b", "/home/u", "/home/u/a/b", Style.Posix) && ok
    ok = abs_is("/x/../y", "/home", "/y", Style.Posix) && ok
    ok = abs_is("", "/w", "/w", Style.Posix) && ok
    ok = abs_is("..", "/", "/", Style.Posix) && ok
    ok = abs_is("../../x", "/a/b/c", "/a/x", Style.Posix) && ok
    ok = abs_is("a", "rel/dir", "rel/dir/a", Style.Posix) && ok
    ok = abs_is("C:\\x", "/w", "/w/C:\\x", Style.Posix) && ok
    ok = abs_is("\\x", "/w", "/w/\\x", Style.Posix) && ok

    // ── abs, Windows ──────────────────────────────────────────────────────
    ok = abs_is("a\\b", "C:\\work", "C:\\work\\a\\b", Style.Windows) && ok
    ok = abs_is("a/b", "C:/work", "C:\\work\\a\\b", Style.Windows) && ok
    ok = abs_is("C:\\x\\..\\y", "D:\\w", "C:\\y", Style.Windows) && ok
    ok = abs_is("\\x", "C:\\work", "C:\\x", Style.Windows) && ok
    ok = abs_is("/x", "C:\\work", "C:\\x", Style.Windows) && ok
    ok = abs_is("\\x", "\\\\host\\share\\dir", "\\\\host\\share\\x", Style.Windows) && ok
    ok = abs_is("c:x", "C:\\work", "C:\\work\\x", Style.Windows) && ok
    ok = abs_is("D:x", "C:\\work", "D:\\x", Style.Windows) && ok
    ok = abs_is("D:", "C:\\work", "D:\\", Style.Windows) && ok
    ok = abs_is("", "C:\\work", "C:\\work", Style.Windows) && ok
    ok = abs_is("..", "C:\\", "C:\\", Style.Windows) && ok
    ok = abs_is("//host/share/a", "C:\\w", "\\\\host\\share\\a", Style.Windows) && ok
    ok = abs_is("\\\\?\\C:\\a", "D:\\", "\\\\?\\C:\\a", Style.Windows) && ok
    ok = abs_is("a", "\\\\host\\share", "\\\\host\\share\\a", Style.Windows) && ok

    // ── rel and join agree, in both styles ────────────────────────────────
    ok = rel_round_trips("/a/b/c", "/a/x/y", Style.Posix) && ok
    ok = rel_round_trips("a/b", "c", Style.Posix) && ok
    ok = rel_round_trips("C:\\a\\b", "c:\\A\\x", Style.Windows) && ok
    ok = rel_round_trips("\\\\host\\share", "\\\\host\\share\\d\\e", Style.Windows) && ok

    // ── where this package answers differently from Go, on purpose ───────
    //
    // Windows' match treats `/` and `\` alike: `*` and `?` cross neither,
    // and a separator in the pattern matches either in the name.
    ok = match_is("a/*", "a\\b", true, Style.Windows) && ok
    ok = match_is("a\\*", "a/b", true, Style.Windows) && ok
    ok = match_is("*", "a/b", false, Style.Windows) && ok
    ok = match_is("a?b", "a/b", false, Style.Windows) && ok
    // On POSIX `\` escapes: `a\b` matches only `ab`.
    ok = match_is("a\\b", "a\\b", false, Style.Posix) && ok
    ok = match_is("a\\b", "ab", true, Style.Posix) && ok
    // A malformed pattern is reported even when an earlier chunk already
    // failed to match, in both styles; Go's answers `false` here.
    ok = match_bad("a*b[", "x", Style.Posix) && ok
    ok = match_bad("a*b[", "x", Style.Windows) && ok

    // Found by running Go's answers against random paths: a Windows "drive"
    // that is a separator is cleaned as Go cleans it, written as given.
    ok = text_is(clean_in("/:", Style.Windows), "/:.", "windows: clean(/:)") && ok
    ok = text_is(clean_in("/:a", Style.Windows), "\\:a", "windows: clean(/:a)") && ok

    if ok:
        return 0
    return 1

private string8 volume_window(string8 p):
    return p[0..<volume_len(p, TARGET)]

when #OS == #WINDOWS:
    private bool target_is_right():
        return TARGET == Style.Windows
else:
    private bool target_is_right():
        return TARGET == Style.Posix
