    ok = is_abs_is("c::", false, Style.Posix) && ok
    ok = is_abs_is("\\", false, Style.Posix) && ok
    ok = is_abs_is("\\Windows", false, Style.Posix) && ok
    ok = is_abs_is("c:a\\b", false, Style.Posix) && ok
