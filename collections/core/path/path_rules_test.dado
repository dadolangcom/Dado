    ok = is_abs_is("\\\\host\\share\\foo", false, Style.Posix) && ok
    ok = is_abs_is("//host/share/foo/bar", true, Style.Posix) && ok
    ok = is_abs_is("\\\\?\\a\\b\\c", false, Style.Posix) && ok
    ok = is_abs_is("\\??\\a\\b\\c", false, Style.Posix) && ok
    // ── Rel ──
    ok = rel_is("a/b", "a/b", ".", Style.Posix) && ok
    ok = rel_is("a/b/.", "a/b", ".", Style.Posix) && ok
    ok = rel_is("a/b", "a/b/.", ".", Style.Posix) && ok
    ok = rel_is("./a/b", "a/b", ".", Style.Posix) && ok
    ok = rel_is("a/b", "./a/b", ".", Style.Posix) && ok
    ok = rel_is("ab/cd", "ab/cde", "../cde", Style.Posix) && ok
    ok = rel_is("ab/cd", "ab/c", "../c", Style.Posix) && ok
    ok = rel_is("a/b", "a/b/c/d", "c/d", Style.Posix) && ok
    ok = rel_is("a/b", "a/b/../c", "../c", Style.Posix) && ok
    ok = rel_is("a/b/../c", "a/b", "../b", Style.Posix) && ok
