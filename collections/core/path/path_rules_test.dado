@test
// Both rule sets on every host: Go's `path/filepath` test tables — Clean,
// Join, Split, Ext, Base, Dir, IsAbs, Rel, VolumeName and Match, the shared
// rows and each system's own — run through the private `_in` form of each
// function once with `Style.Posix` and once with `Style.Windows`.
// The tables are Go's, used under Go's BSD licence, whose notice is in
// THIRD_PARTY_NOTICES at the root of the repository.
//
// Every input of every table is asked of both styles, not only the inputs
// Go asks of that system, so a Windows-looking path is also checked to mean
// nothing special to POSIX (`\` an ordinary byte, `C:` an ordinary name).
// The expected answers are Go 1.24's own: `filepath` on Linux for the POSIX
// rows and `filepath` built for Windows, run under Wine, for the Windows
// rows. Two answers are this package's rather than Go's, as its doc block
// says: `volume` is compared with `/` and `\` equal (a window, not a
// rewrite), and Windows' `match` rows are Go's answers for the inputs with
// their separators cleaned to `\`, asked here of the raw inputs too, since
// this package's `match` treats the two separators alike. Patterns holding
// `\` are POSIX rows only: on Windows `\` is a separator, not an escape.
package path

private string8 style_name(Style st):
    if st == Style.Windows:
        return "windows"
    return "posix"

// Equal with every separator equal to every other, for `volume`, which
// answers the path as written.
private bool slashed_equal(string8 a, string8 b, Style st):
    if #len(a) != #len(b):
        return false
    for i in 0..<#len(a):
        if a[i] != b[i] && !(is_sep(a[i], st) && is_sep(b[i], st)):
            return false
    return true

private bool clean_is(string8 p, string8 want, Style st):
    ref []char8 got = clean_in(p, st)
    defer #delete(got)
    string8 g = string8(got[:])
    return #expect(g == want, style_name(st), ": clean(\"", p, "\") is \"", g, "\", not \"", want, "\"")

private bool join_is(i64 n, string8 a, string8 b, string8 c, string8 d, string8 want, Style st):
    [4]string8 all = [a, b, c, d]
    ref []char8 got = join_in(all[0..<n], st)
    defer #delete(got)
    string8 g = string8(got[:])
    return #expect(g == want, style_name(st), ": join of ", n, " parts (\"", a, "\", \"", b, "\", \"", c, "\", …) is \"", g, "\", not \"", want, "\"")

private bool split_is(string8 p, string8 want_dir, string8 want_file, Style st):
    (string8 d, string8 f) = split_in(p, st)
    return #expect(d == want_dir && f == want_file, style_name(st), ": split(\"", p, "\") is (\"", d, "\", \"", f, "\"), not (\"", want_dir, "\", \"", want_file, "\")")

private bool ext_is(string8 p, string8 want, Style st):
    string8 g = ext_in(p, st)
    return #expect(g == want, style_name(st), ": ext(\"", p, "\") is \"", g, "\", not \"", want, "\"")

private bool base_is(string8 p, string8 want, Style st):
    string8 g = base_in(p, st)
    return #expect(g == want, style_name(st), ": base(\"", p, "\") is \"", g, "\", not \"", want, "\"")

private bool dir_is(string8 p, string8 want, Style st):
    ref []char8 got = dir_in(p, st)
    defer #delete(got)
    string8 g = string8(got[:])
    return #expect(g == want, style_name(st), ": dir(\"", p, "\") is \"", g, "\", not \"", want, "\"")

private bool is_abs_is(string8 p, bool want, Style st):
    bool g = is_abs_in(p, st)
    return #expect(g == want, style_name(st), ": is_abs(\"", p, "\") is ", g)

private bool rel_is(string8 from, string8 to, string8 want, Style st):
    try ref []char8 got = rel_in(from, to, st) else code:
        return #expect(false, style_name(st), ": rel(\"", from, "\", \"", to, "\") failed with ", code, "; wanted \"", want, "\"")
    defer #delete(got)
    string8 g = string8(got[:])
    return #expect(g == want, style_name(st), ": rel(\"", from, "\", \"", to, "\") is \"", g, "\", not \"", want, "\"")

private bool rel_fails(string8 from, string8 to, i32 want, Style st):
    try ref []char8 got = rel_in(from, to, st) else code:
        return #expect(code == want, style_name(st), ": rel(\"", from, "\", \"", to, "\") failed with ", code, ", not ", want)
    defer #delete(got)
    return #expect(false, style_name(st), ": rel(\"", from, "\", \"", to, "\") answered \"", string8(got[:]), "\"; wanted code ", want)

private bool volume_is(string8 p, string8 want, Style st):
    string8 g = p[0..<volume_len(p, st)]
    return #expect(slashed_equal(g, want, st), style_name(st), ": volume(\"", p, "\") is \"", g, "\", not \"", want, "\"")

private bool match_is(string8 pattern, string8 name, bool want, Style st):
    try bool g = match_in(pattern, name, st) else code:
        return #expect(false, style_name(st), ": match(\"", pattern, "\", \"", name, "\") failed with ", code)
    return #expect(g == want, style_name(st), ": match(\"", pattern, "\", \"", name, "\") is ", g)

private bool match_bad(string8 pattern, string8 name, Style st):
    try bool g = match_in(pattern, name, st) else code:
        return #expect(code == BAD_PATTERN, style_name(st), ": match(\"", pattern, "\", \"", name, "\") failed with ", code, ", not BAD_PATTERN")
    return #expect(false, style_name(st), ": match(\"", pattern, "\", \"", name, "\") answered ", g, " for a malformed pattern")

i32 test():
    bool ok = true

    // ════ POSIX ════════════════════════════════════════════════════════════
    // ── Clean ──
    ok = clean_is("abc", "abc", Style.Posix) && ok
    ok = clean_is("abc/def", "abc/def", Style.Posix) && ok
    ok = clean_is("a/b/c", "a/b/c", Style.Posix) && ok
    ok = clean_is(".", ".", Style.Posix) && ok
    ok = clean_is("..", "..", Style.Posix) && ok
    ok = clean_is("../..", "../..", Style.Posix) && ok
    ok = clean_is("../../abc", "../../abc", Style.Posix) && ok
    ok = clean_is("/abc", "/abc", Style.Posix) && ok
    ok = clean_is("/", "/", Style.Posix) && ok
    ok = clean_is("", ".", Style.Posix) && ok
    ok = clean_is("abc/", "abc", Style.Posix) && ok
    ok = clean_is("abc/def/", "abc/def", Style.Posix) && ok
    ok = clean_is("a/b/c/", "a/b/c", Style.Posix) && ok
    ok = clean_is("./", ".", Style.Posix) && ok
    ok = clean_is("../", "..", Style.Posix) && ok
    ok = clean_is("../../", "../..", Style.Posix) && ok
    ok = clean_is("/abc/", "/abc", Style.Posix) && ok
    ok = clean_is("abc//def//ghi", "abc/def/ghi", Style.Posix) && ok
    ok = clean_is("abc//", "abc", Style.Posix) && ok
    ok = clean_is("abc/./def", "abc/def", Style.Posix) && ok
    ok = clean_is("/./abc/def", "/abc/def", Style.Posix) && ok
    ok = clean_is("abc/.", "abc", Style.Posix) && ok
    ok = clean_is("abc/def/ghi/../jkl", "abc/def/jkl", Style.Posix) && ok
    ok = clean_is("abc/def/../ghi/../jkl", "abc/jkl", Style.Posix) && ok
    ok = clean_is("abc/def/..", "abc", Style.Posix) && ok
    ok = clean_is("abc/def/../..", ".", Style.Posix) && ok
    ok = clean_is("/abc/def/../..", "/", Style.Posix) && ok
    ok = clean_is("abc/def/../../..", "..", Style.Posix) && ok
    ok = clean_is("/abc/def/../../..", "/", Style.Posix) && ok
    ok = clean_is("abc/def/../../../ghi/jkl/../../../mno", "../../mno", Style.Posix) && ok
    ok = clean_is("/../abc", "/abc", Style.Posix) && ok
    ok = clean_is("a/../b:/../../c", "../c", Style.Posix) && ok
    ok = clean_is("abc/./../def", "def", Style.Posix) && ok
    ok = clean_is("abc//./../def", "def", Style.Posix) && ok
    ok = clean_is("abc/../../././../def", "../../def", Style.Posix) && ok
    ok = clean_is("//abc", "/abc", Style.Posix) && ok
    ok = clean_is("///abc", "/abc", Style.Posix) && ok
    ok = clean_is("//abc//", "/abc", Style.Posix) && ok
    ok = clean_is("c:", "c:", Style.Posix) && ok
    ok = clean_is("c:\\", "c:\\", Style.Posix) && ok
    ok = clean_is("c:\\abc", "c:\\abc", Style.Posix) && ok
    ok = clean_is("c:abc\\..\\..\\.\\.\\..\\def", "c:abc\\..\\..\\.\\.\\..\\def", Style.Posix) && ok
    ok = clean_is("c:\\abc\\def\\..\\..", "c:\\abc\\def\\..\\..", Style.Posix) && ok
    ok = clean_is("c:\\..\\abc", "c:\\..\\abc", Style.Posix) && ok
    ok = clean_is("c:..\\abc", "c:..\\abc", Style.Posix) && ok
    ok = clean_is("c:\\b:\\..\\..\\..\\d", "c:\\b:\\..\\..\\..\\d", Style.Posix) && ok
    ok = clean_is("\\", "\\", Style.Posix) && ok
    ok = clean_is("\\\\i\\..\\c$", "\\\\i\\..\\c$", Style.Posix) && ok
    ok = clean_is("\\\\i\\..\\i\\c$", "\\\\i\\..\\i\\c$", Style.Posix) && ok
    ok = clean_is("\\\\i\\..\\I\\c$", "\\\\i\\..\\I\\c$", Style.Posix) && ok
    ok = clean_is("\\\\host\\share\\foo\\..\\bar", "\\\\host\\share\\foo\\..\\bar", Style.Posix) && ok
    ok = clean_is("//host/share/foo/../baz", "/host/share/baz", Style.Posix) && ok
    ok = clean_is("\\\\host\\share\\foo\\..\\..\\..\\..\\bar", "\\\\host\\share\\foo\\..\\..\\..\\..\\bar", Style.Posix) && ok
    ok = clean_is("\\\\.\\C:\\a\\..\\..\\..\\..\\bar", "\\\\.\\C:\\a\\..\\..\\..\\..\\bar", Style.Posix) && ok
    ok = clean_is("\\\\.\\C:\\\\\\\\a", "\\\\.\\C:\\\\\\\\a", Style.Posix) && ok
    ok = clean_is("\\\\a\\b\\..\\c", "\\\\a\\b\\..\\c", Style.Posix) && ok
    ok = clean_is("\\\\a\\b", "\\\\a\\b", Style.Posix) && ok
    ok = clean_is(".\\c:", ".\\c:", Style.Posix) && ok
    ok = clean_is(".\\c:\\foo", ".\\c:\\foo", Style.Posix) && ok
    ok = clean_is(".\\c:foo", ".\\c:foo", Style.Posix) && ok
    ok = clean_is("\\\\?\\C:\\", "\\\\?\\C:\\", Style.Posix) && ok
    ok = clean_is("\\\\?\\C:\\a", "\\\\?\\C:\\a", Style.Posix) && ok
    ok = clean_is("a/../c:", "c:", Style.Posix) && ok
    ok = clean_is("a\\..\\c:", "a\\..\\c:", Style.Posix) && ok
    ok = clean_is("a/../c:/a", "c:/a", Style.Posix) && ok
    ok = clean_is("a/../../c:", "../c:", Style.Posix) && ok
    ok = clean_is("foo:bar", "foo:bar", Style.Posix) && ok
    ok = clean_is("/a/../??/a", "/??/a", Style.Posix) && ok
    // ── Join ──
    ok = join_is(0, "", "", "", "", "", Style.Posix) && ok
    ok = join_is(1, "", "", "", "", "", Style.Posix) && ok
    ok = join_is(1, "/", "", "", "", "/", Style.Posix) && ok
    ok = join_is(1, "a", "", "", "", "a", Style.Posix) && ok
    ok = join_is(2, "a", "b", "", "", "a/b", Style.Posix) && ok
    ok = join_is(2, "a", "", "", "", "a", Style.Posix) && ok
    ok = join_is(2, "", "b", "", "", "b", Style.Posix) && ok
    ok = join_is(2, "/", "a", "", "", "/a", Style.Posix) && ok
    ok = join_is(2, "/", "a/b", "", "", "/a/b", Style.Posix) && ok
    ok = join_is(2, "/", "", "", "", "/", Style.Posix) && ok
    ok = join_is(2, "/a", "b", "", "", "/a/b", Style.Posix) && ok
    ok = join_is(2, "a", "/b", "", "", "a/b", Style.Posix) && ok
    ok = join_is(2, "/a", "/b", "", "", "/a/b", Style.Posix) && ok
    ok = join_is(2, "a/", "b", "", "", "a/b", Style.Posix) && ok
    ok = join_is(2, "a/", "", "", "", "a", Style.Posix) && ok
    ok = join_is(2, "", "", "", "", "", Style.Posix) && ok
    ok = join_is(3, "/", "a", "b", "", "/a/b", Style.Posix) && ok
    ok = join_is(2, "//", "a", "", "", "/a", Style.Posix) && ok
    ok = join_is(2, "directory", "file", "", "", "directory/file", Style.Posix) && ok
    ok = join_is(2, "C:\\Windows\\", "System32", "", "", "C:\\Windows\\/System32", Style.Posix) && ok
    ok = join_is(2, "C:\\Windows\\", "", "", "", "C:\\Windows\\", Style.Posix) && ok
    ok = join_is(2, "C:\\", "Windows", "", "", "C:\\/Windows", Style.Posix) && ok
    ok = join_is(2, "C:", "a", "", "", "C:/a", Style.Posix) && ok
    ok = join_is(2, "C:", "a\\b", "", "", "C:/a\\b", Style.Posix) && ok
    ok = join_is(3, "C:", "a", "b", "", "C:/a/b", Style.Posix) && ok
    ok = join_is(3, "C:", "", "b", "", "C:/b", Style.Posix) && ok
    ok = join_is(4, "C:", "", "", "b", "C:/b", Style.Posix) && ok
    ok = join_is(2, "C:", "", "", "", "C:", Style.Posix) && ok
    ok = join_is(3, "C:", "", "", "", "C:", Style.Posix) && ok
    ok = join_is(2, "C:", "\\a", "", "", "C:/\\a", Style.Posix) && ok
    ok = join_is(3, "C:", "", "\\a", "", "C:/\\a", Style.Posix) && ok
    ok = join_is(2, "C:.", "a", "", "", "C:./a", Style.Posix) && ok
    ok = join_is(2, "C:a", "b", "", "", "C:a/b", Style.Posix) && ok
    ok = join_is(3, "C:a", "b", "d", "", "C:a/b/d", Style.Posix) && ok
    ok = join_is(2, "\\\\host\\share", "foo", "", "", "\\\\host\\share/foo", Style.Posix) && ok
    ok = join_is(1, "\\\\host\\share\\foo", "", "", "", "\\\\host\\share\\foo", Style.Posix) && ok
    ok = join_is(2, "//host/share", "foo/bar", "", "", "/host/share/foo/bar", Style.Posix) && ok
    ok = join_is(1, "\\", "", "", "", "\\", Style.Posix) && ok
    ok = join_is(2, "\\", "", "", "", "\\", Style.Posix) && ok
    ok = join_is(2, "\\", "a", "", "", "\\/a", Style.Posix) && ok
    ok = join_is(2, "\\\\", "a", "", "", "\\\\/a", Style.Posix) && ok
    ok = join_is(3, "\\", "a", "b", "", "\\/a/b", Style.Posix) && ok
    ok = join_is(3, "\\\\", "a", "b", "", "\\\\/a/b", Style.Posix) && ok
    ok = join_is(3, "\\", "\\\\a\\b", "c", "", "\\/\\\\a\\b/c", Style.Posix) && ok
    ok = join_is(3, "\\\\a", "b", "c", "", "\\\\a/b/c", Style.Posix) && ok
    ok = join_is(3, "\\\\a\\", "b", "c", "", "\\\\a\\/b/c", Style.Posix) && ok
    ok = join_is(2, "//", "a", "", "", "/a", Style.Posix) && ok
    ok = join_is(2, "a:\\b\\c", "x\\..\\y:\\..\\..\\z", "", "", "a:\\b\\c/x\\..\\y:\\..\\..\\z", Style.Posix) && ok
    ok = join_is(2, "\\", "??\\a", "", "", "\\/??\\a", Style.Posix) && ok
    // ── Split ──
    ok = split_is("a/b", "a/", "b", Style.Posix) && ok
    ok = split_is("a/b/", "a/b/", "", Style.Posix) && ok
    ok = split_is("a/", "a/", "", Style.Posix) && ok
    ok = split_is("a", "", "a", Style.Posix) && ok
    ok = split_is("/", "/", "", Style.Posix) && ok
    ok = split_is("c:", "", "c:", Style.Posix) && ok
    ok = split_is("c:/", "c:/", "", Style.Posix) && ok
    ok = split_is("c:/foo", "c:/", "foo", Style.Posix) && ok
    ok = split_is("c:/foo/bar", "c:/foo/", "bar", Style.Posix) && ok
    ok = split_is("//host/share", "//host/", "share", Style.Posix) && ok
    ok = split_is("//host/share/", "//host/share/", "", Style.Posix) && ok
    ok = split_is("//host/share/foo", "//host/share/", "foo", Style.Posix) && ok
    ok = split_is("\\\\host\\share", "", "\\\\host\\share", Style.Posix) && ok
    ok = split_is("\\\\host\\share\\", "", "\\\\host\\share\\", Style.Posix) && ok
    ok = split_is("\\\\host\\share\\foo", "", "\\\\host\\share\\foo", Style.Posix) && ok
    // ── Ext ──
    ok = ext_is("path.go", ".go", Style.Posix) && ok
    ok = ext_is("path.go", ".go", Style.Posix) && ok
    ok = ext_is("path.pb.go", ".go", Style.Posix) && ok
    ok = ext_is("path.pb.go", ".go", Style.Posix) && ok
    ok = ext_is("a.dir/b", "", Style.Posix) && ok
    ok = ext_is("a.dir\\b", ".dir\\b", Style.Posix) && ok
    ok = ext_is("a.dir/b.go", ".go", Style.Posix) && ok
    ok = ext_is("a.dir\\b.go", ".go", Style.Posix) && ok
    ok = ext_is("a.dir/", "", Style.Posix) && ok
    ok = ext_is("a.dir\\", ".dir\\", Style.Posix) && ok
    // ── Base ──
    ok = base_is("", ".", Style.Posix) && ok
    ok = base_is(".", ".", Style.Posix) && ok
    ok = base_is("/.", ".", Style.Posix) && ok
    ok = base_is("/", "/", Style.Posix) && ok
    ok = base_is("////", "/", Style.Posix) && ok
    ok = base_is("x/", "x", Style.Posix) && ok
    ok = base_is("abc", "abc", Style.Posix) && ok
    ok = base_is("abc/def", "def", Style.Posix) && ok
    ok = base_is("a/b/.x", ".x", Style.Posix) && ok
    ok = base_is("a/b/c.", "c.", Style.Posix) && ok
    ok = base_is("a/b/c.x", "c.x", Style.Posix) && ok
    ok = base_is("c:\\", "c:\\", Style.Posix) && ok
    ok = base_is("c:.", "c:.", Style.Posix) && ok
    ok = base_is("c:\\a\\b", "c:\\a\\b", Style.Posix) && ok
    ok = base_is("c:a\\b", "c:a\\b", Style.Posix) && ok
    ok = base_is("c:a\\b\\c", "c:a\\b\\c", Style.Posix) && ok
    ok = base_is("\\\\host\\share\\", "\\\\host\\share\\", Style.Posix) && ok
    ok = base_is("\\\\host\\share\\a", "\\\\host\\share\\a", Style.Posix) && ok
    ok = base_is("\\\\host\\share\\a\\b", "\\\\host\\share\\a\\b", Style.Posix) && ok
    // ── Dir ──
    ok = dir_is("", ".", Style.Posix) && ok
    ok = dir_is(".", ".", Style.Posix) && ok
    ok = dir_is("/.", "/", Style.Posix) && ok
    ok = dir_is("/", "/", Style.Posix) && ok
    ok = dir_is("/foo", "/", Style.Posix) && ok
    ok = dir_is("x/", "x", Style.Posix) && ok
    ok = dir_is("abc", ".", Style.Posix) && ok
    ok = dir_is("abc/def", "abc", Style.Posix) && ok
    ok = dir_is("a/b/.x", "a/b", Style.Posix) && ok
    ok = dir_is("a/b/c.", "a/b", Style.Posix) && ok
    ok = dir_is("a/b/c.x", "a/b", Style.Posix) && ok
    ok = dir_is("////", "/", Style.Posix) && ok
    ok = dir_is("c:\\", ".", Style.Posix) && ok
    ok = dir_is("c:.", ".", Style.Posix) && ok
    ok = dir_is("c:\\a\\b", ".", Style.Posix) && ok
    ok = dir_is("c:a\\b", ".", Style.Posix) && ok
    ok = dir_is("c:a\\b\\c", ".", Style.Posix) && ok
    ok = dir_is("\\\\host\\share", ".", Style.Posix) && ok
