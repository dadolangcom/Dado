    ok = is_abs_is("/a/../bb", true, Style.Posix) && ok
    ok = is_abs_is("c:/a/../bb", false, Style.Posix) && ok
    ok = is_abs_is(".", false, Style.Posix) && ok
    ok = is_abs_is("c:.", false, Style.Posix) && ok
    ok = is_abs_is("./", false, Style.Posix) && ok
    ok = is_abs_is("c:./", false, Style.Posix) && ok
    ok = is_abs_is("lala", false, Style.Posix) && ok
    ok = is_abs_is("c:lala", false, Style.Posix) && ok
    ok = is_abs_is("C:\\", false, Style.Posix) && ok
