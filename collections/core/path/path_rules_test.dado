    ok = dir_is("\\\\host\\share\\a\\b", ".", Style.Posix) && ok
    ok = dir_is("\\\\\\\\", ".", Style.Posix) && ok
    // ── IsAbs ──
    ok = is_abs_is("", false, Style.Posix) && ok
    ok = is_abs_is("c:", false, Style.Posix) && ok
    ok = is_abs_is("/", true, Style.Posix) && ok
    ok = is_abs_is("c:/", false, Style.Posix) && ok
    ok = is_abs_is("/usr/bin/gcc", true, Style.Posix) && ok
    ok = is_abs_is("c:/usr/bin/gcc", false, Style.Posix) && ok
    ok = is_abs_is("..", false, Style.Posix) && ok
