@test
// The building half when there is no memory, `clone`, and the size guards.
//
// What is claimed:
//
//   * **every function that makes new bytes answers `nil` (or `false`) when
//     its allocation fails**, reached at once by a refusing allocator under
//     `using`: `clone`, `concat`, `join`, `replace`, `replace_n`, `repeat`,
//     `to_upper`, `to_lower`, `split`, `clone_to_cstring`,
//     `clone_from_cstring`, `builder`, and a builder's `append` and
//     `append_char` once its room is spent;
//   * **`clone` is a copy**: equal bytes, its own storage;
//   * **a size an `i64` cannot count is refused, not wrapped**: `repeat` and
//     `replace_n` answer `nil` before they reach the allocator.
package strings

import "core:mem/libc"

// An allocator that refuses everything.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

// C's heap, refusing any block over 32 bytes, so a builder can be made and
// then cannot grow far.
private rawptr small(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    if (mode == AllocatorMode.Alloc || mode == AllocatorMode.Resize) && nbytes > 32:
        return nil
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) heap = libc.allocator()
    return heap.proc(heap.data, mode, nbytes, align, old, old_size)

i32 test():
    bool ok = true

    // ── clone ────────────────────────────────────────────────────────────────
    string8 src = "hello"
    ref []char8 copy = clone(src)
    string8 copied = copy
    ok = #expect(copied == "hello", "clone was ", copied) && ok
    copy[0] = 'J'
    ok = #expect(src == "hello" && copied == "Jello", "clone shared its source's bytes") && ok
    #delete(copy)
    ref []char8 empty = clone("")
    ok = #expect(empty != nil && #len(empty) == 0, "clone of the empty string was not an empty run") && ok
    #delete(empty)

    // ── no memory: every allocating function at once ───────────────────────
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) nothing = (refuses, nil)
    using nothing:
        ok = #expect(clone("abc") == nil, "clone without memory was not nil") && ok
        ok = #expect(concat("a", "b") == nil, "concat without memory was not nil") && ok
        ok = #expect(join(["a", "b"], ",") == nil, "join without memory was not nil") && ok
        ok = #expect(replace("aXb", "X", "Y") == nil, "replace without memory was not nil") && ok
        ok = #expect(replace_n("aXbX", "X", "YY", 1) == nil, "replace_n without memory was not nil") && ok
        ok = #expect(repeat("ab", 3) == nil, "repeat without memory was not nil") && ok
        ok = #expect(to_upper("abc") == nil, "to_upper without memory was not nil") && ok
        ok = #expect(to_lower("ABC") == nil, "to_lower without memory was not nil") && ok
        ok = #expect(split("a,b", ",") == nil, "split without memory was not nil") && ok
        ok = #expect(clone_to_cstring("abc") == nil, "clone_to_cstring without memory was not nil") && ok
        cstring lit = "abc"
        ok = #expect(clone_from_cstring(lit) == nil, "clone_from_cstring without memory was not nil") && ok
        Builder none = builder()
        ok = #expect(none == nil, "a builder without memory was not nil") && ok
        ok = #expect(!append(&none, "x") && !append_char(&none, 'x'), "append to a nil builder answered true") && ok
        ok = #expect(text(none) == "", "a nil builder's text was not empty") && ok

    // A builder that was made, and then cannot grow: `append` answers
    // `false` and appends nothing, so what was built is still there.
    Builder b = builder(4) using (small, nil)
    ok = #expect(b != nil, "a builder within the block was refused") && ok
    ok = #expect(append(&b, "abcd"), "an append within the room failed") && ok
    ok = #expect(!append(&b, "this is far longer than thirty-two bytes, so it cannot fit"), "an append past the block answered true") && ok
    ok = #expect(text(b) == "abcd", "a refused append changed the text: ", text(b)) && ok
    i64 room = #len(b)
    for i in 0..<64:
        if !append_char(&b, 'z'):
            break
    ok = #expect(#len(b) <= 32 && #len(b) >= room, "append_char grew past the block") && ok
    #delete(b)

    // ── sizes an i64 cannot count ────────────────────────────────────────────
    ok = #expect(repeat("ab", 9223372036854775807) == nil, "repeat past i64 was not refused") && ok
    ok = #expect(repeat("ab", 4611686018427387904) == nil, "repeat to exactly 2^63 was not refused") && ok
    // `replace_n`'s growth is `hits * (#len(new) - #len(old))`; the hits are
    // few here, so the guard must answer what fits.
    ref []char8 grown = replace_n("aXbX", "X", "YYY", 0 - 1)
    ok = #expect(grown != nil && string8(grown[:]) == "aYYYbYYY", "replace_n within range") && ok
    #delete(grown)
    ref []char8 zero = repeat("", 9223372036854775807)
    ok = #expect(zero != nil && #len(zero) == 0, "repeat of the empty string is empty however many times") && ok
    #delete(zero)

    // ── the private trim set and `trim_right_cr` ─────────────────────────────
    ok = #expect(is_space(' ') && is_space('\t') && is_space('\n') && is_space('\r'), "the four trim bytes") && ok
    ok = #expect(!is_space('\x0B') && !is_space('\x0C') && !is_space('a'), "\\v and \\f are not trimmed") && ok
    ok = #expect(trim("\x0B a \x0C") == "\x0B a \x0C", "trim cut \\v or \\f") && ok
    ok = #expect(trim_right_cr("a\r") == "a" && trim_right_cr("a\r\r") == "a\r" && trim_right_cr("a ") == "a " && trim_right_cr("") == "", "trim_right_cr") && ok

    if ok:
        return 0
    return 1
