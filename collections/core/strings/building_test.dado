@test
// `rest`, `offset_in`, and the text-building half — `bytes`, `concat`, `join`
// and `Builder`.
//
// What is claimed:
//
//   * **`rest` is `substring` to the end**, with the same clamps at both ends.
//   * **`offset_in` answers by address, not by contents**, and it is what
//     makes two splitters compose: a line window from `line` and a word
//     window from `field` over what followed it become one span of the
//     parent, which neither window's own bounds could reach.
//   * **`bytes` is a reinterpret**: same length, same bytes, and a write
//     through it lands in the string it came from.
//   * **every function that makes new bytes hands back something that can be
//     freed**, and this file frees all of it — the package's tests run clean
//     under LeakSanitizer, which is the claim the convention is for.
//   * **under a `using` arena** the same calls land in the arena, and nothing
//     is `#delete`d: the arena's `destroy` is the free.
package strings

import "core:mem/arena"
import "core:mem/libc"

i32 test():
    bool ok = true

    // ── rest ─────────────────────────────────────────────────────────────────

    ok = #expect(rest("hello", 0) == "hello", "rest from 0 was ", rest("hello", 0)) && ok
    ok = #expect(rest("hello", 2) == "llo", "rest from 2 was ", rest("hello", 2)) && ok
    ok = #expect(rest("hello", 5) == "", "rest from the end was ", rest("hello", 5)) && ok
    ok = #expect(rest("hello", 99) == "", "rest past the end was not clamped") && ok
    ok = #expect(rest("hello", 0 - 3) == "hello", "a negative start was not clamped") && ok
    ok = #expect(rest("", 0) == "", "rest of the empty string") && ok
    // The shape it replaces, and the one that reads as an end index.
    string8 word = "hello world"
    ok = #expect(rest(word, 6) == substring(word, 6, #len(word)), "rest disagreed with substring to the end") && ok

    // ── offset_in ────────────────────────────────────────────────────────────

    string8 parent = "alpha beta\ngamma delta\n"
    (i64 at0, bool in0) = offset_in(parent, parent)
    ok = #expect(in0 && at0 == 0, "a string is not at 0 in itself: ", at0) && ok
    (i64 at1, bool in1) = offset_in(parent, substring(parent, 6, 4))
    ok = #expect(in1 && at1 == 6, "substring(parent, 6, 4) was at ", at1) && ok
    (i64 at2, bool in2) = offset_in(parent, rest(parent, #len(parent)))
    ok = #expect(in2 && at2 == #len(parent), "the empty window at the end was at ", at2) && ok
    // The parent is not inside one of its own windows.
    (i64 _, bool in3) = offset_in(substring(parent, 6, 4), parent)
    ok = #expect(!in3, "a parent was found inside its own window") && ok
    // A window that overhangs the parent's end is not inside it.
    string8 head = substring(parent, 0, 5)
    (i64 _, bool in4) = offset_in(head, substring(parent, 3, 4))
    ok = #expect(!in4, "a window running past its parent's end was found inside it") && ok
    // Equal bytes somewhere else are a different place.
    ref []char8 elsewhere = concat("alpha", "")
    (i64 _, bool in5) = offset_in(parent, string8(elsewhere[:]))
    ok = #expect(!in5, "equal bytes in another buffer were found inside the parent") && ok
    #delete(elsewhere)

    // **Composing two splitters**: extend the first line to cover the next
    // word. Neither window can reach the other's bytes; the parent can.
    (string8 first_line, string8 after, bool had_line) = line(parent)
    (string8 next_word, string8 _, bool had_word) = field(after)
    ok = #expect(had_line && had_word, "the splitters found no line or no word") && ok
    (i64 from, bool from_ok) = offset_in(parent, first_line)
    (i64 upto, bool upto_ok) = offset_in(parent, next_word)
    ok = #expect(from_ok && upto_ok, "a splitter's window was not found in its parent") && ok
    string8 span = parent[from..<(upto + #len(next_word))]
    ok = #expect(span == "alpha beta\ngamma", "the composed span was ", span) && ok

    // ── bytes ────────────────────────────────────────────────────────────────

    []char8 raw = bytes("hé")
    ok = #expect(#len(raw) == 3, "bytes of a two-character, three-byte string had ", #len(raw)) && ok
    ok = #expect(raw[0] == 'h' && raw[1] == char8(0xC3) && raw[2] == char8(0xA9), "bytes were not the string's bytes") && ok
    []char8 no_raw = bytes("")
    ok = #expect(#len(no_raw) == 0, "bytes of the empty string was not empty") && ok
    ref []char8 owned = concat("ab", "c")
    string8 txt = string8(owned[:])
    []char8 through = bytes(txt)
    through[0] = 'X'
    ok = #expect(txt == "Xbc", "a write through bytes() did not land in the string: ", txt) && ok
    (i64 bat, bool bin) = offset_in(txt, string8(through))
    ok = #expect(bin && bat == 0, "bytes() moved the string") && ok
    #delete(owned)

    // ── concat ───────────────────────────────────────────────────────────────

    ref []char8 ab = concat("ab", "cd")
    ok = #expect(string8(ab[:]) == "abcd", "concat was ", string8(ab[:])) && ok
    #delete(ab)
    ref []char8 left = concat("", "x")
    ref []char8 right = concat("x", "")
    ref []char8 none = concat("", "")
    ok = #expect(string8(left[:]) == "x" && string8(right[:]) == "x", "concat with an empty side was wrong") && ok
    ok = #expect(none != nil && #len(none) == 0, "concat of two empties was not an empty run") && ok
    #delete(left)
    #delete(right)
    #delete(none)

    // ── join ─────────────────────────────────────────────────────────────────

    ref []char8 three = join(["a", "bb", "ccc"], ", ")
    ok = #expect(string8(three[:]) == "a, bb, ccc", "join was ", string8(three[:])) && ok
    #delete(three)
    // A one-element literal is its element (a 1-tuple is a scalar), so a
    // one-part list is a window of one over a longer array.
    [2]string8 duo = ["only", "unused"]
    ref []char8 one = join(duo[0..<1], ", ")
    ok = #expect(string8(one[:]) == "only", "join of one part added a separator: ", string8(one[:])) && ok
    #delete(one)
    ref []char8 glued = join(["x", "y", "z"], "")
    ok = #expect(string8(glued[:]) == "xyz", "join with an empty separator was ", string8(glued[:])) && ok
    #delete(glued)
    [2]string8 pair = ["k", "v"]
    ref []char8 nothing = join(pair[0..<0], "=")
    ok = #expect(nothing != nil && #len(nothing) == 0, "join of no parts was not an empty run") && ok
    #delete(nothing)

    // ── Builder ──────────────────────────────────────────────────────────────

    Builder b = builder()
    ok = #expect(b != nil && text(b) == "", "a fresh builder was not empty") && ok
    ok = #expect(append(&b, "key"), "append failed") && ok
    ok = #expect(append_char(&b, '='), "append_char failed") && ok
    ok = #expect(append(&b, "value"), "append failed") && ok
    ok = #expect(text(b) == "key=value", "text was ", text(b)) && ok
    ref []char8 built = finish(&b)
    ok = #expect(string8(built[:]) == "key=value", "finish handed back ", string8(built[:])) && ok
    ok = #expect(b == nil, "finish left the builder holding the run") && ok
    ok = #expect(!append(&b, "more"), "append to a finished builder answered true") && ok
    // A finished builder is `nil`, so deleting it is deleting nothing.
    #delete(b)
    #delete(built)

    // Growth past the room it was made with, a byte at a time and a piece at
    // a time: the run moves, and `text` is read again after each.
    Builder g = builder(1)
    for i in 0..<300:
        _ = append_char(&g, 'a' + char8(i % 26))
    _ = append(&g, "|tail")
    string8 grown = text(g)
    ok = #expect(#len(grown) == 305, "a grown builder held ", #len(grown)) && ok
    ok = #expect(grown[0] == 'a' && grown[25] == 'z' && grown[26] == 'a', "a grown builder's bytes were wrong") && ok
    ok = #expect(ends_with(grown, "|tail"), "a grown builder lost its tail") && ok
    // Never finished: the builder is its run, and `#delete` ends it.
    #delete(g)

    // ── under a `using` arena ────────────────────────────────────────────────
    //
    // Nothing below is `#delete`d. Each result lands in `home`, which the
    // control (the same call, no `using`) shows the ambient did not.
    arena.Arena home = arena.over(libc.allocator())
    u64 empty = arena.used(home)

    ref []char8 ctl = join(["p", "q"], "+")
    ok = #expect(arena.used(home) == empty, "a join with no `using` spent the arena") && ok
    #delete(ctl)

    ref []char8 in_arena = join(["p", "q"], "+") using arena.allocator(&home)
    u64 after_join = arena.used(home)
    ok = #expect(after_join > empty, "a join under `using` did not land in the arena") && ok
    ok = #expect(string8(in_arena[:]) == "p+q", "the arena's join was ", string8(in_arena[:])) && ok

    ref []char8 cat = concat("left", "right") using arena.allocator(&home)
    ok = #expect(arena.used(home) > after_join, "a concat under `using` did not land in the arena") && ok
    ok = #expect(string8(cat[:]) == "leftright", "the arena's concat was ", string8(cat[:])) && ok

    // A builder made under `using` carries the arena, so its growth goes
    // there too, outside the `using` that made it.
    Builder ab_arena = builder(2) using arena.allocator(&home)
    u64 before_growth = arena.used(home)
    for i in 0..<100:
        _ = append(&ab_arena, "grow")
    ok = #expect(arena.used(home) > before_growth, "a builder made under `using` grew somewhere else") && ok
    string8 so_far = text(ab_arena)
    ok = #expect(#len(so_far) == 400, "the arena builder held ", #len(so_far)) && ok
    ref []char8 fin = finish(&ab_arena)
    ok = #expect(#len(fin) == 400, "the arena builder finished with ", #len(fin)) && ok
    arena.destroy(&home)

    if ok:
        return 0
    return 1
