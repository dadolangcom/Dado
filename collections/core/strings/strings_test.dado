@test
// Every function in this package answers a question about bytes that
// already exist, and every one of them has the same three interesting inputs:
// **the empty string, a string of one byte, and the boundary** — the prefix that
// is the whole string, the byte at index 0, the byte at index n−1, the needle
// that is longer than the haystack.
//
// That is what is claimed below, and deliberately not the middle: `contains
// ("hello world", "lo w")` is true under any implementation anybody would write
// by accident, and tells you nothing. `contains("", "")`, `starts_with(s, "")`
// and `ends_with(s, s)` are the inputs where a `<` that should be `<=`, a length
// read the wrong way round, or a C function reached with the wrong argument order
// actually shows.
//
// Two of these functions are **Dado loops** rather than C calls — `index_of`,
// `last_index_of`, `count_byte`, and `ends_with`'s comparison — and the
// descending walk in `last_index_of` is the one body here with an off-by-one to
// make, because ranges are ascending only and it counts down through a
// mutated index instead.
package strings

i32 test():
    bool ok = true

    // ── `==` on an empty string with no storage ─────────────────────────────
    //
    // A nil `ref []char8` viewed as a string is empty with a null pointer, and
    // `==` compared it through `memcmp(NULL, …, 0)`, which C forbids even for
    // zero bytes: this test aborted under UBSan (sawbox DI-0075).
    ref []char8 no_storage
    string8 nothing = no_storage
    ok = #expect(nothing == "", "an empty string with no storage equals \"\"") && ok
    ok = #expect(!(nothing != ""), "and is not unequal to it") && ok

    // ── `#len` of a string ───────────────────────────────────────────────────
    //
    // `length` was a synonym for `#len` and went when `#len` became one type,
    // `i64`, wherever it stands. The claims stay, asked of the builtin: the
    // empty string is the boundary a `strlen`-shaped mistake and a
    // `len`-shaped one both have to agree on, and the one-byte string is the
    // smallest non-zero answer.
    string8 no_bytes = ""
    string8 one_byte = "a"
    string8 five_bytes = "hello"
    ok = #expect(#len(no_bytes) == 0, "#len(\"\") was ", #len(no_bytes)) && ok
    ok = #expect(#len(one_byte) == 1, "#len(\"a\") was ", #len(one_byte)) && ok
    ok = #expect(#len(five_bytes) == 5, "#len(\"hello\") was ", #len(five_bytes)) && ok

    // `is_empty` **was** `s == ""` — equality of contents — and is
    // `#len(s) == 0` now, for a reason that is not about this
    // function: the equality compiles to a `memcmp`, and the `memcmp` put
    // `<string.h>` into the emitted C of everything that imported this package,
    // freestanding target or not. The two spellings are the same answer (`""`
    // has length zero, so the compare is over zero bytes and can only agree),
    // which is why the claims below are unchanged and are still worth making:
    // whichever way the body is written, it must agree with `#len(s) == 0`.
    ok = #expect(is_empty(""), "is_empty(\"\") was false") && ok
    ok = #expect(!is_empty("a"), "is_empty(\"a\") was true") && ok
    ok = #expect(is_empty(no_bytes) == (#len(no_bytes) == 0), "is_empty and #len disagreed on the empty string") && ok

    // ── compare, and the two predicates over it ──────────────────────────────
    //
    // The contract is the **normalisation**: C promises only the sign of
    // `strcmp`, so the claim is that this returns exactly −1, 0 or 1 and never
    // the difference of two bytes. A test written as `compare(a, b) < 0` would
    // pass against the unnormalised version and is therefore not a test of the
    // thing this function adds.
    i32 minus_one = 0 - 1
    ok = #expect(compare("a", "b") == minus_one, "compare(a, b) was ", compare("a", "b")) && ok
    ok = #expect(compare("b", "a") == 1, "compare(b, a) was ", compare("b", "a")) && ok
    ok = #expect(compare("a", "a") == 0, "compare(a, a) was ", compare("a", "a")) && ok

    // The empty string sorts before everything, and equals itself.
    ok = #expect(compare("", "") == 0, "compare(\"\", \"\") was ", compare("", "")) && ok
    ok = #expect(compare("", "a") == minus_one, "compare(\"\", a) was ", compare("", "a")) && ok
    ok = #expect(compare("a", "") == 1, "compare(a, \"\") was ", compare("a", "")) && ok

    // **A prefix sorts before what extends it**, which is the boundary case of
    // an ordering built on a terminated comparison: the shorter string runs out
    // first and its `\0` is what decides.
    ok = #expect(compare("abc", "abcd") == minus_one, "compare(abc, abcd) was ", compare("abc", "abcd")) && ok
    ok = #expect(compare("abcd", "abc") == 1, "compare(abcd, abc) was ", compare("abcd", "abc")) && ok

    // A byte far apart, so a normalisation that let a large magnitude through
    // would show: 'a' and 'z' are 25 apart and the answer is still 1.
    ok = #expect(compare("z", "a") == 1, "compare(z, a) was not normalised: ", compare("z", "a")) && ok

    // `before` and `after` are `compare`'s sign, and they are claimed as a
    // **trichotomy**: for any pair exactly one of before/after/equal holds. That
    // is one property rather than six expectations, and it is what fails if
    // either predicate is written with the comparison the wrong way round.
    ok = #expect(before("a", "b") && !after("a", "b"), "before/after disagreed on (a, b)") && ok
    ok = #expect(after("b", "a") && !before("b", "a"), "before/after disagreed on (b, a)") && ok
    ok = #expect(!before("a", "a") && !after("a", "a"), "an equal pair was ordered") && ok
    ok = #expect(before("", "a") && !before("a", ""), "the empty string did not sort first") && ok

    // ── starts_with ──────────────────────────────────────────────────────────
    //
    // `strncmp(s, prefix, length(prefix))`, so the count comes from the
    // **prefix** and not from `s` — and the two inputs that tell those apart are
    // the empty prefix and a prefix longer than `s`.
    ok = #expect(starts_with("hello", "hell"), "starts_with(hello, hell) was false") && ok
    ok = #expect(starts_with("hello", "h"), "starts_with(hello, h) was false") && ok
    ok = #expect(starts_with("hello", "hello"), "a string was not its own prefix") && ok
    ok = #expect(!starts_with("hello", "hello!"), "a longer prefix matched") && ok
    ok = #expect(!starts_with("hello", "ello"), "starts_with matched in the middle") && ok
    // **The empty prefix**: `strncmp(s, "", 0)` compares nothing and is 0, so
    // every string starts with the empty string. That is the mathematics and it
    // is also what the code does; pinning it stops a well-meant guard clause
    // from changing it.
    ok = #expect(starts_with("hello", ""), "the empty prefix did not match") && ok
    ok = #expect(starts_with("", ""), "the empty string did not start with the empty string") && ok
    ok = #expect(!starts_with("", "a"), "the empty string started with a byte") && ok

    // ── ends_with ────────────────────────────────────────────────────────────
    //
    // Written as a Dado loop over `s[(n - m) + i]`, so it has real index
    // arithmetic in it and the boundary is where that arithmetic is exercised:
    // `m == n` makes the offset zero, `m > n` is the guarded early return, and
    // `m == 0` runs no iterations at all.
    ok = #expect(ends_with("hello", "llo"), "ends_with(hello, llo) was false") && ok
    ok = #expect(ends_with("hello", "o"), "ends_with(hello, o) was false") && ok
    ok = #expect(ends_with("hello", "hello"), "a string was not its own suffix") && ok
    ok = #expect(!ends_with("hello", "hell"), "ends_with matched a prefix") && ok
    ok = #expect(!ends_with("hello", "xhello"), "a suffix longer than the string matched") && ok
    ok = #expect(ends_with("hello", ""), "the empty suffix did not match") && ok
    ok = #expect(ends_with("", ""), "the empty string did not end with the empty string") && ok
    ok = #expect(!ends_with("", "a"), "the empty string ended with a byte") && ok
    // One byte, which is the smallest string with a distinct first and last.
    ok = #expect(starts_with("a", "a") && ends_with("a", "a"), "a one-byte string was not its own prefix and suffix") && ok

    // ── contains ─────────────────────────────────────────────────────────────
    //
    // `strstr`, asked only against `nil`. The empty needle is C's own boundary:
    // `strstr(h, "")` returns `h`, so every string contains the empty string,
    // including the empty one.
    ok = #expect(contains("hello world", "o w"), "contains missed a needle spanning the middle") && ok
    ok = #expect(contains("hello", "hello"), "a string did not contain itself") && ok
    ok = #expect(contains("hello", "h"), "contains missed the first byte") && ok
    ok = #expect(contains("hello", "o"), "contains missed the last byte") && ok
    ok = #expect(!contains("hello", "hello!"), "a needle longer than the haystack matched") && ok
    ok = #expect(!contains("hello", "z"), "contains found an absent byte") && ok
    ok = #expect(contains("hello", ""), "the empty needle was not found") && ok
    ok = #expect(contains("", ""), "the empty needle was not found in the empty haystack") && ok
    ok = #expect(!contains("", "a"), "a byte was found in the empty haystack") && ok

    // ── has_byte ─────────────────────────────────────────────────────────────
    //
    // **The two `'\0'` claims below are inverted from what they were**, and
    // that is deliberate rather than a bug fix that happened to be nearby. This was
    // `strchr`, whose documented oddity was that searching for `'\0'` found the
    // *terminator* — so `has_byte(s, '\0')` was true for every string,
    // including the empty one, and the header said so because it was C's rule
    // left as C's rule. It is a Dado loop now and answers about the bytes the
    // string has, which is what `#len` of a string had already started doing.
    ok = #expect(has_byte("hello", 'h'), "has_byte missed the first byte") && ok
    ok = #expect(has_byte("hello", 'o'), "has_byte missed the last byte") && ok
    ok = #expect(!has_byte("hello", 'z'), "has_byte found an absent byte") && ok
    ok = #expect(!has_byte("", 'a'), "has_byte found a byte in the empty string") && ok
    ok = #expect(!has_byte("hello", '\0'), "a string with no interior NUL reported one") && ok
    ok = #expect(!has_byte("", '\0'), "the empty string reported a byte it does not have") && ok
    ok = #expect(has_byte("a\x00b", '\0'), "an interior NUL was not found") && ok

    // ── index_of / last_index_of ─────────────────────────────────────────────
    //
    // Both are Dado loops, and they are claimed **against each other** on a
    // string where the answers differ: "abcabc" has 'a' at 0 and at 3, so a
    // `last_index_of` that returned the first match, or an `index_of` that ran
    // to the end, fails here and passes on any string with one occurrence.
    ok = #expect(index_of("abcabc", 'a') == 0, "index_of(abcabc, a) was ", index_of("abcabc", 'a')) && ok
    ok = #expect(last_index_of("abcabc", 'a') == 3, "last_index_of(abcabc, a) was ", last_index_of("abcabc", 'a')) && ok
    ok = #expect(index_of("abcabc", 'c') == 2, "index_of(abcabc, c) was ", index_of("abcabc", 'c')) && ok
    ok = #expect(last_index_of("abcabc", 'c') == 5, "last_index_of at the final index was ", last_index_of("abcabc", 'c')) && ok

    // One occurrence: the two must agree, which is the property that ties the
    // ascending walk to the descending one.
    ok = #expect(index_of("abc", 'b') == last_index_of("abc", 'b'), "the two walks disagreed on a unique byte") && ok

    // Index 0 and index n−1 — the ends of both loops.
    ok = #expect(index_of("a", 'a') == 0, "index_of over one byte was ", index_of("a", 'a')) && ok
    ok = #expect(last_index_of("a", 'a') == 0, "last_index_of over one byte was ", last_index_of("a", 'a')) && ok

    // Absent, and the empty string: −1 from both, and the empty string is where
    // `last_index_of`'s `for i > 0` never runs a pass at all.
    ok = #expect(index_of("abc", 'z') == minus_one, "index_of of an absent byte was ", index_of("abc", 'z')) && ok
    ok = #expect(last_index_of("abc", 'z') == minus_one, "last_index_of of an absent byte was ", last_index_of("abc", 'z')) && ok
    ok = #expect(index_of("", 'a') == minus_one, "index_of over the empty string was ", index_of("", 'a')) && ok
    ok = #expect(last_index_of("", 'a') == minus_one, "last_index_of over the empty string was ", last_index_of("", 'a')) && ok

    // ── count_byte ───────────────────────────────────────────────────────────
    //
    // Zero, one and many, plus the string that is nothing but the byte — which
    // is the input where a loop bound that stopped one short is off by exactly
    // one and a `contains`-style early return would answer 1.
    ok = #expect(count_byte("", 'a') == 0, "count_byte over the empty string was ", count_byte("", 'a')) && ok
    ok = #expect(count_byte("abc", 'z') == 0, "count_byte of an absent byte was ", count_byte("abc", 'z')) && ok
    ok = #expect(count_byte("abc", 'b') == 1, "count_byte of a unique byte was ", count_byte("abc", 'b')) && ok
    ok = #expect(count_byte("aaa", 'a') == 3, "count_byte over a run was ", count_byte("aaa", 'a')) && ok
    ok = #expect(count_byte("a,b,c", ',') == 2, "count_byte of a separator was ", count_byte("a,b,c", ',')) && ok

    // The three byte-searching functions agree about **presence**, which is the
    // claim that ties them together: a byte occurs zero times exactly when
    // neither `has_byte` nor `index_of` finds it.
    ok = #expect((count_byte("abc", 'b') > 0) == has_byte("abc", 'b'), "count_byte and has_byte disagreed") && ok
    ok = #expect((count_byte("abc", 'z') > 0) == has_byte("abc", 'z'), "count_byte and has_byte disagreed on an absent byte") && ok
    ok = #expect((index_of("abc", 'z') >= 0) == has_byte("abc", 'z'), "index_of and has_byte disagreed on an absent byte") && ok

    // ── parsing is not in this package any more ──────────────────────────────
    //
    // The nine claims about `to_i32` and `to_f64` that stood here moved to
    // `collections/core/strings/parse/parse_test.dado` with the functions
    // (`STR-FREESTANDING`, 2026-09-02), unchanged, which is what makes the move
    // provably behaviour-preserving.
    //
    // **This suite does not import `core:strings/parse` to get them back.**
    // When it moved that package carried `<stdlib.h>`, and importing it here
    // would have hidden the header regression the move removed. Both parsers
    // are Dado now and the package includes nothing, but the claims live with
    // the functions and are that suite's.

    // An invariant rather than an expectation: a string's own length is where
    // every index-returning function above is bounded, and if `#len` did not
    // agree with the largest index `index_of` can return, the *package* would be
    // inconsistent with itself and there would be nothing to carry on for.
    string8 abcabc = "abcabc"
    #assert(last_index_of(abcabc, 'c') == #len(abcabc) - 1)

    // ── clone_to_cstring ─────────────────────────────────────────────────────
    //
    // Three inputs, and each is a boundary rather than a demonstration. The
    // **empty string** is the one an off-by-one in `n + 1` gets wrong in the
    // only direction that matters — a zero-length run has nowhere to put the
    // terminator. **One byte** is the smallest run with both a byte and a
    // terminator, so it is where a loop bound that should be `<` and is `<=`
    // writes the `\0` twice and loses the byte. And a string with an
    // **interior `\0`** is the input the whole `cstring` boundary exists
    // around: this function copies it through, because its job is the bytes it
    // was given, and what C then makes of them is C's rule and `measured`'s
    // problem rather than this function's.
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc = #default

    ref []char8 empty_run = clone_to_cstring("", alloc)
    ok = #expect(#len(empty_run) == 1, "clone of the empty string was ", #len(empty_run)) && ok
    ok = #expect(empty_run[0] == '\x00', "clone of the empty string did not terminate") && ok
    #delete(empty_run)

    ref []char8 one = clone_to_cstring("a", alloc)
    ok = #expect(#len(one) == 2, "clone of one byte was ", #len(one)) && ok
    ok = #expect(one[0] == 'a', "clone of one byte lost the byte") && ok
    ok = #expect(one[1] == '\x00', "clone of one byte did not terminate") && ok
    #delete(one)

    // `#len` reports every byte a string has, interior `\0` included — the
    // behaviour `strings.length` recorded changing away from `strlen` before
    // it was deleted in favour of `#len` — so the run is four bytes and the terminator is the fourth.
    string8 interior = "a\x00b"
    ref []char8 through = clone_to_cstring(interior, alloc)
    ok = #expect(#len(through) == 4, "clone of an interior-NUL string was ", #len(through)) && ok
    ok = #expect(through[1] == '\x00', "the interior NUL was not copied through") && ok
    ok = #expect(through[2] == 'b', "the byte after the interior NUL was lost") && ok
    ok = #expect(through[3] == '\x00', "the interior-NUL clone did not terminate") && ok
    #delete(through)

    // The invariant the three share, stated once: the run is always one longer
    // than the string, and its last byte is always the terminator. A caller
    // reading `len` gets the honest number and has to know this.
    ref []char8 any = clone_to_cstring("hello", alloc)
    #assert(#len(any) == #len(five_bytes) + 1)
    #assert(any[#len(any) - 1] == '\x00')
    #delete(any)

    // ── clone_from_cstring ───────────────────────────────────────────────────
    //
    // The inverse: C's bytes copied into a run Dado owns. To get a `cstring` to
    // feed it, clone one out first. The boundaries mirror the pair above.
    //
    // **A normal string** round-trips — the run reads back equal as a `string`,
    // and one byte shorter than `clone_to_cstring`'s output, because this copies
    // the bytes and not the terminator. **The empty cstring** is where
    // a measured length of 0 and `#make([]char8, 0)` meet: an empty run, no `memcpy`, no
    // fault. And **`nil`** copies to an empty run rather than faulting, the same
    // answer measuring `nil` gives.
    ref []char8 from_src = clone_to_cstring("hello", alloc)
    ref []char8 from_back = clone_from_cstring(cstring(from_src), alloc)
    ok = #expect(#len(from_back) == #len(five_bytes), "clone_from_cstring length was ", #len(from_back)) && ok
    ok = #expect(string8(from_back[:]) == "hello", "clone_from_cstring bytes differed") && ok
    #delete(from_back)
    #delete(from_src)

    ref []char8 empty_src = clone_to_cstring("", alloc)
    ref []char8 empty_back = clone_from_cstring(cstring(empty_src), alloc)
    ok = #expect(#len(empty_back) == 0, "clone_from_cstring of empty was ", #len(empty_back)) && ok
    #delete(empty_back)
    #delete(empty_src)

    cstring nil_c = nil
    ref []char8 nil_back = clone_from_cstring(nil_c, alloc)
    ok = #expect(#len(nil_back) == 0, "clone_from_cstring of nil was ", #len(nil_back)) && ok
    #delete(nil_back)

    // ── measuring a `cstring` ────────────────────────────────────────────────
    //
    // `strings.measure` went with `length`: a `cstring` is measured by `#len`
    // of its borrow, which `measured` below spells once. The claims stay —
    // S5b's three cases, which make the difference between measuring C's string
    // and `#len` of Dado's visible. **The empty string** is where a walk that
    // counts before it tests returns 1. **One byte** is the smallest answer
    // that is not the empty one. And a string with an **interior `\0`** is the
    // case the whole boundary exists around: `#len` says 3 and `measured` says
    // 1, because they are answering different questions about the same bytes —
    // *how many are there* and *how many will C read*.
    //
    // `nil` measures zero rather than faulting, which is the fourth case and
    // the one a program meets when C had nothing to say.
    ok = #expect(measured("") == 0, "measure of the empty string was ", measured("")) && ok
    ok = #expect(measured("a") == 1, "measure of one byte was ", measured("a")) && ok
    ok = #expect(measured("hello") == 5, "measure of five bytes was ", measured("hello")) && ok

    string8 interior_s = "a\x00b"
    ref []char8 clone = clone_to_cstring(interior_s, alloc)
    cstring c_of = cstring(clone)
    ok = #expect(#len(interior_s) == 3, "#len stopped at the interior NUL") && ok
    ok = #expect(measured(c_of) == 1, "measure ran past the interior NUL: ", measured(c_of)) && ok
    #delete(clone)

    cstring none = nil
    ok = #expect(measured(none) == 0, "measure of nil was ", measured(none)) && ok

    // And the round trip the pair is for: clone a string, measure the clone,
    // get the length back — for any string with no interior `\0`, which is the
    // condition C's kind of string is defined by.
    ref []char8 round = clone_to_cstring("hello", alloc)
    #assert(measured(cstring(round)) == #len(five_bytes))
    #delete(round)

    // ── borrow_from_cstring ──────────────────────────────────────────────────
    //
    // The other half of the ruling: the **no-copy** read. Everything above this
    // point that crosses inbound allocates; this one does not, and the only
    // thing it adds over the conversion `string(c)` is the `nil`.
    //
    // The claims are the same four `measured` makes, because the two answer the
    // same question in different currencies — a length and the bytes — and the
    // row's rule is that **`nil` is answered once and identically for both
    // halves**. So: the empty `cstring` borrows an empty `string`; a normal one
    // borrows bytes that compare equal to the original; an **interior `\0`**
    // stops the borrow where it stops `measured`, because the borrow's length
    // *is* `measured`; and `nil` borrows a zero-length `string` rather than
    // faulting.
    //
    // **`#len(borrow) == measured` on every input** is the claim that ties the
    // two together, and it is the one that would catch a `nil` guard added to
    // one and not the other.
    ref []char8 b_src = clone_to_cstring("hello", alloc)
    string8 borrowed = borrow_from_cstring(cstring(b_src))
    ok = #expect(#len(borrowed) == 5, "borrow_from_cstring length was ", #len(borrowed)) && ok
    ok = #expect(borrowed == "hello", "borrow_from_cstring bytes differed") && ok
    ok = #expect(#len(borrowed) == measured(cstring(b_src)), "borrow and measure disagreed") && ok
    #delete(b_src)

    ref []char8 b_empty_src = clone_to_cstring("", alloc)
    string8 b_empty = borrow_from_cstring(cstring(b_empty_src))
    ok = #expect(#len(b_empty) == 0, "borrow of the empty cstring was ", #len(b_empty)) && ok
    ok = #expect(is_empty(b_empty), "borrow of the empty cstring was not empty") && ok
    #delete(b_empty_src)

    // The interior `\0`, which is where a borrow and `#len` of the original
    // part company: three bytes went in and the borrow finds one, because C's
    // kind of string ends at the first terminator and the borrow's length is
    // the walk that finds it.
    ref []char8 b_interior = clone_to_cstring(interior_s, alloc)
    string8 b_cut = borrow_from_cstring(cstring(b_interior))
    ok = #expect(#len(b_cut) == 1, "borrow ran past the interior NUL: ", #len(b_cut)) && ok
    ok = #expect(b_cut == "a", "borrow of an interior-NUL string was not its first byte") && ok
    ok = #expect(#len(b_cut) == measured(cstring(b_interior)), "borrow and measure disagreed on an interior NUL") && ok
    #delete(b_interior)

    // `nil`, and the whole of the row's decision: a zero-length `string`, not a
    // fault and not a refusal. It is the same answer `measured(nil)` and
    // `clone_from_cstring(nil, …)` give — one answer for the boundary.
    string8 b_nil = borrow_from_cstring(none)
    ok = #expect(#len(b_nil) == 0, "borrow of nil was ", #len(b_nil)) && ok
    ok = #expect(is_empty(b_nil), "borrow of nil was not empty") && ok
    ok = #expect(#len(b_nil) == measured(none), "borrow and measure disagreed on nil") && ok

    // A zero-length borrow does **not** say which of `nil` and `""` it came
    // from, and this is the claim that says so out loud so nobody reads the
    // pair above as an identity. The question is `c == nil` and it is asked
    // directly.
    ok = #expect(#len(b_nil) == #len(b_empty), "the two empty answers differed in length") && ok
    ok = #expect(none == nil, "the nil cstring was not nil") && ok

    // ── the slicing half ─────────────────────────────────────────────────────
    //
    // Every one of these returns a **window** into its argument, so the claim
    // worth making about each is that the bytes are the right bytes and that
    // nothing was allocated to produce them. The second half is not directly
    // observable from Dado, so it is held by the package's header and by the
    // absence of an `Allocator` parameter on any of these signatures.
    //
    // The method is the file's own: the empty string, one byte, and the
    // boundary — not the middle, which is where a wrong implementation is most
    // likely to look right.

    // substring: clamped rather than refused, so every out-of-range ask has a
    // defined answer and the answer is always a window into `s`.
    ok = #expect(substring("hello", 1, 3) == "ell", "substring middle") && ok
    ok = #expect(substring("hello", 0, 0) == "", "substring of nothing") && ok
    ok = #expect(substring("hello", 0, 5) == "hello", "substring of everything") && ok
    ok = #expect(substring("hello", 3, 99) == "lo", "substring past the end was not clamped") && ok
    ok = #expect(substring("hello", 99, 1) == "", "substring starting past the end") && ok
    ok = #expect(substring("hello", 0 - 2, 2) == "he", "a negative start was not clamped") && ok
    ok = #expect(substring("hello", 2, 0 - 1) == "", "a negative count was not clamped") && ok
    ok = #expect(substring("", 0, 3) == "", "substring of the empty string") && ok

    // trim: the three boundaries are nothing to trim, everything to trim, and
    // one byte — the last being where an off-by-one eats the byte it kept.
    ok = #expect(trim("  hi  ") == "hi", "trim both ends") && ok
    ok = #expect(trim_left("  hi  ") == "hi  ", "trim_left") && ok
    ok = #expect(trim_right("  hi  ") == "  hi", "trim_right") && ok
    ok = #expect(trim("hi") == "hi", "trim with nothing to trim") && ok
    ok = #expect(trim("   ") == "", "trim of all space") && ok
    ok = #expect(trim("") == "", "trim of the empty string") && ok
    ok = #expect(trim(" a ") == "a", "trim down to one byte") && ok
    ok = #expect(trim("\t\n\r x \r\n\t") == "x", "trim of the four space bytes") && ok

    // split_first: the pair, and the property that makes a careless loop
    // terminate — when nothing is found, `head` is everything and `rest` is
    // empty, so the cursor always advances or stops.
    (string8 h1, string8 r1, bool f1) = split_first("a,b,c", ",")
    ok = #expect(f1 && h1 == "a" && r1 == "b,c", "split_first at the first separator") && ok

    (string8 h2, string8 r2, bool f2) = split_first("abc", ",")
    ok = #expect(!f2 && h2 == "abc" && r2 == "", "split_first with no separator") && ok

    (string8 h3, string8 r3, bool f3) = split_first(",abc", ",")
    ok = #expect(f3 && h3 == "" && r3 == "abc", "split_first at position zero") && ok

    (string8 h4, string8 r4, bool f4) = split_first("abc,", ",")
    ok = #expect(f4 && h4 == "abc" && r4 == "", "split_first at the last byte") && ok

    (string8 h5, string8 r5, bool f5) = split_first("", ",")
    ok = #expect(!f5 && h5 == "" && r5 == "", "split_first of the empty string") && ok

    (string8 h6, string8 _, bool f6) = split_first("abc", "")
    ok = #expect(!f6 && h6 == "abc", "an empty separator finds nothing") && ok

    (string8 h7, string8 r7, bool f7) = split_first("a--b", "--")
    ok = #expect(f7 && h7 == "a" && r7 == "b", "a multi-byte separator") && ok

    // The loop the pair exists for, walked to the end. Three fields out of two
    // separators is the claim; a cursor that failed to advance would hang here
    // rather than report, which is why the count is checked and not just the
    // last value.
    string8 rest = "one,two,three"
    i32 seen = 0
    string8 last = ""
    bool more = true
    for more:
        (string8 part, string8 tail, bool found) = split_first(rest, ",")
        seen = seen + 1
        last = part
        rest = tail
        more = found
    ok = #expect(seen == 3, "the cursor walk saw ", seen, " parts") && ok
    ok = #expect(last == "three", "the cursor walk ended at ", last) && ok

    // line: `\n` separates and a `\r` before it is not part of the line.
    (string8 l1, string8 lr1, bool lf1) = line("first\nsecond")
    ok = #expect(lf1 && l1 == "first" && lr1 == "second", "line split") && ok

    (string8 l2, string8 lr2, bool lf2) = line("first\r\nsecond")
    ok = #expect(lf2 && l2 == "first" && lr2 == "second", "a CRLF line kept its \\r") && ok

    (string8 l3, string8 _, bool lf3) = line("only")
    ok = #expect(!lf3 && l3 == "only", "a line with no newline") && ok

    // field: runs of space between fields do not produce empty ones, which is
    // the whole difference between this and `split_first(s, " ")`.
    (string8 w1, string8 wr1, bool wf1) = field("  alpha   beta  ")
    ok = #expect(wf1 && w1 == "alpha", "field skipped leading space: got ", w1) && ok

    (string8 w2, string8 wr2, bool _) = field(wr1)
    ok = #expect(w2 == "beta", "the second field was ", w2) && ok

    (string8 w3, string8 _, bool wf3) = field(wr2)
    ok = #expect(!wf3 && w3 == "", "there was a third field: ", w3) && ok

    (string8 w4, string8 _, bool wf4) = field("   ")
    ok = #expect(!wf4 && w4 == "", "field of all space") && ok

    // And the property the whole section rests on: a window is a window into
    // the **original** bytes, so it is still there after the call and equal to
    // the corresponding slice of the source.
    string8 source = "alpha beta"
    (string8 first_word, string8 _, bool got) = field(source)
    ok = #expect(got && first_word == source[0..<5], "the field is a window into its source") && ok

    if ok:
        return 0
    return 1

// What `strings.measure` answered, spelled with the builtin: how many bytes C
// will read at `c`. `#len` takes a place, so the borrow is bound first.
i64 measured(cstring c):
    string8 s = borrow_from_cstring(c)
    return #len(s)
