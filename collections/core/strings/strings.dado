// core:strings — the operations `==` does not give you: ordering, search,
// cutting into windows, splitting, and building new text.
//
// **Tier N W H. Script class S**, except the C boundary at the bottom of the
// file. Pure Dado: the package has no `foreign` block and emits no `#include`,
// so it builds and runs freestanding, on the web and hosted (Linux, macOS,
// Windows), and answers the same for the same bytes everywhere. Every search
// and copy is a byte loop written here rather than `strcmp`, `strstr` or
// `memcpy`, which also makes each one right about a string that holds an
// interior `\0`: C's stopped at the first one. Its one import is `core:chars`,
// for the ASCII case mapping, which is as pure.
//
// **What raises into a script**: every function here but three, each promised
// by the `#assert_raises` on the line above it, and the `Builder` and
// `Splitter` verbs too (they are package-level functions taking a pointer).
// The three left out say why on their own lines: `offset_in` compares
// addresses, and `borrow_from_cstring` and `clone_from_cstring` read a
// `cstring`, which is C's, an address.
//
// **Bytes, not characters.** Every function answers about the bytes of a
// `string8`: `compare` orders by their numbers (no collation), `to_upper`,
// `to_lower` and `equal_fold` map ASCII only, and an index is a byte index.
// `core:chars` is where code points and display widths are.
//
// **Parsing is next door**, in `core:strings/parse`: a parser is not a string
// operation, and the package stays one a caller can decline.
//
// **Who ends what this package returns.** A window (`substring`, `rest`,
// `trim` and its kin, the splitters, `bytes`) allocates nothing and is good as
// long as the bytes it was cut from; new text (`concat`, `join`, `replace`,
// `repeat`, `to_upper`, `to_lower`, `clone`, `clone_to_cstring`,
// `clone_from_cstring`, a `Builder`'s `finish`) is a
// `ref []char8` from the ambient allocator, and `split` answers a
// `ref []string8` of windows the same way. Under a `using` arena nothing
// needs freeing; outside one the caller `#delete`s it. Each answers `nil` when
// its allocation fails.
//
// **Thread-safety.** There is no package state. Any number of threads may
// read one string at once; a `Builder` or a `Splitter` belongs to one thread
// at a time.
package strings

import "core:chars"

// Ordering: byte by byte, and the shorter one first where one is a prefix of
// the other. Answers exactly -1, 0 or 1, not only a sign as C's `strcmp`
// promises, so a caller may compare the result with a number.
//
// **Bytes and not characters.** This orders by the numbers in the string,
// which is what a comparison of `[]char8` can mean; it is not a collation and
// does not claim to be.
#assert_raises
i32 compare(string8 a, string8 b):
    i64 n = #len(a)
    i64 m = #len(b)
    i64 k = n
    if m < k: k = m
    for i in 0..<k:
        if a[i] < b[i]: return 0 - 1
        if a[i] > b[i]: return 1
    if n < m: return 0 - 1
    if n > m: return 1
    return 0

// Whether `a` orders before `b` under `compare`.
#assert_raises
bool before(string8 a, string8 b):
    return compare(a, b) < 0

// Whether `a` orders after `b` under `compare`.
#assert_raises
bool after(string8 a, string8 b):
    return compare(a, b) > 0

// Whether `s` begins with `prefix`. Every string begins with `""`.
#assert_raises
bool starts_with(string8 s, string8 prefix):
    i64 m = #len(prefix)
    if m > #len(s): return false
    for i in 0..<m:
        if s[i] != prefix[i]: return false
    return true

// Whether `needle` occurs anywhere in `haystack`. Every string contains `""`.
//
// The naive search, which is the right one at this size: no table to build,
// no allocation, and the needles a program searches for are words.
#assert_raises
bool contains(string8 haystack, string8 needle):
    return find(haystack, needle) >= 0

// Whether `byte` occurs in `s`. Searching for `'\0'` finds an interior one,
// where C's `strchr` found the terminator: this package answers about the
// bytes the string has.
#assert_raises
bool has_byte(string8 s, char8 byte):
    return index_of(s, byte) >= 0

// Whether `s` ends with `suffix`. Every string ends with `""`.
#assert_raises
bool ends_with(string8 s, string8 suffix):
    i64 n = #len(s)
    i64 m = #len(suffix)
    if m > n: return false
    for i in 0..<m:
        if s[(n - m) + i] != suffix[i]: return false
    return true

// Whether `s` has no bytes. `#len(s) == 0` and not `s == ""`: the same
// answer, without the `memcmp` the compiler emits for a string equality, so a
// program that only asks this carries no `<string.h>`.
#assert_raises
bool is_empty(string8 s):
    return #len(s) == 0

// Where `byte` first occurs, or -1. `find` is the same question about a run
// of bytes.
#assert_raises
i64 index_of(string8 s, char8 byte):
    i64 n = #len(s)
    for i in 0..<n:
        if s[i] == byte: return i
    return 0 - 1

// Where `byte` last occurs, or -1. Ranges are ascending only, so the walk
// counts down through a descending index rather than iterating backwards.
#assert_raises
i64 last_index_of(string8 s, char8 byte):
    i64 i = #len(s)
    for i > 0:
        i = i - 1
        if s[i] == byte: return i
    return 0 - 1

// How many times `byte` occurs. The one a program splitting on a separator
// asks first, to know how many pieces it is about to walk; `count` is the same
// question about a run of bytes.
#assert_raises
i64 count_byte(string8 s, char8 byte):
    i64 n = #len(s)
    i64 seen = 0
    for i in 0..<n:
        if s[i] == byte: seen = seen + 1
    return seen

// Where `needle` first occurs in `s`, as a byte index, or -1. An empty
// `needle` occurs at 0.
#assert_raises
i64 find(string8 s, string8 needle):
    i64 n = #len(s)
    i64 m = #len(needle)
    if m == 0: return 0
    if m > n: return 0 - 1
    for at in 0..<((n - m) + 1):
        if matches_at(s, at, needle): return at
    return 0 - 1

// Where `needle` last occurs in `s`, as a byte index, or -1. An empty
// `needle` occurs at `#len(s)`.
#assert_raises
i64 find_last(string8 s, string8 needle):
    i64 n = #len(s)
    i64 m = #len(needle)
    if m == 0: return n
    if m > n: return 0 - 1
    i64 at = (n - m) + 1
    for at > 0:
        at = at - 1
        if matches_at(s, at, needle): return at
    return 0 - 1

// How many times `needle` occurs in `s` without overlapping, counted from the
// left: `count("aaaa", "aa")` is 2. An empty `needle` is counted nowhere,
// as the splitters find it nowhere.
#assert_raises
i64 count(string8 s, string8 needle):
    i64 n = #len(s)
    i64 m = #len(needle)
    if m == 0 || m > n: return 0
    i64 seen = 0
    i64 at = 0
    for at + m <= n:
        if matches_at(s, at, needle):
            seen = seen + 1
            at = at + m
        else:
            at = at + 1
    return seen

// Whether `a` and `b` are equal when ASCII letters are compared without
// regard to case. Every other byte compares exactly, so `é` and `É` differ.
#assert_raises
bool equal_fold(string8 a, string8 b):
    i64 n = #len(a)
    if #len(b) != n: return false
    for i in 0..<n:
        if chars.lower(a[i]) != chars.lower(b[i]): return false
    return true

// Whether `needle` is at `s[at..]`. `at + #len(needle)` is within `s`.
private bool matches_at(string8 s, i64 at, string8 needle):
    for i in 0..<#len(needle):
        if s[at + i] != needle[i]: return false
    return true

// ── the slicing half ──────────────────────────────────────────────────────
//
// **Not one function in this section allocates**; each returns a window into
// the bytes it was given, and the caller's string is what owns them. A window
// is not terminated, so none of these results may be handed to C as it is:
// `clone_to_cstring` is the crossing, and it is where the copy is.

// Whether `b` is one of the four bytes the trimmers and `field` treat as
// space: space, `\t`, `\n` and `\r`. Private, and not `chars.is_space`,
// which is C's six and adds `\v` and `\f`: see `trim`.
private bool is_space(char8 b):
    return b == ' ' || b == '\t' || b == '\n' || b == '\r'

// `count` bytes of `s` from `at`, **clamped** rather than refused.
//
// The clamp is not what keeps this safe. A window is bounds-checked where it
// is cut, computed bounds included: `s[at..<at + count]` past the end stops
// the program with *window out of bounds* and the Dado source location of the
// slice, and `--no-assert` does not remove the check.
// So taking these bounds literally would be safe too — it would trap.
//
// The clamp is the API's choice, and it is about the common call: a bounded
// read of text whose length the caller has not measured, *up to `count` bytes
// from here*. A `substring` that trapped on a count past the end would make
// every such call write the `min` by hand first. Clamped, the result is always
// a window into `s`, and a caller who asked for more than there is gets what
// there is. A caller who needs to know whether it got all of it compares the
// result's length with `count`.
#assert_raises
string8 substring(string8 s, i64 at, i64 count):
    i64 n = #len(s)
    i64 start = at
    if start < 0: start = 0
    if start > n: start = n
    i64 stop = start + count
    if count < 0: stop = start
    if stop < start: stop = start
    if stop > n: stop = n
    return s[start..<stop]

// Everything of `s` from `at` to the end: `substring(s, at, #len(s))` said
// **to the end** by passing a count long enough to be clamped, and read as
// though the third argument were an end index — which is the misreading
// `substring`'s count invites. `at` is clamped to `0..n` the same way, so
// the result is always a window into `s`.
//
// `substring` keeps its clamp. A count past the end is a caller asking for
// more than there is, and refusing it would make every bounded read of
// untrusted text write the `min` by hand; what the clamp hid was only the
// spelling of *to the end*, and that now has its own name.
#assert_raises
string8 rest(string8 s, i64 at):
    i64 n = #len(s)
    i64 start = at
    if start < 0: start = 0
    if start > n: start = n
    return s[start..<n]

// `s` without the space it begins with: the four bytes `trim` names.
#assert_raises
string8 trim_left(string8 s):
    i64 n = #len(s)
    i64 at = 0
    for at < n && is_space(s[at]):
        at = at + 1
    return s[at..<n]

// `s` without the space it ends with: the four bytes `trim` names.
#assert_raises
string8 trim_right(string8 s):
    i64 stop = #len(s)
    for stop > 0 && is_space(s[stop - 1]):
        stop = stop - 1
    return s[0..<stop]

// `s` without the space at either end. **Space here is four bytes**: space,
// `\t`, `\n` and `\r`, the ones that separate words in a line of text.
// `chars.is_space` is C's six, adding `\v` and `\f`; the trimmers keep the
// narrower set so that what they cut is the same as it has always been.
#assert_raises
string8 trim(string8 s):
    return trim_left(trim_right(s))

// The **cursor pair**, and the shape every splitter here takes.
//
// `head` is the bytes before the first `sep`, `rest` is everything after it,
// and `found` says whether there was one. When there was not, `head` is the
// whole string and `rest` is empty — so a caller that ignores `found` still
// terminates, which is the property that makes the loop below safe to write
// carelessly.
//
//     string8 rest = line
//     bool more = true
//     for more:
//         (string8 word, string8 tail, bool found) = split_first(rest, " ")
//         use(word)
//         rest = tail
//         more = found
//
// **Why a cursor and not a `[]string8`.** A function returning a collection has
// to allocate one, which would make this the only thing in the package that
// does, and would need an allocator on a call that is otherwise free. Dado has
// no user-definable iterator either — `for x in y` walks the shapes the
// language knows and nothing else — so the third option was a language
// feature rather than a library one. A pair of windows is neither: it costs
// nothing, needs nothing new, and composes.
//
// An empty `sep` finds nothing, because every position matches one and
// answering the first would return an empty `head` forever.
#assert_raises
(string8 head, string8 rest, bool found) split_first(string8 s, string8 sep):
    i64 n = #len(s)
    i64 m = #len(sep)
    if m == 0 || m > n:
        return (s, s[n..<n], false)
    for at in 0..<((n - m) + 1):
        bool same = true
        for i in 0..<m:
            if s[at + i] != sep[i]:
                same = false
        if same:
            return (s[0..<at], s[(at + m)..<n], true)
    return (s, s[n..<n], false)

// One line, and the rest. `\n` is the separator and a trailing `\r` is dropped,
// so a file written on either kind of machine reads the same.
#assert_raises
(string8 head, string8 rest, bool found) line(string8 s):
    (string8 first, string8 tail, bool found) = split_first(s, "\n")
    return (trim_right_cr(first), tail, found)

// `trim_right`'s one-byte cousin, kept separate because `line` must not eat
// real trailing space — only the carriage return that belongs to the newline.
#assert_raises
string8 trim_right_cr(string8 s):
    i64 n = #len(s)
    if n > 0 && s[n - 1] == '\r':
        return s[0..<(n - 1)]
    return s

// One whitespace-separated field, and the rest. Leading space is skipped, so
// runs of space between fields do not produce empty ones — which is the whole
// difference between this and `split_first(s, " ")`, and is what a caller
// splitting a line of input almost always wants.
#assert_raises
(string8 head, string8 rest, bool found) field(string8 s):
    string8 from = trim_left(s)
    i64 n = #len(from)
    if n == 0:
        return (from, from, false)
    i64 at = 0
    for at < n && !is_space(from[at]):
        at = at + 1
    return (from[0..<at], from[at..<n], at < n)

// `s` without `prefix` when it begins with it, and `s` unchanged otherwise.
#assert_raises
string8 trim_prefix(string8 s, string8 prefix):
    if !starts_with(s, prefix): return s
    return s[#len(prefix)..<#len(s)]

// `s` without `suffix` when it ends with it, and `s` unchanged otherwise.
#assert_raises
string8 trim_suffix(string8 s, string8 suffix):
    if !ends_with(s, suffix): return s
    i64 n = #len(s)
    return s[0..<(n - #len(suffix))]

// `split_first` from the other end: `head` is the bytes before the **last**
// `sep`, `rest` everything after it. When there is none, `head` is the whole
// string and `rest` is empty, as with `split_first`, so `found` may be
// ignored; an empty `sep` finds nothing. `split_last(path, "/")` is a
// directory and a name.
#assert_raises
(string8 head, string8 rest, bool found) split_last(string8 s, string8 sep):
    i64 n = #len(s)
    if #len(sep) == 0: return (s, s[n..<n], false)
    i64 at = find_last(s, sep)
    if at < 0: return (s, s[n..<n], false)
    return (s[0..<at], s[(at + #len(sep))..<n], true)

// Every piece of `s` between the occurrences of `sep`, as windows into `s`,
// in a new `ref []string8` from the ambient allocator (see "building new
// text" below for who frees it). `n` separators make `n + 1` pieces, empty
// ones included: `split("a,,b", ",")` is `a`, ``, `b`, and `split("", ",")` is
// one empty piece. An empty `sep` finds nothing, so the answer is `s` whole.
// `nil` when the allocation fails. A caller that wants no allocation walks a
// `Splitter` instead.
#assert_raises
ref []string8 split(string8 s, string8 sep):
    i64 pieces = count(s, sep) + 1
    ref []string8 out = #make([]string8, pieces)
    if out == nil:
        return out
    Splitter it = splitter(s, sep)
    string8 piece
    i64 k = 0
    for split_next(&it, &piece):
        out[k] = piece
        k = k + 1
    return out

// A walk over the pieces of a string between the occurrences of a
// separator, one window at a time and nothing allocated: `split` without the
// slice.
//
//     strings.Splitter it = strings.splitter(line, ",")
//     string8 piece
//     for strings.split_next(&it, &piece):
//         use(piece)
//
// It visits exactly the pieces `split` would answer, in order: `n`
// separators are `n + 1` pieces, empty ones included, and an empty separator
// makes one piece of the whole string.
type Splitter:
    string8 rest,
    string8 sep,
    bool done,

// A `Splitter` over `s`, separated by `sep`. Nothing is copied: the pieces it
// hands out are windows into `s`.
#assert_raises
Splitter splitter(string8 s, string8 sep):
    Splitter it
    it.rest = s
    it.sep = sep
    it.done = false
    return it

// The next piece into `piece`, and `true`; or `false`, and `piece`
// untouched, once every piece has been handed out.
#assert_raises
bool split_next(^Splitter it, ^string8 piece):
    if it.done: return false
    (string8 head, string8 tail, bool found) = split_first(it.rest, it.sep)
    piece^ = head
    it.rest = tail
    it.done = !found
    return true

// Where `window`'s bytes start inside `parent`'s, failing (code 1) when they
// do not lie within them — so the splitters above **compose**. Every one of
// them returns a window and none says where in its input it came from, so
// *"from where this line started to where the next word ends"* had no
// spelling: a window's bounds are its own, and indexing past them is refused.
// With the offset, the span is `parent[a..<(b + #len(word))]`, cut from the
// parent, which is the one string whose bounds cover it.
//
//     try i64 a = strings.offset_in(text, line) else:
//         ...                                    // not a window of `text`
//
// **An address comparison, not a search.** Two windows with the same bytes
// at different places are different answers, and a window equal to a
// substring of `parent` but cut from another buffer fails. The comparison is
// made on `#c.uintptr_t`s, the one crossing from an address to a number Dado
// has: ordering two C pointers into different objects is undefined, and
// `window` is not known to be inside `parent` until this has answered. An
// empty window at `parent`'s end answers `#len(parent)`, which is where
// `rest(parent, #len(parent))` would have cut it.
//
// Not promised to raise into a script: it compares addresses, and a script
// has none.
!i64 offset_in(string8 parent, string8 window):
    #c.uintptr_t p = address(parent)
    #c.uintptr_t w = address(window)
    if w < p:
        fail 1
    #c.uintptr_t gap = w - p
    #c.uintptr_t limit = #c.uintptr_t(#len(parent))
    if gap > limit:
        fail 1
    i64 at = i64(gap)
    if #len(window) > #len(parent) - at:
        fail 1
    return at

// The address of `s`'s first byte, as a number. `&b[0]` is legal on an empty
// window — an address-of subscript may name the end — so this answers for
// `""` too.
private #c.uintptr_t address(string8 s):
    []char8 b = bytes(s)
    return #c.uintptr_t(rawptr(&b[0]))

// The largest `i64`: the size past which `repeat` and `replace_n` refuse
// rather than wrap.
private const i64 I64_MAX = 9223372036854775807

// ── building new text ─────────────────────────────────────────────────────
//
// **The ownership convention, in one sentence: a function here that makes new
// bytes returns them as a `ref []char8` allocated from the ambient allocator
// (`#default`, which `using` sets), so under a `using` arena you never free
// it and outside one you `#delete` it; `string8 t = r` reads it as text.**
//
// A `ref` and not a `string8`, because a `ref` is the one thing with authority
// to free: a function that allocated text and handed out only a window would
// make bytes nobody can end (`#delete` of a window is ERR0504).
//
// The C-boundary pair at the foot of the file (`clone_to_cstring`,
// `clone_from_cstring`) follows the same convention.

// The name the `string8 → []char8` conversion is reached through: the
// conversion is free, but `[]char8(s)` is not a callable spelling.
private type Bytes: []char8

// `s`'s bytes, as a window over them. **A pure reinterpret**: the two words
// are the same two words and nothing is copied or allocated. What is given up
// is only the claim that the bytes are text, which is why the result is a
// `[]char8`: indexable, and not something a `cstring` parameter accepts. The
// bytes are still `s`'s, so a write through the result writes whatever `s` is
// a window into — a literal's bytes are read-only.
#assert_raises
[]char8 bytes(string8 s):
    return Bytes(s)

// A new run holding `s`'s bytes: the plain owned copy, for text that must
// outlive the bytes it was cut from. Allocated from `#default`, freed by
// `#delete` or by the end of the `using` that placed it. `nil` when the
// allocation fails.
#assert_raises
ref []char8 clone(string8 s):
    i64 n = #len(s)
    ref []char8 out = #make([]char8, n)
    if out == nil:
        return out
    for i in 0..<n:
        out[i] = s[i]
    return out

// A new run holding `a` then `b`. See the convention above: allocated from
// `#default`, freed by `#delete` or by the end of the `using` that placed it.
// `nil` when the allocation fails.
#assert_raises
ref []char8 concat(string8 a, string8 b):
    i64 n = #len(a)
    i64 m = #len(b)
    ref []char8 out = #make([]char8, n + m)
    if out == nil:
        return out
    for i in 0..<n:
        out[i] = a[i]
    for i in 0..<m:
        out[n + i] = b[i]
    return out

// Every part, with `sep` between each two. `join([], sep)` is an empty run,
// not `nil`; `nil` means the allocation failed. One allocation: the length is
// counted first.
#assert_raises
ref []char8 join([]string8 parts, string8 sep):
    i64 total = 0
    for p, i in parts:
        if i > 0:
            total = total + #len(sep)
        total = total + #len(p)
    ref []char8 out = #make([]char8, total)
    if out == nil:
        return out
    i64 at = 0
    for p, i in parts:
        if i > 0:
            for k in 0..<#len(sep):
                out[at + k] = sep[k]
            at = at + #len(sep)
        for k in 0..<#len(p):
            out[at + k] = p[k]
        at = at + #len(p)
    return out

// `s` with every non-overlapping `old`, read from the left, replaced by
// `new`, as a new run from the ambient allocator. An empty `old` replaces
// nothing, and the answer is a copy of `s`. `nil` when the allocation fails.
#assert_raises
ref []char8 replace(string8 s, string8 old, string8 new):
    return replace_n(s, old, new, 0 - 1)

// `replace`, stopping after the first `n` occurrences; a negative `n` is
// every one, and 0 none. A result longer than an `i64` can count answers
// `nil`, as a failed allocation does, rather than a wrapped size.
#assert_raises
ref []char8 replace_n(string8 s, string8 old, string8 new, i64 n):
    i64 len = #len(s)
    i64 m = #len(old)
    i64 hits = 0
    if m > 0:
        hits = count(s, old)
    if n >= 0 && n < hits:
        hits = n
    i64 grow = #len(new) - m
    if grow > 0 && hits > (I64_MAX - len) / grow:
        ref []char8 none
        return none
    ref []char8 out = #make([]char8, len + hits * grow)
    if out == nil:
        return out
    i64 at = 0
    i64 w = 0
    i64 done = 0
    for at < len:
        if done < hits && at + m <= len && matches_at(s, at, old):
            for k in 0..<#len(new):
                out[w + k] = new[k]
            w = w + #len(new)
            at = at + m
            done = done + 1
        else:
            out[w] = s[at]
            w = w + 1
            at = at + 1
    return out

// `s`, `n` times over, as a new run from the ambient allocator. A `n` of zero
// or below is an empty run. `nil` when the allocation fails, and when the
// result would be longer than an `i64` can count, rather than a wrapped size.
#assert_raises
ref []char8 repeat(string8 s, i64 n):
    i64 m = #len(s)
    i64 times = n
    // The empty string any number of times is empty, without counting to
    // `n`: at -O0 the loop below would run its `n` empty rounds.
    if times < 0 || m == 0: times = 0
    if m > 0 && times > I64_MAX / m:
        ref []char8 none
        return none
    ref []char8 out = #make([]char8, m * times)
    if out == nil:
        return out
    for t in 0..<times:
        for i in 0..<m:
            out[t * m + i] = s[i]
    return out

// `s` with every ASCII small letter made a capital, as a new run from the
// ambient allocator. Every other byte is copied as it is — UTF-8 included,
// so `é` stays `é`. `nil` when the allocation fails.
#assert_raises
ref []char8 to_upper(string8 s):
    i64 n = #len(s)
    ref []char8 out = #make([]char8, n)
    if out == nil:
        return out
    for i in 0..<n:
        out[i] = chars.upper(s[i])
    return out

// `s` with every ASCII capital made a small letter, as `to_upper` does the
// other way.
#assert_raises
ref []char8 to_lower(string8 s):
    i64 n = #len(s)
    ref []char8 out = #make([]char8, n)
    if out == nil:
        return out
    for i in 0..<n:
        out[i] = chars.lower(s[i])
    return out

// Text built a piece at a time, when the pieces are not all known at once.
//
// **A `Builder` is its run and nothing else**, so it is freed the way any run
// is: `#delete(b)`, or the end of the `using` it was made under. `finish`
// hands the run over and leaves the builder `nil`, so a builder that was
// finished and a builder that was never made are both safe to `#delete`.
// `text` reads what is there so far, as a window that the next `append` may
// move.
//
//     strings.Builder b = strings.builder()
//     _ = strings.append(&b, "key")
//     _ = strings.append_char(&b, '=')
//     _ = strings.append(&b, value)
//     ref []char8 line = strings.finish(&b)
//     defer #delete(line)
type Builder: ref []char8

// An empty builder with room for `room` bytes before its first growth,
// allocated from `#default`. `nil` when the allocation fails, and every
// `append` to a `nil` builder answers `false`.
#assert_raises
Builder builder(i64 room = 16):
    ref []char8 run = #make([]char8, 0)
    if run == nil:
        return run
    _ = #reserve(run, room)
    return run

// `s` on the end. `false`, and nothing appended, when the run could not grow.
#assert_raises
bool append(^Builder b, string8 s):
    if b^ == nil:
        return false
    i64 n = #len(s)
    if !#reserve(b^, #len(b^) + n):
        return false
    for i in 0..<n:
        _ = #append(b^, s[i])
    return true

// One byte on the end. `false`, and nothing appended, when the run could not
// grow.
#assert_raises
bool append_char(^Builder b, char8 c):
    if b^ == nil:
        return false
    return #append(b^, c)

// What has been built so far, as text. A window into the builder's run, so it
// is good until the next `append`, `finish` or `#delete`.
#assert_raises
string8 text(Builder b):
    return string8(b[:])

// The run, handed over: the caller owns it now (see the convention above),
// and `b` is left `nil`.
//
// Written with a `defer` rather than as `out = b^; b^ = nil; return out`,
// which the provenance pass (ERR0803) refuses: it reads a `ref` copied out of
// `b^` as a view minted from it, so the rebinding looks like a move under it.
#assert_raises
ref []char8 finish(^Builder b):
    defer b^ = nil
    return b^

// ── parsing lives next door ───────────────────────────────────────────────
//
// Text to numbers is **`core:strings/parse`**: `to_i64`, `to_u64`, `to_i32`
// with a radix and `to_bool` fail on anything that is not exactly what they
// read; `to_f64` and `to_f32` the same for decimal floats, correctly rounded.
//
//     import "core:strings/parse"
//     ...
//     try i64 n = parse.to_i64(s) else code:
//         ...

// ── crossing to and from C ────────────────────────────────────────────────
//
// **A `cstring` gets *both* the measure-and-copy and the no-copy view.** The
// copy is the safe default and what a caller should reach for first; the view
// is allowed on the ground that the compiler guarantees only what falls out of
// the type system and the rest is tooling's — because otherwise every caller
// who only wants to **compare** a `char *` pays an allocation.
//
// The view is a **borrow**, with everything a borrow cannot do: it is not
// `#delete`d, not `#resize`d, and not returned out of the block that owns the
// bytes. The first two the compiler already refuses — `#delete` of a window is
// `ERR0504` (a `^T` and a `[]T` are **views**: Dado did not allocate what they
// name and cannot free it), and so is `#resize`. The third the compiler
// **cannot** check here and does not claim to: the bytes belong to C, so how
// long they last is C's answer and not the type's. That is the division, and
// it is the whole of what this package promises. Nothing more is implied.
//
// **These are library functions and not builtins**, because the global
// namespace is freestanding-total: the name a program reaches for with no
// import must work on a target with no heap. `clone_from_cstring`
// **allocates**, so it cannot be in that namespace; putting the copy in the
// library and the borrow in the global namespace would split one boundary
// across two lookup rules for no reason a reader could state. So all of it is
// here. The **conversion** `string8(c)` stays a conversion — it is a retag and
// a walk, it allocates nothing, and it is the language's spelling of the
// borrow; `borrow_from_cstring` is what it should mean when `c` may be `nil`,
// which is the routine case at this boundary.
//
// **`nil` is answered once, and identically for both halves: a zero-length
// `string8`, never a fault and never a refusal.** The argument, in three
// parts:
//
//  1. *A refusal at the type level cannot be written.* `nil` is a run-time
//     value of `cstring` — `getenv` returns it, `argv[argc]` is it, `fopen`'s
//     failure is it — and the type does not carry which. A refusal would have
//     to be a refusal of `string8(c)` outright, which would take the borrow
//     away from the callers it is for.
//  2. *The language already answers zero, twice.* `#len` of a `nil` borrow is
//     0, and `println(c)` on a `nil` emits `fputs(c ? c : "", stdout)`: `NULL`
//     is what a C function returns when it has nothing to say. Answering
//     anything else here would make this package the one place that
//     disagreed.
//  3. *The alternative that was rejected.* A `nil` `^u8` windowed by
//     `p[0..<16]` emits `.ptr = NULL, .len = 16` and runs — a length the
//     compiler asserts and no memory backs. That is the shape not to
//     reproduce, and a zero length over `""` is its opposite: the count is
//     true of the bytes the result points at.
//
// **Not the same answer as `!= nil`.** A zero-length borrow does not say
// whether `c` was `nil` or was `""`, and neither does its `#len`. A caller who
// needs that distinction asks `c == nil` directly, which is the question.

// The bytes at `c`, as a `string8`, **without copying them**.
//
// One walk to find the length C threw away, and then the same pointer: the
// result is two words over C's buffer and this function allocates nothing.
//
// **This is `string8(c)` with the `nil` written out.** The conversion borrows
// a `nil` as the empty string too; what this function buys a reader is that
// the `nil` is *written down* at the boundary where it is the routine case,
// instead of being a property of the compiler they would have to know.
//
// **The result must not outlive C's buffer**, and nothing here can check that.
// `getenv`'s and `argv`'s bytes belong to the process and outlive any Dado
// frame; a buffer a C call filled and will reuse does not. When in doubt the
// answer is `clone_from_cstring` below, which is why that one is the default.
//
// Not promised to raise into a script: a `cstring` is C's, an address.
string8 borrow_from_cstring(cstring c):
    if c == nil: return ""
    return string8(c)

// `s`'s bytes in a new run with a `\0` after them, so `cstring(run)` can
// cross to C:
//
//     ref []char8 path_c = strings.clone_to_cstring(path)
//     defer #delete(path_c)
//     f = fopen(cstring(path_c), "rb")
//
// **From the ambient allocator**, as everything here that makes new bytes:
// `#default`, freed by `#delete` or by the end of the `using` that placed it;
// a C crossing needs no other. `nil` when the allocation fails.
//
// **`ref []char8` and not a boxed `cstring`.** An owning run is an ordinary
// reference: `#delete`, `#copy` and `#resize` already work on it, `#len` reads
// its length, and it can be returned, stored in a map, or held past the block
// that made it. A `cstring` that owned its bytes would have needed all four of
// those written again for one type.
//
// `n + 1` and not `n`: the terminator is a byte the C side reads and the Dado
// side never does. `#len(out)` therefore answers **one more** than `#len(s)`,
// which is the honest number — the run really is that long — and is the one
// thing about this function a caller has to know.
//
// Interior `\0`s are copied through rather than stopped at, because this
// function's job is the bytes it was given. A string holding one produces a
// run that C will read only up to that byte; that is C's rule, not this
// function's, and `#len` of a borrow is the measurement on the other side of
// it.
#assert_raises
ref []char8 clone_to_cstring(string8 s):
    i64 n = #len(s)
    ref []char8 out = #make([]char8, n + 1)
    if out == nil:
        return out
    for i in 0..<n:
        out[i] = s[i]
    out[n] = '\0'
    return out

// A NUL-terminated C string's bytes in a new run, so C's bytes become a value
// Dado owns: the inverse of `clone_to_cstring`. From the ambient allocator,
// freed by `#delete` or by the end of the `using` that placed it; read it as
// text with `string8 t = out`. `nil` when the allocation fails.
//
// **A copy, not a borrow, and that is the whole reason this is a function** —
// it is the half of the boundary that outlives C's buffer, and the default.
// `borrow_from_cstring` above is the other half and costs nothing; this one is
// what a caller reaches for when the bytes have to last longer than the call
// that produced them, or have to be written to.
//
// **The copy is a byte loop**, the same loop `clone_to_cstring` takes in the
// other direction, over the borrow. The length is one walk (`#len` of the
// borrow) and the bytes are moved one at a time, so nothing here needs
// `<string.h>` and a `#NONE` program may call it.
//
// **`nil` yields an empty run**, matching a `nil` borrow's `#len` of 0 and
// `borrow_from_cstring(nil) == ""`: one answer for the whole boundary, argued
// at the section head above. The terminator is **not** copied — this answers
// the bytes, and `#len(out)` is `#len` of the borrow, one less than
// `clone_to_cstring`'s output for the same text.
//
// Not promised to raise into a script: it reads a `cstring`, an address.
ref []char8 clone_from_cstring(cstring c):
    return clone(borrow_from_cstring(c))
