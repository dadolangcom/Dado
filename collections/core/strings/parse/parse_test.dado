@test
// Both parsers: `to_i32`'s forgiving contract, which is C's `atoi`'s and did
// not change when `atoi` left; and `to_f64`/`to_f32`'s strict, correctly
// rounded one.
//
// The float expectations are **bit patterns**, not tolerances, because the
// claim is the nearest value and a tolerance could not tell the nearest from
// its neighbour. Each hard case's bits are what glibc's `strtod`/`strtof`
// answer for the same text; the standalone harness beside this package's
// results compares against them directly on a million inputs. The round
// trips at the foot run through `core:fmt`'s `put_float_shortest`, so this
// suite is also the proof that its digits read back.
package parse

import "core:fmt"

private cunion B64: (f64 f, u64 u)
private cunion B32: (f32 f, u32 u)

private u64 bits64(f64 x):
    B64 b = B64(x)
    return b.u

private u32 bits32(f32 x):
    B32 b = B32(x)
    return b.u

// `s` reads as exactly `want`.
private bool reads64(string8 s, u64 want):
    try f64 got = to_f64(s) else code:
        return #expect(false, "to_f64(\"", s, "\") failed with ", code)
    u64 have = bits64(got)
    return #expect(have == want, "to_f64(\"", s, "\") has bits ", have, " and should have ", want)

private bool reads32(string8 s, u32 want):
    try f32 got = to_f32(s) else code:
        return #expect(false, "to_f32(\"", s, "\") failed with ", code)
    u32 have = bits32(got)
    return #expect(have == want, "to_f32(\"", s, "\") has bits ", have, " and should have ", want)

// `s` is refused by both, with `MALFORMED`.
private bool refused(string8 s):
    bool ok = true
    try f64 x = to_f64(s) else code:
        ok = #expect(code == MALFORMED, "to_f64(\"", s, "\") failed with ", code, " rather than MALFORMED") && ok
        try f32 y = to_f32(s) else code32:
            return #expect(code32 == MALFORMED, "to_f32(\"", s, "\") failed with ", code32) && ok
        return #expect(false, "to_f32(\"", s, "\") read ", y, " from text that is not a number")
    return #expect(false, "to_f64(\"", s, "\") read ", x, " from text that is not a number")

// `x`'s shortest text, read back, is `x`.
private [64]char8 text
private bool round_trips64(f64 x):
    fmt.Cursor c = fmt.over(text[:])
    _ = fmt.put_float_shortest(x, fmt.to_bytes(&c))
    string8 s = fmt.written(c)
    try f64 back = to_f64(s) else code:
        return #expect(false, "the shortest text of bits ", bits64(x), ", \"", s, "\", failed to read: ", code)
    return #expect(bits64(back) == bits64(x), "\"", s, "\" read back as bits ", bits64(back), " not ", bits64(x))

private bool round_trips32(f32 x):
    fmt.Cursor c = fmt.over(text[:])
    _ = fmt.put_float_shortest(x, fmt.to_bytes(&c))
    string8 s = fmt.written(c)
    try f32 back = to_f32(s) else code:
        return #expect(false, "the shortest text of f32 bits ", bits32(x), ", \"", s, "\", failed to read: ", code)
    return #expect(bits32(back) == bits32(x), "\"", s, "\" read back as f32 bits ", bits32(back), " not ", bits32(x))

// Room for the 900-digit case below.
private [1024]char8 long

i32 test():
    bool ok = true

    // ── to_i32: atoi's contract ─────────────────────────────────────────────
    ok = #expect(to_i32("42") == 42, "to_i32(42) was ", to_i32("42")) && ok
    ok = #expect(to_i32("-7") == 0 - 7, "to_i32(-7) was ", to_i32("-7")) && ok
    ok = #expect(to_i32("+7") == 7, "to_i32(+7) was ", to_i32("+7")) && ok
    ok = #expect(to_i32("0") == 0, "to_i32(0) was ", to_i32("0")) && ok
    ok = #expect(to_i32("") == 0, "to_i32 of the empty string was ", to_i32("")) && ok
    ok = #expect(to_i32("abc") == 0, "to_i32 of a non-number was ", to_i32("abc")) && ok
    ok = #expect(to_i32("-") == 0, "to_i32 of a bare sign was ", to_i32("-")) && ok
    // A number with a tail: read the prefix and stop, which is neither an
    // error nor a full parse.
    ok = #expect(to_i32("12abc") == 12, "to_i32 stopped somewhere other than the tail: ", to_i32("12abc")) && ok
    ok = #expect(to_i32("  8") == 8, "to_i32 did not skip leading space: ", to_i32("  8")) && ok
    ok = #expect(to_i32("\t\n -3") == 0 - 3, "to_i32 did not skip tab and newline: ", to_i32("\t\n -3")) && ok
    ok = #expect(to_i32("2147483647") == 2147483647, "to_i32 of i32's largest was ", to_i32("2147483647")) && ok

    // ── to_f64 / to_f32: what is not a number ───────────────────────────────
    ok = refused("") && ok
    ok = refused("abc") && ok
    ok = refused("12abc") && ok
    ok = refused(" 1") && ok
    ok = refused("1 ") && ok
    ok = refused("+") && ok
    ok = refused("-") && ok
    ok = refused(".") && ok
    ok = refused("-.") && ok
    ok = refused("e5") && ok
    ok = refused(".e5") && ok
    ok = refused("1e") && ok
    ok = refused("1e+") && ok
    ok = refused("1e-x") && ok
    ok = refused("1.2.3") && ok
    ok = refused("--1") && ok
    ok = refused("+-1") && ok
    ok = refused("0x1p3") && ok
    ok = refused("infin") && ok
    ok = refused("infinityy") && ok
    ok = refused("nan(1)") && ok
    ok = refused("1_000") && ok

    // ── the spellings that are ──────────────────────────────────────────────
    ok = reads64("0", 0) && ok
    ok = reads64("-0", 0x8000000000000000) && ok
    ok = reads64("-0.0e10", 0x8000000000000000) && ok
    ok = reads64("0.000", 0) && ok
    ok = reads64("3.5", 0x400C000000000000) && ok
    ok = reads64("+3.5", 0x400C000000000000) && ok
    ok = reads64(".5", 0x3FE0000000000000) && ok
    ok = reads64("5.", 0x4014000000000000) && ok
    ok = reads64("1E-5", 0x3EE4F8B588E368F1) && ok
    ok = reads64("1e+2", 0x4059000000000000) && ok
    ok = reads64("007.50", 0x401E000000000000) && ok
    ok = reads64("inf", 0x7FF0000000000000) && ok
    ok = reads64("INF", 0x7FF0000000000000) && ok
    ok = reads64("Infinity", 0x7FF0000000000000) && ok
    ok = reads64("-inf", 0xFFF0000000000000) && ok
    ok = reads64("+infinity", 0x7FF0000000000000) && ok
    ok = reads64("nan", 0x7FF8000000000000) && ok
    ok = reads64("NaN", 0x7FF8000000000000) && ok
    ok = reads64("-nan", 0xFFF8000000000000) && ok
    ok = reads32("-inf", 0xFF800000) && ok
    ok = reads32("nan", 0x7FC00000) && ok
    ok = reads32("-0", 0x80000000) && ok

    // ── the hard cases, each against strtod's bits ──────────────────────────
    ok = reads64("0.1", 0x3FB999999999999A) && ok
    ok = reads64("1e23", 0x44B52D02C7E14AF6) && ok
    // 2^53 + 1 is halfway between two doubles; the even one is 2^53.
    ok = reads64("9007199254740993", 0x4340000000000000) && ok
    ok = reads64("9007199254740995", 0x4340000000000002) && ok
    // 1 + 2^-53 exactly, then a hair above it.
    ok = reads64("1.00000000000000011102230246251565404236316680908203125", 0x3FF0000000000000) && ok
    ok = reads64("1.00000000000000011102230246251565404236316680908203126", 0x3FF0000000000001) && ok
    ok = reads64("123456789012345678901234567890", 0x45F8EE90FF6C373E) && ok
    // Subnormals: the smallest, and either side of half of it.
    ok = reads64("4.9406564584124654e-324", 0x0000000000000001) && ok
    ok = reads64("2.4703282292062327e-324", 0) && ok
    ok = reads64("2.4703282292062328e-324", 0x0000000000000001) && ok
    ok = reads64("2.2250738585072011e-308", 0x000FFFFFFFFFFFFF) && ok
    ok = reads64("2.2250738585072012e-308", 0x0010000000000000) && ok
    // The top: the largest finite value, just under the halfway point to the
    // next power of two, and past it.
    ok = reads64("1.7976931348623157e308", 0x7FEFFFFFFFFFFFFF) && ok
    ok = reads64("1.7976931348623158e308", 0x7FEFFFFFFFFFFFFF) && ok
    ok = reads64("1.7976931348623159e308", 0x7FF0000000000000) && ok
    ok = reads64("1e400", 0x7FF0000000000000) && ok
    ok = reads64("-1e400", 0xFFF0000000000000) && ok
    ok = reads64("1e-400", 0) && ok
    ok = reads64("1e999999999999", 0x7FF0000000000000) && ok
    ok = reads64("0e999999999999", 0) && ok

    // Halfway between 1 and its successor, written with 900 digits: the
    // exact 54 significant digits of `1 + 2^-53`, then zeros past the 800
    // kept, then a final 1 that only the "something followed" flag sees.
    // That 1 is what makes it round up.
    string8 half = "1.00000000000000011102230246251565404236316680908203125"
    i32 at = 0
    for c in half:
        long[at] = c
        at += 1

    for at < 899:
        long[at] = '0'
        at += 1

    long[at] = '1'
    at += 1
    ok = reads64(string8(long[0..<i64(at)]), 0x3FF0000000000001) && ok
    long[at - 1] = '0'
    ok = reads64(string8(long[0..<i64(at)]), 0x3FF0000000000000) && ok

    // ── the same at single precision, against strtof ────────────────────────
    ok = reads32("0.1", 0x3DCCCCCD) && ok
    ok = reads32("16777217", 0x4B800000) && ok
    ok = reads32("1.000000059604644775390625", 0x3F800000) && ok
    ok = reads32("1.000000059604644775390626", 0x3F800001) && ok
    ok = reads32("1.4e-45", 0x00000001) && ok
    ok = reads32("7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625e-46", 0) && ok
    ok = reads32("7.0064923216240854e-46", 0x00000001) && ok
    ok = reads32("1.17549435e-38", 0x00800000) && ok
    ok = reads32("3.4028235677973366e38", 0x7F7FFFFF) && ok
    ok = reads32("3.4028236e38", 0x7F800000) && ok
    ok = reads32("7.038531e-26", 0x15AE43FD) && ok

    // ── round trips through core:fmt ────────────────────────────────────────
    //
    // A sample, sized for the sanitized gate: every 65 521st `f32` bit pattern
    // (a prime stride, so every exponent and a spread of mantissas), and
    // 20 000 `f64` patterns from a xorshift. The exhaustive `f32` run and the
    // million `f64`s are the standalone harness's.
    u64 pattern = 0
    for pattern < 0x100000000:
        B32 b = B32(u32(pattern))
        if b.f == b.f:
            ok = round_trips32(b.f) && ok

        pattern += 65521

    u64 x = 88172645463325252
    i32 zero = 0
    for _i in zero..<20000:
        x = x ~ (x << 13)
        x = x ~ (x >> 7)
        x = x ~ (x << 17)
        B64 b = B64(x)
        if b.f == b.f:
            ok = round_trips64(b.f) && ok

    if ok:
        return 0
    return 1
