@test
// The strict integer and boolean readers: every claim at an edge — each
// type's last value and the one past it, the radix's last digit and the one
// past it, the empty text, and a sign with nothing after it.
package parse

// `s` in `radix` reads as `want`.
private bool i64_is(string8 s, i32 radix, i64 want):
    try i64 got = to_i64(s, radix) else code:
        return #expect(false, "to_i64(\"", s, "\", ", radix, ") failed with ", code)
    return #expect(got == want, "to_i64(\"", s, "\", ", radix, ") was ", got, ", not ", want)

// `s` in `radix` fails `to_i64` with `code`.
private bool i64_fails(string8 s, i32 radix, Error code):
    try i64 got = to_i64(s, radix) else c:
        return #expect(c == code, "to_i64(\"", s, "\") failed with ", c, ", not ", code)
    return #expect(false, "to_i64(\"", s, "\") read ", got, " and should have failed")

private bool u64_is(string8 s, i32 radix, u64 want):
    try u64 got = to_u64(s, radix) else code:
        return #expect(false, "to_u64(\"", s, "\", ", radix, ") failed with ", code)
    return #expect(got == want, "to_u64(\"", s, "\", ", radix, ") was ", got, ", not ", want)

private bool u64_fails(string8 s, i32 radix, Error code):
    try u64 got = to_u64(s, radix) else c:
        return #expect(c == code, "to_u64(\"", s, "\") failed with ", c, ", not ", code)
    return #expect(false, "to_u64(\"", s, "\") read ", got, " and should have failed")

private bool i32_is(string8 s, i32 want):
    try i32 got = to_i32(s) else code:
        return #expect(false, "to_i32(\"", s, "\") failed with ", code)
    return #expect(got == want, "to_i32(\"", s, "\") was ", got, ", not ", want)

private bool i32_fails(string8 s, Error code):
    try i32 got = to_i32(s) else c:
        return #expect(c == code, "to_i32(\"", s, "\") failed with ", c, ", not ", code)
    return #expect(false, "to_i32(\"", s, "\") read ", got, " and should have failed")

private bool bool_is(string8 s, bool want):
    try bool got = to_bool(s) else code:
        return #expect(false, "to_bool(\"", s, "\") failed with ", code)
    return #expect(got == want, "to_bool(\"", s, "\") was ", got)

private bool bool_fails(string8 s):
    try bool got = to_bool(s) else c:
        return #expect(c == Error.MALFORMED, "to_bool(\"", s, "\") failed with ", c)
    return #expect(false, "to_bool(\"", s, "\") read ", got, " and should have failed")

i32 test():
    bool ok = true

    // ── to_i64 ───────────────────────────────────────────────────────────────
    ok = i64_is("0", 10, 0) && ok
    ok = i64_is("-0", 10, 0) && ok
    ok = i64_is("+42", 10, 42) && ok
    ok = i64_is("9223372036854775807", 10, 9223372036854775807) && ok
    ok = i64_is("-9223372036854775808", 10, (0 - 9223372036854775807) - 1) && ok
    ok = i64_fails("9223372036854775808", 10, Error.RANGE) && ok
    ok = i64_fails("-9223372036854775809", 10, Error.RANGE) && ok
    ok = i64_fails("99999999999999999999999", 10, Error.RANGE) && ok
    // Malformed anywhere is malformed, however large the front.
    ok = i64_fails("99999999999999999999999x", 10, Error.MALFORMED) && ok
    ok = i64_fails("", 10, Error.MALFORMED) && ok
    ok = i64_fails("-", 10, Error.MALFORMED) && ok
    ok = i64_fails(" 1", 10, Error.MALFORMED) && ok
    ok = i64_fails("1 ", 10, Error.MALFORMED) && ok
    ok = i64_fails("1_000", 10, Error.MALFORMED) && ok
    ok = i64_fails("--1", 10, Error.MALFORMED) && ok

    // Radixes: the last digit of each and the one past it.
    ok = i64_is("ff", 16, 255) && ok
    ok = i64_is("FF", 16, 255) && ok
    ok = i64_fails("fg", 16, Error.MALFORMED) && ok
    ok = i64_is("777", 8, 511) && ok
    ok = i64_fails("8", 8, Error.MALFORMED) && ok
    ok = i64_is("-101", 2, -5) && ok
    ok = i64_fails("2", 2, Error.MALFORMED) && ok
    ok = i64_is("zz", 36, 1295) && ok
    ok = i64_fails("1", 1, Error.RADIX) && ok
    ok = i64_fails("1", 37, Error.RADIX) && ok
    // An explicit radix reads no prefix.
    ok = i64_fails("0x10", 16, Error.MALFORMED) && ok

    // Radix 0 reads a prefix, after the sign.
    ok = i64_is("0x1F", 0, 31) && ok
    ok = i64_is("-0x10", 0, -16) && ok
    ok = i64_is("0o17", 0, 15) && ok
    ok = i64_is("0B101", 0, 5) && ok
    ok = i64_is("017", 0, 17) && ok
    ok = i64_is("0", 0, 0) && ok
    ok = i64_fails("0x", 0, Error.MALFORMED) && ok

    // ── to_u64 ───────────────────────────────────────────────────────────────
    ok = u64_is("18446744073709551615", 10, 0xFFFFFFFFFFFFFFFF) && ok
    ok = u64_fails("18446744073709551616", 10, Error.RANGE) && ok
    ok = u64_is("ffffffffffffffff", 16, 0xFFFFFFFFFFFFFFFF) && ok
    ok = u64_is("+7", 10, 7) && ok
    ok = u64_fails("-1", 10, Error.MALFORMED) && ok
    ok = u64_fails("-0", 10, Error.MALFORMED) && ok
    ok = u64_is("0xdead", 0, 0xDEAD) && ok

    // ── to_i32 ──────────────────────────────────────────────────────────────
    ok = i32_is("2147483647", 2147483647) && ok
    ok = i32_is("-2147483648", (0 - 2147483647) - 1) && ok
    ok = i32_fails("2147483648", Error.RANGE) && ok
    ok = i32_fails("-2147483649", Error.RANGE) && ok
    ok = i32_fails("12abc", Error.MALFORMED) && ok
    i32 hex = 0
    try hex = to_i32("7f", 16) else code:
        ok = #expect(false, "to_i32(\"7f\", 16) failed with ", code) && ok
    ok = #expect(hex == 127, "to_i32(\"7f\", 16) was ", hex) && ok

    // Radix 0 reads a prefix for `to_i32` as for `to_i64`, and a caller's
    // `switch` over the bound code names every member with no `else`.
    i32 pre = 0
    try pre = to_i32("-0x7f", 0) else code:
        ok = #expect(false, "to_i32(\"-0x7f\", 0) failed with ", code) && ok
    ok = #expect(pre == -127, "to_i32(\"-0x7f\", 0) was ", pre) && ok
    i32 which = 0
    i32 never = 0
    try never = to_i32("1", 99) else why:
        switch why:
            case Error.MALFORMED: which = 1
            case Error.RANGE: which = 2
            case Error.RADIX: which = 3
    ok = #expect(which == 3 && never == 0, "radix 99 did not fail with RADIX: ", which) && ok

    // ── to_bool ──────────────────────────────────────────────────────────────
    ok = bool_is("true", true) && bool_is("TRUE", true) && bool_is("Yes", true) && bool_is("on", true) && bool_is("1", true) && ok
    ok = bool_is("false", false) && bool_is("False", false) && bool_is("NO", false) && bool_is("off", false) && bool_is("0", false) && ok
    ok = bool_fails("") && bool_fails(" true") && bool_fails("2") && bool_fails("t") && bool_fails("yess") && ok

    if ok: return 0
    return 1
