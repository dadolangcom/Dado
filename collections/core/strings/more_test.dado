@test
// The search, split, replace and case functions, each claimed at its edges:
// the empty needle, the needle that is the whole string, a match at index 0
// and at the end, and overlapping candidates.
package strings

// Whether `got` holds `want`'s bytes; `got` is freed either way.
private bool same(ref []char8 got, string8 want):
    defer #delete(got)
    if got == nil: return false
    string8 text = got
    return text == want

i32 test():
    bool ok = true

    // ── find / find_last / count ─────────────────────────────────────────────
    ok = #expect(find("hello", "l") == 2 && find_last("hello", "l") == 3, "find of one byte") && ok
    ok = #expect(find("hello", "hello") == 0 && find_last("hello", "hello") == 0, "the needle that is the whole string") && ok
    ok = #expect(find("hello", "lo") == 3 && find("hello", "he") == 0, "a match at each end") && ok
    ok = #expect(find("hello", "hellos") == -1 && find_last("hi", "high") == -1, "a needle longer than the haystack") && ok
    ok = #expect(find("abc", "") == 0 && find_last("abc", "") == 3, "the empty needle") && ok
    ok = #expect(find("aaab", "aab") == 1 && find_last("abab", "ab") == 2, "overlapping candidates") && ok
    ok = #expect(count("aaaa", "aa") == 2 && count("abab", "b") == 2 && count("abc", "") == 0 && count("", "a") == 0, "count") && ok
    ok = #expect(contains("hello", "ell") && !contains("hello", "elo") && contains("", ""), "contains through find") && ok

    // ── equal_fold ───────────────────────────────────────────────────────────
    ok = #expect(equal_fold("Hello", "hELLO") && equal_fold("", ""), "equal_fold of ASCII") && ok
    ok = #expect(!equal_fold("abc", "abd") && !equal_fold("ab", "abc"), "equal_fold of different text") && ok
    ok = #expect(!equal_fold("@", "`") && !equal_fold("[", "{"), "equal_fold folds letters only") && ok
    ok = #expect(!equal_fold("é", "É"), "equal_fold folded a non-ASCII byte") && ok

    // ── trim_prefix / trim_suffix / split_last ───────────────────────────────
    ok = #expect(trim_prefix("prefix.rest", "prefix.") == "rest" && trim_prefix("abc", "x") == "abc" && trim_prefix("abc", "abc") == "", "trim_prefix") && ok
    ok = #expect(trim_suffix("file.dado", ".dado") == "file" && trim_suffix("abc", "x") == "abc", "trim_suffix") && ok
    (string8 dir, string8 name, bool found) = split_last("a/b/c", "/")
    ok = #expect(found && dir == "a/b" && name == "c", "split_last found ", dir, " and ", name) && ok
    (string8 whole, string8 none, bool missing) = split_last("abc", "/")
    ok = #expect(!missing && whole == "abc" && none == "", "split_last without a separator") && ok
    (string8 all, string8 _, bool empty_sep) = split_last("abc", "")
    ok = #expect(!empty_sep && all == "abc", "split_last of an empty separator") && ok

    // ── split / Splitter ─────────────────────────────────────────────────────
    ref []string8 parts = split("a,,b", ",")
    ok = #expect(parts != nil && #len(parts) == 3, "split counted ", #len(parts), " pieces") && ok
    if parts != nil && #len(parts) == 3:
        ok = #expect(parts[0] == "a" && parts[1] == "" && parts[2] == "b", "split's pieces") && ok
    #delete(parts)
    ref []string8 one = split("", ",")
    ok = #expect(one != nil && #len(one) == 1 && one[0] == "", "split of the empty string is one empty piece") && ok
    #delete(one)
    ref []string8 edges = split(",x,", ",")
    ok = #expect(edges != nil && #len(edges) == 3 && edges[0] == "" && edges[2] == "", "split keeps the empty pieces at the ends") && ok
    #delete(edges)
    ref []string8 whole_s = split("abc", "")
    ok = #expect(whole_s != nil && #len(whole_s) == 1 && whole_s[0] == "abc", "an empty separator splits nothing") && ok
    #delete(whole_s)
    Splitter it = splitter("one::two::", "::")
    string8 piece
    i32 n = 0
    string8 second
    for split_next(&it, &piece):
        if n == 1: second = piece
        n = n + 1
    ok = #expect(n == 3 && second == "two", "the Splitter walked ", n, " pieces") && ok
    ok = #expect(!split_next(&it, &piece), "a finished Splitter handed out another piece") && ok

    // ── replace / replace_n / repeat ─────────────────────────────────────────
    ok = #expect(same(replace("a-b-c", "-", "+"), "a+b+c"), "replace of one byte") && ok
    ok = #expect(same(replace("aaaa", "aa", "b"), "bb"), "replace reads non-overlapping matches") && ok
    ok = #expect(same(replace("abc", "b", ""), "ac") && same(replace("abc", "", "x"), "abc"), "replace with nothing, and of nothing") && ok
    ok = #expect(same(replace("x", "x", "long"), "long") && same(replace("", "a", "b"), ""), "replace that grows, and of the empty string") && ok
    ok = #expect(same(replace_n("a.b.c.d", ".", "/", 2), "a/b/c.d") && same(replace_n("a.b", ".", "/", 0), "a.b"), "replace_n") && ok
    ok = #expect(same(repeat("ab", 3), "ababab") && same(repeat("ab", 0), "") && same(repeat("ab", -1), ""), "repeat") && ok

    // ── to_upper / to_lower ──────────────────────────────────────────────────
    ok = #expect(same(to_upper("Hello, wörld!"), "HELLO, WöRLD!"), "to_upper left UTF-8 as it was") && ok
    ok = #expect(same(to_lower("@AZ[`az{"), "@az[`az{"), "to_lower's edges") && ok

    if ok: return 0
    return 1
