@test
// The rotations, Euler angles, quaternions, decomposition and [0, 1]-depth
// projections `core:linalg` gained beside its first set. Each is claimed at
// `f64` and the generic ones at `f32` too, and each against another way of
// computing the same thing: a quaternion against the matrix it makes, an
// Euler triple against the matrices it composes, a decomposition against
// the composition it undoes.
package linalg

import "core:math"

// Within a few units of the last place of a value near 1.
private bool close(f64 a, f64 b):
    return math.abs(a - b) < 0.000000001

private bool close3([3]f64 a, [3]f64 b):
    return close(a[0], b[0]) && close(a[1], b[1]) && close(a[2], b[2])

private bool close4([4]f64 a, [4]f64 b):
    return close(a[0], b[0]) && close(a[1], b[1]) && close(a[2], b[2]) && close(a[3], b[3])

private bool close33([3,3]f64 a, [3,3]f64 b):
    bool same = true
    for c in 0..<3:
        for r in 0..<3:
            same = same && close(a[c][r], b[c][r])
    return same

private bool close44([4,4]f64 a, [4,4]f64 b):
    bool same = true
    for c in 0..<4:
        for r in 0..<4:
            same = same && close(a[c][r], b[c][r])
    return same

i32 test():
    bool ok = true
    f64 pi = math.PI

    // ── rotation about an axis ──────────────────────────────────────────────
    [3]f64 x_axis = (1.0, 0.0, 0.0)
    [3]f64 y_axis = (0.0, 2.0, 0.0)
    [3]f64 z_axis = (0.0, 0.0, 0.5)
    ok = #expect(close33(rot_axis(x_axis, 0.7), rot_x(0.7)), "rot_axis about x is not rot_x") && ok
    ok = #expect(close33(rot_axis(y_axis, 0.7), rot_y(0.7)), "rot_axis about y is not rot_y") && ok
    ok = #expect(close33(rot_axis(z_axis, f64(-1.2)), rot_z(f64(-1.2))), "rot_axis about z is not rot_z") && ok
    // A third of a turn about (1, 1, 1) cycles the axes: x to y, y to z.
    [3]f64 diag = (1.0, 1.0, 1.0)
    [3,3]f64 cyc = rot_axis(diag, 2.0 * pi / 3.0)
    [3]f64 ex = (1.0, 0.0, 0.0)
    [3]f64 ey = (0.0, 1.0, 0.0)
    ok = #expect(close3(cyc * ex, ey), "a third turn about (1,1,1) did not take x to y") && ok

    // ── Euler angles ────────────────────────────────────────────────────────
    [3,3]f64 e = from_euler(0.3, f64(-0.4), 1.1)
    ok = #expect(close33(e, rot_y(0.3) * rot_x(f64(-0.4)) * rot_z(1.1)), "from_euler is not yaw * pitch * roll") && ok
    [3]f64 ypr = to_euler(e)
    [3]f64 want = (0.3, -0.4, 1.1)
    ok = #expect(close3(ypr, want), "to_euler did not undo from_euler: ", ypr[0], " ", ypr[1], " ", ypr[2]) && ok
    // Gimbal lock: pitch at a quarter turn, the roll folded into the yaw.
    [3]f64 locked = to_euler(from_euler(0.2, pi / 2.0, 0.5))
    ok = #expect(close(locked[1], pi / 2.0) && locked[2] == 0.0, "gimbal lock answered ", locked[0], " ", locked[1], " ", locked[2]) && ok
    ok = #expect(close33(from_euler(locked[0], locked[1], locked[2]), from_euler(0.2, pi / 2.0, 0.5)), "the gimbal-locked answer is a different rotation") && ok
    [3,3]f32 e32 = from_euler(f32(0.3), f32(-0.4), f32(1.1))
    [3]f32 ypr32 = to_euler(e32)
    ok = #expect(math.abs(f64(ypr32[2]) - 1.1) < 0.00001, "to_euler at f32 was ", ypr32[2]) && ok

    // ── quaternions ─────────────────────────────────────────────────────────
    [3]f64 axis = (1.0, -2.0, 0.5)
    [4]f64 q = quat_from_axis_angle(axis, 0.9)
    ok = #expect(close(length(q), 1.0), "quat_from_axis_angle is not a unit quaternion") && ok
    ok = #expect(close33(quat_to_matrix3(q), rot_axis(axis, 0.9)), "the quaternion's matrix is not rot_axis") && ok
    [3]f64 v = (0.25, 3.0, -1.5)
    ok = #expect(close3(quat_rotate(q, v), rot_axis(axis, 0.9) * v), "quat_rotate disagrees with the matrix") && ok
    [4]f64 p = quat_from_axis_angle(ey, f64(-0.4))
    ok = #expect(close33(quat_to_matrix3(quat_mul(q, p)), quat_to_matrix3(q) * quat_to_matrix3(p)), "quat_mul does not compose like the matrices") && ok
    [4]f64 ident = (0.0, 0.0, 0.0, 1.0)
    ok = #expect(close4(quat_mul(q, quat_conjugate(q)), ident), "q times its conjugate is not the identity") && ok
    ok = #expect(close4(quat_from_matrix3(quat_to_matrix3(q)), q), "quat_from_matrix3 did not undo quat_to_matrix3") && ok
    // Near a half turn, where the trace is negative and a naive method fails.
    [4]f64 half = quat_from_axis_angle(axis, pi - 0.001)
    [4]f64 back = quat_from_matrix3(quat_to_matrix3(half))
    ok = #expect(close4(back, half) || close4(back, 0.0 - half), "quat_from_matrix3 near a half turn was off") && ok
    [4,4]f64 m4 = quat_to_matrix4(q)
    ok = #expect(m4[3][3] == 1.0 && m4[3][0] == 0.0 && close(m4[1][2], quat_to_matrix3(q)[1][2]), "quat_to_matrix4 is not the homogeneous form") && ok
    // slerp: the ends, the middle, and the short way round.
    [4]f64 a = quat_from_axis_angle(ey, 0.2)
    [4]f64 b = quat_from_axis_angle(ey, 1.4)
    ok = #expect(close4(quat_slerp(a, b, 0.0), a) && close4(quat_slerp(a, b, 1.0), b), "slerp missed an end") && ok
    ok = #expect(close4(quat_slerp(a, b, 0.5), quat_from_axis_angle(ey, 0.8)), "slerp's middle is not the middle angle") && ok
    ok = #expect(close4(quat_slerp(a, 0.0 - b, 0.5), quat_from_axis_angle(ey, 0.8)), "slerp took the long way round") && ok
    ok = #expect(close4(quat_slerp(a, a, 0.3), a), "slerp between equal quaternions moved") && ok
    [4]f32 q32 = quat_from_axis_angle((f32(0.0), f32(0.0), f32(1.0)), f32(1.5707963))
    [3]f32 turned = quat_rotate(q32, (f32(1.0), f32(0.0), f32(0.0)))
    ok = #expect(math.abs(f64(turned[1]) - 1.0) < 0.000001, "a quarter turn at f32 gave ", turned[1]) && ok

    // ── compose and decompose ───────────────────────────────────────────────
    [3]f64 t = (4.0, -5.0, 6.5)
    [3]f64 s = (2.0, 0.5, 3.0)
    [4,4]f64 model = compose(t, q, s)
    ok = #expect(close44(model, translation(t) * quat_to_matrix4(q) * scaling(s)), "compose is not T * R * S") && ok
    ([3]f64 dt, [4]f64 dq, [3]f64 ds) = decompose(model)
    ok = #expect(close3(dt, t) && close3(ds, s), "decompose lost the translation or the scale") && ok
    ok = #expect(close4(dq, q) || close4(dq, 0.0 - q), "decompose lost the rotation") && ok
    // A mirror: the negative scale lands on x.
    [3]f64 mirror = (-2.0, 0.5, 3.0)
    ([3]f64 mt, [4]f64 mq, [3]f64 ms) = decompose(compose(t, q, mirror))
    ok = #expect(close3(ms, mirror) && close3(mt, t), "decompose of a mirror answered ", ms[0], " ", ms[1], " ", ms[2]) && ok
    ok = #expect(close44(compose(mt, mq, ms), compose(t, q, mirror)), "decompose of a mirror does not compose back") && ok

    // ── [0, 1]-depth projections ────────────────────────────────────────────
    //
    // The near plane maps to depth 0 and the far plane to 1, where the GL
    // projections map them to -1 and 1.
    [4,4]f64 pz = perspective_zero_to_one(1.0, 1.5, 0.5, 100.0)
    [4]f64 near_point = (0.0, 0.0, -0.5, 1.0)
    [4]f64 far_point = (0.0, 0.0, -100.0, 1.0)
    [4]f64 cn = pz * near_point
    [4]f64 cf = pz * far_point
    ok = #expect(close(cn[2] / cn[3], 0.0) && close(cf[2] / cf[3], 1.0), "perspective_zero_to_one depth was ", cn[2] / cn[3], " and ", cf[2] / cf[3]) && ok
    [4,4]f64 pg = perspective(1.0, 1.5, 0.5, 100.0)
    ok = #expect(pz[0][0] == pg[0][0] && pz[1][1] == pg[1][1], "the two perspectives differ outside depth") && ok
    [4,4]f64 oz = orthographic_zero_to_one(-2.0, 2.0, -1.0, 1.0, 0.5, 10.0)
    [4]f64 on = oz * near_point
    [4]f64 of = oz * (0.0, 0.0, -10.0, 1.0)
    ok = #expect(close(on[2], 0.0) && close(of[2], 1.0), "orthographic_zero_to_one depth was ", on[2], " and ", of[2]) && ok

    if ok:
        return 0
    return 1
