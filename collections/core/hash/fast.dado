// The non-cryptographic hashes: FNV-1a, CRC-32, hash-combine, SipHash-2-4
// and xxHash64. The package comment, in `hash.dado`, says which to reach
// for.
package hash

// ── FNV-1a ────────────────────────────────────────────────────────────────

// FNV-1a's 32-bit offset basis: the hash of no bytes, and where a running
// `fnv1a32_update` starts.
const u32 FNV1A32_OFFSET = 0x811c9dc5

// FNV-1a's 64-bit offset basis: the hash of no bytes, and where a running
// `fnv1a64_update` starts.
const u64 FNV1A64_OFFSET = 0xcbf29ce484222325

// The 32-bit FNV-1a of `data`.
#assert_raises
u32 fnv1a32([]u8 data):
    return fnv32_of(FNV1A32_OFFSET, data)

// The 32-bit FNV-1a of the bytes of `text`.
#assert_raises
u32 fnv1a32_text(string8 text):
    return fnv32_of(FNV1A32_OFFSET, Bytes(text))

// `h` carried on over `data`: `fnv1a32_update(fnv1a32(a), b)` is the hash
// of `a` and `b` end to end.
#assert_raises
u32 fnv1a32_update(u32 h, []u8 data):
    return fnv32_of(h, data)

// The 64-bit FNV-1a of `data`.
#assert_raises
u64 fnv1a64([]u8 data):
    return fnv64_of(FNV1A64_OFFSET, data)

// The 64-bit FNV-1a of the bytes of `text`.
#assert_raises
u64 fnv1a64_text(string8 text):
    return fnv64_of(FNV1A64_OFFSET, Bytes(text))

// `h` carried on over `data`: `fnv1a64_update(fnv1a64(a), b)` is the hash
// of `a` and `b` end to end.
#assert_raises
u64 fnv1a64_update(u64 h, []u8 data):
    return fnv64_of(h, data)

// ── CRC-32 ────────────────────────────────────────────────────────────────

// The CRC-32 of `data`: the reflected polynomial `0xEDB88320` that zlib,
// gzip, zip and PNG use, so `crc32(bytes)` is the number those formats
// store.
#assert_raises
u32 crc32([]u8 data):
    return crc_of(0, data)

// The CRC-32 of the bytes of `text`.
#assert_raises
u32 crc32_text(string8 text):
    return crc_of(0, Bytes(text))

// `crc` carried on over `data`, as zlib's `crc32(crc, buf, len)`: start
// from 0, and `crc32_update(crc32(a), b)` is the CRC of `a` and `b` end to
// end.
#assert_raises
u32 crc32_update(u32 crc, []u8 data):
    return crc_of(crc, data)

// ── hash-combine ──────────────────────────────────────────────────────────

// `seed` mixed with `value`, for hashing a record from its fields' hashes:
// `combine64(combine64(h(a), h(b)), h(c))`. The order matters, so `(a, b)`
// and `(b, a)` differ. Boost's `hash_combine` at 64 bits; a mixer, not a
// hash, so feed it values that are already hashed.
#assert_raises
u64 combine64(u64 seed, u64 value):
    return seed ~ (value + 0x9e3779b97f4a7c15 + (seed << 6) + (seed >> 2))

// ── SipHash-2-4 ───────────────────────────────────────────────────────────

// SipHash-2-4 of `data` under a 16-byte `key`, as the reference
// implementation answers it: the hash a table keyed by text an attacker
// chooses should use, with a key the attacker cannot see. A keyed PRF for
// short inputs, not a digest: 64 bits is too few to name content.
#assert_raises
u64 siphash24([16]u8 key, []u8 data):
    return sip_of(key, data)

// SipHash-2-4 of the bytes of `text` under `key`.
#assert_raises
u64 siphash24_text([16]u8 key, string8 text):
    return sip_of(key, Bytes(text))

// ── xxHash64 ──────────────────────────────────────────────────────────────

// xxHash's XXH64 of `data` with `seed` (0 for the plain hash): fast,
// well mixed and unkeyed — for hash tables over trusted keys, cache keys
// and content fingerprints nobody is attacking. Answers what the reference
// `XXH64(data, len, seed)` answers. The seed comes first, as the key does
// in `siphash24` and the seed in `combine64`.
#assert_raises
u64 xxh64(u64 seed, []u8 data):
    return xxh_of(data, seed)

// XXH64 of the bytes of `text` with `seed`.
#assert_raises
u64 xxh64_text(u64 seed, string8 text):
    return xxh_of(Bytes(text), seed)

// ── inside ────────────────────────────────────────────────────────────────

private u32 fnv32_of(u32 start, []u8 data):
    u32 h = start
    for i in 0..<#len(data):
        h = (h ~ u32(data[i])) * 0x01000193
    return h

private u64 fnv64_of(u64 start, []u8 data):
    u64 h = start
    for i in 0..<#len(data):
        h = (h ~ u64(data[i])) * 0x100000001b3
    return h

private u32 crc_of(u32 crc, []u8 data):
    u32 c = crc ~ 0xFFFFFFFF
    for i in 0..<#len(data):
        c = CRC_TABLE[i64((c ~ u32(data[i])) & 0xFF)] ~ (c >> 8)
    return c ~ 0xFFFFFFFF

private u64 rotl64(u64 x, u64 n):
    return (x << n) | (x >> (64 - n))

// Eight bytes of `data` from `at`, least significant first.
private u64 le64([]u8 data, i64 at):
    u64 v = 0
    for j in 0..<8:
        v = v | (u64(data[at + j]) << u64(8 * j))
    return v

private u64 le32([]u8 data, i64 at):
    u64 v = 0
    for j in 0..<4:
        v = v | (u64(data[at + j]) << u64(8 * j))
    return v

// SipHash's four lanes.
private type Sip:
    u64 v0
    u64 v1
    u64 v2
    u64 v3

private void sip_round(^Sip s):
    s^.v0 = s^.v0 + s^.v1
    s^.v1 = rotl64(s^.v1, 13) ~ s^.v0
    s^.v0 = rotl64(s^.v0, 32)
    s^.v2 = s^.v2 + s^.v3
    s^.v3 = rotl64(s^.v3, 16) ~ s^.v2
    s^.v0 = s^.v0 + s^.v3
    s^.v3 = rotl64(s^.v3, 21) ~ s^.v0
    s^.v2 = s^.v2 + s^.v1
    s^.v1 = rotl64(s^.v1, 17) ~ s^.v2
    s^.v2 = rotl64(s^.v2, 32)

private u64 sip_of([16]u8 key, []u8 data):
    u64 k0 = le64(key[:], 0)
    u64 k1 = le64(key[:], 8)
    Sip s
    s.v0 = k0 ~ 0x736f6d6570736575
    s.v1 = k1 ~ 0x646f72616e646f6d
    s.v2 = k0 ~ 0x6c7967656e657261
    s.v3 = k1 ~ 0x7465646279746573
    i64 n = #len(data)
    i64 at = 0
    for n - at >= 8:
        u64 m = le64(data, at)
        s.v3 = s.v3 ~ m
        sip_round(&s)
        sip_round(&s)
        s.v0 = s.v0 ~ m
        at += 8
    u64 b = u64(n) << 56
    for j in 0..<(n - at):
        b = b | (u64(data[at + j]) << u64(8 * j))
    s.v3 = s.v3 ~ b
    sip_round(&s)
    sip_round(&s)
    s.v0 = s.v0 ~ b
    s.v2 = s.v2 ~ 0xFF
    for _i in 0..<4:
        sip_round(&s)
    return s.v0 ~ s.v1 ~ s.v2 ~ s.v3

private const u64 XXH_P1 = 0x9E3779B185EBCA87
private const u64 XXH_P2 = 0xC2B2AE3D27D4EB4F
private const u64 XXH_P3 = 0x165667B19E3779F9
private const u64 XXH_P4 = 0x85EBCA77C2B2AE63
private const u64 XXH_P5 = 0x27D4EB2F165667C5

private u64 xxh_round(u64 acc, u64 input):
    return rotl64(acc + input * XXH_P2, 31) * XXH_P1

private u64 xxh_merge(u64 acc, u64 v):
    return (acc ~ xxh_round(0, v)) * XXH_P1 + XXH_P4

private u64 xxh_of([]u8 data, u64 seed):
    i64 n = #len(data)
    i64 at = 0
    u64 h
    if n >= 32:
        u64 v1 = seed + XXH_P1 + XXH_P2
        u64 v2 = seed + XXH_P2
        u64 v3 = seed
        u64 v4 = seed - XXH_P1
        for n - at >= 32:
            v1 = xxh_round(v1, le64(data, at))
            v2 = xxh_round(v2, le64(data, at + 8))
            v3 = xxh_round(v3, le64(data, at + 16))
            v4 = xxh_round(v4, le64(data, at + 24))
            at += 32
        h = rotl64(v1, 1) + rotl64(v2, 7) + rotl64(v3, 12) + rotl64(v4, 18)
        h = xxh_merge(h, v1)
        h = xxh_merge(h, v2)
        h = xxh_merge(h, v3)
        h = xxh_merge(h, v4)
    else:
        h = seed + XXH_P5
    h = h + u64(n)
    for n - at >= 8:
        h = h ~ xxh_round(0, le64(data, at))
        h = rotl64(h, 27) * XXH_P1 + XXH_P4
        at += 8
    if n - at >= 4:
        h = h ~ (le32(data, at) * XXH_P1)
        h = rotl64(h, 23) * XXH_P2 + XXH_P3
        at += 4
    for at < n:
        h = h ~ (u64(data[at]) * XXH_P5)
        h = rotl64(h, 11) * XXH_P1
        at += 1
    h = h ~ (h >> 33)
    h = h * XXH_P2
    h = h ~ (h >> 29)
    h = h * XXH_P3
    h = h ~ (h >> 32)
    return h

// The table `crc_of` reads a byte at a time: entry `n` is `n` run through
// eight steps of the reflected polynomial `0xEDB88320`.
