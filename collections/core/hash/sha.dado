// SHA-1, SHA-512 and HMAC over SHA-256 and SHA-512 — the rest of the
// package's FIPS 180-4 and RFC 2104. The package comment, in `hash.dado`,
// says what each is for and what none of them promises.
package hash

// ── SHA-1 ─────────────────────────────────────────────────────────────────

// The 20 bytes of a SHA-1 digest, in the order FIPS 180-4 writes them.
// `hex`, `digest_equal` and `equal_hex` read it.
type Sha1Digest: [20]u8

// A SHA-1 in progress: `sha1_init`, then `update` as the bytes arrive,
// then `finish`. A plain value; copying one forks the hash.
type Sha1:
    [5]u32 state
    [64]u8 block
    i64 used
    u64 length

    // Feed `data`. Any split of a message across calls gives the digest
    // the whole message gives in one.
    #assert_raises
    void update(^self, []u8 data):
        feed1(self, data)

    // Feed the bytes of `text`.
    #assert_raises
    void update_text(^self, string8 text):
        feed1(self, Bytes(text))

    // Pad, compress the last block and answer the digest. The state is
    // spent afterwards: start a new one with `sha1_init` to hash again.
    #assert_raises
    Sha1Digest finish(^self):
        pad64(&self.block, self.used, self.length)
        if self.used > 55:
            compress1(&self.state, self.block[0..<64])
            for i in 0..<56:
                self.block[i] = 0
            put_be64(&self.block, 56, self.length * 8)
        compress1(&self.state, self.block[0..<64])
        self.used = 0
        Sha1Digest d
        for i in 0..<5:
            u32 w = self.state[i]
            d[4 * i] = u8(w >> 24)
            d[4 * i + 1] = u8((w >> 16) & 0xFF)
            d[4 * i + 2] = u8((w >> 8) & 0xFF)
            d[4 * i + 3] = u8(w & 0xFF)
        return d

// A fresh SHA-1: FIPS 180-4's initial hash value, nothing fed.
#assert_raises
Sha1 sha1_init():
    Sha1 s
    s.state[0] = 0x67452301
    s.state[1] = 0xefcdab89
    s.state[2] = 0x98badcfe
    s.state[3] = 0x10325476
    s.state[4] = 0xc3d2e1f0
    s.used = 0
    s.length = 0
    return s

// The SHA-1 of `data`, in one call.
#assert_raises
Sha1Digest sha1([]u8 data):
    Sha1 s = sha1_init()
    s.update(data)
    return s.finish()

// The SHA-1 of the bytes of `text`, in one call.
#assert_raises
Sha1Digest sha1_text(string8 text):
    Sha1 s = sha1_init()
    s.update_text(text)
    return s.finish()

// ── SHA-512 ───────────────────────────────────────────────────────────────

// The 64 bytes of a SHA-512 digest, in the order FIPS 180-4 writes them.
// `hex`, `digest_equal` and `equal_hex` read it.
type Sha512Digest: [64]u8

// A SHA-512 in progress: `sha512_init`, then `update` as the bytes
// arrive, then `finish`. A plain value; copying one forks the hash.
type Sha512:
    [8]u64 state
    [128]u8 block
    i64 used
    u64 length

    // Feed `data`. Any split of a message across calls gives the digest
    // the whole message gives in one.
    #assert_raises
    void update(^self, []u8 data):
        feed512(self, data)

    // Feed the bytes of `text`.
    #assert_raises
    void update_text(^self, string8 text):
        feed512(self, Bytes(text))

    // Pad, compress the last block and answer the digest. The state is
    // spent afterwards: start a new one with `sha512_init` to hash again.
    // The length field is 128 bits; a message under 2^61 bytes, which is
    // every message, has its high 64 bits of length-in-bits from the top
    // three bits of the byte count.
    #assert_raises
    Sha512Digest finish(^self):
        i64 at = self.used
        self.block[at] = 0x80
        at += 1
        if at > 112:
            for at < 128:
                self.block[at] = 0
                at += 1
            compress512(&self.state, self.block[0..<128])
            at = 0
        for at < 112:
            self.block[at] = 0
            at += 1
        u64 high = self.length >> 61
        u64 bits = self.length << 3
        for i in 0..<8:
            self.block[112 + i] = u8((high >> u64(56 - 8 * i)) & 0xFF)
            self.block[120 + i] = u8((bits >> u64(56 - 8 * i)) & 0xFF)
        compress512(&self.state, self.block[0..<128])
        self.used = 0
        Sha512Digest d
        for i in 0..<8:
            u64 w = self.state[i]
            for j in 0..<8:
                d[8 * i + j] = u8((w >> u64(56 - 8 * j)) & 0xFF)
        return d

// A fresh SHA-512: FIPS 180-4's initial hash value, nothing fed.
#assert_raises
Sha512 sha512_init():
    Sha512 s
    s.state[0] = 0x6a09e667f3bcc908
    s.state[1] = 0xbb67ae8584caa73b
    s.state[2] = 0x3c6ef372fe94f82b
    s.state[3] = 0xa54ff53a5f1d36f1
    s.state[4] = 0x510e527fade682d1
    s.state[5] = 0x9b05688c2b3e6c1f
    s.state[6] = 0x1f83d9abfb41bd6b
    s.state[7] = 0x5be0cd19137e2179
    s.used = 0
    s.length = 0
    return s

// The SHA-512 of `data`, in one call.
#assert_raises
Sha512Digest sha512([]u8 data):
    Sha512 s = sha512_init()
    s.update(data)
    return s.finish()

// The SHA-512 of the bytes of `text`, in one call.
#assert_raises
Sha512Digest sha512_text(string8 text):
    Sha512 s = sha512_init()
    s.update_text(text)
    return s.finish()

// ── HMAC ──────────────────────────────────────────────────────────────────
//
// RFC 2104's keyed hash, as RFC 4231 tests it: a key longer than the
// hash's block is hashed first, a shorter one is padded with zeros, and the
// message is hashed inside two passes keyed with `0x36` and `0x5c`. The
// comparison of a computed tag against a received one is the caller's, and
// `digest_equal` is not constant-time — see the package comment.

// HMAC-SHA-256 of `data` under `key`.
#assert_raises
Sha256Digest hmac_sha256([]u8 key, []u8 data):
    return hmac256(key, data)

// HMAC-SHA-256 of the bytes of `text` under the bytes of `key`.
#assert_raises
Sha256Digest hmac_sha256_text(string8 key, string8 text):
    return hmac256(Bytes(key), Bytes(text))

// HMAC-SHA-512 of `data` under `key`.
#assert_raises
Sha512Digest hmac_sha512([]u8 key, []u8 data):
    return hmac512(key, data)

// HMAC-SHA-512 of the bytes of `text` under the bytes of `key`.
#assert_raises
Sha512Digest hmac_sha512_text(string8 key, string8 text):
    return hmac512(Bytes(key), Bytes(text))

// ── inside ────────────────────────────────────────────────────────────────

private Sha256Digest hmac256([]u8 key, []u8 data):
    [64]u8 k
    for i in 0..<64:
        k[i] = 0
    if #len(key) > 64:
        Sha256 kh = sha256_init()
        feed(&kh, key)
        Sha256Digest kd = kh.finish()
        for i in 0..<32:
            k[i] = kd[i]
    else:
        for i in 0..<#len(key):
            k[i] = key[i]
    [64]u8 pad
    for i in 0..<64:
        pad[i] = k[i] ~ 0x36
    Sha256 inner = sha256_init()
    inner.update(pad[:])
    feed(&inner, data)
    Sha256Digest id = inner.finish()
    for i in 0..<64:
        pad[i] = k[i] ~ 0x5c
    Sha256 outer = sha256_init()
    outer.update(pad[:])
    outer.update(id[:])
    return outer.finish()

private Sha512Digest hmac512([]u8 key, []u8 data):
    [128]u8 k
    for i in 0..<128:
        k[i] = 0
    if #len(key) > 128:
        Sha512 kh = sha512_init()
        feed512(&kh, key)
        Sha512Digest kd = kh.finish()
        for i in 0..<64:
            k[i] = kd[i]
    else:
        for i in 0..<#len(key):
            k[i] = key[i]
    [128]u8 pad
    for i in 0..<128:
        pad[i] = k[i] ~ 0x36
    Sha512 inner = sha512_init()
    inner.update(pad[:])
    feed512(&inner, data)
    Sha512Digest id = inner.finish()
    for i in 0..<128:
        pad[i] = k[i] ~ 0x5c
    Sha512 outer = sha512_init()
    outer.update(pad[:])
    outer.update(id[:])
    return outer.finish()

// SHA-1's `feed`: the same buffering as SHA-256's, into `compress1`.
private void feed1(^Sha1 s, []u8 data):
    i64 n = #len(data)
    i64 at = 0
    if s.used > 0:
        for at < n && s.used < 64:
            s.block[s.used] = data[at]
            s.used += 1
            at += 1
        if s.used < 64:
            s.length += u64(n)
            return
        compress1(&s.state, s.block[:])
        s.used = 0
    for n - at >= 64:
        compress1(&s.state, data[at..<(at + 64)])
        at += 64
    for at < n:
        s.block[s.used] = data[at]
        s.used += 1
        at += 1
    s.length += u64(n)

// SHA-512's `feed`, 128 bytes a block.
private void feed512(^Sha512 s, []u8 data):
    i64 n = #len(data)
    i64 at = 0
    if s.used > 0:
        for at < n && s.used < 128:
            s.block[s.used] = data[at]
            s.used += 1
            at += 1
        if s.used < 128:
            s.length += u64(n)
            return
        compress512(&s.state, s.block[:])
        s.used = 0
    for n - at >= 128:
        compress512(&s.state, data[at..<(at + 128)])
        at += 128
    for at < n:
        s.block[s.used] = data[at]
        s.used += 1
        at += 1
    s.length += u64(n)

// The 0x80, the zeros and (when they fit) the 64-bit big-endian length in
// bits that end a 64-byte-block message; `used` bytes are pending. When the
// length does not fit (`used > 55`), the block is left padded with zeros
// for the caller to compress before a block of zeros and the length.
private void pad64(^[64]u8 block, i64 used, u64 length):
    block^[used] = 0x80
    for i in (used + 1)..<64:
        block^[i] = 0
    if used <= 55:
        put_be64(block, 56, length * 8)

private void put_be64(^[64]u8 block, i64 at, u64 v):
    for i in 0..<8:
        block^[at + i] = u8((v >> u64(56 - 8 * i)) & 0xFF)

private u32 rotl(u32 x, u32 n):
    return (x << n) | (x >> (32 - n))

// One 64-byte block into SHA-1's state (FIPS 180-4, section 6.1.2).
private void compress1(^[5]u32 h, []u8 block):
    [80]u32 w
    for t in 0..<16:
        w[t] = (u32(block[4 * t]) << 24) | (u32(block[4 * t + 1]) << 16) | (u32(block[4 * t + 2]) << 8) | u32(block[4 * t + 3])
    for t in 16..<80:
        w[t] = rotl(w[t - 3] ~ w[t - 8] ~ w[t - 14] ~ w[t - 16], 1)
    u32 a = h^[0]
    u32 b = h^[1]
    u32 c = h^[2]
    u32 d = h^[3]
    u32 e = h^[4]
    for t in 0..<80:
        u32 f
        u32 k
        if t < 20:
            f = (b & c) | (d &~ b)
            k = 0x5a827999
        else if t < 40:
            f = b ~ c ~ d
            k = 0x6ed9eba1
        else if t < 60:
            f = (b & c) | (b & d) | (c & d)
            k = 0x8f1bbcdc
        else:
            f = b ~ c ~ d
            k = 0xca62c1d6
        u32 tmp = rotl(a, 5) + f + e + k + w[t]
        e = d
        d = c
        c = rotl(b, 30)
        b = a
        a = tmp
    h^[0] = h^[0] + a
    h^[1] = h^[1] + b
    h^[2] = h^[2] + c
    h^[3] = h^[3] + d
    h^[4] = h^[4] + e

private u64 rotr64(u64 x, u64 n):
    return (x >> n) | (x << (64 - n))

// One 128-byte block into SHA-512's state (FIPS 180-4, section 6.4.2).
// Every `+` is a `u64` addition and wraps modulo 2^64.
private void compress512(^[8]u64 h, []u8 block):
    [80]u64 w
    for t in 0..<16:
        u64 v = 0
        for j in 0..<8:
            v = (v << 8) | u64(block[8 * t + j])
        w[t] = v
    for t in 16..<80:
        u64 x = w[t - 15]
        u64 y = w[t - 2]
        u64 s0 = rotr64(x, 1) ~ rotr64(x, 8) ~ (x >> 7)
        u64 s1 = rotr64(y, 19) ~ rotr64(y, 61) ~ (y >> 6)
        w[t] = w[t - 16] + s0 + w[t - 7] + s1
    u64 a = h^[0]
    u64 b = h^[1]
    u64 c = h^[2]
    u64 d = h^[3]
    u64 e = h^[4]
    u64 f = h^[5]
    u64 g = h^[6]
    u64 k = h^[7]
    for t in 0..<80:
        u64 big1 = rotr64(e, 14) ~ rotr64(e, 18) ~ rotr64(e, 41)
        u64 ch = (e & f) ~ (g &~ e)
        u64 t1 = k + big1 + ch + K512[t] + w[t]
        u64 big0 = rotr64(a, 28) ~ rotr64(a, 34) ~ rotr64(a, 39)
        u64 maj = (a & b) ~ (a & c) ~ (b & c)
        u64 t2 = big0 + maj
        k = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    h^[0] = h^[0] + a
    h^[1] = h^[1] + b
    h^[2] = h^[2] + c
    h^[3] = h^[3] + d
    h^[4] = h^[4] + e
    h^[5] = h^[5] + f
    h^[6] = h^[6] + g
    h^[7] = h^[7] + k

// FIPS 180-4, section 4.2.3: the first 64 bits of the fractional parts of
// the cube roots of the first 80 primes.
private const [80]u64 K512 = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
]
