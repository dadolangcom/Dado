@test
// SHA-256 against FIPS 180-4's own examples and NIST's long-message vectors,
// then against itself: every split of one message across two `update`s, the
// padding edge (a message of 55 bytes pads in one block, 56 needs a second),
// and the helpers. The pattern messages' digests are what `sha256sum`
// answers for the same bytes.
package hash

// A message of `n` bytes, `(7 i + 3) mod 256` at index `i`: no two
// neighbours equal and no run a wrong offset could hide in.
private [1024]u8 scratch
private []u8 pattern(i64 n):
    for i in 0..<n:
        scratch[i] = u8((i * 7 + 3) % 256)
    return scratch[0..<n]

private bool hexes(Sha256Digest d, string8 want, string8 what):
    ref []char8 got = sha256_hex(d)
    defer #delete(got)
    string8 text = string8(got[:])
    return #expect(text == want, what, ": ", text, " should be ", want)

private bool text_is(string8 msg, string8 want, string8 what):
    return hexes(sha256_text(msg), want, what)

i32 test():
    bool ok = true

    // ── FIPS 180-4 and NIST ───────────────────────────────────────────────
    ok = text_is("", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "empty") && ok
    ok = text_is("abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "abc") && ok
    ok = text_is("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
                 "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "448 bits") && ok
    ok = text_is("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
                 "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1", "896 bits") && ok

    // One million `a`, fed in pieces of 1000 through one state.
    [1000]u8 a
    for i in 0..<1000:
        a[i] = 0x61
    Sha256 m = sha256_init()
    for _i in 0..<1000:
        m.update(a[:])
    ok = hexes(m.finish(), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0", "a million a") && ok

    // ── the padding edge ──────────────────────────────────────────────────
    ok = hexes(sha256(pattern(55)), "e7313d333c272e639f790978283f9eb392e843d0f29b7016828bb1daa4aac70b", "55 bytes") && ok
    ok = hexes(sha256(pattern(56)), "4324d65f3c103567f5589c710bc08f8523f929a9272e3af36fc968e52abc6c27", "56 bytes") && ok
    ok = hexes(sha256(pattern(63)), "81c80242132f230c3bd41b3e63bbcff16107339549214a99614ff26664625055", "63 bytes") && ok
    ok = hexes(sha256(pattern(64)), "39e3d7b6b5d075d37d053ad89b24b41bef4f3c29760c84447cab3f3be1882241", "64 bytes") && ok
    ok = hexes(sha256(pattern(65)), "aacca6ff74fdbb296d165a45cecfa04e5127bc008770fbbdd48006f2d2fae95e", "65 bytes") && ok
    ok = hexes(sha256(pattern(1)), "084fed08b978af4d7d196a7446a86b58009e636b611db16211b65a9aadff29c5", "1 byte") && ok
    ok = hexes(sha256(pattern(119)), "9ce7368e4daf32341631b492e80359dc9f594b48453cd0dd5bf0b19279cc177e", "119 bytes") && ok
    ok = hexes(sha256(pattern(120)), "7836b787757e95e58b3ca5aec90b1b004e8deba1e50e9675af9cabf1a13a04b5", "120 bytes") && ok
    ok = hexes(sha256(pattern(128)), "d2742f1f4ac6bb7ca2b239ee18402ba8b3f9f8e652d2a72973c2b9ba11c08cf6", "128 bytes") && ok

    // ── streaming: a 130-byte message split at every boundary ─────────────
    []u8 msg = pattern(130)
    Sha256Digest whole = sha256(msg)
    ok = hexes(whole, "4d5e47a2e8510a314576c238f6ff19d389d3ef3aaaca8b2e530263a5d15741da", "130 bytes") && ok
    for cut in 0..=130:
        Sha256 s = sha256_init()
        s.update(msg[0..<cut])
        s.update(msg[cut..<130])
        Sha256Digest d = s.finish()
        ok = #expect(sha256_equal(d, whole), "130 bytes split at ", cut, " differ from one shot") && ok
    // And byte by byte, then in three uneven pieces.
    Sha256 one = sha256_init()
    for i in 0..<130:
        one.update(msg[i..<(i + 1)])
    ok = #expect(sha256_equal(one.finish(), whole), "130 bytes fed one at a time differ") && ok
    Sha256 three = sha256_init()
    three.update(msg[0..<10])
    three.update(msg[10..<75])
    three.update(msg[75..<130])
    ok = #expect(sha256_equal(three.finish(), whole), "130 bytes in three pieces differ") && ok

    // A copied state forks the hash.
    Sha256 base = sha256_init()
    base.update_text("ab")
    Sha256 fork = base
    fork.update_text("c")
    ok = hexes(fork.finish(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "a fork of ab, then c") && ok
    base.update_text("c")
    ok = hexes(base.finish(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "ab, then c") && ok

    // ── the helpers ───────────────────────────────────────────────────────
    Sha256Digest abc = sha256_text("abc")
    ok = #expect(sha256_equal_hex(abc, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"), "equal_hex, lowercase") && ok
    ok = #expect(sha256_equal_hex(abc, "BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD"), "equal_hex, uppercase") && ok
    ok = #expect(!sha256_equal_hex(abc, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ae"), "equal_hex, last digit off") && ok
    ok = #expect(!sha256_equal_hex(abc, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015a"), "equal_hex, 63 digits") && ok
    ok = #expect(!sha256_equal_hex(abc, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad "), "equal_hex, trailing space") && ok
    ok = #expect(!sha256_equal_hex(abc, "xa7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"), "equal_hex, not a digit") && ok
    ok = #expect(!sha256_equal_hex(abc, ""), "equal_hex, empty") && ok
    ok = #expect(!sha256_equal(abc, sha256_text("abd")), "equal, different digests") && ok
    [3]u8 raw = [0x61, 0x62, 0x63]
    ok = #expect(sha256_equal(abc, sha256(raw[:])), "sha256 and sha256_text agree") && ok

    if ok:
        return 0
    return 1
