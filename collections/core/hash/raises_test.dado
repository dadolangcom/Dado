@test
// What raises into a script. `#assert_raises` stands only above a
// package-level function, so the methods of `Sha1`, `Sha256` and `Sha512`
// cannot carry it themselves: each promised function here calls every one
// of a type's methods, and the build refuses (ERR1227) if any reaches
// something a script cannot run. The package-level functions carry their
// own promises in the package's files.
package hash

#assert_raises
private bool sha1_methods([]u8 data):
    Sha1 s = sha1_init()
    s.update(data)
    s.update_text("abc")
    Sha1Digest d = s.finish()
    return digest_equal(d, d)

#assert_raises
private bool sha256_methods([]u8 data):
    Sha256 s = sha256_init()
    s.update(data)
    s.update_text("abc")
    Sha256Digest d = s.finish()
    return digest_equal(d, d)

#assert_raises
private bool sha512_methods([]u8 data):
    Sha512 s = sha512_init()
    s.update(data)
    s.update_text("abc")
    Sha512Digest d = s.finish()
    return digest_equal(d, d)

i32 test():
    [3]u8 b = [1, 2, 3]
    bool ok = sha1_methods(b[:]) && sha256_methods(b[:]) && sha512_methods(b[:])
    return 0 if #expect(ok, "a digest did not equal itself") else 1
