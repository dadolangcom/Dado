@test
// The digest verbs, `hex`, `digest_equal` and `equal_hex`, at each digest
// size (`[20]u8`, `[32]u8`, `[64]u8`) and at a bare `[N]u8` that is no
// algorithm's, and `hex` answering `nil` when its one allocation is refused
// under `using`.
package hash

// An allocator that refuses everything.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

// `hex(d)` is `want`, `equal_hex` agrees in either case, and a digest equals
// itself and not one with its last byte changed.
private bool verbs([$N]u8 d, string8 want, string8 what):
    ref []char8 got = hex(d)
    string8 text = string8(got[:])
    bool ok = #expect(text == want, what, ": hex was ", text, ", not ", want)
    #delete(got)
    ok = #expect(equal_hex(d, want), what, ": equal_hex refused its own hex") && ok
    [N]u8 other = d
    other[N - 1] = other[N - 1] ~ 1
    ok = #expect(digest_equal(d, d), what, ": a digest did not equal itself") && ok
    ok = #expect(!digest_equal(d, other), what, ": digests a bit apart compared equal") && ok
    ok = #expect(!equal_hex(other, want), what, ": equal_hex matched a changed digest") && ok
    return ok

i32 test():
    bool ok = true
    ok = verbs(sha1_text("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1") && ok
    ok = verbs(sha256_text("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256") && ok
    ok = verbs(sha512_text("abc"),
               "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", "sha512") && ok
    [3]u8 bare = [0x00, 0xab, 0xFF]
    ok = verbs(bare, "00abff", "a bare [3]u8") && ok
    ok = #expect(equal_hex(bare, "00ABFF"), "equal_hex refused upper case") && ok
    ok = #expect(!equal_hex(bare, "00abf"), "equal_hex matched an odd digit count") && ok

    // ── no memory ──────────────────────────────────────────────────────────
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) nothing = (refuses, nil)
    using nothing:
        ok = #expect(hex(sha1_text("abc")) == nil, "hex of a sha1 without memory was not nil") && ok
        ok = #expect(hex(sha256_text("abc")) == nil, "hex of a sha256 without memory was not nil") && ok
        ok = #expect(hex(sha512_text("abc")) == nil, "hex of a sha512 without memory was not nil") && ok
    return 0 if ok else 1
