// core:hash — hashes over bytes. Today: SHA-256.
//
// **Tier N W H.** Pure Dado: no `foreign` block, no `#include` beyond what the
// compiler emits for itself, no allocation except `sha256_hex`'s text. It
// builds and runs freestanding, on the web and hosted (POSIX and Windows)
// unchanged. **Script class S.**
//
// **Thread-safety.** Nothing here is shared: there is no package state. A
// `Sha256` is a plain value; one thread at a time may feed a given one, and
// any number of threads may each feed their own.
//
// **Error codes: none.** Hashing cannot fail. `sha256_hex` answers `nil` when
// its one allocation fails, as every create verb does.
//
// ## SHA-256
//
// FIPS 180-4's SHA-256, for checksums — the `SHA256SUMS` an archive is
// verified against. **It is not a cryptographic promise**: no constant-time
// comparison, no protection of the state's memory, no HMAC. Use it to notice
// that bytes changed, not to keep a secret.
//
// Streaming, when the bytes arrive in pieces:
//
//     hash.Sha256 s = hash.sha256_init()
//     s.update(first)
//     s.update(second)
//     hash.Sha256Digest d = s.finish()
//     ref []char8 text = hash.sha256_hex(d)
//     defer #delete(text)
//
// One shot, when they are all at hand: `hash.sha256(bytes)` or
// `hash.sha256_text(s)`. Checking a published sum:
// `hash.sha256_equal_hex(d, digits)`, which reads the 64 hex digits in
// either case.
//
// The compression function's additions are `u32` additions, which wrap
// modulo 2^32 in Dado as in C's unsigned arithmetic — never a trap, with or
// without the sanitizer — and its rotations are two shifts and an or.
//
// ## Room for the rest
//
// The package is where FNV-1a, a fast 64-bit hash, hash-combine and CRC32
// will live beside SHA-256. Each will be named for its algorithm
// (`fnv1a64`, `crc32`, …), as `sha256` and its helpers are, so they sit
// side by side without a shared state type, `update` or `hex` that would
// have to mean two things.
package hash

// ── SHA-256 ───────────────────────────────────────────────────────────────

// The 32 bytes of a SHA-256 digest, in the order FIPS 180-4 writes them.
// Index it for a byte; `sha256_hex`, `sha256_equal` and `sha256_equal_hex`
// below read it.
public type Sha256Digest: [32]u8

// The digest as 64 lowercase hex digits — the form `sha256sum` prints and
// `SHA256SUMS` lists. New text on the ambient allocator; `nil` when the
// allocation fails.
public ref []char8 sha256_hex(Sha256Digest d):
    ref []char8 out = #make([]char8, 64)
    if out == nil:
        return out
    for i in 0..<32:
        out[2 * i] = HEX_DIGITS[i64(d[i] >> 4)]
        out[2 * i + 1] = HEX_DIGITS[i64(d[i] & 15)]
    return out

// Whether two digests are the same 32 bytes. Not constant-time, which a
// checksum does not need.
public bool sha256_equal(Sha256Digest a, Sha256Digest b):
    for i in 0..<32:
        if a[i] != b[i]:
            return false
    return true

// Whether `text` is `d` in hex: exactly 64 digits, upper or lower case,
// nothing before or after. `false` for text of any other shape, so a
// malformed line never matches.
public bool sha256_equal_hex(Sha256Digest d, string8 text):
    if #len(text) != 64:
        return false
    for i in 0..<32:
        i32 hi = hex_value(text[2 * i])
        i32 lo = hex_value(text[2 * i + 1])
        if hi < 0 || lo < 0:
            return false
        if u8(hi * 16 + lo) != d[i]:
            return false
    return true

// A SHA-256 in progress. Start one with `sha256_init`, feed it with
// `update` as many times as the bytes arrive, and end it with `finish`.
// A plain value of 112 bytes: copying one forks the hash, and nothing
// needs freeing.
public type Sha256:
    [8]u32 state
    [64]u8 block
    i64 used
    u64 length

    // Feed `data`. Any split of a message across calls gives the digest the
    // whole message gives in one.
    void update(^self, []u8 data):
        feed(self, data)

    // Feed the bytes of `text`.
    void update_text(^self, string8 text):
        feed(self, Chars(text))

    // Pad, compress the last block and answer the digest. The state is
    // spent afterwards: start a new one with `sha256_init` to hash again.
    Sha256Digest finish(^self):
        u64 bits = self.length * 8
        self.block[self.used] = 0x80
        self.used += 1
        if self.used > 56:
            for self.used < 64:
                self.block[self.used] = 0
                self.used += 1
            compress(&self.state, self.block[:])
            self.used = 0
        for self.used < 56:
            self.block[self.used] = 0
            self.used += 1
        for i in 0..<8:
            self.block[56 + i] = u8((bits >> u64(56 - 8 * i)) & 0xFF)
        compress(&self.state, self.block[:])
        self.used = 0
        Sha256Digest d
        for i in 0..<8:
            u32 w = self.state[i]
            d[4 * i] = u8(w >> 24)
            d[4 * i + 1] = u8((w >> 16) & 0xFF)
            d[4 * i + 2] = u8((w >> 8) & 0xFF)
            d[4 * i + 3] = u8(w & 0xFF)
        return d

// A fresh SHA-256: FIPS 180-4's initial hash value, nothing fed.
public Sha256 sha256_init():
    Sha256 s
    s.state[0] = 0x6a09e667
    s.state[1] = 0xbb67ae85
    s.state[2] = 0x3c6ef372
    s.state[3] = 0xa54ff53a
    s.state[4] = 0x510e527f
    s.state[5] = 0x9b05688c
    s.state[6] = 0x1f83d9ab
    s.state[7] = 0x5be0cd19
    s.used = 0
    s.length = 0
    return s

// The SHA-256 of `data`, in one call.
public Sha256Digest sha256([]u8 data):
    Sha256 s = sha256_init()
    s.update(data)
    return s.finish()

// The SHA-256 of the bytes of `text`, in one call.
public Sha256Digest sha256_text(string8 text):
    Sha256 s = sha256_init()
    s.update_text(text)
    return s.finish()

// ── inside ────────────────────────────────────────────────────────────────

private const string8 HEX_DIGITS = "0123456789abcdef"

// A string's bytes as a run of `char8`: the same two words, nothing copied.
private type Chars: []char8

// `update`'s body, once for `[]u8` and once for a string's `[]char8`: what
// does not fill the pending block goes through `compress` straight from
// `data`, 64 bytes at a time.
private void feed(^Sha256 s, []$T data):
    i64 n = #len(data)
    i64 at = 0
    if s.used > 0:
        for at < n && s.used < 64:
            s.block[s.used] = u8(data[at])
            s.used += 1
            at += 1
        if s.used < 64:
            s.length += u64(n)
            return
        compress(&s.state, s.block[:])
        s.used = 0
    for n - at >= 64:
        compress(&s.state, data[at..<(at + 64)])
        at += 64
    for at < n:
        s.block[s.used] = u8(data[at])
        s.used += 1
        at += 1
    s.length += u64(n)

private i32 hex_value(char8 c):
    if c >= '0' && c <= '9':
        return i32(c - '0')
    if c >= 'a' && c <= 'f':
        return i32(c - 'a') + 10
    if c >= 'A' && c <= 'F':
        return i32(c - 'A') + 10
    return 0 - 1

// FIPS 180-4, section 4.2.2: the first 32 bits of the fractional parts of the cube
// roots of the first 64 primes.
private const [64]u32 K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]

private u32 rotr(u32 x, u32 n):
    return (x >> n) | (x << (32 - n))

// One 64-byte block into the state (FIPS 180-4, section 6.2.2). Every `+` is a
// `u32` addition and wraps modulo 2^32, which is what the standard means.
private void compress(^[8]u32 h, []$T block):
    [64]u32 w
    for t in 0..<16:
        w[t] = (u32(u8(block[4 * t])) << 24) | (u32(u8(block[4 * t + 1])) << 16) | (u32(u8(block[4 * t + 2])) << 8) | u32(u8(block[4 * t + 3]))
    for t in 16..<64:
        u32 x = w[t - 15]
        u32 y = w[t - 2]
        u32 s0 = rotr(x, 7) ~ rotr(x, 18) ~ (x >> 3)
        u32 s1 = rotr(y, 17) ~ rotr(y, 19) ~ (y >> 10)
        w[t] = w[t - 16] + s0 + w[t - 7] + s1
    u32 a = h^[0]
    u32 b = h^[1]
    u32 c = h^[2]
    u32 d = h^[3]
    u32 e = h^[4]
    u32 f = h^[5]
    u32 g = h^[6]
    u32 k = h^[7]
    for t in 0..<64:
        u32 big1 = rotr(e, 6) ~ rotr(e, 11) ~ rotr(e, 25)
        u32 ch = (e & f) ~ (g &~ e)
        u32 t1 = k + big1 + ch + K[t] + w[t]
        u32 big0 = rotr(a, 2) ~ rotr(a, 13) ~ rotr(a, 22)
        u32 maj = (a & b) ~ (a & c) ~ (b & c)
        u32 t2 = big0 + maj
        k = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    h^[0] = h^[0] + a
    h^[1] = h^[1] + b
    h^[2] = h^[2] + c
    h^[3] = h^[3] + d
    h^[4] = h^[4] + e
    h^[5] = h^[5] + f
    h^[6] = h^[6] + g
    h^[7] = h^[7] + k
