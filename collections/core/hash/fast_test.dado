@test
// The table hashes against their references: CRC-32 and FNV-1a against
// their check values, SipHash-2-4 against the reference implementation's
// vectors (key `00 01 … 0f`, message `00 01 … n-1`) and the paper's worked
// example, xxHash64 against `XXH64` with and without a seed, at every
// length that changes its path (under 4, 4 to 7, 8 to 31, 32 and over);
// then the `_update` forms against the one-shot ones, and `combine64`'s
// order.
package hash

private [512]u8 scratch
private [64]u8 count_buf

// `n` bytes, `(7 i + 3) mod 256` at index `i`.
private []u8 pattern(i64 n):
    for i in 0..<n:
        scratch[i] = u8((i * 7 + 3) % 256)
    return scratch[0..<n]

// `00 01 … n-1`.
private []u8 counting(i64 n):
    for i in 0..<n:
        count_buf[i] = u8(i)
    return count_buf[0..<n]

private bool n64(u64 got, u64 want, string8 what):
    return #expect(got == want, what, ": ", got, " should be ", want)

private bool n32(u32 got, u32 want, string8 what):
    return #expect(got == want, what, ": ", got, " should be ", want)

i32 test():
    bool ok = true
    [16]u8 key
    for i in 0..<16:
        key[i] = u8(i)

    // ── check values ──────────────────────────────────────────────────────
    ok = n32(crc32_text("123456789"), 0xcbf43926, "crc32 check") && ok
    ok = n32(fnv1a32_text("a"), 0xe40c292c, "fnv1a32 a") && ok
    ok = n64(fnv1a64_text("a"), 0xaf63dc4c8601ec8c, "fnv1a64 a") && ok
    ok = n64(fnv1a64_text(""), FNV1A64_OFFSET, "fnv1a64 empty") && ok
    ok = n64(xxh64_text(0, ""), 0xef46db3751d8e999, "xxh64 empty") && ok
    ok = n64(xxh64_text(0, "a"), 0xd24ec4f1a98c6e5b, "xxh64 a") && ok
    ok = n64(xxh64_text(0, "abc"), 0x44bc2cf5ad770999, "xxh64 abc") && ok
    ok = n64(siphash24(key, counting(0)), 0x726fdb47dd0e0e31, "siphash vector 0") && ok
    ok = n64(siphash24(key, counting(15)), 0xa129ca6149be45e5, "siphash paper example") && ok

    // ── each path ─────────────────────────────────────────────────────────
    ok = n64(xxh64(0, pattern(0)), 0xef46db3751d8e999, "xxh64 0") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(0)), 0xc4349fc93c010000, "xxh64 seeded 0") && ok
    ok = n64(xxh64(0, pattern(1)), 0x1f25c8d0bc1f4bb6, "xxh64 1") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(1)), 0x79826bcd749d267a, "xxh64 seeded 1") && ok
    ok = n64(xxh64(0, pattern(3)), 0x31d2363f52e564c9, "xxh64 3") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(3)), 0x78efd77575e26575, "xxh64 seeded 3") && ok
    ok = n64(xxh64(0, pattern(4)), 0x9bb64b7d66ee9fda, "xxh64 4") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(4)), 0x6f0a6c97d68bf353, "xxh64 seeded 4") && ok
    ok = n64(xxh64(0, pattern(7)), 0x9a7b149959ce60d8, "xxh64 7") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(7)), 0xd97ede93c9d66a0d, "xxh64 seeded 7") && ok
    ok = n64(xxh64(0, pattern(8)), 0xdab99d95c6f90092, "xxh64 8") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(8)), 0xa2f1e28437a78a1b, "xxh64 seeded 8") && ok
    ok = n64(xxh64(0, pattern(15)), 0x1b47cb8243cc8e32, "xxh64 15") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(15)), 0xe2ec50a544faec61, "xxh64 seeded 15") && ok
    ok = n64(xxh64(0, pattern(31)), 0xa2aa5f33cc4a6119, "xxh64 31") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(31)), 0x755437271d1d0a84, "xxh64 seeded 31") && ok
    ok = n64(xxh64(0, pattern(32)), 0x23c3c17ef790fd97, "xxh64 32") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(32)), 0xbf624b932c090428, "xxh64 seeded 32") && ok
    ok = n64(xxh64(0, pattern(33)), 0x50a7cfc7ba588784, "xxh64 33") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(33)), 0x7aceaf1e9d34ea35, "xxh64 seeded 33") && ok
    ok = n64(xxh64(0, pattern(63)), 0x5e3e54b431c7493c, "xxh64 63") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(63)), 0x2c8ddce5c85d0d9d, "xxh64 seeded 63") && ok
    ok = n64(xxh64(0, pattern(64)), 0x0eb64b3ef6eeb01f, "xxh64 64") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(64)), 0x4af341f14e3a6fc9, "xxh64 seeded 64") && ok
    ok = n64(xxh64(0, pattern(100)), 0xa61f8d4c170fe531, "xxh64 100") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(100)), 0xf6d8f65c625abb4f, "xxh64 seeded 100") && ok
    ok = n64(xxh64(0, pattern(257)), 0xb7b604f7e4f822fa, "xxh64 257") && ok
    ok = n64(xxh64(0x9e3779b97f4a7c15, pattern(257)), 0x8a59fbe41c74bfd7, "xxh64 seeded 257") && ok
    ok = n64(siphash24(key, counting(0)), 0x726fdb47dd0e0e31, "siphash 0") && ok
    ok = n64(siphash24(key, counting(1)), 0x74f839c593dc67fd, "siphash 1") && ok
    ok = n64(siphash24(key, counting(7)), 0xab0200f58b01d137, "siphash 7") && ok
    ok = n64(siphash24(key, counting(8)), 0x93f5f5799a932462, "siphash 8") && ok
    ok = n64(siphash24(key, counting(9)), 0x9e0082df0ba9e4b0, "siphash 9") && ok
    ok = n64(siphash24(key, counting(15)), 0xa129ca6149be45e5, "siphash 15") && ok
    ok = n64(siphash24(key, counting(16)), 0x3f2acc7f57c29bdb, "siphash 16") && ok
    ok = n64(siphash24(key, counting(63)), 0x958a324ceb064572, "siphash 63") && ok
    ok = n64(siphash24(key, counting(64)), 0xacd2c40b8502cad8, "siphash 64") && ok
    ok = n32(crc32(pattern(0)), 0x00000000, "crc32 0") && ok
    ok = n32(fnv1a32(pattern(0)), 0x811c9dc5, "fnv1a32 0") && ok
    ok = n64(fnv1a64(pattern(0)), 0xcbf29ce484222325, "fnv1a64 0") && ok
    ok = n32(crc32(pattern(1)), 0x4b0bbe37, "crc32 1") && ok
    ok = n32(fnv1a32(pattern(1)), 0x060c5eb2, "fnv1a32 1") && ok
    ok = n64(fnv1a64(pattern(1)), 0xaf63be4c8601b992, "fnv1a64 1") && ok
    ok = n32(crc32(pattern(5)), 0xfcc83142, "crc32 5") && ok
    ok = n32(fnv1a32(pattern(5)), 0xc3d7e272, "fnv1a32 5") && ok
    ok = n64(fnv1a64(pattern(5)), 0x443ac335fae03c52, "fnv1a64 5") && ok
    ok = n32(crc32(pattern(64)), 0xcbd9ecf0, "crc32 64") && ok
    ok = n32(fnv1a32(pattern(64)), 0x71b1e1c5, "fnv1a32 64") && ok
    ok = n64(fnv1a64(pattern(64)), 0xdc73a7cb467baca5, "fnv1a64 64") && ok
    ok = n32(crc32(pattern(300)), 0xde0e57ce, "crc32 300") && ok
    ok = n32(fnv1a32(pattern(300)), 0xe5e7e389, "fnv1a32 300") && ok
    ok = n64(fnv1a64(pattern(300)), 0x44e083902584c7a9, "fnv1a64 300") && ok
    // ── carried across pieces ─────────────────────────────────────────────
    []u8 msg = pattern(300)
    u32 c = crc32(msg)
    u32 f32 = fnv1a32(msg)
    u64 f64v = fnv1a64(msg)
    for cut in 0..=300:
        ok = n32(crc32_update(crc32(msg[0..<cut]), msg[cut..<300]), c, "crc32 split") && ok
        ok = n32(fnv1a32_update(fnv1a32(msg[0..<cut]), msg[cut..<300]), f32, "fnv1a32 split") && ok
        ok = n64(fnv1a64_update(fnv1a64(msg[0..<cut]), msg[cut..<300]), f64v, "fnv1a64 split") && ok
    ok = n64(siphash24_text(key, ""), siphash24(key, pattern(0)), "siphash text") && ok
    // A seeded `_text` form hashes the same bytes under the same seed.
    [3]u8 abc = [0x61, 0x62, 0x63]
    ok = n64(xxh64_text(0x9e3779b97f4a7c15, "abc"), xxh64(0x9e3779b97f4a7c15, abc[:]), "xxh64 seeded text") && ok

    // ── combine64 ─────────────────────────────────────────────────────────
    u64 ab = combine64(combine64(0, 1), 2)
    u64 ba = combine64(combine64(0, 2), 1)
    ok = #expect(ab != ba, "combine64 ignored the order") && ok
    ok = n64(combine64(0, 0), 0x9e3779b97f4a7c15, "combine64 of zeros") && ok
    return 0 if ok else 1
