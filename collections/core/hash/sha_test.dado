@test
// SHA-1 and SHA-512 against FIPS 180-4's examples, then over the padding
// edges of each block size (the digests are what `sha1sum` and `sha512sum`
// answer for the same bytes), a split of one message across every pair of
// `update`s, and HMAC over both against RFC 4231's test cases 1 to 4, 6
// and 7 (5 is a truncated tag, which is the caller's to cut).
package hash

private [512]u8 scratch
private [1024]u8 other

// `n` bytes, `(7 i + 3) mod 256` at index `i`.
private []u8 pattern(i64 n):
    for i in 0..<n:
        scratch[i] = u8((i * 7 + 3) % 256)
    return scratch[0..<n]

// `n` copies of `b`, in the second buffer so a key and a message can
// both be at hand.
private []u8 filled(u8 b, i64 n):
    for i in 0..<n:
        other[i] = b
    return other[0..<n]

// (`Bytes(text)` is the package's own view of text as the `[]u8` the
// byte-keyed HMACs take.)

private bool hex_is(ref []char8 got, string8 want, string8 what):
    string8 text = string8(got[:])
    bool ok = #expect(text == want, what, ": ", text, " should be ", want)
    #delete(got)
    return ok

private bool sum1([]u8 data, string8 want, string8 what):
    Sha1Digest d = sha1(data)
    bool ok = hex_is(hex(d), want, what)
    return #expect(equal_hex(d, want), what, ": the hex does not compare equal") && ok

private bool sum512([]u8 data, string8 want, string8 what):
    Sha512Digest d = sha512(data)
    bool ok = hex_is(hex(d), want, what)
    return #expect(equal_hex(d, want), what, ": the hex does not compare equal") && ok

i32 test():
    bool ok = true

    // ── FIPS 180-4 ────────────────────────────────────────────────────────
    ok = hex_is(hex(sha1_text("abc")), "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1 abc") && ok
    ok = hex_is(hex(sha1_text("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
                "84983e441c3bd26ebaae4aa1f95129e5e54670f1", "sha1 448 bits") && ok
    ok = hex_is(hex(sha512_text("abc")),
                "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", "sha512 abc") && ok
    ok = hex_is(hex(sha512_text("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")),
                "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909", "sha512 896 bits") && ok

    // One million `a`, a thousand at a time.
    Sha1 m1 = sha1_init()
    Sha512 m5 = sha512_init()
    for _i in 0..<1000:
        m1.update(filled(0x61, 1000))
        m5.update(filled(0x61, 1000))
    ok = hex_is(hex(m1.finish()), "34aa973cd4c4daa4f61eeb2bdbad27316534016f", "sha1 a million a") && ok
    ok = hex_is(hex(m5.finish()),
                "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b", "sha512 a million a") && ok

    // ── the padding edges ─────────────────────────────────────────────────
    ok = sum1(pattern(0), "da39a3ee5e6b4b0d3255bfef95601890afd80709", "sha1 0") && ok
    ok = sum1(pattern(1), "9842926af7ca0a8cca12604f945414f07b01e13d", "sha1 1") && ok
    ok = sum1(pattern(55), "ddf57317ef34bfee3b6df83d359098930eb278bc", "sha1 55") && ok
    ok = sum1(pattern(56), "a0d492bb0fc889d0eca3bc137066ab6f4f74f369", "sha1 56") && ok
    ok = sum1(pattern(63), "c55856749bef509bdfe6bfebfc7bf4e793e82132", "sha1 63") && ok
    ok = sum1(pattern(64), "bede92be29c3874e1b54ddc77988d606fc857a8e", "sha1 64") && ok
    ok = sum1(pattern(65), "b05a80522b053d6dc7e0a517d0e70212c7dad11f", "sha1 65") && ok
    ok = sum1(pattern(119), "504e27376a6e0f0dba8295b85cb25dc4dfa17d23", "sha1 119") && ok
    ok = sum1(pattern(120), "82134b02fb3f702491be9bed581eeab59334acb2", "sha1 120") && ok
    ok = sum512(pattern(0), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", "sha512 0") && ok
    ok = sum512(pattern(1), "e45bf5817ddf94aa2f7a407071f0eedc6beb98f768b4cd33d1176d44d1563a45a5d7212290eb7670c6786b13591aedac86478993895e8b24e612014abaa6ba04", "sha512 1") && ok
    ok = sum512(pattern(111), "68cffa6d0d76f309c9ce0d35280939f8e25990c43b7b086ccdf709be35b07d4ddba599541ff2b1c19d34ea49aeafb9659adb7ac3c0b078bb30a22d57fc6687ef", "sha512 111") && ok
    ok = sum512(pattern(112), "d0865c524d1dddf7c23b799c413f5adcd7caefd3f66a9b49750ec81066012c25a8bcf94ddea6dc525691673097ca40e0101e897fc97218cfdb0704084e2bef4b", "sha512 112") && ok
    ok = sum512(pattern(113), "606314353bd419f9f7720e8297f2af8a9ed5f0bb0bed29b716bf18e34577623ae7effa46f496bd4282134e7e895284a4760a910d2ad8ec11e9dd75863058cd9c", "sha512 113") && ok
    ok = sum512(pattern(127), "e0b6a20f1c0c88970a9340152cd5a1c1ecf3d3b8de55102741879438079473540133b812706e5dbec322c8c9523b6fc8c6d16ee626e87ad5fe3d2916afedc369", "sha512 127") && ok
    ok = sum512(pattern(128), "99b16f17aa0b969a5b8f08f367719d516e330ccd2660b6f0688ec031dbc783de50a1cd185a2568dba75070a2403d17d4741d163578515dfd2ff756ddfe4d47b1", "sha512 128") && ok
    ok = sum512(pattern(129), "a1556e29185778aa5991e34b8884c840d589f0fbb4b8ed590e51e9ac4eb03a008125000db2671f8fe7f485b59a77b518670078ecb41a54b4cd02a7f1d2ca4c6d", "sha512 129") && ok
    ok = sum512(pattern(239), "18ee83f30261c3c645d52aee6a209105b25bba39d33845ef48984cc238e4f21661fb7bd7dd4336f71c40fe87d95e5115d6c7be52e0d3e7e7877d24500b5b58df", "sha512 239") && ok
    ok = sum512(pattern(240), "9d60ee60d29ec4fa0b9690c04c1c29413bbe3ed345639182d9d53dcc05926b77b04f4fec1562fb85182954c96b7cbb5d5e4410251ff4f352d09a2da90419fb13", "sha512 240") && ok
    ok = sum512(pattern(256), "e49c208e41556e859d1a52d14784a061c2d5ae2c8690a5360e9f9344f60861c1362a9ec05a9f08a4167b3da41bdd122a387413dd06976470e4beff5053f2ac71", "sha512 256") && ok
    ok = sum512(pattern(300), "46e56ad30db9ef50f8b6762ba55839737f3fba34ab47863c9daff7b3f58f97fe3465a52dd364560db47f802909ced49093322621ea0aebf8e0696b85ca8f81f0", "sha512 300") && ok

    // ── streaming: 300 bytes split at every boundary ──────────────────────
    []u8 msg = pattern(300)
    Sha1Digest w1 = sha1(msg)
    Sha512Digest w5 = sha512(msg)
    for cut in 0..=300:
        Sha1 a = sha1_init()
        a.update(msg[0..<cut])
        a.update(msg[cut..<300])
        ok = #expect(digest_equal(a.finish(), w1), "sha1 split at ", cut) && ok
        Sha512 b = sha512_init()
        b.update(msg[0..<cut])
        b.update(msg[cut..<300])
        ok = #expect(digest_equal(b.finish(), w5), "sha512 split at ", cut) && ok
    ok = #expect(!equal_hex(w1, "nope"), "sha1: short text matched") && ok
    ok = #expect(!equal_hex(w5, "zz"), "sha512: short text matched") && ok

    // ── HMAC, RFC 4231 ────────────────────────────────────────────────────
    ok = hex_is(hex(hmac_sha256_text("Jefe", "what do ya want for nothing?")), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", "hmac256 case 2") && ok
    ok = hex_is(hex(hmac_sha512_text("Jefe", "what do ya want for nothing?")), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737", "hmac512 case 2") && ok
    [131]u8 key
    for i in 0..<20:
        key[i] = 0x0b
    ok = hex_is(hex(hmac_sha256(key[0..<20], Bytes("Hi There"))), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", "hmac256 case 1") && ok
    ok = hex_is(hex(hmac_sha512(key[0..<20], Bytes("Hi There"))), "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854", "hmac512 case 1") && ok
    for i in 0..<131:
        key[i] = 0xaa
    ok = hex_is(hex(hmac_sha256(key[0..<20], filled(0xdd, 50))), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe", "hmac256 case 3") && ok
    ok = hex_is(hex(hmac_sha512(key[0..<20], filled(0xdd, 50))), "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb", "hmac512 case 3") && ok
    string8 long_key = "Test Using Larger Than Block-Size Key - Hash Key First"
    ok = hex_is(hex(hmac_sha256(key[:], Bytes(long_key))), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54", "hmac256 case 6") && ok
    ok = hex_is(hex(hmac_sha512(key[:], Bytes(long_key))), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598", "hmac512 case 6") && ok
    string8 long_data = "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."
    ok = hex_is(hex(hmac_sha256(key[:], Bytes(long_data))), "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2", "hmac256 case 7") && ok
    ok = hex_is(hex(hmac_sha512(key[:], Bytes(long_data))), "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58", "hmac512 case 7") && ok
    for i in 0..<25:
        key[i] = u8(i + 1)
    ok = hex_is(hex(hmac_sha256(key[0..<25], filled(0xcd, 50))), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b", "hmac256 case 4") && ok
    ok = hex_is(hex(hmac_sha512(key[0..<25], filled(0xcd, 50))), "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd", "hmac512 case 4") && ok
    return 0 if ok else 1
