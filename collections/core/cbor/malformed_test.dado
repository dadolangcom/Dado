@test
// RFC 8949 Appendix F.1, every example of bytes that are not well-formed,
// each failing with the code for its kind of error, through `well_formed`
// and through a reader's `skip`, which must not move. Then the depth limit,
// trailing bytes and empty input.
package cbor

private type Case: (string8 hex, i32 code)

private const [104]Case CASES = [
    // End of input in a head.
    ("18", TRUNCATED), ("19", TRUNCATED), ("1a", TRUNCATED), ("1b", TRUNCATED),
    ("1901", TRUNCATED), ("1a0102", TRUNCATED), ("1b01020304050607", TRUNCATED),
    ("38", TRUNCATED), ("58", TRUNCATED), ("78", TRUNCATED), ("98", TRUNCATED),
    ("9a01ff00", TRUNCATED), ("b8", TRUNCATED), ("d8", TRUNCATED), ("f8", TRUNCATED),
    ("f900", TRUNCATED), ("fa0000", TRUNCATED), ("fb000000", TRUNCATED),
    // Definite-length strings with short data.
    ("41", TRUNCATED), ("61", TRUNCATED), ("5affffffff00", TRUNCATED),
    ("5bffffffffffffffff010203", TRUNCATED), ("7affffffff00", TRUNCATED),
    ("7b7fffffffffffffff010203", TRUNCATED),
    // Definite-length maps and arrays not closed with enough items.
    ("81", TRUNCATED), ("818181818181818181", TRUNCATED), ("8200", TRUNCATED),
    ("a1", TRUNCATED), ("a20102", TRUNCATED), ("a100", TRUNCATED), ("a2000000", TRUNCATED),
    // A tag number with no content.
    ("c0", TRUNCATED),
    // Indefinite-length strings, maps and arrays not closed by a break.
    ("5f4100", TRUNCATED), ("7f6100", TRUNCATED),
    ("9f", TRUNCATED), ("9f0102", TRUNCATED), ("bf", TRUNCATED), ("bf01020102", TRUNCATED),
    ("819f", TRUNCATED), ("9f8000", TRUNCATED), ("9f9f9f9f9fffffffff", TRUNCATED),
    ("9f819f819f9fffffff", TRUNCATED),
    // Reserved additional information.
    ("1c", RESERVED), ("1d", RESERVED), ("1e", RESERVED), ("3c", RESERVED), ("3d", RESERVED),
    ("3e", RESERVED), ("5c", RESERVED), ("5d", RESERVED), ("5e", RESERVED), ("7c", RESERVED),
    ("7d", RESERVED), ("7e", RESERVED), ("9c", RESERVED), ("9d", RESERVED), ("9e", RESERVED),
    ("bc", RESERVED), ("bd", RESERVED), ("be", RESERVED), ("dc", RESERVED), ("dd", RESERVED),
    ("de", RESERVED), ("fc", RESERVED), ("fd", RESERVED), ("fe", RESERVED),
    // Reserved two-byte simple values.
    ("f800", RESERVED), ("f801", RESERVED), ("f818", RESERVED), ("f81f", RESERVED),
    // Indefinite-length string pieces of the wrong type, or not definite.
    ("5f00ff", BAD_CHUNK), ("5f21ff", BAD_CHUNK), ("5f6100ff", BAD_CHUNK), ("5f80ff", BAD_CHUNK),
    ("5fa0ff", BAD_CHUNK), ("5fc000ff", BAD_CHUNK), ("5fe0ff", BAD_CHUNK), ("7f4100ff", BAD_CHUNK),
    ("5f5f4100ffff", BAD_CHUNK), ("7f7f6100ffff", BAD_CHUNK),
    // A break on its own, in a definite-length item, or in a value position.
    ("ff", BAD_BREAK), ("81ff", BAD_BREAK), ("8200ff", BAD_BREAK), ("a1ff", BAD_BREAK),
    ("a1ff00", BAD_BREAK), ("a100ff", BAD_BREAK), ("a20000ff", BAD_BREAK), ("9f81ff", BAD_BREAK),
    ("9f829f819f9fffffffff", BAD_BREAK), ("bf00ff", BAD_BREAK), ("bf000000ff", BAD_BREAK),
    // Additional information 31 where there is no indefinite form.
    ("1f", RESERVED), ("3f", RESERVED), ("df", RESERVED),
    // Not Appendix F: bytes after the item, and nothing at all.
    ("0000", TRAILING), ("", TRUNCATED), ("8000", TRAILING),
    // A huge count is caught before any item is walked.
    ("9bffffffffffffffff00", TRUNCATED), ("bbffffffffffffffff0000", TRUNCATED),
    ("5f40ff", 0), ("7fff", 0), ("bf6161f5ff", 0), ("c0c0c000", 0), ("f820", 0),
]

private i32 nibble(char8 c):
    if c >= '0' && c <= '9':
        return i32(c - '0')
    return i32(c - 'a') + 10

private ref []u8 unhex(string8 s):
    ref []u8 out = #make([]u8, #len(s) / 2)
    for i in 0..<(#len(s) / 2):
        out[i] = u8(nibble(s[2 * i]) * 16 + nibble(s[2 * i + 1]))
    return out

private i32 code_of([]u8 b):
    try well_formed(b) else code:
        return code
    return 0

private bool case_ok(Case c):
    ref []u8 b = unhex(c.hex)
    defer #delete(b)
    i32 got = code_of(b[:])
    bool ok = #expect(got == c.code, c.hex, ": failed with ", got, " (", message(got), "), not ", c.code)
    if c.code == TRAILING:
        return ok
    Reader r = reader(b[:])
    i32 skipped = 0
    try r.skip() else code:
        skipped = code
    ok = #expect(skipped == c.code, c.hex, ": skip failed with ", skipped, ", not ", c.code) && ok
    if skipped != 0:
        ok = #expect(r.at == 0, c.hex, ": a failed skip moved the reader to ", r.at) && ok
        // So does a failed diagnose, which never renders a bad item.
        try ref []char8 text = r.diagnose() else:
            return ok
        #delete(text)
        ok = #expect(false, c.hex, ": diagnosed a malformed item") && ok
    return ok

// `n` arrays of one, each inside the last, around a 0; or `n` tags.
private ref []u8 nested(i64 n, u8 head):
    ref []u8 out = #make([]u8, n + 1)
    for i in 0..<n:
        out[i] = head
    out[n] = 0
    return out

private bool depth_ok(i64 n, u8 head, i32 want):
    ref []u8 b = nested(n, head)
    defer #delete(b)
    i32 got = code_of(b[:])
    return #expect(got == want, n, " deep (", head, "): code ", got, ", not ", want)

i32 test():
    bool ok = true
    for c in CASES:
        ok = case_ok(c) && ok
    ok = depth_ok(i64(MAX_DEPTH), 0x81, 0) && ok
    ok = depth_ok(i64(MAX_DEPTH) + 1, 0x81, TOO_DEEP) && ok
    ok = depth_ok(i64(MAX_DEPTH), 0xC0, 0) && ok
    ok = depth_ok(i64(MAX_DEPTH) + 1, 0xC0, TOO_DEEP) && ok
    ok = depth_ok(i64(MAX_DEPTH), 0x9F, TRUNCATED) && ok
    ok = depth_ok(i64(MAX_DEPTH) + 1, 0x9F, TOO_DEEP) && ok
    // Every code has its own sentence.
    for code in 1..=12:
        ok = #expect(message(i32(code)) != message(0), "code ", code, " has no message") && ok
    return 0 if ok else 1
