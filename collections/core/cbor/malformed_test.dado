@test
// RFC 8949 Appendix F.1, every example of bytes that are not well-formed,
// each failing with the code for its kind of error, through `well_formed`
// and through a reader's `skip`, which must not move. Then the depth limit,
// trailing bytes and empty input.
package cbor

private type Case: (string8 hex, Error code)

private const [104]Case CASES = [
    // End of input in a head.
    ("18", Error.TRUNCATED), ("19", Error.TRUNCATED), ("1a", Error.TRUNCATED), ("1b", Error.TRUNCATED),
    ("1901", Error.TRUNCATED), ("1a0102", Error.TRUNCATED), ("1b01020304050607", Error.TRUNCATED),
    ("38", Error.TRUNCATED), ("58", Error.TRUNCATED), ("78", Error.TRUNCATED), ("98", Error.TRUNCATED),
    ("9a01ff00", Error.TRUNCATED), ("b8", Error.TRUNCATED), ("d8", Error.TRUNCATED), ("f8", Error.TRUNCATED),
    ("f900", Error.TRUNCATED), ("fa0000", Error.TRUNCATED), ("fb000000", Error.TRUNCATED),
    // Definite-length strings with short data.
    ("41", Error.TRUNCATED), ("61", Error.TRUNCATED), ("5affffffff00", Error.TRUNCATED),
    ("5bffffffffffffffff010203", Error.TRUNCATED), ("7affffffff00", Error.TRUNCATED),
    ("7b7fffffffffffffff010203", Error.TRUNCATED),
    // Definite-length maps and arrays not closed with enough items.
    ("81", Error.TRUNCATED), ("818181818181818181", Error.TRUNCATED), ("8200", Error.TRUNCATED),
    ("a1", Error.TRUNCATED), ("a20102", Error.TRUNCATED), ("a100", Error.TRUNCATED), ("a2000000", Error.TRUNCATED),
    // A tag number with no content.
    ("c0", Error.TRUNCATED),
    // Indefinite-length strings, maps and arrays not closed by a break.
    ("5f4100", Error.TRUNCATED), ("7f6100", Error.TRUNCATED),
    ("9f", Error.TRUNCATED), ("9f0102", Error.TRUNCATED), ("bf", Error.TRUNCATED), ("bf01020102", Error.TRUNCATED),
    ("819f", Error.TRUNCATED), ("9f8000", Error.TRUNCATED), ("9f9f9f9f9fffffffff", Error.TRUNCATED),
    ("9f819f819f9fffffff", Error.TRUNCATED),
    // Reserved additional information.
    ("1c", Error.RESERVED), ("1d", Error.RESERVED), ("1e", Error.RESERVED), ("3c", Error.RESERVED), ("3d", Error.RESERVED),
    ("3e", Error.RESERVED), ("5c", Error.RESERVED), ("5d", Error.RESERVED), ("5e", Error.RESERVED), ("7c", Error.RESERVED),
    ("7d", Error.RESERVED), ("7e", Error.RESERVED), ("9c", Error.RESERVED), ("9d", Error.RESERVED), ("9e", Error.RESERVED),
    ("bc", Error.RESERVED), ("bd", Error.RESERVED), ("be", Error.RESERVED), ("dc", Error.RESERVED), ("dd", Error.RESERVED),
    ("de", Error.RESERVED), ("fc", Error.RESERVED), ("fd", Error.RESERVED), ("fe", Error.RESERVED),
    // Reserved two-byte simple values.
    ("f800", Error.RESERVED), ("f801", Error.RESERVED), ("f818", Error.RESERVED), ("f81f", Error.RESERVED),
    // Indefinite-length string pieces of the wrong type, or not definite.
    ("5f00ff", Error.BAD_CHUNK), ("5f21ff", Error.BAD_CHUNK), ("5f6100ff", Error.BAD_CHUNK), ("5f80ff", Error.BAD_CHUNK),
    ("5fa0ff", Error.BAD_CHUNK), ("5fc000ff", Error.BAD_CHUNK), ("5fe0ff", Error.BAD_CHUNK), ("7f4100ff", Error.BAD_CHUNK),
    ("5f5f4100ffff", Error.BAD_CHUNK), ("7f7f6100ffff", Error.BAD_CHUNK),
    // A break on its own, in a definite-length item, or in a value position.
    ("ff", Error.BAD_BREAK), ("81ff", Error.BAD_BREAK), ("8200ff", Error.BAD_BREAK), ("a1ff", Error.BAD_BREAK),
    ("a1ff00", Error.BAD_BREAK), ("a100ff", Error.BAD_BREAK), ("a20000ff", Error.BAD_BREAK), ("9f81ff", Error.BAD_BREAK),
    ("9f829f819f9fffffffff", Error.BAD_BREAK), ("bf00ff", Error.BAD_BREAK), ("bf000000ff", Error.BAD_BREAK),
    // Additional information 31 where there is no indefinite form.
    ("1f", Error.RESERVED), ("3f", Error.RESERVED), ("df", Error.RESERVED),
    // Not Appendix F: bytes after the item, and nothing at all.
    ("0000", Error.TRAILING), ("", Error.TRUNCATED), ("8000", Error.TRAILING),
    // A huge count is caught before any item is walked.
    ("9bffffffffffffffff00", Error.TRUNCATED), ("bbffffffffffffffff0000", Error.TRUNCATED),
    ("5f40ff", NONE), ("7fff", NONE), ("bf6161f5ff", NONE), ("c0c0c000", NONE), ("f820", NONE),
]

private i32 nibble(char8 c):
    if c >= '0' && c <= '9':
        return i32(c - '0')
    return i32(c - 'a') + 10

private ref []u8 unhex(string8 s):
    ref []u8 out = #make([]u8, #len(s) / 2)
    for i in 0..<(#len(s) / 2):
        out[i] = u8(nibble(s[2 * i]) * 16 + nibble(s[2 * i + 1]))
    return out

private Error code_of([]u8 b):
    try well_formed(b) else code:
        return code
    return NONE

private bool case_ok(Case c):
    ref []u8 b = unhex(c.hex)
    defer #delete(b)
    Error got = code_of(b[:])
    bool ok = #expect(got == c.code, c.hex, ": failed with ", got, " (", message(got), "), not ", c.code)
    if c.code == Error.TRAILING:
        return ok
    Reader r = reader(b[:])
    Error skipped = NONE
    try r.skip() else code:
        skipped = code
    ok = #expect(skipped == c.code, c.hex, ": skip failed with ", skipped, ", not ", c.code) && ok
    if skipped != NONE:
        ok = #expect(r.at == 0, c.hex, ": a failed skip moved the reader to ", r.at) && ok
        // So does a failed diagnose, which never renders a bad item.
        try ref []char8 text = r.diagnose() else:
            return ok
        #delete(text)
        ok = #expect(false, c.hex, ": diagnosed a malformed item") && ok
    return ok

// `n` arrays of one, each inside the last, around a 0; or `n` tags.
private ref []u8 nested(i64 n, u8 head):
    ref []u8 out = #make([]u8, n + 1)
    for i in 0..<n:
        out[i] = head
    out[n] = 0
    return out

private bool depth_ok(i64 n, u8 head, Error want):
    ref []u8 b = nested(n, head)
    defer #delete(b)
    Error got = code_of(b[:])
    return #expect(got == want, n, " deep (", head, "): code ", got, ", not ", want)

i32 test():
    bool ok = true
    for c in CASES:
        ok = case_ok(c) && ok
    ok = depth_ok(i64(MAX_DEPTH), 0x81, NONE) && ok
    ok = depth_ok(i64(MAX_DEPTH) + 1, 0x81, Error.TOO_DEEP) && ok
    ok = depth_ok(i64(MAX_DEPTH), 0xC0, NONE) && ok
    ok = depth_ok(i64(MAX_DEPTH) + 1, 0xC0, Error.TOO_DEEP) && ok
    ok = depth_ok(i64(MAX_DEPTH), 0x9F, Error.TRUNCATED) && ok
    ok = depth_ok(i64(MAX_DEPTH) + 1, 0x9F, Error.TOO_DEEP) && ok
    // Every code has its own sentence, in cbor's range, 1200 to 1299.
    for code in 1200..=1211:
        ok = #expect(message(Error(code)) != message(NONE), "code ", code, " has no message") && ok
    ok = #expect(i32(Error.TRUNCATED) == 1200 && i32(Error.CHUNKED) == 1211, "the codes are 1200 to 1211") && ok
    return 0 if ok else 1
