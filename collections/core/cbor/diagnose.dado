// Diagnostic notation (RFC 8949 section 8): an item as text, for tests and
// debugging.
//
// Integers are written in decimal, byte strings as h'hex', and text in
// double quotes with JSON's escapes: every other character outside printable
// ASCII as \u, and a byte that is not UTF-8 as U+FFFD. Floats are written as ECMAScript
// writes numbers, with `.0` added where it writes no point. An
// indefinite-length item is marked `_`, and a tag is `n(item)`. Bignums
// (tags 2 and 3) stay tags.
package cbor

import "core:fmt"

private type Out: ref []char8

// `item`, known well-formed, rendered into a new run on `#default`.
private !ref([]char8) render([]u8 item):
    Out out = #make([]char8, 0)
    if out == nil:
        fail NO_MEMORY
    _ = #reserve(out, 2 * #len(item) + 8)
    try i64 _ = render_item(item, 0, &out) else code:
        #delete(out)
        fail code
    return out

// Appends the item at `d[at]`, known to be well-formed, to `out^` in
// diagnostic notation, and answers where the item ends. Fails with
// `NO_MEMORY`.
private !i64 render_item([]u8 d, i64 at, ^Out out):
    try Head h = read_head(d, at)
    i64 p = h.next
    bool indef = h.info == INDEFINITE
    if h.major == MAJOR_UNSIGNED:
        try put_u64(out, h.arg)
    else if h.major == MAJOR_NEGATIVE:
        try put(out, "-")
        if h.arg == 0xFFFFFFFFFFFFFFFF:
            try put(out, "18446744073709551616")
        else:
            try put_u64(out, h.arg + 1)
    else if h.major == MAJOR_BYTES || h.major == MAJOR_TEXT:
        if !indef:
            try put_string(out, h.major, d[p..<(p + i64(h.arg))])
            p += i64(h.arg)
        else:
            try put(out, "(_ ")
            bool first = true
            for d[p] != BREAK:
                if !first:
                    try put(out, ", ")
                first = false
                try Head c = read_head(d, p)
                try put_string(out, h.major, d[c.next..<(c.next + i64(c.arg))])
                p = c.next + i64(c.arg)
            try put(out, ")")
            p += 1
    else if h.major == MAJOR_ARRAY || h.major == MAJOR_MAP:
        bool is_map = h.major == MAJOR_MAP
        try put(out, "{" if is_map else "[")
        if indef:
            try put(out, "_ ")
        u64 i = 0
        for (indef && d[p] != BREAK) || (!indef && i < h.arg):
            if i > 0:
                try put(out, ", ")
            try p = render_item(d, p, out)
            if is_map:
                try put(out, ": ")
                try p = render_item(d, p, out)
            i += 1
        if indef:
            p += 1
        try put(out, "}" if is_map else "]")
    else if h.major == MAJOR_TAG:
        try put_u64(out, h.arg)
        try put(out, "(")
        try p = render_item(d, p, out)
        try put(out, ")")
    else if h.info == 20:
        try put(out, "false")
    else if h.info == 21:
        try put(out, "true")
    else if h.info == 22:
        try put(out, "null")
    else if h.info == 23:
        try put(out, "undefined")
    else if h.info >= 25 && h.info <= 27:
        try put_float(out, float_of(h))
    else:
        try put(out, "simple(")
        try put_u64(out, h.arg)
        try put(out, ")")
    return p

// Appends `s` to `out^`, or fails with `NO_MEMORY`.
private !void put(^Out out, string8 s):
    if !#reserve(out^, #len(out^) + #len(s)):
        fail NO_MEMORY
    for c in s:
        _ = #append(out^, c)

// Appends `c` to `out^`, or fails with `NO_MEMORY`.
private !void put_char(^Out out, char8 c):
    if !#append(out^, c):
        fail NO_MEMORY

// Appends `v` in decimal to `out^`, or fails with `NO_MEMORY`.
private !void put_u64(^Out out, u64 v):
    [20]char8 buf
    i32 n = fmt.render_unsigned(v, buf[:])
    try put(out, string8(buf[0..<i64(n)]))

private const string8 HEX = "0123456789abcdef"

// Appends `v`'s low 16 bits as a `\uXXXX` escape to `out^`, or fails with
// `NO_MEMORY`.
private !void put_hex4(^Out out, u32 v):
    try put(out, "\\u")
    for i in 0..<4:
        try put_char(out, HEX[i64((v >> u32(12 - 4 * i)) & 15)])

// Appends the string `s` of major type `major` to `out^`: a byte string as
// h'hex', a text string quoted and escaped. Fails with `NO_MEMORY`.
private !void put_string(^Out out, u8 major, []u8 s):
    if major == MAJOR_BYTES:
        try put(out, "h'")
        for b in s:
            try put_char(out, HEX[i64(b >> 4)])
            try put_char(out, HEX[i64(b & 15)])
        try put(out, "'")
        return
    try put_char(out, '"')
    i64 i = 0
    for i < #len(s):
        (u32 cp, i64 size) = utf8_at(s, i)
        i += size
        if cp == u32('"'):
            try put(out, "\\\"")
        else if cp == u32('\\'):
            try put(out, "\\\\")
        else if cp == u32('\n'):
            try put(out, "\\n")
        else if cp == u32('\r'):
            try put(out, "\\r")
        else if cp == u32('\t'):
            try put(out, "\\t")
        else if cp >= 0x20 && cp < 0x7F:
            try put_char(out, char8(cp))
        else if cp >= 0x10000:
            u32 v = cp - 0x10000
            try put_hex4(out, 0xD800 + (v >> 10))
            try put_hex4(out, 0xDC00 + (v & 0x3FF))
        else:
            try put_hex4(out, cp)
    try put_char(out, '"')

// The code point at `s[at]` and its length; U+FFFD and 1 for a byte that
// does not start a well-formed sequence.
private (u32 cp, i64 size) utf8_at([]u8 s, i64 at):
    u32 b0 = u32(s[at])
    if b0 < 0x80:
        return (b0, 1)
    i64 need = 0
    u32 cp = 0
    u32 min = 0
    if b0 >= 0xC2 && b0 < 0xE0:
        need = 1
        cp = b0 & 0x1F
        min = 0x80
    else if b0 >= 0xE0 && b0 < 0xF0:
        need = 2
        cp = b0 & 0x0F
        min = 0x800
    else if b0 >= 0xF0 && b0 < 0xF5:
        need = 3
        cp = b0 & 0x07
        min = 0x10000
    else:
        return (0xFFFD, 1)
    if at + need >= #len(s):
        return (0xFFFD, 1)
    for k in 1..=need:
        u32 b = u32(s[at + k])
        if b & 0xC0 != 0x80:
            return (0xFFFD, 1)
        cp = (cp << 6) | (b & 0x3F)
    if cp < min || cp > 0x10FFFF || (cp >= 0xD800 && cp < 0xE000):
        return (0xFFFD, 1)
    return (cp, need + 1)

// `v` as ECMAScript's Number#toString writes it, with `.0` added where it
// writes no point: plain from 1e-6 up to 1e21, exponent form outside.
private !void put_float(^Out out, f64 v):
    if v != v:
        try put(out, "NaN")
        return
    if v > 1.7976931348623157e308:
        try put(out, "Infinity")
        return
    if v < -1.7976931348623157e308:
        try put(out, "-Infinity")
        return
    // Shortest round-trip digits, in Python's layout, rewritten.
    [24]char8 buf
    i32 n = fmt.render_float_shortest(v, buf[:])
    string8 repr = string8(buf[0..<i64(n)])
    [24]char8 digits
    i64 nd = 0
    i64 dp = 0
    bool seen_point = false
    i64 exp = 0
    bool neg = false
    i64 i = 0
    if repr[0] == '-':
        neg = true
        i = 1
    for i < #len(repr):
        char8 ch = repr[i]
        if ch == '.':
            seen_point = true
        else if ch == 'e':
            i64 sign = 1
            i += 1
            if repr[i] == '-':
                sign = -1
            i += 1
            for i < #len(repr):
                exp = exp * 10 + i64(repr[i] - '0')
                i += 1
            exp *= sign
            break
        else:
            if nd > 0 || ch != '0':
                digits[nd] = ch
                nd += 1
                if !seen_point:
                    dp += 1
            else if seen_point:
                dp -= 1
        i += 1
    for nd > 1 && digits[nd - 1] == '0':
        nd -= 1
    if neg:
        try put_char(out, '-')
    if nd == 0:
        try put(out, "0.0")
        return
    dp += exp
    if dp > -6 && dp <= 21:
        if dp <= 0:
            try put(out, "0.")
            for _k in 0..<(-dp):
                try put_char(out, '0')
            for k in 0..<nd:
                try put_char(out, digits[k])
        else if dp >= nd:
            for k in 0..<nd:
                try put_char(out, digits[k])
            for _k in nd..<dp:
                try put_char(out, '0')
            try put(out, ".0")
        else:
            for k in 0..<nd:
                if k == dp:
                    try put_char(out, '.')
                try put_char(out, digits[k])
        return
    try put_char(out, digits[0])
    try put_char(out, '.')
    if nd == 1:
        try put_char(out, '0')
    for k in 1..<nd:
        try put_char(out, digits[k])
    try put(out, "e+" if dp - 1 > 0 else "e-")
    i64 e = dp - 1 if dp - 1 > 0 else 1 - dp
    try put_u64(out, u64(e))
