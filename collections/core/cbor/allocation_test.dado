@test
// Where the package's memory goes: every new run lands on the `#default` the
// caller chose with `using`, and a copy of a string in pieces is one run of
// exactly its length, whatever the pieces.
package cbor

import "core:mem/arena"
import "core:mem/libc"

i32 test():
    bool ok = true

    // A string in three pieces, an empty one, and an empty string in pieces.
    [16]u8 enc = [0x7F, 0x61, 0x61, 0x62, 0x62, 0x62, 0x60, 0xFF, 0x60, 0x5F, 0xFF, 0x43, 1, 2, 3, 0]
    Reader r = reader(enc[0..<15])
    ref []char8 t
    try t = r.text_copy() else code:
        t = nil
        ok = #expect(false, "text_copy failed: ", message(code)) && ok
    ok = #expect(t != nil && string8(t[:]) == "abb" && #cap(t) == 3, "text_copy of three pieces") && ok
    #delete(t)
    ref []char8 empty
    try empty = r.text_copy() else code:
        empty = nil
        ok = #expect(false, "text_copy of an empty string failed: ", message(code)) && ok
    ok = #expect(#len(empty) == 0, "text_copy of an empty string held ", #len(empty)) && ok
    #delete(empty)
    ref []u8 none
    try none = r.bytes_copy() else code:
        ok = #expect(false, "bytes_copy of an empty string in pieces failed: ", message(code)) && ok
    ok = #expect(#len(none) == 0, "bytes_copy of no pieces held ", #len(none)) && ok
    #delete(none)
    ref []u8 three
    try three = r.bytes_copy() else code:
        ok = #expect(false, "bytes_copy of a definite string failed: ", message(code)) && ok
    ok = #expect(#len(three) == 3 && three[2] == 3 && r.done(), "bytes_copy of a definite string") && ok
    #delete(three)

    // A failed copy leaves the reader where it was and allocates nothing
    // the caller must free.
    [4]u8 bad = [0x7F, 0x41, 0x00, 0xFF]
    Reader br = reader(bad[:])
    i32 code = 0
    try _ = br.text_copy() else c:
        code = c
    ok = #expect(code == BAD_CHUNK && br.at == 0, "text_copy of a byte piece in text: code ", code, " at ", br.at) && ok
    code = 0
    try _ = br.bytes_copy() else c:
        code = c
    ok = #expect(code == WRONG_TYPE && br.at == 0, "bytes_copy of text: code ", code) && ok

    // Under `using`, the writer's bytes and every copy land in the arena.
    // Nothing made there is deleted; the arena is destroyed at the end.
    arena.Arena home = arena.over(libc.allocator())
    u64 empty_arena = arena.used(home)
    Writer control = writer()
    control.text("x")
    control.destroy()
    ok = #expect(arena.used(home) == empty_arena, "a writer with no `using` spent the arena") && ok

    Writer w = writer() using arena.allocator(&home)
    u64 made = arena.used(home)
    ok = #expect(made > empty_arena, "a writer made under `using` did not reserve in the arena") && ok
    w.array(200)
    for i in 0..<200:
        w.text("grows past the first reservation")
    ok = #expect(arena.used(home) > made, "a writer made under `using` grew somewhere else") && ok
    ref []u8 doc
    try doc = w.finish() else code:
        ok = #expect(false, "the arena writer failed: ", message(code)) && ok
    u64 before = arena.used(home)
    Reader ar = reader(doc[:])
    ref []char8 d
    try d = ar.diagnose() using arena.allocator(&home) else code:
        ok = #expect(false, "diagnose failed: ", message(code)) && ok
    ok = #expect(#len(d) > 0 && arena.used(home) > before, "diagnose under `using` did not land in the arena") && ok
    arena.destroy(&home)
    return 0 if ok else 1
