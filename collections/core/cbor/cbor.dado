// core:cbor — CBOR (RFC 8949): an append writer, a pull reader, and
// diagnostic notation.
//
// **Tier N W H. Script class S.** Pure Dado over `core:chars`, `core:fmt`
// and `core:slices`: no `foreign` block and no state, so it builds and runs
// freestanding, on the web and hosted, and any thread may use it.
//
// **What raises into a script.** Everything: every function and every
// method of `Writer` and `Reader`, each promised by the `#assert_raises` on
// the line above it.
//
//     cbor.Writer w = cbor.writer()
//     w.map(2)
//     w.text("name")
//     w.text("oak")
//     w.text("size")
//     w.array(2)
//     w.uint(600)
//     w.float(18.5)
//     try ref []u8 bytes = w.finish() else code:
//         ...
//     defer #delete(bytes)
//
//     cbor.Reader r = cbor.reader(bytes[:])
//     try cbor.Container m = r.map()
//     for r.more(&m):
//         try string8 key = r.text()
//         try r.skip()
//
// The writer writes definite lengths only, every head in its shortest form,
// and each `float` in the narrowest width that holds it exactly (RFC 8949's
// preferred serialization). Map keys go out in the order they are written;
// `sort_map` puts a finished map in the deterministic order. The bytes grow
// on the allocator that was `#default` when `writer` was called.
//
// The reader allocates nothing except in `bytes_copy`, `text_copy` and
// `diagnose`. The strings it answers are views into the input. It reads
// indefinite lengths too, and malformed input fails with a code and leaves
// the reader where it was.
//
// The common tags have verbs of their own: `date_time` (tag 0, RFC 3339
// text), `epoch` and `epoch_float` (tag 1, seconds since 1970), and
// `bignum` and `negative_bignum` (tags 2 and 3, big-endian bytes), on the
// writer and the reader both. Any other tag is `tag(number)` and then its
// content.
//
// **Error codes: `Error`, 1200 to 1299**, a range no other package's codes
// share; `message(why)` answers a sentence for each.
package cbor

// Why a read or a write failed. The numbers are this package's, 1200 to
// 1299, apart from every other package's, so a code read anywhere never means
// two things.
distinct enum i32 Error:
    // The input ends inside an item, or a length runs past the input.
    TRUNCATED = 1200,
    // Additional information 28 to 30; 31 on a major type with no indefinite
    // form; or a two-byte simple value below 32.
    RESERVED,
    // A break outside an indefinite-length item, or in a map's value
    // position.
    BAD_BREAK,
    // A piece of an indefinite-length string is not a definite string of the
    // same major type.
    BAD_CHUNK,
    // Items nest deeper than `MAX_DEPTH`.
    TOO_DEEP,
    // The item is not of the type the read asked for.
    WRONG_TYPE,
    // The integer does not fit the type the read answers.
    OVERFLOW,
    // An allocation failed.
    NO_MEMORY,
    // `Writer.sort_map` found two equal keys.
    DUPLICATE_KEY,
    // `Writer.simple` was given 24 to 31, which have no encoding.
    BAD_SIMPLE,
    // Bytes follow the one item expected.
    TRAILING,
    // `Reader.bytes` or `Reader.text` met an indefinite-length string, which
    // has no single view: read it with `chunks`, `bytes_copy` or `text_copy`.
    CHUNKED,

// How deep arrays, maps, tags and indefinite-length strings may nest before
// `skip`, `well_formed` and `diagnose` fail with `TOO_DEEP`.
const i32 MAX_DEPTH = 128

// The self-describe tag's number. Its head, the bytes d9 d9 f7, marks what
// follows as CBOR.
const u64 SELF_DESCRIBE = 55799

// Tag 0: the content is a date and time as RFC 3339 text.
// `Writer.date_time` and `Reader.date_time` write and read one.
const u64 TAG_DATE_TIME = 0

// Tag 1: the content is seconds since 1970-01-01T00:00Z, an integer or a
// float. `Writer.epoch`, `Writer.epoch_float` and `Reader.epoch`.
const u64 TAG_EPOCH = 1

// Tag 2: the content is a byte string holding an unsigned integer, big-endian.
// `Writer.bignum` and `Reader.bignum`.
const u64 TAG_BIGNUM = 2

// Tag 3: the content is a byte string holding `n`, big-endian, of the
// negative integer `-1 - n`. `Writer.negative_bignum` and `Reader.bignum`.
const u64 TAG_NEGATIVE_BIGNUM = 3

// A sentence describing `why`; any value that is not a member answers "not
// a code of core:cbor".
#assert_raises
string8 message(Error why):
    switch why:
        case Error.TRUNCATED:
            return "the input ends inside an item"
        case Error.RESERVED:
            return "a reserved or invalid additional-information value"
        case Error.BAD_BREAK:
            return "a break where no indefinite-length item can end"
        case Error.BAD_CHUNK:
            return "an indefinite-length string holds a piece that is not a definite string of its type"
        case Error.TOO_DEEP:
            return "items nest deeper than MAX_DEPTH"
        case Error.WRONG_TYPE:
            return "the item is not of the type asked for"
        case Error.OVERFLOW:
            return "the integer does not fit"
        case Error.NO_MEMORY:
            return "an allocation failed"
        case Error.DUPLICATE_KEY:
            return "a map holds two equal keys"
        case Error.BAD_SIMPLE:
            return "simple values 24 to 31 have no encoding"
        case Error.TRAILING:
            return "bytes follow the item"
        case Error.CHUNKED:
            return "the string is indefinite-length: read it in chunks or as a copy"
        else:
            return "not a code of core:cbor"

// ── inside ────────────────────────────────────────────────────────────────

private const u8 MAJOR_UNSIGNED = 0
private const u8 MAJOR_NEGATIVE = 1
private const u8 MAJOR_BYTES = 2
private const u8 MAJOR_TEXT = 3
private const u8 MAJOR_ARRAY = 4
private const u8 MAJOR_MAP = 5
private const u8 MAJOR_TAG = 6
private const u8 MAJOR_SIMPLE = 7

private const u8 INDEFINITE = 31
private const u8 BREAK = 0xFF

private cunion Bits64: (f64 f, u64 u)
private cunion Bits32: (f32 f, u32 u)

// No failure yet: the zero code, which is no member. A writer's `code`
// answers it until a write fails.
private const Error NONE = Error(0)

// Text's bytes, as a `[]u8` window: `Bytes(s)` views a `string8` without a
// copy (`[]u8(s)` written in place would read as a function type).
private type Bytes: []u8
