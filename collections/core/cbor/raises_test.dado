@test
// What raises into a script. `#assert_raises` stands only above a
// package-level function, so the methods of `Writer` and `Reader` cannot
// carry it themselves: each promised function here calls a group of them,
// and the build refuses (ERR1227) if any reaches something a script cannot
// run. One is left out, for the reason its comment gives.
package cbor

#assert_raises
private !void writes():
    [2]u8 b = [1, 2]
    Writer w = writer(8)
    w.uint(1)
    w.int(-1)
    w.negative(3)
    w.bytes(b[:])
    w.text("a")
    w.array(1)
    w.tag(1)
    w.self_describe()
    w.boolean(true)
    w.null()
    w.undefined()
    w.simple(16)
    w.float(1.5)
    w.float32(f32(1.5))
    w.float64(1.5)
    w.raw(b[:])
    i64 at = w.mark()
    w.map(0)
    w.sort_map(at)
    _ = w.data()
    _ = w.code()
    try ref []u8 out = w.finish()
    #delete(out)
    w.destroy()

#assert_raises
private !bool reads([]u8 data):
    Reader r = reader(data)
    _ = r.self_described()
    _ = r.done()
    try _ = r.kind()
    try _ = r.uint()
    try _ = r.int()
    try _ = r.negative()
    try _ = r.bytes()
    try _ = r.tag()
    try _ = r.boolean()
    try r.null()
    try r.undefined()
    try _ = r.simple()
    try _ = r.float()
    try r.skip()
    try Container a = r.array()
    for r.more(&a):
        try r.skip()
    try Container m = r.map()
    for r.more(&m):
        try r.skip()
        try r.skip()
    try Container c = r.chunks()
    for r.more(&c):
        try _ = r.chunk(&c)
    try ref []u8 b = r.bytes_copy()
    #delete(b)
    try ref []char8 t = r.text_copy()
    #delete(t)
    try ref []char8 d = r.diagnose()
    #delete(d)
    return r.done()

// Not promised: `Reader.text` answers its view through a `rawptr`, because
// `[]u8` has no view conversion to `string8` (ERR0504).

i32 test():
    bool ok = true
    try writes() else code:
        ok = #expect(false, "the writes failed: ", message(code)) && ok
    // Every read above, in order, over one item each.
    [37]u8 enc = [0xD9, 0xD9, 0xF7, 0x01, 0x20, 0x20, 0x41, 0x07, 0xC1, 0xF5, 0xF6, 0xF7,
                  0xF0, 0xF9, 0x3C, 0x00, 0x00, 0x82, 0x01, 0x02, 0xA1, 0x01, 0x02, 0x5F,
                  0x41, 0x01, 0xFF, 0x42, 0x01, 0x02, 0x7F, 0x61, 0x61, 0xFF, 0xF9, 0x3E, 0x00]
    bool all
    try all = reads(enc[:]) else code:
        all = #expect(false, "the reads failed: ", message(code))
    ok = #expect(all, "the reads did not end at the end") && ok
    return 0 if ok else 1
