@test
// The failure paths and calls the other tests do not reach: a writer whose
// allocator runs out, `raw`, a tag's number, `chunk` and `chunks` refusing
// what they cannot read, and `message` for a value that is no code.
package cbor

import "core:mem/bump"

i32 test():
    bool ok = true

    // An allocator with room for nothing: the writer's first reservation
    // fails, every write after it does nothing, and `finish` says why.
    [16]u8 tiny
    bump.Arena none = bump.over(rawptr(&tiny), 0)
    Writer starved = writer() using bump.allocator(&none)
    ok = #expect(starved.code() == NO_MEMORY, "a writer with no memory has code ", starved.code()) && ok
    starved.uint(1)
    i32 code = 0
    try _ = starved.finish() else c:
        code = c
    ok = #expect(code == NO_MEMORY, "finish of a starved writer failed with ", code) && ok

    // Room for the first reservation and no more: the write that outgrows
    // it fails, and the bytes before it are kept until `finish` frees them.
    [64]u8 small
    bump.Arena some = bump.over(rawptr(&small), 64)
    Writer w = writer(4) using bump.allocator(&some)
    w.uint(1)
    w.text("more text than four bytes and more than the arena holds, by a distance")
    []u8 kept = w.data()
    ok = #expect(w.code() == NO_MEMORY && #len(kept) <= 4, "a writer that outgrew its arena: code ", w.code()) && ok
    code = 0
    try _ = w.finish() else c:
        code = c
    ok = #expect(code == NO_MEMORY, "finish after running out failed with ", code) && ok

    // `raw` appends its bytes unchecked, and a tag reads back its number.
    [3]u8 item = [0x82, 0x01, 0x02]
    Writer rw = writer()
    rw.tag(1000)
    rw.raw(item[:])
    ref []u8 tagged
    try tagged = rw.finish() else c:
        ok = #expect(false, "the tagged writer failed: ", message(c)) && ok
    defer #delete(tagged)
    ok = #expect(#len(tagged) == 6 && tagged[3] == 0x82, "raw did not append its bytes") && ok
    Reader r = reader(tagged[:])
    u64 number = 0
    try number = r.tag() else c:
        ok = #expect(false, "tag failed: ", message(c)) && ok
    ok = #expect(number == 1000 && r.at == 3, "tag read ", number, ", now at ", r.at) && ok
    code = 0
    try _ = r.tag() else c:
        code = c
    ok = #expect(code == WRONG_TYPE && r.at == 3, "tag of an array failed with ", code) && ok

    // `chunks` of something that is no string, and a piece of the wrong
    // major type, each leave the reader where it was.
    code = 0
    try _ = r.chunks() else c:
        code = c
    ok = #expect(code == WRONG_TYPE && r.at == 3, "chunks of an array failed with ", code) && ok
    [5]u8 mixed = [0x5F, 0x61, 0x61, 0xFF, 0x00]
    Reader mr = reader(mixed[0..<4])
    Container pieces
    try pieces = mr.chunks() else c:
        ok = #expect(false, "chunks of a byte string failed: ", message(c)) && ok
    ok = #expect(mr.more(&pieces), "an open string in pieces had no piece") && ok
    code = 0
    try _ = mr.chunk(&pieces) else c:
        code = c
    ok = #expect(code == BAD_CHUNK && mr.at == 1, "a text piece in a byte string failed with ", code, " at ", mr.at) && ok

    // The break that ends an indefinite-length item is a kind of its own,
    // and no read takes it as an item.
    [2]u8 brk = [0xFF, 0x00]
    Reader b = reader(brk[0..<1])
    Kind k = Kind.Unsigned
    try k = b.kind() else c:
        ok = #expect(false, "kind of a break failed: ", message(c)) && ok
    ok = #expect(k == Kind.Break, "a break is not Kind.Break") && ok
    code = 0
    try b.skip() else c:
        code = c
    ok = #expect(code == BAD_BREAK && b.at == 0, "skip of a lone break failed with ", code) && ok

    ok = #expect(message(0) == message(99) && message(-1) == message(99), "a value that is no code has its own sentence") && ok
    return 0 if ok else 1
