// The response: a status, headers and a body, made by one call and adjusted by
// chaining.
//
//     return server.html("<h1>hello</h1>")
//     return server.json("{\"ok\": true}", 201)
//     return server.text("gone").with_status(410).with_header("cache-control", "no-store")
//     return server.redirect("/login")
//
// A response is a value: the helpers make one, `with_*` answers an adjusted
// copy, and the server serializes whatever the handler returns. Its body is a
// view — a literal, or something the handler built on `#default`, which in a
// running server is the request's frame and lives until the response is sent.
package server

import "core:strings"

type Response:
    i32 status
    ref []Header headers
    string8 body

    // A copy with `name: value` added. Headers are sent in the order added,
    // and adding one that is already there adds a second.
    Response with_header(self, string8 name, string8 value):
        Response r = self
        r.headers = copy_headers(self.headers)
        Header pair = (name, value)
        if r.headers != nil:
            _ = #append(r.headers, pair)
        return r

    // A copy with the status changed.
    Response with_status(self, i32 status):
        Response r = self
        r.status = status
        return r

    // The value of the header `name`, matched without regard to case, or "".
    string8 header(self, string8 name):
        for h in self.headers:
            if same_fold(h.name, name):
                return h.value
        return ""

// ── the helpers ─────────────────────────────────────────────────────────────

// A body of `content_type`, sent as given.
Response respond(string8 body, string8 content_type, i32 status = 200):
    Response r
    r.status = status
    r.body = body
    r.headers = #make([]Header, 0)
    Header ct = ("Content-Type", content_type)
    if r.headers != nil:
        _ = #append(r.headers, ct)
    return r

Response text(string8 body, i32 status = 200):
    return respond(body, "text/plain; charset=utf-8", status)

Response html(string8 body, i32 status = 200):
    return respond(body, "text/html; charset=utf-8", status)

// The body is sent as written: this server has no JSON encoder of its own.
Response json(string8 body, i32 status = 200):
    return respond(body, "application/json", status)

// A redirect to `location`: 302 unless asked for another (301, 303, 307, 308).
Response redirect(string8 location, i32 status = 302):
    return text("", status).with_header("Location", location)

// An empty response with only a status — 204, say — or one whose body is the
// status's reason phrase, for an error.
Response status(i32 code):
    if code == 204 || code == 304:
        Response r
        r.status = code
        r.headers = #make([]Header, 0)
        return r
    return text(#format(code, " ", reason(code), "\n"), code)

Response not_found():
    return status(404)

Response bad_request():
    return status(400)

// `s` with `&`, `<`, `>`, `"` and `'` written as HTML's entities, for text from
// a request that goes into a page. Answered as it is when there is nothing to
// escape; otherwise the escaped copy is on `#default`.
string8 escape(string8 s):
    bool plain = true
    for c in s:
        if c == '&' || c == '<' || c == '>' || c == '"' || c == '\'':
            plain = false
    if plain:
        return s
    strings.Builder b = strings.builder(i64(#len(s)) + 16)
    for c in s:
        if c == '&': _ = strings.append(&b, "&amp;")
        else if c == '<': _ = strings.append(&b, "&lt;")
        else if c == '>': _ = strings.append(&b, "&gt;")
        else if c == '"': _ = strings.append(&b, "&quot;")
        else if c == '\'': _ = strings.append(&b, "&#39;")
        else: _ = strings.append_char(&b, c)
    ref []char8 out = strings.finish(&b)
    string8 escaped = out
    return escaped

// ── on the wire ─────────────────────────────────────────────────────────────

// The bytes of `r` as an HTTP/1.1 response, on `#default`: the status line, the
// headers `r` carries, `Content-Length`, `Connection: close` and the body. A
// `head_only` response — the answer to a HEAD — carries the length and no body.
ref []char8 serialize(Response r, bool head_only = false):
    []Header none
    return serialize_with(r, head_only, none)

// `serialize`, with `extra` headers after the response's own — the app's
// `header`s, which every response it sends carries.
ref []char8 serialize_with(Response r, bool head_only, []Header extra):
    strings.Builder b = strings.builder(256 + i64(#len(r.body)))
    _ = strings.append(&b, "HTTP/1.1 ")
    _ = strings.append(&b, #format(r.status, " ", reason(r.status), "\r\n"))
    for h in extra:
        _ = strings.append(&b, h.name)
        _ = strings.append(&b, ": ")
        _ = strings.append(&b, h.value)
        _ = strings.append(&b, "\r\n")
    for h in r.headers:
        _ = strings.append(&b, h.name)
        _ = strings.append(&b, ": ")
        _ = strings.append(&b, h.value)
        _ = strings.append(&b, "\r\n")
    if r.status != 204 && r.status != 304:
        _ = strings.append(&b, #format("Content-Length: ", #len(r.body), "\r\n"))
    _ = strings.append(&b, "Connection: close\r\n\r\n")
    if !head_only:
        _ = strings.append(&b, r.body)
    return strings.finish(&b)

// The reason phrase HTTP gives `code`, or "" for one it does not name.
string8 reason(i32 code):
    switch code:
        case 100: return "Continue"
        case 200: return "OK"
        case 201: return "Created"
        case 202: return "Accepted"
        case 204: return "No Content"
        case 206: return "Partial Content"
        case 301: return "Moved Permanently"
        case 302: return "Found"
        case 303: return "See Other"
        case 304: return "Not Modified"
        case 307: return "Temporary Redirect"
        case 308: return "Permanent Redirect"
        case 400: return "Bad Request"
        case 401: return "Unauthorized"
        case 403: return "Forbidden"
        case 404: return "Not Found"
        case 405: return "Method Not Allowed"
        case 408: return "Request Timeout"
        case 409: return "Conflict"
        case 410: return "Gone"
        case 413: return "Content Too Large"
        case 415: return "Unsupported Media Type"
        case 418: return "I'm a teapot"
        case 422: return "Unprocessable Content"
        case 429: return "Too Many Requests"
        case 431: return "Request Header Fields Too Large"
        case 500: return "Internal Server Error"
        case 501: return "Not Implemented"
        case 502: return "Bad Gateway"
        case 503: return "Service Unavailable"
        else: return ""

private ref []Header copy_headers([]Header from):
    ref []Header out = #make([]Header, 0)
    if out == nil:
        return out
    _ = #reserve(out, #len(from) + 1)
    for h in from:
        _ = #append(out, h)
    return out
