// The request: parsed once from the bytes that arrived, and read through methods.
//
// Every string a `Request` holds is a view into the bytes the server read, so
// parsing allocates nothing and a handler reads `req.path` or
// `req.header("content-type")` for free. What does allocate — a decoded query
// or form value — lands on `#default`, which inside a running server is the
// request's own scratch frame: it is reclaimed when the response has been
// sent, and a handler never frees anything.
package server

import "core:strings"

// One `name: value` pair: a request header, a response header, or a route's
// captured parameter.
type Header: (string8 name, string8 value)

// The most headers a request may carry; one more is answered 431.
const i32 MAX_HEADERS = 100

type Request:
    string8 method              // as sent: "GET", "POST", …
    string8 target              // the request-target, query included
    string8 path                // the target before any `?`
    string8 query_string        // the target after the `?`, undecoded
    string8 version             // "HTTP/1.1"
    ref []Header headers        // in the order sent
    ref []Header params         // what the matched route's `{name}`s captured
    string8 body

    // The value of the header `name`, matched without regard to case, or
    // `fallback` when the request has none.
    string8 header(self, string8 name, string8 fallback = ""):
        for h in self.headers:
            if same_fold(h.name, name):
                return h.value
        return fallback

    bool has_header(self, string8 name):
        for h in self.headers:
            if same_fold(h.name, name):
                return true
        return false

    // What the route's `{name}` captured, or `fallback`. A capture is a view of
    // the path as sent, not decoded.
    string8 param(self, string8 name, string8 fallback = ""):
        for p in self.params:
            if p.name == name:
                return p.value
        return fallback

    // The query parameter `name`, percent-decoded (`+` read as a space), or
    // `fallback`. The first one wins when the name repeats.
    string8 query(self, string8 name, string8 fallback = ""):
        return lookup_encoded(self.query_string, name, fallback)

    bool has_query(self, string8 name):
        return has_encoded(self.query_string, name)

    // A field of an `application/x-www-form-urlencoded` body, decoded as
    // `query` decodes, or `fallback`.
    string8 form(self, string8 name, string8 fallback = ""):
        return lookup_encoded(self.body, name, fallback)

    // Whether the request's method is `method`, which is case-sensitive as
    // HTTP's methods are.
    bool is(self, string8 method):
        return self.method == method

// ── parsing ──────────────────────────────────────────────────────────────────

// How a parse ended: `Done`, `Partial` (the headers have not all arrived, or
// the body is shorter than its `Content-Length`), or an HTTP status to answer.
const i32 PARSE_DONE    = 0
const i32 PARSE_PARTIAL = 1

// Parse one request from `raw`. Answers the request and `PARSE_DONE`, or
// `PARSE_PARTIAL` while more bytes are owed, or the status a malformed request
// is answered with: 400, 431 (too many headers) or 501 (a chunked body, which
// this server does not read). The request views `raw`, which must outlive it.
(Request req, i32 outcome) parse(string8 raw):
    Request r
    (i64 head_end, bool complete) = find_head_end(raw)
    if !complete:
        return (r, PARSE_PARTIAL)

    string8 head = strings.substring(raw, 0, head_end)
    (string8 line, string8 rest, bool _) = strings.split_first(head, "\r\n")

    // The request line: METHOD SP TARGET SP VERSION.
    (string8 method, string8 after_method, bool m_ok) = strings.split_first(line, " ")
    (string8 target, string8 version, bool t_ok) = strings.split_first(after_method, " ")
    if !m_ok || !t_ok || #len(method) == 0 || #len(target) == 0:
        return (r, 400)
    if !strings.starts_with(version, "HTTP/1."):
        return (r, 400)
    r.headers = #make([]Header, 0)
    r.params = #make([]Header, 0)
    if r.headers == nil || r.params == nil:
        return (r, 500)
    r.method = method
    r.target = target
    r.version = version
    (string8 path, string8 qs, bool has_q) = strings.split_first(target, "?")
    r.path = path
    r.query_string = qs if has_q else ""

    // The headers, one per line, until the head ends.
    string8 lines = rest
    for #len(lines) > 0:
        (string8 h, string8 more, bool _) = strings.split_first(lines, "\r\n")
        lines = more
        if #len(h) == 0:
            continue
        (string8 name, string8 value, bool colon) = strings.split_first(h, ":")
        if !colon || #len(name) == 0:
            return (r, 400)
        if #len(r.headers) == MAX_HEADERS:
            return (r, 431)
        Header pair = (name, strings.trim(value))
        if !#append(r.headers, pair):
            return (r, 500)

    if same_fold(r.header("transfer-encoding"), "chunked"):
        return (r, 501)

    // The body: exactly `Content-Length` bytes after the head.
    i64 length = 0
    string8 cl = r.header("content-length")
    if #len(cl) > 0:
        (i64 n, bool ok) = parse_count(cl)
        if !ok:
            return (r, 400)
        length = n
    i64 body_at = head_end + 4
    if i64(#len(raw)) - body_at < length:
        return (r, PARSE_PARTIAL)
    r.body = strings.substring(raw, body_at, length)
    return (r, PARSE_DONE)

// How many bytes the whole request in `raw` takes, once its head has arrived:
// the head, the blank line and `Content-Length`'s body. `ok` is false while the
// head is incomplete or the length is malformed.
(i64 total, bool ok) expected_size(string8 raw):
    (i64 head_end, bool complete) = find_head_end(raw)
    if !complete:
        return (0, false)
    string8 head = strings.substring(raw, 0, head_end)
    string8 lines = head
    for #len(lines) > 0:
        (string8 h, string8 more, bool _) = strings.split_first(lines, "\r\n")
        lines = more
        (string8 name, string8 value, bool colon) = strings.split_first(h, ":")
        if colon && same_fold(name, "content-length"):
            (i64 n, bool ok) = parse_count(strings.trim(value))
            if !ok:
                return (0, false)
            return (head_end + 4 + n, true)
    return (head_end + 4, true)

// Where the head ends: the offset of the `\r\n\r\n` that closes it.
private (i64 at, bool found) find_head_end(string8 raw):
    i64 n = i64(#len(raw))
    i64 i = 0
    for i + 3 < n:
        if raw[i] == '\r' && raw[i + 1] == '\n' && raw[i + 2] == '\r' && raw[i + 3] == '\n':
            return (i, true)
        i = i + 1
    return (0, false)

// A non-negative decimal count, as `Content-Length` writes one.
private (i64 n, bool ok) parse_count(string8 s):
    if #len(s) == 0 || #len(s) > 15:
        return (0, false)
    i64 n = 0
    for c in s:
        if c < '0' || c > '9':
            return (0, false)
        n = n * 10 + i64(c - '0')
    return (n, true)

// ASCII case-insensitive equality: header names are case-insensitive.
bool same_fold(string8 a, string8 b):
    if #len(a) != #len(b):
        return false
    for i in 0..<i64(#len(a)):
        if lower(a[i]) != lower(b[i]):
            return false
    return true

private char8 lower(char8 c):
    return char8(i32(c) + 32) if c >= 'A' && c <= 'Z' else c

// ── `a=1&b=two` ─────────────────────────────────────────────────────────────

private string8 lookup_encoded(string8 pairs, string8 name, string8 fallback):
    string8 rest = pairs
    for #len(rest) > 0:
        (string8 pair, string8 more, bool _) = strings.split_first(rest, "&")
        rest = more
        (string8 key, string8 value, bool _) = strings.split_first(pair, "=")
        if decode(key) == name:
            return decode(value)
    return fallback

private bool has_encoded(string8 pairs, string8 name):
    string8 rest = pairs
    for #len(rest) > 0:
        (string8 pair, string8 more, bool _) = strings.split_first(rest, "&")
        rest = more
        (string8 key, string8 _, bool _) = strings.split_first(pair, "=")
        if decode(key) == name:
            return true
    return false

// Percent-decode `s`, reading `+` as a space. A string with nothing to decode
// is answered as it is, allocating nothing; otherwise the decoded copy is on
// `#default`. A malformed escape is kept as written.
string8 decode(string8 s):
    bool plain = true
    for c in s:
        if c == '%' || c == '+':
            plain = false
    if plain:
        return s
    ref []char8 out = #make([]char8, 0)
    if out == nil:
        return s
    _ = #reserve(out, #len(s))
    i64 n = i64(#len(s))
    i64 i = 0
    for i < n:
        char8 c = s[i]
        if c == '+':
            _ = #append(out, ' ')
            i = i + 1
        else if c == '%' && i + 2 < n && hex(s[i + 1]) >= 0 && hex(s[i + 2]) >= 0:
            _ = #append(out, char8(hex(s[i + 1]) * 16 + hex(s[i + 2])))
            i = i + 3
        else:
            _ = #append(out, c)
            i = i + 1
    string8 decoded = out
    return decoded

private i32 hex(char8 c):
    if c >= '0' && c <= '9':
        return i32(c - '0')
    if c >= 'a' && c <= 'f':
        return i32(c - 'a') + 10
    if c >= 'A' && c <= 'F':
        return i32(c - 'A') + 10
    return 0 - 1
