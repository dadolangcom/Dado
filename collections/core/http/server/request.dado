// The request: parsed once from the bytes that arrived, and read through methods.
//
// Every string a `Request` holds is a view into the bytes the server read, so
// parsing allocates little and a handler reads `req.path` or
// `req.header("content-type")` for free. What does allocate — the header list,
// a chunked body's decoded bytes, a decoded query or form value — lands on
// `#default`, which inside a running server is the request's own scratch
// frame: it is reclaimed when the response has been sent, and a handler never
// frees anything.
package server

import "core:chars"
import "core:http"
import "core:strings"

// One `name: value` pair: a request header, a response header, or a route's
// captured parameter. `core:http`'s `Header` itself, by a qualified alias, so
// the headers a server reads and a client sends are one type.
type Header: http.Header

// The most headers a request may carry; one more is answered 431.
const i32 MAX_HEADERS = 100

// One parsed request. Its strings view the bytes it was parsed from.
type Request:
    string8 method              // as sent: "GET", "POST", …
    string8 target              // the request-target, query included
    string8 path                // the target before any `?`
    string8 query_string        // the target after the `?`, undecoded
    string8 version             // "HTTP/1.1"
    ref []Header headers        // in the order sent
    ref []Header params         // what the matched route's `{name}`s captured
    string8 body

    // The value of the header `name`, matched without regard to case, or
    // `fallback` when the request has none.
    #assert_raises
    string8 header(self, string8 name, string8 fallback = ""):
        for h in self.headers:
            if strings.equal_fold(h.name, name):
                return h.value
        return fallback

    // Whether the request carries the header `name`, in any case.
    #assert_raises
    bool has_header(self, string8 name):
        for h in self.headers:
            if strings.equal_fold(h.name, name):
                return true
        return false

    // What the route's `{name}` captured, or `fallback`. A capture is a view of
    // the path as sent, not decoded.
    #assert_raises
    string8 param(self, string8 name, string8 fallback = ""):
        for p in self.params:
            if p.name == name:
                return p.value
        return fallback

    // The query parameter `name`, percent-decoded (`+` read as a space), or
    // `fallback`. The first one wins when the name repeats.
    #assert_raises
    string8 query(self, string8 name, string8 fallback = ""):
        return lookup_encoded(self.query_string, name, fallback)

    // Whether the query names `name`, with or without a value.
    #assert_raises
    bool has_query(self, string8 name):
        return has_encoded(self.query_string, name)

    // A field of an `application/x-www-form-urlencoded` body, decoded as
    // `query` decodes, or `fallback`.
    #assert_raises
    string8 form(self, string8 name, string8 fallback = ""):
        return lookup_encoded(self.body, name, fallback)

    // Whether the request's method is `method`, which is case-sensitive as
    // HTTP's methods are.
    #assert_raises
    bool is(self, string8 method):
        return self.method == method

// ── parsing ──────────────────────────────────────────────────────────────────

// The request cannot be served: `status` is what to answer instead — 400 (it
// is malformed), 431 (too many headers), 501 (a transfer coding other than
// chunked), or 500 (an allocation failed).
distinct type Refused: (i32 status)

// What `parse` answers: the request, more bytes owed (`core:http`'s
// `Pending`), or the status a request that cannot be served is answered
// with. A `switch` over it names all three and needs no `else`.
union Parsed: (Request, http.Pending, Refused)

// Parse one request from `raw`. Answers the `Request`, or `http.Pending`
// while more bytes are owed — the head has not all arrived, or the body is
// shorter than its `Content-Length` or its chunks say — or `Refused` with
// the status to answer. A chunked body is decoded onto `#default`;
// otherwise the request views `raw`, which must outlive it.
#assert_raises
Parsed parse(string8 raw):
    Request r
    try http.Extent extent = http.request_end(raw) else:
        return Refused(400)
    i64 end = 0
    switch extent:
        case http.Whole w:
            end = w.length
        case http.Pending pending:
            return pending
        case http.ToClose _:
            return Refused(400)
    try i64 head_end = http.head_end(raw) else:
        return Refused(400)

    string8 head = strings.substring(raw, 0, head_end)
    (string8 line, string8 rest, bool _) = strings.split_first(head, "\r\n")

    // The request line: METHOD SP TARGET SP VERSION.
    (string8 method, string8 after_method, bool m_ok) = strings.split_first(line, " ")
    (string8 target, string8 version, bool t_ok) = strings.split_first(after_method, " ")
    if !m_ok || !t_ok || #len(method) == 0 || #len(target) == 0:
        return Refused(400)
    if !strings.starts_with(version, "HTTP/1."):
        return Refused(400)
    r.headers = #make([]Header, 0)
    r.params = #make([]Header, 0)
    if r.headers == nil || r.params == nil:
        return Refused(500)
    r.method = method
    r.target = target
    r.version = version
    (string8 path, string8 qs, bool has_q) = strings.split_first(target, "?")
    r.path = path
    r.query_string = qs if has_q else ""

    // The headers, one per line, until the head ends.
    string8 lines = rest
    for #len(lines) > 0:
        (string8 h, string8 more, bool _) = strings.split_first(lines, "\r\n")
        lines = more
        if #len(h) == 0:
            continue
        (string8 name, string8 value, bool colon) = strings.split_first(h, ":")
        if !colon || #len(name) == 0:
            return Refused(400)
        if #len(r.headers) == MAX_HEADERS:
            return Refused(431)
        Header pair = (name, strings.trim(value))
        if !#append(r.headers, pair):
            return Refused(500)

    i64 body_at = head_end + 4
    string8 body = strings.substring(raw, body_at, end - body_at)
    string8 coding = r.header("transfer-encoding")
    if #len(coding) > 0:
        if !strings.equal_fold(coding, "chunked"):
            return Refused(501)
        try ref []char8 plain = http.unchunk(body) else why:
            return Refused(400 if why == http.Error.MALFORMED else 500)
        r.body = plain
        return r
    r.body = body
    return r

// ── `a=1&b=two` ─────────────────────────────────────────────────────────────

#assert_raises
private string8 lookup_encoded(string8 pairs, string8 name, string8 fallback):
    string8 rest = pairs
    for #len(rest) > 0:
        (string8 pair, string8 more, bool _) = strings.split_first(rest, "&")
        rest = more
        (string8 key, string8 value, bool _) = strings.split_first(pair, "=")
        if decode(key) == name:
            return decode(value)
    return fallback

#assert_raises
private bool has_encoded(string8 pairs, string8 name):
    string8 rest = pairs
    for #len(rest) > 0:
        (string8 pair, string8 more, bool _) = strings.split_first(rest, "&")
        rest = more
        (string8 key, string8 _, bool _) = strings.split_first(pair, "=")
        if decode(key) == name:
            return true
    return false

// Percent-decode `s`, reading `+` as a space. A string with nothing to decode
// is answered as it is, allocating nothing; otherwise the decoded copy is on
// `#default`. A malformed escape is kept as written.
#assert_raises
string8 decode(string8 s):
    bool plain = true
    for c in s:
        if c == '%' || c == '+':
            plain = false
    if plain:
        return s
    ref []char8 out = #make([]char8, 0)
    if out == nil:
        return s
    _ = #reserve(out, #len(s))
    i64 n = i64(#len(s))
    i64 i = 0
    for i < n:
        char8 c = s[i]
        if c == '+':
            _ = #append(out, ' ')
            i = i + 1
        else if c == '%' && i + 2 < n && chars.digit_value(s[i + 1]) >= 0 && chars.digit_value(s[i + 2]) >= 0:
            _ = #append(out, char8(chars.digit_value(s[i + 1]) * 16 + chars.digit_value(s[i + 2])))
            i = i + 3
        else:
            _ = #append(out, c)
            i = i + 1
    string8 decoded = out
    return decoded
