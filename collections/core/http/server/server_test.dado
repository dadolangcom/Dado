@test
// core:http/server — the parser, the router and the responses, end to end
// through `App.handle` (bytes in, bytes out, no socket); static files from a
// temporary directory; then real round trips over loopback with
// `core:http`'s own client, one kept alive across two requests. Every wait
// is wall-clock bounded. On the web only `App.handle` runs: there is no
// socket and no directory, and the test checks that `listen` says so.
package server

import "core:http"
import "core:mem"
import "core:strings"
import "core:runtime"
import "core:time"
import "core:threads"
import "core:os"
import "core:os/fs"

// An allocator that refuses everything, so the allocation-failure answers
// are reached.
private rawptr refuses(rawptr data, mem.AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

// ── the handlers the tests route to ─────────────────────────────────────────

private Response index(Request req):
    return html("<h1>hello</h1>")

private Response user(Request req):
    return text(#format("user ", req.param("id"), " tab ", req.query("tab", "none")))

private Response file_path(Request req):
    return text(req.param("rest"))

private Response echo(Request req):
    return json(#format("{\"name\": \"", req.form("name"), "\", \"type\": \"",
                        req.header("CONTENT-TYPE"), "\"}"), 201)

private Response moved(Request req):
    return redirect("/").with_header("X-Why", "moved")

private Response missing(Request req):
    return text(#format("nothing at ", req.path), 404)

private void stream(Request req, ^Writer w):
    w.set_status(202)
    w.header("Content-Type", "text/event-stream")
    for i in 0..<3:
        _ = w.write(#format("data: ", i, "\n\n"))

private App routes():
    App a = app()
    a.quiet = true
    a.get("/", index)
    a.get("/users/{id}", user)
    a.get("/files/{rest...}", file_path)
    a.post("/echo", echo)
    a.get("/old", moved)
    a.raw("GET", "/events", stream)
    return a

// What `parse` makes of `raw`, as text: `request METHOD BODY`, `pending N`
// or `refused STATUS`.
private string8 parsed(string8 raw):
    switch parse(raw):
        case Request req:
            ref []char8 s = #format("request ", req.method, " ", req.body)
            string8 t = s
            return t
        case http.Pending p:
            ref []char8 s = #format("pending ", p.at_least)
            string8 t = s
            return t
        case Refused why:
            ref []char8 s = #format("refused ", why.status)
            string8 t = s
            return t

// The response to `raw`, as text.
private string8 ask(^App a, string8 raw):
    ref []char8 out = a.handle(raw)
    string8 s = out
    return s

private bool has(string8 s, string8 part):
    return strings.contains(s, part)

i32 test():
    bool ok = true
    using runtime.enter_temp():
        App a = routes()

        // A page.
        string8 r = ask(&a, "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 200 OK\r\n"), "GET / is 200: ", r) && ok
        ok = #expect(has(r, "Content-Type: text/html; charset=utf-8\r\n"), "html content type: ", r) && ok
        ok = #expect(has(r, "Content-Length: 14\r\n"), "its length: ", r) && ok
        ok = #expect(strings.ends_with(r, "\r\n\r\n<h1>hello</h1>"), "its body: ", r) && ok

        // A capture, and a query decoded on asking.
        r = ask(&a, "GET /users/42?tab=a%20b+c HTTP/1.1\r\n\r\n")
        ok = #expect(strings.ends_with(r, "user 42 tab a b c"), "param and query: ", r) && ok
        r = ask(&a, "GET /users/7/ HTTP/1.1\r\n\r\n")
        ok = #expect(strings.ends_with(r, "user 7 tab none"), "trailing slash, query fallback: ", r) && ok

        // The rest of the path.
        r = ask(&a, "GET /files/a/b/c.txt HTTP/1.1\r\n\r\n")
        ok = #expect(strings.ends_with(r, "\r\n\r\na/b/c.txt"), "{rest...}: ", r) && ok

        // A form body, a header asked in another case, a status argument.
        r = ask(&a, "POST /echo HTTP/1.1\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 13\r\n\r\nname=Sam+M%2E")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 201 Created\r\n"), "201: ", r) && ok
        ok = #expect(has(r, "{\"name\": \"Sam M.\", \"type\": \"application/x-www-form-urlencoded\"}"), "form and header: ", r) && ok

        // Chaining.
        r = ask(&a, "GET /old HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 302 Found\r\n"), "redirect: ", r) && ok
        ok = #expect(has(r, "Location: /\r\n") && has(r, "X-Why: moved\r\n"), "with_header: ", r) && ok

        // HEAD is a GET without its body.
        r = ask(&a, "HEAD / HTTP/1.1\r\n\r\n")
        ok = #expect(has(r, "Content-Length: 14\r\n") && strings.ends_with(r, "\r\n\r\n"), "HEAD: ", r) && ok

        // The wrong method is 405 naming the right one; no route is 404.
        r = ask(&a, "DELETE /echo HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 405 ") && has(r, "Allow: POST\r\n"), "405: ", r) && ok
        r = ask(&a, "GET /nope HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 404 Not Found\r\n"), "404: ", r) && ok
        a.on_not_found(missing)
        r = ask(&a, "GET /nope HTTP/1.1\r\n\r\n")
        ok = #expect(strings.ends_with(r, "nothing at /nope"), "fallback: ", r) && ok

        // A raw route streams with no length.
        r = ask(&a, "GET /events HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 202 Accepted\r\n"), "raw status: ", r) && ok
        ok = #expect(has(r, "Content-Type: text/event-stream\r\n") && !has(r, "Content-Length"), "raw head: ", r) && ok
        ok = #expect(strings.ends_with(r, "data: 0\n\ndata: 1\n\ndata: 2\n\n"), "raw body: ", r) && ok

        // Malformed requests.
        r = ask(&a, "nonsense\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 400 "), "400: ", r) && ok
        r = ask(&a, "POST /echo HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 501 "), "a coding other than chunked is 501: ", r) && ok

        // A chunked body is decoded.
        r = ask(&a, "POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Type: t\r\n\r\n5\r\nname=\r\n3\r\nAnn\r\n0\r\n\r\n")
        ok = #expect(has(r, "{\"name\": \"Ann\", \"type\": \"t\"}"), "a chunked form body: ", r) && ok

        // What `parse` answers: a request, more bytes owed, or a refusal.
        ok = #expect(parsed("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nx\r\n0\r\n\r\nNEXT") == "request POST x",
                     "a chunked request parses whole: ", parsed("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nx\r\n0\r\n\r\nNEXT")) && ok
        ok = #expect(parsed("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nx\r\n") == "pending 0", "a chunked body that has not ended") && ok
        ok = #expect(parsed("POST / HTTP/1.1\r\ncontent-length: 5\r\n\r\nab") == "pending 43", "a body shorter than its length") && ok
        ok = #expect(parsed("GET / HTTP/1.1\r\nHost: x\r\n") == "pending 0", "a head not yet whole") && ok
        ok = #expect(parsed("GET / SMTP/1.1\r\n\r\n") == "refused 400", "not HTTP/1") && ok
        ok = #expect(parsed("POST / HTTP/1.1\r\nContent-Length: x\r\n\r\n") == "refused 400", "a bad length") && ok
        ok = #expect(parsed("POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n") == "refused 501", "a coding other than chunked") && ok

        // An allocation that fails while parsing is the server's fault: 500,
        // and its reason phrase.
        (mem.Proc proc, rawptr data) refusing = (refuses, nil)
        i32 starved = 0
        using refusing:
            switch parse("GET / HTTP/1.1\r\nHost: x\r\n\r\n"):
                case Request _:
                    starved = 200
                case http.Pending _:
                    starved = 0
                case Refused why:
                    starved = why.status
        ok = #expect(starved == 500, "a parse with no memory is refused 500, got ", starved) && ok
        ok = #expect(reason(500) == "Internal Server Error" && reason(403) == "Forbidden", "the reason phrases of 500 and 403") && ok

        // More headers than a request may carry is 431.
        strings.Builder many = strings.builder()
        _ = strings.append(&many, "GET / HTTP/1.1\r\n")
        for i in 0..<MAX_HEADERS + 1:
            _ = strings.append(&many, #format("X-", i, ": v\r\n"))
        _ = strings.append(&many, "\r\n")
        ref []char8 many_bytes = strings.finish(&many)
        string8 too_many = many_bytes
        ok = #expect(parsed(too_many) == "refused 431", "too many headers: ", parsed(too_many)) && ok
        r = ask(&a, too_many)
        ok = #expect(strings.starts_with(r, "HTTP/1.1 431 "), "too many headers is answered 431: ", r) && ok

        // The pieces on their own.
        (bool hit, ref []Header ps) = match("/a/{x}/c", "/a/b/c")
        ok = #expect(hit && #len(ps) == 1 && ps[0].value == "b", "match") && ok
        (bool miss, ref []Header _) = match("/a/{x}/c", "/a/b")
        ok = #expect(!miss, "a short path does not match") && ok
        ok = #expect(decode("%41%2b+%zz") == "A+ %zz", "decode: ", decode("%41%2b+%zz")) && ok
        ok = #expect(content_type("app.WASM") == "application/wasm", "content type") && ok
        ok = #expect(escape("<a href='x'>&\"</a>") == "&lt;a href=&#39;x&#39;&gt;&amp;&quot;&lt;/a&gt;", "escape: ", escape("<a href='x'>&\"</a>")) && ok
        ok = #expect(escape("plain") == "plain", "escape leaves plain text") && ok

        a.header("Cache-Control", "no-store")
        r = ask(&a, "GET / HTTP/1.1\r\n\r\n")
        ok = #expect(has(r, "\r\nCache-Control: no-store\r\n"), "an app header on a response: ", r) && ok
        r = ask(&a, "GET /events HTTP/1.1\r\n\r\n")
        ok = #expect(has(r, "\r\nCache-Control: no-store\r\n"), "and on a raw route's head: ", r) && ok
        r = ask(&a, "GET /nope HTTP/1.1\r\n\r\n")
        ok = #expect(has(r, "\r\nCache-Control: no-store\r\n"), "and on the fallback: ", r) && ok

        ok = static_files() && ok
        ok = round_trip() && ok
        a.destroy()
    _ = runtime.close_temp()
    return 0 if ok else 1

// ── static files ────────────────────────────────────────────────────────────

private bool static_files():
    when #OS == #WEB:
        App w = app()
        w.quiet = true
        w.files("/static", "public")
        string8 r = ask(&w, "GET /static/a.css HTTP/1.1\r\n\r\n")
        bool web_ok = #expect(strings.starts_with(r, "HTTP/1.1 501 "), "a page has no files: ", r)
        w.destroy()
        return web_ok
    else:
        return disk_files()

when #OS != #WEB:
    private bool disk_files():
        bool ok = true
        try ref []char8 made = fs.make_temp_dir("dado-server-test-") else code:
            return #expect(false, "make_temp_dir: ", os.message(code))
        string8 root = made
        ref []char8 dir_bytes = #format(root, "/site")
        string8 dir = dir_bytes
        ref []char8 sub_bytes = #format(dir, "/sub")
        try fs.make_dirs(sub_bytes) else why:
            ok = #expect(false, "made the directories: ", os.message(why)) && ok
        ok = #expect(put_file(#format(dir, "/index.html"), "<p>root</p>"), "wrote index.html") && ok
        ok = #expect(put_file(#format(dir, "/sub/app.css"), "p{}"), "wrote app.css") && ok
        ok = #expect(put_file(#format(root, "/secret"), "secret"), "wrote a file outside") && ok

        App a = app()
        a.quiet = true
        a.files("/static", dir)
        string8 r = ask(&a, "GET /static/sub/app.css HTTP/1.1\r\n\r\n")
        ok = #expect(has(r, "Content-Type: text/css; charset=utf-8\r\n") && strings.ends_with(r, "p{}"), "a file: ", r) && ok
        r = ask(&a, "GET /static/ HTTP/1.1\r\n\r\n")
        ok = #expect(strings.ends_with(r, "<p>root</p>"), "a directory's index.html: ", r) && ok
        r = ask(&a, "GET /static/sub HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 301 ") && has(r, "Location: /static/sub/\r\n"), "a directory without its slash redirects: ", r) && ok
        r = ask(&a, "GET /static HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 301 ") && has(r, "Location: /static/\r\n"), "the prefix itself redirects to its slash: ", r) && ok
        r = ask(&a, "GET /static/../secret HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 404 "), "`..` cannot climb out: ", r) && ok
        r = ask(&a, "GET /static/%2e%2e/secret HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 404 "), "nor `..` encoded: ", r) && ok
        r = ask(&a, "GET /static/none.txt HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 404 "), "a missing file: ", r) && ok
        r = ask(&a, "GET /static/sub%5capp.css HTTP/1.1\r\n\r\n")
        ok = #expect(strings.starts_with(r, "HTTP/1.1 404 "), "a backslash is refused: ", r) && ok

        // A file the server may not read is 403. Whether this process may read
        // it is the system's to say — root reads anything, and Windows' mode
        // bits do not take reading away — so the test asks first.
        ref []char8 locked_bytes = #format(dir, "/locked.txt")
        string8 locked = locked_bytes
        ok = #expect(put_file(#format(dir, "/locked.txt"), "no"), "wrote locked.txt") && ok
        try fs.chmod(locked, 0) else why:
            ok = #expect(false, "chmod 0: ", os.message(why)) && ok
        bool refused = unreadable(locked)
        r = ask(&a, "GET /static/locked.txt HTTP/1.1\r\n\r\n")
        if refused:
            ok = #expect(strings.starts_with(r, "HTTP/1.1 403 Forbidden\r\n"), "an unreadable file is 403: ", r) && ok
        else:
            ok = #expect(strings.starts_with(r, "HTTP/1.1 200 ") && strings.ends_with(r, "no"), "a file this process may read anyway is served: ", r) && ok
        try fs.chmod(locked, 0x1A4) else why:
            ok = #expect(false, "chmod 644: ", os.message(why)) && ok
        a.destroy()

        // The segments Windows gives meaning to are refused there, and are
        // ordinary names elsewhere.
        bool windows = #OS == #WINDOWS
        ok = #expect(safe_segment("nul.txt") != windows && safe_segment("CON") != windows &&
                     safe_segment("com7.log") != windows && safe_segment("Lpt1") != windows &&
                     safe_segment("aux .x") != windows && safe_segment("a:stream") != windows,
                     "device names and streams are refused on Windows only") && ok
        ok = #expect(safe_segment("com0") && safe_segment("console.txt") && safe_segment("nully"),
                     "names that only look like devices are files everywhere") && ok

        try fs.remove_all(root) else code:
            ok = #expect(false, "removed the temp dir: ", os.message(code)) && ok
        return ok

    // Whether the system refuses this process reading `path`.
    private bool unreadable(string8 path):
        try ref []char8 got = fs.read_file(path) else why:
            return why == os.Error.PERMISSION
        #delete(got)
        return false

    private bool put_file(ref []char8 path, string8 text):
        string8 p = path
        try fs.write_file(p, text) else:
            return false
        return true

// ── over a real socket ──────────────────────────────────────────────────────

private const u16 PORT = 18974

private bool round_trip():
    when #OS == #WEB:
        App a = routes()
        bool ok = false
        try a.listen(PORT) else why:
            ok = #expect(why == http.Error.UNSUPPORTED, "a page cannot listen, got ", http.message(why))
        a.destroy()
        return ok
    else:
        return socket_trips()

when #OS != #WEB:
    private bool socket_trips():
        bool ok = true
        App a = routes()
        try a.listen(PORT) else why:
            return #expect(false, "listen on ", i32(PORT), ": ", http.message(why))
        ok = #expect(!a.step(), "no client: step answers nothing") && ok

        // A second app on the same port is refused, and says why.
        App b = routes()
        bool taken = false
        try b.listen(PORT) else why:
            taken = #expect(why == http.Error.IN_USE, "a second listen fails IN_USE, got ", http.message(why))
        ok = #expect(taken && !b.listening, "a second app cannot take the port") && ok
        b.destroy()

        // The client connects and sends; the request waits in the socket until
        // `step` reads it, and the answer waits until the client reads it.
        try http.Conn c = http.dial("127.0.0.1", PORT, 2000) else why:
            a.destroy()
            return #expect(false, "dial: ", http.message(why))
        []http.Header none
        ref []char8 req = http.build_request("GET", "127.0.0.1", PORT, "/users/9?tab=x", none, "")
        string8 req_text = req
        ok = send_text(c, req_text) && ok
        #delete(req)
        ok = #expect(step_within(&a, 5.0), "answered within 5s") && ok
        try http.Response r = http.read_response(c, 2000) else why:
            http.close_conn(c)
            a.destroy()
            return #expect(false, "read_response: ", http.message(why))
        http.close_conn(c)
        ok = #expect(r.status == 200 && r.body == "user 9 tab x", "the client read the body: ", r.body) && ok
        ok = #expect(r.header("connection") == "close", "closed when keep-alive is off") && ok
        r.destroy()
        a.close()

        // Kept alive: a client on another thread sends two requests down one
        // connection, and one `step` answers both.
        a.keep_alive_ms = 2000
        try a.listen(PORT) else why:
            ok = #expect(false, "listen again: ", http.message(why)) && ok
        Twice t = (0, 0, false)
        threads.Thread th = threads.spawn(two_requests, rawptr(&t))
        ok = #expect(th != nil, "spawned the client") && ok
        if th != nil:
            ok = #expect(step_within(&a, 5.0), "a kept connection was served") && ok
            _ = threads.join(th)
            ok = #expect(t.first == 200 && t.second == 200 && t.kept, "two answers on one connection: ",
                         t.first, " ", t.second, " kept=", t.kept) && ok
        a.close()

        // A request larger than `max_request` is answered 413 before its body
        // is read.
        a.keep_alive_ms = 0
        a.max_request = 64
        try a.listen(PORT) else why:
            ok = #expect(false, "listen a third time: ", http.message(why)) && ok
        try http.Conn big = http.dial("127.0.0.1", PORT, 2000) else why:
            a.destroy()
            return #expect(false, "dial: ", http.message(why))
        ok = send_text(big, "POST /echo HTTP/1.1\r\nContent-Length: 1000\r\n\r\n") && ok
        ok = #expect(step_within(&a, 5.0), "the large request was answered") && ok
        try http.Response r413 = http.read_response(big, 2000) else why:
            http.close_conn(big)
            a.destroy()
            return #expect(false, "read_response (413): ", http.message(why))
        http.close_conn(big)
        ok = #expect(r413.status == 413, "a request over max_request is 413, got ", r413.status) && ok
        r413.destroy()

        // A request whose bytes stop short is answered 408 once
        // `read_timeout_ms` has passed.
        a.max_request = 1048576
        a.read_timeout_ms = 100
        try http.Conn slow = http.dial("127.0.0.1", PORT, 2000) else why:
            a.destroy()
            return #expect(false, "dial: ", http.message(why))
        ok = send_text(slow, "GET /users/1 HTTP/1.1\r\nHost: x\r\n") && ok
        ok = #expect(step_within(&a, 5.0), "the slow request was answered") && ok
        try http.Response r408 = http.read_response(slow, 2000) else why:
            http.close_conn(slow)
            a.destroy()
            return #expect(false, "read_response (408): ", http.message(why))
        http.close_conn(slow)
        ok = #expect(r408.status == 408, "a request that stops short is 408, got ", r408.status) && ok
        r408.destroy()
        a.destroy()
        return ok

    // Send `text` on `c`; false with a printed reason when it did not all go.
    private bool send_text(http.Conn c, string8 text):
        try http.send(c, Bytes(text)) else why:
            return #expect(false, "send: ", http.message(why))
        return true

    private bool step_within(^App a, f64 seconds):
        time.Instant t0 = time.instant()
        for time.as_seconds_f64(time.elapsed(t0)) < seconds:
            if a.step():
                return true
            time.sleep(time.milliseconds(5))
        return false

    // What the keep-alive client saw.
    private type Twice: (i32 first, i32 second, bool kept)
    private type TwicePtr: ^Twice

    private rawptr two_requests(rawptr arg):
        TwicePtr out = TwicePtr(arg)
        try http.Conn c = http.dial("127.0.0.1", PORT, 2000) else:
            return nil
        _ = send_text(c, "GET /users/1 HTTP/1.1\r\nHost: x\r\n\r\n")
        try http.Response r1 = http.read_response(c, 2000) else:
            http.close_conn(c)
            return nil
        out^.first = r1.status
        out^.kept = r1.header("connection") == "keep-alive"
        r1.destroy()
        _ = send_text(c, "GET /users/2 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
        try http.Response r2 = http.read_response(c, 2000) else:
            http.close_conn(c)
            return nil
        out^.second = r2.status
        r2.destroy()
        http.close_conn(c)
        return nil
