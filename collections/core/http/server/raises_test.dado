@test
// What raises into a script, for the methods. `#assert_raises` stands only
// above a package-level function, so the methods of `Request`, `Response` and
// the route table of `App` are promised here, through private functions that
// call each one, and the build refuses (ERR1227) if any reaches something a
// script cannot run. `App`'s serving methods (`run`, `listen`, `step`,
// `close`, `handle`) and `Writer`'s are left out: they reach `core:http`'s
// sockets or, through a `files` route, `core:os/fs`.
package server

import "core:http"

private Response hello(Request req):
    return text(req.path)

private void streamed(Request req, ^Writer w):
    _ = req

#assert_raises
private bool request_methods(Request r):
    _ = r.header("content-type", "none")
    _ = r.param("id", "none")
    _ = r.query("q", "none")
    _ = r.form("f", "none")
    return r.has_header("host") && r.has_query("q") && r.is("GET")

#assert_raises
private i32 response_methods(Response r):
    Response s = r.with_header("X-A", "b").with_status(201)
    _ = s.header("x-a")
    return s.status

#assert_raises
private i64 route_table():
    App a = app()
    a.get("/", hello)
    a.post("/p", hello)
    a.put("/p", hello)
    a.patch("/p", hello)
    a.delete("/p", hello)
    a.route("", "/any", hello)
    a.raw("GET", "/raw", streamed)
    a.files("/static", "public")
    a.header("Cache-Control", "no-store")
    a.on_not_found(hello)
    i64 n = i64(#len(a.routes))
    #delete(a.routes)
    #delete(a.always)
    return n

i32 test():
    bool ok = true
    switch parse("GET /x?q=1 HTTP/1.1\r\nHost: h\r\n\r\n"):
        case Request r:
            ok = #expect(request_methods(r), "request methods") && ok
        case http.Pending _:
            ok = #expect(false, "a whole request parsed as pending") && ok
        case Refused _:
            ok = #expect(false, "a whole request was refused") && ok
    ok = #expect(response_methods(text("x")) == 201, "response methods") && ok
    ok = #expect(route_table() == 8, "route table") && ok
    return 0 if ok else 1
