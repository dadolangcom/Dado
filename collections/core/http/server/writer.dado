// The writer: where a response goes, and the low level's way of writing one.
//
// A raw route's handler is handed one:
//
//     void events(server.Request req, ^server.Writer w):
//         w.set_status(200)
//         w.header("Content-Type", "text/event-stream")
//         w.header("Cache-Control", "no-store")
//         for i in 0..<3:
//             w.write(#format("data: tick ", i, "\n\n"))
//
// The status and headers are sent with the first `write` (or when the handler
// returns, if it wrote nothing). The body carries no `Content-Length`; it ends
// when the connection closes, so a raw route's connection is never kept alive
// whatever the app's `keep_alive_ms`. Each `write` is sent as it is made, so a
// long answer streams.
//
// A writer with no connection — `App.handle`'s — keeps every byte instead, so a
// test reads exactly what a client would have.
package server

import "core:http"
import "core:strings"

// Where one response goes, and how far it has got: the writer's working
// state, which only this package reads.
private type WriterState:
    http.Conn conn
    bool to_conn                // false: keep the bytes in `out`
    ref []char8 out
    i32 status_sent             // the status line's code, once sent
    bool head_sent
    bool head_only              // a HEAD: send the head, drop the body
    i32 status
    ref []Header headers
    bool failed                 // the peer went away
    string8 method              // for the log line
    string8 path
    []Header extra              // the app's headers, on every response
    bool may_keep               // the app and the client both want the connection kept
    bool kept                   // the response sent said `keep-alive`

// Where one response goes: a connection, or (for `App.handle`) a buffer.
// A raw handler sets its status and headers, and writes its body; the rest
// is the server's.
type Writer:
    WriterState st

    // Set the status the head will carry: 200 unless set.
    void set_status(^self, i32 code):
        self.st.status = code

    // Add a header to the head. After the first `write` it is too late, and
    // the header is dropped.
    void header(^self, string8 name, string8 value):
        if self.st.head_sent:
            return
        if self.st.headers == nil:
            self.st.headers = #make([]Header, 0)
        Header pair = (name, value)
        if self.st.headers != nil:
            _ = #append(self.st.headers, pair)

    // Send `data` as the next piece of the body, sending the head first if it
    // has not gone. Answers false once the peer has gone away.
    bool write(^self, string8 data):
        if !self.st.head_sent:
            self.send_head(false)
        if self.st.head_only:
            return !self.st.failed
        return self.put(data)

    // Send the head now, with no body yet.
    void flush_head(^self):
        if !self.st.head_sent:
            self.send_head(false)

    // Whether the peer is still there to write to.
    bool ok(self):
        return !self.st.failed

    // ── the server's own side ───────────────────────────────────────────────

    // A whole response at once, with its `Content-Length`.
    private void send_response(^self, Response r, bool head_only):
        if self.st.head_sent:
            return
        self.st.head_sent = true
        self.st.status_sent = r.status
        self.st.kept = self.st.may_keep
        string8 bytes = serialize_with(r, head_only, self.st.extra, self.st.kept)
        _ = self.put(bytes)

    // What a raw handler that wrote nothing still owes: its head.
    private void finish(^self):
        if !self.st.head_sent:
            self.send_head(false)

    private void send_head(^self, bool with_length):
        self.st.head_sent = true
        i32 code = self.st.status if self.st.status != 0 else 200
        self.st.status_sent = code
        strings.Builder b = strings.builder(256)
        _ = strings.append(&b, #format("HTTP/1.1 ", code, " ", reason(code), "\r\n"))
        for h in self.st.extra:
            _ = strings.append(&b, h.name)
            _ = strings.append(&b, ": ")
            _ = strings.append(&b, h.value)
            _ = strings.append(&b, "\r\n")
        for h in self.st.headers:
            _ = strings.append(&b, h.name)
            _ = strings.append(&b, ": ")
            _ = strings.append(&b, h.value)
            _ = strings.append(&b, "\r\n")
        if with_length:
            _ = strings.append(&b, "Content-Length: 0\r\n")
        _ = strings.append(&b, "Connection: close\r\n\r\n")
        _ = self.put(strings.text(b))

    private bool put(^self, string8 data):
        if self.st.failed:
            return false
        if !self.st.to_conn:
            for c in data:
                if !#append(self.st.out, c):
                    self.st.failed = true
                    return false
            return true
        try http.send(self.st.conn, Bytes(data)) else:
            self.st.failed = true
        return !self.st.failed

// A writer that sends to `c` as it is written.
#assert_raises
private Writer connection_writer(http.Conn c):
    Writer w
    w.st.conn = c
    w.st.to_conn = true
    // What the log line says of a request that never parsed.
    w.st.method = "-"
    w.st.path = "-"
    return w

// A writer that keeps every byte in `out`, on `#default`, and sends nothing.
#assert_raises
private Writer buffered_writer():
    Writer w
    w.st.conn = http.Conn(0 - 1)
    w.st.out = #make([]char8, 0)
    return w

// Text as the bytes `http.send` takes: the same bytes, nothing copied.
private type Bytes: []u8
