// The wire: HTTP/1.1's bytes, read and written without a socket.
//
// Everything in this file is pure Dado — no `foreign` call, no address, no
// clock — and each function carries `#assert_raises`, so it runs in a script
// and on every target, the web's included. A read loop receives bytes until
// `request_end` or `response_end` says the message is whole, and a writer
// builds what it sends with these functions.
package http

import "core:chars"
import "core:strings"

// ── a header ────────────────────────────────────────────────────────────────

// One `name: value` line of a head, both views of the bytes it was read from.
// `core:http/server`'s `Header` is this type, so a request's headers, a
// response's and a client's are one type.
type Header: (string8 name, string8 value)

// ── what the read loops ask ──────────────────────────────────────────────────

// The message is whole, and is `length` bytes: its head, the blank line and
// its body.
distinct type Whole: (i64 length)
// More bytes are owed. `at_least` is how long the message will be once whole,
// when its head says (a `Content-Length`); 0 while that is not known yet —
// the head has not all arrived, or the body is chunked.
distinct type Pending: (i64 at_least)
// From `response_end`: the body runs until the server closes the connection,
// a response with neither `Content-Length` nor chunking. `body_at` is where
// the body starts.
distinct type ToClose: (i64 body_at)

// How far a message at the front of some bytes reaches: whole, not yet, or
// to the connection's close. Not yet is no failure; bytes that cannot be
// HTTP are, and fail `Error.MALFORMED`.
union Extent: (Whole, Pending, ToClose)

// The offset of the `\r\n\r\n` that closes the head of `raw`, or -1 while
// there is none.
#assert_raises
private i64 head_offset(string8 raw):
    i64 n = i64(#len(raw))
    i64 i = 0
    for i + 3 < n:
        if raw[i] == '\r' && raw[i + 1] == '\n' && raw[i + 2] == '\r' && raw[i + 3] == '\n':
            return i
        i = i + 1
    return -1

// Where the head of the whole message in `raw` ends: the offset of the
// `\r\n\r\n` that closes it. Fails `Error.MALFORMED` when `raw` holds no
// blank line; for bytes still arriving, `request_end` and `response_end`
// answer `Pending` instead.
#assert_raises
Error!i64 head_end(string8 raw):
    i64 at = head_offset(raw)
    if at < 0:
        fail Error.MALFORMED
    return at

// The value of the header `name` in `head` (the bytes before the blank line),
// matched without regard to case and trimmed of spaces and tabs, or `fallback`
// when the head has none. The request or status line is never a header.
#assert_raises
string8 head_value(string8 head, string8 name, string8 fallback = ""):
    i64 n = i64(#len(head))
    i64 i = line_after(head, 0)
    for i < n:
        i64 next = line_after(head, i)
        i64 stop = next - 2 if next <= n && next >= i + 2 && head[next - 2] == '\r' else next
        if stop > n:
            stop = n
        string8 line = head[i..<stop]
        i64 colon = strings.index_of(line, ':')
        if colon > 0 && strings.equal_fold(trim(line[0..<colon]), name):
            return trim(line[colon + 1..<i64(#len(line))])
        i = next
    return fallback

// The extent of a message whose body starts `body_at` bytes into `raw`, as
// its head says: chunked, sized by `Content-Length`, or else empty (a
// request) or running to the close (a response, `to_close`).
#assert_raises
private Error!Extent body_extent(string8 raw, string8 head, i64 body_at, bool to_close):
    if is_chunked(head):
        try Extent e = chunked_end(raw[body_at..<i64(#len(raw))])
        switch e:
            case Whole w: return Whole(body_at + w.length)
            case Pending _: return Pending(0)
            case ToClose _: return Pending(0)
    string8 cl = head_value(head, "content-length")
    if #len(cl) == 0:
        if to_close:
            return ToClose(body_at)
        return Whole(body_at)
    try i64 len = parse_decimal(cl)
    if i64(#len(raw)) < body_at + len:
        return Pending(body_at + len)
    return Whole(body_at + len)

// How far the request at the front of `raw` reaches: `Whole` with its
// length — its head, the blank line, and the body its `Content-Length` or
// chunking says — or `Pending` while more is owed. A request with neither
// has no body. Fails `Error.MALFORMED` when a length or a chunk size cannot
// be read.
#assert_raises
Error!Extent request_end(string8 raw):
    i64 at = head_offset(raw)
    if at < 0:
        return Pending(0)
    return body_extent(raw, raw[0..<at], at + 4, false)

// How far the response at the front of `raw` reaches: `Whole`, `Pending`, or
// `ToClose` for a body that ends when the server closes the connection.
// `head_only` is a response to HEAD, which carries no body whatever its
// headers say; so do 1xx, 204 and 304. Fails `Error.MALFORMED` when the
// status line, a length or a chunk size cannot be read.
#assert_raises
Error!Extent response_end(string8 raw, bool head_only = false):
    i64 at = head_offset(raw)
    if at < 0:
        return Pending(0)
    string8 head = raw[0..<at]
    i64 body_at = at + 4
    i32 code = status_code(head)
    if code < 100:
        fail Error.MALFORMED
    if head_only || code < 200 || code == 204 || code == 304:
        return Whole(body_at)
    return body_extent(raw, head, body_at, true)

// The three-digit status of a status line (`HTTP/1.1 200 OK`), or 0 when the
// head does not start with one.
#assert_raises
i32 status_code(string8 head):
    if #len(head) < 12 || head[0..<7] != "HTTP/1." || head[8] != ' ':
        return 0
    i32 code = 0
    for i in 9..<12:
        char8 c = head[i]
        if c < '0' || c > '9':
            return 0
        code = code * 10 + i32(c - '0')
    if #len(head) > 12 && head[12] != ' ' && head[12] != '\r':
        return 0
    return code

// ── chunked bodies ───────────────────────────────────────────────────────────

// How far the chunked body at the front of `body` reaches: `Whole` with every
// chunk, the last (empty) one, its trailer lines and the blank line that
// ends them, or `Pending`. Fails `Error.MALFORMED` when a size line is not
// hexadecimal or a chunk is not followed by its CRLF.
#assert_raises
Error!Extent chunked_end(string8 body):
    i64 n = i64(#len(body))
    i64 i = 0
    for:
        i64 eol = crlf_from(body, i)
        if eol < 0:
            return Pending(0)
        try i64 size = parse_chunk_size(body[i..<eol])
        i = eol + 2
        if size == 0:
            // Trailer lines, until an empty one.
            for:
                i64 t = crlf_from(body, i)
                if t < 0:
                    return Pending(0)
                if t == i:
                    return Whole(i + 2)
                i = t + 2
        if n - i < size + 2:
            return Pending(0)
        if body[i + size] != '\r' || body[i + size + 1] != '\n':
            fail Error.MALFORMED
        i = i + size + 2
    fail Error.MALFORMED

// Write the data of the chunked body `body` into `out`, without its framing,
// and answer how many bytes that is. Bytes past `out`'s length are counted
// and dropped, so a caller with a fixed buffer learns how much it missed.
// Fails `Error.MALFORMED` when the framing is malformed or incomplete.
#assert_raises
Error!i64 unchunk_to([]char8 out, string8 body):
    i64 n = i64(#len(body))
    i64 cap = i64(#len(out))
    i64 w = 0
    i64 i = 0
    for:
        i64 eol = crlf_from(body, i)
        if eol < 0:
            fail Error.MALFORMED
        try i64 size = parse_chunk_size(body[i..<eol])
        i = eol + 2
        if size == 0:
            return w
        if n - i < size:
            fail Error.MALFORMED
        for k in 0..<size:
            if w < cap:
                out[w] = body[i + k]
            w = w + 1
        i = i + size + 2
    fail Error.MALFORMED

// The data of the chunked body `body`, on `#default`. Fails
// `Error.MALFORMED` when the framing is, and `Error.NO_MEMORY` when the copy
// cannot be made.
#assert_raises
Error!ref []char8 unchunk(string8 body):
    ref []char8 out = #make([]char8, #len(body))
    if out == nil:
        fail Error.NO_MEMORY
    try i64 got = unchunk_to(out[:], body) else why:
        #delete(out)
        fail why
    #truncate(out, got)
    return out

// ── building a request ───────────────────────────────────────────────────────

// The bytes of an HTTP/1.1 request, on `#default`: the request line, `Host`
// (with `:port` unless it is 80), the caller's `headers`, `Content-Length`
// when there is a body or the method is one that carries one, and
// `Connection: close`, then the body. Nil when the bytes cannot be
// allocated.
#assert_raises
ref []char8 build_request(string8 method, string8 host, u16 port, string8 target,
                          []Header headers, string8 body):
    ref []char8 out = #make([]char8, 0)
    if out == nil:
        return out
    _ = #reserve(out, 128 + #len(target) + #len(body))
    bool ok = add(&out, method) && add(&out, " ") && add(&out, target if #len(target) > 0 else "/")
    ok = ok && add(&out, " HTTP/1.1\r\nHost: ") && add(&out, host)
    if port != 80:
        ok = ok && add(&out, ":") && add_int(&out, i64(port))
    ok = ok && add(&out, "\r\n")
    for h in headers:
        ok = ok && add(&out, h.name) && add(&out, ": ") && add(&out, h.value) && add(&out, "\r\n")
    if #len(body) > 0 || method == "POST" || method == "PUT" || method == "PATCH":
        ok = ok && add(&out, "Content-Length: ") && add_int(&out, i64(#len(body))) && add(&out, "\r\n")
    ok = ok && add(&out, "Connection: close\r\n\r\n") && add(&out, body)
    if !ok:
        #delete(out)
        return nil
    return out

// ── reading a response ───────────────────────────────────────────────────────

// A response a server sent: its status, its headers and its body, every one a
// view of `data`, which the response owns. `destroy` gives the bytes back.
type Response:
    i32 status                  // 200, 404, …
    string8 reason              // the status line's phrase, as sent
    string8 version             // "HTTP/1.1"
    ref []Header headers        // in the order sent
    string8 body                // decoded when the body came chunked
    ref []char8 data            // the bytes received
    ref []char8 decoded         // a chunked body's data; nil otherwise

    // The value of the header `name`, matched without regard to case, or
    // `fallback` when the response has none.
    #assert_raises
    string8 header(self, string8 name, string8 fallback = ""):
        for h in self.headers:
            if strings.equal_fold(h.name, name):
                return h.value
        return fallback

    // Whether the response carries the header `name`, in any case.
    #assert_raises
    bool has_header(self, string8 name):
        for h in self.headers:
            if strings.equal_fold(h.name, name):
                return true
        return false

    // Give back the bytes the response holds. Its strings are not readable
    // after.
    #assert_raises
    void destroy(^self):
        #delete(self.headers)
        #delete(self.data)
        #delete(self.decoded)

// Parse the whole response in `data`, which the answer takes ownership of
// (and frees, on failure). `head_only` reads it as the answer to HEAD. Fails
// `Error.MALFORMED` when the bytes are not one complete HTTP/1.x response,
// and `Error.NO_MEMORY` when the header list or a chunked body cannot be
// made.
#assert_raises
Error!Response parse_response(ref []char8 data, bool head_only = false):
    Response r
    r.data = data
    string8 raw = data
    try Extent extent = response_end(raw, head_only) else:
        #delete(r.data)
        fail Error.MALFORMED
    i64 end = 0
    switch extent:
        case Whole w:
            end = w.length
        case ToClose _:
            end = i64(#len(raw))
        case Pending _:
            #delete(r.data)
            fail Error.MALFORMED
    i64 at = head_offset(raw)
    string8 head = raw[0..<at]
    r.status = status_code(head)
    i64 first = line_after(head, 0)
    i64 line_stop = first - 2 if first <= i64(#len(head)) else i64(#len(head))
    r.version = head[0..<8]
    r.reason = trim(head[12..<line_stop]) if line_stop > 12 else ""
    r.headers = #make([]Header, 0)
    if r.headers == nil:
        #delete(r.data)
        fail Error.NO_MEMORY
    i64 n = i64(#len(head))
    i64 i = first
    for i < n:
        i64 next = line_after(head, i)
        i64 stop = next - 2 if next <= n else n
        if stop < i:
            stop = i
        string8 line = head[i..<stop]
        i64 colon = strings.index_of(line, ':')
        if colon <= 0:
            r.destroy()
            fail Error.MALFORMED
        Header h = (trim(line[0..<colon]), trim(line[colon + 1..<i64(#len(line))]))
        if !#append(r.headers, h):
            r.destroy()
            fail Error.NO_MEMORY
        i = next
    string8 body = raw[at + 4..<end]
    if !head_only && is_chunked(head):
        try ref []char8 plain = unchunk(body) else why:
            r.destroy()
            fail why
        r.decoded = plain
        r.body = r.decoded
    else:
        r.body = body
    return r

// ── small pieces ─────────────────────────────────────────────────────────────

// Whether the head's `Transfer-Encoding` ends in `chunked`, the one coding
// this package reads.
#assert_raises
private bool is_chunked(string8 head):
    string8 te = head_value(head, "transfer-encoding")
    i64 n = i64(#len(te))
    return n >= 7 && strings.equal_fold(te[n - 7..<n], "chunked")

// The offset just past the CRLF that ends the line starting at `from`, or
// past the end when no CRLF follows.
#assert_raises
private i64 line_after(string8 s, i64 from):
    i64 at = crlf_from(s, from)
    return at + 2 if at >= 0 else i64(#len(s)) + 2

// The offset of the first `\r\n` at or after `from`, or -1.
#assert_raises
private i64 crlf_from(string8 s, i64 from):
    i64 n = i64(#len(s))
    i64 i = from
    for i + 1 < n:
        if s[i] == '\r' && s[i + 1] == '\n':
            return i
        i = i + 1
    return -1

// `s` without the spaces and tabs at either end: HTTP's optional whitespace,
// which is narrower than `strings.trim`'s.
#assert_raises
private string8 trim(string8 s):
    i64 a = 0
    i64 b = i64(#len(s))
    for a < b && (s[a] == ' ' || s[a] == '\t'):
        a = a + 1
    for b > a && (s[b - 1] == ' ' || s[b - 1] == '\t'):
        b = b - 1
    return s[a..<b]

// A non-negative decimal count, as `Content-Length` writes one: at most 15
// digits, so it cannot overflow. Fails `Error.MALFORMED` for anything else.
#assert_raises
private Error!i64 parse_decimal(string8 s):
    string8 t = trim(s)
    if #len(t) == 0 || #len(t) > 15:
        fail Error.MALFORMED
    i64 n = 0
    for c in t:
        if c < '0' || c > '9':
            fail Error.MALFORMED
        n = n * 10 + i64(c - '0')
    return n

// A chunk's size line: hexadecimal digits, then any `;extension` (ignored).
// Fails `Error.MALFORMED` for anything else.
#assert_raises
private Error!i64 parse_chunk_size(string8 line):
    i64 stop = strings.index_of(line, ';')
    string8 t = trim(line[0..<stop] if stop >= 0 else line)
    if #len(t) == 0 || #len(t) > 15:
        fail Error.MALFORMED
    i64 n = 0
    for c in t:
        i32 d = chars.digit_value(c)
        if d < 0:
            fail Error.MALFORMED
        n = n * 16 + i64(d)
    return n

// Append `s` to `out`; false when an append could not allocate.
#assert_raises
private bool add(^ref []char8 out, string8 s):
    for c in s:
        if !#append(out^, c):
            return false
    return true

// Append `v` in decimal; false when an append could not allocate.
#assert_raises
private bool add_int(^ref []char8 out, i64 v):
    [20]char8 tmp
    i32 k = 0
    i64 x = v if v >= 0 else 0 - v
    if x == 0:
        tmp[0] = '0'
        k = 1
    for x > 0:
        tmp[k] = char8(i32('0') + i32(x % 10))
        x = x / 10
        k = k + 1
    if v < 0 && !#append(out^, '-'):
        return false
    for j in 0..<k:
        if !#append(out^, tmp[k - 1 - j]):
            return false
    return true
