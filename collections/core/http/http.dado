// core:http — HTTP/1.1 over TCP: connections for a server and a client, a
// small blocking client, and the wire format both are written on.
//
//     import "core:http"
//     import "core:fmt"
//
//     try http.Response r = http.get("example.com", 80, "/") else why:
//         fmt.println("get: ", http.message(why))
//         return 1
//     defer r.destroy()
//     fmt.println(r.status, " ", r.header("content-type"))
//
// A server is `core:http/server`, the router built on this package: it
// listens with `listen`, takes each connection with `accept`, reads it with
// `receive` until `request_end` says the request is whole, and answers with
// `send`. A client is `get`, `post` and `request`, or `dial` and
// `read_response` for one that sends its own bytes.
//
// **Tier [W] H. Script class S for the wire, T for the sockets.** Built for
// Linux, macOS, the BSDs or Windows, the whole package is here, over
// `core:net`'s sockets. Built for the web it compiles and every call that
// needs a socket fails `Error.UNSUPPORTED` — a page has no listening socket
// and no raw TCP, and node's sockets are asynchronous where these calls wait —
// while the wire (`wire.dado`) works unchanged. A target with no operating
// system has no sockets, and the `#static_assert` below refuses it by name.
//
// **What raises into a script.** The wire is pure Dado and promised, each
// function by the `#assert_raises` above it: `head_end`, `head_value`,
// `request_end`, `response_end`, `status_code`, `chunked_end`, `unchunk_to`,
// `unchunk`, `build_request` and `parse_response`, with `message` here and the
// `Response` methods through `raises_test.dado`. What touches a socket is not
// and cannot be: it reaches `core:net`, which calls the platform's C and
// holds the platform's descriptors. A script that wants HTTP builds and
// parses it here and asks its host for the bytes.
//
// **Listening binds the address it is given.** `listen("127.0.0.1", port)` is
// the loopback interface only, which is what a tool's status page or a dev
// bridge wants; `"0.0.0.0"` (or `"::"`) is every interface, and is a decision
// worth writing down where it is made. The listening socket is nonblocking,
// so `accept` answers `Error.WOULD_BLOCK` at once when nobody is waiting.
//
// **The client waits.** `get`, `post` and `request` connect, send, and read
// the whole response — `Content-Length`, chunked, or until the server closes
// — each step bounded by `timeout_ms`, and answer a `Response` whose bytes
// are on `#default` until `destroy`. One request per connection
// (`Connection: close`), IPv4 or IPv6, no TLS: `https://` is not here.
//
// **Errors.** Every failable function fails with a member of `Error`
// (codes 1100 to 1199), and `message(why)` is a sentence for each. A
// connection's failures are `core:net`'s, read into this package's members
// at the moment they happen.
//
// **Thread-safety.** Nothing here shares state: the client, the wire, and
// `accept`/`receive`/`send` on distinct connections are safe from any
// thread.
package http

import "core:net"

#static_assert(#OS != #NONE, "core:http needs an operating system's TCP sockets, and a target with no operating system (`#NONE`) has none")

// ── failure ─────────────────────────────────────────────────────────────────

// Why a call failed.
distinct enum i32 Error:
    // This target has no TCP sockets: the web.
    UNSUPPORTED = 1101,
    // The address and port are taken (another listener holds them), or the
    // system refused to bind them.
    IN_USE,
    // Nothing is listening at the address dialed.
    REFUSED,
    // The peer did not answer within the time allowed.
    TIMED_OUT,
    // The host name did not resolve, the address is not this machine's, or no
    // route reaches it.
    UNREACHABLE,
    // The peer closed the connection before the message was whole, or reset
    // it.
    CLOSED,
    // The bytes are not an HTTP/1.x message.
    MALFORMED,
    // The message is larger than the limit the caller set.
    TOO_LARGE,
    // The system's sockets failed for another reason (out of descriptors, a
    // network that is down, a Winsock that would not start).
    NETWORK,
    // An allocation failed.
    NO_MEMORY,
    // The listening socket has no connection waiting: try again later.
    WOULD_BLOCK,

// A sentence for `why`, for a person: what went wrong and, where there is
// one, what to do. Never empty.
#assert_raises
string8 message(Error why):
    if why == Error.UNSUPPORTED: return "this target has no TCP sockets (a web build cannot listen or connect)"
    if why == Error.IN_USE: return "the address is in use: another program is listening on that port, or it needs a privilege"
    if why == Error.REFUSED: return "the connection was refused: nothing is listening at that address and port"
    if why == Error.TIMED_OUT: return "the peer did not answer in time"
    if why == Error.UNREACHABLE: return "the host could not be reached: check the name, the address and the network"
    if why == Error.CLOSED: return "the peer closed the connection before the message was complete"
    if why == Error.MALFORMED: return "the bytes are not an HTTP/1.x message"
    if why == Error.TOO_LARGE: return "the message is larger than the limit allowed"
    if why == Error.NETWORK: return "the system's sockets failed"
    if why == Error.NO_MEMORY: return "out of memory"
    if why == Error.WOULD_BLOCK: return "no connection is waiting yet"
    return "not a core:http error"

// Fail with `core:net`'s reason read as this package's member: always
// fails. A read or write timeout is `WOULD_BLOCK` to `core:net` and
// `TIMED_OUT` here, where a connection blocks. (A function answering an
// `Error` could not be failed with: a value of a `distinct enum` need not be
// a member, ERR0724, so the translation fails itself.)
private Error!void fail_from(net.Error why):
    switch why:
        case net.Error.UNSUPPORTED: fail Error.UNSUPPORTED
        case net.Error.ADDRESS_IN_USE, net.Error.PERMISSION: fail Error.IN_USE
        case net.Error.REFUSED: fail Error.REFUSED
        case net.Error.TIMED_OUT, net.Error.WOULD_BLOCK: fail Error.TIMED_OUT
        case net.Error.INVALID_ADDRESS, net.Error.NOT_FOUND, net.Error.DNS_FAILED, net.Error.ADDRESS_UNAVAILABLE, net.Error.UNREACHABLE, net.Error.FAMILY_UNSUPPORTED: fail Error.UNREACHABLE
        case net.Error.RESET, net.Error.ABORTED, net.Error.CLOSED, net.Error.NOT_CONNECTED: fail Error.CLOSED
        case net.Error.TOO_LARGE: fail Error.TOO_LARGE
        case net.Error.NO_RESOURCES, net.Error.INTERRUPTED, net.Error.INVALID, net.Error.UNKNOWN: fail Error.NETWORK
        else: fail Error.NETWORK

// ── handles ─────────────────────────────────────────────────────────────────

// A listening socket. End it with `stop`.
distinct type Server: i64

// One accepted, or dialed, connection. End it with `close_conn`.
distinct type Conn: i64

// ── the server's side ───────────────────────────────────────────────────────

// Start listening on `host:port`, where `host` is a numeric address of this
// machine: `"127.0.0.1"` for the loopback interface only, `"0.0.0.0"` or
// `"::"` for every interface. The socket is nonblocking, so `accept` never
// waits. Fails `Error.IN_USE` when the port is taken, `Error.UNREACHABLE`
// when `host` is not an address of this machine, and `Error.UNSUPPORTED` on
// the web.
Error!Server listen(string8 host, u16 port):
    try net.Ip ip = net.parse_ip(host) else:
        fail Error.UNREACHABLE
    net.Endpoint at = (ip, port)
    net.Socket s = net.Socket(-1)
    try s = net.tcp_listen(at, 16) else why:
        try fail_from(why)
    try net.set_nonblocking(s, true) else why:
        net.close(s)
        try fail_from(why)
    return Server(i64(s))

// Stop the server: the listen socket is closed. Connections already accepted
// are the caller's to `close_conn`.
void stop(Server s):
    if i64(s) >= 0:
        net.close(net.Socket(i64(s)))

// Accept one waiting connection without reading from it. The connection
// blocks, with a 250 ms read and write timeout (`set_timeout` changes it).
// Fails `Error.WOULD_BLOCK` when none is waiting, and with `core:net`'s
// reason read as this package's when the accept itself fails.
Error!Conn accept(Server s):
    net.Socket c = net.Socket(-1)
    try c = net.accept(net.Socket(i64(s))) else why:
        if why == net.Error.WOULD_BLOCK:
            fail Error.WOULD_BLOCK
        try fail_from(why)
    // Darwin, the BSDs and Windows hand back a connection that inherits the
    // listener's nonblocking mode, and Linux does not: clear it everywhere,
    // so the timeout is what bounds a read.
    Conn conn = Conn(i64(c))
    try net.set_nonblocking(c, false) else why:
        net.close(c)
        try fail_from(why)
    try set_timeout(conn, 250) else why:
        net.close(c)
        fail why
    return conn

// ── the client's side ───────────────────────────────────────────────────────

// Connect to `host:port` — a name or a numeric address, IPv4 or IPv6 —
// trying each address the name resolves to, each within `timeout_ms`, which
// also becomes the connection's read and write timeout. Fails
// `Error.REFUSED`, `Error.TIMED_OUT`, `Error.UNREACHABLE`, `Error.NETWORK`,
// or `Error.UNSUPPORTED` on the web.
Error!Conn dial(string8 host, u16 port, i32 timeout_ms = 5000):
    net.Socket s = net.Socket(-1)
    try s = net.dial(host, port, timeout_ms) else why:
        try fail_from(why)
    Conn c = Conn(i64(s))
    try set_timeout(c, timeout_ms) else why:
        net.close(s)
        fail why
    return c

// ── a connection ────────────────────────────────────────────────────────────

// Read what has arrived on `c` into `into`, waiting at most the connection's
// timeout, and answer how many bytes that was: 0 when the peer has finished
// sending, or `into` is empty. Fails `Error.TIMED_OUT` when nothing arrived
// in time, and `Error.CLOSED` when the peer reset the connection.
Error!i64 receive(Conn c, []u8 into):
    i64 n = 0
    try n = net.read(net.Socket(i64(c)), into) else why:
        try fail_from(why)
    return n

// Write all of `from` to `c`, as many writes as it takes. Fails
// `Error.CLOSED` when the peer has gone, and `Error.TIMED_OUT` when a write
// waited out the connection's timeout; some of the bytes may have gone, and
// the connection is then best closed.
Error!void send(Conn c, []u8 from):
    try net.write_all(net.Socket(i64(c)), from) else why:
        try fail_from(why)

// Give every `receive` and every `send` on `c` at most `milliseconds` to
// finish; 0 or less is read as 1, the shortest wait, never as "forever".
Error!void set_timeout(Conn c, i32 milliseconds):
    i32 ms = milliseconds if milliseconds > 0 else 1
    net.Socket s = net.Socket(i64(c))
    try net.set_read_timeout(s, ms) else why:
        try fail_from(why)
    try net.set_write_timeout(s, ms) else why:
        try fail_from(why)

// Close a connection.
void close_conn(Conn c):
    if i64(c) >= 0:
        net.close(net.Socket(i64(c)))

// ── text as bytes ───────────────────────────────────────────────────────────

private type BytePtr: ^u8
private type Chars: []char8

// `s`'s bytes as the `[]u8` `send` takes: the same bytes, nothing copied.
// There is no view conversion between `string8` and `[]u8` (ERR0504), so the
// view is rebuilt through a pointer to its first byte.
private []u8 bytes_of(string8 s):
    i64 n = #len(s)
    []u8 none
    if n == 0:
        return none
    []char8 c = Chars(s)
    BytePtr p = BytePtr(rawptr(&c[0]))
    return p[0..<n]
