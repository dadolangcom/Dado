@test
// What raises into a script, for the methods. `#assert_raises` stands only
// above a package-level function, so `Response`'s methods are promised here,
// through a private function that calls each one, and the build refuses
// (ERR1227) if any reaches something a script cannot run.
package http

#assert_raises
private bool response_methods(Response r):
    bool seen = r.has_header("content-type")
    _ = r.header("content-type", "none")
    Response copy = r
    copy.destroy()
    return seen

i32 test():
    ref []char8 data = #make([]char8, 0)
    for c in "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 1\r\n\r\nx":
        _ = #append(data, c)
    try Response r = parse_response(data) else code:
        #expect(false, "parse_response: ", message(code))
        return 1
    return 0 if response_methods(r) else 1
