@test
// core:http — the wire alone: framing, chunking, parsing and building, with no
// socket, so it runs on every target the package builds for.
package http

import "core:mem"

// An allocator that refuses everything, so the allocation-failure answers
// are reached.
private rawptr refuses(rawptr data, mem.AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

// An extent as text, for comparing: `whole 59`, `pending 0`, `to-close 19`,
// or the failure's name.
private ref []char8 shown(Extent e):
    switch e:
        case Whole w: return #format("whole ", w.length)
        case Pending p: return #format("pending ", p.at_least)
        case ToClose t: return #format("to-close ", t.body_at)

private ref []char8 failed(Error why):
    if why == Error.MALFORMED:
        return #format("MALFORMED")
    return #format("failed ", message(why))

// `request_end(raw)` as text.
private ref []char8 req(string8 raw):
    try Extent e = request_end(raw) else why:
        return failed(why)
    return shown(e)

// `response_end(raw, head_only)` as text.
private ref []char8 resp(string8 raw, bool head_only = false):
    try Extent e = response_end(raw, head_only) else why:
        return failed(why)
    return shown(e)

// `chunked_end(body)` as text.
private ref []char8 chunks(string8 body):
    try Extent e = chunked_end(body) else why:
        return failed(why)
    return shown(e)

// Whether `got` is `want`; frees `got`.
private bool is(ref []char8 got, string8 want, string8 what):
    string8 g = got
    bool same = #expect(g == want, what, ": ", g, ", want ", want)
    #delete(got)
    return same

i32 test():
    bool ok = true

    // ── the head ────────────────────────────────────────────────────────────
    string8 req_text = "GET /x HTTP/1.1\r\nHost: a\r\nContent-Length:  3 \r\nX-Y:z\r\n\r\nabcEXTRA"
    try i64 at = head_end(req_text) else why:
        _ = #expect(false, "head_end: ", message(why))
        return 1
    ok = #expect(at == 52, "head_end: ", at) && ok
    bool no_head = false
    try _ = head_end("GET / HTTP/1.1\r\nHost: a\r\n") else why:
        no_head = #expect(why == Error.MALFORMED, "head_end of bytes with no blank line fails MALFORMED")
    ok = #expect(no_head, "head_end of bytes with no blank line failed") && ok
    string8 head = req_text[0..<at]
    ok = #expect(head_value(head, "content-length") == "3", "a header's value is trimmed") && ok
    ok = #expect(head_value(head, "x-y") == "z", "a header with no space") && ok
    ok = #expect(head_value(head, "GET /x HTTP/1.1") == "", "the request line is not a header") && ok
    ok = #expect(head_value(head, "missing", "dflt") == "dflt", "a missing header's fallback") && ok

    // ── how long a request is ───────────────────────────────────────────────
    ok = is(req(req_text), "whole 59", "request_end counts Content-Length") && ok
    ok = is(req("GET / HTTP/1.1\r\nHost: a\r\n"), "pending 0", "no blank line yet") && ok
    ok = is(req("POST / HTTP/1.1\r\nContent-Length: 9\r\n\r\nabc"), "pending 47", "a short body, its length known") && ok
    ok = is(req("POST / HTTP/1.1\r\nContent-Length: x\r\n\r\n"), "MALFORMED", "a bad length") && ok
    ok = is(req("GET / HTTP/1.1\r\n\r\n"), "whole 18", "no body") && ok
    string8 chunked_req = "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
    ok = is(req(chunked_req), #format("whole ", #len(chunked_req)), "a chunked request's end") && ok
    ok = is(req("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nab"), "pending 0", "a chunked request not yet whole") && ok
    ok = is(req("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n"), "MALFORMED", "a chunked request with a bad size") && ok

    // ── how long a response is ──────────────────────────────────────────────
    string8 sized = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi"
    ok = is(resp(sized), #format("whole ", #len(sized)), "a sized response") && ok
    ok = is(resp(sized, true), #format("whole ", #len(sized) - 2), "a HEAD answer has no body") && ok
    ok = is(resp("HTTP/1.1 204 No Content\r\n\r\n"), "whole 27", "204 has no body") && ok
    ok = is(resp("HTTP/1.0 200 OK\r\n\r\nrest"), "to-close 19", "no length runs to the close") && ok
    ok = is(resp("SMTP 200 OK\r\n\r\n"), "MALFORMED", "not HTTP") && ok
    ok = is(resp("HTTP/1.1 200"), "pending 0", "a status line not yet whole") && ok
    ok = #expect(status_code("HTTP/1.1 404 Not Found") == 404, "status_code") && ok
    ok = #expect(status_code("HTTP/1.1 20x Bad") == 0, "status_code refuses non-digits") && ok

    // ── chunking ────────────────────────────────────────────────────────────
    string8 body = "4\r\nWiki\r\n5;name=v\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0\r\nT: 1\r\n\r\nNEXT"
    ok = is(chunks(body), #format("whole ", #len(body) - 4), "chunked_end stops at the blank line") && ok
    ok = is(chunks("4\r\nWik"), "pending 0", "a chunk not yet whole") && ok
    ok = is(chunks("zz\r\n"), "MALFORMED", "a size that is not hex") && ok
    ok = is(chunks("2\r\nabX\r\n"), "MALFORMED", "a chunk with no CRLF after it") && ok
    try ref []char8 plain = unchunk(body) else why:
        _ = #expect(false, "unchunk: ", message(why))
        return 1
    string8 p = plain
    ok = #expect(p == "Wikipedia in\r\n\r\nchunks.", "unchunk: ", p) && ok
    #delete(plain)
    [4]char8 small
    try i64 counted = unchunk_to(small[:], "6\r\nabcdef\r\n0\r\n\r\n") else why:
        _ = #expect(false, "unchunk_to: ", message(why))
        return 1
    ok = #expect(counted == 6, "unchunk_to counts what it drops") && ok
    ok = #expect(small[3] == 'd', "and keeps what fits") && ok
    bool cut = false
    try _ = unchunk_to(small[:], "6\r\nabc") else why:
        cut = #expect(why == Error.MALFORMED, "unchunk_to of an incomplete body fails MALFORMED")
    ok = #expect(cut, "unchunk_to of an incomplete body failed") && ok
    ref []char8 bad
    try bad = unchunk("q\r\n") else why:
        ok = #expect(why == Error.MALFORMED, "unchunk of a bad body fails MALFORMED") && ok
    #delete(bad)

    // ── building a request ──────────────────────────────────────────────────
    []Header none
    ref []char8 built = build_request("POST", "h", 8080, "/p", none, "data")
    string8 b = built
    ok = #expect(b == "POST /p HTTP/1.1\r\nHost: h:8080\r\nContent-Length: 4\r\nConnection: close\r\n\r\ndata", "build_request: ", b) && ok
    #delete(built)
    [2]Header two = [("X-A", "b"), ("X-B", "c")]
    ref []char8 built3 = build_request("PUT", "h", 1, "/q", two[:], "")
    string8 b3 = built3
    ok = #expect(b3 == "PUT /q HTTP/1.1\r\nHost: h:1\r\nX-A: b\r\nX-B: c\r\nContent-Length: 0\r\nConnection: close\r\n\r\n", "headers and an empty PUT: ", b3) && ok
    #delete(built3)
    ref []char8 built2 = build_request("GET", "h", 80, "", none, "")
    string8 b2 = built2
    ok = #expect(b2 == "GET / HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n", "a GET on port 80: ", b2) && ok
    #delete(built2)

    // ── parsing a response ──────────────────────────────────────────────────
    try Response r = parse_response(owned("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nServer: t\r\n\r\n2\r\nok\r\n0\r\n\r\n")) else why:
        _ = #expect(false, "parse_response: ", message(why))
        return 1
    ok = #expect(r.status == 200 && r.reason == "OK" && r.version == "HTTP/1.1", "status line") && ok
    ok = #expect(r.body == "ok", "chunked body decoded: ", r.body) && ok
    ok = #expect(r.header("SERVER") == "t" && r.has_header("transfer-encoding") && !r.has_header("nope"), "headers") && ok
    r.destroy()
    Response short
    short.status = -1
    try short = parse_response(owned("HTTP/1.1 200 OK\r\nContent-Length: 9\r\n\r\nshort")) else why:
        ok = #expect(why == Error.MALFORMED, "a short body is MALFORMED, got ", message(why)) && ok
    ok = #expect(short.status == -1, "a short body does not parse") && ok
    try Response closing = parse_response(owned("HTTP/1.0 200 OK\r\nServer: t\r\n\r\nto the end")) else why:
        _ = #expect(false, "parse_response of a body to the close: ", message(why))
        return 1
    ok = #expect(closing.body == "to the end", "a body that runs to the close: ", closing.body) && ok
    closing.destroy()

    // ── out of memory ───────────────────────────────────────────────────────
    ref []char8 whole_answer = owned("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nok\r\n0\r\n\r\n")
    (mem.Proc proc, rawptr data) refusing = (refuses, nil)
    using refusing:
        ref []char8 nothing = build_request("GET", "h", 80, "/", none, "")
        ok = #expect(nothing == nil, "build_request with no memory answers nil") && ok
        bool no_memory = false
        try _ = unchunk("2\r\nok\r\n0\r\n\r\n") else why:
            no_memory = #expect(why == Error.NO_MEMORY, "unchunk with no memory fails NO_MEMORY, got ", message(why))
        ok = #expect(no_memory, "unchunk with no memory failed") && ok
        no_memory = false
        Response unparsed
        try unparsed = parse_response(whole_answer) else why:
            no_memory = #expect(why == Error.NO_MEMORY, "parse_response with no memory fails NO_MEMORY, got ", message(why))
        ok = #expect(no_memory, "parse_response with no memory failed") && ok
        unparsed.destroy()

    // ── messages ────────────────────────────────────────────────────────────
    ok = #expect(message(Error.MALFORMED) != message(Error.CLOSED), "message tells codes apart") && ok
    ok = #expect(message(Error.WOULD_BLOCK) != "not a core:http error", "the last member has a sentence") && ok
    return 0 if ok else 1

private ref []char8 owned(string8 s):
    ref []char8 out = #make([]char8, 0)
    for c in s:
        _ = #append(out, c)
    return out
