@test
// `width` is comparisons below U+0591 and a table search above it, so the
// claims below sit where either can be wrong: on each side of every comparison
// the fast path makes; on the first and last code point of the first, the
// middle and the last row of each table, where an off-by-one in a search
// misses and a probe in the middle does not; and, exhaustively, on the two
// shortcuts agreeing with the plain search they stand in for.
//
// The expected values are read from the Unicode Character Database 17.0.0, the
// data the tables were generated from: a code point's general category and its
// East_Asian_Width, with the two exceptions `width` states (U+00AD is one
// column; U+1160..U+11FF are zero).
package chars

private bool w(u32 v, i32 want):
    i32 got = width(char32(v))
    return #expect(got == want, "width(", v, ") = ", got, ", want ", want)

// `v`'s row in `WIDTHS` by the block index, which is what `width` reads.
private bool t(u32 v, i32 want):
    i32 got = table_width(v)
    return #expect(got == want, "table_width(", v, ") = ", got, ", want ", want)

private bool amb(u32 v, bool want):
    bool got = search(v, AMBIGUOUS[:], 0, AMBIGUOUS_N, 1) == 2
    return #expect(got == want, "AMBIGUOUS holds ", v, ": ", got, ", want ", want)

// Sorted, each row well-formed, a width of 0 or 2, and merged: two rows that
// touch have different widths, or they would have been one row. The searches
// are only correct over the first two.
private bool well_formed([][3]u32 table, string8 name):
    bool ok = true
    i32 n = i32(#len(table))
    for i in 0..<n:
        ok = #expect(table[i][0] <= table[i][1], name, " row ", i, " is backwards") && ok
        ok = #expect(table[i][2] == 0 || table[i][2] == 2, name, " row ", i, " width ", table[i][2]) && ok
        if i + 1 < n:
            ok = #expect(table[i][1] < table[i + 1][0], name, " rows ", i, " and ", i + 1, " overlap") && ok
            bool touch = table[i][1] + 1 == table[i + 1][0]
            ok = #expect(!touch || table[i][2] != table[i + 1][2], name, " rows ", i, " and ", i + 1, " should be merged") && ok
    return ok

i32 test():
    bool ok = true

    // ── the fast path's boundaries ──────────────────────────────────────────
    //
    // C0 controls end at 0x1F; printable ASCII is 0x20..0x7E; DEL and the C1
    // controls are 0x7F..0x9F; the table-free run is 0xA0..0x590, with the
    // two zero-width runs 0x300..0x36F and 0x483..0x489 inside it, and 0x591
    // is the first code point `WIDTHS` decides.
    ok = w(0x00, 0) && ok
    ok = w(0x1F, 0) && ok
    ok = w(0x20, 1) && ok
    ok = w(0x7E, 1) && ok
    ok = w(0x7F, 0) && ok
    ok = w(0x9F, 0) && ok
    ok = w(0xA0, 1) && ok
    ok = w(0xAD, 1) && ok      // SOFT HYPHEN: Cf, and one column by choice
    ok = w(0x2FF, 1) && ok
    ok = w(0x300, 0) && ok
    ok = w(0x36F, 0) && ok
    ok = w(0x370, 1) && ok
    ok = w(0x482, 1) && ok
    ok = w(0x483, 0) && ok
    ok = w(0x489, 0) && ok
    ok = w(0x48A, 1) && ok
    ok = w(0x590, 1) && ok
    ok = w(0x591, 0) && ok     // Hebrew accent etnahta, the first table answer

    // The fast path's premise, against the table it skips: for every code
    // point from 0xA0 to 0x590 the comparisons and `WIDTHS` agree. U+00AD is
    // not in `WIDTHS`, so it agrees at 1.
    for v in 0xA0..<0x591:
        ok = #expect(width(char32(u32(v))) == table_width(u32(v)), "fast path disagrees with WIDTHS at ", v) && ok

    // The block index's premise: for every code point, searching the rows
    // `BLOCK_FIRST` names answers what searching all of `WIDTHS` answers.
    i32 disagree = 0
    for v in 0..<0x110000:
        if table_width(u32(v)) != search(u32(v), WIDTHS[:], 0, WIDTHS_N, 1): disagree = disagree + 1
    ok = #expect(disagree == 0, "block index disagrees with a full search at ", disagree, " code points") && ok

    // ── one of each kind ────────────────────────────────────────────────────
    ok = w(0x4E00, 2) && ok      // 一, CJK unified
    ok = w(0x3000, 2) && ok      // ideographic space, East_Asian_Width F
    ok = w(0xAC00, 2) && ok      // 가, Hangul syllable
    ok = w(0xD7A3, 2) && ok      // the last Hangul syllable
    ok = w(0x115F, 2) && ok      // Hangul initial filler, wide
    ok = w(0x1160, 0) && ok      // Hangul medial vowel filler, zero: the row after it
    ok = w(0x11FF, 0) && ok      // the last final consonant
    ok = w(0xFF21, 2) && ok      // Ａ, fullwidth
    ok = w(0xFF61, 1) && ok      // ｡, halfwidth: the first code point after the fullwidth run
    ok = w(0x0301, 0) && ok      // combining acute
    ok = w(0x200B, 0) && ok      // ZERO WIDTH SPACE
    ok = w(0x200D, 0) && ok      // ZERO WIDTH JOINER
    ok = w(0xFE0F, 0) && ok      // VARIATION SELECTOR-16
    ok = w(0x20000, 2) && ok     // astral CJK, extension B
    ok = w(0x2A6E0, 2) && ok     // unassigned, but reserved as wide by the UCD
    ok = w(0x0378, 1) && ok      // unassigned in the Greek block
    ok = w(0xE000, 1) && ok      // private use: ambiguous, so one by default
    ok = w(0x03B1, 1) && ok      // α: ambiguous, so one by default
    ok = w(0x2500, 1) && ok      // ─: ambiguous, so one by default
    ok = w(0x302A, 0) && ok      // Mn and W both: zero wins
    ok = w(0xE0001, 0) && ok     // LANGUAGE TAG, Cf, past the last block
    ok = w(0x10FFFF, 1) && ok    // the last code point: past every row
    ok = w(0x110000, 1) && ok    // not a code point at all, and still an answer

    // ── search edges ────────────────────────────────────────────────────────
    //
    // For each table: the first row, the middle row (index N/2) and the last,
    // at both ends and one past each end. `WIDTHS`' first row is inside the
    // fast path, so its edges are asked of `table_width` directly.
    //
    // WIDTHS (500 rows): [0x0300, 0x036F] · [0xAA29, 0xAA2E] (row 250) · [0xE0100, 0xE01EF]
    ok = t(0x2FF, 1) && ok
    ok = t(0x300, 0) && ok
    ok = t(0x36F, 0) && ok
    ok = t(0x370, 1) && ok
    ok = w(0xAA28, 1) && ok
    ok = w(0xAA29, 0) && ok
    ok = w(0xAA2E, 0) && ok
    ok = w(0xAA2F, 1) && ok
    ok = w(0xE00FF, 1) && ok
    ok = w(0xE0100, 0) && ok
    ok = w(0xE01EF, 0) && ok
    ok = w(0xE01F0, 1) && ok
    // The last wide row, which is the last row below `BLOCK_FIRST`'s tail:
    // [0x30000, 0x3FFFD] (row 496).
    ok = w(0x2FFFF, 1) && ok
    ok = w(0x30000, 2) && ok
    ok = w(0x3FFFD, 2) && ok
    ok = w(0x3FFFE, 1) && ok
    ok = w(0x40000, 1) && ok
    // A row that crosses a block boundary: [0x3250, 0xA48C] spans blocks 3
    // through 10, and is found from each.
    ok = w(0x324F, 1) && ok
    ok = w(0x3250, 2) && ok
    ok = w(0x3FFF, 2) && ok
    ok = w(0x4000, 2) && ok
    ok = w(0xA000, 2) && ok
    ok = w(0xA48C, 2) && ok
    ok = w(0xA48D, 1) && ok

    // AMBIGUOUS is read only under `AMBIGUOUS_WIDE`, which a test build leaves
    // false, so its edges are asked of the search directly.
    // AMBIGUOUS (179 rows): [0x00A1, 0x00A1] · [0x2190, 0x2199] (row 89) · [0x100000, 0x10FFFD]
    ok = amb(0xA0, false) && ok
    ok = amb(0xA1, true) && ok
    ok = amb(0xA2, false) && ok
    ok = amb(0x218F, false) && ok
    ok = amb(0x2190, true) && ok
    ok = amb(0x2199, true) && ok
    ok = amb(0x219A, false) && ok
    ok = amb(0xFFFFF, false) && ok
    ok = amb(0x100000, true) && ok
    ok = amb(0x10FFFD, true) && ok
    ok = amb(0x10FFFE, false) && ok
    // And the default is what keeps them one column.
    ok = #expect(!AMBIGUOUS_WIDE, "AMBIGUOUS_WIDE defaults to false") && ok
    ok = w(0x2190, 1) && ok

    // `search` is total: rows outside the table answer `missing`.
    ok = #expect(search(0x300, WIDTHS[:], -1, 3, 7) == 7, "search from row -1") && ok
    ok = #expect(search(0x300, WIDTHS[:], 0, 0, 7) == 7, "search of no rows") && ok
    ok = #expect(search(0xE0100, WIDTHS[:], WIDTHS_N - 1, 2, 7) == 7, "search past the last row") && ok

    ok = well_formed(WIDTHS[:], "WIDTHS") && ok
    ok = well_formed(AMBIGUOUS[:], "AMBIGUOUS") && ok

    if ok: return 0
    return 1
