@test
// Each case below states a string byte by byte — `\x` escapes for everything
// past ASCII, so the combining marks are visible in the source instead of
// sitting invisibly on the letter before them — and what `cluster_end`,
// `cluster_width`, `cluster_count` and `cluster_columns` answer for it.
package chars

// `s` is `clusters` clusters taking `columns` columns, and its first cluster
// is `first_bytes` bytes wide and `first_width` columns.
private bool shape(string8 s, string8 name, i32 clusters, i32 columns, i32 first_bytes, i32 first_width):
    bool ok = true
    ok = #expect(cluster_count(s) == clusters, name, ": cluster_count ", cluster_count(s), ", want ", clusters) && ok
    ok = #expect(cluster_columns(s) == columns, name, ": cluster_columns ", cluster_columns(s), ", want ", columns) && ok
    ok = #expect(cluster_end(s, 0) == first_bytes, name, ": cluster_end(0) ", cluster_end(s, 0), ", want ", first_bytes) && ok
    ok = #expect(cluster_width(s, 0) == first_width, name, ": cluster_width(0) ", cluster_width(s, 0), ", want ", first_width) && ok
    return ok

i32 test():
    bool ok = true

    // ASCII: one byte, one column, one cluster per character.
    ok = shape("abc", "ascii", 3, 3, 1, 1) && ok
    ok = #expect(cluster_end("abc", 1) == 2, "ascii cluster_end(1)") && ok

    // e + U+0301 COMBINING ACUTE (CC 81): one cluster, three bytes, one column.
    ok = shape("e\xCC\x81", "e+acute", 1, 1, 3, 1) && ok
    // ...and the letter after it starts the next cluster.
    ok = shape("e\xCC\x81x", "e+acute,x", 2, 2, 3, 1) && ok

    // Vietnamese ế decomposed: e + U+0302 (CC 82) + U+0301 (CC 81). Two marks
    // on one base, five bytes.
    ok = shape("e\xCC\x82\xCC\x81", "e+circumflex+acute", 1, 1, 5, 1) && ok

    // Hebrew shin + U+05C1 shin dot (D7 81) + U+05B8 qamats (D6 B8): the
    // letter is D7 A9, and both points are Mn.
    ok = shape("\xD7\xA9\xD7\x81\xD6\xB8\xD7\x9C", "shin+dot+qamats,lamed", 2, 2, 6, 1) && ok

    // CJK: 日本 (E6 97 A5, E6 9C AC), two wide clusters.
    ok = shape("\xE6\x97\xA5\xE6\x9C\xAC", "cjk", 2, 4, 3, 2) && ok

    // An orphan mark at the start is its own cluster, one column, and the
    // mark after it joins it: U+0301 U+0302 a → [U+0301 U+0302] [a].
    ok = shape("\xCC\x81\xCC\x82a", "orphan at start", 2, 2, 4, 1) && ok
    ok = #expect(display_width("\xCC\x81\xCC\x82a") == 1, "display_width counts the orphan as 0") && ok

    // A mark after '\n' is an orphan, not the newline's accent:
    // a '\n' U+0301 → [a] [\n] [U+0301].
    ok = shape("a\n\xCC\x81", "mark after newline", 3, 2, 1, 1) && ok
    ok = #expect(cluster_end("a\n\xCC\x81", 1) == 2, "newline takes no mark") && ok
    ok = #expect(cluster_width("a\n\xCC\x81", 1) == 0, "newline is zero columns") && ok
    ok = #expect(cluster_width("a\n\xCC\x81", 2) == 1, "the orphan is one column") && ok

    // A tab is a control: its own cluster, zero columns (a grid expands it,
    // and that is the grid's decision, not a width), and it absorbs nothing.
    ok = shape("\t\xCC\x81", "tab then mark", 2, 1, 1, 0) && ok
    // Nor is it absorbed as a mark: a '\t' is two clusters.
    ok = shape("a\t", "letter then tab", 2, 1, 1, 1) && ok

    // CR LF is one cluster; a lone CR or LF is one each; LF CR is two.
    ok = shape("\r\n", "crlf", 1, 0, 2, 0) && ok
    ok = shape("\r", "cr", 1, 0, 1, 0) && ok
    ok = shape("\n\r", "lfcr", 2, 0, 1, 0) && ok
    ok = shape("a\r\nb", "a crlf b", 3, 2, 1, 1) && ok
    ok = #expect(cluster_end("a\r\nb", 1) == 3, "crlf is one cluster mid-text") && ok

    // A lone 0xFF byte decodes to U+FFFD, size 1: a base of one column, which
    // takes the mark after it like any other base.
    ok = shape("\xFF", "lone FF", 1, 1, 1, 1) && ok
    ok = shape("\xFF\xCC\x81", "FF + acute", 1, 1, 3, 1) && ok
    // A truncated sequence (E6 97, missing its last byte) is two U+FFFDs.
    ok = shape("\xE6\x97", "truncated", 2, 2, 1, 1) && ok

    // The empty string: no clusters, and every `at` is the end.
    ok = shape("", "empty", 0, 0, 0, 0) && ok
    ok = #expect(cluster_end("", 5) == 0, "empty cluster_end(5)") && ok

    // `at` clamped: past the end answers the end and zero columns; below
    // zero reads as zero.
    ok = #expect(cluster_end("abc", 3) == 3, "cluster_end at len") && ok
    ok = #expect(cluster_end("abc", 99) == 3, "cluster_end past len") && ok
    ok = #expect(cluster_width("abc", 99) == 0, "cluster_width past len") && ok
    ok = #expect(cluster_end("e\xCC\x81", -4) == 3, "cluster_end below zero") && ok
    ok = #expect(cluster_width("\xE6\x97\xA5", -1) == 2, "cluster_width below zero") && ok
    // `at` inside a sequence: the continuation byte decodes to U+FFFD and is
    // a base, so the walk still moves. 日 at 1 → [97] [A5].
    ok = #expect(cluster_end("\xE6\x97\xA5", 1) == 2, "cluster_end mid-sequence") && ok

    // Emoji are out of scope and not special-cased; this pins what happens.
    // Family = U+1F468 (F0 9F 91 A8) ZWJ (E2 80 8D) U+1F469 (F0 9F 91 A9)
    // ZWJ U+1F467 (F0 9F 91 A7): each person is wide, the ZWJ is zero-width
    // and rides on the person before it, so three clusters of two columns,
    // the first seven bytes long.
    ok = shape("\xF0\x9F\x91\xA8\xE2\x80\x8D\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA7", "family", 3, 6, 7, 2) && ok
    // A variation selector is zero-width and rides too: ☃ U+2603 + U+FE0F
    // (EF B8 8F) is one cluster of one column — the selector asks for emoji
    // presentation and `width` does not follow it.
    ok = shape("\xE2\x98\x83\xEF\xB8\x8F", "snowman+VS16", 1, 1, 6, 1) && ok

    if ok: return 0
    return 1
