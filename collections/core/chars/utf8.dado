// core:chars — UTF-8, and how wide a character is on a terminal.
//
// `chars.dado` is `<ctype.h>` told the truth about, and every one of its
// answers is about one byte. This file is the other half: a `string` is bytes,
// a *character* is one to four of them, and a character occupies zero, one or
// two columns when a terminal draws it.
//
// The three facts worth stating before the code:
//
// **`#len(s)` is bytes and always was.** That is the right answer to the
// question it is asked, and it is the wrong answer to "how wide is this on the
// screen". Both questions are real; `display_width` is the second one.
//
// **Malformed input decodes rather than fails.** `decode` answers U+FFFD and a
// size of one for any byte that cannot begin or continue a sequence, so a walk
// over arbitrary bytes terminates and makes progress. A decoder that returns
// an error here would put a branch in every caller's loop for a case none of
// them can do anything about.
//
// **The width tables are data, not a promise.** They are generated from the
// Unicode Character Database, they say 1 for anything they do not list, and
// they answer per code point — which is what every terminal's own `wcwidth`
// does, and where two terminals disagree no library can be right. Grouping
// code points into what one cell holds is `cluster_end`'s job, on top of
// `width`.
package chars

// U+FFFD, the replacement character — what a malformed sequence decodes to.
// Spelled as a number because there is no `\u` escape: a character literal
// holds one UTF-8 character, and this one is easier to read as its code point.
const u32 REPLACEMENT = 0xFFFD

// Decode one character from `s` beginning at byte `at`.
//
// Answers the code point and **how many bytes it took**, so a walk is
// `at += size`. A size of zero is impossible — `at` past the end answers
// `(0, 0)` and that is the one case a caller tests, because it is the end.
//
// Over-long encodings, surrogates and out-of-range values are rejected as
// malformed and answer `(0xFFFD, 1)`: they decode to *something*, which is
// what keeps the walk going.
(char32 cp, i32 size) decode(string8 s, i32 at):
    i32 n = i32(#len(s))
    if at < 0 || at >= n: return (char32(0), 0)

    u32 b0 = u32(s[at])
    if b0 < 0x80: return (char32(b0), 1)
    if b0 < 0xC2: return (char32(REPLACEMENT), 1)      // continuation, or over-long

    i32 need = 0
    u32 acc = 0
    if b0 < 0xE0:
        need = 1
        acc = b0 & 0x1F
    else if b0 < 0xF0:
        need = 2
        acc = b0 & 0x0F
    else if b0 < 0xF5:
        need = 3
        acc = b0 & 0x07
    else:
        return (char32(REPLACEMENT), 1)

    if at + need >= n: return (char32(REPLACEMENT), 1)
    for k in 1..=need:
        u32 c = u32(s[at + k])
        if (c & 0xC0) != 0x80: return (char32(REPLACEMENT), 1)
        acc = (acc << 6) | (c & 0x3F)

    // An over-long form spells a value in more bytes than it needs: E0 80 AF
    // is '/', and F0 80 80 80 is NUL. Accepting one would let a character
    // hide from any check that looks for its shortest form. The two-byte
    // case was refused above by its lead byte; the three- and four-byte
    // cases can only be seen in the value.
    if need == 2 && acc < 0x800: return (char32(REPLACEMENT), 1)
    if need == 3 && acc < 0x10000: return (char32(REPLACEMENT), 1)

    // Surrogates are not characters, and a value past the last plane is not
    // one either. Both are malformed however well-formed the bytes looked.
    if acc >= 0xD800 && acc <= 0xDFFF: return (char32(REPLACEMENT), 1)
    if acc > 0x10FFFF: return (char32(REPLACEMENT), 1)
    return (char32(acc), need + 1)

// How many bytes `cp` encodes to. Zero for a value that is not a character.
i32 encoded_size(char32 cp):
    u32 v = u32(cp)
    if v < 0x80: return 1
    if v < 0x800: return 2
    if v >= 0xD800 && v <= 0xDFFF: return 0
    if v < 0x10000: return 3
    if v <= 0x10FFFF: return 4
    return 0

// Encode `cp` into `into` at byte `at`. Answers how many bytes were written,
// which is zero if it does not fit or `cp` is not a character — so a caller
// that ignores the answer writes nothing rather than a truncated sequence.
i32 encode(char32 cp, []char8 into, i32 at):
    i32 size = encoded_size(cp)
    if size == 0: return 0
    if at < 0 || at + size > i32(#len(into)): return 0

    u32 v = u32(cp)
    if size == 1:
        into[at] = char8(v)
    else if size == 2:
        into[at] = char8(0xC0 | (v >> 6))
        into[at + 1] = char8(0x80 | (v & 0x3F))
    else if size == 3:
        into[at] = char8(0xE0 | (v >> 12))
        into[at + 1] = char8(0x80 | ((v >> 6) & 0x3F))
        into[at + 2] = char8(0x80 | (v & 0x3F))
    else:
        into[at] = char8(0xF0 | (v >> 18))
        into[at + 1] = char8(0x80 | ((v >> 12) & 0x3F))
        into[at + 2] = char8(0x80 | ((v >> 6) & 0x3F))
        into[at + 3] = char8(0x80 | (v & 0x3F))
    return size

// How many characters are in `s`, as opposed to how many bytes.
i32 count(string8 s):
    i32 n = i32(#len(s))
    i32 at = 0
    i32 total = 0
    for at < n:
        (char32 _, i32 size) = decode(s, at)
        if size == 0: break
        at = at + size
        total = total + 1
    return total

// ── display width ──────────────────────────────────────────────────────────
//
// Zero for a control, a combining mark or a format character; two for the
// East Asian wide and fullwidth characters; one for everything else, which
// includes every unassigned code point outside the blocks Unicode reserves as
// wide. The tables below are generated from the Unicode Character Database
// 17.0.0 (UnicodeData.txt and EastAsianWidth.txt), not maintained by hand:
//
// - `WIDTHS` holds the zero- and two-column ranges, each with its width.
//   Zero is general category Mn, Me or Cf, minus U+00AD, plus U+1160..U+11FF
//   (Hangul medial vowels and final consonants, which fuse into the syllable
//   before them) and U+200B ZERO WIDTH SPACE. Two is East_Asian_Width W or F,
//   reserved code points included where the UCD lists them as W (all of
//   U+20000..U+3FFFD, for instance). Seven code points are both Mn and W
//   (U+302A..U+302D, U+3099..U+309A, U+16FE4) and are zero, because a
//   combining mark that took two columns would push its own base aside.
// - `AMBIGUOUS` holds East_Asian_Width A, read only under `AMBIGUOUS_WIDE`.
//
// Each is sorted and inclusive, and ranges that touch with the same width are
// merged into one. They are `private` package variables rather than `const`s
// because a `const` has no storage — every use is emitted as a compound
// literal of the whole value (read from the emitted C) — and a 500-row table
// has to be one copy in static storage for a lookup to be cheap. Nothing
// writes to them.
//
// **U+00AD SOFT HYPHEN is one column, not zero**, though it is Cf. Terminals
// draw it as a hyphen, glibc's `wcwidth` answers 1 for it, and a zero here
// would put everything after it one column left of where the terminal drew it.
//
// Scripts that shape or reorder (Arabic, the Indic scripts) get an answer per
// code point from these tables like anything else, and it is not a promise
// about what a terminal draws for them: no per-code-point width is.

// East Asian Ambiguous characters — Greek, Cyrillic, box drawing, much of
// Latin-1's punctuation, the private use planes — are one column by default,
// and two under `-D AMBIGUOUS_WIDE=true` (or `-D chars.AMBIGUOUS_WIDE=true`).
// One is the default because two would put every Greek letter and every box
// line at double width in Western text, and a width that followed the locale
// would make the same string measure differently on two machines. A build
// for a CJK legacy terminal, which draws them wide, turns this on.
@const bool AMBIGUOUS_WIDE = false

// [first, last, columns]: every range of zero or two columns.
private const i32 WIDTHS_N = 500
private [WIDTHS_N][3]u32 WIDTHS = [
    [0x0300, 0x036F, 0], [0x0483, 0x0489, 0], [0x0591, 0x05BD, 0],
    [0x05BF, 0x05BF, 0], [0x05C1, 0x05C2, 0], [0x05C4, 0x05C5, 0],
