// Where to start looking in `WIDTHS`, per 4096-code-point block: entry `b` is
// the first row whose last code point is at or past `b << 12`, and entry
// `BLOCKS` is the first row past U+3FFFF (the three rows left there are the
// tag characters and the variation selectors supplement). The row holding a
// `v` in block `b`, if any, is between entries `b` and `b + 1` inclusive —
// anything earlier ends before the block, anything later starts after a row
// that already reaches past it — so a lookup searches at most 107 rows (block
// 0, the Latin through Indic marks), and one row for most of the CJK
// ideographs. Generated with `WIDTHS`, from the same data.
private const i32 BLOCKS = 64
private const i32 BLOCK_ENTRIES = 65     // BLOCKS + 1
private [BLOCK_ENTRIES]u16 BLOCK_FIRST = [
    0, 106, 170, 217, 228, 228, 228, 228, 228, 228, 228, 266, 266,
    266, 267, 267, 279, 294, 392, 392, 394, 394, 394, 403, 403, 406,
    406, 409, 417, 419, 432, 449, 495, 495, 495, 495, 495, 495, 495,
    495, 495, 495, 495, 495, 495, 495, 495, 495, 496, 496, 496, 496,
    496, 496, 496, 496, 496, 496, 496, 496, 496, 496, 496, 496, 497,
]

// The width that rows `first .. first + count - 1` of `table` give `v`, or
// `missing` if none of them holds it. Out-of-range rows answer `missing`.
//
// A binary search that runs ceil(log2 count) halvings with no early exit: the
// one branch in the loop picks a half, which gcc 13 at -O2 compiles to a
// conditional move (read from its output), so the cost does not depend on
// how well the next code point is predicted. `table[lo][0] <= v` holds
// throughout — the test before the loop establishes it.
private i32 search(u32 v, [][3]u32 table, i32 first, i32 count, i32 missing):
    if first < 0 || count <= 0 || first + count > i32(#len(table)): return missing
    i32 lo = first
    i32 n = count
    if v < table[lo][0]: return missing
    for n > 1:
        i32 half = n / 2
        if table[lo + half][0] <= v: lo = lo + half
        n = n - half
    if v <= table[lo][1]: return i32(table[lo][2])
    return missing

// `v`'s width from `WIDTHS`, or 1: the rows `BLOCK_FIRST` names for its block.
private i32 table_width(u32 v):
    i32 b = BLOCKS
    if v < (u32(BLOCKS) << 12): b = i32(v >> 12)
    i32 first = i32(BLOCK_FIRST[b])
    i32 last = WIDTHS_N - 1
    if b < BLOCKS && i32(BLOCK_FIRST[b + 1]) < last: last = i32(BLOCK_FIRST[b + 1])
    return search(v, WIDTHS[:], first, last - first + 1, 1)

// How many columns `cp` occupies: 0, 1 or 2.
//
// A control character (U+0000..U+001F, U+007F..U+009F) is zero, because a
// terminal does not advance the cursor for one — and a library that answered
// one would misplace everything after it on the line.
//
// Below U+0591 no table is read. The only zero-width ranges there are the
// combining diacriticals U+0300..U+036F and the Cyrillic marks U+0483..U+0489,
// nothing is W or F, and the one Cf, U+00AD, is one column by the rule above;
// so ASCII, Latin, Greek and Cyrillic text answers from comparisons. That
// the comparisons agree with `WIDTHS` is checked for every code point from
// U+00A0 to U+0590 by this package's width test. Under `AMBIGUOUS_WIDE` a
// one-column answer from U+00A0 up is looked up in `AMBIGUOUS` as well: 93
// code points below U+0300 alone are ambiguous.
//
// Measured (cloud sandbox, Xeon 2.1 GHz, -O2, 10 million calls): ASCII 2.7
// ns with the old 32-row linear scan and 0.45 ns now under gcc 13, 0.6 and 0.8
// under clang 18. A flat search of these 500 rows lost to that scan on CJK
// (14 ns against 10.5, gcc), which is why `BLOCK_FIRST` exists: 6 ns now.
i32 width(char32 cp):
    u32 v = u32(cp)
    if v < 0x20: return 0
    if v < 0x7F: return 1
    if v < 0xA0: return 0
    i32 w = 1
    if v < 0x591:
        if (v >= 0x300 && v <= 0x36F) || (v >= 0x483 && v <= 0x489): w = 0
    else:
        w = table_width(v)
    if AMBIGUOUS_WIDE && w == 1: w = search(v, AMBIGUOUS[:], 0, AMBIGUOUS_N, 1)
    return w

// How many columns `s` occupies. This is the measurement every layout in a
// terminal actually wants, and `#len` is not it.
i32 display_width(string8 s):
    i32 n = i32(#len(s))
    i32 at = 0
    i32 total = 0
    for at < n:
        (char32 cp, i32 size) = decode(s, at)
        if size == 0: break
        total = total + width(cp)
        at = at + size
    return total

// The byte index just past the last character that fits in `columns` columns.
// A caller clipping a string to a box wants this rather than a byte count,
// because cutting a multi-byte character in half writes a broken sequence to
// the terminal — which most of them draw as a replacement glyph, in the middle
// of otherwise correct output.
i32 fit(string8 s, i32 columns):
    i32 n = i32(#len(s))
    i32 at = 0
    i32 used = 0
    for at < n:
        (char32 cp, i32 size) = decode(s, at)
        if size == 0: break
        i32 w = width(cp)
        if used + w > columns: return at
        used = used + w
        at = at + size
    return n
