// core:chars — clusters: what one cell of a monospace grid holds.
//
// A grid that draws text puts one *cluster* in a cell, or in two for a wide
// one. A cluster here is a base code point and every code point straight after
// it whose `width` is zero — combining marks, ZWJ and ZWNJ, variation
// selectors, the other format characters. So `e` followed by U+0301 is one
// cluster, one column and three bytes, and a cursor that moves by clusters
// never lands between the letter and its accent.
//
// **This is not Unicode's extended grapheme cluster, and is not trying to be.**
// The scripts that need the full rules — Arabic and the other joining scripts,
// the Indic scripts, whose clusters are spacing marks and conjuncts — need
// shaping and reordering too, which no cell grid does; so they are not served,
// and the rules they would need are not here. Emoji sequences are not special
// either: man ZWJ woman ZWJ girl is three clusters of two columns, each ZWJ
// riding on the person before it, which is what a terminal without
// emoji-sequence support draws.
//
// The rules, in order:
//
// - **A control is its own cluster, of zero columns.** A control (U+0000..
//   U+001F, U+007F..U+009F) is zero-width like a mark, but it is not a mark:
//   a tab or a newline is not an accent on the letter before it, and it takes
//   no marks after it either.
// - **CR LF is one cluster.** A cursor stepping by clusters then never stops
//   between the two halves of one line break, and a line counted by
//   clusters counts it once. A lone CR, and a lone LF, are a cluster each.
// - **An orphan mark is a cluster of one column.** A zero-width code point at
//   the start of the text or after a control has no base to sit on, so it is
//   the base: the marks after it join it, and the cluster takes one column —
//   drawn, typically, on a dotted circle or a space — so it can be seen and
//   selected. A width of zero would make it a cell nobody can reach.
// - **Malformed bytes are a base like any other**, because `decode` answers
//   U+FFFD for each of them and U+FFFD is one column.
//
// Every function here takes any `at` and answers: below zero reads as zero,
// at or past the end reads as the end.
package chars

// A C0 or C1 control, or DEL. Kept here and not in `chars.dado`, whose
// predicates are one byte each: this one is about code points.
private bool is_control(u32 v):
    return v < 0x20 || (v >= 0x7F && v < 0xA0)

// The byte index just past the cluster that begins at `at`. `at` at or past
// the end answers `#len(s)`, and anything else answers more than `at`, so a
// walk `at = cluster_end(s, at)` ends and always makes progress.
i32 cluster_end(string8 s, i32 at):
    i32 n = i32(#len(s))
    if at < 0: at = 0
    if at >= n: return n
    (char32 base, i32 size) = decode(s, at)
    i32 end = at + size
    u32 b = u32(base)
    if is_control(b):
        if b == 0x0D && end < n && s[end] == '\n': return end + 1
        return end
    for end < n:
        (char32 cp, i32 k) = decode(s, end)
        u32 v = u32(cp)
        if is_control(v) || width(cp) != 0: break
        end = end + k
    return end

// Columns of the cluster that begins at `at`: its base's `width`, which is 0
// for a control and 1 or 2 otherwise — except an orphan mark, which is 1 (see
// the rules above). The marks after the base add nothing. `at` at or past the
// end answers 0.
i32 cluster_width(string8 s, i32 at):
    i32 n = i32(#len(s))
    if at < 0: at = 0
    if at >= n: return 0
    (char32 base, i32 _) = decode(s, at)
    if is_control(u32(base)): return 0
    i32 w = width(base)
    if w == 0: return 1
    return w

// How many clusters `s` holds: how many cells a grid gives it, counting a
// wide cluster once.
i32 cluster_count(string8 s):
    i32 n = i32(#len(s))
    i32 at = 0
    i32 total = 0
    for at < n:
        at = cluster_end(s, at)
        total = total + 1
    return total

// How many columns `s` takes on a grid: the sum of its clusters' widths. This
// is text measurement for a cell grid — a column count, with no font in it.
// It differs from `display_width` only for an orphan mark, which this counts
// as one column and `display_width` as zero.
i32 cluster_columns(string8 s):
    i32 n = i32(#len(s))
    i32 at = 0
    i32 total = 0
    for at < n:
        total = total + cluster_width(s, at)
        at = cluster_end(s, at)
    return total

// The byte index where the cluster **before** `at` begins — the step a caret
// takes leftwards in logical order. `at` at or below zero answers 0; `at` past
// the end reads as the end. Answers less than `at` for every `at` above zero,
// so a walk `at = cluster_start(s, at)` ends and always makes progress.
//
// It walks backwards over code points rather than forwards from the start of
// the text, so it costs the length of one cluster and not of the text before
// it. The rules are `cluster_end`'s, read from the other side: marks are
// skipped back to the code point they sit on; a control there means the marks
// were orphans and the cluster begins at the first of them; and a CR before an
// LF is part of the LF's cluster.
i32 cluster_start(string8 s, i32 at):
    i32 n = i32(#len(s))
    if at > n: at = n
    if at <= 0: return 0
    i32 p = prev_code_point(s, at)
    (char32 last, i32 _) = decode(s, p)
    u32 lv = u32(last)
    if is_control(lv):
        if lv == 0x0A && p > 0 && s[p - 1] == '\r': return p - 1
        return p
    // Step back over zero-width, non-control code points to what they sit on.
    i32 first_mark = p
    i32 q = p
    for q > 0 && !is_control(lv) && width(last) == 0:
        first_mark = q
        q = prev_code_point(s, q)
        (char32 c, i32 _) = decode(s, q)
        last = c
        lv = u32(c)
    if !is_control(lv) && width(last) != 0: return q
    if is_control(lv) && q < first_mark: return first_mark
    // Reached the start with nothing but marks behind us: an orphan run that
    // begins the text, and a zero-width code point at 0 is the base.
    return q

// The byte index of the code point that ends just before `at`, as a forward
// walk with `decode` would have found it. Back over UTF-8 continuation bytes
// (10xxxxxx), at most three; then the candidate is kept only if `decode` from
// it ends exactly at `at`. Otherwise the byte before `at` was malformed —
// a stray continuation byte, or a sequence cut short — and `decode` reads
// each such byte as its own U+FFFD, so the code point is that one byte.
private i32 prev_code_point(string8 s, i32 at):
    i32 p = at - 1
    i32 steps = 0
    for p > 0 && steps < 3 && (u8(s[p]) & 0xC0) == 0x80:
        p = p - 1
        steps = steps + 1
    (char32 _, i32 size) = decode(s, p)
    if p + size == at: return p
    return at - 1
