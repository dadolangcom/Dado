@test
// `cluster_start` against `cluster_end`: for every string below, walking
// forwards with `cluster_end` finds a list of boundaries, and walking backwards
// with `cluster_start` from the end must find exactly the same list, in
// reverse. Checking the inverse rather than hand-written answers is what makes
// a malformed or mark-heavy string cheap to add.
package chars

private const i32 MAX_BOUNDS = 64

private bool round_trip(string8 s, string8 name):
    [64]i32 fwd
    i32 nf = 0
    i32 at = 0
    i32 n = i32(#len(s))
    fwd[0] = 0
    nf = 1
    for at < n && nf < MAX_BOUNDS:
        at = cluster_end(s, at)
        fwd[nf] = at
        nf = nf + 1
    bool ok = true
    i32 k = nf - 1
    i32 back = n
    for k > 0:
        i32 prev = cluster_start(s, back)
        ok = #expect(prev == fwd[k - 1], name, ": cluster_start(", back, ") = ", prev, ", forward walk says ", fwd[k - 1]) && ok
        back = prev
        k = k - 1
    ok = #expect(cluster_start(s, 0) == 0, name, ": cluster_start(0)") && ok
    return ok

i32 test():
    bool ok = true
    ok = round_trip("", "empty") && ok
    ok = round_trip("abc", "ascii") && ok
    ok = round_trip("e\xCC\x81x", "e+acute,x") && ok
    ok = round_trip("e\xCC\x82\xCC\x81", "e+two marks") && ok
    ok = round_trip("\xD7\xA9\xD7\x81\xD6\xB8", "hebrew shin+dot+qamats") && ok
    ok = round_trip("\xE6\x97\xA5\xE6\x9C\xAC", "cjk") && ok
    ok = round_trip("\xCC\x81\xCC\x81a", "orphan marks at start") && ok
    ok = round_trip("a\n\xCC\x81b", "orphan mark after newline") && ok
    ok = round_trip("a\r\nb", "crlf") && ok
    ok = round_trip("a\r\r\nb\n", "cr then crlf") && ok
    ok = round_trip("\ta\t", "tabs") && ok
    ok = round_trip("a\x80\x80b", "stray continuations") && ok
    ok = round_trip("\xE6\x97x", "truncated sequence") && ok
    ok = round_trip("\xFF\xCC\x81", "bad byte then mark") && ok
    ok = round_trip("a\xE0\x80\xAFb", "overlong slash") && ok
    ok = round_trip("\xF0\x9F\x91\xA8\xE2\x80\x8D\xF0\x9F\x91\xA9", "zwj sequence") && ok
    // Past the end reads as the end.
    ok = #expect(cluster_start("ab", 99) == 1, "past end") && ok
    ok = #expect(cluster_start("ab", -5) == 0, "negative") && ok
    if ok: return 0
    return 1
