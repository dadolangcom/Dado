@test
// The byte predicates are comparisons over ASCII, and the only thing a
// comparison can get wrong is its boundary: an off-by-one in a class, or a
// `<` that should have been `<=`.
//
// So every claim below is written at an **edge** — the last byte outside a class
// and the first byte inside it — rather than in the middle, where every plausible
// mistake still passes. `is_alpha('m')` is true under any implementation anybody
// would write by accident; `is_alpha('`')` and `is_alpha('a')` together are what
// pin the boundary at 0x61.
//
// The bytes are named by their literals and their codes are written beside them,
// because ASCII adjacency is the whole argument and a reader should not have to
// remember that '/' is 0x2F and ':' is 0x3A.
package chars

i32 test():
    bool ok = true

    // ── is_alpha ─────────────────────────────────────────────────────────────
    //
    // Two runs, four edges. 0x40 '@' / 0x41 'A', 0x5A 'Z' / 0x5B '[', and
    // 0x60 '`' / 0x61 'a', 0x7A 'z' / 0x7B '{'.
    ok = #expect(!is_alpha('@'), "is_alpha('@') 0x40 was true") && ok
    ok = #expect(is_alpha('A'), "is_alpha('A') 0x41 was false") && ok
    ok = #expect(is_alpha('Z'), "is_alpha('Z') 0x5A was false") && ok
    ok = #expect(!is_alpha('['), "is_alpha('[') 0x5B was true") && ok
    ok = #expect(!is_alpha('`'), "is_alpha('`') 0x60 was true") && ok
    ok = #expect(is_alpha('a'), "is_alpha('a') 0x61 was false") && ok
    ok = #expect(is_alpha('z'), "is_alpha('z') 0x7A was false") && ok
    ok = #expect(!is_alpha('{'), "is_alpha('{') 0x7B was true") && ok
    // A digit is not a letter, which is the one confusion `is_alnum` exists for.
    ok = #expect(!is_alpha('5'), "is_alpha('5') was true") && ok

    // ── is_digit ─────────────────────────────────────────────────────────────
    //
    // 0x2F '/' / 0x30 '0', and 0x39 '9' / 0x3A ':'.
    ok = #expect(!is_digit('/'), "is_digit('/') 0x2F was true") && ok
    ok = #expect(is_digit('0'), "is_digit('0') 0x30 was false") && ok
    ok = #expect(is_digit('9'), "is_digit('9') 0x39 was false") && ok
    ok = #expect(!is_digit(':'), "is_digit(':') 0x3A was true") && ok
    // Hex digits are digits to a reader and not to `is_digit`. Worth pinning:
    // a program that assumed otherwise would be wrong on exactly this byte.
    ok = #expect(!is_digit('a'), "is_digit('a') was true") && ok

    // ── is_alnum ─────────────────────────────────────────────────────────────
    //
    // The union, and it is claimed *as* the union: for each of these bytes,
    // `is_alnum` agrees with `is_alpha || is_digit`. That is a stronger claim
    // than six separate expectations, and it is the one that catches a wrapper
    // wired to the wrong C function.
    ok = #expect(is_alnum('0') == (is_alpha('0') || is_digit('0')), "is_alnum('0') disagreed with the union") && ok
    ok = #expect(is_alnum('a') == (is_alpha('a') || is_digit('a')), "is_alnum('a') disagreed with the union") && ok
    ok = #expect(is_alnum('Z') == (is_alpha('Z') || is_digit('Z')), "is_alnum('Z') disagreed with the union") && ok
    ok = #expect(is_alnum('_') == (is_alpha('_') || is_digit('_')), "is_alnum('_') disagreed with the union") && ok
    ok = #expect(!is_alnum(' '), "is_alnum(' ') was true") && ok

    // ── is_space ─────────────────────────────────────────────────────────────
    //
    // C's six: space, `\t`, `\n`, `\v`, `\f`, `\r`. The vertical tab and the
    // form feed are written as their codes because they are the two nobody
    // remembers are in the class, and they are exactly where a hand-rolled
    // `c == ' ' || c == '\t' || c == '\n'` diverges from C's `isspace`.
    ok = #expect(is_space(' '), "is_space(' ') was false") && ok
    ok = #expect(is_space('\t'), "is_space(tab) was false") && ok
    ok = #expect(is_space('\n'), "is_space(newline) was false") && ok
    ok = #expect(is_space('\r'), "is_space(CR) was false") && ok
    ok = #expect(is_space(char8(11)), "is_space(0x0B vertical tab) was false") && ok
    ok = #expect(is_space(char8(12)), "is_space(0x0C form feed) was false") && ok
    // 0x0D is the last of the run and 0x0E is the first byte past it.
    ok = #expect(!is_space(char8(14)), "is_space(0x0E) was true") && ok
    ok = #expect(!is_space('0'), "is_space('0') was true") && ok
    // The NUL byte is not whitespace, which matters because C puts one at
    // the end of every string and a trimming loop reads it.
    ok = #expect(!is_space(char8(0)), "is_space(NUL) was true") && ok

    // ── is_upper / is_lower ──────────────────────────────────────────────────
    //
    // Disjoint, and each the other's edge. The four boundary bytes again,
    // because a wrapper that reached `isalpha` for both would pass every claim
    // made only in the middle of a run.
    ok = #expect(is_upper('A') && is_upper('Z'), "is_upper missed an end of A..Z") && ok
    ok = #expect(!is_upper('@') && !is_upper('['), "is_upper reached past A..Z") && ok
    ok = #expect(!is_upper('a'), "is_upper('a') was true") && ok
    ok = #expect(is_lower('a') && is_lower('z'), "is_lower missed an end of a..z") && ok
    ok = #expect(!is_lower('`') && !is_lower('{'), "is_lower reached past a..z") && ok
    ok = #expect(!is_lower('A'), "is_lower('A') was true") && ok
    ok = #expect(!(is_upper('5') || is_lower('5')), "a digit was cased") && ok

    // ── is_punct ─────────────────────────────────────────────────────────────
    //
    // C's definition and not the intuitive one: printable, not a space, not
    // alphanumeric. So `' '` is **not** punctuation — the trap this claim is
    // here for — and `'_'` and `'~'` are.
    ok = #expect(is_punct('!'), "is_punct('!') was false") && ok
    ok = #expect(is_punct('_'), "is_punct('_') was false") && ok
    ok = #expect(is_punct('~'), "is_punct('~') 0x7E was false") && ok
    ok = #expect(!is_punct(' '), "is_punct(' ') was true: space is not punctuation in C") && ok
    ok = #expect(!is_punct('a'), "is_punct('a') was true") && ok
    ok = #expect(!is_punct('0'), "is_punct('0') was true") && ok

    // ── is_print ─────────────────────────────────────────────────────────────
    //
    // The printable run is 0x20..0x7E inclusive, and both ends are named: the
    // space is *in* it and DEL is not, which is the pair that catches a `<` that
    // should have been `<=`.
    ok = #expect(is_print(' '), "is_print(' ') 0x20 was false") && ok
    ok = #expect(is_print('~'), "is_print('~') 0x7E was false") && ok
    ok = #expect(!is_print(char8(127)), "is_print(0x7F DEL) was true") && ok
    ok = #expect(!is_print('\n'), "is_print(newline) was true") && ok
    ok = #expect(!is_print(char8(0)), "is_print(NUL) was true") && ok

    // ── upper / lower ────────────────────────────────────────────────────────
    //
    // Three properties rather than a table of pairs. A table would be a longer
    // way of saying the same thing about the same 26 letters; these say
    // something about *every* byte the loop below visits.
    ok = #expect(upper('a') == 'A', "upper('a') was ", upper('a')) && ok
    ok = #expect(lower('A') == 'a', "lower('A') was ", lower('A')) && ok
    // Non-letters pass through untouched, which is the case a naive `c - 32`
    // gets wrong and gets wrong silently.
    ok = #expect(upper('5') == '5', "upper('5') was ", upper('5')) && ok
    ok = #expect(lower('5') == '5', "lower('5') was ", lower('5')) && ok
    ok = #expect(upper('[') == '[', "upper('[') was ", upper('[')) && ok
    ok = #expect(lower('`') == '`', "lower('`') was ", lower('`')) && ok
    // Idempotence: a byte already upper is unchanged by `upper`.
    ok = #expect(upper(upper('a')) == upper('a'), "upper was not idempotent") && ok
    ok = #expect(lower(lower('A')) == lower('A'), "lower was not idempotent") && ok

    // The whole printable range, as one sweep. `upper` and `lower` are each
    // other's inverse **on the cased bytes only**, and are the identity on the
    // rest — which is one claim that holds for 95 bytes, and the shape of
    // property the per-byte expectations above cannot make.
    for code in 32..<127:
        char8 c = char8(code)
        if is_lower(c):
            ok = #expect(is_upper(upper(c)), "upper(", c, ") was not upper") && ok
            ok = #expect(lower(upper(c)) == c, "lower(upper(", c, ")) moved") && ok
        else:
            if !is_upper(c):
                // Not cased at all, so both are the identity.
                ok = #expect(upper(c) == c, "upper(", c, ") moved an uncased byte") && ok
                ok = #expect(lower(c) == c, "lower(", c, ") moved an uncased byte") && ok

    // An invariant rather than an expectation: if the alphabet were not 26
    // letters wide the *package* would be describing a different alphabet, and
    // there would be nothing to carry on for.
    i32 letters = 0
    for code in 0..<128:
        if is_alpha(char8(code)):
            letters = letters + 1
    #assert(letters == 52, "the printable alphabet held ", letters, " letters, not 52")

    // ── is_xdigit / digit_value ──────────────────────────────────────────────
    //
    // The three runs' edges: 0x2F '/' / '0', '9' / ':', '`' / 'a', 'f' / 'g',
    // '@' / 'A', 'F' / 'G'.
    ok = #expect(!is_xdigit('/') && is_xdigit('0') && is_xdigit('9') && !is_xdigit(':'), "is_xdigit's digit edges") && ok
    ok = #expect(!is_xdigit('`') && is_xdigit('a') && is_xdigit('f') && !is_xdigit('g'), "is_xdigit's lower edges") && ok
    ok = #expect(!is_xdigit('@') && is_xdigit('A') && is_xdigit('F') && !is_xdigit('G'), "is_xdigit's upper edges") && ok
    ok = #expect(digit_value('0') == 0 && digit_value('9') == 9, "digit_value of the decimal digits") && ok
    ok = #expect(digit_value('a') == 10 && digit_value('F') == 15, "digit_value of the hex letters") && ok
    ok = #expect(digit_value('g') == -1 && digit_value(' ') == -1, "digit_value of a non-digit") && ok
    for code in 0..<256:
        char8 c = char8(code)
        ok = #expect(is_xdigit(c) == (digit_value(c) >= 0), "is_xdigit and digit_value disagree on ", code) && ok

    // ── is_cntrl / is_graph / is_ascii ───────────────────────────────────────
    //
    // 0x1F / 0x20 and 0x7E / 0x7F split the controls from the printable run,
    // and `is_graph` is `is_print` without the space.
    ok = #expect(is_cntrl(char8(0)) && is_cntrl(char8(31)) && !is_cntrl(' ') && !is_cntrl('~') && is_cntrl(char8(127)), "is_cntrl's edges") && ok
    ok = #expect(!is_graph(' ') && is_graph('!') && is_graph('~') && !is_graph(char8(127)), "is_graph's edges") && ok
    ok = #expect(is_ascii(char8(127)) && !is_ascii(char8(128)), "is_ascii's edge") && ok
    for code in 0..<128:
        char8 c = char8(code)
        ok = #expect(is_print(c) != is_cntrl(c), "an ASCII byte was both or neither printable and a control: ", code) && ok
        ok = #expect(is_graph(c) == (is_print(c) && c != ' '), "is_graph is not is_print without the space at ", code) && ok

    // ── the bytes from 0x80 up ───────────────────────────────────────────────
    //
    // Every one of them is outside every class and untouched by the case
    // mapping: they are bytes of multi-byte characters, and a locale that
    // would have said otherwise is not consulted.
    for code in 128..<256:
        char8 c = char8(code)
        bool any = is_alpha(c) || is_digit(c) || is_xdigit(c) || is_alnum(c) || is_space(c)
        any = any || is_upper(c) || is_lower(c) || is_punct(c) || is_print(c) || is_graph(c) || is_cntrl(c)
        ok = #expect(!any, "the byte ", code, " was in an ASCII class") && ok
        ok = #expect(upper(c) == c && lower(c) == c, "the byte ", code, " was case-mapped") && ok

    if ok:
        return 0
    return 1
