@test
package chars

i32 test():
    bool ok = true
    (char32 a, i32 an) = decode("A", 0)
    ok = #expect(an == 1, "ascii size ", an) && ok
    ok = #expect(u32(a) == 65, "ascii cp ", u32(a)) && ok
    (char32 s, i32 sn) = decode("☃", 0)
    ok = #expect(sn == 3, "snow size ", sn) && ok
    ok = #expect(u32(s) == 0x2603, "snow cp ", u32(s)) && ok
    ok = #expect(display_width("abc") == 3, "abc") && ok
    ok = #expect(display_width("日本語") == 6, "cjk ", display_width("日本語")) && ok
    ok = #expect(count("日本語") == 3, "cjk count") && ok
    ok = #expect(fit("日本語", 4) == 6, "fit ", fit("日本語", 4)) && ok
    // Over-long three- and four-byte forms are malformed: each lead byte
    // decodes alone as U+FFFD, like any other malformed start.
    (char32 o3, i32 o3n) = decode("\xE0\x80\xAF", 0)
    ok = #expect(u32(o3) == REPLACEMENT && o3n == 1, "overlong 3-byte '/' ", u32(o3), " ", o3n) && ok
    (char32 o4, i32 o4n) = decode("\xF0\x80\x80\xAF", 0)
    ok = #expect(u32(o4) == REPLACEMENT && o4n == 1, "overlong 4-byte '/' ", u32(o4), " ", o4n) && ok
    // ...and the shortest forms at each boundary still decode.
    (char32 m3, i32 m3n) = decode("\xE0\xA0\x80", 0)
    ok = #expect(u32(m3) == 0x800 && m3n == 3, "U+0800 ", u32(m3)) && ok
    (char32 m4, i32 m4n) = decode("\xF0\x90\x80\x80", 0)
    ok = #expect(u32(m4) == 0x10000 && m4n == 4, "U+10000 ", u32(m4)) && ok
    if ok: return 0
    return 1
