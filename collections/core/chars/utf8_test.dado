@test
package chars

i32 test():
    bool ok = true
    (char32 a, i64 an) = decode("A", 0)
    ok = #expect(an == 1, "ascii size ", an) && ok
    ok = #expect(u32(a) == 65, "ascii cp ", u32(a)) && ok
    (char32 s, i64 sn) = decode("☃", 0)
    ok = #expect(sn == 3, "snow size ", sn) && ok
    ok = #expect(u32(s) == 0x2603, "snow cp ", u32(s)) && ok
    ok = #expect(display_width("abc") == 3, "abc") && ok
    ok = #expect(display_width("日本語") == 6, "cjk ", display_width("日本語")) && ok
    ok = #expect(count("日本語") == 3, "cjk count") && ok
    ok = #expect(fit("日本語", 4) == 6, "fit ", fit("日本語", 4)) && ok
    // Over-long three- and four-byte forms are malformed: each lead byte
    // decodes alone as U+FFFD, like any other malformed start.
    (char32 o3, i64 o3n) = decode("\xE0\x80\xAF", 0)
    ok = #expect(o3 == REPLACEMENT && o3n == 1, "overlong 3-byte '/' ", u32(o3), " ", o3n) && ok
    (char32 o4, i64 o4n) = decode("\xF0\x80\x80\xAF", 0)
    ok = #expect(o4 == REPLACEMENT && o4n == 1, "overlong 4-byte '/' ", u32(o4), " ", o4n) && ok
    // ...and the shortest forms at each boundary still decode.
    (char32 m3, i64 m3n) = decode("\xE0\xA0\x80", 0)
    ok = #expect(u32(m3) == 0x800 && m3n == 3, "U+0800 ", u32(m3)) && ok
    (char32 m4, i64 m4n) = decode("\xF0\x90\x80\x80", 0)
    ok = #expect(u32(m4) == 0x10000 && m4n == 4, "U+10000 ", u32(m4)) && ok
    // `valid` refuses what `decode` reads as a malformed U+FFFD, and accepts
    // a U+FFFD written out properly.
    ok = #expect(valid("") && valid("abc") && valid("日本語"), "valid text was refused") && ok
    ok = #expect(valid("\xEF\xBF\xBD"), "a well-formed U+FFFD was refused") && ok
    ok = #expect(!valid("a\x80b"), "a stray continuation byte was valid") && ok
    ok = #expect(!valid("\xE6\x97"), "a cut-short sequence was valid") && ok
    ok = #expect(!valid("\xE0\x80\xAF"), "an over-long form was valid") && ok

    // Walking backwards visits what walking forwards does, last first.
    string8 mixed = "a日\x80☃b"
    i64 at = #len(mixed)
    i32 seen = 0
    [8]u32 back
    for at > 0:
        (char32 cp, i64 size) = decode_last(mixed, at)
        ok = #expect(size > 0 && prev_start(mixed, at) == at - size, "decode_last and prev_start disagree at ", at) && ok
        back[seen] = u32(cp)
        seen = seen + 1
        at = at - size
    ok = #expect(seen == 5, "the backwards walk saw ", seen, " code points, not 5") && ok
    ok = #expect(back[0] == 98 && back[1] == 0x2603 && back[2] == u32(REPLACEMENT) && back[3] == 0x65E5 && back[4] == 97, "the backwards walk read the wrong code points") && ok
    ok = #expect(prev_start(mixed, 0) == 0 && prev_start(mixed, 99) == prev_start(mixed, #len(mixed)), "prev_start's clamps") && ok
    (char32 z, i64 zn) = decode_last(mixed, 0)
    ok = #expect(u32(z) == 0 && zn == 0, "decode_last at 0 was not (0, 0)") && ok
    // Bytes held as `[]u8` decode as the text they view, at every offset.
    string8 text = "a日\x80☃b\xE6\x97"
    []u8 raw = Bytes(text)
    for i in 0..<#len(text):
        (char32 dc, i64 dn) = decode(text, i)
        (char32 bc, i64 bn) = decode(string8(raw), i)
        ok = #expect(dc == bc && dn == bn, "a []u8 viewed as text decodes differently at ", i) && ok
    (char32 past, i64 pn) = decode(string8(raw), 99)
    ok = #expect(u32(past) == 0 && pn == 0, "decode past the end of a viewed []u8") && ok

    // ── encode and encoded_size ──────────────────────────────────────────────
    //
    // Each width's first and last code point, the surrogates and the value past
    // the last plane (which encode to nothing), and the room in `into`: a
    // sequence that does not fit whole is not written at all.
    ok = #expect(encoded_size(char32(0)) == 1 && encoded_size(char32(0x7F)) == 1, "one-byte sizes") && ok
    ok = #expect(encoded_size(char32(0x80)) == 2 && encoded_size(char32(0x7FF)) == 2, "two-byte sizes") && ok
    ok = #expect(encoded_size(char32(0x800)) == 3 && encoded_size(char32(0xFFFF)) == 3, "three-byte sizes") && ok
    ok = #expect(encoded_size(char32(0x10000)) == 4 && encoded_size(char32(0x10FFFF)) == 4, "four-byte sizes") && ok
    ok = #expect(encoded_size(char32(0xD800)) == 0 && encoded_size(char32(0xDFFF)) == 0, "a surrogate had a size") && ok
    ok = #expect(encoded_size(char32(0x110000)) == 0, "a value past the last plane had a size") && ok
    ok = #expect(encoded_size(REPLACEMENT) == 3, "U+FFFD is three bytes") && ok

    [8]char8 into
    [5]u32 cps = [0x41, 0xE9, 0x2603, 0x1F600, 0x10FFFF]
    for v in cps:
        i64 wrote = encode(char32(v), into[:], 1)
        ok = #expect(wrote == encoded_size(char32(v)), "encode of ", v, " wrote ", wrote) && ok
        string8 back_text = string8(into[1..<(1 + wrote)])
        (char32 round, i64 rn) = decode(back_text, 0)
        ok = #expect(round == char32(v) && rn == wrote, "encode of ", v, " did not decode back") && ok
    i64 sw = encode(char32(0x2603), into[:], 0)
    string8 snow = string8(into[0..<sw])
    ok = #expect(snow == "☃", "encode of U+2603 wrote the wrong bytes") && ok
    // No room: three bytes asked at 6 of 8, and a negative offset.
    into[6] = 'x'
    ok = #expect(encode(char32(0x2603), into[:], 6) == 0, "a sequence that did not fit was written") && ok
    ok = #expect(into[6] == 'x', "a sequence that did not fit wrote a byte") && ok
    ok = #expect(encode(char32(0x41), into[:], 8) == 0 && encode(char32(0x41), into[:], 0 - 1) == 0, "encode out of bounds") && ok
    ok = #expect(encode(char32(0x41), into[:], 7) == 1, "one byte at the last index") && ok
    ok = #expect(encode(char32(0xD800), into[:], 0) == 0, "a surrogate was encoded") && ok
    if ok: return 0
    return 1

// Text viewed as bytes, as a reader holding `[]u8` has it.
private type Bytes: []u8
