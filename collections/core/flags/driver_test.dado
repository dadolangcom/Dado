@test
// The acceptance test: the whole command line of the toolchain's driver,
// `dado` — its ten verbs, the flags its shared loop accepts for `build`,
// `run`, `check`, `emit` and `test`, and the flags of `fmt` and `doc` —
// declared once, then a run of invocations it accepts, read back typed, and
// the spellings it refuses on purpose, refused: `--target=` and
// `--sanitize=` with any other value, and `--manifest` and `--base` without
// their `=`.
package flags

import "core:strings"

private const string8 SHARED = "build run check emit test"

private ref []string8 words(string8 line):
    ref []string8 out = #make([]string8, 0)
    i64 at = 0
    for at < #len(line):
        (i64 start, i64 stop) = next_word(line, at)
        if start == stop:
            break
        _ = #append(out, line[start..<stop])
        at = stop
    return out

// The driver's declarations, and the handles a test reads.
private type Dado:
    Parser p
    TextFlag out
    ListFlag libs
    ListFlag defines
    ListFlag pass
    TextFlag passes
    TextFlag cc
    BoolFlag no_c
    BoolFlag debug
    BoolFlag no_werror
    BoolFlag no_lines
    TextFlag sanitize
    BoolFlag no_sanitize
    BoolFlag lenient
    BoolFlag link
    TextFlag target
    TextFlag manifest
    BoolFlag web_threads
    BoolFlag release
    TextFlag html
    TextFlag base
    TextFlag shader
    BoolFlag no_assert
    BoolFlag no_expect
    TextFlag emit
    TextFlag filter
    TextFlag shard
    BoolFlag verbose
    TextFlag pkg
    ListFlag args
    BoolFlag check
    ListFlag files
    TextFlag doc_out
    TextFlag spine
    TextFlag ext
    TextFlag captions
    TextFlag what
    ListFlag paths

private Dado declare():
    Dado d
    d.p = parser("dado", "The Dado toolchain: build, run and test Dado packages.")
    ^Parser p = &d.p
    p.command("build", "transpile a package and compile it")
    p.command("run", "build a package, then run it with the arguments after --")
    p.command("check", "check a package without compiling it")
    p.command("emit", "print one compiler phase for a package")
    p.command("test", "build and run a package's @test files")
    p.command("fmt", "format files in place")
    p.command("doc", "document a package, the language reference, or parameter lines")
    p.command("clean", "remove the build directory")
    p.command("where", "print where the toolchain's parts are")
    p.command("help", "")
    // The shared loop, in the inventory's order.
    d.out = p.text("-o", "PATH", "the output path", "", SHARED)
    d.libs = p.list("-l", "NAME", "link a library", SHARED)
    d.defines = p.list("-D", "NAME=VALUE", "replace a @const", SHARED)
    d.pass = p.list("--pass", "=NAME=on|off", "turn one optimisation pass on or off", SHARED)
    d.passes = p.choice("--passes", "=off|default", "every optimisation pass off, or the default set", "", SHARED)
    d.cc = p.text("--cc", "PROG", "the C compiler (default: $CC, else clang, cc or gcc)", "", SHARED)
    _ = p.boolean("--keep-c", "", SHARED)
    d.no_c = p.boolean("--no-c", "delete the generated C after a successful compile", SHARED)
    d.debug = p.boolean("--debug", "compile with -g -O0 rather than -O2", SHARED)
    d.no_werror = p.boolean("--no-werror", "do not treat C warnings as errors", SHARED)
    d.no_lines = p.boolean("--no-line-directives", "do not map the C back to the Dado source", SHARED)
    d.sanitize = p.choice("--sanitize", "[=address|thread]", "build under the sanitizers (on for test)", "", SHARED)
    d.no_sanitize = p.boolean("--no-sanitize", "build without the sanitizers", SHARED)
    d.lenient = p.boolean("--lenient", "drop --strict", SHARED)
    d.link = p.boolean("--link", "link a freestanding build anyway", SHARED)
    d.target = p.choice("--target", "=web|js", "build for the web, or as a JS library (other targets: DADO_TARGET)", "", SHARED)
    d.manifest = p.text("--manifest", "=LIST", "write the manifest and the extensions LIST names", "", SHARED)
    d.web_threads = p.boolean("--web-threads", "a threaded web module", SHARED)
    d.release = p.boolean("--release", "transpile for release", SHARED)
    d.html = p.text("--html", "[=PATH]", "the web page's template", "", SHARED)
    d.base = p.text("--base --html-base", "=PREFIX", "the web page's <base href>", "", SHARED)
    d.shader = p.text("--shader", "=LIST", "shader stages, passed to the compiler", "", SHARED)
    d.no_assert = p.boolean("--no-assert", "strip #assert", SHARED)
    d.no_expect = p.boolean("--no-expect", "strip #expect", SHARED)
    d.emit = p.text("--emit", "=PHASE", "the phase emit prints", "", SHARED)
    d.filter = p.text("--filter", "SUBSTR", "test only the files whose name holds SUBSTR", "", SHARED)
    d.shard = p.text("--shard", "K/N", "test only slice K of N", "", SHARED)
    d.verbose = p.boolean("-v --verbose", "echo each command", SHARED)
    d.pkg = p.positional("PKG", "the package directory", false, SHARED)
    d.args = p.tail("ARGS", "the program's arguments", "run")
    // `fmt`'s and `doc`'s own.
    d.check = p.boolean("--check", "write nothing; list the files that would change", "fmt")
    d.files = p.rest("FILE", "the files to format", "fmt")
    d.doc_out = p.text("-o", "FILE", "the document to write", "", "doc")
    d.spine = p.text("--spine", "FILE", "the spine document", "", "doc")
    d.ext = p.text("--ext", "SUFFIX", "the suffix of the files to read", ".dado", "doc")
    d.captions = p.text("--captions", "FILE", "the reference's captions", "", "doc")
    d.what = p.positional("WHAT", "a package directory, `reference` or `params`", true, "doc")
    d.paths = p.rest("PATH", "the paths `params` reads", "doc")
    return d

private bool accepts(^Dado d, string8 line, string8 command):
    ref []string8 args = words(line)
    defer #delete(args)
    try string8 got = d.p.parse(args[:]) else code:
        return #expect(false, "`dado ", line, "` failed with ", code, ": ", d.p.error())
    return #expect(got == command, "`dado ", line, "` chose `", got, "`")

private bool refuses(^Dado d, string8 line, i32 code, string8 repair):
    ref []string8 args = words(line)
    defer #delete(args)
    try string8 got = d.p.parse(args[:]) else failed:
        bool ok = #expect(failed == code, "`dado ", line, "` failed with ", failed, ", not ", code, ": ", d.p.error())
        return #expect(strings.contains(d.p.error(), repair), "`dado ", line, "`: `", d.p.error(), "` does not say `", repair, "`") && ok
    return #expect(false, "`dado ", line, "` was accepted (", got, ")")

private bool is(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is `", got, "`, not `", want, "`")

private bool list_is([]string8 got, string8 want, string8 what):
    ref []char8 joined = strings.join(got, " ")
    defer #delete(joined)
    return #expect(string8(joined[:]) == want, what, " is `", string8(joined[:]), "`, not `", want, "`")

// Every line of `text` fits 80 columns.
private bool fits(ref []char8 text, string8 what):
    string8 t = string8(text[:])
    bool ok = true
    i64 start = 0
    for i in 0..=#len(t):
        if i == #len(t) || t[i] == '\n':
            ok = #expect(i - start <= 80, what, ": a line of ", i - start, " columns: ", t[start..<i]) && ok
            start = i + 1
    #delete(text)
    return ok

i32 test():
    bool ok = true
    Dado d = declare()
    defer d.p.destroy()

    // ── the brief's three ─────────────────────────────────────────────────
    ok = accepts(&d, "test collections/core/os --cc clang --filter fs -D X=1 -D Y=2", "test") && ok
    ok = is(d.p.value(d.pkg), "collections/core/os", "test's package") && ok
    ok = is(d.p.value(d.cc), "clang", "--cc") && ok
    ok = is(d.p.value(d.filter), "fs", "--filter") && ok
    ok = list_is(d.p.values(d.defines), "X=1 Y=2", "-D") && ok

    ok = accepts(&d, "run corpus/tour -- a b --c", "run") && ok
    ok = is(d.p.value(d.pkg), "corpus/tour", "run's package") && ok
    ok = list_is(d.p.values(d.args), "a b --c", "run's arguments") && ok

    ok = accepts(&d, "build pkg --target=web --html=page.html --release -o out", "build") && ok
    ok = is(d.p.value(d.target), "web", "--target") && ok
    ok = is(d.p.value(d.html), "page.html", "--html=") && ok
    ok = #expect(d.p.on(d.release), "--release") && ok
    ok = is(d.p.value(d.out), "out", "-o") && ok

    // ── more of what the gate, the tools and the scripts write ───────────
    ok = accepts(&d, "test pkg --shard 2/4 --sanitize=thread --no-werror", "test") && ok
    ok = is(d.p.value(d.shard), "2/4", "--shard") && ok
    ok = is(d.p.value(d.sanitize), "thread", "--sanitize=thread") && ok
    ok = #expect(d.p.on(d.no_werror), "--no-werror") && ok

    ok = accepts(&d, "test --sanitize --debug corpus", "test") && ok
    ok = is(d.p.value(d.sanitize), "address", "--sanitize alone") && ok
    ok = #expect(d.p.on(d.debug), "--debug") && ok

    ok = accepts(&d, "check pkg --lenient -v", "check") && ok
    ok = #expect(d.p.on(d.lenient) && d.p.on(d.verbose), "--lenient -v") && ok

    ok = accepts(&d, "emit pkg --emit=c -DNAME=1 --pass=inline=off --passes=off", "emit") && ok
    ok = is(d.p.value(d.emit), "c", "--emit=") && ok
    ok = list_is(d.p.values(d.defines), "NAME=1", "-DNAME=1") && ok
    ok = list_is(d.p.values(d.pass), "inline=off", "--pass=") && ok
    ok = is(d.p.value(d.passes), "off", "--passes=") && ok

    ok = accepts(&d, "build pkg --manifest=h,dts --target=js", "build") && ok
    ok = is(d.p.value(d.manifest), "h,dts", "--manifest=") && ok
    ok = is(d.p.value(d.target), "js", "--target=js") && ok

    ok = accepts(&d, "build pkg -lm -l pthread --web-threads --base=/app/ --shader=vs,fs", "build") && ok
    ok = list_is(d.p.values(d.libs), "m pthread", "-l") && ok
    ok = #expect(d.p.on(d.web_threads), "--web-threads") && ok
    ok = is(d.p.value(d.base), "/app/", "--base=") && ok
    ok = is(d.p.value(d.shader), "vs,fs", "--shader=") && ok

    ok = accepts(&d, "build --html-base=/old/ pkg", "build") && ok
    ok = is(d.p.value(d.base), "/old/", "--html-base=, the old spelling") && ok

    ok = accepts(&d, "run --target=web --html pkg", "run") && ok
    ok = #expect(d.p.given(d.html) && d.p.value(d.html) == "", "--html alone") && ok
    ok = is(d.p.value(d.pkg), "pkg", "the package after a bare --html") && ok

    ok = accepts(&d, "build --no-c --keep-c --no-line-directives --link --no-assert --no-expect --no-sanitize pkg", "build") && ok
    ok = #expect(d.p.on(d.no_c) && d.p.on(d.no_lines) && d.p.on(d.link) && d.p.on(d.no_assert) && d.p.on(d.no_expect) && d.p.on(d.no_sanitize), "the switches") && ok

    ok = accepts(&d, "fmt a.dado b.dado --check", "fmt") && ok
    ok = #expect(d.p.on(d.check), "fmt --check") && ok
    ok = list_is(d.p.values(d.files), "a.dado b.dado", "fmt's files") && ok

    ok = accepts(&d, "doc collections/core/os -o out.txt --spine docs/spine.txt --ext .rs", "doc") && ok
    ok = is(d.p.value(d.what), "collections/core/os", "doc's package") && ok
    ok = is(d.p.value(d.doc_out), "out.txt", "doc -o") && ok
    ok = is(d.p.value(d.spine), "docs/spine.txt", "--spine") && ok
    ok = is(d.p.value(d.ext), ".rs", "--ext") && ok
    ok = is(d.p.value(d.out), "", "doc's -o is not build's") && ok

    ok = accepts(&d, "doc reference -o ref.txt --captions caps.txt", "doc") && ok
    ok = is(d.p.value(d.what), "reference", "doc reference") && ok
    ok = is(d.p.value(d.captions), "caps.txt", "--captions") && ok
    ok = is(d.p.value(d.ext), ".dado", "--ext's default") && ok

    ok = accepts(&d, "doc params collections/core collections/app", "doc") && ok
    ok = list_is(d.p.values(d.paths), "collections/core collections/app", "doc params' paths") && ok

    ok = accepts(&d, "where", "where") && ok
    ok = accepts(&d, "clean", "clean") && ok
    ok = accepts(&d, "help", "help") && ok
    ok = accepts(&d, "", "") && ok
    ok = accepts(&d, "--help", "") && ok
    ok = #expect(d.p.wants_help(), "dado --help") && ok
    ok = accepts(&d, "build pkg -o out -h", "build") && ok
    ok = #expect(d.p.wants_help(), "-h after other words") && ok

    // ── refused on purpose ────────────────────────────────────────────────
    ok = refuses(&d, "build pkg --target=wasm64", BAD_VALUE, "`--target` expects `web` or `js`, not `wasm64`") && ok
    ok = refuses(&d, "test pkg --sanitize=memory", BAD_VALUE, "`--sanitize` expects `address` or `thread`, not `memory`") && ok
    ok = refuses(&d, "build pkg --manifest", MISSING_VALUE, "write `--manifest=LIST`") && ok
    ok = refuses(&d, "build pkg --base", MISSING_VALUE, "write `--base=PREFIX`") && ok
    // And the rest of what the driver refuses.
    ok = refuses(&d, "build a b", EXTRA_POSITIONAL, "`dado build` takes only PKG") && ok
    ok = refuses(&d, "run a b", EXTRA_POSITIONAL, "words for the program go after `--`") && ok
    ok = refuses(&d, "build pkg -- x", EXTRA_POSITIONAL, "unexpected argument `x`") && ok
    ok = refuses(&d, "build pkg --cc", MISSING_VALUE, "write `--cc PROG`") && ok
    ok = refuses(&d, "build pkg --cc=", MISSING_VALUE, "an empty one is not one") && ok
    ok = refuses(&d, "build --bogus", UNKNOWN_FLAG, "unknown flag `--bogus`") && ok
    ok = refuses(&d, "build --relase", UNKNOWN_FLAG, "did you mean `--release`?") && ok
    ok = refuses(&d, "test --sanitise", UNKNOWN_FLAG, "did you mean `--sanitize`?") && ok
    ok = refuses(&d, "--version", UNKNOWN_FLAG, "unknown flag `--version`") && ok
    ok = refuses(&d, "version", UNKNOWN_COMMAND, "unknown command `version`") && ok
    ok = refuses(&d, "biuld pkg", UNKNOWN_COMMAND, "did you mean `build`?") && ok
    ok = refuses(&d, "fmt --release a.dado", UNKNOWN_FLAG, "`--release` is not a flag of `dado fmt`; it belongs to `build`, `run`, `check`, `emit` or `test`") && ok
    ok = refuses(&d, "--cc gcc build", UNKNOWN_FLAG, "write it after the command, as `dado build --cc`") && ok
    ok = refuses(&d, "doc -o x.txt", MISSING_POSITIONAL, "`dado doc` wants WHAT") && ok
    ok = refuses(&d, "build --check", UNKNOWN_FLAG, "it belongs to `fmt`") && ok

    // ── the help fits 80 columns ──────────────────────────────────────────
    ok = fits(d.p.help_for(""), "dado --help") && ok
    ok = fits(d.p.help_for("build"), "dado build --help") && ok
    ok = fits(d.p.help_for("run"), "dado run --help") && ok
    ok = fits(d.p.help_for("doc"), "dado doc --help") && ok
    ok = fits(d.p.help_for("fmt"), "dado fmt --help") && ok
    if ok:
        return 0
    return 1
