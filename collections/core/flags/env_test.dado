@test
// Float flags and the environment fallback: a number read with `to_f64`'s
// grammar, a variable read when the command line is silent and ignored when
// it is not, a bad variable refused with a sentence naming it, and an `env`
// naming no flag refused as the program's mistake.
package flags

import "core:strings"

i32 test():
    bool ok = true
    Parser p = parser("tool", "A tool.")
    defer p.destroy()
    FloatFlag ratio = p.real("-r --ratio", "X", "how much", 0.5)
    IntFlag jobs = p.integer("-j --jobs", "N", "workers", 1)
    BoolFlag quiet = p.boolean("-q --quiet", "say less")
    TextFlag cc = p.text("--cc", "PROG", "the compiler", "cc")
    p.env("--jobs", "TOOL_JOBS")
    p.env("-q", "TOOL_QUIET")
    p.env("--cc", "TOOL_CC")

    // No variables supplied: every default stands, as on a target with no
    // environment.
    []string8 none
    try string8 _ = p.parse(none) else code:
        _ = #expect(false, "an empty command line failed with ", code, ": ", p.error())
        return 1
    ok = #expect(p.amount(ratio) == 0.5 && p.number(jobs) == 1 && !p.on(quiet) && p.value(cc) == "cc", "the defaults") && ok

    // A float on the command line, both spellings.
    [2]string8 a = ["--ratio=2.5e-1", "-r1"]
    try string8 _ = p.parse(a[:]) else code:
        _ = #expect(false, "the ratios failed with ", code, ": ", p.error())
        return 1
    ok = #expect(p.amount(ratio) == 1.0, "the last ratio wins: ", p.amount(ratio)) && ok
    [2]string8 bad = ["-j", "--ratio=1.5x"]
    try string8 _ = p.parse(bad[1..<2]) else code:
        ok = #expect(code == Error.BAD_VALUE, "a bad ratio failed with ", code) && ok
        ok = #expect(strings.contains(p.error(), "expects a number"), "the sentence: ", p.error()) && ok

    // Variables fill what the command line left alone.
    p.env_var("TOOL_JOBS", "8")
    p.env_var("TOOL_QUIET", "yes")
    p.env_var("TOOL_CC", "")
    try string8 _ = p.parse(none) else code:
        _ = #expect(false, "the environment failed with ", code, ": ", p.error())
        return 1
    ok = #expect(p.number(jobs) == 8 && p.on(quiet), "the variables were not read") && ok
    ok = #expect(p.value(cc) == "cc", "an empty variable counted as set: ", p.value(cc)) && ok

    // The command line wins over a variable.
    [2]string8 given = ["-j", "3"]
    try string8 _ = p.parse(given[:]) else code:
        _ = #expect(false, "-j 3 failed with ", code)
        return 1
    ok = #expect(p.number(jobs) == 3, "the variable beat the command line") && ok

    // A bad variable is refused, naming it; replacing it mends the parse.
    p.env_var("TOOL_JOBS", "many")
    try string8 _ = p.parse(none) else code:
        ok = #expect(code == Error.BAD_VALUE, "a bad TOOL_JOBS failed with ", code) && ok
        ok = #expect(strings.contains(p.error(), "TOOL_JOBS"), "the sentence does not name the variable: ", p.error()) && ok
    p.env_var("TOOL_JOBS", "4")
    p.env_var("TOOL_QUIET", "maybe")
    try string8 _ = p.parse(none) else code:
        ok = #expect(code == Error.BAD_VALUE && strings.contains(p.error(), "TOOL_QUIET"), "a bad switch variable: ", p.error()) && ok

    // The help shows the variable and the float's default.
    ref []char8 h = p.help()
    string8 text = h
    ok = #expect(strings.contains(text, "(env: TOOL_JOBS)") && strings.contains(text, "(default: 0.5)"), "the help: ", text) && ok
    #delete(h)

    // An `env` that names no flag is the program's mistake.
    Parser q = parser("other", "")
    defer q.destroy()
    q.env("--nothing", "X")
    try string8 _ = q.parse(none[:]) else code:
        ok = #expect(code == Error.BAD_SPEC, "an env naming no flag failed with ", code) && ok

    if ok: return 0
    return 1
