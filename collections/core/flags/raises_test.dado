@test
// What raises into a script. `#assert_raises` stands only above a
// package-level function, so the methods of `Parser` cannot carry it
// themselves: each promised function here calls a group of them, and the
// build refuses (ERR1227) if any reaches something a script cannot run.
package flags

#assert_raises
private bool declares_and_reads([]string8 args):
    Parser p = parser("tool", "A tool.")
    p.command("go", "go somewhere")
    BoolFlag b = p.boolean("-b", "a switch")
    TextFlag t = p.text("--text", "T", "a text")
    IntFlag n = p.integer("-n", "N", "a number", 2)
    FloatFlag x = p.real("-x", "X", "a real", 1.5)
    ListFlag l = p.list("-l", "L", "a list")
    TextFlag c = p.choice("--c", "=a|b", "a choice", "a")
    TextFlag pos = p.positional("FILE", "a file")
    ListFlag r = p.rest("MORE", "more files")
    ListFlag tl = p.tail("ARGS", "after --", "go")
    p.env("-n", "N")
    p.env_var("N", "3")
    try string8 _ = p.parse(args) else:
        _ = p.error()
    ref []char8 h = p.help()
    #delete(h)
    ref []char8 hf = p.help_for("go")
    #delete(hf)
    []string8 ls = p.values(l)
    []string8 rs = p.values(r)
    []string8 ts = p.values(tl)
    string8 cv = p.value(c)
    string8 pv = p.value(pos)
    string8 name = p.command_name()
    string8 said = message(Error.UNKNOWN_FLAG)
    bool any = p.on(b) || p.given(t) || p.number(n) > 0 || p.amount(x) > 0.0 || #len(ls) > 0
    any = any || #len(cv) > 0 || #len(pv) > 0 || #len(rs) > 0 || #len(ts) > 0
    any = any || p.wants_help() || #len(name) > 0 || #len(said) > 0
    p.destroy()
    return any

i32 test():
    [3]string8 args = ["-b", "-x", "2"]
    bool ok = #expect(declares_and_reads(args[:]), "the promised calls read nothing")
    return 0 if ok else 1
