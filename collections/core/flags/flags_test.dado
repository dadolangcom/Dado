@test
// Every form a flag can be written in, every failure with the repair its
// sentence names, the help's exact text for a small program, subcommands
// with shared and own flags, `--`, repeats, and a second `parse` starting
// from the defaults again.
package flags

import "core:strings"

// `line` cut at its spaces. The words are windows into `line`.
private ref []string8 split(string8 line):
    ref []string8 out = #make([]string8, 0)
    i64 at = 0
    for at < #len(line):
        (i64 start, i64 stop) = next_word(line, at)
        if start == stop:
            break
        _ = #append(out, line[start..<stop])
        at = stop
    return out

// `line` parses, choosing `command`.
private bool parses(^Parser p, string8 line, string8 command):
    ref []string8 args = split(line)
    defer #delete(args)
    try string8 got = p.parse(args[:]) else code:
        return #expect(false, "`", line, "` failed with ", code, ": ", p.error())
    return #expect(got == command, "`", line, "` chose `", got, "`, not `", command, "`")

// `args` fails with `code`, and the sentence holds `repair`.
private bool fails_args(^Parser p, []string8 args, string8 line, i32 code, string8 repair):
    try string8 got = p.parse(args) else failed:
        bool ok = #expect(failed == code, "`", line, "` failed with ", failed, ", not ", code, ": ", p.error())
        return #expect(strings.contains(p.error(), repair), "`", line, "`: the sentence `", p.error(), "` does not say `", repair, "`") && ok
    return #expect(false, "`", line, "` parsed (chose `", got, "`); wanted code ", code)

private bool fails(^Parser p, string8 line, i32 code, string8 repair):
    ref []string8 args = split(line)
    defer #delete(args)
    return fails_args(p, args[:], line, code, repair)

private bool text_is(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is `", got, "`, not `", want, "`")

private bool list_is([]string8 got, string8 want, string8 what):
    ref []char8 joined = strings.join(got, " ")
    defer #delete(joined)
    string8 j = string8(joined[:])
    return #expect(j == want, what, " is `", j, "`, not `", want, "`")

// The help is `lines`, each ended by a newline; `got` is freed.
private bool help_is(ref []char8 got, string8 what, ..string8 lines):
    strings.Builder b = strings.builder(256)
    for l in lines:
        _ = strings.append(&b, l)
        _ = strings.append_char(&b, '\n')
    ref []char8 want = strings.finish(&b)
    string8 g = string8(got[:])
    string8 w = string8(want[:])
    bool ok = #expect(g == w, what, " is\n", g, "--- not ---\n", w)
    #delete(got)
    #delete(want)
    return ok

// ── a program with no commands ────────────────────────────────────────────

private bool test_forms():
    bool ok = true
    Parser p = parser("tool", "does things")
    defer p.destroy()
    BoolFlag verbose = p.boolean("-v --verbose", "say more")
    BoolFlag quiet = p.boolean("-q", "say less")
    TextFlag out = p.text("-o --output", "PATH", "where to write", "a.out")
    TextFlag cc = p.text("--cc", "PROG", "the C compiler")
    IntFlag jobs = p.integer("-j --jobs", "N", "how many at once", 1)
    ListFlag defs = p.list("-D --define", "NAME=VALUE", "a constant", "")
    ListFlag libs = p.list("-l", "LIB", "a library", "")
    TextFlag target = p.choice("--target", "=web|js", "what to build for")
    TextFlag san = p.choice("--sanitize", "[=address|thread]", "the sanitizer")
    TextFlag page = p.text("--html", "[=PATH]", "the page template")
    TextFlag manifest = p.text("--manifest", "=LIST", "what to write beside the build")
    TextFlag src = p.positional("SRC", "the input")
    ListFlag more = p.rest("MORE", "further inputs")

    // Defaults, before anything is given.
    ok = parses(&p, "", "") && ok
    ok = text_is(p.value(out), "a.out", "the default output") && ok
    ok = #expect(!p.given(out), "an absent text is not given") && ok
    ok = #expect(p.number(jobs) == 1, "the default jobs is ", p.number(jobs)) && ok
    ok = #expect(!p.on(verbose) && !p.on(quiet), "switches start off") && ok
    ok = list_is(p.values(defs), "", "a list before anything is given") && ok
    ok = #expect(!p.given(src), "an absent positional is not given") && ok

    // Long: `--name=value`, `--name value`, and a switch.
    ok = parses(&p, "--output=x.bin --cc gcc --verbose", "") && ok
    ok = text_is(p.value(out), "x.bin", "--output=") && ok
    ok = #expect(p.given(out), "a written text is given") && ok
    ok = text_is(p.value(cc), "gcc", "--cc PROG") && ok
    ok = #expect(p.on(verbose), "--verbose") && ok

    // Short: `-o PATH`, `-o=PATH`, `-oPATH`, and clusters.
    ok = parses(&p, "-o one", "") && ok
    ok = text_is(p.value(out), "one", "-o PATH") && ok
    ok = parses(&p, "-o=two", "") && ok
    ok = text_is(p.value(out), "two", "-o=PATH") && ok
    ok = parses(&p, "-othree", "") && ok
    ok = text_is(p.value(out), "three", "-oPATH") && ok
    ok = parses(&p, "-vq", "") && ok
    ok = #expect(p.on(verbose) && p.on(quiet), "-vq is -v -q") && ok
    ok = parses(&p, "-vo four", "") && ok
    ok = #expect(p.on(verbose), "-vo: -v") && ok
    ok = text_is(p.value(out), "four", "-vo PATH") && ok
    ok = parses(&p, "-qvofive", "") && ok
    ok = text_is(p.value(out), "five", "-qvoPATH") && ok
    // The last one given wins.
    ok = parses(&p, "-o first --output second", "") && ok
    ok = text_is(p.value(out), "second", "a text given twice") && ok

    // Numbers.
    ok = parses(&p, "--jobs 4", "") && ok
    ok = #expect(p.number(jobs) == 4, "--jobs 4 is ", p.number(jobs)) && ok
    ok = parses(&p, "--jobs=-3", "") && ok
    ok = #expect(p.number(jobs) == -3, "--jobs=-3 is ", p.number(jobs)) && ok
    ok = parses(&p, "-j7", "") && ok
    ok = #expect(p.number(jobs) == 7, "-j7 is ", p.number(jobs)) && ok
    ok = parses(&p, "-j +12", "") && ok
    ok = #expect(p.number(jobs) == 12, "-j +12 is ", p.number(jobs)) && ok
    ok = parses(&p, "-j -9223372036854775808", "") && ok
    ok = #expect(p.number(jobs) == -9223372036854775807 - 1, "the least i64 is ", p.number(jobs)) && ok
    ok = parses(&p, "-j 9223372036854775807", "") && ok
    ok = #expect(p.number(jobs) == 9223372036854775807, "the greatest i64 is ", p.number(jobs)) && ok

    // Repeats collect, in order, in every form.
    ok = parses(&p, "-D A=1 -DB=2 --define C=3 --define=D=4 -D=E=5 -l m -lpthread", "") && ok
    ok = list_is(p.values(defs), "A=1 B=2 C=3 D=4 E=5", "the -D list") && ok
    ok = list_is(p.values(libs), "m pthread", "the -l list") && ok

    // Choices, `=`-only and optional values.
    ok = parses(&p, "--target=js", "") && ok
    ok = text_is(p.value(target), "js", "--target=js") && ok
    ok = parses(&p, "--sanitize", "") && ok
    ok = text_is(p.value(san), "address", "--sanitize alone, its first choice") && ok
    ok = #expect(p.given(san), "--sanitize alone is given") && ok
    ok = parses(&p, "--sanitize=thread", "") && ok
    ok = text_is(p.value(san), "thread", "--sanitize=thread") && ok
    ok = parses(&p, "--html", "") && ok
    ok = #expect(p.given(page) && p.value(page) == "", "--html alone is given and empty") && ok
    ok = parses(&p, "--html=page.html", "") && ok
    ok = text_is(p.value(page), "page.html", "--html=PATH") && ok
    ok = parses(&p, "--manifest=h,dts", "") && ok
    ok = text_is(p.value(manifest), "h,dts", "--manifest=LIST") && ok
    // A form-`[=V]` flag never takes the next word: it is a positional.
    ok = parses(&p, "--html page.html", "") && ok
    ok = #expect(p.value(page) == "" && p.value(src) == "page.html", "--html then a word") && ok

    // Positionals, a rest, `-` and `--`.
    ok = parses(&p, "a b c", "") && ok
    ok = text_is(p.value(src), "a", "the positional") && ok
    ok = list_is(p.values(more), "b c", "the rest") && ok
    ok = parses(&p, "-", "") && ok
    ok = text_is(p.value(src), "-", "a lone dash") && ok
    ok = parses(&p, "-v -- -o --cc", "") && ok
    ok = #expect(p.on(verbose), "a flag before --") && ok
    ok = text_is(p.value(src), "-o", "after --, a flag's spelling is a positional") && ok
    ok = list_is(p.values(more), "--cc", "after --, the rest") && ok
    ok = text_is(p.value(out), "a.out", "after --, -o set nothing") && ok

    // A second parse starts from the defaults again.
    ok = parses(&p, "-v -o x -D A=1 -j 3 s", "") && ok
    ok = parses(&p, "", "") && ok
    ok = #expect(!p.on(verbose), "a switch reset") && ok
    ok = text_is(p.value(out), "a.out", "a text reset") && ok
    ok = #expect(p.number(jobs) == 1, "a number reset") && ok
    ok = list_is(p.values(defs), "", "a list reset") && ok
    ok = #expect(!p.given(src) && p.value(src) == "", "a positional reset") && ok
    ok = text_is(p.error(), "", "the error after a success") && ok
    return ok

private bool test_failures():
    bool ok = true
    Parser p = parser("tool", "does things")
    defer p.destroy()
    _ = p.boolean("-v --verbose", "say more")
    _ = p.boolean("--release", "optimise")
    _ = p.text("-o", "PATH", "where to write")
    _ = p.text("--cc", "PROG", "the C compiler")
    _ = p.integer("-j --jobs", "N", "how many at once")
    _ = p.choice("--target", "=web|js", "what to build for")
    _ = p.choice("--sanitize", "[=address|thread]", "the sanitizer")
    _ = p.text("--manifest", "=LIST", "what to write")
    _ = p.positional("SRC", "the input", true)

    // Unknown flags: the nearest spelling, or where the list is.
    ok = fails(&p, "--relase s", UNKNOWN_FLAG, "did you mean `--release`?") && ok
    ok = fails(&p, "--verbos s", UNKNOWN_FLAG, "did you mean `--verbose`?") && ok
    ok = fails(&p, "--zzzzzz s", UNKNOWN_FLAG, "unknown flag `--zzzzzz`; `tool --help` lists the flags") && ok
    ok = fails(&p, "-x s", UNKNOWN_FLAG, "unknown flag `-x`") && ok
    ok = fails(&p, "-vx s", UNKNOWN_FLAG, "unknown flag `-x`") && ok
    // No automatic negation.
    ok = fails(&p, "--no-release s", UNKNOWN_FLAG, "unknown flag `--no-release`") && ok
    // An unknown flag with a value names the flag, not the value.
    ok = fails(&p, "--relase=1 s", UNKNOWN_FLAG, "unknown flag `--relase`;") && ok

    // Missing values, with the form to write.
    ok = fails(&p, "s --cc", MISSING_VALUE, "`--cc` wants a value: write `--cc PROG`") && ok
    ok = fails(&p, "s -o", MISSING_VALUE, "`-o` wants a value: write `-o PATH`") && ok
    ok = fails(&p, "s --manifest h", MISSING_VALUE, "`--manifest` takes its value after `=`: write `--manifest=LIST`") && ok
    ok = fails(&p, "s --target", MISSING_VALUE, "write `--target=web|js`") && ok
    ok = fails(&p, "s --cc=", MISSING_VALUE, "an empty one is not one: write `--cc PROG`") && ok
    ok = fails(&p, "s -o=", MISSING_VALUE, "an empty one is not one: write `-o PATH`") && ok
    ok = fails(&p, "s --sanitize=", MISSING_VALUE, "an empty one is not one: write `--sanitize=address|thread`") && ok
    [3]string8 empty = ["s", "--cc", ""]
    ok = fails_args(&p, empty[:], "s --cc \"\"", MISSING_VALUE, "an empty one is not one") && ok

    // Bad values: what was expected.
    ok = fails(&p, "s --jobs x", BAD_VALUE, "`--jobs` expects a whole number, not `x`: write `--jobs N`") && ok
    ok = fails(&p, "s -j 4x", BAD_VALUE, "expects a whole number, not `4x`") && ok
    ok = fails(&p, "s -j -", BAD_VALUE, "expects a whole number, not `-`") && ok
    ok = fails(&p, "s -j 9223372036854775808", BAD_VALUE, "not `9223372036854775808`") && ok
    ok = fails(&p, "s -j -9223372036854775809", BAD_VALUE, "not `-9223372036854775809`") && ok
    ok = fails(&p, "s --target=wasm64", BAD_VALUE, "`--target` expects `web` or `js`, not `wasm64`") && ok
    ok = fails(&p, "s --sanitize=thred", BAD_VALUE, "expects `address` or `thread`, not `thred`; did you mean `thread`?") && ok
    ok = fails(&p, "s --release=yes", BAD_VALUE, "`--release` is a switch and takes no value: write `--release` alone") && ok
    ok = fails(&p, "s -v=1", BAD_VALUE, "`-v` is a switch and takes no value") && ok

    // Positionals.
    ok = fails(&p, "-v", MISSING_POSITIONAL, "`tool` wants SRC (the input): write `tool SRC`") && ok
    ok = fails(&p, "a b", EXTRA_POSITIONAL, "unexpected argument `b`: `tool` takes only SRC") && ok
    ok = fails(&p, "a -- b", EXTRA_POSITIONAL, "unexpected argument `b`") && ok

    // Help stops the parse, before anything after it can fail, and before
    // the required positional is asked for.
    ok = parses(&p, "-h --bogus", "") && ok
    ok = #expect(p.wants_help(), "-h wants help") && ok
    ok = parses(&p, "-v --help", "") && ok
    ok = #expect(p.wants_help(), "--help wants help") && ok
    ok = parses(&p, "-vh", "") && ok
    ok = #expect(p.wants_help(), "-vh wants help") && ok
    ok = parses(&p, "s", "") && ok
    ok = #expect(!p.wants_help(), "help reset") && ok
    // A failure before the help is still a failure.
    ok = fails(&p, "--bogus -h", UNKNOWN_FLAG, "--bogus") && ok
    return ok

// ── subcommands ───────────────────────────────────────────────────────────

private bool test_commands():
    bool ok = true
    Parser p = parser("dd", "a driver")
    defer p.destroy()
    p.command("build", "build a package")
    p.command("run", "build, then run")
    p.command("fmt", "format files")
    BoolFlag verbose = p.boolean("-v --verbose", "say more")
    BoolFlag release = p.boolean("--release", "optimise", "build run")
    BoolFlag check = p.boolean("--check", "list, do not write", "fmt")
    TextFlag pkg = p.positional("PKG", "the package", false, "build run")
    ListFlag files = p.rest("FILE", "the files", "fmt")
    ListFlag args = p.tail("ARGS", "the program's arguments", "run")

    ok = parses(&p, "", "") && ok
    ok = parses(&p, "build", "build") && ok
    ok = #expect(!p.given(pkg), "build with no package") && ok
    // A shared flag before or after the command; an own flag after it.
    ok = parses(&p, "-v build pkg --release", "build") && ok
    ok = #expect(p.on(verbose) && p.on(release), "build: -v and --release") && ok
    ok = text_is(p.value(pkg), "pkg", "build's package") && ok
    ok = parses(&p, "run pkg --release -v", "run") && ok
    ok = #expect(p.on(verbose) && p.on(release), "run: -v and --release") && ok
    ok = parses(&p, "fmt --check a.dado b.dado", "fmt") && ok
    ok = #expect(p.on(check), "fmt --check") && ok
    ok = list_is(p.values(files), "a.dado b.dado", "fmt's files") && ok

    // The tail takes exactly what follows `--`, flags included.
    ok = parses(&p, "run corpus/tour -- a b --c -v", "run") && ok
    ok = text_is(p.value(pkg), "corpus/tour", "run's package") && ok
    ok = list_is(p.values(args), "a b --c -v", "run's tail") && ok
    ok = #expect(!p.on(verbose), "a -v after -- is the program's") && ok
    ok = parses(&p, "run -- x", "run") && ok
    ok = #expect(!p.given(pkg), "run -- x leaves the package to its default") && ok
    ok = list_is(p.values(args), "x", "run -- x") && ok

    // Refusals that name the scope.
    ok = fails(&p, "fmt --release", UNKNOWN_FLAG, "`--release` is not a flag of `dd fmt`; it belongs to `build` or `run`") && ok
    ok = fails(&p, "--release build", UNKNOWN_FLAG, "`--release` is a flag of the command `build` or `run`: write it after the command, as `dd build --release`") && ok
    ok = fails(&p, "build --chek", UNKNOWN_FLAG, "unknown flag `--chek`; `dd build --help` lists the flags") && ok
    ok = fails(&p, "fmt --chek", UNKNOWN_FLAG, "did you mean `--check`?") && ok
    ok = fails(&p, "biuld pkg", UNKNOWN_COMMAND, "unknown command `biuld`; did you mean `build`? (`dd --help` lists the commands)") && ok
    ok = fails(&p, "xyzzy", UNKNOWN_COMMAND, "unknown command `xyzzy`; `dd --help` lists the commands") && ok
    ok = fails(&p, "build a b", EXTRA_POSITIONAL, "unexpected argument `b`: `dd build` takes only PKG") && ok
    ok = fails(&p, "build a -- b", EXTRA_POSITIONAL, "unexpected argument `b`: `dd build` takes only PKG") && ok
    ok = fails(&p, "run a b", EXTRA_POSITIONAL, "`dd run` takes only PKG; words for the program go after `--`") && ok
    ok = fails(&p, "-v pkg", UNKNOWN_COMMAND, "unknown command `pkg`") && ok
    return ok

// ── declarations that are wrong ───────────────────────────────────────────

private bool spec_fails(Parser p, string8 repair):
    Parser q = p
    bool ok = fails(&q, "", BAD_SPEC, repair)
    q.destroy()
    return ok

private bool test_spec():
    bool ok = true
    Parser a = parser("t", "")
    _ = a.boolean("-verbose", "x")
    ok = spec_fails(a, "the flag spelling `-verbose` in `-verbose` is neither a short `-c`") && ok
    Parser b = parser("t", "")
    _ = b.boolean("---x", "x")
    ok = spec_fails(b, "`---x`") && ok
    Parser c = parser("t", "")
    _ = c.boolean("-v --verbose", "x")
    _ = c.text("-v", "V", "y")
    ok = spec_fails(c, "the flag spelling `-v` is declared twice where both reach") && ok
    Parser d = parser("t", "")
    _ = d.boolean("--help", "mine")
    ok = spec_fails(d, "`--help` is declared twice") && ok
    Parser e = parser("t", "")
    e.command("build", "b")
    _ = e.boolean("--release", "x", "build biuld")
    ok = spec_fails(e, "`biuld` is not a declared command") && ok
    Parser f = parser("t", "")
    _ = f.choice("--target", "=web|js", "x", "wasm")
    ok = spec_fails(f, "defaults to `wasm`, which is not one of its choices `web|js`") && ok
    Parser g = parser("t", "")
    _ = g.text("--cc", "", "x")
    ok = spec_fails(g, "takes a value but declares no form") && ok
    Parser h = parser("t", "")
    _ = h.boolean("", "x")
    ok = spec_fails(h, "declared with no spelling") && ok
    Parser i = parser("t", "")
    _ = i.positional("", "x")
    ok = spec_fails(i, "a positional is declared with no name") && ok
    Parser j = parser("t", "")
    _ = j.boolean("--a=b", "x")
    ok = spec_fails(j, "`--a=b`") && ok
    Parser n = parser("t", "")
    _ = n.integer("--level", "[=N]", "x")
    ok = spec_fails(n, "a number with an optional value") && ok
    // One spelling in two scopes apart is two flags, not a clash.
    Parser k = parser("t", "")
    k.command("fmt", "f")
    k.command("doc", "d")
    TextFlag fo = k.text("-o", "FILE", "x", "", "fmt")
    TextFlag dox = k.text("-o", "DOC", "y", "", "doc")
    ok = parses(&k, "doc -o z", "doc") && ok
    ok = #expect(p_value_pair(k, fo, dox), "-o reached doc's own") && ok
    k.destroy()
    return ok

private bool p_value_pair(Parser k, TextFlag fo, TextFlag dox):
    return !k.given(fo) && k.value(dox) == "z"

// ── the codes ─────────────────────────────────────────────────────────────

private bool test_messages():
    bool ok = true
    [7]i32 codes = [UNKNOWN_FLAG, MISSING_VALUE, BAD_VALUE, UNKNOWN_COMMAND, EXTRA_POSITIONAL, MISSING_POSITIONAL, BAD_SPEC]
    for i in 0..<7:
        string8 m = message(codes[i])
        ok = #expect(#len(m) > 0 && m != message(0), "code ", codes[i], " has a sentence") && ok
        for j in 0..<i:
            ok = #expect(codes[i] != codes[j], "codes ", i, " and ", j, " differ") && ok
    ok = text_is(message(99), "not a code of core:flags", "an unknown code") && ok
    return ok

// ── the help ──────────────────────────────────────────────────────────────

private bool test_help():
    bool ok = true
    Parser p = parser("tool", "Turns sources into programs, one at a time, which is slow but easy to follow.")
    defer p.destroy()
    _ = p.boolean("-v --verbose", "echo each command before running it")
    _ = p.text("-o", "PATH", "where to write the program", "a.out")
    _ = p.text("--cc", "PROG", "the C compiler")
    _ = p.integer("-j --jobs", "N", "how many to build at once", 4)
    _ = p.list("-D", "NAME=VALUE", "replace a constant")
    _ = p.choice("--sanitize", "[=address|thread]", "build under a sanitizer; alone it means address, which catches most memory errors there are")
    _ = p.text("--manifest", "=LIST", "write the manifest and the extensions LIST names, separated by commas")
    _ = p.boolean("--keep-c", "")
    _ = p.positional("SRC", "the source file", true)
    _ = p.rest("MORE", "more source files")
    ok = help_is(p.help(), "the program's help",
        "usage: tool [flags] SRC [MORE...]",
        "",
        "Turns sources into programs, one at a time, which is slow but easy to follow.",
        "",
        "arguments:",
        "  SRC   the source file",
        "  MORE  more source files",
        "",
        "flags:",
        "  -h, --help           print this help and stop",
        "  -v, --verbose        echo each command before running it",
        "  -o PATH              where to write the program (default: a.out)",
        "      --cc PROG        the C compiler",
        "  -j, --jobs N         how many to build at once (default: 4)",
        "  -D NAME=VALUE        replace a constant (repeatable)",
        "      --sanitize[=address|thread]",
        "                       build under a sanitizer; alone it means address, which",
        "                       catches most memory errors there are",
        "      --manifest=LIST  write the manifest and the extensions LIST names,",
        "                       separated by commas") && ok
    return ok

private bool test_command_help():
    bool ok = true
    Parser p = parser("dd", "The driver.")
    defer p.destroy()
    p.command("build", "transpile and compile a package")
    p.command("run", "build, then run the program")
    p.command("help", "")
    _ = p.boolean("--verbose", "echo each command")
    _ = p.boolean("--release", "optimise", "build run")
    _ = p.positional("PKG", "the package directory", false, "build run")
    _ = p.tail("ARGS", "the program's arguments", "run")
    ok = help_is(p.help(), "the program's help, with commands",
        "usage: dd <command> [flags]",
        "",
        "The driver.",
        "",
        "commands:",
        "  build  transpile and compile a package",
        "  run    build, then run the program",
        "",
        "flags:",
        "  -h, --help     print this help and stop",
        "      --verbose  echo each command",
        "",
        "`dd <command> --help` describes a command and its own flags.") && ok
    ok = parses(&p, "run --help", "run") && ok
    ok = #expect(p.wants_help(), "run --help") && ok
    ok = help_is(p.help(), "run's help",
        "usage: dd run [flags] [PKG] [-- ARGS...]",
        "",
        "build, then run the program",
        "",
        "arguments:",
        "  PKG   the package directory",
        "  ARGS  the program's arguments",
        "",
        "flags:",
        "  -h, --help     print this help and stop",
        "      --verbose  echo each command",
        "      --release  optimise") && ok
    ok = help_is(p.help_for("build"), "build's help",
        "usage: dd build [flags] [PKG]",
        "",
        "transpile and compile a package",
        "",
        "arguments:",
        "  PKG  the package directory",
        "",
        "flags:",
        "  -h, --help     print this help and stop",
        "      --verbose  echo each command",
        "      --release  optimise") && ok
    // A hidden command still parses.
    ok = parses(&p, "help", "help") && ok
    return ok

i32 test():
    bool ok = true
    ok = test_forms() && ok
    ok = test_failures() && ok
    ok = test_commands() && ok
    ok = test_spec() && ok
    ok = test_messages() && ok
    ok = test_help() && ok
    ok = test_command_help() && ok
    if ok:
        return 0
    return 1
