// core:flags — command lines: flags, positionals, subcommands, and the help
// text they imply, declared once and read back typed.
//
//     import "core:flags"
//     import "core:fmt"
//
//     i32 run([]string8 args):                 // the words after the program's name
//         flags.Parser p = flags.parser("greet", "Say hello to someone.")
//         flags.BoolFlag loud = p.boolean("-l --loud", "shout")
//         flags.IntFlag times = p.integer("-n --times", "N", "how many times", 1)
//         flags.TextFlag who = p.positional("NAME", "who to greet", true)
//         try string8 _ = p.parse(args) else:
//             fmt.println(p.error())             // the sentence, repair included
//             return 2
//         if p.wants_help():
//             fmt.println(p.help())
//             return 0
//         for i in 0..<p.number(times):
//             fmt.println("hello, ", p.value(who), "!" if p.on(loud) else ".")
//         return 0
//
// **Tier N W H. Script class S.** Pure Dado, and it never reads the process's
// arguments or environment itself: `parse` takes a `[]string8` the caller
// supplies, and `env_var` the variables the caller read, so the same
// declarations parse a test's words, a script's, or `main`'s, on every target
// alike — freestanding, the web and hosted (Linux, macOS, Windows).
//
// **What raises into a script**: everything. `message`, `parser` and every
// method of `Parser` carry `#assert_raises` on the line above them.
//
// **The shape, and why.** A `Parser` holds a table of declarations. Each
// declaring method answers a small typed handle (`BoolFlag`, `TextFlag`,
// `IntFlag`, `FloatFlag`, `ListFlag`, each a `distinct` index into the
// table), and after `parse` the reading methods take the handle back: `on`,
// `value`, `number`, `amount`, `values`. The program writes no loop and the handle's type
// decides what may be read from it, so reading a switch as a number is a
// compile error (ERR0504) rather than a zero. A handle is an index and not a
// `^T` into the table, so declaring more flags (which grows the table) never
// leaves an earlier handle pointing at moved memory. Calls are all
// positional with trailing defaults, as the language asks (a call never
// mixes positional and named arguments), so a declaration reads
// `names, form, summary[, default][, scope]`.
//
// **Spellings are written as they are typed.** `names` is the flag's
// spellings separated by spaces: `-v --verbose`, `-o`, `--cc`, or an old
// spelling kept beside a new one, `--base --html-base`. A short spelling is
// a dash and one byte, a long one two dashes and a word.
//
// **The form is written as the help shows it**, and decides how a value is
// given:
//
// * `PROG` — `--cc PROG`, `--cc=PROG`; short: `-o PATH`, `-o=PATH`,
//   `-oPATH`;
// * `=LIST` — only `--manifest=LIST` (a bare `--manifest` is refused, and the
//   next word is never taken as its value);
// * `[=PATH]` — `--html` alone, or `--html=PATH`; alone it gives the empty
//   value, or a `choice`'s first choice, and `given` tells it from absent;
// * for a `choice`, the inner placeholder lists the accepted values:
//   `=web|js`, `[=address|thread]`, `off|default`.
//
// A value is never empty: `--cc ""` and `--cc=` are refused. Short boolean
// flags cluster: `-vh` is `-v -h`, and a short flag that takes a value ends
// a cluster, so `-vlm` is `-v -l m`. A plain `-` is a positional (the
// conventional name for a standard stream).
//
// **No automatic `--no-name`.** Where a program has an opposite, it declares
// it as a flag of its own (`--no-werror`, `--no-assert`): most such flags
// have no positive twin to negate, and an automatic negation would add
// spellings nobody chose (`--no-verbose`, `--no-release`) to every program's
// command line, each one more near miss for the spelling suggestions.
//
// **Subcommands.** `command` declares a word; once any is declared, the
// first positional word must be one of them, and `parse` answers it. One
// level only: a word after the command that picks a mode of it (`doc
// reference`) is a positional the program reads. Every flag and positional
// declaration takes a `scope`: `""`, the default, is every command and the
// words before the command; otherwise it is the command names it belongs to,
// separated by spaces, so flags shared by several commands are declared once
// (`"build run check emit test"`). A flag written where its scope does not
// reach is refused with the commands it belongs to.
//
// **Positionals.** `positional` takes one word, optional unless `required`;
// `rest` collects every further positional word; `tail` collects exactly
// the words after `--` (a `run` command's program arguments), and while a
// command has a `tail`, a word after `--` goes nowhere else. Without one,
// `--` only ends the flags: what follows is positional however it is
// spelled. A positional word with nowhere to go is refused.
//
// **The environment, as a fallback.** `env("--cc", "DADO_CC")` says that
// the flag spelled `--cc` takes its value from the variable `DADO_CC` when
// the command line does not give one; `env_var(name, value)` hands the parser
// one variable the program read. The parser reads no environment of its own —
// on the web and freestanding there is none to read — so a program that
// supplies no variables simply finds none, and every flag keeps its default:
//
//     os.Environment e = os.environment()
//     defer e.destroy()
//     for v in e.vars:
//         p.env_var(v.name, v.value)
//
// A value given on the command line always wins. A variable set to the empty
// string counts as unset. A variable's value is checked as the flag's value
// would be, and a bad one fails `parse` with that code and a sentence naming
// the variable. A switch reads `true`, `yes`, `on` and `1` as on and their
// opposites as off (`core:strings/parse`'s `to_bool`), a list takes the whole
// value as one item, and a variable is never a positional. The help shows the
// variable beside the flag: `(env: DADO_CC)`.
//
// **Help.** Every parser declares `-h --help` itself. `parse` stops at it
// and answers success, `wants_help` says so, and `help` writes the text for
// the command chosen (or for the program): a usage line, the summary, the
// commands, the positionals and the flags, each flag with its form, its
// summary, its default and whether it repeats, in declaration order and
// aligned, wrapped to 80 columns where the words allow. Plain text: no
// colour. A declaration whose summary is `""` is accepted and left out of
// the help, which is how an old spelling stays working without being
// advertised.
//
// **Values are windows.** A text value, a positional and a list's items are
// windows into the `args` passed to `parse` (`-DNAME=1`'s value is the word
// from its third byte), so `args` must outlive the reads. Nothing is
// copied.
//
// **Error codes: `Error`, 1400 to 1499**, a range no other package's codes
// share. `parse` is `Error!string8`; `message(why)` answers a sentence for
// the code, and `error()` the full sentence for the failure just returned,
// which names the word, the flag and the repair:
//
// * `UNKNOWN_FLAG` — no such flag here; the nearest spelling (edit distance)
//   is suggested, or the commands it belongs to are named.
// * `MISSING_VALUE` — a flag that takes a value has none (or an empty one);
//   its form is shown.
// * `BAD_VALUE` — the value is not what the flag accepts: not a whole
//   number, not a number, not one of its choices, or a value given to a
//   switch.
// * `UNKNOWN_COMMAND` — the first word is not a command; the nearest is
//   suggested.
// * `EXTRA_POSITIONAL` — a positional word with no place to go.
// * `MISSING_POSITIONAL` — a required positional is absent.
// * `BAD_SPEC` — the declarations themselves are wrong: a spelling that is
//   neither `-c` nor `--word`, one spelling twice where both reach, a scope
//   naming no command, a value form missing, a default that is not a choice,
//   a number whose value is optional, an `env` naming no flag.
//   This is the program's mistake, not the user's, reported at `parse`.
// * `NO_MEMORY` — the allocator refused a declaration, or a list's value.
//
// **Allocation.** Ambient: the table, the lists and the failure sentence are
// on `#default`, and `help` answers a `ref []char8` the caller owns. Under a
// `using` arena nothing needs freeing; outside one, `destroy` frees what the
// parser holds and the caller `#delete`s the help text. Lengths and indices
// are `i64`. When the allocator refuses, nothing traps: a declaration it
// refused makes the next `parse` fail with `NO_MEMORY` and its handle read
// as the zero value; a list's value it refused fails that `parse` with
// `NO_MEMORY`; a failure sentence it refused leaves `error()` answering
// `message` of the code; and `help` answers `nil`.
//
// **Thread-safety.** No package state. A `Parser` is a plain value that one
// thread at a time may declare into, parse with and read; separate parsers
// are independent.
package flags

import "core:fmt"
import "core:strings"
import "core:strings/parse"

// ── the public surface ────────────────────────────────────────────────────

// Why `parse` failed. The numbers are this package's, 1400 to 1499, apart
// from every other package's, so a code read anywhere never means two things.
distinct enum i32 Error:
    // A flag no declaration in reach spells.
    UNKNOWN_FLAG = 1400,
    // A flag that takes a value was given none, or an empty one.
    MISSING_VALUE,
    // A flag's value is not one it accepts.
    BAD_VALUE,
    // The first word is not a declared command.
    UNKNOWN_COMMAND,
    // A positional word has no positional left to fill.
    EXTRA_POSITIONAL,
    // A required positional was not given.
    MISSING_POSITIONAL,
    // The declarations are malformed or contradict each other.
    BAD_SPEC,
    // The allocator refused: a declaration or a value could not be stored.
    NO_MEMORY,

// A sentence for each of this package's codes, and one for any other value.
#assert_raises
string8 message(Error why):
    if why == Error.UNKNOWN_FLAG:
        return "an unknown flag: no flag of that spelling applies here"
    if why == Error.MISSING_VALUE:
        return "a flag that takes a value was given none, or an empty one"
    if why == Error.BAD_VALUE:
        return "a flag was given a value it does not accept"
    if why == Error.UNKNOWN_COMMAND:
        return "the first word is not one of the program's commands"
    if why == Error.EXTRA_POSITIONAL:
        return "a positional word has no place: the command takes no more of them"
    if why == Error.MISSING_POSITIONAL:
        return "a required positional word is missing"
    if why == Error.BAD_SPEC:
        return "the program declares its flags wrongly; the fault is the program's, not the command line's"
    if why == Error.NO_MEMORY:
        return "out of memory: the parser could not store a declaration or a value"
    return "not a code of core:flags"

// A switch: on when given.
distinct type BoolFlag: i64

// One text: a flag's value, a `choice`, or a positional.
distinct type TextFlag: i64

// A whole number.
distinct type IntFlag: i64

// A number with a fraction: what `core:strings/parse`'s `to_f64` reads.
distinct type FloatFlag: i64

// A list: a repeatable flag's values, or the words a `rest` or `tail`
// collects.
distinct type ListFlag: i64

// A program's command line: what it declares, and what the last `parse`
// found. Made by `parser`; ended by `destroy` when no `using` arena owns it.
type Parser:
    string8 program
    string8 summary
    ref []Command commands
    ref []Spec specs
    i64 chosen
    bool helped
    ref []char8 failure
    ref []EnvLink links
    ref []EnvLink vars
    bool starved
    bool failed
    Error why

    // ── declaring ─────────────────────────────────────────────────────────

    // A command word, with the one line the help shows beside it (`""`
    // keeps it out of the help).
    #assert_raises
    void command(^self, string8 name, string8 summary):
        Command c = (name, summary)
        if !#append(self.commands, c):
            self.starved = true

    // A switch, off unless given. A value written to it (`--release=yes`)
    // is refused.
    #assert_raises
    BoolFlag boolean(^self, string8 names, string8 summary, string8 scope = ""):
        return BoolFlag(self.add(Kind.Bool, names, "", summary, scope, "", 0, false))

    // A flag with one text value; the last one given wins. `default` is what
    // `value` answers when it is absent, shown in the help when not empty.
    #assert_raises
    TextFlag text(^self, string8 names, string8 form, string8 summary, string8 default = "", string8 scope = ""):
        return TextFlag(self.add(Kind.Text, names, form, summary, scope, default, 0, false))

    // A flag whose value must be a whole number (decimal, an optional sign).
    #assert_raises
    IntFlag integer(^self, string8 names, string8 form, string8 summary, i64 default = 0, string8 scope = ""):
        return IntFlag(self.add(Kind.Int, names, form, summary, scope, "", default, false))

    // A flag whose value must be a number: decimal digits with an optional
    // sign, fraction and exponent, or `inf` and `nan` (`to_f64`'s grammar).
    #assert_raises
    FloatFlag real(^self, string8 names, string8 form, string8 summary, f64 default = 0.0, string8 scope = ""):
        i64 k = self.add(Kind.Float, names, form, summary, scope, "", 0, false)
        if self.holds(k):
            self.specs[k].default_real = default
            self.specs[k].real = default
        return FloatFlag(k)

    // The flag spelled `spelling` (any one of its spellings) takes its value
    // from the environment variable `variable` when the command line gives
    // none. A spelling no flag has fails the next `parse` with `BAD_SPEC`.
    #assert_raises
    void env(^self, string8 spelling, string8 variable):
        EnvLink l = (spelling, variable)
        if !#append(self.links, l):
            self.starved = true
        i64 k = self.find_anywhere(spelling)
        if k >= 0:
            self.specs[k].env_name = variable

    // One variable of the environment the program read, for the flags `env`
    // links to it. `value` is a window and must outlive the reads, as `args`
    // must; giving a name again replaces its value.
    #assert_raises
    void env_var(^self, string8 name, string8 value):
        for i in 0..<#len(self.vars):
            if self.vars[i].a == name:
                self.vars[i].b = value
                return
        EnvLink v = (name, value)
        if !#append(self.vars, v):
            self.starved = true

    // A repeatable flag: every value given, in order (`-D A=1 -D B=2`).
    #assert_raises
    ListFlag list(^self, string8 names, string8 form, string8 summary, string8 scope = ""):
        return ListFlag(self.add(Kind.List, names, form, summary, scope, "", 0, false))

    // A flag whose value must be one of the choices its form lists between
    // `|`: `=web|js`, `[=address|thread]`.
    #assert_raises
    TextFlag choice(^self, string8 names, string8 form, string8 summary, string8 default = "", string8 scope = ""):
        return TextFlag(self.add(Kind.Choice, names, form, summary, scope, default, 0, false))

    // One positional word, filled in declaration order. A `required` one
    // that is absent fails `parse` with `MISSING_POSITIONAL`.
    #assert_raises
    TextFlag positional(^self, string8 name, string8 summary, bool required = false, string8 scope = ""):
        return TextFlag(self.add(Kind.Positional, name, "", summary, scope, "", 0, required))

    // Every positional word left over once the `positional`s are filled.
    #assert_raises
    ListFlag rest(^self, string8 name, string8 summary, string8 scope = ""):
        return ListFlag(self.add(Kind.Rest, name, "", summary, scope, "", 0, false))

    // The words after `--`, exactly as written, flags or not.
    #assert_raises
    ListFlag tail(^self, string8 name, string8 summary, string8 scope = ""):
        return ListFlag(self.add(Kind.Tail, name, "", summary, scope, "", 0, false))

    // ── parsing ───────────────────────────────────────────────────────────

    // Read `args` (the words after the program's name) against the
    // declarations. Answers the command word chosen, or `""` when the
    // program declares none or none was given. Stops at `-h`/`--help`,
    // successfully (`wants_help`). Fails with one of `Error`'s codes, and
    // `error()` then says what was wrong and how to write it instead.
    // Each `parse` starts from the defaults again.
    #assert_raises
    Error!string8 parse(^self, []string8 args):
        self.reset()
        try string8 cmd = self.read(args) else why:
            self.failed = true
            self.why = why
            fail why
        return cmd

    // Whether the last `parse` stopped at `-h` or `--help`.
    #assert_raises
    bool wants_help(self):
        return self.helped

    // The full sentence for the last failure of `parse`, or `message` of its
    // code when the sentence could not be allocated; empty after a success.
    #assert_raises
    string8 error(self):
        if self.failure != nil:
            return string8(self.failure[:])
        if self.failed:
            return message(self.why)
        return ""

    // The command word the last `parse` chose, or `""`.
    #assert_raises
    string8 command_name(self):
        if self.chosen < 0:
            return ""
        return self.commands[self.chosen].name

    // ── reading ───────────────────────────────────────────────────────────
    //
    // A handle whose declaration the allocator refused reads as the zero
    // value; `parse` has failed with `NO_MEMORY` by then.

    // Whether the switch was given.
    #assert_raises
    bool on(self, BoolFlag f):
        if !self.holds(i64(f)):
            return false
        return self.specs[i64(f)].on

    // The text given, or the default when it was not.
    #assert_raises
    string8 value(self, TextFlag f):
        if !self.holds(i64(f)):
            return ""
        return self.specs[i64(f)].text

    // Whether the text was given at all, which tells a form-`[=PATH]` flag
    // written alone from one never written, and a positional from its
    // absence.
    #assert_raises
    bool given(self, TextFlag f):
        if !self.holds(i64(f)):
            return false
        return self.specs[i64(f)].given

    // The number given, or the default when it was not.
    #assert_raises
    i64 number(self, IntFlag f):
        if !self.holds(i64(f)):
            return 0
        return self.specs[i64(f)].number

    // The number given, or the default when it was not.
    #assert_raises
    f64 amount(self, FloatFlag f):
        if !self.holds(i64(f)):
            return 0.0
        return self.specs[i64(f)].real

    // Every value given, in order; empty when none was.
    #assert_raises
    []string8 values(self, ListFlag f):
        if !self.holds(i64(f)) || self.specs[i64(f)].items == nil:
            []string8 none
            return none
        return self.specs[i64(f)].items[:]

    // ── help ──────────────────────────────────────────────────────────────

    // The help for the command the last `parse` chose, or for the program
    // when it chose none. New text on the ambient allocator; `nil` when the
    // allocation fails.
    #assert_raises
    ref []char8 help(self):
        return self.help_for(self.command_name())

    // The help for `command`, or for the program when `command` is `""`
    // (or names no command).
    #assert_raises
    ref []char8 help_for(self, string8 command):
        i64 cmd = self.command_index(command)
        Writing b = writing(512)
        put(&b, "usage: ")
        put(&b, self.program)
        if cmd >= 0:
            put(&b, " ")
            put(&b, self.commands[cmd].name)
        else if #len(self.commands) > 0:
            put(&b, " <command>")
        put(&b, " [flags]")
        if cmd >= 0 || #len(self.commands) == 0:
            for s in self.specs:
                if is_positional(s.kind) && #len(s.summary) > 0 && reaches(s.scope, self.name_of(cmd)):
                    put(&b, " ")
                    put_owned(&b, usage_word(s))
        put(&b, "\n")
        string8 about = self.summary
        if cmd >= 0:
            about = self.commands[cmd].summary
        if #len(about) > 0:
            put(&b, "\n")
            wrap(&b, about, 0, 0)
        if cmd < 0 && #len(self.commands) > 0:
            i64 width = 0
            for c in self.commands:
                if #len(c.summary) > 0 && #len(c.name) + 2 > width:
                    width = #len(c.name) + 2
            put(&b, "\ncommands:\n")
            for c in self.commands:
                if #len(c.summary) > 0:
                    entry(&b, c.name, c.summary, width)
        if cmd >= 0 || #len(self.commands) == 0:
            i64 width = 0
            bool any = false
            for s in self.specs:
                if is_positional(s.kind) && #len(s.summary) > 0 && reaches(s.scope, self.name_of(cmd)):
                    any = true
                    if #len(s.names) > width:
                        width = #len(s.names)
            if any:
                put(&b, "\narguments:\n")
                for s in self.specs:
                    if is_positional(s.kind) && #len(s.summary) > 0 && reaches(s.scope, self.name_of(cmd)):
                        entry(&b, s.names, s.summary, width + 2)
        self.flag_section(&b, cmd)
        if cmd < 0 && #len(self.commands) > 0:
            put(&b, "\n`")
            put(&b, self.program)
            put(&b, " <command> --help` describes a command and its own flags.\n")
        return done(&b)

    // ── teardown ──────────────────────────────────────────────────────────

    // Free what the parser holds. Not needed under a `using` arena. The
    // handles and every value read from the parser are dead afterwards.
    #assert_raises
    void destroy(^self):
        for s in self.specs:
            if s.items != nil:
                #delete(s.items)
        if self.specs != nil:
            #delete(self.specs)
        if self.commands != nil:
            #delete(self.commands)
        if self.failure != nil:
            #delete(self.failure)
        if self.links != nil:
            #delete(self.links)
        if self.vars != nil:
            #delete(self.vars)
        self.specs = nil
        self.commands = nil
        self.failure = nil
        self.links = nil
        self.vars = nil

    // ── inside ────────────────────────────────────────────────────────────

    // `parse`'s reading, whose failure `parse` records for `error`.
    private Error!string8 read(^self, []string8 args):
        if self.starved:
            self.set_failure(#format("`", self.program, "` ran out of memory while it declared its flags, so its command line was not read"))
            fail Error.NO_MEMORY
        try self.check_spec()
        i64 i = 0
        bool dashed = false
        for i < #len(args):
            string8 a = args[i]
            if dashed:
                try self.place(a, true)
                i += 1
            else if a == "--":
                dashed = true
                i += 1
            else if #len(a) > 2 && a[0] == '-' && a[1] == '-':
                try i64 next = self.long_flag(args, i)
                i = next
            else if #len(a) > 1 && a[0] == '-':
                try i64 next = self.short_flags(args, i)
                i = next
            else if #len(self.commands) > 0 && self.chosen < 0:
                try self.pick(a)
                i += 1
            else:
                try self.place(a, false)
                i += 1
            if self.helped:
                return self.command_name()
        try self.from_env()
        try self.check_required()
        return self.command_name()

    private i64 add(^self, Kind kind, string8 names, string8 form, string8 summary, string8 scope,
                    string8 default_text, i64 default_number, bool required):
        Spec s
        s.kind = kind
        s.names = names
        s.form = form
        s.summary = summary
        s.scope = scope
        s.default_text = default_text
        s.default_number = default_number
        s.required = required
        s.text = default_text
        s.number = default_number
        if kind == Kind.List || kind == Kind.Rest || kind == Kind.Tail:
            s.items = #make([]string8, 0)
            if s.items == nil:
                self.starved = true
                return -1
        if !#append(self.specs, s):
            if s.items != nil:
                #delete(s.items)
            self.starved = true
            return -1
        return #len(self.specs) - 1

    // Whether `k` is a declaration in the table: false for a handle whose
    // declaration the allocator refused.
    private bool holds(self, i64 k):
        return k >= 0 && k < #len(self.specs)

    private void reset(^self):
        self.chosen = -1
        self.helped = false
        self.failed = false
        if self.failure != nil:
            #delete(self.failure)
            self.failure = nil
        for i in 0..<#len(self.specs):
            ^Spec s = &self.specs[i]
            s.given = false
            s.on = false
            s.text = s.default_text
            s.number = s.default_number
            s.real = s.default_real
            if s.items != nil:
                #truncate(s.items, 0)

    // The sentence for a value the allocator refused to keep.
    private void no_room(^self, string8 what):
        self.set_failure(#format("out of memory: the value for `", what, "` could not be kept"))

    private void set_failure(^self, ref []char8 sentence):
        if self.failure != nil:
            #delete(self.failure)
        self.failure = sentence

    private i64 command_index(self, string8 name):
        if #len(name) == 0:
            return -1
        for i in 0..<#len(self.commands):
            if self.commands[i].name == name:
                return i
        return -1

    private string8 name_of(self, i64 cmd):
        if cmd < 0:
            return ""
        return self.commands[cmd].name

    // The words naming the program and its command, for a sentence.
    private ref []char8 invocation(self):
        if self.chosen < 0:
            return #format(self.program)
        return #format(self.program, " ", self.commands[self.chosen].name)

    // The declarations, checked before any word is read.
    private Error!void check_spec(^self):
        for i in 0..<#len(self.specs):
            Spec s = self.specs[i]
            // A scope names only declared commands.
            i64 at = 0
            for at < #len(s.scope):
                (i64 start, i64 stop) = next_word(s.scope, at)
                if start == stop:
                    break
                string8 w = s.scope[start..<stop]
                if self.command_index(w) < 0:
                    self.set_failure(#format("the declaration `", s.names, "` has the scope `", s.scope,
                                             "`, and `", w, "` is not a declared command; declare it with `command` or correct the scope"))
                    fail Error.BAD_SPEC
                at = stop
            if is_positional(s.kind):
                if #len(s.names) == 0:
                    self.set_failure(#format("a positional is declared with no name; give it the word the help shows, such as `FILE`"))
                    fail Error.BAD_SPEC
                continue
            string8 placeholder = inner(s.form)
            if s.kind != Kind.Bool && #len(placeholder) == 0:
                self.set_failure(#format("the flag `", s.names, "` takes a value but declares no form; write its placeholder, such as `PATH`, `=PATH` or `[=PATH]`"))
                fail Error.BAD_SPEC
            if s.kind == Kind.Int && form_style(s.form) == Form.Optional:
                self.set_failure(#format("the flag `", s.names, "` is a number with an optional value, which has no number to give when written alone; give its form as `N` or `=N`"))
                fail Error.BAD_SPEC
            if s.kind == Kind.Choice && #len(s.default_text) > 0 && !has_choice(inner(s.form), s.default_text):
                self.set_failure(#format("the flag `", s.names, "` defaults to `", s.default_text, "`, which is not one of its choices `", inner(s.form), "`"))
                fail Error.BAD_SPEC
            at = 0
            i32 count = 0
            for at < #len(s.names):
                (i64 start, i64 stop) = next_word(s.names, at)
                if start == stop:
                    break
                string8 w = s.names[start..<stop]
                count += 1
                if !well_spelled(w):
                    self.set_failure(#format("the flag spelling `", w, "` in `", s.names, "` is neither a short `-c` (a dash and one byte) nor a long `--word`"))
                    fail Error.BAD_SPEC
                for j in 0..<i:
                    Spec o = self.specs[j]
                    if !is_positional(o.kind) && has_word(o.names, w) && overlap(o.scope, s.scope):
                        self.set_failure(#format("the flag spelling `", w, "` is declared twice where both reach (`", o.names,
                                                 "` and `", s.names, "`); remove one or give them scopes apart"))
                        fail Error.BAD_SPEC
                at = stop
            if count == 0:
                self.set_failure(#format("a flag is declared with no spelling; write its spellings, such as `-v --verbose`"))
                fail Error.BAD_SPEC
        for l in self.links:
            i64 k = self.find_anywhere(l.a)
            if k < 0:
                self.set_failure(#format("`env` links the variable `", l.b, "` to `", l.a, "`, which no flag spells; declare the flag first or correct the spelling"))
                fail Error.BAD_SPEC
            self.specs[k].env_name = l.b

    // The value of the environment variable `name` that `env_var` gave, and
    // whether it was given (and not empty).
    private (string8 value, bool found) variable(self, string8 name):
        for v in self.vars:
            if v.a == name:
                return (v.b, #len(v.b) > 0)
        return ("", false)

    // Every flag the command line left alone and `env` links to a variable
    // that is set: its value, checked as the command line's would be.
    private Error!void from_env(^self):
        string8 cmd = self.command_name()
        for i in 0..<#len(self.specs):
            Spec s = self.specs[i]
            if #len(s.env_name) == 0 || s.given || is_positional(s.kind) || !reaches(s.scope, cmd):
                continue
            (string8 v, bool found) = self.variable(s.env_name)
            if !found:
                continue
            if s.kind == Kind.Bool:
                try bool on = parse.to_bool(v) else:
                    self.set_failure(#format("the environment variable `", s.env_name, "`, which `", first_word(s.names),
                                             "` reads, holds `", v, "`; a switch reads `true`, `yes`, `on` or `1`, or their opposites"))
                    fail Error.BAD_VALUE
                self.specs[i].on = on
                self.specs[i].given = true
                continue
            try self.store(i, first_word(s.names), v) else code:
                self.set_failure(#format("the environment variable `", s.env_name, "`, which `", first_word(s.names),
                                         "` reads, holds `", v, "`: ", message(code)))
                fail code

    // The declaration of `spelling` that reaches the words being read, or -1.
    private i64 find(self, string8 spelling):
        string8 cmd = self.command_name()
        for i in 0..<#len(self.specs):
            Spec s = self.specs[i]
            if !is_positional(s.kind) && has_word(s.names, spelling) && reaches(s.scope, cmd):
                return i
        return -1

    // The first declaration of `spelling` in any scope, or -1.
    private i64 find_anywhere(self, string8 spelling):
        for i in 0..<#len(self.specs):
            Spec s = self.specs[i]
            if !is_positional(s.kind) && has_word(s.names, spelling):
                return i
        return -1

    // The spelling in reach nearest to `word`, or `""` when none is near.
    private string8 nearest_flag(self, string8 word):
        string8 cmd = self.command_name()
        string8 best = ""
        i64 best_d = near_limit(word)
        for s in self.specs:
            if is_positional(s.kind) || !reaches(s.scope, cmd):
                continue
            i64 at = 0
            for at < #len(s.names):
                (i64 start, i64 stop) = next_word(s.names, at)
                if start == stop:
                    break
                string8 w = s.names[start..<stop]
                i64 d = distance(word, w)
                if d <= best_d && (#len(best) == 0 || d < best_d):
                    best = w
                    best_d = d
                at = stop
        return best

    // The sentence for a flag `find` did not find: where it belongs, or the
    // nearest spelling in reach.
    private void unknown_flag(^self, string8 spelling):
        ref []char8 who = self.invocation()
        defer #delete(who)
        if who == nil:
            self.set_failure(nil)
            return
        i64 other = self.find_anywhere(spelling)
        if other >= 0:
            string8 owners = self.specs[other].scope
            ref []char8 names = listed(owners)
            defer #delete(names)
            if names == nil:
                self.set_failure(nil)
            else if self.chosen < 0:
                self.set_failure(#format("`", spelling, "` is a flag of the command ", string8(names[:]), ": write it after the command, as `",
                                         self.program, " ", first_word(owners), " ", spelling, "`"))
            else:
                self.set_failure(#format("`", spelling, "` is not a flag of `", string8(who[:]), "`; it belongs to ", string8(names[:])))
            return
        string8 near = self.nearest_flag(spelling)
        if #len(near) > 0:
            self.set_failure(#format("unknown flag `", spelling, "`; did you mean `", near, "`? (`", string8(who[:]), " --help` lists the flags)"))
        else:
            self.set_failure(#format("unknown flag `", spelling, "`; `", string8(who[:]), " --help` lists the flags"))

    // `--name`, `--name=value` or `--name value` at `args[i]`; answers the
    // index of the next word to read.
    private Error!i64 long_flag(^self, []string8 args, i64 i):
        string8 a = args[i]
        i64 eq = strings.index_of(a, '=')
        string8 spelling = a
        string8 attached = ""
        bool has_eq = eq >= 0
        if has_eq:
            spelling = a[0..<eq]
            attached = a[(eq + 1)..<#len(a)]
        i64 k = self.find(spelling)
        if k < 0:
            self.unknown_flag(spelling)
            fail Error.UNKNOWN_FLAG
        Spec s = self.specs[k]
        if s.kind == Kind.Bool:
            if has_eq:
                self.set_failure(#format("`", spelling, "` is a switch and takes no value: write `", spelling, "` alone, not `", a, "`"))
                fail Error.BAD_VALUE
            self.switch_on(k)
            return i + 1
        Form style = form_style(s.form)
        if has_eq:
            try self.store(k, spelling, attached)
            return i + 1
        if style == Form.Optional:
            try self.store_implied(k)
            return i + 1
        if style == Form.Equals:
            self.set_failure(#format("`", spelling, "` takes its value after `=`: write `", spelling, "=", inner(s.form), "`"))
            fail Error.MISSING_VALUE
        if i + 1 >= #len(args):
            self.set_failure(#format("`", spelling, "` wants a value: write `", spelling, " ", inner(s.form), "`"))
            fail Error.MISSING_VALUE
        try self.store(k, spelling, args[i + 1])
        return i + 2

    // A cluster of short flags at `args[i]`: `-v`, `-vh`, `-o PATH`,
    // `-o=PATH`, `-oPATH`; answers the index of the next word to read.
    private Error!i64 short_flags(^self, []string8 args, i64 i):
        string8 a = args[i]
        i64 j = 1
        for j < #len(a):
            [2]char8 pair = ['-', a[j]]
            string8 spelling = string8(pair[:])
            i64 k = self.find(spelling)
            if k < 0:
                self.unknown_flag(spelling)
                fail Error.UNKNOWN_FLAG
            Spec s = self.specs[k]
            if s.kind == Kind.Bool:
                if j + 1 < #len(a) && a[j + 1] == '=':
                    self.set_failure(#format("`", spelling, "` is a switch and takes no value: write `", spelling, "` alone, not `", a, "`"))
                    fail Error.BAD_VALUE
                self.switch_on(k)
                if self.helped:
                    return i + 1
                j += 1
                continue
            string8 after = a[(j + 1)..<#len(a)]
            Form style = form_style(s.form)
            if #len(after) > 0:
                if after[0] == '=':
                    after = after[1..<#len(after)]
                else if style != Form.Either:
                    self.set_failure(#format("`", spelling, "` takes its value after `=`: write `", spelling, "=", inner(s.form), "`"))
                    fail Error.MISSING_VALUE
                try self.store(k, spelling, after)
                return i + 1
            if style == Form.Optional:
                try self.store_implied(k)
                return i + 1
            if style == Form.Equals:
                self.set_failure(#format("`", spelling, "` takes its value after `=`: write `", spelling, "=", inner(s.form), "`"))
                fail Error.MISSING_VALUE
            if i + 1 >= #len(args):
                self.set_failure(#format("`", spelling, "` wants a value: write `", spelling, " ", inner(s.form), "`"))
                fail Error.MISSING_VALUE
            try self.store(k, spelling, args[i + 1])
            return i + 2
        return i + 1

    private void switch_on(^self, i64 k):
        self.specs[k].on = true
        self.specs[k].given = true
        if k == HELP:
            self.helped = true

    // A value for the flag `k`, checked against its kind.
    private Error!void store(^self, i64 k, string8 spelling, string8 v):
        Spec s = self.specs[k]
        if #len(v) == 0:
            self.set_failure(#format("`", spelling, "` wants a value, and an empty one is not one: write `", spelling, joiner(s.form), inner(s.form), "`"))
            fail Error.MISSING_VALUE
        if s.kind == Kind.Int:
            try i64 n = parse.to_i64(v) else:
                self.set_failure(#format("`", spelling, "` expects a whole number, not `", v, "`: write `", spelling, joiner(s.form), inner(s.form), "` with digits"))
                fail Error.BAD_VALUE
            self.specs[k].number = n
        else if s.kind == Kind.Float:
            try f64 x = parse.to_f64(v) else:
                self.set_failure(#format("`", spelling, "` expects a number, not `", v, "`: write `", spelling, joiner(s.form), inner(s.form), "` as digits, such as `1.5` or `2e-3`"))
                fail Error.BAD_VALUE
            self.specs[k].real = x
        else if s.kind == Kind.Choice:
            string8 choices = inner(s.form)
            if !has_choice(choices, v):
                string8 near = nearest_choice(choices, v)
                ref []char8 all = choice_list(choices)
                defer #delete(all)
                if all == nil:
                    self.set_failure(nil)
                else if #len(near) > 0:
                    self.set_failure(#format("`", spelling, "` expects ", string8(all[:]), ", not `", v, "`; did you mean `", near, "`?"))
                else:
                    self.set_failure(#format("`", spelling, "` expects ", string8(all[:]), ", not `", v, "`"))
                fail Error.BAD_VALUE
            self.specs[k].text = v
        else if s.kind == Kind.List:
            if !#append(self.specs[k].items, v):
                self.no_room(spelling)
                fail Error.NO_MEMORY
        else:
            self.specs[k].text = v
        self.specs[k].given = true

    // A form-`[=V]` flag written alone: the empty value, or a choice's first.
    private Error!void store_implied(^self, i64 k):
        Spec s = self.specs[k]
        string8 v = ""
        if s.kind == Kind.Choice:
            string8 choices = inner(s.form)
            (i64 start, i64 stop) = next_choice(choices, 0)
            v = choices[start..<stop]
        if s.kind == Kind.List:
            if !#append(self.specs[k].items, v):
                self.no_room(first_word(s.names))
                fail Error.NO_MEMORY
        else:
            self.specs[k].text = v
        self.specs[k].given = true

    private Error!void pick(^self, string8 word):
        i64 c = self.command_index(word)
        if c >= 0:
            self.chosen = c
            return
        string8 best = ""
        i64 best_d = near_limit(word)
        for cm in self.commands:
            i64 d = distance(word, cm.name)
            if d <= best_d && (#len(best) == 0 || d < best_d):
                best = cm.name
                best_d = d
        if #len(best) > 0:
            self.set_failure(#format("unknown command `", word, "`; did you mean `", best, "`? (`", self.program, " --help` lists the commands)"))
        else:
            self.set_failure(#format("unknown command `", word, "`; `", self.program, " --help` lists the commands"))
        fail Error.UNKNOWN_COMMAND

    // A positional word: into a `tail` after `--` when the command has one,
    // else the next unfilled `positional`, else a `rest`.
    private Error!void place(^self, string8 word, bool after_dash):
        string8 cmd = self.command_name()
        if after_dash:
            for i in 0..<#len(self.specs):
                Spec s = self.specs[i]
                if s.kind == Kind.Tail && reaches(s.scope, cmd):
                    if !#append(self.specs[i].items, word):
                        self.no_room(s.names)
                        fail Error.NO_MEMORY
                    return
        for i in 0..<#len(self.specs):
            Spec s = self.specs[i]
            if s.kind == Kind.Positional && !s.given && reaches(s.scope, cmd):
                self.specs[i].text = word
                self.specs[i].given = true
                return
        for i in 0..<#len(self.specs):
            Spec s = self.specs[i]
            if s.kind == Kind.Rest && reaches(s.scope, cmd):
                if !#append(self.specs[i].items, word):
                    self.no_room(s.names)
                    fail Error.NO_MEMORY
                return
        ref []char8 who = self.invocation()
        defer #delete(who)
        Writing takes = writing(32)
        bool tail = false
        for s in self.specs:
            if s.kind == Kind.Positional && reaches(s.scope, cmd):
                put(&takes, " ")
                put(&takes, s.names)
            if s.kind == Kind.Tail && reaches(s.scope, cmd):
                tail = true
        ref []char8 t = done(&takes)
        defer #delete(t)
        if who == nil || t == nil:
            self.set_failure(nil)
            fail Error.EXTRA_POSITIONAL
        string8 hint = ""
        if tail:
            hint = "; words for the program go after `--`"
        if #len(t) == 0:
            self.set_failure(#format("unexpected argument `", word, "`: `", string8(who[:]), "` takes no positional words", hint))
        else:
            self.set_failure(#format("unexpected argument `", word, "`: `", string8(who[:]), "` takes only", string8(t[:]), hint))
        fail Error.EXTRA_POSITIONAL

    private Error!void check_required(^self):
        string8 cmd = self.command_name()
        for s in self.specs:
            if s.kind == Kind.Positional && s.required && !s.given && reaches(s.scope, cmd):
                ref []char8 who = self.invocation()
                defer #delete(who)
                if who == nil:
                    self.set_failure(nil)
                    fail Error.MISSING_POSITIONAL
                self.set_failure(#format("`", string8(who[:]), "` wants ", s.names, " (", s.summary, "): write `", string8(who[:]), " ", s.names, "`"))
                fail Error.MISSING_POSITIONAL

    private void flag_section(self, ^Writing b, i64 cmd):
        bool shorts = false
        for s in self.specs:
            if !is_positional(s.kind) && #len(s.summary) > 0 && self.listed_here(s, cmd) && has_short(s.names):
                shorts = true
        i64 width = 0
        for s in self.specs:
            if !is_positional(s.kind) && #len(s.summary) > 0 && self.listed_here(s, cmd):
                i64 n = left_width(s, shorts)
                if n <= LEFT_MAX && n > width:
                    width = n
        put(b, "\nflags:\n")
        for s in self.specs:
            if !is_positional(s.kind) && #len(s.summary) > 0 && self.listed_here(s, cmd):
                ref []char8 left = left_column(s, shorts)
                ref []char8 said = described(s)
                if left == nil || said == nil:
                    b.lost = true
                else:
                    entry(b, string8(left[:]), string8(said[:]), width + 2)
                if left != nil:
                    #delete(left)
                if said != nil:
                    #delete(said)

    // Whether the help for `cmd` lists `s`: the program's help lists the
    // flags of every scope when there are no commands, and only the shared
    // ones when there are.
    private bool listed_here(self, Spec s, i64 cmd):
        if cmd < 0:
            return #len(s.scope) == 0
        return reaches(s.scope, self.commands[cmd].name)

// A parser for `program`, which the help and the error sentences name, with
// the one-paragraph `summary` the program's help shows. It declares `-h
// --help` itself.
#assert_raises
Parser parser(string8 program, string8 summary):
    Parser p
    p.program = program
    p.summary = summary
    p.chosen = -1
    p.commands = #make([]Command, 0)
    p.specs = #make([]Spec, 0)
    p.links = #make([]EnvLink, 0)
    p.vars = #make([]EnvLink, 0)
    p.starved = p.commands == nil || p.specs == nil || p.links == nil || p.vars == nil
    _ = p.boolean("-h --help", "print this help and stop")
    return p

// ── the table ─────────────────────────────────────────────────────────────

private type Command: (string8 name, string8 summary)

// Two words: a flag's spelling and the variable `env` links it to, or a
// variable's name and the value `env_var` gave it.
private type EnvLink: (string8 a, string8 b)

private type Spec:
    Kind kind
    string8 names
    string8 form
    string8 summary
    string8 scope
    string8 default_text
    i64 default_number
    bool required
    bool given
    bool on
    string8 text
    i64 number
    ref []string8 items
    f64 default_real
    f64 real
    string8 env_name

// What a declaration is, which decides what `parse` stores in it and what
// may be read from it.
private enum i32 Kind: (Bool, Text, Int, List, Choice, Positional, Rest, Tail, Float)

// `-h --help`, declared first by `parser`.
private const i64 HELP = 0

// How a flag's form says its value is given: `PATH` (after a space or
// `=`), `=PATH` (only after `=`), `[=PATH]` (after `=`, or not at all).
private enum i32 Form: (Either, Equals, Optional)

// The help's left column wraps to its own line past this width.
private const i64 LEFT_MAX = 30

// The help wraps its text to this many columns.
private const i64 COLUMNS = 80

private bool is_positional(Kind kind):
    return kind == Kind.Positional || kind == Kind.Rest || kind == Kind.Tail

// ── words in a declaration ────────────────────────────────────────────────

// The next space-separated word of `s` at or after `at`, as `[start, stop)`;
// `start == stop` when there is none.
private (i64 start, i64 stop) next_word(string8 s, i64 at):
    i64 i = at
    for i < #len(s) && s[i] == ' ':
        i += 1
    i64 j = i
    for j < #len(s) && s[j] != ' ':
        j += 1
    return (i, j)

private bool has_word(string8 list, string8 w):
    i64 at = 0
    for at < #len(list):
        (i64 start, i64 stop) = next_word(list, at)
        if start == stop:
            return false
        if list[start..<stop] == w:
            return true
        at = stop
    return false

private string8 first_word(string8 list):
    (i64 start, i64 stop) = next_word(list, 0)
    return list[start..<stop]

// Whether a declaration of `scope` applies under the command `cmd` (`""`
// before any command).
private bool reaches(string8 scope, string8 cmd):
    if #len(scope) == 0:
        return true
    if #len(cmd) == 0:
        return false
    return has_word(scope, cmd)

// Whether two scopes share a place where both apply.
private bool overlap(string8 a, string8 b):
    if #len(a) == 0 || #len(b) == 0:
        return true
    i64 at = 0
    for at < #len(a):
        (i64 start, i64 stop) = next_word(a, at)
        if start == stop:
            return false
        if has_word(b, a[start..<stop]):
            return true
        at = stop
    return false

// `build run test` as "`build`, `run` or `test`".
private ref []char8 listed(string8 list):
    Writing b = writing(32)
    i64 total = 0
    i64 at = 0
    for at < #len(list):
        (i64 start, i64 stop) = next_word(list, at)
        if start == stop:
            break
        total += 1
        at = stop
    i64 n = 0
    at = 0
    for at < #len(list):
        (i64 start, i64 stop) = next_word(list, at)
        if start == stop:
            break
        if n > 0 && n == total - 1:
            put(&b, " or ")
        else if n > 0:
            put(&b, ", ")
        put(&b, "`")
        put(&b, list[start..<stop])
        put(&b, "`")
        n += 1
        at = stop
    return done(&b)

private bool well_spelled(string8 w):
    if #len(w) == 2:
        return w[0] == '-' && w[1] != '-' && w[1] != '='
    if #len(w) < 3 || w[0] != '-' || w[1] != '-' || w[2] == '-':
        return false
    for i in 2..<#len(w):
        if w[i] == '=':
            return false
    return true

private bool has_short(string8 names):
    i64 at = 0
    for at < #len(names):
        (i64 start, i64 stop) = next_word(names, at)
        if start == stop:
            return false
        if stop - start == 2:
            return true
        at = stop
    return false

// ── forms ─────────────────────────────────────────────────────────────────

private Form form_style(string8 form):
    if #len(form) >= 3 && form[0] == '[' && form[1] == '=' && form[#len(form) - 1] == ']':
        return Form.Optional
    if #len(form) >= 1 && form[0] == '=':
        return Form.Equals
    return Form.Either

// The placeholder alone: `PATH` of `PATH`, `=PATH` and `[=PATH]`.
private string8 inner(string8 form):
    Form style = form_style(form)
    if style == Form.Optional:
        return form[2..<(#len(form) - 1)]
    if style == Form.Equals:
        return form[1..<#len(form)]
    return form

// The form as it follows a spelling: ` PATH`, `=PATH`, `[=PATH]`.
private ref []char8 written(string8 form):
    if #len(form) == 0:
        return #format("")
    if form_style(form) == Form.Either:
        return #format(" ", form)
    return #format(form)

// What joins a spelling to its value in a sentence: a space, or `=` for a
// form that takes its value only after one.
private string8 joiner(string8 form):
    if form_style(form) == Form.Either:
        return " "
    return "="

// The next `|`-separated choice of `choices` at or after `at`.
private (i64 start, i64 stop) next_choice(string8 choices, i64 at):
    i64 j = at
    for j < #len(choices) && choices[j] != '|':
        j += 1
    return (at, j)

private bool has_choice(string8 choices, string8 v):
    i64 at = 0
    for at <= #len(choices):
        (i64 start, i64 stop) = next_choice(choices, at)
        if choices[start..<stop] == v:
            return true
        at = stop + 1
    return false

private string8 nearest_choice(string8 choices, string8 v):
    string8 best = ""
    i64 best_d = near_limit(v)
    i64 at = 0
    for at <= #len(choices):
        (i64 start, i64 stop) = next_choice(choices, at)
        string8 c = choices[start..<stop]
        i64 d = distance(v, c)
        if d <= best_d && (#len(best) == 0 || d < best_d):
            best = c
            best_d = d
        at = stop + 1
    return best

// `address|thread` as "`address` or `thread`".
private ref []char8 choice_list(string8 choices):
    Writing b = writing(32)
    i64 at = 0
    bool first = true
    for at <= #len(choices):
        (i64 start, i64 stop) = next_choice(choices, at)
        if !first:
            if stop >= #len(choices):
                put(&b, " or ")
            else:
                put(&b, ", ")
        put(&b, "`")
        put(&b, choices[start..<stop])
        put(&b, "`")
        first = false
        at = stop + 1
    return done(&b)

// ── the nearest spelling ──────────────────────────────────────────────────

// How far a suggestion may be from what was typed: a third of its length
// without the dashes, and at least one edit.
private i64 near_limit(string8 word):
    i64 n = #len(word)
    i64 i = 0
    for i < n && word[i] == '-':
        i += 1
    i64 lim = (n - i) / 3
    if lim < 1:
        return 1
    return lim

// The edit distance between `a` and `b`: insertions, deletions,
// substitutions and swaps of two neighbouring bytes, each one edit (the
// optimal string alignment distance), or a number past any limit when
// either is longer than 64 bytes.
private i64 distance(string8 a, string8 b):
    i64 n = #len(a)
    i64 m = #len(b)
    if n > 64 || m > 64:
        return 1000
    [65]i64 back
    [65]i64 prev
    [65]i64 cur
    for j in 0..=m:
        prev[j] = j
    for i in 1..=n:
        cur[0] = i
        for j in 1..=m:
            i64 cost = 1
            if a[i - 1] == b[j - 1]:
                cost = 0
            i64 best = prev[j - 1] + cost
            if prev[j] + 1 < best:
                best = prev[j] + 1
            if cur[j - 1] + 1 < best:
                best = cur[j - 1] + 1
            if i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] && back[j - 2] + 1 < best:
                best = back[j - 2] + 1
            cur[j] = best
        for j in 0..=m:
            back[j] = prev[j]
            prev[j] = cur[j]
    return prev[m]

// ── text being written ────────────────────────────────────────────────────

// Text being written that remembers a piece it could not keep, so the help
// and the sentences are whole or `nil`, never a part with words missing.
private type Writing:
    strings.Builder b
    bool lost

private Writing writing(i64 room):
    Writing w
    w.b = strings.builder(room)
    w.lost = w.b == nil
    return w

private void put(^Writing w, string8 s):
    if !strings.append(&w.b, s):
        w.lost = true

private void put_char(^Writing w, char8 c):
    if !strings.append_char(&w.b, c):
        w.lost = true

// `piece` on the end, then freed; a `nil` piece loses the text.
private void put_owned(^Writing w, ref []char8 piece):
    if piece == nil:
        w.lost = true
        return
    put(w, string8(piece[:]))
    #delete(piece)

// The text, or `nil` when any piece of it was lost.
private ref []char8 done(^Writing w):
    if w.lost:
        if w.b != nil:
            #delete(w.b)
        w.b = nil
        return nil
    return strings.finish(&w.b)

// ── the help's layout ─────────────────────────────────────────────────────

// A positional in the usage line: `PKG`, `[PKG]`, `[FILE...]`, `[-- ARGS...]`.
private ref []char8 usage_word(Spec s):
    if s.kind == Kind.Rest:
        return #format("[", s.names, "...]")
    if s.kind == Kind.Tail:
        return #format("[-- ", s.names, "...]")
    if s.required:
        return #format(s.names)
    return #format("[", s.names, "]")

// `-v, --verbose`, `-o PATH`, `    --manifest=LIST`: the flag's spellings
// joined, its form after the last, and room for a short one when any flag
// listed beside it has one.
private ref []char8 left_column(Spec s, bool shorts):
    Writing b = writing(32)
    put(&b, "  ")
    (i64 s0, i64 e0) = next_word(s.names, 0)
    if shorts && e0 - s0 != 2:
        put(&b, "    ")
    i64 at = 0
    bool first = true
    for at < #len(s.names):
        (i64 start, i64 stop) = next_word(s.names, at)
        if start == stop:
            break
        if !first:
            put(&b, ", ")
        put(&b, s.names[start..<stop])
        first = false
        at = stop
    put_owned(&b, written(s.form))
    return done(&b)

private i64 left_width(Spec s, bool shorts):
    i64 n = 0
    (i64 s0, i64 e0) = next_word(s.names, 0)
    if shorts && e0 - s0 != 2:
        n += 4
    i64 at = 0
    bool first = true
    for at < #len(s.names):
        (i64 start, i64 stop) = next_word(s.names, at)
        if start == stop:
            break
        if !first:
            n += 2
        n += stop - start
        first = false
        at = stop
    if #len(s.form) > 0 && form_style(s.form) == Form.Either:
        n += 1
    return n + #len(s.form)

// The summary with what the help adds: the default, that it repeats, and the
// environment variable it falls back to.
private ref []char8 described(Spec s):
    ref []char8 said = #format(s.summary)
    if s.kind == Kind.List:
        said = again(said, #format(string8(said[:]), " (repeatable)"))
    if (s.kind == Kind.Text || s.kind == Kind.Choice) && #len(s.default_text) > 0:
        said = again(said, #format(string8(said[:]), " (default: ", s.default_text, ")"))
    if s.kind == Kind.Int && s.default_number != 0:
        said = again(said, #format(string8(said[:]), " (default: ", s.default_number, ")"))
    if s.kind == Kind.Float && s.default_real != 0.0:
        // The shortest digits that read back, written by `core:fmt` in Dado:
        // `#format` of a float is C's `%g` and is refused freestanding.
        [32]char8 digits
        i32 n = fmt.render_float_shortest(s.default_real, digits[:])
        said = again(said, #format(string8(said[:]), " (default: ", string8(digits[0..<i64(n)]), ")"))
    if #len(s.env_name) > 0:
        said = again(said, #format(string8(said[:]), " (env: ", s.env_name, ")"))
    return said

// `next`, having freed `old`, which `next` was made from; `nil` when either
// is, so a description the allocator cut short is never answered.
private ref []char8 again(ref []char8 old, ref []char8 next):
    if old == nil:
        if next != nil:
            #delete(next)
        return nil
    #delete(old)
    return next

// One aligned entry: `left` (already indented when it is a flag's column,
// indented here otherwise), then `text` from column `width + 2`, wrapped. A
// `left` too wide for the column gets a line of its own.
private void entry(^Writing b, string8 left, string8 text, i64 width):
    string8 l = left
    bool indent = #len(l) == 0 || l[0] != ' '
    if indent:
        put(b, "  ")
    put(b, l)
    i64 used = #len(l)
    if indent:
        used += 2
    i64 col = width + 2
    if used + 2 > col:
        put(b, "\n")
        used = 0
    for used < col:
        put_char(b, ' ')
        used += 1
    wrap(b, text, col, col)

// `text` wrapped at spaces to `COLUMNS`, the first line starting at column
// `first` (already reached) and the rest indented to `indent`; ends the line.
private void wrap(^Writing b, string8 text, i64 first, i64 indent):
    i64 col = first
    bool line_empty = true
    i64 at = 0
    for at < #len(text):
        (i64 start, i64 stop) = next_word(text, at)
        if start == stop:
            break
        i64 n = stop - start
        if !line_empty && col + 1 + n > COLUMNS:
            put(b, "\n")
            for k in 0..<indent:
                put_char(b, ' ')
            col = indent
            line_empty = true
        if !line_empty:
            put_char(b, ' ')
            col += 1
        put(b, text[start..<stop])
        col += n
        line_empty = false
        at = stop
    put(b, "\n")
