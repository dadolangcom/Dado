@test
// The file layer, on a target with files: a round trip through `save` and
// `load`, `save` over a hand-written file keeping its comments, a missing
// file loading clean, `exists` saying no to a missing path and to a
// directory, a directory loading as not `ok`, and `save` answering false
// where nothing can be written. Everything happens in a directory `core:os/fs` makes where the
// system keeps temporary files, removed at the end. On the web, where no
// file opens yet, it checks that the layer says so instead.
package cfg

import "core:os"
import "core:os/fs"

private ref []char8 under(string8 dir, string8 name):
    return #format(dir, "/", name)

i32 test():
    when #OS == #WEB:
        return 0 if no_files() else 1
    else:
        return 0 if disk() else 1

// On the web `core:io` opens no file yet, and the file layer says so: an
// empty `Config` that is not `ok`, a `save` that answers false, and no file
// that exists.
private bool no_files():
    Config c = empty()
    set_i32(&c, "s", "k", 1)
    bool ok = #expect(!save(c, "settings.ini"), "save answered true with no file system")
    destroy(&c)
    ok = #expect(!exists("settings.ini"), "a file exists with no file system") && ok
    (Config back, bool lok, i32 bad) = load("settings.ini")
    ok = #expect(!lok && bad == 0 && get_i32(back, "s", "k", 0) == 0, "load answered something with no file system") && ok
    destroy(&back)
    return ok

private bool disk():
    bool ok = true
    try ref []char8 made = fs.make_temp_dir("dado-cfg-test-") else code:
        return #expect(false, "make_temp_dir: ", os.message(code))
    string8 dir = string8(made[:])
    ref []char8 settings = under(dir, "settings.ini")
    ref []char8 missing = under(dir, "missing.ini")

    // ── a round trip ──────────────────────────────────────────────────────
    Config out = empty()
    set_string(&out, "", "app", "toy")
    set_i32(&out, "window", "width", 1024)
    set_f64(&out, "window", "scale", 1.25)
    set_bool(&out, "window", "vsync", true)
    set_u64(&out, "net", "id", 18446744073709551615)
    ok = #expect(save(out, settings), "save answered false") && ok
    ok = #expect(exists(settings), "exists was false right after save") && ok
    (Config back, bool lok, i32 lbad) = load(settings)
    ok = #expect(lok && lbad == 0, "loading the saved file: ok ", lok, ", bad lines ", lbad) && ok
    ok = #expect(get_string(back, "", "app", "?") == "toy", "app was ", get_string(back, "", "app", "?")) && ok
    ok = #expect(get_i32(back, "window", "width", 0) == 1024, "width was ", get_i32(back, "window", "width", 0)) && ok
    ok = #expect(get_f64(back, "window", "scale", 0.0) == 1.25, "scale was ", get_f64(back, "window", "scale", 0.0)) && ok
    ok = #expect(get_bool(back, "window", "vsync", false), "vsync was false") && ok
    ok = #expect(get_u64(back, "net", "id", 0) == 18446744073709551615, "net.id was ", get_u64(back, "net", "id", 0)) && ok
    destroy(&out)

    // ── save over a hand-written file keeps its comments ──────────────────
    destroy(&back)
    ref []char8 hand = #format(dir, "/hand.ini")
    string8 written = "; written by a person\n[window]\n# the width\nwidth = 800\n"
    try fs.write_file(string8(hand[:]), written) else code:
        ok = #expect(false, "write_file: ", os.message(code)) && ok
    (Config h, bool hok, i32 _) = load(hand)
    ok = #expect(hok, "the hand-written file did not load clean") && ok
    set_i32(&h, "window", "width", 1024)
    set_i32(&h, "window", "height", 768)
    ok = #expect(save(h, hand), "save over the hand-written file answered false") && ok
    destroy(&h)
    ref []char8 after
    try after = fs.read_file(string8(hand[:])) else code:
        ok = #expect(false, "read_file: ", os.message(code)) && ok
    string8 want = "; written by a person\n[window]\n# the width\nwidth = 1024\nheight = 768\n"
    ok = #expect(after != nil && string8(after[:]) == want, "save over a hand-written file wrote:\n", string8(after[:])) && ok
    #delete(after)
    #delete(hand)

    // ── a missing file loads clean; exists says no to it and to a directory ─
    ok = #expect(!exists(missing), "a missing file exists") && ok
    ok = #expect(!exists(dir), "a directory exists as a file") && ok
    (Config none, bool mok, i32 mbad) = load(missing)
    ok = #expect(mok && mbad == 0, "loading a missing file was not clean") && ok
    ok = #expect(get_string(none, "", "anything", "fallback") == "fallback", "a missing file's Config answered something") && ok
    destroy(&none)

    // ── a file that is there and cannot be read; a path that cannot be written ─
    //
    // A directory is there and does not read as a file, so `load` answers an
    // empty `Config` that is not `ok`; a path under a directory that does not
    // exist cannot be written, and neither can a directory, so `save` answers
    // false for both and makes nothing.
    (Config unread, bool uok, i32 ubad) = load(dir)
    ok = #expect(!uok && ubad == 0, "loading a directory: ok ", uok, ", bad lines ", ubad) && ok
    ok = #expect(get_string(unread, "", "anything", "fallback") == "fallback", "a directory's Config answered something") && ok
    destroy(&unread)
    ref []char8 nowhere = under(dir, "no-such-dir/settings.ini")
    Config w = empty()
    set_i32(&w, "s", "k", 1)
    ok = #expect(!save(w, nowhere), "save under a missing directory answered true") && ok
    ok = #expect(!fs.exists(nowhere), "save under a missing directory made a file") && ok
    ok = #expect(!save(w, dir), "save over a directory answered true") && ok
    destroy(&w)
    #delete(nowhere)

    try fs.remove_all(dir) else code:
        ok = #expect(false, "removing the temporary directory: ", os.message(code)) && ok
    #delete(settings)
    #delete(missing)
    #delete(made)
    return ok
