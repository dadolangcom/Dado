@test
// The text half's later claims, with no file:
//
//   * **quoted values** read their escapes, and a quote that does not close,
//     an escape this format lacks or a second quoted part is a bad line;
//   * **`render` quotes exactly what needs it**, sorts sections and keys,
//     and `parse` of what it wrote is the `Config` it was given;
//   * **`render_over` keeps what a person wrote** — comments, blank lines,
//     an unchanged line byte for byte — rewrites a changed value in place,
//     drops a removed key or section, puts a new key after its section's last
//     line and a new section at the end, checked against the whole text;
//   * **every typed getter is strict**, and `i64`/`u64` round-trip their
//     extremes;
//   * **`remove_key` and `remove_section`** say whether there was something
//     to remove, and free what they remove (LeakSanitizer would say).
package cfg

private bool is_text(ref []char8 got, string8 want, string8 what):
    if got == nil:
        return #expect(false, what, ": nil")
    string8 text = string8(got[:])
    bool ok = #expect(text == want, what, ":\n", text, "\nshould be:\n", want)
    #delete(got)
    return ok

i32 test():
    bool ok = true

    // ── quoted values ─────────────────────────────────────────────────────
    string8 quoted = "a = \"  spaced  \"\nb = \"say \\\"hi\\\" \\\\ there\\nnext\\tend\"\nc = say \"hi\" \\n\nd = \"\"\nbad1 = \"open\nbad2 = \"what \\q\"\nbad3 = \"one\" \"two\"\n"
    (Config q, i32 qbad) = parse(quoted)
    ok = #expect(qbad == 3, "quoted text bad_lines was ", qbad) && ok
    ok = #expect(get_string(q, "", "a", "?") == "  spaced  ", "a was [", get_string(q, "", "a", "?"), "]") && ok
    ok = #expect(get_string(q, "", "b", "?") == "say \"hi\" \\ there\nnext\tend", "b was [", get_string(q, "", "b", "?"), "]") && ok
    ok = #expect(get_string(q, "", "c", "?") == "say \"hi\" \\n", "a bare value was read as quoted: [", get_string(q, "", "c", "?"), "]") && ok
    ok = #expect(get_string(q, "", "d", "?") == "", "an empty quoted value was [", get_string(q, "", "d", "?"), "]") && ok
    bool bad_absent = false
    string8 stored = ""
    try stored = get(q, "", "bad1") else:
        bad_absent = true
    ok = #expect(bad_absent, "an unclosed quote was stored: ", stored) && ok
    // Every value that parsed renders back to itself.
    ref []char8 qtext = render(q)
    (Config q2, i32 q2bad) = parse(string8(qtext[:]))
    ok = #expect(q2bad == 0, "rendered quoted values did not parse clean") && ok
    for key in ["a", "b", "c", "d"]:
        ok = #expect(get_string(q2, "", key, "?") == get_string(q, "", key, "!"), "value ", key, " changed in a render and parse") && ok
    ok = is_text(qtext, "a = \"  spaced  \"\nb = \"say \\\"hi\\\" \\\\ there\\nnext\\tend\"\nc = say \"hi\" \\n\nd = \n", "render quotes what needs it") && ok
    destroy(&q)
    destroy(&q2)

    // ── render: sorted, sections after the default one ────────────────────
    Config r = empty()
    set_string(&r, "zone", "k", "v")
    set_i32(&r, "", "b", 2)
    set_i32(&r, "", "a", 1)
    set_string(&r, "alpha", "y", "2")
    set_string(&r, "alpha", "x", "1")
    ok = is_text(render(r), "a = 1\nb = 2\n\n[alpha]\nx = 1\ny = 2\n\n[zone]\nk = v\n", "render") && ok
    destroy(&r)

    // ── render_over keeps what a person wrote ─────────────────────────────
    string8 original = "; settings for the camp\nname = camp\ncount = 3\n\n# the window\n[window]\nwidth=800\nheight = 600\n; trailing comment in window\n\n[old]\nx = 1\n[empty]\n; nothing here yet\n"
    (Config o, i32 obad) = parse(original)
    ok = #expect(obad == 0, "the original did not parse clean") && ok
    ok = is_text(render_over(o, original), original, "an unchanged Config renders over its text as that text") && ok
    set_i32(&o, "window", "width", 1024)
    set_string(&o, "window", "title", "  padded  ")
    set_string(&o, "", "zeta", "z")
    set_i32(&o, "audio", "volume", 5)
    ok = #expect(remove_key(&o, "", "count"), "remove_key found nothing") && ok
    ok = #expect(!remove_key(&o, "", "count"), "remove_key removed twice") && ok
    ok = #expect(!remove_key(&o, "nowhere", "count"), "remove_key found a missing section") && ok
    ok = #expect(remove_section(&o, "old"), "remove_section found nothing") && ok
    ok = #expect(!remove_section(&o, "old"), "remove_section removed twice") && ok
    ok = #expect(get_i32(o, "old", "x", 0 - 1) == 0 - 1, "a removed section still answered") && ok
    string8 want = "; settings for the camp\nname = camp\nzeta = z\n\n# the window\n[window]\nwidth = 1024\nheight = 600\ntitle = \"  padded  \"\n; trailing comment in window\n\n[empty]\n; nothing here yet\n\n[audio]\nvolume = 5\n"
    ok = is_text(render_over(o, original), want, "render_over") && ok
    // A file with no header gets new default keys at the end, and no
    // original at all is `render`.
    ok = is_text(render_over(o, "; only a comment\n"), "; only a comment\nname = camp\nzeta = z\n\n[audio]\nvolume = 5\n\n[empty]\n\n[window]\nheight = 600\ntitle = \"  padded  \"\nwidth = 1024\n", "render_over a comment") && ok
    destroy(&o)

    // ── strict getters, and the 64-bit ones ───────────────────────────────
    Config n = empty()
    set_string(&n, "", "apples", "12 apples")
    set_string(&n, "", "hex", "0x10")
    set_string(&n, "", "neg", "-5")
    set_string(&n, "", "big", "2147483648")
    set_i64(&n, "", "min", (0 - 9223372036854775807) - 1)
    set_u64(&n, "", "max", 18446744073709551615)
    ok = #expect(get_i32(n, "", "apples", 7) == 7, "get_i32 read a number out of words") && ok
    ok = #expect(get_i32(n, "", "hex", 7) == 7, "get_i32 read a prefix") && ok
    ok = #expect(get_i32(n, "", "neg", 7) == 0 - 5, "get_i32 of -5") && ok
    ok = #expect(get_i32(n, "", "big", 7) == 7, "get_i32 past its range") && ok
    ok = #expect(get_i64(n, "", "big", 7) == 2147483648, "get_i64 of 2^31") && ok
    ok = #expect(get_i64(n, "", "min", 7) == (0 - 9223372036854775807) - 1, "get_i64 of its minimum: ", get_i64(n, "", "min", 7)) && ok
    ok = #expect(get_i64(n, "", "max", 7) == 7, "get_i64 past its range") && ok
    ok = #expect(get_u64(n, "", "max", 7) == 18446744073709551615, "get_u64 of its maximum: ", get_u64(n, "", "max", 7)) && ok
    ok = #expect(get_u64(n, "", "neg", 7) == 7, "get_u64 of a negative") && ok
    ok = #expect(get_i64(n, "", "apples", 7) == 7 && get_u64(n, "", "nothing", 9) == 9, "get_i64/get_u64 fallbacks") && ok
    ok = #expect(get_f64(n, "", "apples", 1.5) == 1.5, "get_f64 read a number out of words") && ok
    destroy(&n)
    return 0 if ok else 1
