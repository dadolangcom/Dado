// The file layer: `load`, `save` and `exists`, a thin layer over `core:io` on
// top of the text half in `cfg.dado`. Paths are `string8`, UTF-8 on every
// system, as `core:io` and `core:os/fs` take them.
//
// **Not on `#NONE`.** A freestanding build has no files, and `core:io`
// declares no stream there, so these three are declared only where it does;
// `parse` and `render` are the whole package there. On the web `core:io`
// opens no file yet, so `load` answers an empty `Config` that is not `ok`,
// `save` answers false and `exists` false — and each starts working, with no
// change here, when `core:io` does.
//
// **Why `core:io` and not `core:os/fs`.** `fs.read_file` and `fs.write_file`
// are the whole-file calls this layer would otherwise be, but `core:os/fs`
// refuses a `#NONE` build at its `#static_assert`, an import cannot sit under
// a `when`, and this file is part of a package whose text half builds on
// `#NONE`. `core:io`'s `open` takes the same `string8` path (UTF-16 through
// `_wfopen` on Windows), and a failure is the same `os.Error`.
//
// **Not promised to raise into a script**: each reaches C's streams through
// `core:io`.
package cfg

import "core:io"
import "core:os"

when #OS != #NONE:
    // Whether `path` names a file `load` would read: one that opens and
    // reads, so not a missing path and not a directory.
    bool exists(string8 path):
        try ^io.FILE f = io.open(path, "rb") else:
            return false
        _ = io.read_byte(f)
        bool readable = !io.failed(f)
        _ = io.close(f)
        return readable

    // Read `path` and parse it onto `#default`; the caller ends the `Config`
    // with `destroy`. A missing file is not an error: it answers an empty
    // `Config` with `ok` true and `bad_lines` 0, which is what lets "no file
    // yet, write defaults" share this call with "read it back". A file that
    // is there and cannot be read, or whose text cannot be allocated, answers
    // an empty `Config` with `ok` false and `bad_lines` 0. Otherwise `ok` is
    // `bad_lines == 0`. Use `exists` first if the distinction matters.
    (Config cfg, bool ok, i32 bad_lines) load(string8 path):
        (ref []char8 text, i32 status) = slurp(path)
        if status != 0:
            return (fresh(), status == i32(os.Error.NOT_FOUND), 0)
        (Config cfg, i32 bad) = parse(string8(text[:]))
        #delete(text)
        return (cfg, bad == 0, bad)

    // Write `cfg` to `path` as INI text. When a file is already there, `cfg`
    // is rendered over it (`render_over`), so its comments, blank lines and
    // order survive; otherwise it is rendered fresh (`render`). False when
    // the file cannot be written, or an allocation fails. The scratch it
    // allocates is on `#default`, and freed before it returns.
    bool save(Config cfg, string8 path):
        (ref []char8 old, i32 status) = slurp(path)
        string8 original = ""
        if status == 0:
            original = string8(old[:])
        ref []char8 text = render_over(cfg, original)
        #delete(old)
        if text == nil:
            return false
        try ^io.FILE f = io.open_write(path) else:
            #delete(text)
            return false
        i64 wrote = io.write_bytes(f, text[:])
        bool whole = wrote == #len(text) && !io.failed(f)
        bool closed = io.close(f) == 0
        #delete(text)
        return whole && closed

    // The bytes of the file at `path` on `#default` and 0, or `nil` and the
    // `os.Error` it could not be read with: `NOT_FOUND` for no such file,
    // `IO` for a read that failed (a directory, on POSIX), `NO_MEMORY` when
    // the run cannot grow.
    private (ref []char8 text, i32 status) slurp(string8 path):
        try ^io.FILE f = io.open(path, "rb") else why:
            return (nil, i32(why))
        // `io.read_all` over `io.reader(f)` is this loop, but a call to it
        // from another package is ERR0920 at its `^Reader` today.
        ref []char8 text = #make([]char8, 0)
        [4096]char8 chunk
        os.Error why = os.Error.NO_MEMORY
        bool fine = text != nil
        for fine:
            i64 n = io.read_bytes(f, chunk[:])
            if n <= 0:
                if io.failed(f):
                    why = os.Error.IO
                    fine = false
                break
            fine = #reserve(text, #len(text) + n)
            for i in 0..<n:
                _ = #append(text, chunk[i])
        _ = io.close(f)
        if !fine:
            #delete(text)
            return (nil, i32(why))
        return (text, 0)
