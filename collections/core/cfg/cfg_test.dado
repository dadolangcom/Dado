@test
// The text half: `parse`'s tolerance and a round trip through `render`,
// with no file — so it runs on every target. `file_test.dado` takes the same
// round trip through a file, and `text_test.dado` covers quoting, comments
// kept by `render_over`, the strict getters and removal. What is claimed
// here:
//
//   * **the default section** — everything before the first `[header]`
//     lands in `""`, so a flat key=value file with no header still parses.
//   * **comments and blank lines** are ignored, `;` and `#` both.
//   * **whitespace** around `=` and around a section name is trimmed.
//   * **malformed lines are skipped, not fatal** — `bad_lines` counts them,
//     and every well-formed line around a bad one still
//     parses: boot anyway, rather than fail hard on a malformed file.
//   * **`get` fails `NOT_FOUND`** for a missing key or section, and answers
//     the value when it is there; `message` has a sentence for it.
//   * **missing keys** answer the caller's fallback, at every typed getter.
//   * **a round trip through text** — `set_*`, `render`, `parse`, and the
//     values read back equal to the values written, for string/i32/f64/bool
//     alike.
//   * **values don't borrow from the source** — `parse`'s `text` can be
//     freed the moment it returns and the `Config` is still good, because
//     every value is its own allocation.
//   * **every `Config` is ended by `destroy`**, and this file ends every one
//     it makes — so it runs clean under LeakSanitizer (`detect_leaks=1`),
//     which it did not before values became freeable (19,696 B in 169
//     allocations).
//     `destroy` of an `empty` config and a second `destroy` are both safe.
//     `roundtrip64_test.dado` is the 64-section, thousand-round claim.
package cfg

i32 test():
    bool ok = true

    // ── the default section, comments, blank lines, whitespace ────────────

    string8 text1 = "; a leading comment\nname = camp\n  count =   3  \n\n# another comment\n[window]\nwidth=800\nheight = 600\n"

    (Config c1, i32 bad1) = parse(text1)
    ok = #expect(bad1 == 0, "text1 bad_lines was ", bad1) && ok
    ok = #expect(get_string(c1, "", "name", "?") == "camp", "default-section name was ", get_string(c1, "", "name", "?")) && ok
    ok = #expect(get_string(c1, "", "count", "?") == "3", "default-section count was ", get_string(c1, "", "count", "?")) && ok
    ok = #expect(get_string(c1, "window", "width", "?") == "800", "window.width was ", get_string(c1, "window", "width", "?")) && ok
    ok = #expect(get_string(c1, "window", "height", "?") == "600", "window.height was ", get_string(c1, "window", "height", "?")) && ok
    // A key that exists in one section must not leak into another.
    string8 leaked = "(none)"
    bool missing = false
    try leaked = get(c1, "window", "name") else why:
        missing = true
        ok = #expect(why == Error.NOT_FOUND, "a missing key failed with ", message(why)) && ok
    ok = #expect(missing, "window.name should not exist, found ", leaked) && ok
    // `get` answers the value itself when it is there.
    try string8 width = get(c1, "window", "width") else why:
        _ = #expect(false, "get of window.width failed: ", message(why))
        return 1
    ok = #expect(width == "800", "get of window.width was ", width) && ok
    // A missing section fails as a missing key does.
    missing = false
    try leaked = get(c1, "nowhere", "width") else why:
        missing = true
        ok = #expect(why == Error.NOT_FOUND, "a missing section failed with ", message(why)) && ok
    ok = #expect(missing, "a missing section answered ", leaked) && ok
    ok = #expect(message(Error.NOT_FOUND) == "no such key in that section", "NOT_FOUND's message was ", message(Error.NOT_FOUND)) && ok
    ok = #expect(i32(Error.NOT_FOUND) == 1300, "NOT_FOUND is ", i32(Error.NOT_FOUND), ", outside cfg's 1300-1399") && ok
    destroy(&c1)
    ok = #expect(get_string(c1, "", "name", "gone") == "gone", "a destroyed Config still answered") && ok
    // Twice is nothing: `destroy` leaves the zero `Config`.
    destroy(&c1)

    // ── malformed lines: counted, not fatal, neighbours still parse ───────

    string8 text2 = "good = 1\nthis line has no equals sign\n[]\n[   ]\nalso_good = 2\n= no key\n[section]\nstill_good = 3\n"

    (Config c2, i32 bad2) = parse(text2)
    ok = #expect(bad2 == 4, "text2 bad_lines was ", bad2) && ok
    ok = #expect(get_string(c2, "", "good", "?") == "1", "good was ", get_string(c2, "", "good", "?")) && ok
    ok = #expect(get_string(c2, "", "also_good", "?") == "2", "also_good was ", get_string(c2, "", "also_good", "?")) && ok
    ok = #expect(get_string(c2, "section", "still_good", "?") == "3", "still_good was ", get_string(c2, "section", "still_good", "?")) && ok
    // The bad `= no key` line must not have landed anywhere as key "".
    bool nokey = false
    try leaked = get(c2, "", "") else:
        nokey = true
    ok = #expect(nokey, "an empty key should not exist") && ok
    destroy(&c2)

    // ── a key repeated in the text overwrites, and frees what it replaced ──
    //
    // The first value is freed by `put`; LeakSanitizer is what would say if
    // it were not. The last one read wins.
    (Config dup, i32 badd) = parse("k = one\nk = two\nk = three\n")
    ok = #expect(badd == 0, "the repeated-key text reported bad lines") && ok
    ok = #expect(get_string(dup, "", "k", "?") == "three", "a repeated key read back ", get_string(dup, "", "k", "?")) && ok
    destroy(&dup)

    // ── missing keys answer the fallback, every typed getter ──────────────

    Config blank = empty()
    ok = #expect(get_string(blank, "x", "y", "fallback") == "fallback", "get_string fallback was wrong") && ok
    ok = #expect(get_i32(blank, "x", "y", 42) == 42, "get_i32 fallback was wrong") && ok
    f64 fb = get_f64(blank, "x", "y", 1.5)
    ok = #expect(fb > 1.4999 && fb < 1.5001, "get_f64 fallback was wrong: ", fb) && ok
    ok = #expect(get_bool(blank, "x", "y", true), "get_bool fallback was wrong") && ok
    destroy(&blank)

    // ── values don't borrow from the source ────────────────────────────────
    //
    // Build the text in an owned buffer, parse it, then overwrite the buffer
    // before reading the Config back. If a value were a window into it, this
    // would read the overwritten bytes instead.
    i64 blen = #len(text1)
    ref []char8 tbuf = #make([]char8, blen)
    for i in 0..<blen:
        tbuf[i] = text1[i]
    string8 owned_text = string8(tbuf[:])
    (Config c3, i32 bad3) = parse(owned_text)
    ok = #expect(bad3 == 0, "owned-buffer parse reported bad lines") && ok
    for i in 0..<blen:
        tbuf[i] = 'Z'
    ok = #expect(get_string(c3, "", "name", "?") == "camp", "a value borrowed from a freed/overwritten buffer") && ok
    #delete(tbuf)
    destroy(&c3)

    // ── typed setters, and a round trip through disk ───────────────────────

    Config out = empty()
    set_string(&out, "", "app", "toy")
    set_i32(&out, "window", "width", 1024)
    set_i32(&out, "window", "height", 768)
    set_f64(&out, "window", "scale", 1.25)
    set_bool(&out, "window", "fullscreen", false)
    set_bool(&out, "window", "vsync", true)
    // An overwrite, of every kind: each frees the value it replaces.
    set_string(&out, "", "app", "toy-overwritten")
    set_string(&out, "", "app", "toy")
    set_i32(&out, "window", "width", 1)
    set_i32(&out, "window", "width", 1024)
    set_f64(&out, "window", "scale", 9.5)
    set_f64(&out, "window", "scale", 1.25)
    set_bool(&out, "window", "vsync", false)
    set_bool(&out, "window", "vsync", true)
    // Twelve more sections. A `Config`'s outer map holds one entry per
    // section and grows when its entries would pass three quarters of its
    // slots; with two sections this round trip exercised the setters and
    // never the growth, which is the one thing about a map that a setter can
    // get wrong. `&out` at every call is ERR0819's repair, and it is what
    // makes the growth happen in `out` rather than in a copy.
    set_i32(&out, "audio", "volume", 100)
    set_i32(&out, "input", "deadzone", 15)
    set_i32(&out, "video", "gamma", 1)
    set_i32(&out, "network", "port", 7777)
    set_i32(&out, "debug", "level", 2)
    set_i32(&out, "ui", "theme", 0)
    set_i32(&out, "log", "rotate", 7)
    set_i32(&out, "paths", "depth", 3)
    set_i32(&out, "physics", "steps", 60)
    set_i32(&out, "render", "msaa", 4)
    set_i32(&out, "save", "slots", 8)
    set_i32(&out, "misc", "seed", 1)

    ref []char8 text = render(out)
    ok = #expect(text != nil, "render answered nil") && ok
    (Config back, i32 bad4) = parse(string8(text[:]))
    #delete(text)
    ok = #expect(bad4 == 0, "the rendered text had bad lines: ", bad4) && ok
    ok = #expect(get_string(back, "", "app", "?") == "toy", "app was ", get_string(back, "", "app", "?")) && ok
    ok = #expect(get_i32(back, "window", "width", 0) == 1024, "width was ", get_i32(back, "window", "width", 0)) && ok
    ok = #expect(get_i32(back, "window", "height", 0) == 768, "height was ", get_i32(back, "window", "height", 0)) && ok
    f64 scale = get_f64(back, "window", "scale", 0.0)
    ok = #expect(scale > 1.2499 && scale < 1.2501, "scale was ", scale) && ok
    ok = #expect(get_bool(back, "window", "fullscreen", true) == false, "fullscreen was true") && ok
    ok = #expect(get_bool(back, "window", "vsync", false) == true, "vsync was false") && ok
    ok = #expect(get_i32(back, "misc", "seed", 0) == 1, "misc.seed was ", get_i32(back, "misc", "seed", 0)) && ok
    destroy(&out)
    destroy(&back)

    if ok:
        return 0
    return 1
