@test
// The pull reader: walking objects and arrays, keys and strings as views and
// as decoded copies, every number read at its limits, reads of the wrong type
// and out of turn leaving the reader where it was, a turn that reads nothing
// having its value skipped, and failures fixing their code and offset.
package json

private bool has_code(Error got, Error want, string8 what):
    return #expect(got == want, what, ": code ", got, " (", message(got), "), not ", want, " (", message(want), ")")

private bool walks():
    bool ok = true
    string8 text = "{\"name\": \"oak\", \"sizes\": [600, 18.5, -3], \"tall\": true, \"note\": null, \"x\": {\"y\": [1]}}"
    Reader r = reader_text(text)
    ref []char8 scratch
    defer #delete(scratch)
    // `name` is kept past later reads, and a view into a scratch run is good
    // only until that run is next written: it gets a run of its own.
    ref []char8 kept
    defer #delete(kept)
    string8 name = ""
    f64 total = 0.0
    bool tall = false
    bool saw_null = false
    try r.object() else code:
        return #expect(false, "object: ", message(code))
    for r.more():
        try string8 k = r.key(&scratch) else code:
            return #expect(false, "key: ", message(code))
        if k == "name":
            try name = r.text(&kept) else code:
                ok = #expect(false, "name: ", message(code)) && ok
        else if k == "sizes":
            try r.array() else code:
                return #expect(false, "array: ", message(code))
            for r.more():
                f64 v = 0.0
                try v = r.float() else code:
                    ok = #expect(false, "size: ", message(code)) && ok
                total += v
        else if k == "tall":
            try tall = r.boolean() else code:
                ok = #expect(false, "tall: ", message(code)) && ok
        else if k == "note":
            try r.null() else code:
                ok = #expect(false, "note: ", message(code)) && ok
            saw_null = true
        // "x" is read by nothing, so `more` skips it.
    try r.finish() else code:
        ok = #expect(false, "finish: ", message(code), " at ", r.offset()) && ok
    ok = #expect(name == "oak", "name is ", name) && ok
    ok = #expect(total == 615.5, "sizes total ", total) && ok
    ok = #expect(tall && saw_null, "tall and note") && ok
    ok = #expect(r.done() && r.code() == NONE && r.offset() == -1, "done, no code") && ok
    return ok

private bool strings():
    bool ok = true
    ref []char8 scratch
    defer #delete(scratch)
    // A plain string from text is a view into the text; scratch is untouched.
    string8 text = "[\"plain\", \"a\\n\\u00e9\\uD834\\uDD1E\\/\\\"\", \"\"]"
    Reader r = reader_text(text)
    try r.array() else:
        return #expect(false, "array")
    _ = r.more()
    try string8 a = r.text(&scratch) else code:
        return #expect(false, "plain: ", message(code))
    ok = #expect(a == "plain" && scratch == nil, "a plain string is a view") && ok
    _ = r.more()
    try string8 b = r.text(&scratch) else code:
        return #expect(false, "escaped: ", message(code))
    ok = #expect(b == "a\n\xC3\xA9\xF0\x9D\x84\x9E/\"", "escapes decode, got ", b) && ok
    _ = r.more()
    try string8 c = r.text(&scratch) else code:
        return #expect(false, "empty: ", message(code))
    ok = #expect(#len(c) == 0, "the empty string") && ok
    ok = #expect(!r.more(), "three strings") && ok
    try r.finish() else code:
        ok = #expect(false, "finish: ", message(code)) && ok
    // From bytes as from text: a string with an escape is decoded into
    // scratch, and a plain one is a view into the input, leaving scratch
    // as it was.
    Reader q = reader(Bytes("{\"k\\u0041\": \"v\", \"plain\": \"w\"}"))
    try q.object() else:
        return #expect(false, "object")
    _ = q.more()
    try string8 k = q.key(&scratch) else code:
        return #expect(false, "key: ", message(code))
    ok = #expect(k == "kA", "key from bytes ", k) && ok
    try ref []char8 v = q.text_copy() else code:
        return #expect(false, "text_copy: ", message(code))
    string8 vs = v
    ok = #expect(vs == "v", "text_copy ", vs) && ok
    #delete(v)
    _ = q.more()
    try string8 p = q.key(&scratch) else code:
        return #expect(false, "plain key: ", message(code))
    ok = #expect(p == "plain", "plain key from bytes ", p) && ok
    string8 still = scratch
    ok = #expect(still == "kA", "a plain key left scratch as ", still) && ok
    try string8 w = q.text(&scratch) else code:
        return #expect(false, "plain text: ", message(code))
    ok = #expect(w == "w", "plain text from bytes ", w) && ok
    try q.finish() else code:
        ok = #expect(false, "finish: ", message(code)) && ok
    return ok

// `text` holds one number; `int`, `uint` and `float` read it as these.
private bool number(string8 text, Error int_code, i64 i, Error uint_code, u64 u, f64 f):
    bool ok = true
    Reader a = reader_text(text)
    Error got = NONE
    i64 iv = 0
    try iv = a.int() else code:
        got = code
    ok = has_code(got, int_code, text) && ok
    if got == NONE:
        ok = #expect(iv == i, text, ": int ", iv) && ok
    Reader b = reader_text(text)
    got = NONE
    u64 uv = 0
    try uv = b.uint() else code:
        got = code
    ok = has_code(got, uint_code, text) && ok
    if got == NONE:
        ok = #expect(uv == u, text, ": uint ", uv) && ok
    Reader c = reader(Bytes(text))
    try f64 fv = c.float() else code:
        return #expect(false, text, ": float failed ", message(code))
    ok = #expect(fv == f, text, ": float ", fv, ", not ", f) && ok
    return ok

private bool numbers():
    bool ok = true
    ok = number("0", NONE, 0, NONE, 0, 0.0) && ok
    ok = number("-0", NONE, 0, NONE, 0, 0.0) && ok
    ok = number("42", NONE, 42, NONE, 42, 42.0) && ok
    ok = number("-42", NONE, -42, Error.OVERFLOW, 0, -42.0) && ok
    ok = number("9223372036854775807", NONE, 9223372036854775807, NONE, 9223372036854775807, 9223372036854775807.0) && ok
    ok = number("-9223372036854775808", NONE, -9223372036854775807 - 1, Error.OVERFLOW, 0, -9223372036854775808.0) && ok
    ok = number("9223372036854775808", Error.OVERFLOW, 0, NONE, 9223372036854775808, 9223372036854775808.0) && ok
    ok = number("-9223372036854775809", Error.OVERFLOW, 0, Error.OVERFLOW, 0, -9223372036854775809.0) && ok
    ok = number("18446744073709551615", Error.OVERFLOW, 0, NONE, 18446744073709551615, 18446744073709551615.0) && ok
    ok = number("18446744073709551616", Error.OVERFLOW, 0, Error.OVERFLOW, 0, 18446744073709551616.0) && ok
    ok = number("123456789012345678901234567890", Error.OVERFLOW, 0, Error.OVERFLOW, 0, 123456789012345678901234567890.0) && ok
    ok = number("1.5", Error.WRONG_TYPE, 0, Error.WRONG_TYPE, 0, 1.5) && ok
    ok = number("1e2", Error.WRONG_TYPE, 0, Error.WRONG_TYPE, 0, 100.0) && ok
    ok = number("-1.25E-2", Error.WRONG_TYPE, 0, Error.WRONG_TYPE, 0, -0.0125) && ok
    ok = number("0.1", Error.WRONG_TYPE, 0, Error.WRONG_TYPE, 0, 0.1) && ok
    ok = number("2.2250738585072011e-308", Error.WRONG_TYPE, 0, Error.WRONG_TYPE, 0, 2.2250738585072011e-308) && ok
    ok = number("1.7976931348623157e308", Error.WRONG_TYPE, 0, Error.WRONG_TYPE, 0, 1.7976931348623157e308) && ok
    ok = number("1e-400", Error.WRONG_TYPE, 0, Error.WRONG_TYPE, 0, 0.0) && ok
    // A digit string longer than any buffer goes through a run of its own.
    ok = number("3.14159265358979323846264338327950288419716939937510582097494459230781640628620899862803482534211706798214808651", Error.WRONG_TYPE, 0, Error.WRONG_TYPE, 0, 3.141592653589793) && ok
    Reader r = reader_text("1e400")
    try f64 inf = r.float() else:
        return #expect(false, "1e400 reads")
    ok = #expect(inf > 1.7976931348623157e308, "1e400 is an infinity, ", inf) && ok
    // number_text answers the digits as written.
    ref []char8 scratch
    defer #delete(scratch)
    Reader t = reader_text("[123456789012345678901234567890]")
    try t.array() else:
        return false
    _ = t.more()
    try string8 digits = t.number_text() else code:
        return #expect(false, "number_text: ", message(code))
    ok = #expect(digits == "123456789012345678901234567890", "number_text ", digits) && ok
    return ok

private bool turns():
    bool ok = true
    ref []char8 scratch
    defer #delete(scratch)
    // `a` is read after `scratch` is written again: a run of its own.
    ref []char8 kept
    defer #delete(kept)
    Reader r = reader_text("  {\"a\": \"x\", \"b\": [1, 2]}")
    Error got = NONE
    try _ = r.int() else code:
        got = code
    ok = has_code(got, Error.WRONG_TYPE, "int on an object") && ok
    ok = #expect(r.code() == NONE, "a wrong type does not fail the reader") && ok
    try Kind k = r.kind() else:
        return false
    ok = #expect(k == Kind.Object, "kind is Object") && ok
    try r.object() else:
        return false
    got = NONE
    try _ = r.text(&scratch) else code:
        got = code
    ok = has_code(got, Error.OUT_OF_TURN, "a value before more") && ok
    _ = r.more()
    got = NONE
    try _ = r.text(&scratch) else code:
        got = code
    ok = has_code(got, Error.OUT_OF_TURN, "a value where a key is due") && ok
    try string8 a = r.key(&kept) else:
        return false
    got = NONE
    try _ = r.key(&scratch) else code:
        got = code
    ok = has_code(got, Error.OUT_OF_TURN, "a second key") && ok
    got = NONE
    try _ = r.boolean() else code:
        got = code
    ok = has_code(got, Error.WRONG_TYPE, "boolean on a string") && ok
    try string8 x = r.text(&scratch) else:
        return false
    ok = #expect(a == "a" && x == "x", "a is x") && ok
    // "b"'s turn reads nothing, and `more` skips its key and its value.
    ok = #expect(r.more(), "b is due") && ok
    ok = #expect(!r.more(), "and then the end") && ok
    got = NONE
    try _ = r.int() else code:
        got = code
    ok = has_code(got, Error.OUT_OF_TURN, "a second top-level value") && ok
    try r.finish() else code:
        ok = #expect(false, "finish: ", message(code)) && ok
    return ok

// `text` fails with `want` at byte `at`, from a walk that reads every value.
private bool fails_at(string8 text, Error want, i64 at):
    Reader r = reader_text(text)
    Error got = NONE
    try r.finish() else code:
        got = code
    bool ok = has_code(got, want, text)
    ok = #expect(r.offset() == at, text, ": offset ", r.offset(), ", not ", at) && ok
    // The code sticks.
    Error again = NONE
    try _ = r.kind() else code:
        again = code
    return #expect(again == want || got == NONE, text, ": the code does not stick") && ok

private bool failures():
    bool ok = true
    ok = fails_at("", Error.TRUNCATED, 0) && ok
    ok = fails_at("   ", Error.TRUNCATED, 3) && ok
    ok = fails_at("[1 2]", Error.UNEXPECTED, 3) && ok
    ok = fails_at("[1,]", Error.UNEXPECTED, 3) && ok
    ok = fails_at("{\"a\" 1}", Error.UNEXPECTED, 5) && ok
    ok = fails_at("[01]", Error.BAD_NUMBER, 2) && ok
    ok = fails_at("[1.]", Error.BAD_NUMBER, 3) && ok
    ok = fails_at("[1e]", Error.BAD_NUMBER, 3) && ok
    ok = fails_at("[\"a\\qb\"]", Error.BAD_ESCAPE, 3) && ok
    ok = fails_at("[\"\\uD800\"]", Error.LONE_SURROGATE, 2) && ok
    ok = fails_at("[\"\\uDC00\"]", Error.LONE_SURROGATE, 2) && ok
    ok = fails_at("[\"a\tb\"]", Error.CONTROL_CHARACTER, 3) && ok
    ok = fails_at("[\"a\xC0\xAFb\"]", Error.BAD_UTF8, 3) && ok
    ok = fails_at("[1] x", Error.TRAILING, 4) && ok
    ok = fails_at("[1, tru]", Error.UNEXPECTED, 7) && ok
    ok = fails_at("[1, tru", Error.TRUNCATED, 7) && ok
    ok = fails_at("{\"a\": [1, {\"b\": ", Error.TRUNCATED, 16) && ok
    return ok

private bool depth():
    bool ok = true
    Reader r = reader_text("[[[1]]]", 2)
    Error got = NONE
    try r.finish() else code:
        got = code
    ok = has_code(got, Error.TOO_DEEP, "three deep under a limit of two") && ok
    ok = #expect(r.offset() == 2, "Error.TOO_DEEP at the third bracket, not ", r.offset()) && ok
    Reader s = reader_text("[[1]]", 2)
    try s.finish() else code:
        ok = #expect(false, "two deep under two: ", message(code)) && ok
    return ok

i32 test():
    bool ok = walks()
    ok = strings() && ok
    ok = numbers() && ok
    ok = turns() && ok
    ok = failures() && ok
    ok = depth() && ok
    return 0 if ok else 1
