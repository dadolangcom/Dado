// JSON (RFC 8259): a writer, a pull reader, and a tree.
//
//     json.Writer w = json.writer(indent: 2)
//     w.object()
//     w.key("name")
//     w.text("oak")
//     w.key("sizes")
//     w.array()
//     w.int(600)
//     w.float(18.5)
//     w.end_array()
//     w.end_object()
//     try ref []char8 text = w.finish() else code:
//         fmt.println(json.message(code))
//         return
//     defer #delete(text)
//
// `text` is then:
//
//     {
//       "name": "oak",
//       "sizes": [
//         600,
//         18.5
//       ]
//     }
//
// and it reads back a value at a time, allocating nothing:
//
//     json.Reader r = json.reader_text(text)
//     ref []char8 scratch
//     defer #delete(scratch)
//     try r.object()
//     for r.more():
//         try string8 name = r.key(&scratch)
//         if name == "sizes":
//             try r.array()
//             for r.more():
//                 try f64 size = r.float()
//     try r.finish()
//
// or whole, as a tree:
//
//     try json.Document doc = json.parse_text(text)
//     defer doc.destroy()
//     try json.Value sizes = doc.root().get("sizes")
//     try json.Value first = sizes.at(0)
//     try i64 n = first.int()                     // 600
//
// **The writer.** The text grows on the allocator that was `#default` when
// `writer` was called, so `json.writer() using a` puts it in `a`. Every call
// costs time in proportion to what it writes. Strings escape `"`, `\`, the
// control characters, DEL, U+0080 to U+009F, U+2028 and U+2029, and pass
// other valid UTF-8 through. A byte that is not valid UTF-8 becomes U+FFFD.
// Floats are the shortest text that reads back as the same value. Keys are
// written in the order given, and nothing checks that a key is not repeated.
// A call that cannot write what it was asked fails the writer with a code:
// the code is kept, later calls write nothing, and `finish` fails with it.
//
// **The reader** (`reader` over bytes, `reader_text` over text, one reader
// either way: `reader_text` views the text as bytes) is strict RFC 8259: no
// comments, trailing commas, leading zeros, `NaN`, single quotes or
// byte-order mark, and strings of well-formed UTF-8 whose `\u` escapes pair
// their surrogates. A string or number read with no escape is a view into the
// input; otherwise a read decodes into a scratch run the caller gives it.
// Integers read exactly as `i64` or `u64` and fail with `OVERFLOW` when they
// do not fit; any number reads as the nearest `f64`, correctly rounded by
// core:strings/parse. Objects and arrays nest at most `MAX_DEPTH` deep, and
// walking or skipping them costs no stack. Malformed input fails the reader
// for good with a code and the byte offset it was found at.
//
// **The tree** (`parse`, `parse_text`, `Reader.document`) holds a value in
// three runs on `#default`: a node per value, every container's children,
// and every string's text. `Value` is a handle into it whose lookups by
// index cost the same at any size; `get` by key is linear in the members.
// `Writer.value` writes a tree back.
//
// **Bytes or text.** JSON is UTF-8 text (RFC 8259, section 8.1), so each way
// in has a text form beside its bytes form: `reader_text`, `well_formed_text`
// and `parse_text` take the `string8` a program usually holds, and view it as
// the bytes `reader`, `well_formed` and `parse` read, copying nothing.
//
// **Error codes: `Error`, 1900 to 1999**, a range no other package's codes
// share; `message(why)` answers a sentence for each.
//
// **Tier N W H. Script class S.** No `foreign` block and no package state:
// it builds for every target, `#NONE` and `#WEB` included, and any thread
// may use it, one thread to a writer, reader or document.
//
// **What raises into a script.** Everything: every function and every
// method of `Writer`, `Reader`, `Document` and `Value`, each promised by the
// `#assert_raises` on the line above it.
package json

import "core:chars"
import "core:fmt"
import "core:math"

// Why a write or a read failed. The numbers are this package's, 1900 to
// 1999, apart from every other package's, so a code read anywhere never means
// two things.
distinct enum i32 Error:
    // A value written inside an object with no key before it.
    EXPECTED_KEY = 1900,
    // A key outside an object, or a second key before the first one's value.
    UNEXPECTED_KEY,
    // An end that closes nothing or the wrong kind of container, an end after
    // a key with no value, a second top-level value, or `finish` with nothing
    // written or something still open.
    UNBALANCED,
    // `float` or `float32` was given a NaN or an infinity, which JSON cannot
    // spell.
    NOT_FINITE,
    // Objects and arrays nested deeper than `MAX_DEPTH`, or than a reader's
    // lower limit.
    TOO_DEEP,
    // An allocation failed: the text, a scratch run or a tree could not grow.
    NO_MEMORY,
    // The input ends inside a value, or where one is due.
    TRUNCATED,
    // A byte that no value, separator or bracket starts where it stands:
    // `[1 2]`, `[1,]`, `{"a" 1}`, `'a'`, `tru`, a comment.
    UNEXPECTED,
    // A number not in RFC 8259's form: a leading zero (`01`), a `+`, a point
    // with no digit on either side (`1.`, `.5`), or an exponent with no
    // digits (`1e`).
    BAD_NUMBER,
    // A backslash in a string followed by anything but `"`, `\`, `/`, `b`,
    // `f`, `n`, `r`, `t`, or `u` and four hex digits.
    BAD_ESCAPE,
    // A `\u` escape of a UTF-16 surrogate that is not one half of a pair: a
    // high one with no `\u` low one after it, or a low one alone.
    LONE_SURROGATE,
    // A string holds a control character, U+0000 to U+001F, written as
    // itself rather than escaped.
    CONTROL_CHARACTER,
    // A string's bytes are not well-formed UTF-8: a stray continuation byte,
    // a sequence cut short, an over-long form, an encoded surrogate, or a
    // value past U+10FFFF.
    BAD_UTF8,
    // Something other than whitespace follows the one value.
    TRAILING,
    // The value is not of the type the read asked for. The reader does not
    // move.
    WRONG_TYPE,
    // The integer does not fit the type the read answers. The reader does
    // not move.
    OVERFLOW,
    // A read where the walk has nothing of that kind due: a value before
    // `more` answered true, a value where an object's key is due, a key
    // outside an object, or a second top-level value. The reader does not
    // move.
    OUT_OF_TURN,
    // `Value.get` names no member, or `Value.at` an index past the end.
    NOT_FOUND,

// How many objects and arrays may be open at once, in a writer and in a
// reader.
const i32 MAX_DEPTH = 128

// A sentence describing `why`; any value that is not a member answers "not a
// code of core:json".
//
//     string8 said = json.message(json.Error.TOO_DEEP)
//     // said is "objects and arrays nest deeper than MAX_DEPTH"
#assert_raises
string8 message(Error why):
    switch why:
        case Error.EXPECTED_KEY:
            return "a value inside an object needs a key first"
        case Error.UNEXPECTED_KEY:
            return "a key outside an object, or two keys in a row"
        case Error.UNBALANCED:
            return "the objects and arrays do not balance, or there is not exactly one top-level value"
        case Error.NOT_FINITE:
            return "JSON has no NaN or infinity"
        case Error.TOO_DEEP:
            return "objects and arrays nest deeper than MAX_DEPTH"
        case Error.NO_MEMORY:
            return "an allocation failed"
        case Error.TRUNCATED:
            return "the input ends inside a value, or where one is due"
        case Error.UNEXPECTED:
            return "a byte that cannot stand where it does"
        case Error.BAD_NUMBER:
            return "a number not in JSON's form"
        case Error.BAD_ESCAPE:
            return "a backslash escape JSON does not have"
        case Error.LONE_SURROGATE:
            return "a \\u escape of half a surrogate pair"
        case Error.CONTROL_CHARACTER:
            return "a control character in a string, not escaped"
        case Error.BAD_UTF8:
            return "a string holds bytes that are not UTF-8"
        case Error.TRAILING:
            return "more follows the value"
        case Error.WRONG_TYPE:
            return "the value is not of the type asked for"
        case Error.OVERFLOW:
            return "the integer does not fit"
        case Error.OUT_OF_TURN:
            return "no value or key of that kind is due here"
        case Error.NOT_FOUND:
            return "no such member or element"
        else:
            return "not a code of core:json"

// No failure yet: the zero code, which is no member. A writer's and a
// reader's `code` answer it until they fail.
private const Error NONE = Error(0)

// What an open container is, one per level of `Writer.open`.
private enum u8 Container:
    Object
    Array

// One JSON text being written: make one with `writer`, write exactly one
// top-level value, then take the text with `finish` or free it with
// `destroy`. Its slots are its state; read the failure with `code` and write
// no slot. A copy shares the text, so pass a writer by pointer.
type Writer:
    ref []char8 out
    Error failed
    i32 indent
    i32 depth
    [MAX_DEPTH]Container open
    bool empty
    bool keyed
    bool done

    // Opens an object: `{`. Inside it, write `key` before each value, then
    // `end_object`. Fails with `EXPECTED_KEY` where a key is due, `UNBALANCED`
    // after the top-level value, and `TOO_DEEP` past `MAX_DEPTH`.
    #assert_raises
    void object(^self):
        self.begin(Container.Object, '{')

    // Closes the innermost open object: `}`. Fails with `UNBALANCED` when it
    // is not an object or its last key has no value.
    #assert_raises
    void end_object(^self):
        self.end(Container.Object, '}')

    // Opens an array: `[`. Values written next are its elements, up to
    // `end_array`. Fails with `EXPECTED_KEY` where a key is due, `UNBALANCED`
    // after the top-level value, and `TOO_DEEP` past `MAX_DEPTH`.
    #assert_raises
    void array(^self):
        self.begin(Container.Array, '[')

    // Closes the innermost open array: `]`. Fails with `UNBALANCED` when it is
    // not an array.
    #assert_raises
    void end_array(^self):
        self.end(Container.Array, ']')

    // Writes `name` as the next member's name, a JSON string escaped the way
    // `text` escapes a value; its value is the next thing written. Fails with
    // `UNEXPECTED_KEY` outside an object or straight after another key.
    #assert_raises
    void key(^self, string8 name):
        if self.failed != NONE:
            return
        if self.depth == 0 || self.open[self.depth - 1] != Container.Object || self.keyed:
            self.fail_with(Error.UNEXPECTED_KEY)
            return
        self.separate()
        self.quoted(name)
        self.put(": " if self.indent > 0 else ":")
        self.keyed = true

    // Writes `s` as a JSON string. `"`, `\`, the control characters, DEL,
    // U+0080 to U+009F, U+2028 and U+2029 are escaped, other valid UTF-8 is
    // written as it is, and each byte that is not valid UTF-8 becomes U+FFFD.
    // Fails with `EXPECTED_KEY` in an object with no key
    // before it, and `UNBALANCED` after the top-level value.
    #assert_raises
    void text(^self, string8 s):
        if self.before_value():
            self.quoted(s)
            self.after_value()

    // Writes `v` in decimal: `-42`. Fails with `EXPECTED_KEY` in an object with
    // no key before it, and `UNBALANCED` after the top-level value.
    #assert_raises
    void int(^self, i64 v):
        if self.before_value():
            [20]char8 buf
            i32 n = fmt.render_signed(v, buf[:])
            self.put(string8(buf[0..<i64(n)]))
            self.after_value()

    // Writes `v` in decimal: `18446744073709551615`. Fails with `EXPECTED_KEY`
    // in an object with no key before it, and `UNBALANCED` after the top-level
    // value.
    #assert_raises
    void uint(^self, u64 v):
        if self.before_value():
            [20]char8 buf
            i32 n = fmt.render_unsigned(v, buf[:])
            self.put(string8(buf[0..<i64(n)]))
            self.after_value()

    // Writes the shortest decimal that reads back as `v`: `0.1`, `1.0`,
    // `1e+21`. Fails with `NOT_FINITE` for a NaN or an infinity,
    // `EXPECTED_KEY` in an object with no key before it, and `UNBALANCED`
    // after the top-level value.
    #assert_raises
    void float(^self, f64 v):
        put_float(self, v)

    // Writes the shortest decimal that reads back as `v` in single
    // precision: `f32(0.1)` is `0.1`. Fails with `NOT_FINITE` for a NaN or an
    // infinity, `EXPECTED_KEY` in an object with no key before it, and
    // `UNBALANCED` after the top-level value.
    #assert_raises
    void float32(^self, f32 v):
        put_float(self, v)

    // Writes `true` or `false`. Fails with `EXPECTED_KEY` in an object with no
    // key before it, and `UNBALANCED` after the top-level value.
    #assert_raises
    void boolean(^self, bool v):
        if self.before_value():
            self.put("true" if v else "false")
            self.after_value()

    // Writes `null`. Fails with `EXPECTED_KEY` in an object with no key
    // before it, and `UNBALANCED` after the top-level value.
    #assert_raises
    void null(^self):
        if self.before_value():
            self.put("null")
            self.after_value()

    // Writes `v` and everything inside it, as `parse` read it: each kind by
    // the call above that writes it, an `Int` with `int`, a `Uint` with
    // `uint`, and a `Float` or a `Big` with `float`, so a `Big` comes out as
    // its nearest `f64` and one past the largest fails with `NOT_FINITE`.
    // Fails as those calls do. Nesting costs a call each level, and the
    // reader's depth limit, like the writer's, is `MAX_DEPTH`.
    #assert_raises
    void value(^self, Value v):
        switch v.doc^.nodes[v.node].held:
            case Null _:
                self.null()
            case bool b:
                self.boolean(b)
            case i64 i:
                self.int(i)
            case u64 u:
                self.uint(u)
            case Big g:
                self.float(f64(g))
            case f64 f:
                self.float(f)
            case Text _:
                try string8 s = v.text() else:
                    return
                self.text(s)
            case Elements _:
                self.array()
                for i in 0..<v.len():
                    try Value e = v.at(i) else:
                        return
                    self.value(e)
                self.end_array()
            case Members _:
                self.object()
                for i in 0..<v.len():
                    try string8 name = v.key(i) else:
                        return
                    try Value e = v.at(i) else:
                        return
                    self.key(name)
                    self.value(e)
                self.end_object()

    // The code the writer failed with, or `Error(0)`, which is no member,
    // while it has not failed.
    #assert_raises
    Error code(self):
        return self.failed

    // Hands over the text, which the caller then owns and `#delete`s. Fails
    // with the code the writer failed with, or with `UNBALANCED` unless
    // exactly one whole value was written; on failure the text is freed.
    #assert_raises
    Error!ref([]char8) finish(^self):
        if self.failed == NONE && !self.done:
            self.failed = Error.UNBALANCED
        if self.failed != NONE:
            #delete(self.out)
            fail self.failed
        defer self.out = nil
        return self.out

    // Frees the text without finishing. Does nothing after `finish`.
    #assert_raises
    void destroy(^self):
        #delete(self.out)

    private void fail_with(^self, Error code):
        if self.failed == NONE:
            self.failed = code

    private void put(^self, string8 s):
        if self.failed != NONE:
            return
        if !#reserve(self.out, #len(self.out) + #len(s)):
            self.fail_with(Error.NO_MEMORY)
            return
        for c in s:
            _ = #append(self.out, c)

    private void put_char(^self, char8 c):
        if self.failed != NONE:
            return
        if !#append(self.out, c):
            self.fail_with(Error.NO_MEMORY)

    // Between members or elements: the comma, then the line and indent.
    private void separate(^self):
        if !self.empty:
            self.put_char(',')
        self.empty = false
        self.newline(self.depth)

    private void newline(^self, i32 depth):
        if self.indent <= 0:
            return
        self.put_char('\n')
        for _i in 0..<(depth * self.indent):
            self.put_char(' ')

    // Whether a value may go here, writing what comes before it.
    private bool before_value(^self):
        if self.failed != NONE:
            return false
        if self.depth == 0:
            if self.done:
                self.fail_with(Error.UNBALANCED)
                return false
            return true
        if self.open[self.depth - 1] == Container.Object:
            if !self.keyed:
                self.fail_with(Error.EXPECTED_KEY)
                return false
            self.keyed = false
            return true
        self.separate()
        return self.failed == NONE

    private void after_value(^self):
        if self.depth == 0:
            self.done = true

    private void begin(^self, Container kind, char8 brace):
        if !self.before_value():
            return
        if self.depth == MAX_DEPTH:
            self.fail_with(Error.TOO_DEEP)
            return
        self.put_char(brace)
        self.open[self.depth] = kind
        self.depth += 1
        self.empty = true

    private void end(^self, Container kind, char8 brace):
        if self.failed != NONE:
            return
        if self.depth == 0 || self.open[self.depth - 1] != kind || self.keyed:
            self.fail_with(Error.UNBALANCED)
            return
        self.depth -= 1
        if !self.empty:
            self.newline(self.depth)
        self.put_char(brace)
        self.empty = false
        self.after_value()

    // `s` between quotes. Bytes that need no escape are written a run at a
    // time, so plain text costs one `put` per run rather than one per
    // character.
    private void quoted(^self, string8 s):
        self.put_char('"')
        i64 n = #len(s)
        i64 run = 0
        i64 i = 0
        for i < n:
            u32 b = u32(s[i])
            if b >= 0x20 && b < 0x7F && b != u32('"') && b != u32('\\'):
                i += 1
                continue
            i64 size = 1
            u32 cp = b
            if b >= 0x80:
                (char32 c, i64 k) = chars.decode(s[i..<(i + 4 if i + 4 < n else n)], 0)
                cp = u32(c)
                size = k
                bool plain = cp >= 0xA0 && cp != 0x2028 && cp != 0x2029 && !(cp == REPLACEMENT && size == 1)
                if plain:
                    i += size
                    continue
            self.put(s[run..<i])
            self.escape(cp)
            i += size
            run = i
        self.put(s[run..<n])
        self.put_char('"')

    // The escape for one code point `quoted` does not pass through.
    private void escape(^self, u32 cp):
        if cp == u32('"'):
            self.put("\\\"")
        else if cp == u32('\\'):
            self.put("\\\\")
        else if cp == u32('\n'):
            self.put("\\n")
        else if cp == u32('\r'):
            self.put("\\r")
        else if cp == u32('\t'):
            self.put("\\t")
        else if cp == 0x08:
            self.put("\\b")
        else if cp == 0x0C:
            self.put("\\f")
        else if cp == REPLACEMENT:
            self.put("\xEF\xBF\xBD")
        else:
            self.put("\\u")
            for k in 0..<4:
                self.put_char(HEX[i64((cp >> u32(12 - 4 * k)) & 15)])

// `v` as `float` and `float32` write it: NaN and the infinities fail with
// `NOT_FINITE`, and anything else is the shortest text that reads back as `v`
// at its own precision.
private void put_float(^Writer w, $T v) where T is float:
    if math.is_nan(f64(v)) || math.is_infinite(f64(v)):
        w.fail_with(Error.NOT_FINITE)
        return
    if w.before_value():
        [24]char8 buf
        i32 n = fmt.render_float_shortest(v, buf[:])
        w.put(string8(buf[0..<i64(n)]))
        w.after_value()

// An empty writer. With `indent` 0 or less the text is compact; above 0, each
// member and element goes on its own line, indented `indent` spaces a level.
// The text is allocated on `#default`, with `room` bytes reserved up front; a
// failed allocation shows as `NO_MEMORY` from `finish`.
//
//     json.Writer w = json.writer() using arena    // the text lives in `arena`
#assert_raises
Writer writer(i32 indent = 0, i64 room = 64):
    Writer w
    w.indent = indent
    w.out = #make([]char8, 0)
    if w.out == nil || !#reserve(w.out, room):
        w.failed = Error.NO_MEMORY
    return w

private const u32 REPLACEMENT = 0xFFFD
private const string8 HEX = "0123456789abcdef"
