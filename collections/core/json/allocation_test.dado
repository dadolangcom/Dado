@test
// Running out of memory: a tree that outgrows its allocator fails with
// `NO_MEMORY` at every size short of what it needs and keeps nothing, and a
// string read whose scratch cannot grow fails without moving the reader.
package json

import "core:mem/bump"

private const string8 TEXT = "{\"name\": \"o\\u0061k\", \"sizes\": [600, 18.5, [true, null]], \"tags\": {\"a\": \"\\n\"}}"

i32 test():
    bool ok = true
    // Every arena smaller than the tree needs fails cleanly; one big enough
    // succeeds, and the smallest that does is found on the way.
    [8192]u8 room
    i64 fitted = -1
    for cap in 0..<8192:
        bump.Arena arena = bump.over(room[0..<cap])
        i32 code = 0
        Document doc
        try doc = parse_text(TEXT) using bump.allocator(&arena) else c:
            code = c
        if code == 0:
            fitted = cap
            try Value v = doc.root().get("sizes") else:
                ok = #expect(false, "sizes in a fitted tree") && ok
                break
            ok = #expect(v.len() == 3, "a fitted tree is whole") && ok
            break
        if code != NO_MEMORY:
            ok = #expect(false, "an arena of ", cap, " failed with ", message(code)) && ok
            break
    ok = #expect(fitted > 0, "no arena under 8192 bytes held the tree") && ok

    // A scratch run that cannot grow: NO_MEMORY, and the read can be retried.
    [4]u8 none
    bump.Arena empty = bump.over(none[0..<0])
    Reader r = reader_text("[\"a\\tb\"]")
    try r.array() else:
        return 1
    _ = r.more()
    ref []char8 scratch
    i32 code = 0
    try _ = r.text(&scratch) using bump.allocator(&empty) else c:
        code = c
    ok = #expect(code == NO_MEMORY, "a scratch with no room failed with ", code) && ok
    ok = #expect(r.code() == 0, "running out of scratch does not fail the reader") && ok
    // The run, if one was made, grows on the allocator that made it: start
    // again with none.
    #delete(scratch)
    try string8 s = r.text(&scratch) else c:
        return 0 if #expect(false, "the retry failed: ", message(c)) else 1
    ok = #expect(s == "a\tb", "the retry reads ", s) && ok
    #delete(scratch)
    try r.finish() else c:
        ok = #expect(false, "finish: ", message(c)) && ok
    return 0 if ok else 1
