@test
// Running out of memory: a tree whose runs cannot be made fails with
// `Error.NO_MEMORY` and keeps nothing, and a string read whose scratch cannot be
// made fails without moving the reader. (A run that was made and then cannot
// grow stops the program, as any growth does.)
package json

// An allocator that refuses everything.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

private const string8 TEXT = "{\"name\": \"o\\u0061k\", \"sizes\": [600, 18.5, [true, null]], \"tags\": {\"a\": \"\\n\"}}"

i32 test():
    bool ok = true
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) nothing = (refuses, nil)
    Error refused = NONE
    try _ = parse_text(TEXT) using nothing else c:
        refused = c
    ok = #expect(refused == Error.NO_MEMORY, "a tree with no memory failed with ", refused) && ok
    // With memory, the same text is a whole tree.
    try Document doc = parse_text(TEXT) else c:
        return 0 if #expect(false, "the tree failed: ", message(c)) else 1
    try Value v = doc.root().get("sizes") else:
        return 0 if #expect(false, "sizes in the tree") else 1
    ok = #expect(v.len() == 3, "the tree is whole") && ok
    doc.destroy()

    // A scratch run that cannot be made: Error.NO_MEMORY, and the read can be retried.
    Reader r = reader_text("[\"a\\tb\"]")
    try r.array() else:
        return 1
    _ = r.more()
    ref []char8 scratch
    Error code = NONE
    try _ = r.text(&scratch) using nothing else c:
        code = c
    ok = #expect(code == Error.NO_MEMORY, "a scratch with no room failed with ", code) && ok
    ok = #expect(r.code() == NONE, "running out of scratch does not fail the reader") && ok
    // The run, if one was made, grows on the allocator that made it: start
    // again with none.
    #delete(scratch)
    try string8 s = r.text(&scratch) else c:
        return 0 if #expect(false, "the retry failed: ", message(c)) else 1
    ok = #expect(s == "a\tb", "the retry reads ", s) && ok
    #delete(scratch)
    try r.finish() else c:
        ok = #expect(false, "finish: ", message(c)) && ok
    return 0 if ok else 1
