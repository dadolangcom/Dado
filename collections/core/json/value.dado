// The tree: a whole value read into memory, to look things up in.
package json

// How a number is held, in a tree or as a `Reader` read it. `Int` is an
// integer from -2^63 to 2^63 - 1; `Uint` an integer from 2^63 to 2^64 - 1;
// `Big` an integer past both, held only as the nearest `f64`; `Float` a
// number written with a fraction or an exponent. `Value.form` answers it.
enum i32 Form: (Float, Int, Uint, Big)

// `null`, as a tree holds it.
private distinct type Null: u8
// An integer past `u64`'s range, held as its nearest `f64`.
private distinct type Big: f64
// A string's text in a document's `chars`.
private distinct type Text: (i64 at, i64 len)
// An array's elements in a document's `kids`, by node index.
private distinct type Elements: (i64 at, i64 len)
// An object's members' values in a document's `kids`, by node index; each
// one's node holds its key.
private distinct type Members: (i64 at, i64 len)

// What one value in a tree is, and its value: each kind of JSON value is a
// member, and a number one of four by its `Form` (`i64` an `Int`, `u64` a
// `Uint`, `Big`, and `f64` a `Float`).
private union Held: (Null, bool, i64, u64, Big, f64, Text, Elements, Members)

// One value in a `Document`: what it holds, and its key in `chars` when it
// is an object's member. A tree is read through `Value`.
private type Node:
    Held held
    i64 key_at
    i64 key_len

// A JSON value and everything inside it, as `parse` and `Reader.document`
// make it, held in three runs: one `Node` per value in the order written,
// every container's children as node indices, and every string's and key's
// text, escapes decoded. Its slots are its state; read it through `root`, and
// write no slot:
//
//     try json.Document doc = json.parse_text(text) else code:
//         fmt.println(json.message(code))
//         return
//     defer doc.destroy()
//     json.Value top = doc.root()
//     try json.Value sizes = top.get("sizes")
//     for i in 0..<sizes.len():
//         try json.Value size = sizes.at(i)
//         try f64 v = size.float()
//
// The runs are on the allocator that was `#default` when it was made;
// `destroy` frees them, or they go with their arena. A copy shares the runs,
// so destroy one copy once.
type Document:
    ref []Node nodes
    ref []i64 kids
    ref []char8 chars

    // The top-level value. Valid while the document is not moved or
    // destroyed.
    #assert_raises
    Value root(^self):
        return (self, 0)

    // Frees the runs, and leaves an empty document.
    #assert_raises
    void destroy(^self):
        #delete(self.nodes)
        #delete(self.kids)
        #delete(self.chars)

// One value in a `Document`: the document and the node's index. A plain
// handle, copied freely; it is valid while its document is not moved or
// destroyed. Every lookup costs time independent of the tree's size, except
// `get`, which is linear in the object's member count.
type Value:
    ^Document doc
    i64 node

    // What the value is.
    #assert_raises
    Kind kind(self):
        switch self.held():
            case Null _: return Kind.Null
            case bool _: return Kind.Bool
            case i64 _: return Kind.Number
            case u64 _: return Kind.Number
            case Big _: return Kind.Number
            case f64 _: return Kind.Number
            case Text _: return Kind.String
            case Elements _: return Kind.Array
            case Members _: return Kind.Object

    // How a `Number` is held (see `Form`); `Float` for any other kind.
    #assert_raises
    Form form(self):
        switch self.held():
            case i64 _: return Form.Int
            case u64 _: return Form.Uint
            case Big _: return Form.Big
            else: return Form.Float

    // Whether it is `null`.
    #assert_raises
    bool is_null(self):
        return self.kind() == Kind.Null

    // A `Bool`'s value. Fails with `WRONG_TYPE` for any other kind.
    #assert_raises
    Error!bool boolean(self):
        switch self.held():
            case bool b: return b
            else: fail Error.WRONG_TYPE

    // A `Number` that is an integer from -2^63 to 2^63 - 1. Fails with
    // `OVERFLOW` for an integer outside that range, and `WRONG_TYPE` for a
    // number with a fraction or an exponent or any other kind.
    #assert_raises
    Error!i64 int(self):
        switch self.held():
            case i64 i: return i
            case u64 _: fail Error.OVERFLOW
            case Big _: fail Error.OVERFLOW
            else: fail Error.WRONG_TYPE

    // A `Number` that is an integer from 0 to 2^64 - 1. Fails with
    // `OVERFLOW` for an integer outside that range, and `WRONG_TYPE` for a
    // number with a fraction or an exponent or any other kind.
    #assert_raises
    Error!u64 uint(self):
        switch self.held():
            case u64 u: return u
            case i64 i:
                if i < 0:
                    fail Error.OVERFLOW
                return u64(i)
            case Big _: fail Error.OVERFLOW
            else: fail Error.WRONG_TYPE

    // A `Number` as the nearest `f64`; past the largest finite one, an
    // infinity of its sign. Fails with `WRONG_TYPE` for any other kind.
    #assert_raises
    Error!f64 float(self):
        switch self.held():
            case i64 i: return f64(i)
            case u64 u: return f64(u)
            case Big g: return f64(g)
            case f64 f: return f
            else: fail Error.WRONG_TYPE

    // A `String`'s text, escapes decoded, as a view into the document. Fails
    // with `WRONG_TYPE` for any other kind.
    #assert_raises
    Error!string8 text(self):
        switch self.held():
            case Text t:
                string8 all = self.doc^.chars
                return all[t.at..<(t.at + t.len)]
            else: fail Error.WRONG_TYPE

    // How many elements an `Array` has or members an `Object` has; 0 for
    // any other kind.
    #assert_raises
    i64 len(self):
        (i64 _, i64 n, bool _) = self.children()
        return n

    // An `Array`'s element `i`, or the value of an `Object`'s member `i`,
    // counting from 0 in the order written. Fails with `NOT_FOUND` for an
    // index outside `0..<len()`, and `WRONG_TYPE` for any other kind.
    #assert_raises
    Error!Value at(self, i64 i):
        (i64 at, i64 n, bool container) = self.children()
        if !container:
            fail Error.WRONG_TYPE
        if i < 0 || i >= n:
            fail Error.NOT_FOUND
        return (self.doc, self.doc^.kids[at + i])

    // The key of an `Object`'s member `i`, as a view into the document.
    // Fails with `NOT_FOUND` for an index outside `0..<len()`, and
    // `WRONG_TYPE` for any other kind.
    #assert_raises
    Error!string8 key(self, i64 i):
        if self.kind() != Kind.Object:
            fail Error.WRONG_TYPE
        (i64 at, i64 n, bool _) = self.children()
        if i < 0 || i >= n:
            fail Error.NOT_FOUND
        Node m = self.doc^.nodes[self.doc^.kids[at + i]]
        string8 all = self.doc^.chars
        return all[m.key_at..<(m.key_at + m.key_len)]

    // The value of an `Object`'s member named `name`, the last one when the
    // name repeats. Linear in the member count. Fails with `NOT_FOUND` when
    // no member has that name, and `WRONG_TYPE` for any other kind.
    #assert_raises
    Error!Value get(self, string8 name):
        if self.kind() != Kind.Object:
            fail Error.WRONG_TYPE
        (i64 at, i64 n, bool _) = self.children()
        string8 all = self.doc^.chars
        i64 k = n
        for k > 0:
            k -= 1
            i64 child = self.doc^.kids[at + k]
            Node m = self.doc^.nodes[child]
            if all[m.key_at..<(m.key_at + m.key_len)] == name:
                return (self.doc, child)
        fail Error.NOT_FOUND

    // Whether an `Object` has a member named `name`; false for any other
    // kind.
    #assert_raises
    bool has(self, string8 name):
        try _ = self.get(name) else:
            return false
        return true

    // What the node holds.
    private Held held(self):
        return self.doc^.nodes[self.node].held

    // An `Array`'s or `Object`'s children in `kids`: where they start, how
    // many, and whether it is either; `(0, 0, false)` for any other kind.
    private (i64 at, i64 len, bool container) children(self):
        switch self.held():
            case Elements e: return (e.at, e.len, true)
            case Members m: return (m.at, m.len, true)
            else: return (0, 0, false)

// The one JSON value `data` holds, as a tree on `#default` that the caller
// `destroy`s. Fails as `Reader.document` and `Reader.finish` do; on failure
// nothing is kept. `Reader.offset` says where malformed input went wrong.
#assert_raises
Error!Document parse([]u8 data):
    Reader r = reader(data)
    try Document d = r.document()
    try r.finish() else code:
        d.destroy()
        fail code
    return d

// `parse` over text, nothing copied.
#assert_raises
Error!Document parse_text(string8 text):
    try Document d = parse(Bytes(text))
    return d
