// The reader: a cursor over JSON text, pulled one value at a time.
package json

import "core:chars"
import "core:strings/parse"

// A failure code: the input ends inside a value, or where one is due.
public const i32 TRUNCATED = 7

// A failure code: a byte that no value, separator or bracket starts where it
// stands: `[1 2]`, `[1,]`, `{"a" 1}`, `'a'`, `tru`, a comment.
public const i32 UNEXPECTED = 8

// A failure code: a number not in RFC 8259's form: a leading zero (`01`), a
// `+`, a point with no digit on either side (`1.`, `.5`), or an exponent
// with no digits (`1e`).
public const i32 BAD_NUMBER = 9

// A failure code: a backslash in a string followed by anything but `"`, `\`,
// `/`, `b`, `f`, `n`, `r`, `t`, or `u` and four hex digits.
public const i32 BAD_ESCAPE = 10

// A failure code: a `\u` escape of a UTF-16 surrogate that is not one half
// of a pair: a high one with no `\u` low one after it, or a low one alone.
public const i32 LONE_SURROGATE = 11

// A failure code: a string holds a control character, U+0000 to U+001F,
// written as itself rather than escaped.
public const i32 CONTROL_CHARACTER = 12

// A failure code: a string's bytes are not well-formed UTF-8: a stray
// continuation byte, a sequence cut short, an over-long form, an encoded
// surrogate, or a value past U+10FFFF.
public const i32 BAD_UTF8 = 13

// A failure code: something other than whitespace follows the one value.
public const i32 TRAILING = 14

// A failure code: the value is not of the type the read asked for. The
// reader does not move.
public const i32 WRONG_TYPE = 15

// A failure code: the integer does not fit the type the read answers. The
// reader does not move.
public const i32 OVERFLOW = 16

// A failure code: a read where the walk has nothing of that kind due: a value
// before `more` answered true, a value where an object's key is due, a key
// outside an object, or a second top-level value. The reader does not move.
public const i32 OUT_OF_TURN = 17

// A failure code: `Value.get` names no member, or `Value.at` an index past
// the end.
public const i32 NOT_FOUND = 18

// What a value is, as `Reader.kind` and `Value.kind` answer it.
public enum u8 Kind: (Null, Bool, Number, String, Array, Object)

// A cursor over one JSON text. Make one with `reader` or `reader_text`, read
// the top-level value, then call `finish`:
//
//     json.Reader r = json.reader_text(text)
//     ref []char8 scratch
//     defer #delete(scratch)
//     try r.object()
//     for r.more():
//         try string8 name = r.key(&scratch)
//         if name == "size":
//             try i64 size = r.int()
//     try r.finish()
//
// `object` and `array` open a container and `more` walks it: each time it
// answers true one member (a key, then its value) or one element is due,
// and a turn that reads nothing has it skipped. `more` answers false at the
// closing bracket, which it reads.
//
// A read of the wrong type fails with `WRONG_TYPE`, `OVERFLOW` or
// `OUT_OF_TURN` and leaves the reader where it was, so another read may be
// tried. Malformed input fails the reader for good: that read, every read
// after it and `finish` fail with the same code, `code` answers it and
// `offset` the byte it was found at. `more` cannot fail, so on malformed
// input it answers false and leaves the code for the next read or `finish`.
//
// It reads RFC 8259 strictly: no comments, no trailing commas, no leading
// zeros, no `NaN` or `Infinity`, no single quotes, no byte-order mark, only
// space, tab, line feed and carriage return between tokens, and strings of
// well-formed UTF-8 with paired surrogate escapes. Nothing is allocated
// except in the scratch run a string or number read is given, by
// `text_copy` and `document`, and by `float` for a number of more than 64
// bytes read from `[]u8`, which it copies to a run it frees. Its slots are
// its state; read them, and write none.
public type Reader:
    []u8 bytes
    string8 source
    bool from_text
    i64 at
    i32 limit
    i32 depth
    [2]u64 objects
    bool first
    bool due
    bool keyed
    bool ended
    i32 failed
    i64 failed_at

    // What the next value is, without reading it. Fails with `OUT_OF_TURN`
    // when no value is due, `TRUNCATED` at the end of the input, and
    // `UNEXPECTED` when the next byte starts no value.
    !Kind kind(^self):
        try self.value_due()
        try Kind k = self.kind_at(self.at)
        return k

    // Opens the next value, an object; `more` then answers true once per
    // member, and the turn reads its key and then its value. Fails with
    // `WRONG_TYPE` for any other value, `TOO_DEEP` past the reader's depth
    // limit, or the code of malformed input.
    !void object(^self):
        try self.open(Kind.Object)

    // Opens the next value, an array; `more` then answers true once per
    // element. Fails with `WRONG_TYPE` for any other value, `TOO_DEEP` past
    // the reader's depth limit, or the code of malformed input.
    !void array(^self):
        try self.open(Kind.Array)

    // Whether the innermost open object or array has another member or
    // element, reading the comma before it; false at its closing bracket,
    // which it reads. Whatever the last turn left unread of its member or
    // element is skipped first. Answers false outside any container, and on
    // malformed input, which then fails the reader.
    bool more(^self):
        if self.failed != 0 || self.depth == 0:
            return false
        if self.due || self.keyed:
            if self.due && self.in_object():
                try self.key_end() else:
                    return false
            try self.skip() else:
                return false
        i64 n = self.size()
        i64 p = self.space(self.at)
        if p >= n:
            _ = self.stop(TRUNCATED, p)
            return false
        u8 close = u8('}') if self.in_object() else u8(']')
        u8 b = self.byte(p)
        if b == close:
            self.close(p + 1)
            return false
        if !self.first:
            if b != u8(','):
                _ = self.stop(UNEXPECTED, p)
                return false
            p = self.space(p + 1)
            if p >= n:
                _ = self.stop(TRUNCATED, p)
                return false
            if self.byte(p) == close:
                _ = self.stop(UNEXPECTED, p)
                return false
        self.first = false
        self.due = true
        self.at = p
        return true

    // The next member's key, after which its value is due. The key is a view
    // into the input when the reader reads a `string8` and the key has no
    // escape; otherwise it is decoded into `scratch^`, which the caller
    // deletes, and the view is into that, good until `scratch^` is next
    // written. A nil `scratch^` is made on `#default`; a run grows on the
    // allocator that made it. Fails with
    // `OUT_OF_TURN` unless a key is due, `NO_MEMORY` when `scratch^` cannot
    // grow, or the code of malformed input.
    !string8 key(^self, ^ref []char8 scratch):
        try i64 start = self.key_start()
        try Span s = self.span(start)
        try i64 end = self.colon(s.end)
        if s.plain && self.from_text:
            self.keyed = true
            self.due = false
            self.at = end
            return self.source[(start + 1)..<(s.end - 1)]
        try self.decode(start, s.end, scratch)
        self.keyed = true
        self.due = false
        self.at = end
        string8 got = scratch^
        return got

    // The next value, a string, its escapes decoded. It is a view as `key`'s
    // answer is: into the input, or into `scratch^`. Fails with `WRONG_TYPE`
    // for any other value, `NO_MEMORY` when `scratch^` cannot grow, or the
    // code of malformed input.
    !string8 text(^self, ^ref []char8 scratch):
        try self.typed(Kind.String)
        try Span s = self.span(self.at)
        if s.plain && self.from_text:
            string8 part = self.source[(self.at + 1)..<(s.end - 1)]
            self.took(s.end)
            return part
        try self.decode(self.at, s.end, scratch)
        self.took(s.end)
        string8 got = scratch^
        return got

    // The next value, a string, its escapes decoded into a new run on
    // `#default`, which the caller deletes. Linear in the string's length.
    // Fails with `WRONG_TYPE` for any other value, `NO_MEMORY` when the run
    // cannot be made, or the code of malformed input.
    !ref([]char8) text_copy(^self):
        try self.typed(Kind.String)
        try Span s = self.span(self.at)
        ref []char8 out
        try self.decode(self.at, s.end, &out)
        self.took(s.end)
        return out

    // The next value, a number written as an integer, `-9223372036854775808`
    // to `9223372036854775807`. Fails with `WRONG_TYPE` for any other value
    // or a number with a fraction or an exponent, `OVERFLOW` for an integer
    // outside that range, or the code of malformed input.
    !i64 int(^self):
        try Number n = self.number_here(true)
        if n.form == Form.Float:
            fail WRONG_TYPE
        if n.form != Form.Int:
            fail OVERFLOW
        self.took(n.end)
        return n.i

    // The next value, a number written as an integer from 0 to
    // `18446744073709551615`; `-0` reads as 0. Fails with `WRONG_TYPE` for any
    // other value or a number with a fraction or an exponent, `OVERFLOW` for
    // an integer outside that range, or the code of malformed input.
    !u64 uint(^self):
        try Number n = self.number_here(true)
        if n.form == Form.Float:
            fail WRONG_TYPE
        if n.form == Form.Uint:
            self.took(n.end)
            return n.u
        if n.form != Form.Int || n.i < 0:
            fail OVERFLOW
        self.took(n.end)
        return u64(n.i)

    // The next value, any number, as the nearest `f64`, ties to even. A
    // magnitude past the largest finite `f64` reads as an infinity of its
    // sign, and one below the smallest subnormal as a zero; `number_text`
    // gives the digits exactly. Fails with `WRONG_TYPE` for any other value,
    // `NO_MEMORY` when a number of more than 64 bytes read from `[]u8` cannot
    // be copied, or the code of malformed input.
    !f64 float(^self):
        try Number n = self.number_here(false)
        self.took(n.end)
        return n.f

    // The next value, a number, as the text it is written in: a view into
    // the input when the reader reads a `string8`, and otherwise a copy in
    // `scratch^`, as `key` uses it. For a number no `int`, `uint` or `float` holds exactly. Fails
    // with `WRONG_TYPE` for any other value, `NO_MEMORY` when `scratch^`
    // cannot grow, or the code of malformed input.
    !string8 number_text(^self, ^ref []char8 scratch):
        try self.typed(Kind.Number)
        try i64 end = self.number_end(self.at)
        if self.from_text:
            string8 part = self.source[self.at..<end]
            self.took(end)
            return part
        try self.copy_bytes(self.at, end, scratch)
        self.took(end)
        string8 got = scratch^
        return got

    // The next value, `true` or `false`. Fails with `WRONG_TYPE` for any
    // other value, or the code of malformed input.
    !bool boolean(^self):
        try self.typed(Kind.Bool)
        bool v = self.byte(self.at) == u8('t')
        try i64 end = self.literal("true" if v else "false")
        self.took(end)
        return v

    // Reads the next value, `null`. Fails with `WRONG_TYPE` for any other
    // value, or the code of malformed input.
    !void null(^self):
        try self.typed(Kind.Null)
        try i64 end = self.literal("null")
        self.took(end)

    // Steps over the next value, whatever it holds, checking all of it. Fails
    // with `OUT_OF_TURN` when no value is due, `TOO_DEEP` past the reader's
    // depth limit, or the code of malformed input. Linear in the value's
    // length, and nesting costs no stack.
    !void skip(^self):
        try Kind k = self.kind()
        if k != Kind.Object && k != Kind.Array:
            try self.scalar(k)
            return
        i32 base = self.depth
        try self.open(k)
        for self.depth > base:
            if self.more():
                if self.in_object():
                    try self.key_end()
                try Kind inner = self.kind()
                if inner == Kind.Object || inner == Kind.Array:
                    try self.open(inner)
                else:
                    try self.scalar(inner)
            else if self.failed != 0:
                fail self.failed

    // The next value as a tree (see `Document`), made on `#default`; the
    // caller `destroy`s it. Fails with `OUT_OF_TURN` when no value is due,
    // `TOO_DEEP` past the reader's depth limit, the code of malformed input,
    // or `NO_MEMORY`, which then fails the reader too; on any failure nothing
    // is kept. Linear in the value's length, and nesting costs no stack.
    !Document document(^self):
        Document d
        d.nodes = #make([]Node, 0)
        d.kids = #make([]i64, 0)
        d.chars = #make([]char8, 0)
        ref []i64 pending = #make([]i64, 0)
        defer #delete(pending)
        try self.build(&d, &pending) else code:
            d.destroy()
            fail code
        return d

    // Succeeds when the input is one whole value and whitespace. Reads
    // through whatever is still unread first, checking it, so a walk may stop
    // early and still learn whether the text was well formed. Fails with the
    // reader's code once it has failed, `TRAILING` when more follows the
    // value, `TOO_DEEP`, or the code of malformed input.
    !void finish(^self):
        if self.failed != 0:
            fail self.failed
        for self.depth > 0 || !self.ended:
            if self.depth == 0:
                try self.skip()
            else if !self.more() && self.failed != 0:
                fail self.failed
        i64 p = self.space(self.at)
        if p < self.size():
            fail self.stop(TRAILING, p)
        self.at = p

    // Whether the top-level value has been read to its end.
    bool done(self):
        return self.ended

    // The code the reader failed with, or 0 while it has not failed.
    i32 code(self):
        return self.failed

    // The byte offset in the input where the reader failed: of the byte that
    // was out of place, or the input's length when it ended too soon. -1
    // while it has not failed.
    i64 offset(self):
        return self.failed_at if self.failed != 0 else -1

    // ── inside ──

    private i64 size(self):
        return #len(self.source) if self.from_text else #len(self.bytes)

    // The input's byte at `i`, which is below `size()`.
    private u8 byte(self, i64 i):
        if self.from_text:
            return u8(self.source[i])
        return self.bytes[i]

    private bool in_object(self):
        i32 d = self.depth - 1
        return (self.objects[d >> 6] >> u64(d & 63)) & 1 != 0

    // Fails the reader for good with `code` found at `offset`, unless it has
    // failed already, and answers the code it failed with.
    private i32 stop(^self, i32 code, i64 offset):
        if self.failed == 0:
            self.failed = code
            self.failed_at = offset
        return self.failed

    // Where the whitespace from `p` ends.
    private i64 space(self, i64 from):
        i64 n = self.size()
        i64 p = from
        for p < n:
            u8 b = self.byte(p)
            if b != 0x20 && b != 0x0A && b != 0x0D && b != 0x09:
                return p
            p += 1
        return p

    // Succeeds when a value may be read now, moving `at` over the whitespace
    // before it.
    private !void value_due(^self):
        if self.failed != 0:
            fail self.failed
        if self.depth == 0:
            if self.ended:
                fail OUT_OF_TURN
        else if self.in_object():
            if !self.keyed:
                fail OUT_OF_TURN
        else if !self.due:
            fail OUT_OF_TURN
        self.at = self.space(self.at)
        if self.at >= self.size():
            fail self.stop(TRUNCATED, self.at)

    // A value is due and its first byte says it is of kind `want`.
    private !void typed(^self, Kind want):
        try Kind k = self.kind()
        if k != want:
            fail WRONG_TYPE

    // What the value starting at `p` is, by its first byte.
    private !Kind kind_at(^self, i64 p):
        u8 b = self.byte(p)
        if b == u8('{'):
            return Kind.Object
        if b == u8('['):
            return Kind.Array
        if b == u8('"'):
            return Kind.String
        if b == u8('-') || (b >= u8('0') && b <= u8('9')):
            return Kind.Number
        if b == u8('t') || b == u8('f'):
            return Kind.Bool
        if b == u8('n'):
            return Kind.Null
        fail self.stop(UNEXPECTED, p)

    // The value just read ended at `end`: the turn is spent.
    private void took(^self, i64 end):
        self.at = end
        self.due = false
        self.keyed = false
        if self.depth == 0:
            self.ended = true

    // Opens the object or array due next.
    private !void open(^self, Kind want):
        try self.typed(want)
        if self.depth >= self.limit:
            fail self.stop(TOO_DEEP, self.at)
        i32 d = self.depth
        u64 bit = u64(1) << u64(d & 63)
        if want == Kind.Object:
            self.objects[d >> 6] = self.objects[d >> 6] | bit
        else:
            self.objects[d >> 6] = self.objects[d >> 6] & ~bit
        self.at += 1
        self.due = false
        self.keyed = false
        self.depth += 1
        self.first = true

    // Reads the closing bracket that ends at `end`.
    private void close(^self, i64 end):
        self.depth -= 1
        self.at = end
        self.first = false
        self.due = false
        self.keyed = false
        if self.depth == 0:
            self.ended = true

    // Where the key due next starts: its opening quote.
    private !i64 key_start(^self):
        if self.failed != 0:
            fail self.failed
        if self.depth == 0 || !self.in_object() || !self.due:
            fail OUT_OF_TURN
        i64 p = self.space(self.at)
        if p >= self.size():
            fail self.stop(TRUNCATED, p)
        if self.byte(p) != u8('"'):
            fail self.stop(UNEXPECTED, p)
        return p

    // Where the colon after a key ending at `p` ends, and its whitespace.
    private !i64 colon(^self, i64 p):
        i64 q = self.space(p)
        if q >= self.size():
            fail self.stop(TRUNCATED, q)
        if self.byte(q) != u8(':'):
            fail self.stop(UNEXPECTED, q)
        return q + 1

    // Steps over the key due next and its colon.
    private !void key_end(^self):
        try i64 start = self.key_start()
        try Span s = self.span(start)
        try i64 end = self.colon(s.end)
        self.keyed = true
        self.due = false
        self.at = end

    // The key due next, decoded into a new run on `#default`.
    private !ref([]char8) key_copy(^self):
        try i64 start = self.key_start()
        try Span s = self.span(start)
        try i64 end = self.colon(s.end)
        ref []char8 out
        try self.decode(start, s.end, &out)
        self.keyed = true
        self.due = false
        self.at = end
        return out

    // Steps over the scalar value of kind `k` due next.
    private !void scalar(^self, Kind k):
        if k == Kind.String:
            try Span s = self.span(self.at)
            self.took(s.end)
        else if k == Kind.Number:
            try i64 end = self.number_end(self.at)
            self.took(end)
        else if k == Kind.Bool:
            try _ = self.boolean()
        else:
            try self.null()

    // Where the literal `word` (`true`, `false`, `null`) at `at` ends.
    private !i64 literal(^self, string8 word):
        i64 n = self.size()
        for k in 0..<#len(word):
            i64 p = self.at + k
            if p >= n:
                fail self.stop(TRUNCATED, p)
            if self.byte(p) != u8(word[k]):
                fail self.stop(UNEXPECTED, p)
        return self.at + #len(word)

    // The string whose opening quote is at `from`: where it ends, past its
    // closing quote, and whether it holds no escape. Checks every byte.
    private !Span span(^self, i64 from):
        i64 n = self.size()
        i64 p = from + 1
        bool plain = true
        for:
            if p >= n:
                fail self.stop(TRUNCATED, p)
            u8 b = self.byte(p)
            if b == u8('"'):
                return (p + 1, plain)
            if b < 0x20:
                fail self.stop(CONTROL_CHARACTER, p)
            if b == u8('\\'):
                plain = false
                try Step e = self.escape(p)
                p = e.end
            else if b >= 0x80:
                try Step c = self.utf8(p)
                p = c.end
            else:
                p += 1
        return (p, plain)

    // The escape whose backslash is at `p`: the code point it names (a
    // surrogate pair's, for the pair) and where it ends.
    private !Step escape(^self, i64 p):
        i64 n = self.size()
        if p + 1 >= n:
            fail self.stop(TRUNCATED, n)
        u8 c = self.byte(p + 1)
        if c == u8('"') || c == u8('\\') || c == u8('/'):
            return (u32(c), p + 2)
        if c == u8('b'):
            return (0x08, p + 2)
        if c == u8('f'):
            return (0x0C, p + 2)
        if c == u8('n'):
            return (0x0A, p + 2)
        if c == u8('r'):
            return (0x0D, p + 2)
        if c == u8('t'):
            return (0x09, p + 2)
        if c != u8('u'):
            fail self.stop(BAD_ESCAPE, p)
        try u32 hi = self.hex4(p + 2)
        if hi >= 0xDC00 && hi < 0xE000:
            fail self.stop(LONE_SURROGATE, p)
        if hi < 0xD800 || hi >= 0xDC00:
            return (hi, p + 6)
        if p + 7 >= n || self.byte(p + 6) != u8('\\') || self.byte(p + 7) != u8('u'):
            fail self.stop(LONE_SURROGATE, p)
        try u32 lo = self.hex4(p + 8)
        if lo < 0xDC00 || lo >= 0xE000:
            fail self.stop(LONE_SURROGATE, p)
        return (0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00), p + 12)

    // The four hex digits at `p`, as a number.
    private !u32 hex4(^self, i64 p):
        i64 n = self.size()
        u32 v = 0
        for k in 0..<4:
            if p + k >= n:
                fail self.stop(TRUNCATED, n)
            u32 b = u32(self.byte(p + k))
            u32 d = 0
            if b >= 0x30 && b <= 0x39:
                d = b - 0x30
            else if b >= 0x61 && b <= 0x66:
                d = b - 0x61 + 10
            else if b >= 0x41 && b <= 0x46:
                d = b - 0x41 + 10
            else:
                fail self.stop(BAD_ESCAPE, p - 2)
            v = (v << 4) | d
        return v

    // The UTF-8 sequence whose first byte, 0x80 or above, is at `p`: its code
    // point and where it ends. core:chars decides what is well formed.
    private !Step utf8(^self, i64 p):
        i64 n = self.size()
        [4]char8 buf
        i64 k = 0
        for k < 4 && p + k < n:
            buf[k] = char8(self.byte(p + k))
            k += 1
        (char32 cp, i64 size) = chars.decode(string8(buf[0..<k]), 0)
        if size <= 1:
            fail self.stop(BAD_UTF8, p)
        return (u32(cp), p + size)

    // The string from the quote at `from` to `end`, its escapes decoded, into
    // `out^` in place of what it held; a nil one is made on `#default`.
    // Fails with `NO_MEMORY` alone: `span` has checked the string.
    private !void decode(^self, i64 from, i64 end, ^ref []char8 out):
        if out^ == nil:
            out^ = #make([]char8, 0)
            if out^ == nil:
                fail NO_MEMORY
        #truncate(out^, 0)
        try self.decode_onto(from, end, out)

    // The string from the quote at `from` to `end`, its escapes decoded,
    // appended to `out^`.
    private !void decode_onto(^self, i64 from, i64 end, ^ref []char8 out):
        if !#reserve(out^, #len(out^) + end - from - 2):
            fail NO_MEMORY
        i64 p = from + 1
        for p < end - 1:
            u8 b = self.byte(p)
            if b != u8('\\'):
                _ = #append(out^, char8(b))
                p += 1
                continue
            try Step e = self.escape(p)
            [4]char8 buf
            i64 size = chars.encode(char32(e.cp), buf[:], 0)
            for k in 0..<size:
                if !#append(out^, buf[k]):
                    fail NO_MEMORY
            p = e.end

    // `from` to `end` of the input, as they are, into `out^` in place of what
    // it held.
    private !void copy_bytes(^self, i64 from, i64 end, ^ref []char8 out):
        if out^ == nil:
            out^ = #make([]char8, 0)
            if out^ == nil:
                fail NO_MEMORY
        #truncate(out^, 0)
        if !#reserve(out^, end - from):
            fail NO_MEMORY
        for p in from..<end:
            _ = #append(out^, char8(self.byte(p)))

    // Where the number starting at `from` ends, checking RFC 8259's form:
    // `-`? (`0` | [1-9] digits) (`.` digits)? ((`e` | `E`) (`+` | `-`)? digits)?
    private !i64 number_end(^self, i64 from):
        try Number n = self.scan(from, false, false)
        return n.end

    // The number due next, read.
    // The number due next, read; its nearest `f64` too when `exact` is false,
    // and otherwise only for an `Int` or a `Uint`.
    private !Number number_here(^self, bool exact):
        try self.typed(Kind.Number)
        try Number n = self.scan(self.at, true, !exact)
        return n

    // The number starting at `from`: where it ends and, with `values`, what it
    // is; with `floats` too, the nearest `f64` to one that is neither an `Int`
    // nor a `Uint`.
    private !Number scan(^self, i64 from, bool values, bool floats):
        i64 n = self.size()
        i64 p = from
        bool negative = self.byte(p) == u8('-')
        if negative:
            p += 1
        i64 first = p
        try p = self.digits(p, true)
        if self.byte(first) == u8('0') && p - first > 1:
            fail self.stop(BAD_NUMBER, first + 1)
        bool integer = true
        if p < n && self.byte(p) == u8('.'):
            integer = false
            try p = self.digits(p + 1, true)
        if p < n && (self.byte(p) == u8('e') || self.byte(p) == u8('E')):
            integer = false
            p += 1
            if p < n && (self.byte(p) == u8('+') || self.byte(p) == u8('-')):
                p += 1
            try p = self.digits(p, true)
        Number out
        out.end = p
        out.form = Form.Float
        if !values:
            return out
        if integer:
            u64 mag = 0
            bool fits = true
            for q in first..<p:
                u64 d = u64(self.byte(q) - u8('0'))
                if mag > (0xFFFFFFFFFFFFFFFF - d) / 10:
                    fits = false
                    break
                mag = mag * 10 + d
            if fits && negative && mag <= 0x8000000000000000:
                out.form = Form.Int
                out.i = 0 - i64(mag - 1) - 1 if mag > 0 else 0
                out.f = f64(out.i)
                return out
            if fits && !negative:
                if mag <= 0x7FFFFFFFFFFFFFFF:
                    out.form = Form.Int
                    out.i = i64(mag)
                else:
                    out.form = Form.Uint
                out.u = mag
                out.f = f64(mag)
                return out
            out.form = Form.Big
        if floats:
            try out.f = self.to_f64(from, p)
        return out

    // Where the run of digits at `p` ends; with `need`, it must have one.
    private !i64 digits(^self, i64 from, bool need):
        i64 n = self.size()
        i64 p = from
        for p < n && self.byte(p) >= u8('0') && self.byte(p) <= u8('9'):
            p += 1
        if need && p == from:
            if p >= n:
                fail self.stop(TRUNCATED, p)
            fail self.stop(BAD_NUMBER, p)
        return p

    // The number from `from` to `end`, checked already, as the nearest `f64`.
    private !f64 to_f64(^self, i64 from, i64 end):
        if self.from_text:
            try f64 v = parse.to_f64(self.source[from..<end]) else:
                fail self.stop(BAD_NUMBER, from)
            return v
        i64 len = end - from
        if len <= 64:
            [64]char8 buf
            for k in 0..<len:
                buf[k] = char8(self.byte(from + k))
            try f64 v = parse.to_f64(string8(buf[0..<len])) else:
                fail self.stop(BAD_NUMBER, from)
            return v
        ref []char8 long
        try self.copy_bytes(from, end, &long) else code:
            #delete(long)
            fail code
        string8 s = long
        try f64 v = parse.to_f64(s) else:
            #delete(long)
            fail self.stop(BAD_NUMBER, from)
        #delete(long)
        return v

    // Reads the value due next into `d^`: one node for it and one for
    // each value inside it, in the order written. `pending^` holds the
    // indices of the children of each container still open, which move to
    // `d^.kids` when it closes. Iterative, so nesting costs two words a
    // level of `MAX_DEPTH`, not stack. A failure fails the reader.
    private !void build(^self, ^Document d, ^ref []i64 pending):
        if d^.nodes == nil || d^.kids == nil || d^.chars == nil || pending^ == nil:
            fail self.stop(NO_MEMORY, self.at)
        [MAX_DEPTH]i64 marks
        [MAX_DEPTH]i64 opened
        i32 base = self.depth
        i64 key_at = 0
        i64 key_len = 0
        for:
            try Kind k = self.kind()
            i64 index = #len(d^.nodes)
            Node node
            node.kind = k
            node.key_at = key_at
            node.key_len = key_len
            if self.depth > base && !#append(pending^, index):
                fail self.stop(NO_MEMORY, self.at)
            if k == Kind.Bool:
                try node.truth = self.boolean()
            else if k == Kind.Null:
                try self.null()
            else if k == Kind.Number:
                try Number n = self.number_here(false) else code:
                    fail self.stop(code, self.at)
                self.took(n.end)
                node.form = n.form
                node.i = n.i
                node.u = n.u
                node.f = n.f
            else if k == Kind.String:
                try Span s = self.span(self.at)
                node.at = #len(d^.chars)
                try self.decode_onto(self.at, s.end, &d^.chars) else code:
                    fail self.stop(code, self.at)
                node.len = #len(d^.chars) - node.at
                self.took(s.end)
            else:
                try self.open(k)
                i32 level = self.depth - base - 1
                marks[level] = #len(pending^)
                opened[level] = index
            if !#append(d^.nodes, node):
                fail self.stop(NO_MEMORY, self.at)
            // Close what ends here, then find the next value due, if any.
            bool next = false
            for !next && self.depth > base:
                if self.more():
                    if self.in_object():
                        try i64 start = self.key_start()
                        try Span s = self.span(start)
                        try i64 end = self.colon(s.end)
                        key_at = #len(d^.chars)
                        try self.decode_onto(start, s.end, &d^.chars) else code:
                            fail self.stop(code, start)
                        key_len = #len(d^.chars) - key_at
                        self.keyed = true
                        self.due = false
                        self.at = end
                    else:
                        key_at = 0
                        key_len = 0
                    next = true
                else:
                    if self.failed != 0:
                        fail self.failed
                    i32 level = self.depth - base
                    i64 mark = marks[level]
                    i64 count = #len(pending^) - mark
                    i64 at = #len(d^.kids)
                    if !#reserve(d^.kids, at + count):
                        fail self.stop(NO_MEMORY, self.at)
                    for c in mark..<#len(pending^):
                        _ = #append(d^.kids, pending^[c])
                    #truncate(pending^, mark)
                    d^.nodes[opened[level]].at = at
                    d^.nodes[opened[level]].len = count
            if !next:
                return

// A reader at the start of `data`, which it reads in place. Objects and
// arrays may nest `max_depth` deep, which is held between 1 and `MAX_DEPTH`.
#assert_raises
public Reader reader([]u8 data, i32 max_depth = MAX_DEPTH):
    Reader r
    r.bytes = data
    r.limit = depth_limit(max_depth)
    return r

// A reader at the start of `text`, which it reads in place; a string or a
// number with no escape is answered as a view into it. Objects and arrays
// may nest `max_depth` deep, which is held between 1 and `MAX_DEPTH`.
#assert_raises
public Reader reader_text(string8 text, i32 max_depth = MAX_DEPTH):
    Reader r
    r.source = text
    r.from_text = true
    r.limit = depth_limit(max_depth)
    return r

// Succeeds when `data` is exactly one JSON value and whitespace, by RFC 8259
// strictly. Fails with the code of the first malformed byte, `TOO_DEEP` past
// `MAX_DEPTH`, or `TRAILING`. Linear in `#len(data)`; allocates nothing, and
// nesting costs no stack.
#assert_raises
public !void well_formed([]u8 data):
    Reader r = reader(data)
    try r.finish()

// `well_formed` over text.
#assert_raises
public !void well_formed_text(string8 text):
    Reader r = reader_text(text)
    try r.finish()

private i32 depth_limit(i32 max_depth):
    if max_depth < 1:
        return 1
    if max_depth > MAX_DEPTH:
        return MAX_DEPTH
    return max_depth

// A string's extent, as `Reader.span` answers it.
private type Span:
    i64 end
    bool plain

// A code point read and where what follows starts.
private type Step:
    u32 cp
    i64 end

// A number read: where it ends, its form, and its value in each slot the
// form fills (`f` always).
private type Number:
    i64 end
    Form form
    i64 i
    u64 u
    f64 f
