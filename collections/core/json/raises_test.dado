@test
// What raises into a script. `#assert_raises` stands only above a
// package-level function, so the methods of `Writer`, `Reader`, `Document`
// and `Value` cannot carry it themselves: each promised function here calls
// a group of them, and the build refuses (ERR1227) if any reaches something
// a script cannot run. Nothing is left out.
package json

#assert_raises
private !void writes(Value v):
    Writer w = writer(2)
    w.object()
    w.key("a")
    w.array()
    w.text("x")
    w.int(-1)
    w.uint(1)
    w.float(1.5)
    w.float32(f32(1.5))
    w.boolean(true)
    w.null()
    w.value(v)
    w.end_array()
    w.end_object()
    _ = w.code()
    try ref []char8 out = w.finish()
    #delete(out)
    w.destroy()

#assert_raises
private !bool reads(string8 text, []u8 data):
    ref []char8 scratch
    defer #delete(scratch)
    Reader r = reader_text(text)
    _ = r.done()
    _ = r.code()
    _ = r.offset()
    try _ = r.kind()
    try r.object()
    _ = r.more()
    try _ = r.key(&scratch)
    try _ = r.text(&scratch)
    _ = r.more()
    try _ = r.key(&scratch)
    try r.array()
    _ = r.more()
    try _ = r.int()
    _ = r.more()
    try _ = r.uint()
    _ = r.more()
    try _ = r.float()
    _ = r.more()
    try _ = r.number_text(&scratch)
    _ = r.more()
    try _ = r.boolean()
    _ = r.more()
    try r.null()
    _ = r.more()
    try ref []char8 t = r.text_copy()
    #delete(t)
    _ = r.more()
    try r.skip()
    _ = r.more()
    try Document d = r.document()
    d.destroy()
    try r.finish()
    Reader b = reader(data)
    try b.finish()
    return r.done()

#assert_raises
private !i64 looks(Document d):
    Value v = d.root()
    _ = v.kind()
    _ = v.form()
    _ = v.is_null()
    _ = v.has("a")
    try Value a = v.get("a")
    try Value b = v.at(1)
    try _ = v.key(0)
    try _ = a.text()
    try Value c = b.at(0)
    try _ = c.boolean()
    try Value e = b.at(1)
    try _ = e.int()
    try _ = e.uint()
    try _ = e.float()
    return v.len()

i32 test():
    bool ok = true
    string8 text = "{\"a\": \"x\", \"b\": [-1, 1, 1.5, 2, true, null, \"y\", {}, [3]]}"
    ref []u8 data = #make([]u8, #len(text))
    defer #delete(data)
    for i in 0..<#len(text):
        data[i] = u8(text[i])
    bool all
    try all = reads(text, data[:]) else code:
        all = #expect(false, "the reads failed: ", message(code))
    ok = #expect(all, "the reads did not end at the end") && ok
    try Document doc = parse_text("{\"a\": \"x\", \"b\": [true, 2]}") else code:
        return 0 if #expect(false, "parse: ", message(code)) else 1
    defer doc.destroy()
    i64 n = 0
    try n = looks(doc) else code:
        ok = #expect(false, "the looks failed: ", message(code)) && ok
    ok = #expect(n == 2, "two members, not ", n) && ok
    try writes(doc.root()) else code:
        ok = #expect(false, "the writes failed: ", message(code)) && ok
    return 0 if ok else 1
