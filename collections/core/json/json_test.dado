@test
// The writer: compact and indented documents, the escaping table (invalid
// UTF-8 included), integers at their limits, floats that read back through
// `core:strings/parse` bit for bit (fixed-seed random doubles and singles
// among them), and every misuse failing with its code.
package json

import "core:strings/parse"

private cunion Bits64: (f64 f, u64 u)
private cunion Bits32: (f32 f, u32 u)

private u64 state = 0x2545F4914F6CDD1D

private u64 next():
    state = state ~ (state >> 12)
    state = state ~ (state << 25)
    state = state ~ (state >> 27)
    return state * 0x9E3779B97F4A7C15

// What `w` finished as is `want`.
private bool is(^Writer w, string8 want, string8 what):
    try ref []char8 got = w.finish() else code:
        return #expect(false, what, ": failed: ", message(code))
    defer #delete(got)
    string8 text = string8(got[:])
    return #expect(text == want, what, ": wrote ", text, ", not ", want)

private bool fails(^Writer w, i32 want, string8 what):
    i32 code = 0
    ref []char8 got
    try got = w.finish() else c:
        code = c
        got = nil
    #delete(got)
    return #expect(code == want, what, ": code ", code, ", not ", want)

private bool escaped(string8 s, string8 want):
    Writer w = writer()
    w.text(s)
    return is(&w, want, "escaping")

// `s` escaped one code point at a time, as the source package did it before
// `quoted` learned to write runs: the reference the run writer is held to.
private ref []char8 one_at_a_time(string8 s):
    ref []char8 out = #make([]char8, 0)
    _ = #append(out, '"')
    string8 hex = "0123456789abcdef"
    i64 i = 0
    i64 n = #len(s)
    for i < n:
        (u32 cp, i64 size) = utf8_at(s, i)
        string8 esc = ""
        if cp == 0x22:
            esc = "\\\""
        else if cp == 0x5C:
            esc = "\\\\"
        else if cp == 0x0A:
            esc = "\\n"
        else if cp == 0x0D:
            esc = "\\r"
        else if cp == 0x09:
            esc = "\\t"
        else if cp == 0x08:
            esc = "\\b"
        else if cp == 0x0C:
            esc = "\\f"
        if #len(esc) > 0:
            for b in esc:
                _ = #append(out, b)
        else if cp < 0x20 || (cp >= 0x7F && cp < 0xA0) || cp == 0x2028 || cp == 0x2029:
            _ = #append(out, '\\')
            _ = #append(out, 'u')
            for k in 0..<4:
                _ = #append(out, hex[i64((cp >> u32(12 - 4 * k)) & 15)])
        else if cp == 0xFFFD && size == 1:
            for b in "\xEF\xBF\xBD":
                _ = #append(out, b)
        else:
            for k in 0..<size:
                _ = #append(out, s[i + k])
        i += size
    _ = #append(out, '"')
    return out

// Random strings drawn from bytes that exercise every arm: plain ASCII,
// escapes, controls, lead and continuation bytes, and the first bytes of
// U+2028 and U+FFFD.
private bool runs_match_reference():
    string8 alphabet = "ab \"\\\n\t\x01\x7F\xC2\x80\x9F\xA0\xE2\xA8\xA9\xEF\xBF\xBD\xF0\x90\x85\x91\xFF\xC0\xED"
    bool ok = true
    [24]char8 text
    for round in 0..<3000:
        i64 len = i64(next() % 24)
        for k in 0..<len:
            text[k] = alphabet[i64(next() % u64(#len(alphabet)))]
        string8 s = string8(text[0..<len])
        ref []char8 want = one_at_a_time(s)
        Writer w = writer()
        w.text(s)
        ok = is(&w, string8(want[:]), "a run of mixed bytes") && ok
        #delete(want)
        if !ok:
            break
    return ok

// An allocator that refuses everything, and one that hands out one fixed
// 64-byte block and refuses to grow past it: the two ways `NO_MEMORY` arises.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

private [64]char8 pool

private rawptr no_growth(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    if nbytes <= 64:
        return rawptr(&pool[0])
    return nil

private bool float_back(f64 v):
    Writer w = writer()
    w.float(v)
    try ref []char8 got = w.finish() else:
        return #expect(false, "float ", v, " failed")
    defer #delete(got)
    string8 text = string8(got[:])
    f64 back = 0.0
    try back = parse.to_f64(text) else:
        return #expect(false, "float text ", text, " does not parse")
    Bits64 a = Bits64(v)
    Bits64 b = Bits64(back)
    return #expect(a.u == b.u, "float ", text, " read back with other bits")

private bool float32_back(f32 v):
    Writer w = writer()
    w.float32(v)
    try ref []char8 got = w.finish() else:
        return #expect(false, "float32 ", v, " failed")
    defer #delete(got)
    string8 text = string8(got[:])
    f32 back = 0.0
    try back = parse.to_f32(text) else:
        return #expect(false, "float32 text ", text, " does not parse")
    Bits32 a = Bits32(v)
    Bits32 b = Bits32(back)
    return #expect(a.u == b.u, "float32 ", text, " read back with other bits")

private bool float_text(f64 v, string8 want):
    Writer w = writer()
    w.float(v)
    return is(&w, want, "float text")

private void document(^Writer w):
    w.object()
    w.key("name")
    w.text("oak")
    w.key("sizes")
    w.array()
    w.int(600)
    w.float(18.5)
    w.array()
    w.end_array()
    w.object()
    w.end_object()
    w.end_array()
    w.key("ok")
    w.boolean(true)
    w.key("none")
    w.null()
    w.end_object()

// Every method of `Writer`, called once. A method cannot carry
// `#assert_raises` itself, so this promise is what checks that each one
// raises into a script.
#assert_raises
private bool every_method():
    Writer w = writer(indent: 1)
    w.object()
    w.key("a")
    w.array()
    w.text("t")
    w.int(0 - 1)
    w.uint(1)
    w.float(0.5)
    w.float32(f32(0.5))
    w.boolean(true)
    w.null()
    w.end_array()
    w.end_object()
    bool clean = w.code() == 0
    try ref []char8 got = w.finish() else:
        return false
    bool right = string8(got[:]) == "{\n \"a\": [\n  \"t\",\n  -1,\n  1,\n  0.5,\n  0.5,\n  true,\n  null\n ]\n}"
    #delete(got)
    w.destroy()
    return clean && right

i32 test():
    bool ok = true
    ok = #expect(every_method(), "the promised walk over every method wrote the wrong text") && ok

    // ── documents ─────────────────────────────────────────────────────────
    Writer w = writer()
    document(&w)
    ok = is(&w, "{\"name\":\"oak\",\"sizes\":[600,18.5,[],{}],\"ok\":true,\"none\":null}", "compact") && ok
    w = writer(indent: 2)
    document(&w)
    ok = is(&w, "{\n  \"name\": \"oak\",\n  \"sizes\": [\n    600,\n    18.5,\n    [],\n    {}\n  ],\n  \"ok\": true,\n  \"none\": null\n}", "indented") && ok
    // The package comment's example, and the text it says it writes.
    w = writer(indent: 2)
    w.object()
    w.key("name")
    w.text("oak")
    w.key("sizes")
    w.array()
    w.int(600)
    w.float(18.5)
    w.end_array()
    w.end_object()
    ok = is(&w, "{\n  \"name\": \"oak\",\n  \"sizes\": [\n    600,\n    18.5\n  ]\n}", "the package comment's example") && ok
    ok = #expect(message(TOO_DEEP) == "objects and arrays nest deeper than MAX_DEPTH", "message's example") && ok
    w = writer(indent: 4)
    w.array()
    w.end_array()
    ok = is(&w, "[]", "an empty top-level array") && ok
    w = writer()
    w.text("alone")
    ok = is(&w, "\"alone\"", "a top-level string") && ok
    w = writer()
    w.array()
    w.int(0 - 9223372036854775807 - 1)
    w.uint(0xFFFFFFFFFFFFFFFF)
    w.int(0)
    w.boolean(false)
    w.end_array()
    ok = is(&w, "[-9223372036854775808,18446744073709551615,0,false]", "integer limits") && ok

    // ── escaping ──────────────────────────────────────────────────────────
    ok = escaped("", "\"\"") && ok
    ok = escaped("plain / text", "\"plain / text\"") && ok
    ok = escaped("\"\\", "\"\\\"\\\\\"") && ok
    ok = escaped("\n\r\t", "\"\\n\\r\\t\"") && ok
    ok = escaped("\x08\x0C", "\"\\b\\f\"") && ok
    ok = escaped("\x00\x01\x1F", "\"\\u0000\\u0001\\u001f\"") && ok
    ok = escaped("\x7F", "\"\\u007f\"") && ok
    ok = escaped("\xC2\x80\xC2\x9F\xC2\xA0", "\"\\u0080\\u009f\xC2\xA0\"") && ok
    ok = escaped("\xE2\x80\xA8\xE2\x80\xA9", "\"\\u2028\\u2029\"") && ok
    ok = escaped("ü水𐅑", "\"ü水𐅑\"") && ok
    ok = escaped("\xEF\xBF\xBD", "\"\xEF\xBF\xBD\"") && ok
    // Not UTF-8: each bad byte one U+FFFD.
    ok = escaped("a\xFFb", "\"a\xEF\xBF\xBDb\"") && ok
    ok = escaped("\xC3", "\"\xEF\xBF\xBD\"") && ok
    ok = escaped("\xC0\xAF", "\"\xEF\xBF\xBD\xEF\xBF\xBD\"") && ok
    ok = escaped("\xED\xA0\x80", "\"\xEF\xBF\xBD\xEF\xBF\xBD\xEF\xBF\xBD\"") && ok
    ok = escaped("\xF4\x90\x80\x80", "\"\xEF\xBF\xBD\xEF\xBF\xBD\xEF\xBF\xBD\xEF\xBF\xBD\"") && ok
    ok = escaped("\xE6\xB0", "\"\xEF\xBF\xBD\xEF\xBF\xBD\"") && ok
    // Escapes at either end of a run, and two in a row.
    ok = escaped("\"a", "\"\\\"a\"") && ok
    ok = escaped("a\"", "\"a\\\"\"") && ok
    ok = escaped("\n\n", "\"\\n\\n\"") && ok
    ok = escaped("ab\xFFcd\xC2\x85ef", "\"ab\xEF\xBF\xBDcd\\u0085ef\"") && ok
    // A text far longer than the room reserved up front.
    ref []char8 long = #make([]char8, 0)
    ref []char8 long_want = #make([]char8, 0)
    _ = #append(long_want, '"')
    for k in 0..<5000:
        _ = #append(long, 'x')
        _ = #append(long_want, 'x')
        if k % 1000 == 999:
            _ = #append(long, '\t')
            _ = #append(long_want, '\\')
            _ = #append(long_want, 't')
    _ = #append(long_want, '"')
    ok = escaped(string8(long[:]), string8(long_want[:])) && ok
    #delete(long)
    #delete(long_want)
    ok = runs_match_reference() && ok
    // Keys escape the same way.
    w = writer()
    w.object()
    w.key("a\"b")
    w.int(1)
    w.end_object()
    ok = is(&w, "{\"a\\\"b\":1}", "an escaped key") && ok

    // ── floats ────────────────────────────────────────────────────────────
    ok = float_text(0.1, "0.1") && ok
    ok = float_text(1.0, "1.0") && ok
    ok = float_text(0.0 - 0.0, "0.0") && ok
    ok = float_text(1.0e21, "1e+21") && ok
    ok = float_text(5.0e-324, "5e-324") && ok
    Bits64 nz = Bits64(u64(0x8000000000000000))
    ok = float_text(nz.f, "-0.0") && ok
    [10]f64 picked = [0.1, 1.0 / 3.0, 2.0 / 3.0, 1.7976931348623157e308, 2.2250738585072014e-308,
                      4.9e-324, 123456789012345680.0, 0.000001, 9007199254740993.0, 0.0 - 1.5e-7]
    for v in picked:
        ok = float_back(v) && ok
    for _i in 0..<5000:
        Bits64 b = Bits64(next())
        if (b.u >> 52) & 0x7FF != 0x7FF:
            ok = float_back(b.f) && ok
        Bits32 s = Bits32(u32(next() >> 32))
        if (s.u >> 23) & 0xFF != 0xFF:
            ok = float32_back(s.f) && ok
    Bits64 nan = Bits64(u64(0x7FF8000000000000))
    Bits64 inf = Bits64(u64(0x7FF0000000000000))
    Bits64 ninf = Bits64(u64(0xFFF0000000000000))
    w = writer()
    w.float(nan.f)
    ok = fails(&w, NOT_FINITE, "NaN") && ok
    w = writer()
    w.array()
    w.float(inf.f)
    w.end_array()
    ok = fails(&w, NOT_FINITE, "infinity") && ok
    w = writer()
    w.float(ninf.f)
    ok = fails(&w, NOT_FINITE, "-infinity") && ok
    w = writer()
    w.float32(f32(inf.f))
    ok = fails(&w, NOT_FINITE, "single infinity") && ok
    w = writer()
    w.float32(f32(nan.f))
    ok = fails(&w, NOT_FINITE, "single NaN") && ok
    w = writer()
    w.float32(f32(ninf.f))
    ok = fails(&w, NOT_FINITE, "single -infinity") && ok
    // The largest finite values are not infinities.
    ok = float_back(1.7976931348623157e308) && ok
    ok = float_back(0.0 - 1.7976931348623157e308) && ok
    Bits32 big = Bits32(u32(0x7F7FFFFF))
    ok = float32_back(big.f) && ok

    // ── misuse ────────────────────────────────────────────────────────────
    w = writer()
    w.object()
    w.int(1)
    ok = fails(&w, EXPECTED_KEY, "a value with no key") && ok
    w = writer()
    w.object()
    w.object()
    ok = fails(&w, EXPECTED_KEY, "an object with no key") && ok
    w = writer()
    w.array()
    w.key("k")
    ok = fails(&w, UNEXPECTED_KEY, "a key in an array") && ok
    w = writer()
    w.key("k")
    ok = fails(&w, UNEXPECTED_KEY, "a key at the top") && ok
    w = writer()
    w.object()
    w.key("a")
    w.key("b")
    ok = fails(&w, UNEXPECTED_KEY, "two keys") && ok
    w = writer()
    w.object()
    w.key("a")
    w.end_object()
    ok = fails(&w, UNBALANCED, "a key with no value") && ok
    w = writer()
    w.object()
    w.end_array()
    ok = fails(&w, UNBALANCED, "the wrong end") && ok
    w = writer()
    w.end_array()
    ok = fails(&w, UNBALANCED, "an end with nothing open") && ok
    // The kind is kept per level: an array inside an object inside an array.
    w = writer()
    w.array()
    w.object()
    w.key("k")
    w.array()
    w.end_array()
    w.end_array()
    ok = fails(&w, UNBALANCED, "an array end closing an object two levels down") && ok
    w = writer()
    w.array()
    w.object()
    w.key("k")
    w.array()
    w.end_array()
    w.end_object()
    w.end_array()
    ok = is(&w, "[{\"k\":[]}]", "three levels, each closed by its own kind") && ok
    w = writer()
    w.array()
    ok = fails(&w, UNBALANCED, "an open array at finish") && ok
    w = writer()
    ok = fails(&w, UNBALANCED, "nothing written") && ok
    w = writer()
    w.int(1)
    w.int(2)
    ok = fails(&w, UNBALANCED, "two top-level values") && ok
    w = writer()
    w.object()
    w.end_object()
    w.array()
    ok = fails(&w, UNBALANCED, "a container after the top-level value") && ok
    w = writer()
    for _i in 0..<MAX_DEPTH:
        w.array()
    for _i in 0..<MAX_DEPTH:
        w.end_array()
    ok = #expect(w.code() == 0, "MAX_DEPTH arrays failed with ", w.code()) && ok
    w.destroy()
    w = writer()
    for _i in 0..=MAX_DEPTH:
        w.array()
    ok = fails(&w, TOO_DEEP, "MAX_DEPTH + 1 arrays") && ok
    // Out of memory: at `writer`, and when the text cannot grow.
    w = writer() using (refuses, nil)
    ok = #expect(w.code() == NO_MEMORY, "a refused writer has code ", w.code()) && ok
    w.text("x")
    ok = fails(&w, NO_MEMORY, "a writer whose allocation was refused") && ok
    w = writer(room: 8) using (no_growth, nil)
    ok = #expect(w.code() == 0, "a writer with 8 bytes has code ", w.code()) && ok
    w.text("this text needs more than the sixty-four bytes the block holds, so it fails")
    ok = #expect(w.code() == NO_MEMORY, "a text past the block's end has code ", w.code()) && ok
    ok = fails(&w, NO_MEMORY, "a writer whose text could not grow") && ok
    // Compact for any indent of 0 or less.
    w = writer(indent: 0 - 3)
    w.array()
    w.int(1)
    w.int(2)
    w.end_array()
    ok = is(&w, "[1,2]", "a negative indent") && ok
    // `code` reports the failure before `finish`; `destroy` after `finish`
    // does nothing; the writer keeps its first code.
    w = writer()
    w.null()
    w.null()
    ok = #expect(w.code() == UNBALANCED, "code after a second top-level value is ", w.code()) && ok
    w.destroy()
    w = writer()
    w.null()
    ok = is(&w, "null", "a lone null") && ok
    w.destroy()
    ok = #expect(w.out == nil, "destroy after finish left text behind") && ok
    // The first failure is the one kept.
    w = writer()
    w.object()
    w.int(1)
    w.end_array()
    ok = fails(&w, EXPECTED_KEY, "the first of two failures") && ok
    for code in 1..=6:
        ok = #expect(message(i32(code)) != message(0), "code ", code, " has no message") && ok
    return 0 if ok else 1
