@test
// The tree and round trips: RFC 8259's own examples parsed and looked up,
// every lookup's failures, texts read and written back by the writer to the
// same compact text, and values written by the writer read back exactly
// (fixed-seed random doubles and integers among them).
package json

private cunion Bits64: (f64 f, u64 u)

private u64 state = 0x9E3779B97F4A7C15

private u64 next():
    state = state ~ (state >> 12)
    state = state ~ (state << 25)
    state = state ~ (state >> 27)
    return state * 0x2545F4914F6CDD1D

private bool has_code(Error got, Error want, string8 what):
    return #expect(got == want, what, ": code ", got, " (", message(got), "), not ", want)

// RFC 8259 section 13, the first example.
private const string8 IMAGE = "{\n      \"Image\": {\n          \"Width\":  800,\n          \"Height\": 600,\n          \"Title\":  \"View from 15th Floor\",\n          \"Thumbnail\": {\n              \"Url\":    \"http://www.example.com/image/481989943\",\n              \"Height\": 125,\n              \"Width\":  100\n          },\n          \"Animated\" : false,\n          \"IDs\": [116, 943, 234, 38793]\n        }\n      }"

// RFC 8259 section 13, the second example.
private const string8 PLACES = "[\n        {\n           \"precision\": \"zip\",\n           \"Latitude\":  37.7668,\n           \"Longitude\": -122.3959,\n           \"Address\":   \"\",\n           \"City\":      \"SAN FRANCISCO\",\n           \"State\":     \"CA\",\n           \"Zip\":       \"94107\",\n           \"Country\":   \"US\"\n        },\n        {\n           \"precision\": \"zip\",\n           \"Latitude\":  37.371991,\n           \"Longitude\": -122.026020,\n           \"Address\":   \"\",\n           \"City\":      \"SUNNYVALE\",\n           \"State\":     \"CA\",\n           \"Zip\":       \"94085\",\n           \"Country\":   \"US\"\n        }\n      ]"

private bool rfc_examples():
    bool ok = true
    try Document doc = parse_text(IMAGE) else code:
        return #expect(false, "IMAGE: ", message(code))
    defer doc.destroy()
    Value top = doc.root()
    ok = #expect(top.kind() == Kind.Object && top.len() == 1, "one member") && ok
    try Value image = top.get("Image") else:
        return #expect(false, "Image")
    try Value width = image.get("Width") else:
        return #expect(false, "Width")
    try i64 w = width.int() else:
        return #expect(false, "Width is an int")
    ok = #expect(w == 800, "Width ", w) && ok
    try Value title = image.get("Title") else:
        return false
    try string8 t = title.text() else:
        return false
    ok = #expect(t == "View from 15th Floor", "Title ", t) && ok
    try Value thumb = image.get("Thumbnail") else:
        return false
    try Value url = thumb.get("Url") else:
        return false
    try string8 u = url.text() else:
        return false
    ok = #expect(u == "http://www.example.com/image/481989943", "Url ", u) && ok
    try Value animated = image.get("Animated") else:
        return false
    try bool a = animated.boolean() else:
        return false
    ok = #expect(!a, "Animated is false") && ok
    try Value ids = image.get("IDs") else:
        return false
    ok = #expect(ids.kind() == Kind.Array && ids.len() == 4, "four IDs") && ok
    i64 sum = 0
    for i in 0..<ids.len():
        try Value id = ids.at(i) else:
            return false
        try i64 v = id.int() else:
            return false
        sum += v
    ok = #expect(sum == 116 + 943 + 234 + 38793, "IDs sum ", sum) && ok
    ok = #expect(image.len() == 6, "Image has six members") && ok
    try string8 k = image.key(4) else:
        return false
    ok = #expect(k == "Animated", "the fifth key is ", k) && ok

    try Document places = parse_text(PLACES) else code:
        return #expect(false, "PLACES: ", message(code))
    defer places.destroy()
    Value list = places.root()
    ok = #expect(list.len() == 2, "two places") && ok
    try Value second = list.at(1) else:
        return false
    try Value lon = second.get("Longitude") else:
        return false
    try f64 x = lon.float() else:
        return false
    ok = #expect(x == -122.02602, "Longitude ", x) && ok
    ok = #expect(lon.form() == Form.Float, "a fraction is a Float") && ok
    try Value city = second.get("City") else:
        return false
    try string8 c = city.text() else:
        return false
    ok = #expect(c == "SUNNYVALE", "City ", c) && ok
    try Value addr = second.get("Address") else:
        return false
    try string8 empty = addr.text() else:
        return false
    ok = #expect(#len(empty) == 0, "Address is empty") && ok

    // The RFC's scalar texts.
    try Document hello = parse_text("\"Hello world!\"") else:
        return #expect(false, "a string alone")
    try string8 h = hello.root().text() else:
        return false
    ok = #expect(h == "Hello world!", "Hello world!") && ok
    hello.destroy()
    try Document clef = parse_text("\"\\uD834\\uDD1E\"") else:
        return #expect(false, "the G clef")
    try string8 g = clef.root().text() else:
        return false
    ok = #expect(g == "\xF0\x9D\x84\x9E", "the G clef decodes to U+1D11E") && ok
    clef.destroy()
    return ok

private bool lookups():
    bool ok = true
    try Document doc = parse_text("{\"a\": 1, \"b\": [true], \"a\": \"last\", \"n\": null, \"big\": 18446744073709551615, \"huge\": 1e999, \"neg\": -5}") else:
        return #expect(false, "parse")
    defer doc.destroy()
    Value top = doc.root()
    try Value a = top.get("a") else:
        return false
    try string8 last = a.text() else:
        return #expect(false, "a repeated key answers the last")
    ok = #expect(last == "last", "the last a") && ok
    ok = #expect(top.has("n") && !top.has("z"), "has") && ok
    Error got = NONE
    try _ = top.get("z") else code:
        got = code
    ok = has_code(got, Error.NOT_FOUND, "get of a missing key") && ok
    got = NONE
    try _ = top.at(7) else code:
        got = code
    ok = has_code(got, Error.NOT_FOUND, "at past the end") && ok
    got = NONE
    try _ = top.at(-1) else code:
        got = code
    ok = has_code(got, Error.NOT_FOUND, "at below 0") && ok
    got = NONE
    try _ = top.int() else code:
        got = code
    ok = has_code(got, Error.WRONG_TYPE, "int of an object") && ok
    try Value b = top.get("b") else:
        return false
    got = NONE
    try _ = b.get("x") else code:
        got = code
    ok = has_code(got, Error.WRONG_TYPE, "get on an array") && ok
    got = NONE
    try _ = b.key(0) else code:
        got = code
    ok = has_code(got, Error.WRONG_TYPE, "key on an array") && ok
    try Value n = top.get("n") else:
        return false
    ok = #expect(n.is_null() && n.len() == 0, "null") && ok
    try Value big = top.get("big") else:
        return false
    ok = #expect(big.form() == Form.Uint, "2^64 - 1 is a Uint") && ok
    got = NONE
    try _ = big.int() else code:
        got = code
    ok = has_code(got, Error.OVERFLOW, "int of a Uint") && ok
    try u64 bu = big.uint() else:
        return false
    ok = #expect(bu == 18446744073709551615, "uint of a Uint") && ok
    try Value neg = top.get("neg") else:
        return false
    got = NONE
    try _ = neg.uint() else code:
        got = code
    ok = has_code(got, Error.OVERFLOW, "uint of a negative") && ok
    try Value huge = top.get("huge") else:
        return false
    try f64 hf = huge.float() else:
        return false
    ok = #expect(hf > 1.7976931348623157e308, "1e999 is an infinity") && ok
    // A document of its own from inside a walk.
    Reader r = reader_text("[1, {\"k\": [2, 3]}, 4]")
    try r.array() else:
        return false
    _ = r.more()
    try r.skip() else:
        return false
    _ = r.more()
    try Document part = r.document() else code:
        return #expect(false, "document mid-walk: ", message(code))
    defer part.destroy()
    _ = r.more()
    try i64 four = r.int() else:
        return #expect(false, "the walk goes on after document")
    ok = #expect(four == 4, "four") && ok
    try r.finish() else code:
        ok = #expect(false, "finish: ", message(code)) && ok
    try Value k = part.root().get("k") else:
        return false
    ok = #expect(k.len() == 2, "the part holds k's two") && ok
    return ok

// `text` parses and writes back, compact, as `want`.
private bool back(string8 text, string8 want):
    try Document doc = parse_text(text) else code:
        return #expect(false, text, ": ", message(code))
    defer doc.destroy()
    Writer w = writer()
    w.value(doc.root())
    try ref []char8 out = w.finish() else code:
        return #expect(false, text, ": writing failed: ", message(code))
    defer #delete(out)
    string8 got = out
    return #expect(got == want, text, ": wrote ", got, ", not ", want)

private bool round_trips():
    bool ok = true
    ok = back("{\"a\":[1,2.5,\"x\\n\",true,null,{}],\"b\":-7}", "{\"a\":[1,2.5,\"x\\n\",true,null,{}],\"b\":-7}") && ok
    ok = back(" [ 1 , 2 ] ", "[1,2]") && ok
    ok = back("\"\\u00e9\\u2028\\ud83d\\ude00\\/\"", "\"\xC3\xA9\\u2028\xF0\x9F\x98\x80/\"") && ok
    ok = back("[1E2, 0.10, -0, 1e-7]", "[100.0,0.1,0,1e-07]") && ok
    ok = back("[18446744073709551615, -9223372036854775808]", "[18446744073709551615,-9223372036854775808]") && ok
    ok = back("[[[]],{\"\":{\"\":[]}}]", "[[[]],{\"\":{\"\":[]}}]") && ok
    // The RFC's examples survive a round trip through compact text: written
    // back and read again, they write the same.
    try Document doc = parse_text(IMAGE) else:
        return false
    Writer w = writer()
    w.value(doc.root())
    doc.destroy()
    try ref []char8 once = w.finish() else:
        return false
    defer #delete(once)
    ok = back(once, once) && ok
    return ok

private bool writer_to_reader():
    bool ok = true
    Writer w = writer()
    w.array()
    [200]f64 floats
    [200]i64 ints
    for i in 0..<200:
        Bits64 b = Bits64(next())
        f64 f = b.f
        if f != f || f - f != 0.0:
            f = f64(i)
        floats[i] = f
        ints[i] = i64(next())
        w.float(f)
        w.int(ints[i])
    w.text("tab\there \"quoted\" \xC3\xA9 \x7F")
    w.end_array()
    try ref []char8 text = w.finish() else code:
        return #expect(false, "writing: ", message(code))
    defer #delete(text)
    Reader r = reader_text(text)
    try r.array() else:
        return false
    for i in 0..<200:
        _ = r.more()
        try f64 f = r.float() else code:
            return #expect(false, "float ", i, ": ", message(code))
        Bits64 want = Bits64(floats[i])
        Bits64 got = Bits64(f)
        ok = #expect(got.u == want.u, "float ", i, " reads back as ", f, ", not ", floats[i]) && ok
        _ = r.more()
        try i64 v = r.int() else code:
            return #expect(false, "int ", i, ": ", message(code))
        ok = #expect(v == ints[i], "int ", i, " reads back as ", v) && ok
    _ = r.more()
    ref []char8 scratch
    defer #delete(scratch)
    try string8 s = r.text(&scratch) else code:
        return #expect(false, "text: ", message(code))
    ok = #expect(s == "tab\there \"quoted\" \xC3\xA9 \x7F", "the text reads back, got ", s) && ok
    ok = #expect(!r.more(), "the array ends") && ok
    try r.finish() else code:
        ok = #expect(false, "finish: ", message(code)) && ok
    return ok

i32 test():
    bool ok = rfc_examples()
    ok = lookups() && ok
    ok = round_trips() && ok
    ok = writer_to_reader() && ok
    return 0 if ok else 1
