// core:shader — what a compiled DadoGL shader looks like to the program that
// hands it to a graphics backend. **DadoGL is reserved and not built yet**:
// nothing produces a `Shader` today, and `#shader_load`,
// which will, is refused `ERR0001`. The trait and its shapes are declared
// whole now so that a backend written against them today does not change when
// DadoGL lands.
//
// **Outside the standard library's 1.0 promise until DadoGL is designed.**
// What a real producer needs of the trait (push constants, specialization
// constants, a compute stage's workgroup size, storage-texture formats) is not
// known yet, and adding a method to a trait breaks every implementer. So this
// package may change in any release until DadoGL ships; then it takes the
// promise the rest of `core:` carries.
//
//     import "core:shader"
//
//     void upload(shader.Shader s):
//         switch s.format():
//             case shader.Format.Wgsl:
//                 create_module(s.to_string())
//             case shader.Format.Spirv:
//                 create_module_spirv(s.to_bytes())
//             else:
//                 pass
//
// A shader carries its **interface** as well as its code — which entry points
// it has and in which stage, what it binds where, and what vertex input it
// reads — so a backend lays out its pipeline from these answers instead of
// parsing the shader again.
//
// **Tier N W H.** Declarations only, with no `foreign` block and no state:
// the package builds freestanding (`#NONE`), on the web and hosted, Windows
// included, and any thread may use it. Which formats a backend can use is
// the backend's question, not this package's.
//
// **What raises into a script.** `is_text`, promised by the `#assert_raises`
// above it. The rest is types and a trait, which declare no body to promise;
// a `Shader`'s methods are its implementer's, and raise or not as that
// implementer's code does.
package shader

// The closed set of formats a shader is compiled to, one per `--shader=`
// value. The first five are text; the last three are bytes.
//
//     Wgsl      WebGPU
//     Glsl      desktop OpenGL
//     Essl      OpenGL ES and WebGL2 (GLSL ES)
//     Hlsl      Direct3D, as source
//     Msl       Metal, as source
//     Spirv     Vulkan, and OpenGL 4.6 through GL_ARB_gl_spirv
//     Dxil      Direct3D 12
//     Metallib  Metal, compiled
enum Format: (Wgsl, Glsl, Essl, Hlsl, Msl, Spirv, Dxil, Metallib)

// Whether `f` is a text format, answered by `to_string`, rather than a binary
// one, answered by `to_bytes`.
// Every member is named, so a format added to `Format` is a decision made
// here, not a fall-through.
#assert_raises
bool is_text(Format f):
    switch f:
        case Format.Wgsl, Format.Glsl, Format.Essl, Format.Hlsl, Format.Msl:
            return true
        case Format.Spirv, Format.Dxil, Format.Metallib:
            return false
        else:
            return false

// The pipeline stage an entry point runs in.
enum Stage: (Vertex, Fragment, Compute)

// One entry point: its name in the compiled code, and its stage.
type EntryPoint: (string8 name, Stage stage)

// What a binding slot holds.
enum BindingKind: (UniformBuffer, StorageBuffer, ReadOnlyStorageBuffer, Sampler, ComparisonSampler, SampledTexture, StorageTexture)

// One resource binding: the group (WebGPU; a descriptor set in Vulkan, a
// register space in Direct3D), the slot within it, what it holds, and its
// name in the source.
type Binding: (u32 group, u32 slot, BindingKind kind, string8 name)

// The type of one vertex attribute as the vertex buffer holds it.
enum VertexFormat: (F32, F32x2, F32x3, F32x4, I32, I32x2, I32x3, I32x4, U32, U32x2, U32x3, U32x4, U8x4Norm, I8x4Norm, U16x2Norm, U16x4Norm, F16x2, F16x4)

// One vertex attribute: the shader's input location, the vertex buffer it is
// read from, its byte offset in that buffer's element, and its format.
type VertexAttribute: (u32 location, u32 buffer, u64 offset, VertexFormat format)

// One vertex buffer: its slot, the bytes from one element to the next, and
// whether it advances per instance rather than per vertex.
type VertexBuffer: (u32 slot, u64 stride, bool per_instance)

// A compiled shader, as `#shader_load` will answer one.
//
// `to_string` answers the code of a text format and `to_bytes` the code of a
// binary one; `format` says which this is, so a backend asks the right one.
// Each of the four reflection queries answers a table the compiler wrote,
// which lives as long as the program.
trait Shader:
    string8 to_string(self)
    []u8 to_bytes(self)
    Format format(self)
    []EntryPoint entry_points(self)
    []Binding bindings(self)
    []VertexAttribute vertex_attributes(self)
    []VertexBuffer vertex_buffers(self)
