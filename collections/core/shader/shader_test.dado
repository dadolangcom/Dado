@test
// A graphics backend written against `Shader` today (row H14). DadoGL is
// reserved and unbuilt, so nothing the compiler makes is a `Shader` yet; a
// backend takes one anyway — as a template over any `Shader`, and as trait
// values held in its pipeline — and is exercised here with hand-written
// implementers, which is what a test double for a DadoGL shader looks like.
package shader

// A backend's two entry doors: a template over any `Shader`...
private i64 upload(Shader s):
    if is_text(s.format()):
        string8 text = s.to_string()
        return #len(text)
    []u8 code = s.to_bytes()
    return #len(code)

// ...and trait values, held where the pipeline keeps them.
private type Pipeline: (Shader vertex, Shader fragment, u32 id)

private i64 build(^Pipeline p):
    i64 n = 0
    for e in p.vertex.entry_points():
        n += #len(e.name)
    for b in p.fragment.bindings():
        n += i64(b.group) * 10 + i64(b.slot)
    for a in p.vertex.vertex_attributes():
        n += i64(a.location) + i64(a.offset)
    []VertexBuffer buffers = p.vertex.vertex_buffers()
    for vb in buffers:
        n += i64(vb.stride)
    return n

private [2]EntryPoint entries = [("vs_main", Stage.Vertex), ("fs_main", Stage.Fragment)]
private [2]Binding binds = [(0, 1, BindingKind.UniformBuffer, "camera"), (1, 0, BindingKind.SampledTexture, "albedo")]
private [2]VertexAttribute attrs = [(0, 0, 0, VertexFormat.F32x3), (1, 0, 12, VertexFormat.F32x2)]
private [2]VertexBuffer vbufs = [(0, 20, false), (1, 64, true)]
private [4]u8 words = [3, 2, 35, 7]

// A stand-in for what `#shader_load` will answer: WGSL text and its tables.
private type FakeWgsl using Shader:
    i32 tag
    string8 to_string(self):
        return "@vertex fn vs_main() {}"
    []u8 to_bytes(self):
        return words[0..<0]
    Format format(self):
        return Format.Wgsl
    []EntryPoint entry_points(self):
        return entries[:]
    []Binding bindings(self):
        return binds[:]
    []VertexAttribute vertex_attributes(self):
        return attrs[:]
    []VertexBuffer vertex_buffers(self):
        return vbufs[:]

// And a binary one, SPIR-V's magic number's first bytes.
private type FakeSpirv using Shader:
    i32 tag
    string8 to_string(self):
        return ""
    []u8 to_bytes(self):
        return words[:]
    Format format(self):
        return Format.Spirv
    []EntryPoint entry_points(self):
        return entries[0..<0]
    []Binding bindings(self):
        return binds[0..<1]
    []VertexAttribute vertex_attributes(self):
        return attrs[0..<0]
    []VertexBuffer vertex_buffers(self):
        return vbufs[0..<0]

i32 test():
    FakeWgsl w = (1)
    FakeSpirv v = (2)
    Pipeline p = (w, v, 7)
    bool ok = #expect(upload(w) == 23, "the WGSL text is ", upload(w), " bytes")
    ok = #expect(upload(v) == 4, "the SPIR-V code is ", upload(v), " bytes") && ok
    ok = #expect(build(&p) == 112, "the pipeline read ", build(&p), " from the reflection tables") && ok
    ok = #expect(is_text(Format.Msl) && !is_text(Format.Spirv) && !is_text(Format.Metallib), "is_text split the formats wrongly") && ok
    return 0 if ok else 1
