@test
// The later additions: the stable sort, against an order it must keep at
// every size from empty past several merge rounds; the ordered verbs over
// types `scalar` did not admit, and `min`/`max` failing on an empty run; the
// run searches; `clone`, on another allocator and a refusing one; and the chunk
// and window walks.
//
// **The stable sort is checked three ways.** Sorted by key, the same
// multiset (each record's sequence number appears once), and equal keys
// still in sequence order — the last is what a stable sort promises and an
// unstable one breaks, and keys drawn from seven values make every run full
// of ties.
package slices

import "core:mem/libc"

// An allocator that refuses everything.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

type Rec:
    i32 key
    i32 seq

private bool key_less(Rec a, Rec b):
    return a.key < b.key

private bool i32_lt(i32 a, i32 b):
    return a < b

private [600]Rec recs
private [600]bool seen

private bool stable_at(i64 n, u32 seed):
    u32 r = seed
    for i in i64(0)..<n:
        r = r * 1664525 + 1013904223
        recs[i] = (i32((r >> 16) % 7), i32(i))
        seen[i] = false
    []Rec xs = recs[0..<n]
    sort_stable(xs, key_less)
    bool ok = true
    for i in i64(0)..<n:
        Rec x = xs[i]
        if x.seq < 0 || i64(x.seq) >= n || seen[x.seq]:
            return #expect(false, "n=", n, ": record ", x.seq, " lost or doubled")
        seen[x.seq] = true
        if i > 0:
            Rec p = xs[i - 1]
            if x.key < p.key:
                return #expect(false, "n=", n, ": not sorted at ", i)
            if x.key == p.key && x.seq < p.seq:
                return #expect(false, "n=", n, ": equal keys reordered at ", i)
    return ok

private [9]i32 HAY = [1, 2, 3, 1, 2, 3, 4, 1, 2]
private [2]i32 N12 = [1, 2]
private [3]i32 N234 = [2, 3, 4]
private [2]i32 N99 = [9, 9]

i32 test():
    bool ok = true

    // ── sort_stable ───────────────────────────────────────────────────────
    for n in i64(0)..<70:
        ok = stable_at(n, u32(n) + 1) && ok
    ok = stable_at(199, 7) && ok
    ok = stable_at(600, 11) && ok
    [6]i32 plain = [5, 1, 4, 1, 3, 9]
    sort_stable(plain[:], i32_lt)
    ok = #expect(is_sorted_ascending(plain[:]), "sort_stable over i32") && ok

    // ── ordered types without a comparator ────────────────────────────────
    [5]char8 cs = ['d', 'a', 'c', 'e', 'b']
    char8 lo = ' '
    char8 hi = ' '
    try lo = min(cs[:]) else:
        ok = #expect(false, "min of five refused") && ok
    try hi = max(cs[:]) else:
        ok = #expect(false, "max of five refused") && ok
    ok = #expect(lo == 'a' && hi == 'e', "min/max over char8") && ok
    sort_ascending(cs[:])
    ok = #expect(is_sorted_ascending(cs[:]) && cs[0] == 'a' && cs[4] == 'e', "sort_ascending over char8") && ok
    (i64 at, bool found) = find_sorted(cs[:], 'c')
    ok = #expect(found && at == 2, "find_sorted over char8") && ok
    []f64 nothing
    i32 why = 0
    try _ = min(nothing) else code:
        why = i32(code)
    ok = #expect(why == i32(Error.EMPTY), "min of an empty run answered ", why) && ok
    why = 0
    try _ = max(nothing) else code:
        why = i32(code)
    ok = #expect(why == i32(Error.EMPTY), "max of an empty run answered ", why) && ok
    ok = #expect(message(Error.EMPTY) == "the run is empty", "message(EMPTY)") && ok
    [4]f64 fs = [2.5, -1.0, 7.0, 0.0]
    f64 fmax = 0.0
    try fmax = max(fs[:]) else:
        ok = #expect(false, "max of four refused") && ok
    ok = #expect(fmax == 7.0, "max over f64") && ok
    // The first of several equal: a tie is still an answer, not a failure.
    [3]i64 tied = [4, 4, 4]
    i64 t = 0
    try t = min(tied[:]) else:
        ok = #expect(false, "min of a tie refused") && ok
    ok = #expect(t == 4, "min of a tie") && ok
    ok = #expect(!is_sorted_ascending(fs[:]), "unsorted f64 called sorted") && ok

    // ── run searches ──────────────────────────────────────────────────────
    ok = #expect(index_of_run(HAY[:], N12[:]) == 0, "index_of_run [1 2]") && ok
    ok = #expect(last_index_of_run(HAY[:], N12[:]) == 7, "last_index_of_run [1 2]") && ok
    ok = #expect(index_of_run(HAY[:], N234[:]) == 4, "index_of_run [2 3 4]") && ok
    ok = #expect(index_of_run(HAY[:], N99[:]) == 0 - 1, "index_of_run absent") && ok
    ok = #expect(!contains_run(HAY[:], N99[:]) && contains_run(HAY[:], N234[:]), "contains_run") && ok
    ok = #expect(index_of_run(HAY[:], HAY[0..<0]) == 0, "empty needle first") && ok
    ok = #expect(last_index_of_run(HAY[:], HAY[0..<0]) == 9, "empty needle last") && ok
    ok = #expect(index_of_run(N12[:], HAY[:]) == 0 - 1, "needle longer than haystack") && ok
    ok = #expect(ends_with(HAY[:], N12[:]) && !ends_with(HAY[:], N234[:]), "ends_with") && ok
    ok = #expect(ends_with(HAY[:], HAY[0..<0]) && !ends_with(N12[:], HAY[:]), "ends_with edges") && ok

    // ── clone ─────────────────────────────────────────────────────────────
    ref []i32 c = clone(HAY[:])
    ok = #expect(c != nil && equal(c[:], HAY[:]), "clone") && ok
    if c != nil:
        c[0] = 42
        ok = #expect(HAY[0] == 1, "clone shares its source") && ok
    #delete(c)
    // On another allocator, by `using`: a refusing one answers `nil`.
    ref []i32 d = clone(N234[:]) using libc.allocator()
    ok = #expect(d != nil && equal(d[:], N234[:]), "clone under using") && ok
    #delete(d)
    ref []i32 starved = clone(N234[:]) using (refuses, nil)
    ok = #expect(starved == nil, "clone on a refusing allocator answered a run") && ok

    // ── chunks and windows ────────────────────────────────────────────────
    ok = #expect(chunk_count(HAY[:], 4) == 3 && chunk_count(HAY[:], 9) == 1 && chunk_count(HAY[:], 0) == 0, "chunk_count") && ok
    ok = #expect(chunk_count(HAY[0..<0], 3) == 0, "chunk_count of empty") && ok
    i64 covered = 0
    for i in i64(0)..<chunk_count(HAY[:], 4):
        []i32 piece = chunk(HAY[:], 4, i)
        ok = #expect(equal(piece, HAY[i * 4..<i * 4 + #len(piece)]), "chunk ", i) && ok
        covered = covered + #len(piece)
    []i32 last_piece = chunk(HAY[:], 4, 2)
    ok = #expect(covered == 9 && #len(last_piece) == 1, "chunks cover the run") && ok
    []i32 past = chunk(HAY[:], 4, 3)
    []i32 before = chunk(HAY[:], 4, 0 - 1)
    ok = #expect(#len(past) == 0 && #len(before) == 0, "chunk out of range") && ok
    ok = #expect(window_count(HAY[:], 3) == 7 && window_count(HAY[:], 10) == 0 && window_count(HAY[:], 0) == 0, "window_count") && ok
    ok = #expect(equal(window(HAY[:], 3, 4), N234[:]) || equal(window(HAY[:], 3, 4), HAY[4..<7]), "window") && ok
    []i32 w7 = window(HAY[:], 3, 7)
    []i32 w6 = window(HAY[:], 3, 6)
    ok = #expect(#len(w7) == 0 && #len(w6) == 3, "window out of range") && ok
    return 0 if ok else 1
