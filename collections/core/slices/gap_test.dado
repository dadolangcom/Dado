@test
// The gap buffer, checked two ways.
//
// **Against a shadow.** A plain run edited by naive shifting is obviously right
// and slow; the gap buffer is supposed to be the same thing, fast. Two random
// churns of 100 000 operations each — inserts, removes, sets, gets and bare gap
// moves at random positions — are run on both and compared, element by element,
// every 1 000 operations and at the end. One churn is over a two-field record
// and one over a plain `i64`, so a `T` wider than a word and one that is not are
// both exercised.
//
// **Against derived numbers.** The byte counters are the reason the container
// exists, so they are asserted exactly: each expected figure below is worked
// out beside it from the gap's position and `#size(T)`, never read back from a
// run and pasted in.
package slices

// Two slots of different meaning, the way an editor's line record is: an
// identity and a measurement.
private type GapLine: (i64 id, i64 width)

// A xorshift64 stream: deterministic, so a failure reproduces.
private u64 gap_next(^u64 state):
    u64 s = state^
    s = s ~ (s << 13)
    s = s ~ (s >> 7)
    s = s ~ (s << 17)
    state^ = s
    return s

// A value in `0 ..< bound`, for `bound > 0`.
private i64 gap_below(^u64 state, i64 bound):
    return i64(gap_next(state) % u64(bound))

private GapLine line_of(i64 k):
    return (k, k * 3 + 1)

private i64 int_of(i64 k):
    return k * 7 - 5

// The shadow's capacity. The churn keeps the length under it by removing
// whenever it gets close, so the shadow never needs to grow.
private const i64 SHADOW = 2048

// Whether the gap buffer holds exactly `shadow[0 ..< n]`.
private bool gap_same(^Gap($T) g, []T shadow, i64 n, string8 label) where #has_eq(T):
    if !#expect(g.len() == n, label, ": length ", g.len(), ", shadow ", n):
        return false
    for i in i64(0)..<n:
        try T v = g.get(i) else:
            return #expect(false, label, ": element ", i, " refused")
        if !#expect(v == shadow[i], label, ": element ", i, " differs"):
            return false
    return true

// `ops` random edits applied to both, compared as it goes.
private bool gap_churn(^Gap($T) g, T(i64) value_of, u64 seed, i64 ops, string8 label) where #has_eq(T):
    ref []T shadow = #make([]T, SHADOW, #heap)
    i64 n = 0
    u64 state = seed
    bool ok = true
    for op in i64(0)..<ops:
        i64 kind = gap_below(&state, 10)
        if n > SHADOW - 16:
            kind = 4
        if kind <= 3:
            // insert 1..4 at a position in 0 ..= n, then fill them
            i64 at = gap_below(&state, n + 1)
            i64 m = 1 + gap_below(&state, 4)
            try g.insert(at, m) else:
                ok = #expect(false, label, ": insert refused at op ", op)
            i64 k = n - 1
            for k >= at:
                shadow[k + m] = shadow[k]
                k = k - 1
            for j in i64(0)..<m:
                T v = value_of(op * 4 + j)
                shadow[at + j] = v
                try g.set(at + j, v) else:
                    ok = #expect(false, label, ": set refused at op ", op)
            n = n + m
        else if kind <= 6 && n > 0:
            // remove 1..4, clipped to what exists after `at`
            i64 at = gap_below(&state, n)
            i64 m = 1 + gap_below(&state, 4)
            if m > n - at:
                m = n - at
            try g.remove(at, m) else:
                ok = #expect(false, label, ": remove refused at op ", op)
            for k in at..<(n - m):
                shadow[k] = shadow[k + m]
            n = n - m
        else if kind == 7 && n > 0:
            i64 at = gap_below(&state, n)
            T v = value_of(op)
            shadow[at] = v
            try g.set(at, v) else:
                ok = #expect(false, label, ": set refused at op ", op)
        else if kind == 8 && n > 0:
            i64 at = gap_below(&state, n)
            try T v = g.get(at) else:
                return #expect(false, label, ": get refused at op ", op)
            ok = #expect(v == shadow[at], label, ": get at op ", op) && ok
        else:
            g.move(gap_below(&state, n + 1))
        if op % 1000 == 999:
            ok = gap_same(g, shadow[:], n, label) && ok
            if !ok:
                #delete(shadow)
                return false
    ok = gap_same(g, shadow[:], n, label) && ok
    #delete(shadow)
    return ok

// An allocator that refuses everything, so every growth fails `NO_MEMORY`.
private rawptr gap_refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

// The code each edit failed with, or 0 when it succeeded, so one line can ask
// both that an edit was refused and why.
private i32 insert_code(^Gap($T) g, i64 at, i64 n):
    try g.insert(at, n) else why:
        return i32(why)
    return 0

private i32 remove_code(^Gap($T) g, i64 at, i64 n):
    try g.remove(at, n) else why:
        return i32(why)
    return 0

private i32 set_code(^Gap($T) g, i64 i, T v):
    try g.set(i, v) else why:
        return i32(why)
    return 0

private i32 push_code(^Gap($T) g, T v):
    try g.push(v) else why:
        return i32(why)
    return 0

private i32 init_code(^Gap($T) g, i64 cap):
    try g.init(cap) else why:
        return i32(why)
    return 0

private i32 get_code(^Gap($T) g, i64 i):
    try _ = g.get(i) else why:
        return i32(why)
    return 0

private const i32 OK = 0
private const i32 RANGE = 2301
private const i32 NO_ALLOC = 2302
private const i32 NO_MEM = 2303

i32 test():
    bool ok = true
    u64 word = u64(#size(i64))
    u64 wide = u64(#size(GapLine))
    ok = #expect(RANGE == i32(Error.OUT_OF_RANGE) && NO_ALLOC == i32(Error.NO_ALLOCATOR) && NO_MEM == i32(Error.NO_MEMORY), "the codes moved") && ok

    // ── the shadow churns ────────────────────────────────────────────────────
    Gap(GapLine) lines
    ok = #expect(init_code(&lines, 4) == OK, "init lines") && ok
    ok = gap_churn(&lines, line_of, 88172645463325252, 100000, "line churn") && ok
    lines.destroy()

    Gap(i64) ints
    ok = #expect(init_code(&ints, 0) == OK, "init ints") && ok
    ok = gap_churn(&ints, int_of, 2463534242, 100000, "int churn") && ok
    ints.destroy()

    // ── inserting at the front, the back and the middle ─────────────────────
    Gap(i64) g
    ok = #expect(init_code(&g, 16) == OK, "init 16") && ok
    for i in i64(0)..<10:
        ok = #expect(push_code(&g, i) == OK, "push ", i) && ok
    // Each push inserts at the length, which is where the previous one left the
    // gap: ten inserts, nothing crosses it.
    ok = #expect(g.bytes_moved() == 0, "pushes moved ", g.bytes_moved()) && ok

    // Insert at 3 from a gap at 10: the seven elements 3..9 cross it.
    ok = #expect(insert_code(&g, 3, 2) == OK, "insert 3") && ok
    ok = #expect(g.shifted == 7 * word, "insert at 3 shifted ", g.shifted) && ok
    // At 5, which is where that insert left the gap: free.
    ok = #expect(insert_code(&g, 5, 1) == OK, "insert 5") && ok
    ok = #expect(g.shifted == 7 * word, "insert at 5 shifted ", g.shifted) && ok
    // Contents: 0 1 2 _ _ _ 3 4 5 6 7 8 9, the three new ones zero.
    [13]i64 mid = [0, 1, 2, 0, 0, 0, 3, 4, 5, 6, 7, 8, 9]
    ok = gap_same(&g, mid[:], 13, "middle") && ok

    // At 0: the gap is at 6, so elements 0..5 cross it — six more.
    ok = #expect(insert_code(&g, 0, 1) == OK, "insert 0") && ok
    ok = #expect(g.shifted == 13 * word, "insert at 0 shifted ", g.shifted) && ok
    // At the end, 14, from a gap at 1: the thirteen after it cross.
    ok = #expect(insert_code(&g, 14, 1) == OK, "insert end") && ok
    ok = #expect(g.shifted == 26 * word, "insert at end shifted ", g.shifted) && ok
    ok = #expect(g.len() == 15 && g.cap() == 16, "len ", g.len(), " cap ", g.cap()) && ok
    [15]i64 ends = [0, 0, 1, 2, 0, 0, 0, 3, 4, 5, 6, 7, 8, 9, 0]
    ok = gap_same(&g, ends[:], 15, "ends") && ok

    // An explicit move is exactly distance · size, in either direction.
    g.move(4)
    ok = #expect(g.shifted == 37 * word, "move to 4 shifted ", g.shifted) && ok
    g.move(12)
    ok = #expect(g.shifted == 45 * word, "move to 12 shifted ", g.shifted) && ok
    g.move(12)
    ok = #expect(g.shifted == 45 * word, "move in place shifted ", g.shifted) && ok
    // Clamped, not refused: -5 is 0 (twelve cross) and 99 is 15 (fifteen).
    g.move(0 - 5)
    ok = #expect(g.start == 0 && g.shifted == 57 * word, "clamp low ", g.start) && ok
    g.move(99)
    ok = #expect(g.start == 15 && g.shifted == 72 * word, "clamp high ", g.start) && ok
    ok = gap_same(&g, ends[:], 15, "after moves") && ok

    // ── growth ───────────────────────────────────────────────────────────────
    // Fifteen in sixteen; five more at 7 do not fit, so the block doubles to 32
    // and all fifteen are copied once — and none of them is counted as motion,
    // though the gap was at 15 and the insert at 7.
    ok = #expect(insert_code(&g, 7, 5) == OK, "insert past capacity") && ok
    ok = #expect(g.cap() == 32, "grew to ", g.cap()) && ok
    ok = #expect(g.grown == 15 * word, "growth copied ", g.grown) && ok
    ok = #expect(g.shifted == 72 * word, "growth shifted ", g.shifted) && ok
    ok = #expect(g.start == 12, "gap left at ", g.start) && ok
    [20]i64 grown = [0, 0, 1, 2, 0, 0, 0, 0, 0, 0, 0, 0, 3, 4, 5, 6, 7, 8, 9, 0]
    ok = gap_same(&g, grown[:], 20, "grown") && ok

    // ── removing across the gap ──────────────────────────────────────────────
    ok = #expect(set_code(&g, 0, 100) == OK && set_code(&g, 13, 104) == OK, "sets") && ok
    g.move(10)
    u64 before = g.shifted
    // `[8, 14)` straddles the gap at 10. The gap moves back to 8 (two elements)
    // and widens by six.
    ok = #expect(remove_code(&g, 8, 6) == OK, "remove across") && ok
    ok = #expect(g.shifted - before == 2 * word, "remove shifted ", g.shifted - before) && ok
    [14]i64 cut = [100, 0, 1, 2, 0, 0, 0, 0, 5, 6, 7, 8, 9, 0]
    ok = gap_same(&g, cut[:], 14, "removed") && ok
    // Removing again at the same place is free: the gap is already there.
    before = g.shifted
    ok = #expect(remove_code(&g, 8, 1) == OK, "remove again") && ok
    ok = #expect(g.shifted == before, "second remove shifted ", g.shifted - before) && ok

    // ── out of range, refused or clamped, never aborting ─────────────────────
    i64 count = g.len()
    ok = #expect(get_code(&g, 0 - 1) == RANGE && get_code(&g, count) == RANGE, "get out of range answered") && ok
    ok = #expect(set_code(&g, count, 1) == RANGE && set_code(&g, 0 - 1, 1) == RANGE, "set out of range accepted") && ok
    ok = #expect(g.at(count) == nil && g.at(0 - 1) == nil, "at out of range") && ok
    ok = #expect(insert_code(&g, count + 1, 1) == RANGE && insert_code(&g, 0 - 1, 1) == RANGE, "insert out of range") && ok
    ok = #expect(insert_code(&g, 0, 0 - 1) == RANGE, "negative insert") && ok
    ok = #expect(remove_code(&g, count - 1, 2) == RANGE && remove_code(&g, 0 - 1, 1) == RANGE, "remove out of range") && ok
    ok = #expect(remove_code(&g, 0, 0 - 1) == RANGE, "negative remove") && ok
    ok = #expect(insert_code(&g, count, 0) == OK && remove_code(&g, count, 0) == OK, "empty edits at the end") && ok
    ok = #expect(g.len() == count, "a refusal changed the length") && ok
    g.destroy()

    // ── a zero-capacity start, and the zero value ────────────────────────────
    Gap(i64) z
    ok = #expect(init_code(&z, 0) == OK, "init 0") && ok
    ok = #expect(z.cap() == 0 && z.len() == 0, "zero start holds ", z.cap()) && ok
    // The first push grows to the floor of 8 and copies nothing; the ninth
    // doubles to 16 and copies the eight.
    for i in i64(0)..<9:
        ok = #expect(push_code(&z, i) == OK, "zero push ", i) && ok
    ok = #expect(z.cap() == 16 && z.grown == 8 * word, "zero start grew ", z.grown) && ok
    ok = #expect(z.shifted == 0, "zero start shifted ", z.shifted) && ok
    [9]i64 nine = [0, 1, 2, 3, 4, 5, 6, 7, 8]
    ok = gap_same(&z, nine[:], 9, "zero start") && ok
    z.clear()
    ok = #expect(z.len() == 0 && z.cap() == 16, "clear kept the block") && ok
    z.destroy()
    ok = #expect(init_code(&z, 0 - 1) == RANGE, "negative capacity") && ok

    // Never `init`ed: nothing to grow from, told apart from out of memory.
    Gap(i64) none
    ok = #expect(push_code(&none, 1) == NO_ALLOC, "the zero value has no allocator to grow from") && ok
    ok = #expect(none.len() == 0, "zero value length") && ok
    none.destroy()

    // ── on a refusing allocator, under `using` ───────────────────────────────
    // `init` keeps the allocator in force where it was called, so the block it
    // asks for, and every later growth outside the `using`, fail `NO_MEMORY` —
    // and the gap stays empty and usable.
    Gap(i64) starved
    i32 refused = init_code(&starved, 4) using (gap_refuses, nil)
    ok = #expect(refused == NO_MEM, "init on a refusing allocator") && ok
    ok = #expect(starved.len() == 0 && starved.cap() == 0, "a refused init left ", starved.cap()) && ok
    ok = #expect(push_code(&starved, 1) == NO_MEM, "growth outside the `using` asked another allocator") && ok
    ok = #expect(insert_code(&starved, 0, 3) == NO_MEM && starved.len() == 0, "a refused insert changed the gap") && ok
    starved.destroy()
    // A zero start allocates nothing, so it succeeds; the first growth fails.
    Gap(i64) later
    i32 empty = init_code(&later, 0) using (gap_refuses, nil)
    ok = #expect(empty == OK, "zero init on a refusing allocator") && ok
    ok = #expect(push_code(&later, 1) == NO_MEM, "first growth on a refusing allocator") && ok
    later.destroy()

    // ── a record, changed in place ───────────────────────────────────────────
    Gap(GapLine) doc
    ok = #expect(init_code(&doc, 2) == OK, "init doc") && ok
    for i in i64(0)..<5:
        ok = #expect(push_code(&doc, line_of(i)) == OK, "doc push ", i) && ok
    // Cap 2, then 8 when the third push found no room, copying two lines.
    ok = #expect(doc.grown == 2 * wide, "doc grew ", doc.grown) && ok
    ^GapLine p = doc.at(3)
    p.width = 999
    GapLine third
    try third = doc.get(3) else:
        ok = #expect(false, "get(3) refused")
    ok = #expect(third.id == 3 && third.width == 999, "in place gave ", third) && ok
    // An Enter at line 1, then another below it. The gap was at 5, so lines
    // 1..4 cross for the first — four lines — and none cross for the second,
    // which is where the first left the gap.
    ok = #expect(insert_code(&doc, 1, 1) == OK, "enter 1") && ok
    ok = #expect(doc.shifted == 4 * wide, "enter shifted ", doc.shifted) && ok
    ok = #expect(insert_code(&doc, 2, 1) == OK, "enter 2") && ok
    ok = #expect(doc.shifted == 4 * wide, "second enter shifted ", doc.shifted) && ok
    doc.destroy()

    // ── messages ─────────────────────────────────────────────────────────────
    string8 range_text = message(Error.OUT_OF_RANGE)
    string8 alloc_text = message(Error.NO_ALLOCATOR)
    ok = #expect(#len(range_text) > 0 && #len(alloc_text) > 0, "messages") && ok
    ok = #expect(message(Error.NO_MEMORY) != alloc_text, "two failures, one message") && ok

    if ok:
        return 0
    return 1
