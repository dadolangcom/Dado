// core:slices, the gap buffer — a growable run of anything whose inserts and
// removes cost the distance from the previous edit, not the distance to the end.
//
//     slices.Gap(Line) doc
//     try doc.init(1024) else why:            // on `#default`; `using` picks another
//         return why
//     try doc.insert(row, 1) else why:        // one zeroed Line at `row`
//         return why
//     doc.at(row).width = 0
//     try doc.remove(row, 1) else why:
//         return why
//     doc.destroy()
//
// A plain array pays for an insert near the front with every element after it.
// This one keeps an unused run — the gap — inside its block and parks it at the
// last edit, so a second edit nearby moves only what lies between the two, and
// an edit exactly where the last one was moves nothing at all.
//
// ## What every index means
//
// The **logical** index is the only one a caller sees: `0 ..< g.len()`, in
// order, with the gap invisible. Out-of-range indices are handled totally and
// never abort:
//
//   * everything that changes the contents **refuses** — `insert`, `remove`
//     and `set` fail `Error.OUT_OF_RANGE` and change nothing;
//   * everything that reads **refuses** too — `get` fails `OUT_OF_RANGE`,
//     `at` answers `nil`;
//   * `move` alone **clamps**, into `0 ..= g.len()`, because where the gap
//     sits is not something the contents can show — any position is a
//     correct one, and clamping is the nearest correct one.
//
// An edit that has to grow the block tells its two other failures apart:
// `NO_ALLOCATOR` for a `Gap` never `init`ed (the zero value has nothing to
// grow from), `NO_MEMORY` when the allocator refused.
//
// ## Elements are opaque
//
// Nothing here reads an element. It copies them, and a copy of a `ref` is the
// same `ref`, so a `T` owning memory is moved around as its handle and never
// duplicated or freed. **Freeing what an element owns is the caller's job, and
// it has to be done before `remove`**, which closes over the element and
// leaves nothing to reach it by.
//
// **Not promised to raise into a script.** A `Gap` holds the allocator it
// grows on, which is two addresses, and a script has none. A script that
// wants a growable run has its own arrays.
package slices

// The smallest block a growth produces. Doubling from a zero-capacity start
// would otherwise run 1, 2, 4, 8 and pay four copies for eight elements.
private const i64 GAP_FLOOR = 8

// A gap buffer of `T`. The block is `[0, #len(block))`; the gap is
// `[start, end)` inside it; the elements are everything else, in order.
//
//     block     the storage, gap included
//     alloc     where the block came from, and where a larger one comes from
//     start     the first slot of the gap, which is also the logical index the
//               gap sits in front of
//     end       one past the last slot of the gap
//     shifted   bytes copied by gap motion, since `init`
//     grown     bytes copied into a larger block, since `init`
//
// The two counters are the instrument: they say what the edits cost in bytes
// moved, which is the number this container exists to make small. They count
// **element** bytes only — `#size(T)` per element copied — and not the zeroing
// of freshly opened slots, which a plain array pays identically.
//
// **It keeps its allocator, and that is the justified exception to `using`.**
// `init` captures `#default` once and every later growth asks that one,
// because a gap outlives the `using` it was opened in (an editor's document
// lives for the session, its edits come one keystroke at a time) and a block
// has to grow on the allocator that made it. A caller who wants an arena
// writes `using a:` around `init`, and not around each edit. A larger block is
// a fresh `#make` and not a `#resize`: a `#resize` copies the whole block, gap
// and all, and the part after the gap would then have to be moved again to the
// new end. A fresh block lets each element be copied once, straight to where
// it belongs.
type Gap($T):
    ref []T block
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc
    i64 start
    i64 end
    u64 shifted
    u64 grown

    // ── making and ending ───────────────────────────────────────────────────

    // Keep `#default` as the gap's allocator and take a block of `cap`
    // elements from it, with the gap covering all of it. Fails
    // `OUT_OF_RANGE` for a negative `cap` and `NO_MEMORY` for a failed
    // allocation; after either the gap is empty, keeps the allocator and is
    // still usable — its first insert asks again. A zero `cap` succeeds and
    // allocates nothing.
    //
    // Whatever the gap held before is overwritten, not freed; `destroy` it
    // first.
    Error!void init(^self, i64 cap):
        self.alloc = #default
        self.block = nil
        self.start = 0
        self.end = 0
        self.shifted = 0
        self.grown = 0
        if cap < 0:
            fail Error.OUT_OF_RANGE
        if cap == 0:
            return
        ref []T block = #make([]T, cap, self.alloc)
        if block == nil:
            fail Error.NO_MEMORY
        self.block = block
        self.end = cap
        return

    // Return the block to its allocator. The gap is left empty with its
    // allocator and counters kept, so it may be inserted into again. Whatever
    // the elements own is the caller's to free first.
    void destroy(^self):
        #delete(self.block)
        self.block = nil
        self.start = 0
        self.end = 0
        return

    // Forget every element and keep the block. Nothing is copied and nothing
    // is zeroed; the next insert zeroes what it opens.
    void clear(^self):
        self.start = 0
        self.end = #len(self.block)
        return

    // ── measuring ───────────────────────────────────────────────────────────

    // How many elements there are.
    i64 len(^self):
        return #len(self.block) - (self.end - self.start)

    // How many the block holds before the next insert has to grow it.
    i64 cap(^self):
        return #len(self.block)

    // Every byte copied since `init`: gap motion plus growth. The two halves
    // are the `shifted` and `grown` slots.
    u64 bytes_moved(^self):
        return self.shifted + self.grown

    // ── reaching an element ─────────────────────────────────────────────────

    // Where logical index `i` lives in the block. `i` must already be in
    // range.
    private i64 slot(^self, i64 i):
        if i < self.start:
            return i
        return i + (self.end - self.start)

    // The element at `i`. Fails `OUT_OF_RANGE` when `i` is not in
    // `0 ..< g.len()`.
    Error!T get(^self, i64 i):
        if i < 0 || i >= self.len():
            fail Error.OUT_OF_RANGE
        return self.block[self.slot(i)]

    // Overwrite the element at `i`. Fails `OUT_OF_RANGE`, writing nothing,
    // when `i` is not in `0 ..< g.len()`.
    Error!void set(^self, i64 i, T v):
        if i < 0 || i >= self.len():
            fail Error.OUT_OF_RANGE
        self.block[self.slot(i)] = v
        return

    // A pointer to the element at `i`, for changing it in place, or `nil`
    // when `i` is out of range.
    //
    // **It is good until the next insert, remove, move or destroy** — any of
    // which may copy the element somewhere else or return its block — and
    // nothing checks that. Hold an index across an edit, never this.
    ^T at(^self, i64 i):
        if i < 0 || i >= self.len():
            return nil
        return &self.block[self.slot(i)]

    // ── editing ─────────────────────────────────────────────────────────────

    // Park the gap in front of logical index `to`, clamped into
    // `0 ..= g.len()`.
    //
    // Every element between the old position and the new one crosses the
    // gap, so the cost is exactly `|to - start| · #size(T)` bytes — never
    // more, whatever the length — and that is what `shifted` grows by.
    // Moving to where the gap already is costs nothing.
    void move(^self, i64 to):
        i64 dest = to
        i64 count = self.len()
        if dest < 0:
            dest = 0
        if dest > count:
            dest = count
        i64 start = self.start
        i64 end = self.end
        if dest < start:
            // `[dest, start)` moves up to `[end - d, end)`. The two runs
            // overlap when `d` exceeds the gap's width, and the destination
            // is the higher one, so the copy runs downwards.
            i64 d = start - dest
            i64 k = d - 1
            for k >= 0:
                self.block[#no_bounds end - d + k] = self.block[#no_bounds dest + k]
                k = k - 1
            self.start = dest
            self.end = end - d
            self.shifted = self.shifted + (u64(d) * u64(#size(T)))
        else if dest > start:
            // `[end, end + d)` moves down to `[start, start + d)`; the
            // destination is the lower run, so the copy runs upwards.
            i64 d = dest - start
            for k in i64(0)..<d:
                self.block[#no_bounds start + k] = self.block[#no_bounds end + k]
            self.start = dest
            self.end = end + d
            self.shifted = self.shifted + (u64(d) * u64(#size(T)))
        return

    // Open `n` zeroed elements at logical index `at`, so the first of them is
    // `at` and what was at `at` is now at `at + n`.
    //
    // Fails, changing nothing: `OUT_OF_RANGE` for `at` outside
    // `0 ..= g.len()` or a negative `n`; `NO_ALLOCATOR` when the block must
    // grow and the gap was never `init`ed; `NO_MEMORY` for a length that
    // would overflow or a failed allocation. `n == 0` succeeds and moves
    // nothing.
    //
    // When the gap is narrower than `n` the block is replaced by one of at
    // least twice the capacity (and at least `GAP_FLOOR`, and at least
    // enough), and the gap is built at `at` during that one copy — so growth
    // costs every element exactly once and no gap motion on top.
    Error!void insert(^self, i64 at, i64 n):
        i64 count = self.len()
        if at < 0 || at > count || n < 0:
            fail Error.OUT_OF_RANGE
        if n == 0:
            return
        if self.end - self.start < n:
            try self.grow(at, n)
        else:
            self.move(at)
        T zero
        i64 start = self.start
        for k in i64(0)..<n:
            self.block[#no_bounds start + k] = zero
        self.start = start + n
        return

    // Close `n` elements starting at logical index `at`.
    //
    // Fails `OUT_OF_RANGE` for `at < 0`, `n < 0`, or a run reaching past the
    // end — it is not clamped to what exists, because removing fewer elements
    // than were named is the silent kind of wrong. The closed elements are
    // not read, zeroed or freed.
    Error!void remove(^self, i64 at, i64 n):
        i64 count = self.len()
        if at < 0 || n < 0 || at > count || n > count - at:
            fail Error.OUT_OF_RANGE
        if n == 0:
            return
        self.move(at)
        self.end = self.end + n
        return

    // Put `v` on the end. Fails as `insert` does.
    Error!void push(^self, T v):
        i64 count = self.len()
        try self.insert(count, 1)
        self.block[self.slot(count)] = v
        return

    // Replace the block with a larger one and leave a gap of at least `n` at
    // `at`.
    //
    // The capacity doubles, which is what makes a run of pushes cost O(1)
    // copies per element amortized; `GAP_FLOOR` stops a zero start from
    // growing one slot at a time; and `count + n` covers an insert larger
    // than the doubling. The doubling is refused past `i64`'s half so it
    // cannot overflow.
    private Error!void grow(^self, i64 at, i64 n):
        if self.alloc.proc == nil:
            fail Error.NO_ALLOCATOR
        i64 cap = #len(self.block)
        i64 count = cap - (self.end - self.start)
        if cap > 4611686018427387903 || n > 4611686018427387903 - count:
            fail Error.NO_MEMORY
        i64 want = cap * 2
        if want < GAP_FLOOR:
            want = GAP_FLOOR
        if want < count + n:
            want = count + n
        ref []T fresh = #make([]T, want, self.alloc)
        if fresh == nil:
            fail Error.NO_MEMORY
        // Logical `[0, at)` goes to the front and logical `[at, count)` to
        // the back, each read from wherever the old gap left it.
        i64 tail = count - at
        i64 new_end = want - tail
        for i in i64(0)..<at:
            fresh[#no_bounds i] = self.block[#no_bounds self.slot(i)]
        for i in i64(0)..<tail:
            fresh[#no_bounds new_end + i] = self.block[#no_bounds self.slot(at + i)]
        #delete(self.block)
        self.block = fresh
        self.start = at
        self.end = new_end
        self.grown = self.grown + (u64(count) * u64(#size(T)))
        return
