@test
// Every public name in `core:slices`, and the three private algorithms the
// public sort dispatches between.
//
// **The private ones are called directly, and that is the point of a `@test`
// file being an ordinary member of its package.** `sort` picks insertion,
// quicksort or heapsort by size and recursion depth, and the heapsort arm is
// reached only when quicksort has gone deeper than `2·log2(n)` — which a
// median-of-three pivot makes hard to provoke and impossible to provoke
// *reliably*. A test that sorted a large adversarial array and hoped would be
// claiming coverage it could not demonstrate, so `heapsort` and `insertion` are
// each exercised as units, and `sort` is tested for what it promises rather
// than for which arm it took.
//
// **A sort is checked two ways, never one.** `is_sorted` alone passes for a
// function that fills the run with its smallest element, so every case below
// also checks that the multiset survived — the sum, and a count of a value that
// appears more than once. Order plus contents is what sorting means.
package slices

private bool i32_less(i32 a, i32 b):
    return a < b

private bool i32_greater(i32 a, i32 b):
    return a > b

private bool is_even(i32 n):
    return n % 2 == 0

private bool is_negative(i32 n):
    return n < 0

private i64 total([]i32 xs):
    i64 sum = 0
    i64 count = #len(xs)
    for i in i64(0)..<count:
        sum = sum + i64(xs[i])
    return sum

// Expected results, as storage rather than as `const`s. A literal has no place
// and so cannot be windowed — `REV5[:]` is ERR0606 — and a `const`
// has no storage to be a place of either, so the only spelling that can be
// compared against a slice is a name bound to a run.
private [5]i32 REV5 = [5, 4, 3, 2, 1]
private [4]i32 REV4 = [4, 3, 2, 1]
private [5]i32 ID5 = [1, 2, 3, 4, 5]
private [5]i32 ROT2 = [3, 4, 5, 1, 2]
private [4]i32 NINES = [9, 9, 9, 9]
private [2]i32 PRE2 = [4, 8]
private [2]i32 PRE2R = [8, 4]
private [3]i32 HAY3 = [4, 8, 99]
private [4]i32 UNIQ4 = [1, 2, 3, 1]
private [5]i32 DOWN5 = [5, 4, 3, 1, 1]
private [6]i32 UP6 = [1, 2, 3, 7, 8, 9]
private [6]i32 DOWN6 = [9, 8, 7, 3, 2, 1]
private [9]i32 SORT9 = [1, 2, 3, 4, 5, 6, 7, 8, 9]

i32 test():
    bool ok = true

    // ── swap, reverse, rotate ────────────────────────────────────────────────
    [4]i32 pair = [1, 2, 3, 4]
    swap(pair[:], 0, 3)
    ok = #expect(pair[0] == 4 && pair[3] == 1, "swap gave ", pair) && ok
    // Swapping a slot with itself is a real call and must not lose the value.
    swap(pair[:], 1, 1)
    ok = #expect(pair[1] == 2, "swap(i, i) lost the value: ", pair) && ok

    [5]i32 five = [1, 2, 3, 4, 5]
    reverse(five[:])
    ok = #expect(equal(five[:], REV5[:]), "reverse gave ", five) && ok
    // Even length, so the loop's midpoint case differs from the odd one above.
    [4]i32 four = [1, 2, 3, 4]
    reverse(four[:])
    ok = #expect(equal(four[:], REV4[:]), "reverse of an even run gave ", four) && ok
    // A run of one and a run of none: the loop is entered zero times.
    //
    // **The run of one is a window and not a `[1]i32`**, because `[1]T` *is*
    // `T` — a one-slot tuple is its element — so `[1]i32 one = [7]` declares an
    // `i32` and there is nothing there to slice.
    [2]i32 short_pair = [7, 7]
    reverse(short_pair[0..<1])
    ok = #expect(short_pair[0] == 7, "reverse of one element changed it") && ok
    reverse(five[0..<0])

    [5]i32 spun = [1, 2, 3, 4, 5]
    rotate(spun[:], 2)
    ok = #expect(equal(spun[:], ROT2[:]), "rotate(2) gave ", spun) && ok
    rotate(spun[:], 0 - 2)
    ok = #expect(equal(spun[:], ID5[:]), "rotate(-2) did not undo it: ", spun) && ok
    // Past the length, and exactly the length: both reduce to a rotation the
    // run can perform, and one of them to no rotation at all.
    rotate(spun[:], 7)
    ok = #expect(equal(spun[:], ROT2[:]), "rotate(7) of five gave ", spun) && ok
    rotate(spun[:], 5)
    ok = #expect(equal(spun[:], ROT2[:]), "rotate by the length moved something") && ok
    // The two early returns: a run too short to rotate.
    rotate(short_pair[0..<1], 1)
    ok = #expect(short_pair[0] == 7, "rotate of one element changed it") && ok

    // ── fill and copy_into ───────────────────────────────────────────────────
    [4]i32 filled
    fill(filled[:], 9)
    ok = #expect(equal(filled[:], NINES[:]), "fill gave ", filled) && ok

    [3]i32 src = [1, 2, 3]
    [5]i32 dst
    fill(dst[:], 0)
    i64 moved = copy_into(src[:], dst[:])
    ok = #expect(moved == 3, "copy_into moved ", moved) && ok
    ok = #expect(equal(dst[0..<3], src[:]), "copy_into wrote ", dst) && ok
    ok = #expect(dst[3] == 0 && dst[4] == 0, "copy_into wrote past the source") && ok
    // The short-destination arm: the count is the shorter of the two.
    [2]i32 cramped
    i64 clipped = copy_into(src[:], cramped[:])
    ok = #expect(clipped == 2, "copy_into into a shorter run moved ", clipped) && ok

    // ── equality ─────────────────────────────────────────────────────────────
    [6]i32 hay = [4, 8, 15, 8, 16, 23]
    ok = #expect(index_of(hay[:], 8) == 1, "index_of found ", index_of(hay[:], 8)) && ok
    ok = #expect(last_index_of(hay[:], 8) == 3, "last_index_of found ", last_index_of(hay[:], 8)) && ok
    ok = #expect(index_of(hay[:], 99) == 0 - 1, "index_of found a value that is not there") && ok
    ok = #expect(last_index_of(hay[:], 99) == 0 - 1, "last_index_of found a value that is not there") && ok
    ok = #expect(contains(hay[:], 23), "contains missed the last element") && ok
    ok = #expect(!contains(hay[:], 99), "contains found a value that is not there") && ok
    ok = #expect(count_of(hay[:], 8) == 2, "count_of said ", count_of(hay[:], 8)) && ok
    ok = #expect(count_of(hay[:], 99) == 0, "count_of found a value that is not there") && ok

    // A float run: `==` applies to `f32`, so the equality family serves one.
    // It is IEEE equality, so a NaN is in the run and is still never found.
    f32 zero = 0.0
    f32 nan = zero / zero
    [4]f32 weights = [0.5, 1.5, nan, 2.5]
    ok = #expect(contains(weights[:], 1.5), "contains missed a float that is there") && ok
    ok = #expect(!contains(weights[:], 3.5), "contains found a float that is not there") && ok
    ok = #expect(index_of(weights[:], 2.5) == 3, "index_of over floats found ", index_of(weights[:], 2.5)) && ok
    ok = #expect(!contains(weights[:], nan), "contains found a NaN, which equals nothing") && ok

    ok = #expect(equal(hay[:], hay[:]), "a run did not equal itself") && ok
    ok = #expect(!equal(hay[:], hay[0..<5]), "runs of different lengths compared equal") && ok
    ok = #expect(!equal(hay[0..<3], HAY3[:]), "runs differing in the last slot compared equal") && ok
    ok = #expect(equal(hay[0..<0], hay[3..<3]), "two empty runs did not compare equal") && ok

    ok = #expect(starts_with(hay[:], PRE2[:]), "starts_with missed a real prefix") && ok
    ok = #expect(!starts_with(hay[:], PRE2R[:]), "starts_with matched the wrong order") && ok
    ok = #expect(starts_with(hay[:], hay[0..<0]), "the empty prefix did not match") && ok
    // A prefix longer than the run, which is the guard before the comparison.
    ok = #expect(!starts_with(hay[0..<2], hay[:]), "a prefix longer than the run matched") && ok

    // ── unique ───────────────────────────────────────────────────────────────
    [8]i32 dupes = [1, 1, 2, 2, 2, 3, 1, 1]
    i64 kept = unique(dupes[:])
    ok = #expect(kept == 4, "unique kept ", kept) && ok
    ok = #expect(equal(dupes[0..<kept], UNIQ4[:]), "unique gave ", dupes[0..<kept]) && ok
    // Adjacent and not global: the trailing 1 survives because it is not beside
    // the leading ones. That is the documented behaviour and the line that
    // notices if it ever quietly becomes a set.
    [3]i32 no_dupes = [1, 2, 3]
    ok = #expect(unique(no_dupes[:]) == 3, "unique dropped something from a run with no duplicates") && ok
    ok = #expect(unique(no_dupes[0..<1]) == 1, "unique of one element gave the wrong length") && ok
    ok = #expect(unique(no_dupes[0..<0]) == 0, "unique of an empty run gave the wrong length") && ok

    // ── predicates ───────────────────────────────────────────────────────────
    [4]i32 evens = [2, 4, 6, 8]
    [4]i32 mixed = [2, 3, 6, 8]
    [4]i32 odds = [1, 3, 5, 7]

    ok = #expect(all(evens[:], is_even), "all missed a run that is entirely even") && ok
    ok = #expect(!all(mixed[:], is_even), "all accepted a run with an odd in it") && ok
    ok = #expect(all(evens[0..<0], is_even), "all was false for an empty run") && ok

    ok = #expect(any(mixed[:], is_even), "any missed an even") && ok
    ok = #expect(!any(odds[:], is_even), "any found an even among odds") && ok
    ok = #expect(!any(evens[0..<0], is_even), "any was true for an empty run") && ok

    ok = #expect(none(odds[:], is_even), "none was false for a run with no evens") && ok
    ok = #expect(!none(mixed[:], is_even), "none was true for a run with an even") && ok

    ok = #expect(count_if(mixed[:], is_even) == 3, "count_if said ", count_if(mixed[:], is_even)) && ok
    ok = #expect(count_if(odds[:], is_even) == 0, "count_if counted an even among odds") && ok

    ok = #expect(find_if(mixed[:], is_even) == 0, "find_if found ", find_if(mixed[:], is_even)) && ok
    ok = #expect(find_if(odds[:], is_even) == 0 - 1, "find_if found an even among odds") && ok

    [6]i32 to_split = [1, 2, 3, 4, 5, 6]
    i64 front = partition(to_split[:], is_even)
    ok = #expect(front == 3, "partition put ", front, " elements in front") && ok
    ok = #expect(all(to_split[0..<front], is_even), "partition left an odd in front: ", to_split) && ok
    ok = #expect(none(to_split[front..<6], is_even), "partition left an even behind: ", to_split) && ok
    // Nothing satisfies, so the swap never runs and the answer is zero.
    ok = #expect(partition(odds[:], is_even) == 0, "partition moved something that does not satisfy") && ok
    // Everything satisfies, so the swap runs on every index including i == kept.
    ok = #expect(partition(evens[:], is_even) == 4, "partition left an even behind") && ok
    ok = #expect(partition(odds[:], is_negative) == 0, "partition found a negative among positives") && ok

    // ── min, max, is_sorted ──────────────────────────────────────────────────
    [5]i32 spread = [3, 1, 4, 1, 5]
    ok = #expect(min_index(spread[:], i32_less) == 1, "min_index gave ", min_index(spread[:], i32_less)) && ok
    ok = #expect(max_index(spread[:], i32_less) == 4, "max_index gave ", max_index(spread[:], i32_less)) && ok
    // The first of several equal minima, which is what makes the choice stable.
    ok = #expect(min_index(spread[:], i32_less) < 3, "min_index did not take the first of two equal minima") && ok
    ok = #expect(min_index(spread[0..<0], i32_less) == 0 - 1, "min_index of an empty run was not -1") && ok
    ok = #expect(max_index(spread[0..<0], i32_less) == 0 - 1, "max_index of an empty run was not -1") && ok

    [4]i32 rising = [1, 2, 2, 3]
    ok = #expect(is_sorted(rising[:], i32_less), "is_sorted rejected an ordered run with a tie") && ok
    ok = #expect(!is_sorted(spread[:], i32_less), "is_sorted accepted an unordered run") && ok
    ok = #expect(is_sorted(rising[0..<1], i32_less), "is_sorted rejected a run of one") && ok
    ok = #expect(is_sorted(rising[0..<0], i32_less), "is_sorted rejected an empty run") && ok

    // ── sort, over the shapes that break a bad one ───────────────────────────
    //
    // Under SMALL, so insertion; over it, so quicksort. Already-sorted and
    // reverse-sorted are the two inputs a last-element pivot is worst on, and
    // all-equal is the one a two-way partition loops forever on.
    [6]i32 shuffled = [9, 1, 8, 2, 7, 3]
    ok = check_sort(shuffled[:], "random, under SMALL") && ok
    [6]i32 ordered = [1, 2, 3, 4, 5, 6]
    ok = check_sort(ordered[:], "already sorted") && ok
    [6]i32 backwards = [6, 5, 4, 3, 2, 1]
    ok = check_sort(backwards[:], "reverse sorted") && ok
    [6]i32 flat = [4, 4, 4, 4, 4, 4]
    ok = check_sort(flat[:], "all equal") && ok

    [40]i32 big
    for i in i64(0)..<i64(40):
        big[i] = i32((i * 37) % 41)
    ok = check_sort(big[:], "forty elements, over SMALL") && ok

    [40]i32 descending
    for i in i64(0)..<i64(40):
        descending[i] = i32(40 - i)
    ok = check_sort(descending[:], "forty descending") && ok

    [40]i32 same
    fill(same[:], 3)
    ok = check_sort(same[:], "forty equal") && ok

    // A run of one and a run of none: `sort` returns before touching anything.
    sort(short_pair[0..<1], i32_less)
    ok = #expect(short_pair[0] == 7, "sorting one element changed it") && ok
    sort(short_pair[0..<0], i32_less)

    // The comparator decides, so the same source sorts the other way.
    [5]i32 down = [3, 1, 4, 1, 5]
    sort(down[:], i32_greater)
    ok = #expect(equal(down[:], DOWN5[:]), "sorting by greater gave ", down) && ok

    // ── the private algorithms, each as a unit ───────────────────────────────
    //
    // `sort` chooses between these three and a test of `sort` cannot say which
    // one it took, so each is called here directly. `heapsort` in particular is
    // reachable through `sort` only past a recursion depth a median-of-three
    // pivot makes hard to provoke — so this is the only place it is exercised
    // at all, and without it the fallback that makes the worst case O(n log n)
    // would be untested code.
    [9]i32 heaped = [5, 3, 9, 1, 7, 2, 8, 4, 6]
    heapsort(heaped[:], i32_less)
    ok = #expect(equal(heaped[:], SORT9[:]), "heapsort gave ", heaped) && ok
    // An even count, so the last parent has one child rather than two — the
    // `child + 1 < end` arm.
    [8]i32 heaped_even = [8, 7, 6, 5, 4, 3, 2, 1]
    heapsort(heaped_even[:], i32_less)
    ok = #expect(is_sorted(heaped_even[:], i32_less), "heapsort of an even run gave ", heaped_even) && ok

    [6]i32 inserted = [5, 3, 9, 1, 7, 2]
    insertion(inserted[:], i32_less)
    ok = #expect(is_sorted(inserted[:], i32_less), "insertion gave ", inserted) && ok

    [20]i32 heaped_up = [5, 3, 9, 1, 7, 2, 8, 4, 6, 0, 19, 11, 13, 12, 15, 14, 17, 16, 18, 10]
    heapsort_up(heaped_up[:])
    ok = #expect(is_sorted(heaped_up[:], i32_less), "heapsort_up gave ", heaped_up) && ok

    [6]i32 inserted_up = [5, 3, 9, 1, 7, 2]
    insertion_up(inserted_up[:])
    ok = #expect(is_sorted(inserted_up[:], i32_less), "insertion_up gave ", inserted_up) && ok

    // The depth budget itself: the fallback fires when this is exhausted, so a
    // wrong answer here disables heapsort silently or reaches it immediately.
    ok = #expect(depth_budget(1) == 1, "depth_budget(1) = ", depth_budget(1)) && ok
    ok = #expect(depth_budget(2) == 2, "depth_budget(2) = ", depth_budget(2)) && ok
    ok = #expect(depth_budget(16) == 8, "depth_budget(16) = ", depth_budget(16)) && ok
    ok = #expect(depth_budget(1024) == 20, "depth_budget(1024) = ", depth_budget(1024)) && ok

    // ── the comparator-free sorts ────────────────────────────────────────────
    [6]i32 up = [9, 1, 8, 2, 7, 3]
    sort_ascending(up[:])
    ok = #expect(equal(up[:], UP6[:]), "sort_ascending gave ", up) && ok

    [6]i32 falling = [9, 1, 8, 2, 7, 3]
    sort_descending(falling[:])
    ok = #expect(equal(falling[:], DOWN6[:]), "sort_descending gave ", falling) && ok

    // A float run, so the `number` category is instantiated at a second width
    // and the comparisons are the ones a float has rather than an int's.
    [5]f64 reals = [2.5, 0.5, 3.5, 1.5, 4.5]
    sort_ascending(reals[:])
    ok = #expect(reals[0] == 0.5 && reals[4] == 4.5, "sort_ascending of floats gave ", reals) && ok

    [30]i32 many
    for i in i64(0)..<i64(30):
        many[i] = i32((i * 17) % 31)
    sort_ascending(many[:])
    ok = #expect(is_sorted(many[:], i32_less), "sort_ascending over SMALL gave ", many) && ok

    sort_ascending(short_pair[0..<1])
    ok = #expect(short_pair[0] == 7, "sort_ascending of one element changed it") && ok
    sort_ascending(short_pair[0..<0])

    // ── searching a sorted run ───────────────────────────────────────────────
    [7]i32 sorted = [1, 3, 3, 3, 5, 7, 9]

    ok = #expect(lower_bound(sorted[:], 3, i32_less) == 1, "lower_bound(3) = ", lower_bound(sorted[:], 3, i32_less)) && ok
    ok = #expect(upper_bound(sorted[:], 3, i32_less) == 4, "upper_bound(3) = ", upper_bound(sorted[:], 3, i32_less)) && ok
    // The difference is how many copies there are, which is the pair's use.
    i64 copies = upper_bound(sorted[:], 3, i32_less) - lower_bound(sorted[:], 3, i32_less)
    ok = #expect(copies == 3, "the run held ", copies, " threes") && ok
    // Before the first and after the last: the two ends the loop must not run off.
    ok = #expect(lower_bound(sorted[:], 0, i32_less) == 0, "lower_bound below the run was not 0") && ok
    ok = #expect(lower_bound(sorted[:], 99, i32_less) == 7, "lower_bound above the run was not the length") && ok
    ok = #expect(upper_bound(sorted[:], 0, i32_less) == 0, "upper_bound below the run was not 0") && ok
    ok = #expect(upper_bound(sorted[:], 99, i32_less) == 7, "upper_bound above the run was not the length") && ok

    (i64 hit_at, bool hit) = binary_search(sorted[:], 5, i32_less)
    ok = #expect(hit && hit_at == 4, "binary_search(5) gave (", hit_at, ", ", hit, ")") && ok
    // A miss, and the index is where it would go — which is the half of the
    // answer a bare -1 would have thrown away.
    (i64 gap_at, bool gap) = binary_search(sorted[:], 4, i32_less)
    ok = #expect(!gap && gap_at == 4, "binary_search(4) gave (", gap_at, ", ", gap, ")") && ok
    (i64 past_at, bool past) = binary_search(sorted[:], 99, i32_less)
    ok = #expect(!past && past_at == 7, "binary_search(99) gave (", past_at, ", ", past, ")") && ok
    (i64 empty_at, bool empty_hit) = binary_search(sorted[0..<0], 1, i32_less)
    ok = #expect(!empty_hit && empty_at == 0, "binary_search of an empty run gave (", empty_at, ", ", empty_hit, ")") && ok

    (i64 f_at, bool f_hit) = find_sorted(sorted[:], 7)
    ok = #expect(f_hit && f_at == 5, "find_sorted(7) gave (", f_at, ", ", f_hit, ")") && ok
    (i64 fm_at, bool fm_hit) = find_sorted(sorted[:], 6)
    ok = #expect(!fm_hit && fm_at == 5, "find_sorted(6) gave (", fm_at, ", ", fm_hit, ")") && ok
    (i64 fe_at, bool fe_hit) = find_sorted(sorted[0..<0], 1)
    ok = #expect(!fe_hit && fe_at == 0, "find_sorted of an empty run gave (", fe_at, ", ", fe_hit, ")") && ok

    if ok:
        return 0
    return 1

// Sort a run and check both halves of what sorting means: the order, and that
// the contents survived. Written once because every case below needs both, and
// because `is_sorted` alone passes for a function that fills the run with its
// smallest element.
private bool check_sort([]i32 xs, string8 label):
    i64 before = total(xs)
    i64 count = #len(xs)
    i64 first = count_of(xs, xs[0])
    sort(xs, i32_less)
    bool ok = #expect(is_sorted(xs, i32_less), label, ": not sorted — ", xs)
    ok = #expect(total(xs) == before, label, ": the sum changed, ", before, " to ", total(xs)) && ok
    i64 after = #len(xs)
    ok = #expect(after == count, label, ": the length changed") && ok
    ok = #expect(count_of(xs, xs[0]) >= first || first == 0, label, ": an element was lost") && ok
    return ok
