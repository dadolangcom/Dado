@test
// What raises into a script. The functions of `core:slices` are templates,
// and a promise written on a template binds **every** instantiation a
// program makes — so `#assert_raises` above `index_of` would refuse a
// program searching a run of `rawptr`, which is a call this package
// serves. The promise is made here instead, one private function per group
// at element types a script has (`i64`, `f64`, `bool`, `char8`, `string8`,
// a record of them), and the build refuses (ERR1227) if any of them reaches
// something a script cannot run. The gap buffer is left out, for the reason
// the package comment gives.
package slices

type Pair:
    i64 key
    string8 name

private bool pair_less(Pair a, Pair b):
    return a.key < b.key

private bool f64_less(f64 a, f64 b):
    return a < b

private bool positive(f64 x):
    return x > 0.0

private bool nonempty(string8 s):
    return #len(s) > 0

#assert_raises
private i64 rearranges([]i64 xs, []i64 into):
    swap(xs, 0, 1)
    reverse(xs)
    rotate(xs, 1)
    fill(into, 7)
    return copy_into(xs, into)

#assert_raises
private i64 equalities([]i64 xs, []i64 probe, []string8 names):
    i64 n = index_of(xs, 1) + last_index_of(xs, 1) + count_of(xs, 1)
    if contains(xs, 2) && equal(xs, probe) && starts_with(xs, probe) && ends_with(xs, probe):
        n = n + 1
    n = n + index_of_run(xs, probe) + last_index_of_run(xs, probe)
    if contains_run(xs, probe) && contains(names, "a"):
        n = n + 1
    return n + unique(xs) + index_of(names, "b")

#assert_raises
private i64 predicates([]f64 xs, []string8 names):
    i64 n = count_if(xs, positive) + find_if(xs, positive) + partition(xs, positive)
    if all(xs, positive) || any(xs, positive) || none(names, nonempty):
        n = n + 1
    return n

#assert_raises
private i64 orders([]f64 xs, []char8 cs, []Pair ps):
    i64 n = min_index(xs, f64_less) + max_index(xs, f64_less)
    sort(xs, f64_less)
    sort_stable(ps, pair_less)
    sort_ascending(cs)
    sort_descending(xs)
    if is_sorted(xs, f64_less) && is_sorted_ascending(cs):
        n = n + 1
    try char8 lo = min(cs) else:
        return n
    try char8 hi = max(cs) else:
        return n
    try f64 small = min(xs) else:
        return n
    if lo <= hi && small <= 1.0:
        n = n + 1
    (i64 at, bool found) = binary_search(xs, 1.0, f64_less)
    (i64 at2, bool found2) = find_sorted(cs, 'a')
    if found || found2:
        n = n + at + at2
    return n + lower_bound(xs, 1.0, f64_less) + upper_bound(xs, 1.0, f64_less)

#assert_raises
private i64 pieces([]i64 xs):
    ref []i64 c = clone(xs)
    i64 n = #len(c)
    #delete(c)
    for i in i64(0)..<chunk_count(xs, 2):
        []i64 piece = chunk(xs, 2, i)
        n = n + #len(piece)
    for i in i64(0)..<window_count(xs, 2):
        []i64 w = window(xs, 2, i)
        n = n + #len(w)
    return n

private bool bool_less(bool a, bool b):
    return !a && b

private bool is_true(bool b):
    return b

// Every function that admits a `bool`, at `bool`: `bool` has `==` but no `<`,
// so the comparator-free orderings are the ones left out.
#assert_raises
private i64 booleans([]bool bs, []bool into, []bool probe):
    swap(bs, 0, 1)
    reverse(bs)
    rotate(bs, 1)
    fill(into, true)
    i64 n = copy_into(bs, into)
    n = n + index_of(bs, true) + last_index_of(bs, false) + count_of(bs, true)
    if contains(bs, true) && equal(bs, probe) && starts_with(bs, probe) && ends_with(bs, probe):
        n = n + 1
    n = n + index_of_run(bs, probe) + last_index_of_run(bs, probe)
    if contains_run(bs, probe) || all(bs, is_true) || any(bs, is_true) || none(bs, is_true):
        n = n + 1
    n = n + count_if(bs, is_true) + find_if(bs, is_true) + partition(bs, is_true)
    n = n + min_index(bs, bool_less) + max_index(bs, bool_less)
    sort(bs, bool_less)
    sort_stable(into, bool_less)
    if is_sorted(bs, bool_less):
        n = n + 1
    (i64 at, bool found) = binary_search(bs, true, bool_less)
    if found:
        n = n + at
    n = n + lower_bound(bs, true, bool_less) + upper_bound(bs, false, bool_less)
    ref []bool c = clone(bs)
    n = n + #len(c)
    #delete(c)
    []bool piece = chunk(bs, 2, 0)
    []bool w = window(bs, 2, 0)
    n = n + chunk_count(bs, 2) + #len(piece) + window_count(bs, 2) + #len(w)
    return n + unique(bs)

i32 test():
    [4]i64 xs = [3, 1, 2, 1]
    [4]i64 into
    [2]i64 probe = [1, 2]
    [3]string8 names = ["b", "a", ""]
    [3]f64 fs = [2.0, -1.0, 1.0]
    [3]char8 cs = ['c', 'a', 'b']
    [2]Pair ps = [(2, "two"), (1, "one")]
    i64 n = rearranges(xs[:], into[:]) + equalities(xs[:], probe[:], names[:])
    n = n + predicates(fs[:], names[:]) + orders(fs[:], cs[:], ps[:]) + pieces(xs[:])
    [4]bool bs = [true, false, true, false]
    [4]bool binto
    [2]bool bprobe = [false, true]
    n = n + booleans(bs[:], binto[:], bprobe[:])
    // The answers are the other tests' to check; this one asks only that
    // every promised function ran.
    return 0 if #expect(n != 0, "the promised functions answered nothing") else 1
