// Predicates on the sweep plane: vertices ordered by (s, t), edges
// evaluated against a vertex between their ends.
package tess

private bool vert_eq(^Vertex u, ^Vertex v):
    return u.s == v.s && u.t == v.t

private bool vert_leq(^Vertex u, ^Vertex v):
    return u.s < v.s || (u.s == v.s && u.t <= v.t)

private bool trans_leq(^Vertex u, ^Vertex v):
    return u.t < v.t || (u.t == v.t && u.s <= v.s)

private bool edge_goes_left(^HalfEdge e):
    return vert_leq(dst(e), e.org)

private bool edge_goes_right(^HalfEdge e):
    return vert_leq(e.org, dst(e))

private bool edge_is_internal(^HalfEdge e):
    return rface(e) != nil && rface(e).inside != 0

// |x| in Dado, so the package reaches no C (core:math's is fabs).
private f64 abs(f64 x):
    return -x if x < 0.0 else x

private f64 vert_l1_dist(^Vertex u, ^Vertex v):
    return abs(u.s - v.s) + abs(u.t - v.t)

private bool vert_ccw(^Vertex u, ^Vertex v, ^Vertex w):
    return (u.s * (v.t - w.t) + v.s * (w.t - u.t) + w.s * (u.t - v.t)) >= 0.0

private void add_winding(^HalfEdge e_dst, ^HalfEdge e_src):
    e_dst.winding += e_src.winding
    e_dst.sym.winding += e_src.sym.winding

// With u <= v <= w in s: the signed t-distance from v to the edge uw.
private f64 edge_eval(^Vertex u, ^Vertex v, ^Vertex w):
    f64 gap_l = v.s - u.s
    f64 gap_r = w.s - v.s
    if gap_l + gap_r > 0.0:
        if gap_l < gap_r:
            return (v.t - u.t) + (u.t - w.t) * (gap_l / (gap_l + gap_r))
        return (v.t - w.t) + (w.t - u.t) * (gap_r / (gap_l + gap_r))
    return 0.0

// edge_eval's sign, without the division.
private f64 edge_sign(^Vertex u, ^Vertex v, ^Vertex w):
    f64 gap_l = v.s - u.s
    f64 gap_r = w.s - v.s
    if gap_l + gap_r > 0.0:
        f64 r = (v.t - w.t) * gap_l + (v.t - u.t) * gap_r
        return 0.0 if r != r else r   // r != r: NaN
    return 0.0

private f64 trans_eval(^Vertex u, ^Vertex v, ^Vertex w):
    f64 gap_l = v.t - u.t
    f64 gap_r = w.t - v.t
    if gap_l + gap_r > 0.0:
        if gap_l < gap_r:
            return (v.s - u.s) + (u.s - w.s) * (gap_l / (gap_l + gap_r))
        return (v.s - w.s) + (w.s - u.s) * (gap_r / (gap_l + gap_r))
    return 0.0

private f64 trans_sign(^Vertex u, ^Vertex v, ^Vertex w):
    f64 gap_l = v.t - u.t
    f64 gap_r = w.t - v.t
    if gap_l + gap_r > 0.0:
        return (v.s - w.s) * gap_l + (v.s - u.s) * gap_r
    return 0.0

private f64 interpolate(f64 a_in, f64 x, f64 b_in, f64 y):
    f64 a = 0.0 if a_in < 0.0 else a_in
    f64 b = 0.0 if b_in < 0.0 else b_in
    if a <= b:
        if b == 0.0:
            return x / 2.0 + y / 2.0
        return x + (y - x) * (a / (a + b))
    return y + (x - y) * (b / (a + b))

// The intersection of o1d1 and o2d2, written to v.s and v.t.
private void edge_intersect(^Vertex o1_in, ^Vertex d1_in, ^Vertex o2_in, ^Vertex d2_in, ^Vertex v):
    ^Vertex o1 = o1_in
    ^Vertex d1 = d1_in
    ^Vertex o2 = o2_in
    ^Vertex d2 = d2_in
    ^Vertex tmp = nil

    if !vert_leq(o1, d1):
        tmp = o1
        o1 = d1
        d1 = tmp
    if !vert_leq(o2, d2):
        tmp = o2
        o2 = d2
        d2 = tmp
    if !vert_leq(o1, o2):
        tmp = o1
        o1 = o2
        o2 = tmp
        tmp = d1
        d1 = d2
        d2 = tmp

    if !vert_leq(o2, d1):
        v.s = o2.s / 2.0 + d1.s / 2.0
    else if vert_leq(d1, d2):
        f64 z1 = edge_eval(o1, o2, d1)
        f64 z2 = edge_eval(o2, d1, d2)
        if z1 + z2 < 0.0:
            z1 = -z1
            z2 = -z2
        v.s = interpolate(z1, o2.s, z2, d1.s)
    else:
        f64 z1 = edge_sign(o1, o2, d1)
        f64 z2 = -edge_sign(o1, d2, d1)
        if z1 + z2 < 0.0:
            z1 = -z1
            z2 = -z2
        v.s = interpolate(z1, o2.s, z2, d2.s)

    if !trans_leq(o1, d1):
        tmp = o1
        o1 = d1
        d1 = tmp
    if !trans_leq(o2, d2):
        tmp = o2
        o2 = d2
        d2 = tmp
    if !trans_leq(o1, o2):
        tmp = o1
        o1 = o2
        o2 = tmp
        tmp = d1
        d1 = d2
        d2 = tmp

    if !trans_leq(o2, d1):
        v.t = o2.t / 2.0 + d1.t / 2.0
    else if trans_leq(d1, d2):
        f64 z1 = trans_eval(o1, o2, d1)
        f64 z2 = trans_eval(o2, d1, d2)
        if z1 + z2 < 0.0:
            z1 = -z1
            z2 = -z2
        v.t = interpolate(z1, o2.t, z2, d1.t)
    else:
        f64 z1 = trans_sign(o1, o2, d1)
        f64 z2 = -trans_sign(o1, d2, d1)
        if z1 + z2 < 0.0:
            z1 = -z1
            z2 = -z2
        v.t = interpolate(z1, o2.t, z2, d2.t)

private f64 in_circle(^Vertex v, ^Vertex v0, ^Vertex v1, ^Vertex v2):
    f64 adx = v0.s - v.s
    f64 ady = v0.t - v.t
    f64 bdx = v1.s - v.s
    f64 bdy = v1.t - v.t
    f64 cdx = v2.s - v.s
    f64 cdy = v2.t - v.t
    f64 abdet = adx * bdy - bdx * ady
    f64 bcdet = bdx * cdy - cdx * bdy
    f64 cadet = cdx * ady - adx * cdy
    f64 alift = adx * adx + ady * ady
    f64 blift = bdx * bdx + bdy * bdy
    f64 clift = cdx * cdx + cdy * cdy
    return alift * bcdet + blift * cadet + clift * abdet

private bool edge_is_locally_delaunay(^HalfEdge e):
    return in_circle(e.sym.lnext.lnext.org, e.lnext.org, e.lnext.lnext.org, e.org) < 0.0
