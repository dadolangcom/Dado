// The event queue: the input vertices sorted once, plus a binary heap for the
// intersections the sweep finds. A handle >= 0 is a heap entry; a negative
// one, -(i + 1), is sorted key i.
package tess

import "core:mem/arena"

private const i32 INV_HANDLE = 0x0fffffff

private type HandleElem:
    ^Vertex key
    i32 node

private type Heap:
    ref []i32 nodes            // heap position -> handle
    ref []HandleElem handles   // handle -> key and heap position
    i32 size
    i32 max
    i32 free_list
    bool initialized

private type PQ:
    Heap heap
    ref []^Vertex keys
    ref []i32 order            // indices into keys, sorted descending
    i32 size
    i32 max
    bool initialized

private bool heap_init_storage(^Heap pq, i32 size, ^arena.Arena ar):
    pq.nodes = #make([]i32, size + 1, arena.allocator(ar))
    pq.handles = #make([]HandleElem, size + 1, arena.allocator(ar))
    if pq.nodes == nil || pq.handles == nil:
        return false
    pq.size = 0
    pq.max = size
    pq.free_list = 0
    pq.initialized = false
    pq.nodes[1] = 1
    pq.handles[1].key = nil
    return true

private void float_down(^Heap pq, i32 curr_in):
    i32 curr = curr_in
    i32 h_curr = pq.nodes[curr]
    for true:
        i32 child = curr << 1
        if child < pq.size && vert_leq(pq.handles[pq.nodes[child + 1]].key, pq.handles[pq.nodes[child]].key):
            child += 1
        i32 h_child = pq.nodes[child]
        if child > pq.size || vert_leq(pq.handles[h_curr].key, pq.handles[h_child].key):
            pq.nodes[curr] = h_curr
            pq.handles[h_curr].node = curr
            break
        pq.nodes[curr] = h_child
        pq.handles[h_child].node = curr
        curr = child

private void float_up(^Heap pq, i32 curr_in):
    i32 curr = curr_in
    i32 h_curr = pq.nodes[curr]
    for true:
        i32 parent = curr >> 1
        i32 h_parent = pq.nodes[parent]
        if parent == 0 || vert_leq(pq.handles[h_parent].key, pq.handles[h_curr].key):
            pq.nodes[curr] = h_curr
            pq.handles[h_curr].node = curr
            break
        pq.nodes[curr] = h_parent
        pq.handles[h_parent].node = curr
        curr = parent

private void heap_init(^Heap pq):
    i32 i = pq.size
    for i >= 1:
        float_down(pq, i)
        i -= 1
    pq.initialized = true

private ^Vertex heap_minimum(^Heap pq):
    return pq.handles[pq.nodes[1]].key

private bool heap_is_empty(^Heap pq):
    return pq.size == 0

private i32 heap_insert(^Heap pq, ^Vertex key_new):
    pq.size += 1
    i32 curr = pq.size
    if curr * 2 > pq.max:
        i32 grown = pq.max << 1
        if !#resize(pq.nodes, i64(grown) + 1):
            return INV_HANDLE
        if !#resize(pq.handles, i64(grown) + 1):
            return INV_HANDLE
        pq.max = grown

    i32 free = 0
    if pq.free_list == 0:
        free = curr
    else:
        free = pq.free_list
        pq.free_list = pq.handles[free].node

    pq.nodes[curr] = free
    pq.handles[free].node = curr
    pq.handles[free].key = key_new
    if pq.initialized:
        float_up(pq, curr)
    return free

private ^Vertex heap_extract_min(^Heap pq):
    i32 h_min = pq.nodes[1]
    ^Vertex min = pq.handles[h_min].key
    if pq.size > 0:
        pq.nodes[1] = pq.nodes[pq.size]
        pq.handles[pq.nodes[1]].node = 1
        pq.handles[h_min].key = nil
        pq.handles[h_min].node = pq.free_list
        pq.free_list = h_min
        pq.size -= 1
        if pq.size > 0:
            float_down(pq, 1)
    return min

private void heap_delete(^Heap pq, i32 h_curr):
    i32 curr = pq.handles[h_curr].node
    pq.nodes[curr] = pq.nodes[pq.size]
    pq.handles[pq.nodes[curr]].node = curr
    pq.size -= 1
    if curr <= pq.size:
        if curr <= 1 || vert_leq(pq.handles[pq.nodes[curr >> 1]].key, pq.handles[pq.nodes[curr]].key):
            float_down(pq, curr)
        else:
            float_up(pq, curr)
    pq.handles[h_curr].key = nil
    pq.handles[h_curr].node = pq.free_list
    pq.free_list = h_curr

private bool pq_new(^PQ pq, i32 size, ^arena.Arena ar):
    if !heap_init_storage(&pq.heap, size, ar):
        return false
    pq.keys = #make([]^Vertex, size, arena.allocator(ar))
    if pq.keys == nil:
        return false
    pq.size = 0
    pq.max = size
    pq.initialized = false
    return true

private ^Vertex order_key(^PQ pq, i32 i):
    return pq.keys[pq.order[i]]

// Sorts the keys descending, so the minimum is last, then starts the heap.
private bool pq_init(^PQ pq, ^arena.Arena ar):
    pq.order = #make([]i32, pq.size + 1, arena.allocator(ar))
    if pq.order == nil:
        return false
    for i in 0..<pq.size:
        pq.order[i] = i

    u32 seed = 2016473283
    [100]i32 stack   // (p, r) frames
    i32 top = 0
    stack[0] = 0
    stack[1] = pq.size - 1
    top = 1

    for top > 0:
        top -= 1
        i32 p = stack[2 * top]
        i32 r = stack[2 * top + 1]

        for r > p + 10:
            seed = seed * 1539415821 + 1
            i32 idx = p + i32(seed % u32(r - p + 1))
            i32 piv = pq.order[idx]
            pq.order[idx] = pq.order[p]
            pq.order[p] = piv
            i32 i = p - 1
            i32 j = r + 1
            for true:
                i += 1
                for !vert_leq(order_key(pq, i), pq.keys[piv]):
                    i += 1
                j -= 1
                for !vert_leq(pq.keys[piv], order_key(pq, j)):
                    j -= 1
                if i >= j:
                    break
                i32 tmp = pq.order[i]
                pq.order[i] = pq.order[j]
                pq.order[j] = tmp
            if i - p < r - j:
                stack[2 * top] = j + 1
                stack[2 * top + 1] = r
                top += 1
                r = i - 1
            else:
                stack[2 * top] = p
                stack[2 * top + 1] = i - 1
                top += 1
                p = j + 1

        i32 k = p + 1
        for k <= r:
            i32 piv = pq.order[k]
            i32 j = k
            for j > p && !vert_leq(pq.keys[piv], order_key(pq, j - 1)):
                pq.order[j] = pq.order[j - 1]
                j -= 1
            pq.order[j] = piv
            k += 1

    pq.max = pq.size
    pq.initialized = true
    heap_init(&pq.heap)
    return true

private i32 pq_insert(^PQ pq, ^Vertex key_new):
    if pq.initialized:
        return heap_insert(&pq.heap, key_new)
    i32 curr = pq.size
    pq.size += 1
    if pq.size >= pq.max:
        i32 grown = pq.max << 1
        if !#resize(pq.keys, i64(grown)):
            return INV_HANDLE
        pq.max = grown
    pq.keys[curr] = key_new
    return -(curr + 1)

private ^Vertex pq_extract_min(^PQ pq):
    if pq.size == 0:
        return heap_extract_min(&pq.heap)
    ^Vertex sort_min = order_key(pq, pq.size - 1)
    if !heap_is_empty(&pq.heap):
        ^Vertex heap_min = heap_minimum(&pq.heap)
        if vert_leq(heap_min, sort_min):
            return heap_extract_min(&pq.heap)
    for true:
        pq.size -= 1
        if pq.size <= 0 || order_key(pq, pq.size - 1) != nil:
            break
    return sort_min

private ^Vertex pq_minimum(^PQ pq):
    if pq.size == 0:
        return heap_minimum(&pq.heap)
    ^Vertex sort_min = order_key(pq, pq.size - 1)
    if !heap_is_empty(&pq.heap):
        ^Vertex heap_min = heap_minimum(&pq.heap)
        if vert_leq(heap_min, sort_min):
            return heap_min
    return sort_min

private void pq_delete(^PQ pq, i32 curr_in):
    if curr_in >= 0:
        heap_delete(&pq.heap, curr_in)
        return
    i32 curr = -(curr_in + 1)
    pq.keys[curr] = nil
    for pq.size > 0 && order_key(pq, pq.size - 1) == nil:
        pq.size -= 1
