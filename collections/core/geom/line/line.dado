// Where two lines, rays or segments in the plane cross, for any float.
//
//     [2]f64 a0 = (-1.0, -1.0)
//     [2]f64 a1 = (1.0, 1.0)
//     ([2]f64 at, bool hit) = line.segment_segment_intersect(a0, a1, (-1.0, 1.0), (1.0, -1.0))
//     // at is (0, 0), hit is true
//
// Each of the three kinds is given by two points, p0 and p1. A line runs through both without
// end; a ray starts at p0 and runs through p1 without end; a segment runs from p0 to p1, both
// ends included. Every function answers the crossing and whether there is one, with (0, 0) and
// `false` for a miss. Lines that are parallel never cross here, even when they lie on each
// other; `segment_segment_parameters` is the one function that finds where collinear segments
// overlap.
//
// The parallel test is exact: two directions are parallel when their 2D cross product is 0.0,
// and nothing else is. Directions a rounding error apart are not parallel, and their crossing
// can lie very far away. A caller that wants a tolerance asks `nearly_parallel` first.
//
// **Tier N W H.** Pure Dado over `core:linalg`: it builds and runs freestanding
// (`#NONE`), on the web, and hosted (Linux, macOS and Windows) alike.
//
// **What raises into a script.** Every public function, each promised by the `#assert_raises`
// on the line above it and checked at each instantiation a program makes: the arithmetic here
// is a script's own.
package line

import "core:linalg"

// Solves for (t, u) in: a0 + t*(a1 - a0) = b0 + u*(b1 - b0)
// Returns (t, u, parallel_flag)
private ($T, T, bool) solve_params([2]T a0, [2]T a1, [2]T b0, [2]T b1) where T is float:
    [2]T da = a1 - a0
    [2]T db = b1 - b0

    // 2D cross product determinant
    T det = (da.x * db.y) - (da.y * db.x)
    if det == 0.0:
        return (0.0, 0.0, true)

    [2]T dp = b0 - a0
    T t = ((dp.x * db.y) - (dp.y * db.x)) / det
    T u = ((dp.x * da.y) - (dp.y * da.x)) / det

    return (t, u, false)

// Whether the direction of a0-a1 and the direction of b0-b1 are within `eps` of parallel,
// where `eps` bounds the sine of the angle between them: |cross| <= eps * |a1 - a0| * |b1 - b0|,
// compared squared, so no square root is taken. A zero-length direction is parallel to
// everything. With `eps` 0 it is the exact test the intersections use.
//
//     if !line.nearly_parallel(a0, a1, b0, b1, 0.000000001):
//         ([2]f64 at, bool hit) = line.line_line_intersect(a0, a1, b0, b1)
#assert_raises
bool nearly_parallel([2]$T a0, a1, b0, b1, T eps) where T is float:
    [2]T da = a1 - a0
    [2]T db = b1 - b0
    T det = (da.x * db.y) - (da.y * db.x)
    if eps <= 0.0:
        return det == 0.0
    return det * det <= eps * eps * linalg.dot(da, da) * linalg.dot(db, db)

// Where the line through a0 and a1 crosses the line through b0 and b1. Parallel lines miss.
#assert_raises
([2]$T at, bool hit) line_line_intersect([2]T a0, a1, b0, b1) where T is float:
    (T t, T _, bool parallel) = solve_params(a0, a1, b0, b1)
    if parallel:
        return ([0.0, 0.0], false)
    return (a0 + (a1 - a0) * t, true)

// Where the ray from a0 through a1 crosses the ray from b0 through b1. Each ray includes its
// start. Parallel rays miss.
#assert_raises
([2]$T at, bool hit) ray_ray_intersect([2]T a0, a1, b0, b1) where T is float:
    (T t, T u, bool parallel) = solve_params(a0, a1, b0, b1)
    if parallel || t < 0.0 || u < 0.0:
        return ([0.0, 0.0], false)
    return (a0 + (a1 - a0) * t, true)

// Where segment a0-a1 crosses segment b0-b1, ends included. Parallel segments miss, even
// collinear ones that overlap; `segment_segment_parameters` answers those.
#assert_raises
([2]$T at, bool hit) segment_segment_intersect([2]T a0, a1, b0, b1) where T is float:
    (T t, T u, bool parallel) = solve_params(a0, a1, b0, b1)
    if parallel || t < 0.0 || t > 1.0 || u < 0.0 || u > 1.0:
        return ([0.0, 0.0], false)
    return (a0 + (a1 - a0) * t, true)

// Where the line through l0 and l1 crosses the ray from r0 through r1. Parallel ones miss.
#assert_raises
([2]$T at, bool hit) line_ray_intersect([2]T l0, l1, r0, r1) where T is float:
    (T t, T u, bool parallel) = solve_params(l0, l1, r0, r1)
    if parallel || u < 0.0:
        return ([0.0, 0.0], false)
    return (l0 + (l1 - l0) * t, true)

// Where the line through l0 and l1 crosses segment s0-s1, ends included. Parallel ones miss.
#assert_raises
([2]$T at, bool hit) line_segment_intersect([2]T l0, l1, s0, s1) where T is float:
    (T t, T u, bool parallel) = solve_params(l0, l1, s0, s1)
    if parallel || u < 0.0 || u > 1.0:
        return ([0.0, 0.0], false)
    return (l0 + (l1 - l0) * t, true)

// Where the ray from r0 through r1 crosses segment s0-s1, ends included. Parallel ones miss.
#assert_raises
([2]$T at, bool hit) ray_segment_intersect([2]T r0, r1, s0, s1) where T is float:
    (T t, T u, bool parallel) = solve_params(r0, r1, s0, s1)
    if parallel || t < 0.0 || u < 0.0 || u > 1.0:
        return ([0.0, 0.0], false)
    return (r0 + (r1 - r0) * t, true)

// The 2D cross product of a and b: the z of their 3D cross.
private $T cross2([2]T a, [2]T b) where T is float:
    return a.x * b.y - a.y * b.x

// Where segment a0-a1 meets segment b0-b1, as parameters: a0 + t*(a1 - a0) == b0 + u*(b1 - b0),
// with t and u in [0, 1]. Touching ends meet. Unlike `segment_segment_intersect`, collinear
// segments that overlap meet, at the first point of the overlap along a, and a zero-length
// segment is a point. A miss answers (0, 0, false). Exact: no tolerance.
//
//     (f64 t, f64 u, bool hit) = line.segment_segment_parameters(a0, a1, b0, b1)
//     [2]f64 at = a0 + (a1 - a0) * t
#assert_raises
($T t, T u, bool hit) segment_segment_parameters([2]T a0, a1, b0, b1) where T is float:
    T zero = 0.0
    (T t, T u, bool parallel) = solve_params(a0, a1, b0, b1)
    if !parallel:
        if t < 0.0 || t > 1.0 || u < 0.0 || u > 1.0:
            return (zero, zero, false)
        return (t, u, true)

    // Parallel: they meet only if collinear.
    [2]T da = a1 - a0
    [2]T db = b1 - b0
    [2]T dp = b0 - a0
    if cross2(dp, da) != 0.0 || cross2(dp, db) != 0.0:
        return (zero, zero, false)
    T la = linalg.dot(da, da)
    T lb = linalg.dot(db, db)
    if la == 0.0 && lb == 0.0:
        return (zero, zero, a0.x == b0.x && a0.y == b0.y)
    if la == 0.0:
        T on_b = linalg.dot(a0 - b0, db) / lb
        return (zero, on_b, on_b >= 0.0 && on_b <= 1.0)
    // b's ends as parameters along a.
    T s0 = linalg.dot(dp, da) / la
    T s1 = linalg.dot(b1 - a0, da) / la
    T lo = s0 if s0 < s1 else s1
    T hi = s1 if s0 < s1 else s0
    if lo < 0.0: lo = 0.0
    if hi > 1.0: hi = 1.0
    if lo > hi:
        return (zero, zero, false)
    T at_b = zero
    if lb != 0.0:
        at_b = linalg.dot(a0 + da * lo - b0, db) / lb
    return (lo, at_b, true)
