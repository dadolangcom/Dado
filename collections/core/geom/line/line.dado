package line

import "core:linalg"

// Solves for (t, u) in: a0 + t*(a1 - a0) = b0 + u*(b1 - b0)
// Returns (t, u, parallel_flag)
private ($T, T, bool) solve_params([2]T a0, [2]T a1, [2]T b0, [2]T b1) where T is float:
    [2]T da = a1 - a0
    [2]T db = b1 - b0
    
    // 2D cross product determinant
    T det = (da.x * db.y) - (da.y * db.x)
    if det == 0.0:
        return (0.0, 0.0, true)

    [2]T dp = b0 - a0
    T t = ((dp.x * db.y) - (dp.y * db.x)) / det
    T u = ((dp.x * da.y) - (dp.y * da.x)) / det

    return (t, u, false)

([2]$T, bool) line_line_intersect([2]T a0, a1, b0, b1) where T is float:
    (typeof(a0[0]) t, typeof(a0[0]) _, bool parallel) = solve_params(a0, a1, b0, b1)
    if parallel:
        return ([0.0, 0.0], false)
    return (a0 + (a1 - a0) * t, true)

([2]$T, bool) ray_ray_intersect([2]T a0, a1, b0, b1) where T is float:
    (typeof(a0[0]) t, typeof(a0[0]) u, bool parallel) = solve_params(a0, a1, b0, b1)
    if parallel || t < 0.0 || u < 0.0:
        return ([0.0, 0.0], false)
    return (a0 + (a1 - a0) * t, true)

([2]$T, bool) segment_segment_intersect([2]T a0, a1, b0, b1) where T is float:
    (typeof(a0[0]) t, typeof(a0[0]) u, bool parallel) = solve_params(a0, a1, b0, b1)
    if parallel || t < 0.0 || t > 1.0 || u < 0.0 || u > 1.0:
        return ([0.0, 0.0], false)
    return (a0 + (a1 - a0) * t, true)

([2]$T, bool) line_ray_intersect([2]T l0, l1, r0, r1) where T is float:
    (typeof(l0[0]) t, typeof(l0[0]) u, bool parallel) = solve_params(l0, l1, r0, r1)
    if parallel || u < 0.0:
        return ([0.0, 0.0], false)
    return (l0 + (l1 - l0) * t, true)

([2]$T, bool) line_segment_intersect([2]T l0, l1, s0, s1) where T is float:
    (typeof(l0[0]) t, typeof(l0[0]) u, bool parallel) = solve_params(l0, l1, s0, s1)
    if parallel || u < 0.0 || u > 1.0:
        return ([0.0, 0.0], false)
    return (l0 + (l1 - l0) * t, true)

([2]$T, bool) ray_segment_intersect([2]T r0, r1, s0, s1) where T is float:
    (typeof(r0[0]) t, typeof(r0[0]) u, bool parallel) = solve_params(r0, r1, s0, s1)
    if parallel || t < 0.0 || u < 0.0 || u > 1.0:
        return ([0.0, 0.0], false)
    return (r0 + (r1 - r0) * t, true)
