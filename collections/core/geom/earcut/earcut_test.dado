@test
package earcut

import "core:mem"

// Hand cases. Expected counts and indices are mapbox/earcut 3.2.4's output.
// One hole start is written as a two-element array windowed to one, `h[..<1]`:
// a one-element array cannot be windowed (ERR0504).

private bool near0(f64 x):
    return x < 0.000000000001 && x > -0.000000000001

// Triangulates, then checks the triangle count and a zero deviation.
private bool shape(string8 name, []f64 v, []u32 holes, i64 want):
    try ref []u32 t = triangulate(v, holes) else code:
        return #expect(false, name, ": failed with ", code)
    defer #delete(t)
    bool ok = #expect(#len(t) == want * 3, name, ": ", #len(t) / 3, " triangles, want ", want)
    f64 dev = deviation(v, holes, 2, t)
    return #expect(near0(dev), name, ": deviation ", dev) && ok

private bool same([]u32 got, []u32 want):
    if #len(got) != #len(want):
        return false
    for x, i in want:
        if got[i] != x:
            return false
    return true

private rawptr starved(rawptr data, mem.AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

i32 test():
    bool ok = true
    []u32 none

    // The reference's README example: exact indices, in 2D and 3D.
    [8]f64 quad = [10.0, 0.0, 0.0, 50.0, 60.0, 60.0, 70.0, 10.0]
    [6]u32 quad_want = [1, 0, 3, 1, 3, 2]
    try ref []u32 t2 = triangulate(quad[:], none) else:
        return 1
    defer #delete(t2)
    ok = #expect(same(t2, quad_want[:]), "indices-2d: ", t2) && ok

    [12]f64 quad3 = [10.0, 0.0, 0.0, 0.0, 50.0, 0.0, 60.0, 60.0, 0.0, 70.0, 10.0, 0.0]
    try ref []u32 t3 = triangulate(quad3[:], none, 3) else:
        return 1
    defer #delete(t3)
    ok = #expect(same(t3, quad_want[:]), "indices-3d: ", t3) && ok

    []f64 empty
    try ref []u32 te = triangulate(empty, none) else:
        return 1
    defer #delete(te)
    ok = #expect(#len(te) == 0, "empty: ", te) && ok

    [8]f64 sq = [0.0, 0.0, 1.0, 0.0, 1.0, 1.0, 0.0, 1.0]
    ok = shape("square ccw", sq[:], none, 2) && ok
    [8]f64 sq_cw = [0.0, 0.0, 0.0, 1.0, 1.0, 1.0, 1.0, 0.0]
    ok = shape("square cw", sq_cw[:], none, 2) && ok

    [12]f64 ell = [0.0, 0.0, 2.0, 0.0, 2.0, 1.0, 1.0, 1.0, 1.0, 2.0, 0.0, 2.0]
    ok = shape("concave L", ell[:], none, 4) && ok

    [16]f64 framed = [0.0, 0.0, 4.0, 0.0, 4.0, 4.0, 0.0, 4.0, 1.0, 1.0, 1.0, 3.0, 3.0, 3.0, 3.0, 1.0]
    [2]u32 framed_h = [4, 0]
    ok = shape("one hole", framed[:], framed_h[..<1], 8) && ok

    [24]f64 two = [
        0.0, 0.0, 10.0, 0.0, 10.0, 4.0, 0.0, 4.0,
        1.0, 1.0, 1.0, 3.0, 3.0, 3.0, 3.0, 1.0,
        6.0, 1.0, 6.0, 3.0, 8.0, 3.0, 8.0, 1.0,
    ]
    [2]u32 two_h = [4, 8]
    ok = shape("two holes", two[:], two_h[:], 12) && ok

    [10]f64 steiner = [0.0, 0.0, 4.0, 0.0, 4.0, 4.0, 0.0, 4.0, 2.0, 2.0]
    [2]u32 steiner_h = [4, 0]
    ok = shape("steiner point", steiner[:], steiner_h[..<1], 4) && ok

    // A repeated vertex and a closing point are dropped.
    [12]f64 dup = [0.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 1.0, 0.0, 1.0, 0.0, 0.0]
    ok = shape("duplicate points", dup[:], none, 2) && ok

    [10]f64 colin = [0.0, 0.0, 1.0, 0.0, 2.0, 0.0, 2.0, 2.0, 0.0, 2.0]
    ok = shape("collinear edge point", colin[:], none, 3) && ok

    // All on y = 2x: no triangles, and no deviation despite shoelace roundoff.
    [8]f64 line = [0.1, 0.2, 1.3, 2.6, 2.5, 5.0, 3.7, 7.4]
    ok = shape("collinear polygon", line[:], none, 0) && ok

    // Terminates; the reference answers one triangle.
    [20]f64 loop = [1.0, 2.0, 2.0, 2.0, 1.0, 2.0, 1.0, 1.0, 1.0, 2.0, 4.0, 1.0, 5.0, 1.0, 3.0, 2.0, 4.0, 2.0, 4.0, 1.0]
    [2]u32 loop_h = [5, 0]
    try ref []u32 tl = triangulate(loop[:], loop_h[..<1]) else:
        return 1
    defer #delete(tl)
    ok = #expect(#len(tl) == 3, "infinite-loop: ", tl) && ok

    // f32 input, as an XZ footprint would come.
    [8]f32 sq32 = [0.0, 0.0, 0.6, 0.0, 0.6, 0.58, 0.0, 0.58]
    try ref []u32 t32 = triangulate(sq32[:], none) else:
        return 1
    defer #delete(t32)
    ok = #expect(#len(t32) == 6 && near0(deviation(sq32[:], none, 2, t32)), "f32 square: ", t32) && ok

    // Malformed input fails rather than reading out of bounds.
    [7]f64 partial = [0.0, 0.0, 1.0, 0.0, 1.0, 1.0, 0.0]
    ref []u32 tp
    try tp = triangulate(partial[:], none) else code:
        ok = #expect(code == MALFORMED, "partial vertex code ", code) && ok
    defer #delete(tp)
    ok = #expect(tp == nil, "partial vertex answered") && ok

    ref []u32 td
    try td = triangulate(sq[:], none, 1) else code:
        ok = #expect(code == MALFORMED, "dim 1 code ", code) && ok
    defer #delete(td)
    ok = #expect(td == nil, "dim 1 answered") && ok

    [2]u32 past = [4, 0]
    ref []u32 th
    try th = triangulate(sq[:], past[..<1]) else code:
        ok = #expect(code == MALFORMED, "hole past the end code ", code) && ok
    defer #delete(th)
    ok = #expect(th == nil, "hole past the end answered") && ok

    [2]u32 backwards = [6, 5]
    ref []u32 tb
    try tb = triangulate(two[:], backwards[:]) else code:
        ok = #expect(code == MALFORMED, "holes out of order code ", code) && ok
    defer #delete(tb)
    ok = #expect(tb == nil, "holes out of order answered") && ok

    // With no memory: NO_MEMORY, and nothing to free.
    (rawptr(rawptr, mem.AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) empty_heap = (starved, nil)
    ref []u32 tn
    try tn = triangulate(sq[:], none) using empty_heap else code:
        ok = #expect(code == NO_MEMORY, "no memory code ", code) && ok
    defer #delete(tn)
    ok = #expect(tn == nil, "no memory answered") && ok

    return 0 if ok else 1
