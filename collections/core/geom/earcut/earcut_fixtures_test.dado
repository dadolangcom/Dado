@test
package earcut

// mapbox/earcut 3.2.4's own fixtures (ISC, Copyright (c) 2026 Mapbox): its
// triangle count, an FNV-1a hash of its index output, and its deviation bound.
// One hole start is written as a two-element array windowed to one, `h[..<1]`:
// a one-element array cannot be windowed (ERR0504).

private u32 fnv([]u32 xs):
    u32 h = 0x811c9dc5
    for v in xs:
        for k in 0..<4:
            h = (h ~ ((v >> (8 * k)) & 0xff)) * 0x01000193
    return h

private bool fixture(string8 name, []f64 v, []u32 holes, i64 want, u32 hash, f64 bound):
    try ref []u32 t = triangulate(v, holes) else code:
        return #expect(false, name, ": failed with ", code)
    defer #delete(t)
    bool ok = #expect(#len(t) == want * 3, name, ": ", #len(t) / 3, " triangles, want ", want)
    ok = #expect(fnv(t) == hash, name, ": indices differ from the reference") && ok
    if want > 0:
        f64 dev = deviation(v, holes, 2, t)
        ok = #expect(dev <= bound, name, ": deviation ", dev, " over ", bound) && ok
    return ok

