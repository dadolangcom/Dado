@test
package geom

import "line"
import "point"
import "rect"
import "polygon"
import "core:runtime"

    // // 1. Line-Line: Standard intersection
    // ([2]f32 pos, bool hit) = line.line_line_intersect(a0, a1, b0, b1)
    // ok = #expect(hit, "line_line should intersect") && ok
    // ok = #expect(pos.x == 0.0 && pos.y == 0.0, "line_line hit at wrong position: ", pos) && ok

    // // 2. Parallel Lines: No intersection
    // [2]f32 p0 = [0.0, 0.0]
    // [2]f32 p1 = [1.0, 1.0]
    // [2]f32 p2 = [0.0, 1.0]
    // [2]f32 p3 = [1.0, 2.0]
    // (_, hit) = line.line_line_intersect(p0, p1, p2, p3)
    // ok = #expect(!hit, "parallel lines should not intersect") && ok

i32 test():
    bool ok = true

    // `core:runtime`'s scratch is what replaced the old `context.temp`.
    // It is a library, so it has to be configured: `temp()` before
    // `init_scratch` is an allocator whose every request answers `nil`.
    _ = runtime.init_scratch(runtime.BLOCK, true)
    defer runtime.destroy_scratch()

    // ==========================================
    // 1. Line / Segment / Ray Intersections
    // ==========================================
    [2]f32 a0 = (-1.0, -1.0)
    [2]f32 a1 = (1.0, 1.0)
    [2]f32 b0 = (-1.0, 1.0)
    [2]f32 b1 = (1.0, -1.0)

    ([2]f32 pos1, bool hit1) = line.line_line_intersect(a0, a1, b0, b1)
    ok = #expect(hit1, "line_line should intersect") && ok
    ok = #expect(pos1.x == 0.0 && pos1.y == 0.0, "line_line hit at wrong position: ", pos1) && ok

    [2]f32 p0 = (0.0, 0.0)
    [2]f32 p1 = (1.0, 1.0)
    [2]f32 p2 = (0.0, 1.0)
    [2]f32 p3 = (1.0, 2.0)
    (_, bool hit2) = line.line_line_intersect(p0, p1, p2, p3)
    ok = #expect(!hit2, "parallel lines should not intersect") && ok

    ([2]f32 pos3, bool hit3) = line.segment_segment_intersect(a0, a1, b0, b1)
    ok = #expect(hit3, "segment_segment should hit") && ok
    ok = #expect(pos3.x == 0.0 && pos3.y == 0.0, "segment_segment hit wrong position: ", pos3) && ok

    [2]f32 s0 = (2.0, 2.0)
    [2]f32 s1 = (3.0, 3.0)
    (_, bool hit4) = line.segment_segment_intersect(s0, s1, b0, b1)
    ok = #expect(!hit4, "disjoint segments should not hit") && ok

    [2]f32 r0 = (-2.0, 0.0)
    [2]f32 r1 = (-1.0, 0.0)
    [2]f32 r2 = (0.0, -2.0)
    [2]f32 r3 = (0.0, -1.0)
    ([2]f32 pos5, bool hit5) = line.ray_ray_intersect(r0, r1, r2, r3)
    ok = #expect(hit5, "rays pointing at each other should hit") && ok
    ok = #expect(pos5.x == 0.0 && pos5.y == 0.0, "ray_ray hit wrong position: ", pos5) && ok

    [2]f32 r_away = (-3.0, 0.0)
    (_, bool hit6) = line.ray_ray_intersect(r0, r_away, r2, r3)
    ok = #expect(!hit6, "rays pointing away should not hit") && ok

    [2]f32 l0 = (-2.0, 0.0)
    [2]f32 l1 = (2.0, 0.0)
    [2]f32 seg0 = (0.0, -1.0)
    [2]f32 seg1 = (0.0, 1.0)
    ([2]f32 pos7, bool hit7) = line.line_segment_intersect(l0, l1, seg0, seg1)
    ok = #expect(hit7, "line_segment should hit") && ok
    ok = #expect(pos7.x == 0.0 && pos7.y == 0.0, "line_segment hit wrong position: ", pos7) && ok

    [2]f32 short_seg0 = (0.0, 1.0)
    [2]f32 short_seg1 = (0.0, 2.0)
    (_, bool hit8) = line.line_segment_intersect(l0, l1, short_seg0, short_seg1)
    ok = #expect(!hit8, "line should miss segment out of reach") && ok

    // ==========================================
    // 2. Point Containment & Distance Checks
    // ==========================================
    [2]f32 pt_on = (0.5, 0.5)
    [2]f32 pt_off = (0.5, 1.5)
    ok = #expect(point.point_on_line(pt_on, a0, a1, 0.001), "point_on_line should return true") && ok
    ok = #expect(!point.point_on_line(pt_off, a0, a1, 0.001), "point_on_line should return false") && ok

    [2]f32 t0 = (0.0, 0.0)
    [2]f32 t1 = (2.0, 0.0)
    [2]f32 t2 = (0.0, 2.0)
    [2]f32 in_tri = (0.5, 0.5)
    [2]f32 out_tri = (2.0, 2.0)
    ok = #expect(point.point_in_triangle(in_tri, t0, t1, t2, 0.001), "point_in_triangle inside") && ok
    ok = #expect(!point.point_in_triangle(out_tri, t0, t1, t2, 0.001), "point_in_triangle outside") && ok

    // ==========================================
    // 3. Rect Slicing & Operations
    // ==========================================
    [2]f32 rect_pos = (0.0, 0.0)
    [2]f32 rect_size = (10.0, 10.0)
    ok = #expect(rect.area(rect_pos, rect_size) == 100.0, "rect area should be 100") && ok
    ok = #expect(rect.perimeter(rect_pos, rect_size) == 40.0, "rect perimeter should be 40") && ok

    ([2][2]f32 left_rect, [2][2]f32 right_rect) = rect.vslice(rect_pos, rect_size, 3.0)
    ok = #expect(left_rect[1].x == 3.0, "vslice left width should be 3.0") && ok
    ok = #expect(right_rect[1].x == 7.0, "vslice right width should be 7.0") && ok

    // ==========================================
    // 4. Polygon Offset Verification
    // ==========================================
    auto poly = #make([][2]f32, 4, runtime.temp())
    defer #delete(poly)
    poly[0] = (0.0, 0.0)
    poly[1] = (2.0, 0.0)
    poly[2] = (2.0, 2.0)
    poly[3] = (0.0, 2.0)

    polygon.offset(poly, 1.0)
    ok = #expect(poly[0].x == -1.0 && poly[0].y == -1.0, "offset bottom-left should be (-1,-1)") && ok
    ok = #expect(poly[2].x == 3.0 && poly[2].y == 3.0, "offset top-right should be (3,3)") && ok

    // ==========================================
    // 5b. Rect type + number-generic toolkit
    // ==========================================
    // The same body against i32 cells (via the `Rect` alias and its
    // constructor) and against raw f32 pixels (no `Rect` involved — any
    // [2][2]number shape binds) — proving the receivers are genuinely
    // number-generic, not float-generic-only.
    rect.Rect ir = rect.rect(0, 0, 40, 10)
    ok = #expect(rect.rx(ir) == 0 && rect.ry(ir) == 0 && rect.rw(ir) == 40 && rect.rh(ir) == 10, "Rect ctor/accessors (i32)") && ok

    rect.Rect iins = rect.inset(ir, 2, 1)
    ok = #expect(rect.rx(iins) == 2 && rect.ry(iins) == 1 && rect.rw(iins) == 36 && rect.rh(iins) == 8, "inset (i32)") && ok

    rect.Rect img = rect.margin(ir, 2, 1, 2, 1)
    ok = #expect(rect.rw(img) == 36 && rect.rh(img) == 8, "margin (i32)") && ok

    rect.Rect isv = rect.stackv(ir, 2, 0, 1)
    ok = #expect(rect.rx(isv) == 0 && rect.ry(isv) == 5 && rect.rw(isv) == 40 && rect.rh(isv) == 5, "stackv (i32)") && ok

    rect.Rect ish = rect.stackh(rect.rect(0, 0, 40, 10), 4, 1, 1)
    ok = #expect(rect.rx(ish) == 10 && rect.rw(ish) == 9, "stackh (i32)") && ok

    rect.Rect igr = rect.grid(rect.rect(0, 0, 40, 20), 2, 2, 0, 0, 1, 1)
    ok = #expect(rect.rx(igr) == 20 && rect.ry(igr) == 10 && rect.rw(igr) == 20 && rect.rh(igr) == 10, "grid (i32)") && ok

    rect.Rect ial = rect.align_in(rect.rect(0, 0, 40, 10), 10, 2, rect.Align.End, rect.Align.Center)
    ok = #expect(rect.rx(ial) == 30 && rect.ry(ial) == 4, "align_in (i32)") && ok

    rect.Rect ice = rect.center_in(rect.rect(0, 0, 40, 10), 10, 2)
    ok = #expect(rect.rx(ice) == 15 && rect.ry(ice) == 4, "center_in (i32)") && ok

    // The exact same functions, at f32 pixel precision — no `Rect` alias in
    // sight, just a raw [2][2]f32 shape, and the identical arithmetic.
    [2][2]f32 fr = [[0.0, 0.0], [40.0, 10.0]]
    ok = #expect(rect.rx(fr) == 0.0 && rect.rw(fr) == 40.0, "raw [2][2]f32 accessors") && ok

    [2][2]f32 fins = rect.inset(fr, 2.0, 1.0)
    ok = #expect(fins[0].x == 2.0 && fins[0].y == 1.0 && fins[1].x == 36.0 && fins[1].y == 8.0, "inset (f32)") && ok

    // Float division does not truncate the way i32 division does — cell
    // width is 37.0/4 = 9.25, not the 9 the i32 case rounds down to. Same
    // formula, exact at this precision; that difference is the point of
    // going number-generic rather than staying i32-only.
    [2][2]f32 fsh = rect.stackh(fr, 4, 1, 1)
    ok = #expect(fsh[0].x == 10.25 && fsh[1].x == 9.25, "stackh (f32)") && ok

    [2][2]f32 fal = rect.align_in(fr, 10.0, 2.0, rect.Align.End, rect.Align.Center)
    ok = #expect(fal[0].x == 30.0 && fal[0].y == 4.0, "align_in (f32)") && ok

    // ==========================================
    // 5c. point.point_in_rect — number-generic containment
    // ==========================================
    [2]i32 ipt_in = (5, 5)
    [2]i32 ipt_out = (15, 5)
    [2]i32 izero = (0, 0)
    [2]i32 iten = (10, 10)
    ok = #expect(point.point_in_rect(ipt_in, izero, iten, 0), "point_in_rect inside (i32)") && ok
    ok = #expect(!point.point_in_rect(ipt_out, izero, iten, 0), "point_in_rect outside (i32)") && ok

    [2]f32 fpt_in = (5.0, 5.0)
    [2]f32 fzero = (0.0, 0.0)
    [2]f32 ften = (10.0, 10.0)
    ok = #expect(point.point_in_rect(fpt_in, fzero, ften, 0.0), "point_in_rect inside (f32)") && ok

    // ==========================================
    // 5. Generic Category Binder (f64 Precision)
    // ==========================================
    [2]f64 d_a0 = (-1.0, -1.0)
    [2]f64 d_a1 = (1.0, 1.0)
    [2]f64 d_b0 = (-1.0, 1.0)
    [2]f64 d_b1 = (1.0, -1.0)
    ([2]f64 d_pos, bool d_hit) = line.line_line_intersect(d_a0, d_a1, d_b0, d_b1)
    ok = #expect(d_hit, "f64 line_line should intersect") && ok
    ok = #expect(d_pos.x == 0.0 && d_pos.y == 0.0, "f64 hit wrong position") && ok

    if ok:
        return 0
    return 1
