package polygon

import "core:mem"
import "core:math"

// `core:math` exposes only `root`/`magnitude` publicly, and both take `f64`.
// These functions are generic over `float` (f32 or f64), so a scalar square
// root and absolute value are reached at f64 and converted back.
private $T rootf(T x) where T is float:
    return T(math.root(f64(x)))

private $T absf(T x) where T is float:
    return T(math.magnitude(f64(x)))

void offset(ref [][2]$T polygon, T dt) where T is float:
    i64 n = #len(polygon)
    if n < 3 || dt == 0.0:
        return

    // Allocate temporary space for the new vertex coordinates. `#default` is
    // an ordinary allocator, so `make` takes it directly and the run is
    // released at scope exit — the earlier `arena.begin(context.temp)` misread
    // an allocator as an `^Arena`, and that record is kept because the misread
    // is about what an `Allocator` *is*, which the respelling did not change.
    //
    // **`#default` and not `runtime.temp()`, deliberately.** `context.temp` is
    // retired and `core:runtime`'s scratch is what replaced it, but
    // this is a **library** function: naming the process scratch here would
    // make `offset` silently allocate nothing for any caller that had not run
    // `runtime.init_scratch`, and would couple a geometry routine to a global.
    // The ambient allocator is the caller's to choose, and a caller who wants
    // the scratch writes `using runtime.temp():` around the call — which is the
    // whole of what replaced the second context slot.
    auto temp = #make([][2]T, n, #default)
    defer #delete(temp)

    for i in 0..<n:
        i64 prev_i = (i + n - 1) % n
        i64 next_i = (i + 1) % n

        [2]T p_prev = polygon[prev_i]
        [2]T p_curr = polygon[i]
        [2]T p_next = polygon[next_i]

        // Direction vectors for incoming and outgoing edges
        [2]T d1 = p_curr - p_prev
        [2]T d2 = p_next - p_curr

        // Lengths of edges
        T len1 = rootf((d1.x * d1.x) + (d1.y * d1.y))
        T len2 = rootf((d2.x * d2.x) + (d2.y * d2.y))

        if len1 == 0.0 || len2 == 0.0:
            temp[i] = p_curr
            continue

        // Outward unit normal vectors for a CCW polygon: the right-hand normal
        // (dy, -dx). Positive `dt` therefore expands the polygon, which is what
        // an offset by a positive distance means.
        [2]T n1 = (d1.y / len1, -d1.x / len1)
        [2]T n2 = (d2.y / len2, -d2.x / len2)

        // Points along the offset lines
        [2]T l1_p = p_curr + (n1 * dt)
        [2]T l2_p = p_curr + (n2 * dt)

        // Intersect adjacent offset lines: l1_p + t*d1 = l2_p + u*d2
        T det = (d1.x * d2.y) - (d1.y * d2.x)

        if absf(det) < 0.00001:
            // Parallel edges: shift vertex directly by edge normal
            temp[i] = p_curr + (n1 * dt)
        else:
            [2]T dp = l2_p - l1_p
            T t = ((dp.x * d2.y) - (dp.y * d2.x)) / det
            temp[i] = l1_p + (d1 * t)

    // Write back updated points into the referenced polygon
    for i in 0..<n:
        polygon[i] = temp[i]

// A default of `#default` is not allowed — a parameter default must fold at
// compile time, and the ambient allocator is a runtime value, so
// writing one is `ERR0901`. The allocator is taken explicitly, as the rest of
// `core` does (e.g. `strings.clone_to_cstring`); pass `#default` at the call
// site for the ambient one.
ref [][2]$T offset_by([][2]T polygon, T dt, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc) where T is float:
    auto r = #copy(polygon, alloc)
    offset(r, dt)
    return r
