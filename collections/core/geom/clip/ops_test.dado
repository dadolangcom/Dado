@test
package clip

// The tesselator-backed operations at f32 and f64: booleans, triangulation
// and the welded union.

private bool near32(f32 a, f32 b):
    f32 d = a - b
    return d < 0.01 && d > -0.01

private bool near(f64 a, f64 b):
    f64 d = a - b
    return d < 0.000000001 && d > -0.000000001

private f32 set_area32(^Contours(f32) c):
    f32 total = 0.0
    for k in 0..<count(c):
        total += area(contour(c, k))
    return total

private f64 set_area(^Contours(f64) c):
    f64 total = 0.0
    for k in 0..<count(c):
        total += signed_area(contour(c, k))
    return total

private f32 tri_area([3][2]f32 t):
    f32 a = 0.5 * ((t[1].x - t[0].x) * (t[2].y - t[0].y) - (t[2].x - t[0].x) * (t[1].y - t[0].y))
    return -a if a < 0.0 else a

private bool triangulate_both():
    bool ok = true
    [4][2]f32 sq = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (0.0, 2.0)]
    try ref [][3][2]f32 tris = triangulate(sq[:]) else:
        return false
    defer #delete(tris)
    f32 total = 0.0
    for t in tris:
        total += tri_area(t)
    ok = #expect(#len(tris) >= 1, "produced triangles") && ok
    ok = #expect(near32(total, 4.0), "triangulated area preserved: ", total) && ok

    try ref [][3][2]f32 fast = triangulate(sq[:], Mode.Fast) else:
        return false
    defer #delete(fast)
    f32 ftotal = 0.0
    for t in fast:
        ftotal += tri_area(t)
    ok = #expect(near32(ftotal, 4.0), "fast (earcut) area preserved: ", ftotal) && ok
    return ok

private bool booleans():
    bool ok = true
    [8][2]f32 ab = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (0.0, 2.0), (1.0, 1.0), (3.0, 1.0), (3.0, 3.0), (1.0, 3.0)]
    [2]u32 two = [0, 4]
    Contours(f32) u
    try union_polygon(ab[:], two[:], &u) else:
        return false
    defer release(&u)
    ok = #expect(near32(set_area32(&u), 7.0), "union area 7: ", set_area32(&u)) && ok
    Contours(f32) x
    try intersect(ab[:], two[:], &x) else:
        return false
    defer release(&x)
    ok = #expect(near32(set_area32(&x), 1.0), "intersect area 1: ", set_area32(&x)) && ok
    Contours(f32) d
    try difference(ab[:], two[:], &d) else:
        return false
    defer release(&d)
    ok = #expect(near32(set_area32(&d), 3.0), "difference area 3: ", set_area32(&d)) && ok
    Contours(f32) xr
    try xor(ab[:], two[:], &xr) else:
        return false
    defer release(&xr)
    ok = #expect(near32(set_area32(&xr), 6.0), "xor area 6: ", set_area32(&xr)) && ok
    return ok

// Two unit squares a hair apart: the weld closes the seam into one outline
// of four corners; a plain union, or a gap wider than the fuzz, does not.
private bool fuzzy():
    bool ok = true
    [8][2]f64 pair = [(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0), (1.0000001, 0.0), (2.0, 0.0), (2.0, 1.0), (1.0000001, 1.0)]
    [2]u32 two = [0, 4]

    Contours(f64) plain
    try union_polygon(pair[:], two[:], &plain) else:
        return false
    defer release(&plain)
    ok = #expect(count(&plain) == 2, "a plain union leaves the seam: ", count(&plain)) && ok

    Contours(f64) welded
    try union_fuzzy(pair[:], two[:], 0.0001, &welded) else:
        return false
    defer release(&welded)
    ok = #expect(count(&welded) == 1, "welded: one outline, got ", count(&welded)) && ok
    ok = #expect(#len(welded.points) == 4, "the seam's collinear splits are simplified away: ", #len(welded.points)) && ok
    ok = #expect(near(set_area(&welded), 2.0), "welded area 2: ", set_area(&welded)) && ok

    Contours(f64) zero
    try union_fuzzy(pair[:], two[:], 0.0, &zero) else:
        return false
    defer release(&zero)
    ok = #expect(count(&zero) == 2, "fuzz 0 is a plain union: ", count(&zero)) && ok

    [8][2]f64 apart = [(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0), (1.01, 0.0), (2.0, 0.0), (2.0, 1.0), (1.01, 1.0)]
    Contours(f64) gap
    try union_fuzzy(apart[:], two[:], 0.0001, &gap) else:
        return false
    defer release(&gap)
    ok = #expect(count(&gap) == 2, "a gap wider than the fuzz stays: ", count(&gap)) && ok

    // A seam a hundredth of the fuzz wide, at f32.
    [8][2]f32 noisy = [(0.0, 0.0), (0.29999, 0.0), (0.29999, 1.0), (0.0, 1.0), (0.3, 0.0), (1.0, 0.0), (1.0, 1.0), (0.3, 1.0)]
    Contours(f32) n
    try union_fuzzy(noisy[:], two[:], 0.001, &n) else:
        return false
    defer release(&n)
    ok = #expect(count(&n) == 1 && #len(n.points) == 4, "an f32 seam welds: ", count(&n), " / ", #len(n.points)) && ok
    ok = #expect(near32(set_area32(&n), 1.0), "f32 welded area 1: ", set_area32(&n)) && ok
    return ok

// Snapping rounds halves away from zero, on both sides of zero.
private bool snapping():
    bool ok = #expect(snap(0.25, 0.5) == 0.5 && snap(-0.25, 0.5) == -0.5, "halves round away: ", snap(-0.25, 0.5))
    ok = #expect(snap(1.2, 0.5) == 1.0 && snap(-1.3, 0.5) == -1.5, "nearest multiple: ", snap(-1.3, 0.5)) && ok
    return ok

i32 test():
    bool ok = true
    ok = triangulate_both() && ok
    ok = booleans() && ok
    ok = fuzzy() && ok
    ok = snapping() && ok
    return 0 if ok else 1
