@test
package clip

// The set operations and the set triangulation at f64, by area, and the
// failure codes.

import "core:mem"
import earcut "../earcut"
import tess "../tess"

private f64 ring_area([][2]f64 r):
    f64 a = 0.0
    i64 n = #len(r)
    for i in 0..<n:
        [2]f64 p = r[i]
        [2]f64 q = r[(i + 1) % n]
        a += p.x * q.y - q.x * p.y
    return a * 0.5

// Signed: holes subtract.
private f64 set_area(^Contours(f64) c):
    f64 a = 0.0
    for k in 0..<count(c):
        a += ring_area(contour(c, k))
    return a

private bool near(f64 a, f64 b):
    f64 d = a - b
    return d < 0.000001 && d > -0.000001

private f64 tri_area([3][2]f64 t):
    return 0.5 * ((t[1].x - t[0].x) * (t[2].y - t[0].y) - (t[2].x - t[0].x) * (t[1].y - t[0].y))

// Ring starts that do not increase, or run past the points, fail MALFORMED;
// earcut and tess give each cause the same code.
private bool failures():
    bool ok = #expect(earcut.MALFORMED == tess.MALFORMED && earcut.NO_MEMORY == tess.NO_MEMORY, "earcut and tess codes agree")
    [8][2]f64 ab = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (0.0, 2.0), (1.0, 1.0), (3.0, 1.0), (3.0, 3.0), (1.0, 3.0)]
    [2]u32 backwards = [4, 0]
    [2]u32 past = [0, 9]
    i32 got = 0
    Contours(f64) u
    try union_polygon(ab[:], backwards[:], &u) else code:
        got = code
    release(&u)
    ok = #expect(got == tess.MALFORMED, "starts out of order: MALFORMED, got ", got) && ok
    got = 0
    Contours(f64) v
    try boundary(ab[:], past[:], tess.Winding.Odd, &v) else code:
        got = code
    release(&v)
    ok = #expect(got == tess.MALFORMED, "a start past the end: MALFORMED, got ", got) && ok
    got = 0
    ref [][3][2]f64 tris
    try tris = triangulate_polygons(ab[:], past[:]) else code:
        got = code
    #delete(tris)
    ok = #expect(got == tess.MALFORMED, "triangulate_polygons, a start past the end: MALFORMED, got ", got) && ok
    return ok

// An allocator with nothing to give: every request answers nil.
private rawptr starved(rawptr data, mem.AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

// With no memory, the set operations, triangulation and simplify fail NO_MEMORY
// and leave nothing to free.
private bool out_of_memory():
    [8][2]f64 ab = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (0.0, 2.0), (1.0, 1.0), (3.0, 1.0), (3.0, 3.0), (1.0, 3.0)]
    [2]u32 two = [0, 4]
    (rawptr(rawptr, mem.AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) none = (starved, nil)
    i32 got = 0
    Contours(f64) u
    try union_polygon(ab[:], two[:], &u) using none else code:
        got = code
    bool ok = #expect(got == tess.NO_MEMORY && u.points == nil && u.starts == nil, "union with no memory: NO_MEMORY, got ", got)
    release(&u)
    got = 0
    ref [][3][2]f64 tris
    try tris = triangulate(ab[..<4], Mode.Fast) using none else code:
        got = code
    ok = #expect(got == tess.NO_MEMORY && tris == nil, "earcut with no memory: NO_MEMORY, got ", got) && ok
    #delete(tris)
    got = 0
    ref [][2]f64 kept
    try kept = simplify(ab[:], 0.1) using none else code:
        got = code
    ok = #expect(got == tess.NO_MEMORY && kept == nil, "simplify with no memory: NO_MEMORY, got ", got) && ok
    #delete(kept)
    return ok

i32 test():
    bool ok = true
    // [0,2]^2 and [1,3]^2 overlap on [1,2]^2.
    [8][2]f64 ab = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (0.0, 2.0), (1.0, 1.0), (3.0, 1.0), (3.0, 3.0), (1.0, 3.0)]
    [2]u32 two = [0, 4]

    Contours(f64) u
    try union_polygon(ab[:], two[:], &u) else code:
        _ = #expect(false, "union failed: ", code)
        return 1
    defer release(&u)
    ok = #expect(count(&u) == 1, "union: one contour, got ", count(&u)) && ok
    ok = #expect(near(set_area(&u), 7.0), "union area 7, got ", set_area(&u)) && ok
    ok = #expect(#len(u.points) == 8, "union: 8 vertices, got ", #len(u.points)) && ok

    Contours(f64) x
    try intersect(ab[:], two[:], &x) else:
        return 1
    defer release(&x)
    ok = #expect(near(set_area(&x), 1.0), "intersect area 1, got ", set_area(&x)) && ok

    Contours(f64) d
    try difference(ab[:], two[:], &d) else:
        return 1
    defer release(&d)
    ok = #expect(near(set_area(&d), 3.0), "difference area 3, got ", set_area(&d)) && ok

    Contours(f64) xr
    try xor(ab[:], two[:], &xr) else:
        return 1
    defer release(&xr)
    ok = #expect(near(set_area(&xr), 6.0), "xor area 6, got ", set_area(&xr)) && ok
    ok = #expect(count(&xr) == 2, "xor: two pieces, got ", count(&xr)) && ok

    // Triangulate the square: area kept, every triangle CCW.
    try ref [][3][2]f64 tris = triangulate_polygons(ab[..<4], two[..<0]) else:
        return 1
    defer #delete(tris)
    f64 total = 0.0
    for t in tris:
        total += tri_area(t)
        ok = #expect(tri_area(t) > 0.0, "triangle wound CCW: ", t) && ok
    ok = #expect(#len(tris) == 2, "square: two triangles, got ", #len(tris)) && ok
    ok = #expect(near(total, 4.0), "triangulated area 4, got ", total) && ok

    ok = failures() && ok
    ok = out_of_memory() && ok
    return 0 if ok else 1
