// The set operations over the tesselator. Points go in at their own width
// and the tesselator works in f64; answers are written back at T.
package clip

import tess "../tess"

// Ring k of the set; no starts is one ring.
private [][2]$T part([][2]T points, []u32 starts, i64 k) where T is float:
    if #len(starts) == 0:
        return points
    i64 lo = i64(starts[k])
    i64 hi = #len(points)
    if k + 1 < #len(starts):
        hi = i64(starts[k + 1])
    return points[lo..<hi]

private i64 part_count([][2]$T points, []u32 starts) where T is float:
    if #len(starts) == 0:
        return 0 if #len(points) == 0 else 1
    return #len(starts)

private !void add_set(^tess.Tess t, [][2]$T points, []u32 starts) where T is float:
    i64 last = -1
    for s in starts:
        if i64(s) <= last || i64(s) > #len(points):
            fail tess.MALFORMED
        last = i64(s)
    for k in 0..<part_count(points, starts):
        try tess.add_points(t, part(points, starts, k))

// Copies the boundary output of `t` into `out` at T, on `#default`.
private !void take_contours(^tess.Tess t, ^Contours($T) out) where T is float:
    i64 n = i64(t.element_count)
    try out.points = #make([][2]T, i64(t.vertex_count)) else tess.NO_MEMORY
    out.starts = #make([]u32, n)
    if out.starts == nil:
        #delete(out.points)
        fail tess.NO_MEMORY
    for i in 0..<i64(t.vertex_count):
        out.points[i] = (T(t.vertices[2 * i]), T(t.vertices[2 * i + 1]))
    for k in 0..<n:
        out.starts[k] = u32(t.elements[2 * k])

// The boundary of the region `rule` keeps, over every ring of the set.
private !void boundary_of([][2]$T points, []u32 starts, tess.Winding rule, ^Contours(T) out) where T is float:
    tess.Tess t
    tess.init(&t)
    defer tess.destroy(&t)
    try add_set(&t, points, starts)
    try tess.tesselate(&t, rule, tess.Element.Boundary_Contours, 3, 2)
    try take_contours(&t, out)

// The first ring minus every other. Exact when the cutters do not overlap
// each other; where they do, the cut is built with the covered-twice rule.
private !void difference_of([][2]$T points, []u32 starts, ^Contours(T) out) where T is float:
    if part_count(points, starts) < 2:
        return
    tess.Tess t
    tess.init(&t)
    defer tess.destroy(&t)
    try add_set(&t, points, starts)
    try tess.tesselate(&t, tess.Winding.Abs_Geq_Two, tess.Element.Boundary_Contours, 3, 2)
    Contours(f64) cut
    try take_contours(&t, &cut)
    defer release(&cut)

    // The cut, reversed, subtracts from the subject.
    for k in 0..<count(&cut):
        [][2]f64 c = contour(&cut, k)
        i64 n = #len(c)
        for i in 0..<n / 2:
            [2]f64 tmp = c[i]
            c[i] = c[n - 1 - i]
            c[n - 1 - i] = tmp
    try tess.add_points(&t, part(points, starts, 0))
    for k in 0..<count(&cut):
        try tess.add_points(&t, contour(&cut, k))
    try tess.tesselate(&t, tess.Winding.Nonzero, tess.Element.Boundary_Contours, 3, 2)
    try take_contours(&t, out)

// Triangles covering the odd-winding region of the set, at T on `#default`.
private !ref [][3][2]$T triangles_of([][2]T points, []u32 starts) where T is float:
    tess.Tess t
    tess.init(&t)
    defer tess.destroy(&t)
    try add_set(&t, points, starts)
    try tess.tesselate(&t, tess.Winding.Odd, tess.Element.Polygons, 3, 2)
    i64 n = i64(t.element_count)
    try ref [][3][2]T out = #make([][3][2]T, n) else tess.NO_MEMORY
    for i in 0..<n:
        for j in 0..<3:
            i32 idx = t.elements[i * 3 + j]
            if idx != tess.UNDEF:
                out[i][j] = (T(t.vertices[2 * i64(idx)]), T(t.vertices[2 * i64(idx) + 1]))
    return out
