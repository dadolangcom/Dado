@test
package hit

private type V3: [3]f64
private type F3: [3]f32

private bool near(f64 a, f64 b):
    f64 d = a - b
    return d < 0.000001 && d > -0.000001

private bool near3([3]f64 a, [3]f64 b):
    return near(a.x, b.x) && near(a.y, b.y) && near(a.z, b.z)

private bool test_ray_aabb():
    bool ok = true
    [3]f64 lo = (0.0, 0.0, 0.0)
    [3]f64 hi = (1.0, 1.0, 1.0)

    [3]f64 o = (-1.0, 0.5, 0.5)
    (f64 t0, f64 t1, bool h) = ray_aabb(o, inverse_dir(V3((1.0, 0.0, 0.0))), lo, hi, 100.0)
    ok = #expect(h && near(t0, 1.0) && near(t1, 2.0), "aabb along x: ", t0, " ", t1, " ", h) && ok

    // Pointing away.
    (_, _, h) = ray_aabb(o, inverse_dir(V3((-1.0, 0.0, 0.0))), lo, hi, 100.0)
    ok = #expect(!h, "aabb behind") && ok

    // t_max short of the box.
    (_, _, h) = ray_aabb(o, inverse_dir(V3((1.0, 0.0, 0.0))), lo, hi, 0.5)
    ok = #expect(!h, "aabb past t_max") && ok

    // Origin inside: entry clipped to 0.
    [3]f64 inside_o = (0.5, 0.5, 0.5)
    (t0, t1, h) = ray_aabb(inside_o, inverse_dir(V3((0.0, 1.0, 0.0))), lo, hi, 100.0)
    ok = #expect(h && near(t0, 0.0) && near(t1, 0.5), "aabb from inside: ", t0, " ", t1) && ok

    // Grazing along a face plane, direction parallel to it: counts.
    [3]f64 face = (-1.0, 1.0, 0.5)
    (t0, t1, h) = ray_aabb(face, inverse_dir(V3((1.0, 0.0, 0.0))), lo, hi, 100.0)
    ok = #expect(h && near(t0, 1.0) && near(t1, 2.0), "aabb on face plane: ", t0, " ", t1, " ", h) && ok

    // From the far side.
    [3]f64 far_o = (2.0, 0.5, 0.5)
    (t0, t1, h) = ray_aabb(far_o, inverse_dir(V3((-1.0, 0.0, 0.0))), lo, hi, 100.0)
    ok = #expect(h && near(t0, 1.0) && near(t1, 2.0), "aabb from +x: ", t0, " ", t1, " ", h) && ok

    // Parallel and outside a slab.
    [3]f64 above = (-1.0, 1.5, 0.5)
    (_, _, h) = ray_aabb(above, inverse_dir(V3((1.0, 0.0, 0.0))), lo, hi, 100.0)
    ok = #expect(!h, "aabb parallel outside") && ok

    // Diagonal, f32.
    [3]f32 o32 = (-1.0, -1.0, -1.0)
    [3]f32 lo32 = (0.0, 0.0, 0.0)
    [3]f32 hi32 = (1.0, 1.0, 1.0)
    (f32 s0, f32 s1, bool h32) = ray_aabb(o32, inverse_dir(F3((1.0, 1.0, 1.0))), lo32, hi32, f32(10.0))
    ok = #expect(h32 && near(f64(s0), 1.0) && near(f64(s1), 2.0), "aabb diagonal f32: ", s0, " ", s1) && ok
    return ok

private bool test_ray_triangle():
    bool ok = true
    // Counter-clockwise seen from +z.
    [3]f64 a = (0.0, 0.0, 0.0)
    [3]f64 b = (1.0, 0.0, 0.0)
    [3]f64 c = (0.0, 1.0, 0.0)
    [3]f64 down = (0.0, 0.0, -1.0)
    [3]f64 up = (0.0, 0.0, 1.0)

    [3]f64 o = (0.25, 0.25, 2.0)
    (f64 t, f64 u, f64 v, bool h) = ray_triangle(o, down, a, b, c, false)
    ok = #expect(h && near(t, 2.0) && near(u, 0.25) && near(v, 0.25), "tri front: ", t, " ", u, " ", v, " ", h) && ok
    [3]f64 at = o + down * t
    ok = #expect(near3(at, a * (1.0 - u - v) + b * u + c * v), "tri barycentrics rebuild the point") && ok

    // From below it is a back face.
    [3]f64 below = (0.25, 0.25, -2.0)
    (_, _, _, h) = ray_triangle(below, up, a, b, c, false)
    ok = #expect(!h, "tri back face, one-sided") && ok
    (t, _, _, h) = ray_triangle(below, up, a, b, c, true)
    ok = #expect(h && near(t, 2.0), "tri back face, two-sided: ", t) && ok

    // Outside, behind, parallel.
    [3]f64 miss = (0.75, 0.75, 2.0)
    (_, _, _, h) = ray_triangle(miss, down, a, b, c, true)
    ok = #expect(!h, "tri outside the hypotenuse") && ok
    (_, _, _, h) = ray_triangle(o, up, a, b, c, true)
    ok = #expect(!h, "tri behind the origin") && ok
    [3]f64 side = (-1.0, 0.25, 0.0)
    [3]f64 along = (1.0, 0.0, 0.0)
    (_, _, _, h) = ray_triangle(side, along, a, b, c, true)
    ok = #expect(!h, "tri parallel") && ok

    // An edge counts; a vertex counts.
    [3]f64 on_edge = (0.5, 0.0, 1.0)
    (_, _, _, h) = ray_triangle(on_edge, down, a, b, c, false)
    ok = #expect(h, "tri on an edge") && ok
    (_, _, _, h) = ray_triangle(c + up, down, a, b, c, false)
    ok = #expect(h, "tri on a vertex") && ok
    return ok

private bool test_plane_sphere():
    bool ok = true
    // The floor, y == 0, Y-up.
    [3]f64 n = (0.0, 1.0, 0.0)
    [3]f64 eye = (1.0, 2.0, 3.0)
    [3]f64 dir = (0.0, -2.0, 0.0)
    (f64 t, bool h) = ray_plane(eye, dir, n, 0.0)
    ok = #expect(h && near(t, 1.0), "plane: ", t) && ok
    (_, h) = ray_plane(eye, (0.0, 1.0, 0.0), n, 0.0)
    ok = #expect(!h, "plane behind") && ok
    (_, h) = ray_plane(eye, (1.0, 0.0, 0.0), n, 0.0)
    ok = #expect(!h, "plane parallel") && ok
    (t, h) = ray_plane(eye, dir, n, 0.5)
    ok = #expect(h && near(t, 0.75), "plane offset: ", t) && ok

    [3]f64 center = (0.0, 0.0, 0.0)
    [3]f64 o = (-5.0, 0.0, 0.0)
    (t, h) = ray_sphere(o, (1.0, 0.0, 0.0), center, 1.0)
    ok = #expect(h && near(t, 4.0), "sphere: ", t) && ok
    (t, h) = ray_sphere(o, (2.0, 0.0, 0.0), center, 1.0)
    ok = #expect(h && near(t, 2.0), "sphere, unnormalised dir: ", t) && ok
    (t, h) = ray_sphere(center, (0.0, 0.0, 1.0), center, 1.0)
    ok = #expect(h && near(t, 1.0), "sphere from inside: ", t) && ok
    (_, h) = ray_sphere(o, (-1.0, 0.0, 0.0), center, 1.0)
    ok = #expect(!h, "sphere behind") && ok
    (_, h) = ray_sphere((-5.0, 1.5, 0.0), (1.0, 0.0, 0.0), center, 1.0)
    ok = #expect(!h, "sphere passes by") && ok
    (t, h) = ray_sphere((-5.0, 1.0, 0.0), (1.0, 0.0, 0.0), center, 1.0)
    ok = #expect(h && near(t, 5.0), "sphere tangent: ", t) && ok
    return ok

private bool test_aabb():
    bool ok = true
    [3]f64 lo = (0.0, 0.0, 0.0)
    [3]f64 hi = (1.0, 1.0, 1.0)
    ok = #expect(aabb_aabb(lo, hi, (1.0, 0.5, 0.5), (2.0, 2.0, 2.0)), "aabb touching overlaps") && ok
    ok = #expect(!aabb_aabb(lo, hi, (1.1, 0.5, 0.5), (2.0, 2.0, 2.0)), "aabb apart") && ok
    [2]i32 ilo = (0, 0)
    [2]i32 ihi = (4, 4)
    ok = #expect(aabb_aabb(ilo, ihi, (2, 2), (8, 8)), "aabb i32") && ok
    return ok

// Every generic function at f32, the width bvh and its callers use, beside the f64 cases above.
private bool test_f32():
    bool ok = true
    F3 a = (0.0, 0.0, 0.0)
    F3 b = (1.0, 0.0, 0.0)
    F3 c = (0.0, 1.0, 0.0)
    F3 o = (0.25, 0.25, 2.0)
    F3 down = (0.0, 0.0, -1.0)
    (f32 t, f32 u, f32 v, bool h) = ray_triangle(o, down, a, b, c, false)
    ok = #expect(h && t == 2.0 && u == 0.25 && v == 0.25, "f32 triangle: ", t, " ", u, " ", v) && ok
    F3 up = (0.0, 0.0, 1.0)
    (t, h) = ray_plane(o, down, up, f32(0.0))
    ok = #expect(h && t == 2.0, "f32 plane: ", t) && ok
    (t, h) = ray_sphere(F3((-5.0, 0.0, 0.0)), F3((1.0, 0.0, 0.0)), a, f32(1.0))
    ok = #expect(h && t == 4.0, "f32 sphere: ", t) && ok
    [2]i64 llo = (0, 0)
    [2]i64 lhi = (4, 4)
    ok = #expect(aabb_aabb(llo, lhi, (4, 4), (8, 8)) && !aabb_aabb(llo, lhi, (5, 0), (8, 8)), "aabb i64") && ok
    [2]f32 flo = (0.0, 0.0)
    [2]f32 fhi = (1.0, 1.0)
    ok = #expect(!aabb_aabb(flo, fhi, (1.5, 0.0), (2.0, 1.0)), "aabb f32") && ok
    return ok

i32 test():
    bool ok = test_ray_aabb()
    ok = test_f32() && ok
    ok = test_ray_triangle() && ok
    ok = test_plane_sphere() && ok
    ok = test_aabb() && ok
    return 0 if ok else 1
