// Ray and box tests for picking and collision, in 3D.
//
//     [3]f64 a = (0.0, 0.0, 0.0)
//     [3]f64 b = (1.0, 0.0, 0.0)
//     [3]f64 c = (0.0, 1.0, 0.0)
//     (f64 t, f64 u, f64 v, bool hit) = hit.ray_triangle((0.25, 0.25, 2.0), (0.0, 0.0, -1.0), a, b, c, false)
//     // hit: t = 2, u = 0.25, v = 0.25
//
// The ray tests are generic over f32 and f64. A ray is an origin and a direction that need not be
// unit length, and every t answered is in units of that direction. Each test is exact at its
// boundary, with no tolerance, and a boundary point counts as a hit. The 2D segment and point
// tests are in core:geom/line and core:geom/point.
package hit

import "core:linalg"
import "core:math"

#static_assert(#OS != #NONE, "core:geom/hit needs core:math and core:linalg, which take their square root from the C library, and a #NONE target has none")

// Where the ray origin + t * dir enters and leaves the box [lo, hi] (the slab test), clipped
// to [0, t_max]. `inv_dir` is `inverse_dir(dir)`, computed once per ray. A ray lying in a face
// plane counts as inside. hit is false when the clipped interval is empty.
#assert_raises
($T t_near, T t_far, bool hit) ray_aabb([3]T origin, [3]T inv_dir, [3]T lo, [3]T hi, T t_max) where T is float:
    T t0 = 0.0
    T t1 = t_max
    for i in 0..<3:
        T a = (lo[i] - origin[i]) * inv_dir[i]
        T b = (hi[i] - origin[i]) * inv_dir[i]
        if a > b:
            T s = a
            a = b
            b = s
        // A NaN (origin on the plane, direction along it) constrains nothing.
        if a > t0: t0 = a
        if b < t1: t1 = b
    return (t0, t1, t0 <= t1)

// 1 / dir per component, for `ray_aabb`. A zero component answers an infinity of its sign.
#assert_raises
[3]$T inverse_dir([3]T dir) where T is float:
    T one = 1.0
    return (one / dir[0], one / dir[1], one / dir[2])

// Where the ray origin + t * dir meets triangle a, b, c (Moller-Trumbore): t >= 0, and the
// weights u of b and v of c, so the point is a * (1 - u - v) + b * u + c * v. Front faces are
// counter-clockwise seen from the origin; with `two_sided` false a back face misses. A ray in the
// triangle's plane misses. A miss answers zeros and hit false.
#assert_raises
($T t, T u, T v, bool hit) ray_triangle([3]T origin, [3]T dir, [3]T a, [3]T b, [3]T c, bool two_sided) where T is float:
    T zero = 0.0
    [3]T e1 = b - a
    [3]T e2 = c - a
    [3]T p = linalg.cross(dir, e2)
    T det = linalg.dot(e1, p)
    if det == 0.0 || (!two_sided && det < 0.0):
        return (zero, zero, zero, false)
    T inv = 1.0 / det
    [3]T s = origin - a
    T u = linalg.dot(s, p) * inv
    if u < 0.0 || u > 1.0:
        return (zero, zero, zero, false)
    [3]T q = linalg.cross(s, e1)
    T v = linalg.dot(dir, q) * inv
    if v < 0.0 || u + v > 1.0:
        return (zero, zero, zero, false)
    T t = linalg.dot(e2, q) * inv
    if t < 0.0:
        return (zero, zero, zero, false)
    return (t, u, v, true)

// Where the ray origin + t * dir meets the plane dot(normal, x) == offset, with t >= 0. A ray
// parallel to the plane, or pointing away from it, misses: (0, false).
#assert_raises
($T t, bool hit) ray_plane([3]T origin, [3]T dir, [3]T normal, T offset) where T is float:
    T zero = 0.0
    T den = linalg.dot(normal, dir)
    if den == 0.0:
        return (zero, false)
    T t = (offset - linalg.dot(normal, origin)) / den
    if t < 0.0:
        return (zero, false)
    return (t, true)

// The first t >= 0 where the ray origin + t * dir meets the sphere: the entry, or the exit when
// the origin is inside. A zero `dir`, or a ray that passes by, misses: (0, false).
($T t, bool hit) ray_sphere([3]T origin, [3]T dir, [3]T center, T radius) where T is float:
    T zero = 0.0
    [3]T m = origin - center
    T a = linalg.dot(dir, dir)
    T b = linalg.dot(m, dir)
    T c = linalg.dot(m, m) - radius * radius
    if a == 0.0:
        return (zero, false)
    T disc = b * b - a * c
    if disc < 0.0:
        return (zero, false)
    T root = T(math.root(f64(disc)))
    T t = (0.0 - b - root) / a
    if t < 0.0:
        t = (0.0 - b + root) / a
    if t < 0.0:
        return (zero, false)
    return (t, true)

// Whether boxes [alo, ahi] and [blo, bhi] overlap, touching included, in any dimension.
#assert_raises
bool aabb_aabb([$N]$T alo, [N]T ahi, [N]T blo, [N]T bhi) where T is scalar:
    for i in 0..<N:
        if ahi[i] < blo[i] || bhi[i] < alo[i]:
            return false
    return true
