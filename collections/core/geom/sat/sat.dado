// Separating-axis tests for convex polygons in 2D: whether two overlap, and the shortest push that
// separates them.
//
//     [4][2]f64 a = [(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0)]
//     [4][2]f64 b = [(0.75, 0.0), (1.75, 0.0), (1.75, 1.0), (0.75, 1.0)]
//     ([2]f64 dir, f64 depth, bool hit) = sat.mtv(a[:], b[:], 0.0)
//     // hit: dir = (-1, 0), depth = 0.25
//
// A polygon is a run of points in either winding, implicitly closed; one point is a point and two
// are a segment. The axes tested are the edge normals of both shapes. `tol` is the overlap that
// still counts as apart: 0 makes touching apart, a positive value ignores grazing contact, and a
// negative one asks for clearance. A concave shape goes in as convex parts (`overlap_parts`,
// `mtv_parts`). Every function is generic over f32 and f64.
package sat

import "core:linalg"

#static_assert(#OS != #NONE, "core:geom/sat needs core:linalg, which takes its square root from the C library, and a #NONE target has none")

// Whether convex polygons `a` and `b` overlap by more than `tol`. O((n + m)^2) for n and m
// points.
bool overlap([][2]$T a, [][2]T b, T tol) where T is float:
    (_, _, bool hit) = mtv(a, b, tol)
    return hit

// The minimum translation vector of convex polygons `a` and `b`: moving `a` by dir * depth
// leaves it touching `b`. `dir` is unit length, or zero when neither shape has an edge. hit is
// depth > tol. When the shapes are apart, depth is negative: minus the widest gap along any axis.
// O((n + m)^2) for n and m points.
([2]$T dir, T depth, bool hit) mtv([][2]T a, [][2]T b, T tol) where T is float:
    [2]T best_dir = (0.0, 0.0)
    T best = 0.0
    bool any = false
    for pass in 0..<2:
        [][2]T p = a if pass == 0 else b
        i64 n = #len(p)
        for i in 0..<n:
            [2]T e = p[(i + 1) % n] - p[i]
            T len = linalg.length(e)
            if len == 0.0:
                continue
            [2]T axis = (e.y / len, (0.0 - e.x) / len)
            (T alo, T ahi) = project(a, axis)
            (T blo, T bhi) = project(b, axis)
            // The push along +axis, and along -axis; the shorter wins.
            T up = bhi - alo
            T down = ahi - blo
            T d = up if up < down else down
            if !any || d < best:
                any = true
                best = d
                best_dir = axis if up < down else -axis
    return (best_dir, best, any && best > tol)

private ($T lo, T hi) project([][2]T p, [2]T axis) where T is float:
    T lo = 0.0
    T hi = 0.0
    for q, i in p:
        T s = q.x * axis.x + q.y * axis.y
        if i == 0 || s < lo: lo = s
        if i == 0 || s > hi: hi = s
    return (lo, hi)

private [4][2]$T corners([2]T lo, [2]T hi) where T is float:
    return [lo, (hi.x, lo.y), hi, (lo.x, hi.y)]

// Whether convex polygon `a` overlaps the axis-aligned box [lo, hi] by more than `tol`: `overlap`
// with the box as the second shape.
bool overlap_box([][2]$T a, [2]T lo, [2]T hi, T tol) where T is float:
    [4][2]T box = corners(lo, hi)
    return overlap(a, box[:], tol)

// `mtv` of convex polygon `a` against the axis-aligned box [lo, hi]: moving `a` by dir * depth
// leaves it touching the box.
([2]$T dir, T depth, bool hit) mtv_box([][2]T a, [2]T lo, [2]T hi, T tol) where T is float:
    [4][2]T box = corners(lo, hi)
    return mtv(a, box[:], tol)

// Part k of a parts set is points[starts[k] ..< starts[k + 1]], the last
// running to the end; no starts is one part.
private [][2]$T part([][2]T points, []u32 starts, i64 k) where T is float:
    if #len(starts) == 0:
        return points
    i64 lo = i64(starts[k])
    i64 hi = #len(points)
    if k + 1 < #len(starts):
        hi = i64(starts[k + 1])
    return points[lo..<hi]

private i64 part_count([]u32 starts):
    return 1 if #len(starts) == 0 else #len(starts)

// Whether any convex part of `a` overlaps any convex part of `b` by more than `tol`. A parts set
// is a run of points and the index each part starts at: part k is points[starts[k] ..< starts[k + 1]],
// the last part runs to the end, and an empty `starts` makes the whole run one part.
bool overlap_parts([][2]$T a, []u32 a_starts, [][2]T b, []u32 b_starts, T tol) where T is float:
    for i in 0..<part_count(a_starts):
        for j in 0..<part_count(b_starts):
            if overlap(part(a, a_starts, i), part(b, b_starts, j), tol):
                return true
    return false

// One push that separates every overlapping pair of parts, for parts sets as `overlap_parts`
// takes them: of the overlapping pairs' MTV directions, the one whose largest push over all those
// pairs is least, with that push. It clears the pairs overlapping now and does not look for
// contacts the push makes. When no pair overlaps it answers a zero direction, the closest pair's
// depth (negative) and hit false. For p and q parts, up to (p * q)^2 pair tests.
([2]$T dir, T depth, bool hit) mtv_parts([][2]T a, []u32 a_starts, [][2]T b, []u32 b_starts, T tol) where T is float:
    [2]T best_dir = (0.0, 0.0)
    T best = 0.0
    bool found = false
    T closest = 0.0
    bool any = false
    for i in 0..<part_count(a_starts):
        for j in 0..<part_count(b_starts):
            ([2]T d, T depth, bool h) = mtv(part(a, a_starts, i), part(b, b_starts, j), tol)
            if !any || depth > closest:
                closest = depth
                any = true
            if !h:
                continue
            // A candidate: the push along d that clears every overlapping pair.
            T need = push_along(a, a_starts, b, b_starts, d, tol)
            if !found || need < best:
                found = true
                best = need
                best_dir = d
    if !found:
        [2]T zero = (0.0, 0.0)
        return (zero, closest, false)
    return (best_dir, best, true)

private $T push_along([][2]T a, []u32 a_starts, [][2]T b, []u32 b_starts, [2]T dir, T tol) where T is float:
    T need = 0.0
    for i in 0..<part_count(a_starts):
        [][2]T pa = part(a, a_starts, i)
        for j in 0..<part_count(b_starts):
            [][2]T pb = part(b, b_starts, j)
            if !overlap(pa, pb, tol):
                continue
            (T alo, _) = project(pa, dir)
            (_, T bhi) = project(pb, dir)
            if bhi - alo > need:
                need = bhi - alo
    return need
