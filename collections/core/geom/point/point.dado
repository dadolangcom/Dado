package point

import "core:math"

// `core:math` exposes only `root`/`magnitude` publicly, and both take `f64`.
// These functions are generic over `float` (f32 or f64), so a scalar square
// root and absolute value are reached at f64 and converted back — the same
// width round-trip `core:linalg.length` uses.
private $T rootf(T x) where T is float:
    return T(math.root(f64(x)))

private $T absf(T x) where T is float:
    return T(math.magnitude(f64(x)))

bool point_on_line([2]$T point, l0, l1, T eps) where T is float:
    // Calculate triangle area formed by point and line segment (cross product)
    [2]T d = l1 - l0
    [2]T p = point - l0
    T cross = absf((d.x * p.y) - (d.y * p.x))
    
    // Normalization to account for distance between l0 and l1
    T seg_len = rootf((d.x * d.x) + (d.y * d.y))
    if seg_len == 0.0:
        // Degenerate line segment (point check)
        T dist = rootf((p.x * p.x) + (p.y * p.y))
        return dist <= eps

    T dist = cross / seg_len
    return dist <= eps

bool point_on_ray([2]$T point, r0, r1, T eps) where T is float:
    [2]T d = r1 - r0
    [2]T p = point - r0

    // Compute projection scale along ray direction
    T dot = (p.x * d.x) + (p.y * d.y)
    
    // Point is behind ray origin
    if dot < -eps:
        return false

    T seg_len = rootf((d.x * d.x) + (d.y * d.y))
    if seg_len == 0.0:
        T dist = rootf((p.x * p.x) + (p.y * p.y))
        return dist <= eps

    // Perpendicular distance check
    T cross = absf((d.x * p.y) - (d.y * p.x))
    T dist = cross / seg_len
    return dist <= eps

bool point_on_segment([2]$T point, s0, s1, T eps) where T is float:
    [2]T d = s1 - s0
    [2]T p = point - s0

    T seg_len_sq = (d.x * d.x) + (d.y * d.y)
    if seg_len_sq == 0.0:
        T dist = rootf((p.x * p.x) + (p.y * p.y))
        return dist <= eps

    // Normalized projection factor t along segment [0, 1]
    T t = ((p.x * d.x) + (p.y * d.y)) / seg_len_sq

    // Clamped projection bounds with epsilon tolerance
    if t < -eps || t > 1.0 + eps:
        return false

    // Perpendicular distance check
    T cross = absf((d.x * p.y) - (d.y * p.x))
    T seg_len = rootf(seg_len_sq)
    T dist = cross / seg_len
    return dist <= eps

bool point_in_triangle([2]$T point, t0, t1, t2, T eps) where T is float:
    // Compute barycentric/cross product signs with tolerance threshold
    T cross0 = ((t1.x - t0.x) * (point.y - t0.y)) - ((t1.y - t0.y) * (point.x - t0.x))
    T cross1 = ((t2.x - t1.x) * (point.y - t1.y)) - ((t2.y - t1.y) * (point.x - t1.x))
    T cross2 = ((t0.x - t2.x) * (point.y - t2.y)) - ((t0.y - t2.y) * (point.x - t2.x))

    bool has_neg = (cross0 < -eps) || (cross1 < -eps) || (cross2 < -eps)
    bool has_pos = (cross0 > eps)  || (cross1 > eps)  || (cross2 > eps)

    return !(has_neg && has_pos)

// Width-agnostic: a pure comparison, no
// sqrt, so it binds `scalar` rather than `float` — one body for both an
// integer hit-test (e.g. `app:ui`'s terminal cells) and a float one.
bool point_in_rect([2]$T point, rect_position, rect_size, T eps) where T is scalar:
    T min_x = rect_position.x - eps
    T max_x = rect_position.x + rect_size.x + eps
    T min_y = rect_position.y - eps
    T max_y = rect_position.y + rect_size.y + eps

    return point.x >= min_x && point.x <= max_x && point.y >= min_y && point.y <= max_y

bool point_in_polygon([2]$T point, [][2]T polygon, T eps) where T is float:
    i32 n = #len(polygon)
    if n < 3:
        return false

    bool inside = false
    i32 j = n - 1

    for i in 0..<n:
        [2]T p1 = polygon[i]
        [2]T p2 = polygon[j]

        // Edge distance tolerance check for boundary hits
        [2]T d = p2 - p1
        [2]T p = point - p1
        T seg_len = rootf((d.x * d.x) + (d.y * d.y))
        if seg_len > 0.0:
            T cross = absf((d.x * p.y) - (d.y * p.x))
            T dist = cross / seg_len
            
            // Check bounding box of edge with epsilon
            T min_x = math.min(p1.x, p2.x) - eps
            T max_x = math.max(p1.x, p2.x) + eps
            T min_y = math.min(p1.y, p2.y) - eps
            T max_y = math.max(p1.y, p2.y) + eps
            
            if dist <= eps && point.x >= min_x && point.x <= max_x && point.y >= min_y && point.y <= max_y:
                return true

        // Ray casting algorithm (even-odd rule)
        bool intersect = ((p1.y > point.y) != (p2.y > point.y)) && (point.x < (p2.x - p1.x) * (point.y - p1.y) / (p2.y - p1.y) + p1.x)
        if intersect:
            inside = !inside

        j = i

    return inside
