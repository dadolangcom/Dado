// Whether a point in the plane lies on a line, ray or segment, or inside a triangle, rectangle
// or polygon, within a tolerance; the winding number of a polygon about a point; and the nearest
// point of a segment, in any dimension. For any float, and `in_rect` for any number.
//
//     [4][2]f64 square = [(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0)]
//     [2]f64 p = (0.5, 0.5)
//     bool inside = point.in_polygon(p, square[:], 0.000001)   // true
//
// A line, ray or segment is given by two points, as `core:geom/line` gives them: a line runs
// through both, a ray starts at the first, a segment runs between them. `eps` is a distance
// everywhere but `in_triangle`, which says what it bounds there:
// a point within `eps` of the shape counts as on it, and an `eps` below zero accepts nothing a
// distance test would. Distances are compared squared, so no function here takes a square root.
//
// **Tier N W H.** Pure Dado over `core:linalg` and `core:math`: it builds and runs freestanding
// (`#NONE`), on the web, and hosted (Linux, macOS and Windows) alike.
//
// **What raises into a script.** Every public function, each promised by the `#assert_raises`
// on the line above it and checked at each instantiation a program makes.
package point

import "core:linalg"
import "core:math"

// Whether a vector of squared length `len2` is within `eps` of zero length.
private bool within2($T len2, T eps) where T is float:
    return eps >= 0.0 && len2 <= eps * eps

// Whether the point at offset `p` from a line's first point lies within `eps` of the line whose
// direction is `d`, `d` not zero: |cross(d, p)| / |d| <= eps, compared squared.
private bool near_line([2]$T d, [2]T p, T eps) where T is float:
    T cross = (d.x * p.y) - (d.y * p.x)
    return eps >= 0.0 && cross * cross <= eps * eps * linalg.dot(d, d)

// Whether `point` lies within `eps` of the line through l0 and l1. When l0 and l1 are the same
// point, whether `point` lies within `eps` of it.
#assert_raises
bool on_line([2]$T point, l0, l1, T eps) where T is float:
    [2]T d = l1 - l0
    [2]T p = point - l0
    if linalg.dot(d, d) == 0.0:
        return within2(linalg.dot(p, p), eps)
    return near_line(d, p, eps)

// Whether `point` lies within `eps` of the ray from r0 through r1: within `eps` of its line,
// and no more than `eps` behind r0 as measured along the ray's direction scaled by its length
// (so for a ray of unit length, a distance). When r0 and r1 are the same point, whether `point`
// lies within `eps` of it.
#assert_raises
bool on_ray([2]$T point, r0, r1, T eps) where T is float:
    [2]T d = r1 - r0
    [2]T p = point - r0
    if linalg.dot(p, d) < -eps:
        return false
    if linalg.dot(d, d) == 0.0:
        return within2(linalg.dot(p, p), eps)
    return near_line(d, p, eps)

// Whether `point` lies within `eps` of segment s0-s1: within `eps` of its line, with its
// projection's parameter along the segment in [-eps, 1 + eps]. When s0 and s1 are the same
// point, whether `point` lies within `eps` of it.
#assert_raises
bool on_segment([2]$T point, s0, s1, T eps) where T is float:
    [2]T d = s1 - s0
    [2]T p = point - s0
    T seg_len_sq = linalg.dot(d, d)
    if seg_len_sq == 0.0:
        return within2(linalg.dot(p, p), eps)
    T t = linalg.dot(p, d) / seg_len_sq
    if t < -eps || t > 1.0 + eps:
        return false
    return near_line(d, p, eps)

// Whether `point` lies inside triangle t0 t1 t2, of either orientation, edges included. `eps`
// bounds each edge's cross product with the point, so it scales with the edge's length.
#assert_raises
bool in_triangle([2]$T point, t0, t1, t2, T eps) where T is float:
    // Compute barycentric/cross product signs with tolerance threshold
    T cross0 = ((t1.x - t0.x) * (point.y - t0.y)) - ((t1.y - t0.y) * (point.x - t0.x))
    T cross1 = ((t2.x - t1.x) * (point.y - t1.y)) - ((t2.y - t1.y) * (point.x - t1.x))
    T cross2 = ((t0.x - t2.x) * (point.y - t2.y)) - ((t0.y - t2.y) * (point.x - t2.x))

    bool has_neg = (cross0 < -eps) || (cross1 < -eps) || (cross2 < -eps)
    bool has_pos = (cross0 > eps)  || (cross1 > eps)  || (cross2 > eps)

    return !(has_neg && has_pos)

// Whether `point` lies in the rectangle at `rect_position` with size `rect_size`, edges
// included, grown by `eps` on every side. It binds `scalar` rather than `float`, so the same body
// tests integer cells (with `eps` 0) and float pixels.
#assert_raises
bool in_rect([2]$T point, rect_position, rect_size, T eps) where T is scalar:
    T min_x = rect_position.x - eps
    T max_x = rect_position.x + rect_size.x + eps
    T min_y = rect_position.y - eps
    T max_y = rect_position.y + rect_size.y + eps

    return point.x >= min_x && point.x <= max_x && point.y >= min_y && point.y <= max_y

// Whether `point` lies inside `polygon`, implicitly closed and of either orientation, by the
// even-odd rule. A point within `eps` of an edge is inside. Fewer than three corners enclose
// nothing. O(n); `winding_number` answers the nonzero rule instead.
#assert_raises
bool in_polygon([2]$T point, [][2]T polygon, T eps) where T is float:
    i64 n = #len(polygon)
    if n < 3:
        return false

    bool inside = false
    i64 j = n - 1

    for i in 0..<n:
        [2]T p1 = polygon[i]
        [2]T p2 = polygon[j]

        // Within eps of the edge, and of its bounding box: on the boundary, so inside.
        [2]T d = p2 - p1
        [2]T p = point - p1
        if linalg.dot(d, d) > 0.0 && near_line(d, p, eps):
            T min_x = math.min(p1.x, p2.x) - eps
            T max_x = math.max(p1.x, p2.x) + eps
            T min_y = math.min(p1.y, p2.y) - eps
            T max_y = math.max(p1.y, p2.y) + eps
            if point.x >= min_x && point.x <= max_x && point.y >= min_y && point.y <= max_y:
                return true

        // Ray casting algorithm (even-odd rule)
        bool intersect = ((p1.y > point.y) != (p2.y > point.y)) && (point.x < (p2.x - p1.x) * (point.y - p1.y) / (p2.y - p1.y) + p1.x)
        if intersect:
            inside = !inside

        j = i

    return inside

// The winding number of `polygon` (implicitly closed, either orientation) about `point`:
// positive for counter-clockwise turns, 0 outside. A point on an edge may count as either side.
// Nonzero is inside under the nonzero rule, which counts the doubly wound part of a
// self-overlapping polygon as inside where `in_polygon`'s even-odd rule does not. O(n).
//
//     bool inside = point.winding_number(p, polygon) != 0
#assert_raises
i32 winding_number([2]$T point, [][2]T polygon) where T is float:
    i64 n = #len(polygon)
    i32 w = 0
    for i in 0..<n:
        [2]T a = polygon[i]
        [2]T b = polygon[(i + 1) % n]
        [2]T ab = b - a
        [2]T ap = point - a
        T side = ab.x * ap.y - ab.y * ap.x
        if a.y <= point.y:
            if b.y > point.y && side > 0.0:
                w += 1
        else if b.y <= point.y && side < 0.0:
            w -= 1
    return w

// The point of segment s0-s1 nearest `point`, in any dimension, and its parameter `t` in [0, 1]
// along the segment. A zero-length segment answers s0 and t = 0.
#assert_raises
([$N]$T closest, T t) closest_point_on_segment([N]T point, s0, s1) where T is float:
    [N]T d = s1 - s0
    T len2 = linalg.dot(d, d)
    T t = 0.0
    if len2 > 0.0:
        t = linalg.dot(point - s0, d) / len2
        if t < 0.0: t = 0.0
        if t > 1.0: t = 1.0
    return (s0 + d * t, t)
