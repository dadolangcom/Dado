@test
package point

private type F2: [2]f32
private type D2: [2]f64
private type I2: [2]i32

private bool near(f64 a, f64 b):
    f64 d = a - b
    return d < 0.000001 && d > -0.000001

private bool near3([3]f64 a, [3]f64 b):
    return near(a.x, b.x) && near(a.y, b.y) && near(a.z, b.z)

private bool test_point_on_line():
    bool ok = true
    F2 a0 = (-1.0, -1.0)
    F2 a1 = (1.0, 1.0)
    ok = #expect(on_line(F2((0.5, 0.5)), a0, a1, 0.001), "on the diagonal") && ok
    ok = #expect(!on_line(F2((0.5, 1.5)), a0, a1, 0.001), "off the diagonal") && ok
    // A line runs past its points.
    ok = #expect(on_line(F2((7.0, 7.0)), a0, a1, 0.001), "beyond a1") && ok
    // eps is a distance: (0, 1) is 1/sqrt(2) = 0.7071 from the diagonal.
    ok = #expect(on_line(D2((0.0, 1.0)), D2((0.0, 0.0)), D2((1.0, 1.0)), 0.71), "within 0.71") && ok
    ok = #expect(!on_line(D2((0.0, 1.0)), D2((0.0, 0.0)), D2((1.0, 1.0)), 0.70), "not within 0.70") && ok
    // A line given by one point is that point.
    ok = #expect(on_line(D2((0.0, 0.5)), D2((0.0, 0.0)), D2((0.0, 0.0)), 0.5), "degenerate within") && ok
    ok = #expect(!on_line(D2((0.0, 0.5)), D2((0.0, 0.0)), D2((0.0, 0.0)), 0.4), "degenerate outside") && ok
    // A negative eps accepts nothing.
    ok = #expect(!on_line(D2((0.5, 0.5)), D2((0.0, 0.0)), D2((1.0, 1.0)), -1.0), "negative eps") && ok
    return ok

private bool test_point_on_ray():
    bool ok = true
    D2 r0 = (0.0, 0.0)
    D2 r1 = (1.0, 0.0)
    ok = #expect(on_ray(D2((5.0, 0.0)), r0, r1, 0.001), "ahead on the ray") && ok
    ok = #expect(on_ray(D2((0.0, 0.0)), r0, r1, 0.001), "at the start") && ok
    ok = #expect(!on_ray(D2((-5.0, 0.0)), r0, r1, 0.001), "behind the start") && ok
    ok = #expect(on_ray(D2((-0.0005, 0.0)), r0, r1, 0.001), "within eps behind the start") && ok
    ok = #expect(!on_ray(D2((5.0, 0.5)), r0, r1, 0.001), "beside the ray") && ok
    ok = #expect(on_ray(D2((5.0, 0.5)), r0, r1, 0.6), "beside the ray within 0.6") && ok
    ok = #expect(on_ray(D2((0.1, 0.0)), r0, r0, 0.2), "degenerate ray within") && ok
    ok = #expect(!on_ray(D2((0.3, 0.0)), r0, r0, 0.2), "degenerate ray outside") && ok
    ok = #expect(on_ray(F2((3.0, 3.0)), F2((0.0, 0.0)), F2((1.0, 1.0)), 0.001), "f32 diagonal") && ok
    return ok

private bool test_point_on_segment():
    bool ok = true
    D2 s0 = (0.0, 0.0)
    D2 s1 = (2.0, 0.0)
    ok = #expect(on_segment(D2((1.0, 0.0)), s0, s1, 0.001), "middle") && ok
    ok = #expect(on_segment(D2((0.0, 0.0)), s0, s1, 0.001) && on_segment(D2((2.0, 0.0)), s0, s1, 0.001), "ends") && ok
    ok = #expect(!on_segment(D2((3.0, 0.0)), s0, s1, 0.001), "past the end") && ok
    ok = #expect(!on_segment(D2((-1.0, 0.0)), s0, s1, 0.001), "before the start") && ok
    ok = #expect(!on_segment(D2((1.0, 0.1)), s0, s1, 0.001), "beside") && ok
    ok = #expect(on_segment(D2((1.0, 0.1)), s0, s1, 0.2), "beside within 0.2") && ok
    ok = #expect(on_segment(D2((0.0, 0.1)), s0, s0, 0.2), "degenerate within") && ok
    ok = #expect(!on_segment(D2((0.0, 0.3)), s0, s0, 0.2), "degenerate outside") && ok
    ok = #expect(on_segment(F2((0.5, 0.5)), F2((0.0, 0.0)), F2((1.0, 1.0)), 0.001), "f32 diagonal") && ok
    return ok

private bool test_point_in_triangle():
    bool ok = true
    F2 t0 = (0.0, 0.0)
    F2 t1 = (2.0, 0.0)
    F2 t2 = (0.0, 2.0)
    ok = #expect(in_triangle(F2((0.5, 0.5)), t0, t1, t2, 0.001), "inside") && ok
    ok = #expect(!in_triangle(F2((2.0, 2.0)), t0, t1, t2, 0.001), "outside") && ok
    ok = #expect(in_triangle(F2((1.0, 0.0)), t0, t1, t2, 0.001), "on an edge") && ok
    // Clockwise works the same.
    ok = #expect(in_triangle(F2((0.5, 0.5)), t0, t2, t1, 0.001), "inside clockwise") && ok
    ok = #expect(!in_triangle(D2((2.0, 2.0)), D2((0.0, 0.0)), D2((0.0, 2.0)), D2((2.0, 0.0)), 0.001), "outside clockwise f64") && ok
    return ok

private bool test_point_in_rect():
    bool ok = true
    [2]i32 izero = (0, 0)
    [2]i32 iten = (10, 10)
    ok = #expect(in_rect(I2((5, 5)), izero, iten, 0), "inside (i32)") && ok
    ok = #expect(!in_rect(I2((15, 5)), izero, iten, 0), "outside (i32)") && ok
    ok = #expect(in_rect(I2((10, 10)), izero, iten, 0), "far corner, closed (i32)") && ok
    ok = #expect(in_rect(I2((11, 5)), izero, iten, 1), "within eps (i32)") && ok
    ok = #expect(in_rect(F2((5.0, 5.0)), F2((0.0, 0.0)), F2((10.0, 10.0)), 0.0), "inside (f32)") && ok
    return ok

private bool test_point_in_polygon():
    bool ok = true
    // A square with a notch cut from its top: (0.5, 1.5) is in the notch, outside.
    [6][2]f64 notched = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (1.0, 2.0), (1.0, 1.0), (0.0, 1.0)]
    ok = #expect(in_polygon(D2((1.5, 1.5)), notched[:], 0.000001), "inside") && ok
    ok = #expect(!in_polygon(D2((0.5, 1.5)), notched[:], 0.000001), "in the notch") && ok
    ok = #expect(!in_polygon(D2((5.0, 0.5)), notched[:], 0.000001), "far outside") && ok
    // On an edge, and within eps of one from outside.
    ok = #expect(in_polygon(D2((2.0, 1.0)), notched[:], 0.000001), "on an edge") && ok
    ok = #expect(in_polygon(D2((2.05, 1.0)), notched[:], 0.1), "within eps of an edge") && ok
    ok = #expect(!in_polygon(D2((2.05, 1.0)), notched[:], 0.01), "outside eps of an edge") && ok
    // Fewer than three corners enclose nothing.
    [2][2]f64 two = [(0.0, 0.0), (1.0, 1.0)]
    ok = #expect(!in_polygon(D2((0.5, 0.5)), two[:], 0.1), "two corners") && ok
    // Even-odd: the doubly wound core of a spiral is outside, where the winding number is 2.
    [8][2]f64 twice = [(0.0, 0.0), (4.0, 0.0), (4.0, 4.0), (1.0, 4.0), (1.0, 1.0), (3.0, 1.0), (3.0, 3.0), (0.0, 3.0)]
    ok = #expect(!in_polygon(D2((2.0, 2.0)), twice[:], 0.000001), "even-odd excludes the doubly wound part") && ok
    [4][2]f32 sq = [(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0)]
    ok = #expect(in_polygon(F2((0.5, 0.5)), sq[:], f32(0.0001)), "f32 inside") && ok
    return ok

private bool test_winding_number():
    bool ok = true
    // An XZ footprint with a notch, counter-clockwise.
    [6][2]f64 ccw = [(0.0, 0.0), (2.0, 0.0), (2.0, 2.0), (1.0, 2.0), (1.0, 1.0), (0.0, 1.0)]
    [6][2]f64 cw = [(0.0, 1.0), (1.0, 1.0), (1.0, 2.0), (2.0, 2.0), (2.0, 0.0), (0.0, 0.0)]
    D2 in_p = (1.5, 1.5)
    D2 notch = (0.5, 1.5)
    ok = #expect(winding_number(in_p, ccw[:]) == 1, "winding ccw: ", winding_number(in_p, ccw[:])) && ok
    ok = #expect(winding_number(in_p, cw[:]) == -1, "winding cw: ", winding_number(in_p, cw[:])) && ok
    ok = #expect(winding_number(in_p, cw[:]) != 0 && winding_number(notch, ccw[:]) == 0, "inside") && ok
    ok = #expect(winding_number(D2((5.0, 0.5)), ccw[:]) == 0, "winding far") && ok
    // A vertex level with the point does not double count.
    ok = #expect(winding_number(D2((0.5, 1.0)), ccw[:]) != 2 && winding_number(D2((1.5, 1.0)), ccw[:]) == 1, "winding at a vertex's height") && ok

    // The rightward ray leaves through a vertex.
    [4][2]f64 diamond = [(1.0, 0.0), (2.0, 1.0), (1.0, 2.0), (0.0, 1.0)]
    ok = #expect(winding_number(D2((0.5, 1.0)), diamond[:]) == 1, "winding through a vertex: ", winding_number(D2((0.5, 1.0)), diamond[:])) && ok

    // A spiral wound twice about its core.
    [8][2]f64 twice = [(0.0, 0.0), (4.0, 0.0), (4.0, 4.0), (1.0, 4.0), (1.0, 1.0), (3.0, 1.0), (3.0, 3.0), (0.0, 3.0)]
    ok = #expect(winding_number(D2((2.0, 2.0)), twice[:]) == 2, "winding self-overlap: ", winding_number(D2((2.0, 2.0)), twice[:])) && ok

    [4][2]f32 sq = [(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0)]
    ok = #expect(winding_number(F2((0.5, 0.5)), sq[:]) != 0, "inside f32") && ok
    return ok

private bool test_closest_point_on_segment():
    bool ok = true
    [3]f64 a = (0.0, 0.0, 0.0)
    [3]f64 b = (2.0, 0.0, 0.0)
    ([3]f64 q, f64 t) = closest_point_on_segment((1.0, 5.0, 0.0), a, b)
    ok = #expect(near3(q, (1.0, 0.0, 0.0)) && near(t, 0.5), "closest middle: ", q, " ", t) && ok
    (q, t) = closest_point_on_segment((-3.0, 1.0, 0.0), a, b)
    ok = #expect(near3(q, a) && near(t, 0.0), "closest clamps to a") && ok
    (q, t) = closest_point_on_segment((9.0, 1.0, 0.0), a, b)
    ok = #expect(near3(q, b) && near(t, 1.0), "closest clamps to b") && ok
    (q, t) = closest_point_on_segment((9.0, 1.0, 0.0), a, a)
    ok = #expect(near3(q, a) && near(t, 0.0), "closest on a point") && ok
    ([2]f32 q2, f32 t2) = closest_point_on_segment(F2((0.0, 1.0)), F2((-1.0, 0.0)), F2((1.0, 0.0)))
    ok = #expect(near(f64(q2.x), 0.0) && near(f64(t2), 0.5), "closest 2D f32") && ok
    return ok

i32 test():
    bool ok = true
    ok = test_point_on_line() && ok
    ok = test_point_on_ray() && ok
    ok = test_point_on_segment() && ok
    ok = test_point_in_triangle() && ok
    ok = test_point_in_rect() && ok
    ok = test_point_in_polygon() && ok
    ok = test_winding_number() && ok
    ok = test_closest_point_on_segment() && ok
    return 0 if ok else 1
