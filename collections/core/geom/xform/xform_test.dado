@test
package xform

import "core:math"

private f32 EPS = 0.0001

private bool near(f32 a, f32 b):
    return math.abs(f64(a) - f64(b)) < f64(EPS)

private bool near2(f32 ax, f32 ay, f32 bx, f32 by):
    return near(ax, bx) && near(ay, by)

i32 test():
    bool ok = true

    // IDENTITY does nothing.
    [2]f32 p0 = transform_point(IDENTITY, (3.0, 4.0))
    ok = #expect(near2(p0.x, p0.y, 3.0, 4.0), "identity moved a point: ", p0.x, ", ", p0.y) && ok

    // Pure translation.
    Transform2D t = from_trs((5.0, 7.0), 0.0, (1.0, 1.0))
    [2]f32 p1 = transform_point(t, (1.0, 1.0))
    ok = #expect(near2(p1.x, p1.y, 6.0, 8.0), "translate: got ", p1.x, ", ", p1.y) && ok

    // Pure scale, applied around the origin.
    Transform2D s = from_trs((0.0, 0.0), 0.0, (2.0, 3.0))
    [2]f32 p2 = transform_point(s, (5.0, 5.0))
    ok = #expect(near2(p2.x, p2.y, 10.0, 15.0), "scale: got ", p2.x, ", ", p2.y) && ok

    // Pure rotation, 90 degrees counter-clockwise: (1, 0) -> (0, 1).
    f32 quarter_turn = f32(math.PI) / 2.0
    Transform2D r = from_trs((0.0, 0.0), quarter_turn, (1.0, 1.0))
    [2]f32 p3 = transform_point(r, (1.0, 0.0))
    ok = #expect(near2(p3.x, p3.y, 0.0, 1.0), "rotate: got ", p3.x, ", ", p3.y) && ok

    // Composition: parent translates by (10, 0), child scales by 2 then sits
    // at local (1, 1) — parent * child maps the child's local origin-ish
    // point (1, 1) to (10 + 2, 0 + 2) = (12, 2).
    Transform2D parent = from_trs((10.0, 0.0), 0.0, (1.0, 1.0))
    Transform2D child = from_trs((0.0, 0.0), 0.0, (2.0, 2.0))
    Transform2D global = parent * child
    [2]f32 p4 = transform_point(global, (1.0, 1.0))
    ok = #expect(near2(p4.x, p4.y, 12.0, 2.0), "compose: got ", p4.x, ", ", p4.y) && ok

    // transform_vector ignores translation.
    [2]f32 v0 = transform_vector(t, (1.0, 0.0))
    ok = #expect(near2(v0.x, v0.y, 1.0, 0.0), "transform_vector carried translation: ", v0.x, ", ", v0.y) && ok

    // position_of / rotation_of / scale_of decode a transform `from_trs`
    // built, for the axis-aligned (no accumulated shear) case.
    Transform2D decode_me = from_trs((3.0, 4.0), quarter_turn, (2.0, 5.0))
    [2]f32 pos = position_of(decode_me)
    ok = #expect(near2(pos.x, pos.y, 3.0, 4.0), "position_of: got ", pos.x, ", ", pos.y) && ok
    f32 rot = rotation_of(decode_me)
    ok = #expect(near(rot, quarter_turn), "rotation_of: got ", rot) && ok
    [2]f32 scl = scale_of(decode_me)
    ok = #expect(near2(scl.x, scl.y, 2.0, 5.0), "scale_of: got ", scl.x, ", ", scl.y) && ok

    // inverse: applying t then inverse(t) is the identity, up to float error.
    Transform2D t2 = from_trs((3.0, -2.0), 0.7, (1.5, 0.6))
    Transform2D t2_inv = inverse(t2)
    [2]f32 round_trip = transform_point(t2_inv, transform_point(t2, (4.0, -1.0)))
    ok = #expect(near2(round_trip.x, round_trip.y, 4.0, -1.0), "inverse round-trip: got ", round_trip.x, ", ", round_trip.y) && ok

    // transform_vector scales and rotates: (1, 0) scaled by 2 and turned a quarter is (0, 2).
    Transform2D sr = from_trs((7.0, 9.0), quarter_turn, (2.0, 3.0))
    [2]f32 v1 = transform_vector(sr, (1.0, 0.0))
    ok = #expect(near2(v1.x, v1.y, 0.0, 2.0), "transform_vector rotates and scales: ", v1.x, ", ", v1.y) && ok
    [2]f32 v2 = transform_vector(sr, (0.0, 1.0))
    ok = #expect(near2(v2.x, v2.y, -3.0, 0.0), "transform_vector, y axis: ", v2.x, ", ", v2.y) && ok

    // IDENTITY composes to nothing, either side, and is its own inverse.
    Transform2D left = IDENTITY * t2
    Transform2D right = t2 * IDENTITY
    [2]f32 a = transform_point(left, (1.0, 2.0))
    [2]f32 b = transform_point(right, (1.0, 2.0))
    [2]f32 c = transform_point(t2, (1.0, 2.0))
    ok = #expect(near2(a.x, a.y, c.x, c.y) && near2(b.x, b.y, c.x, c.y), "IDENTITY composes to nothing") && ok
    [2]f32 ii = transform_point(inverse(IDENTITY), (5.0, -6.0))
    ok = #expect(near2(ii.x, ii.y, 5.0, -6.0), "inverse(IDENTITY) is IDENTITY") && ok

    // The inverse of a composition, with a rotation over a non-uniform scale (shear).
    Transform2D sheared = from_trs((1.0, 2.0), 0.4, (1.0, 1.0)) * from_trs((0.0, 0.0), 0.0, (3.0, 0.5))
    Transform2D undo = inverse(sheared)
    [2]f32 back = transform_point(undo, transform_point(sheared, (2.5, -1.5)))
    ok = #expect(near2(back.x, back.y, 2.5, -1.5), "inverse of a sheared composition: ", back.x, ", ", back.y) && ok
    [2]f32 fwd = transform_point(sheared * undo, (2.5, -1.5))
    ok = #expect(near2(fwd.x, fwd.y, 2.5, -1.5), "t * inverse(t) is the identity: ", fwd.x, ", ", fwd.y) && ok

    // position_of a composition is where the child's origin lands.
    [2]f32 pc = position_of(parent * child)
    ok = #expect(near2(pc.x, pc.y, 10.0, 0.0), "position_of a composition: ", pc.x, ", ", pc.y) && ok

    // rotation_of composes: a quarter turn on a quarter turn is a half turn.
    f32 half = rotation_of(r * r)
    ok = #expect(near(half, f32(math.PI)) || near(half, -f32(math.PI)), "rotation_of composes: ", half) && ok

    // A reflection reads back as a positive scale and a half-turned rotation.
    Transform2D flip = from_trs((0.0, 0.0), 0.0, (-1.0, -1.0))
    [2]f32 fs = scale_of(flip)
    ok = #expect(near2(fs.x, fs.y, 1.0, 1.0), "scale_of a reflection is positive: ", fs.x, ", ", fs.y) && ok
    f32 fr = rotation_of(flip)
    ok = #expect(near(fr, f32(math.PI)) || near(fr, -f32(math.PI)), "rotation_of a point reflection is a half turn: ", fr) && ok

    if ok:
        return 0
    return 1
