// Axis-aligned rectangles for layout and hit-testing: padding, growing, slicing, equal
// division into rows, columns and grids, alignment, and overlap. For any number, so the same
// body lays out a terminal's integer cells and a window's float pixels.
//
//     rect.Rect screen = rect.rect(0, 0, 80, 24)
//     rect.Rect body = rect.inset(screen, 1, 1)            // (1, 1) 78x22
//     rect.Rect row = rect.stackv(body, 2, 0, 1)            // the lower of two rows
//     bool hot = rect.contains(row, [40, 15])               // true
//
// A rectangle is a position and a size: its top-left corner (x, y) and its extent (w, h), with
// y growing downwards, as layout has it (`core:geom/clip`'s rings are y-up). Every function
// takes it as one `[2][2]T`, `[[x, y], [w, h]]`; `Rect` is that shape at `i32`, with a
// constructor. Every function works for both kinds of number: a width that would go negative is
// clamped to zero where a function says so, and an integer division rounds towards zero.
//
// **Tier N W H.** Pure Dado over `core:math`: it builds and runs freestanding
// (`#NONE`), on the web, and hosted (Linux, macOS and Windows) alike.
//
// **What raises into a script.** Every public function, each promised by the `#assert_raises`
// on the line above it and checked at each instantiation a program makes.
package rect

import "core:math"

// A rectangle of integer cells as (position, size): rect[0] = (x, y), rect[1] = (w, h). A plain
// alias, not a `distinct` type, so every function here takes it as it takes any `[2][2]T`.
type Rect: [2][2]i32

// Build a Rect from x, y, w, h.
#assert_raises
Rect rect(i32 x, i32 y, i32 w, i32 h):
    return [[x, y], [w, h]]

// ── accessors ────────────────────────────────────────────────────────────

// The x of `r`'s top-left corner.
#assert_raises
$T x([2][2]T r) where T is scalar: return r[0].x

// The y of `r`'s top-left corner.
#assert_raises
$T y([2][2]T r) where T is scalar: return r[0].y

// The width of `r`.
#assert_raises
$T w([2][2]T r) where T is scalar: return r[1].x

// The height of `r`.
#assert_raises
$T h([2][2]T r) where T is scalar: return r[1].y

// ── containment ─────────────────────────────────────────────────────────

// Whether `inner` lies wholly inside `outer`, edges included: a rectangle contains itself.
#assert_raises
bool contains_rect([2][2]$T outer, [2][2]T inner) where T is scalar:
    return inner[0].x >= outer[0].x && inner[0].x + inner[1].x <= outer[0].x + outer[1].x && inner[0].y >= outer[0].y && inner[0].y + inner[1].y <= outer[0].y + outer[1].y

// Whether `point` lies in `r`, its top and left edges included and its bottom and right
// edges not, so the cells of a grid of rectangles each hold a point once. A rectangle with no
// width or height holds nothing. `point.in_rect` is the closed test with a tolerance.
#assert_raises
bool contains([2][2]$T r, [2]T point) where T is scalar:
    return point.x >= r[0].x && point.x < r[0].x + r[1].x && point.y >= r[0].y && point.y < r[0].y + r[1].y

// Whether `a` and `b` share some area. Rectangles that only touch along an edge or at a corner
// do not, and neither does one with no width or height.
#assert_raises
bool overlaps([2][2]$T a, [2][2]T b) where T is scalar:
    (_, bool hit) = intersection(a, b)
    return hit

// The rectangle `a` and `b` share, and whether they share any area. When they do not (they
// only touch, or lie apart), the answer is ([[0, 0], [0, 0]], false).
//
//     ([2][2]f32 both, bool hit) = rect.intersection([[0.0, 0.0], [4.0, 4.0]], [[2.0, 1.0], [5.0, 2.0]])
//     // both is [[2, 1], [2, 2]], hit is true
#assert_raises
([2][2]$T both, bool hit) intersection([2][2]T a, [2][2]T b) where T is scalar:
    T x0 = math.max(a[0].x, b[0].x)
    T y0 = math.max(a[0].y, b[0].y)
    T x1 = math.min(a[0].x + a[1].x, b[0].x + b[1].x)
    T y1 = math.min(a[0].y + a[1].y, b[0].y + b[1].y)
    T zero = 0
    if x1 <= x0 || y1 <= y0:
        return ([[zero, zero], [zero, zero]], false)
    return ([[x0, y0], [x1 - x0, y1 - y0]], true)

// ── padding ──────────────────────────────────────────────────────────────

// Shrink a rect by `dx` on each side and `dy` on top and bottom, clamped so it
// never inverts. The bread-and-butter of border/padding insets.
#assert_raises
[2][2]$T inset([2][2]T r, T dx, dy) where T is scalar:
    T x = r[0].x + dx
    T y = r[0].y + dy
    T w = r[1].x - dx - dx
    T h = r[1].y - dy - dy
    if w < 0: w = 0
    if h < 0: h = 0
    return [[x, y], [w, h]]

// Shrink a rect by explicit per-side margins (left, top, right, bottom),
// clamped so it never inverts. Positioning a child inside a parent's padding.
#assert_raises
[2][2]$T margin([2][2]T r, T left, top, right, bottom) where T is scalar:
    T x = r[0].x + left
    T y = r[0].y + top
    T w = r[1].x - left - right
    T h = r[1].y - top - bottom
    if w < 0: w = 0
    if h < 0: h = 0
    return [[x, y], [w, h]]

// ── grow / bounds ────────────────────────────────────────────────────────

// `r` grown by `dt` on every side. A negative `dt` shrinks it, without the clamp `inset`
// applies.
#assert_raises
[2][2]$T grow([2][2]T r, T dt) where T is scalar:
    return [[r[0].x - dt, r[0].y - dt], [r[1].x + dt * 2, r[1].y + dt * 2]]

// `r` grown by a margin on each side, given in the order left, top, right, bottom. Negative
// margins shrink it, without a clamp (`margin` is the clamped inward form).
#assert_raises
[2][2]$T grow_sides([2][2]T r, T left, top, right, bottom) where T is scalar:
    return [[r[0].x - left, r[0].y - top], [r[1].x + left + right, r[1].y + top + bottom]]

// The smallest rectangle holding both `r` and `point`.
#assert_raises
[2][2]$T grow_to_point([2][2]T r, [2]T point) where T is scalar:
    T min_x = math.min(r[0].x, point.x)
    T min_y = math.min(r[0].y, point.y)
    T max_x = math.max(r[0].x + r[1].x, point.x)
    T max_y = math.max(r[0].y + r[1].y, point.y)
    return [[min_x, min_y], [max_x - min_x, max_y - min_y]]

// The smallest rectangle holding both `a` and `b`: their union's bounds.
#assert_raises
[2][2]$T grow_to_rect([2][2]T a, [2][2]T b) where T is scalar:
    T min_x = math.min(a[0].x, b[0].x)
    T min_y = math.min(a[0].y, b[0].y)
    T max_x = math.max(a[0].x + a[1].x, b[0].x + b[1].x)
    T max_y = math.max(a[0].y + a[1].y, b[0].y + b[1].y)
    return [[min_x, min_y], [max_x - min_x, max_y - min_y]]

// ── slicing ──────────────────────────────────────────────────────────────

// `r` cut by a vertical line `distance` from its left edge into a left and a right part,
// `distance` clamped to [0, width].
#assert_raises
[2][2][2]$T vslice([2][2]T r, T distance) where T is scalar:
    T zero = 0
    T split_x = math.min(math.max(distance, zero), r[1].x)
    [2][2]T left_rect = [r[0], [split_x, r[1].y]]
    [2][2]T right_rect = [[r[0].x + split_x, r[0].y], [r[1].x - split_x, r[1].y]]
    return [left_rect, right_rect]

// `r` cut by a horizontal line `distance` from its top edge into a top and a bottom part,
// `distance` clamped to [0, height].
#assert_raises
[2][2][2]$T hslice([2][2]T r, T distance) where T is scalar:
    T zero = 0
    T split_y = math.min(math.max(distance, zero), r[1].y)
    [2][2]T top_rect = [r[0], [r[1].x, split_y]]
    [2][2]T bottom_rect = [[r[0].x, r[0].y + split_y], [r[1].x, r[1].y - split_y]]
    return [top_rect, bottom_rect]

// `r` with a non-negative size: a negative width or height moves the corner by it and flips
// its sign, so the rectangle covers the same area.
#assert_raises
[2][2]$T positive([2][2]T r) where T is scalar:
    T new_x = r[0].x
    T new_y = r[0].y
    T new_w = r[1].x
    T new_h = r[1].y
    if new_w < 0:
        new_x += new_w
        new_w = -new_w
    if new_h < 0:
        new_y += new_h
        new_h = -new_h
    return [[new_x, new_y], [new_w, new_h]]

// The area of `r`, negative when one side is.
#assert_raises
$T area([2][2]T r) where T is scalar:
    return r[1].x * r[1].y

// The length of the edge of `r`.
#assert_raises
$T perimeter([2][2]T r) where T is scalar:
    return r[1].x * 2 + r[1].y * 2

// ── stacks: equal division into n children (top-down) ───────────────────
//
// `n`/`gap`/`i` are counts and always `i32`; only the extent they carve up is
// width-agnostic. Which child gets which cell is a layout's choice; these only divide a rectangle
// into equal shares.

// The i-th of `n` equal rows stacked down `area`, with `gap` blank rows
// between. A vertical flex row: children share the height evenly, top to
// bottom.
#assert_raises
[2][2]$T stackv([2][2]T area, i32 n, gap, i) where T is scalar:
    if n <= 0: return area
    T cell = (area[1].y - T(gap * (n - 1))) / T(n)
    if cell < 0: cell = 0
    T y = area[0].y + T(i) * (cell + T(gap))
    return [[area[0].x, y], [area[1].x, cell]]

// The i-th of `n` equal columns across `area`, with `gap` blank columns
// between.
#assert_raises
[2][2]$T stackh([2][2]T area, i32 n, gap, i) where T is scalar:
    if n <= 0: return area
    T cell = (area[1].x - T(gap * (n - 1))) / T(n)
    if cell < 0: cell = 0
    T x = area[0].x + T(i) * (cell + T(gap))
    return [[x, area[0].y], [cell, area[1].y]]

// The cell at (col, row) of a `cols`×`rows` grid over `area`, with `gx`/`gy`
// gaps. Top-down and left-to-right; equal cells.
#assert_raises
[2][2]$T grid([2][2]T area, i32 cols, rows, gx, gy, col, row) where T is scalar:
    i32 c = cols
    i32 r = rows
    if c <= 0: c = 1
    if r <= 0: r = 1
    T cw = (area[1].x - T(gx * (c - 1))) / T(c)
    T ch = (area[1].y - T(gy * (r - 1))) / T(r)
    if cw < 0: cw = 0
    if ch < 0: ch = 0
    T x = area[0].x + T(col) * (cw + T(gx))
    T y = area[0].y + T(row) * (ch + T(gy))
    return [[x, y], [cw, ch]]

// ── positioning a fixed-size box within a parent ────────────────────────

// Where a fixed-size box sits inside a larger allocation.
enum i32 Align: (Start, Center, End)

// Place a `w`×`h` box inside `parent`, aligned on each axis.
#assert_raises
[2][2]$T align_in([2][2]T parent, T w, h, Align ax, ay) where T is scalar:
    T x = parent[0].x
    switch ax:
        case Align.Start:  x = parent[0].x
        case Align.Center: x = parent[0].x + (parent[1].x - w) / T(2)
        case Align.End:    x = parent[0].x + parent[1].x - w
        else:              x = parent[0].x
    T y = parent[0].y
    switch ay:
        case Align.Start:  y = parent[0].y
        case Align.Center: y = parent[0].y + (parent[1].y - h) / T(2)
        case Align.End:    y = parent[0].y + parent[1].y - h
        else:              y = parent[0].y
    return [[x, y], [w, h]]

// A `w`×`h` box centred in `parent`.
#assert_raises
[2][2]$T center_in([2][2]T parent, T w, h) where T is scalar:
    return align_in(parent, w, h, Align.Center, Align.Center)
