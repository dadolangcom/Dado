package rect

import "core:math"

// A rectangle as (position, size): rect[0] = (x, y), rect[1] = (w, h). A
// plain (non-distinct) alias, so a `scalar`-bound receiver below instantiates
// against it exactly as it would against a raw [2][2]f32 — this is what lets
// one body serve a terminal's integer cells and a future graphical backend's
// float pixels from the same source.
type Rect: [2][2]i32

// Build a Rect from x, y, w, h.
Rect rect(i32 x, i32 y, i32 w, i32 h):
    return [[x, y], [w, h]]

// ── accessors ────────────────────────────────────────────────────────────

$T rx([2][2]T r) where T is scalar: return r[0].x
$T ry([2][2]T r) where T is scalar: return r[0].y
$T rw([2][2]T r) where T is scalar: return r[1].x
$T rh([2][2]T r) where T is scalar: return r[1].y

// ── containment ─────────────────────────────────────────────────────────

bool contains_rect([2]$T outer_pos, outer_size, inner_pos, inner_size) where T is scalar:
    // Rect A contains Rect B if B's bounds are fully inside A
    T a_min_x = outer_pos.x
    T a_max_x = outer_pos.x + outer_size.x
    T a_min_y = outer_pos.y
    T a_max_y = outer_pos.y + outer_size.y

    T b_min_x = inner_pos.x
    T b_max_x = inner_pos.x + inner_size.x
    T b_min_y = inner_pos.y
    T b_max_y = inner_pos.y + inner_size.y

    return b_min_x >= a_min_x && b_max_x <= a_max_x && b_min_y >= a_min_y && b_max_y <= a_max_y

// ── padding ──────────────────────────────────────────────────────────────

// Shrink a rect by `dx` on each side and `dy` on top and bottom, clamped so it
// never inverts. The bread-and-butter of border/padding insets.
[2][2]$T inset([2][2]T r, T dx, dy) where T is scalar:
    T x = rx(r) + dx
    T y = ry(r) + dy
    T w = rw(r) - dx - dx
    T h = rh(r) - dy - dy
    if w < 0: w = 0
    if h < 0: h = 0
    return [[x, y], [w, h]]

// Shrink a rect by explicit per-side margins (left, top, right, bottom),
// clamped so it never inverts. Positioning a child inside a parent's padding.
[2][2]$T margin([2][2]T r, T left, top, right, bottom) where T is scalar:
    T x = rx(r) + left
    T y = ry(r) + top
    T w = rw(r) - left - right
    T h = rh(r) - top - bottom
    if w < 0: w = 0
    if h < 0: h = 0
    return [[x, y], [w, h]]

// ── grow / bounds ────────────────────────────────────────────────────────

[2][2]$T grow([2]T position, extent, T dt) where T is scalar:
    // Expands the rectangle uniformly in all 4 directions by dt
    [2]T new_pos = (position.x - dt, position.y - dt)
    [2]T new_size = (extent.x + (dt * 2), extent.y + (dt * 2))
    return (new_pos, new_size)

// Standard ordering: left, top, right, bottom
[2][2]$T grow_sides([2]T position, extent, T left, top, right, bottom) where T is scalar:
    [2]T new_pos = (position.x - left, position.y - top)
    [2]T new_size = (extent.x + left + right, extent.y + top + bottom)
    return (new_pos, new_size)

[2][2]$T grow_to_point([2]T position, extent, point) where T is scalar:
    // Expands bounding box to encompass a target point
    T min_x = math.min(position.x, point.x)
    T min_y = math.min(position.y, point.y)
    T max_x = math.max(position.x + extent.x, point.x)
    T max_y = math.max(position.y + extent.y, point.y)

    [2]T new_pos = (min_x, min_y)
    [2]T new_size = (max_x - min_x, max_y - min_y)
    return (new_pos, new_size)

[2][2]$T grow_to_rect([2]T position, extent, to_position, to_size) where T is scalar:
    // Computes the union bounding box of two rectangles
    T min_x = math.min(position.x, to_position.x)
    T min_y = math.min(position.y, to_position.y)
    T max_x = math.max(position.x + extent.x, to_position.x + to_size.x)
    T max_y = math.max(position.y + extent.y, to_position.y + to_size.y)

    [2]T new_pos = (min_x, min_y)
    [2]T new_size = (max_x - min_x, max_y - min_y)
    return (new_pos, new_size)

// ── slicing ──────────────────────────────────────────────────────────────

[2][2][2]$T vslice([2]T position, extent, T distance) where T is scalar:
    // Vertical split along X-axis (left rect, right rect)
    T split_x = math.min(math.max(distance, 0), extent.x)

    [2][2]T left_rect = (position, (split_x, extent.y))
    [2][2]T right_rect = ((position.x + split_x, position.y), (extent.x - split_x, extent.y))

    return (left_rect, right_rect)

[2][2][2]$T hslice([2]T position, extent, T distance) where T is scalar:
    // Horizontal split along Y-axis (top rect, bottom rect)
    T split_y = math.min(math.max(distance, 0), extent.y)

    [2][2]T top_rect = (position, (extent.x, split_y))
    [2][2]T bottom_rect = ((position.x, position.y + split_y), (extent.x, extent.y - split_y))

    return (top_rect, bottom_rect)

[2][2]$T positive([2]T position, extent) where T is scalar:
    // Fixes negative dimensions by adjusting origin point
    T new_x = position.x
    T new_y = position.y
    T new_w = extent.x
    T new_h = extent.y

    if new_w < 0:
        new_x += new_w
        new_w = -new_w

    if new_h < 0:
        new_y += new_h
        new_h = -new_h

    return ((new_x, new_y), (new_w, new_h))

$T area([2]T position, extent) where T is scalar:
    return extent.x * extent.y

$T perimeter([2]T position, extent) where T is scalar:
    return (extent.x * 2) + (extent.y * 2)

// ── stacks: equal division into n children (top-down) ───────────────────
//
// `n`/`gap`/`i` are counts and always `i32`; only the extent they carve up is
// width-agnostic. This is the primitive `app:ui`'s `stackv`/`stackh` layout
// helpers are built on — arranging *which* child gets which cell is UI
// opinion and stays there; dividing a rect into equal shares is
// pure geometry and lives here.

// The i-th of `n` equal rows stacked down `area`, with `gap` blank rows
// between. A vertical flex row: children share the height evenly, top to
// bottom.
[2][2]$T stackv([2][2]T area, i32 n, gap, i) where T is scalar:
    if n <= 0: return area
    T cell = (rh(area) - T(gap * (n - 1))) / T(n)
    if cell < 0: cell = 0
    T y = ry(area) + T(i) * (cell + T(gap))
    return [[rx(area), y], [rw(area), cell]]

// The i-th of `n` equal columns across `area`, with `gap` blank columns
// between.
[2][2]$T stackh([2][2]T area, i32 n, gap, i) where T is scalar:
    if n <= 0: return area
    T cell = (rw(area) - T(gap * (n - 1))) / T(n)
    if cell < 0: cell = 0
    T x = rx(area) + T(i) * (cell + T(gap))
    return [[x, ry(area)], [cell, rh(area)]]

// The cell at (col, row) of a `cols`×`rows` grid over `area`, with `gx`/`gy`
// gaps. Top-down and left-to-right; equal cells.
[2][2]$T grid([2][2]T area, i32 cols, rows, gx, gy, col, row) where T is scalar:
    i32 c = cols
    i32 r = rows
    if c <= 0: c = 1
    if r <= 0: r = 1
    T cw = (rw(area) - T(gx * (c - 1))) / T(c)
    T ch = (rh(area) - T(gy * (r - 1))) / T(r)
    if cw < 0: cw = 0
    if ch < 0: ch = 0
    T x = rx(area) + T(col) * (cw + T(gx))
    T y = ry(area) + T(row) * (ch + T(gy))
    return [[x, y], [cw, ch]]

// ── positioning a fixed-size box within a parent ────────────────────────

// Where a fixed-size box sits inside a larger allocation.
enum i32 Align: (Start, Center, End)

// Place a `w`×`h` box inside `parent`, aligned on each axis.
[2][2]$T align_in([2][2]T parent, T w, h, Align ax, ay) where T is scalar:
    T x = rx(parent)
    switch ax:
        case Align.Start:  x = rx(parent)
        case Align.Center: x = rx(parent) + (rw(parent) - w) / T(2)
        case Align.End:    x = rx(parent) + rw(parent) - w
        else:              x = rx(parent)
    T y = ry(parent)
    switch ay:
        case Align.Start:  y = ry(parent)
        case Align.Center: y = ry(parent) + (rh(parent) - h) / T(2)
        case Align.End:    y = ry(parent) + rh(parent) - h
        else:              y = ry(parent)
    return [[x, y], [w, h]]

// A `w`×`h` box centred in `parent`.
[2][2]$T center_in([2][2]T parent, T w, h) where T is scalar:
    return align_in(parent, w, h, Align.Center, Align.Center)
