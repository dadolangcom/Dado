@test
package rect

private type F2: [2]f32
private type I2: [2]i32
private type FR: [2][2]f32

private bool same(Rect a, i32 ex, i32 ey, i32 ew, i32 eh):
    return x(a) == ex && y(a) == ey && w(a) == ew && h(a) == eh

private bool samef([2][2]f32 a, f32 ex, f32 ey, f32 ew, f32 eh):
    return a[0].x == ex && a[0].y == ey && a[1].x == ew && a[1].y == eh

private bool test_accessors():
    bool ok = true
    Rect r = rect(1, 2, 40, 10)
    ok = #expect(x(r) == 1 && y(r) == 2 && w(r) == 40 && h(r) == 10, "Rect constructor and accessors (i32)") && ok
    FR f = [[0.5, 1.5], [40.0, 10.0]]
    ok = #expect(x(f) == 0.5 && y(f) == 1.5 && w(f) == 40.0 && h(f) == 10.0, "accessors on a raw [2][2]f32") && ok
    return ok

private bool test_containment():
    bool ok = true
    Rect big = rect(0, 0, 10, 10)
    ok = #expect(contains_rect(big, rect(2, 2, 3, 3)), "contains_rect inside") && ok
    ok = #expect(contains_rect(big, big), "contains_rect itself") && ok
    ok = #expect(!contains_rect(big, rect(8, 8, 3, 3)), "contains_rect crossing the edge") && ok
    ok = #expect(!contains_rect(big, rect(-1, 0, 2, 2)), "contains_rect left of it") && ok
    ok = #expect(contains_rect(FR([[0.0, 0.0], [1.0, 1.0]]), FR([[0.25, 0.25], [0.5, 0.5]])), "contains_rect (f32)") && ok

    // contains is half-open: the top and left edges hold, the bottom and right do not.
    Rect r = rect(0, 0, 10, 10)
    ok = #expect(contains(r, I2((0, 0))) && contains(r, I2((9, 9))), "contains: corners within") && ok
    ok = #expect(!contains(r, I2((10, 5))) && !contains(r, I2((5, 10))), "contains: far edges outside") && ok
    ok = #expect(!contains(r, I2((-1, 5))), "contains: left of it") && ok
    ok = #expect(!contains(rect(3, 3, 0, 5), I2((3, 4))), "contains: no width holds nothing") && ok
    ok = #expect(contains(FR([[0.0, 0.0], [1.0, 1.0]]), F2((0.999, 0.0))), "contains (f32)") && ok
    return ok

private bool test_overlap():
    bool ok = true
    Rect a = rect(0, 0, 4, 4)
    (Rect both, bool hit) = intersection(a, rect(2, 1, 5, 2))
    ok = #expect(hit && same(both, 2, 1, 2, 2), "intersection: ", both) && ok
    (both, hit) = intersection(a, rect(1, 1, 2, 2))
    ok = #expect(hit && same(both, 1, 1, 2, 2), "intersection: one inside the other") && ok
    (both, hit) = intersection(a, rect(4, 0, 2, 2))
    ok = #expect(!hit && same(both, 0, 0, 0, 0), "intersection: touching edges share nothing") && ok
    (both, hit) = intersection(a, rect(9, 9, 2, 2))
    ok = #expect(!hit, "intersection: apart") && ok
    ok = #expect(overlaps(a, rect(3, 3, 5, 5)) && overlaps(rect(3, 3, 5, 5), a), "overlaps, both ways") && ok
    ok = #expect(!overlaps(a, rect(4, 4, 1, 1)), "corners touching do not overlap") && ok
    ok = #expect(!overlaps(a, rect(1, 1, 0, 2)), "no width does not overlap") && ok
    ([2][2]f32 fboth, bool fhit) = intersection(FR([[0.0, 0.0], [4.0, 4.0]]), FR([[2.0, 1.0], [5.0, 2.0]]))
    ok = #expect(fhit && samef(fboth, 2.0, 1.0, 2.0, 2.0), "intersection (f32)") && ok
    return ok

private bool test_padding():
    bool ok = true
    Rect r = rect(0, 0, 40, 10)
    ok = #expect(same(inset(r, 2, 1), 2, 1, 36, 8), "inset (i32)") && ok
    ok = #expect(same(inset(rect(0, 0, 3, 3), 2, 2), 2, 2, 0, 0), "inset clamps to zero") && ok
    ok = #expect(same(margin(r, 2, 1, 3, 4), 2, 1, 35, 5), "margin (i32)") && ok
    ok = #expect(same(margin(rect(0, 0, 4, 4), 3, 3, 3, 3), 3, 3, 0, 0), "margin clamps to zero") && ok
    ok = #expect(samef(inset(FR([[0.0, 0.0], [40.0, 10.0]]), 2.0, 1.0), 2.0, 1.0, 36.0, 8.0), "inset (f32)") && ok
    return ok

private bool test_grow():
    bool ok = true
    Rect r = rect(2, 3, 4, 5)
    ok = #expect(same(grow(r, 1), 1, 2, 6, 7), "grow") && ok
    ok = #expect(same(grow(r, -1), 3, 4, 2, 3), "grow by a negative shrinks") && ok
    ok = #expect(same(grow_sides(r, 1, 2, 3, 4), 1, 1, 8, 11), "grow_sides") && ok
    ok = #expect(same(grow_to_point(r, I2((10, 0))), 2, 0, 8, 8), "grow_to_point outside") && ok
    ok = #expect(same(grow_to_point(r, I2((3, 4))), 2, 3, 4, 5), "grow_to_point inside changes nothing") && ok
    ok = #expect(same(grow_to_rect(r, rect(-1, 4, 2, 10)), -1, 3, 7, 11), "grow_to_rect") && ok
    ok = #expect(samef(grow(FR([[0.0, 0.0], [1.0, 1.0]]), 0.5), -0.5, -0.5, 2.0, 2.0), "grow (f32)") && ok
    return ok

private bool test_slice():
    bool ok = true
    FR whole = [[0.0, 0.0], [10.0, 10.0]]
    ([2][2]f32 left, [2][2]f32 right) = vslice(whole, 3.0)
    ok = #expect(samef(left, 0.0, 0.0, 3.0, 10.0) && samef(right, 3.0, 0.0, 7.0, 10.0), "vslice") && ok
    (left, right) = vslice(whole, 30.0)
    ok = #expect(samef(left, 0.0, 0.0, 10.0, 10.0) && samef(right, 10.0, 0.0, 0.0, 10.0), "vslice clamps past the width") && ok
    (left, right) = vslice(whole, -3.0)
    ok = #expect(samef(left, 0.0, 0.0, 0.0, 10.0) && samef(right, 0.0, 0.0, 10.0, 10.0), "vslice clamps below zero") && ok

    ([2][2]i32 top, [2][2]i32 bottom) = hslice(rect(1, 1, 4, 6), 2)
    ok = #expect(same(top, 1, 1, 4, 2) && same(bottom, 1, 3, 4, 4), "hslice") && ok
    (top, bottom) = hslice(rect(1, 1, 4, 6), 9)
    ok = #expect(same(top, 1, 1, 4, 6) && same(bottom, 1, 7, 4, 0), "hslice clamps past the height") && ok
    (top, bottom) = hslice(rect(1, 1, 4, 6), -1)
    ok = #expect(same(top, 1, 1, 4, 0) && same(bottom, 1, 1, 4, 6), "hslice clamps below zero") && ok
    return ok

private bool test_measure():
    bool ok = true
    ok = #expect(same(positive(rect(5, 5, -3, -2)), 2, 3, 3, 2), "positive flips both") && ok
    ok = #expect(same(positive(rect(5, 5, 3, 2)), 5, 5, 3, 2), "positive keeps a positive one") && ok
    ok = #expect(samef(positive(FR([[0.0, 0.0], [-1.5, 2.0]])), -1.5, 0.0, 1.5, 2.0), "positive (f32)") && ok
    ok = #expect(area(FR([[0.0, 0.0], [10.0, 10.0]])) == 100.0, "area") && ok
    ok = #expect(perimeter(FR([[0.0, 0.0], [10.0, 10.0]])) == 40.0, "perimeter") && ok
    ok = #expect(area(rect(7, 7, 3, 4)) == 12 && perimeter(rect(7, 7, 3, 4)) == 14, "area and perimeter (i32)") && ok
    return ok

private bool test_stacks():
    bool ok = true
    Rect r = rect(0, 0, 40, 10)
    ok = #expect(same(stackv(r, 2, 0, 1), 0, 5, 40, 5), "stackv (i32)") && ok
    ok = #expect(same(stackh(r, 4, 1, 1), 10, 0, 9, 10), "stackh (i32)") && ok
    ok = #expect(same(stackv(r, 0, 0, 0), 0, 0, 40, 10), "stackv of none is the area") && ok
    ok = #expect(same(grid(rect(0, 0, 40, 20), 2, 2, 0, 0, 1, 1), 20, 10, 20, 10), "grid (i32)") && ok
    // Float division does not truncate: 37/4 is 9.25 where i32 answers 9.
    FR f = [[0.0, 0.0], [40.0, 10.0]]
    [2][2]f32 fsh = stackh(f, 4, 1, 1)
    ok = #expect(fsh[0].x == 10.25 && fsh[1].x == 9.25, "stackh (f32)") && ok
    return ok

private bool test_align():
    bool ok = true
    ok = #expect(same(align_in(rect(0, 0, 40, 10), 10, 2, Align.End, Align.Center), 30, 4, 10, 2), "align_in (i32)") && ok
    ok = #expect(same(align_in(rect(5, 5, 40, 10), 10, 2, Align.Start, Align.End), 5, 13, 10, 2), "align_in start and end") && ok
    ok = #expect(same(center_in(rect(0, 0, 40, 10), 10, 2), 15, 4, 10, 2), "center_in (i32)") && ok
    [2][2]f32 fal = align_in(FR([[0.0, 0.0], [40.0, 10.0]]), 10.0, 2.0, Align.End, Align.Center)
    ok = #expect(samef(fal, 30.0, 4.0, 10.0, 2.0), "align_in (f32)") && ok
    return ok

i32 test():
    bool ok = true
    ok = test_accessors() && ok
    ok = test_containment() && ok
    ok = test_overlap() && ok
    ok = test_padding() && ok
    ok = test_grow() && ok
    ok = test_slice() && ok
    ok = test_measure() && ok
    ok = test_stacks() && ok
    ok = test_align() && ok
    return 0 if ok else 1
