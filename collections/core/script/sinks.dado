// core:script — where a script's output and its failures go: the sinks
// `#script_vm`'s `out:` and `err:` lower to.
//
// **Set on the VM, saved per run, as a stack.** An engine has an output
// sink, which `print` and `println` write to, and an error sink, which a
// failure's text is written to. `create` makes them standard output and
// standard error, the streams `core:fmt` writes to, so a script's lines and
// the program's never reorder; `#script_vm(…, out: s, err: e)` sets them for
// the VM's life. Every run entering an engine pushes the engine's two sinks,
// and every run leaving pops them — on return, on failure, and on a stop,
// which leaves through the same door — so a run made from inside another
// nests and the outer run's sinks are back when it returns.
//
// **Scoped per thread.** `c.greet(x) using out: log` and a suite opened by
// `using out: log:` put a sink in force on the calling thread for their
// extent: the compiled program reads the one in force (`scope_out`), puts
// its own in (`scope_set_out`), and puts the saved one back at every exit
// of the scope, so scopes nest and the innermost wins. A run entering any
// engine on the thread inside a scope writes to the scope's sinks for that
// run; outside every scope, the engine's own hold.
//
// **They wait beside no engine**, as a run's arguments do: `pend_out` and
// `pend_err` keep the next verb's sinks on the calling thread, and the verb
// takes them once it has entered its engine.
package script

import "core:io"

// How deep runs on one engine nest: a run made from a Dado function a script
// calls, from a script that run called, and so on. Past it a run fails
// `NO_MEMORY`.
const i32 MAX_NEST = 64

// The sinks the runs in progress on an engine displaced, one pair a run, the
// outermost first.
type SinkStack:
    [MAX_NEST]Sink out,
    [MAX_NEST]Sink err,

// The sinks a `using` scope put in force on this thread; a sink whose
// procedure is nil is none, and an engine's own sink holds.
private @thread_local Sink g_scope_out
private @thread_local Sink g_scope_err

// The output sink a `using out:` scope put in force on this thread — nil
// outside every scope. Read where a scope opens, to put back when it ends.
Sink scope_out():
    return g_scope_out

// `s` in force as this thread's scoped output sink: a scope's own on
// entering it, the one it saved on leaving it.
void scope_set_out(Sink s):
    g_scope_out = s

// The error sink a `using err:` scope put in force on this thread.
Sink scope_err():
    return g_scope_err

// `s` in force as this thread's scoped error sink.
void scope_set_err(Sink s):
    g_scope_err = s

// A run that has just entered `e`: the sinks a scope put in force are the
// engine's for the run — the ones `sinks_push` saved come back when it
// leaves.
private void scope_take(Engine e):
    if g_scope_out.proc != nil:
        e^.out = g_scope_out
    if g_scope_err.proc != nil:
        e^.err = g_scope_err

// Where a failure of a call coming into `e` is written before the call has
// entered it: the scope's error sink, or the engine's.
private Sink err_of(Engine e):
    if g_scope_err.proc != nil:
        return g_scope_err
    return e^.err

private @thread_local Sink g_out_next
private @thread_local Sink g_err_next
private @thread_local bool g_out_given
private @thread_local bool g_err_given

// The next verb's output sink, `out:`.
void pend_out(Sink s):
    g_out_next = s
    g_out_given = true

// The next verb's error sink, `err:`.
void pend_err(Sink s):
    g_err_next = s
    g_err_given = true

// The waiting sinks, forgotten: the verb they were given to made no run.
private void drop_sinks():
    g_out_given = false
    g_err_given = false

// The waiting sinks, made the engine's: for the run that has just entered it,
// or, at a load, for the engine's life.
private void take_sinks(Engine e):
    if g_out_given:
        e^.out = g_out_next
    if g_err_given:
        e^.err = g_err_next
    drop_sinks()

// Where a failure with no engine to say it on is written: the error sink
// the verb was given, the one a scope put in force, or standard error.
private Sink loose_err():
    if g_err_given:
        return g_err_next
    if g_scope_err.proc != nil:
        return g_scope_err
    return io.stderr_sink()

// A run entering: the engine's sinks saved at its depth.
private void sinks_push(Engine e, i32 depth):
    e^.sinks.out[depth] = e^.out
    e^.sinks.err[depth] = e^.err

// A run leaving: the sinks it entered with, back.
private void sinks_pop(Engine e, i32 depth):
    e^.out = e^.sinks.out[depth]
    e^.err = e^.sinks.err[depth]
