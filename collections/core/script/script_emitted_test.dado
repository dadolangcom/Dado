@test
// What `dadoc --emit=js` writes, run on the fork: the modules of the DadoScript
// cases `dados_scalar`, `dados_class_block`, `dados_int_tiers`,
// `dados_float_render`, `dados_raise`, `dados_containers`, `dados_failure`,
// `dados_classes`, `dados_packages`, `dados_any`, `dados_platform`,
// `dados_generics`, `dados_closures`, `dados_javascript`, `dados_async` and
// `dados_traits` (`tests/cases`), with the runtime they import,
// `dados:runtime`, registered in one engine, loaded under the fork's DadoScript
// flag and driven as each case's `.run` drives it under node — the class
// constructed with its arguments, methods called by name, an answer printed as
// `<method> returned <value>` and a raise as `<method> threw <the error>`.
//
// **Three engines, one text.** Each case's output here is held to the
// `.stdout` its node run is held to (`dados_cases_run_under_node_as_their_stdout_says`,
// in the compiler's end-to-end tests), embedded below. So node's JavaScript
// definitions of the tier operations and the fork's opcodes for them give
// the same answers on every line, and — since `dados_int_tiers.stdout` is also
// the text `dados_int_reference`, the same arithmetic in Dado over `i64`, prints
// under gcc and clang — a DadoScript `int` is Dado's `i64` on all three.
//
// **The float renderer is Dado's.** `dados_float_render` prints some 1 300
// doubles; `float_reference` below computes the same doubles by the same
// arithmetic in Dado and writes each with `fmt.put_float_shortest`, and the two
// texts are held equal: `string(x)` in DadoScript is `put_float_shortest` in Dado.
//
// **Every other script case runs here too, by generated code**
// (`forked_cases`): each in an engine of its own, its `.run` played as the
// node driver plays it and its output held to the same `.stdout`, so the
// corpus node runs is the corpus the fork runs and a difference fails.
//
// The block between the two `generated` lines is written by
// `script_emitted_test_is_current` (in the compiler's snapshot tests) from
// `--emit=js`, the runtime, the `.run` and the `.stdout` files, and rewritten
// by `DADO_BLESS=1`; a module that changes and is not re-blessed fails that test.
package script

import "core:fmt"
import "core:mem/libc"
import "core:io"

// Every module's source, NUL-terminated, one after another: the engine
// borrows each for its life.
private [262144]char8 js_store
private [131072]char8 out_store
private [131072]char8 want_store
private [8192]char8 err_store
private fmt.Cursor js_c
private fmt.Cursor out_c
private fmt.Cursor want_c
private fmt.Cursor err_c

// What `js_c` holds from `start` on, closed with a NUL, as a C string.
private cstring closed(i64 start):
    _ = fmt.put_string("\0", fmt.to_bytes(&js_c))
    string8 all = fmt.written(js_c)
    return cstring(rawptr(all[start..<#len(all)]))

private i64 at():
    return js_c.used

// An unexpected failure: what failed, its code and what the engine said.
private i32 stop(string8 what, i32 code):
    fmt.writeln(io.stderr_sink(), what, " failed with ", code, ": ", fmt.written(err_c))
    return 1

// The first line the error sink holds — an exception's `String(error)` —
// and the sink emptied.
private string8 thrown():
    string8 said = fmt.written(err_c)
    i64 n = 0
    for n < #len(said) && said[n] != '\n':
        n += 1
    return said[0..<n]

// `<method> threw <the error>`, into the output as the node driver writes it.
private void threw(string8 method):
    fmt.writeln(fmt.to_bytes(&out_c), method, " threw ", thrown())
    fmt.rewind(&err_c)

// Whether the output matches what `case`'s `.stdout` says, saying where not.
private bool same(string8 case):
    string8 got = fmt.written(out_c)
    string8 want = fmt.written(want_c)
    if out_c.overflowed || want_c.overflowed:
        fmt.writeln(io.stderr_sink(), case, ": a buffer overflowed")
        return false
    if got == want:
        return true
    i64 n = 0
    for n < #len(got) && n < #len(want) && got[n] == want[n]:
        n += 1
    i64 from = n
    for from > 0 && got[from - 1] != '\n':
        from -= 1
    i64 upto = n
    for upto < #len(got) && got[upto] != '\n':
        upto += 1
    i64 wupto = n
    for wupto < #len(want) && want[wupto] != '\n':
        wupto += 1
    fmt.writeln(io.stderr_sink(), case, " on the fork printed \"", got[from..<upto], "\" where its .stdout says \"", want[from..<wupto], "\"")
    return false

// `dados_float_render`'s doubles, by its arithmetic, each written by
// `put_float_shortest` as `println` writes it in the script.
private void float_reference(Sink out):
    f64 zero = 0.0
    line(0.0, out)
    line(-zero, out)
    line(1.0, out)
    line(-1.0, out)
    line(0.1, out)
    line(100.0, out)
    line(123.456, out)
    line(1234567890123456.0, out)
    line(9999999999999998.0, out)
    line(1e16, out)
    line(0.0001, out)
    line(0.00001, out)
    line(1e21, out)
    line(1e22, out)
    line(1e23, out)
    line(123456789.0, out)
    line(5e-324, out)
    line(2.2250738585072014e-308, out)
    line(1.7976931348623157e308, out)
    line(zero / zero, out)
    line(1.0 / zero, out)
    line(-1.0 / zero, out)
    _ = put_float_shortest(2.5, out)
    _ = fmt.put_string(" ", out)
    _ = put_float_shortest(-0.5, out)
    _ = fmt.put_string(" ", out)
    line(1.0 / 3.0, out)
    _ = put_float_shortest(0.5, out)
    _ = fmt.put_string(" ", out)
    _ = put_float_shortest(0.25, out)
    _ = fmt.put_string(" ", out)
    line(3.0, out)
    f64 x = 1.0
    for i in 0..<320:
        line(x, out)
        x = x * 10.0
    x = 1.0
    for i in 0..<330:
        line(x, out)
        x = x / 10.0
    x = 0.1
    for i in 0..<400:
        line(x, out)
        x = x * 1.37 + 0.001
        if x > 1e300:
            x = x / 1e300 * 0.7
    for i in 1..<200:
        _ = put_float_shortest(1.0 / f64(i), out)
        _ = fmt.put_string(" ", out)
        _ = put_float_shortest(f64(i) / 7.0, out)
        _ = fmt.put_string(" ", out)
        line(-f64(i * i) * 0.001, out)

// Register the module `name`, whose source `write` writes.
private !void add(Engine e, cstring name, void(Sink) write):
    i64 start = at()
    write(fmt.to_bytes(&js_c))
    if js_c.overflowed:
        fail stop("storing the modules", 0)
    try add_module(e, name, closed(start)) else code:
        fail stop("add_module", code)

// Load `module`, construct its `class` with nothing, and run `main`, which
// answers an `int`.
private !i64 run_main(Engine e, cstring module, cstring class):
    try Handle ns = load(e, module) else code:
        fail stop("load", code)
    try Handle o = construct(e, ns, class) else code:
        fail stop("new", code)
    try call_method(e, o, "main") else code:
        fail stop("main", code)
    try i64 answer = result_i64(e) else code:
        fail stop("result_i64", code)
    return answer

private void line(f64 x, Sink out):
    _ = put_float_shortest(x, out)
    _ = fmt.put_string("\n", out)

private i64 put_float_shortest(f64 x, Sink out):
    return fmt.put_float_shortest(x, out)

i32 test():
    bool ok = true
    js_c = fmt.over(js_store[:])
    out_c = fmt.over(out_store[:])
    want_c = fmt.over(want_store[:])
    err_c = fmt.over(err_store[:])
    try Engine e = create(libc.allocator()) else code:
        return stop("create", code)
    defer destroy(e)
    set_sinks(e, fmt.to_bytes(&out_c), fmt.to_bytes(&err_c))

    // Every module in one engine, under the names `--emit=js` gives them.
    i64 start = at()
    js_runtime(fmt.to_bytes(&js_c))
    try add_module(e, "dados:runtime", closed(start)) else code:
        return stop("add_module(dados:runtime)", code)
    start = at()
    js_counter(fmt.to_bytes(&js_c))
    try add_module(e, "main/Counter", closed(start)) else code:
        return stop("add_module(main/Counter)", code)
    start = at()
    js_greeter(fmt.to_bytes(&js_c))
    try add_module(e, "main/greeter", closed(start)) else code:
        return stop("add_module(main/greeter)", code)
    start = at()
    js_tally(fmt.to_bytes(&js_c))
    try add_module(e, "main/Tally", closed(start)) else code:
        return stop("add_module(main/Tally)", code)
    start = at()
    js_int_tiers(fmt.to_bytes(&js_c))
    try add_module(e, "main/IntTiers", closed(start)) else code:
        return stop("add_module(main/IntTiers)", code)
    start = at()
    js_float_render(fmt.to_bytes(&js_c))
    try add_module(e, "main/FloatRender", closed(start)) else code:
        return stop("add_module(main/FloatRender)", code)
    start = at()
    js_raise(fmt.to_bytes(&js_c))
    try add_module(e, "main/Raise", closed(start)) else code:
        return stop("add_module(main/Raise)", code)
    start = at()
    js_containers(fmt.to_bytes(&js_c))
    try add_module(e, "main/Containers", closed(start)) else code:
        return stop("add_module(main/Containers)", code)
    start = at()
    js_failure(fmt.to_bytes(&js_c))
    try add_module(e, "main/Failure", closed(start)) else code:
        return stop("add_module(main/Failure)", code)
    start = at()
    js_anys(fmt.to_bytes(&js_c))
    try add_module(e, "main/Anys", closed(start)) else code:
        return stop("add_module(main/Anys)", code)
    start = at()
    js_plat(fmt.to_bytes(&js_c))
    try add_module(e, "main/Plat", closed(start)) else code:
        return stop("add_module(main/Plat)", code)
    start = at()
    js_generics(fmt.to_bytes(&js_c))
    try add_module(e, "main/Generics", closed(start)) else code:
        return stop("add_module(main/Generics)", code)
    start = at()
    js_closures(fmt.to_bytes(&js_c))
    try add_module(e, "main/Closures", closed(start)) else code:
        return stop("add_module(main/Closures)", code)
    // `dados_classes` and `dados_packages`: classes that construct, extend and
    // import one another, every module registered for the loader to find.
    try add(e, "main/Arena", js_arena) else code:
        return code
    try add(e, "main/Boss", js_boss) else code:
        return code
    try add(e, "main/Goblin", js_goblin) else code:
        return code
    try add(e, "main/Goblin.Loot", js_goblin_loot) else code:
        return code
    try add(e, "main/Imp", js_imp) else code:
        return code
    try add(e, "main/Mob", js_mob) else code:
        return code
    try add(e, "main/Swarm", js_swarm) else code:
        return code
    try add(e, "main/Party", js_party) else code:
        return code
    try add(e, "npc/Goblin", js_npc_goblin) else code:
        return code
    try add(e, "npc/Goblin.Loot", js_npc_goblin_loot) else code:
        return code
    try add(e, "npc/Healer", js_npc_healer) else code:
        return code
    try add(e, "lore/Book", js_lore_book) else code:
        return code
    // `dados_javascript`: a class and the JavaScript it imports, each module
    // under the name the loader gave it, its specifiers rewritten to those.
    try add(e, "main/Interop", js_interop) else code:
        return code
    try add(e, "js:lib.js", jsfile_lib_js) else code:
        return code
    try add(e, "js:util/words.js", jsfile_util_words_js) else code:
        return code
    try add(e, "js:shapes/geometry.mjs", jsfile_shapes_geometry_mjs) else code:
        return code
    try add(e, "main/Async", js_async) else code:
        return code
    try add(e, "main/Async.Store", js_async_store) else code:
        return code
    // `dados_traits`: a class and the inner classes taking its traits on.
    try add(e, "main/Zoo", js_zoo) else code:
        return code
    try add(e, "main/Zoo.Cat", js_zoo_cat) else code:
        return code
    try add(e, "main/Zoo.Lion", js_zoo_lion) else code:
        return code
    try add(e, "main/Zoo.Nest", js_zoo_nest) else code:
        return code
    if js_c.overflowed:
        return stop("storing the modules", 0)

    // ── dados_scalar: `new Counter 10 "c"`, `call main -> int` ──────────────
    try Handle counter_ns = load(e, "main/Counter") else code:
        return stop("load(main/Counter)", code)
    arg_i64(e, 10)
    arg_string(e, "c")
    try Handle counter = construct(e, counter_ns, "Counter") else code:
        return stop("new Counter", code)
    try call_method(e, counter, "main") else code:
        return stop("Counter.main", code)
    try i64 counted = result_i64(e) else code:
        return stop("result_i64", code)
    fmt.writeln(fmt.to_bytes(&out_c), "main returned ", counted)
    stdout_dados_scalar(fmt.to_bytes(&want_c))
    ok = same("dados_scalar") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)

    // ── dados_class_block: `new greeter`, `call main`, `new Tally`,
    // `call main -> int` ─────────────────────────────────────────────────────
    try Handle greeter_ns = load(e, "main/greeter") else code:
        return stop("load(main/greeter)", code)
    try Handle greeter = construct(e, greeter_ns, "greeter") else code:
        return stop("new greeter", code)
    try call_method(e, greeter, "main") else code:
        return stop("greeter.main", code)
    try Handle tally_ns = load(e, "main/Tally") else code:
        return stop("load(main/Tally)", code)
    try Handle tally = construct(e, tally_ns, "Tally") else code:
        return stop("new Tally", code)
    try call_method(e, tally, "main") else code:
        return stop("Tally.main", code)
    try i64 total = result_i64(e) else code:
        return stop("result_i64", code)
    fmt.writeln(fmt.to_bytes(&out_c), "main returned ", total)
    stdout_dados_class_block(fmt.to_bytes(&want_c))
    ok = same("dados_class_block") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)

    // ── dados_int_tiers: `new IntTiers`, `call main` ────────────────────────
    try Handle tiers_ns = load(e, "main/IntTiers") else code:
        return stop("load(main/IntTiers)", code)
    try Handle tiers = construct(e, tiers_ns, "IntTiers") else code:
        return stop("new IntTiers", code)
    try call_method(e, tiers, "main") else code:
        return stop("IntTiers.main", code)
    stdout_dados_int_tiers(fmt.to_bytes(&want_c))
    ok = same("dados_int_tiers") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)

    // ── dados_float_render: `new FloatRender`, `call main`; and the same
    // doubles through `put_float_shortest` ────────────────────────────────────
    try Handle render_ns = load(e, "main/FloatRender") else code:
        return stop("load(main/FloatRender)", code)
    try Handle render = construct(e, render_ns, "FloatRender") else code:
        return stop("new FloatRender", code)
    try call_method(e, render, "main") else code:
        return stop("FloatRender.main", code)
    stdout_dados_float_render(fmt.to_bytes(&want_c))
    ok = same("dados_float_render") && ok
    fmt.rewind(&want_c)
    float_reference(fmt.to_bytes(&want_c))
    ok = same("dados_float_render against put_float_shortest") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)

    // ── dados_raise: each method on its own; a raise says so ────────────────
    try Handle raise_ns = load(e, "main/Raise") else code:
        return stop("load(main/Raise)", code)
    try Handle raising = construct(e, raise_ns, "Raise") else code:
        return stop("new Raise", code)
    try call_method(e, raising, "main") else code:
        return stop("Raise.main", code)
    try call_method(e, raising, "divide") else code:
        ok = #expect(code == THREW, "divide failed with ", code, ", not THREW") && ok
        threw("divide")
    try call_method(e, raising, "remainder") else code:
        ok = #expect(code == THREW, "remainder failed with ", code, ", not THREW") && ok
        threw("remainder")
    try call_method(e, raising, "big_divide") else code:
        ok = #expect(code == THREW, "big_divide failed with ", code, ", not THREW") && ok
        threw("big_divide")
    try call_method(e, raising, "compound") else code:
        ok = #expect(code == THREW, "compound failed with ", code, ", not THREW") && ok
        threw("compound")
    try call_method(e, raising, "after") else code:
        return stop("Raise.after", code)
    try i64 after = result_i64(e) else code:
        return stop("result_i64", code)
    fmt.writeln(fmt.to_bytes(&out_c), "after returned ", after)
    stdout_dados_raise(fmt.to_bytes(&want_c))
    ok = same("dados_raise") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)

    // ── dados_containers: `call main`, then each method on its own, every one
    // of which raises ─────────────────────────────────────────────────────────
    try Handle containers_ns = load(e, "main/Containers") else code:
        return stop("load(main/Containers)", code)
    try Handle containers = construct(e, containers_ns, "Containers") else code:
        return stop("new Containers", code)
    try call_method(e, containers, "main") else code:
        return stop("Containers.main", code)
    try call_method(e, containers, "past_the_end") else code:
        ok = #expect(code == THREW, "past_the_end failed with ", code, ", not THREW") && ok
        threw("past_the_end")
    try call_method(e, containers, "before_the_start") else code:
        ok = #expect(code == THREW, "before_the_start failed with ", code, ", not THREW") && ok
        threw("before_the_start")
    try call_method(e, containers, "past_i64") else code:
        ok = #expect(code == THREW, "past_i64 failed with ", code, ", not THREW") && ok
        threw("past_i64")
    try call_method(e, containers, "string_index") else code:
        ok = #expect(code == THREW, "string_index failed with ", code, ", not THREW") && ok
        threw("string_index")
    try call_method(e, containers, "string_window") else code:
        ok = #expect(code == THREW, "string_window failed with ", code, ", not THREW") && ok
        threw("string_window")
    try call_method(e, containers, "array_window") else code:
        ok = #expect(code == THREW, "array_window failed with ", code, ", not THREW") && ok
        threw("array_window")
    try call_method(e, containers, "missing_key") else code:
        ok = #expect(code == THREW, "missing_key failed with ", code, ", not THREW") && ok
        threw("missing_key")
    try call_method(e, containers, "pop_empty") else code:
        ok = #expect(code == THREW, "pop_empty failed with ", code, ", not THREW") && ok
        threw("pop_empty")
    try call_method(e, containers, "absent") else code:
        ok = #expect(code == THREW, "absent failed with ", code, ", not THREW") && ok
        threw("absent")
    try call_method(e, containers, "none_accepted") else code:
        ok = #expect(code == THREW, "none_accepted failed with ", code, ", not THREW") && ok
        threw("none_accepted")
    try call_method(e, containers, "insert_past") else code:
        ok = #expect(code == THREW, "insert_past failed with ", code, ", not THREW") && ok
        threw("insert_past")
    try call_method(e, containers, "negative_resize") else code:
        ok = #expect(code == THREW, "negative_resize failed with ", code, ", not THREW") && ok
        threw("negative_resize")
    try call_method(e, containers, "negative_repeat") else code:
        ok = #expect(code == THREW, "negative_repeat failed with ", code, ", not THREW") && ok
        threw("negative_repeat")
    try call_method(e, containers, "not_an_int") else code:
        ok = #expect(code == THREW, "not_an_int failed with ", code, ", not THREW") && ok
        threw("not_an_int")
    try call_method(e, containers, "past_int") else code:
        ok = #expect(code == THREW, "past_int failed with ", code, ", not THREW") && ok
        threw("past_int")
    try call_method(e, containers, "not_a_float") else code:
        ok = #expect(code == THREW, "not_a_float failed with ", code, ", not THREW") && ok
        threw("not_a_float")
    try call_method(e, containers, "no_code_point") else code:
        ok = #expect(code == THREW, "no_code_point failed with ", code, ", not THREW") && ok
        threw("no_code_point")
    stdout_dados_containers(fmt.to_bytes(&want_c))
    ok = same("dados_containers") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)

    // ── dados_failure: each method on its own; `uncaught` fails, and its
    // failure reaches the engine's caller as a DadoScript `Error`, code 16 ─────────
    try Handle failure_ns = load(e, "main/Failure") else code:
        return stop("load(main/Failure)", code)
    try Handle failing = construct(e, failure_ns, "Failure") else code:
        return stop("new Failure", code)
    try call_method(e, failing, "main") else code:
        return stop("Failure.main", code)
    try call_method(e, failing, "tries") else code:
        return stop("Failure.tries", code)
    try call_method(e, failing, "faults") else code:
        return stop("Failure.faults", code)
    try call_method(e, failing, "run_defers") else code:
        return stop("Failure.run_defers", code)
    try call_method(e, failing, "traced") else code:
        return stop("Failure.traced", code)
    try call_method(e, failing, "uncaught") else code:
        ok = #expect(code == THREW, "uncaught failed with ", code, ", not THREW") && ok
        ok = #expect(e^.thrown == 16, "uncaught's code was reported as ", e^.thrown, ", not 16") && ok
        threw("uncaught")
    stdout_dados_failure(fmt.to_bytes(&want_c))
    ok = same("dados_failure") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)

    // ── dados_classes: `new Arena`, `call main -> int` — the modules it
    // reaches load with it, in whatever order its imports name them ─────────
    try i64 arena = run_main(e, "main/Arena", "Arena") else code:
        return code
    fmt.writeln(fmt.to_bytes(&out_c), "main returned ", arena)
    stdout_dados_classes(fmt.to_bytes(&want_c))
    ok = same("dados_classes") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)

    // ── dados_packages: `new Party`, `call main -> int`, over two packages of
    // scripts that import each other ────────────────────────────────────────
    try i64 party = run_main(e, "main/Party", "Party") else code:
        return code
    fmt.writeln(fmt.to_bytes(&out_c), "main returned ", party)
    stdout_dados_packages(fmt.to_bytes(&want_c))
    ok = same("dados_packages") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)

    // ── dados_any: `call main`, then each method on its own, every one of
    // which leaves an `any` into a place it does not fit, and raises a fault,
    // a DadoScript `Error` of code 70 ──────────────────────────────────────────────
    try Handle anys_ns = load(e, "main/Anys") else code:
        return stop("load(main/Anys)", code)
    try Handle anys = construct(e, anys_ns, "Anys") else code:
        return stop("new Anys", code)
    try call_method(e, anys, "main") else code:
        return stop("Anys.main", code)
    try call_method(e, anys, "not_an_int") else code:
        ok = #expect(code == THREW, "not_an_int failed with ", code, ", not THREW") && ok
        ok = #expect(e^.thrown == 70, "not_an_int's code was reported as ", e^.thrown, ", not 70") && ok
        threw("not_an_int")
    try call_method(e, anys, "not_whole") else code:
        ok = #expect(code == THREW, "not_whole failed with ", code, ", not THREW") && ok
        threw("not_whole")
    try call_method(e, anys, "not_all_ints") else code:
        ok = #expect(code == THREW, "not_all_ints failed with ", code, ", not THREW") && ok
        threw("not_all_ints")
    try call_method(e, anys, "missing") else code:
        ok = #expect(code == THREW, "missing failed with ", code, ", not THREW") && ok
        threw("missing")
    try call_method(e, anys, "not_a_map") else code:
        ok = #expect(code == THREW, "not_a_map failed with ", code, ", not THREW") && ok
        threw("not_a_map")
    stdout_dados_any(fmt.to_bytes(&want_c))
    ok = same("dados_any") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)
    // ── dados_platform: `new Plat`, `call main` ───────────────────────────────
    try Handle plat_ns = load(e, "main/Plat") else code:
        return stop("load(main/Plat)", code)
    try Handle plat = construct(e, plat_ns, "Plat") else code:
        return stop("new Plat", code)
    try call_method(e, plat, "main") else code:
        return stop("Plat.main", code)
    stdout_dados_platform(fmt.to_bytes(&want_c))
    ok = same("dados_platform") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)
    // ── dados_generics: `new Generics`, `call main` ───────────────────────────
    try Handle generics_ns = load(e, "main/Generics") else code:
        return stop("load(main/Generics)", code)
    try Handle generics = construct(e, generics_ns, "Generics") else code:
        return stop("new Generics", code)
    try call_method(e, generics, "main") else code:
        return stop("Generics.main", code)
    stdout_dados_generics(fmt.to_bytes(&want_c))
    ok = same("dados_generics") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)
    // ── dados_closures: `new Closures`, `call main` ───────────────────────────
    try Handle closures_ns = load(e, "main/Closures") else code:
        return stop("load(main/Closures)", code)
    try Handle closures = construct(e, closures_ns, "Closures") else code:
        return stop("new Closures", code)
    try call_method(e, closures, "main") else code:
        return stop("Closures.main", code)
    stdout_dados_closures(fmt.to_bytes(&want_c))
    ok = same("dados_closures") && ok
    fmt.rewind(&out_c)
    fmt.rewind(&want_c)
    // ── dados_javascript: `new Interop`, `call main -> int` ─────────────────
    try Handle interop_ns = load(e, "main/Interop") else code:
        return stop("load(main/Interop)", code)
    try Handle interop = construct(e, interop_ns, "Interop") else code:
