// core:script — how the program ends when a script fails and nothing handled
// it: with the failure's code as its status, after its text is on the error
// sink (`exit_status`).
//
// **Natively it is `quit`.** On the web there is no process for `quit` to end
// (`quit` is refused there), and the loader that runs the module is what reads
// a status: the runtime the compiler emits into a `#WEB` program flushes the
// console and hands the status to the host's `dado.exit`, which unwinds the
// module to the loader, and the loader answers it as a native run's status.
// Defers do not run on the way, as they do not under `quit`.
package script

when #OS == #WEB:
    private foreign "dado/web.h":
        void dado_rt__web_exit_status(i32 status)

    // Ends the program with `status`; never returns.
    private void end_program(i32 status):
        dado_rt__web_exit_status(status)

else:
    // Ends the program with `status`; never returns.
    private void end_program(i32 status):
        quit status
