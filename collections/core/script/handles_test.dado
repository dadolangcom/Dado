@test
// The host's handle table in isolation (`handles.dado`), on the fork, with no
// emitter in front.
//
// * **A handle is a slot and a generation**, and a live one reads back its
//   engine and its instance.
// * **Letting go of a slot makes every copy stale**, and the slot is reused
//   only with a new generation, so a stale copy never reads the new holder.
// * **One object is one handle**: an instance that crosses again is answered
//   the handle it already has, and its mark is not enumerable.
// * **An instance belongs to its engine**: pushed into a run of another, it
//   is refused `OTHER_VM`; a stale one `STALE`.
// * **An engine's end makes every handle on it stale**, and the table holds
//   nothing of it afterwards.
package script

import "core:mem/libc"

private const cstring BOXES_JS = """
    export class Box { constructor(n) { this.n = n; } }
    export function keys(o) { return Object.keys(o).length; }
    """

i32 test():
    bool ok = true
    i64 before = live_handles()
    try Engine e = create(libc.allocator()) else code:
        _ = #expect(false, "create failed with ", code)
        return 1
    try Engine other = create(libc.allocator()) else code:
        _ = #expect(false, "the second create failed with ", code)
        destroy(e)
        return 1
    defer destroy(other)
    try add_module(e, "boxes", BOXES_JS) else code:
        _ = #expect(false, "add_module failed with ", code)
        return 1
    try Handle m = load(e, "boxes") else code:
        _ = #expect(false, "load failed with ", code)
        return 1

    // ── a slot and a generation ─────────────────────────────────────────────
    arg_i64(e, 7)
    try Handle o = construct(e, m, "Box") else code:
        _ = #expect(false, "construct failed with ", code)
        return 1
    rawptr h = hold_object(e, o, "Box")
    ok = #expect(h != nil, "no handle for the box") && ok
    Slot at
    ok = #expect(slot_read(h, &at) && at.engine == e && !at.owner, "the handle does not read back its engine") && ok
    ok = #expect((bits_of(h) >> 32) != 0, "a live handle's generation is 0") && ok
    ok = #expect(live_handles() == before + 1, "live handles ", live_handles(), ", wanted ", before + 1) && ok

    // ── one object, one handle ──────────────────────────────────────────────
    rawptr again = adopt(e, at.value, "Box")
    ok = #expect(again == h, "the box crossed again as another handle") && ok
    ok = #expect(live_handles() == before + 1, "crossing again made a slot") && ok
    push(e, JS_DupValue(e^.ctx, at.value))
    try call(e, m, "keys") else code:
        _ = #expect(false, "keys failed with ", code)
        return 1
    try i64 keys = result_i64(e) else code:
        _ = #expect(false, "keys answered no int: ", code)
        return 1
    ok = #expect(keys == 1, "the mark is enumerable: the box has ", keys, " keys") && ok

    // ── another VM, and a stale handle ──────────────────────────────────────
    ok = #expect(arg_instance(other, h, 1) == OTHER_VM, "another VM took the box") && ok
    clear_args(other)

    // ── letting go makes every copy stale ───────────────────────────────────
    rawptr copy = h
    ok = #expect(slot_take(h, &at), "the handle was not live") && ok
    JS_FreeValue(e^.ctx, at.value)
    ok = #expect(!slot_read(copy, &at), "a copy outlived the slot") && ok
    ok = #expect(!slot_take(copy, &at), "a copy let go of the slot twice") && ok
    ok = #expect(arg_instance(e, copy, 1) == STALE, "a stale handle was pushed") && ok
    clear_args(e)
    rawptr fresh = slot_new(e, undefined(), false, "Box")
    ok = #expect((bits_of(fresh) & 0xFFFFFFFF) == (bits_of(copy) & 0xFFFFFFFF), "the freed slot was not reused") && ok
    ok = #expect(fresh != copy && !slot_read(copy, &at), "a stale copy reads the slot's new holder") && ok

    // ── the engine's end ────────────────────────────────────────────────────
    destroy(e)
    ok = #expect(!slot_read(fresh, &at), "a handle outlived its engine") && ok
    ok = #expect(live_handles() == before, "live handles ", live_handles(), " after the end, wanted ", before) && ok
    if !ok:
        return 1
    return 0
