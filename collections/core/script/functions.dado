// core:script — Dado's call of a script's package function, `game.on_hit(a, b)`:
// an `export` method that reaches no `self`, called with no VM and no handle.
//
// **The thread's engine for package functions.** A package function reads no
// instance, so no VM the program made is the one to run it in: each thread
// that calls one gets an engine of its own, made on `#heap` the first time —
// the program's module table registered in it as `#script_vm` registers it —
// and kept for the thread's life. Its modules are loaded the first time a
// function of theirs is called, so a function sees its module's state, which
// no VM the program made shares.
//
// **Direct, or through the seam.** The compiler decides which, from what the
// function's body reads (`dado_check::dados::wrappers`), and hands the answer
// in as `seam`:
//
// * **direct** — one call of the cached function, `Class.prototype.name`,
//   with no receiver: the arguments made in the engine, the call, the answer
//   read. No run is entered — no stop accounting, no sinks swapped, no lend
//   lock — because the function reads nothing a run guards. On the web the
//   compiler does not come here at all: its JavaScript is the module's import.
// * **through the seam** — the same call inside a run of the engine, entered
//   and left as a member call's is, for a function that prints, calls Dado,
//   makes an instance or reads the global object.
//
// Every function below is failable as a member call is: a throw fails with the
// script's `Error`'s code, its text on the error sink first. The compiler
// writes the end of the program for an untried call itself: a trap, as a C
// call that aborts ends one.
package script

// How many of a thread's package functions are kept looked up; one past it is
// looked up on each call.
private const i64 MAX_FUNCTIONS = 256

// The thread's engine for package functions, as a VM's own handle, or nil
// before the first call.
private @thread_local rawptr g_fn_vm

// The functions looked up on this thread, by the compiler's index for each,
// each held by the engine until the thread ends.
private @thread_local [MAX_FUNCTIONS]JSValue g_fns
private @thread_local [MAX_FUNCTIONS]bool g_fn_held

// The thread's engine, made the first time with the program's module table.
private !Engine function_engine(const rawptr table, const rawptr bound, const rawptr channels):
    if g_fn_vm == nil:
        try rawptr vm = vm_create_on_heap(table, bound, channels) else code:
            drop_pending()
            fail code
        g_fn_vm = vm
    Slot at
    if !slot_read(g_fn_vm, &at):
        drop_pending()
        no_script(g_fn_vm)
        fail STALE
    return at.engine

// `Class.prototype.function` of the loaded `module`, the module loaded the
// first time, and kept for the thread under `index`. Borrowed: the cache
// holds it.
private !JSValue function_value(Engine e, i32 index, cstring module, cstring class, cstring function):
    bool cached = index >= 0 && i64(index) < MAX_FUNCTIONS
    if cached && g_fn_held[index]:
        return g_fns[index]
    try Handle m = module_of(e, module)
    JSValue k = JS_GetPropertyStr(e^.ctx, handle_at(e, m)^, class)
    if is_exception(k):
        report(e)
        fail THREW
    JSValue proto = JS_GetPropertyStr(e^.ctx, k, "prototype")
    JS_FreeValue(e^.ctx, k)
    if is_exception(proto):
        report(e)
        fail THREW
    JSValue f = JS_GetPropertyStr(e^.ctx, proto, function)
    JS_FreeValue(e^.ctx, proto)
    if is_exception(f):
        report(e)
        fail THREW
    if !JS_IsFunction(e^.ctx, f):
        JS_FreeValue(e^.ctx, f)
        say(e, "script: a package function the compiler named is not a function of its class's prototype")
        fail NO_SUCH
    if !cached:
        // Held for the call alone: the caller frees it (`function_done`).
        return f
    g_fns[index] = f
    g_fn_held[index] = true
    return f

// The call, its arguments those pushed, the answer left in the engine for a
// reader. Entered when `seam`; a failure has left, with its code a verb's.
private !Engine function_called(const rawptr table, const rawptr bound, const rawptr channels, i32 index, cstring module, cstring class, cstring function, bool seam):
    try Engine e = function_engine(table, bound, channels)
    if seam:
        try enter(e) else code:
            drop_pending()
            fail code
        take_sinks(e)
    try JSValue f = function_value(e, index, module, class, function) else code:
        drop_pending()
        fail function_left(e, seam, script_code(e, code))
    try take_pending(e) else code:
        function_done(e, index, f)
        fail function_left(e, seam, code)
    [MAX_ARGS]JSValue argv
    i32 n = take_args(e, &argv)
    JSValue r = JS_Call(e^.ctx, f, undefined(), n, &argv[0])
    free_args(e, &argv, n)
    function_done(e, index, f)
    try settle(e, r) else code:
        fail function_left(e, seam, script_code(e, code))
    return e

// A function looked up for one call alone, let go of.
private void function_done(Engine e, i32 index, JSValue f):
    if index < 0 || i64(index) >= MAX_FUNCTIONS:
        JS_FreeValue(e^.ctx, f)

// A failure's code, the run left first when it was entered.
private i32 function_left(Engine e, bool seam, i32 code):
    if seam:
        return leaving(e, code)
    return code

// The call is over: the run left when it was entered.
private void function_over(Engine e, bool seam):
    if seam:
        leave(e)

// The calls, one per answer's type.
!void call_function(const rawptr table, const rawptr bound, const rawptr channels, i32 index, cstring module, cstring class, cstring function, bool seam):
    try Engine e = function_called(table, bound, channels, index, module, class, function, seam)
    function_over(e, seam)

!i64 call_function_int(const rawptr table, const rawptr bound, const rawptr channels, i32 index, cstring module, cstring class, cstring function, bool seam):
    try Engine e = function_called(table, bound, channels, index, module, class, function, seam)
    try i64 v = result_i64(e) else code:
        fail function_left(e, seam, script_code(e, code))
    function_over(e, seam)
    return v

!f64 call_function_float(const rawptr table, const rawptr bound, const rawptr channels, i32 index, cstring module, cstring class, cstring function, bool seam):
    try Engine e = function_called(table, bound, channels, index, module, class, function, seam)
    try f64 v = result_f64(e) else code:
        fail function_left(e, seam, script_code(e, code))
    function_over(e, seam)
    return v

!bool call_function_bool(const rawptr table, const rawptr bound, const rawptr channels, i32 index, cstring module, cstring class, cstring function, bool seam):
    try Engine e = function_called(table, bound, channels, index, module, class, function, seam)
    try bool v = result_bool(e) else code:
        fail function_left(e, seam, script_code(e, code))
    function_over(e, seam)
    return v

// A `string` answer is a create verb's, as a member call's: a copy on the
// ambient allocator of the program that asked, which owns it.
!ref([]char8) call_function_string(const rawptr table, const rawptr bound, const rawptr channels, i32 index, cstring module, cstring class, cstring function, bool seam):
    try Engine e = function_called(table, bound, channels, index, module, class, function, seam)
    try string8 text = result_string(e) else code:
        fail function_left(e, seam, script_code(e, code))
    ref([]char8) out = #make([]char8, #len(text))
    if out == nil:
        fail function_left(e, seam, NO_MEMORY)
    for i in 0..<#len(text):
        out[i] = text[i]
    function_over(e, seam)
    return out

// On the web a direct call's `string` answer: the page encoded it and holds
// the bytes, `n` of them, until this copies them onto the ambient allocator.
when #OS == #WEB:
    private foreign "dado/web.h":
        void dado_rt__web_dados_fn_take(rawptr into)

    !ref([]char8) function_text(i64 n):
        ref([]char8) out = #make([]char8, n)
        if out == nil:
            fail NO_MEMORY
        if n > 0:
            dado_rt__web_dados_fn_take(rawptr(&out[0]))
        return out
