@test 1
// **This test passes if it exits 1**, and it exits 1 only when a script's
// uncaught exception came back as `THREW` through the default sinks.
//
// `script_test.dado` points both sinks at buffers so it can read what was
// written. This file leaves them where `create` puts them — standard output
// and standard error, the streams `core:fmt` writes to — which is the path a
// program that never calls `set_sinks` takes: the script's `println` reaches
// the process's standard output, and the exception's text and stack reach its
// standard error (`Error: the script gave up` and its `at` line are in the
// test's log). A failure of any other kind exits 2 or 3, and a script that did
// not throw exits 0, so neither can pass for this one.
package script

import "core:fmt"
import "core:mem/libc"

private const cstring GIVES_UP_JS = """
    export function run() {
        println("about to throw");
        throw new Error("the script gave up");
    }
    """

// **On the web this file runs nothing, and says so.** It drives the fork's
// module loader over ES modules embedded as strings (`add_module`), and the
// web has no fork: there a script's modules are files the build writes beside
// the module, and a module given as a string is never compiled (a page under
// a strict Content-Security-Policy cannot evaluate one). What the web's own
// loader does is the hosted cases' to show, each run on the web as natively.
when #OS == #WEB:
    private const bool ON_THE_FORK = false

else:
    private const bool ON_THE_FORK = true

i32 test():
    if !ON_THE_FORK:
        fmt.println("script_uncaught_test: skipped on the web, which loads no module given as a string")
        return 1
    try Engine e = create(libc.allocator()) else:
        return 2
    defer destroy(e)
    try add_module(e, "gives_up", GIVES_UP_JS) else:
        return 2
    try Handle m = load(e, "gives_up") else:
        return 2
    try call(e, m, "run") else code:
        if code == THREW:
            return 1
        return 3
    return 0
