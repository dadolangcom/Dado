// core:script — the values the glue transcodes or copies entry by entry: a
// Dado `string16`, `string32` or `cstring` crossing as a script's `string`,
// and a Dado map crossing as a script's `Map`.
//
// The generated glue holds a Dado string as C does — its units' address and
// count, or a `cstring`'s address — and these read and write the engine's
// side, by the same tags and with the same `TypeError`s as `script.dado`'s
// readers and writers of a `string8`; a map's entries are read as the array
// of its pairs and written one `set` at a time. A program does not call these
// by name.
package script

// ── Strings of other widths ──────────────────────────────────────────────────
//
// A Dado `string16`, `string32` or `cstring` crosses as a script's `string`,
// JavaScript's, transcoded each way. The generated glue holds the Dado string
// as C does — its units' address and count, or a `cstring`'s address — and
// these read and write the engine's side. A `string16` is UTF-16, so its units
// cross as they are, a lone surrogate included; a `string32` is read through
// the UTF-8 a `string8` is read as, so it keeps an unpaired surrogate as a
// `string8` keeps it, and a value past U+10FFFF is written as U+FFFD; a
// `cstring` is UTF-8 that ends at its first NUL, so a script's string holding
// a NUL character does not cross into one.

// `v` as a `string16`: the engine's UTF-16 copy of it, borrowed until
// `drop_units`; its count of code units into `n`.
!rawptr read_units(^JSContext ctx, JSValue v, cstring function, cstring what, ^i64 path, i32 depth, ^i64 n):
    i32 tag = i32(v.tag)
    if tag != JS_TAG_STRING && tag != JS_TAG_STRING_ROPE:
        mistyped_at(ctx, v, function, what, path, depth, "a string")
        fail TYPE
    #c.size_t got = 0
    ^const u16 units = JS_ToCStringLenUTF16(ctx, &got, v)
    if units == nil:
        fail THREW
    Engine e = Engine(JS_GetContextOpaque(ctx))
    e^.bytes_in += i64(got) * 2
    n^ = i64(got)
    return rawptr(units)

// Gives back the units `read_units` borrowed.
void drop_units(^JSContext ctx, rawptr p):
    JS_FreeCStringUTF16(ctx, ConstUnits(p))

// `n` UTF-16 code units at `p`, copied into the engine as they are.
JSValue give_units(^JSContext ctx, rawptr p, i64 n):
    Engine e = Engine(JS_GetContextOpaque(ctx))
    e^.bytes_out += n * 2
    if n == 0:
        return JS_NewStringLen(ctx, "", 0)
    return JS_NewStringUTF16(ctx, ConstUnits(p), #c.size_t(n))

// `mix` over a `string16`'s length and then each of its units.
u64 mix_units(u64 h, rawptr p, i64 n):
    u64 out = mix(h, u64(n))
    if n == 0:
        return out
    Units at = Units(p)
    []u16 run = at[0..<n]
    for i in 0..<n:
        out = mix(out, u64(run[i]))
    return out

// `v` as a `string32`: its code points, decoded from the UTF-8 `read_string`
// reads into a block on the engine's allocator, which `drop_points` gives
// back; their count into `n`.
!rawptr read_points(^JSContext ctx, JSValue v, cstring function, cstring what, ^i64 path, i32 depth, ^i64 n):
    try string8 s = read_string(ctx, v, function, what, path, depth)
    i64 count = decode_utf8(s, nil)
    rawptr block = nil
    try block = scratch(ctx, u64(count) * 4) else code:
        drop_string(ctx, s)
        fail code
    _ = decode_utf8(s, block)
    drop_string(ctx, s)
    n^ = count
    return block

// Gives back the block `read_points` filled with `n` code points.
void drop_points(^JSContext ctx, rawptr p, i64 n):
    unscratch(ctx, p, u64(n) * 4)

// `n` code points at `p`, copied into the engine as UTF-16: one past U+10FFFF
// as U+FFFD, the replacement character, and an unpaired surrogate as itself.
JSValue give_points(^JSContext ctx, rawptr p, i64 n):
    if n == 0:
        return JS_NewStringLen(ctx, "", 0)
    Points at = Points(p)
    []u32 points = at[0..<n]
    i64 units = 0
    for i in 0..<n:
        units += 1
        if points[i] > 0xFFFF && points[i] <= 0x10FFFF:
            units += 1
    rawptr block = nil
    try block = scratch(ctx, u64(units) * 2) else:
        return raised()
    Units out = Units(block)
    []u16 run = out[0..<units]
    i64 k = 0
    for i in 0..<n:
        u32 c = points[i]
        if c > 0x10FFFF:
            c = 0xFFFD
        if c > 0xFFFF:
            u32 d = c - 0x10000
            run[k] = u16(0xD800 | (d >> 10))
            run[k + 1] = u16(0xDC00 | (d & 0x3FF))
            k += 2
        else:
            run[k] = u16(c)
            k += 1
    Engine e = Engine(JS_GetContextOpaque(ctx))
    e^.bytes_out += units * 2
    JSValue v = JS_NewStringUTF16(ctx, ConstUnits(block), #c.size_t(units))
    unscratch(ctx, block, u64(units) * 2)
    return v

// `mix` over a `string32`'s length and then each of its code points.
u64 mix_points(u64 h, rawptr p, i64 n):
    u64 out = mix(h, u64(n))
    if n == 0:
        return out
    Points at = Points(p)
    []u32 run = at[0..<n]
    for i in 0..<n:
        out = mix(out, u64(run[i]))
    return out

// `v` as a `cstring`: the engine's UTF-8 copy, which ends at a NUL, borrowed
// until `drop_cstring`. A string holding a NUL character would end early, and
// throws instead.
!rawptr read_cstring(^JSContext ctx, JSValue v, cstring function, cstring what, ^i64 path, i32 depth):
    try string8 s = read_string(ctx, v, function, what, path, depth)
    for i in 0..<#len(s):
        if s[i] == char8(0):
            drop_string(ctx, s)
            [128]char8 text
            where_into(&text, path, depth)
            _ = JS_ThrowTypeError(ctx, "`%s`'s %s%s is a `cstring`, which ends at its first NUL, and this string holds one", function, what, cstring(rawptr(&text)))
            fail TYPE
    return rawptr(s)

// Gives back a `cstring` `read_cstring` borrowed, by its address.
void drop_cstring(^JSContext ctx, rawptr c):
    JS_FreeCString(ctx, cstring(c))

// A `cstring`'s bytes up to its NUL, by its address, read as UTF-8; nil is
// the empty string.
JSValue give_cstring(^JSContext ctx, rawptr c):
    i64 n = cstring_length(c)
    Engine e = Engine(JS_GetContextOpaque(ctx))
    e^.bytes_out += n
    if n == 0:
        return JS_NewStringLen(ctx, "", 0)
    return JS_NewStringLen(ctx, cstring(c), #c.size_t(n))

// `mix` over a `cstring`'s length and then each of its bytes, by its address.
u64 mix_cstring(u64 h, rawptr c):
    i64 n = cstring_length(c)
    u64 out = mix(h, u64(n))
    if n == 0:
        return out
    Chars at = Chars(c)
    []char8 run = at[0..<n]
    for i in 0..<n:
        out = mix(out, u64(run[i]))
    return out

// How many bytes a `cstring` holds before its NUL; nil holds none.
private i64 cstring_length(rawptr c):
    if c == nil:
        return 0
    Chars at = Chars(c)
    i64 n = 0
    for at[n..<n + 1][0] != char8(0):
        n += 1
    return n

// The code points of the UTF-8 `s`, written to `into` when it is not nil, and
// how many: a lead byte and the continuation bytes after it are one, and a
// byte no lead stands before is one by itself.
private i64 decode_utf8(string8 s, rawptr into):
    i64 i = 0
    i64 k = 0
    i64 n = #len(s)
    Points out = Points(into)
    for i < n:
        u32 b = u32(u8(s[i]))
        u32 c = b
        i64 more = 0
        if b >= 0xF0:
            c = b & 0x07
            more = 3
        else if b >= 0xE0:
            c = b & 0x0F
            more = 2
        else if b >= 0xC0:
            c = b & 0x1F
            more = 1
        i += 1
        for more > 0 && i < n && (u32(u8(s[i])) & 0xC0) == 0x80:
            c = (c << 6) | (u32(u8(s[i])) & 0x3F)
            i += 1
            more -= 1
        if into != nil:
            []u32 run = out[k..<k + 1]
            run[0] = c
        k += 1
    return k

// ── Maps ────────────────────────────────────────────────────────────────────
//
// A Dado map crosses as a script's map, a JavaScript `Map`, copied entry by
// entry: a script's map is read as the array of its `[key, value]` pairs, in
// its order, and a new one is set entry by entry. The generated glue reads
// and writes each key and value as it would alone.

// The entries of the map `v`, as a new array of `[key, value]` pairs in the
// map's order (`Array.from(v)`); anything but a map throws.
!JSValue map_entries(^JSContext ctx, JSValue v, cstring function, cstring what, ^i64 path, i32 depth):
    if i32(v.tag) != JS_TAG_OBJECT || !JS_IsMap(v):
        mistyped_at(ctx, v, function, what, path, depth, "a map")
        fail TYPE
    JSValue r = pairs_of(ctx, v)
    if is_exception(r):
        fail THREW
    return r

// A new, empty map.
JSValue new_map(^JSContext ctx):
    return fresh_map(ctx)

// On the web a VM's globals hold neither `Map` nor `Array`: the page makes
// the map and the pairs.
when #OS == #WEB:
    private foreign "dado/web.h":
        void dado_rt__web_dados_map_new(^JSContext ctx, ^JSValue out)
        void dado_rt__web_dados_map_entries(^JSContext ctx, ^JSValue v, ^JSValue out)

    private JSValue fresh_map(^JSContext ctx):
        JSValue m
        dado_rt__web_dados_map_new(ctx, &m)
        return m

    private JSValue pairs_of(^JSContext ctx, JSValue v):
        JSValue held = v
        JSValue r
        dado_rt__web_dados_map_entries(ctx, &held, &r)
        return r

else:
    private JSValue fresh_map(^JSContext ctx):
        JSValue global = JS_GetGlobalObject(ctx)
        JSValue k = JS_GetPropertyStr(ctx, global, "Map")
        JSValue m = JS_CallConstructor(ctx, k, 0, nil)
        JS_FreeValue(ctx, k)
        JS_FreeValue(ctx, global)
        return m

    private JSValue pairs_of(^JSContext ctx, JSValue v):
        JSValue global = JS_GetGlobalObject(ctx)
        JSValue array = JS_GetPropertyStr(ctx, global, "Array")
        JSValue from = JS_GetPropertyStr(ctx, array, "from")
        JSValue arg = v
        JSValue r = JS_Call(ctx, from, array, 1, &arg)
        JS_FreeValue(ctx, from)
        JS_FreeValue(ctx, array)
        JS_FreeValue(ctx, global)
        return r

// `m.set(k, v)`, taking `k` and `v`. Any of the three already the exception
// marker — a writer that failed — fails, letting go of the others and `m`.
!void map_set(^JSContext ctx, JSValue m, JSValue k, JSValue v):
    if is_exception(m) || is_exception(k) || is_exception(v):
        if !is_exception(m):
            JS_FreeValue(ctx, m)
        if !is_exception(k):
            JS_FreeValue(ctx, k)
        if !is_exception(v):
            JS_FreeValue(ctx, v)
        fail THREW
    JSValue set = JS_GetPropertyStr(ctx, m, "set")
    [2]JSValue args = [k, v]
    JSValue r = JS_Call(ctx, set, m, 2, &args[0])
    JS_FreeValue(ctx, set)
    JS_FreeValue(ctx, k)
    JS_FreeValue(ctx, v)
    if is_exception(r):
        JS_FreeValue(ctx, m)
        fail THREW
    JS_FreeValue(ctx, r)

private type Units: ^u16

private type ConstUnits: ^const u16

private type Points: ^u32
