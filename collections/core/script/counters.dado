// core:script — a VM's crossing counters, per frame.
//
// `script.counters(vm)` answers what crossed the seam of `vm` since its frame
// began — the host's last `#script_pump(vm)`, which is the frame boundary, or
// the VM's making: `calls`, a script's calls of Dado functions; `runs`, Dado's
// calls into the script (a member call, `#script_run`, `#script_new`);
// `bytes_in` and `bytes_out`, the UTF-8 bytes of the strings that crossed
// into Dado and out of it, **in both directions of call**: a script's string
// arguments to a Dado function and a run's string answer are bytes in; a Dado
// function's string answer, a run's string arguments and the text a `Sink`
// hands a script's function are bytes out — a string inside an array or a
// tuple as one on its own. A host reads them before it pumps, and reports
// them beside its own frame counters.
//
// **Natively every crossing is a thunk**, and the engine counts: a thunk's
// entry, a run's entry, the strings read and written by the glue and by a
// run's arguments and answer. **On the web** a
// crossing written inline at its site is counted there, in the page's
// JavaScript, as a plain property increment, and nothing is added to the wasm
// module for it: `calls` and the inline sites' bytes are the page's, read
// through the host (`dados.counters`) and begun again at the frame boundary
// (`dados.frame`); a thunk's string bytes, a run's and `runs` are still the
// engine's, which counts them as natively.
package script

// What crossed a VM's seam since its frame began.
type Counters: (i64 calls, i64 runs, i64 bytes_in, i64 bytes_out)

// `vm`'s counters since its frame began; all zero for a handle that holds no
// VM.
Counters counters(VM vm):
    Counters c = (0, 0, 0, 0)
    Slot at
    if !slot_read(rawptr(vm), &at):
        return c
    Engine e = at.engine
    c.calls = e^.thunks - e^.frame.calls
    c.runs = e^.entries - e^.frame.runs
    c.bytes_in = e^.bytes_in - e^.frame.bytes_in
    c.bytes_out = e^.bytes_out - e^.frame.bytes_out
    page_counters(e, &c)
    return c

// The frame boundary: every counter begins again.
private void frame_begin(Engine e):
    e^.frame.calls = e^.thunks
    e^.frame.runs = e^.entries
    e^.frame.bytes_in = e^.bytes_in
    e^.frame.bytes_out = e^.bytes_out
    page_frame(e)

when #OS == #WEB:
    private foreign "dado/web.h":
        void dado_rt__web_dados_counters(rawptr ctx, ^i64 out)
        void dado_rt__web_dados_frame(rawptr ctx)

    // The page's counts for the VM: every crossing a site counted (a thunk's
    // too, so the engine's count of thunks is not added), and the bytes the
    // inline sites encoded and decoded.
    private void page_counters(Engine e, ^Counters c):
        [3]i64 page
        dado_rt__web_dados_counters(rawptr(e^.ctx), &page[0])
        c^.calls = page[0]
        c^.bytes_in += page[1]
        c^.bytes_out += page[2]

    private void page_frame(Engine e):
        dado_rt__web_dados_frame(rawptr(e^.ctx))

else:
    private void page_counters(Engine e, ^Counters c):
        return

    private void page_frame(Engine e):
        return
