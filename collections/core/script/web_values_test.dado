@test
// The engine's values, with no module and no script: what the web runtime's
// engine — the compiler's API over the page's JavaScript engine, a value C
// holds a slot of the host's value table — keeps as QuickJS-ng keeps it
// natively. It runs on both, and on the web it is the shim's own test.
//
// * **A reference `JS_DupValue` took outlives the one `JS_FreeValue` let
//   go**: the string still reads back after its first reference is gone.
// * **Non-ASCII text crosses both ways exactly**: two-, three- and four-byte
//   UTF-8 into the engine and back byte for byte, and its UTF-16 code units
//   are JavaScript's — a character past the BMP is a surrogate pair.
// * **What the engine copies out goes back to its allocator**: once each C
//   string is freed and each value released, the engine holds what it held.
// * **On the web a released slot is reused**: the next value made takes the
//   slot the last reference let go of.
package script

import "core:mem/libc"

private const string8 SAMPLE = "héllo wörld ☃ 𝄞"

// The `i`th code unit at `at`.
private u16 unit(^const u16 at, i64 i):
    ^u16 p = ^u16(rawptr(#c.uintptr_t(rawptr(at)) + #c.uintptr_t(i) * 2))
    return p^

when #OS == #WEB:
    // On the web a string is a slot of the host's table, its index in the
    // payload: the slot a released value held is the next one made.
    private bool slot_reused(i32 was, JSValue now):
        return now.u.int32 == was

else:
    // Natively a value is the engine's own memory, which this does not ask
    // about.
    private bool slot_reused(i32 was, JSValue now):
        return true

i32 test():
    bool ok = true
    try Engine e = create(libc.allocator()) else code:
        _ = #expect(false, "create failed with ", code)
        return 1
    defer destroy(e)
    ^JSContext ctx = e^.ctx
    (i64 blocks, i64 bytes) = held(e)
    string8 sample = SAMPLE
    JSValue s = JS_NewStringLen(ctx, cstring(rawptr(sample)), #c.size_t(#len(sample)))
    JSValue d = JS_DupValue(ctx, s)
    JS_FreeValue(ctx, s)
    #c.size_t n = 0
    ^const #c.char back = JS_ToCStringLen2(ctx, &n, d, false)
    if back == nil:
        _ = #expect(false, "the string did not read back after one of its two references was let go")
        return 1
    Chars at = Chars(rawptr(back))
    string8 got = string8(at[0..<i64(n)])
    ok = #expect(got == SAMPLE, "the string read back as \"", got, "\"") && ok
    JS_FreeCString(ctx, cstring(rawptr(back)))
    ^const u16 units = JS_ToCStringLenUTF16(ctx, &n, d)
    if units == nil:
        _ = #expect(false, "the string's code units did not read back")
        return 1
    ok = #expect(i64(n) == 16, "the string is ", i64(n), " code units, not 16") && ok
    ok = #expect(unit(units, 1) == 0xE9, "its second unit is ", unit(units, 1)) && ok
    ok = #expect(unit(units, 12) == 0x2603, "its thirteenth unit is ", unit(units, 12)) && ok
    ok = #expect(unit(units, 14) == 0xD834 && unit(units, 15) == 0xDD1E, "U+1D11E is not the pair D834 DD1E") && ok
    JSValue again = JS_NewStringUTF16(ctx, units, n)
    JS_FreeCStringUTF16(ctx, units)
    ^const #c.char twice = JS_ToCStringLen2(ctx, &n, again, false)
    JS_FreeValue(ctx, again)
    if twice == nil:
        _ = #expect(false, "the string made of its code units did not read back")
        return 1
    Chars at2 = Chars(rawptr(twice))
    ok = #expect(string8(at2[0..<i64(n)]) == SAMPLE, "the string made of its code units is another") && ok
    JS_FreeCString(ctx, cstring(rawptr(twice)))
    i32 was = d.u.int32
    JS_FreeValue(ctx, d)
    JSValue next = JS_NewStringLen(ctx, "next", 4)
    ok = #expect(slot_reused(was, next), "the slot ", was, " was not reused: the next value took ", next.u.int32) && ok
    JS_FreeValue(ctx, next)
    (i64 blocks_after, i64 bytes_after) = held(e)
    ok = #expect(blocks_after == blocks && bytes_after == bytes, "the engine held ", blocks, " blocks of ", bytes, " bytes and holds ", blocks_after, " of ", bytes_after) && ok
    if ok:
        return 0
    return 1
