@test
// The reserved codes, the failure's text and the sink stack in isolation
// (`failure.dado`, `sinks.dado`), on the fork, with no emitter in front.
//
// * **The reserved codes** are the band from `INT32_MIN`, in their places, and
//   a failure's status is never 0.
// * **A throw that carries no code is `ERROR`**, and its text is what the
//   error sink was given, kept for `failure_text` beside it.
// * **A text too long for the buffer is cut at a character's boundary.**
// * **Every run pushes the engine's sinks and pops them as it leaves**, so a
//   run given its own leaves the engine's in place, nested or not, and the
//   sinks waiting for a verb are dropped when no run takes them.
package script

import "core:fmt"
import "core:mem/libc"

private const cstring THROWS_JS = """
    export function plain() { throw "nothing to say"; }
    export function zero() { const e = new Error("zero"); e.code = 0; throw e; }
    export function hello() { println("hello"); }
    """

private [256]char8 out_store
private [1024]char8 err_store
private [256]char8 run_store
private fmt.Cursor out_c
private fmt.Cursor err_c
private fmt.Cursor run_c

i32 test():
    bool ok = true
    out_c = fmt.over(out_store[:])
    err_c = fmt.over(err_store[:])
    run_c = fmt.over(run_store[:])

    // ── the band ────────────────────────────────────────────────────────────
    ok = #expect(ERROR == -2147483647 - 1, "ERROR is ", ERROR) && ok
    ok = #expect(STOPPED == ERROR + 1 && STALE == ERROR + 2 && TYPE == ERROR + 3, "the band's first four are out of place") && ok
    ok = #expect(NO_MEMORY == ERROR + 4 && BUSY == ERROR + 5 && LENT == ERROR + 6, "the band's next three are out of place") && ok
    for code in [ERROR, STOPPED, STALE, TYPE, NO_MEMORY, BUSY, LENT]:
        ok = #expect(exit_status(code) != 0, "a reserved code's status is 0: ", code) && ok
    ok = #expect(exit_status(ERROR) == UNTRIED, "ERROR's status is ", exit_status(ERROR)) && ok
    ok = #expect(exit_status(256) == UNTRIED && exit_status(259) == 3, "a status keeps the low eight bits, 70 for 0") && ok

    try Engine e = create(libc.allocator()) else code:
        _ = #expect(false, "create failed with ", code)
        return 1
    defer destroy(e)
    set_sinks(e, fmt.to_bytes(&out_c), fmt.to_bytes(&err_c))
    try add_module(e, "throws", THROWS_JS) else code:
        _ = #expect(false, "add_module failed with ", code)
        return 1
    try Handle m = load(e, "throws") else code:
        _ = #expect(false, "load failed with ", code)
        return 1

    // ── a throw with no code, and the text beside it ────────────────────────
    i32 got = 0
    try call(e, m, "plain") else code:
        got = script_code(e, code)
    ok = #expect(got == ERROR, "a thrown string failed with ", got, ", not ERROR") && ok
    ok = #expect(failure_text() == "nothing to say\n", "the text is \"", failure_text(), "\"") && ok
    ok = #expect(fmt.written(err_c) == failure_text(), "the error sink holds \"", fmt.written(err_c), "\"") && ok
    try call(e, m, "zero") else code:
        got = script_code(e, code)
    ok = #expect(got == ERROR, "an Error of code 0 failed with ", got, ", not ERROR") && ok
    string8 said = failure_text()
    ok = #expect(said[0..<11] == "Error: zero", "the text is \"", said, "\"") && ok
    ok = #expect(script_code(e, NO_SUCH) == STALE, "NO_SUCH is not STALE at a verb") && ok

    // ── a text too long is cut at a character ───────────────────────────────
    text_begin(fmt.discard())
    for i in 0..<2047:
        text_keep("é")
    text_keep("é")
    text_keep("x")
    string8 full = failure_text()
    ok = #expect(#len(full) == TEXT_MAX, "the full text is ", #len(full), " bytes") && ok
    text_begin(fmt.discard())
    text_keep("a")
    for i in 0..<2048:
        text_keep("é")
    string8 cut = failure_text()
    ok = #expect(#len(cut) == TEXT_MAX - 1, "a cut é was kept: ", #len(cut), " bytes") && ok
    ok = #expect(cut[0] == 'a', "the text lost its head, not its tail") && ok

    // ── the stack ───────────────────────────────────────────────────────────
    Sink engine_out = e^.out
    try enter(e) else code:
        _ = #expect(false, "enter failed with ", code)
        return 1
    pend_out(fmt.to_bytes(&run_c))
    take_sinks(e)
    try call(e, m, "hello") else code:
        _ = #expect(false, "hello failed with ", code)
    try enter(e) else code:
        _ = #expect(false, "a nested enter failed with ", code)
        return 1
    take_sinks(e)
    try call(e, m, "hello") else code:
        _ = #expect(false, "the nested hello failed with ", code)
    leave(e)
    try call(e, m, "hello") else code:
        _ = #expect(false, "hello after the nested run failed with ", code)
    leave(e)
    ok = #expect(e^.out.data == engine_out.data, "the engine's own sink is not back") && ok
    ok = #expect(fmt.written(run_c) == "hello\nhello\nhello\n", "the run's sink holds \"", fmt.written(run_c), "\"") && ok
    ok = #expect(fmt.written(out_c) == "", "the engine's sink holds \"", fmt.written(out_c), "\"") && ok
    pend_err(fmt.to_bytes(&run_c))
    drop_pending()
    ok = #expect(!g_err_given, "a waiting sink was not dropped") && ok
    if ok:
        return 0
    return 1
