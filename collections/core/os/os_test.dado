@test
// Three of this package's four sections are testable from a test
// file, and the fourth is not — which is worth saying at the top rather than
// leaving as an absence:
//
//   * **`arg`** reads `argv[i]` through `args.c`, because that is pointer
//     arithmetic and Dado does not have it. A test's entry is `i32 test()` with
//     **no parameters** (rule 3), so there is no real `argv` to hand it. It is
//     tested anyway, against an `argv` this file builds — an array of `rawptr`
//     into NUL-terminated byte arrays, which is exactly what C hands `main`.
//     That tests the shim and the `cstring` return; it does not test that a real
//     process's `argv` arrives intact, and nothing in a `@test` file can.
//   * **`quit_with`** ends the process, so it cannot be claimed by a function
//     that has to return a value. It lives in `os_exit_test.dado` beside this
//     file, under `@test <status>` — the same mechanism that makes a
//     deliberate `assert` observable, used for a deliberate exit.
//   * **`env`** carries a decision worth pinning: an unset variable is `nil`
//     and not the empty string. The fold that made those one answer went with
//     the implicit `cstring` crossing, so `has_env` asks C's own question again
//     — and what is claimed below is the unset case, because that is where the
//     answer used to be manufactured.
//   * **`random`** is only worth testing for the property the header claims for
//     it: *deterministic for a given seed*, which is what makes it usable in a
//     test and unsuitable for anything that matters.
//
// **What cannot be claimed here, and it is a real gap.** `arg` and `env` hand
// back a `cstring`, and the only questions Dado can ask one are *how long* and
// *is it nil* — there is no indexing, no `==` by contents, and no conversion
// into a `string` to get either. So the claims below are about lengths and
// about which slot was read, and the bytes themselves reach a reader only
// through the failure messages, which render a `cstring` by walking it.
package os

import "core:strings"

// A fake `argv`: an array of pointers to NUL-terminated bytes, which is what
// `char **` is and what `^rawptr` is the honest Dado spelling of. Package-level
// so the addresses are stable — a stack array's would not survive the
// helper that filled it.
private type Word: [8]char8
private Word word0
private Word word1
private Word word2

private type ArgvSlots: [3]rawptr
private ArgvSlots argv_slots

// Writing a short literal into a `[8]char8` by hand. There is no `strcpy` here
// and there does not need to be: three words of at most seven bytes is a table,
// and a table is clearer than a loop over a `string` would be.
private void put(^Word w, char8 a, char8 b, char8 c):
    w^[0] = a
    w^[1] = b
    w^[2] = c
    w^[3] = '\0'
    return

// The five-byte word, and the length is the point: `measure` is the only thing
// that can be asked about `arg`'s answer, so the three words are made three
// different lengths and the length is what says which slot was read.
private void put5(^Word w, char8 a, char8 b, char8 c, char8 d, char8 e):
    w^[0] = a
    w^[1] = b
    w^[2] = c
    w^[3] = d
    w^[4] = e
    w^[5] = '\0'
    return

i32 test():
    bool ok = true

    // ── has_arg ──────────────────────────────────────────────────────────────
    //
    // `index >= 0 && index < argc`, which is a bounds question with one
    // spelling — and the four values that matter are the two ends and the two
    // just outside them. Written as a function precisely so a caller does not
    // write `<=` on one of them.
    ok = #expect(has_arg(3, 0), "has_arg(3, 0) was false") && ok
    ok = #expect(has_arg(3, 2), "has_arg(3, 2) was false: argc-1 is in range") && ok
    ok = #expect(!has_arg(3, 3), "has_arg(3, 3) was true: argc is out of range") && ok
    ok = #expect(!has_arg(3, 0 - 1), "has_arg(3, -1) was true") && ok
    // The degenerate argc, which is what a program invoked with nothing at all
    // would see and the one value for which no index is in range.
    ok = #expect(!has_arg(0, 0), "has_arg(0, 0) was true") && ok
    ok = #expect(has_arg(1, 0), "has_arg(1, 0) was false: argv[0] is the program's own name") && ok

    // ── arg ──────────────────────────────────────────────────────────────────
    //
    // The inbound half of the boundary, and the direction that costs: C threw
    // the length away, so getting it back is a walk and `#len` of the borrow is
    // where it is spent (`measured`, below). What is claimed is that the shim indexes the array the
    // caller passed — the three words are three different lengths, so a shim
    // that read the wrong slot answers the wrong number — and that an argument
    // of length zero comes back as an empty `cstring` rather than as `nil`.
    put(&word0, 'a', 'b', 'c')
    put5(&word1, 'w', 'x', 'y', 'z', '!')
    word2[0] = '\0'

    argv_slots[0] = rawptr(&word0)
    argv_slots[1] = rawptr(&word1)
    argv_slots[2] = rawptr(&word2)

    ^rawptr argv = &argv_slots[0]
    ok = #expect(measured(arg(argv, 0)) == 3, "arg(argv, 0) was \"", arg(argv, 0), "\"") && ok
    ok = #expect(measured(arg(argv, 1)) == 5, "arg(argv, 1) was \"", arg(argv, 1), "\"") && ok
    // An argument that is the empty string: a real thing to be passed, and the
    // one place where "there is an argument and it is empty" has to stay apart
    // from "there is no argument" — the measured length is 0 for both and `nil` is not.
    ok = #expect(measured(arg(argv, 2)) == 0, "an empty argument came back as \"", arg(argv, 2), "\"") && ok
    ok = #expect(arg(argv, 2) != nil, "an empty argument came back as nil") && ok
    // The indices are the caller's, not the shim's: arg 1 is not arg 0. A
    // `cstring`'s `==` is the address and not the contents, which is exactly
    // the question here — three slots, three addresses.
    ok = #expect(arg(argv, 0) != arg(argv, 1), "two different arguments read the same") && ok

    // ── all ──────────────────────────────────────────────────────────────────
    //
    // The window `arg` cannot take, because `arg` is never told `argc`. Here it
    // is, so the slice is the real length and `#len` is the count the caller
    // passed — which is the whole difference: an index past it is a bounds
    // panic naming the index rather than a read off the end of the vector.
    []rawptr slots = all(argv, 3)
    ok = #expect(#len(slots) == 3, "all(argv, 3) windowed ", #len(slots), " slots") && ok
    ok = #expect(measured(cstring(slots[1])) == 5, "all()[1] was \"", cstring(slots[1]), "\"") && ok

    // Iteration, which is what a slice buys over an index-at-a-time reader.
    i64 total = 0
    for slot in slots:
        total = total + measured(cstring(slot))
    ok = #expect(total == 8, "the three arguments measured ", total, " bytes and should have measured 8") && ok

    // The degenerate vector: a program invoked with nothing at all. Zero is a
    // real `argc` and the window has to be empty rather than refused.
    []rawptr none = all(argv, 0)
    ok = #expect(#len(none) == 0, "all(argv, 0) windowed ", #len(none), " slots") && ok
    []rawptr negative = all(argv, 0 - 1)
    ok = #expect(#len(negative) == 0, "all(argv, -1) windowed ", #len(negative), " slots") && ok

    // `arg`'s own out-of-range arm, which the shim never had.
    ok = #expect(arg(argv, 0 - 1) == nil, "arg(argv, -1) was not nil") && ok

    // ── env ──────────────────────────────────────────────────────────────────
    //
    // **The unset case is the claim**, because it is where the answer used to be
    // manufactured: `getenv` returns NULL, the implicit crossing turned that
    // into the empty string, and there is no crossing any more. `nil` reaches
    // the program, which is what C said.
    cstring absent = env("DADO_CORE_OS_TEST_DEFINITELY_NOT_SET")
    ok = #expect(absent == nil, "an unset variable came back as \"", absent, "\"") && ok
    ok = #expect(!has_env("DADO_CORE_OS_TEST_DEFINITELY_NOT_SET"), "an unset variable reported itself set") && ok
    // And its measured length is 0 rather than a fault at the first byte, which is
    // the one thing a program holding a null answer is likely to do next.
    ok = #expect(measured(absent) == 0, "measuring an unset variable answered ", measured(absent)) && ok

    // A variable that is set. `PATH` is the one thing a process that got far
    // enough to run this test must have — the shell that started it found a
    // binary somewhere.
    ok = #expect(has_env("PATH"), "PATH was not set") && ok
    ok = #expect(measured(env("PATH")) > 0, "PATH was set and empty") && ok

    // The equivalence, stated rather than left implicit: `has_env` is exactly
    // `env(name) != nil`, so a variable set to nothing is **set** — which is
    // the answer the fold could not give and the reason it is worth pinning.
    ok = #expect(has_env("PATH") == (env("PATH") != nil), "has_env and env disagreed") && ok

    // ── magnitude ────────────────────────────────────────────────────────────
    //
    // C's `abs`. Zero is the fixed point and the boundary between the two arms;
    // `i32`'s most negative value is deliberately not claimed, because `abs` of
    // it is undefined in C and a test that pinned an answer would be pinning a
    // platform.
    ok = #expect(magnitude(5) == 5, "magnitude(5) was ", magnitude(5)) && ok
    ok = #expect(magnitude(0 - 5) == 5, "magnitude(-5) was ", magnitude(0 - 5)) && ok
    ok = #expect(magnitude(0) == 0, "magnitude(0) was ", magnitude(0)) && ok
    ok = #expect(magnitude(1) == 1 && magnitude(0 - 1) == 1, "magnitude was wrong at 1") && ok

    // ── random ───────────────────────────────────────────────────────────────
    //
    // **Deterministic for a given seed**, which is the only property this is
    // good for and the only one claimed. Three draws rather than one, because a
    // generator that ignored the seed and returned a constant would pass a
    // single-draw comparison.
    seed(42)
    i32 first_a = random()
    i32 first_b = random()
    i32 first_c = random()

    seed(42)
    ok = #expect(random() == first_a, "the first draw after reseeding differed") && ok
    ok = #expect(random() == first_b, "the second draw after reseeding differed") && ok
    ok = #expect(random() == first_c, "the third draw after reseeding differed") && ok

    // A different seed gives a different sequence — not guaranteed by anything C
    // says for one draw, so it is claimed across three: a generator that ignored
    // its seed entirely would have to match all three by accident.
    seed(1)
    i32 other_a = random()
    i32 other_b = random()
    i32 other_c = random()
    ok = #expect(!(other_a == first_a && other_b == first_b && other_c == first_c), "two different seeds gave the same three draws") && ok

    // `RAND_MAX` is C's ceiling and every draw is under it — the invariant the
    // modulo below is not uniform against.
    ok = #expect(random_max() > 0, "RAND_MAX was ", random_max()) && ok
    ok = #expect(first_a >= 0 && first_a <= random_max(), "a draw was outside 0..RAND_MAX: ", first_a) && ok

    // `random_below`'s guard: a bound of zero or less answers 0 rather than
    // dividing by zero, which is the arm no ordinary call reaches.
    ok = #expect(random_below(0) == 0, "random_below(0) was ", random_below(0)) && ok
    ok = #expect(random_below(0 - 7) == 0, "random_below(-7) was ", random_below(0 - 7)) && ok
    // A bound of one has exactly one answer, which is the smallest non-degenerate
    // case and the one where `% 1` must be 0 every time.
    for i in 0..<20:
        ok = #expect(random_below(1) == 0, "random_below(1) answered non-zero on draw ", i) && ok

    // And the range, over enough draws that a bound applied to the wrong side of
    // the modulo would show.
    seed(7)
    for i in 0..<200:
        i32 r = random_below(10)
        ok = #expect(r >= 0 && r < 10, "random_below(10) answered ", r, " on draw ", i) && ok

    // ── the exit statuses ────────────────────────────────────────────────────
    //
    // `EXIT_SUCCESS` is 0 by C99's own words. `EXIT_FAILURE` is only required to
    // be a value that reports failure, so what is claimed is that it is **not**
    // success — a test that pinned it to 1 would be pinning a platform, which is
    // the same reason `strings.compare` normalises rather than trusting
    // `strcmp`'s magnitude.
    ok = #expect(success() == 0, "EXIT_SUCCESS was ", success()) && ok
    ok = #expect(failure() != success(), "EXIT_FAILURE and EXIT_SUCCESS were the same value: ", failure()) && ok

    // An invariant rather than an expectation: `random_below` must never answer
    // its own bound, because every caller uses it to index something of that
    // length. If it could, the *package* would be handing out an out-of-range
    // index and there would be nothing to carry on for.
    seed(99)
    for i in 0..<500:
        i32 r = random_below(4)
        #assert(r >= 0 && r < 4, "random_below(4) answered ", r)

    if ok:
        return 0
    return 1

// How many bytes C will read at `c`: `#len` of the borrow, which is what
// `strings.measure` answered before it was deleted in favour of `#len`.
// `#len` takes a place, so the borrow is bound first.
i64 measured(cstring c):
    string8 s = strings.borrow_from_cstring(c)
    return #len(s)
