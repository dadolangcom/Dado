@test
// The arithmetic half of `core:os`: the seeded generator, the exit statuses
// and `fail_with`. `quit_with` ends the process, so it lives in
// `os_exit_test.dado` under `@test <status>`; the system's half is
// `system_test`, `host_test` and `executable_test`.
//
// **The generator is Dado on every system**, so its sequence is pinned here:
// the first draws after `seed(1)` are the C standard's sample `rand`
// recurrence, and the same numbers on Linux, macOS, Windows and the web.
package os

i32 test():
    bool ok = true

    // ── the generator ────────────────────────────────────────────────────────

    // **Deterministic for a given seed**, and the same sequence everywhere.
    seed(42)
    i32 first_a = random()
    i32 first_b = random()
    i32 first_c = random()
    seed(42)
    ok = #expect(random() == first_a, "the first draw after reseeding differed") && ok
    ok = #expect(random() == first_b, "the second draw after reseeding differed") && ok
    ok = #expect(random() == first_c, "the third draw after reseeding differed") && ok

    // The recurrence's own numbers: state 1103515245 * 1 + 12345 is
    // 1103527590, and half of it, 551763795, is the first draw.
    seed(1)
    ok = #expect(random() == 551763795, "the first draw after seed(1) was not the recurrence's") && ok
    i32 other_b = random()
    i32 other_c = random()
    ok = #expect(!(551763795 == first_a && other_b == first_b && other_c == first_c), "two different seeds gave the same three draws") && ok

    ok = #expect(random_max() == 2147483647, "random_max was ", random_max()) && ok
    ok = #expect(first_a >= 0 && first_a <= random_max(), "a draw was outside 0..random_max: ", first_a) && ok

    // A negative seed wraps, and is a seed like any other.
    seed(0 - 1)
    i32 neg = random()
    seed(0 - 1)
    ok = #expect(random() == neg, "a negative seed was not deterministic") && ok

    // `random_below`'s guard: a bound of zero or less answers 0 rather than
    // dividing by it.
    ok = #expect(random_below(0) == 0, "random_below(0) was ", random_below(0)) && ok
    ok = #expect(random_below(0 - 7) == 0, "random_below(-7) was ", random_below(0 - 7)) && ok
    for i in 0..<20:
        ok = #expect(random_below(1) == 0, "random_below(1) answered non-zero on draw ", i) && ok
    seed(7)
    for i in 0..<200:
        i32 r = random_below(10)
        ok = #expect(r >= 0 && r < 10, "random_below(10) answered ", r, " on draw ", i) && ok

    // ── the exit statuses ────────────────────────────────────────────────────
    ok = #expect(success() == 0, "EXIT_SUCCESS was ", success()) && ok
    ok = #expect(failure() == 1, "EXIT_FAILURE was ", failure()) && ok

    // ── failing with a held code ─────────────────────────────────────────────
    //
    // Every member comes back as itself, and a value that is no member as
    // `UNKNOWN`.
    for code in 1..=99:
        Error held = Error(code)
        try fail_with(held) else why:
            if message(held) == "not an os error code":
                ok = #expect(why == Error.UNKNOWN, "fail_with(", code, ") is no member and failed ", i32(why)) && ok
            else:
                ok = #expect(why == held, "fail_with(", code, ") failed with ", i32(why)) && ok
            continue
        ok = #expect(false, "fail_with(", code, ") did not fail") && ok

    // An invariant rather than an expectation: `random_below` must never answer
    // its own bound, because every caller uses it to index something of that
    // length.
    seed(99)
    for i in 0..<500:
        i32 r = random_below(4)
        #assert(r >= 0 && r < 4, "random_below(4) answered ", r)

    if ok:
        return 0
    return 1
