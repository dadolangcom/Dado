// std/os — the process, and the arguments it was started with.
//
//     i32 main(i32 argc, ^rawptr argv):
//         for i in 0..<argc:
//             println(i, ": ", os.arg(argv, i))
//
// The entry point's parameter list is fixed, because C's is: `main`
// takes nothing, or `(i32 argc, ^rawptr argv)`. `^rawptr` is the honest Dado
// spelling of `char **` — a pointer to pointers, to bytes whose end is a `\0`
// rather than a type.
//
// Reading `argv[i]` is pointer arithmetic, which Dado does not have. So it
// happens in `args.c` beside this file, which the toolchain compiles and links
// because it is in the package directory. (That was true once; the comment
// on `arg` below says what replaced it.)
//
// **The package, in three files.** This one holds the `cstring` surface the
// tree has used since before `string8`: `arg`, `all`, `env`, `has_env`, the
// seeded generator and `quit_with`. `system.dado` holds the `string8` surface
// written per system — `args`, `get_env`/`set_env`/`unset_env`, `pid`,
// `home_dir`, `temp_dir`, `is_terminal` — and `errors.dado` the error code space
// every failable function in `os` and `os/fs` fails with, and `message`.
//
// Tier: hosted — Linux, macOS and Windows, each with its own arm where the
// systems differ. Thread-safety: what changes the environment belongs before
// threads start (`system.dado` says why); everything else is safe from any
// thread.
package os

private foreign "stdlib.h":
    i32 abs(i32 n)
    i32 rand()
    void srand(u32 seed)
    void exit(i32 status)
    cstring getenv(cstring name)
    const i32 RAND_MAX
    const i32 EXIT_SUCCESS
    const i32 EXIT_FAILURE

// ── arguments ─────────────────────────────────────────────────────────────

// The argument at `index`, exactly as C handed it over.
//
// **Returns a `cstring` and not a `string`**, which is the boundary at a
// signature. `argv[i]` is a `const char *` whose length C threw away; there is
// no conversion into a `string` in this direction, because finding the length
// again is a walk and writing the bytes somewhere they can own a `\0` is a
// copy. So the type says what arrived and the caller decides what to spend:
// `println(arg(argv, i))` prints it, `strings.measure` counts it, and neither
// pretends the count was free.
//
// The bytes belong to the process rather than to this call, so the result is
// good for as long as the program runs.
// **This used to be three lines of C beside this file, and is not any more.**
// `args.c` existed because reading `argv[i]` is pointer arithmetic, which Dado
// does not have — and the sentence stopped being true when a window could be
// taken over a bare pointer. `argv[0..<n]` is a `[]rawptr` of the length the
// caller states, and indexing a slice is what the language does. The shim, its
// header, and the `foreign` block that reached them are all gone.
//
// The window is `index + 1` long because that is the least this call can
// honestly claim: `argv` carries no length, so nothing here knows `argc` and
// nothing here can check against it. That is the same amount of checking the
// shim did — which is none — and it is why `all` below exists.
cstring arg(^rawptr argv, i32 index):
    if index < 0:
        return nil
    i64 upto = i64(index) + 1
    []rawptr slots = argv[0..<upto]
    return cstring(slots[index])

// The whole argument vector, as a slice, windowed once.
//
// **This is the one to reach for**, and it is what the shim could never offer:
// `argc` is in the value, so `slots[i]` is bounds-checked against the real
// length and a walk off the end is a runtime panic naming the index rather than
// whatever byte follows the vector. Window it once at the entry point and pass
// the slice down.
//
//     []rawptr slots = os.all(argv, argc)
//     for slot in slots:
//         println(cstring(slot))
//
// The elements are `rawptr` and not `cstring` because a slice's element type is
// not converted slotwise — `cstring(slot)` is the written boundary, and it is
// the same assertion `arg` makes internally.
[]rawptr all(^rawptr argv, i32 argc):
    if argc <= 0:
        return argv[0..<0]
    return argv[0..<i64(argc)]

// Whether `argv` carries an argument at `index` — i.e. whether `index` is
// below `argc`. Written as a function so the bounds question has one spelling.
bool has_arg(i32 argc, i32 index):
    return index >= 0 && index < argc

// ── the environment ───────────────────────────────────────────────────────

// The value of an environment variable, or `nil` when it is unset.
//
// **Both halves are `cstring` now.** The name is one because it exists only to
// reach `getenv`, and a caller with bytes of its own says how it got a `\0`
// (`strings.clone_to_cstring`); a literal — which is what almost every call
// passes — is already a `cstring` and costs nothing. The value is one because
// C hands back a pointer and nothing else, and there is no conversion into a
// `string` to hide the walk inside.
//
// `nil` used to be folded into the empty string on the way out, and that fold
// is gone with the implicit crossing that performed it. What it cost is below.
cstring env(cstring name):
    return getenv(name)

// Whether a variable is set. `getenv(name) != nil`, which is C's own question
// and is spellable again: a `cstring` compares against `nil` because that is
// what C returns when it has nothing to say.
//
// **"Unset" and "set to the empty string" are two answers now**, where the
// fold made them one — `has_env` is true for a variable set to nothing and
// `strings.measure(env(name))` is then 0. That is the sharper answer, but it
// is sharper than C: POSIX lets an implementation return either a null pointer
// or an empty string for a variable set to nothing, so a program that leans on
// the distinction is leaning on its platform rather than on this package. On
// Windows the C runtime's copy of the table cannot hold an empty value at all,
// so there `has_env` is false for one; `get_env` is the reader that tells the
// two apart on every system.
bool has_env(cstring name):
    return env(name) != nil

// ── numbers ───────────────────────────────────────────────────────────────

i32 magnitude(i32 n):
    return abs(n)

// C's generator, seeded explicitly. Deterministic for a given seed, which is
// what makes it usable in a test and unsuitable for anything that matters.
//
// `srand` takes an `unsigned int`, and the conversion is written: a negative
// seed wraps, which is what C did to it silently while the restatement said
// `i32` (the `_Generic` assertion over each foreign signature is what
// noticed).
void seed(i32 value):
    srand(u32(value))

i32 random():
    return rand()

// A value in `0..<bound`, by the modulo everyone writes and nobody should
// trust for uniformity when `bound` does not divide `RAND_MAX + 1`.
i32 random_below(i32 bound):
    if bound <= 0:
        return 0
    return rand() % bound

i32 random_max():
    return RAND_MAX

// ── ending ────────────────────────────────────────────────────────────────

void quit_with(i32 status):
    exit(status)

i32 success():
    return EXIT_SUCCESS

i32 failure():
    return EXIT_FAILURE
