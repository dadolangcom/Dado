@test
package proc

import "core:io"

// On Windows this file is empty: it runs `/bin/sh`, `cat` and signals, which
// Windows does not have, and `windows_test.dado` holds the same claims there.
when #OS == #WINDOWS:
    i32 test():
        return 0
else:
    // A child that writes, pauses, and writes again. The pause is the point: a
    // blocking read would return everything at the end, and this has to come back
    // with the first half while the second is still being written.
    i32 test():
        bool ok = true
        ^io.FILE p = read(cstring("printf 'alpha\nbeta\n'; sleep 0.25; printf 'gamma\n'"))
        ok = #expect(p != nil, "pipe did not open") && ok
        if p == nil: return 1

        [512]char8 chunk
        i32 rounds = 0
        i32 total = 0
        i32 waits = 0
        i32 early = 0
        for:
            i32 n = drain(p, chunk[:], 20)
            rounds = rounds + 1
            if n == DRAINED: break
            if n == BROKE: break
            if n == WAITED:
                waits = waits + 1
                continue
            if total == 0: early = n
            total = total + n
            if rounds > 500: break

        (bool exited, i32 status) = close(p)
        ok = #expect(total == 17, "expected 17 bytes, got ", total) && ok
        // The first read must have come back before the child was done, which is
        // the whole claim: 17 bytes at once would mean it waited.
        ok = #expect(early > 0 && early < 17, "first read was ", early, " bytes; a blocking read would be 17") && ok
        ok = #expect(waits > 0, "never once timed out, so it never yielded") && ok
        ok = #expect(exited && status == 0, "exited=", exited, " status=", status) && ok
        if ok: return 0
        return 1
