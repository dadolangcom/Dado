@test
package proc

import "core:io"
import "core:os"

// `ok`, under a name a local `ok` does not hide.
private bool proc_ok(Ended e):
    return ok(e)

// On Windows this file is empty: it runs `/bin/sh`, `cat` and signals, which
// Windows does not have, and `windows_test.dado` holds the same claims there.
when #OS == #WINDOWS:
    i32 test():
        return 0
else:
    // A child that writes, pauses, and writes again. The pause is the point: a
    // blocking read would return everything at the end, and this has to come back
    // with the first half while the second is still being written.
    i32 test():
        bool ok = true
        try ^io.FILE p = read("printf 'alpha\nbeta\n'; sleep 0.25; printf 'gamma\n'") else why:
            _ = #expect(false, "pipe did not open: ", os.message(why))
            return 1

        [512]char8 chunk
        i32 rounds = 0
        i64 total = 0
        i32 waits = 0
        i64 early = 0
        bool broke = false
        for:
            rounds = rounds + 1
            if rounds > 500: break
            try i64 n = drain(p, chunk[:], 20) else why2:
                if why2 == Pipe.BROKE:
                    broke = true
                    break
                waits = waits + 1
                continue
            if n == 0: break
            if total == 0: early = n
            total = total + n

        try Ended e = close(p) else why3:
            _ = #expect(false, "close failed: ", os.message(why3))
            return 1
        ok = #expect(!broke, "the drain broke") && ok
        ok = #expect(total == 17, "expected 17 bytes, got ", total) && ok
        // The first read must have come back before the child was done, which is
        // the whole claim: 17 bytes at once would mean it waited.
        ok = #expect(early > 0 && early < 17, "first read was ", early, " bytes; a blocking read would be 17") && ok
        ok = #expect(waits > 0, "never once timed out, so it never yielded") && ok
        ok = #expect(proc_ok(e), "the child did not exit 0") && ok

        // No stream is `BROKE`, and so is an empty buffer.
        ^io.FILE none = nil
        try _ = drain(none, chunk[:], 0) else why4:
            ok = #expect(why4 == Pipe.BROKE, "drain of no stream failed ", message(why4)) && ok
        if ok: return 0
        return 1
