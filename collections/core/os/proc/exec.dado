// core:os/proc — running another program **without a shell**.
//
//     import "core:os/proc"
//     import "core:io"
//
//     [3]string8 argv = ["git", "rev-parse", "--short"]
//     try proc.Child c = proc.spawn(argv[:]) else why:
//         ...
//     try ref []char8 line = io.read_line(c.stream) else:
//         ...
//     try proc.Ended e = proc.wait(c) else why:
//         ...
//
// **This is the half of the package that does not go through `/bin/sh`.**
// `read`, `write` and `run` hand a *line* to a shell; everything here hands an
// *array* to `execvp`, so a space, a quote and a `;` are bytes in an argument
// and nothing else.
//
// **`execvp` and not `execv`**, so a bare program name is looked up on `PATH`
// the way a shell would — which is the one convenience of the shell form worth
// keeping. The child inherits the caller's environment, because `execvp` reads
// `environ` itself and nothing here has to name it.
//
// **The argv is `[]string8`**, terminated for C here: one block on the
// ambient allocator holds every argument and its `\0`, made before the fork
// (the child may not allocate between `fork` and `exec`) and freed before the
// call returns.
package proc

import "core:io"
import "core:os"

// **The arguments this package will pass, at most.** Over the cap is a
// *refusal* (`INVALID`) and never a truncation: an argv one element short is a
// different program being run, and that is the kind of difference nobody
// notices.
const i32 ARG_CAP = 255

// The array `exec_argv` builds: the cap, plus C's terminator. Bound to its own
// `const` because an array length is a compile-time integer written as one
// spelling and `ARG_CAP + 1` is arithmetic (ERR0502).
private const i32 ARGV_SLOTS = 256

// A running program and the pipe its standard output arrives on. `pid` is kept
// beside the stream because closing the pipe and reaping the child are two
// operations here, and `wait` does both.
type Child:
    ^io.FILE stream,
    i32      pid,

// Whether an argv is one this package will run: at least the program, no more
// than the cap, and **no `\0` in any argument** — C would stop there, so the
// child would silently run a shorter argument, which is the truncation the cap
// refuses arriving by a different door.
private bool runnable([]string8 argv):
    if #len(argv) < 1 || #len(argv) > ARG_CAP: return false
    for a in argv:
        for c in a:
            if c == '\0': return false
    return true

// Every argument of `argv` with a `\0` after it, end to end, in one block for
// C; `nil` when it could not be allocated. `c_argv` points into it.
private ref []char8 argv_block([]string8 argv):
    i64 total = 0
    for a in argv:
        total += #len(a) + 1
    ref []char8 block = #make([]char8, total)
    if block == nil: return block
    i64 at = 0
    for a in argv:
        for c in a:
            block[at] = c
            at += 1
        block[at] = '\0'
        at += 1
    return block

// ── Windows ─────────────────────────────────────────────────────────────────
//
// `windows.dado` holds the mechanics: the argv quoted into one command line by
// the rule the C runtime reverses, the child started by `CreateProcessW` with
// only its three standard handles inherited, and waited on by its handle.
// `exec` and `spawn` hand the child the caller's own standard input and error,
// as the POSIX arm's `fork` does.
//
// **A program that is not there is `Exited(127)` from `exec`**, as it is on
// POSIX, so a caller reads one answer on both; `spawn` and `duplex`, which
// `CreateProcessW` tells before anything runs, fail `NOT_FOUND`.
when #OS == #WINDOWS:
    // Run `argv` to completion with the caller's own streams. Fails `INVALID`
    // for an argv this package will not run.
    os.Error!Ended exec([]string8 argv):
        if !runnable(argv): fail os.Error.INVALID
        (i32 pid, i32 why) = launch_argv(argv, std_handle(STD_INPUT_HANDLE), std_handle(STD_OUTPUT_HANDLE), std_handle(STD_ERROR_HANDLE))
        if why == i32(ERROR_FILE_NOT_FOUND) || why == i32(ERROR_PATH_NOT_FOUND):
            Exited missing = Exited(127)
            return Ended(missing)
        if pid < 0: try os.fail_with(os.from_system(i64(why)))
        (_, bool exited, i32 status) = reap_pid(pid, 0 - 1)
        try Ended e = ended_or_fail(exited, status)
        return e

    // Start `argv` and read its standard output.
    os.Error!Child spawn([]string8 argv):
        if !runnable(argv): fail os.Error.INVALID
        (rawptr read_end, rawptr write_end, i32 why) = anonymous_pipe()
        if why != 0: try os.fail_with(os.from_system(i64(why)))
        (i32 pid, i32 failed) = launch_argv(argv, std_handle(STD_INPUT_HANDLE), write_end, std_handle(STD_ERROR_HANDLE))
        close_handle(write_end)
        if failed != 0:
            close_handle(read_end)
            try os.fail_with(os.from_system(i64(failed)))
        ^io.FILE f = stream_over(read_end, true)
        if f == nil:
            _ = end_tree(pid)
            _ = reap_pid(pid, 0 - 1)
            fail os.Error.TOO_MANY_OPEN
        return (f, pid)

    // Close the pipe and wait for the program.
    os.Error!Ended wait(Child c):
        if c.stream == nil: fail os.Error.INVALID
        _ = io.close(c.stream)
        (_, bool exited, i32 status) = reap_pid(c.pid, 0 - 1)
        try Ended e = ended_or_fail(exited, status)
        return e

// ── POSIX: Linux, macOS and the BSDs ────────────────────────────────────────
else:
    // **`argv` is restated as `^const ^#c.char`, which is C's `char *const *`
    // exactly**, and the `_Generic` assertion over each foreign signature holds
    // the declaration to it. The argv is built as `[N]cstring` — `const char *`
    // elements — and handing their address to `char *const *` is the
    // conversion C refuses, so the call writes it through `Argv(rawptr(…))`,
    // once, in `exec_argv` below (and in `duplex.dado`'s `posix_spawnp`).
    private type Argv: ^const ^#c.char

    // Both feature macros are written unconditionally: each is inert on the
    // platform it is not for.
    private foreign sys "unistd.h" define "_POSIX_C_SOURCE=200809L" define "_DARWIN_C_SOURCE=1":
        i32 execvp(cstring file, ^const ^#c.char argv)
        i32 fork()
        i32 pipe(^i32 fds)
        i32 dup2(i32 old, i32 new)
        i32 close(i32 fd)
        void _exit(i32 code)

    private foreign wait_for "sys/wait.h":
        i32 waitpid(i32 pid, ^i32 status, i32 options)

    private foreign "stdio.h" define "_POSIX_C_SOURCE=200809L" define "_DARWIN_C_SOURCE=1":
        ^io.FILE fdopen(i32 fd, cstring mode)

    // `block`'s arguments, `count` of them, as a null-terminated array of
    // pointers into it.
    private type CArgv: [ARGV_SLOTS]cstring
    private CArgv c_argv_of(^ref []char8 block, i64 count):
        CArgv out
        i64 at = 0
        for i in 0..<count:
            out[i] = cstring(rawptr(&block^[at]))
            for block^[at] != '\0':
                at += 1
            at += 1
        out[count] = nil
        return out

    // ── the whole thing in one call ───────────────────────────────────────────

    // Run `argv` to completion with the caller's own streams, so its output
    // goes straight to the terminal and nothing is captured. The `run` twin.
    // A program that is not there exits 127, as a shell reports it. Fails
    // `INVALID` for an argv this package will not run, and with the system's
    // reason when the fork failed.
    os.Error!Ended exec([]string8 argv):
        if !runnable(argv): fail os.Error.INVALID
        ref []char8 block = argv_block(argv)
        defer #delete(block)
        if block == nil: fail os.Error.NO_MEMORY
        CArgv c_argv = c_argv_of(&block, #len(argv))
        i32 pid = sys.fork()
        if pid < 0: try os.fail_last()
        if pid == 0: exec_argv(&c_argv)
        (bool exited, i32 status) = reap(pid)
        try Ended e = ended_or_fail(exited, status)
        return e

    // ── opening ───────────────────────────────────────────────────────────────

    // Start `argv` and read its standard output. The `read` twin. Its standard
    // error is not redirected and goes wherever the caller's does.
    os.Error!Child spawn([]string8 argv):
        if !runnable(argv): fail os.Error.INVALID
        ref []char8 block = argv_block(argv)
        defer #delete(block)
        if block == nil: fail os.Error.NO_MEMORY
        CArgv c_argv = c_argv_of(&block, #len(argv))
        [2]i32 fds
        if sys.pipe(&fds[0]) != 0: try os.fail_last()
        i32 pid = sys.fork()
        if pid < 0:
            os.Error why = os.last_error()
            _ = sys.close(fds[0])
            _ = sys.close(fds[1])
            try os.fail_with(why)
        if pid == 0:
            // **Only async-signal-safe calls between `fork` and `exec`**, which
            // is `dup2`, `close`, `execvp` and `_exit` and nothing else.
            _ = sys.dup2(fds[1], 1)
            _ = sys.close(fds[0])
            _ = sys.close(fds[1])
            exec_argv(&c_argv)
        _ = sys.close(fds[1])
        ^io.FILE f = fdopen(fds[0], "r")
        if f == nil:
            os.Error why2 = os.last_error()
            _ = sys.close(fds[0])
            _ = reap(pid)
            try os.fail_with(why2)
        return (f, pid)

    // ── closing, which is where the answer is ─────────────────────────────────

    // Close the pipe and wait for the program. The `close` twin, and the same
    // protocol: read to the end first, because the answer is here and not at
    // the `spawn`. Fails `INVALID` for a `Child` that never started.
    os.Error!Ended wait(Child c):
        if c.stream == nil: fail os.Error.INVALID
        _ = io.close(c.stream)
        (bool exited, i32 status) = reap(c.pid)
        try Ended e = ended_or_fail(exited, status)
        return e

    // ── the two halves nobody outside this file should have to write ──────────

    // In the child, and it does not return. `execvp` returns only on failure,
    // and 127 is the status a shell reports for a command it could not run.
    private void exec_argv(^CArgv c_argv):
        _ = sys.execvp(c_argv^[0], Argv(rawptr(&c_argv^[0])))
        sys._exit(127)

    // In the parent. `waitpid` with no options blocks until the child ends.
    private (bool exited, i32 status) reap(i32 pid):
        i32 raw = 0
        if wait_for.waitpid(pid, &raw, 0) < 0: return (false, 0 - 1)
        return decode(raw)
