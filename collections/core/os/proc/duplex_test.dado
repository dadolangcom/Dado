@test
// `duplex` against real children. What is claimed, one scenario per function:
//
//   * **A megabyte through `cat` and back, byte for byte, with neither side
//     stuck.** Sixteen times a Linux pipe, sent and received in turn from one
//     thread. A `send` that blocked would deadlock here — `cat` stops reading
//     while its stdout is full — so this is the test that holds the
//     non-blocking design, and it also counts that the pipe really did fill
//     (`send` failed `WAITED` or answered a short count at least once).
//   * **An exit code, a signal, and a missing program** come back as three
//     different answers: `Exited`, `Signaled`, and `duplex` failing
//     `NOT_FOUND`.
//   * **A write to a child that has exited is `BROKE`, and this process is
//     still here to say so** — `SIGPIPE` did not kill it.
//   * **`close_input` is end-of-file**, and it still is with a second child
//     alive: the close-on-exec test. Removing the flag from `open_pipe` was run
//     and this scenario (and every other that closes a `cat`'s input) failed
//     on its 2 s deadline with the `cat` still running; restored, it passes.
//   * **Every verb is total over a handle that never started, and over one
//     that has been stopped.**
//
// Every wait here has a deadline, so a regression fails rather than hangs.
// The children are `cat`, `sleep` and `/bin/sh` running builtins, which both
// supported platforms have.
//
// The `Pipe!` answers are read through `send_n`, `recv_n` and `recv_err_n` below,
// which give the count, or -1 for `WAITED` and -2 for `BROKE`; and the endings
// through `fin` and `halted`, as `(done, exited, status)` with a signal
// negated.
package proc

import "core:os"
import "core:time"

private i64 send_n(^Duplex d, []char8 bytes, i32 timeout_ms):
    try i64 n = send(d, bytes, timeout_ms) else why:
        if why == Pipe.WAITED: return 0 - 1
        return 0 - 2
    return n

private i64 recv_n(^Duplex d, []char8 into, i32 timeout_ms):
    try i64 n = receive(d, into, timeout_ms) else why:
        if why == Pipe.WAITED: return 0 - 1
        return 0 - 2
    return n

private i64 recv_err_n(^Duplex d, []char8 into, i32 timeout_ms):
    try i64 n = receive_errors(d, into, timeout_ms) else why:
        if why == Pipe.WAITED: return 0 - 1
        return 0 - 2
    return n

// `finish`'s answer as `(done, exited, status)`: not done while it runs, and
// `(true, false, -1)` for `BROKE`.
private (bool done, bool exited, i32 status) fin(^Duplex d, i32 timeout_ms):
    try Ended e = finish(d, timeout_ms) else why:
        if why == Pipe.WAITED: return (false, false, 0 - 1)
        return (true, false, 0 - 1)
    switch e:
        case Exited x: return (true, true, x.code)
        case Signaled s: return (true, false, 0 - s.signal)

// `stop`'s answer as `(exited, status)`, `(false, -1)` for `BROKE`.
private (bool exited, i32 status) halted(^Duplex d, i32 grace_ms):
    try Ended e = stop(d, grace_ms) else:
        return (false, 0 - 1)
    switch e:
        case Exited x: return (true, x.code)
        case Signaled s: return (false, 0 - s.signal)

// `duplex`, or a zero `Duplex` when it failed.
private Duplex started_or_zero([]string8 argv, Errors errors):
    try Duplex d = duplex(argv, errors) else:
        Duplex zero
        return zero
    return d

// The code `duplex` fails with, or `UNKNOWN` when it started.
private os.Error refusal([]string8 argv, Errors errors):
    try Duplex d = duplex(argv, errors) else why:
        return why
    _ = halted(&d, 0)
    return os.Error.UNKNOWN

// On Windows this file is empty: it runs `/bin/sh`, `cat` and signals, which
// Windows does not have, and `windows_test.dado` holds the same claims there.
when #OS == #WINDOWS:
    i32 test():
        return 0
else:
    // What `stdio_closed_parent` moves stdin aside and back with. Bound as `ux`
    // and not as `sys`: a binding's name is in scope only in a file that writes a
    // block under it — measured, `sys.close` here was ERR0408 until this file
    // declared a `sys` block of its own — and writing one just to reach the other
    // files' members would be a block that declares nothing it uses.
    private foreign ux "unistd.h" define "_POSIX_C_SOURCE=200809L":
        i32 dup2(i32 old, i32 new)
        i32 close(i32 fd)

    private foreign ux "fcntl.h" define "_POSIX_C_SOURCE=200809L":
        const i32 F_DUPFD_CLOEXEC
        const i32 F_GETFD
        i32 fcntl(i32 fd, i32 cmd, ...)

    private const i64 MIB = 1048576

    // A program that is not on anybody's `PATH`.
    private const string8 MISSING = "dado-no-such-program-zqx98765"

    i32 test():
        bool ok = true
        ok = megabyte_round_trip() && ok
        ok = statuses() && ok
        ok = missing_program() && ok
        ok = write_after_exit() && ok
        ok = child_sigpipe_is_default() && ok
        ok = eof_by_close_input() && ok
        ok = two_children() && ok
        ok = error_modes() && ok
        ok = stdio_closed_parent() && ok
        ok = bad_handles() && ok
        if ok: return 0
        return 1

    // ── the round trip ────────────────────────────────────────────────────────

    private bool megabyte_round_trip():
        bool ok = true
        [2]string8 argv = ["cat", "-"]
        Duplex d = started_or_zero(argv[:], Errors.Inherit)
        if !#expect(started(d), "cat did not start"): return false

        ref []char8 payload = #make([]char8, MIB, #heap)
        if payload == nil: return false
        defer #delete(payload)
        for i in 0..<MIB:
            payload[i] = char8(i % 251)

        [8192]char8 chunk
        i64 sent = 0
        i64 got = 0
        i32 mismatches = 0
        i32 stalls = 0
        bool drained = false
        bool broke = false
        time.Instant began = time.instant()
        for !drained && !broke && time.as_milliseconds(time.elapsed(began)) < 20000:
            if sent < MIB:
                i64 n = send_n(&d, payload[sent..<MIB], 0)
                if n == 0 - 2: broke = true
                if n == 0 - 1: stalls += 1
                if n > 0:
                    if i64(n) < MIB - sent: stalls += 1
                    sent += i64(n)
                    if sent == MIB: _ = close_input(&d)
            i64 r = recv_n(&d, chunk[:], 5)
            if r == 0: drained = true
            if r == 0 - 2: broke = true
            if r > 0:
                for k in 0..<r:
                    if got + i64(k) < MIB && chunk[k] != payload[got + i64(k)]: mismatches += 1
                got += i64(r)

        (bool done, bool exited, i32 status) = fin(&d, 2000)
        close_pipes(&d)
        ok = #expect(!broke, "the round trip broke") && ok
        ok = #expect(sent == MIB, "sent ", sent, " of ", MIB) && ok
        ok = #expect(got == MIB, "read back ", got, " of ", MIB) && ok
        ok = #expect(mismatches == 0, mismatches, " bytes came back different") && ok
        ok = #expect(drained, "never saw end-of-file after closing cat's input") && ok
        ok = #expect(stalls > 0, "the pipe never filled, so nothing proved send does not block") && ok
        ok = #expect(done && exited && status == 0, "cat ended done=", done, " exited=", exited, " status=", status) && ok
        return ok

    // ── how children end ──────────────────────────────────────────────────────

    private bool statuses():
        bool ok = true
        [3]string8 three = ["/bin/sh", "-c", "exit 3"]
        Duplex d = started_or_zero(three[:], Errors.Inherit)
        ok = #expect(started(d), "sh did not start") && ok
        (bool done, bool exited, i32 status) = fin(&d, 2000)
        ok = #expect(done && exited && status == 3, "exit 3 gave done=", done, " exited=", exited, " status=", status) && ok
        // Once reaped the answer is the record's, asked again without the kernel.
        (bool again, bool exited2, i32 status2) = fin(&d, 0)
        ok = #expect(again && exited2 && status2 == 3, "a second finished() changed its answer") && ok
        close_pipes(&d)

        // `finished` before the child is done says so, and `terminate` is a
        // negated signal number with `exited` false.
        [2]string8 nap = ["sleep", "30"]
        Duplex s = started_or_zero(nap[:], Errors.Inherit)
        ok = #expect(started(s), "sleep did not start") && ok
        (bool early, _, _) = fin(&s, 0)
        ok = #expect(!early, "sleep 30 finished at once") && ok
        (bool timed, _, _) = fin(&s, 30)
        ok = #expect(!timed, "a 30 ms finish() on sleep 30 said done") && ok
        ok = #expect(terminate(&s), "terminate refused a live child") && ok
        (bool tdone, bool texited, i32 tstatus) = fin(&s, 2000)
        ok = #expect(tdone && !texited && tstatus == 0 - 15, "SIGTERM gave done=", tdone, " exited=", texited, " status=", tstatus) && ok
        // Reaped, so its pid may be anybody's now: no more signals.
        ok = #expect(!kill(&s), "kill signalled a reaped pid") && ok
        ok = #expect(!terminate(&s), "terminate signalled a reaped pid") && ok
        close_pipes(&s)

        // `stop` on a child that ignores its stdin's end: grace, then SIGKILL.
        Duplex k = started_or_zero(nap[:], Errors.Inherit)
        time.Instant began = time.instant()
        (bool kexited, i32 kstatus) = halted(&k, 50)
        i64 took = time.as_milliseconds(time.elapsed(began))
        ok = #expect(!kexited && kstatus == 0 - 9, "stop gave exited=", kexited, " status=", kstatus) && ok
        ok = #expect(took < 2000, "stop took ", took, " ms for a 50 ms grace") && ok
        return ok

    private bool missing_program():
        bool ok = true
        [2]string8 argv = [MISSING, "x"]
        Duplex d = started_or_zero(argv[:], Errors.Inherit)
        ok = #expect(!started(d), "a missing program reported as started") && ok
        os.Error why = refusal(argv[:], Errors.Inherit)
        ok = #expect(why == os.Error.NOT_FOUND, "a missing program failed with ", os.message(why), ", not NOT_FOUND") && ok
        [4]char8 bytes
        ok = #expect(send_n(&d, bytes[:], 0) == 0 - 2, "send to a failed start was not BROKE") && ok
        return ok

    // ── broken pipes ──────────────────────────────────────────────────────────

    private bool write_after_exit():
        bool ok = true
        [3]string8 argv = ["/bin/sh", "-c", "exit 0"]
        Duplex d = started_or_zero(argv[:], Errors.Inherit)
        (bool done, _, _) = fin(&d, 2000)
        ok = #expect(done, "sh -c 'exit 0' did not finish") && ok
        ok = #expect(ignoring_sigpipe(), "SIGPIPE was not set to ignored") && ok

        [64]char8 bytes
        // Reaching the line after `send` is the SIGPIPE half of the claim.
        i64 n = send_n(&d, bytes[:], 100)
        ok = #expect(n == 0 - 2, "a write to an exited child answered ", n) && ok
        try send_all(&d, bytes[:], 100) else why:
            ok = #expect(why == Pipe.BROKE, "send_all to an exited child failed ", message(why)) && ok
        close_pipes(&d)
        return ok

    // The ignore this package installs must not reach the child: a shell that
    // sends itself `SIGPIPE` dies of it, and would print "alive" if it were
    // inherited as ignored.
    private bool child_sigpipe_is_default():
        bool ok = true
        [3]string8 argv = ["/bin/sh", "-c", "kill -PIPE $$; echo alive"]
        Duplex d = started_or_zero(argv[:], Errors.Inherit)
        [64]char8 chunk
        i64 total = 0
        time.Instant began = time.instant()
        for time.as_milliseconds(time.elapsed(began)) < 2000:
            i64 r = recv_n(&d, chunk[:], 10)
            if r == 0 || r == 0 - 2: break
            if r > 0: total += r
        (bool done, bool exited, i32 status) = fin(&d, 2000)
        ok = #expect(total == 0, "the child survived its own SIGPIPE and wrote ", total, " bytes") && ok
        ok = #expect(done && !exited && status == 0 - 13, "SIGPIPE in the child gave exited=", exited, " status=", status) && ok
        close_pipes(&d)
        return ok

    // ── end-of-file ───────────────────────────────────────────────────────────

    private bool eof_by_close_input():
        bool ok = true
        [2]string8 argv = ["cat", "-"]
        Duplex d = started_or_zero(argv[:], Errors.Inherit)
        [5]char8 hello
        hello[0] = char8(104)
        hello[1] = char8(101)
        hello[2] = char8(108)
        hello[3] = char8(108)
        hello[4] = char8(111)
        try send_all(&d, hello[:], 1000) else why:
            ok = #expect(false, "send_all failed ", message(why)) && ok
        ok = #expect(close_input(&d), "close_input did not close") && ok
        ok = #expect(!close_input(&d), "a second close_input claimed to close") && ok
        ok = #expect(send_n(&d, hello[:], 0) == 0 - 2, "send after close_input was not BROKE") && ok

        [16]char8 chunk
        i64 total = 0
        bool drained = false
        time.Instant began = time.instant()
        for !drained && time.as_milliseconds(time.elapsed(began)) < 2000:
            i64 r = recv_n(&d, chunk[total..<16], 10)
            if r == 0: drained = true
            if r > 0: total += r
            if r == 0 - 2: break
        ok = #expect(drained && total == 5, "cat gave back ", total, " bytes, drained=", drained) && ok
        ok = #expect(chunk[0] == hello[0] && chunk[4] == hello[4], "cat changed the bytes") && ok
        // End-of-file is sticky.
        ok = #expect(recv_n(&d, chunk[:], 0) == 0, "a second receive after the end was not DRAINED") && ok
        (bool done, bool exited, i32 status) = fin(&d, 2000)
        ok = #expect(done && exited && status == 0, "cat did not exit 0 on end-of-file") && ok
        close_pipes(&d)
        return ok

    // The close-on-exec claim. `b` is started after `a`, so without the flag it
    // holds a copy of `a`'s stdin write end and `a` never sees end-of-file.
    private bool two_children():
        bool ok = true
        [2]string8 argv = ["cat", "-"]
        Duplex a = started_or_zero(argv[:], Errors.Inherit)
        Duplex b = started_or_zero(argv[:], Errors.Inherit)
        ok = #expect(started(a) && started(b), "two cats did not start") && ok
        _ = close_input(&a)
        (bool done, bool exited, i32 status) = fin(&a, 2000)
        ok = #expect(done && exited && status == 0, "the first cat did not see end-of-file while the second lived: done=", done) && ok
        (bool bdone, _, _) = fin(&b, 0)
        ok = #expect(!bdone, "the second cat ended with the first") && ok
        _ = halted(&a, 0)
        (bool bexited, i32 bstatus) = halted(&b, 2000)
        ok = #expect(bexited && bstatus == 0, "the second cat did not end on stop: ", bstatus) && ok
        return ok

    // ── standard error ────────────────────────────────────────────────────────

    private i64 read_all(^Duplex d, []char8 into, bool errors):
        i64 total = 0
        time.Instant began = time.instant()
        for time.as_milliseconds(time.elapsed(began)) < 2000 && total < #len(into):
            i64 r = 0
            if errors: r = recv_err_n(d, into[total..<#len(into)], 10)
            else: r = recv_n(d, into[total..<#len(into)], 10)
            if r == 0 || r == 0 - 2: break
            if r > 0: total += r
        return total

    private bool error_modes():
        bool ok = true
        [3]string8 argv = ["/bin/sh", "-c", "printf out; printf err >&2"]
        [16]char8 outb
        [16]char8 errb

        Duplex p = started_or_zero(argv[:], Errors.Pipe)
        i64 po = read_all(&p, outb[:], false)
        i64 pe = read_all(&p, errb[:], true)
        ok = #expect(po == 3 && pe == 3, "ERRORS_PIPE split out=", po, " err=", pe) && ok
        ok = #expect(errb[0] == char8(101), "the stderr pipe did not carry 'err'") && ok
        _ = halted(&p, 2000)

        Duplex m = started_or_zero(argv[:], Errors.Merge)
        i64 mo = read_all(&m, outb[:], false)
        ok = #expect(mo == 6, "ERRORS_MERGE carried ", mo, " bytes, not 6") && ok
        ok = #expect(recv_err_n(&m, errb[:], 0) == 0 - 2, "a merged child had a stderr pipe") && ok
        _ = halted(&m, 2000)

        Duplex x = started_or_zero(argv[:], Errors.Discard)
        i64 xo = read_all(&x, outb[:], false)
        ok = #expect(xo == 3, "ERRORS_DISCARD carried ", xo, " bytes, not 3") && ok
        (bool xexited, i32 xstatus) = halted(&x, 2000)
        ok = #expect(xexited && xstatus == 0, "the discarding child failed: ", xstatus) && ok

        os.Error bad = refusal(argv[:], Errors(7))
        ok = #expect(bad == os.Error.INVALID, "an unknown errors mode failed ", os.message(bad), ", not INVALID") && ok
        return ok

    // A parent with stdin closed gets pipe ends numbered 0 — the case
    // `above_stdio` exists for. Stdin is moved aside, closed, and put back.
    private bool stdio_closed_parent():
        bool ok = true
        i32 saved = ux.fcntl(0, ux.F_DUPFD_CLOEXEC, 3)
        if saved < 0: return #expect(false, "could not save stdin")
        _ = ux.close(0)

        [2]string8 argv = ["cat", "-"]
        Duplex d = started_or_zero(argv[:], Errors.Inherit)
        [3]char8 abc
        abc[0] = char8(97)
        abc[1] = char8(98)
        abc[2] = char8(99)
        i64 sent = 3
        try send_all(&d, abc[:], 1000) else:
            sent = 0
        _ = close_input(&d)
        [8]char8 back
        i64 got = read_all(&d, back[:], false)
        (bool exited, i32 status) = halted(&d, 2000)

        // `above_stdio` itself, with 0 free: a descriptor made there is moved to
        // 3 or above and 0 is left closed, which is what keeps every end
        // `duplex` makes off the child's 0, 1 and 2 however the parent started.
        // (glibc 2.29 and later clear close-on-exec on a `dup2` onto itself in
        // `posix_spawn`, so the scenario above passes here without the move; it
        // is for the others.)
        i32 zero = ux.fcntl(saved, ux.F_DUPFD_CLOEXEC, 0)
        i32 moved = above_stdio(zero)
        bool zero_free = ux.fcntl(0, ux.F_GETFD) < 0
        _ = ux.close(moved)

        _ = ux.dup2(saved, 0)
        _ = ux.close(saved)
        ok = #expect(zero == 0 && moved >= 3 && zero_free, "above_stdio: made ", zero, ", moved to ", moved, ", 0 free ", zero_free) && ok
        ok = #expect(started(d) && sent == 3 && got == 3, "with stdin closed: sent ", sent, ", got ", got) && ok
        ok = #expect(back[2] == char8(99), "with stdin closed the bytes changed") && ok
        ok = #expect(exited && status == 0, "with stdin closed cat gave ", status) && ok
        return ok

    // ── handles that are not children ─────────────────────────────────────────

    private bool bad_handles():
        bool ok = true
        [8]char8 buf

        // The zero value, which must never touch descriptor 0 or pid 0.
        Duplex zero
        ok = #expect(!started(zero), "the zero Duplex is started") && ok
        ok = #expect(send_n(&zero, buf[:], 0) == 0 - 2, "send on zero") && ok
        ok = #expect(recv_n(&zero, buf[:], 0) == 0 - 2, "receive on zero") && ok
        ok = #expect(recv_err_n(&zero, buf[:], 0) == 0 - 2, "receive_errors on zero") && ok
        ok = #expect(!close_input(&zero), "close_input on zero") && ok
        ok = #expect(!terminate(&zero) && !kill(&zero), "a signal to the zero Duplex") && ok
        try _ = finished(&zero) else zw:
            ok = #expect(zw == Pipe.BROKE, "finished on zero failed ", message(zw)) && ok
        try _ = finish(&zero, 0 - 1) else zf:
            ok = #expect(zf == Pipe.BROKE, "finish on zero failed ", message(zf)) && ok
        close_pipes(&zero)
        (bool ze, i32 zst) = halted(&zero, 0)
        ok = #expect(!ze && zst == 0 - 1, "stop on zero") && ok

        // A nil pointer.
        ok = #expect(send_n(nil, buf[:], 0) == 0 - 2, "send on nil") && ok
        ok = #expect(recv_n(nil, buf[:], 0) == 0 - 2, "receive on nil") && ok
        ok = #expect(!close_input(nil) && !kill(nil), "close or kill on nil") && ok
        close_pipes(nil)

        // A refused argv, and one that is empty.
        [3]string8 holed = ["cat", "a\0b", "x"]
        ok = #expect(refusal(holed[:], Errors.Inherit) == os.Error.INVALID, "a NUL inside an argument was run") && ok
        ok = #expect(refusal(holed[0..<0], Errors.Inherit) == os.Error.INVALID, "an empty argv was run") && ok

        // Stopped, then used: every descriptor is -1 and the pid is reaped, so
        // nothing is closed or signalled twice.
        [2]string8 argv = ["cat", "-"]
        Duplex d = started_or_zero(argv[:], Errors.Inherit)
        _ = halted(&d, 2000)
        ok = #expect(d.input == 0 - 1 && d.output == 0 - 1 && d.errors == 0 - 1, "stop left a descriptor open") && ok
        ok = #expect(send_n(&d, buf[:], 0) == 0 - 2, "send after stop") && ok
        ok = #expect(recv_n(&d, buf[:], 0) == 0 - 2, "receive after stop") && ok
        ok = #expect(!close_input(&d) && !kill(&d) && !terminate(&d), "a verb acted after stop") && ok
        close_pipes(&d)
        (bool done, bool exited, i32 status) = fin(&d, 0)
        ok = #expect(done && exited && status == 0, "the stopped cat's answer changed: ", status) && ok
        return ok
