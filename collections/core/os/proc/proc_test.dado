@test
// `core:os/proc` had **no test file at all** until this one, which is how a
// package that runs other programs and decodes their wait statuses shipped with
// nothing pinning either behaviour. It is written now because the package was
// rewritten — `proc.c` and `proc.h` are gone and the shell handling, the wait
// decoding and every nil guard are Dado — and a rewrite whose old behaviour
// nothing recorded is a rewrite nobody can check.
//
// **What is actually claimed here**, since running `echo` is not a test of this
// package:
//
//   * **`close` is where the exit status is, and `read` is not.** A command
//     that does not exist still opens; the status arrives at the close. That is
//     the package's one real contract and the header states it in bold.
//   * **The three endings are three different answers.** A normal exit gives
//     `(true, code)`; a signal gives `(false, -signal)`, which cannot be
//     confused with an exit code because an exit code is 0..255; a wait that
//     never happened gives `(false, -1)`.
//   * **Every nil guard.** These were C's while the shim existed and are Dado's
//     now, so each is a line this file has to reach or the rewrite dropped one
//     silently.
//
// The commands are `/bin/sh` builtins — `exit`, `kill`, `printf`, `cat` — so
// nothing here depends on a program being installed. Both supported platforms
// are POSIX and both have a shell; `available` is asked first and the file
// says so rather than assuming.
package proc

import "core:io"
import "core:strings"

// On Windows this file is empty: it runs `/bin/sh`, `cat` and signals, which
// Windows does not have, and `windows_test.dado` holds the same claims there.
when #OS == #WINDOWS:
    i32 test():
        return 0
else:
    private const cstring SINK_PATH = "/tmp/dado_core_proc_test.txt"

    i32 test():
        bool ok = true

        // ── available ────────────────────────────────────────────────────────────
        //
        // An invariant rather than an expectation: every check below runs a command,
        // so a platform with no shell has nothing for this file to say and carrying
        // on would report failures that are about the environment.
        #assert(available())

        // ── close carries the status, and read does not ──────────────────────────
        ^io.FILE zero = read("exit 0")
        ok = #expect(opened(zero), "a pipe for `exit 0` did not open") && ok
        (bool zero_exited, i32 zero_status) = close(zero)
        ok = #expect(zero_exited, "`exit 0` did not report exiting") && ok
        ok = #expect(zero_status == 0, "`exit 0` closed with status ", zero_status) && ok
        ok = #expect(ok_status(zero_exited, zero_status), "ok() was false for a clean exit") && ok

        // A non-zero code travels intact, and is not folded into a boolean.
        ^io.FILE three = read("exit 3")
        (bool three_exited, i32 three_status) = close(three)
        ok = #expect(three_exited, "`exit 3` did not report exiting") && ok
        ok = #expect(three_status == 3, "`exit 3` closed with status ", three_status) && ok
        ok = #expect(!ok_status(three_exited, three_status), "ok() was true for exit 3") && ok

        // **The claim the header makes in bold.** A command that does not exist
        // still opens — the shell started, which is all a successful open means —
        // and the failure arrives at the close as 127.
        ^io.FILE absent = read("toy_core_proc_test_no_such_command_9c1f 2>/dev/null")
        ok = #expect(opened(absent), "a pipe for a missing command did not open: an open says the shell started") && ok
        (bool absent_exited, i32 absent_status) = close(absent)
        ok = #expect(absent_exited, "a missing command did not report exiting") && ok
        ok = #expect(absent_status == 127, "a missing command closed with status ", absent_status, " and should have been 127") && ok

        // ── the bytes actually arrive ────────────────────────────────────────────
        ^io.FILE talker = read("printf 'hello\\n'")
        (cstring line, bool got) = io.read_line(talker)
        ok = #expect(got, "reading a command's output found no line") && ok
        string8 line_s = strings.borrow_from_cstring(line)
        ok = #expect(#len(line_s) == 5, "the command said \"", line, "\"") && ok
        (bool talked, i32 talk_status) = close(talker)
        ok = #expect(ok_status(talked, talk_status), "the talking command did not end cleanly") && ok

        // ── a signal is not an exit code ─────────────────────────────────────────
        //
        // `-15` is SIGTERM negated, and the encoding is the point: an exit code is
        // 0..255, so a negative status can only be a signal and the two can never
        // be confused. If the decoding ever collapsed to "non-zero means failure"
        // this line is what notices.
        ^io.FILE doomed = read("kill -TERM $$")
        (bool doomed_exited, i32 doomed_status) = close(doomed)
        ok = #expect(!doomed_exited, "a signalled process reported exiting") && ok
        ok = #expect(doomed_status == 0 - 15, "a SIGTERM gave status ", doomed_status, " and should have given -15") && ok

        // ── run: the caller's own streams, and the same pair ─────────────────────
        (bool ran, i32 ran_status) = run("exit 0")
        ok = #expect(ok_status(ran, ran_status), "run(`exit 0`) was not ok") && ok

        (bool ran7, i32 ran7_status) = run("exit 7")
        ok = #expect(ran7, "run(`exit 7`) did not report exiting") && ok
        ok = #expect(ran7_status == 7, "run(`exit 7`) gave status ", ran7_status) && ok

        // ── write: the other direction ───────────────────────────────────────────
        //
        // `w` is the mode the package's second opener exists for, and a pipe nobody
        // reads back is not a test of it — so the command writes a file and the
        // file is read afterwards.
        ^io.FILE sink = write("cat > /tmp/dado_core_proc_test.txt")
        ok = #expect(opened(sink), "a pipe for writing did not open") && ok
        _ = io.write(sink, "written through a pipe\n")
        (bool wrote, i32 wrote_status) = close(sink)
        ok = #expect(ok_status(wrote, wrote_status), "the writing command did not end cleanly") && ok

        ^io.FILE back = io.open_read(SINK_PATH)
        ok = #expect(io.opened(back), "the file the pipe wrote was not there") && ok
        (cstring written_line, bool read_back) = io.read_line(back)
        string8 written_s = strings.borrow_from_cstring(written_line)
        ok = #expect(read_back && #len(written_s) == 22, "the pipe wrote \"", written_line, "\"") && ok
        _ = io.close(back)

        // ── every nil guard ──────────────────────────────────────────────────────
        //
        // Each of these was a line of C while the shim existed. They are Dado now,
        // and a rewrite that dropped one would leave a `popen(NULL, ...)` or a
        // `pclose(NULL)` for a sanitizer to find at some later date rather than
        // here.
        cstring no_command = nil
        ok = #expect(read(no_command) == nil, "read(nil) opened something") && ok
        ok = #expect(write(no_command) == nil, "write(nil) opened something") && ok
        ok = #expect(!opened(read(no_command)), "opened() was true for a nil stream") && ok

        (bool nil_exited, i32 nil_status) = run(no_command)
        ok = #expect(!nil_exited, "run(nil) reported exiting") && ok
        ok = #expect(nil_status == 0 - 1, "run(nil) gave status ", nil_status) && ok

        ^io.FILE nothing = nil
        (bool closed_exited, i32 closed_status) = close(nothing)
        ok = #expect(!closed_exited, "close(nil) reported exiting") && ok
        ok = #expect(closed_status == 0 - 1, "close(nil) gave status ", closed_status) && ok

        // ── ok(), both arms ──────────────────────────────────────────────────────
        //
        // Two conditions and both have to be false somewhere, or the `&&` is a
        // conjunction nothing tested.
        ok = #expect(!ok_status(false, 0), "ok(false, 0) was true: a signalled process is not ok") && ok
        ok = #expect(!ok_status(true, 1), "ok(true, 1) was true: a non-zero exit is not ok") && ok

        if ok:
            return 0
        return 1

    // `ok` is this package's own name and this file is in this package, so calling
    // it unqualified inside a function that also has a local called `ok` would read
    // the local. One alias, written once, rather than renaming the accumulator
    // every other test file in the tree uses.
    private bool ok_status(bool exited, i32 status):
        return ok(exited, status)
