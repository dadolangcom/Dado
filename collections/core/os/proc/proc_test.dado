@test
// The shell form, `read`, `write`, `close` and `run`, and how an ending is
// told:
//
//   * **`close` is where the ending is, and `read` is not.** A command that
//     does not exist still opens; `Exited(127)` arrives at the close. That is
//     the package's one real contract and the header states it in bold.
//   * **The endings are a union.** A normal exit is `Exited(code)`; a signal
//     is `Signaled(number)`, which no exit code can be mistaken for; a wait
//     that never happened is a failure of the call, not a third member.
//   * **What the system refused is `os.Error`**: a stream not opened here
//     closes `INVALID`.
//   * **`Pipe`'s codes are this package's own**, 2100 and up, and each has a
//     sentence.
//
// The commands are `/bin/sh` builtins — `exit`, `kill`, `printf`, `cat` — so
// nothing here depends on a program being installed; `available` is asked
// first and the file says so rather than assuming.
package proc

import "core:io"
import "core:os"

// The ending's code when it exited, or -(signal) when a signal ended it.
private i32 code_of(Ended e):
    switch e:
        case Exited x: return x.code
        case Signaled s: return 0 - s.signal

// `ok` is this package's own name and this file is in this package, so calling
// it unqualified inside a function that also has a local called `ok` would read
// the local. One alias, written once.
private bool ok_ended(Ended e):
    return ok(e)

// The ending of closing `f`, or -1000 when the close failed.
private i32 closed(^io.FILE f):
    try Ended e = close(f) else:
        return 0 - 1000
    return code_of(e)

// On Windows this file holds only the portable claims: it runs `/bin/sh`,
// `cat` and signals, which Windows does not have, and `windows_test.dado`
// holds the rest there.
when #OS == #WINDOWS:
    i32 test():
        return 0 if portable() else 1
else:
    private const string8 SINK_PATH = "/tmp/dado_core_proc_test.txt"

    i32 test():
        bool ok = portable()

        // An invariant rather than an expectation: every check below runs a
        // command, so a platform with no shell has nothing for this file to say.
        #assert(available())

        // ── close carries the ending, and read does not ──────────────────────
        try ^io.FILE zero = read("exit 0") else why:
            _ = #expect(false, "a pipe for `exit 0` did not open: ", os.message(why))
            return 1
        try Ended z = close(zero) else why2:
            _ = #expect(false, "closing `exit 0` failed: ", os.message(why2))
            return 1
        ok = #expect(ok_ended(z) && code_of(z) == 0, "`exit 0` ended ", code_of(z)) && ok

        // A non-zero code travels intact, and is not folded into a boolean.
        try ^io.FILE three = read("exit 3") else why3:
            _ = #expect(false, "a pipe for `exit 3` did not open: ", os.message(why3))
            return 1
        try Ended t = close(three) else why4:
            _ = #expect(false, "closing `exit 3` failed: ", os.message(why4))
            return 1
        ok = #expect(!ok_ended(t) && code_of(t) == 3, "`exit 3` ended ", code_of(t)) && ok

        // **The claim the header makes in bold.** A command that does not exist
        // still opens — the shell started, which is all a successful open means —
        // and the failure arrives at the close as `Exited(127)`.
        try ^io.FILE absent = read("toy_core_proc_test_no_such_command_9c1f 2>/dev/null") else why5:
            _ = #expect(false, "a pipe for a missing command did not open: ", os.message(why5))
            return 1
        ok = #expect(closed(absent) == 127, "a missing command did not close Exited(127)") && ok

        // ── the bytes actually arrive ────────────────────────────────────────
        try ^io.FILE talker = read("printf 'hello\\n'") else why6:
            _ = #expect(false, "a pipe for printf did not open: ", os.message(why6))
            return 1
        try ref []char8 line = io.read_line(talker) else why7:
            _ = #expect(false, "reading a command's output found no line: ", os.message(why7))
            return 1
        ok = #expect(string8(line[:]) == "hello", "the command said '", string8(line[:]), "'") && ok
        #delete(line)
        ok = #expect(closed(talker) == 0, "the talking command did not end cleanly") && ok

        // ── a signal is not an exit code ─────────────────────────────────────
        try ^io.FILE doomed = read("kill -TERM $$") else why8:
            _ = #expect(false, "a pipe for `kill` did not open: ", os.message(why8))
            return 1
        try Ended d = close(doomed) else why9:
            _ = #expect(false, "closing a signalled command failed: ", os.message(why9))
            return 1
        switch d:
            case Exited x: ok = #expect(false, "a signalled process exited ", x.code) && ok
            case Signaled s: ok = #expect(s.signal == 15, "a SIGTERM was signal ", s.signal) && ok
        ok = #expect(!ok_ended(d), "ok() was true for a signalled process") && ok

        // ── run: the caller's own streams, and the same ending ───────────────
        try Ended ran = run("exit 0") else why10:
            _ = #expect(false, "run(`exit 0`) failed: ", os.message(why10))
            return 1
        ok = #expect(ok_ended(ran), "run(`exit 0`) was not ok") && ok
        try Ended ran7 = run("exit 7") else why11:
            _ = #expect(false, "run(`exit 7`) failed: ", os.message(why11))
            return 1
        ok = #expect(code_of(ran7) == 7, "run(`exit 7`) ended ", code_of(ran7)) && ok

        // ── write: the other direction ───────────────────────────────────────
        try ^io.FILE sink = write("cat > /tmp/dado_core_proc_test.txt") else why12:
            _ = #expect(false, "a pipe for writing did not open: ", os.message(why12))
            return 1
        _ = io.write(sink, "written through a pipe\n")
        ok = #expect(closed(sink) == 0, "the writing command did not end cleanly") && ok
        try ^io.FILE back = io.open_read(SINK_PATH) else why13:
            _ = #expect(false, "the file the pipe wrote was not there: ", os.message(why13))
            return 1
        try ref []char8 written = io.read_line(back) else why14:
            _ = #expect(false, "the file the pipe wrote was empty: ", os.message(why14))
            return 1
        ok = #expect(string8(written[:]) == "written through a pipe", "the pipe wrote '", string8(written[:]), "'") && ok
        #delete(written)
        _ = io.close(back)

        // ── a stream this package did not open ───────────────────────────────
        ^io.FILE nothing = nil
        Ended none = Ended(Exited(0 - 1))
        try none = close(nothing) else why15:
            ok = #expect(why15 == os.Error.INVALID, "close(nil) failed ", os.message(why15), ", not INVALID") && ok
        ok = #expect(code_of(none) == 0 - 1, "close(nil) answered an ending") && ok

        if ok:
            return 0
        return 1

// What holds on every platform: `ok` over each member, and `Pipe`'s codes.
private bool portable():
    bool ok = true
    Ended exited0 = Ended(Exited(0))
    Ended exited1 = Ended(Exited(1))
    Ended killed = Ended(Signaled(9))
    ok = #expect(ok_ended(exited0), "ok(Exited(0)) was false") && ok
    ok = #expect(!ok_ended(exited1), "ok(Exited(1)) was true: a non-zero exit is not ok") && ok
    ok = #expect(!ok_ended(killed), "ok(Signaled(9)) was true: a signalled process is not ok") && ok
    ok = #expect(i32(Pipe.WAITED) == 2100 && i32(Pipe.BROKE) == 2101, "Pipe's codes left 2100..2199") && ok
    string8 broke = message(Pipe.BROKE)
    ok = #expect(message(Pipe.WAITED) != broke && #len(broke) > 0, "Pipe's codes share a sentence") && ok
    ok = #expect(message(Pipe(0)) == "not a code of core:os/proc", "a value that is no member has no sentence of its own") && ok
    return ok
