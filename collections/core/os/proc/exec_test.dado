@test
// The claim this file exists for is one sentence: **an argument containing a
// space, a quote and a `;` reaches the child as one argument and runs nothing.**
// The shell form in `proc_test.dado` cannot make that claim and this one is how
// the difference is held.
package proc

import "core:io"
import "core:os"

// The ending's code when it exited, or -(signal) when a signal ended it.
private i32 code_of(Ended e):
    switch e:
        case Exited x: return x.code
        case Signaled s: return 0 - s.signal

// `ok`, under a name a local `ok` does not hide.
private bool ok_ended(Ended e):
    return ok(e)

// The ending's exit code, or -1000 for an exec that failed and -(signal).
private i32 exec_code([]string8 argv):
    try Ended e = exec(argv) else:
        return 0 - 1000
    return code_of(e)

// The code `exec` fails with, or `UNKNOWN` when it ran.
private os.Error exec_refusal([]string8 argv):
    try Ended e = exec(argv) else why:
        return why
    _ = code_of(e)
    return os.Error.UNKNOWN

// On Windows this file is empty: it runs `/bin/sh`, `cat` and signals, which
// Windows does not have, and `windows_test.dado` holds the same claims there.
when #OS == #WINDOWS:
    i32 test():
        return 0
else:
    // The witness. `/bin/sh` is used here as a *program being run*, not as the
    // thing this package invokes on a caller's behalf: it is handed an argv, and
    // what it prints is that argv read back.
    private const string8 COUNTER = "printf 'argc=%d\n' $#; printf 'arg=[%s]\n' \"$@\""

    // A space, a single quote, a semicolon and a command that would be visible if
    // anything had interpreted it.
    private const string8 NASTY = "a b'c;d ; touch /tmp/dado_proc_exec_test_INJECTED ;"

    private const string8 INJECTED = "/tmp/dado_proc_exec_test_INJECTED"

    i32 test():
        bool ok = true

        // ── one argument in, one argument out ────────────────────────────────
        [5]string8 argv = ["/bin/sh", "-c", COUNTER, "sh", NASTY]
        try Child c = spawn(argv[:]) else why:
            _ = #expect(false, "spawn did not start /bin/sh: ", os.message(why))
            return 1
        try ref []char8 first = io.read_line(c.stream) else why2:
            _ = #expect(false, "the counter said nothing: ", os.message(why2))
            return 1
        try ref []char8 second = io.read_line(c.stream) else why3:
            _ = #expect(false, "the counter said one line: ", os.message(why3))
            return 1
        ref []char8 third = nil
        try third = io.read_line(c.stream) else why4:
            ok = #expect(why4 == os.Error.END, "the counter's output failed ", os.message(why4)) && ok
        ok = #expect(third == nil, "the counter said a third line") && ok
        #delete(third)
        try Ended e = wait(c) else why5:
            _ = #expect(false, "wait failed: ", os.message(why5))
            return 1

        ref []char8 want = #format("arg=[", NASTY, "]")
        ok = #expect(string8(first[:]) == "argc=1", "the argument was split: ", string8(first[:])) && ok
        ok = #expect(string8(second[:]) == string8(want[:]), "the argument did not arrive whole: ", string8(second[:])) && ok
        ok = #expect(ok_ended(e), "the counter did not exit 0") && ok
        #delete(want)
        #delete(second)
        #delete(first)

        // **Nothing ran.** The `;` and the `touch` were bytes in an argument, so
        // the file the argument names does not exist.
        ^io.FILE leftover = nil
        try leftover = io.open_read(INJECTED) else:
            leftover = nil
        ok = #expect(leftover == nil, "an argument was interpreted: ", INJECTED, " exists") && ok
        if leftover != nil:
            _ = io.close(leftover)

        // ── the ending is the child's, not a shell's ─────────────────────────
        // A one-element array is its element (A2), so a run of one is a window
        // over a longer array.
        [2]string8 falsely = ["false", ""]
        ok = #expect(exec_code(falsely[0..<1]) == 1, "/bin/false ended ", exec_code(falsely[0..<1])) && ok

        // A program that is not there is `Exited(127)`, which is what a shell
        // reports for the same thing.
        [2]string8 missing = ["dado-no-such-program-zqx98765", ""]
        ok = #expect(exec_code(missing[0..<1]) == 127, "a missing program ended ", exec_code(missing[0..<1])) && ok

        // ── what this package refuses to run ─────────────────────────────────
        // Each of these fails `INVALID`: the system was never asked.
        ok = #expect(exec_refusal(falsely[0..<0]) == os.Error.INVALID, "an empty argv was not INVALID") && ok
        [3]string8 holed = ["/bin/echo", "a\0b", "after"]
        ok = #expect(exec_refusal(holed[:]) == os.Error.INVALID, "a NUL inside an argument was not INVALID") && ok

        // One over the cap. Refused, and **not truncated to the cap**: an argv one
        // element short is a different program being run.
        ref []string8 long = #make([]string8, ARG_CAP + 1)
        for i in 0..<ARG_CAP + 1:
            long[i] = "true"
        ok = #expect(exec_refusal(long[:]) == os.Error.INVALID, "an over-cap argv was not INVALID") && ok
        // And exactly the cap is not refused, so the boundary is the boundary.
        ok = #expect(exec_code(long[0..<ARG_CAP]) == 0, "an argv at the cap did not run `true`") && ok
        #delete(long)

        // ── a Child that never started ───────────────────────────────────────
        Child none = (nil, 0 - 1)
        try none = spawn(holed[:]) else why7:
            ok = #expect(why7 == os.Error.INVALID, "a refused spawn failed ", os.message(why7)) && ok
        try _ = wait(none) else why8:
            ok = #expect(why8 == os.Error.INVALID, "waiting on nothing failed ", os.message(why8)) && ok

        if ok:
            return 0
        return 1
