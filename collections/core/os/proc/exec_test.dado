@test
// The claim this file exists for is one sentence: **an argument containing a
// space, a quote and a `;` reaches the child as one argument and runs nothing.**
// The shell form in `proc_test.dado` cannot make that claim and this one is how
// the difference is held.
package proc

import "core:io"
import "core:strings"

// On Windows this file is empty: it runs `/bin/sh`, `cat` and signals, which
// Windows does not have, and `windows_test.dado` holds the same claims there.
when #OS == #WINDOWS:
    i32 test():
        return 0
else:
    // The witness. `/bin/sh` is used here as a *program being run*, not as the
    // thing this package invokes on a caller's behalf: it is handed an argv, and
    // what it prints is that argv read back. So the test's own child is what
    // counts the arguments, which is the only counter that cannot be fooled by
    // `echo` joining them with spaces.
    private const cstring COUNTER = "printf 'argc=%d\n' $#; printf 'arg=[%s]\n' \"$@\""

    // A space, a single quote, a semicolon and a command that would be visible if
    // anything had interpreted it.
    private const cstring NASTY = "a b'c;d ; touch /tmp/dado_proc_exec_test_INJECTED ;"

    private const cstring INJECTED = "/tmp/dado_proc_exec_test_INJECTED"

    i32 test():
        bool ok = true

        // ── one argument in, one argument out ────────────────────────────────
        [5]cstring argv
        argv[0] = "/bin/sh"
        argv[1] = "-c"
        argv[2] = COUNTER
        argv[3] = "sh"
        argv[4] = NASTY

        Child c = spawn(argv[:])
        ok = #expect(spawned(c), "spawn did not start /bin/sh") && ok
        if !spawned(c):
            return 1

        // `read_line` hands back a pointer into one shared buffer that the next
        // read clobbers, so each line that has to outlive the loop is copied.
        ref []char8 first = #make([]char8, 0, #heap)
        ref []char8 second = #make([]char8, 0, #heap)
        i32 lines = 0
        for:
            (cstring line, bool got) = io.read_line(c.stream)
            if !got:
                break
            if lines == 0:
                #delete(first)
                first = strings.clone_from_cstring(line, #heap)
            if lines == 1:
                #delete(second)
                second = strings.clone_from_cstring(line, #heap)
            lines = lines + 1
        (bool exited, i32 status) = wait(c)

        string8 nasty = string8(NASTY)
        ref []char8 want = #format("arg=[", nasty, "]", #heap)
        // Bound rather than written as a conversion: a `ref` **lends** a `string`,
        // and a lend is spelled by binding.
        string8 saw_first = first
        string8 saw_second = second
        string8 wanted = want
        ok = #expect(lines == 2, "expected 2 lines from the counter, got ", lines) && ok
        ok = #expect(saw_first == "argc=1", "the argument was split: ", saw_first) && ok
        ok = #expect(saw_second == wanted, "the argument did not arrive whole: ", saw_second) && ok
        ok = #expect(exited && status == 0, "counter exited=", exited, " status=", status) && ok
        #delete(want)
        #delete(second)
        #delete(first)

        // **Nothing ran.** The `;` and the `touch` were bytes in an argument, so
        // the file the argument names does not exist. This is the assertion the
        // shell form fails: measured, `proc.read` on the same value created it.
        ^io.FILE leftover = io.open_read(INJECTED)
        ok = #expect(leftover == nil, "an argument was interpreted: ", string8(INJECTED), " exists") && ok
        if leftover != nil:
            _ = io.close(leftover)

        // ── the status is the child's, not a shell's ─────────────────────────
        // A one-element argv is a slice and not a `[1]cstring`: a one-slot tuple
        // is its element (A2), so `[1]T` is a `T` and was never a run to slice.
        ref []cstring falsely = #make([]cstring, 1, #heap)
        falsely[0] = "false"
        (bool fe, i32 fs) = exec(falsely[:])
        ok = #expect(fe && fs == 1, "/bin/false gave exited=", fe, " status=", fs) && ok
        #delete(falsely)

        // A program that is not there is 127, which is what a shell reports for
        // the same thing — so a caller moving off `run` reads the same number.
        ref []cstring missing = #make([]cstring, 1, #heap)
        missing[0] = "dado-no-such-program-zqx98765"
        (bool me, i32 ms) = exec(missing[:])
        ok = #expect(me && ms == 127, "a missing program gave exited=", me, " status=", ms) && ok
        #delete(missing)

        // ── what this package refuses to run ─────────────────────────────────
        // Each of these is `(false, -1)`, the pair that means *the system said no*
        // and is distinct from a program that ran and failed.
        ref []cstring empty = #make([]cstring, 0, #heap)
        (bool ee, i32 es) = exec(empty[:])
        ok = #expect(!ee && es == 0 - 1, "an empty argv gave exited=", ee, " status=", es) && ok
        #delete(empty)

        [3]cstring holed
        holed[0] = "/bin/echo"
        holed[1] = nil
        holed[2] = "after"
        (bool he, i32 hs) = exec(holed[:])
        ok = #expect(!he && hs == 0 - 1, "a nil inside argv gave exited=", he, " status=", hs) && ok

        // One over the cap. Refused, and **not truncated to the cap**: an argv one
        // element short is a different program being run.
        ref []cstring long = #make([]cstring, ARG_CAP + 1, #heap)
        i32 i = 0
        for i < ARG_CAP + 1:
            long[i] = "true"
            i = i + 1
        (bool le, i32 ls) = exec(long[:])
        ok = #expect(!le && ls == 0 - 1, "an over-cap argv gave exited=", le, " status=", ls) && ok
        #delete(long)

        // And exactly the cap is not refused, so the boundary is the boundary and
        // not one less. `true` (found on `PATH`: macOS has it only in `/usr/bin`) with 254 ignored arguments.
        ref []cstring atcap = #make([]cstring, ARG_CAP, #heap)
        i32 j = 0
        for j < ARG_CAP:
            atcap[j] = "true"
            j = j + 1
        (bool ae, i32 as2) = exec(atcap[:])
        ok = #expect(ae && as2 == 0, "an argv at the cap gave exited=", ae, " status=", as2) && ok
        #delete(atcap)

        // ── a Child that never started ───────────────────────────────────────
        Child none = spawn(holed[:])
        ok = #expect(!spawned(none), "a refused spawn reported as started") && ok
        (bool ne, i32 ns) = wait(none)
        ok = #expect(!ne && ns == 0 - 1, "waiting on nothing gave exited=", ne, " status=", ns) && ok

        if ok:
            return 0
        return 1
