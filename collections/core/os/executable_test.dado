@test
// `executable_path` names this test's own binary, absolutely, on the system
// the test is built for, and a second call answers the same bytes.
//
// The test runner names each test binary after its file, so the path must
// hold `executable_test`; the rest of it is wherever the build put it, which
// this test does not know and does not claim.
package os

import "core:mem/libc"
import "core:strings"

private bool names_this_test(string8 p):
    bool ok = #expect(strings.contains(p, "executable_test"), "executable_path() is '", p, "', not this test's binary")
    try string8 again = executable_path() else code:
        return #expect(false, "a second executable_path() failed: ", message(code)) && ok
    ok = #expect(again == p, "a second executable_path() is '", again, "', not '", p, "'") && ok
    return ok

when #OS == #WINDOWS:
    // A drive (`C:\…`) or a UNC share (`\\server\…`), written with Windows'
    // own separator. The extension is whatever the build named the image.
    private bool shaped(string8 p):
        bool ok = #expect(#len(p) > 3, "executable_path() is '", p, "'")
        if #len(p) <= 3: return ok
        bool drive = p[1] == ':' && (p[2] == '\\' || p[2] == '/')
        bool unc = p[0] == '\\' && p[1] == '\\'
        ok = #expect(drive || unc, "executable_path() '", p, "' is not absolute") && ok
        ok = #expect(strings.contains(p, "\\"), "executable_path() '", p, "' has no `\\` in it") && ok
        return ok
else when #OS == #DARWIN:
    // `realpath`'s answer: absolute, and with no `.` or `..` component left.
    private bool shaped(string8 p):
        bool ok = #expect(#len(p) > 1 && p[0] == '/', "executable_path() '", p, "' is not absolute")
        ok = #expect(!strings.contains(p, "/./") && !strings.contains(p, "/../"), "executable_path() '", p, "' is not resolved") && ok
        return ok
else:
    // The kernel's answer: absolute, resolved, and not the link itself.
    private bool shaped(string8 p):
        bool ok = #expect(#len(p) > 1 && p[0] == '/', "executable_path() '", p, "' is not absolute")
        ok = #expect(!strings.contains(p, "/./") && !strings.contains(p, "/../"), "executable_path() '", p, "' is not resolved") && ok
        ok = #expect(p != "/proc/self/exe", "executable_path() answered the link, not its target") && ok
        return ok

i32 test():
    using libc.allocator():
        try string8 p = executable_path() else code:
            _ = #expect(false, "executable_path() failed: ", message(code))
            return 1
        bool ok = shaped(p)
        ok = names_this_test(p) && ok
        if ok: return 0
        return 1
