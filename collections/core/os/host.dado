// The machine and the person: the host's name, the user's name and the
// directories a program keeps its settings and its cache in, the whole
// environment at once, how many processors there are, bytes nobody can
// predict, and Ctrl-C.
//
//     try ref []char8 dir = os.config_dir() else code:
//         println("no settings directory: ", os.message(code))
//         return 1
//     defer #delete(dir)
//
//     [32]u8 key
//     try os.random_bytes(key[:]) else code:
//         ...
//
//     try os.catch_interrupt() else code:
//         ...
//     for !os.interrupted():
//         step()
//
// **Allocation is the caller's ambient allocator** (`using`): a `ref []char8`
// answer is the caller's to `#delete`, and an `Environment` is ended with
// its `destroy` method.
//
// **On `#WEB`** the host has no name for itself or its user that this package
// can reach yet and no directories, so those fail with `UNSUPPORTED`;
// `environment` is empty, `random_bytes` fails with `UNSUPPORTED` (the host's
// `crypto.getRandomValues` is not imported yet), `catch_interrupt` fails with
// `UNSUPPORTED` (a page has no Ctrl-C to catch) and `interrupted` is always
// false. `cpu_count` is the host's own count.
//
// **What raises into a script.** Nothing here: each function asks the system
// through a `foreign` call, or is built on `get_env`, which does.
//
// Thread-safety: everything is safe from any thread, except that
// `catch_interrupt` and `release_interrupt` change the whole process's
// handling of Ctrl-C and belong in `main`; `interrupted` may be asked from any
// thread, and answers for the process.
package os

// One variable of an `Environment`: views into the environment's own bytes,
// good until it is destroyed.
type EnvVar:
    string8 name
    string8 value

// A copy of the whole environment: one block of bytes and one slice of views
// over it. End it with `destroy`, never by `#delete` of either half.
type Environment:
    ref []char8 bytes
    ref []EnvVar vars

    // Free the two blocks `environment` made. Safe on an empty environment.
    void destroy(self):
        #delete(self.vars)
        #delete(self.bytes)

// How many times Ctrl-C (or Ctrl-Break) arrived since it was last asked
// about. Written by the handler, which may run on any thread (on Windows, one
// the system starts for it), so it is `volatile` and only ever set whole.
private volatile i32 g_interrupts

// Whether `catch_interrupt` installed the handler.
private bool g_catching

// `name` and `value` joined into an environment's bytes, recorded as spans
// first: the views can only be taken once the bytes stop moving.
private type EnvSpan: (i64 at, i64 name_len, i64 value_len)

// The `Environment` over `bytes`, given the spans of each variable.
private Environment views_over(ref []char8 bytes, []EnvSpan spans):
    ref []EnvVar vars = #make([]EnvVar, 0)
    string8 all = bytes
    for s in spans:
        string8 name = all[s.at..<s.at + s.name_len]
        i64 v = s.at + s.name_len + 1
        string8 value = all[v..<v + s.value_len]
        _ = #append(vars, (name, value))
    return (bytes, vars)

// One `NAME=value` entry appended to `bytes`, its span to `spans`. An entry
// with no `=`, or one whose name is empty (Windows' per-drive directories,
// `=C:=C:\`), is skipped.
private void add_entry(^ref []char8 bytes, ^ref []EnvSpan spans, string8 entry):
    i64 eq = 0 - 1
    for i in 1..<#len(entry):
        if entry[i] == '=':
            eq = i
            break
    if eq <= 0: return
    i64 at = #len(bytes^)
    for c in entry:
        _ = #append(bytes^, c)
    _ = #append(spans^, (at, eq, #len(entry) - eq - 1))

// `base` and `rest` joined by `sep`, owned by the caller.
private ref []char8 joined(string8 base, string8 sep, string8 rest):
    return #format(base, sep, rest)

when #OS != #NONE:
    // The value of `name`, owned by the caller, when it is set to an absolute
    // path; `NOT_FOUND` when it is unset or anything else, `NO_MEMORY` when it
    // cannot be copied.
    private Error!ref []char8 absolute_env(string8 name):
        try ref []char8 v = get_env(name) else why:
            if why == Error.NO_MEMORY: fail Error.NO_MEMORY
            fail Error.NOT_FOUND
        string8 s = v
        if #len(s) > 0 && (s[0] == '/' || s[0] == '\\' || (#len(s) > 2 && s[1] == ':')): return v
        #delete(v)
        fail Error.NOT_FOUND

// ── Windows ─────────────────────────────────────────────────────────────────
//
// `GetComputerNameW` is the NetBIOS name, which is what `hostname` prints on
// Windows. `GetUserNameW` is `advapi32`'s. `BCryptGenRandom` is `bcrypt`'s,
// with the system's preferred generator (`BCRYPT_USE_SYSTEM_PREFERRED_RNG`,
// 2), so no algorithm handle is opened. A console's Ctrl-C and Ctrl-Break are
// delivered to `SetConsoleCtrlHandler`'s routine on a thread the system
// starts for it; answering 1 says it was handled and the process is not ended.
when #OS == #WINDOWS:
    private foreign whost "windows.h" define "WIN32_LEAN_AND_MEAN=1":
        const #c.ushort ALL_PROCESSOR_GROUPS
        const #c.ulong CTRL_C_EVENT
        const #c.ulong CTRL_BREAK_EVENT
        #c.int GetComputerNameW(^u16 into, ^#c.ulong size)
        #c.ulong GetActiveProcessorCount(#c.ushort group)
        ^u16 GetEnvironmentStringsW()
        #c.int FreeEnvironmentStringsW(^u16 block)
        #c.int SetConsoleCtrlHandler(CtrlHandler handler, #c.int add)

    private foreign wuser "windows.h" link "-ladvapi32":
        #c.int GetUserNameW(^u16 into, ^#c.ulong size)

    private foreign wrng "bcrypt.h" link "-lbcrypt":
        #c.long BCryptGenRandom(rawptr algorithm, ^#c.uchar into, #c.ulong count, #c.ulong flags)

    private const #c.ulong USE_SYSTEM_RNG = 2

    private type CtrlHandler: #c.int(#c.ulong)
    private type UcharBuf: ^#c.uchar

    // The name this machine goes by on its network, owned by the caller.
    // Fails with the system's reason, and `UNSUPPORTED` on `#WEB`.
    //
    // On Windows it is `GetComputerNameW`'s NetBIOS name.
    Error!ref []char8 hostname():
        [256]u16 buf
        #c.ulong size = 256
        if whost.GetComputerNameW(&buf[0], &size) == 0: try fail_last()
        return narrow(&buf[0], i64(size))

    // The name of the user this process runs as, owned by the caller. Fails
    // with `NOT_FOUND` when the system does not say, and `UNSUPPORTED` on
    // `#WEB`.
    //
    // On Windows it is `GetUserNameW`, whose count includes the terminator.
    Error!ref []char8 user_name():
        [257]u16 buf
        #c.ulong size = 257
        if wuser.GetUserNameW(&buf[0], &size) == 0: try fail_last()
        if size <= 1: fail Error.NOT_FOUND
        return narrow(&buf[0], i64(size) - 1)

    // The directory this user's settings belong in, owned by the caller:
    // `$XDG_CONFIG_HOME` or `~/.config` on Linux and the BSDs,
    // `~/Library/Application Support` on macOS, `%APPDATA%` on Windows. A
    // program makes its own directory inside it. Fails with `NOT_FOUND` when
    // neither the variable nor a home directory is set, and `UNSUPPORTED` on
    // `#WEB`.
    Error!ref []char8 config_dir():
        try ref []char8 v = absolute_env("APPDATA")
        return v

    // The directory this user's caches belong in — what may be deleted and
    // rebuilt — owned by the caller: `$XDG_CACHE_HOME` or `~/.cache` on Linux
    // and the BSDs, `~/Library/Caches` on macOS, `%LOCALAPPDATA%` on Windows.
    // Fails as `config_dir` does.
    Error!ref []char8 cache_dir():
        try ref []char8 v = absolute_env("LOCALAPPDATA")
        return v

    // A copy of every environment variable, in the system's order. Empty on
    // `#WEB`.
    //
    // On Windows, `GetEnvironmentStringsW`'s block: `NAME=value` entries, each
    // ended by a `\0`, the whole ended by an empty one.
    Environment environment():
        ref []char8 bytes = #make([]char8, 0)
        ref []EnvSpan spans = #make([]EnvSpan, 0)
        defer #delete(spans)
        ^u16 block = whost.GetEnvironmentStringsW()
        if block != nil:
            // The block's length is not known until its empty entry; a window
            // larger than any block is taken and read only up to that entry.
            []u16 units = block[0..<1073741824]
            i64 at = 0
            for units[at] != 0:
                i64 end = at
                for units[end] != 0:
                    end += 1
                ref []char8 entry = narrow(&units[at], end - at)
                add_entry(&bytes, &spans, entry)
                #delete(entry)
                at = end + 1
            _ = whost.FreeEnvironmentStringsW(block)
        return views_over(bytes, spans)

    // How many processors this process may run on, at least 1.
    //
    // On Windows, `GetActiveProcessorCount` over every processor group.
    i32 cpu_count():
        #c.ulong n = whost.GetActiveProcessorCount(whost.ALL_PROCESSOR_GROUPS)
        if n < 1: return 1
        return i32(n)

    // Fill `into` with bytes from the system's cryptographic generator: the
    // source for keys, tokens and nonces, which `random` is not. Fails with
    // the system's reason (and leaves `into` unspecified), and `UNSUPPORTED`
    // on `#WEB`.
    //
    // On Windows it is `BCryptGenRandom` over the system's preferred
    // generator, asked at most 2^30 bytes at a time.
    Error!void random_bytes([]u8 into):
        i64 done = 0
        i64 n = #len(into)
        for done < n:
            i64 step = n - done
            if step > 1073741824: step = 1073741824
            #c.long status = wrng.BCryptGenRandom(nil, UcharBuf(rawptr(&into[done])), #c.ulong(step), USE_SYSTEM_RNG)
            if status != 0: fail Error.UNKNOWN
            done += step
        return

    // The handler: Ctrl-C and Ctrl-Break are counted and handled; closing the
    // console, logging off and shutting down are left to the system.
    private #c.int on_console(#c.ulong kind):
        if kind == whost.CTRL_C_EVENT || kind == whost.CTRL_BREAK_EVENT:
            g_interrupts = 1
            return 1
        return 0

    // From now on, Ctrl-C does not end the program: it is recorded, and
    // `interrupted` answers it. Calling it twice is the same as once. Fails
    // with the system's reason, and `UNSUPPORTED` on `#WEB`.
    //
    // On Windows it adds a console control handler, which also catches
    // Ctrl-Break.
    Error!void catch_interrupt():
        if g_catching: return
        if whost.SetConsoleCtrlHandler(on_console, 1) == 0: try fail_last()
        g_catching = true
        return

    // Put Ctrl-C back to ending the program. Nothing when it was not caught.
    void release_interrupt():
        if !g_catching: return
        _ = whost.SetConsoleCtrlHandler(on_console, 0)
        g_catching = false

// ── the web ─────────────────────────────────────────────────────────────────
//
// The host's processor count is the runtime's `dado_rt__web_thread_cores`
// (`navigator.hardwareConcurrency`, or node's `os.availableParallelism`).
// Everything else would need a host import that is not there yet, and fails
// as the file's head says.
else when #OS == #WEB:
    private foreign "dado/web.h":
        i32 dado_rt__web_thread_cores()

    Error!ref []char8 hostname():
        fail Error.UNSUPPORTED

    Error!ref []char8 user_name():
        fail Error.UNSUPPORTED

    Error!ref []char8 config_dir():
        fail Error.UNSUPPORTED

    Error!ref []char8 cache_dir():
        fail Error.UNSUPPORTED

    Environment environment():
        return (#make([]char8, 0), #make([]EnvVar, 0))

    i32 cpu_count():
        i32 n = dado_rt__web_thread_cores()
        if n < 1: return 1
        return n

    // Where the host's `crypto.getRandomValues` will answer, once imported.
    private Error!void web_random(^u8 into, i64 count):
        fail Error.UNSUPPORTED

    Error!void random_bytes([]u8 into):
        if #len(into) == 0: return
        try web_random(&into[0], #len(into))
        return

    Error!void catch_interrupt():
        fail Error.UNSUPPORTED

    void release_interrupt():
        return

// ── POSIX: Linux, macOS and the BSDs ────────────────────────────────────────
//
// `gethostname`, `getlogin_r` and `sysconf` are `<unistd.h>`'s.
// `_SC_NPROCESSORS_ONLN` is not POSIX but every system here has it. The
// environment is `environ`, which glibc and musl declare under `_GNU_SOURCE`
// and the BSDs by default; macOS reaches it through `_NSGetEnviron`. Ctrl-C is
// `SIGINT`, caught with C's `signal`, which keeps the handler installed on
// every system here (BSD semantics).
else when #OS != #NONE:
    private foreign hsys "unistd.h" define "_POSIX_C_SOURCE=200809L":
        #c.int gethostname(^#c.char into, #c.size_t size)
        #c.int getlogin_r(^#c.char into, #c.size_t size)

    private type HostChars: ^#c.char
    private type SigHandler: void(i32)

    private foreign hsig "signal.h":
        const i32 SIGINT
        const SigHandler SIG_DFL
        const SigHandler SIG_ERR
        SigHandler signal(i32 signum, SigHandler handler)

    // `getrandom` answers fewer bytes than asked past 256 and is asked again;
    // `arc4random_buf` never fails. The first is Linux's (glibc 2.25 and musl
    // 1.1.20 on) and FreeBSD's (12 on), the second the other systems'.
    // The environment block, the processor count and the generator, per
    // system. A build that defines `_POSIX_C_SOURCE` — and this tree's
    // packages do — hides each system's own extensions: glibc and musl give
    // `environ` back under `_GNU_SOURCE`, NetBSD everything under
    // `_NETBSD_SOURCE` and OpenBSD under `_BSD_SOURCE`, and FreeBSD has no
    // macro that undoes it, so there the processor count is a `sysctl`. No BSD
    // declares `environ` at all, so it is declared here, as POSIX tells a
    // program to do.
    // No BSD header declares `environ`; POSIX says a program declares it
    // itself, and this is that declaration.
    when #OS == #FREEBSD || #OS == #NETBSD || #OS == #OPENBSD:
        private @c_body("""
            extern char **environ;
            """) i32 g_environ_declared = 0

    when #OS == #DARWIN:
        private foreign "crt_externs.h":
            ^^^#c.char _NSGetEnviron()

        private foreign hrng "stdlib.h" define "_DARWIN_C_SOURCE=1":
            void arc4random_buf(rawptr into, #c.size_t count)

        private foreign hcpu "unistd.h" define "_DARWIN_C_SOURCE=1":
            #c.long sysconf(#c.int name)
            const #c.int _SC_NPROCESSORS_ONLN

        private rawptr environ_block():
            return rawptr(_NSGetEnviron()^)

        private Error!void fill_random([]u8 into):
            if #len(into) > 0: hrng.arc4random_buf(rawptr(&into[0]), #c.size_t(#len(into)))
            return

        private i64 processors():
            return i64(hcpu.sysconf(hcpu._SC_NPROCESSORS_ONLN))
    else when #OS == #FREEBSD:
        private foreign henv "unistd.h":
            const rawptr environ

        private foreign hrng "sys/random.h":
            #c.long getrandom(rawptr into, #c.size_t count, #c.uint flags)

        private foreign hcpu "sys/sysctl.h":
            const #c.int CTL_HW
            const #c.int HW_NCPU
            #c.int sysctl(^const #c.int name, #c.uint namelen, rawptr oldp, ^#c.size_t oldlenp, const rawptr newp, #c.size_t newlen)

        private rawptr environ_block():
            return henv.environ

        private Error!void fill_random([]u8 into):
            i64 done = 0
            i64 n = #len(into)
            for done < n:
                i64 got = i64(hrng.getrandom(rawptr(&into[done]), #c.size_t(n - done), 0))
                if got < 0:
                    Error code = last_error()
                    if code == Error.INTERRUPTED: continue
                    try fail_with(code)
                done += got
            return

        private i64 processors():
            [2]#c.int mib
            mib[0] = hcpu.CTL_HW
            mib[1] = hcpu.HW_NCPU
            #c.int n = 0
            #c.size_t size = #c.size_t(#size(#c.int))
            if hcpu.sysctl(&mib[0], 2, rawptr(&n), &size, nil, 0) != 0: return 1
            return i64(n)
    else when #OS == #LINUX:
        private foreign henv "unistd.h" define "_GNU_SOURCE=1":
            const rawptr environ

        private foreign hrng "sys/random.h":
            #c.long getrandom(rawptr into, #c.size_t count, #c.uint flags)

        private foreign hcpu "unistd.h":
            #c.long sysconf(#c.int name)
            const #c.int _SC_NPROCESSORS_ONLN

        private rawptr environ_block():
            return henv.environ

        private Error!void fill_random([]u8 into):
            i64 done = 0
            i64 n = #len(into)
            for done < n:
                i64 got = i64(hrng.getrandom(rawptr(&into[done]), #c.size_t(n - done), 0))
                if got < 0:
                    Error code = last_error()
                    if code == Error.INTERRUPTED: continue
                    try fail_with(code)
                done += got
            return

        private i64 processors():
            return i64(hcpu.sysconf(hcpu._SC_NPROCESSORS_ONLN))
    // NetBSD and OpenBSD: each macro is inert on the other system. This is
    // also the arm a build with no target selects (`#UNKNOWN_OS`), and its C
    // may meet glibc, which warns about `_BSD_SOURCE` alone: `_DEFAULT_SOURCE`
    // quiets it there and is inert on both BSDs.
    else:
        private foreign henv "unistd.h" define "_NETBSD_SOURCE=1" define "_BSD_SOURCE=1" define "_DEFAULT_SOURCE=1":
            const rawptr environ
            #c.long sysconf(#c.int name)
            const #c.int _SC_NPROCESSORS_ONLN

        private foreign hrng "stdlib.h" define "_NETBSD_SOURCE=1" define "_BSD_SOURCE=1" define "_DEFAULT_SOURCE=1":
            void arc4random_buf(rawptr into, #c.size_t count)

        private rawptr environ_block():
            return henv.environ

        private Error!void fill_random([]u8 into):
            if #len(into) > 0: hrng.arc4random_buf(rawptr(&into[0]), #c.size_t(#len(into)))
            return

        private i64 processors():
            return i64(henv.sysconf(henv._SC_NPROCESSORS_ONLN))

    // POSIX allows 255 bytes; the buffer is terminated here whatever the
    // system wrote, because a name that filled it is not terminated.
    Error!ref []char8 hostname():
        [256]char8 buf
        if hsys.gethostname(HostChars(rawptr(&buf[0])), 255) != 0: try fail_last()
        buf[255] = '\0'
        string8 name = string8(cstring(rawptr(&buf[0])))
        if #len(name) == 0: fail Error.NOT_FOUND
        return owned(name)

    // `USER`, then `LOGNAME`, which a login sets, then `getlogin_r`, which
    // asks the terminal's session; a process with neither (a service, a
    // container) fails with `NOT_FOUND`.
    Error!ref []char8 user_name():
        for variable in ["USER", "LOGNAME"]:
            ref []char8 who
            try who = get_env(variable) else why:
                if why == Error.NO_MEMORY: fail Error.NO_MEMORY
                continue
            if #len(who) > 0: return who
            #delete(who)
        [256]char8 buf
        if hsys.getlogin_r(HostChars(rawptr(&buf[0])), 256) != 0: fail Error.NOT_FOUND
        buf[255] = '\0'
        string8 name = string8(cstring(rawptr(&buf[0])))
        if #len(name) == 0: fail Error.NOT_FOUND
        return owned(name)

    // `name`, when it holds an absolute path, else `$HOME` and `rest`.
    private Error!ref []char8 xdg_or_home(string8 name, string8 rest):
        try ref []char8 v = absolute_env(name) else why:
            if why == Error.NO_MEMORY: fail Error.NO_MEMORY
            try ref []char8 home = home_dir()
            defer #delete(home)
            string8 h = home
            return joined(h, "/", rest)
        return v

    when #OS == #DARWIN:
        Error!ref []char8 config_dir():
            try ref []char8 home = home_dir()
            defer #delete(home)
            string8 h = home
            return joined(h, "/", "Library/Application Support")

        Error!ref []char8 cache_dir():
            try ref []char8 home = home_dir()
            defer #delete(home)
            string8 h = home
            return joined(h, "/", "Library/Caches")
    else:
        Error!ref []char8 config_dir():
            try ref []char8 dir = xdg_or_home("XDG_CONFIG_HOME", ".config")
            return dir

        Error!ref []char8 cache_dir():
            try ref []char8 dir = xdg_or_home("XDG_CACHE_HOME", ".cache")
            return dir

    // `environ`, read to its terminating null: the block carries no count,
    // so it is windowed larger than any environment and read only that far.
    Environment environment():
        ref []char8 bytes = #make([]char8, 0)
        ref []EnvSpan spans = #make([]EnvSpan, 0)
        defer #delete(spans)
        rawptr block = environ_block()
        if block != nil:
            []rawptr slots = ^rawptr(block)[0..<1073741824]
            i64 i = 0
            for slots[i] != nil:
                add_entry(&bytes, &spans, string8(cstring(slots[i])))
                i += 1
        return views_over(bytes, spans)

    i32 cpu_count():
        i64 n = processors()
        if n < 1: return 1
        if n > 2147483647: return 2147483647
        return i32(n)

    Error!void random_bytes([]u8 into):
        try fill_random(into)
        return

    // The handler touches one `volatile` word and nothing else, which is all a
    // signal handler may do.
    private void on_sigint(i32 signum):
        g_interrupts = 1

    Error!void catch_interrupt():
        if g_catching: return
        if hsig.signal(hsig.SIGINT, on_sigint) == hsig.SIG_ERR: try fail_last()
        g_catching = true
        return

    void release_interrupt():
        if !g_catching: return
        _ = hsig.signal(hsig.SIGINT, hsig.SIG_DFL)
        g_catching = false

// Whether Ctrl-C arrived since `catch_interrupt`, or since this last answered
// true; asking clears it, so each interrupt is answered once. Always false
// before `catch_interrupt` (Ctrl-C then ends the program, as it does by
// default) and on `#WEB`. An interrupt arriving between the read and the clear
// is folded into the one being answered.
bool interrupted():
    if g_interrupts == 0: return false
    g_interrupts = 0
    return true
