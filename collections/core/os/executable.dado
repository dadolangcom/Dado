// Where the program this process is running lives on the disk.
//
//     try string8 me = os.executable_path() else code:
//         println("cannot find myself: ", os.message(code))
//         return 1
//
// A toolchain finds everything it ships beside its own executable, so it has
// to know where that is — and `argv[0]` does not say: it is whatever the
// caller typed, a bare name looked up on `PATH`, or a symlink's own name. The
// system knows where the image it loaded came from, and each arm asks it:
//
// * **Linux:** `readlink("/proc/self/exe")`, which the kernel answers with the
//   file it mapped, every symlink already followed.
// * **FreeBSD:** `sysctl` of `KERN_PROC_PATHNAME` for this process, the
//   kernel's own record of the image it loaded.
// * **NetBSD:** `readlink("/proc/curproc/exe")`, which needs `/proc` mounted
//   (it is by default); unmounted, the call fails with the system's reason.
// * **OpenBSD:** the system keeps no record of the path a program was loaded
//   from, so the answer is `UNSUPPORTED` rather than a guess from `argv[0]`.
// * **macOS:** `_NSGetExecutablePath`, which answers the path the program was
//   started by (possibly through a symlink, possibly with `..` in it), then
//   `realpath`, which resolves it.
// * **Windows:** `GetModuleFileNameW(NULL, …)`, the image's full path as the
//   loader opened it, converted from UTF-16.
//
// **Made once, on the heap, and good for the whole process**, as `args` is:
// the answer does not change while the program runs, so it is a `string8`
// over bytes nobody frees, and a second call answers the same bytes. A path
// longer than the system's own limit, or a system that will not say, fails
// with `NOT_FOUND`; the bytes are UTF-8 on every system.
//
// **On `#WEB`** a module has no file it was loaded from that this package can
// name, so `executable_path` fails with `UNSUPPORTED`.
//
// Not promised to raise: every arm asks the system through a `foreign` call.
//
// Thread-safety: call it first from one thread (normally `main`); after that
// it only reads.
package os

private ref []char8 g_exe
private bool g_exe_made

// The largest path any arm asks for. Windows' long paths stop at 32767 UTF-16
// units; Linux's `PATH_MAX` is 4096 and Darwin's 1024.
private const i64 EXE_CAP = 32768

when #OS == #WINDOWS:
    private foreign "windows.h" define "WIN32_LEAN_AND_MEAN=1":
        type @incomplete @c("struct HINSTANCE__") ExeModule
        #c.ulong GetModuleFileNameW(^ExeModule module, ^u16 into, #c.ulong size)

    // Where the running program's executable is: an absolute path with every
    // link followed, UTF-8, made once and good for the whole process. Fails
    // with `NOT_FOUND` when the system will not say, and `UNSUPPORTED` where
    // it cannot (OpenBSD, `#WEB`).
    //
    // On Windows, `GetModuleFileNameW` answers the count it wrote, and a count
    // equal to the buffer means the path was cut short, which is refused
    // rather than answered.
    Error!string8 executable_path():
        if g_exe_made:
            string8 kept = g_exe
            return kept
        ref []u16 wide = #make([]u16, EXE_CAP)
        defer #delete(wide)
        if wide == nil: fail Error.NO_MEMORY
        #c.ulong got = GetModuleFileNameW(nil, &wide[0], #c.ulong(EXE_CAP))
        if got == 0 || i64(got) >= EXE_CAP: fail Error.NOT_FOUND
        using #heap:
            g_exe = narrow(&wide[0], i64(got))
        if #len(g_exe) == 0: fail Error.NOT_FOUND
        g_exe_made = true
        string8 made = g_exe
        return made

else when #OS == #DARWIN:
    private foreign dyld "mach-o/dyld.h":
        #c.int _NSGetExecutablePath(^#c.char into, ^u32 size)

    private foreign dreal "stdlib.h" define "_DARWIN_C_SOURCE=1":
        ^#c.char realpath(cstring path, ^#c.char resolved)
        void free(rawptr p)

    private foreign dstr "string.h":
        #c.size_t strlen(cstring s)

    private type ExeChars: ^#c.char

    // `_NSGetExecutablePath` answers -1 and the size it needs when the buffer
    // is too small; this buffer is the largest path Darwin has.
    Error!string8 executable_path():
        if g_exe_made:
            string8 kept = g_exe
            return kept
        ref []char8 raw = #make([]char8, EXE_CAP)
        defer #delete(raw)
        if raw == nil: fail Error.NO_MEMORY
        u32 size = u32(EXE_CAP)
        if dyld._NSGetExecutablePath(ExeChars(rawptr(&raw[0])), &size) != 0: fail Error.NOT_FOUND
        rawptr resolved = rawptr(dreal.realpath(cstring(rawptr(&raw[0])), nil))
        if resolved == nil: try fail_last()
        i64 n = i64(dstr.strlen(cstring(resolved)))
        using #heap:
            g_exe = owned(string8(cstring(resolved)))
        dreal.free(resolved)
        if n == 0 || #len(g_exe) != n: fail Error.NOT_FOUND
        g_exe_made = true
        string8 made = g_exe
        return made

// The kernel keeps the answer in a sysctl, read into a buffer of the largest
// size it can be: `size` says how much it wrote, terminator included.
else when #OS == #FREEBSD:
    private foreign fbsd "sys/sysctl.h":
        const #c.int CTL_KERN
        const #c.int KERN_PROC
        const #c.int KERN_PROC_PATHNAME
        #c.int sysctl(^const #c.int name, #c.uint namelen, rawptr oldp, ^#c.size_t oldlenp, const rawptr newp, #c.size_t newlen)

    Error!string8 executable_path():
        if g_exe_made:
            string8 kept = g_exe
            return kept
        ref []char8 raw = #make([]char8, EXE_CAP)
        defer #delete(raw)
        if raw == nil: fail Error.NO_MEMORY
        [4]#c.int mib
        mib[0] = fbsd.CTL_KERN
        mib[1] = fbsd.KERN_PROC
        mib[2] = fbsd.KERN_PROC_PATHNAME
        mib[3] = #c.int(0 - 1)
        #c.size_t size = #c.size_t(EXE_CAP)
        if fbsd.sysctl(&mib[0], 4, rawptr(&raw[0]), &size, nil, 0) != 0: try fail_last()
        i64 n = i64(size)
        // `size` counts the terminator; a path that filled the buffer is refused.
        if n > 0 && raw[n - 1] == '\0': n -= 1
        if n <= 0 || n >= EXE_CAP - 1: fail Error.NOT_FOUND
        using #heap:
            g_exe = owned(string8(raw[0..<n]))
        g_exe_made = true
        string8 made = g_exe
        return made

// OpenBSD records no path for a running image, so there is nothing true to
// answer.
else when #OS == #OPENBSD:
    Error!string8 executable_path():
        fail Error.UNSUPPORTED

// A module on the web has no file this package can name.
else when #OS == #WEB:
    Error!string8 executable_path():
        fail Error.UNSUPPORTED

// Linux reads `/proc/self/exe` and NetBSD `/proc/curproc/exe`: each a link
// the kernel answers with the file it mapped.
else when #OS != #NONE:
    private foreign lexe "unistd.h" define "_POSIX_C_SOURCE=200809L":
        #c.long readlink(cstring path, ^#c.char into, #c.size_t size)

    private type ExeChars: ^#c.char

    when #OS == #NETBSD:
        private const cstring SELF_EXE = "/proc/curproc/exe"
    else:
        private const cstring SELF_EXE = "/proc/self/exe"

    // `readlink` does not terminate what it writes and answers how much it
    // wrote; a count that fills the buffer may be a path cut short, so it is
    // refused.
    Error!string8 executable_path():
        if g_exe_made:
            string8 kept = g_exe
            return kept
        ref []char8 raw = #make([]char8, EXE_CAP)
        defer #delete(raw)
        if raw == nil: fail Error.NO_MEMORY
        i64 n = i64(lexe.readlink(SELF_EXE, ExeChars(rawptr(&raw[0])), #c.size_t(EXE_CAP)))
        if n < 0: try fail_last()
        if n == 0 || n >= EXE_CAP: fail Error.NOT_FOUND
        using #heap:
            g_exe = owned(string8(raw[0..<n]))
        g_exe_made = true
        string8 made = g_exe
        return made
