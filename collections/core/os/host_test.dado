@test
// The machine and the person (`host.dado`), run on the system the test is
// built for. A hosted system answers each question; `#WEB` answers each with
// the empty value or the `UNSUPPORTED` its comment promises, and that is what
// is checked there.
package os

private bool hosted_holds():
    bool ok = true
    try ref []char8 host = hostname() else code:
        ok = #expect(false, "hostname failed: ", message(code)) && ok
        return ok
    ok = #expect(#len(host) > 0, "hostname answered nothing") && ok
    #delete(host)

    // A service or a container may have no user name to give; a failure must
    // still be one of this package's codes.
    ref []char8 user = #make([]char8, 0)
    try user = user_name() else code:
        ok = #expect(code == Error.NOT_FOUND, "user_name failed with ", message(code)) && ok
    #delete(user)

    ref []char8 cfg = #make([]char8, 0)

    try cfg = config_dir() else code:
        ok = #expect(code == Error.NOT_FOUND, "config_dir failed with ", message(code)) && ok
    #delete(cfg)
    ref []char8 cache = #make([]char8, 0)
    try cache = cache_dir() else code:
        ok = #expect(code == Error.NOT_FOUND, "cache_dir failed with ", message(code)) && ok
    #delete(cache)

    // The environment holds a variable this test set, once, with its value.
    string8 name = "DADO_OS_HOST_TEST_ZQX"
    try set_env(name, "a=b") else code:
        ok = #expect(false, "set_env failed: ", message(code)) && ok
    Environment env = environment()
    i32 seen = 0
    for v in env.vars:
        ok = #expect(#len(v.name) > 0, "an environment variable has no name") && ok
        if v.name == name:
            seen += 1
            ok = #expect(v.value == "a=b", "the variable's value read back '", v.value, "'") && ok
    ok = #expect(seen == 1, "the variable set was seen ", seen, " times") && ok
    env.destroy()
    try unset_env(name) else code:
        ok = #expect(false, "unset_env failed: ", message(code)) && ok

    // Two draws of 32 bytes are not equal, which a broken source (all zero,
    // or the same bytes twice) would be.
    [32]u8 a
    [32]u8 b
    try random_bytes(a[:]) else code:
        ok = #expect(false, "random_bytes failed: ", message(code)) && ok
    try random_bytes(b[:]) else code:
        ok = #expect(false, "random_bytes failed: ", message(code)) && ok
    bool differ = false
    for i in 0..<32:
        if a[i] != b[i]: differ = true
    ok = #expect(differ, "two draws of random_bytes were the same") && ok
    try random_bytes(a[0..<0]) else code:
        ok = #expect(false, "random_bytes of nothing failed: ", message(code)) && ok

    // Catching, then releasing: nothing arrives in between.
    try catch_interrupt() else code:
        ok = #expect(false, "catch_interrupt failed: ", message(code)) && ok
    try catch_interrupt() else code:
        ok = #expect(false, "a second catch_interrupt failed: ", message(code)) && ok
    ok = #expect(!interrupted(), "an interrupt was reported that never came") && ok
    release_interrupt()
    release_interrupt()
    return ok

private bool web_holds():
    bool ok = true
    ref []char8 host = #make([]char8, 0)
    try host = hostname() else code:
        ok = #expect(code == Error.UNSUPPORTED, "hostname failed with ", message(code)) && ok
    #delete(host)
    ref []char8 user = #make([]char8, 0)
    try user = user_name() else code:
        ok = #expect(code == Error.UNSUPPORTED, "user_name failed with ", message(code)) && ok
    #delete(user)
    ref []char8 cfg = #make([]char8, 0)
    try cfg = config_dir() else code:
        ok = #expect(code == Error.UNSUPPORTED, "config_dir failed with ", message(code)) && ok
    #delete(cfg)
    ref []char8 cache = #make([]char8, 0)
    try cache = cache_dir() else code:
        ok = #expect(code == Error.UNSUPPORTED, "cache_dir failed with ", message(code)) && ok
    #delete(cache)
    Environment env = environment()
    ok = #expect(#len(env.vars) == 0, "the web's environment is not empty") && ok
    env.destroy()
    [4]u8 a
    try random_bytes(a[:]) else code:
        ok = #expect(code == Error.UNSUPPORTED, "random_bytes failed with ", message(code)) && ok
    try catch_interrupt() else code:
        ok = #expect(code == Error.UNSUPPORTED, "catch_interrupt failed with ", message(code)) && ok
    ok = #expect(!interrupted(), "the web reported an interrupt") && ok
    release_interrupt()
    return ok

i32 test():
    bool ok = #expect(cpu_count() >= 1, "cpu_count answered ", cpu_count()) && true
    when #OS == #WEB:
        ok = web_holds() && ok
    else:
        ok = hosted_holds() && ok
    return 0 if ok else 1
