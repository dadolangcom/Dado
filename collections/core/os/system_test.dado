@test
// The error code space, the environment, the arguments, and the process's
// own questions, run on the system the test is built for.
//
// The environment is the process's own, so every variable this test sets is
// named for it and removed before it returns.
package os

import "core:mem/libc"
import "core:strings"

// Every code, so each is checked to have a sentence and to be told apart from
// every other by value.
private type Codes: [20]i32
private const Codes ALL = (NOT_FOUND, EXISTS, PERMISSION, NOT_DIR, IS_DIR, NOT_EMPTY, INVALID, IO,
                           NO_SPACE, BUSY, CROSS_DEVICE, TOO_LONG, LOOP, READ_ONLY, NO_MEMORY,
                           TOO_MANY_OPEN, PRIVILEGE, UNSUPPORTED, INTERRUPTED, UNKNOWN)

private bool codes_hold():
    bool ok = true
    for i in 0..<20:
        i32 c = ALL[i]
        ok = #expect(c > 0 && c < 100, "code ", c, " is outside 1..99") && ok
        string8 m = message(c)
        ok = #expect(#len(m) > 0, "code ", c, " has no message") && ok
        ok = #expect(message(c) != message(1000), "code ", c, " answers the not-a-code sentence") && ok
        for j in 0..<i:
            ok = #expect(ALL[j] != c, "two codes share the value ", c) && ok
    string8 none = message(0)
    ok = #expect(none == message(1000) && #len(none) > 0, "a code that is not os's still has a sentence") && ok
    ok = #expect(from_system(0) == UNKNOWN, "the system's 'no error' maps to UNKNOWN") && ok
    return ok

private bool env_holds():
    bool ok = true
    string8 name = "DADO_OS_TEST_VARIABLE_ZQX"

    // Unset first, whatever a previous run left.
    try unset_env(name) else code:
        ok = #expect(false, "unset_env of a name that may not be set failed: ", message(code)) && ok
    (ref []char8 gone, bool there) = get_env(name)
    ok = #expect(!there && #len(gone) == 0, "an unset variable was found") && ok
    #delete(gone)

    // Set, read back, byte for byte, with characters outside ASCII.
    try set_env(name, "héllo €𝄞") else code:
        ok = #expect(false, "set_env failed: ", message(code)) && ok
    (ref []char8 v, bool found) = get_env(name)
    string8 vs = v
    ok = #expect(found && vs == "héllo €𝄞", "get_env read back '", vs, "'") && ok
    #delete(v)

    // **Empty is not unset.** A variable set to nothing is found, and is empty.
    try set_env(name, "") else code:
        ok = #expect(false, "set_env to the empty string failed: ", message(code)) && ok
    (ref []char8 e, bool efound) = get_env(name)
    ok = #expect(efound && #len(e) == 0, "a variable set to nothing was not found as empty: found=", efound, " len=", #len(e)) && ok
    #delete(e)

    // Unset again, and it is gone; unsetting what is not set is success.
    try unset_env(name) else code:
        ok = #expect(false, "unset_env failed: ", message(code)) && ok
    (ref []char8 after, bool still) = get_env(name)
    ok = #expect(!still, "unset_env left the variable set") && ok
    #delete(after)
    try unset_env(name) else code:
        ok = #expect(false, "unset_env of an unset name failed: ", message(code)) && ok

    // A name the table cannot hold is refused with INVALID, before the system
    // is asked.
    try set_env("", "x") else code:
        ok = #expect(code == INVALID, "set_env(\"\") failed with ", code, " not INVALID") && ok
    try set_env("A=B", "x") else code2:
        ok = #expect(code2 == INVALID, "set_env(\"A=B\") failed with ", code2, " not INVALID") && ok
    try unset_env("") else code3:
        ok = #expect(code3 == INVALID, "unset_env(\"\") failed with ", code3) && ok
    (ref []char8 bad, bool badfound) = get_env("A=B")
    ok = #expect(!badfound, "get_env of a name with '=' found something") && ok
    #delete(bad)

    // The old `cstring` surface still reads the same table.
    try set_env(name, "abc") else code4:
        ok = #expect(false, "set_env failed: ", message(code4)) && ok
    ok = #expect(has_env("DADO_OS_TEST_VARIABLE_ZQX"), "has_env does not see what set_env set") && ok
    try unset_env(name) else code5:
        ok = #expect(false, "unset_env failed: ", message(code5)) && ok
    ok = #expect(!has_env("DADO_OS_TEST_VARIABLE_ZQX"), "has_env still sees what unset_env removed") && ok
    return ok

private bool process_holds():
    bool ok = true
    ok = #expect(pid() > 0, "pid() is ", pid()) && ok

    ref []char8 t = temp_dir()
    ok = #expect(#len(t) > 0, "temp_dir() is empty") && ok
    #delete(t)

    try ref []char8 h = home_dir() else code:
        return #expect(false, "home_dir() failed: ", message(code)) && ok
    ok = #expect(#len(h) > 0, "home_dir() is empty") && ok
    #delete(h)

    // Nothing here can know whether a person is watching, so only the answers
    // that are certain are claimed: a negative or unknown stream is not one.
    ok = #expect(!is_terminal(0 - 1), "stream -1 is a terminal") && ok
    _ = is_terminal(1)
    return ok

when #OS == #WINDOWS:
    private foreign twin "windows.h" define "WIN32_LEAN_AND_MEAN=1":
        const #c.long ERROR_FILE_NOT_FOUND
        const #c.long ERROR_PRIVILEGE_NOT_HELD
        const #c.long ERROR_DIR_NOT_EMPTY

    // A test's entry has no `argv`, and on Windows `args` never reads one: the
    // command line is the process's own, and the first argument is the
    // program, which names this test's binary.
    private bool args_hold():
        bool ok = true
        []string8 a = args(0, nil)
        ok = #expect(#len(a) >= 1, "args() found no program name on the command line") && ok
        if #len(a) >= 1:
            ok = #expect(strings.contains(a[0], "system_test"), "args()[0] is '", a[0], "', not this test") && ok
        // Made once: a second call answers the same arguments.
        []string8 again = args(0, nil)
        ok = #expect(#len(again) == #len(a), "a second args() call differs") && ok
        ok = #expect(from_system(i64(twin.ERROR_FILE_NOT_FOUND)) == NOT_FOUND, "ERROR_FILE_NOT_FOUND is not NOT_FOUND") && ok
        ok = #expect(from_system(i64(twin.ERROR_PRIVILEGE_NOT_HELD)) == PRIVILEGE, "ERROR_PRIVILEGE_NOT_HELD is not PRIVILEGE") && ok
        ok = #expect(from_system(i64(twin.ERROR_DIR_NOT_EMPTY)) == NOT_EMPTY, "ERROR_DIR_NOT_EMPTY is not NOT_EMPTY") && ok
        return ok
else:
    private foreign terr "errno.h":
        const i32 ENOENT
        const i32 EEXIST
        const i32 ENOTEMPTY

    private type Word: [16]char8
    private Word w0
    private Word w1
    private Word w2
    private type Slots: [3]rawptr
    private Slots slots

    private void put(^Word w, string8 s):
        for i in 0..<#len(s):
            w^[i] = s[i]
        w^[#len(s)] = '\0'

    // A fake `argv`, with a UTF-8 argument, which `args` hands back as views.
    private bool args_hold():
        bool ok = true
        put(&w0, "prog")
        put(&w1, "été")
        put(&w2, "")
        slots[0] = rawptr(&w0[0])
        slots[1] = rawptr(&w1[0])
        slots[2] = rawptr(&w2[0])
        []string8 a = args(3, ^rawptr(&slots[0]))
        ok = #expect(#len(a) == 3, "args() has ", #len(a), " arguments, not 3") && ok
        if #len(a) == 3:
            ok = #expect(a[0] == "prog" && a[1] == "été" && a[2] == "", "args() read '", a[0], "' '", a[1], "' '", a[2], "'") && ok
        []string8 again = args(0, nil)
        ok = #expect(#len(again) == 3, "a second args() call differs") && ok
        ok = #expect(from_system(i64(terr.ENOENT)) == NOT_FOUND, "ENOENT is not NOT_FOUND") && ok
        ok = #expect(from_system(i64(terr.EEXIST)) == EXISTS, "EEXIST is not EXISTS") && ok
        ok = #expect(from_system(i64(terr.ENOTEMPTY)) == NOT_EMPTY, "ENOTEMPTY is not NOT_EMPTY") && ok
        return ok

i32 test():
    using libc.allocator():
        bool ok = codes_hold()
        ok = env_holds() && ok
        ok = process_holds() && ok
        ok = args_hold() && ok
        if ok: return 0
        return 1
