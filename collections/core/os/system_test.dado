@test
// The error code space, the environment, the arguments, and the process's
// own questions, run on the system the test is built for.
//
// The environment is the process's own, so every variable this test sets is
// named for it and removed before it returns.
package os

import "core:mem/libc"
import "core:strings"

// An allocator that refuses everything, to reach `get_env`'s `NO_MEMORY`.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

// Every code, so each is checked to have a sentence and to be told apart from
// every other by value.
private type Codes: [21]Error
private const Codes ALL = (Error.NOT_FOUND, Error.EXISTS, Error.PERMISSION, Error.NOT_DIR, Error.IS_DIR,
                           Error.NOT_EMPTY, Error.INVALID, Error.IO, Error.NO_SPACE, Error.BUSY,
                           Error.CROSS_DEVICE, Error.TOO_LONG, Error.LOOP, Error.READ_ONLY,
                           Error.NO_MEMORY, Error.TOO_MANY_OPEN, Error.PRIVILEGE, Error.UNSUPPORTED,
                           Error.INTERRUPTED, Error.END, Error.UNKNOWN)

private bool codes_hold():
    bool ok = true
    for i in 0..<21:
        Error c = ALL[i]
        ok = #expect(i32(c) > 0 && i32(c) < 100, "code ", i32(c), " is outside 1..99") && ok
        string8 m = message(c)
        ok = #expect(#len(m) > 0, "code ", i32(c), " has no message") && ok
        ok = #expect(message(c) != message(Error(1000)), "code ", i32(c), " answers the not-a-code sentence") && ok
        for j in 0..<i:
            ok = #expect(ALL[j] != c, "two codes share the value ", i32(c)) && ok
    // The numbers callers and older programs compare against stay as they
    // were: 1 is NOT_FOUND, 10 BUSY, 19 INTERRUPTED, 99 UNKNOWN.
    ok = #expect(i32(Error.NOT_FOUND) == 1 && i32(Error.BUSY) == 10 && i32(Error.INTERRUPTED) == 19 && i32(Error.UNKNOWN) == 99, "a code changed its number") && ok
    string8 none = message(Error(0))
    ok = #expect(none == message(Error(1000)) && #len(none) > 0, "a code that is not os's still has a sentence") && ok
    ok = #expect(from_system(0) == Error.UNKNOWN, "the system's 'no error' maps to UNKNOWN") && ok
    return ok

private bool env_holds():
    bool ok = true
    string8 name = "DADO_OS_TEST_VARIABLE_ZQX"

    // Unset first, whatever a previous run left.
    try unset_env(name) else why:
        ok = #expect(false, "unset_env of a name that may not be set failed: ", message(why)) && ok
    ref []char8 gone
    try gone = get_env(name) else why:
        ok = #expect(why == Error.NOT_FOUND, "an unset variable failed ", message(why), ", not NOT_FOUND") && ok
        gone = nil
    ok = #expect(gone == nil, "an unset variable was found") && ok
    #delete(gone)

    // Set, read back, byte for byte, with characters outside ASCII.
    try set_env(name, "héllo €𝄞") else why:
        ok = #expect(false, "set_env failed: ", message(why)) && ok
    try ref []char8 v = get_env(name) else why:
        return #expect(false, "get_env of a set variable failed: ", message(why)) && ok
    string8 vs = v
    ok = #expect(vs == "héllo €𝄞", "get_env read back '", vs, "'") && ok
    #delete(v)

    // **Empty is not unset.** A variable set to nothing is found, and is empty.
    try set_env(name, "") else why:
        ok = #expect(false, "set_env to the empty string failed: ", message(why)) && ok
    try ref []char8 e = get_env(name) else why:
        return #expect(false, "a variable set to nothing failed ", message(why)) && ok
    ok = #expect(#len(e) == 0, "a variable set to nothing measured ", #len(e)) && ok
    #delete(e)

    // **No memory is not unset.** A value that cannot be copied fails
    // `NO_MEMORY`, so a caller never reads it as missing.
    try set_env(name, "abc") else why:
        ok = #expect(false, "set_env failed: ", message(why)) && ok
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) nothing = (refuses, nil)
    using nothing:
        ref []char8 none
        try none = get_env(name) else why:
            ok = #expect(why == Error.NO_MEMORY, "get_env without memory failed ", message(why)) && ok
            none = nil
        ok = #expect(none == nil, "get_env without memory answered a value") && ok
        // Nor is it a malformed name: the copy the system call reads fails too.
        bool set_refused = false
        try set_env(name, "xyz") else why2:
            ok = #expect(why2 == Error.NO_MEMORY, "set_env without memory failed ", message(why2)) && ok
            set_refused = true
        ok = #expect(set_refused, "set_env without memory succeeded") && ok
        bool unset_refused = false
        try unset_env(name) else why3:
            ok = #expect(why3 == Error.NO_MEMORY, "unset_env without memory failed ", message(why3)) && ok
            unset_refused = true
        ok = #expect(unset_refused, "unset_env without memory succeeded") && ok

    // Unset again, and it is gone; unsetting what is not set is success.
    try unset_env(name) else why:
        ok = #expect(false, "unset_env failed: ", message(why)) && ok
    ref []char8 after
    try after = get_env(name) else:
        after = nil
    ok = #expect(after == nil, "unset_env left the variable set") && ok
    #delete(after)
    try unset_env(name) else why:
        ok = #expect(false, "unset_env of an unset name failed: ", message(why)) && ok

    // A name the table cannot hold is refused with INVALID, before the system
    // is asked.
    try set_env("", "x") else why:
        ok = #expect(why == Error.INVALID, "set_env(\"\") failed with ", message(why), " not INVALID") && ok
    try set_env("A=B", "x") else why2:
        ok = #expect(why2 == Error.INVALID, "set_env(\"A=B\") failed with ", message(why2), " not INVALID") && ok
    // A NUL is refused, not cut short at: the value is not set to "a".
    bool nul_refused = false
    try set_env(name, "a\0b") else why3:
        ok = #expect(why3 == Error.INVALID, "a value with a NUL failed with ", message(why3), " not INVALID") && ok
        nul_refused = true
    ok = #expect(nul_refused, "a value with a NUL was set") && ok
    try unset_env(name) else:
        ok = #expect(false, "unset_env after the NUL value failed") && ok
    try unset_env("") else why4:
        ok = #expect(why4 == Error.INVALID, "unset_env(\"\") failed with ", message(why4)) && ok
    ref []char8 bad
    try bad = get_env("A=B") else why5:
        ok = #expect(why5 == Error.INVALID, "get_env of a name with '=' failed ", message(why5), " not INVALID") && ok
        bad = nil
    ok = #expect(bad == nil, "get_env of a name with '=' found something") && ok
    #delete(bad)
    return ok

private bool process_holds():
    bool ok = true
    ok = #expect(pid() > 0, "pid() is ", pid()) && ok

    ref []char8 t = temp_dir()
    ok = #expect(#len(t) > 0, "temp_dir() is empty") && ok
    #delete(t)

    try ref []char8 h = home_dir() else why:
        return #expect(false, "home_dir() failed: ", message(why)) && ok
    ok = #expect(#len(h) > 0, "home_dir() is empty") && ok
    #delete(h)

    // Nothing here can know whether a person is watching, so only the answers
    // that are certain are claimed: a negative or unknown stream is not one.
    ok = #expect(!is_terminal(0 - 1), "stream -1 is a terminal") && ok
    _ = is_terminal(1)
    return ok

when #OS == #WINDOWS:
    private foreign twin "windows.h" define "WIN32_LEAN_AND_MEAN=1":
        const #c.long ERROR_FILE_NOT_FOUND
        const #c.long ERROR_PRIVILEGE_NOT_HELD
        const #c.long ERROR_DIR_NOT_EMPTY
        const #c.long ERROR_SHARING_VIOLATION

    // A test's entry has no `argv`, and on Windows `args` never reads one: the
    // command line is the process's own, and the first argument is the
    // program, which names this test's binary.
    private bool args_hold():
        bool ok = true
        []string8 a = args(0, nil)
        ok = #expect(#len(a) >= 1, "args() found no program name on the command line") && ok
        if #len(a) >= 1:
            ok = #expect(strings.contains(a[0], "system_test"), "args()[0] is '", a[0], "', not this test") && ok
        // Made once: a second call answers the same arguments.
        []string8 again = args(0, nil)
        ok = #expect(#len(again) == #len(a), "a second args() call differs") && ok
        ok = #expect(from_system(i64(twin.ERROR_FILE_NOT_FOUND)) == Error.NOT_FOUND, "ERROR_FILE_NOT_FOUND is not NOT_FOUND") && ok
        ok = #expect(from_system(i64(twin.ERROR_PRIVILEGE_NOT_HELD)) == Error.PRIVILEGE, "ERROR_PRIVILEGE_NOT_HELD is not PRIVILEGE") && ok
        ok = #expect(from_system(i64(twin.ERROR_DIR_NOT_EMPTY)) == Error.NOT_EMPTY, "ERROR_DIR_NOT_EMPTY is not NOT_EMPTY") && ok
        ok = #expect(from_system(i64(twin.ERROR_SHARING_VIOLATION)) == Error.BUSY, "ERROR_SHARING_VIOLATION is not BUSY") && ok
        return ok
else when #OS == #WEB:
    private type Word: [16]char8
    private Word w0
    private type Slots: [1]rawptr
    private Slots slots

    // A module is handed no `argv`, and `args` reads what it is given: one
    // argument here, made once.
    private bool args_hold():
        bool ok = true
        w0[0] = 'p'
        w0[1] = '\0'
        slots[0] = rawptr(&w0[0])
        []string8 a = args(1, ^rawptr(&slots[0]))
        ok = #expect(#len(a) == 1 && a[0] == "p", "args() read ", #len(a), " arguments") && ok
        ok = #expect(from_system(2) == Error.UNKNOWN, "the web mapped a system number") && ok
        ok = #expect(last_error() == Error.UNKNOWN, "the web has a last error") && ok
        return ok

    // The environment and the process, as the web answers them: nothing set,
    // and every change refused as unsupported.
    private bool web_holds():
        bool ok = true
        ref []char8 v
        try v = get_env("PATH") else why:
            ok = #expect(why == Error.NOT_FOUND, "get_env on the web failed ", message(why)) && ok
            v = nil
        ok = #expect(v == nil, "the web found PATH") && ok
        #delete(v)
        try set_env("DADO_OS_TEST_VARIABLE_ZQX", "x") else why:
            ok = #expect(why == Error.UNSUPPORTED, "set_env failed with ", message(why)) && ok
        try set_env("A=B", "x") else why2:
            ok = #expect(why2 == Error.INVALID, "set_env(\"A=B\") failed with ", message(why2)) && ok
        try unset_env("DADO_OS_TEST_VARIABLE_ZQX") else why3:
            ok = #expect(why3 == Error.UNSUPPORTED, "unset_env failed with ", message(why3)) && ok
        ok = #expect(pid() == 0, "pid() is ", pid()) && ok
        ref []char8 t = temp_dir()
        ok = #expect(#len(t) == 0, "temp_dir() is not empty") && ok
        #delete(t)
        try ref []char8 h = home_dir() else why4:
            return #expect(why4 == Error.UNSUPPORTED, "home_dir() failed with ", message(why4)) && ok
        ok = #expect(false, "home_dir() answered on the web") && ok
        #delete(h)
        ok = #expect(!is_terminal(0) && !is_terminal(1) && !is_terminal(2), "the web has a terminal") && ok
        return ok
else:
    private foreign terr "errno.h":
        const i32 ENOENT
        const i32 EEXIST
        const i32 ENOTEMPTY
        const i32 EBUSY

    private type Word: [16]char8
    private Word w0
    private Word w1
    private Word w2
    private type Slots: [3]rawptr
    private Slots slots

    private void put(^Word w, string8 s):
        for i in 0..<#len(s):
            w^[i] = s[i]
        w^[#len(s)] = '\0'

    // A fake `argv`, with a UTF-8 argument, which `args` hands back as views.
    private bool args_hold():
        bool ok = true
        put(&w0, "prog")
        put(&w1, "été")
        put(&w2, "")
        slots[0] = rawptr(&w0[0])
        slots[1] = rawptr(&w1[0])
        slots[2] = rawptr(&w2[0])
        []string8 a = args(3, ^rawptr(&slots[0]))
        ok = #expect(#len(a) == 3, "args() has ", #len(a), " arguments, not 3") && ok
        if #len(a) == 3:
            ok = #expect(a[0] == "prog" && a[1] == "été" && a[2] == "", "args() read '", a[0], "' '", a[1], "' '", a[2], "'") && ok
        []string8 again = args(0, nil)
        ok = #expect(#len(again) == 3, "a second args() call differs") && ok
        ok = #expect(from_system(i64(terr.ENOENT)) == Error.NOT_FOUND, "ENOENT is not NOT_FOUND") && ok
        ok = #expect(from_system(i64(terr.EEXIST)) == Error.EXISTS, "EEXIST is not EXISTS") && ok
        ok = #expect(from_system(i64(terr.ENOTEMPTY)) == Error.NOT_EMPTY, "ENOTEMPTY is not NOT_EMPTY") && ok
        ok = #expect(from_system(i64(terr.EBUSY)) == Error.BUSY, "EBUSY is not BUSY") && ok
        return ok

i32 test():
    using libc.allocator():
        bool ok = codes_hold()
        when #OS == #WEB:
            ok = web_holds() && ok
        else:
            ok = env_holds() && ok
            ok = process_holds() && ok
        ok = args_hold() && ok
        if ok: return 0
        return 1
