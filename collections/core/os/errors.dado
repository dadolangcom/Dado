// The error code space: one set of named codes for everything the operating
// system can refuse, shared by `os`, `os/fs` and every package that calls the
// system for a program.
//
//     try ref []char8 text = fs.read_file("notes.txt") else code:
//         println("notes.txt: ", os.message(code))
//         return 1
//
// **A failable function in these packages fails with one of the codes below**,
// whichever system it runs on. Each arm translates its own system's number —
// `errno` on Linux and macOS, `GetLastError()` on Windows — into this space at
// the moment of failure, so a caller writes `code == os.NOT_FOUND` once and it
// means the same thing everywhere. A number the table does not know becomes
// `UNKNOWN` rather than leaking through, because a raw `errno` and a raw
// Windows error are both small integers and would collide with these.
//
// **The codes 1 to 99 are this package's.** A package with failures of its own
// that are not the system's (a parser's `MALFORMED`) numbers them from 1000 up
// and gives each a message of its own, so a code read from any of these
// packages never means two things.
//
// Every code has a sentence, `message(code)`, written for a person reading a
// tool's output and naming what to do where there is something to do.
//
// Thread-safety: everything here is a pure function of its argument except
// `last_error`, which reads the calling thread's own `errno` or last error and
// so is safe from any thread.
package os

// ── the codes ───────────────────────────────────────────────────────────────

// Nothing is at the path, or a directory on the way to it is missing.
const i32 NOT_FOUND = 1
// Something is already at the path, and the operation does not replace it.
const i32 EXISTS = 2
// The system refused: the caller may not read, write, enter or change this.
const i32 PERMISSION = 3
// A component of the path that has to be a directory is not one.
const i32 NOT_DIR = 4
// The path is a directory and the operation wanted a file.
const i32 IS_DIR = 5
// The directory has entries, and the operation needs it empty.
const i32 NOT_EMPTY = 6
// The argument is not one the operation can take: an empty name, a name with a
// byte the system refuses, a mode that makes no sense.
const i32 INVALID = 7
// The device failed to read or write.
const i32 IO = 8
// The disk, or the user's quota on it, is full.
const i32 NO_SPACE = 9
// Something else holds the file: it is in use, locked, or being executed.
const i32 BUSY = 10
// A rename between two filesystems, which moves nothing.
const i32 CROSS_DEVICE = 11
// The path, or one of its components, is longer than the system allows.
const i32 TOO_LONG = 12
// Symbolic links loop, or are nested deeper than the system will follow.
const i32 LOOP = 13
// The filesystem is mounted read-only.
const i32 READ_ONLY = 14
// The system, or this process, ran out of memory.
const i32 NO_MEMORY = 15
// The process, or the whole system, has too many files open.
const i32 TOO_MANY_OPEN = 16
// The operation needs a privilege the process does not hold. On Windows,
// creating a symbolic link is the common case.
const i32 PRIVILEGE = 17
// The system or the filesystem does not do this at all.
const i32 UNSUPPORTED = 18
// A signal interrupted the call before it finished.
const i32 INTERRUPTED = 19
// The system failed with a reason this table does not name.
const i32 UNKNOWN = 99

// A sentence for `code`, for a person: what went wrong and, where there is
// one, what to do. Never empty; a code this package does not own answers that
// it does not.
string8 message(i32 code):
    if code == NOT_FOUND: return "no such file or directory"
    if code == EXISTS: return "something already exists at that path"
    if code == PERMISSION: return "permission denied: check the file's owner and permissions"
    if code == NOT_DIR: return "a part of the path that should be a directory is not one"
    if code == IS_DIR: return "the path is a directory, and a file was wanted"
    if code == NOT_EMPTY: return "the directory is not empty"
    if code == INVALID: return "the system refused the argument as invalid (an empty or malformed name?)"
    if code == IO: return "the device reported an input/output error"
    if code == NO_SPACE: return "no space left on the device: free some space or raise the quota"
    if code == BUSY: return "the file is in use by another process: close it there and try again"
    if code == CROSS_DEVICE: return "the two paths are on different filesystems: copy, then remove the original"
    if code == TOO_LONG: return "the path, or a name in it, is longer than the system allows"
    if code == LOOP: return "too many levels of symbolic links: a link points back at itself"
    if code == READ_ONLY: return "the filesystem is read-only"
    if code == NO_MEMORY: return "out of memory"
    if code == TOO_MANY_OPEN: return "too many open files: close some, or raise the limit"
    if code == PRIVILEGE:
        when #OS == #WINDOWS:
            return "a privilege is missing: creating a symbolic link on Windows needs administrator rights or Developer Mode (Settings, For developers)"
        else:
            return "the operation needs a privilege this process does not hold"
    if code == UNSUPPORTED: return "the system or the filesystem does not support this operation"
    if code == INTERRUPTED: return "a signal interrupted the call: try it again"
    if code == UNKNOWN: return "the operating system failed for a reason this program does not recognise"
    return "not an os error code"

// ── reading the system's own number ─────────────────────────────────────────

// The calling thread's most recent system failure, as a code above. Read it
// straight after the call that failed: any later system call may overwrite it.
// `UNKNOWN` when the system holds no failure at all.
i32 last_error():
    return from_system(i64(system_error()))

when #OS == #WINDOWS:
    // Win32 error numbers, from `<winerror.h>` (which `<windows.h>` includes).
    // Each is written there as a `long` literal, which is why the type is
    // `#c.long`. `DWORD` is `unsigned long`, 32 bits on Windows.
    private foreign werr "windows.h" define "WIN32_LEAN_AND_MEAN=1":
        #c.ulong GetLastError()
        const #c.long ERROR_FILE_NOT_FOUND
        const #c.long ERROR_PATH_NOT_FOUND
        const #c.long ERROR_INVALID_DRIVE
        const #c.long ERROR_BAD_NETPATH
        const #c.long ERROR_BAD_PATHNAME
        const #c.long ERROR_ENVVAR_NOT_FOUND
        const #c.long ERROR_ACCESS_DENIED
        const #c.long ERROR_ALREADY_EXISTS
        const #c.long ERROR_FILE_EXISTS
        const #c.long ERROR_DIRECTORY
        const #c.long ERROR_DIR_NOT_EMPTY
        const #c.long ERROR_INVALID_NAME
        const #c.long ERROR_INVALID_PARAMETER
        const #c.long ERROR_INVALID_HANDLE
        const #c.long ERROR_CRC
        const #c.long ERROR_READ_FAULT
        const #c.long ERROR_WRITE_FAULT
        const #c.long ERROR_DISK_FULL
        const #c.long ERROR_HANDLE_DISK_FULL
        const #c.long ERROR_SHARING_VIOLATION
        const #c.long ERROR_LOCK_VIOLATION
        const #c.long ERROR_NOT_SAME_DEVICE
        const #c.long ERROR_FILENAME_EXCED_RANGE
        const #c.long ERROR_CANT_RESOLVE_FILENAME
        const #c.long ERROR_WRITE_PROTECT
        const #c.long ERROR_NOT_ENOUGH_MEMORY
        const #c.long ERROR_OUTOFMEMORY
        const #c.long ERROR_TOO_MANY_OPEN_FILES
        const #c.long ERROR_PRIVILEGE_NOT_HELD
        const #c.long ERROR_NOT_SUPPORTED
        const #c.long ERROR_CALL_NOT_IMPLEMENTED
        const #c.long ERROR_OPERATION_ABORTED

    private i64 system_error():
        return i64(werr.GetLastError())

    // A Win32 error number (what `GetLastError` answers) as a code above.
    i32 from_system(i64 raw):
        if raw == i64(werr.ERROR_FILE_NOT_FOUND) || raw == i64(werr.ERROR_PATH_NOT_FOUND) || raw == i64(werr.ERROR_INVALID_DRIVE) || raw == i64(werr.ERROR_BAD_NETPATH) || raw == i64(werr.ERROR_ENVVAR_NOT_FOUND):
            return NOT_FOUND
        if raw == i64(werr.ERROR_ALREADY_EXISTS) || raw == i64(werr.ERROR_FILE_EXISTS): return EXISTS
        if raw == i64(werr.ERROR_ACCESS_DENIED): return PERMISSION
        if raw == i64(werr.ERROR_DIRECTORY): return NOT_DIR
        if raw == i64(werr.ERROR_DIR_NOT_EMPTY): return NOT_EMPTY
        if raw == i64(werr.ERROR_INVALID_NAME) || raw == i64(werr.ERROR_INVALID_PARAMETER) || raw == i64(werr.ERROR_INVALID_HANDLE) || raw == i64(werr.ERROR_BAD_PATHNAME):
            return INVALID
        if raw == i64(werr.ERROR_CRC) || raw == i64(werr.ERROR_READ_FAULT) || raw == i64(werr.ERROR_WRITE_FAULT): return IO
        if raw == i64(werr.ERROR_DISK_FULL) || raw == i64(werr.ERROR_HANDLE_DISK_FULL): return NO_SPACE
        if raw == i64(werr.ERROR_SHARING_VIOLATION) || raw == i64(werr.ERROR_LOCK_VIOLATION): return BUSY
        if raw == i64(werr.ERROR_NOT_SAME_DEVICE): return CROSS_DEVICE
        if raw == i64(werr.ERROR_FILENAME_EXCED_RANGE): return TOO_LONG
        if raw == i64(werr.ERROR_CANT_RESOLVE_FILENAME): return LOOP
        if raw == i64(werr.ERROR_WRITE_PROTECT): return READ_ONLY
        if raw == i64(werr.ERROR_NOT_ENOUGH_MEMORY) || raw == i64(werr.ERROR_OUTOFMEMORY): return NO_MEMORY
        if raw == i64(werr.ERROR_TOO_MANY_OPEN_FILES): return TOO_MANY_OPEN
        if raw == i64(werr.ERROR_PRIVILEGE_NOT_HELD): return PRIVILEGE
        if raw == i64(werr.ERROR_NOT_SUPPORTED) || raw == i64(werr.ERROR_CALL_NOT_IMPLEMENTED): return UNSUPPORTED
        if raw == i64(werr.ERROR_OPERATION_ABORTED): return INTERRUPTED
        return UNKNOWN
else:
    // `errno` is a macro expanding to the calling thread's own lvalue, and a
    // foreign constant is read at its use, so this reads that thread's value.
    // The names are `<errno.h>`'s and the numbers are the platform's: Linux and
    // Darwin number them differently, which is why none is written here.
    private foreign perr "errno.h":
        const i32 errno
        const i32 ENOENT
        const i32 EEXIST
        const i32 EACCES
        const i32 EPERM
        const i32 ENOTDIR
        const i32 EISDIR
        const i32 ENOTEMPTY
        const i32 EINVAL
        const i32 EBADF
        const i32 EIO
        const i32 ENOSPC
        const i32 EDQUOT
        const i32 EBUSY
        const i32 ETXTBSY
        const i32 EXDEV
        const i32 ENAMETOOLONG
        const i32 ELOOP
        const i32 EROFS
        const i32 ENOMEM
        const i32 EMFILE
        const i32 ENFILE
        const i32 ENOSYS
        const i32 ENOTSUP
        const i32 EOPNOTSUPP
        const i32 EINTR

    private i64 system_error():
        return i64(perr.errno)

    // An `errno` value as a code above.
    i32 from_system(i64 raw):
        i32 e = i32(raw)
        if e == perr.ENOENT: return NOT_FOUND
        if e == perr.EEXIST: return EXISTS
        if e == perr.EACCES || e == perr.EPERM: return PERMISSION
        if e == perr.ENOTDIR: return NOT_DIR
        if e == perr.EISDIR: return IS_DIR
        if e == perr.ENOTEMPTY: return NOT_EMPTY
        if e == perr.EINVAL || e == perr.EBADF: return INVALID
        if e == perr.EIO: return IO
        if e == perr.ENOSPC || e == perr.EDQUOT: return NO_SPACE
        if e == perr.EBUSY || e == perr.ETXTBSY: return BUSY
        if e == perr.EXDEV: return CROSS_DEVICE
        if e == perr.ENAMETOOLONG: return TOO_LONG
        if e == perr.ELOOP: return LOOP
        if e == perr.EROFS: return READ_ONLY
        if e == perr.ENOMEM: return NO_MEMORY
        if e == perr.EMFILE || e == perr.ENFILE: return TOO_MANY_OPEN
        if e == perr.ENOSYS || e == perr.ENOTSUP || e == perr.EOPNOTSUPP: return UNSUPPORTED
        if e == perr.EINTR: return INTERRUPTED
        return UNKNOWN
