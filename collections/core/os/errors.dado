// The error code space: one set of named codes for everything the operating
// system can refuse, shared by `os`, `os/fs`, `os/proc` and `io`.
//
//     try ref []char8 text = fs.read_file("notes.txt") else why:
//         println("notes.txt: ", os.message(why))
//         return 1
//
// **A failable function in these packages is `os.Error!T`**, whichever system
// it runs on, so a caller's `switch` over the bound `why` names members and
// needs no `else`. Each arm translates its own system's number — `errno` on
// Linux and macOS, `GetLastError()` on Windows — into this space at the moment
// of failure (`from_system`), so `why == os.Error.NOT_FOUND` means the same
// thing everywhere. A number the table does not know becomes `UNKNOWN` rather
// than leaking through, because a raw `errno` and a raw Windows error are both
// small integers and would collide with these.
//
// **The codes 1 to 99 are this package's.** A package with failures of its
// own that are not the system's has its own enum in its own range (`path`
// is 2200 to 2299, `os/proc`'s pipe 2100 to 2199), so a code read from any
// package never means two things.
//
// Every code has a sentence, `message(why)`, written for a person reading a
// tool's output and naming what to do where there is something to do.
//
// **On `#WEB` and `#NONE`** there is no system number to read: `last_error`
// answers `UNKNOWN`, and the functions that cannot run there fail with
// `UNSUPPORTED` directly rather than through a number. This file is the one
// part of `core:os` a `#NONE` build declares, because `core:io` fails with
// these codes and builds freestanding.
//
// **What raises into a script.** `message` is promised (`#assert_raises`): it
// is a table of sentences. `last_error` and `from_system` are not, because
// they read the system's `errno` or `GetLastError()` and its numbers through
// `foreign` declarations.
//
// Thread-safety: everything here is a pure function of its argument except
// `last_error`, which reads the calling thread's own `errno` or last error and
// so is safe from any thread.
package os

// ── the codes ───────────────────────────────────────────────────────────────

// Why the system refused, in the numbers 1 to 99, the same on every system.
distinct enum i32 Error:
    // Nothing is at the path, or a directory on the way to it is missing; an
    // environment variable that is not set.
    NOT_FOUND = 1,
    // Something is already at the path, and the operation does not replace it.
    EXISTS = 2,
    // The system refused: the caller may not read, write, enter or change this.
    PERMISSION = 3,
    // A component of the path that has to be a directory is not one.
    NOT_DIR = 4,
    // The path is a directory and the operation wanted a file.
    IS_DIR = 5,
    // The directory has entries, and the operation needs it empty.
    NOT_EMPTY = 6,
    // The argument is not one the operation can take: an empty name, a name
    // with a byte the system refuses, a mode that makes no sense.
    INVALID = 7,
    // The device failed to read or write, or a reader or a sink failed.
    IO = 8,
    // The disk, or the user's quota on it, is full.
    NO_SPACE = 9,
    // Something else holds the file: it is in use, locked, or being executed.
    BUSY = 10,
    // A rename between two filesystems, which moves nothing.
    CROSS_DEVICE = 11,
    // The path, or one of its components, is longer than the system allows.
    TOO_LONG = 12,
    // Symbolic links loop, or are nested deeper than the system will follow.
    LOOP = 13,
    // The filesystem is mounted read-only.
    READ_ONLY = 14,
    // The system, or this process, ran out of memory.
    NO_MEMORY = 15,
    // The process, or the whole system, has too many files open.
    TOO_MANY_OPEN = 16,
    // The operation needs a privilege the process does not hold. On Windows,
    // creating a symbolic link is the common case.
    PRIVILEGE = 17,
    // The system or the filesystem does not do this at all, or this target
    // has no system to ask (`#WEB`).
    UNSUPPORTED = 18,
    // A signal interrupted the call before it finished.
    INTERRUPTED = 19,
    // The input ended: a stream read at its end (`io.read_line`).
    END = 20,
    // The system failed with a reason this table does not name.
    UNKNOWN = 99,

// A sentence for `why`, for a person: what went wrong and, where there is
// one, what to do. Never empty.
#assert_raises
string8 message(Error why):
    if why == Error.NOT_FOUND: return "no such file or directory"
    if why == Error.EXISTS: return "something already exists at that path"
    if why == Error.PERMISSION: return "permission denied: check the file's owner and permissions"
    if why == Error.NOT_DIR: return "a part of the path that should be a directory is not one"
    if why == Error.IS_DIR: return "the path is a directory, and a file was wanted"
    if why == Error.NOT_EMPTY: return "the directory is not empty"
    if why == Error.INVALID: return "the system refused the argument as invalid (an empty or malformed name?)"
    if why == Error.IO: return "the device reported an input/output error"
    if why == Error.NO_SPACE: return "no space left on the device: free some space or raise the quota"
    if why == Error.BUSY: return "the file is in use by another process: close it there and try again"
    if why == Error.CROSS_DEVICE: return "the two paths are on different filesystems: copy, then remove the original"
    if why == Error.TOO_LONG: return "the path, or a name in it, is longer than the system allows"
    if why == Error.LOOP: return "too many levels of symbolic links: a link points back at itself"
    if why == Error.READ_ONLY: return "the filesystem is read-only"
    if why == Error.NO_MEMORY: return "out of memory"
    if why == Error.TOO_MANY_OPEN: return "too many open files: close some, or raise the limit"
    if why == Error.PRIVILEGE:
        when #OS == #WINDOWS:
            return "a privilege is missing: creating a symbolic link on Windows needs administrator rights or Developer Mode (Settings, For developers)"
        else:
            return "the operation needs a privilege this process does not hold"
    if why == Error.UNSUPPORTED: return "the system or the filesystem does not support this operation"
    if why == Error.INTERRUPTED: return "a signal interrupted the call: try it again"
    if why == Error.END: return "the input ended: there is nothing more to read"
    if why == Error.UNKNOWN: return "the operating system failed for a reason this program does not recognise"
    return "not an os error code"

// ── failing with a code held as a value ─────────────────────────────────────

// Fail with `why`. **It always fails**: a caller writes `try os.fail_with(why)`
// where it holds the code in a variable. `fail why` is refused there, because
// an `Error` value need not be a member (the backing is an `i32`), and an
// `Error!` function fails only with members; this names each one. A value
// that is no member fails `UNKNOWN`.
#assert_raises
Error!void fail_with(Error why):
    if why == Error.NOT_FOUND: fail Error.NOT_FOUND
    if why == Error.EXISTS: fail Error.EXISTS
    if why == Error.PERMISSION: fail Error.PERMISSION
    if why == Error.NOT_DIR: fail Error.NOT_DIR
    if why == Error.IS_DIR: fail Error.IS_DIR
    if why == Error.NOT_EMPTY: fail Error.NOT_EMPTY
    if why == Error.INVALID: fail Error.INVALID
    if why == Error.IO: fail Error.IO
    if why == Error.NO_SPACE: fail Error.NO_SPACE
    if why == Error.BUSY: fail Error.BUSY
    if why == Error.CROSS_DEVICE: fail Error.CROSS_DEVICE
    if why == Error.TOO_LONG: fail Error.TOO_LONG
    if why == Error.LOOP: fail Error.LOOP
    if why == Error.READ_ONLY: fail Error.READ_ONLY
    if why == Error.NO_MEMORY: fail Error.NO_MEMORY
    if why == Error.TOO_MANY_OPEN: fail Error.TOO_MANY_OPEN
    if why == Error.PRIVILEGE: fail Error.PRIVILEGE
    if why == Error.UNSUPPORTED: fail Error.UNSUPPORTED
    if why == Error.INTERRUPTED: fail Error.INTERRUPTED
    if why == Error.END: fail Error.END
    fail Error.UNKNOWN

// Fail with the calling thread's most recent system failure, `last_error()`.
// It always fails, as `fail_with` does; call it straight after the call that
// failed, before anything else can overwrite the system's record.
Error!void fail_last():
    try fail_with(last_error())

// ── reading the system's own number ─────────────────────────────────────────

// The calling thread's most recent system failure, as a code above. Read it
// straight after the call that failed: any later system call may overwrite it.
// `UNKNOWN` when the system holds no failure at all.
Error last_error():
    return from_system(i64(system_error()))

when #OS == #WINDOWS:
    // Win32 error numbers, from `<winerror.h>` (which `<windows.h>` includes).
    // Each is written there as a `long` literal, which is why the type is
    // `#c.long`. `DWORD` is `unsigned long`, 32 bits on Windows.
    private foreign werr "windows.h" define "WIN32_LEAN_AND_MEAN=1":
        #c.ulong GetLastError()
        const #c.long ERROR_FILE_NOT_FOUND
        const #c.long ERROR_PATH_NOT_FOUND
        const #c.long ERROR_INVALID_DRIVE
        const #c.long ERROR_BAD_NETPATH
        const #c.long ERROR_BAD_PATHNAME
        const #c.long ERROR_ENVVAR_NOT_FOUND
        const #c.long ERROR_ACCESS_DENIED
        const #c.long ERROR_ALREADY_EXISTS
        const #c.long ERROR_FILE_EXISTS
        const #c.long ERROR_DIRECTORY
        const #c.long ERROR_DIR_NOT_EMPTY
        const #c.long ERROR_INVALID_NAME
        const #c.long ERROR_INVALID_PARAMETER
        const #c.long ERROR_INVALID_HANDLE
        const #c.long ERROR_NEGATIVE_SEEK
        const #c.long ERROR_CRC
        const #c.long ERROR_READ_FAULT
        const #c.long ERROR_WRITE_FAULT
        const #c.long ERROR_DISK_FULL
        const #c.long ERROR_HANDLE_DISK_FULL
        const #c.long ERROR_SHARING_VIOLATION
        const #c.long ERROR_LOCK_VIOLATION
        const #c.long ERROR_NOT_SAME_DEVICE
        const #c.long ERROR_FILENAME_EXCED_RANGE
        const #c.long ERROR_CANT_RESOLVE_FILENAME
        const #c.long ERROR_WRITE_PROTECT
        const #c.long ERROR_NOT_ENOUGH_MEMORY
        const #c.long ERROR_OUTOFMEMORY
        const #c.long ERROR_TOO_MANY_OPEN_FILES
        const #c.long ERROR_PRIVILEGE_NOT_HELD
        const #c.long ERROR_NOT_SUPPORTED
        const #c.long ERROR_CALL_NOT_IMPLEMENTED
        const #c.long ERROR_OPERATION_ABORTED

    private i64 system_error():
        return i64(werr.GetLastError())

    // A system's own error number as a code above: on Windows a Win32 error
    // (what `GetLastError` answers), on POSIX an `errno` value. A number the
    // table does not know is `UNKNOWN`.
    Error from_system(i64 raw):
        if raw == i64(werr.ERROR_FILE_NOT_FOUND) || raw == i64(werr.ERROR_PATH_NOT_FOUND) || raw == i64(werr.ERROR_INVALID_DRIVE) || raw == i64(werr.ERROR_BAD_NETPATH) || raw == i64(werr.ERROR_ENVVAR_NOT_FOUND):
            return Error.NOT_FOUND
        if raw == i64(werr.ERROR_ALREADY_EXISTS) || raw == i64(werr.ERROR_FILE_EXISTS): return Error.EXISTS
        if raw == i64(werr.ERROR_ACCESS_DENIED): return Error.PERMISSION
        if raw == i64(werr.ERROR_DIRECTORY): return Error.NOT_DIR
        if raw == i64(werr.ERROR_DIR_NOT_EMPTY): return Error.NOT_EMPTY
        if raw == i64(werr.ERROR_INVALID_NAME) || raw == i64(werr.ERROR_INVALID_PARAMETER) || raw == i64(werr.ERROR_INVALID_HANDLE) || raw == i64(werr.ERROR_BAD_PATHNAME) || raw == i64(werr.ERROR_NEGATIVE_SEEK):
            return Error.INVALID
        if raw == i64(werr.ERROR_CRC) || raw == i64(werr.ERROR_READ_FAULT) || raw == i64(werr.ERROR_WRITE_FAULT): return Error.IO
        if raw == i64(werr.ERROR_DISK_FULL) || raw == i64(werr.ERROR_HANDLE_DISK_FULL): return Error.NO_SPACE
        if raw == i64(werr.ERROR_SHARING_VIOLATION) || raw == i64(werr.ERROR_LOCK_VIOLATION): return Error.BUSY
        if raw == i64(werr.ERROR_NOT_SAME_DEVICE): return Error.CROSS_DEVICE
        if raw == i64(werr.ERROR_FILENAME_EXCED_RANGE): return Error.TOO_LONG
        if raw == i64(werr.ERROR_CANT_RESOLVE_FILENAME): return Error.LOOP
        if raw == i64(werr.ERROR_WRITE_PROTECT): return Error.READ_ONLY
        if raw == i64(werr.ERROR_NOT_ENOUGH_MEMORY) || raw == i64(werr.ERROR_OUTOFMEMORY): return Error.NO_MEMORY
        if raw == i64(werr.ERROR_TOO_MANY_OPEN_FILES): return Error.TOO_MANY_OPEN
        if raw == i64(werr.ERROR_PRIVILEGE_NOT_HELD): return Error.PRIVILEGE
        if raw == i64(werr.ERROR_NOT_SUPPORTED) || raw == i64(werr.ERROR_CALL_NOT_IMPLEMENTED): return Error.UNSUPPORTED
        if raw == i64(werr.ERROR_OPERATION_ABORTED): return Error.INTERRUPTED
        return Error.UNKNOWN
// `#WEB` and `#NONE` have no `errno` and no system to have failed: nothing is
// recorded, so every number is `UNKNOWN`.
else when #OS == #WEB || #OS == #NONE:
    private i64 system_error():
        return 0

    // A system number as a code above; on `#WEB` and `#NONE` there are none,
    // so always `UNKNOWN`.
    Error from_system(i64 raw):
        return Error.UNKNOWN

// Linux, macOS and the BSDs.
else:
    // `errno` is a macro expanding to the calling thread's own lvalue, and a
    // foreign constant is read at its use, so this reads that thread's value.
    // The names are `<errno.h>`'s and the numbers are the platform's: Linux and
    // Darwin number them differently, which is why none is written here.
    private foreign perr "errno.h":
        const i32 errno
        const i32 ENOENT
        const i32 EEXIST
        const i32 EACCES
        const i32 EPERM
        const i32 ENOTDIR
        const i32 EISDIR
        const i32 ENOTEMPTY
        const i32 EINVAL
        const i32 EBADF
        const i32 EIO
        const i32 ENOSPC
        const i32 EDQUOT
        const i32 EBUSY
        const i32 ETXTBSY
        const i32 EXDEV
        const i32 ENAMETOOLONG
        const i32 ELOOP
        const i32 EROFS
        const i32 ENOMEM
        const i32 EMFILE
        const i32 ENFILE
        const i32 ENOSYS
        const i32 ENOTSUP
        const i32 EOPNOTSUPP
        const i32 EINTR

    private i64 system_error():
        return i64(perr.errno)

    // An `errno` value as a code above.
    Error from_system(i64 raw):
        i32 e = i32(raw)
        if e == perr.ENOENT: return Error.NOT_FOUND
        if e == perr.EEXIST: return Error.EXISTS
        if e == perr.EACCES || e == perr.EPERM: return Error.PERMISSION
        if e == perr.ENOTDIR: return Error.NOT_DIR
        if e == perr.EISDIR: return Error.IS_DIR
        if e == perr.ENOTEMPTY: return Error.NOT_EMPTY
        if e == perr.EINVAL || e == perr.EBADF: return Error.INVALID
        if e == perr.EIO: return Error.IO
        if e == perr.ENOSPC || e == perr.EDQUOT: return Error.NO_SPACE
        if e == perr.EBUSY || e == perr.ETXTBSY: return Error.BUSY
        if e == perr.EXDEV: return Error.CROSS_DEVICE
        if e == perr.ENAMETOOLONG: return Error.TOO_LONG
        if e == perr.ELOOP: return Error.LOOP
        if e == perr.EROFS: return Error.READ_ONLY
        if e == perr.ENOMEM: return Error.NO_MEMORY
        if e == perr.EMFILE || e == perr.ENFILE: return Error.TOO_MANY_OPEN
        if e == perr.ENOSYS || e == perr.ENOTSUP || e == perr.EOPNOTSUPP: return Error.UNSUPPORTED
        if e == perr.EINTR: return Error.INTERRUPTED
        return Error.UNKNOWN
