// What every Windows arm of this package shares: the Win32 declarations, the
// conversion between Dado's UTF-8 paths and Windows' UTF-16 ones, and the two
// ways of asking what a path is.
//
// **Paths are UTF-8 in Dado and UTF-16 at the call.** Each `W` function is
// handed the path converted by `MultiByteToWideChar(CP_UTF8, …)`, and each name
// Windows hands back is converted by `WideCharToMultiByte`. Both separators
// work: Win32 reads `/` as `\` everywhere except behind the `\\?\` prefix.
//
// **Long paths.** A path longer than `MAX_PATH` (260 units, and 248 for a
// directory being made) is refused by the plain forms. When such a path is
// absolute, it is made full by `GetFullPathNameW` — which resolves `.`, `..`
// and `/`, none of which the prefix allows — and given the `\\?\` prefix
// (`\\?\UNC\` for a `\\server\share` path), which lifts the limit to 32,767
// units. A relative path that long is passed as written and fails as Windows
// fails it.
//
// The declarations are unbound, so every file of the package reaches them, and
// each Win32 struct is declared under a name of this package's (`FsFindData`
// for `WIN32_FIND_DATAW`, and so on) through a `define`: a C type has one Dado
// name across a whole program, and another package declaring the same struct
// under the header's name must not collide with this one. A `FILETIME` member
// is a member list for the same reason: `core:time` declares `FILETIME`.
//
// `DWORD` is `unsigned long` (32 bits on Windows), `BOOL` is `int`, `BOOLEAN`
// is `unsigned char`, a `HANDLE` is a `void *`, and a `WCHAR` is a 16-bit
// `wchar_t`, which is `unsigned short` in C and `u16` here.
package fs

import "core:os"
import "core:strings"

when #OS == #WINDOWS:
    private foreign "windows.h" define "WIN32_LEAN_AND_MEAN=1" define "FsFindData=WIN32_FIND_DATAW" define "FsHandleInfo=BY_HANDLE_FILE_INFORMATION" define "FsSecurity=SECURITY_ATTRIBUTES" define "FsOverlapped=OVERLAPPED":
        type FsFindData: (#c.ulong dwFileAttributes,
                          (#c.ulong dwLowDateTime, #c.ulong dwHighDateTime) ftCreationTime,
                          (#c.ulong dwLowDateTime, #c.ulong dwHighDateTime) ftLastAccessTime,
                          (#c.ulong dwLowDateTime, #c.ulong dwHighDateTime) ftLastWriteTime,
                          #c.ulong nFileSizeHigh, #c.ulong nFileSizeLow,
                          #c.ulong dwReserved0, #c.ulong dwReserved1,
                          [260]u16 cFileName, [14]u16 cAlternateFileName)
        type FsHandleInfo: (#c.ulong dwFileAttributes,
                            (#c.ulong dwLowDateTime, #c.ulong dwHighDateTime) ftCreationTime,
                            (#c.ulong dwLowDateTime, #c.ulong dwHighDateTime) ftLastAccessTime,
                            (#c.ulong dwLowDateTime, #c.ulong dwHighDateTime) ftLastWriteTime,
                            #c.ulong dwVolumeSerialNumber,
                            #c.ulong nFileSizeHigh, #c.ulong nFileSizeLow,
                            #c.ulong nNumberOfLinks,
                            #c.ulong nFileIndexHigh, #c.ulong nFileIndexLow)
        type FsSecurity: (#c.ulong nLength, rawptr lpSecurityDescriptor, #c.int bInheritHandle)
        type FsOverlapped

        const #c.uint CP_UTF8
        const #c.ulong GENERIC_READ
        const #c.ulong GENERIC_WRITE
        const #c.ulong FILE_READ_ATTRIBUTES
        const #c.ulong FILE_SHARE_READ
        const #c.ulong FILE_SHARE_WRITE
        const #c.ulong FILE_SHARE_DELETE
        const #c.ulong OPEN_EXISTING
        const #c.ulong CREATE_NEW
        const #c.ulong FILE_ATTRIBUTE_NORMAL
        const #c.ulong FILE_ATTRIBUTE_DIRECTORY
        const #c.ulong FILE_ATTRIBUTE_READONLY
        const #c.ulong FILE_ATTRIBUTE_REPARSE_POINT
        const #c.ulong FILE_FLAG_BACKUP_SEMANTICS
        const #c.ulong FILE_FLAG_OPEN_REPARSE_POINT
        const #c.ulong INVALID_FILE_ATTRIBUTES
        const rawptr INVALID_HANDLE_VALUE
        const #c.ulong MOVEFILE_REPLACE_EXISTING
        const #c.ulong MOVEFILE_WRITE_THROUGH
        const #c.ulong SYMBOLIC_LINK_FLAG_DIRECTORY
        const #c.ulong SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE
        const #c.ulong IO_REPARSE_TAG_SYMLINK
        const #c.ulong IO_REPARSE_TAG_MOUNT_POINT
        const #c.ulong VOLUME_NAME_DOS
        const #c.ulong HEAP_ZERO_MEMORY
        const #c.long ERROR_FILE_NOT_FOUND
        const #c.long ERROR_PATH_NOT_FOUND
        const #c.long ERROR_NO_MORE_FILES
        const #c.long ERROR_ACCESS_DENIED
        const #c.long ERROR_INVALID_PARAMETER
        const #c.long ERROR_ALREADY_EXISTS
        const #c.long ERROR_FILE_EXISTS

        #c.int MultiByteToWideChar(#c.uint code_page, #c.ulong flags, cstring from, #c.int from_count, ^u16 into, #c.int into_count)
        #c.int WideCharToMultiByte(#c.uint code_page, #c.ulong flags, ^const u16 from, #c.int from_count, ^#c.char into, #c.int into_count, cstring default_char, ^#c.int used_default)
        #c.ulong GetLastError()
        void SetLastError(#c.ulong code)

        rawptr FindFirstFileW(^const u16 pattern, ^FsFindData found)
        #c.int FindNextFileW(rawptr search, ^FsFindData found)
        #c.int FindClose(rawptr search)
        #c.ulong GetFileAttributesW(^const u16 path)
        #c.int SetFileAttributesW(^const u16 path, #c.ulong attributes)
        rawptr CreateFileW(^const u16 path, #c.ulong access, #c.ulong share, ^FsSecurity security, #c.ulong disposition, #c.ulong flags, rawptr template_file)
        #c.int GetFileInformationByHandle(rawptr file, ^FsHandleInfo info)
        #c.int CloseHandle(rawptr handle)
        #c.int ReadFile(rawptr file, rawptr into, #c.ulong count, ^#c.ulong got, ^FsOverlapped overlapped)
        #c.int WriteFile(rawptr file, const rawptr from, #c.ulong count, ^#c.ulong wrote, ^FsOverlapped overlapped)
        #c.int FlushFileBuffers(rawptr file)
        #c.int DeviceIoControl(rawptr device, #c.ulong code, rawptr in_buffer, #c.ulong in_size, rawptr out_buffer, #c.ulong out_size, ^#c.ulong returned, ^FsOverlapped overlapped)
        #c.ulong GetFullPathNameW(^const u16 path, #c.ulong size, ^u16 into, ^^u16 file_part)
        #c.ulong GetFinalPathNameByHandleW(rawptr file, ^u16 into, #c.ulong size, #c.ulong flags)
        #c.ulong GetCurrentDirectoryW(#c.ulong size, ^u16 into)
        #c.int SetCurrentDirectoryW(^const u16 path)
        #c.int CreateDirectoryW(^const u16 path, ^FsSecurity security)
        #c.int RemoveDirectoryW(^const u16 path)
        #c.int DeleteFileW(^const u16 path)
        #c.int MoveFileExW(^const u16 from, ^const u16 to, #c.ulong flags)
        #c.int CopyFileW(^const u16 from, ^const u16 to, #c.int fail_if_exists)
        #c.uchar CreateSymbolicLinkW(^const u16 link, ^const u16 target, #c.ulong flags)
        rawptr GetProcessHeap()
        rawptr HeapAlloc(rawptr heap, #c.ulong flags, #c.size_t bytes)
        #c.int HeapFree(rawptr heap, #c.ulong flags, rawptr block)
        rawptr LocalFree(rawptr block)
        #c.ullong GetTickCount64()
        #c.ulong GetCurrentProcessId()

    // `ConvertStringSecurityDescriptorToSecurityDescriptorW` is `<sddl.h>`'s and
    // lives in `advapi32`. `SDDL_REVISION_1` is 1.
    private foreign "sddl.h" link "-ladvapi32":
        const #c.int SDDL_REVISION_1
        #c.int ConvertStringSecurityDescriptorToSecurityDescriptorW(^const u16 sddl, #c.ulong revision, ^rawptr descriptor, ^#c.ulong size)

    private foreign "wchar.h":
        #c.size_t wcslen(^const u16 s)

    // `FSCTL_GET_REPARSE_POINT` is `<winioctl.h>`'s, which `WIN32_LEAN_AND_MEAN`
    // leaves out; its value is the documented control code `CTL_CODE(
    // FILE_DEVICE_FILE_SYSTEM, 42, METHOD_BUFFERED, FILE_ANY_ACCESS)`. The
    // largest reparse buffer Windows hands back is 16 KiB.
    private const #c.ulong FSCTL_GET_REPARSE_POINT = 0x000900A8
    private const i64 REPARSE_BUFFER = 16384

    // A byte buffer handed to C as the `char *` the header declares.
    private type WCharBuf: ^#c.char

    // The length past which a plain path is refused: 260 units with the
    // terminator, and 248 for `CreateDirectoryW`, which keeps room for an 8.3
    // name inside. The smaller one decides, so every call agrees.
    private const i64 SHORT_PATH = 247

    // ── UTF-8 and UTF-16 ────────────────────────────────────────────────────

    // `text` as UTF-16 with its terminator. Empty when it could not be
    // converted, which every caller treats as the call failing.
    private ref []u16 widen(string8 text):
        i64 n = #len(text)
        if n == 0:
            ref []u16 nothing = #make([]u16, 1)
            nothing[0] = 0
            return nothing
        ref []char8 bytes = c_path(text)
        defer #delete(bytes)
        #c.int units = MultiByteToWideChar(CP_UTF8, 0, cstring(bytes), #c.int(n), nil, 0)
        if units <= 0: return #make([]u16, 0)
        ref []u16 wide = #make([]u16, i64(units) + 1)
        #c.int wrote = MultiByteToWideChar(CP_UTF8, 0, cstring(bytes), #c.int(n), &wide[0], units)
        if wrote != units:
            #delete(wide)
            return #make([]u16, 0)
        wide[i64(units)] = 0
        return wide

    // `count` UTF-16 units at `wide`, as UTF-8 with no terminator.
    private ref []char8 narrow(^u16 wide, i64 count):
        if wide == nil || count <= 0: return #make([]char8, 0)
        #c.int bytes = WideCharToMultiByte(CP_UTF8, 0, wide, #c.int(count), nil, 0, nil, nil)
        if bytes <= 0: return #make([]char8, 0)
        ref []char8 out = #make([]char8, i64(bytes))
        _ = WideCharToMultiByte(CP_UTF8, 0, wide, #c.int(count), WCharBuf(rawptr(&out[0])), bytes, nil, nil)
        return out

    // Whether `path` names a place from a root: `C:\…`, `C:/…`, or
    // `\\server\share`.
    private bool absolute(string8 path):
        i64 n = #len(path)
        if n >= 3 && path[1] == ':' && (path[2] == '\\' || path[2] == '/'):
            return true
        return n >= 2 && (path[0] == '\\' || path[0] == '/') && (path[1] == '\\' || path[1] == '/')

    // `path` as UTF-16 for a `W` call, with the `\\?\` prefix when it is
    // absolute and too long for the plain forms. Empty when it cannot be
    // converted.
    private ref []u16 wide_path(string8 path):
        ref []u16 wide = widen(path)
        if #len(wide) == 0 || #len(path) <= SHORT_PATH || !absolute(path):
            return wide
        // Made full first: the prefix turns off every normalisation, so `.`,
        // `..` and `/` have to be gone before it is added.
        #c.ulong need = GetFullPathNameW(&wide[0], 0, nil, nil)
        if need == 0: return wide
        ref []u16 full = #make([]u16, i64(need) + 8)
        // Room for `\\?\UNC\` in front: eight units.
        #c.ulong got = GetFullPathNameW(&wide[0], need, &full[8], nil)
        if got == 0 || got >= need:
            #delete(full)
            return wide
        #delete(wide)
        i64 start = 4
        if full[8] == 0x5C && full[9] == 0x5C:
            // `\\server\share\…` becomes `\\?\UNC\server\share\…`: the
            // `\\` of the original is dropped and `UNC` takes its place.
            start = 2
            full[2] = 0x5C
            full[3] = 0x5C
            full[4] = 0x3F
            full[5] = 0x5C
            full[6] = 0x55
            full[7] = 0x4E
            full[8] = 0x43
            // full[9] is already `\`.
        else:
            full[4] = 0x5C
            full[5] = 0x5C
            full[6] = 0x3F
            full[7] = 0x5C
        ref []u16 prefixed = #make([]u16, i64(got) + 8 - start + 1)
        i64 k = 0
        for k < #len(prefixed) - 1:
            prefixed[k] = full[start + k]
            k += 1
        prefixed[#len(prefixed) - 1] = 0
        #delete(full)
        return prefixed

    // A `cstring` path as a `string8`, or the empty string for `nil`, which
    // every caller has already refused.
    private string8 text_of(cstring path):
        if path == nil: return ""
        return string8(path)

    // ── asking what a path is ───────────────────────────────────────────────

    // What `path` resolves to, following links: a handle opened for nothing
    // but its attributes, and `FILE_FLAG_BACKUP_SEMANTICS`, which is what lets
    // `CreateFileW` open a directory. A dangling link fails here, as POSIX's
    // `stat` does.
    private (FsHandleInfo info, bool ok) info_follow(string8 path):
        FsHandleInfo info
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(w) == 0: return (info, false)
        rawptr h = CreateFileW(&w[0], FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nil, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nil)
        if h == INVALID_HANDLE_VALUE: return (info, false)
        bool got = GetFileInformationByHandle(h, &info) != 0
        _ = CloseHandle(h)
        return (info, got)

    // The attributes of `path` itself — a link's own, not its target's.
    private (u32 attributes, bool ok) attributes_of(string8 path):
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(w) == 0: return (0, false)
        #c.ulong a = GetFileAttributesW(&w[0])
        if a == INVALID_FILE_ATTRIBUTES: return (0, false)
        return (u32(a), true)

    // Whether `path` is itself a link: a reparse point whose tag is a symbolic
    // link or a junction (`mklink /J`), the two Windows follows as a link. The
    // tag is `dwReserved0` of the entry `FindFirstFileW` finds for the path.
    private bool link_at(string8 path):
        (u32 a, bool got) = attributes_of(path)
        if !got || (a & u32(FILE_ATTRIBUTE_REPARSE_POINT)) == 0: return false
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(w) == 0: return false
        FsFindData found
        rawptr h = FindFirstFileW(&w[0], &found)
        if h == INVALID_HANDLE_VALUE: return false
        _ = FindClose(h)
        return found.dwReserved0 == IO_REPARSE_TAG_SYMLINK || found.dwReserved0 == IO_REPARSE_TAG_MOUNT_POINT

    // A `FILETIME` — 100 ns intervals since 1601-01-01 UTC — as nanoseconds
    // since the Unix epoch. The epochs are 11,644,473,600 seconds apart.
    private i64 unix_nanos_of(#c.ulong low, #c.ulong high):
        i64 intervals = i64(high) * 4294967296 + i64(low)
        return (intervals - 116444736000000000) * 100

    // The last error, as `os`'s code.
    private i32 failure():
        return os.last_error()

    // ── private directories ─────────────────────────────────────────────────

    // A directory only its owner and the system can open: a protected DACL
    // (`P`, so nothing is inherited from the parent) with full access for the
    // owner (`OW`) and for `SYSTEM` (`SY`), on the directory and everything
    // later made in it (`OICI`). The descriptor is the system's, and freed.
    private !void create_private(string8 path):
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(w) == 0: fail os.INVALID
        ref []u16 sddl = widen("D:P(A;OICI;FA;;;OW)(A;OICI;FA;;;SY)")
        defer #delete(sddl)
        rawptr descriptor = nil
        if ConvertStringSecurityDescriptorToSecurityDescriptorW(&sddl[0], #c.ulong(SDDL_REVISION_1), &descriptor, nil) == 0:
            fail failure()
        FsSecurity sa = (#c.ulong(#size(FsSecurity)), descriptor, 0)
        bool made = CreateDirectoryW(&w[0], &sa) != 0
        i32 code = 0
        if !made: code = failure()
        _ = LocalFree(descriptor)
        if !made: fail code
        return

    // A name nobody else is likely to pick: the process, a tick count and a
    // counter, mixed. Collisions are still possible and the caller retries.
    private u64 g_temp_counter
    private u64 temp_noise():
        g_temp_counter += 1
        u64 x = u64(GetTickCount64()) * MIX_A + u64(GetCurrentProcessId()) * MIX_B + g_temp_counter * MIX_C
        x = x ~ (x >> 31)
        return x

    // Three odd constants of SplitMix64's, which spread the bits of each input
    // across the whole word.
    private const u64 MIX_A = 0x9E3779B97F4A7C15
    private const u64 MIX_B = 0xBF58476D1CE4E5B9
    private const u64 MIX_C = 0x94D049BB133111EB

    // The text a link holds — the one hop — read from its reparse data. The
    // buffer is `REPARSE_DATA_BUFFER`, which no user-mode header declares, so
    // its fields are read at their documented offsets: the tag at 0, then for
    // a symbolic link four `u16`s (substitute name offset and length, print
    // name offset and length, in bytes) at 8, a `u32` of flags at 16 and the
    // names at 20; a junction has no flags word, so its names are at 16. The
    // print name is the one a person wrote; a relative link may leave it empty,
    // and then the substitute name is the answer.
    private (ref []char8 text, bool ok) link_text(string8 path):
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(w) == 0: return (#make([]char8, 0), false)
        rawptr h = CreateFileW(&w[0], FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nil, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS, nil)
        if h == INVALID_HANDLE_VALUE: return (#make([]char8, 0), false)
        ref []u16 buf = #make([]u16, REPARSE_BUFFER / 2)
        defer #delete(buf)
        #c.ulong got = 0
        bool read_it = DeviceIoControl(h, FSCTL_GET_REPARSE_POINT, nil, 0, rawptr(&buf[0]), #c.ulong(REPARSE_BUFFER), &got, nil) != 0
        _ = CloseHandle(h)
        if !read_it || got < 16: return (#make([]char8, 0), false)
        u64 tag = u64(buf[0]) | (u64(buf[1]) << 16)
        i64 names = 0
        if tag == u64(IO_REPARSE_TAG_SYMLINK):
            names = 20
        else if tag == u64(IO_REPARSE_TAG_MOUNT_POINT):
            names = 16
        else:
            return (#make([]char8, 0), false)
        i64 sub_at = i64(buf[4])
        i64 sub_len = i64(buf[5])
        i64 print_at = i64(buf[6])
        i64 print_len = i64(buf[7])
        i64 at = print_at
        i64 len = print_len
        if len == 0:
            at = sub_at
            len = sub_len
        i64 first = (names + at) / 2
        i64 count = len / 2
        if first + count > #len(buf) || count <= 0: return (#make([]char8, 0), false)
        ref []char8 text = narrow(&buf[first], count)
        // A substitute name is an NT path, `\??\C:\…`; the person's form drops
        // the `\??\`.
        string8 t = text
        if strings.starts_with(t, "\\??\\"):
            ref []char8 trimmed = #format(strings.rest(t, 4))
            #delete(text)
            return (trimmed, true)
        return (text, true)

    // A path `GetFinalPathNameByHandleW` answered, in the plain form: the
    // `\\?\` prefix off, and `\\?\UNC\` back to `\\`.
    private ref []char8 plain_form(string8 t):
        if strings.starts_with(t, "\\\\?\\UNC\\"):
            return #format("\\\\", strings.rest(t, 8))
        if strings.starts_with(t, "\\\\?\\"):
            return #format(strings.rest(t, 4))
        return #format(t)

    // Whether `path` ends in one of the extensions in `PATHEXT`
    // (`.COM;.EXE;.BAT;.CMD` when it is unset), ignoring ASCII case.
    private bool runnable_name(string8 path):
        (ref []char8 env, bool found) = os.get_env("PATHEXT")
        defer #delete(env)
        string8 list = ".COM;.EXE;.BAT;.CMD"
        if found && #len(env) > 0:
            list = env
        i64 start = 0
        for i in 0..<#len(list) + 1:
            if i == #len(list) || list[i] == ';':
                string8 ext = strings.substring(list, start, i - start)
                if #len(ext) > 0 && #len(ext) <= #len(path) && same_ignoring_case(strings.rest(path, #len(path) - #len(ext)), ext):
                    return true
                start = i + 1
        return false

    // ASCII case only, which is what an extension needs.
    private bool same_ignoring_case(string8 a, string8 b):
        if #len(a) != #len(b): return false
        for i in 0..<#len(a):
            char8 x = a[i]
            char8 y = b[i]
            if x >= 'a' && x <= 'z': x = char8(i32(x) - 32)
            if y >= 'a' && y <= 'z': y = char8(i32(y) - 32)
            if x != y: return false
        return true
