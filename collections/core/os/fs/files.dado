// Whole files, and changing the tree — the failable half of `core:os/fs`, over
// `string8` paths on every system.
//
//     try fs.write_file("settings.ini", text) else code:
//         println("cannot save: ", os.message(code))
//     try ref []char8 back = fs.read_file("settings.ini") else code:
//         ...
//     defer #delete(back)
//
// **Every function here fails with a code from `core:os`** (`os.NOT_FOUND`,
// `os.PERMISSION`, …), whichever system it runs on, and `os.message(code)` is
// the sentence. The predicates in `fs.dado` keep their `bool`s, because *"is
// this a directory"* has no failure that is not also *no*.
//
// **Paths are `string8`**, UTF-8 on every system: POSIX passes the bytes on,
// with a `\0` added for the call; Windows converts them to UTF-16
// (`windows.dado`).
//
// **What is allocated is the caller's**, from the ambient allocator (`using`):
// `read_file`'s bytes and `make_temp_dir`'s path are `ref []char8`s to
// `#delete`. The scratch the functions make for themselves is freed before
// they return, on every path out.
//
// Thread-safety: every function is safe from any thread; two threads changing
// one tree at once get whatever order the system gives them.
package fs

import "core:os"
import "core:strings"

// ── what every system shares ────────────────────────────────────────────────

// `s` with a `\0` after it, for a C call; the caller deletes it.
private ref []char8 c_path(string8 s):
    ref []char8 out = #make([]char8, #len(s) + 1)
    for i in 0..<#len(s):
        out[i] = s[i]
    out[#len(s)] = '\0'
    return out

// The name `write_file` writes first, beside `path` so the rename that
// publishes it stays on one filesystem: the path, the process and a counter,
// so two writers in two processes, or two threads of one, never share one.
private u64 g_temp_files
private ref []char8 temp_beside(string8 path):
    g_temp_files += 1
    return #format(path, ".dado-tmp-", os.pid(), "-", g_temp_files)

// Whether a temp directory's prefix is a plain name: no separator, so the
// directory is made where `os.temp_dir()` says and nowhere else.
private bool plain_name(string8 prefix):
    for c in prefix:
        if c == '/' || c == '\\' || c == '\0': return false
    return true

// ── Windows ─────────────────────────────────────────────────────────────────
when #OS == #WINDOWS:
    // The whole file. Opened with every sharing mode, so a file another
    // program has open can still be read, as on POSIX.
    !ref []char8 read_file(string8 path):
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(w) == 0: fail os.INVALID
        // `CreateFileW` refuses a directory opened without
        // `FILE_FLAG_BACKUP_SEMANTICS` as `ERROR_ACCESS_DENIED`, which would
        // read as a permission problem; asked first, it is `IS_DIR`, as POSIX
        // answers it.
        (u32 a, bool got) = attributes_of(path)
        if got && (a & u32(FILE_ATTRIBUTE_DIRECTORY)) != 0: fail os.IS_DIR
        rawptr h = CreateFileW(&w[0], GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nil, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nil)
        if h == INVALID_HANDLE_VALUE: fail failure()
        defer _ = CloseHandle(h)
        FsHandleInfo info
        if GetFileInformationByHandle(h, &info) == 0: fail failure()
        if (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0: fail os.IS_DIR
        ref []char8 out = #make([]char8, 0)
        [65536]char8 chunk
        for:
            #c.ulong got = 0
            if ReadFile(h, rawptr(&chunk[0]), 65536, &got, nil) == 0:
                i32 code = failure()
                #delete(out)
                fail code
            if got == 0: break
            for i in 0..<i64(got):
                _ = #append(out, chunk[i])
        return out

    private !void write_all(rawptr h, string8 data):
        []char8 bytes = strings.bytes(data)
        i64 done = 0
        i64 n = #len(bytes)
        for done < n:
            i64 step = n - done
            if step > 1048576: step = 1048576
            #c.ulong wrote = 0
            if WriteFile(h, rawptr(&bytes[done]), #c.ulong(step), &wrote, nil) == 0:
                fail failure()
            if wrote == 0: fail os.IO
            done += i64(wrote)
        return

    // Written to a new file beside `path`, flushed to the disk, and moved over
    // `path` by `MoveFileExW` with `MOVEFILE_REPLACE_EXISTING` and
    // `MOVEFILE_WRITE_THROUGH`. A reader sees the old bytes or the new ones and
    // never a part; a failure removes the new file and leaves `path` as it was.
    !void write_file(string8 path, string8 data):
        ref []char8 tmp = temp_beside(path)
        defer #delete(tmp)
        ref []u16 wtmp = wide_path(tmp)
        defer #delete(wtmp)
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(wtmp) == 0 || #len(w) == 0: fail os.INVALID
        rawptr h = CreateFileW(&wtmp[0], GENERIC_WRITE, 0, nil, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nil)
        if h == INVALID_HANDLE_VALUE: fail failure()
        try write_all(h, data) else code:
            _ = CloseHandle(h)
            _ = DeleteFileW(&wtmp[0])
            fail code
        if FlushFileBuffers(h) == 0:
            i32 code = failure()
            _ = CloseHandle(h)
            _ = DeleteFileW(&wtmp[0])
            fail code
        _ = CloseHandle(h)
        if MoveFileExW(&wtmp[0], &w[0], MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) == 0:
            i32 code = failure()
            _ = DeleteFileW(&wtmp[0])
            fail code
        return

    // A read-only file refuses `DeleteFileW`, which POSIX's `unlink` never
    // does for that reason, so the attribute is cleared and the delete asked
    // again.
    !void remove_file(string8 path):
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(w) == 0: fail os.INVALID
        if DeleteFileW(&w[0]) != 0: return
        i32 code = failure()
        (u32 a, bool got) = attributes_of(path)
        if got && (a & u32(FILE_ATTRIBUTE_DIRECTORY)) != 0 && (a & u32(FILE_ATTRIBUTE_REPARSE_POINT)) == 0:
            fail os.IS_DIR
        if got && (a & u32(FILE_ATTRIBUTE_READONLY)) != 0:
            if SetFileAttributesW(&w[0], FILE_ATTRIBUTE_NORMAL) != 0 && DeleteFileW(&w[0]) != 0:
                return
            code = failure()
        fail code

    !void remove_dir(string8 path):
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(w) == 0: fail os.INVALID
        if RemoveDirectoryW(&w[0]) == 0: fail failure()
        return

    // A link — symbolic, or a junction — is removed as itself, never entered:
    // `RemoveDirectoryW` for one to a directory and `remove_file` for one to a
    // file. A directory's names are read whole before any is removed, so the
    // search never runs over entries that are going.
    !void remove_all(string8 path):
        (u32 a, bool got) = attributes_of(path)
        if !got:
            i32 code = failure()
            if code == os.NOT_FOUND: return
            fail code
        bool dir = (a & u32(FILE_ATTRIBUTE_DIRECTORY)) != 0
        bool link = (a & u32(FILE_ATTRIBUTE_REPARSE_POINT)) != 0
        if dir && !link:
            ref []char8 cp = c_path(path)
            ^Dir d = open(cstring(cp))
            #delete(cp)
            if !opened(d): fail failure()
            ref []char8 names = #make([]char8, 0)
            defer #delete(names)
            for:
                (cstring name, bool more) = next(d)
                if !more: break
                string8 nm = string8(name)
                if nm == "." || nm == "..": continue
                for c in nm:
                    _ = #append(names, c)
                _ = #append(names, '\0')
            close(d)
            i64 start = 0
            string8 all = names
            for i in 0..<#len(all):
                if all[i] == '\0':
                    ref []char8 child = #format(path, "\\", strings.substring(all, start, i - start))
                    string8 c = child
                    try remove_all(c) else code:
                        #delete(child)
                        fail code
                    #delete(child)
                    start = i + 1
            try remove_dir(path)
            return
        if dir:
            try remove_dir(path)
            return
        try remove_file(path)
        return

    // `MoveFileExW` with `MOVEFILE_REPLACE_EXISTING`: an existing `to` is
    // replaced, as POSIX's `rename` does; a move to another volume fails with
    // `CROSS_DEVICE` and moves nothing.
    !void rename(string8 from, string8 to):
        ref []u16 wf = wide_path(from)
        defer #delete(wf)
        ref []u16 wt = wide_path(to)
        defer #delete(wt)
        if #len(wf) == 0 || #len(wt) == 0: fail os.INVALID
        if MoveFileExW(&wf[0], &wt[0], MOVEFILE_REPLACE_EXISTING) == 0: fail failure()
        return

    // `CopyFileW`, replacing `to`; it copies the attributes too.
    !void copy_file(string8 from, string8 to):
        ref []u16 wf = wide_path(from)
        defer #delete(wf)
        ref []u16 wt = wide_path(to)
        defer #delete(wt)
        if #len(wf) == 0 || #len(wt) == 0: fail os.INVALID
        if CopyFileW(&wf[0], &wt[0], 0) == 0: fail failure()
        return

    !i64 mtime(string8 path):
        (FsHandleInfo info, bool got) = info_follow(path)
        if !got: fail failure()
        return unix_nanos_of(info.ftLastWriteTime.dwLowDateTime, info.ftLastWriteTime.dwHighDateTime)

    // A new directory under `os.temp_dir()`, named `prefix` and sixteen hex
    // digits, that only its owner can open. A name already taken is tried
    // again with new digits.
    !ref []char8 make_temp_dir(string8 prefix):
        if !plain_name(prefix): fail os.INVALID
        ref []char8 base = os.temp_dir()
        defer #delete(base)
        string8 b = base
        for _ in 0..<100:
            ref []char8 path = #format(b, "\\", prefix, hex16(temp_noise()))
            string8 p = path
            try create_private(p) else code:
                #delete(path)
                if code == os.EXISTS: continue
                fail code
            return path
        fail os.EXISTS

    private ref []char8 hex16(u64 x):
        ref []char8 out = #make([]char8, 16)
        u64 v = x
        for i in 0..<16:
            u64 d = v & 15
            if d < 10:
                out[15 - i] = char8(u64('0') + d)
            else:
                out[15 - i] = char8(u64('a') + d - 10)
            v = v >> 4
        return out

    // `CreateSymbolicLinkW`, with
    // `SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE` so Developer Mode is
    // enough; without it, or administrator rights, Windows refuses with
    // `PRIVILEGE`, whose message says so. A link to a directory has to be
    // made as one, so `target` is looked at from the link's own directory,
    // which is where a relative target is read from. Separators in `target`
    // are written as `\`, the only one a link's text is read with.
    !void make_symlink(string8 target, string8 path):
        if #len(target) == 0 || #len(path) == 0: fail os.INVALID
        ref []char8 t = #format(target)
        defer #delete(t)
        for i in 0..<#len(t):
            if t[i] == '/': t[i] = '\\'
        string8 ts = t
        #c.ulong flags = SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE
        ref []char8 seen = #format(ts)
        if !absolute(target):
            #delete(seen)
            seen = #format(parent_of(path), ts)
        string8 s = seen
        ref []char8 sc = c_path(s)
        if is_dir(cstring(sc)): flags = flags | SYMBOLIC_LINK_FLAG_DIRECTORY
        #delete(sc)
        #delete(seen)
        ref []u16 wl = wide_path(path)
        defer #delete(wl)
        ref []u16 wt = widen(ts)
        defer #delete(wt)
        if #len(wl) == 0 || #len(wt) == 0: fail os.INVALID
        if CreateSymbolicLinkW(&wl[0], &wt[0], flags) == 0:
            // An old Windows refuses the flag it does not know; asked again
            // without it, the answer is the privilege question.
            if i64(GetLastError()) == i64(ERROR_INVALID_PARAMETER):
                if CreateSymbolicLinkW(&wl[0], &wt[0], flags ~ SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE) != 0:
                    return
            fail failure()
        // A system that answers success and makes nothing is not one that
        // makes links: Wine's `CreateSymbolicLinkW` is such a stub. Asked
        // afterwards, so the caller hears `UNSUPPORTED` rather than finding
        // nothing there.
        if !link_at(path): fail os.UNSUPPORTED
        return

    // Everything of `path` up to and including its last separator; empty when
    // it has none.
    private string8 parent_of(string8 path):
        i64 i = #len(path)
        for i > 0:
            char8 c = path[i - 1]
            if c == '/' || c == '\\' || c == ':': return strings.substring(path, 0, i)
            i -= 1
        return ""

// ── POSIX: Linux and macOS ──────────────────────────────────────────────────
//
// `open`'s and `mkdtemp`'s declarations need the POSIX surface asked for, and
// `rename` is C's own. Bound as `px` because this package declares `open`,
// `close` and `rename` of its own.
else:
    private foreign px "fcntl.h" define "_POSIX_C_SOURCE=200809L" define "_DARWIN_C_SOURCE=1":
        const i32 O_RDONLY
        const i32 O_WRONLY
        const i32 O_CREAT
        const i32 O_EXCL
        const i32 O_TRUNC
        const i32 O_CLOEXEC
        i32 open(cstring path, i32 flags, ...)

    private foreign px "unistd.h" define "_POSIX_C_SOURCE=200809L" define "_DARWIN_C_SOURCE=1":
        #c.long read(i32 fd, rawptr buf, #c.size_t count)
        #c.long write(i32 fd, const rawptr buf, #c.size_t count)
        #c.int close(i32 fd)
        #c.int fsync(i32 fd)
        #c.int unlink(cstring path)
        #c.int rmdir(cstring path)

    private foreign px "stdio.h":
        #c.int rename(cstring from, cstring to)

    private foreign px "stdlib.h" define "_POSIX_C_SOURCE=200809L" define "_DARWIN_C_SOURCE=1":
        ^#c.char mkdtemp(^#c.char template)

    // `0666` and `0777`, in the hex this language writes; the process's umask
    // takes from them what the user asked it to.
    private const i32 FILE_MODE = 0x1B6

    private i32 failure():
        return os.last_error()

    // The whole file. A directory opens for reading on Linux and fails at the
    // first `read` with `EISDIR`, which is the code it fails with here.
    !ref []char8 read_file(string8 path):
        ref []char8 cp = c_path(path)
        i32 fd = px.open(cstring(cp), px.O_RDONLY | px.O_CLOEXEC)
        #delete(cp)
        if fd < 0: fail failure()
        defer _ = px.close(fd)
        ref []char8 out = #make([]char8, 0)
        [65536]char8 chunk
        for:
            i64 got = i64(px.read(fd, rawptr(&chunk[0]), 65536))
            if got < 0:
                i32 code = failure()
                if code == os.INTERRUPTED: continue
                #delete(out)
                fail code
            if got == 0: break
            for i in 0..<got:
                _ = #append(out, chunk[i])
        return out

    private !void write_all(i32 fd, string8 data):
        []char8 bytes = strings.bytes(data)
        i64 done = 0
        i64 n = #len(bytes)
        for done < n:
            i64 wrote = i64(px.write(fd, rawptr(&bytes[done]), #c.size_t(n - done)))
            if wrote < 0:
                i32 code = failure()
                if code == os.INTERRUPTED: continue
                fail code
            if wrote == 0: fail os.IO
            done += wrote
        return

    // Written to a new file beside `path` (`O_CREAT | O_EXCL`, so it is never
    // someone else's), `fsync`ed, and `rename`d over `path`, which POSIX makes
    // atomic: a reader sees the old bytes or the new ones and never a part. A
    // failure removes the new file and leaves `path` as it was. The new file
    // has the default mode (`0666` less the umask), not the old one's.
    !void write_file(string8 path, string8 data):
        ref []char8 tmp = temp_beside(path)
        defer #delete(tmp)
        string8 t = tmp
        ref []char8 ctmp = c_path(t)
        defer #delete(ctmp)
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        i32 fd = px.open(cstring(ctmp), px.O_WRONLY | px.O_CREAT | px.O_EXCL | px.O_CLOEXEC, FILE_MODE)
        if fd < 0: fail failure()
        try write_all(fd, data) else code:
            _ = px.close(fd)
            _ = px.unlink(cstring(ctmp))
            fail code
        if px.fsync(fd) != 0:
            i32 code = failure()
            _ = px.close(fd)
            _ = px.unlink(cstring(ctmp))
            fail code
        if px.close(fd) != 0:
            i32 code = failure()
            _ = px.unlink(cstring(ctmp))
            fail code
        if px.rename(cstring(ctmp), cstring(cp)) != 0:
            i32 code = failure()
            _ = px.unlink(cstring(ctmp))
            fail code
        return

    !void remove_file(string8 path):
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if px.unlink(cstring(cp)) != 0: fail failure()
        return

    !void remove_dir(string8 path):
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if px.rmdir(cstring(cp)) != 0: fail failure()
        return

    // `lstat` decides, so a symbolic link is `unlink`ed as itself and never
    // entered, wherever it points. A directory's names are read whole before
    // any is removed, so `readdir` never runs over entries that are going.
    // Something that swaps a directory for a link between the `lstat` and the
    // `opendir` can still steer one level of the walk; a tree nobody else is
    // changing is removed exactly.
    !void remove_all(string8 path):
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        (bool there, bool dir) = lstat_kind(cstring(cp))
        if !there:
            i32 code = failure()
            if code == os.NOT_FOUND: return
            fail code
        if !dir:
            try remove_file(path)
            return
        ^Dir d = open(cstring(cp))
        if !opened(d): fail failure()
        ref []char8 names = #make([]char8, 0)
        defer #delete(names)
        for:
            (cstring name, bool more) = next(d)
            if !more: break
            string8 nm = string8(name)
            if nm == "." || nm == "..": continue
            for c in nm:
                _ = #append(names, c)
            _ = #append(names, '\0')
        close(d)
        i64 start = 0
        string8 all = names
        for i in 0..<#len(all):
            if all[i] == '\0':
                ref []char8 child = #format(path, "/", strings.substring(all, start, i - start))
                string8 c = child
                try remove_all(c) else code:
                    #delete(child)
                    fail code
                #delete(child)
                start = i + 1
        try remove_dir(path)
        return

    // `rename(2)`: an existing `to` is replaced atomically; across
    // filesystems it fails with `CROSS_DEVICE` and moves nothing.
    !void rename(string8 from, string8 to):
        ref []char8 cf = c_path(from)
        defer #delete(cf)
        ref []char8 ct = c_path(to)
        defer #delete(ct)
        if px.rename(cstring(cf), cstring(ct)) != 0: fail failure()
        return

    // The bytes, into `to` created or truncated, with `from`'s permission
    // bits.
    !void copy_file(string8 from, string8 to):
        ref []char8 cf = c_path(from)
        defer #delete(cf)
        ref []char8 ct = c_path(to)
        defer #delete(ct)
        (u32 mode, bool got) = mode_bits(cstring(cf))
        if !got: fail failure()
        if is_dir(cstring(cf)): fail os.IS_DIR
        i32 src = px.open(cstring(cf), px.O_RDONLY | px.O_CLOEXEC)
        if src < 0: fail failure()
        defer _ = px.close(src)
        i32 dst = px.open(cstring(ct), px.O_WRONLY | px.O_CREAT | px.O_TRUNC | px.O_CLOEXEC, i32(mode & 0x1FF))
        if dst < 0: fail failure()
        [65536]char8 chunk
        for:
            i64 got_bytes = i64(px.read(src, rawptr(&chunk[0]), 65536))
            if got_bytes < 0:
                i32 code = failure()
                if code == os.INTERRUPTED: continue
                _ = px.close(dst)
                fail code
            if got_bytes == 0: break
            string8 piece = string8(chunk[0..<got_bytes])
            try write_all(dst, piece) else code:
                _ = px.close(dst)
                fail code
        if px.close(dst) != 0: fail failure()
        return

    !i64 mtime(string8 path):
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        (i64 ns, bool got) = mtime_of(cstring(cp))
        if !got: fail failure()
        return ns

    // `mkdtemp`, which makes the directory `0700` and never over anything
    // already there.
    !ref []char8 make_temp_dir(string8 prefix):
        if !plain_name(prefix): fail os.INVALID
        ref []char8 base = os.temp_dir()
        defer #delete(base)
        string8 b = base
        ref []char8 template = #format(b, "/", prefix, "XXXXXX", "\0")
        if px.mkdtemp(CharBuf(rawptr(&template[0]))) == nil:
            i32 code = failure()
            #delete(template)
            fail code
        string8 whole = template
        string8 made = strings.substring(whole, 0, #len(whole) - 1)
        ref []char8 out = #format(made)
        #delete(template)
        return out

    // `symlink(2)`, which needs no privilege on POSIX.
    !void make_symlink(string8 target, string8 path):
        ref []char8 ct = c_path(target)
        defer #delete(ct)
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if #len(target) == 0 || #len(path) == 0: fail os.INVALID
        if !symlink(cstring(ct), cstring(cp)): fail failure()
        return
