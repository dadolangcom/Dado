@test
// The rest of the failable generation, on whichever system the test is built
// for: `info` and `link_info`, `chmod`, `read_dir`, `glob`, the working
// directory, `create_dir`, `canonical` and `link_target` — and on `#WEB`, the
// `UNSUPPORTED` each of them, and every older failable function, answers.
//
// Everything hosted happens under a directory `make_temp_dir` made, which is
// removed by `remove_all` at the end.
package fs

import "core:mem/libc"
import "core:os"
import "core:strings"

private ref []char8 at(string8 root, string8 name):
    return #format(root, "/", name)

// Whether `l` lists exactly the names in `want`, each once, in that order.
private bool lists(Listing l, string8 what, ..string8 want):
    bool ok = #expect(#len(l.entries) == #len(want), what, " listed ", #len(l.entries), " entries, not ", #len(want))
    if !ok: return false
    for i in 0..<#len(want):
        ok = #expect(strings.ends_with(l.entries[i].path, want[i]), what, " entry ", i, " is '", l.entries[i].path, "', not '", want[i], "'") && ok
    return ok

private bool hosted(string8 root):
    bool ok = true
    ref []char8 file = at(root, "a.txt")
    defer #delete(file)
    ref []char8 sub = at(root, "sub")
    defer #delete(sub)

    // `info` reads kind, size and time together.
    try write_file(file, "hello") else code:
        return #expect(false, "write_file failed: ", os.message(code))
    try FileInfo fi = info(file) else code1:
        return #expect(false, "info(file) failed: ", os.message(code1))
    ok = #expect(fi.is_file() && !fi.is_dir() && !fi.is_link(), "a file's kind is ", fi.kind) && ok
    ok = #expect(fi.size == 5, "a five-byte file's size is ", fi.size) && ok
    try i64 m = mtime(file) else code2:
        return #expect(false, "mtime failed: ", os.message(code2))
    ok = #expect(fi.mtime == m && m > 0, "info's mtime ", fi.mtime, " is not mtime's ", m) && ok

    try create_dir(sub) else code3:
        return #expect(false, "create_dir failed: ", os.message(code3))
    try create_dir(sub) else code4:
        ok = #expect(code4 == os.Error.EXISTS, "a second create_dir failed with ", os.message(code4)) && ok
    try FileInfo di = info(sub) else code5:
        return #expect(false, "info(dir) failed: ", os.message(code5))
    ok = #expect(di.is_dir(), "a directory's kind is ", di.kind) && ok

    ref []char8 none = at(root, "none")
    defer #delete(none)
    try _ = info(none) else code6:
        ok = #expect(code6 == os.Error.NOT_FOUND, "info of nothing failed with ", os.message(code6)) && ok

    // `chmod`: read-only, then writable again. On POSIX the bits read back
    // exactly; on Windows only the write bit means anything.
    try chmod(file, 0x124) else code7:
        ok = #expect(false, "chmod failed: ", os.message(code7)) && ok
    try FileInfo ro = info(file) else code8:
        return #expect(false, "info after chmod failed: ", os.message(code8))
    ok = #expect((ro.mode & 0x92) == 0, "a file made 0444 has write bits: ", ro.mode) && ok
    when #OS != #WINDOWS:
        ok = #expect(ro.mode == 0x124, "a file made 0444 reads back ", ro.mode) && ok
    try chmod(file, 0x1A4) else code9:
        ok = #expect(false, "chmod back failed: ", os.message(code9)) && ok
    try FileInfo rw = info(file) else code10:
        return #expect(false, "info after chmod failed: ", os.message(code10))
    ok = #expect((rw.mode & 0x80) != 0, "a file made 0644 is not writable: ", rw.mode) && ok

    // `read_dir` and `glob`.
    ref []char8 b = at(root, "b.txt")
    defer #delete(b)
    ref []char8 hid = at(root, ".hidden.txt")
    defer #delete(hid)
    ref []char8 deep = at(sub, "c.txt")
    defer #delete(deep)
    try write_file(b, "b") else code11:
        return #expect(false, "write_file failed: ", os.message(code11))
    try write_file(hid, "h") else code12:
        return #expect(false, "write_file failed: ", os.message(code12))
    try write_file(deep, "c") else code13:
        return #expect(false, "write_file failed: ", os.message(code13))
    try Listing rd = read_dir(root) else code14:
        return #expect(false, "read_dir failed: ", os.message(code14))
    ok = #expect(#len(rd.entries) == 4, "read_dir listed ", #len(rd.entries), " entries, not 4") && ok
    for e in rd.entries:
        ok = #expect(e.is_dir == (e.path == "sub"), "read_dir: '", e.path, "' is_dir=", e.is_dir) && ok
        ok = #expect(!strings.contains(e.path, "/"), "read_dir answered a joined path '", e.path, "'") && ok
    rd.destroy()
    Listing nd = (#make([]char8, 0), #make([]Entry, 0))
    try nd = read_dir(none) else code15:
        ok = #expect(code15 == os.Error.NOT_FOUND, "read_dir of nothing failed with ", os.message(code15)) && ok
    nd.destroy()

    ref []char8 pat = at(root, "*.txt")
    defer #delete(pat)
    try Listing g = glob(pat) else code16:
        return #expect(false, "glob failed: ", os.message(code16))
    ok = lists(g, "glob *.txt", "/a.txt", "/b.txt") && ok
    g.destroy()
    ref []char8 pat2 = at(root, "s?b/*")
    defer #delete(pat2)
    try Listing g2 = glob(pat2) else code17:
        return #expect(false, "glob failed: ", os.message(code17))
    ok = lists(g2, "glob s?b/*", "sub/c.txt") && ok
    g2.destroy()
    ref []char8 pat3 = at(root, "nothing*")
    defer #delete(pat3)
    try Listing g3 = glob(pat3) else code18:
        return #expect(false, "glob failed: ", os.message(code18))
    ok = #expect(#len(g3.entries) == 0, "a glob matching nothing listed ", #len(g3.entries)) && ok
    g3.destroy()
    ref []char8 pat4 = at(root, ".h*")
    defer #delete(pat4)
    try Listing g4 = glob(pat4) else code19:
        return #expect(false, "glob failed: ", os.message(code19))
    ok = #expect(#len(g4.entries) == 1, "a glob for .h* listed ", #len(g4.entries)) && ok
    g4.destroy()

    // **A malformed pattern is not "not found".** `path`'s codes are its own,
    // so `glob` reports the argument as invalid, and its sentence is not
    // `NOT_FOUND`'s (`path`'s `BAD_PATTERN` once collided with it).
    ref []char8 pat5 = at(root, "[a-")
    defer #delete(pat5)
    Listing g5 = (#make([]char8, 0), #make([]Entry, 0))
    try g5 = glob(pat5) else code19b:
        ok = #expect(code19b == os.Error.INVALID, "a malformed glob failed with ", os.message(code19b), ", not INVALID") && ok
        ok = #expect(os.message(code19b) != os.message(os.Error.NOT_FOUND), "a malformed glob reads as not found") && ok
    ok = #expect(#len(g5.entries) == 0, "a malformed glob listed ", #len(g5.entries)) && ok
    g5.destroy()
    // A part the walk never reaches is not judged: under a directory that is
    // not there nothing matches, which is an empty listing and no failure.
    ref []char8 pat6 = at(none, "x[")
    defer #delete(pat6)
    Listing g6 = (#make([]char8, 0), #make([]Entry, 0))
    try g6 = glob(pat6) else code19c:
        ok = #expect(false, "a pattern under nothing failed with ", os.message(code19c)) && ok
    g6.destroy()

    // The working directory, moved into `sub` and back.
    try ref []char8 here = current_dir() else code20:
        return #expect(false, "current_dir failed: ", os.message(code20))
    try change_dir(sub) else code21:
        #delete(here)
        return #expect(false, "change_dir failed: ", os.message(code21))
    try ref []char8 there = current_dir() else code22:
        #delete(here)
        return #expect(false, "current_dir failed: ", os.message(code22))
    ref []char8 canon_sub = #make([]char8, 0)
    try canon_sub = canonical(sub) else code23:
        ok = #expect(false, "canonical failed: ", os.message(code23)) && ok
    string8 t = there
    string8 cs = canon_sub
    ok = #expect(t == cs, "after change_dir the directory is '", t, "', not '", cs, "'") && ok
    #delete(there)
    #delete(canon_sub)
    try change_dir(here) else code24:
        ok = #expect(false, "change_dir back failed: ", os.message(code24)) && ok
    #delete(here)
    try change_dir(none) else code25:
        ok = #expect(code25 == os.Error.NOT_FOUND, "change_dir to nothing failed with ", os.message(code25)) && ok

    // `link_target` and `link_info`, where links can be made.
    ref []char8 link = at(root, "ln")
    defer #delete(link)
    bool linked = true
    try make_symlink("a.txt", link) else code26:
        linked = false
        ok = #expect(code26 == os.Error.PRIVILEGE || code26 == os.Error.UNSUPPORTED, "make_symlink failed: ", os.message(code26)) && ok
    if linked:
        try ref []char8 lt = link_target(link) else code27:
            return #expect(false, "link_target failed: ", os.message(code27))
        string8 lts = lt
        ok = #expect(lts == "a.txt", "link_target read '", lts, "'") && ok
        #delete(lt)
        try FileInfo li = link_info(link) else code28:
            return #expect(false, "link_info failed: ", os.message(code28))
        ok = #expect(li.is_link(), "link_info of a link has kind ", li.kind) && ok
        try FileInfo lf = info(link) else code29:
            return #expect(false, "info through a link failed: ", os.message(code29))
        ok = #expect(lf.is_file() && lf.size == 5, "info through a link is kind ", lf.kind, " size ", lf.size) && ok
    ref []char8 nl = #make([]char8, 0)
    try nl = link_target(file) else code30:
        ok = #expect(code30 == os.Error.INVALID, "link_target of a file failed with ", os.message(code30)) && ok
    #delete(nl)
    return ok

// Every failable function answers `UNSUPPORTED` on the web.
private bool web():
    bool ok = true
    ref []char8 r = #make([]char8, 0)
    try r = read_file("x") else c1:
        ok = #expect(c1 == os.Error.UNSUPPORTED, "read_file failed with ", os.message(c1)) && ok
    #delete(r)
    try write_file("x", "y") else c2:
        ok = #expect(c2 == os.Error.UNSUPPORTED, "write_file failed with ", os.message(c2)) && ok
    try remove_file("x") else c3:
        ok = #expect(c3 == os.Error.UNSUPPORTED, "remove_file failed with ", os.message(c3)) && ok
    try remove_all("x") else c4:
        ok = #expect(c4 == os.Error.UNSUPPORTED, "remove_all failed with ", os.message(c4)) && ok
    try _ = info("x") else c5:
        ok = #expect(c5 == os.Error.UNSUPPORTED, "info failed with ", os.message(c5)) && ok
    Listing l = (#make([]char8, 0), #make([]Entry, 0))
    try l = read_dir(".") else c6:
        ok = #expect(c6 == os.Error.UNSUPPORTED, "read_dir failed with ", os.message(c6)) && ok
    l.destroy()
    Listing g = (#make([]char8, 0), #make([]Entry, 0))
    try g = glob("*") else c7:
        ok = #expect(c7 == os.Error.UNSUPPORTED, "glob failed with ", os.message(c7)) && ok
    g.destroy()
    ref []char8 cd = #make([]char8, 0)
    try cd = current_dir() else c8:
        ok = #expect(c8 == os.Error.UNSUPPORTED, "current_dir failed with ", os.message(c8)) && ok
    #delete(cd)
    ref []char8 t = #make([]char8, 0)
    try t = make_temp_dir("x") else c9:
        ok = #expect(c9 == os.Error.UNSUPPORTED, "make_temp_dir failed with ", os.message(c9)) && ok
    #delete(t)
    try chmod("x", 0x1A4) else c10:
        ok = #expect(c10 == os.Error.UNSUPPORTED, "chmod failed with ", os.message(c10)) && ok
    File f = (0 - 1, nil, false)
    try f = open_file("x", Open.Read) else c11:
        ok = #expect(c11 == os.Error.UNSUPPORTED, "open_file failed with ", os.message(c11)) && ok
    [4]char8 buf
    try _ = f.read(buf[:]) else c12:
        ok = #expect(c12 == os.Error.INVALID, "reading a closed File failed with ", os.message(c12)) && ok
    ok = #expect(!exists(".") && !is_dir(".") && !is_file(".") && !is_link(".") && !is_executable("."), "the web found something at '.'") && ok
    ok = #expect(open(".") == nil, "the web opened a directory") && ok
    ref []u8 rb = #make([]u8, 0)
    try rb = read_bytes("x") else c13:
        ok = #expect(c13 == os.Error.UNSUPPORTED, "read_bytes failed with ", os.message(c13)) && ok
    #delete(rb)
    [2]u8 two
    try write_bytes("x", two[:]) else c14:
        ok = #expect(c14 == os.Error.UNSUPPORTED, "write_bytes failed with ", os.message(c14)) && ok
    try make_dirs("x/y") else c15:
        ok = #expect(c15 == os.Error.UNSUPPORTED, "make_dirs failed with ", os.message(c15)) && ok
    try make_executable("x") else c16:
        ok = #expect(c16 == os.Error.UNSUPPORTED, "make_executable failed with ", os.message(c16)) && ok
    try create_private_dir("x") else c17:
        ok = #expect(c17 == os.Error.UNSUPPORTED, "create_private_dir failed with ", os.message(c17)) && ok
    Listing w = walk(".")
    ok = #expect(#len(w.entries) == 0, "the web walked something") && ok
    w.destroy()
    return ok

i32 test():
    using libc.allocator():
        when #OS == #WEB:
            return 0 if web() else 1
        else:
            try ref []char8 root = make_temp_dir("dado-info-test-") else code:
                _ = #expect(false, "make_temp_dir failed: ", os.message(code))
                return 1
            string8 r = root
            bool ok = hosted(r)
            try remove_all(r) else code2:
                ok = #expect(false, "remove_all failed: ", os.message(code2)) && ok
            #delete(root)
            return 0 if ok else 1
