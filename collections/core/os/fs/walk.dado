// Walking a tree, and making one — the half of `core:os/fs` that allocates.
//
//     fs.Listing l = fs.walk("collections")
//     defer l.destroy()
//     for e in l.entries:
//         if !e.is_dir && strings.ends_with(e.path, ".dado"):
//             ...
//
// **Allocation is the caller's ambient allocator** (`using`): a `Listing` —
// `walk`'s, `read_dir`'s and `glob`'s answer — is two blocks from it, ended
// together by `destroy`. `make_dirs`' scratch is freed before it returns.
//
// **On `#WEB`** nothing is ever there: `walk` answers an empty `Listing` and
// `make_dirs` fails `UNSUPPORTED`.
//
// Not promised to raise: both walk the disk through `fs.dado`'s `foreign`
// calls. `Listing.destroy` is two `#delete`s, promised on the line above it.
package fs

import "core:os"
import "core:path"
import "core:strings"

// One path a listing found, and whether it is a directory (links followed).
//
// `path` is a **view into the listing's own bytes** and dies with it. That is
// the whole ownership design: the alternative is a `ref []string8`, and a
// `ref` frees one block while the strings in it would each be another — so
// the elements would leak or the slice would be unfreeable, and neither is a
// thing to hand a caller.
type Entry: (string8 path, bool is_dir)

// What a listing answers: one block of bytes holding every path, and one
// slice of views over it. Two allocations, ended together by `destroy`, and
// **not** by `#delete` on either half — a caller that frees the bytes leaves
// the entries pointing at nothing, which is exactly the mistake the pair
// exists to make hard to write.
type Listing:
    ref []char8 bytes
    ref []Entry entries

    // Free the two blocks the listing holds, and leave it empty. Safe on an
    // empty listing, and on one already destroyed.
    #assert_raises
    void destroy(^self):
        #delete(self.entries)
        #delete(self.bytes)
        self.entries = nil
        self.bytes = nil

// A span of the blob, recorded while the blob is still growing.
//
// **Views cannot be taken until the bytes have stopped moving.** `#append` may
// reallocate, so a `string8` built into `entries` during the walk would point
// at a freed block the moment the blob grew past its capacity — which is the
// kind of defect that works in every small test. So the walk records offsets
// and the views are made once, at the end.
private type Span: (i64 start, i64 len, bool is_dir)

// Every path under `root`, depth first, **a directory before its contents**,
// on the ambient allocator. End it with `destroy`.
//
// `root` itself is not in the listing: the caller named it and already has it.
//
// Reversed, this is a safe deletion order — every child appears after its
// parent, so backwards every child comes before it — which is what `rm -rf`
// needs and is why the order is stated rather than left as whatever `readdir`
// gave.
//
// **Hidden entries are skipped**, which is `fs.hidden`'s policy: `.`, `..` and
// every dotfile. Descending into a `.git` is the difference between a second
// and a minute. A caller that wants them uses `read_dir` and its own
// recursion, which is what this replaces rather than forbids.
//
// **A symlinked directory is listed and not entered.** A link can point at its
// own ancestor, and a walk that follows one does not finish.
//
// An unreadable directory contributes nothing and is not an error: a walk of a
// tree somebody is editing underneath it is a normal thing to be doing, and
// the alternative is a listing that is thrown away because one directory
// changed. An empty `Listing` is the answer for a `root` that is not there.
Listing walk(string8 root):
    ref []char8 bytes = #make([]char8, 0)
    ref []Span spans = #make([]Span, 0)
    walk_into(root, &bytes, &spans)

    ref []Entry entries = #make([]Entry, 0)
    string8 all = bytes
    for s in spans:
        _ = #append(entries, (strings.substring(all, s.start, s.len), s.is_dir))
    #delete(spans)
    return (bytes, entries)

private void walk_into(string8 dir, ^ref []char8 bytes, ^ref []Span spans):
    ^Dir d = open(dir)
    if d == nil:
        return
    defer close(d)
    for:
        (string8 nm, bool more) = next(d)
        if !more:
            break
        if hidden(nm):
            continue
        ref []char8 joined = #format(dir, "/", nm)
        string8 p = joined
        bool dir_here = is_dir(p)
        bool link_here = is_link(p)

        i64 start = #len(bytes^)
        for c in p:
            _ = #append(bytes^, c)
        _ = #append(spans^, (start, #len(p), dir_here))

        // Listed above, entered only here. A directory reached through a
        // symlink is a directory somewhere else in the tree, and walking it
        // from here either duplicates it or never ends.
        if dir_here && !link_here:
            walk_into(p, bytes, spans)
        #delete(joined)

// ── making a tree ─────────────────────────────────────────────────────────

// `mkdir -p`: every directory on `path` that is not there yet.
//
// **An existing directory is not a failure** — that is the whole difference
// between `create_dir` and this, and a caller racing another process to the
// same parent is the ordinary case rather than the exotic one. A component
// that exists as a *file* fails `EXISTS`: nothing here replaces anything. An
// empty `path` is `INVALID`; otherwise the system's reason for the first
// level that could not be made.
os.Error!void make_dirs(string8 path):
    if #len(path) == 0: fail os.Error.INVALID
    i64 n = #len(path)
    for i in 1..<n:
        // A leading `/` is the root and a `//` is one separator: an empty
        // component has nothing to make.
        if separator(path[i]) && !separator(path[i - 1]):
            try ensure_dir(strings.substring(path, 0, i))
    try ensure_dir(path)
    return

// A byte that ends a path component: `/` everywhere, and `\` too on Windows,
// which reads both. `core:path`'s answer for this target.
private bool separator(char8 c):
    return path.is_separator(c)

// One level, treating *already a directory* as success.
private os.Error!void ensure_dir(string8 p):
    if is_dir(p):
        return
    try create_dir(p) else why:
        // The race: somebody else made it between the two calls. Asking
        // again is cheaper than locking and is the only answer that is true.
        if is_dir(p): return
        fail why
    return
