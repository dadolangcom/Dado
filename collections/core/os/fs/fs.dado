// core:os/fs — what is on the disk.
//
//     import "core:os"
//     import "core:os/fs"
//
//     try fs.Listing l = fs.read_dir(".") else why:
//         println(".: ", os.message(why))
//         return 1
//     defer l.destroy()
//     for e in l.entries:
//         println(e.path, "  dir=", e.is_dir)
//
// **The package, in five files.** This one asks the questions of a path that
// have no failure but *no* — `is_dir`, `is_file`, `exists`, `is_link`,
// `is_executable`, `hidden` — and holds the system's directory stream and
// `struct stat` reader the rest is written over. `files.dado` is whole files,
// the tree changed, `info`, `read_dir`, `glob`, `chmod` and the working
// directory. `handle.dado` is an open `File`: read, write, seek, truncate,
// sync and lock. `walk.dado` walks and makes whole trees. `windows.dado` holds
// what the Windows arms share.
//
// **Every failable function fails `os.Error`** (`os.Error.NOT_FOUND`, …),
// whichever system it runs on, and `os.message(why)` is the sentence. **Paths
// are `string8`**, UTF-8 on every system: POSIX passes the bytes on with a
// `\0` added for the call, and Windows converts them to UTF-16
// (`windows.dado`).
//
// **Tier W H.** Hosted means Linux, macOS, Windows and the BSDs, each with an
// arm of its own. `#WEB` builds every function: a page has no file system, and
// node's is not imported yet, so each question answers false (nothing is
// there) and each failable function fails with `os.Error.UNSUPPORTED`. `#NONE`
// has no file system and is refused at build time.
//
// **What raises into a script.** `hidden`, `FileInfo`'s methods, the
// `Listing`'s `destroy` and the enums are plain Dado and promised. Every other
// function asks the system through a `foreign` call, and is not; `walk`,
// `make_dirs`, `read_dir` and `glob` are Dado, but each reaches the system too.
//
// Joining, splitting and cleaning paths is `core:path`'s, which asks the disk
// nothing; this package is the half that does.
//
// **What is read from `struct stat`, and how.** POSIX fixes which members
// `struct stat` has and nothing about their order, their widths or the padding
// between them, and every C library lays it out its own way — glibc
// differently on each architecture, musl, Darwin and each BSD differently
// again. So no layout is restated here: a few lines of C beside this file
// (`posix_stat` below) read the members by name, on whatever system the
// program is built for, into five 64-bit numbers Dado owns. `struct dirent`'s
// name is read the same way.
//
// Thread-safety: every function is safe from any thread; two threads changing
// one tree at once get whatever order the system gives them.
package fs

import "core:os"
import "core:strings"

#static_assert(#OS != #NONE, "core:os/fs reads a file system, and a #NONE build has none: keep this build from importing core:os/fs")

// ── what every system shares ────────────────────────────────────────────────

// Whether a name is `.`, `..`, or begins with a dot: the three a listing
// usually skips, as one question.
#assert_raises
bool hidden(string8 name):
    if name == "" || name == "." || name == "..":
        return true
    return name[0] == '.'

// `s` with a `\0` after it, for a C call, or `nil` when it could not be
// allocated; the caller deletes it.
private ref []char8 c_path(string8 s):
    return strings.clone_to_cstring(s)

// ── Windows ─────────────────────────────────────────────────────────────────
//
// The same surface over Win32, with the declarations and the path conversion
// in `windows.dado`. Each function's contract is the one its first comment
// line states; what Windows does to keep it is said after.
when #OS == #WINDOWS:
    // The search a directory listing is: `FindFirstFileW` answers the first
    // entry along with the handle, so it is held until the first `next`. The
    // record is allocated from the process heap by `open` and freed by
    // `close`, because `^Dir` is a pointer the caller holds and no Dado
    // allocator is in scope to free it with.
    private type Dir: (rawptr search, bool pending, FsFindData found, [1024]char8 name)

    // Open the directory at `path` for `next` to read, or `nil` when it cannot
    // be opened. Close it with `close`.
    private ^Dir open(string8 p):
        if #len(p) == 0:
            return nil
        // `dir\*` lists `dir`; a path that already ends in a separator takes
        // only the `*`.
        ref []char8 pattern = #format(p, "\\*")
        if p[#len(p) - 1] == '/' || p[#len(p) - 1] == '\\':
            #delete(pattern)
            pattern = #format(p, "*")
        ref []u16 w = wide_path(pattern)
        #delete(pattern)
        if #len(w) == 0:
            #delete(w)
            return nil
        rawptr block = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, #c.size_t(#size(Dir)))
        if block == nil:
            #delete(w)
            return nil
        ^Dir d = ^Dir(block)
        d^.search = FindFirstFileW(&w[0], &d^.found)
        #delete(w)
        if d^.search == INVALID_HANDLE_VALUE:
            _ = HeapFree(GetProcessHeap(), 0, block)
            return nil
        d^.pending = true
        return d

    // Close a directory `open` opened; `nil` is ignored.
    private void close(^Dir dir):
        if dir != nil:
            _ = FindClose(dir^.search)
            _ = HeapFree(GetProcessHeap(), 0, rawptr(dir))

    // The next entry's name, and whether there was one; `("", false)` at the
    // end. The name is converted into the record's own buffer, so it is good
    // until the next `next` on the same handle, as on POSIX. `.` and `..` are
    // included, as on POSIX: Windows lists both for every directory but a
    // drive's root.
    private (string8 name, bool ok) next(^Dir dir):
        if dir == nil:
            return ("", false)
        if dir^.pending:
            dir^.pending = false
        else if FindNextFileW(dir^.search, &dir^.found) == 0:
            return ("", false)
        #c.int wrote = WideCharToMultiByte(CP_UTF8, 0, &dir^.found.cFileName[0], -1, WCharBuf(rawptr(&dir^.name[0])), 1023, nil, nil)
        if wrote <= 0:
            dir^.name[0] = '\0'
        dir^.name[1023] = '\0'
        return (string8(cstring(rawptr(&dir^.name[0]))), true)

    // Whether `path` is a directory, following links; false when nothing is
    // there or it cannot be asked.
    bool is_dir(string8 path):
        (FsHandleInfo info, bool got) = info_follow(path)
        return got && (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0

    // Whether `path` is a regular file (anything but a directory), following
    // links; false when nothing is there or it cannot be asked.
    bool is_file(string8 path):
        (FsHandleInfo info, bool got) = info_follow(path)
        return got && (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) == 0

    // Whether something is at `path`, following links (a dangling link is not
    // there; `is_link` sees it).
    bool exists(string8 path):
        (FsHandleInfo _, bool got) = info_follow(path)
        return got

    // Whether `path` is itself a symbolic link (not followed): on Windows a
    // symbolic link or a junction.
    bool is_link(string8 path):
        return link_at(path)

    // Whether the caller could run the file at `path`.
    //
    // **Windows has no execute bit**: whether a file runs is decided by its
    // name, against the extensions in `PATHEXT` (`.COM;.EXE;.BAT;.CMD` when it
    // is unset). So this asks that question of a file that exists.
    bool is_executable(string8 path):
        if !is_file(path): return false
        return runnable_name(path)

    // Make the file at `path` runnable by whoever can read it. Fails with the
    // system's reason (`NOT_FOUND`, `IS_DIR`), and `UNSUPPORTED` on `#WEB`.
    //
    // On Windows there is nothing to set: with no execute bit, a file that
    // exists is as runnable as its name makes it.
    os.Error!void make_executable(string8 path):
        (FsHandleInfo info, bool got) = info_follow(path)
        if !got: try failed()
        if (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0: fail os.Error.IS_DIR
        return

    // `path` resolved against the disk — every `.`, `..` and link followed —
    // written into `out` with a terminator; answers the length, or -1 when it
    // cannot be resolved or does not fit.
    //
    // `GetFinalPathNameByHandleW` over a handle that followed every link: the
    // path Windows itself resolved to, with every `.` and `..` gone. It answers
    // in the `\\?\` form, which is taken off (`\\?\UNC\` back to `\\`) because
    // the result is for a person and for comparing, and the plain form is the
    // one both expect.
    private i64 real_path(string8 path, []char8 out):
        i64 cap = #len(out)
        if cap <= 0:
            return 0 - 1
        ref []u16 w = wide_path(path)
        defer #delete(w)
        if #len(w) == 0:
            return 0 - 1
        rawptr h = CreateFileW(&w[0], FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nil, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nil)
        if h == INVALID_HANDLE_VALUE:
            return 0 - 1
        ref []u16 buf = #make([]u16, 32768)
        defer #delete(buf)
        #c.ulong got = GetFinalPathNameByHandleW(h, &buf[0], 32767, VOLUME_NAME_DOS)
        _ = CloseHandle(h)
        if got == 0 || got >= 32767:
            return 0 - 1
        ref []char8 text = narrow(&buf[0], i64(got))
        defer #delete(text)
        string8 t = text
        ref []char8 plain = plain_form(t)
        defer #delete(plain)
        i64 n = #len(plain)
        if n >= cap:
            return 0 - 1
        for i in 0..<n:
            out[i] = plain[i]
        out[i32(n)] = '\0'
        return n

    // The text the link at `path` holds, written into `out` with a
    // terminator; answers its length, or -1 when `path` is not a link or the
    // text does not fit.
    private i64 read_link(string8 path, []char8 out):
        i64 cap = #len(out)
        if cap <= 0:
            return 0 - 1
        (ref []char8 text, bool got) = link_text(path)
        defer #delete(text)
        i64 n = #len(text)
        if !got || n >= cap:
            return 0 - 1
        for i in 0..<n:
            out[i] = text[i]
        out[i32(n)] = '\0'
        return n

    // Make one directory only its owner can open. Fails with `EXISTS` when
    // anything is already at `path`, and `UNSUPPORTED` on `#WEB`.
    //
    // On Windows: owner and `SYSTEM` only, through a protected DACL
    // (`windows.dado`), which is what `0700` says on POSIX.
    os.Error!void create_private_dir(string8 path):
        try create_private(path)
        return

// ── the web ─────────────────────────────────────────────────────────────────
//
// A page has no file system, and node's is not imported yet: nothing is ever
// there. Each answer is the one the hosted arms give for a path with nothing
// at it.
else when #OS == #WEB:
    private type Dir: (i32 unused)

    private ^Dir open(string8 path):
        return nil

    private void close(^Dir dir):
        return

    private (string8 name, bool ok) next(^Dir dir):
        return ("", false)

    bool is_dir(string8 path):
        return false

    bool is_file(string8 path):
        return false

    bool exists(string8 path):
        return false

    bool is_link(string8 path):
        return false

    bool is_executable(string8 path):
        return false

    os.Error!void make_executable(string8 path):
        fail os.Error.UNSUPPORTED

    os.Error!void create_private_dir(string8 path):
        fail os.Error.UNSUPPORTED

// ── POSIX: Linux, macOS and the BSDs ────────────────────────────────────────
else:
    // The members of `struct stat` this package reads, and `struct dirent`'s
    // name, read by name in C so no layout is restated (the file's head says
    // why). `posix_stat` and `posix_fstat` answer 0 and fill `out` with the
    // kind (`Kind`'s numbers, `files.dado`), the permission bits
    // (`st_mode & 07777`), the size, and the last write as seconds and
    // nanoseconds — `st_mtimespec` on Darwin and NetBSD, `st_mtim` elsewhere —
    // or answer -1 and leave `errno` as the call left it. `posix_seek` and
    // `posix_truncate` are `lseek` and `ftruncate` over `int64_t`, because
    // `off_t` is `long` on some systems and `long long` on others. Each is
    // `static inline` and marked unused, so a program that calls none of them
    // carries none and is not warned about it.
    private @c_body("""
        __attribute__((unused)) static inline void dadofs_fill(const struct stat *st, int64_t *out) {
            out[0] = S_ISREG(st->st_mode) ? 1 : S_ISDIR(st->st_mode) ? 2 : S_ISLNK(st->st_mode) ? 3 : 4;
            out[1] = (int64_t)(st->st_mode & 07777);
            out[2] = (int64_t)st->st_size;
        #if defined(__APPLE__) || defined(__NetBSD__)
            out[3] = (int64_t)st->st_mtimespec.tv_sec;
            out[4] = (int64_t)st->st_mtimespec.tv_nsec;
        #else
            out[3] = (int64_t)st->st_mtim.tv_sec;
            out[4] = (int64_t)st->st_mtim.tv_nsec;
        #endif
        }
        __attribute__((unused)) static inline int dadofs_stat(const char *path, int follow, int64_t *out) {
            struct stat st;
            if ((follow ? stat(path, &st) : lstat(path, &st)) != 0) return -1;
            dadofs_fill(&st, out);
            return 0;
        }
        __attribute__((unused)) static inline int dadofs_fstat(int fd, int64_t *out) {
            struct stat st;
            if (fstat(fd, &st) != 0) return -1;
            dadofs_fill(&st, out);
            return 0;
        }
        __attribute__((unused)) static inline int64_t dadofs_seek(int fd, int64_t offset, int whence) {
            return (int64_t)lseek(fd, (off_t)offset, whence);
        }
        __attribute__((unused)) static inline int dadofs_truncate(int fd, int64_t size) {
            return ftruncate(fd, (off_t)size);
        }
        __attribute__((unused)) static inline const char *dadofs_entry_name(const struct dirent *e) {
            return e->d_name;
        }
        """) i32 g_posix_accessors = 0

    // The five numbers `posix_stat` fills, in order.
    private type StatOut: [5]i64

    // `realpath` and `lstat` are the calls a feature-test macro is needed
    // for: glibc guards them behind `__USE_XOPEN_EXTENDED`/`__USE_MISC`.
    //
    // **`_DEFAULT_SOURCE` and not `_XOPEN_SOURCE 700`.** A `define` clause is
    // emitted above *every* `#include` in the whole program's translation
    // unit, not just this package's — so a feature macro here is one every
    // other package in the program gets. `_DEFAULT_SOURCE` only *widens* what
    // glibc declares; `_XOPEN_SOURCE 700` would also suppress the set glibc
    // turns on by itself when nothing asks. `_DARWIN_C_SOURCE` is the same
    // widening on Darwin and is inert on Linux, as `_DEFAULT_SOURCE` is on
    // Darwin.
    private foreign pst "sys/stat.h" define "_DEFAULT_SOURCE=1" define "_DARWIN_C_SOURCE=1":
        #c.int dadofs_stat(cstring path, #c.int follow, ^i64 out)
        #c.int dadofs_fstat(#c.int fd, ^i64 out)
        i64 dadofs_seek(#c.int fd, i64 offset, #c.int whence)
        #c.int dadofs_truncate(#c.int fd, i64 size)

    // `mkdir`'s and `chmod`'s mode is a `mode_t`, which is `unsigned int` on
    // glibc, musl, NetBSD and OpenBSD and `unsigned short` on Darwin and
    // FreeBSD. It needs an arm: the emitter asserts each restated signature's C
    // type with `_Generic`, and `unsigned int` is not `unsigned short`.
    when #OS == #DARWIN || #OS == #FREEBSD:
        private foreign mk "sys/stat.h":
            #c.int mkdir(cstring path, #c.ushort mode)
            #c.int chmod(cstring path, #c.ushort mode)

        private bool chmod_to(cstring path, u32 mode): return mk.chmod(path, #c.ushort(mode)) == 0
        private bool mkdir_to(cstring path, u32 mode): return mk.mkdir(path, #c.ushort(mode)) == 0
    else:
        private foreign mk "sys/stat.h":
            #c.int mkdir(cstring path, #c.uint mode)
            #c.int chmod(cstring path, #c.uint mode)

        private bool chmod_to(cstring path, u32 mode): return mk.chmod(path, #c.uint(mode)) == 0
        private bool mkdir_to(cstring path, u32 mode): return mk.mkdir(path, #c.uint(mode)) == 0

    // `DIR` and `struct dirent` are opaque here: bodiless `foreign` types,
    // complete enough to have a pointer to and nothing else. The name is read
    // through `dadofs_entry_name`.
    private foreign "dirent.h" define "Dirent=struct dirent":
        type DIR
        type Dirent
        ^DIR opendir(cstring path)
        #c.int closedir(^DIR d)
        ^Dirent readdir(^DIR d)
        cstring dadofs_entry_name(^const Dirent e)

    // **`realpath(path, nil)`, not a caller-sized buffer.** POSIX.1-2008 makes
    // a null second argument mean *allocate the answer*, which deletes this
    // package's `PATH_MAX` question. The buffer is `free`d before this package
    // returns, on every path out.
    private foreign "stdlib.h" define "_DEFAULT_SOURCE=1" define "_DARWIN_C_SOURCE=1":
        ^#c.char realpath(cstring path, ^#c.char resolved)
        void free(rawptr p)

    // **`memcpy` carries `@macro` and `strlen` does not.** On macOS,
    // `<string.h>` defines `memcpy` as a macro under the fortified headers, so
    // an unmarked declaration — which the emitter checks is no macro — is a
    // build error there. `@macro` declines that check for `memcpy` alone; an
    // unmarked `foreign` function surviving a build is proved to name a real
    // symbol, and marking one gives that up.
    private foreign "string.h":
        #c.size_t strlen(cstring s)
        @macro rawptr memcpy(rawptr dst, rawptr src, #c.size_t nbytes)

    // A byte buffer handed to C as the `char *` the header declares: a
    // restatement saying `rawptr` there is a `void *` the header does not have.
    private type CharBuf: ^#c.char

    // Bound as `sys`. **`access` and not a mode read** answers *"can this be
    // executed"*, which is a question about the caller's own permissions and
    // not the bits.
    private foreign sys "unistd.h":
        #c.int symlink(cstring target, cstring path)
        #c.long readlink(cstring path, ^#c.char buf, #c.size_t nbytes)
        #c.int access(cstring path, i32 mode)
        const i32 X_OK

    // The handle, under the name this package writes.
    private type Dir: DIR

    // `symlink(2)`: `target` stored as written, at `path`; whether it was made.
    private bool symlink_to(cstring target, cstring path):
        return sys.symlink(target, path) == 0

    // What `posix_stat` read of `path`, following links or not, and whether
    // it could read anything.
    private (StatOut st, bool ok) posix_stat(cstring path, bool follow):
        StatOut st
        if path == nil: return (st, false)
        #c.int f = 0
        if follow: f = 1
        if pst.dadofs_stat(path, f, &st[0]) != 0: return (st, false)
        return (st, true)

    // `posix_stat` of a `string8`, terminated for the call.
    private (StatOut st, bool ok) stat_of(string8 path, bool follow):
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if cp == nil:
            StatOut none
            return (none, false)
        return posix_stat(cstring(cp), follow)

    // ── walking a directory ───────────────────────────────────────────────────

    private ^Dir open(string8 path):
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if cp == nil: return nil
        return opendir(cstring(cp))

    private void close(^Dir dir):
        if dir != nil:
            _ = closedir(dir)

    // `.` and `..` are included, because filtering them is a policy and this
    // is not the layer for one — `hidden` is the policy. The bytes belong to
    // the directory stream, so the name is good until the next `next` on the
    // same handle.
    private (string8 name, bool ok) next(^Dir dir):
        if dir == nil:
            return ("", false)
        ^Dirent e = readdir(dir)
        if e == nil:
            return ("", false)
        return (string8(dadofs_entry_name(e)), true)

    // ── asking about a path ───────────────────────────────────────────────────

    // `stat` follows symlinks, which is what a program listing a tree almost
    // always means, and a path that does not exist is not an error here — it
    // is `false`.
    bool is_dir(string8 path):
        (StatOut st, bool got) = stat_of(path, true)
        return got && st[0] == i64(Kind.Dir)

    bool is_file(string8 path):
        (StatOut st, bool got) = stat_of(path, true)
        return got && st[0] == i64(Kind.File)

    bool exists(string8 path):
        (StatOut _, bool got) = stat_of(path, true)
        return got

    // **The one predicate in this file that does not follow links**: `stat`
    // resolves, so a dangling link reports `exists=false`, and `lstat` is what
    // tells it from nothing being there.
    bool is_link(string8 path):
        (StatOut st, bool got) = stat_of(path, false)
        return got && st[0] == i64(Kind.Link)

    bool is_executable(string8 path):
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if cp == nil: return false
        return sys.access(cstring(cp), sys.X_OK) == 0

    // The three read bits, `0444`, in the hex this language writes. Two places
    // right of each read bit is the class's execute bit — `0444 >> 2` is
    // `0111`.
    private const u32 READ_BITS = 0x124

    // The execute bit is added **for each class that can already read the
    // file**: `0600` becomes `0700` and not `0711`, which is `chmod +x`'s own
    // answer under the usual umask without depending on the umask. Already
    // executable is success.
    os.Error!void make_executable(string8 path):
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if cp == nil: fail os.Error.NO_MEMORY
        (StatOut st, bool got) = posix_stat(cstring(cp), true)
        if !got: try failed()
        u32 mode = u32(st[1])
        u32 want = mode | ((mode & READ_BITS) >> 2)
        if want == mode: return
        if !chmod_to(cstring(cp), want): try failed()
        return

    // The permission bits of `path`, and whether there were any to read.
    private (u32 mode, bool ok) mode_bits(cstring path):
        (StatOut st, bool got) = posix_stat(path, true)
        if !got: return (0, false)
        return (u32(st[1]), true)

    // Whether `path` itself exists — a link is not followed — and whether it
    // is a directory. `remove_all`'s question, because it must never enter a
    // link.
    private (bool there, bool dir) lstat_kind(cstring path):
        (StatOut st, bool got) = posix_stat(path, false)
        if !got: return (false, false)
        return (true, st[0] == i64(Kind.Dir))

    // When `path` (followed) was last written, in nanoseconds since the Unix
    // epoch.
    private (i64 ns, bool ok) mtime_of(cstring path):
        (StatOut st, bool got) = posix_stat(path, true)
        if !got: return (0, false)
        return (st[3] * 1000000000 + st[4], true)

    // ── canonicalization ──────────────────────────────────────────────────────

    // `realpath` into the caller's `out`, with the terminator copied too, so
    // a result that exactly fills `out` is refused rather than handed back
    // unterminated. The length, or -1.
    private i64 real_path(string8 path, []char8 out):
        i64 cap = #len(out)
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if cp == nil || cap <= 0:
            return 0 - 1
        rawptr got = rawptr(realpath(cstring(cp), nil))
        if got == nil:
            return 0 - 1
        i64 n = i64(strlen(cstring(got)))
        if n >= cap:
            free(got)
            return 0 - 1
        _ = memcpy(rawptr(&out[0]), got, #c.size_t(n + 1))
        free(got)
        return n

    // **The one hop, and not the resolution** — `real_path` is the resolution.
    // `readlink` does not terminate what it writes, so this does.
    private i64 read_link(string8 path, []char8 out):
        i64 cap = #len(out)
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if cp == nil || cap <= 0:
            return 0 - 1
        i64 n = i64(sys.readlink(cstring(cp), CharBuf(rawptr(&out[0])), #c.size_t(cap)))
        if n < 0 || n >= cap:
            return 0 - 1
        out[i32(n)] = '\0'
        return n

    // The mode `0700` (`0x1C0`). **`EXISTS` when anything is already at
    // `path`**, a directory or a symbolic link included, because `mkdir` never
    // opens an existing name: a caller that gets success made the directory
    // itself, so nobody else chose what is in it.
    os.Error!void create_private_dir(string8 path):
        ref []char8 cp = c_path(path)
        defer #delete(cp)
        if cp == nil: fail os.Error.NO_MEMORY
        if !mkdir_to(cstring(cp), 0x1C0): try failed()
        return
