@test
// What raises into a script. `#assert_raises` stands only above a
// package-level function, so `FileInfo`'s methods and a `Listing`'s
// `destroy` cannot carry it themselves: the promised function here calls each
// of them, with `hidden` and the enums, and the build refuses (ERR1227) if any
// reaches something a script cannot run.
package fs

#assert_raises
private bool pure(FileInfo i, string8 name):
    bool kinds = i.is_file() || i.is_dir() || i.is_link() || i.kind == Kind.Other
    Open flags = Open.Read | Open.Write | Open.Append | Open.Create | Open.Truncate | Open.Exclusive
    Listing l = (#make([]char8, 0), #make([]Entry, 0))
    l.destroy()
    return kinds && hidden(name) && i32(flags) == 63

i32 test():
    FileInfo f = (Kind.File, 0x1A4, 5, 0)
    FileInfo d = (Kind.Dir, 0x1ED, 0, 0)
    FileInfo l = (Kind.Link, 0x1FF, 4, 0)
    bool ok = #expect(f.is_file() && !f.is_dir() && !f.is_link(), "a file's kind") && true
    ok = #expect(d.is_dir() && !d.is_file(), "a directory's kind") && ok
    ok = #expect(l.is_link() && !l.is_file(), "a link's kind") && ok
    ok = #expect(pure(f, ".dot") && !pure(f, "a"), "the promised probe") && ok
    return 0 if ok else 1
