@test
// An open `File` (`handle.dado`): written, read back, moved about in, cut,
// synced, described and locked, under a directory `make_temp_dir` made. On
// `#WEB` no file opens, and `info_test` claims that.
package fs

import "core:mem/libc"
import "core:io"
import "core:os"

private bool reads_back(File f, string8 want, string8 what):
    try _ = f.seek(0) else code:
        return #expect(false, what, ": seek failed: ", os.message(code))
    [64]char8 buf
    try i64 n = f.read(buf[:]) else code2:
        return #expect(false, what, ": read failed: ", os.message(code2))
    string8 got = string8(buf[0..<n])
    return #expect(got == want, what, ": read '", got, "', not '", want, "'")

private bool hosted(string8 root):
    bool ok = true
    ref []char8 p = #format(root, "/f.bin")
    defer #delete(p)

    try File f = open_file(p, Open.Read | Open.Write | Open.Create | Open.Exclusive) else code:
        return #expect(false, "open_file failed: ", os.message(code))
    File again = (0 - 1, nil, false)
    try again = open_file(p, Open.Read | Open.Write | Open.Create | Open.Exclusive) else code1:
        ok = #expect(code1 == os.Error.EXISTS, "a second Open.Exclusive open failed with ", os.message(code1)) && ok
    again.close()

    try i64 wrote = f.write("hello, world") else code2:
        f.close()
        return #expect(false, "write failed: ", os.message(code2))
    ok = #expect(wrote == 12, "write answered ", wrote) && ok
    ok = reads_back(f, "hello, world", "after write") && ok

    try i64 at = f.seek(0 - 5, io.Whence.End) else code3:
        f.close()
        return #expect(false, "seek from the end failed: ", os.message(code3))
    ok = #expect(at == 7, "seek(-5, io.Whence.End) answered ", at) && ok
    try _ = f.write("WORLD") else code4:
        ok = #expect(false, "write failed: ", os.message(code4)) && ok
    ok = reads_back(f, "hello, WORLD", "after overwrite") && ok
    try _ = f.seek(0 - 1, io.Whence.Start) else code5:
        ok = #expect(code5 == os.Error.INVALID, "seek before the start failed with ", os.message(code5)) && ok

    try _ = f.seek(3) else code6:
        ok = #expect(false, "seek failed: ", os.message(code6)) && ok
    try f.truncate(5) else code7:
        ok = #expect(false, "truncate failed: ", os.message(code7)) && ok
    i64 still = 0 - 1
    try still = f.seek(0, io.Whence.Current) else code8:
        ok = #expect(false, "seek failed: ", os.message(code8)) && ok
    ok = #expect(still == 3, "truncate moved the position to ", still) && ok
    ok = reads_back(f, "hello", "after truncate") && ok
    try f.sync() else code9:
        ok = #expect(false, "sync failed: ", os.message(code9)) && ok
    FileInfo i = (0, 0, 0 - 1, 0)
    try i = f.info() else code10:
        ok = #expect(false, "File.info failed: ", os.message(code10)) && ok
    ok = #expect(i.is_file() && i.size == 5, "File.info: kind ", i.kind, " size ", i.size) && ok

    // Locks: an exclusive one, then a shared one on a second handle is
    // refused without waiting on POSIX (`flock` locks are per open file) and
    // on Windows.
    try f.lock(true) else code11:
        ok = #expect(false, "lock failed: ", os.message(code11)) && ok
    try File g = open_file(p, Open.Read) else code12:
        f.close()
        return #expect(false, "a second open failed: ", os.message(code12))
    bool got = true
    try got = g.try_lock(false) else code13:
        ok = #expect(false, "try_lock failed: ", os.message(code13)) && ok
    ok = #expect(!got, "a shared lock was taken while an exclusive one was held") && ok
    try f.unlock() else code14:
        ok = #expect(false, "unlock failed: ", os.message(code14)) && ok
    bool got2 = false
    try got2 = g.try_lock(false) else code15:
        ok = #expect(false, "try_lock failed: ", os.message(code15)) && ok
    ok = #expect(got2, "a shared lock was refused once nothing was held") && ok
    try g.unlock() else code16:
        ok = #expect(false, "unlock failed: ", os.message(code16)) && ok
    g.close()
    f.close()
    f.close()
    try _ = f.write("x") else code17:
        ok = #expect(code17 == os.Error.INVALID, "writing a closed File failed with ", os.message(code17)) && ok

    // `Open.Append` writes at the end, wherever the position is.
    try File a = open_file(p, Open.Write | Open.Append) else code18:
        return #expect(false, "open for append failed: ", os.message(code18))
    try _ = a.write("!") else code19:
        ok = #expect(false, "append failed: ", os.message(code19)) && ok
    a.close()
    try ref []char8 whole = read_file(p) else code20:
        return #expect(false, "read_file failed: ", os.message(code20))
    string8 w = whole
    ok = #expect(w == "hello!", "after append the file is '", w, "'") && ok
    #delete(whole)

    // Bytes beside text: `write_bytes` and `read_bytes` move `u8`s through
    // the same position.
    try File bf = open_file(p, Open.Read | Open.Write | Open.Truncate) else code20b:
        return #expect(false, "open for bytes failed: ", os.message(code20b))
    [4]u8 four = [0, 255, 10, 128]
    i64 put = 0
    try put = bf.write_bytes(four[:]) else code20c:
        ok = #expect(false, "write_bytes failed: ", os.message(code20c)) && ok
    ok = #expect(put == 4, "write_bytes answered ", put) && ok
    try _ = bf.seek(0) else code20d:
        ok = #expect(false, "seek failed: ", os.message(code20d)) && ok
    [8]u8 back
    i64 n = 0
    try n = bf.read_bytes(back[:]) else code20e:
        ok = #expect(false, "read_bytes failed: ", os.message(code20e)) && ok
    ok = #expect(n == 4 && back[0] == 0 && back[1] == 255 && back[2] == 10 && back[3] == 128, "read_bytes read ", n, " bytes back differently") && ok
    i64 at_end = 0 - 1
    try at_end = bf.read_bytes(back[:]) else code20f:
        ok = #expect(false, "read_bytes at the end failed: ", os.message(code20f)) && ok
    ok = #expect(at_end == 0, "read_bytes at the end answered ", at_end) && ok
    i64 nothing = 0 - 1
    try nothing = bf.read_bytes(back[0..<0]) else code20g:
        ok = #expect(false, "read_bytes into nothing failed: ", os.message(code20g)) && ok
    ok = #expect(nothing == 0, "read_bytes into nothing answered ", nothing) && ok
    bf.close()
    try _ = bf.write_bytes(four[:]) else code20h:
        ok = #expect(code20h == os.Error.INVALID, "write_bytes on a closed File failed with ", os.message(code20h)) && ok

    File d = (0 - 1, nil, false)
    try d = open_file(root, Open.Read) else code21:
        ok = #expect(code21 == os.Error.IS_DIR, "opening a directory failed with ", os.message(code21)) && ok
    d.close()
    File none = (0 - 1, nil, false)
    try none = open_file(p, Open(0)) else code22:
        ok = #expect(code22 == os.Error.INVALID, "open_file with no access failed with ", os.message(code22)) && ok
    none.close()
    return ok

i32 test():
    when #OS == #WEB:
        return 0
    else:
        using libc.allocator():
            try ref []char8 root = make_temp_dir("dado-handle-test-") else code:
                _ = #expect(false, "make_temp_dir failed: ", os.message(code))
                return 1
            string8 r = root
            bool ok = hosted(r)
            try remove_all(r) else code2:
                ok = #expect(false, "remove_all failed: ", os.message(code2)) && ok
            #delete(root)
            return 0 if ok else 1
