@test
// The failable half of `core:os/fs`, on whichever system the test is built
// for: whole files, removing and moving, copying, `mtime`, temp directories
// and links — each claimed against what the test put on the disk, and each
// failure against the `os` code it must carry.
//
// Everything happens under a directory `make_temp_dir` made, which is removed
// by `remove_all` at the end.
package fs

import "core:mem/libc"
import "core:os"
import "core:strings"
import "core:time"

// `root` joined to `name` with `/`, which every system here reads as a
// separator.
private ref []char8 at(string8 root, string8 name):
    return #format(root, "/", name)

// The whole of `path` is `want`.
private bool holds(string8 path, string8 want):
    try ref []char8 got = read_file(path) else code:
        return #expect(false, "read_file(", path, ") failed: ", os.message(code))
    string8 g = got
    bool same = g == want
    bool ok = #expect(same, "read_file(", path, ") read '", g, "' not '", want, "'")
    #delete(got)
    return ok

// An allocator that refuses everything.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil

// The names directly in `dir`, but `.` and `..`.
private i32 entries(string8 dir):
    ^Dir d = open(dir)
    if d == nil: return 0 - 1
    i32 n = 0
    for:
        (string8 nm, bool more) = next(d)
        if !more: break
        if nm != "." && nm != "..": n += 1
    close(d)
    return n

private bool listed(string8 dir, string8 want):
    ^Dir d = open(dir)
    if d == nil: return false
    bool found = false
    for:
        (string8 name, bool more) = next(d)
        if !more: break
        if name == want: found = true
    close(d)
    return found

// The code `read_file(path)` fails with, or 0 when it reads.
private os.Error read_code(string8 path):
    try ref []char8 got = read_file(path) else code:
        return code
    #delete(got)
    return os.Error(0)

private os.Error temp_dir_code(string8 prefix):
    try ref []char8 made = make_temp_dir(prefix) else code:
        return code
    string8 m = made
    try remove_dir(m) else code:
        #delete(made)
        return code
    #delete(made)
    return os.Error(0)

private bool there(string8 path):
    return exists(path) || is_link(path)

i32 test():
    // No disk on the web: `info_test` claims what each function answers there.
    when #OS == #WEB:
        return 0
    using libc.allocator():
        bool ok = true
        try ref []char8 root_bytes = make_temp_dir("dado-files-test-") else code:
            #expect(false, "make_temp_dir failed: ", os.message(code))
            return 1
        string8 root = root_bytes
        ok = #expect(there(root) && entries(root) == 0, "the temp directory is there and empty") && ok

        // ── temp directories ─────────────────────────────────────────────────
        try ref []char8 other = make_temp_dir("dado-files-test-") else code:
            ok = #expect(false, "a second make_temp_dir failed: ", os.message(code)) && ok
            return 1
        string8 o = other
        ok = #expect(o != root, "two temp directories share a name") && ok
        try remove_dir(o) else code:
            ok = #expect(false, "remove_dir of an empty temp directory failed: ", os.message(code)) && ok
        #delete(other)
        os.Error bad = temp_dir_code("a/b")
        ok = #expect(bad == os.Error.INVALID, "make_temp_dir(\"a/b\") answered ", bad, " not INVALID") && ok

        // ── whole files ──────────────────────────────────────────────────────
        ref []char8 f = at(root, "file.txt")
        string8 fp = f
        try write_file(fp, "first") else code:
            ok = #expect(false, "write_file of a new file failed: ", os.message(code)) && ok
        ok = holds(fp, "first") && ok

        // **Atomic replacement**: the second write replaces the first whole,
        // and nothing of the temp file it went through is left beside it.
        try write_file(fp, "second, and longer") else code:
            ok = #expect(false, "write_file over an existing file failed: ", os.message(code)) && ok
        ok = holds(fp, "second, and longer") && ok
        ok = #expect(entries(root) == 1, "write_file left ", entries(root), " entries; a temp file survived") && ok

        // Empty, and bytes that are not text.
        try write_file(fp, "") else code:
            ok = #expect(false, "write_file of nothing failed: ", os.message(code)) && ok
        ok = holds(fp, "") && ok
        try write_file(fp, "a\0b\r\n\xFFc") else code:
            ok = #expect(false, "write_file of binary bytes failed: ", os.message(code)) && ok
        ok = holds(fp, "a\0b\r\n\xFFc") && ok

        ref []char8 missing = at(root, "no-such-file")
        string8 mp = missing
        os.Error code1 = read_code(mp)
        ok = #expect(code1 == os.Error.NOT_FOUND, "read_file of nothing answered ", code1, " not NOT_FOUND") && ok
        os.Error code2 = read_code(root)
        ok = #expect(code2 == os.Error.IS_DIR, "read_file of a directory answered ", code2, " not IS_DIR") && ok
        ref []char8 in_missing = at(root, "no-such-dir/file")
        try write_file(string8(in_missing[:]), "x") else code3:
            ok = #expect(code3 == os.Error.NOT_FOUND, "write_file into a missing directory failed with ", code3, " not NOT_FOUND") && ok

        // ── a UTF-8 name round-trips ─────────────────────────────────────────
        ref []char8 wide = at(root, "été €日 𝄞.txt")
        string8 wp = wide
        try write_file(wp, "héllo") else code:
            ok = #expect(false, "write_file of a UTF-8 name failed: ", os.message(code)) && ok
        ok = holds(wp, "héllo") && ok
        ok = #expect(listed(root, "été €日 𝄞.txt"), "the listing did not name the UTF-8 file byte for byte") && ok

        // ── copy and rename, each replacing its target ───────────────────────
        ref []char8 copy = at(root, "copy.txt")
        string8 cp = copy
        try write_file(cp, "to be replaced") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        try copy_file(wp, cp) else code:
            ok = #expect(false, "copy_file failed: ", os.message(code)) && ok
        ok = holds(cp, "héllo") && ok
        ok = holds(wp, "héllo") && ok
        try copy_file(mp, cp) else code4:
            ok = #expect(code4 == os.Error.NOT_FOUND, "copy_file of nothing failed with ", code4) && ok

        try rename(cp, fp) else code:
            ok = #expect(false, "rename over an existing file failed: ", os.message(code)) && ok
        ok = holds(fp, "héllo") && ok
        ok = #expect(!there(cp), "rename left its source behind") && ok
        try rename(mp, fp) else code5:
            ok = #expect(code5 == os.Error.NOT_FOUND, "rename of nothing failed with ", code5) && ok

        // ── mtime, on the wall clock ─────────────────────────────────────────
        i64 written = 0
        try written = mtime(fp) else code:
            ok = #expect(false, "mtime failed: ", os.message(code)) && ok
        i64 now = time.unix_nanos()
        i64 day = 86400 * 1000000000
        ok = #expect(written > now - day && written < now + day, "mtime ", written, " is not within a day of now ", now) && ok
        i64 never = 0
        try never = mtime(mp) else code6:
            ok = #expect(code6 == os.Error.NOT_FOUND, "mtime of nothing failed with ", code6) && ok
        ok = #expect(never == 0, "mtime of nothing answered ", never) && ok

        // ── removing ─────────────────────────────────────────────────────────
        try remove_file(fp) else code:
            ok = #expect(false, "remove_file failed: ", os.message(code)) && ok
        ok = #expect(!there(fp), "remove_file left the file") && ok
        try remove_file(fp) else code7:
            ok = #expect(code7 == os.Error.NOT_FOUND, "a second remove_file failed with ", code7) && ok

        ref []char8 sub = at(root, "sub")
        string8 sp = sub
        try create_dir(sp) else code:
            ok = #expect(false, "create_dir sub failed: ", os.message(code)) && ok
        ref []char8 inner = at(sp, "inner.txt")
        try write_file(string8(inner[:]), "x") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        try remove_dir(sp) else code8:
            ok = #expect(code8 == os.Error.NOT_EMPTY, "remove_dir of a full directory failed with ", code8, " not NOT_EMPTY") && ok
        try remove_file(sp) else code9:
            ok = #expect(code9 == os.Error.IS_DIR || code9 == os.Error.PERMISSION, "remove_file of a directory failed with ", code9) && ok
        try remove_file(string8(inner[:])) else code:
            ok = #expect(false, "remove_file failed: ", os.message(code)) && ok
        try remove_dir(sp) else code:
            ok = #expect(false, "remove_dir of an empty directory failed: ", os.message(code)) && ok
        ok = #expect(!there(sp), "remove_dir left the directory") && ok

        // ── remove_all, of a nested tree with a link out of it ───────────────
        ref []char8 outside = at(root, "outside")
        string8 op = outside
        ref []char8 kept = at(op, "kept.txt")
        ref []char8 tree = at(root, "tree")
        string8 tp = tree
        ref []char8 leaf_dir = #format(tp, "/a/b/c")
        try make_dirs(op) else code:
            ok = #expect(false, "make_dirs failed: ", os.message(code)) && ok
        try make_dirs(leaf_dir) else code:
            ok = #expect(false, "make_dirs of the tree failed: ", os.message(code)) && ok
        try write_file(string8(kept[:]), "keep me") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        ref []char8 l1 = #format(tp, "/a/one.txt")
        ref []char8 l2 = #format(tp, "/a/b/two.txt")
        ref []char8 l3 = #format(tp, "/a/b/c/three.txt")
        try write_file(string8(l1[:]), "1") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        try write_file(string8(l2[:]), "2") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        try write_file(string8(l3[:]), "3") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        // A link inside the tree to a directory outside it. `remove_all` must
        // remove the link and leave what it points at. Where the system
        // refuses the link (Windows without the privilege), the refusal is
        // the claim instead.
        ref []char8 link = #format(tp, "/a/b/out")
        bool linked = true
        try make_symlink(op, string8(link[:])) else code:
            linked = false
            ok = #expect(code == os.Error.PRIVILEGE || code == os.Error.UNSUPPORTED, "make_symlink failed with ", code, ": ", os.message(code)) && ok
            string8 sentence = os.message(code)
            ok = #expect(#len(sentence) > 0, "the refusal has no sentence") && ok
        if linked:
            ok = #expect(is_link(link), "the link is a link") && ok
        try remove_all(tp) else code:
            ok = #expect(false, "remove_all of a nested tree failed: ", os.message(code)) && ok
        ok = #expect(!there(tp), "remove_all left the tree") && ok
        ok = holds(string8(kept[:]), "keep me") && ok
        try remove_all(tp) else code:
            ok = #expect(false, "remove_all of nothing is success, and failed: ", os.message(code)) && ok

        // A file, and a link, are each removed by `remove_all` as themselves.
        ref []char8 lone = at(root, "lone.txt")
        try write_file(string8(lone[:]), "x") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        try remove_all(string8(lone[:])) else code:
            ok = #expect(false, "remove_all of a file failed: ", os.message(code)) && ok
        ok = #expect(!there(string8(lone[:])), "remove_all left the file") && ok

        // ── a long path ──────────────────────────────────────────────────────
        // Past 260 bytes, which is Windows' `MAX_PATH`: the `\\?\` route there,
        // and an ordinary path on POSIX.
        ref []char8 long_dir = #format(root, "")
        ok = #expect(#len(long_dir) > 300, "the long path is not long") && ok
        try make_dirs(long_dir) else code:
            ok = #expect(false, "make_dirs of a path past MAX_PATH failed: ", os.message(code)) && ok
        ref []char8 long_file = #format(string8(long_dir[:]), "/file.txt")
        try write_file(string8(long_file[:]), "deep") else code:
            ok = #expect(false, "write_file past MAX_PATH failed: ", os.message(code)) && ok
        ok = holds(string8(long_file[:]), "deep") && ok
        ref []char8 long_top = at(root, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
        try remove_all(string8(long_top[:])) else code:
            ok = #expect(false, "remove_all past MAX_PATH failed: ", os.message(code)) && ok
        ok = #expect(!there(string8(long_top[:])), "remove_all left the long tree") && ok

        // ── a link, made and read ────────────────────────────────────────────
        ref []char8 target_file = at(root, "target.txt")
        try write_file(string8(target_file[:]), "t") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        ref []char8 ln = at(root, "ln")
        try make_symlink("target.txt", string8(ln[:])) else code:
            ok = #expect(code == os.Error.PRIVILEGE || code == os.Error.UNSUPPORTED, "make_symlink failed with ", code) && ok
        if there(string8(ln[:])):
            ok = holds(string8(ln[:]), "t") && ok
            try make_symlink("target.txt", string8(ln[:])) else code10:
                ok = #expect(code10 == os.Error.EXISTS, "make_symlink over an existing name failed with ", code10, " not EXISTS") && ok
        try make_symlink("", string8(ln[:])) else code11:
            ok = #expect(code11 == os.Error.INVALID, "make_symlink to nothing failed with ", code11) && ok

        // ── bytes, beside text ───────────────────────────────────────────────
        // Every byte value, written as `u8`s and read back both ways, with no
        // copy between the two forms.
        ref []char8 bin = at(root, "all.bin")
        ref []u8 every = #make([]u8, 256)
        for i in 0..<256:
            every[i] = u8(i)
        try write_bytes(bin, every) else code:
            ok = #expect(false, "write_bytes failed: ", os.message(code)) && ok
        try ref []u8 back = read_bytes(bin) else code:
            ok = #expect(false, "read_bytes failed: ", os.message(code))
            return 1
        bool same = #len(back) == 256
        if same:
            for i in 0..<256:
                if back[i] != u8(i): same = false
        ok = #expect(same, "read_bytes did not read back every byte: ", #len(back)) && ok
        try ref []char8 as_text = read_file(bin) else code:
            ok = #expect(false, "read_file of a binary file failed: ", os.message(code))
            return 1
        ok = #expect(#len(as_text) == 256 && as_text[255] == char8(255), "read_file read the bytes differently") && ok
        #delete(as_text)
        #delete(back)
        ref []u8 none_bytes
        try none_bytes = read_bytes(mp) else code:
            ok = #expect(code == os.Error.NOT_FOUND, "read_bytes of nothing failed with ", os.message(code)) && ok
            none_bytes = nil
        #delete(none_bytes)
        try write_bytes(bin, every[0..<0]) else code:
            ok = #expect(false, "write_bytes of nothing failed: ", os.message(code)) && ok
        try ref []u8 empty = read_bytes(bin) else code:
            ok = #expect(false, "read_bytes of an empty file failed: ", os.message(code))
            return 1
        ok = #expect(#len(empty) == 0, "an empty file read ", #len(empty), " bytes") && ok
        #delete(empty)
        #delete(every)

        // A file larger than one read step grows the run and keeps every byte.
        ref []u8 big = #make([]u8, 200000)
        for i in 0..<200000:
            big[i] = u8(i % 251)
        try write_bytes(bin, big) else code:
            ok = #expect(false, "write_bytes of 200000 bytes failed: ", os.message(code)) && ok
        try ref []u8 big_back = read_bytes(bin) else code:
            ok = #expect(false, "read_bytes of 200000 bytes failed: ", os.message(code))
            return 1
        bool big_same = #len(big_back) == 200000
        if big_same:
            for i in 0..<200000:
                if big_back[i] != u8(i % 251): big_same = false
        ok = #expect(big_same, "a 200000-byte file read back as ", #len(big_back), " different bytes") && ok
        #delete(big_back)
        #delete(big)

        // **No memory is NO_MEMORY**, not a short or empty read.
        (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) nothing = (refuses, nil)
        using nothing:
            ref []char8 t
            try t = read_file(bin) else code:
                ok = #expect(code == os.Error.NO_MEMORY, "read_file without memory failed with ", os.message(code)) && ok
                t = nil
            ok = #expect(t == nil, "read_file without memory answered text") && ok
            ref []u8 u
            try u = read_bytes(bin) else code:
                ok = #expect(code == os.Error.NO_MEMORY, "read_bytes without memory failed with ", os.message(code)) && ok
                u = nil
            ok = #expect(u == nil, "read_bytes without memory answered bytes") && ok
        #delete(bin)

        try remove_all(root) else code:
            ok = #expect(false, "remove_all of the scratch root failed: ", os.message(code)) && ok
        ok = #expect(!there(root), "the scratch root survived") && ok

        #delete(ln)
        #delete(target_file)
        #delete(long_top)
        #delete(long_file)
        #delete(long_dir)
        #delete(lone)
        #delete(link)
        #delete(l3)
        #delete(l2)
        #delete(l1)
        #delete(leaf_dir)
        #delete(tree)
        #delete(kept)
        #delete(outside)
        #delete(inner)
        #delete(sub)
        #delete(copy)
        #delete(wide)
        #delete(in_missing)
        #delete(missing)
        #delete(f)
        #delete(root_bytes)
        if ok: return 0
        return 1
