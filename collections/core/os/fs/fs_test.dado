@test
// core:os/fs — the platform's answers, run rather than typechecked.
//
// **Every function here is a claim about the system's headers**, `struct
// stat`'s members included. A test that only compiled would prove the
// declarations parse and nothing about whether the size read is the file's —
// so each block below builds something on the disk, asks this package about
// it, and checks the answer against what it built. On `#WEB` there is no disk,
// and `info_test` claims what every function answers there.
//
// The scratch tree is made under `/tmp` (the user's temp directory on
// Windows), removed at the start of the run rather than at the end (a failing
// run leaves its evidence behind), and every path into it is absolute so the
// `change_dir` block cannot move the ground under the rest.
package fs

import "core:mem/libc"
import "core:strings"
import "core:os"

when #OS == #WINDOWS:
    // The same questions as the POSIX test below, asked of a scratch tree
    // under the user's temp directory, with Windows' own answers where they
    // differ: a drive-letter root, no execute bit, and symbolic links that
    // need a privilege.
    i32 test():
        using libc.allocator():
            return windows_test()

    // A path under `root`.
    private ref []char8 under(string8 root, string8 name):
        return #format(root, "\\", name)

    private i32 windows_test():
        bool ok = true
        ref []char8 b = #make([]char8, 4096)
        []char8 win = b[0..<i32(#len(b))]

        try ref []char8 root_bytes = make_temp_dir("dado-fs-test-") else why:
            #expect(false, "make_temp_dir failed: ", os.message(why))
            return 1
        string8 root = root_bytes

        // ── realpath ─────────────────────────────────────────────────────────
        i64 n1 = real_path(root, win)
        ok = #expect(n1 > 3 && win[1] == ':' && win[2] == '\\', "real_path of the scratch root is a drive path, got ", n1) && ok
        ok = #expect(real_path("Z:\\no_such_dir_zqx_98765\\nope", win) == 0 - 1, "real_path of nothing is -1") && ok
        []char8 tiny = b[0..<2]
        ok = #expect(real_path(root, tiny) == 0 - 1, "real_path into a too-small buffer is -1") && ok

        // ── making, and asking ───────────────────────────────────────────────
        ref []char8 d1 = under(root, "d")
        try create_dir(d1) else why:
            ok = #expect(false, "create_dir failed: ", os.message(why)) && ok
        try create_dir(d1) else why2:
            ok = #expect(why2 == os.Error.EXISTS, "create_dir on an existing path failed ", os.message(why2)) && ok
        ok = #expect(is_dir(d1) && !is_file(d1) && exists(d1), "a directory answers as one") && ok
        ref []char8 priv = under(root, "private")
        try create_private_dir(priv) else why3:
            ok = #expect(false, "create_private_dir failed: ", os.message(why3)) && ok
        try create_private_dir(priv) else why4:
            ok = #expect(why4 == os.Error.EXISTS, "a second create_private_dir failed ", os.message(why4)) && ok

        ref []char8 five = under(root, "five")
        try write_file(five, "hello") else why5:
            ok = #expect(false, "write_file failed: ", os.message(why5)) && ok
        ok = #expect(is_file(five) && !is_dir(five), "a file answers as one") && ok
        ok = #expect(!exists("Z:\\no_such_dir_zqx_98765"), "nothing is nothing") && ok

        // ── listing ──────────────────────────────────────────────────────────
        ^Dir d = open(root)
        ok = #expect(d != nil, "open the scratch root") && ok
        i32 seen = 0
        bool found_five = false
        for:
            (string8 name, bool got) = next(d)
            if !got: break
            seen += 1
            if name == "five": found_five = true
        close(d)
        ok = #expect(seen == 5, "., .., d, private and five — five entries, got ", seen) && ok
        ok = #expect(found_five, "the listing named `five`") && ok
        ok = #expect(open("Z:\\no_such_dir_zqx_98765") == nil, "open of nothing is nil") && ok
        ok = #expect(open(five) == nil, "open of a file is nil") && ok
        ok = #expect(!exists("") && !is_dir("") && !is_file(""), "an empty path is nothing") && ok

        // ── the working directory ────────────────────────────────────────────
        try ref []char8 home = current_dir() else why6:
            ok = #expect(false, "current_dir failed: ", os.message(why6))
            return 1
        ok = #expect(#len(home) > 2 && home[1] == ':', "current_dir is a drive path") && ok
        try change_dir(root) else why7:
            ok = #expect(false, "change_dir into the scratch tree failed: ", os.message(why7)) && ok
        ok = #expect(is_file("five"), "a relative path resolves in the new directory") && ok
        try change_dir(home) else why8:
            ok = #expect(false, "change_dir back failed: ", os.message(why8)) && ok
        ok = #expect(!is_file("five"), "and the relative name stops resolving") && ok
        #delete(home)

        // ── no execute bit ───────────────────────────────────────────────────
        ok = #expect(!is_executable(five), "a name with no PATHEXT extension is not executable") && ok
        try make_executable(five) else why9:
            ok = #expect(false, "make_executable of a file that exists failed: ", os.message(why9)) && ok
        ref []char8 exe = under(root, "tool.EXE")
        try write_file(exe, "MZ") else why10:
            ok = #expect(false, "write_file failed: ", os.message(why10)) && ok
        ok = #expect(is_executable(exe), "a .EXE is executable") && ok
        try make_executable("Z:\\no_such_dir_zqx_98765\\x") else why11:
            ok = #expect(why11 == os.Error.NOT_FOUND, "make_executable of nothing failed ", os.message(why11)) && ok

        // ── links, when this machine allows them ─────────────────────────────
        ref []char8 live = under(root, "live")
        try make_symlink("five", live) else why12:
            // Without Developer Mode or administrator rights, Windows refuses,
            // and the code and its sentence say so.
            ok = #expect(why12 == os.Error.PRIVILEGE || why12 == os.Error.UNSUPPORTED, "make_symlink failed with ", os.message(why12)) && ok
        if is_link(live):
            ok = #expect(is_file(live), "a live link answers as its target") && ok
            [64]char8 target
            i64 ln = read_link(live, target[:])
            ok = #expect(ln == 4 && string8(target[0..<4]) == "five", "read_link reports the link's text, got ", ln) && ok
            ok = #expect(read_link(five, target[:]) == 0 - 1, "read_link of a file is -1") && ok
        ok = #expect(!is_link(five), "a file is not a link") && ok

        // ── making a tree, and walking it ────────────────────────────────────
        ref []char8 deep = #format(root, "/w/sub")
        try make_dirs(deep) else why13:
            ok = #expect(false, "make_dirs failed: ", os.message(why13)) && ok
        try make_dirs(deep) else why14:
            ok = #expect(false, "make_dirs again failed: ", os.message(why14)) && ok
        ref []char8 back_deep = #format(root, "\\w2\\x\\y")
        try make_dirs(back_deep) else why15:
            ok = #expect(false, "make_dirs over backslashes failed: ", os.message(why15)) && ok
        ok = #expect(is_dir(back_deep), "make_dirs splits on backslashes too") && ok
        #delete(back_deep)
        ref []char8 wdir = #format(root, "/w")
        Listing l = walk(wdir)
        ok = #expect(#len(l.entries) == 1 && l.entries[0].is_dir, "the walk found sub, and only sub: ", #len(l.entries)) && ok
        l.destroy()

        ok = #expect(hidden(".git") && !hidden("five"), "hidden is the same policy") && ok

        #delete(deep)
        #delete(wdir)
        #delete(live)
        #delete(exe)
        #delete(five)
        #delete(priv)
        #delete(d1)
        try remove_all(root) else why16:
            ok = #expect(false, "remove_all of the scratch tree failed: ", os.message(why16)) && ok
        ok = #expect(!exists(root), "the scratch tree is gone") && ok
        #delete(root_bytes)
        #delete(b)
        if ok: return 0
        return 1
else when #OS == #WEB:
    i32 test():
        return 0

else:
    private const string8 SCRATCH = "/tmp/dado_fs_test_zqx98765"

    i32 test():
        using libc.allocator():
            bool ok = true

            ref []char8 b = #make([]char8, 4096)
            []char8 win = b[0..<i32(#len(b))]

            // ── realpath: the crossing `canonical` is built on ───────────────
            i64 n1 = real_path("/", win)
            ok = #expect(n1 == 1 && string8(win[0..<i32(n1)]) == "/", "realpath / is /") && ok
            i64 n2 = real_path("/usr/..", win)
            ok = #expect(n2 == 1 && string8(win[0..<i32(n2)]) == "/", "realpath /usr/.. is /") && ok
            ok = #expect(real_path("/no_such_dir_zqx_98765/nope", win) == -1, "realpath nonexistent is -1") && ok
            i64 n4 = real_path(".", win)
            ok = #expect(n4 > 0 && win[0] == '/', "realpath . is absolute") && ok
            // A buffer too small to hold the result and its terminator is
            // refused, not truncated, and so is one it would exactly fill.
            ok = #expect(real_path("/usr", b[0..<2]) == -1, "realpath into too-small buffer is -1") && ok
            ok = #expect(real_path("/usr", b[0..<4]) == -1, "realpath refuses a buffer with no room for the terminator") && ok

            // ── a scratch tree this test builds, then asks about ─────────────
            try remove_all(SCRATCH) else why:
                ok = #expect(false, "remove_all of the old scratch tree failed: ", os.message(why)) && ok
            ok = #expect(!exists(SCRATCH), "the scratch tree is gone before we start") && ok
            try create_dir(SCRATCH) else why2:
                ok = #expect(false, "create_dir failed: ", os.message(why2)) && ok
            // A second `mkdir` on the same path is EEXIST — which proves the
            // first one reached the platform.
            try create_dir(SCRATCH) else why3:
                ok = #expect(why3 == os.Error.EXISTS, "create_dir on an existing path failed ", os.message(why3)) && ok

            // A private directory: made once, refused over anything already
            // there, and holding only its owner's bits.
            string8 priv = "/tmp/dado_fs_test_zqx98765/private"
            try create_private_dir(priv) else why4:
                ok = #expect(false, "create_private_dir failed: ", os.message(why4)) && ok
            try create_private_dir(priv) else why5:
                ok = #expect(why5 == os.Error.EXISTS, "a second create_private_dir failed ", os.message(why5)) && ok
            try create_private_dir("/no_such_parent_zqx/child") else why6:
                ok = #expect(why6 == os.Error.NOT_FOUND, "create_private_dir with no parent failed ", os.message(why6)) && ok
            (u32 pm, bool pgot) = mode_bits("/tmp/dado_fs_test_zqx98765/private")
            ok = #expect(pgot && (pm & 0x1FF) == 0x1C0, "its permission bits are 0700: ", i64(pm & 0x1FF)) && ok
            try remove_dir(priv) else why7:
                ok = #expect(false, "remove_dir failed: ", os.message(why7)) && ok

            ok = #expect(exists(SCRATCH) && is_dir(SCRATCH) && !is_file(SCRATCH), "the directory answers as one") && ok

            string8 five = "/tmp/dado_fs_test_zqx98765/five"
            try write_file(five, "hello") else why8:
                ok = #expect(false, "write_file failed: ", os.message(why8)) && ok
            ok = #expect(is_file(five) && !is_dir(five), "a file answers as one") && ok

            // Nothing on the disk, and the empty path: no crash, no abort.
            ok = #expect(!exists("/no_such_dir_zqx_98765") && !is_dir("/no_such_dir_zqx_98765") && !is_file("/no_such_dir_zqx_98765"), "nothing is nothing") && ok
            ok = #expect(!exists("") && !is_dir("") && !is_file("") && !is_link("") && !is_executable(""), "the empty path is nothing") && ok

            // ── the directory stream ─────────────────────────────────────────
            //
            // `.`, `..` and `five` — and `five` by name, which is what proves
            // `d_name` is read at the offset the platform puts it at.
            ^Dir d = open(SCRATCH)
            ok = #expect(d != nil, "opendir") && ok
            i32 seen = 0
            i32 skipped = 0
            bool found_five = false
            for:
                (string8 name, bool got) = next(d)
                if !got:
                    break
                seen = seen + 1
                if hidden(name):
                    skipped = skipped + 1
                else if name == "five":
                    found_five = true
            close(d)
            ok = #expect(seen == 3, "., .. and five — three entries, got ", seen) && ok
            ok = #expect(skipped == 2, "hidden skips . and .., got ", skipped) && ok
            ok = #expect(found_five, "readdir named `five`") && ok
            ^Dir bad = open("/no_such_dir_zqx_98765")
            ok = #expect(bad == nil, "opendir on nothing is nil") && ok
            close(bad)
            (string8 nothing, bool none) = next(bad)
            ok = #expect(!none && #len(nothing) == 0, "next on a nil handle is (\"\", false)") && ok

            // ── the working directory ────────────────────────────────────────
            try ref []char8 home = current_dir() else why9:
                ok = #expect(false, "current_dir failed: ", os.message(why9))
                return 1
            ok = #expect(#len(home) > 0 && home[0] == '/', "current_dir is a non-empty absolute path") && ok
            try change_dir("/no_such_dir_zqx_98765") else why10:
                ok = #expect(why10 == os.Error.NOT_FOUND, "change_dir to nothing failed ", os.message(why10)) && ok
            try change_dir(SCRATCH) else why11:
                ok = #expect(false, "change_dir into the scratch tree failed: ", os.message(why11)) && ok
            ok = #expect(is_file("five"), "a relative path resolves in the new directory") && ok
            try change_dir(home) else why12:
                ok = #expect(false, "change_dir back failed: ", os.message(why12)) && ok
            ok = #expect(!is_file("five"), "and the relative name stops resolving") && ok
            #delete(home)

            // ── links, and the bit a toolchain cares about ───────────────────
            string8 live = "/tmp/dado_fs_test_zqx98765/live"
            string8 dangling = "/tmp/dado_fs_test_zqx98765/dangling"
            try make_symlink("five", live) else why13:
                ok = #expect(false, "make_symlink onto a file failed: ", os.message(why13)) && ok
            try make_symlink("nowhere", dangling) else why14:
                ok = #expect(false, "make_symlink onto nothing failed: ", os.message(why14)) && ok
            try make_symlink("five", live) else why15:
                ok = #expect(why15 == os.Error.EXISTS, "make_symlink over an existing name failed ", os.message(why15)) && ok

            // **The whole reason `is_link` exists.** `stat` follows, so the
            // dangling link is `exists=false` and `is_file=false` — which is
            // what a name that is not there answers too.
            ok = #expect(is_link(live) && is_link(dangling) && !is_link(five), "is_link sees links and only links") && ok
            ok = #expect(!exists(dangling), "stat follows, so a dangling link does not exist") && ok
            ok = #expect(is_file(live), "a live link stats as what it points at") && ok

            [64]char8 target
            i64 ln = read_link(live, target[:])
            ok = #expect(ln == 4 && string8(target[0..<4]) == "five", "read_link reports the text of the link, got ", ln) && ok
            ok = #expect(read_link(five, target[:]) == 0 - 1, "read_link on a file that is not a link is -1") && ok
            [4]char8 tight
            ok = #expect(read_link(live, tight[:]) == 0 - 1, "a result that exactly fills the buffer is refused") && ok

            // The execute bit. `five` was made by `write_file` and is not
            // executable; afterwards it is.
            ok = #expect(!is_executable(five), "a written file is not executable") && ok
            try make_executable(five) else why16:
                ok = #expect(false, "make_executable failed: ", os.message(why16)) && ok
            ok = #expect(is_executable(five), "and now it is") && ok
            try make_executable(five) else why17:
                ok = #expect(false, "make_executable of an executable file failed: ", os.message(why17)) && ok
            try make_executable("/tmp/dado_fs_test_zqx98765/nothing_here") else why18:
                ok = #expect(why18 == os.Error.NOT_FOUND, "make_executable of nothing failed ", os.message(why18)) && ok
            ok = #expect(!is_executable("/tmp/dado_fs_test_zqx98765/nothing_here"), "a name that is not there is not executable") && ok

            // **The rule itself, which `is_executable` cannot see.**
            // `access(X_OK)` answers for the caller, so it would say `true` for
            // `0711` exactly as for `0700`. `0x1C0` is `0700` and `0x180` is
            // `0600`.
            try chmod(five, 0x180) else why19:
                ok = #expect(false, "chmod to 0600 failed: ", os.message(why19)) && ok
            try make_executable(five) else why20:
                ok = #expect(false, "make_executable on 0600 failed: ", os.message(why20)) && ok
            (u32 got_mode, bool read_it) = mode_bits("/tmp/dado_fs_test_zqx98765/five")
            ok = #expect(read_it && (got_mode & 0x1FF) == 0x1C0, "0600 + x must be 0700 and not 0711; got ", i64(got_mode & 0x1FF)) && ok
            try chmod(five, 0x1A4) else why21:
                ok = #expect(false, "chmod to 0644 failed: ", os.message(why21)) && ok
            try make_executable(five) else why22:
                ok = #expect(false, "make_executable on 0644 failed: ", os.message(why22)) && ok
            (u32 wide_mode, bool read_wide) = mode_bits("/tmp/dado_fs_test_zqx98765/five")
            ok = #expect(read_wide && (wide_mode & 0x1FF) == 0x1ED, "0644 + x must be 0755; got ", i64(wide_mode & 0x1FF)) && ok

            // ── walking a tree, and making one ───────────────────────────────
            try make_dirs("/tmp/dado_fs_test_zqx98765/w/sub") else why23:
                ok = #expect(false, "make_dirs failed: ", os.message(why23)) && ok
            ok = #expect(is_dir("/tmp/dado_fs_test_zqx98765/w") && is_dir("/tmp/dado_fs_test_zqx98765/w/sub"), "and both levels are there") && ok
            // Twice is success, which is the whole difference from `create_dir`.
            try make_dirs("/tmp/dado_fs_test_zqx98765/w/sub") else why24:
                ok = #expect(false, "make_dirs over an existing tree failed: ", os.message(why24)) && ok
            try make_dirs("/tmp/dado_fs_test_zqx98765/w//deep///er") else why25:
                ok = #expect(false, "make_dirs over a doubled separator failed: ", os.message(why25)) && ok
            ok = #expect(is_dir("/tmp/dado_fs_test_zqx98765/w/deep/er"), "a doubled separator is one separator") && ok
            // A component that is a file is refused: nothing here replaces
            // anything.
            try make_dirs("/tmp/dado_fs_test_zqx98765/five/below") else why26:
                ok = #expect(why26 == os.Error.NOT_DIR || why26 == os.Error.EXISTS, "a file in the middle failed ", os.message(why26)) && ok
            try make_dirs("") else why27:
                ok = #expect(why27 == os.Error.INVALID, "an empty path failed ", os.message(why27)) && ok

            try write_file("/tmp/dado_fs_test_zqx98765/w/a.txt", "aa") else why28:
                ok = #expect(false, "write_file failed: ", os.message(why28)) && ok
            try write_file("/tmp/dado_fs_test_zqx98765/w/sub/b.txt", "bbb") else why29:
                ok = #expect(false, "write_file failed: ", os.message(why29)) && ok
            try write_file("/tmp/dado_fs_test_zqx98765/w/.hidden", "h") else why30:
                ok = #expect(false, "write_file failed: ", os.message(why30)) && ok
            try make_symlink("sub", "/tmp/dado_fs_test_zqx98765/w/loop") else why31:
                ok = #expect(false, "a link to a directory inside the tree failed: ", os.message(why31)) && ok

            Listing l = walk("/tmp/dado_fs_test_zqx98765/w")
            i32 files = 0
            i32 dirs = 0
            i32 saw_sub = 0 - 1
            i32 saw_b = 0 - 1
            bool saw_hidden = false
            bool saw_through_link = false
            i32 at = 0
            for e in l.entries:
                if e.is_dir:
                    dirs += 1
                else:
                    files += 1
                if strings.ends_with(e.path, "/w/sub"):
                    saw_sub = at
                if strings.ends_with(e.path, "/sub/b.txt"):
                    saw_b = at
                if strings.ends_with(e.path, "/.hidden"):
                    saw_hidden = true
                if strings.ends_with(e.path, "/loop/b.txt"):
                    saw_through_link = true
                at += 1

            // `w` holds a.txt, .hidden, sub/, sub/b.txt, loop -> sub, deep/, deep/er.
            ok = #expect(files == 2, "expected 2 files (a.txt and sub/b.txt), got ", files) && ok
            ok = #expect(dirs == 4, "expected 4 directories (sub, loop, deep, deep/er), got ", dirs) && ok
            ok = #expect(!saw_hidden, "a dotfile was walked") && ok
            // **Pre-order**: a parent is recorded before its contents.
            ok = #expect(saw_sub >= 0 && saw_b >= 0 && saw_sub < saw_b, "sub must come before sub/b.txt; got ", saw_sub, " and ", saw_b) && ok
            // **Listed and not entered.**
            ok = #expect(!saw_through_link, "the walk followed a symlinked directory") && ok
            ok = #expect(#len(l.entries) == 6, "6 entries, got ", #len(l.entries)) && ok
            l.destroy()
            ok = #expect(#len(l.entries) == 0 && #len(l.bytes) == 0, "a destroyed listing is empty") && ok
            l.destroy()

            // A root that is not there is an empty listing and not a failure.
            Listing missing_root = walk("/tmp/dado_fs_test_zqx98765/no_such_tree")
            ok = #expect(#len(missing_root.entries) == 0, "a missing root walks to nothing") && ok
            missing_root.destroy()

            // ── the policy this package states ───────────────────────────────
            ok = #expect(hidden("") && hidden(".") && hidden("..") && hidden(".git"), "hidden covers the four it names") && ok
            ok = #expect(!hidden("five") && !hidden("a.b"), "and nothing else") && ok

            #delete(b)
            if ok:
                return 0
            return 1
