@test
// core:os/fs — the platform's answers, run rather than typechecked.
//
// **This package is now `stat`, `readdir`, `realpath` and `getcwd` restated
// directly, so every function here is a claim about a C header and a layout.**
// A test that only compiled would prove the restatement parses and nothing
// about whether `st_size` is the member the platform puts at that offset — so
// each block below builds something on the disk, asks this package about it,
// and checks the answer against what it built.
//
// The scratch tree is made under `/tmp`, removed at the start of the run rather
// than at the end (a failing run leaves its evidence behind), and every path
// into it is absolute so the `set_cwd` block cannot move the ground under the
// rest.
package fs

import "core:mem/libc"
import "core:io"
import "core:strings"
import "core:os"

when #OS == #WINDOWS:
    // The same questions as the POSIX test below, asked of a scratch tree
    // under the user's temp directory, with Windows' own answers where they
    // differ: a drive-letter root, no execute bit, and symbolic links that
    // need a privilege.
    i32 test():
        using libc.allocator():
            return windows_test()

    // A path under `root`, as the `cstring` the predicates take.
    private ref []char8 under(string8 root, string8 name):
        ref []char8 joined = #format(root, "\\", name)
        string8 j = joined
        ref []char8 c = c_path(j)
        #delete(joined)
        return c

    private i32 windows_test():
        bool ok = true
        ref []char8 b = #make([]char8, 4096)
        []char8 win = b[0..<i32(#len(b))]

        try ref []char8 root_bytes = make_temp_dir("dado-fs-test-") else code:
            #expect(false, "make_temp_dir failed: ", os.message(code))
            return 1
        string8 root = root_bytes
        ref []char8 croot = c_path(root)
        cstring r = cstring(croot)

        // ── realpath ─────────────────────────────────────────────────────────
        i64 n1 = real_path(r, win)
        ok = #expect(n1 > 3 && win[1] == ':' && win[2] == '\\', "real_path of the scratch root is a drive path, got ", n1) && ok
        ok = #expect(real_path("Z:\\no_such_dir_zqx_98765\\nope", win) == 0 - 1, "real_path of nothing is -1") && ok
        []char8 tiny = b[0..<2]
        ok = #expect(real_path(r, tiny) == 0 - 1, "real_path into a too-small buffer is -1") && ok

        // ── making, and asking ───────────────────────────────────────────────
        ref []char8 d1 = under(root, "d")
        ok = #expect(make_dir(cstring(d1)), "make_dir creates it") && ok
        ok = #expect(!make_dir(cstring(d1)), "make_dir on an existing path is false") && ok
        ok = #expect(is_dir(cstring(d1)) && !is_file(cstring(d1)) && exists(cstring(d1)), "a directory answers as one") && ok
        ref []char8 priv = under(root, "private")
        ok = #expect(make_private_dir(cstring(priv)), "make_private_dir creates it") && ok
        ok = #expect(!make_private_dir(cstring(priv)), "a second make_private_dir is false") && ok

        ref []char8 five = under(root, "five")
        string8 five_s = string8(cstring(five))
        try write_file(five_s, "hello") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        ok = #expect(is_file(cstring(five)) && !is_dir(cstring(five)), "a file answers as one") && ok
        ok = #expect(bytes(cstring(five)) == 5, "bytes is 5, got ", bytes(cstring(five))) && ok
        ok = #expect(!exists("Z:\\no_such_dir_zqx_98765") && bytes("Z:\\no_such_dir_zqx_98765") == 0 - 1, "nothing is nothing") && ok

        // ── listing ──────────────────────────────────────────────────────────
        ^Dir d = open(r)
        ok = #expect(opened(d), "open the scratch root") && ok
        i32 seen = 0
        bool found_five = false
        for:
            (cstring name, bool got) = next(d)
            if !got: break
            seen += 1
            if string8(name) == "five": found_five = true
        close(d)
        ok = #expect(seen == 5, "., .., d, private and five — five entries, got ", seen) && ok
        ok = #expect(found_five, "the listing named `five`") && ok
        ok = #expect(!opened(open("Z:\\no_such_dir_zqx_98765")), "open of nothing is nil") && ok
        ok = #expect(!opened(open(cstring(five))), "open of a file is nil") && ok

        // ── the nil path ─────────────────────────────────────────────────────
        cstring none_path = nil
        ok = #expect(!exists(none_path) && !is_dir(none_path) && !is_file(none_path) && bytes(none_path) == 0 - 1, "a nil path is nothing") && ok
        ok = #expect(real_path(none_path, win) == 0 - 1 && !set_cwd(none_path) && !make_dir(none_path) && !opened(open(none_path)), "a nil path is answered here") && ok

        // ── the working directory ────────────────────────────────────────────
        ref []char8 home = strings.clone_from_cstring(cwd(), libc.allocator())
        ok = #expect(#len(home) > 2 && home[1] == ':', "cwd is a drive path") && ok
        ok = #expect(set_cwd(r), "set_cwd into the scratch tree") && ok
        ok = #expect(is_file("five"), "a relative path resolves in the new cwd") && ok
        ref []char8 back = c_path(string8(home[:]))
        ok = #expect(set_cwd(cstring(back)), "set_cwd back") && ok
        ok = #expect(!is_file("five"), "and the relative name stops resolving") && ok
        #delete(back)
        #delete(home)

        // ── no execute bit ───────────────────────────────────────────────────
        ok = #expect(!executable(cstring(five)), "a name with no PATHEXT extension is not executable") && ok
        ok = #expect(make_executable(cstring(five)), "make_executable of a file that exists is true") && ok
        ref []char8 exe = under(root, "tool.EXE")
        try write_file(string8(cstring(exe)), "MZ") else code:
            ok = #expect(false, "write_file failed: ", os.message(code)) && ok
        ok = #expect(executable(cstring(exe)), "a .EXE is executable") && ok
        ok = #expect(!make_executable(nil) && !executable(nil), "a nil path is answered here") && ok

        // ── links, when this machine allows them ─────────────────────────────
        ref []char8 live = under(root, "live")
        try make_symlink("five", string8(cstring(live))) else code:
            // Without Developer Mode or administrator rights, Windows refuses,
            // and the code and its sentence say so.
            ok = #expect(code == os.PRIVILEGE || code == os.UNSUPPORTED, "make_symlink failed with ", code, ": ", os.message(code)) && ok
            ok = #expect(!symlink("five", cstring(live)), "symlink agrees") && ok
        if is_symlink(cstring(live)):
            ok = #expect(is_file(cstring(live)) && bytes(cstring(live)) == 5, "a live link answers as its target") && ok
            [64]char8 target
            i64 ln = read_link(cstring(live), target[:])
            ok = #expect(ln == 4 && string8(target[0..<4]) == "five", "read_link reports the link's text, got ", ln) && ok
            ok = #expect(read_link(cstring(five), target[:]) == 0 - 1, "read_link of a file is -1") && ok
            ok = #expect(!symlink("five", cstring(live)), "symlink over an existing name is refused") && ok
        ok = #expect(!is_symlink(cstring(five)), "a file is not a link") && ok

        // ── making a tree, and walking it ────────────────────────────────────
        ref []char8 deep = #format(root, "/w/sub")
        ok = #expect(make_dirs(string8(deep[:]), #heap), "make_dirs builds every level") && ok
        ok = #expect(make_dirs(string8(deep[:]), #heap), "and again is true") && ok
        ref []char8 back_deep = #format(root, "\\w2\\x\\y")
        ref []char8 cback = c_path(string8(back_deep[:]))
        ok = #expect(make_dirs(string8(back_deep[:]), #heap) && is_dir(cstring(cback)), "make_dirs splits on backslashes too") && ok
        #delete(cback)
        #delete(back_deep)
        ref []char8 wdir = #format(root, "/w")
        Listing l = walk(string8(wdir[:]), #heap)
        ok = #expect(#len(l.entries) == 1 && l.entries[0].is_dir, "the walk found sub, and only sub: ", #len(l.entries)) && ok
        release(l)

        ok = #expect(hidden(".git") && !hidden("five"), "hidden is the same policy") && ok

        #delete(deep)
        #delete(wdir)
        #delete(live)
        #delete(exe)
        #delete(five)
        #delete(priv)
        #delete(d1)
        try remove_all(root) else code:
            ok = #expect(false, "remove_all of the scratch tree failed: ", os.message(code)) && ok
        ok = #expect(!exists(r), "the scratch tree is gone") && ok
        #delete(croot)
        #delete(root_bytes)
        #delete(b)
        if ok: return 0
        return 1
else:
    i32 test():
        using libc.allocator():
            bool ok = true

            ref []char8 b = #make([]char8, 4096)
            []char8 win = b[0..<i32(#len(b))]

            // ── realpath: the crossing the load stage's `identity` is built on ──
            //
            // Canonical bytes on success, -1 where the filesystem cannot resolve
            // the path (which is what sends `identity` to the lexical `normalize`).

            // The root canonicalizes to itself, on every platform.
            i64 n1 = real_path("/", win)
            ok = #expect(n1 == 1 && string8(win[0..<i32(n1)]) == "/", "realpath / is /") && ok

            // `..` is resolved against the disk: /usr/.. is /.
            i64 n2 = real_path("/usr/..", win)
            ok = #expect(n2 == 1 && string8(win[0..<i32(n2)]) == "/", "realpath /usr/.. is /") && ok

            // A path that does not exist cannot be resolved — the -1 that sends
            // `identity` to the lexical answer.
            i64 n3 = real_path("/no_such_dir_zqx_98765/nope", win)
            ok = #expect(n3 == -1, "realpath nonexistent is -1") && ok

            // The current directory resolves to an absolute path.
            i64 n4 = real_path(".", win)
            ok = #expect(n4 > 0 && win[0] == '/', "realpath . is absolute") && ok

            // A buffer too small to hold the result and its terminator is refused,
            // not truncated (/usr is four bytes and does not fit in two).
            []char8 tiny = b[0..<2]
            i64 n5 = real_path("/usr", tiny)
            ok = #expect(n5 == -1, "realpath into too-small buffer is -1") && ok

            // The terminator is written and counted against the buffer, so a result
            // that would exactly fill it is refused too: "/usr" is four bytes and
            // needs five.
            []char8 exact = b[0..<4]
            ok = #expect(real_path("/usr", exact) == -1,
                        "realpath refuses a buffer with no room for the terminator") && ok

            // ── a scratch tree this test builds, then asks about ─────────────────

            // Left behind by a previous failing run, if there was one.
            try remove_all("/tmp/dado_fs_test_zqx98765") else code:
                ok = #expect(false, "remove_all of the old scratch tree failed with ", code) && ok

            ok = #expect(!exists("/tmp/dado_fs_test_zqx98765"), "the scratch tree is gone before we start") && ok
            ok = #expect(make_dir("/tmp/dado_fs_test_zqx98765"), "make_dir creates it") && ok
            // A second `mkdir` on the same path is EEXIST — which proves the first
            // one reached the platform rather than answering true on its own.
            ok = #expect(!make_dir("/tmp/dado_fs_test_zqx98765"), "make_dir on an existing path is false") && ok
            ok = #expect(!make_dir("/no_such_parent_zqx/child"),
                        "make_dir without a parent is false") && ok

            // A private directory: made once, refused over anything already there,
            // and holding only its owner's bits (read back through `mode_bits`).
            ok = #expect(make_private_dir("/tmp/dado_fs_test_zqx98765/private"), "make_private_dir creates it") && ok
            ok = #expect(!make_private_dir("/tmp/dado_fs_test_zqx98765/private"), "a second make_private_dir is false") && ok
            ok = #expect(!make_private_dir("/tmp/dado_fs_test_zqx98765"), "so is one over a directory make_dir made") && ok
            ok = #expect(!make_private_dir(nil) && !make_private_dir("/no_such_parent_zqx/child"), "nil and no parent are false") && ok
            (u32 pm, bool pgot) = mode_bits("/tmp/dado_fs_test_zqx98765/private")
            ok = #expect(pgot && (pm & 0x1FF) == 0x1C0, "its permission bits are 0700: ", i64(pm & 0x1FF)) && ok
            ok = #expect(io.delete("/tmp/dado_fs_test_zqx98765/private") && !exists("/tmp/dado_fs_test_zqx98765/private"),
                         "and an empty one is removed by io.delete") && ok

            ok = #expect(exists("/tmp/dado_fs_test_zqx98765"), "the directory exists") && ok
            ok = #expect(is_dir("/tmp/dado_fs_test_zqx98765"), "S_ISDIR says directory") && ok
            ok = #expect(!is_file("/tmp/dado_fs_test_zqx98765"), "S_ISREG says not a file") && ok

            // Five known bytes, so `bytes` is checked against a number this test
            // chose rather than against whatever `st_size` happens to hold.
            ^io.FILE f = io.open_write("/tmp/dado_fs_test_zqx98765/five")
            ok = #expect(io.opened(f), "opened the scratch file for writing") && ok
            _ = io.write(f, "hello")
            _ = io.close(f)

            ok = #expect(is_file("/tmp/dado_fs_test_zqx98765/five"), "S_ISREG says file") && ok
            ok = #expect(!is_dir("/tmp/dado_fs_test_zqx98765/five"), "S_ISDIR says not a directory") && ok
            ok = #expect(bytes("/tmp/dado_fs_test_zqx98765/five") == 5, "st_size is 5, got ", bytes("/tmp/dado_fs_test_zqx98765/five")) && ok

            // Nothing on the disk: three different questions, three answers, no
            // crash and no abort.
            ok = #expect(!exists("/no_such_dir_zqx_98765"), "exists is false") && ok
            ok = #expect(!is_dir("/no_such_dir_zqx_98765"), "is_dir is false") && ok
            ok = #expect(!is_file("/no_such_dir_zqx_98765"), "is_file is false") && ok
            ok = #expect(bytes("/no_such_dir_zqx_98765") == -1, "bytes is -1") && ok

            // ── walking it ───────────────────────────────────────────────────────
            //
            // `.`, `..` and `five` — and `five` by name, which is what proves
            // `d_name` is read at the offset the platform puts it at rather than at
            // some other member that happens to be in the struct.
            ^Dir d = open("/tmp/dado_fs_test_zqx98765")
            ok = #expect(opened(d), "opendir") && ok
            i32 seen = 0
            i32 skipped = 0
            bool found_five = false
            for:
                (cstring name, bool got) = next(d)
                if !got:
                    break
                seen = seen + 1
                // `string(c)` is the borrow `hidden`'s comment rests on: it is what
                // lets a name that came out of `readdir` be asked this package's own
                // question. If that conversion ever stops borrowing, this line is
                // where it is noticed.
                if hidden(string8(name)):
                    skipped = skipped + 1
                else if string8(name) == "five":
                    found_five = true
            close(d)
            ok = #expect(seen == 3, "., .. and five — three entries, got ", seen) && ok
            ok = #expect(skipped == 2, "hidden skips . and .., got ", skipped) && ok
            ok = #expect(found_five, "readdir named `five`") && ok

            // A directory that is not there opens as nil, and `close` takes one.
            ^Dir bad = open("/no_such_dir_zqx_98765")
            ok = #expect(!opened(bad), "opendir on nothing is nil") && ok
            close(bad)
            (cstring nothing, bool none) = next(bad)
            ok = #expect(!none && nothing == nil, "next on a nil handle is (nil, false)") && ok

            // ── the nil path ─────────────────────────────────────────────────────
            //
            // `next` hands back `nil` at the end of a directory, so a caller that
            // reads the name without reading `ok` arrives here. Every one of these
            // answers rather than reaching `stat(NULL, …)`, which is undefined
            // behaviour in C whatever a given libc survives — and under the
            // sanitizers this test runs with, surviving it is not the same as being
            // allowed to do it.
            cstring none_path = nil
            ok = #expect(!exists(none_path) && !is_dir(none_path) && !is_file(none_path),
                        "a nil path is nothing on the disk") && ok
            ok = #expect(bytes(none_path) == -1, "bytes of a nil path is -1") && ok
            ok = #expect(real_path(none_path, win) == -1, "real_path of a nil path is -1") && ok
            ok = #expect(!set_cwd(none_path), "set_cwd to a nil path is false") && ok
            ok = #expect(!make_dir(none_path), "make_dir of a nil path is false") && ok
            ^Dir nod = open(none_path)
            ok = #expect(!opened(nod), "open of a nil path is nil") && ok
            close(nod)

            // ── the working directory ────────────────────────────────────────────
            //
            // `cwd` hands back a pointer into this package's own buffer, so the
            // bytes are copied before anything else can overwrite them.
            ref []char8 home = strings.clone_from_cstring(cwd(), libc.allocator())
            ok = #expect(#len(home) > 0 && home[0] == '/', "cwd is a non-empty absolute path") && ok

            // `getcwd` answers the canonical path, so `realpath` of it is itself.
            i64 n6 = real_path(cwd(), win)
            ok = #expect(n6 == #len(home) && string8(win[0..<i32(n6)]) == string8(home[:]),
                        "cwd is already canonical") && ok

            ok = #expect(!set_cwd("/no_such_dir_zqx_98765"), "set_cwd to nothing is false") && ok
            ok = #expect(set_cwd("/tmp/dado_fs_test_zqx98765"), "set_cwd into the scratch tree") && ok
            // The proof that the process actually moved: a *relative* name now
            // resolves inside the scratch tree.
            ok = #expect(is_file("five"), "a relative path resolves in the new cwd") && ok

            ref []char8 back = strings.clone_to_cstring(string8(home[:]), libc.allocator())
            ok = #expect(set_cwd(cstring(back)), "set_cwd back to where the test started") && ok
            ok = #expect(!is_file("five"), "and the relative name stops resolving") && ok

            #delete(back)
            #delete(home)

            // ── links, and the bit a toolchain cares about ───────────────────────
            // The scratch tree holds `five`, a five-byte file, and this hangs a
            // link beside it and one beside nothing.
            ok = #expect(symlink("five", "/tmp/dado_fs_test_zqx98765/live"),
                        "symlink onto an existing file") && ok
            ok = #expect(symlink("nowhere", "/tmp/dado_fs_test_zqx98765/dangling"),
                        "symlink onto a name that is not there") && ok
            ok = #expect(!symlink("five", "/tmp/dado_fs_test_zqx98765/live"),
                        "symlink over an existing name is refused") && ok
            ok = #expect(!symlink(nil, "/tmp/dado_fs_test_zqx98765/nil") && !symlink("five", nil),
                        "a nil either side is answered here") && ok

            // **The whole reason `is_symlink` exists.** `stat` follows, so the
            // dangling link is `exists=false` and `is_file=false` — which is what
            // a name that is not there answers too, and `lstat` is the only thing
            // that tells the two apart.
            ok = #expect(is_symlink("/tmp/dado_fs_test_zqx98765/live"), "live link is a link") && ok
            ok = #expect(is_symlink("/tmp/dado_fs_test_zqx98765/dangling"), "dangling link is a link") && ok
            ok = #expect(!is_symlink("/tmp/dado_fs_test_zqx98765/five"), "a real file is not a link") && ok
            ok = #expect(!exists("/tmp/dado_fs_test_zqx98765/dangling"),
                        "stat follows, so a dangling link does not exist") && ok
            ok = #expect(is_file("/tmp/dado_fs_test_zqx98765/live") && bytes("/tmp/dado_fs_test_zqx98765/live") == 5,
                        "a live link stats as what it points at") && ok

            [64]char8 target
            i64 ln = read_link("/tmp/dado_fs_test_zqx98765/live", target[:])
            ok = #expect(ln == 4 && string8(target[0..<4]) == "five",
                        "read_link reports the text of the link, got ", ln) && ok
            ok = #expect(read_link("/tmp/dado_fs_test_zqx98765/five", target[:]) == 0 - 1,
                        "read_link on a file that is not a link is -1") && ok
            // The buffer rule, the same one `real_path` has: a result that exactly
            // fills it is refused rather than handed back unterminated.
            [4]char8 tight
            ok = #expect(read_link("/tmp/dado_fs_test_zqx98765/live", tight[:]) == 0 - 1,
                        "a result that exactly fills the buffer is refused") && ok

            // The execute bit. `five` was made by `io.open_write` and is not
            // executable; afterwards it is, and the classes that could not read it
            // still cannot run it.
            ok = #expect(!executable("/tmp/dado_fs_test_zqx98765/five"), "a written file is not executable") && ok
            ok = #expect(make_executable("/tmp/dado_fs_test_zqx98765/five"), "make_executable") && ok
            ok = #expect(executable("/tmp/dado_fs_test_zqx98765/five"), "and now it is") && ok
            ok = #expect(make_executable("/tmp/dado_fs_test_zqx98765/five"),
                        "already executable is true, because this says what the file is") && ok
            ok = #expect(!executable("/tmp/dado_fs_test_zqx98765/nothing_here"),
                        "a name that is not there is not executable") && ok
            ok = #expect(!make_executable(nil) && !executable(nil), "a nil path is answered here") && ok

            // **The rule itself, which `executable` cannot see.** `access(X_OK)`
            // answers for the caller, so it would say `true` for `0711` exactly as
            // for `0700` — and `0711` is a private file somebody just let everyone
            // run. This test is in package `fs`, so it reads `st_mode` the way the
            // package does rather than through a public accessor nothing else
            // wants. `0x1C0` is `0700` and `0x180` is `0600`.
            ok = #expect(set_mode("/tmp/dado_fs_test_zqx98765/five", 0x180), "set_mode to 0600") && ok
            ok = #expect(make_executable("/tmp/dado_fs_test_zqx98765/five"), "make_executable on 0600") && ok
            (u32 got_mode, bool read_it) = mode_bits("/tmp/dado_fs_test_zqx98765/five")
            ok = #expect(read_it && (got_mode & 0x1FF) == 0x1C0,
                        "0600 + x must be 0700 and not 0711; got ", i64(got_mode & 0x1FF)) && ok
            // And the other direction: a file everybody can read gains the bit for
            // everybody, which is the same rule and not a second one.
            ok = #expect(set_mode("/tmp/dado_fs_test_zqx98765/five", 0x1A4), "set_mode to 0644") && ok
            ok = #expect(make_executable("/tmp/dado_fs_test_zqx98765/five"), "make_executable on 0644") && ok
            (u32 wide_mode, bool read_wide) = mode_bits("/tmp/dado_fs_test_zqx98765/five")
            ok = #expect(read_wide && (wide_mode & 0x1FF) == 0x1ED,
                        "0644 + x must be 0755; got ", i64(wide_mode & 0x1FF)) && ok

            // ── walking a tree, and making one ───────────────────────────────────
            ok = #expect(make_dirs("/tmp/dado_fs_test_zqx98765/w/sub", #heap),
                        "make_dirs builds every level") && ok
            ok = #expect(is_dir("/tmp/dado_fs_test_zqx98765/w") && is_dir("/tmp/dado_fs_test_zqx98765/w/sub"),
                        "and both levels are there") && ok
            // Twice is true, which is the whole difference from `make_dir`.
            ok = #expect(make_dirs("/tmp/dado_fs_test_zqx98765/w/sub", #heap),
                        "make_dirs over an existing tree is true") && ok
            ok = #expect(make_dirs("/tmp/dado_fs_test_zqx98765/w//deep///er", #heap),
                        "a doubled separator is one separator") && ok
            ok = #expect(is_dir("/tmp/dado_fs_test_zqx98765/w/deep/er"), "and it made both") && ok
            // A component that is a file is refused: nothing here replaces anything.
            ok = #expect(!make_dirs("/tmp/dado_fs_test_zqx98765/five/below", #heap),
                        "a file in the middle of a path is not a directory to descend") && ok
            ok = #expect(!make_dirs("", #heap), "an empty path makes nothing") && ok

            ^io.FILE wf = io.open_write("/tmp/dado_fs_test_zqx98765/w/a.txt")
            _ = io.write(wf, "aa")
            _ = io.close(wf)
            ^io.FILE wg = io.open_write("/tmp/dado_fs_test_zqx98765/w/sub/b.txt")
            _ = io.write(wg, "bbb")
            _ = io.close(wg)
            ^io.FILE wh = io.open_write("/tmp/dado_fs_test_zqx98765/w/.hidden")
            _ = io.write(wh, "h")
            _ = io.close(wh)
            ok = #expect(symlink("sub", "/tmp/dado_fs_test_zqx98765/w/loop"),
                        "a link to a directory inside the tree") && ok

            Listing l = walk("/tmp/dado_fs_test_zqx98765/w", #heap)
            i32 files = 0
            i32 dirs = 0
            i32 saw_sub = 0 - 1
            i32 saw_b = 0 - 1
            bool saw_hidden = false
            bool saw_through_link = false
            i32 at = 0
            for e in l.entries:
                if e.is_dir:
                    dirs += 1
                else:
                    files += 1
                if strings.ends_with(e.path, "/w/sub"):
                    saw_sub = at
                if strings.ends_with(e.path, "/sub/b.txt"):
                    saw_b = at
                if strings.ends_with(e.path, "/.hidden"):
                    saw_hidden = true
                if strings.ends_with(e.path, "/loop/b.txt"):
                    saw_through_link = true
                at += 1

            // `w` holds a.txt, .hidden, sub/, sub/b.txt, loop -> sub, deep/, deep/er.
            ok = #expect(files == 2, "expected 2 files (a.txt and sub/b.txt), got ", files) && ok
            ok = #expect(dirs == 4, "expected 4 directories (sub, loop, deep, deep/er), got ", dirs) && ok
            ok = #expect(!saw_hidden, "a dotfile was walked") && ok

            // **Pre-order, stated as an order and not as whatever readdir gave.**
            // A parent is recorded before its contents, which reversed is a safe
            // deletion order.
            ok = #expect(saw_sub >= 0 && saw_b >= 0 && saw_sub < saw_b,
                        "sub must come before sub/b.txt; got ", saw_sub, " and ", saw_b) && ok

            // **Listed and not entered.** `loop` points at `sub`, so following it
            // would duplicate `sub/b.txt` — and a link at an ancestor would not
            // finish at all.
            ok = #expect(!saw_through_link, "the walk followed a symlinked directory") && ok

            // The views are into the listing's own bytes, so they read correctly
            // until it is released and the release is one call for both blocks.
            ok = #expect(#len(l.entries) == 6, "6 entries, got ", #len(l.entries)) && ok
            release(l)

            // A root that is not there is an empty listing and not a failure.
            Listing missing_root = walk("/tmp/dado_fs_test_zqx98765/no_such_tree", #heap)
            ok = #expect(#len(missing_root.entries) == 0, "a missing root walks to nothing") && ok
            release(missing_root)

            // ── the policy this package states ───────────────────────────────────
            ok = #expect(hidden("") && hidden(".") && hidden("..") && hidden(".git"),
                        "hidden covers the four it names") && ok
            ok = #expect(!hidden("five") && !hidden("a.b"), "and nothing else") && ok

            #delete(b)
            if ok:
                return 0
            return 1
