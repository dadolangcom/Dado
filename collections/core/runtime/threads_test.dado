@test
// The scratch is per thread.
//
// Four threads doing nothing but `enter_temp`/`close_temp` around a `#make`,
// while the spawning thread holds a temp scope of its own open. With one
// shared copy of this package's state — before its words were
// `@thread_local` — this failed 5 runs in 10 with `TEMP_GUARD … Scopes open:
// 2` and a segfault, and the survivors read `temp_depth()` back as an
// underflowed counter. Here every claim is about one thread's own state:
//
//   * a spawned thread starts with **no scope open**, whatever its spawner has
//     open — its depth is its own;
//   * its first scope **configures its scratch** over C's heap with the
//     defaults, with no `init_scratch` call on that thread;
//   * every close is the innermost scope's, so `TEMP_GUARD` never defers;
//   * the arena a scope hands out is this thread's: `is_temp` of the scope's
//     allocator is true here and the spawner's arena is not it;
//   * and the thread hands its blocks back with `destroy_scratch` before it
//     returns, which is the call that keeps a thread's exit LSan-clean.
//
// Run it under `./dado test --sanitize=thread` as well as the default: the
// counts below catch the lost updates, and TSan catches the race itself.
package runtime

import "core:threads"

private const i32 THREADS = 4
private const i32 ROUNDS = 2000

private i32 g_bad

private void bad():
    _ = #atomic_fetch_add(&g_bad, 1, #SEQ_CST)

private rawptr worker(rawptr arg):
    // The spawner's arena, handed over by address: a pointer compare, never a
    // dereference.
    rawptr theirs = arg
    if temp_depth() != 0 || ready():
        bad()
    for i in 0..<ROUNDS:
        mem_ok(i, theirs)
        if !close_temp():
            bad()
    if temp_depth() != 0 || deferrals() != 0 || !ready():
        bad()
    destroy_scratch()
    return nil

private void mem_ok(i32 i, rawptr theirs):
    using enter_temp():
        if !is_temp(#default) || #default.data == theirs:
            bad()
        ref []i32 xs = #make([]i32, 32)
        if #len(xs) != 32:
            bad()
            return
        xs[31] = i
        if xs[31] != i || temp_depth() != 1:
            bad()

i32 test():
    bool ok = #expect(init_scratch(), "init_scratch")
    defer destroy_scratch()
    using enter_temp():
        rawptr mine = #default.data
        [THREADS]rawptr ts
        for i in 0..<THREADS:
            ts[i] = threads.spawn(worker, mine)
            ok = #expect(ts[i] != nil, "spawn ", i) && ok
        for i in 0..<THREADS:
            _ = threads.join(ts[i])
        ok = #expect(temp_depth() == 1, "the spawner's depth moved: ", temp_depth()) && ok
    ok = #expect(close_temp(), "the spawner's own close") && ok
    ok = #expect(temp_depth() == 0 && deferrals() == 0, "depth ", temp_depth(), " deferrals ", deferrals()) && ok
    i32 n = #atomic_load(&g_bad, #SEQ_CST)
    ok = #expect(n == 0, n, " per-thread claims failed") && ok
    if ok:
        return 0
    return 1
