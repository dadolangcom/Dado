@test
// core:threads: threads adding to one atomic counter, compare-and-swap, a
// mutex, and hardware_concurrency. If the atomics were not atomic the counter
// would lose increments under contention. The threads start with
// `try_spawn`, so a single-threaded web module builds this test too and
// checks the rest on its one thread.
package threads

import "core:time"

type Ctx:    (^i32 counter, i32 adds)
type CtxPtr: ^Ctx

// each thread atomically adds 1 to the shared counter `adds` times.
// (Converting rawptr -> a typed pointer drops the pointee's name view for
// direct field access, so copy the pointee into a typed local to get names
// back.)
rawptr adder(rawptr arg):
    CtxPtr cp = CtxPtr(arg)
    Ctx c = cp^
    for _ in 0..<c.adds:
        _ = atomic_fetch_add(c.counter, 1)
    return nil

i32 test():
    bool ok = true

    // ── contended atomic counter across N threads ──
    const i32 N    = 8
    const i32 ADDS = 20000
    i32 counter = 0
    Ctx ctx = (&counter, ADDS)
    [N]Thread ts
    i32 started = 0
    for i in 0..<N:
        ts[i] = try_spawn(adder, rawptr(&ctx))
        if ts[i] != nil:
            started += 1
    ok = #expect(started == N || (started == 0 && #OS == #WEB), "started ", started, " of ", N, " threads") && ok
    for i in 0..<N:
        if ts[i] != nil:
            ok = #expect(join(ts[i]), "join ", i) && ok
    ok = #expect(atomic_load(&counter) == started * ADDS, "counter = ", atomic_load(&counter), " want ", started * ADDS) && ok

    // ── compare-and-swap ──
    i32 cell = 5
    ok = #expect(atomic_cas(&cell, 5, 9), "cas 5->9 succeeds") && ok
    ok = #expect(atomic_load(&cell) == 9, "cell is 9") && ok
    ok = #expect(!atomic_cas(&cell, 5, 1), "cas 5->1 fails (cell is 9)") && ok
    ok = #expect(atomic_load(&cell) == 9, "cell still 9") && ok

    // ── mutex round-trip ──
    Mutex m = mutex_new()
    ok = #expect(m != nil, "mutex_new") && ok
    lock(m)
    unlock(m)
    mutex_free(m)

    ok = #expect(hardware_concurrency() >= 1, "hwc = ", hardware_concurrency()) && ok

    // ── a timed wait nothing signals runs out (on the web too: a threaded
    // module waits on the word, a single-threaded one runs out at once);
    // sync_test has the wait a signal ends ──
    Cond c = cond_new()
    Mutex held = mutex_new()
    lock(held)
    ok = #expect(!cond_wait_for(c, held, time.milliseconds(5)), "a 5 ms wait nothing signals answered woken") && ok
    ok = #expect(!cond_wait_for(c, held, time.nanoseconds(0)), "a 0 ms wait answered woken") && ok
    // The millisecond waits (Windows, the web) round up, and saturate rather
    // than overflow for the longest `Duration`.
    ok = #expect(ceil_ms(1) == 1 && ceil_ms(1000000) == 1 && ceil_ms(1000001) == 2 && ceil_ms(0) == 0, "ceil_ms rounds wrong") && ok
    ok = #expect(ceil_ms(9223372036854775807) == 9223372036854, "ceil_ms of the longest wait was ", ceil_ms(9223372036854775807)) && ok
    unlock(held)
    cond_free(c)
    mutex_free(held)

    if ok:
        return 0
    return 1
