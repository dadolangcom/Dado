@test
// core:threads — spawn/join with a shared atomic counter (race-free), CAS,
// mutex, and hardware_concurrency. If the atomics were not atomic this test
// would lose increments under contention and fail, which is the point.
package threads

type Ctx:    (^i32 counter, i32 adds)
type CtxPtr: ^Ctx

// each thread atomically adds 1 to the shared counter `adds` times.
// (Converting rawptr -> a typed pointer drops the pointee's name view for
// direct field access, so copy the pointee into a typed local to get names
// back.)
rawptr adder(rawptr arg):
    CtxPtr cp = CtxPtr(arg)
    Ctx c = cp^
    for _ in 0..<c.adds:
        _ = atomic_fetch_add(c.counter, 1)
    return nil

i32 test():
    bool ok = true

    // ── contended atomic counter across N threads ──
    const i32 N    = 8
    const i32 ADDS = 20000
    i32 counter = 0
    Ctx ctx = (&counter, ADDS)
    [N]rawptr ts
    for i in 0..<N:
        ts[i] = spawn(adder, rawptr(&ctx))
        ok = #expect(ts[i] != nil, "spawn ", i) && ok
    for i in 0..<N:
        _ = join(ts[i])
    ok = #expect(atomic_load(&counter) == N * ADDS, "counter = ", atomic_load(&counter), " want ", N * ADDS) && ok

    // ── compare-and-swap ──
    i32 cell = 5
    ok = #expect(atomic_cas(&cell, 5, 9), "cas 5->9 succeeds") && ok
    ok = #expect(atomic_load(&cell) == 9, "cell is 9") && ok
    ok = #expect(!atomic_cas(&cell, 5, 1), "cas 5->1 fails (cell is 9)") && ok
    ok = #expect(atomic_load(&cell) == 9, "cell still 9") && ok

    // ── mutex round-trip ──
    rawptr m = mutex_new()
    ok = #expect(m != nil, "mutex_new") && ok
    lock(m)
    unlock(m)
    mutex_free(m)

    ok = #expect(hardware_concurrency() >= 1, "hwc = ", hardware_concurrency()) && ok

    // ── a timed wait nothing signals runs out (on the web too: a threaded
    // module waits on the word, a single-threaded one runs out at once) ──
    rawptr c = cond_new()
    rawptr held = mutex_new()
    lock(held)
    ok = #expect(!cond_wait_for(c, held, 5), "a 5 ms wait nothing signals answered woken") && ok
    ok = #expect(!cond_wait_for(c, held, 0), "a 0 ms wait answered woken") && ok
    unlock(held)
    cond_free(c)
    mutex_free(held)

    if ok:
        return 0
    return 1
