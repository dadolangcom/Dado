@test 134
// `#delete` of a value whose channel still holds `ref`s traps in a debug build,
// naming the channel: freeing the value would leak every allocation queued in
// it. This test passes by aborting — status 134.
package threads

type ChanParcel: (i32 id, #channel(2) chan_parcels(i32 n, ref []u8 bytes))

i32 test():
    ref ChanParcel box = #new(ChanParcel)
    ref []u8 data = #make([]u8, 2)
    try #send(box.chan_parcels, 1, data) else:
        #delete(data)
    #delete(box)
    return 0
