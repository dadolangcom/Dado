@test 134
// A channel's one-consumer guard: a walk from a second thread traps, naming the
// channel and both threads, in a debug build (`--no-assert` strips it). This
// test passes by aborting — status 134, `SIGABRT` through a shell.
//
// The second thread is handed the channel through a pointer to the value that
// holds it, which is the hand-off the compiler cannot see and so does not lint;
// the owner word is what catches it, at run time, at the second walk.
package threads

type ChanInbox: (i32 id, #channel(4) chan_inbox(i32 n))

private ChanInbox chan_box

rawptr chan_second_consumer(rawptr arg):
    ^ChanInbox box = ^ChanInbox(arg)
    for n in #drain(box.chan_inbox):
        pass
    return nil

i32 test():
    for n in #drain(chan_box.chan_inbox):
        pass
    Thread t = spawn(chan_second_consumer, rawptr(&chan_box))
    _ = join(t)
    return 0
