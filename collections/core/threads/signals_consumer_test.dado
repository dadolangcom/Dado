@test 134
// A signal's one-consumer guard: a walk from a second thread traps, naming the
// signal and both threads, in a debug build (`--no-assert` strips it). This
// test passes by aborting — status 134, `SIGABRT` through a shell.
//
// The second thread is handed the signal through a pointer to the value that
// holds it, which is the hand-off the compiler cannot see and so does not lint;
// the owner word is what catches it, at run time, at the second walk.
package threads

type SigInbox: (i32 id, #signal(4) sig_inbox(i32 n))

private SigInbox sig_box

rawptr sig_second_consumer(rawptr arg):
    ^SigInbox box = ^SigInbox(arg)
    for n in #drain(box.sig_inbox):
        pass
    return nil

i32 test():
    for n in #drain(sig_box.sig_inbox):
        pass
    rawptr t = spawn(sig_second_consumer, rawptr(&sig_box))
    _ = join(t)
    return 0
