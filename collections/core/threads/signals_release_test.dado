@test
// `#release(sig)` hands a signal's consumption to another thread (R11.10).
//
// The one-consumer guard fixes a signal's owner at its first walk, so a second
// thread's walk traps (`signals_consumer_test`). `#release` is the consumer
// saying it is done: the owner word is cleared, and the next thread to walk
// the signal becomes its consumer — here the spawned thread, which takes the
// messages emitted before it started, releases in its turn, and hands the
// signal back to the first thread. In a debug build every walk is checked
// against the owner word, so the test reaching its end is the claim.
package threads

type RelInbox: (i32 id, #signal(8) rel_inbox(i32 n))

private RelInbox rel_box
private i32 rel_taken

rawptr rel_second_consumer(rawptr arg):
    ^RelInbox box = ^RelInbox(arg)
    for n in #drain(box.rel_inbox):
        rel_taken += n
    #release(box.rel_inbox)
    return nil

!i32 test():
    try #emit(rel_box.rel_inbox, 1) else 1
    for n in #drain(rel_box.rel_inbox):
        rel_taken += n
    #release(rel_box.rel_inbox)
    try #emit(rel_box.rel_inbox, 10) else 1
    try #emit(rel_box.rel_inbox, 100) else 1
    rawptr t = spawn(rel_second_consumer, rawptr(&rel_box))
    _ = join(t)
    try #emit(rel_box.rel_inbox, 1000) else 1
    for n in #drain(rel_box.rel_inbox):
        rel_taken += n
    return 0 if rel_taken == 1111 else 1
