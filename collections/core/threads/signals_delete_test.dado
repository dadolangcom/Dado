@test 134
// `#delete` of a value whose signal still holds `ref`s traps in a debug build,
// naming the signal: freeing the value would leak every allocation queued in
// it. This test passes by aborting — status 134.
package threads

type SigParcel: (i32 id, #signal(2) sig_parcels(i32 n, ref []u8 bytes))

i32 test():
    ref SigParcel box = #new(SigParcel)
    ref []u8 data = #make([]u8, 2)
    try #emit(box.sig_parcels, 1, data) else:
        #delete(data)
    #delete(box)
    return 0
