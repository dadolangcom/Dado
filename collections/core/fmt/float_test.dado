@test
// The float putters added beside `put_float`: the padded form, exponent
// notation, and the two renderers a script calls. Exponent notation is
// claimed at its edges — a carry out of the first digit, a halfway digit
// both ways, the smallest subnormal, zero, and `f32` read at its own width.
package fmt

[128]char8 store
Cursor scratch

// What landed in `scratch` is `want`; rewinds either way.
private bool is(string8 want, string8 label):
    string8 got = written(scratch)
    bool ok = #expect(got == want, label, ": got \"", got, "\" and should have been \"", want, "\"")
    rewind(&scratch)
    return ok

// `render_float(v, places)` is `want`. Promised, so the build checks that
// the fixed-point renderer raises into a script.
#assert_raises
private bool rendered_fixed(f64 v, i32 places, string8 want):
    [40]char8 buf
    i32 n = render_float(v, places, buf[:])
    string8 got = string8(buf[0..<i64(n)])
    return #expect(got == want, "render_float: got \"", got, "\" and should have been \"", want, "\"")

// `render_float_exp(v, places)` is `want`, at both widths.
#assert_raises
private bool rendered_exp(f64 v, i32 places, string8 want):
    [24]char8 buf
    i32 n = render_float_exp(v, places, buf[:])
    string8 got = string8(buf[0..<i64(n)])
    return #expect(got == want, "render_float_exp: got \"", got, "\" and should have been \"", want, "\"")

#assert_raises
private bool rendered_exp32(f32 v, i32 places, string8 want):
    [24]char8 buf
    i32 n = render_float_exp(v, places, buf[:])
    string8 got = string8(buf[0..<i64(n)])
    return #expect(got == want, "render_float_exp f32: got \"", got, "\" and should have been \"", want, "\"")

// The `Pad` and `Cursor` verbs, which take no `Sink` and so are promised too.
#assert_raises
private bool pads_and_cursors():
    Pad a = right(4)
    Pad b = left(4)
    Pad c = zeros(4)
    [8]char8 mem
    Cursor k = over(mem[:])
    rewind(&k)
    return a.width == 4 && b.align == Align.Left && c.fill == '0' && written(k) == "" && !is_nan(1.0) && !is_infinite(1.0)

i32 test():
    bool ok = true
    scratch = over(store[:])
    Sink out = to_bytes(&scratch)

    // ── put_float_pad ────────────────────────────────────────────────────────
    _ = put_float_pad(1.5, 2, right(8), out)
    ok = is("    1.50", "put_float_pad right") && ok
    f64 minus = 0.0 - 1.5
    _ = put_float_pad(minus, 2, right(8), out)
    ok = is("   -1.50", "put_float_pad negative") && ok
    _ = put_float_pad(1.5, 1, left(6), out)
    ok = is("1.5   ", "put_float_pad left") && ok
    _ = put_float_pad(2.25, 2, zeros(7), out)
    ok = is("0002.25", "put_float_pad zeros") && ok
    // The zeros go after the sign, as `put_signed_pad`'s do.
    _ = put_float_pad(f64(0.0 - 1.5), 2, zeros(8), out)
    ok = is("-0001.50", "put_float_pad negative zeros") && ok
    _ = put_float_pad(f64(0.0 - 1.5), 2, right(8), out)
    ok = is("   -1.50", "put_float_pad negative right") && ok
    _ = put_float_pad(123.456, 3, right(3), out)
    ok = is("123.456", "put_float_pad never truncates") && ok

    // ── put_float_exp ────────────────────────────────────────────────────────
    _ = put_float_exp(1500.0, 2, out)
    ok = is("1.50e+03", "put_float_exp") && ok
    _ = put_float_exp(0.15625, 3, out)
    ok = is("1.562e-01", "put_float_exp of an exact halfway value, to even") && ok
    _ = put_float_exp(0.00012, 3, out)
    ok = is("1.200e-04", "put_float_exp of a small value") && ok
    _ = put_float_exp(9.9999, 2, out)
    ok = is("1.00e+01", "put_float_exp carries out of the first digit") && ok
    _ = put_float_exp(1.0, 0, out)
    ok = is("1e+00", "put_float_exp with no places") && ok
    _ = put_float_exp(0.0, 3, out)
    ok = is("0.000e+00", "put_float_exp of zero") && ok
    _ = put_float_exp(minus, 1, out)
    ok = is("-1.5e+00", "put_float_exp negative") && ok
    _ = put_float_exp(1.0e300, 1, out)
    ok = is("1.0e+300", "put_float_exp three exponent digits") && ok
    // The smallest subnormal's shortest digits are one `5`, so more places
    // are zeros, where C's `%.2e` writes the binary value's `4.94e-324`.
    _ = put_float_exp(5.0e-324, 2, out)
    ok = is("5.00e-324", "put_float_exp of the smallest subnormal") && ok
    _ = put_float_exp(f32(0.1), 3, out)
    ok = is("1.000e-01", "put_float_exp of an f32 at its own width") && ok
    _ = put_float_exp(2.5, 0, out)
    ok = is("2e+00", "put_float_exp halfway to even, down") && ok
    _ = put_float_exp(3.5, 0, out)
    ok = is("4e+00", "put_float_exp halfway to even, up") && ok
    f64 zero_f = 0.0
    f64 inf = 1.0 / zero_f
    _ = put_float_exp(inf, 2, out)
    ok = is("inf", "put_float_exp inf") && ok
    _ = put_float_exp(inf - inf, 2, out)
    ok = is("nan", "put_float_exp nan") && ok

    // The fixed path past 10^18 is the exponent path, and a mantissa that
    // rounds up to ten moves the exponent rather than writing `10.00`.
    _ = put_float(9.9999999e18, 2, out)
    ok = is("1.00e+19", "put_float past the fixed ceiling carries") && ok

    // ── the renderers ────────────────────────────────────────────────────────
    ok = rendered_fixed(2.5, 2, "2.50") && ok
    ok = rendered_fixed(minus, 0, "-2") && ok
    ok = rendered_exp(1500.0, 2, "1.50e+03") && ok
    ok = rendered_exp32(f32(0.1), 2, "1.00e-01") && ok
    ok = #expect(pads_and_cursors(), "the Pad and Cursor verbs") && ok

    // A renderer given too little room writes nothing.
    [3]char8 small
    ok = #expect(render_float(2.5, 2, small[:]) == 0, "render_float wrote into too small a buffer") && ok

    if ok: return 0
    return 1
