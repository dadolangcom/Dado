@test
// Every public name in `core:fmt`, and both arms of every branch it has.
//
// The shape of every check is the same: render into a `Cursor` over this file's
// own storage, compare `written` against the text it should be, rewind. That is
// one helper — `is` — and it is what lets a hundred expectations read as one
// line each.
//
// **The failures accumulate and the test fails once.** `#expect` answers the
// claim it was given, so `ok = #expect(...) && ok` runs every check, reports
// every failure, and still ends in a single non-zero exit. `#assert` is not used
// here: nothing below is an invariant of the *program*, it is all an expectation
// about a library, and an abort would hide every check after the first bad one.
package fmt

[512]char8 store
Cursor scratch

// Render through `body`, compare what landed against `want`, and rewind.
//
// It takes the rendered text rather than a function, because a function
// reference here would have to be one per check and Dado has no closures — so
// the call site does the rendering into the shared cursor and this compares.
private bool is(string8 want, string8 label):
    string8 got = written(scratch)
    bool ok = #expect(got == want, label, ": got \"", got, "\" and should have been \"", want, "\"")
    rewind(&scratch)
    return ok

i32 test():
    bool ok = true
    scratch = over(store[:])
    Sink out = to_bytes(&scratch)

    // ── put_bytes, and the two guards every putter inherits from it ─────────
    _ = put_string("hello", out)
    ok = is("hello", "put_string") && ok

    // A zero-length slice: the `count <= 0` arm, and the reason `put_bytes` guards
    // before taking the address of element 0.
    []char8 empty = store[0..<0]
    i64 nothing = put_bytes(empty, out)
    ok = #expect(nothing == 0, "put_bytes of an empty slice took ", nothing) && ok
    ok = is("", "put_bytes empty") && ok

    // A nil sink takes nothing and does not fault — the `out.proc == nil` arm,
    // reached through both `put_bytes` and `put_string`.
    Sink unset = (nil, nil)
    ok = #expect(put_bytes(store[0..<3], unset) == 0, "a nil sink took bytes from put_bytes") && ok
    ok = #expect(put_string("x", unset) == 0, "a nil sink took bytes from put_string") && ok

    // The empty string: `put_string`'s own `count <= 0` arm.
    ok = #expect(put_string("", out) == 0, "the empty string wrote bytes") && ok

    _ = put_cstring("via C", out)
    ok = is("via C", "put_cstring") && ok

    // `nil` borrows as the empty string rather than walking from address zero.
    cstring absent = nil
    ok = #expect(put_cstring(absent, out) == 0, "a nil cstring wrote bytes") && ok

    _ = put_char('q', out)
    ok = is("q", "put_char") && ok

    // ── put_repeat, over and under the one-chunk boundary ───────────────────
    _ = put_repeat('-', 5, out)
    ok = is("-----", "put_repeat short") && ok

    ok = #expect(put_repeat('-', 0, out) == 0, "put_repeat(0) wrote bytes") && ok
    ok = #expect(put_repeat('-', 0 - 3, out) == 0, "put_repeat(-3) wrote bytes") && ok

    // Past SCRATCH, so the chunking loop runs more than once and the `chunk >
    // SCRATCH` clamp is taken.
    i64 many = put_repeat('.', 200, out)
    ok = #expect(many == 200, "put_repeat(200) wrote ", many) && ok
    string8 landed = written(scratch)
    ok = #expect(#len(landed) == 200, "put_repeat(200) landed ", #len(landed)) && ok
    rewind(&scratch)

    // ── integers ────────────────────────────────────────────────────────────
    u32 nought = 0
    _ = put_unsigned(nought, out)
    ok = is("0", "put_unsigned zero") && ok

    u64 top = 18446744073709551615
    _ = put_unsigned(top, out)
    ok = is("18446744073709551615", "put_unsigned max") && ok

    _ = put_signed(0, out)
    ok = is("0", "put_signed zero") && ok

    _ = put_signed(1234567, out)
    ok = is("1234567", "put_signed positive") && ok

    _ = put_signed(i32(0 - 1234567), out)
    ok = is("-1234567", "put_signed negative") && ok

    // The one input where negating in `i64` would wrap to itself.
    i64 floor = 0 - 9223372036854775807 - 1
    _ = put_signed(floor, out)
    ok = is("-9223372036854775808", "put_signed i64 floor") && ok

    // ── bases ───────────────────────────────────────────────────────────────
    _ = put_base(255, 16, false, out)
    ok = is("ff", "put_base 16 lower") && ok

    _ = put_base(255, 16, true, out)
    ok = is("FF", "put_base 16 upper") && ok

    _ = put_base(255, 36, true, out)
    ok = is("73", "put_base 36") && ok

    _ = put_base(0, 2, false, out)
    ok = is("0", "put_base zero") && ok

    // A base with no digits to write in: total rather than empty.
    _ = put_base(255, 1, false, out)
    ok = is("0", "put_base below 2") && ok

    _ = put_base(255, 37, false, out)
    ok = is("0", "put_base above 36") && ok

    // ── hex and binary, with the prefix and the floor ───────────────────────
    u32 byte_max = 255
    _ = put_hex(byte_max, 0, false, false, out)
    ok = is("ff", "put_hex bare") && ok

    _ = put_hex(byte_max, 4, false, true, out)
    ok = is("0x00ff", "put_hex padded lower") && ok

    _ = put_hex(byte_max, 4, true, true, out)
    ok = is("0X00FF", "put_hex padded upper") && ok

    // `digits` is a floor and never a ceiling.
    u32 word_max = 65535
    _ = put_hex(word_max, 2, false, false, out)
    ok = is("ffff", "put_hex floor not ceiling") && ok

    u8 five = 5
    _ = put_binary(five, 0, false, out)
    ok = is("101", "put_binary bare") && ok

    _ = put_binary(five, 8, true, out)
    ok = is("0b00000101", "put_binary padded") && ok

    // ── alignment ───────────────────────────────────────────────────────────
    _ = put_string_pad("ab", right(5), out)
    ok = is("   ab", "pad right") && ok

    _ = put_string_pad("ab", left(5), out)
    ok = is("ab   ", "pad left") && ok

    _ = put_string_pad("ab", (5, Align.Center, ' '), out)
    ok = is(" ab  ", "pad center odd slack") && ok

    _ = put_string_pad("ab", (6, Align.Center, ' '), out)
    ok = is("  ab  ", "pad center even slack") && ok

    // A field narrower than its body is not a truncation.
    _ = put_string_pad("abcdef", right(3), out)
    ok = is("abcdef", "pad narrower than body") && ok

    // PLAIN pads nothing.
    _ = put_string_pad("ab", PLAIN, out)
    ok = is("ab", "PLAIN") && ok

    // A `Pad` named once and reused, which is what the type exists for: a
    // column is one value, not three arguments repeated at every call.
    Pad column = (7, Align.Right, '.')
    _ = put_string_pad("id", column, out)
    _ = put_string_pad("42", column, out)
    ok = is(".....id.....42", "a named Pad, reused") && ok

    _ = put_signed_pad(42, zeros(5), out)
    ok = is("00042", "put_signed_pad zeros") && ok

    // The sign is part of the field, which is what `zeros` documents.
    _ = put_signed_pad(i32(0 - 7), zeros(4), out)
    ok = is("00-7", "put_signed_pad negative zeros") && ok

    _ = put_signed_pad(i32(0 - 7), left(4), out)
    ok = is("-7  ", "put_signed_pad negative left") && ok

    u16 answer = 42
    _ = put_unsigned_pad(answer, right(5), out)
    ok = is("   42", "put_unsigned_pad") && ok

    // ── booleans ────────────────────────────────────────────────────────────
    _ = put_bool(true, out)
    ok = is("true", "put_bool true") && ok

    _ = put_bool(false, out)
    ok = is("false", "put_bool false") && ok

    _ = put_bool_as(true, "on", "off", out)
    ok = is("on", "put_bool_as true") && ok

    _ = put_bool_as(false, "on", "off", out)
    ok = is("off", "put_bool_as false") && ok

    // ── quoting, every arm ──────────────────────────────────────────────────
    _ = put_quoted("plain", out)
    ok = is("\"plain\"", "put_quoted plain") && ok

    _ = put_quoted("a\"b", out)
    ok = is("\"a\\\"b\"", "put_quoted quote") && ok

    _ = put_quoted("a\\b", out)
    ok = is("\"a\\\\b\"", "put_quoted backslash") && ok

    _ = put_quoted("a\nb", out)
    ok = is("\"a\\nb\"", "put_quoted newline") && ok

    _ = put_quoted("a\rb", out)
    ok = is("\"a\\rb\"", "put_quoted return") && ok

    _ = put_quoted("a\tb", out)
    ok = is("\"a\\tb\"", "put_quoted tab") && ok

    _ = put_quoted("a\0b", out)
    ok = is("\"a\\0b\"", "put_quoted nul") && ok

    _ = put_quoted("a\x01b", out)
    ok = is("\"a\\x01b\"", "put_quoted control") && ok

    _ = put_quoted("a\x7Fb", out)
    ok = is("\"a\\x7fb\"", "put_quoted delete") && ok

    // A high byte is part of a UTF-8 sequence and travels untouched.
    _ = put_quoted("a\xC3\xA9b", out)
    ok = is("\"a\xC3\xA9b\"", "put_quoted high bytes") && ok

    // ── floats ──────────────────────────────────────────────────────────────
    _ = put_float(3.14159, 2, out)
    ok = is("3.14", "put_float rounds down") && ok

    _ = put_float(3.14159, 4, out)
    ok = is("3.1416", "put_float rounds up") && ok

    _ = put_float(2.0, 0, out)
    ok = is("2", "put_float no decimals") && ok

    f64 minus = 0.0 - 2.5
    _ = put_float(minus, 1, out)
    ok = is("-2.5", "put_float negative") && ok

    // A fraction whose digits are fewer than `places`, so the zero fill runs.
    _ = put_float(1.5, 4, out)
    ok = is("1.5000", "put_float zero fill") && ok

    // `decimals` outside 0..=17 is clamped rather than refused.
    _ = put_float(1.25, 0 - 3, out)
    ok = is("1", "put_float negative decimals") && ok

    f64 zero_f = 0.0
    _ = put_float(zero_f, 2, out)
    ok = is("0.00", "put_float zero") && ok

    // The specials, asked without <math.h>.
    f64 nan = zero_f / zero_f
    ok = #expect(is_nan(nan), "is_nan said a NaN is not one") && ok
    ok = #expect(!is_nan(1.0), "is_nan said 1.0 is a NaN") && ok
    _ = put_float(nan, 2, out)
    ok = is("nan", "put_float nan") && ok

    f64 one = 1.0
    f64 inf = one / zero_f
    ok = #expect(is_infinite(inf), "is_infinite said an infinity is not one") && ok
    ok = #expect(!is_infinite(1.0), "is_infinite said 1.0 is infinite") && ok
    ok = #expect(!is_infinite(nan), "is_infinite said a NaN is infinite") && ok
    _ = put_float(inf, 2, out)
    ok = is("inf", "put_float inf") && ok

    _ = put_float(0.0 - inf, 2, out)
    ok = is("-inf", "put_float -inf") && ok

    // Past the fixed-point ceiling, so the scientific path runs.
    _ = put_float(1.0e20, 2, out)
    ok = is("1.00e+20", "put_float scientific") && ok

    // Below the ceiling but past a `u64` once scaled by `10^decimals`: the
    // value itself fits and `value * 10^decimals` does not. These once read
    // `0.000000` and `0.00000000000000000`.
    _ = put_float(1.0e15, 6, out)
    ok = is("1000000000000000.000000", "put_float 1e15 at 6") && ok

    _ = put_float(1.0e10, 17, out)
    ok = is("10000000000.00000000000000000", "put_float 1e10 at 17") && ok

    // Either side of `value * 10^decimals == 2^64`, at 6 and at 17 places.
    // Each value is exact in binary, so the expected text is the exact one.
    _ = put_float(18446744073709.5, 6, out)
    ok = is("18446744073709.500000", "put_float just under 2^64 scaled at 6") && ok

    _ = put_float(18446744073709.75, 6, out)
    ok = is("18446744073709.750000", "put_float just over 2^64 scaled at 6") && ok

    _ = put_float(184.25, 17, out)
    ok = is("184.25000000000000000", "put_float just under 2^64 scaled at 17") && ok

    _ = put_float(184.5, 17, out)
    ok = is("184.50000000000000000", "put_float just over 2^64 scaled at 17") && ok

    _ = put_float(123456789012.345678, 3, out)
    ok = is("123456789012.346", "put_float large with a rounded fraction") && ok

    // The largest `f64` below the ceiling is still fixed-point.
    _ = put_float(999999999999999872.0, 2, out)
    ok = is("999999999999999872.00", "put_float largest fixed-point value") && ok

    _ = put_float(1.0e300, 6, out)
    ok = is("1.000000e+300", "put_float 1e300") && ok

    f64 minus_1e15 = 0.0 - 1.0e15
    _ = put_float(minus_1e15, 6, out)
    ok = is("-1000000000000000.000000", "put_float -1e15 at 6") && ok

    f64 minus_large = 0.0 - 12345678.875
    _ = put_float(minus_large, 2, out)
    ok = is("-12345678.88", "put_float negative large rounds away from zero") && ok

    f64 minus_1e20 = 0.0 - 1.0e20
    _ = put_float(minus_1e20, 2, out)
    ok = is("-1.00e+20", "put_float negative scientific") && ok

    // Rounding the fraction up carries into the whole part.
    _ = put_float(9.9999996, 6, out)
    ok = is("10.000000", "put_float rounding carry") && ok

    f64 minus_carry = 0.0 - 9.9999996
    _ = put_float(minus_carry, 6, out)
    ok = is("-10.000000", "put_float negative rounding carry") && ok

    _ = put_float(2.5, 0, out)
    ok = is("3", "put_float carry at no decimals") && ok

    // ── put_float_shortest ──────────────────────────────────────────────────
    //
    // Each expectation is what Python's `repr` writes for the same `f64`, which
    // is the layout the function promises; the digits are the shortest that
    // read back, which `core:strings/parse`'s own suite checks by reading them.
    _ = put_float_shortest(0.1, out)
    ok = is("0.1", "shortest 0.1") && ok

    _ = put_float_shortest(1.0, out)
    ok = is("1.0", "shortest 1.0 keeps its point") && ok

    _ = put_float_shortest(100.0, out)
    ok = is("100.0", "shortest 100.0") && ok

    _ = put_float_shortest(123.456, out)
    ok = is("123.456", "shortest 123.456") && ok

    _ = put_float_shortest(1.0e23, out)
    ok = is("1e+23", "shortest 1e23") && ok

    _ = put_float_shortest(9007199254740993.0, out)
    ok = is("9007199254740992.0", "shortest 2^53 + 1 is 2^53") && ok

    _ = put_float_shortest(1234567890123456.0, out)
    ok = is("1234567890123456.0", "shortest: sixteen places before the point is still positional") && ok

    _ = put_float_shortest(1.0e16, out)
    ok = is("1e+16", "shortest: seventeen places before the point is an exponent") && ok

    _ = put_float_shortest(0.0001, out)
    ok = is("0.0001", "shortest 1e-4 is positional") && ok

    _ = put_float_shortest(0.00001, out)
    ok = is("1e-05", "shortest 1e-5 is an exponent of two digits") && ok

    _ = put_float_shortest(5.0e-324, out)
    ok = is("5e-324", "shortest smallest subnormal") && ok

    _ = put_float_shortest(2.2250738585072014e-308, out)
    ok = is("2.2250738585072014e-308", "shortest smallest normal") && ok

    _ = put_float_shortest(1.7976931348623157e308, out)
    ok = is("1.7976931348623157e+308", "shortest largest finite") && ok

    _ = put_float_shortest(0.30000000000000004, out)
    ok = is("0.30000000000000004", "shortest 0.1 + 0.2") && ok

    f64 negative_tenth = 0.0 - 0.1
    _ = put_float_shortest(negative_tenth, out)
    ok = is("-0.1", "shortest negative") && ok

    _ = put_float_shortest(zero_f, out)
    ok = is("0.0", "shortest zero") && ok

    f64 negative_zero = -zero_f
    _ = put_float_shortest(negative_zero, out)
    ok = is("-0.0", "shortest negative zero keeps its sign") && ok

    _ = put_float_shortest(inf, out)
    ok = is("inf", "shortest inf") && ok

    _ = put_float_shortest(0.0 - inf, out)
    ok = is("-inf", "shortest -inf") && ok

    _ = put_float_shortest(nan, out)
    ok = is("nan", "shortest nan") && ok

    f64 negative_nan = -nan
    _ = put_float_shortest(negative_nan, out)
    ok = is("nan", "shortest: every NaN is nan") && ok

    // An `f32` is written from its own digits, not its widening's.
    f32 tenth32 = 0.1
    _ = put_float_shortest(tenth32, out)
    ok = is("0.1", "shortest f32 0.1") && ok

    f32 third32 = 0.33333334
    _ = put_float_shortest(third32, out)
    ok = is("0.33333334", "shortest f32 a third") && ok

    f32 big32 = 3.4028235e38
    _ = put_float_shortest(big32, out)
    ok = is("3.4028235e+38", "shortest f32 largest finite") && ok

    f32 tiny32 = 1.0e-45
    _ = put_float_shortest(tiny32, out)
    ok = is("1e-45", "shortest f32 smallest subnormal") && ok

    f32 million32 = 16777216.0
    _ = put_float_shortest(million32, out)
    ok = is("16777216.0", "shortest f32 2^24") && ok

    f32 zero32 = 0.0
    f32 negative_zero32 = -zero32
    _ = put_float_shortest(negative_zero32, out)
    ok = is("-0.0", "shortest f32 negative zero") && ok

    // ── render_signed, render_unsigned, render_float_shortest ───────────────
    // The same text as their putters, into a slice and with no `Sink`.
    ok = rendered_signed(i64(0), "0") && ok
    ok = rendered_signed(i64(0 - 42), "-42") && ok
    ok = rendered_signed(i64(0 - 9223372036854775807 - 1), "-9223372036854775808") && ok
    ok = rendered_signed(i64(9223372036854775807), "9223372036854775807") && ok
    ok = rendered_signed(i8(128), "-128") && ok
    ok = rendered_signed(i32(2147483647), "2147483647") && ok
    ok = rendered_unsigned(u64(0), "0") && ok
    ok = rendered_unsigned(u64(18446744073709551615), "18446744073709551615") && ok
    ok = rendered_unsigned(u8(255), "255") && ok
    ok = rendered_unsigned(u32(600), "600") && ok
    ok = rendered_float(0.1, "0.1") && ok
    ok = rendered_float(1.0e23, "1e+23") && ok
    ok = rendered_float(0.0 - 2.2250738585072014e-308, "-2.2250738585072014e-308") && ok
    ok = rendered_float(negative_zero, "-0.0") && ok
    ok = rendered_float(inf, "inf") && ok
    ok = rendered_float(0.0 - inf, "-inf") && ok
    ok = rendered_float(nan, "nan") && ok
    ok = rendered_float32(tenth32, "0.1") && ok
    ok = rendered_float32(big32, "3.4028235e+38") && ok
    // Too small a slice: 0, and nothing written.
    [2]char8 two = ['x', 'x']
    ok = #expect(render_signed(i64(0 - 42), two[:]) == 0, "render_signed into 2 bytes wrote something") && ok
    ok = #expect(render_unsigned(u64(600), two[:]) == 0, "render_unsigned into 2 bytes wrote something") && ok
    ok = #expect(render_float_shortest(0.25, two[:]) == 0, "render_float_shortest into 2 bytes wrote something") && ok
    ok = #expect(two[0] == 'x' && two[1] == 'x', "a render that did not fit wrote into the slice") && ok
    ok = #expect(render_unsigned(u64(42), two[:]) == 2 && two[0] == '4' && two[1] == '2', "render_unsigned exactly filling the slice") && ok

    // ── the cursor's own surface ────────────────────────────────────────────
    ok = #expect(!scratch.overflowed, "the cursor overflowed before it was asked to") && ok

    [4]char8 tiny
    Cursor small = over(tiny[:])
    Sink cramped = to_bytes(&small)
    i64 took = put_string("abcdefgh", cramped)
    ok = #expect(took == 4, "a full cursor took ", took, " of 8") && ok
    ok = #expect(small.overflowed, "a truncating cursor did not say so") && ok
    ok = #expect(written(small) == "abcd", "the prefix was \"", written(small), "\"") && ok

    // Nothing more fits, so the `take <= 0` arm is taken.
    ok = #expect(put_string("i", cramped) == 0, "a full cursor took another byte") && ok
    rewind(&small)
    ok = #expect(!small.overflowed, "rewind kept the overflow flag") && ok
    string8 emptied = written(small)
    ok = #expect(#len(emptied) == 0, "rewind kept the bytes") && ok

    // A nil cursor pointer, and a zero-length write: the procedure's guards.
    Sink nil_cursor = (nil, nil)
    ok = #expect(put_string("x", nil_cursor) == 0, "a nil-proc sink took a byte") && ok

    // ── the counting sink ───────────────────────────────────────────────────
    i64 measured = 0
    Sink tape = counting(&measured)
    _ = put_string("hello", tape)
    _ = put_signed(i32(0 - 42), tape)
    ok = #expect(measured == 8, "counting measured ", measured, " and should have measured 8") && ok
    ok = #expect(put_string("", tape) == 0, "counting took a zero-length write") && ok

    // ── discard ─────────────────────────────────────────────────────────────
    Sink nowhere = discard()
    ok = #expect(put_string("gone", nowhere) == 4, "discard did not take its bytes") && ok
    ok = #expect(put_string("", nowhere) == 0, "discard took a zero-length write") && ok

    // ── an owned, growable run ──────────────────────────────────────────────
    ref []char8 grown = #make([]char8, 0)
    defer #delete(grown)
    Sink appended = to_run(&grown)
    _ = put_string("grow", appended)
    _ = put_signed(99, appended)
    ok = #expect(string8(grown[:]) == "grow99", "to_run built \"", string8(grown[:]), "\"") && ok
    ok = #expect(put_string("", appended) == 0, "to_run took a zero-length write") && ok

    // A run whose allocator refuses, so `#append`'s failure arm is taken and
    // the sink answers a short count rather than pretending.
    ref []char8 refused = #make([]char8, 0, (refuses, nil))
    Sink doomed = to_run(&refused)
    i64 short = put_string("nope", doomed)
    ok = #expect(short == 0, "a refusing run took ", short, " bytes") && ok

    // ── put: the default form, over a type this file does not name ──────────
    _ = put(true, out)
    ok = is("true", "put bool") && ok

    _ = put(i32(7), out)
    ok = is("7", "put i32") && ok

    string8 words = "text"
    _ = put(words, out)
    ok = is("text", "put string") && ok

    // A tuple every slot of which is one type renders in brackets rather than
    // parentheses — the compiler's own rule, and this is where it is pinned.
    Pair p = (1, 2)
    _ = put(p, out)
    ok = is("[1, 2]", "put uniform tuple") && ok

    Mixed m = (3, true)
    _ = put(m, out)
    ok = is("(3, true)", "put mixed tuple") && ok

    // ── the four printing functions ────────────────────────────────────────
    //
    // `write` and `writeln` take a sink, so their bytes can be compared the way
    // every other check here compares them. A mixture of types in one call is
    // the point: the pack is unrolled once per element and `#render` picks each
    // element's own form, which is what replaced the old builtin's argument
    // loop.
    write(out, "n = ", 7, " ", true)
    ok = is("n = 7 true", "write") && ok

    writeln(out, "n = ", 7)
    ok = is("n = 7\n", "writeln") && ok

    // A pack with nothing in it: `writeln(out)` is a blank line, which is what
    // `println()` was, and `write(out)` writes nothing at all.
    write(out)
    ok = is("", "write of an empty pack") && ok
    writeln(out)
    ok = is("\n", "writeln of an empty pack") && ok

    // `print` and `println` are the same two with `core:io`'s standard-output
    // sink filled in, so what is checkable here is that they compile, resolve
    // and run — the bytes go to the terminal and this test's own exit status is
    // what the harness reads.
    print("fmt_test: print ", 1, " ")
    println("and println ", true)

    if ok:
        return 0
    return 1

// `render_signed` of `v` is `want`. Promised, so the build checks that the
// renderers raise into a script at each width this file instantiates.
#assert_raises
private bool rendered_signed($T v, string8 want) where T is int && T in (i8, i16, i32, i64):
    [20]char8 buf
    i32 n = render_signed(v, buf[:])
    string8 got = string8(buf[0..<i64(n)])
    return #expect(got == want, "render_signed: got \"", got, "\" and should have been \"", want, "\"")

#assert_raises
private bool rendered_unsigned($T v, string8 want) where T is int && T in (u8, u16, u32, u64):
    [20]char8 buf
    i32 n = render_unsigned(v, buf[:])
    string8 got = string8(buf[0..<i64(n)])
    return #expect(got == want, "render_unsigned: got \"", got, "\" and should have been \"", want, "\"")

#assert_raises
private bool rendered_float(f64 v, string8 want):
    [24]char8 buf
    i32 n = render_float_shortest(v, buf[:])
    string8 got = string8(buf[0..<i64(n)])
    return #expect(got == want, "render_float_shortest: got \"", got, "\" and should have been \"", want, "\"")

#assert_raises
private bool rendered_float32(f32 v, string8 want):
    [24]char8 buf
    i32 n = render_float_shortest(v, buf[:])
    string8 got = string8(buf[0..<i64(n)])
    return #expect(got == want, "render_float_shortest f32: got \"", got, "\" and should have been \"", want, "\"")

// A shape declared here and named nowhere in `core:fmt`, which is what `put`
// exists to demonstrate.
private type Pair: (i32 a, i32 b)

// And one whose slots are not, so both renderings are exercised.
private type Mixed: (i32 n, bool flag)

// An allocator that refuses every mode, so the failure side of `#append` is a
// path this test takes rather than one a reader trusts.
private rawptr refuses(rawptr data, AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    return nil
