@test
// Most of this package is a **restatement** of `<math.h>`,
// and testing that `sqrt` computes a square root would be testing libm, which
// is better tested than this file could be. So the wrappers are checked for the
// one thing a wrapper can get wrong — being wired to the wrong C function — with
// a single value each where the answer is exact in binary, and the weight of the
// file goes where the *Dado* is:
//
//   * `min`, `max` and `clamp`, which are written here and are generic over
//     `number`, so one source serves every width and a mistake in it is a
//     mistake at every width — and whose NaN and crossed-bounds answers are
//     defined in `math.dado` and claimed here;
//   * `power`, which is Dado's own exponentiation-by-squaring with **two
//     independent bindings** — a float base and an int exponent — and is the one
//     body in this package with a loop in it;
//   * `radians`/`degrees`, whose factor is written once here so no call site
//     carries a bare `3.14159 / 180`.
//
// **Rounding is claimed at negative values and at halves**, because that is where
// the four rounding wrappers differ from each other: at 2.5 they answer 2, 3, 2
// and 3, and at −1.7 they answer −2, −1, −1 and −2. A test written only at 1.2
// cannot tell `floor` from `trunc`.
package math

// Floating-point equality, at a tolerance. `==` on an `f64` that came back from
// libm is a claim about the last bit, which is not what any expectation below
// means — and writing the tolerance once is what keeps every claim comparing at
// the same bar. Not `private`: this file is the only member that names it.
bool near(f64 a, f64 b):
    return magnitude(a - b) < 0.000000001

i32 test():
    bool ok = true

    // ── min / max / clamp, at two widths ─────────────────────────────────────
    //
    // `number` is the intersection of every numeric's operators, so these are
    // one source and the widths below are separate instantiations of it. Both
    // are claimed, because "one source" is exactly the thing that would make a
    // single-width test look like coverage while an instantiation was wrong.

    // Ordered, both ways round, so a `<` flipped to `>` fails rather than
    // passing on a symmetric argument list.
    ok = #expect(min(3, 8) == 3, "min(3, 8) was ", min(3, 8)) && ok
    ok = #expect(min(8, 3) == 3, "min(8, 3) was ", min(8, 3)) && ok
    ok = #expect(max(3, 8) == 8, "max(3, 8) was ", max(3, 8)) && ok
    ok = #expect(max(8, 3) == 8, "max(8, 3) was ", max(8, 3)) && ok

    // **The equal case**, which is the boundary of a comparison and the arm no
    // ordered pair reaches: `min` tests `b < a` and falls through to `a`, `max`
    // tests `b > a` and falls through to `a`, so an equal pair is the only input
    // that proves the fall-through returns an operand at all rather than, say,
    // a zero.
    ok = #expect(min(5, 5) == 5, "min(5, 5) was ", min(5, 5)) && ok
    ok = #expect(max(5, 5) == 5, "max(5, 5) was ", max(5, 5)) && ok

    // Negatives, where a `magnitude`-flavoured mistake shows. **Bound first**,
    // and that is ERR0504 rather than style: a binding is inferred from the
    // arguments, and `0 - 4` is an untyped literal expression that supplies no
    // answer of its own — `min(0 - 4, 2)` is refused for the same reason
    // `min(3, 8)` is accepted only because the default width answers it.
    i32 neg4 = 0 - 4
    i32 neg9 = 0 - 9
    i32 two = 2
    ok = #expect(min(neg4, two) == neg4, "min(-4, 2) was ", min(neg4, two)) && ok
    ok = #expect(max(neg4, neg9) == neg4, "max(-4, -9) was ", max(neg4, neg9)) && ok

    // The second width: the same three functions, off `f64` arguments.
    ok = #expect(near(min(3.0, 8.0), 3.0), "min(3.0, 8.0) was ", min(3.0, 8.0)) && ok
    ok = #expect(near(max(3.0, 8.0), 8.0), "max(3.0, 8.0) was ", max(3.0, 8.0)) && ok
    ok = #expect(near(min(5.0, 5.0), 5.0), "min(5.0, 5.0) was ", min(5.0, 5.0)) && ok
    ok = #expect(near(max(5.0, 5.0), 5.0), "max(5.0, 5.0) was ", max(5.0, 5.0)) && ok

    // A third, unsigned, because `number` includes the unsigned widths and a
    // body that reached for a signed comparison would be wrong only there.
    u8 lo = 7
    u8 hi = 200
    ok = #expect(min(lo, hi) == 7, "min over u8 was ", min(lo, hi)) && ok
    ok = #expect(max(lo, hi) == 200, "max over u8 was ", max(lo, hi)) && ok

    // `clamp` is `min(max(x, low), high)`, so its three arms are: below the
    // window, inside it, above it — plus the two ends, which are *in* the
    // window and are where an exclusive comparison would show.
    ok = #expect(clamp(0, 1, 3) == 1, "clamp below the window was ", clamp(0, 1, 3)) && ok
    ok = #expect(clamp(2, 1, 3) == 2, "clamp inside the window was ", clamp(2, 1, 3)) && ok
    ok = #expect(clamp(9, 1, 3) == 3, "clamp above the window was ", clamp(9, 1, 3)) && ok
    ok = #expect(clamp(1, 1, 3) == 1, "clamp at the low end was ", clamp(1, 1, 3)) && ok
    ok = #expect(clamp(3, 1, 3) == 3, "clamp at the high end was ", clamp(3, 1, 3)) && ok

    // A degenerate window — `low == high` — is one point, and every input maps
    // to it. The equal case of `min` and `max` at once, reached through the
    // composition rather than directly.
    ok = #expect(clamp(0, 4, 4) == 4, "clamp into a one-point window was ", clamp(0, 4, 4)) && ok
    ok = #expect(clamp(9, 4, 4) == 4, "clamp into a one-point window was ", clamp(9, 4, 4)) && ok
    ok = #expect(near(clamp(1.5, 0.0, 1.0), 1.0), "clamp over f64 was ", clamp(1.5, 0.0, 1.0)) && ok

    // **Crossed bounds — `low > high` — are defined, and `high` wins**, from
    // below the window, inside the gap and above it alike. Claimed from all
    // three sides, because a body that lowered to `high` first and raised to
    // `low` second would answer `low` from every one of them.
    ok = #expect(clamp(0, 5, 2) == 2, "clamp below crossed bounds was ", clamp(0, 5, 2)) && ok
    ok = #expect(clamp(3, 5, 2) == 2, "clamp between crossed bounds was ", clamp(3, 5, 2)) && ok
    ok = #expect(clamp(9, 5, 2) == 2, "clamp above crossed bounds was ", clamp(9, 5, 2)) && ok


    // ── power ────────────────────────────────────────────────────────────────
    //
    // Exponentiation by squaring, and the one loop in this package. Claimed at
    // **two instantiations**, because the base and the exponent bind
    // independently and a body that assumed one width for both would still
    // compile for the case where they agree.
    //
    // Every value is a power of two, so every product is exact in binary and
    // these are `==`-grade claims written through `near` for consistency.
    ok = #expect(near(power(2.0, 10), 1024.0), "power(2.0, 10) was ", power(2.0, 10)) && ok
    ok = #expect(near(power(2.0, 1), 2.0), "power(2.0, 1) was ", power(2.0, 1)) && ok

    // **The zero exponent**, which is the loop's not-taken case and the only
    // input for which the answer is not a product of anything: `1.0`, from the
    // accumulator's initial value alone.
    ok = #expect(near(power(2.0, 0), 1.0), "power(2.0, 0) was ", power(2.0, 0)) && ok
    ok = #expect(near(power(0.0, 0), 1.0), "power(0.0, 0) was ", power(0.0, 0)) && ok
    ok = #expect(near(power(0.0, 5), 0.0), "power(0.0, 5) was ", power(0.0, 5)) && ok

    // A negative base, where the parity of the exponent decides the sign — the
    // property that fails if the `(e & 1)` test is dropped and every square is
    // multiplied in.
    f64 neg_base = 0.0 - 2.0
    ok = #expect(near(power(neg_base, 3), 0.0 - 8.0), "power(-2.0, 3) was ", power(neg_base, 3)) && ok
    ok = #expect(near(power(neg_base, 4), 16.0), "power(-2.0, 4) was ", power(neg_base, 4)) && ok

    // The second instantiation: an `f32` base and a `u8` exponent, which share
    // nothing with the pair above. `power(2.0, 10)` at `f32` is still exact —
    // 1024 has one significant bit.
    f32 base = 2.0
    u8 exponent = 10
    f32 small = power(base, exponent)
    ok = #expect(near(f64(small), 1024.0), "power at (f32, u8) was ", small) && ok

    // An exponent large enough that the squaring runs several rounds, so the
    // loop is doing more than one pass: 2^20 is 1 048 576.
    ok = #expect(near(power(2.0, 20), 1048576.0), "power(2.0, 20) was ", power(2.0, 20)) && ok

    // ── the constants, and the two conversions written over them ─────────────
    //
    // `TAU` is `2 * PI` by definition, so the pair is claimed against each other
    // rather than against a transcription — a typo in either digit string is
    // what this catches, and a transcribed expectation would have to be typed a
    // third time to catch it.
    ok = #expect(near(TAU, PI * 2.0), "TAU was not 2 * PI: ", TAU) && ok

    ok = #expect(near(radians(180.0), PI), "radians(180) was ", radians(180.0)) && ok
    ok = #expect(near(radians(0.0), 0.0), "radians(0) was ", radians(0.0)) && ok
    ok = #expect(near(degrees(PI), 180.0), "degrees(PI) was ", degrees(PI)) && ok
    // Round trip, which is the property a caller actually relies on and the one
    // that fails if the two factors are the same way up.
    ok = #expect(near(degrees(radians(57.0)), 57.0), "the degree round trip lost ", 57.0 - degrees(radians(57.0))) && ok

    // ── rounding, at the values where the four differ ────────────────────────
    //
    //         2.5    -2.5   -1.7
    //   down    2      -3     -2
    //   up      3      -2     -1
    //   toward  2      -2     -1
    //   nearest 3      -3     -2      (`round` breaks halves away from zero)
    ok = #expect(near(down(2.5), 2.0), "down(2.5) was ", down(2.5)) && ok
    ok = #expect(near(up(2.5), 3.0), "up(2.5) was ", up(2.5)) && ok
    ok = #expect(near(toward_zero(2.5), 2.0), "toward_zero(2.5) was ", toward_zero(2.5)) && ok
    ok = #expect(near(nearest(2.5), 3.0), "nearest(2.5) was ", nearest(2.5)) && ok

    ok = #expect(near(down(0.0 - 2.5), 0.0 - 3.0), "down(-2.5) was ", down(0.0 - 2.5)) && ok
    ok = #expect(near(up(0.0 - 2.5), 0.0 - 2.0), "up(-2.5) was ", up(0.0 - 2.5)) && ok
    ok = #expect(near(toward_zero(0.0 - 2.5), 0.0 - 2.0), "toward_zero(-2.5) was ", toward_zero(0.0 - 2.5)) && ok
    ok = #expect(near(nearest(0.0 - 2.5), 0.0 - 3.0), "nearest(-2.5) was ", nearest(0.0 - 2.5)) && ok

    ok = #expect(near(down(0.0 - 1.7), 0.0 - 2.0), "down(-1.7) was ", down(0.0 - 1.7)) && ok
    ok = #expect(near(toward_zero(0.0 - 1.7), 0.0 - 1.0), "toward_zero(-1.7) was ", toward_zero(0.0 - 1.7)) && ok

    // An integral input is a fixed point of all four, which is the boundary
    // between the arms rather than a value inside one.
    ok = #expect(near(down(4.0), 4.0) && near(up(4.0), 4.0), "a whole number moved under down/up") && ok
    ok = #expect(near(toward_zero(4.0), 4.0) && near(nearest(4.0), 4.0), "a whole number moved under toward_zero/nearest") && ok

    // `magnitude` and `remainder`, whose sign rules are the reason they are
    // here: `fabs` has none, and `fmod` takes the **numerator's**.
    ok = #expect(near(magnitude(0.0 - 3.5), 3.5), "magnitude(-3.5) was ", magnitude(0.0 - 3.5)) && ok
    ok = #expect(near(magnitude(3.5), 3.5), "magnitude(3.5) was ", magnitude(3.5)) && ok
    ok = #expect(near(magnitude(0.0), 0.0), "magnitude(0) was ", magnitude(0.0)) && ok
    ok = #expect(near(remainder(7.0, 3.0), 1.0), "remainder(7, 3) was ", remainder(7.0, 3.0)) && ok
    ok = #expect(near(remainder(0.0 - 7.0, 3.0), 0.0 - 1.0), "remainder(-7, 3) took the denominator's sign: ", remainder(0.0 - 7.0, 3.0)) && ok

    // ── the libm wrappers, one exact value each ──────────────────────────────
    //
    // Not a test of libm. A test that each name is bound to the function it
    // says it is — which is what a `sqrt` wired to `fabs` would fail, and what
    // nothing else in the gate would notice.
    ok = #expect(near(root(16.0), 4.0), "root(16) was ", root(16.0)) && ok
    ok = #expect(near(root(0.0), 0.0), "root(0) was ", root(0.0)) && ok
    ok = #expect(near(raised(3.0, 4.0), 81.0), "raised(3, 4) was ", raised(3.0, 4.0)) && ok
    // `length` is `hypot`, and 3-4-5 is the triangle that says so exactly.
    ok = #expect(near(length(3.0, 4.0), 5.0), "length(3, 4) was ", length(3.0, 4.0)) && ok
    ok = #expect(near(length(0.0, 0.0), 0.0), "length(0, 0) was ", length(0.0, 0.0)) && ok
    ok = #expect(near(e_to(0.0), 1.0), "e_to(0) was ", e_to(0.0)) && ok
    ok = #expect(near(ln(1.0), 0.0), "ln(1) was ", ln(1.0)) && ok
    ok = #expect(near(log_2(1024.0), 10.0), "log_2(1024) was ", log_2(1024.0)) && ok
    ok = #expect(near(log_10(1000.0), 3.0), "log_10(1000) was ", log_10(1000.0)) && ok
    ok = #expect(near(sine(0.0), 0.0), "sine(0) was ", sine(0.0)) && ok
    ok = #expect(near(cosine(0.0), 1.0), "cosine(0) was ", cosine(0.0)) && ok
    ok = #expect(near(tangent(0.0), 0.0), "tangent(0) was ", tangent(0.0)) && ok
    // `sine` and `cosine` are told apart at PI/2, where they answer 1 and 0 —
    // the pair a swap of the two bindings would fail and the values at 0 would
    // not.
    ok = #expect(near(sine(PI / 2.0), 1.0), "sine(PI/2) was ", sine(PI / 2.0)) && ok
    ok = #expect(near(cosine(PI / 2.0), 0.0), "cosine(PI/2) was ", cosine(PI / 2.0)) && ok
    // `angle` is `atan2` and carries the quadrant, which is the whole reason to
    // prefer it: (−1, −1) is in the third quadrant, and `atan(y / x)` would put
    // it in the first.
    ok = #expect(near(angle(1.0, 1.0), PI / 4.0), "angle(1, 1) was ", angle(1.0, 1.0)) && ok
    ok = #expect(near(angle(0.0 - 1.0, 0.0 - 1.0), 0.0 - (PI * 0.75)), "angle(-1, -1) lost its quadrant: ", angle(0.0 - 1.0, 0.0 - 1.0)) && ok

    // An invariant rather than an expectation: `sin² + cos² = 1` is the identity
    // the whole trigonometric half rests on, and if it did not hold the package
    // would be describing something other than a circle.
    f64 s = sine(1.0)
    f64 c = cosine(1.0)
    #assert(near((s * s) + (c * c), 1.0), "sin^2 + cos^2 was ", (s * s) + (c * c))

    // ── classification, and the two values Dado cannot write down ─────────────
    //
    // **A NaN and an infinity are built here, because there is no literal for
    // either.** The language has no spelling for them and no other file in this
    // tree makes one, so these four lines are the first of their kind and the
    // recipe is worth reading rather than copying. Both come out of a division:
    // `zero / zero` is the NaN, `one / zero` the infinity, and negating the
    // numerator gives the other infinity.
    //
    // **The operands are bound first, and that is not decoration.** Written as
    // the literal `0.0 / 0.0` the division is a constant expression, and what
    // becomes of a constant expression with no value is the C compiler's
    // business — it may fold it, warn about it, or refuse it, and which of the
    // three costs nothing to avoid. Through a binding it is arithmetic on two
    // `double`s at run time, which every C compiler does the same way.
    f64 zero_d = 0.0
    f64 one_d = 1.0
    f64 nan = zero_d / zero_d
    f64 inf = one_d / zero_d
    f64 neg_inf = (0.0 - one_d) / zero_d

    // Four inputs each, because the wrong binding is the failure being looked
    // for and only the full square finds it: an `is_nan` wired to `isinf` still
    // answers false at 2.5 and at 0, and is caught on the first two rows alone.
    ok = #expect(is_nan(nan), "is_nan(0/0) was false") && ok
    ok = #expect(!is_nan(inf), "is_nan(inf) was true") && ok
    ok = #expect(!is_nan(2.5), "is_nan(2.5) was true") && ok
    ok = #expect(!is_nan(0.0), "is_nan(0) was true") && ok

    ok = #expect(is_infinite(inf), "is_infinite(1/0) was false") && ok
    // **Negative infinity is the row that pays for the `bool` restatement.**
    // The C macro is free to answer any nonzero value here and glibc answers
    // −1, so this is the input on which a truth value that had been carried
    // across as an `i32` and compared against 1 would read as false.
    ok = #expect(is_infinite(neg_inf), "is_infinite(-1/0) was false") && ok
    ok = #expect(!is_infinite(nan), "is_infinite(nan) was true") && ok
    ok = #expect(!is_infinite(2.5), "is_infinite(2.5) was true") && ok
    ok = #expect(!is_infinite(0.0), "is_infinite(0) was true") && ok

    // ── fused multiply-add ───────────────────────────────────────────────────
    //
    // The wiring first, at whole numbers where the answer is exact in binary
    // and the third argument is not interchangeable with the other two: 2·3+4
    // is 10, where 2·4+3 is 11 and 4·3+2 is 14. A wrapper that passed its
    // arguments in the wrong order fails this line.
    ok = #expect(near(fused_multiply_add(2.0, 3.0, 4.0), 10.0), "fused_multiply_add(2, 3, 4) was ", fused_multiply_add(2.0, 3.0, 4.0)) && ok
    ok = #expect(near(fused_multiply_add(0.0, 5.0, 7.0), 7.0), "fused_multiply_add(0, 5, 7) was ", fused_multiply_add(0.0, 5.0, 7.0)) && ok

    // Then the single rounding, which is the whole of the name. With `eps` the
    // gap between 1 and the next `f64` up, `(1+eps)·(1−eps)` is exactly
    // `1 − eps²` — a value one bit too wide to be an `f64` — so a `*` that
    // rounds on its own returns 1.0 and the residual is gone before the `+`
    // ever sees it. Rounded once, the answer is the residual: −eps², about
    // −4.9e−32. It is small, so the claim is `!= 0.0` and not `near`, whose
    // tolerance would swallow the entire quantity under test.
    f64 eps = 1.0 / power(2.0, 52)
    f64 just_over = 1.0 + eps
    f64 just_under = 1.0 - eps
    f64 minus_one = 0.0 - 1.0
    ok = #expect(fused_multiply_add(just_over, just_under, minus_one) != 0.0, "the fused product rounded twice and lost its residual: ", fused_multiply_add(just_over, just_under, minus_one)) && ok
    ok = #expect(fused_multiply_add(just_over, just_under, minus_one) < 0.0, "the residual had the wrong sign: ", fused_multiply_add(just_over, just_under, minus_one)) && ok

    // **The other half of that comparison is deliberately not claimed**, and
    // the reason is the one honest limit on the two lines above. The obvious
    // companion is that `just_over * just_under + minus_one` *is* 0.0 — and
    // that is not a fact about this package, it is a fact about the C compiler,
    // which is free to contract a multiply and an add into one fused operation
    // and decides for itself whether to. Measured here: gcc leaves it alone and
    // answers 0.0; clang at `-O2` contracts it and answers the same residual as
    // the line above.
    //
    // The cost of that is worth writing down rather than glossing. Swap the
    // body of `fused_multiply_add` for `(x * y) + z` and these two lines fail
    // under gcc and **pass** under clang, so they are a wiring check on one of
    // the two compilers and a tautology on the other. That is still worth
    // having — it is the only claim in this file that reaches the rounding at
    // all — but the claim it makes is `fused_multiply_add` rounds once, which
    // every conforming libm owes, and not `*` and `+` round twice, which no
    // compiler promises.

    // **`min`, `max` and `clamp` over a NaN**, the one built above. Every
    // comparison with a NaN is false, so the rule — the first argument unless
    // a comparison says otherwise — decides it: a NaN first is kept, a NaN
    // second is never chosen, a NaN clamped stays NaN, and a NaN bound bounds
    // nothing.
    ok = #expect(is_nan(min(nan, 1.0)), "min(NaN, 1) dropped the NaN: ", min(nan, 1.0)) && ok
    ok = #expect(near(min(1.0, nan), 1.0), "min(1, NaN) chose the NaN: ", min(1.0, nan)) && ok
    ok = #expect(is_nan(max(nan, 1.0)), "max(NaN, 1) dropped the NaN: ", max(nan, 1.0)) && ok
    ok = #expect(near(max(1.0, nan), 1.0), "max(1, NaN) chose the NaN: ", max(1.0, nan)) && ok
    ok = #expect(is_nan(clamp(nan, 0.0, 1.0)), "clamp(NaN) came back a number: ", clamp(nan, 0.0, 1.0)) && ok
    ok = #expect(near(clamp(2.0, nan, 1.0), 1.0), "a NaN low bound bounded: ", clamp(2.0, nan, 1.0)) && ok
    ok = #expect(near(clamp(0.0 - 2.0, 0.0, nan), 0.0), "a NaN high bound bounded: ", clamp(0.0 - 2.0, 0.0, nan)) && ok
    ok = #expect(near(clamp(0.5, nan, nan), 0.5), "two NaN bounds moved the value: ", clamp(0.5, nan, nan)) && ok

    if ok:
        return 0
    return 1
