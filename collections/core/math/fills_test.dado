@test
// The functions `core:math` gained beside its first set: the inverse and
// hyperbolic trigonometry, the cube root and the accurate-near-zero
// exponentials, the exact helpers, the constants and the generic
// arithmetic. As in `math_test.dado`, a wrapper is checked for being wired
// to the right function at values whose answers are exact or nearly so;
// `soft_test.dado` measures the accuracy of the Dado ones.
package math

// Within a few units of the last place of a value near 1.
private bool close(f64 a, f64 b):
    return abs(a - b) < 0.000000000001

i32 test():
    bool ok = true
    f64 zero = 0.0
    f64 nan_value = nan()
    f64 inf = infinity()

    // ── inverse trigonometry ────────────────────────────────────────────────
    ok = #expect(close(arcsine(1.0), PI / 2.0), "arcsine(1) was ", arcsine(1.0)) && ok
    ok = #expect(close(arcsine(-0.5), -PI / 6.0), "arcsine(-1/2) was ", arcsine(-0.5)) && ok
    ok = #expect(is_nan(arcsine(2.0)), "arcsine(2) was a number: ", arcsine(2.0)) && ok
    ok = #expect(close(arccosine(-1.0), PI), "arccosine(-1) was ", arccosine(-1.0)) && ok
    ok = #expect(close(arccosine(0.5), PI / 3.0), "arccosine(1/2) was ", arccosine(0.5)) && ok
    ok = #expect(close(arctangent(1.0), PI / 4.0), "arctangent(1) was ", arctangent(1.0)) && ok
    ok = #expect(close(arctangent(inf), PI / 2.0), "arctangent(inf) was ", arctangent(inf)) && ok
    // The inverse undoes the function on its principal range.
    ok = #expect(close(sine(arcsine(0.3)), 0.3), "sine(arcsine(0.3)) was ", sine(arcsine(0.3))) && ok
    ok = #expect(close(tangent(arctangent(-2.0)), -2.0), "tangent(arctangent(-2)) was ", tangent(arctangent(-2.0))) && ok

    // ── hyperbolic ──────────────────────────────────────────────────────────
    ok = #expect(hyperbolic_sine(0.0) == 0.0, "sinh(0) was ", hyperbolic_sine(0.0)) && ok
    ok = #expect(hyperbolic_cosine(0.0) == 1.0, "cosh(0) was ", hyperbolic_cosine(0.0)) && ok
    ok = #expect(close(hyperbolic_sine(1.0), (E - 1.0 / E) / 2.0), "sinh(1) was ", hyperbolic_sine(1.0)) && ok
    ok = #expect(close(hyperbolic_cosine(1.0), (E + 1.0 / E) / 2.0), "cosh(1) was ", hyperbolic_cosine(1.0)) && ok
    ok = #expect(hyperbolic_tangent(30.0) == 1.0, "tanh(30) was ", hyperbolic_tangent(30.0)) && ok
    ok = #expect(hyperbolic_tangent(-30.0) == -1.0, "tanh(-30) was ", hyperbolic_tangent(-30.0)) && ok
    f64 c = hyperbolic_cosine(0.7)
    f64 s = hyperbolic_sine(0.7)
    ok = #expect(close(c * c - s * s, 1.0), "cosh^2 - sinh^2 was ", c * c - s * s) && ok
    ok = #expect(close(hyperbolic_tangent(0.7), s / c), "tanh(0.7) was ", hyperbolic_tangent(0.7)) && ok

    // ── roots, exponentials, logarithms ─────────────────────────────────────
    // Not `==`: a C library's cube root need not be exact at a perfect cube.
    ok = #expect(close(cube_root(27.0), 3.0), "cube_root(27) was ", cube_root(27.0)) && ok
    ok = #expect(close(cube_root(-8.0), -2.0), "cube_root(-8) was ", cube_root(-8.0)) && ok
    ok = #expect(two_to(10.0) == 1024.0, "two_to(10) was ", two_to(10.0)) && ok
    ok = #expect(two_to(-1.0) == 0.5, "two_to(-1) was ", two_to(-1.0)) && ok
    ok = #expect(close(two_to(0.5), SQRT2), "two_to(1/2) was ", two_to(0.5)) && ok
    // Near zero, where the plain forms lose everything: e^x - 1 and
    // ln(1 + x) are both x to first order.
    f64 tiny = 1.0e-20
    ok = #expect(e_to_minus_one(tiny) == tiny, "e_to_minus_one(1e-20) was ", e_to_minus_one(tiny)) && ok
    ok = #expect(ln_one_plus(tiny) == tiny, "ln_one_plus(1e-20) was ", ln_one_plus(tiny)) && ok
    ok = #expect(close(e_to_minus_one(1.0), E - 1.0), "e_to_minus_one(1) was ", e_to_minus_one(1.0)) && ok
    ok = #expect(close(ln_one_plus(E - 1.0), 1.0), "ln_one_plus(e - 1) was ", ln_one_plus(E - 1.0)) && ok
    ok = #expect(ln_one_plus(-1.0) == -inf, "ln_one_plus(-1) was ", ln_one_plus(-1.0)) && ok

    // ── constants ───────────────────────────────────────────────────────────
    ok = #expect(close(ln(E), 1.0), "ln(E) was ", ln(E)) && ok
    ok = #expect(close(SQRT2 * SQRT2, 2.0), "SQRT2^2 was ", SQRT2 * SQRT2) && ok
    ok = #expect(close(e_to(LN2), 2.0), "e^LN2 was ", e_to(LN2)) && ok
    ok = #expect(close(e_to(LN10), 10.0), "e^LN10 was ", e_to(LN10)) && ok
    ok = #expect(1.0 + EPSILON > 1.0 && 1.0 + EPSILON / 2.0 == 1.0, "EPSILON is not the gap above 1") && ok
    ok = #expect(is_infinite(MAX_FINITE * 2.0) && is_finite(MAX_FINITE), "MAX_FINITE is not the largest finite") && ok
    ok = #expect(MIN_NORMAL == times_power_of_two(1.0, -1022), "MIN_NORMAL was ", MIN_NORMAL) && ok
    ok = #expect(MIN_SUBNORMAL / 2.0 == 0.0 && MIN_SUBNORMAL > 0.0, "MIN_SUBNORMAL is not the smallest") && ok
    ok = #expect(is_infinite(inf) && inf > 0.0, "infinity() was ", inf) && ok
    ok = #expect(is_nan(nan_value), "nan() was ", nan_value) && ok

    // ── exact helpers ───────────────────────────────────────────────────────
    //
    // `nearest_even` against `nearest` at the halves, where they differ.
    ok = #expect(nearest_even(2.5) == 2.0 && nearest(2.5) == 3.0, "2.5 rounded wrong: ", nearest_even(2.5)) && ok
    ok = #expect(nearest_even(3.5) == 4.0, "nearest_even(3.5) was ", nearest_even(3.5)) && ok
    ok = #expect(nearest_even(-2.5) == -2.0, "nearest_even(-2.5) was ", nearest_even(-2.5)) && ok
    ok = #expect(nearest_even(2.4) == 2.0 && nearest_even(2.6) == 3.0, "nearest_even off a half moved wrong") && ok
    f64 neg_half = nearest_even(-0.5)
    ok = #expect(neg_half == 0.0 && bits_of(neg_half) == 0x8000000000000000, "nearest_even(-0.5) was not -0.0") && ok
    ok = #expect(up(-0.5) == 0.0 && bits_of(up(-0.5)) == 0x8000000000000000, "up(-0.5) was not -0.0") && ok
    ok = #expect(with_sign_of(3.0, -0.0) == -3.0, "with_sign_of(3, -0) was ", with_sign_of(3.0, -0.0)) && ok
    ok = #expect(with_sign_of(-3.0, 1.0) == 3.0, "with_sign_of(-3, 1) was ", with_sign_of(-3.0, 1.0)) && ok
    ok = #expect(is_finite(0.0) && is_finite(-MAX_FINITE) && !is_finite(inf) && !is_finite(nan_value), "is_finite answered wrong") && ok
    Exponent parts = split_exponent(8.0)
    ok = #expect(parts.fraction == 0.5 && parts.exponent == 4, "split_exponent(8) was ", parts.fraction, ", ", parts.exponent) && ok
    Exponent sub = split_exponent(MIN_SUBNORMAL)
    ok = #expect(sub.fraction == 0.5 && sub.exponent == -1073, "split_exponent of the least subnormal was ", sub.fraction, ", ", sub.exponent) && ok
    Exponent z = split_exponent(zero)
    ok = #expect(z.fraction == 0.0 && z.exponent == 0, "split_exponent(0) was ", z.fraction, ", ", z.exponent) && ok
    ok = #expect(times_power_of_two(0.75, 4) == 12.0, "times_power_of_two(0.75, 4) was ", times_power_of_two(0.75, 4)) && ok
    ok = #expect(times_power_of_two(1.0, -1074) == MIN_SUBNORMAL, "2^-1074 was ", times_power_of_two(1.0, -1074)) && ok
    ok = #expect(is_infinite(times_power_of_two(1.0, 1024)), "2^1024 did not overflow") && ok
    ok = #expect(remainder(5.5, inf) == 5.5, "remainder(5.5, inf) was ", remainder(5.5, inf)) && ok
    ok = #expect(is_nan(remainder(5.5, zero)), "remainder(5.5, 0) was a number") && ok

    // ── generic ─────────────────────────────────────────────────────────────
    i32 neg = -7
    u8 unsigned_value = 9
    ok = #expect(sign(neg) == -1 && sign(5) == 1 && sign(0) == 0, "sign over i32 answered wrong") && ok
    ok = #expect(sign(unsigned_value) == 1, "sign over u8 was ", sign(unsigned_value)) && ok
    f64 neg_f = -2.5
    f64 pos_f = 0.1
    ok = #expect(sign(neg_f) == -1.0 && sign(pos_f) == 1.0 && sign(nan_value) == 0.0, "sign over f64 answered wrong") && ok
    ok = #expect(lerp(2.0, 6.0, 0.25) == 3.0, "lerp(2, 6, 1/4) was ", lerp(2.0, 6.0, 0.25)) && ok
    ok = #expect(lerp(2.0, 6.0, 0.0) == 2.0 && lerp(2.0, 6.0, 1.0) == 6.0, "lerp missed an end") && ok
    f32 a32 = 1.0
    f32 b32 = 3.0
    f32 t32 = 0.5
    ok = #expect(lerp(a32, b32, t32) == f32(2.0), "lerp over f32 was ", lerp(a32, b32, t32)) && ok
    ok = #expect(smoothstep(0.0, 1.0, -1.0) == 0.0 && smoothstep(0.0, 1.0, 2.0) == 1.0, "smoothstep did not clamp") && ok
    ok = #expect(smoothstep(0.0, 1.0, 0.5) == 0.5, "smoothstep(0, 1, 1/2) was ", smoothstep(0.0, 1.0, 0.5)) && ok
    ok = #expect(smoothstep(0.0, 2.0, 0.5) == 0.15625, "smoothstep(0, 2, 1/2) was ", smoothstep(0.0, 2.0, 0.5)) && ok
    ok = #expect(gcd(12, 18) == 6 && gcd(18, 12) == 6, "gcd(12, 18) was ", gcd(12, 18)) && ok
    i32 minus_four = -4
    ok = #expect(gcd(minus_four, 6) == 2 && gcd(6, minus_four) == 2, "gcd(-4, 6) was ", gcd(minus_four, 6)) && ok
    ok = #expect(gcd(0, 0) == 0 && gcd(0, 5) == 5, "gcd with a zero answered wrong") && ok
    u64 big_a = 600851475143
    u64 big_b = 6857
    ok = #expect(gcd(big_a, big_b) == 6857, "gcd over u64 was ", gcd(big_a, big_b)) && ok
    ok = #expect(lcm(4, 6) == 12 && lcm(0, 6) == 0, "lcm(4, 6) was ", lcm(4, 6)) && ok
    ok = #expect(lcm(minus_four, 6) == 12, "lcm(-4, 6) was ", lcm(minus_four, 6)) && ok
    u8 u4 = 4
    u8 u10 = 10
    ok = #expect(lcm(u4, u10) == 20, "lcm over u8 was ", lcm(u4, u10)) && ok

    if ok:
        return 0
    return 1
