@test
// `soft.dado` against the C library, and `exact.dado` against it bit for bit.
//
// The Dado libm is what `#NONE` computes with and what `#WEB` takes the
// functions its runtime lacks from, and neither target can compare it with
// anything. So the comparison is made here, on the hosted build, where the
// public functions are the C library's: each `soft_` function is run over a
// few hundred thousand inputs drawn across its whole domain — tiny,
// subnormal, huge, near the reductions' edges, infinite and NaN — and its
// answer is held to within `ULP_BAR` units in the last place of C's.
//
// **Two units, not one**, because each side is allowed one: glibc's and
// this file's are each within one unit of the true value, and can sit on
// either side of it. `soft_sqrt` and `soft_fma` are held to zero, since both
// are correctly rounded by definition, as is every function of `exact.dado`.
// The worst error seen for each function is printed, so a change that makes
// one worse shows before it fails.
//
// Hosted, `fused_multiply_add` is `soft_fma` itself (`math.dado` says why),
// so the `fma` row compares `soft_fma` with the C library's own `fma` — when
// that is a C library's. Built by the pinned zig for a baseline CPU, the `fma`
// a program links is zig's routine, which is wrong (NaN, and a unit off, near
// the subnormals) and can judge nothing; `c_fma_trusted` asks it a question
// whose answer it gets wrong and skips the row when it does.
//
// On `#WEB` the public functions are the runtime's musl, and the functions
// transliterated from the same musl files must match it exactly; the others
// are held to the same two units.
package math

import "core:fmt"

// Within this many units in the last place of the C library's answer.
private const u64 ULP_BAR = 2

// The C library's exact functions, which `exact.dado` replaces, declared here
// only to be compared with. Hosted only: the web runtime carries none of
// them but the first three.
when #OS != #NONE && #OS != #WEB:
    private foreign "math.h":
        f64 floor(f64 x)
        f64 ceil(f64 x)
        f64 trunc(f64 x)
        f64 round(f64 x)
        f64 rint(f64 x)
        f64 fabs(f64 x)
        f64 copysign(f64 x, f64 y)
        f64 fmod(f64 x, f64 y)
        f64 ldexp(f64 x, i32 n)

// Whether C's `fma` is one that can judge `soft_fma`: the routine the pinned
// zig links for a baseline CPU answers NaN for this product, too small to be
// any `f64`, beside an ordinary `z`, where the answer is `z`.
// `math_test.dado` holds `fused_multiply_add` to the same point.
when #OS != #NONE:
    private bool c_fma_trusted():
        f64 x = 0.0 - times_power_of_two(1.6901811592983056, -538)
        f64 y = times_power_of_two(1.3087985103971629, -540)
        f64 z = 0.0 - times_power_of_two(1.6179335275422109, 1010)
        return fma(x, y, z) == z

// xorshift64*, so every run draws the same inputs.
private type Rng: (u64 state)

private u64 next(^Rng r):
    u64 x = r^.state
    x = x ~ (x >> 12)
    x = x ~ (x << 25)
    x = x ~ (x >> 27)
    r^.state = x
    return x * 0x2545F4914F6CDD1D

// A uniform `f64` in [lo, hi).
private f64 uniform(^Rng r, f64 lo, f64 hi):
    f64 unit = f64(next(r) >> 11) * 1.1102230246251565e-16
    return lo + (hi - lo) * unit

// Any `f64` at all, by its bits: every exponent equally likely, so tiny,
// subnormal, huge, infinite and NaN inputs all turn up.
private f64 any_bits(^Rng r):
    return of_bits(next(r))

// Any normal `f64` whose magnitude is between 2^lo and 2^hi, of either sign;
// `lo` is at least -1022, the least normal exponent.
private f64 any_scale(^Rng r, i32 lo, i32 hi):
    u64 bits = next(r)
    u64 span = u64(hi - lo)
    u64 e = u64(lo + 1023) + (bits >> 32) % (span + 1)
    return of_bits((bits & 0x800FFFFFFFFFFFFF) | (e << 52))

// The distance between two answers in units in the last place: 0 for the
// same bits or two NaNs, and the most a `u64` holds for a NaN against a
// number. Zeros of opposite sign are one apart, as the sign is part of the
// answer.
private u64 ulps(f64 a, f64 b):
    if a != a || b != b:
        if a != a && b != b:
            return 0
        return 0xFFFFFFFFFFFFFFFF
    u64 ua = bits_of(a)
    u64 ub = bits_of(b)
    if ua == ub:
        return 0
    bool na = (ua >> 63) != 0
    bool nb = (ub >> 63) != 0
    u64 ma = ua & 0x7FFFFFFFFFFFFFFF
    u64 mb = ub & 0x7FFFFFFFFFFFFFFF
    if na != nb:
        return ma + mb + 1
    if ma > mb:
        return ma - mb
    return mb - ma

// The worst disagreement found for one function.
private type Worst:
    string8 name
    u64 bar
    u64 ulps
    f64 x
    f64 y
    f64 got
    f64 want

private Worst worst(string8 name, u64 bar):
    return (name, bar, 0, 0.0, 0.0, 0.0, 0.0)

private void note(^Worst w, f64 x, f64 y, f64 got, f64 want):
    u64 d = ulps(got, want)
    if d > w^.ulps:
        w^.ulps = d
        w^.x = x
        w^.y = y
        w^.got = got
        w^.want = want

// Prints the worst case, and answers whether it is within the bar.
private bool report(Worst w):
    bool ok = w.ulps <= w.bar
    if !ok:
        fmt.println("FAIL ", w.name, ": ", w.ulps, " ulps at x=", w.x, " (bits ", bits_of(w.x), ") y=", w.y, " (bits ", bits_of(w.y), ") got ", w.got, " want ", w.want)
    else:
        fmt.println(w.name, ": worst ", w.ulps, " ulps")
    return ok

private const i32 N = 200000

// One-argument functions: `soft` against `c` over draws from `draw`.
private bool unary(string8 name, u64 bar, f64(f64) soft, f64(f64) c, ^Rng r, i32 kind):
    Worst w = worst(name, bar)
    for i in 0..<N:
        f64 x = 0.0
        if kind == 0:
            x = any_bits(r)
        else if kind == 1:
            x = uniform(r, -10.0, 10.0)
        else if kind == 2:
            x = uniform(r, -1.0, 1.0)
        else if kind == 3:
            x = uniform(r, -745.5, 710.0)
        else if kind == 4:
            x = abs(any_bits(r))
        else if kind == 5:
            x = uniform(r, -720.0, 720.0)
        else if kind == 6:
            x = any_scale(r, -60, 30)
        else if kind == 8:
            x = abs(any_scale(r, -1022, 1023))
        else:
            x = uniform(r, -1.0, 100.0)
        note(&w, x, 0.0, soft(x), c(x))
    return report(w)

i32 test():
    when #OS == #NONE:
        return 0
    else:
        bool ok = true
        Rng r = (0x9E3779B97F4A7C15)
        bool hosted = #OS != #WEB
        // The functions the `#WEB` runtime has from the same musl file.
        u64 same = 0 if !hosted else ULP_BAR

        // Correctly rounded, so exact.
        ok = unary("sqrt", 0, soft_sqrt, root, &r, 0) && ok
        ok = unary("sqrt (positive)", 0, soft_sqrt, root, &r, 4) && ok

        ok = unary("sin", same, soft_sin, sine, &r, 1) && ok
        ok = unary("sin (any)", same, soft_sin, sine, &r, 0) && ok
        ok = unary("cos", same, soft_cos, cosine, &r, 1) && ok
        ok = unary("cos (any)", same, soft_cos, cosine, &r, 0) && ok
        ok = unary("tan", same, soft_tan, tangent, &r, 1) && ok
        ok = unary("tan (any)", same, soft_tan, tangent, &r, 0) && ok
        ok = unary("acos", same, soft_acos, arccosine, &r, 2) && ok
        ok = unary("acos (any)", same, soft_acos, arccosine, &r, 0) && ok
        // Normal inputs only: the C library this is linked with (zig's
        // `compiler_rt`, which supplies `log2` and `log10` ahead of the C
        // library's) forgets the low word of a subnormal it has scaled. The
        // subnormal case is checked below against fixed answers instead.
        ok = unary("log10", same, soft_log10, log_10, &r, 8) && ok

        // Hosted, the C library's: arcsine, arctangent, the hyperbolic
        // functions, cube_root, two_to, ln_one_plus and e_to_minus_one are
        // the soft ones themselves on the web, so there is nothing to compare.
        when #OS != #WEB:
            ok = unary("asin", ULP_BAR, soft_asin, arcsine, &r, 2) && ok
            ok = unary("asin (any)", ULP_BAR, soft_asin, arcsine, &r, 0) && ok
            ok = unary("atan", ULP_BAR, soft_atan, arctangent, &r, 1) && ok
            ok = unary("atan (any)", ULP_BAR, soft_atan, arctangent, &r, 0) && ok
            ok = unary("sinh", ULP_BAR, soft_sinh, hyperbolic_sine, &r, 5) && ok
            ok = unary("sinh (small)", ULP_BAR, soft_sinh, hyperbolic_sine, &r, 6) && ok
            ok = unary("cosh", ULP_BAR, soft_cosh, hyperbolic_cosine, &r, 5) && ok
            ok = unary("tanh", ULP_BAR, soft_tanh, hyperbolic_tangent, &r, 1) && ok
            ok = unary("tanh (any)", ULP_BAR, soft_tanh, hyperbolic_tangent, &r, 0) && ok
            // glibc's `cbrt` is itself up to 3 units out on some
            // architectures (its own table of known errors says so), so the
            // bar is the two errors added.
            ok = unary("cbrt", 4, soft_cbrt, cube_root, &r, 0) && ok
            ok = unary("expm1", ULP_BAR, soft_expm1, e_to_minus_one, &r, 3) && ok
            ok = unary("expm1 (small)", ULP_BAR, soft_expm1, e_to_minus_one, &r, 6) && ok
            ok = unary("log1p", ULP_BAR, soft_log1p, ln_one_plus, &r, 7) && ok
            ok = unary("log1p (any)", ULP_BAR, soft_log1p, ln_one_plus, &r, 0) && ok

        // The table-driven musl functions on the web, msun's here.
        ok = unary("exp", ULP_BAR, soft_exp, e_to, &r, 3) && ok
        ok = unary("exp (any)", ULP_BAR, soft_exp, e_to, &r, 0) && ok
        ok = unary("log", ULP_BAR, soft_log, ln, &r, 4) && ok
        ok = unary("log (any)", ULP_BAR, soft_log, ln, &r, 0) && ok
        ok = unary("log2", ULP_BAR, soft_log2, log_2, &r, 8) && ok
        // log2 and log10 of the subnormal 6.74325e-309, correctly rounded.
        f64 sub = 6.74325e-309
        ok = #expect(bits_of(soft_log2(sub)) == 13875588009580987563, "soft_log2 of a subnormal was ", soft_log2(sub)) && ok
        ok = #expect(bits_of(soft_log10(sub)) == 13867501056911864220, "soft_log10 of a subnormal was ", soft_log10(sub)) && ok

        // Two- and three-argument functions.
        Worst w_atan2 = worst("atan2", same)
        Worst w_hypot = worst("hypot", same)
        Worst w_pow = worst("pow", ULP_BAR)
        Worst w_pow_int = worst("pow (negative base, whole exponent)", ULP_BAR)
        Worst w_fma = worst("fma", 0)
        for i in 0..<N:
            f64 a = any_bits(&r)
            f64 b = any_bits(&r)
            note(&w_atan2, a, b, soft_atan2(a, b), angle(a, b))
            note(&w_hypot, a, b, soft_hypot(a, b), length(a, b))
            f64 u = uniform(&r, -3.0, 3.0)
            f64 v = uniform(&r, -3.0, 3.0)
            note(&w_atan2, u, v, soft_atan2(u, v), angle(u, v))
            note(&w_hypot, u, v, soft_hypot(u, v), length(u, v))
            f64 base = uniform(&r, 0.0, 100.0)
            f64 exponent = uniform(&r, -150.0, 150.0)
            note(&w_pow, base, exponent, soft_pow(base, exponent), raised(base, exponent))
            note(&w_pow, a, b, soft_pow(a, b), raised(a, b))
            f64 near_one = uniform(&r, 0.999, 1.001)
            f64 big = uniform(&r, -1.0e6, 1.0e6)
            note(&w_pow, near_one, big, soft_pow(near_one, big), raised(near_one, big))
            f64 nb = uniform(&r, -20.0, 0.0)
            f64 whole = down(uniform(&r, -60.0, 60.0))
            note(&w_pow_int, nb, whole, soft_pow(nb, whole), raised(nb, whole))
            f64 c = any_bits(&r)
            note(&w_fma, a, b, soft_fma(a, b, c), fma(a, b, c))
            f64 p = uniform(&r, -2.0, 2.0)
            f64 q = uniform(&r, -2.0, 2.0)
            f64 s = -(p * q) + uniform(&r, -1.0e-15, 1.0e-15)
            note(&w_fma, p, q, soft_fma(p, q, s), fma(p, q, s))
            f64 tiny_a = any_scale(&r, -540, -500)
            f64 tiny_b = any_scale(&r, -540, -500)
            // Subnormal and smallest-normal `z`, 2^-1074 to 2^-1020: a normal
            // draw scaled down, since `any_scale` builds a normal exponent.
            f64 tiny_c = times_power_of_two(any_scale(&r, -1022, -968), -52)
            note(&w_fma, tiny_a, tiny_b, soft_fma(tiny_a, tiny_b, tiny_c), fma(tiny_a, tiny_b, tiny_c))
        ok = report(w_atan2) && ok
        ok = report(w_hypot) && ok
        ok = report(w_pow) && ok
        ok = report(w_pow_int) && ok
        // 2^x is `soft_pow(2, x)` off the hosted build, and C's `exp2` on it.
        when #OS != #WEB:
            Worst w_exp2 = worst("exp2", ULP_BAR)
            for i in 0..<N:
                f64 e2 = uniform(&r, -1080.0, 1030.0)
                note(&w_exp2, e2, 0.0, soft_pow(2.0, e2), two_to(e2))
            ok = report(w_exp2) && ok
        if c_fma_trusted():
            ok = report(w_fma) && ok
        else:
            fmt.println("fma: skipped, the C library's fma is the pinned zig's routine, which answers NaN for finite arguments")

        // `exact.dado` against the C library, bit for bit.
        when #OS != #WEB:
            Worst w_floor = worst("floor", 0)
            Worst w_ceil = worst("ceil", 0)
            Worst w_trunc = worst("trunc", 0)
            Worst w_round = worst("round", 0)
            Worst w_rint = worst("rint", 0)
            Worst w_fabs = worst("fabs", 0)
            Worst w_copysign = worst("copysign", 0)
            Worst w_fmod = worst("fmod", 0)
            Worst w_ldexp = worst("ldexp", 0)
            Worst w_frexp = worst("frexp round trip", 0)
            for i in 0..<N:
                f64 x = any_bits(&r)
                if (i & 1) == 0:
                    x = any_scale(&r, -3, 55)
                if (i & 7) == 1:
                    x = down(uniform(&r, -8.0, 8.0)) + 0.5
                note(&w_floor, x, 0.0, down(x), floor(x))
                note(&w_ceil, x, 0.0, up(x), ceil(x))
                note(&w_trunc, x, 0.0, toward_zero(x), trunc(x))
                note(&w_round, x, 0.0, nearest(x), round(x))
                note(&w_rint, x, 0.0, nearest_even(x), rint(x))
                note(&w_fabs, x, 0.0, abs(x), fabs(x))
                f64 y = any_bits(&r)
                note(&w_copysign, x, y, with_sign_of(x, y), copysign(x, y))
                note(&w_fmod, x, y, remainder(x, y), fmod(x, y))
                f64 y2 = any_scale(&r, -10, 10)
                note(&w_fmod, x, y2, remainder(x, y2), fmod(x, y2))
                i32 n = i32(next(&r) % 4400) - 2200
                note(&w_ldexp, x, f64(n), times_power_of_two(x, n), ldexp(x, n))
                Exponent parts = split_exponent(x)
                note(&w_frexp, x, 0.0, times_power_of_two(parts.fraction, parts.exponent), x)
                if is_finite(x) && x != 0.0:
                    f64 m = abs(parts.fraction)
                    ok = #expect(m >= 0.5 && m < 1.0, "split_exponent's fraction out of range at ", x) && ok
            ok = report(w_floor) && ok
            ok = report(w_ceil) && ok
            ok = report(w_trunc) && ok
            ok = report(w_round) && ok
            ok = report(w_rint) && ok
            ok = report(w_fabs) && ok
            ok = report(w_copysign) && ok
            ok = report(w_fmod) && ok
            ok = report(w_ldexp) && ok
            ok = report(w_frexp) && ok

        if ok:
            return 0
        return 1
