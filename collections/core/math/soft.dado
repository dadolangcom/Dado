// The functions `math.h` would answer, written in Dado, for the targets that
// have no `math.h` of their own to take them from.
//
// `math.dado` takes the transcendental functions from C wherever there is a C
// library: the platform's libm when hosted, and on `#WEB` the runtime's own
// (musl's, compiled into the module). This file is what is left when neither
// is there. Every function in it is `private` and named `soft_…`, and each
// public function in `math.dado` says which targets reach it:
//
// * **`#NONE`**, freestanding, which has no C library at all, takes every
//   transcendental from here.
// * **`#WEB`** takes the ones its runtime does not carry from here: the
//   inverse sine and tangent, the hyperbolic functions, the cube root, `2^x`,
//   `ln(1 + x)` and `e^x - 1`.
// * **Hosted** builds take none of them; the tests build them there and
//   compare every one with the C library's answer.
//
// **Where the algorithms come from.** Each function is a line-by-line
// transliteration of the C one named in its comment: musl 1.2.5's `src/math`
// where the `#WEB` runtime uses the same file (so a `#NONE` build and a
// `#WEB` build compute the same bits for `sin`, `cos`, `tan`, `acos`,
// `atan2`, `hypot`, `fma` and `log10`), and FreeBSD's msun, the common
// ancestor, for the rest. Only the spelling changed: C's word access to a
// double is the `F64Bits` union below, `goto` is a loop, and an out
// parameter is a returned tuple. The constants are the originals, digit for
// digit. None of them is correctly rounded except `soft_sqrt`; each is
// within one unit in the last place of the true answer, as its original is.
//
// **What raises into a script.** Every function here is pure Dado, so each
// carries `#assert_raises` on its own line, and the build is refused
// (ERR1227) if one ever reaches a `foreign` call, an address or an atomic.
// That is what makes `#NONE`'s answers Dado's own; the public functions in
// `math.dado` that call these on `#NONE` call C elsewhere, so they cannot carry
// the promise themselves.
//
// **Licences.** musl is MIT: "Copyright (c) 2005-2020 Rich Felker, et al.
// Permission is hereby granted, free of charge, to any person obtaining a
// copy of this software and associated documentation files (the
// "Software"), to deal in the Software without restriction, including
// without limitation the rights to use, copy, modify, merge, publish,
// distribute, sublicense, and/or sell copies of the Software, and to permit
// persons to whom the Software is furnished to do so, subject to the
// following conditions: The above copyright notice and this permission
// notice shall be included in all copies or substantial portions of the
// Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
// EXPRESS OR IMPLIED." The msun-derived functions, in musl and in FreeBSD
// alike, carry Sun Microsystems' notice: "Copyright (C) 1993 by Sun
// Microsystems, Inc. All rights reserved. Developed at SunPro, a Sun
// Microsystems, Inc. business. Permission to use, copy, modify, and
// distribute this software is freely granted, provided that this notice is
// preserved." `soft_cbrt` adds "Copyright (c) 2009-2011 Bruce D. Evans,
// Steven G. Kargl" under the same terms, and `soft_sqrt` is this file's own.
package math

// ── words of a double ─────────────────────────────────────────────────────
//
// fdlibm reads and writes a double as two 32-bit words, the high one holding
// the sign, the exponent and the top 20 bits of the fraction. These are its
// `GET_HIGH_WORD`, `INSERT_WORDS` and the rest, over one union.

// The 64 bits of an `f64`, readable as either.
private cunion F64Bits: (f64 f, u64 u)

// The bits of `x`.
#assert_raises
private u64 bits_of(f64 x):
    F64Bits b = F64Bits(x)
    return b.u

// The `f64` whose bits are `u`.
#assert_raises
private f64 of_bits(u64 u):
    F64Bits b = F64Bits(u)
    return b.f

// The high word: sign, exponent and the top 20 bits of the fraction.
#assert_raises
private u32 high_word(f64 x):
    return u32(bits_of(x) >> 32)

// The low word: the bottom 32 bits of the fraction.
#assert_raises
private u32 low_word(f64 x):
    return u32(bits_of(x) & 0xFFFFFFFF)

// The `f64` made of a high and a low word.
#assert_raises
private f64 from_words(u32 high, u32 low):
    return of_bits((u64(high) << 32) | u64(low))

// `x` with its low word cleared: the head of a split into a part with few
// enough bits that products of two heads are exact.
#assert_raises
private f64 low_cleared(f64 x):
    return of_bits(bits_of(x) & 0xFFFFFFFF00000000)

// `x` with its high word replaced.
#assert_raises
private f64 high_set(f64 x, u32 high):
    return from_words(high, low_word(x))

// A quiet NaN and the two infinities, which no `f64` literal can spell.
#assert_raises
private f64 soft_nan():
    return of_bits(0x7FF8000000000000)

#assert_raises
private f64 soft_inf():
    return of_bits(0x7FF0000000000000)

#assert_raises
private f64 soft_minus_inf():
    return of_bits(0xFFF0000000000000)

// Powers of two the reductions scale by. Each decimal is the shortest that
// reads back as the exact power.
private const f64 TWO_1023 = 8.98846567431158e+307
private const f64 TWO_M969 = 2.004168360008973e-292
private const f64 TWO_54 = 1.8014398509481984e+16
private const f64 TWO_24 = 16777216.0
private const f64 TWO_M24 = 5.960464477539063e-08
private const f64 TWO_63 = 9.223372036854776e+18
private const f64 TWO_700 = 5.260135901548374e+210
private const f64 TWO_M700 = 1.90109156629516e-211
private const f64 TWO_M1022 = 2.2250738585072014e-308

// ── scalbn ────────────────────────────────────────────────────────────────

// `x * 2^n`, rounded once, with no overflow or underflow on the way: musl's
// `scalbn`. Shared by `times_power_of_two` and the functions below.
#assert_raises
private f64 soft_scalbn(f64 x, i32 n):
    f64 y = x
    i32 k = n
    if k > 1023:
        y = y * TWO_1023
        k -= 1023
        if k > 1023:
            y = y * TWO_1023
            k -= 1023
            if k > 1023:
                k = 1023
    else if k < -1022:
        // Below -1022 the result may be subnormal; scaling down in steps
        // that stop above -53 keeps it to one rounding.
        y = y * TWO_M969
        k += 1022 - 53
        if k < -1022:
            y = y * TWO_M969
            k += 1022 - 53
            if k < -1022:
                k = -1022
    return y * of_bits(u64(0x3FF + k) << 52)

// ── square root ───────────────────────────────────────────────────────────

// The square root, **correctly rounded**: the same bits as IEEE 754's `sqrt`
// and every C library's, for every input.
//
// Written here rather than transliterated. The significand `m` (53 bits,
// with the hidden one) and an even exponent `e` give `x = m * 2^e`, and the
// root's significand is the integer square root of `m * 2^52`, taken two
// bits of the radicand at a time with a remainder that never needs more
// than 56 bits. One more bit of the root decides the rounding: the exact
// root is never halfway between two doubles, because `(2q + 1)^2` is odd
// and four times the radicand is not.
#assert_raises
private f64 soft_sqrt(f64 x):
    u64 u = bits_of(x)
    u64 magnitude_bits = u & 0x7FFFFFFFFFFFFFFF
    if magnitude_bits == 0:
        return x
    if (u >> 63) != 0:
        return soft_nan()
    if magnitude_bits >= 0x7FF0000000000000:
        return x
    i32 e = i32(u >> 52)
    u64 m = u & 0x000FFFFFFFFFFFFF
    if e == 0:
        // Subnormal: shift the leading one up to the hidden bit's place.
        e = 1
        for (m & 0x0010000000000000) == 0:
            m = m << 1
            e -= 1
    else:
        m = m | 0x0010000000000000
    // x = m * 2^(e - 1075); make the exponent even.
    i32 exp2 = e - 1075
    if (exp2 & 1) != 0:
        m = m << 1
        exp2 -= 1
    // Root of m * 2^52, a 106-bit radicand of which only the top 54 bits
    // (m) are not zero: 53 pairs, the low 26 of them zero.
    u64 q = 0
    u64 r = 0
    i32 pair = 52
    for pair >= 0:
        u64 next = 0
        if pair >= 26:
            next = (m >> u64(2 * pair - 52)) & 3
        r = (r << 2) | next
        u64 t = (q << 2) | 1
        q = q << 1
        if r >= t:
            r -= t
            q = q | 1
        pair -= 1
    // The next bit of the root: one, and the root is above q + 1/2.
    if (r << 2) >= ((q << 2) | 1):
        q += 1
    // q is in [2^52, 2^53]; the hidden bit carries into the exponent, and a
    // q of 2^53 carries one further, which is the right answer.
    i32 biased = exp2 / 2 + 26 + 1023
    return of_bits((u64(biased - 1) << 52) + q)

// ── argument reduction for the trigonometric functions ────────────────────

// `x` less a whole number `n` of quarter turns, as an unevaluated sum
// `y0 + y1` in [-pi/4, pi/4] carrying about 100 bits, and `n`.
private type Reduced: (i32 n, f64 y0, f64 y1)

// musl `__rem_pio2_large`'s tables: 2/pi, 24 bits at a time (enough for
// every exponent a double has), and pi/2 cut into 24-bit pieces.
private const [66]i32 TWO_OVER_PI = [
    0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62,
    0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7, 0x246E3A,
    0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,
    0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41,
    0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8,
    0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,
    0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5,
    0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08,
    0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,
    0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880,
    0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B,
]

private const [8]f64 PI_OVER_2_PIECES = [
    1.57079625129699707031e+00,
    7.54978941586159635335e-08,
    5.39030252995776476554e-15,
    3.28200341580791294123e-22,
    1.27065575308067607349e-29,
    1.22933308981111328932e-36,
    2.73370053816464559624e-44,
    2.16741683877804819444e-51,
]

// musl `__rem_pio2_large` at double precision (`prec` 1, so `jk` is 4): the
// reduction of an `x` too large for the three-step one, written as the
// 24-bit pieces `x[0..nx)` scaled by `2^e0`. Payne and Hanek's method: only
// the bits of 2/pi that land near the binary point of the product are
// multiplied out, and more are taken when the first ones cancel.
#assert_raises
private Reduced soft_rem_pio2_large([3]f64 x, i32 e0, i32 nx):
    [20]i32 iq
    [20]f64 f
    [20]f64 fq
    [20]f64 q
    i32 jk = 4
    i32 jp = jk
    i32 jx = nx - 1
    i32 jv = (e0 - 3) / 24
    if jv < 0:
        jv = 0
    i32 q0 = e0 - 24 * (jv + 1)

    // f[0..jx+jk] = TWO_OVER_PI[jv-jx .. jv+jk], zero below the table.
    i32 j = jv - jx
    i32 m = jx + jk
    i32 i = 0
    for i <= m:
        f[i] = 0.0 if j < 0 else f64(TWO_OVER_PI[j])
        i += 1
        j += 1

    // q[0..jk]
    i = 0
    for i <= jk:
        f64 fw = 0.0
        j = 0
        for j <= jx:
            fw += x[j] * f[jx + i - j]
            j += 1
        q[i] = fw
        i += 1

    i32 jz = jk
    i32 n = 0
    i32 ih = 0
    f64 z = 0.0
    for true:
        // Distill q[] into iq[], reversed.
        i = 0
        j = jz
        z = q[jz]
        for j > 0:
            f64 fw = f64(i32(TWO_M24 * z))
            iq[i] = i32(z - TWO_24 * fw)
            z = q[j - 1] + fw
            i += 1
            j -= 1

        // n, and z less every whole multiple of 8.
        z = soft_scalbn(z, q0)
        z -= 8.0 * down(z * 0.125)
        n = i32(z)
        z -= f64(n)
        ih = 0
        if q0 > 0:
            i = iq[jz - 1] >> (24 - q0)
            n += i
            iq[jz - 1] -= i << (24 - q0)
            ih = iq[jz - 1] >> (23 - q0)
        else if q0 == 0:
            ih = iq[jz - 1] >> 23
        else if z >= 0.5:
            ih = 2

        if ih > 0:
            // q is at least 1/2: take 1 - q, and n + 1.
            n += 1
            i32 carry = 0
            i = 0
            for i < jz:
                j = iq[i]
                if carry == 0:
                    if j != 0:
                        carry = 1
                        iq[i] = 0x1000000 - j
                else:
                    iq[i] = 0xFFFFFF - j
                i += 1
            if q0 == 1:
                iq[jz - 1] = iq[jz - 1] & 0x7FFFFF
            else if q0 == 2:
                iq[jz - 1] = iq[jz - 1] & 0x3FFFFF
            if ih == 2:
                z = 1.0 - z
                if carry != 0:
                    z -= soft_scalbn(1.0, q0)

        // Recompute with more terms when everything cancelled.
        if z == 0.0:
            j = 0
            i = jz - 1
            for i >= jk:
                j = j | iq[i]
                i -= 1
            if j == 0:
                i32 k = 1
                for iq[jk - k] == 0:
                    k += 1
                i = jz + 1
                for i <= jz + k:
                    f[jx + i] = f64(TWO_OVER_PI[jv + i])
                    f64 fw = 0.0
                    j = 0
                    for j <= jx:
                        fw += x[j] * f[jx + i - j]
                        j += 1
                    q[i] = fw
                    i += 1
                jz += k
                continue
        break

    // Chop off the zero terms, or break z into 24-bit pieces.
    if z == 0.0:
        jz -= 1
        q0 -= 24
        for iq[jz] == 0:
            jz -= 1
            q0 -= 24
    else:
        z = soft_scalbn(z, -q0)
        if z >= TWO_24:
            f64 fw = f64(i32(TWO_M24 * z))
            iq[jz] = i32(z - TWO_24 * fw)
            jz += 1
            q0 += 24
            iq[jz] = i32(fw)
        else:
            iq[jz] = i32(z)

    // The integer pieces back to floating point.
    f64 fw = soft_scalbn(1.0, q0)
    i = jz
    for i >= 0:
        q[i] = fw * f64(iq[i])
        fw = fw * TWO_M24
        i -= 1

    // PI_OVER_2_PIECES[0..jp] * q[jz..0]
    i = jz
    for i >= 0:
        fw = 0.0
        i32 k = 0
        for k <= jp && k <= jz - i:
            fw += PI_OVER_2_PIECES[k] * q[i + k]
            k += 1
        fq[jz - i] = fw
        i -= 1

    // Compress fq[] into the two-term answer.
    fw = 0.0
    i = jz
    for i >= 0:
        fw += fq[i]
        i -= 1
    f64 y0 = fw if ih == 0 else -fw
    fw = fq[0] - fw
    i = 1
    for i <= jz:
        fw += fq[i]
        i += 1
    f64 y1 = fw if ih == 0 else -fw
    return (n & 7, y0, y1)

private const f64 RP_TOINT = 6755399441055744.0
private const f64 RP_PIO4 = 7.85398163397448278999e-01
private const f64 RP_INVPIO2 = 6.36619772367581382433e-01
private const f64 RP_PIO2_1 = 1.57079632673412561417e+00
private const f64 RP_PIO2_1T = 6.07710050650619224932e-11
private const f64 RP_PIO2_2 = 6.07710050630396597660e-11
private const f64 RP_PIO2_2T = 2.02226624879595063154e-21
private const f64 RP_PIO2_3 = 2.02226624871116645580e-21
private const f64 RP_PIO2_3T = 8.47842766036889956997e-32

// The reduction of an `x` within a few quarter turns of zero: `m` quarter
// turns taken off in one step, good to 85 bits.
#assert_raises
private Reduced soft_rem_pio2_few(f64 x, bool negative, i32 m):
    f64 c = f64(m)
    if !negative:
        f64 z = x - c * RP_PIO2_1
        f64 y0 = z - c * RP_PIO2_1T
        f64 y1 = (z - y0) - c * RP_PIO2_1T
        return (m, y0, y1)
    f64 z = x + c * RP_PIO2_1
    f64 y0 = z + c * RP_PIO2_1T
    f64 y1 = (z - y0) + c * RP_PIO2_1T
    return (-m, y0, y1)

// musl `__rem_pio2`: `x` less the nearest whole number of quarter turns.
#assert_raises
private Reduced soft_rem_pio2(f64 x):
    u64 ux = bits_of(x)
    bool negative = (ux >> 63) != 0
    u32 ix = u32(ux >> 32) & 0x7FFFFFFF
    if ix <= 0x400F6A7A:
        // |x| ~<= 5pi/4. Near pi/2 or pi the one-step reduction cancels,
        // and the medium one below is taken instead.
        if (ix & 0xFFFFF) != 0x921FB:
            if ix <= 0x4002D97C:
                return soft_rem_pio2_few(x, negative, 1)
            return soft_rem_pio2_few(x, negative, 2)
    else if ix <= 0x401C463B:
        // |x| ~<= 9pi/4, the same with three and four quarter turns.
        if ix <= 0x4015FDBC:
            if ix != 0x4012D97C:
                return soft_rem_pio2_few(x, negative, 3)
        else if ix != 0x401921FB:
            return soft_rem_pio2_few(x, negative, 4)
    if ix < 0x413921FB:
        // |x| ~< 2^20 * pi/2: up to three steps, as many as cancellation
        // asks for.
        f64 fn = x * RP_INVPIO2 + RP_TOINT - RP_TOINT
        i32 n = i32(fn)
        f64 r = x - fn * RP_PIO2_1
        f64 w = fn * RP_PIO2_1T
        if r - w < -RP_PIO4:
            n -= 1
            fn = fn - 1.0
            r = x - fn * RP_PIO2_1
            w = fn * RP_PIO2_1T
        else if r - w > RP_PIO4:
            n += 1
            fn = fn + 1.0
            r = x - fn * RP_PIO2_1
            w = fn * RP_PIO2_1T
        f64 y0 = r - w
        i32 ey = i32((bits_of(y0) >> 52) & 0x7FF)
        i32 ex = i32(ix >> 20)
        if ex - ey > 16:
            f64 t = r
            w = fn * RP_PIO2_2
            r = t - w
            w = fn * RP_PIO2_2T - ((t - r) - w)
            y0 = r - w
            ey = i32((bits_of(y0) >> 52) & 0x7FF)
            if ex - ey > 49:
                t = r
                w = fn * RP_PIO2_3
                r = t - w
                w = fn * RP_PIO2_3T - ((t - r) - w)
                y0 = r - w
        f64 y1 = (r - y0) - w
        return (n, y0, y1)
    if ix >= 0x7FF00000:
        // Infinity or NaN: no reduction, and a NaN answer.
        f64 nan = x - x
        return (0, nan, nan)
    // Large: |x| scaled to [2^23, 2^24), cut into three 24-bit pieces.
    f64 z = of_bits((ux & 0x000FFFFFFFFFFFFF) | (u64(0x3FF + 23) << 52))
    [3]f64 tx
    tx[0] = f64(i32(z))
    z = (z - tx[0]) * TWO_24
    tx[1] = f64(i32(z))
    z = (z - tx[1]) * TWO_24
    tx[2] = z
    i32 last = 2
    for tx[last] == 0.0:
        last -= 1
    Reduced big = soft_rem_pio2_large(tx, i32(ix >> 20) - (0x3FF + 23), last + 1)
    if negative:
        return (-big.n, -big.y0, -big.y1)
    return big

// ── sine, cosine, tangent ─────────────────────────────────────────────────

private const f64 KS_S1 = -1.66666666666666324348e-01
private const f64 KS_S2 = 8.33333333332248946124e-03
private const f64 KS_S3 = -1.98412698298579493134e-04
private const f64 KS_S4 = 2.75573137070700676789e-06
private const f64 KS_S5 = -2.50507602534068634195e-08
private const f64 KS_S6 = 1.58969099521155010221e-10

// musl `__sin`: the sine of `x + y` on [-pi/4, pi/4], `y` the tail of a
// reduction (`has_tail` false when there is none).
#assert_raises
private f64 soft_k_sin(f64 x, f64 y, bool has_tail):
    f64 z = x * x
    f64 w = z * z
    f64 r = KS_S2 + z * (KS_S3 + z * KS_S4) + z * w * (KS_S5 + z * KS_S6)
    f64 v = z * x
    if !has_tail:
        return x + v * (KS_S1 + z * r)
    return x - ((z * (0.5 * y - v * r) - y) - v * KS_S1)

private const f64 KC_C1 = 4.16666666666666019037e-02
private const f64 KC_C2 = -1.38888888888741095749e-03
private const f64 KC_C3 = 2.48015872894767294178e-05
private const f64 KC_C4 = -2.75573143513906633035e-07
private const f64 KC_C5 = 2.08757232129817482790e-09
private const f64 KC_C6 = -1.13596475577881948265e-11

// musl `__cos`: the cosine of `x + y` on [-pi/4, pi/4].
#assert_raises
private f64 soft_k_cos(f64 x, f64 y):
    f64 z = x * x
    f64 w = z * z
    f64 r = z * (KC_C1 + z * (KC_C2 + z * KC_C3)) + w * w * (KC_C4 + z * (KC_C5 + z * KC_C6))
    f64 hz = 0.5 * z
    w = 1.0 - hz
    return w + (((1.0 - w) - hz) + (z * r - x * y))

private const [13]f64 KT_T = [
    3.33333333333334091986e-01,
    1.33333333333201242699e-01,
    5.39682539762260521377e-02,
    2.18694882948595424599e-02,
    8.86323982359930005737e-03,
    3.59207910759131235356e-03,
    1.45620945432529025516e-03,
    5.88041240820264096874e-04,
    2.46463134818469906812e-04,
    7.81794442939557092300e-05,
    7.14072491382608190305e-05,
    -1.85586374855275456654e-05,
    2.59073051863633712884e-05,
]
private const f64 KT_PIO4 = 7.85398163397448278999e-01
private const f64 KT_PIO4LO = 3.06161699786838301793e-17

// musl `__tan`: the tangent of `x + y` on [-pi/4, pi/4], or minus its
// reciprocal when `odd` (an odd number of quarter turns was taken off).
#assert_raises
private f64 soft_k_tan(f64 x_in, f64 y_in, bool odd):
    f64 x = x_in
    f64 y = y_in
    u32 hx = high_word(x)
    bool big = (hx & 0x7FFFFFFF) >= 0x3FE59428
    bool negative = (hx >> 31) != 0
    if big:
        if negative:
            x = -x
            y = -y
        x = (KT_PIO4 - x) + (KT_PIO4LO - y)
        y = 0.0
    f64 z = x * x
    f64 w = z * z
    f64 r = KT_T[1] + w * (KT_T[3] + w * (KT_T[5] + w * (KT_T[7] + w * (KT_T[9] + w * KT_T[11]))))
    f64 v = z * (KT_T[2] + w * (KT_T[4] + w * (KT_T[6] + w * (KT_T[8] + w * (KT_T[10] + w * KT_T[12])))))
    f64 s = z * x
    r = y + z * (s * (r + v) + y) + s * KT_T[0]
    w = x + r
    if big:
        s = -1.0 if odd else 1.0
        v = s - 2.0 * (x + (r - w * w / (w + s)))
        return -v if negative else v
    if !odd:
        return w
    // -1/(x + r), accurately: 1/w has up to two units of error.
    f64 w0 = low_cleared(w)
    v = r - (w0 - x)
    f64 a = -1.0 / w
    f64 a0 = low_cleared(a)
    return a0 + a * (1.0 + a0 * w0 + a0 * v)

// musl `sin`.
#assert_raises
private f64 soft_sin(f64 x):
    u32 ix = high_word(x) & 0x7FFFFFFF
    if ix <= 0x3FE921FB:
        // |x| ~< pi/4
        if ix < 0x3E500000:
            return x
        return soft_k_sin(x, 0.0, false)
    if ix >= 0x7FF00000:
        return x - x
    Reduced r = soft_rem_pio2(x)
    u32 quadrant = u32(r.n) & 3
    if quadrant == 0:
        return soft_k_sin(r.y0, r.y1, true)
    if quadrant == 1:
        return soft_k_cos(r.y0, r.y1)
    if quadrant == 2:
        return -soft_k_sin(r.y0, r.y1, true)
    return -soft_k_cos(r.y0, r.y1)

// musl `cos`.
#assert_raises
private f64 soft_cos(f64 x):
    u32 ix = high_word(x) & 0x7FFFFFFF
    if ix <= 0x3FE921FB:
        if ix < 0x3E46A09E:
            return 1.0
        return soft_k_cos(x, 0.0)
    if ix >= 0x7FF00000:
        return x - x
    Reduced r = soft_rem_pio2(x)
    u32 quadrant = u32(r.n) & 3
    if quadrant == 0:
        return soft_k_cos(r.y0, r.y1)
    if quadrant == 1:
        return -soft_k_sin(r.y0, r.y1, true)
    if quadrant == 2:
        return -soft_k_cos(r.y0, r.y1)
    return soft_k_sin(r.y0, r.y1, true)

// musl `tan`.
#assert_raises
private f64 soft_tan(f64 x):
    u32 ix = high_word(x) & 0x7FFFFFFF
    if ix <= 0x3FE921FB:
        if ix < 0x3E400000:
            return x
        return soft_k_tan(x, 0.0, false)
    if ix >= 0x7FF00000:
        return x - x
    Reduced r = soft_rem_pio2(x)
    return soft_k_tan(r.y0, r.y1, (u32(r.n) & 1) != 0)

// ── inverse trigonometric functions ───────────────────────────────────────

private const f64 AC_PIO2_HI = 1.57079632679489655800e+00
private const f64 AC_PIO2_LO = 6.12323399573676603587e-17
private const f64 AC_PIO4_HI = 7.85398163397448278999e-01
private const f64 AC_PS0 = 1.66666666666666657415e-01
private const f64 AC_PS1 = -3.25565818622400915405e-01
private const f64 AC_PS2 = 2.01212532134862925881e-01
private const f64 AC_PS3 = -4.00555345006794114027e-02
private const f64 AC_PS4 = 7.91534994289814532176e-04
private const f64 AC_PS5 = 3.47933107596021167570e-05
private const f64 AC_QS1 = -2.40339491173441421878e+00
private const f64 AC_QS2 = 2.02094576023350569471e+00
private const f64 AC_QS3 = -6.88283971605453293030e-01
private const f64 AC_QS4 = 7.70381505559019352791e-02

// The rational approximation `asin` and `acos` share: (asin(x) - x) / x^3
// at x^2 = z.
#assert_raises
private f64 soft_asin_r(f64 z):
    f64 p = z * (AC_PS0 + z * (AC_PS1 + z * (AC_PS2 + z * (AC_PS3 + z * (AC_PS4 + z * AC_PS5)))))
    f64 q = 1.0 + z * (AC_QS1 + z * (AC_QS2 + z * (AC_QS3 + z * AC_QS4)))
    return p / q

// musl `acos`.
#assert_raises
private f64 soft_acos(f64 x):
    u32 hx = high_word(x)
    u32 ix = hx & 0x7FFFFFFF
    if ix >= 0x3FF00000:
        // |x| >= 1, or NaN
        if ((ix - 0x3FF00000) | low_word(x)) == 0:
            if (hx >> 31) != 0:
                return 2.0 * AC_PIO2_HI
            return 0.0
        return soft_nan()
    if ix < 0x3FE00000:
        // |x| < 0.5
        if ix <= 0x3C600000:
            return AC_PIO2_HI
        return AC_PIO2_HI - (x - (AC_PIO2_LO - x * soft_asin_r(x * x)))
    if (hx >> 31) != 0:
        // x < -0.5
        f64 z = (1.0 + x) * 0.5
        f64 s = soft_sqrt(z)
        f64 w = soft_asin_r(z) * s - AC_PIO2_LO
        return 2.0 * (AC_PIO2_HI - (s + w))
    // x > 0.5
    f64 z = (1.0 - x) * 0.5
    f64 s = soft_sqrt(z)
    f64 df = low_cleared(s)
    f64 c = (z - df * df) / (s + df)
    f64 w = soft_asin_r(z) * s + c
    return 2.0 * (df + w)

// FreeBSD msun `asin` (musl's is the same algorithm).
#assert_raises
private f64 soft_asin(f64 x):
    u32 hx = high_word(x)
    u32 ix = hx & 0x7FFFFFFF
    if ix >= 0x3FF00000:
        if ((ix - 0x3FF00000) | low_word(x)) == 0:
            // asin(+-1) = +-pi/2
            return x * AC_PIO2_HI + x * AC_PIO2_LO
        return soft_nan()
    if ix < 0x3FE00000:
        // |x| < 0.5
        if ix < 0x3E500000:
            return x
        f64 t = x * x
        return x + x * soft_asin_r(t)
    f64 w = 1.0 - abs(x)
    f64 t = w * 0.5
    f64 s = soft_sqrt(t)
    if ix >= 0x3FEF3333:
        // |x| > 0.975
        t = AC_PIO2_HI - (2.0 * (s + s * soft_asin_r(t)) - AC_PIO2_LO)
    else:
        w = low_cleared(s)
        f64 c = (t - w * w) / (s + w)
        f64 r = soft_asin_r(t)
        f64 p = 2.0 * s * r - (AC_PIO2_LO - 2.0 * c)
        f64 q = AC_PIO4_HI - 2.0 * w
        t = AC_PIO4_HI - (p - q)
    if (hx >> 31) != 0:
        return -t
    return t

private const [4]f64 AT_HI = [
    4.63647609000806093515e-01,
    7.85398163397448278999e-01,
    9.82793723247329054082e-01,
    1.57079632679489655800e+00,
]
private const [4]f64 AT_LO = [
    2.26987774529616870924e-17,
    3.06161699786838301793e-17,
    1.39033110312309984516e-17,
    6.12323399573676603587e-17,
]
private const [11]f64 AT_T = [
    3.33333333333329318027e-01,
    -1.99999999998764832476e-01,
    1.42857142725034663711e-01,
    -1.11111104054623557880e-01,
    9.09088713343650656196e-02,
    -7.69187620504482999495e-02,
    6.66107313738753120669e-02,
    -5.83357013379057348645e-02,
    4.97687799461593236017e-02,
    -3.65315727442169155270e-02,
    1.62858201153657823623e-02,
]

// musl `atan`.
#assert_raises
private f64 soft_atan(f64 x_in):
    f64 x = x_in
    u32 hx = high_word(x)
    bool negative = (hx >> 31) != 0
    u32 ix = hx & 0x7FFFFFFF
    i32 id = -1
    if ix >= 0x44100000:
        // |x| >= 2^66
        if x != x:
            return x
        f64 z = AT_HI[3]
        return -z if negative else z
    if ix < 0x3FDC0000:
        // |x| < 0.4375
        if ix < 0x3E400000:
            return x
    else:
        x = abs(x)
        if ix < 0x3FF30000:
            if ix < 0x3FE60000:
                id = 0
                x = (2.0 * x - 1.0) / (2.0 + x)
            else:
                id = 1
                x = (x - 1.0) / (x + 1.0)
        else:
            if ix < 0x40038000:
                id = 2
                x = (x - 1.5) / (1.0 + 1.5 * x)
            else:
                id = 3
                x = -1.0 / x
    f64 z = x * x
    f64 w = z * z
    f64 s1 = z * (AT_T[0] + w * (AT_T[2] + w * (AT_T[4] + w * (AT_T[6] + w * (AT_T[8] + w * AT_T[10])))))
    f64 s2 = w * (AT_T[1] + w * (AT_T[3] + w * (AT_T[5] + w * (AT_T[7] + w * AT_T[9]))))
    if id < 0:
        return x - x * (s1 + s2)
    z = AT_HI[id] - (x * (s1 + s2) - AT_LO[id] - x)
    return -z if negative else z

private const f64 AT2_PI = 3.1415926535897931160e+00
private const f64 AT2_PI_LO = 1.2246467991473531772e-16

// musl `atan2`.
#assert_raises
private f64 soft_atan2(f64 y, f64 x):
    if x != x || y != y:
        return x + y
    u32 ix = high_word(x)
    u32 lx = low_word(x)
    u32 iy = high_word(y)
    u32 ly = low_word(y)
    if ((ix - 0x3FF00000) | lx) == 0:
        // x = 1
        return soft_atan(y)
    // 2 * sign(x) + sign(y)
    u32 m = ((iy >> 31) & 1) | ((ix >> 30) & 2)
    ix = ix & 0x7FFFFFFF
    iy = iy & 0x7FFFFFFF
    if (iy | ly) == 0:
        // y = 0
        if m < 2:
            return y
        if m == 2:
            return AT2_PI
        return -AT2_PI
    if (ix | lx) == 0:
        // x = 0
        return -AT2_PI / 2.0 if (m & 1) != 0 else AT2_PI / 2.0
    if ix == 0x7FF00000:
        // x infinite
        if iy == 0x7FF00000:
            if m == 0:
                return AT2_PI / 4.0
            if m == 1:
                return -AT2_PI / 4.0
            if m == 2:
                return 3.0 * AT2_PI / 4.0
            return -3.0 * AT2_PI / 4.0
        if m == 0:
            return 0.0
        if m == 1:
            return -0.0
        if m == 2:
            return AT2_PI
        return -AT2_PI
    // |y/x| > 2^64
    if ix + (64 << 20) < iy || iy == 0x7FF00000:
        return -AT2_PI / 2.0 if (m & 1) != 0 else AT2_PI / 2.0
    f64 z = 0.0
    if (m & 2) == 0 || iy + (64 << 20) >= ix:
        z = soft_atan(abs(y / x))
    if m == 0:
        return z
    if m == 1:
        return -z
    if m == 2:
        return AT2_PI - (z - AT2_PI_LO)
    return (z - AT2_PI_LO) - AT2_PI

// ── exponentials and logarithms ───────────────────────────────────────────

private const f64 EX_LN2HI = 6.93147180369123816490e-01
private const f64 EX_LN2LO = 1.90821492927058770002e-10
private const f64 EX_INVLN2 = 1.44269504088896338700e+00
private const f64 EX_P1 = 1.66666666666666019037e-01
private const f64 EX_P2 = -2.77777777770155933842e-03
private const f64 EX_P3 = 6.61375632143793436117e-05
private const f64 EX_P4 = -1.65339022054652515390e-06
private const f64 EX_P5 = 4.13813679705723846039e-08

// e^x: musl 1.1's `exp` (msun's algorithm; the `#WEB` runtime's is the
// table-driven one musl has used since). x is reduced to r = x - k ln2 in
// [-ln2/2, ln2/2], e^r comes from a rational approximation, and 2^k is
// applied last.
#assert_raises
private f64 soft_exp(f64 x_in):
    f64 x = x_in
    u32 hx = high_word(x)
    i32 sign = i32(hx >> 31)
    hx = hx & 0x7FFFFFFF
    if x != x:
        return x
    if hx >= 0x4086232B:
        // |x| >= 708.39
        if x > 709.782712893383973096:
            return x * TWO_1023
        if x < -745.13321910194110842:
            return 0.0
    i32 k = 0
    f64 hi = 0.0
    f64 lo = 0.0
    if hx > 0x3FD62E42:
        // |x| > ln2 / 2
        if hx >= 0x3FF0A2B2:
            k = i32(EX_INVLN2 * x + (0.5 if sign == 0 else -0.5))
        else:
            k = 1 - sign - sign
        f64 dk = f64(k)
        hi = x - dk * EX_LN2HI
        lo = dk * EX_LN2LO
        x = hi - lo
    else if hx > 0x3E300000:
        // |x| > 2^-28
        hi = x
    else:
        return 1.0 + x
    f64 xx = x * x
    f64 c = x - xx * (EX_P1 + xx * (EX_P2 + xx * (EX_P3 + xx * (EX_P4 + xx * EX_P5))))
    f64 y = 1.0 + (x * c / (2.0 - c) - lo + hi)
    if k == 0:
        return y
    return soft_scalbn(y, k)

private const f64 LG_LN2_HI = 6.93147180369123816490e-01
private const f64 LG_LN2_LO = 1.90821492927058770002e-10
private const f64 LG_IVLN2HI = 1.44269504072144627571e+00
private const f64 LG_IVLN2LO = 1.67517131648865118353e-10
private const f64 LG_IVLN10HI = 4.34294481878168880939e-01
private const f64 LG_IVLN10LO = 2.50829467116452752298e-11
private const f64 LG_LOG10_2HI = 3.01029995663611771306e-01
private const f64 LG_LOG10_2LO = 3.69423907715893078616e-13
private const f64 LG1 = 6.666666666666735130e-01
private const f64 LG2 = 3.999999999940941908e-01
private const f64 LG3 = 2.857142874366239149e-01
private const f64 LG4 = 2.222219843214978396e-01
private const f64 LG5 = 1.818357216161805012e-01
private const f64 LG6 = 1.531383769920937332e-01
private const f64 LG7 = 1.479819860511658591e-01

// What the three logarithms share: x = 2^k (1 + f) with 1 + f in
// [sqrt(2)/2, sqrt(2)], and ln(1 + f) = f - hfsq + s (hfsq + r).
private type LogParts: (f64 k, f64 f, f64 hfsq, f64 s, f64 r)

// The answer of a logarithm that needs no reduction, or `special` false.
private type LogEdge: (bool special, f64 answer)

// Zero, a negative, a NaN, an infinity and one: the inputs every
// logarithm answers without the polynomial.
#assert_raises
private LogEdge soft_log_edge(f64 x):
    u64 u = bits_of(x)
    u32 hx = u32(u >> 32)
    if (u << 1) == 0:
        return (true, soft_minus_inf())
    if (hx >> 31) != 0:
        return (true, soft_nan())
    if hx >= 0x7FF00000:
        return (true, x)
    if hx == 0x3FF00000 && (u << 32) == 0:
        return (true, 0.0)
    return (false, 0.0)

// The reduction, for a positive, finite `x` other than one.
#assert_raises
private LogParts soft_log_parts(f64 x_in):
    f64 x = x_in
    u64 u = bits_of(x)
    u32 hx = u32(u >> 32)
    i32 k = 0
    if hx < 0x00100000:
        // Subnormal: scale up.
        k -= 54
        x = x * TWO_54
        u = bits_of(x)
        hx = u32(u >> 32)
    hx += 0x3FF00000 - 0x3FE6A09E
    k += i32(hx >> 20) - 0x3FF
    hx = (hx & 0x000FFFFF) + 0x3FE6A09E
    x = of_bits((u64(hx) << 32) | (u & 0xFFFFFFFF))
    f64 f = x - 1.0
    f64 hfsq = 0.5 * f * f
    f64 s = f / (2.0 + f)
    f64 z = s * s
    f64 w = z * z
    f64 t1 = w * (LG2 + w * (LG4 + w * LG6))
    f64 t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)))
    return (f64(k), f, hfsq, s, t2 + t1)

// The natural logarithm: musl 1.1's `log` (msun's).
#assert_raises
private f64 soft_log(f64 x):
    LogEdge edge = soft_log_edge(x)
    if edge.special:
        return edge.answer
    LogParts p = soft_log_parts(x)
    return p.s * (p.hfsq + p.r) + p.k * LG_LN2_LO - p.hfsq + p.f + p.k * LG_LN2_HI

// The base-2 logarithm: musl 1.1's `log2`, which carries ln(1 + f) as a
// head and a tail so the scaling by 1/ln2 loses nothing.
#assert_raises
private f64 soft_log2(f64 x):
    LogEdge edge = soft_log_edge(x)
    if edge.special:
        return edge.answer
    LogParts p = soft_log_parts(x)
    f64 hi = low_cleared(p.f - p.hfsq)
    f64 lo = p.f - hi - p.hfsq + p.s * (p.hfsq + p.r)
    f64 val_hi = hi * LG_IVLN2HI
    f64 val_lo = (lo + hi) * LG_IVLN2LO + lo * LG_IVLN2HI
    f64 w = p.k + val_hi
    val_lo += (p.k - w) + val_hi
    return val_lo + w

// The base-10 logarithm: musl's `log10`, the `#WEB` runtime's too.
#assert_raises
private f64 soft_log10(f64 x):
    LogEdge edge = soft_log_edge(x)
    if edge.special:
        return edge.answer
    LogParts p = soft_log_parts(x)
    f64 hi = low_cleared(p.f - p.hfsq)
    f64 lo = p.f - hi - p.hfsq + p.s * (p.hfsq + p.r)
    f64 val_hi = hi * LG_IVLN10HI
    f64 y = p.k * LG_LOG10_2HI
    f64 val_lo = p.k * LG_LOG10_2LO + (lo + hi) * LG_IVLN10LO + lo * LG_IVLN10HI
    f64 w = y + val_hi
    val_lo += (y - w) + val_hi
    return val_lo + w

// ln(1 + x), accurate where 1 + x would round x away: musl's `log1p`.
#assert_raises
private f64 soft_log1p(f64 x):
    u64 ix = bits_of(x)
    u32 hx = u32(ix >> 32)
    i32 k = 1
    f64 c = 0.0
    f64 f = 0.0
    if hx < 0x3FDA827A || (hx >> 31) != 0:
        // 1 + x < sqrt(2)
        if hx >= 0xBFF00000:
            // x <= -1
            if x == -1.0:
                return soft_minus_inf()
            return soft_nan()
        if (hx << 1) < (u32(0x3CA00000) << 1):
            // |x| < 2^-53
            return x
        if hx <= 0xBFD2BEC4:
            // sqrt(2)/2 <= 1 + x < sqrt(2)
            k = 0
            f = x
    else if hx >= 0x7FF00000:
        return x
    if k != 0:
        f64 uf = 1.0 + x
        u64 hu = bits_of(uf)
        u32 iu = u32(hu >> 32)
        iu += 0x3FF00000 - 0x3FE6A09E
        k = i32(iu >> 20) - 0x3FF
        // Correction term for the rounding of 1 + x.
        if k < 54:
            c = 1.0 - (uf - x) if k >= 2 else x - (uf - 1.0)
            c = c / uf
        iu = (iu & 0x000FFFFF) + 0x3FE6A09E
        f = of_bits((u64(iu) << 32) | (hu & 0xFFFFFFFF)) - 1.0
    f64 hfsq = 0.5 * f * f
    f64 s = f / (2.0 + f)
    f64 z = s * s
    f64 w = z * z
    f64 t1 = w * (LG2 + w * (LG4 + w * LG6))
    f64 t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)))
    f64 dk = f64(k)
    return s * (hfsq + t2 + t1) + (dk * LG_LN2_LO + c) - hfsq + f + dk * LG_LN2_HI

private const f64 EM_Q1 = -3.33333333333331316428e-02
private const f64 EM_Q2 = 1.58730158725481460165e-03
private const f64 EM_Q3 = -7.93650757867487942473e-05
private const f64 EM_Q4 = 4.00821782732936239552e-06
private const f64 EM_Q5 = -2.01099218183624371326e-07

// e^x - 1, accurate near zero: musl's `expm1`.
#assert_raises
private f64 soft_expm1(f64 x_in):
    f64 x = x_in
    if x != x:
        return x
    u64 ux = bits_of(x)
    u32 hx = u32(ux >> 32) & 0x7FFFFFFF
    bool negative = (ux >> 63) != 0
    if hx >= 0x4043687A:
        // |x| >= 56 ln2
        if negative:
            return -1.0
        if x > 709.782712893383973096:
            return soft_inf()
    f64 c = 0.0
    i32 k = 0
    if hx > 0x3FD62E42:
        // |x| > ln2 / 2
        f64 hi = 0.0
        f64 lo = 0.0
        if hx < 0x3FF0A2B2:
            if !negative:
                hi = x - EX_LN2HI
                lo = EX_LN2LO
                k = 1
            else:
                hi = x + EX_LN2HI
                lo = -EX_LN2LO
                k = -1
        else:
            k = i32(EX_INVLN2 * x + (-0.5 if negative else 0.5))
            f64 t = f64(k)
            hi = x - t * EX_LN2HI
            lo = t * EX_LN2LO
        x = hi - lo
        c = (hi - x) - lo
    else if hx < 0x3C900000:
        // |x| < 2^-54
        return x
    f64 hfx = 0.5 * x
    f64 hxs = x * hfx
    f64 r1 = 1.0 + hxs * (EM_Q1 + hxs * (EM_Q2 + hxs * (EM_Q3 + hxs * (EM_Q4 + hxs * EM_Q5))))
    f64 t = 3.0 - r1 * hfx
    f64 e = hxs * ((r1 - t) / (6.0 - x * t))
    if k == 0:
        return x - (x * e - hxs)
    e = x * (e - c) - c
    e -= hxs
    if k == -1:
        return 0.5 * (x - e) - 0.5
    if k == 1:
        if x < -0.25:
            return -2.0 * (e - (x + 0.5))
        return 1.0 + 2.0 * (x - e)
    if k < 0 || k > 56:
        f64 y = x - e + 1.0
        if k == 1024:
            y = y * 2.0 * TWO_1023
        else:
            y = y * of_bits(u64(0x3FF + k) << 52)
        return y - 1.0
    f64 twopk = of_bits(u64(0x3FF + k) << 52)
    f64 uf = of_bits(u64(0x3FF - k) << 52)
    if k < 20:
        return (x - e + (1.0 - uf)) * twopk
    return (x - (e + uf) + 1.0) * twopk

// e^x / 2 scaled for an x past where e^x overflows but the hyperbolic
// functions do not yet: musl's `__expo2`.
#assert_raises
private f64 soft_expo2(f64 x):
    // scale = 2^1021, k ln2 with k = 2043
    f64 scale = of_bits(u64(0x3FF + 1021) << 52)
    return soft_exp(x - 1416.0996898839683) * scale * scale

// musl `sinh`.
#assert_raises
private f64 soft_sinh(f64 x):
    u64 u = bits_of(x)
    u32 w = u32(u >> 32) & 0x7FFFFFFF
    f64 ax = of_bits(u & 0x7FFFFFFFFFFFFFFF)
    if x == 0.0 || x != x:
        return x
    f64 h = -0.5 if (u >> 63) != 0 else 0.5
    if w < 0x40862E42:
        // |x| < log(DBL_MAX)
        f64 t = soft_expm1(ax)
        if w < 0x3FF00000:
            if w < 0x3FF00000 - (26 << 20):
                return x
            return h * (2.0 * t - t * t / (t + 1.0))
        return h * (t + t / (t + 1.0))
    return 2.0 * h * soft_expo2(ax)

// musl `cosh`.
#assert_raises
private f64 soft_cosh(f64 x):
    u64 u = bits_of(x)
    u32 w = u32(u >> 32) & 0x7FFFFFFF
    f64 ax = of_bits(u & 0x7FFFFFFFFFFFFFFF)
    if w < 0x3FE62E42:
        // |x| < log(2)
        if w < 0x3FF00000 - (26 << 20):
            return 1.0
        f64 t = soft_expm1(ax)
        return 1.0 + t * t / (2.0 * (1.0 + t))
    if w < 0x40862E42:
        f64 t = soft_exp(ax)
        return 0.5 * (t + 1.0 / t)
    return soft_expo2(ax)

// musl `tanh`.
#assert_raises
private f64 soft_tanh(f64 x):
    u64 u = bits_of(x)
    u64 ux = u & 0x7FFFFFFFFFFFFFFF
    u32 w = u32(ux >> 32)
    f64 ax = of_bits(ux)
    f64 t = 0.0
    if w > 0x3FE193EA:
        // |x| > log(3)/2 ~= 0.5493, or NaN
        if w > 0x40340000:
            // |x| > 20, or NaN
            t = ax if ax != ax else 1.0
        else:
            t = soft_expm1(2.0 * ax)
            t = 1.0 - 2.0 / (t + 2.0)
    else if w > 0x3FD058AE:
        // |x| > log(5/3)/2 ~= 0.2554
        t = soft_expm1(2.0 * ax)
        t = t / (t + 2.0)
    else if w >= 0x00100000:
        t = soft_expm1(-2.0 * ax)
        t = -t / (t + 2.0)
    else:
        t = ax
    return -t if (u >> 63) != 0 else t

// ── powers and roots ──────────────────────────────────────────────────────

private const [2]f64 PW_BP = [1.0, 1.5]
private const [2]f64 PW_DP_H = [0.0, 5.84962487220764160156e-01]
private const [2]f64 PW_DP_L = [0.0, 1.35003920212974897128e-08]
private const f64 PW_TWO53 = 9007199254740992.0
private const f64 PW_HUGE = 1.0e300
private const f64 PW_TINY = 1.0e-300
private const f64 PW_L1 = 5.99999999999994648725e-01
private const f64 PW_L2 = 4.28571428578550184252e-01
private const f64 PW_L3 = 3.33333329818377432918e-01
private const f64 PW_L4 = 2.72728123808534006489e-01
private const f64 PW_L5 = 2.30660745775561754067e-01
private const f64 PW_L6 = 2.06975017800338417784e-01
private const f64 PW_LG2 = 6.93147180559945286227e-01
private const f64 PW_LG2_H = 6.93147182464599609375e-01
private const f64 PW_LG2_L = -1.90465429995776804525e-09
private const f64 PW_OVT = 8.0085662595372944372e-17
private const f64 PW_CP = 9.61796693925975554329e-01
private const f64 PW_CP_H = 9.61796700954437255859e-01
private const f64 PW_CP_L = -7.02846165095275826516e-09
private const f64 PW_IVLN2 = 1.44269504088896338700e+00
private const f64 PW_IVLN2_H = 1.44269502162933349609e+00
private const f64 PW_IVLN2_L = 1.92596299112661746887e-08

// x^y: FreeBSD msun's `pow`. log2(x) is taken to about 70 bits as a head
// and a tail, multiplied by y keeping the tail, and 2^(y log2 x) is taken
// the way `soft_exp` takes e^x. Within one unit in the last place.
#assert_raises
private f64 soft_pow(f64 x, f64 y):
    i32 hx = i32(high_word(x))
    u32 lx = low_word(x)
    i32 hy = i32(high_word(y))
    u32 ly = low_word(y)
    i32 ix = hx & 0x7FFFFFFF
    i32 iy = hy & 0x7FFFFFFF

    // y = +-0, or x = 1: the answer is one, even for a NaN.
    if (u32(iy) | ly) == 0:
        return 1.0
    if hx == 0x3FF00000 && lx == 0:
        return 1.0
    // Either a NaN.
    if ix > 0x7FF00000 || (ix == 0x7FF00000 && lx != 0) || iy > 0x7FF00000 || (iy == 0x7FF00000 && ly != 0):
        return (x + 0.0) + (y + 0.0)

    // When x < 0: whether y is an odd integer (1), an even one (2) or
    // not an integer (0).
    i32 yisint = 0
    if hx < 0:
        if iy >= 0x43400000:
            yisint = 2
        else if iy >= 0x3FF00000:
            i32 k = (iy >> 20) - 0x3FF
            if k > 20:
                u32 j = ly >> u32(52 - k)
                if (j << u32(52 - k)) == ly:
                    yisint = 2 - i32(j & 1)
            else if ly == 0:
                i32 j = iy >> (20 - k)
                if (j << (20 - k)) == iy:
                    yisint = 2 - (j & 1)

    // y is +-inf, +-1, 2 or 1/2.
    if ly == 0:
        if iy == 0x7FF00000:
            if ((ix - 0x3FF00000) | i32(lx)) == 0:
                return 1.0
            if ix >= 0x3FF00000:
                return y if hy >= 0 else 0.0
            return -y if hy < 0 else 0.0
        if iy == 0x3FF00000:
            if hy < 0:
                return 1.0 / x
            return x
        if hy == 0x40000000:
            return x * x
        if hy == 0x3FE00000 && hx >= 0:
            return soft_sqrt(x)

    f64 ax = abs(x)
    // x is +-0, +-inf or +-1.
    if lx == 0 && (ix == 0x7FF00000 || ix == 0 || ix == 0x3FF00000):
        f64 z = ax
        if hy < 0:
            z = 1.0 / z
        if hx < 0:
            if ((ix - 0x3FF00000) | yisint) == 0:
                // (-1)^non-integer
                z = soft_nan()
            else if yisint == 1:
                z = -z
        return z

    // n is 0 for x < 0 and -1 otherwise.
    i32 n = i32(u32(hx) >> 31) - 1
    if (n | yisint) == 0:
        // (x < 0)^non-integer
        return soft_nan()
    f64 s = 1.0
    if (n | (yisint - 1)) == 0:
        // (x < 0)^odd
        s = -1.0

    f64 t1 = 0.0
    f64 t2 = 0.0
    if iy > 0x41E00000:
        // |y| > 2^31
        if iy > 0x43F00000:
            // |y| > 2^64: overflows or underflows whatever x is
            if ix <= 0x3FEFFFFF:
                return PW_HUGE * PW_HUGE if hy < 0 else PW_TINY * PW_TINY
            if ix >= 0x3FF00000:
                return PW_HUGE * PW_HUGE if hy > 0 else PW_TINY * PW_TINY
        if ix < 0x3FEFFFFF:
            return s * PW_HUGE * PW_HUGE if hy < 0 else s * PW_TINY * PW_TINY
        if ix > 0x3FF00000:
            return s * PW_HUGE * PW_HUGE if hy > 0 else s * PW_TINY * PW_TINY
        // |1 - x| <= 2^-20: log(x) by its series.
        f64 t = ax - 1.0
        f64 w = (t * t) * (0.5 - t * (3.3333333333333331e-01 - t * 0.25))
        f64 u = PW_IVLN2_H * t
        f64 v = t * PW_IVLN2_L - w * PW_IVLN2
        t1 = low_cleared(u + v)
        t2 = v - (t1 - u)
    else:
        i32 nn = 0
        if ix < 0x00100000:
            // Subnormal x.
            ax = ax * PW_TWO53
            nn -= 53
            ix = i32(high_word(ax))
        nn += (ix >> 20) - 0x3FF
        i32 j = ix & 0x000FFFFF
        // Normalize: x into [1, 2), and k picks the nearer of 1 and 1.5.
        ix = j | 0x3FF00000
        i32 k = 0
        if j <= 0x3988E:
            k = 0
        else if j < 0xBB67A:
            k = 1
        else:
            k = 0
            nn += 1
            ix -= 0x00100000
        ax = high_set(ax, u32(ix))

        // ss = s_h + s_l = (x - 1)/(x + 1) or (x - 1.5)/(x + 1.5)
        f64 u = ax - PW_BP[k]
        f64 v = 1.0 / (ax + PW_BP[k])
        f64 ss = u * v
        f64 s_h = low_cleared(ss)
        // t_h = ax + bp[k], high part
        f64 t_h = from_words(u32(((ix >> 1) | 0x20000000) + 0x00080000 + (k << 18)), 0)
        f64 t_l = ax - (t_h - PW_BP[k])
        f64 s_l = v * ((u - s_h * t_h) - s_h * t_l)
        // log(ax)
        f64 s2 = ss * ss
        f64 r = s2 * s2 * (PW_L1 + s2 * (PW_L2 + s2 * (PW_L3 + s2 * (PW_L4 + s2 * (PW_L5 + s2 * PW_L6)))))
        r += s_l * (s_h + ss)
        s2 = s_h * s_h
        t_h = low_cleared(3.0 + s2 + r)
        t_l = r - ((t_h - 3.0) - s2)
        // u + v = ss * (1 + ...)
        u = s_h * t_h
        v = s_l * t_h + t_l * ss
        // 2 / (3 log2) * (ss + ...)
        f64 p_h = low_cleared(u + v)
        f64 p_l = v - (p_h - u)
        f64 z_h = PW_CP_H * p_h
        f64 z_l = PW_CP_L * p_h + p_l * PW_CP + PW_DP_L[k]
        // log2(ax) = (ss + ...) * 2 / (3 log2) = nn + dp_h + z_h + z_l
        f64 t = f64(nn)
        t1 = low_cleared(((z_h + z_l) + PW_DP_H[k]) + t)
        t2 = z_l - (((t1 - t) - PW_DP_H[k]) - z_h)

    // (y1 + y2) * (t1 + t2)
    f64 y1 = low_cleared(y)
    f64 p_l = (y - y1) * t1 + y * t2
    f64 p_h = y1 * t1
    f64 z = p_l + p_h
    i32 j = i32(high_word(z))
    i32 i = i32(low_word(z))
    if j >= 0x40900000:
        // z >= 1024
        if ((j - 0x40900000) | i) != 0:
            return s * PW_HUGE * PW_HUGE
        if p_l + PW_OVT > z - p_h:
            return s * PW_HUGE * PW_HUGE
    else if (j & 0x7FFFFFFF) >= 0x4090CC00:
        // z <= -1075
        if ((j - i32(0xC090CC00)) | i) != 0:
            return s * PW_TINY * PW_TINY
        if p_l <= z - p_h:
            return s * PW_TINY * PW_TINY

    // 2^(p_h + p_l)
    i = j & 0x7FFFFFFF
    i32 k = (i >> 20) - 0x3FF
    i32 n2 = 0
    if i > 0x3FE00000:
        // |z| > 0.5: n2 = [z + 0.5]
        n2 = j + (0x00100000 >> (k + 1))
        k = ((n2 & 0x7FFFFFFF) >> 20) - 0x3FF
        f64 t = from_words(u32(n2 &~ (0x000FFFFF >> k)), 0)
        n2 = ((n2 & 0x000FFFFF) | 0x00100000) >> (20 - k)
        if j < 0:
            n2 = -n2
        p_h -= t
    f64 t = low_cleared(p_l + p_h)
    f64 u = t * PW_LG2_H
    f64 v = (p_l - (t - p_h)) * PW_LG2 + t * PW_LG2_L
    z = u + v
    f64 w = v - (z - u)
    t = z * z
    t1 = z - t * (EX_P1 + t * (EX_P2 + t * (EX_P3 + t * (EX_P4 + t * EX_P5))))
    f64 r = (z * t1) / (t1 - 2.0) - (w + z * w)
    z = 1.0 - (r - z)
    j = i32(high_word(z))
    j += i32(u32(n2) << 20)
    if (j >> 20) <= 0:
        // Subnormal output.
        z = soft_scalbn(z, n2)
    else:
        z = high_set(z, u32(j))
    return s * z

private const u32 CB_B1 = 715094163
private const u32 CB_B2 = 696219795
private const f64 CB_P0 = 1.87595182427177009643
private const f64 CB_P1 = -1.88497979543377169875
private const f64 CB_P2 = 1.621429720105354466140
private const f64 CB_P3 = -0.758397934778766047437
private const f64 CB_P4 = 0.145996192886612446982

// The real cube root: FreeBSD msun's `cbrt` (Bruce D. Evans' rewrite). An
// estimate good to 5 bits from the exponent, a polynomial to 23 bits, and
// one Newton step rounded to 53.
#assert_raises
private f64 soft_cbrt(f64 x):
    u32 hx = high_word(x)
    u32 low = low_word(x)
    u32 sign = hx & 0x80000000
    hx = hx &~ sign
    if hx >= 0x7FF00000:
        return x + x
    f64 t = 0.0
    if hx < 0x00100000:
        // Zero or subnormal.
        if (hx | low) == 0:
            return x
        t = TWO_54 * x
        u32 high = high_word(t)
        t = from_words(sign | ((high & 0x7FFFFFFF) / 3 + CB_B2), 0)
    else:
        t = from_words(sign | (hx / 3 + CB_B1), 0)
    // 23 bits.
    f64 r = (t * t) * (t / x)
    t = t * ((CB_P0 + r * (CB_P1 + r * CB_P2)) + ((r * r) * r) * (CB_P3 + r * CB_P4))
    // Round t away from zero to 23 bits, so the Newton step's error is one-sided.
    t = of_bits((bits_of(t) + 0x80000000) & 0xFFFFFFFFC0000000)
    f64 s = t * t
    r = x / s
    f64 w = t + t
    r = (r - t) / (w + r)
    return t + t * r

// ── the rest ──────────────────────────────────────────────────────────────

// x^2 as an exact head and tail (musl `hypot`'s `sq`).
private type Square: (f64 hi, f64 lo)

#assert_raises
private Square soft_square(f64 x):
    // 2^27 + 1, the split that leaves 26 bits in each half.
    f64 xc = x * 134217729.0
    f64 xh = x - xc + xc
    f64 xl = x - xh
    f64 hi = x * x
    return (hi, xh * xh - hi + 2.0 * xh * xl + xl * xl)

// sqrt(x^2 + y^2) without overflow or underflow on the way: musl's `hypot`.
#assert_raises
private f64 soft_hypot(f64 x_in, f64 y_in):
    u64 ux = bits_of(x_in) & 0x7FFFFFFFFFFFFFFF
    u64 uy = bits_of(y_in) & 0x7FFFFFFFFFFFFFFF
    if ux < uy:
        u64 swap = ux
        ux = uy
        uy = swap
    i32 ex = i32(ux >> 52)
    i32 ey = i32(uy >> 52)
    f64 x = of_bits(ux)
    f64 y = of_bits(uy)
    // hypot(inf, nan) is inf
    if ey == 0x7FF:
        return y
    if ex == 0x7FF || uy == 0:
        return x
    if ex - ey > 64:
        return x + y
    f64 z = 1.0
    if ex > 0x3FF + 510:
        z = TWO_700
        x = x * TWO_M700
        y = y * TWO_M700
    else if ey < 0x3FF - 450:
        z = TWO_M700
        x = x * TWO_700
        y = y * TWO_700
    Square sx = soft_square(x)
    Square sy = soft_square(y)
    return z * soft_sqrt(sy.lo + sx.lo + sy.hi + sx.hi)

// The count of leading zero bits of a nonzero `x`.
#assert_raises
private i32 soft_clz64(u64 x):
    i32 n = 0
    u64 v = x
    if (v >> 32) == 0:
        n += 32
        v = v << 32
    if (v >> 48) == 0:
        n += 16
        v = v << 16
    if (v >> 56) == 0:
        n += 8
        v = v << 8
    if (v >> 60) == 0:
        n += 4
        v = v << 4
    if (v >> 62) == 0:
        n += 2
        v = v << 2
    if (v >> 63) == 0:
        n += 1
    return n

// A double as fma takes it apart: significand shifted so its top ten bits
// and its last bit are zero, exponent, and sign.
private type FmaNum: (u64 m, i32 e, i32 sign)

// What `soft_fma` takes as zero, an infinity or a NaN: an exponent at least
// this.
private const i32 FMA_ZEROINFNAN = 0x7FF - 0x3FF - 52 - 1

#assert_raises
private FmaNum soft_fma_normalize(f64 x):
    u64 ix = bits_of(x)
    i32 e = i32(ix >> 52)
    i32 sign = e & 0x800
    e = e & 0x7FF
    if e == 0:
        ix = bits_of(x * TWO_63)
        e = i32(ix >> 52) & 0x7FF
        e = e - 63 if e != 0 else 0x800
    ix = ix & ((u64(1) << 52) - 1)
    ix = ix | (u64(1) << 52)
    ix = ix << 1
    e -= 0x3FF + 52 + 1
    return (ix, e, sign)

// The 128-bit product of two 64-bit integers, as its high and low halves.
private type Wide: (u64 hi, u64 lo)

#assert_raises
private Wide soft_mul128(u64 x, u64 y):
    u64 xlo = x & 0xFFFFFFFF
    u64 xhi = x >> 32
    u64 ylo = y & 0xFFFFFFFF
    u64 yhi = y >> 32
    u64 t1 = xlo * ylo
    u64 t2 = xlo * yhi + xhi * ylo
    u64 t3 = xhi * yhi
    u64 lo = t1 + (t2 << 32)
    u64 hi = t3 + (t2 >> 32) + (u64(1) if t1 > lo else u64(0))
    return (hi, lo)

// 1 when any bit of `v` is set: the sticky bit a shift leaves behind.
#assert_raises
private u64 sticky(u64 v):
    return u64(1) if v != 0 else u64(0)

// x * y + z rounded once: musl's `fma`, in 128-bit integer arithmetic.
#assert_raises
private f64 soft_fma(f64 x, f64 y, f64 z):
    FmaNum nx = soft_fma_normalize(x)
    FmaNum ny = soft_fma_normalize(y)
    FmaNum nz = soft_fma_normalize(z)
    if nx.e >= FMA_ZEROINFNAN || ny.e >= FMA_ZEROINFNAN:
        return x * y + z
    if nz.e >= FMA_ZEROINFNAN:
        if nz.e > FMA_ZEROINFNAN:
            // z == 0: x * y is exact-signed, and adding +0 would lose a -0
            return x * y
        return z

    // r = x * y
    Wide prod = soft_mul128(nx.m, ny.m)
    u64 rhi = prod.hi
    u64 rlo = prod.lo
    u64 zhi = 0
    u64 zlo = 0

    // Align the exponents.
    i32 e = nx.e + ny.e
    i32 d = nz.e - e
    if d > 0:
        if d < 64:
            zlo = nz.m << u64(d)
            zhi = nz.m >> u64(64 - d)
        else:
            zlo = 0
            zhi = nz.m
            e = nz.e - 64
            d -= 64
            if d == 0:
                // nothing to shift
                d = 0
            else if d < 64:
                rlo = (rhi << u64(64 - d)) | (rlo >> u64(d)) | sticky(rlo << u64(64 - d))
                rhi = rhi >> u64(d)
            else:
                rlo = 1
                rhi = 0
    else:
        zhi = 0
        d = -d
        if d == 0:
            zlo = nz.m
        else if d < 64:
            zlo = (nz.m >> u64(d)) | sticky(nz.m << u64(64 - d))
        else:
            zlo = 1

    // Add.
    i32 sign = nx.sign ~ ny.sign
    bool samesign = (sign ~ nz.sign) == 0
    bool nonzero = true
    if samesign:
        rlo += zlo
        rhi += zhi + (u64(1) if rlo < zlo else u64(0))
    else:
        u64 t = rlo
        rlo -= zlo
        rhi = rhi - zhi - (u64(1) if t < rlo else u64(0))
        if (rhi >> 63) != 0:
            rlo = 0 - rlo
            rhi = 0 - rhi - sticky(rlo)
            sign = 0x800 if sign == 0 else 0
        nonzero = rhi != 0

    // rhi to the top 63 bits of the result, the last one sticky.
    if nonzero:
        e += 64
        d = soft_clz64(rhi) - 1
        rhi = (rhi << u64(d)) | (rlo >> u64(64 - d)) | sticky(rlo << u64(d))
    else if rlo != 0:
        d = soft_clz64(rlo) - 1
        if d < 0:
            rhi = (rlo >> 1) | (rlo & 1)
        else:
            rhi = rlo << u64(d)
    else:
        // An exact zero.
        return x * y + z
    e -= d

    // To double. i is in [2^62, 2^63).
    i64 i = i64(rhi)
    if sign != 0:
        i = -i
    f64 r = f64(i)
    if e < -1022 - 62:
        // Subnormal before rounding.
        if e == -1022 - 63:
            f64 c = -TWO_63 if sign != 0 else TWO_63
            if r == c:
                // Rounds to the smallest normal.
                return -TWO_M1022 if sign != 0 else TWO_M1022
            // One bit is lost when scaled: add another top bit so the
            // conversion rounds only once.
            if (rhi << 53) != 0:
                i = i64((rhi >> 1) | (rhi & 1) | (u64(1) << 62))
                if sign != 0:
                    i = -i
                r = f64(i)
                r = 2.0 * r - c
        else:
            // Round once, when scaled.
            i = i64(((rhi >> 10) | sticky(rhi << 54)) << 10)
            if sign != 0:
                i = -i
            r = f64(i)
    return soft_scalbn(r, e)
