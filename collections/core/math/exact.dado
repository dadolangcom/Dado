// The functions of `core:math` that have exactly one right answer, written in
// Dado on every target.
//
// Rounding, the absolute value, the remainder, the sign, the exponent and
// the classification questions are each defined by IEEE 754 to the last bit,
// so a C library has no choice in them and neither has this file: the
// answers here are the bits `<math.h>` gives, on every target, which the
// tests check against the C library itself. Being Dado is what lets them
// build on `#NONE` and raise into a script, and each is promised to by the
// `#assert_raises` above it.
//
// Most are transliterations of musl 1.2.5's (MIT; the notice is in
// `soft.dado`), which reads a double through its bits as these do.
package math

// The bits of `x` with the sign cleared.
private const u64 ABS_MASK = 0x7FFFFFFFFFFFFFFF

// 2^52: an `f64` at least this large is a whole number, and adding it to a
// smaller one rounds that one to a whole number.
private const f64 TO_INTEGER = 4503599627370496.0

// ── absolute value, sign, remainder ───────────────────────────────────────

// `|x|`: `x` with its sign bit cleared, so `abs(-0.0)` is `0.0` and a
// NaN stays a NaN. C's `fabs`.
#assert_raises
f64 abs(f64 x):
    return of_bits(bits_of(x) & ABS_MASK)

// `x` with the sign of `sign`: its magnitude, negated when `sign`'s sign bit
// is set. The sign bit is read, not compared, so `with_sign_of(1.0, -0.0)`
// is `-1.0`. C's `copysign`.
#assert_raises
f64 with_sign_of(f64 x, f64 sign):
    return of_bits((bits_of(x) & ABS_MASK) | (bits_of(sign) & 0x8000000000000000))

// The remainder of `numerator / denominator` truncated toward zero: the
// answer has the numerator's sign and is smaller in magnitude than the
// denominator. Exact; C's `fmod`. A zero denominator, an infinite numerator
// or a NaN answers NaN; an infinite denominator answers the numerator.
//
// **Not C's `remainder()`**, which rounds the quotient to the nearest
// (`remainder(5.0, 3.0)` is `-1.0` there, `2.0` here): a port of C code
// that calls `remainder` wants `numerator - denominator *
// nearest_even(numerator / denominator)`, and one that calls `fmod` wants
// this.
//
// Long division on the significands, a bit a step (musl's `fmod`), so it
// takes as many steps as the two exponents are apart.
#assert_raises
f64 remainder(f64 numerator, f64 denominator):
    f64 x = numerator
    f64 y = denominator
    u64 uxi = bits_of(x)
    u64 uyi = bits_of(y)
    i32 ex = i32((uxi >> 52) & 0x7FF)
    i32 ey = i32((uyi >> 52) & 0x7FF)
    u64 sx = uxi >> 63
    if (uyi << 1) == 0 || y != y || ex == 0x7FF:
        return (x * y) / (x * y)
    if (uxi << 1) <= (uyi << 1):
        if (uxi << 1) == (uyi << 1):
            return 0.0 * x
        return x

    // Normalize both significands.
    u64 i = 0
    if ex == 0:
        i = uxi << 12
        for (i >> 63) == 0:
            ex -= 1
            i = i << 1
        uxi = uxi << u64(1 - ex)
    else:
        uxi = (uxi & 0x000FFFFFFFFFFFFF) | 0x0010000000000000
    if ey == 0:
        i = uyi << 12
        for (i >> 63) == 0:
            ey -= 1
            i = i << 1
        uyi = uyi << u64(1 - ey)
    else:
        uyi = (uyi & 0x000FFFFFFFFFFFFF) | 0x0010000000000000

    // x mod y
    for ex > ey:
        i = uxi - uyi
        if (i >> 63) == 0:
            if i == 0:
                return 0.0 * x
            uxi = i
        uxi = uxi << 1
        ex -= 1
    i = uxi - uyi
    if (i >> 63) == 0:
        if i == 0:
            return 0.0 * x
        uxi = i
    for (uxi >> 52) == 0:
        uxi = uxi << 1
        ex -= 1

    // Scale the result.
    if ex > 0:
        uxi -= 0x0010000000000000
        uxi = uxi | (u64(ex) << 52)
    else:
        uxi = uxi >> u64(1 - ex)
    return of_bits(uxi | (sx << 63))

// ── rounding ──────────────────────────────────────────────────────────────
//
// **Five roundings, told apart at negative values and at halves**, which is
// where they differ: at 2.5 `down`, `up`, `toward_zero`, `nearest` and
// `nearest_even` answer 2, 3, 2, 3 and 2, and at -1.5 they answer -2, -1,
// -1, -2 and -2. Each keeps the sign of a zero answer (`up(-0.5)` is
// `-0.0`), passes an infinity and a NaN through, and returns any `f64` of
// magnitude 2^52 or more unchanged, since every such value is whole.

// The largest whole number not above `x`. C's `floor`.
#assert_raises
f64 down(f64 x):
    u64 u = bits_of(x)
    i32 e = i32((u >> 52) & 0x7FF)
    if e >= 0x3FF + 52 || x == 0.0:
        return x
    // y = (a whole neighbour of x) - x
    f64 y = 0.0
    if (u >> 63) != 0:
        y = x - TO_INTEGER + TO_INTEGER - x
    else:
        y = x + TO_INTEGER - TO_INTEGER - x
    if e <= 0x3FF - 1:
        // |x| < 1
        return -1.0 if (u >> 63) != 0 else 0.0
    if y > 0.0:
        return x + y - 1.0
    return x + y

// The smallest whole number not below `x`. C's `ceil`.
#assert_raises
f64 up(f64 x):
    u64 u = bits_of(x)
    i32 e = i32((u >> 52) & 0x7FF)
    if e >= 0x3FF + 52 || x == 0.0:
        return x
    f64 y = 0.0
    if (u >> 63) != 0:
        y = x - TO_INTEGER + TO_INTEGER - x
    else:
        y = x + TO_INTEGER - TO_INTEGER - x
    if e <= 0x3FF - 1:
        return -0.0 if (u >> 63) != 0 else 1.0
    if y < 0.0:
        return x + y + 1.0
    return x + y

// `x` with its fraction dropped: the whole number nearest `x` in the
// direction of zero. C's `trunc`.
#assert_raises
f64 toward_zero(f64 x):
    u64 u = bits_of(x)
    i32 e = i32((u >> 52) & 0x7FF) - 0x3FF + 12
    if e >= 52 + 12:
        return x
    if e < 12:
        e = 1
    // The bits below the binary point.
    u64 ones = 0xFFFFFFFFFFFFFFFF
    u64 m = ones >> u64(e)
    if (u & m) == 0:
        return x
    return of_bits(u &~ m)

// The nearest whole number, halves rounded away from zero: `nearest(2.5)`
// is 3 and `nearest(-2.5)` is -3. C's `round`. For halves to even, the
// rounding IEEE 754 does by default, use `nearest_even`.
#assert_raises
f64 nearest(f64 x_in):
    f64 x = x_in
    u64 u = bits_of(x)
    i32 e = i32((u >> 52) & 0x7FF)
    if e >= 0x3FF + 52:
        return x
    bool negative = (u >> 63) != 0
    if negative:
        x = -x
    if e < 0x3FF - 1:
        // |x| < 1/2: a zero of x's sign
        return 0.0 * x_in
    f64 y = x + TO_INTEGER - TO_INTEGER - x
    if y > 0.5:
        y = y + x - 1.0
    else if y <= -0.5:
        y = y + x + 1.0
    else:
        y = y + x
    if negative:
        return -y
    return y

// The nearest whole number, halves rounded to the even neighbour:
// `nearest_even(2.5)` is 2, `nearest_even(3.5)` is 4 and
// `nearest_even(-0.5)` is `-0.0`. IEEE 754's default rounding, and so the
// one that does not drift when many halves are summed. C's `rint` in the
// default rounding mode, the only mode a Dado program runs in.
#assert_raises
f64 nearest_even(f64 x):
    u64 u = bits_of(x)
    i32 e = i32((u >> 52) & 0x7FF)
    if e >= 0x3FF + 52:
        return x
    bool negative = (u >> 63) != 0
    f64 y = 0.0
    if negative:
        y = x - TO_INTEGER + TO_INTEGER
    else:
        y = x + TO_INTEGER - TO_INTEGER
    if y == 0.0:
        return -0.0 if negative else 0.0
    return y

// ── classification ────────────────────────────────────────────────────────
//
// Questions *about* an `f64` rather than values computed from one. Each reads
// the bits, or compares the number with itself, so none is a macro and each
// may be passed where a `bool(f64)` predicate is wanted.

// Whether `x` is a NaN, of either sign and any payload. A NaN is the one
// `f64` not equal to itself.
#assert_raises
bool is_nan(f64 x):
    return x != x

// Whether `x` is positive or negative infinity.
#assert_raises
bool is_infinite(f64 x):
    return (bits_of(x) & ABS_MASK) == 0x7FF0000000000000

// Whether `x` is neither infinite nor a NaN: a zero, a subnormal or a
// normal number.
#assert_raises
bool is_finite(f64 x):
    return (bits_of(x) & ABS_MASK) < 0x7FF0000000000000

// ── the exponent ──────────────────────────────────────────────────────────

// An `f64` as a fraction and a power of two.
type Exponent:
    // In [0.5, 1) in magnitude, with `x`'s sign; `x` itself when `x` is a
    // zero, an infinity or a NaN.
    f64 fraction
    // The power: `x == fraction * 2^exponent`. Zero when `fraction` is `x`.
    i32 exponent

// `x` as `fraction * 2^exponent` with the fraction's magnitude in [0.5, 1):
// `split_exponent(8.0)` is `(0.5, 4)`. Exact, subnormals included. C's
// `frexp`, answering both halves rather than writing one through a pointer.
#assert_raises
Exponent split_exponent(f64 x):
    u64 u = bits_of(x)
    i32 e = i32((u >> 52) & 0x7FF)
    i32 extra = 0
    if e == 0:
        if x == 0.0:
            return (x, 0)
        // Subnormal: scale into the normal range first.
        u = bits_of(x * 1.8446744073709552e+19)
        e = i32((u >> 52) & 0x7FF)
        extra = 64
    else if e == 0x7FF:
        return (x, 0)
    u = (u & 0x800FFFFFFFFFFFFF) | 0x3FE0000000000000
    return (of_bits(u), e - 0x3FE - extra)

// `x * 2^n`, computed by adjusting the exponent and rounded once if the answer
// is subnormal: `times_power_of_two(0.75, 4)` is `12.0`. It overflows to an
// infinity and underflows to zero as the product would. C's `ldexp` and
// `scalbn`.
#assert_raises
f64 times_power_of_two(f64 x, i32 n):
    return soft_scalbn(x, n)
