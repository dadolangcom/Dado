// std/math — the parts of C's `<math.h>` a program reaches for.
//
// Every declaration is a **restatement**: Dado says what it believes the header
// contains, the emitted C includes the real one, and the C compiler checks the
// belief. Nothing here parses a header, and nothing here is a
// reimplementation — the arithmetic is your platform's libm, which is a great
// deal better tested than anything this file could contain.
//
//     import "core:math"
//     math.root(2.0)
//
// **Linking.** `<math.h>` needs `-lm` on Linux and nothing on macOS, so the
// clause-only `foreign` line below the declarations carries `link "-lm"`.
//
// **On the web** there is no libm to link and no `<math.h>` to include:
// `math.h` is one of the headers the `#WEB` runtime supplies itself. The
// compiler emits the runtime's own math library into the program — musl's,
// transliterated, so every browser computes the same bits — declaring each
// function with C's prototype, and the restatements below are checked against
// those exactly as they are against the header's on a hosted build. So the
// `-lm` is the one thing here that is not the web's, and it is in a `when`.
//
// This paragraph used to argue the other way — that linking is a toolchain
// concern and not a language one, that the source cannot know which
// library provides a header, and that a `link` file beside this one was
// therefore the honest place for it. It was settled the
// other way, and the reason is worth keeping: the objection was never to the
// *value* but to the *variation*. A flag that differs by platform has to be
// conditional, and a file beside the source could express that only by
// inventing a selector format (`#LINUX:`) matched by string against `#OS`'s
// member names — a second, weaker compile-time branch beside the one the
// language already has. `-lm` here is unconditional; where a flag is not,
// `when #OS == …` around a clause-only `foreign` line is what says so, and it
// folds and diagnoses like every other `when`.
package math

// The block is `private`, so these C names are not part of this package's
// surface: a library is the names it chose, not the names it wrapped. Every
// function below is a wrapper, and at `-O2` every one of them disappears.
private foreign "math.h":
    f64 sqrt(f64 x)
    f64 pow(f64 base, f64 exponent)
    f64 fabs(f64 x)
    f64 fmod(f64 numerator, f64 denominator)
    f64 floor(f64 x)
    f64 ceil(f64 x)
    f64 trunc(f64 x)
    f64 round(f64 x)
    f64 hypot(f64 x, f64 y)
    f64 fma(f64 x, f64 y, f64 z)
    f64 exp(f64 x)
    f64 log(f64 x)
    f64 log2(f64 x)
    f64 log10(f64 x)
    f64 sin(f64 x)
    f64 cos(f64 x)
    f64 tan(f64 x)
    f64 atan2(f64 y, f64 x)
    // The last two are **macros** in the header rather than functions, and the
    // rule that follows from that is `is_nan`'s to state. They are restated at
    // `bool` where C writes `int`, for the reason argued there too.
    @macro bool isnan(f64 x)
    @macro bool isinf(f64 x)

// The library `<math.h>` is in, on a target that has one to link.
when #OS != #WEB:
    foreign "math.h" link "-lm"

// **What raises into a script**: the functions written in Dado alone — the two
// conversions and the comparisons and the whole-number power at the bottom of
// the file — each promised by the `#assert_raises` on the line above it, and
// checked at each instantiation a program makes. The wrappers over `math.h`
// are not promised: a transcendental is C's until a script's own is pinned to
// the same bits.

// ── constants ─────────────────────────────────────────────────────────────
//
// C keeps these behind `_USE_MATH_DEFINES` and a non-standard `M_PI`, so a
// program cannot portably reach for the header's copy — they are written out
// here instead, at `f64`, which every float width narrows from. A `const` with
// a written type is a value of that type, range-checked once here.

const f64 PI  = 3.14159265358979323846
const f64 TAU = 6.28318530717958647692

// Degrees to radians and back — the conversion every input handler and every
// rotated draw call needs, and the one place to write the factor so no call
// site carries a bare `3.14159 / 180`.
#assert_raises
f64 radians(f64 degrees):
    return degrees * (PI / 180.0)

#assert_raises
f64 degrees(f64 radians):
    return radians * (180.0 / PI)

// ── powers and roots ──────────────────────────────────────────────────────

f64 root(f64 x):
    return sqrt(x)

f64 raised(f64 base, f64 exponent):
    return pow(base, exponent)

// The length of a vector, computed the way libm computes it — `hypot` avoids
// the overflow `sqrt(x*x + y*y)` walks into for large inputs.
f64 length(f64 x, f64 y):
    return hypot(x, y)

// ── fused multiply-add ────────────────────────────────────────────────────

// `x * y + z`, rounded **once**.
//
// The whole of the difference from writing `x * y + z` is that rounding. The
// product keeps its full width and the sum is taken from there, so the bits `*`
// would have thrown away on its own are still in the answer — which is what a
// dot product, a polynomial and a Newton step are each short of, and the only
// reason to spend a call on arithmetic this short.
//
// **Named for the fusing rather than for the arithmetic**, which is the point
// `power` makes at the bottom of this file from the other side: two names for
// nearly the same thing is how a caller picks the wrong one, and a
// `multiply_add` would be a name for something every caller can already write.
// The long name is doing work — it says the rounding is the feature.
//
// **What it is not: a claim about being faster.** Where the hardware has the
// instruction this is one of them; where it does not, it is a libm routine that
// does more work than a multiply and an add, not less. It is here for the
// answer, and the answer is the accurate one.
f64 fused_multiply_add(f64 x, f64 y, f64 z):
    return fma(x, y, z)

// ── rounding ──────────────────────────────────────────────────────────────

f64 magnitude(f64 x):
    return fabs(x)

f64 remainder(f64 numerator, f64 denominator):
    return fmod(numerator, denominator)

f64 down(f64 x):
    return floor(x)

f64 up(f64 x):
    return ceil(x)

f64 toward_zero(f64 x):
    return trunc(x)

f64 nearest(f64 x):
    return round(x)

// ── exponentials and logarithms ───────────────────────────────────────────

f64 e_to(f64 x):
    return exp(x)

f64 ln(f64 x):
    return log(x)

f64 log_2(f64 x):
    return log2(x)

f64 log_10(f64 x):
    return log10(x)

// ── trigonometry ──────────────────────────────────────────────────────────

f64 sine(f64 x):
    return sin(x)

f64 cosine(f64 x):
    return cos(x)

f64 tangent(f64 x):
    return tan(x)

// The angle of a vector, quadrant included — which is what `atan2` is for and
// `atan(y / x)` is not.
f64 angle(f64 y, f64 x):
    return atan2(y, x)

// ── classification ────────────────────────────────────────────────────────
//
// Two questions *about* an `f64` rather than two values computed from one, and
// the first answers this library has to either: nothing else here names a NaN
// or an infinity, and a caller who wanted to know had to compare a number with
// itself and hope the reader saw why.
//
// **`isnan` and `isinf` are macros, and a macro may be called but not passed.**
// A `foreign` name emits no prototype of its own — the emitted C includes the
// header and writes the name through untouched — so a *call* is the macro's own
// invocation and expands into the header's text. A *use as a value* does not:
// binding one of these to a `bool(f64)` is well-typed Dado and emits the bare
// identifier, and a macro that is nobody's call site never expands, so the C
// compiler is left with an undeclared name and refuses. The refusal names a
// line of Dado source and says `'isnan' undeclared`, which is a C error wearing
// this file's line numbers rather than a diagnostic Dado can give. Every other
// name in the block above is a real function and may be handed around freely;
// these two are called, never referenced.
//
// The rule stops at this file, and that is most of what the two wrappers are
// worth. `is_nan` and `is_infinite` are ordinary Dado functions with ordinary C
// bodies, so a caller may bind one to a `bool(f64)` and pass it wherever a
// predicate is wanted — the thing the macro underneath cannot do. Wrapping a
// macro does not only rename it; it gives it an address.
//
// **Restated at `bool` where C writes `int`, and that is the safer of the two.**
// The macros promise *some* nonzero value for true and are not held to 1 —
// glibc answers −1 for a negative infinity — so the value has to be flattened
// somewhere. Restating them at `i32` and writing `!= 0` in the wrapper reaches
// the same answer and was rejected: it carries a −1 across the boundary into a
// Dado that says a truth value lives there, and it leaves the flattening to a
// wrapper that can be edited to forget it. At `bool` the conversion to `_Bool`
// does it in C, at the crossing, and it is the one conversion in that language
// that takes every nonzero to exactly 1 and has no second reading.

bool is_nan(f64 x):
    return isnan(x)

bool is_infinite(f64 x):
    return isinf(x)

// ── no C at all ───────────────────────────────────────────────────────────
//
// C has no `min`, and its `fmin`/`fmax` are more machinery than a comparison
// needs. These are Dado, and they are here because a standard library is
// allowed to contain the obvious thing.
//
// **Written over `scalar`, which is what `scalar` is for.** Before that these
// were six functions: an `f64` trio and an `i32` trio spelled `min_i32`,
// `max_i32`, `clamp_i32`, kept in step by review. `scalar` is the intersection
// of every numeric's operators — `+ - * /` and the six comparisons — and a
// comparison is all these need, so one source now serves every width and
// `math.min(3, 8)` and `math.min(3.0, 8.0)` are the same three lines.
//
// The `_i32` spellings are **gone**, not deprecated: `math.min` is the name,
// and a library that kept both would be asking every caller to know which.
//
// **The answer is the first argument unless a comparison says otherwise**, and
// that one sentence is the whole of the edge-case behaviour — it is also
// `core:linalg`'s componentwise `min`/`max`/`clamp`, so a scalar and a
// one-slot vector agree:
//
// - `min(a, b)` is `b` only when `b < a`, and `max(a, b)` only when `b > a`.
//   On a tie the answer is `a`, which is only visible for `-0.0` and `0.0`.
// - **NaN.** Every comparison with a NaN is false, so a NaN in `b` is never
//   chosen and a NaN in `a` is never replaced: `min(NaN, 1.0)` is NaN and
//   `min(1.0, NaN)` is `1.0`. Put the value that may be NaN first when it
//   should show, and second when it should be dropped.
// - `clamp(x, low, high)` is `min(max(x, low), high)`, GLSL's definition, so
//   it inherits that rule: `x` is raised to `low` only when `low > x` and then
//   lowered to `high` only when `high <` it. A NaN `x` comes back NaN — a
//   clamp does not turn a broken value into a plausible one — and a NaN bound
//   is ignored, because no comparison with it is true.
// - **`low > high` is not refused: `high` wins.** Whatever number `x` is, it
//   is raised to at least `low`, which is above `high`, and so is lowered to
//   `high`. `core:linalg`'s componentwise `clamp` answers the same. It is not
//   checked because it is well defined, and a caller whose bounds can cross
//   has a bug the answer makes visible: every result is `high`.

#assert_raises
$T min(T a, T b) where T is scalar:
    if b < a:
        return b
    return a

#assert_raises
$T max(T a, T b) where T is scalar:
    if b > a:
        return b
    return a

#assert_raises
$T clamp(T x, T low, T high) where T is scalar:
    return min(max(x, low), high)

// `base` raised to a whole-number power, by squaring.
//
// **Not `raised`**, which is libm's `pow` and takes a real exponent. This is
// the one you want for `x * x * x`: it is exact where `pow` is merely very
// close, and it does not call into libm at all.
//
// Two independent bindings, and they are the reason this is here rather than
// in `linalg`: the base is a **float** of whatever width the caller has, and
// the exponent is an **int** of whatever width the caller has, and neither says
// anything about the other. `power(2.0, 10)` is `f64` and `i32`; a `f32` base
// with a `u8` exponent is a different instantiation of the same source.
//
// **The exponent is a count of multiplications and must not be negative.** It
// cannot be checked here: `int` includes the unsigned widths, `exponent < 0` is
// always false for one of those, and the emitted C builds under `-Wextra
// -Werror` where that is a diagnostic — so the check would compile for half the
// category and fail the build for the other half. For a negative exponent use
// `raised`, which takes a real one.
#assert_raises
$B power(B base, $E exponent) where B is float && E is int:
    B result = 1.0
    B square = base
    E e = exponent
    for e > 0:
        if (e & 1) == 1:
            result = result * square
        square = square * square
        e = e >> 1
    return result
