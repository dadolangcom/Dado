@test
// The kept chunk's `clean` mark: `reset` zeroes nothing, and a carve from the
// chunk it kept zeroes only what an earlier tenant could have written.
// `core:mem/arena`'s `clean_test`, for a slab. Two claims, and each needs the
// other to mean anything:
//
//   1. **A carve over bytes nothing has written does not zero them again.**
//      Checked from inside: a byte is planted above the mark, where the slab
//      believes the chunk is still the backing allocator's zero, and a carve
//      across it must leave it there. A reset that zeroed its whole kept
//      chunk, as this package once did, wipes it.
//   2. **A carve over bytes a reset gave back does zero them**, in a kept
//      chunk the cursor never left and in one it left for a newer chunk.
package slab

import "core:mem"
import "core:mem/libc"

private void fill(rawptr p, i64 n, u8 v):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<n]
    for i in 0..<n:
        span[i] = v
    return

private bool zeroed(rawptr p, i64 n):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<n]
    for i in 0..<n:
        if span[i] != 0:
            return false
    return true

private u8 byte_of(rawptr p, i64 i):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<i + 1]
    return span[i]

private void plant(rawptr p, i64 i, u8 v):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<i + 1]
    span[i] = v
    return

i32 test():
    bool ok = true
    Slab s = over(libc.allocator())
    defer destroy(&s)
    (mem.Proc proc, rawptr data) al = allocator(&s)

    // Four 64-byte blocks off the first chunk, written through, then a reset.
    [4]rawptr first
    for i in 0..<4:
        first[i] = al.proc(al.data, mem.AllocatorMode.Alloc, 64, 16, nil, 0)
        ok = #expect(first[i] != nil && zeroed(first[i], 64), "a fresh carve was not zero") && ok
        fill(first[i], 64, 255)
    ok = #expect(s.clean == 0, "the mark moved before anything was given back: ", s.clean) && ok
    rawptr chunk = s.chunks
    reset(&s)
    ok = #expect(s.chunks == chunk && s.clean == 16 + 4 * 64, "the reset's mark was ", s.clean, ", not the carved top") && ok

    // 1. A byte above the mark survives the carve that reaches it: nothing
    //    zeroed the chunk at the reset, and nothing zeroes it now.
    plant(chunk, i64(s.clean) + 10, 171)
    // 2. Below the mark, each block is zero again.
    for i in 0..<4:
        rawptr again = al.proc(al.data, mem.AllocatorMode.Alloc, 64, 16, nil, 0)
        ok = #expect(again == first[i], "the reset slab did not carve from the chunk's start") && ok
        ok = #expect(zeroed(again, 64), "a carve over bytes the reset gave back was not zeroed") && ok
    rawptr above = al.proc(al.data, mem.AllocatorMode.Alloc, 64, 16, nil, 0)
    ok = #expect(byte_of(above, 10) == 171, "a carve above the mark zeroed bytes the backing allocator had zeroed") && ok
    plant(above, 10, 0)

    // The mark never goes down: a reset after less use keeps it.
    reset(&s)
    rawptr one = al.proc(al.data, mem.AllocatorMode.Alloc, 16, 16, nil, 0)
    fill(one, 16, 255)
    reset(&s)
    ok = #expect(s.clean == 16 + 5 * 64, "a reset after less use moved the mark to ", s.clean) && ok

    // 2b. The cursor leaves the oldest chunk for a newer one: the mark is
    //     raised to where it left, and the kept chunk is zeroed below it on
    //     its next carve. 4096-byte blocks: fifteen fit a 64 KiB chunk.
    [16]rawptr big
    for i in 0..<16:
        big[i] = al.proc(al.data, mem.AllocatorMode.Alloc, 4096, 16, nil, 0)
        ok = #expect(big[i] != nil, "a 4096-byte block was refused") && ok
        fill(big[i], 4096, 255)
    ok = #expect(chunks(&s) == 2, "sixteen 4096-byte blocks took ", chunks(&s), " chunks, not 2") && ok
    reset(&s)
    ok = #expect(chunks(&s) == 1 && s.clean == 16 + 15 * 4096, "the mark after the cursor left the chunk was ", s.clean) && ok
    for i in 0..<15:
        rawptr again = al.proc(al.data, mem.AllocatorMode.Alloc, 4096, 16, nil, 0)
        ok = #expect(again == big[i] && zeroed(again, 4096), "block ", i, " of the kept chunk was not zeroed") && ok

    // A destroyed slab starts clean.
    destroy(&s)
    ok = #expect(s.clean == 0, "destroy left the mark at ", s.clean) && ok

    if ok:
        return 0
    return 1
