// core:mem/bump — a cursor over a block, behind the allocator interface.
//
//     import "core:mem"
//     import "core:mem/bump"
//
//     [4096]u8 storage
//     bump.Arena arena = bump.over(storage[:])
//     using bump.allocator(&arena):
//         ref []i32 xs = #make([]i32, 8)
//
// **The foundation every other allocator is described in terms of**, and the
// one whose `FreeAll` is the reason to reach for it: releasing every
// allocation an arena ever made is one store, O(1), no matter how many there
// were.
//
// It is also the allocator a **freestanding** program uses. At depth 0 on a
// freestanding target `#default` is `nil`, so allocating there
// means supplying an arena — and an arena over a `[N]u8` in static storage
// asks nothing of libc, which is the property `corpus/freestanding` tests by
// inspecting the emitted `#include` lines rather than by asserting. (That program
// writes its own bump arena rather than importing this package — a corpus program
// imports nothing outside its own directory — so what it pins is the *language*
// claim this package is one implementation of. `bump_test.dado` is what tests the
// code here.)
//
// ## What it does with each mode
//
//     Alloc     align the cursor, hand back the block, advance; a zero size
//               advances one byte, so its block is distinct (`core:mem`'s rule)
//     Resize    **in place** when the block is the last allocation, which is
//               O(1) and invisible from outside; `mem.resize_by_copy`
//               otherwise
//     Free      a no-op — an arena does not reclaim one block
//     FreeAll   `used = 0`. One store. Every reference into the arena is stale
//               from that moment, and nothing detects it
//
// `Free` being a no-op is not a gap: the shipped set of allocators already
// contains an allocator that does not honour `delete`, which is what makes a
// collector an ordinary member of the interface rather than a new idea.
//
// ## Where it runs, and what a script sees
//
// **Every target**: freestanding (`#NONE`), the web, and hosted (Linux, macOS
// and Windows) alike. It asks nothing of a C library.
//
// **What raises into a script: nothing.** An `Arena` is a block's address and
// a cursor into it, and every function here takes one.
//
// **Thread-safety.** An `Arena` belongs to one thread at a time; two threads
// allocating from one race on its cursor.
package bump

import "core:mem"

// The arena's state: where the block is, how large it is, and how much of it
// has been handed out. `last` is the offset of the most recent allocation,
// which is the whole of what `Resize`'s in-place fast path needs to know.
//
// `last == used` means "nothing has been handed out since the last reset", and
// is why `last` is an offset rather than a pointer: an offset has a zero that
// means something.
type Arena: (
    rawptr block,
    u64 cap,
    u64 used,
    u64 last,
    u64 last_size,
)

// An arena over storage that already exists — a `[N]u8` on the stack, a
// package-level one in static storage, or a run from another allocator. It
// **does not allocate**, which is what makes it the freestanding answer, and it
// keeps the run's address and length and nothing else: the storage must
// outlive the arena and every allocation made through it. An empty run gives
// an arena that refuses every request.
//
// ## The base is aligned here, and that used to be an assumption
//
// `carve` aligns the **cursor** — an offset, an ordinary integer — and hands
// back `block + at`. That address is aligned only if `block` was, and a `[N]u8`
// has C alignment 1 by the standard: a caller writing `bump.over(storage[:])` is
// promising nothing about where `storage` sits. Everything downstream —
// `core:mem/arena` and every `#make` through it — inherits whatever answer is
// given here, so the base is aligned here, once, with `#align_forward`, and
// what the padding cost comes off the capacity.
//
// **This was not a hypothetical.** Measured 2026-09-05 under clang 18.1 and
// gcc 13.3: a Dado run is emitted as `struct { uint8_t s[N]; }`, whose C
// alignment is **1**, so a package-level `[256]u8`, a `[64]u8` and a named
// `Block` all landed at addresses that are not multiples of 16, and every bump
// arena over Dado-declared storage handed out misaligned blocks until the base
// was aligned at this door. On x86-64 that is a slowdown and an atomics hazard;
// on a target that traps it is a crash.
//
// A base that was already aligned is charged nothing.
Arena over([]u8 storage):
    i64 len = #len(storage)
    if len == 0:
        return (nil, 0, 0, 0, 0)
    rawptr block = rawptr(&storage[0])
    u64 cap = u64(len)
    rawptr base = #align_forward(block, mem.MAX_ALIGN)
    u64 pad = u64(base - block)
    if cap <= pad:
        // The alignment costs more than the run holds, so nothing in it can be
        // handed out at `MAX_ALIGN`: an arena of zero capacity, which refuses
        // every request, as an empty run's does.
        return (base, 0, 0, 0, 0)
    return (base, cap - pad, 0, 0, 0)

// The allocator for `arena`. The arena is the allocator's `data`, so it is
// borrowed by pointer and must outlive every allocation made through it — the
// ordinary raw-pointer bargain, stated because an arena is exactly the
// value somebody puts on the stack.
(mem.Proc proc, rawptr data) allocator(^Arena arena):
    return (dispatch, rawptr(arena))

// The allocator for a bump arena, as a declaration that takes `mem.Allocator` on:
// a `BumpAllocator` is accepted wherever an allocator is asked — `#new`, `using`, a
// parameter written as the two words, an `Allocator` binder — and the
// compiler calls its `data()` there. It holds only the pointer, so a
// one-slot declaration: `self` *is* the `^Arena`.
//
//     bump.BumpAllocator h = &a
//     using h:
//         ...
type BumpAllocator using mem.Allocator:
    ^Arena arena,
    // The two words `allocator(self.arena)` answers.
    (mem.Proc proc, rawptr data) data(self):
        return (dispatch, rawptr(self))

// How many bytes are in use, alignment padding included. A test asserting an
// allocation count reads this rather than eyeballing a printout.
u64 used(Arena a):
    return a.used

// How many bytes are left: the capacity `over` kept, less `used`. A request
// needs this plus its alignment padding.
u64 available(Arena a):
    return a.cap - a.used

// Release every allocation in one store. **Lifetime-ending**: every
// reference into the arena is stale from this moment and using one is UB,
// exactly as using a pointer after `free` is. Nothing detects it, and a
// checker for it is the one gap worth closing for the programs that need
// it closed.
void reset(^Arena a):
    a^.used = 0
    a^.last = 0
    a^.last_size = 0
    return

// ── The procedure ────────────────────────────────────────────────────────────

private type ArenaPtr: ^Arena

private rawptr dispatch(rawptr data, mem.AllocatorMode mode, u64 nbytes, u64 align, rawptr old, u64 old_size):
    ArenaPtr a = ArenaPtr(data)
    if rawptr(a) == nil:
        return nil
    switch mode:
        case mem.AllocatorMode.Alloc:
            return carve(a, nbytes, align)
        case mem.AllocatorMode.Resize:
            return regrow(a, nbytes, align, old, old_size)
        case mem.AllocatorMode.Free:
            // An arena does not reclaim one block. The one thing it can do
            // cheaply is take back the **last** one, which is what makes a
            // scratch push/pop pair O(1) — and it is not done here, because a
            // `Free` that sometimes reclaims is worse than one that never
            // does: it makes "how much is in use" depend on allocation order.
            return nil
        case mem.AllocatorMode.FreeAll:
            reset(a)
            return nil
        else:
            return nil

// Align the cursor, hand back the block, advance. The whole allocator.
//
// The two tests are written as one subtraction rather than as `at + nbytes >
// cap`, because `at + nbytes` is a `u64` sum that can wrap and a wrapped sum
// compares small. `at <= cap` is what makes the second line safe.
private rawptr carve(ArenaPtr a, u64 nbytes, u64 align):
    // **The ceiling, stated rather than assumed.** `over` aligned this block's
    // base to `mem.MAX_ALIGN` and to nothing coarser, so aligning the cursor to
    // more than that produces an offset that is a multiple of `align` from a
    // base that is not — an address this allocator would be claiming is aligned
    // when it has no reason to think so. Refused, because `MAX_ALIGN` is
    // documented as what every shipped allocator hands out and an allocator
    // that quietly under-aligns is the worst of the three possible answers.
    //
    // It is a refusal and not a wider alignment on purpose: honouring an
    // arbitrary `align` means paying `align - 1` bytes of a block the caller
    // sized, and a 4096-byte arena losing 511 bytes to one request for
    // `align = 512` is a surprise nobody asked for. If a caller needs more, the
    // block is theirs to over-size and `over` is theirs to call.
    if align > mem.MAX_ALIGN:
        return nil
    if a^.block == nil:
        return nil
    u64 at = mem.align_up(a^.used, align)
    u64 span = spent(nbytes)
    if at > a^.cap || span > a^.cap - at:
        return nil
    rawptr out = a^.block + at
    mem.zero(out, nbytes)
    a^.last = at
    a^.last_size = nbytes
    a^.used = at + span
    return out

// `Resize`, with the in-place case that is the reason `Resize` is a mode
// rather than something the caller synthesizes.
//
// The block is the arena's last allocation exactly when its offset is `last`,
// and then growing it is moving the cursor: O(1), no copy, and the data did
// not move — which matters, because a reference that did not move
// leaves every pointer and slice into it valid.
private rawptr regrow(ArenaPtr a, u64 nbytes, u64 align, rawptr old, u64 old_size):
    if old == nil:
        return carve(a, nbytes, align)
    if a^.block != nil && old == a^.block + a^.last && old_size == a^.last_size:
        u64 at = a^.last
        u64 span = spent(nbytes)
        if at > a^.cap || span > a^.cap - at:
            return nil
        if nbytes > old_size:
            mem.zero(old + old_size, nbytes - old_size)
        a^.last_size = nbytes
        a^.used = at + span
        return old
    // Not on top of the arena, so there is nothing clever to do and the
    // library helper is what an allocator in that position calls instead.
    return mem.resize_by_copy((dispatch, rawptr(a)), old, old_size, nbytes, align)

// The bytes a block of `nbytes` takes off the cursor: a zero-size block takes
// one, so the next block is not at its address (`core:mem`'s zero-size rule).
private u64 spent(u64 nbytes):
    if nbytes == 0:
        return 1
    return nbytes
