@test
// A block's `clean` mark: an arena zeroes only the memory it has handed out
// and taken back, and trusts the zero its backing allocator gave for the
// rest. Two claims, and each needs the other to mean anything:
//
//   1. **A carve over bytes nothing has written does not zero them again.**
//      Checked from inside: a byte is planted above the mark, where the
//      arena believes the block is still the backing allocator's zero, and
//      a carve across it must leave it there. A carve that zeroed its whole
//      run, as this package once did, wipes it.
//   2. **A carve over bytes a release gave back does zero them.** After a
//      `reset`, an `end` and an in-place grow over written memory, every
//      byte handed out is zero again.
package arena

import "core:mem"
import "core:mem/libc"

private void fill(rawptr p, i64 n, u8 v):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<n]
    for i in 0..<n:
        span[i] = v
    return

private bool zeroed(rawptr p, i64 n):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<n]
    for i in 0..<n:
        if span[i] != 0:
            return false
    return true

private u8 byte_of(rawptr p, i64 i):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<i + 1]
    return span[i]

private void plant(rawptr p, i64 i, u8 v):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<i + 1]
    span[i] = v
    return

i32 test():
    bool ok = true
    Arena a = sized(libc.allocator(), 1024)
    defer destroy(&a)
    (mem.Proc proc, rawptr data) al = allocator(&a)

    rawptr p1 = al.proc(al.data, mem.AllocatorMode.Alloc, 64, 16, nil, 0)
    ok = #expect(p1 != nil && zeroed(p1, 64), "the first carve was not zero") && ok
    BlockPtr head = BlockPtr(a.head)
    ok = #expect(head^.clean == 64, "the clean mark after one carve was ", head^.clean) && ok

    // 1. A byte above the mark survives a carve across it.
    plant(head^.data, 100, 171)
    rawptr p2 = al.proc(al.data, mem.AllocatorMode.Alloc, 64, 16, nil, 0)
    ok = #expect(byte_of(p2, 36) == 171, "a carve zeroed bytes the backing allocator had zeroed") && ok
    plant(p2, 36, 0)
    ok = #expect(head^.clean == 128, "the clean mark after two carves was ", head^.clean) && ok

    // 2a. After a reset, the dirty bytes are zeroed and the mark stays put.
    fill(p1, 64, 255)
    fill(p2, 64, 255)
    reset(&a)
    rawptr p3 = al.proc(al.data, mem.AllocatorMode.Alloc, 128, 16, nil, 0)
    ok = #expect(p3 == p1, "the reset arena did not carve from the start") && ok
    ok = #expect(zeroed(p3, 128), "a carve over released bytes was not zeroed") && ok
    ok = #expect(head^.clean == 128, "a reset moved the clean mark to ", head^.clean) && ok

    // 2b. After an `end`, the same.
    Mark m = begin(&a)
    rawptr p4 = al.proc(al.data, mem.AllocatorMode.Alloc, 96, 16, nil, 0)
    fill(p4, 96, 255)
    end(m)
    rawptr p5 = al.proc(al.data, mem.AllocatorMode.Alloc, 96, 16, nil, 0)
    ok = #expect(p5 == p4 && zeroed(p5, 96), "a carve after end was not zeroed") && ok

    // 2c. An in-place grow over bytes a rewind gave back zeroes its tail.
    fill(p5, 96, 255)
    Mark m2 = begin(&a)
    rawptr p6 = al.proc(al.data, mem.AllocatorMode.Alloc, 32, 16, nil, 0)
    fill(p6, 32, 255)
    end(m2)
    rawptr small = al.proc(al.data, mem.AllocatorMode.Alloc, 8, 16, nil, 0)
    rawptr grown = al.proc(al.data, mem.AllocatorMode.Resize, 32, 16, small, 8)
    ok = #expect(grown == small && zeroed(grown, 32), "an in-place grow over released bytes was not zeroed") && ok

    if ok:
        return 0
    return 1
