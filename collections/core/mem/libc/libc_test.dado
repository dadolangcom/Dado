@test
// This package is the **reference implementation** of the allocator
// interface, and it is here to be the other half of a pair: `core:mem/bump`'s
// `FreeAll` is the whole reason to reach for that allocator, and this one's is
// **permanently unimplemented**. Two correct implementations of one mode that do
// opposite things is what makes the interface exercised rather than merely
// agreed with, and a suite that tested only one of them would have checked that
// the mode compiles.
//
// So the claims below are, in order of how much they are worth:
//
//   1. **`Alloc` zeroes.** Allocation always zeroes, because `i32 a` is zero
//      and a heap `T` that was not would make that rule turn on where the
//      storage came from. `malloc` does not zero, so this is a line of Dado that
//      can be deleted without any program failing to compile — the definition of
//      a thing that needs a test. It is claimed over a **recycled** block, which
//      is the only way to be sure the zeroes are the package's and not the
//      operating system's.
//   2. **`Resize` zeroes the tail it grew into.** `realloc` leaves it
//      uninitialised, and this package's `Resize` arm exists to fix that. Same
//      shape of claim, same reason.
//   3. **`FreeAll` answers `nil` and releases nothing** — the contrast, stated.
//
// *An allocation that fails is a value, not a trap* is **not** claimed
// here, and the section near the bottom of this file says why at length: the
// only way to make C's heap refuse on demand is to ask for more address space
// than exists, and at `-O1` and above the compiler elides the call and folds the
// null check. That arm is tested against `core:mem`'s own starvable allocator
// and against an exhausted `core:mem/bump` arena instead.
package libc

import "core:mem"

private void set_byte(rawptr p, i64 i, u8 v):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<i + 1]
    i64 last = #len(span) - 1
    span[last] = v
    return

private u8 byte_at(rawptr p, i64 i):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<i + 1]
    return span[i]

private void fill(rawptr p, i64 n, u8 v):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[0..<n]
    i64 zero = 0
    for i in zero..<#len(span):
        span[i] = v
    return

private bool zero_between(rawptr p, i64 from, i64 to):
    mem.Bytes b = mem.Bytes(p)
    []u8 span = b[from..<to]
    i64 zero = 0
    for i in zero..<#len(span):
        if span[i] != 0:
            return false
    return true

i32 test():
    bool ok = true

    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) a = allocator()
    ok = #expect(a.proc != nil, "libc.allocator() did not produce a usable allocator") && ok
    // The `data` is nil and stays nil — C's heap is its own state — and the
    // allocator is usable anyway, which is what `mem.ok` reading `proc` rather
    // than `data` is for.
    ok = #expect(a.data == nil, "libc.allocator() carried state it does not have") && ok
    // A value, not a singleton: two calls are two copies of the same two words,
    // and `alloc_id` interning is what makes that free on the compiler's
    // side of the boundary.
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) b = allocator()
    ok = #expect(b.proc == a.proc, "two libc.allocator() values held different procedures") && ok

    // ── Alloc ────────────────────────────────────────────────────────────────

    rawptr p = a.proc(a.data, mem.AllocatorMode.Alloc, 64, mem.MAX_ALIGN, nil, 0)
    ok = #expect(p != nil, "a 64-byte allocation from C's heap failed") && ok
    ok = #expect(zero_between(p, 0, 64), "a fresh allocation was not zeroed") && ok

    // **The recycled block.** A block returned to the allocator and asked for
    // again is very likely the same one, and it is dirty — `free` does not
    // scrub. So this is the claim that the zeroes above came from this package
    // and not from a page the operating system had just handed the process. A
    // `zeroed` deleted from `Alloc` survives the first claim and fails this one.
    fill(p, 64, 171)
    ok = #expect(byte_at(p, 0) == 171, "the block would not take a byte") && ok
    _ = a.proc(a.data, mem.AllocatorMode.Free, 0, 0, p, 64)

    rawptr recycled = a.proc(a.data, mem.AllocatorMode.Alloc, 64, mem.MAX_ALIGN, nil, 0)
    ok = #expect(recycled != nil, "the second 64-byte allocation failed") && ok
    ok = #expect(zero_between(recycled, 0, 64), "a recycled block was not zeroed: this allocator always zeroes") && ok

    // A one-byte allocation, which is the smallest a caller can ask for and the
    // boundary of the zeroing loop.
    rawptr one = a.proc(a.data, mem.AllocatorMode.Alloc, 1, 1, nil, 0)
    ok = #expect(one != nil, "a one-byte allocation failed") && ok
    ok = #expect(byte_at(one, 0) == 0, "a one-byte allocation was not zeroed") && ok
    _ = a.proc(a.data, mem.AllocatorMode.Free, 0, 0, one, 1)

    // ── Resize ───────────────────────────────────────────────────────────────
    //
    // `realloc` is the one thing an allocator can do that a caller cannot
    // synthesize — it grows a block **in place** when the heap has adjacent
    // space — which is why `Resize` is a mode rather than something the caller
    // writes out of `Alloc`/copy/`Free`. Whether it moved is the heap's
    // business and is deliberately not claimed here; what is claimed is what the
    // caller can actually rely on.
    fill(recycled, 64, 200)
    rawptr grown = a.proc(a.data, mem.AllocatorMode.Resize, 256, mem.MAX_ALIGN, recycled, 64)
    ok = #expect(grown != nil, "growing a block failed") && ok
    // The bytes survived, which is `realloc`'s own promise.
    ok = #expect(byte_at(grown, 0) == 200, "the grow lost the first byte") && ok
    ok = #expect(byte_at(grown, 63) == 200, "the grow lost the last byte") && ok
    // **And the tail is zeroed**, which is this package's promise and not
    // `realloc`'s: C leaves the grown tail uninitialised, and this does not.
    // 192 bytes of it, every one claimed.
    ok = #expect(zero_between(grown, 64, 256), "the grown tail was not zeroed: realloc does not, and this allocator does") && ok

    // Shrinking keeps the bytes that fit and zeroes nothing — `nbytes >
    // old_size` is false, so the zeroing arm is not taken, which is the branch
    // a shrink is here to reach.
    rawptr shrunk = a.proc(a.data, mem.AllocatorMode.Resize, 32, mem.MAX_ALIGN, grown, 256)
    ok = #expect(shrunk != nil, "shrinking a block failed") && ok
    ok = #expect(byte_at(shrunk, 0) == 200, "the shrink lost the first byte") && ok
    ok = #expect(byte_at(shrunk, 31) == 200, "the shrink lost the last byte it kept") && ok

    // A `Resize` of a nil block. `realloc(nil, n)` is `malloc(n)` in C99, so
    // the nil case needs no arm of its own — but the **zeroing** does, because
    // `old_size` is 0 and every byte of the result is therefore tail.
    rawptr from_nil = a.proc(a.data, mem.AllocatorMode.Resize, 128, mem.MAX_ALIGN, nil, 0)
    ok = #expect(from_nil != nil, "resizing from nil did not allocate") && ok
    ok = #expect(zero_between(from_nil, 0, 128), "a block grown from nil was not zeroed") && ok
    _ = a.proc(a.data, mem.AllocatorMode.Free, 0, 0, from_nil, 128)

    // ── Free ─────────────────────────────────────────────────────────────────
    //
    // It answers `nil`, like every mode that is not `Alloc` or `Resize`. And
    // `free(nil)` is a no-op in C99, so the guard a caller might expect to write
    // is one C already made — claimed because a `delete` on a nil reference goes
    // through here and must do nothing rather than crash.
    ok = #expect(a.proc(a.data, mem.AllocatorMode.Free, 0, 0, shrunk, 32) == nil, "Free returned something other than nil") && ok
    ok = #expect(a.proc(a.data, mem.AllocatorMode.Free, 0, 0, nil, 0) == nil, "Free of nil returned something other than nil") && ok

    // ── FreeAll — the contrast ───────────────────────────────────────────────
    //
    // Permanently unimplemented, and the header says so in as many words: C's
    // heap has no notion of "everything this allocator handed out", so there is
    // nothing to release. The interface drops `Query_Features` because trying
    // and getting `nil` answers the question a query would have asked — so this
    // `nil` **is** the API, and a later "implementation" of it would be a
    // behaviour change and not a fix.
    //
    // `core:mem/bump` answers the same call by resetting its cursor and making
    // every byte available again. Same mode, same signature, opposite outcomes,
    // both correct.
    rawptr live = a.proc(a.data, mem.AllocatorMode.Alloc, 64, mem.MAX_ALIGN, nil, 0)
    ok = #expect(live != nil, "the allocation before FreeAll failed") && ok
    fill(live, 64, 77)

    ok = #expect(a.proc(a.data, mem.AllocatorMode.FreeAll, 0, 0, nil, 0) == nil, "FreeAll returned something other than nil") && ok

    // Nothing was released, which is what "unimplemented" means here: the block
    // is still the caller's and still holds what was written to it. A `FreeAll`
    // that had quietly walked the heap would make this a read of freed memory.
    ok = #expect(byte_at(live, 0) == 77, "FreeAll disturbed a live block") && ok
    ok = #expect(byte_at(live, 63) == 77, "FreeAll disturbed a live block") && ok
    // And the caller still owns it — which is the other half of "released
    // nothing": the free below is the *first* one this block gets, and a
    // `FreeAll` that had freed it would make this a double free.
    _ = a.proc(a.data, mem.AllocatorMode.Free, 0, 0, live, 64)

    // ── what a failed allocation is, and why it is not claimed here ──────────
    //
    // The rule — **an allocation that fails is a value, not a trap** —
    // holds for this allocator too: `zeroed` passes a NULL `malloc` straight
    // through without touching a byte of it, and `Resize` has the matching `if
    // fresh == nil` guard. Neither is claimed in this file, and the reason is
    // worth writing down rather than leaving as a gap somebody rediscovers.
    //
    // The only way to make C's heap refuse without a machine actually running
    // out of memory is to ask for more address space than exists — 2⁶² bytes,
    // where the user half of a 64-bit map is 2⁴⁷ on x86-64 and 2⁵² on aarch64.
    // Written that way and compiled at `-O0` it works: `malloc` answers NULL and
    // the test sees `nil`. **At `-O1` and above it does not** — measured here
    // with clang, on this file's own emitted C: the compiler treats `malloc` as
    // an allocation function whose result is only null-checked, elides the call,
    // and folds the check to false. Same source, same libc, opposite answer,
    // decided by an optimizer flag.
    //
    // `./dado test` builds at `-O2` and `scripts/check.sh` runs the gate under
    // more than one C compiler, so a claim like that is a claim about the C
    // compiler's inlining policy wearing a standard library test's clothes. It
    // would go red on a toolchain change that broke nothing.
    //
    // The rule is real and is tested where it can be tested honestly: **`core:
    // mem`'s own test** drives `resize_by_copy` through an allocator with a
    // starvation switch, and **`core:mem/bump`'s** exhausts a real arena against
    // a block whose size it wrote. Between them that failure arm is
    // covered by allocators whose refusals are theirs to decide, which is the
    // only kind of refusal a test can ask for and be sure of getting.

    // What *can* be claimed here without asking the heap to fail: the tail
    // zeroing, over and over, against a block that keeps moving. Sixty-four
    // rounds, each growing by 16 bytes and each **dirtying the whole block
    // first**, so every round's claim is about bytes `realloc` really did leave
    // uninitialised rather than about a page that happened to arrive clean.
    //
    // `have` is the size the block actually is, and it starts at **0** — not at
    // `want`. That distinction is the entire claim: `Resize` only zeroes when
    // `nbytes > old_size`, so a caller who reports the wrong `old_size` is
    // telling the package there is no tail, and gets whatever the heap had. An
    // earlier draft of this loop passed `want` on the first round, when the
    // block did not exist yet, and it **passed under clang and failed under
    // gcc** — the first block malloc returned happened to be zeroed on one and
    // not the other. That is precisely the class of bug the gate's two-compiler
    // bar exists to catch, and it was caught here by that bar on this loop.
    rawptr churn = nil
    u64 have = 0
    for round in 0..<64:
        u64 want = have + 16
        churn = a.proc(a.data, mem.AllocatorMode.Resize, want, mem.MAX_ALIGN, churn, have)
        if churn == nil:
            ok = #expect(false, "the heap gave out on round ", round) && ok
        else:
            // The bytes the grow moved into, every round.
            ok = #expect(zero_between(churn, i64(have), i64(want)), "round ", round, " left an unzeroed tail") && ok
            // And the bytes that were already there survived it — the first one,
            // which is as far from the tail as the block goes.
            if have > 0:
                ok = #expect(byte_at(churn, 0) == 171, "round ", round, " lost the first byte") && ok
            // Dirty everything, so the next round's tail claim is a claim about
            // memory that is known not to be zero.
            fill(churn, i64(want), 171)
            have = want
    ok = #expect(churn != nil, "sixty-four rounds of resize left nothing") && ok
    ok = #expect(have == 1024, "the churned block ended at ", have, " bytes, not 1024") && ok
    _ = a.proc(a.data, mem.AllocatorMode.Free, 0, 0, churn, have)

    // Resize to ZERO returns a LIVE block, not nil.
    //
    // This is the arm that had no test, and its absence cost a use-after-free
    // that survived every gate in the tree: glibc's `realloc(p, 0)` frees `p`
    // and returns NULL, so an unclamped arm answers nil, `resize` reports
    // FAILURE, and the caller keeps a freed pointer whose length still reads as
    // whatever it was. Reproduced before the fix as an ASan `heap-use-after-free`
    // on the next read and a `double-free` on the caller's `delete`.
    //
    // The claim being asserted is NOT "zero is special" — it is that this
    // package agrees with the allocator the COMPILER emits, `dado_rt__heap`'s
    // `realloc(old, size ? (size_t)size : 1)` (`layout` (`dado_emit_c`)), which is
    // normative where a document is not. `core:mem/heap` clamps in
    // both its `make` and its `resize`; this package is the third of three and
    // was the one that did not.
    rawptr shrink = a.proc(a.data, mem.AllocatorMode.Alloc, 256, mem.MAX_ALIGN, nil, 0)
    ok = #expect(shrink != nil, "the heap would not give up 256 bytes to shrink") && ok
    if shrink != nil:
        fill(shrink, 256, 171)
        rawptr shrunk = a.proc(a.data, mem.AllocatorMode.Resize, 0, mem.MAX_ALIGN, shrink, 256)
        // The whole finding in one line: nil here is what a caller reads as
        // failure, and it is what leaves the caller's stale handle dangling.
        ok = #expect(shrunk != nil, "resize to 0 answered nil - the caller is left holding a freed pointer") && ok
        if shrunk != nil:
            // The block is live: writing through it is what an unclamped arm
            // cannot do.
            //
            // HOW THIS ONE ACTUALLY FAILS, because it is not what you would
            // guess and the first draft of this comment guessed wrong. Neutralise
            // the clamp and `c_test` does not reach a sanitizer at all — it stops
            // at `cc`, because gcc constant-folds `nbytes` to 0 through this arm
            // and `-Werror=array-bounds` rejects the subscript statically:
            // `array subscript 0 is outside array bounds of 'void[0]'`, and
            // `./dado test` reports `FAIL c_test (the C did not build)`.
            // The RUNTIME form of the same defect needs a caller the compiler
            // cannot fold — a `#resize(b, 0)` on a `ref []char8` in a separate
            // program, and there it
            // is an ASan `heap-use-after-free` on the next read and a
            // `double-free` on `delete`. Two failure modes, one bug; this file
            // catches the cheap one and the gate's swept programs catch the other.
            fill(shrunk, 1, 7)
            ok = #expect(byte_at(shrunk, 0) == 7, "the block resize(0) returned is not writable") && ok
            _ = a.proc(a.data, mem.AllocatorMode.Free, 0, 0, shrunk, 0)

    // An invariant rather than an expectation: the allocator this package hands
    // out must be usable, because it is what `#default` holds at depth
    // 0 on a hosted target. If it were not the *package* would be broken
    // for every hosted program at once and there would be nothing to carry on
    // for.
    #assert(allocator().proc != nil)

    ok = #expect(heap_cases(), "the C heap as an implementer of mem.Allocator") && ok

    if ok:
        return 0
    return 1

// ── the trait (a0.13b H13) ──────────────────────────────────────────────────
//
// C's heap as a `Heap`, which takes `mem.Allocator` on: `#new` through it, a
// `using` suite over it, a binder instantiated for it, and the `ref`'s two
// words handing the block back to `free`.

private type Pair: (i64 a, i64 b)

private i64 via(mem.Allocator al):
    ref Pair p = #new(Pair, al)
    p^.b = 11
    i64 got = p^.b
    #delete(p)
    return got

private bool heap_cases():
    bool ok = true
    Heap h
    ok = #expect(h.ok(), "the heap's implementer reported itself unusable") && ok
    ref Pair p = #new(Pair, h)
    p^.a = 2
    using h:
        ref Pair q = #new(Pair)
        ok = #expect(q^.a == 0, "an allocation under `using h` was not zeroed") && ok
        #delete(q)
    ok = #expect(via(h) == 11, "the binder's allocation did not hold") && ok
    ok = #expect(p^.a == 2, "the heap's block was disturbed") && ok
    // And as a `mem.Allocator` trait value, whose `data()` is dispatched.
    mem.Allocator tv = h
    ref Pair r = #new(Pair, tv)
    r^.b = 4
    ok = #expect(r^.b == 4, "an allocation through a trait value did not hold") && ok
    #delete(r)
    #delete(p)
    return ok
