@test
// What is actually claimed: reachable blocks survive a collection and
// unreachable ones do not. Everything else here is scaffolding for that.
//
// A chain is the case worth testing, because only its head is on the stack —
// every link past the first is reachable only through another block's contents,
// so a collector that scanned roots and stopped would free nine tenths of it
// and the sum would still typecheck.
package gc

import "core:mem"

type Node: (i64 value, ^Node next)

private ref Node chain(i32 n, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) a):
    ref Node head = #new(Node, a)
    ref Node at = head
    for i in i64(1)..<i64(n):
        ref Node next = #new(Node, a)
        next.value = i
        at.next = next
        at = next
    return head

private i64 walk(^Node from):
    i64 sum = 0
    ^Node at = from
    for at != nil:
        sum = sum + at.value
        at = at.next
    return sum

private void litter(i32 n, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) a):
    for i in i64(0)..<i64(n):
        ref []u8 junk = #make([]u8, 64, a)
        junk[0] = 1
    return

i32 test():
    bool ok = true

    Heap h
    init(&h)
    ok = #expect(live(&h) == 0, "a fresh heap held ", live(&h), " blocks") && ok
    ok = #expect(collections(&h) == 0, "a fresh heap had collected") && ok

    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) a = allocator(&h)
    // The implementer, as a `mem.Allocator` trait value: it keeps its
    // declaration (one slot, a pointer), and `data()` through the pair's
    // dispatch answers the same two words `allocator` does.
    HeapAllocator handle = &h
    mem.Allocator tv = handle
    ok = #expect(tv.ok() && tv.data().data == a.data, "the HeapAllocator trait value did not answer the allocator's words") && ok
    ok = #expect(a.proc != nil, "the collector's allocator has no procedure") && ok

    ref Node head = chain(10, a)
    ok = #expect(live(&h) == 10, "ten nodes left ", live(&h), " blocks") && ok
    ok = #expect(walk(head) == 45, "the chain summed ", walk(head)) && ok

    litter(50, a)
    ok = #expect(live(&h) == 60, "sixty blocks expected, found ", live(&h)) && ok

    // The claim, and note what it is not.
    //
    // **Reachability is asserted exactly; the free count is asserted loosely.**
    // Conservative collection promises no false negatives — everything
    // reachable survives — and promises nothing about false *positives*: a
    // stale word in a dead stack frame that still looks like an address pins
    // its block. Whether any given word survives is the C compiler's frame
    // layout, not this package's logic. Measured on the same source: gcc freed
    // all 50 junk blocks, clang freed 49 and took the last on the next pass.
    // An exact count here would be asserting the absence of false retention,
    // which is not a property a conservative collector has.
    i64 gone = collect(&h)
    ok = #expect(gone >= 45, "collected only ", gone, " of 50 junk blocks") && ok
    ok = #expect(live(&h) <= 15, "left ", live(&h), " blocks, more than conservatism explains") && ok
    ok = #expect(walk(head) == 45, "the chain summed ", walk(head), " after collection") && ok
    ok = #expect(collections(&h) == 1, "collections counted ", collections(&h)) && ok
    ok = #expect(freed(&h) == gone, "freed counted ", freed(&h), " against ", gone) && ok

    // A second pass frees at most the stragglers and never the chain — the
    // check that sweep left the table consistent rather than merely smaller.
    i64 again = collect(&h)
    ok = #expect(again <= 5, "a second collection freed ", again) && ok
    ok = #expect(live(&h) >= 10, "a second collection took part of the chain: ", live(&h)) && ok
    ok = #expect(walk(head) == 45, "the chain summed ", walk(head), " after two collections") && ok

    // `Free` is a no-op: the collector decides. `#delete` through this
    // allocator must not unmap anything — every block is still in the table —
    // and, like every `#delete` of a place, it leaves `head` nil, so the chain
    // is now garbage the next collection may take.
    i32 before_delete = live(&h)
    #delete(head)
    ok = #expect(live(&h) == before_delete, "delete freed a block; it must be a no-op here") && ok
    ok = #expect(head == nil, "delete left the place it was handed non-nil") && ok

    // `FreeAll` is a collection, reached through the interface rather than by
    // calling `collect` directly.
    litter(5, a)
    i32 before = live(&h)
    _ = a.proc(a.data, mem.AllocatorMode.FreeAll, 0, 0, nil, 0)
    ok = #expect(live(&h) < before, "FreeAll collected nothing: ", before, " -> ", live(&h)) && ok

    // Resize allocates and copies; the old block is left for the collector,
    // because a reference to it may still be on the stack.
    ref []u8 run = #make([]u8, 8, a)
    run[0] = 7
    ok = #expect(#resize(run, 32), "resize through the collector failed") && ok
    ok = #expect(run[0] == 7, "resize lost the bytes: ", run[0]) && ok
    ok = #expect(#len(run) == 32, "resize gave length ", #len(run)) && ok

    // A zero-byte request is a real call and must answer a usable block.
    ref []u8 nothing = #make([]u8, 0, a)
    ok = #expect(nothing != nil, "a zero-length allocation was nil") && ok

    if ok:
        return 0
    return 1
