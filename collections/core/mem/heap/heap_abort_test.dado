@test 134
// **This test passes if it exits 134.**
//
// A failed `assert` calls `abort`, and a process killed by `SIGABRT` reports
// 128 + 6 through a shell. Nothing else in the language can observe that a
// process died the way it was supposed to, so without this file the one thing
// `assert` does that `expect` does not is untestable — and this package's bounds
// contract is written entirely in `assert`s.
//
// That contract is worth a file of its own. `get`, `set`, `peek`, `pop`,
// `insert` and `remove` all assert their index, and the header says why: an
// out-of-bounds read is a bug, and an assertion (always on) turns it into a
// **named abort rather than silent corruption**. A `List` is three words over a
// `malloc`ed block with no bounds anywhere else in the language, so those
// assertions are the only thing standing between a typo and a wild write.
//
// One entry means one abort, so this file claims the boundary that matters
// most: **index `count`**, the first index past the live range. It is the
// off-by-one a caller actually writes — `for i in 0..count` instead of
// `0..<count` — and it is inside the allocated block, so without the assertion
// it would read a plausible-looking value and carry on.
//
// Two test files in one package, and they never coexist: exactly one is in any
// test compilation (rule 4), which is why this one may declare a `fresh` of its
// own alongside `heap_test.dado`'s.
package heap

import "core:fmt"

private List fresh(i32 cap0):
    i32 c = cap0
    if c < 1: c = 1
    rawptr raw = malloc(#c.size_t(#size(T) * u64(c)))
    return (Ptr(raw), 0, c)

i32 test():
    // A block with room for eight and two elements live, so index 2 is inside
    // the allocation and outside the live range. That is the whole point: a
    // bounds check that only caught reads past the *block* would let this one
    // through, and it would return whatever `malloc` had lying around.
    List v = fresh(8)
    _ = push(&v, 10)
    _ = push(&v, 20)

    #assert(count(v) == 2, "the list did not take two elements")
    #assert(capacity(v) == 8, "the block was not eight elements wide")

    // The reads that must work, so that the abort below is about the index and
    // not about the list being broken.
    #assert(get(v, 0) == 10, "get(0) was ", get(v, 0))
    #assert(get(v, 1) == 20, "get(1) was ", get(v, 1))

    // And the one that must not. `get` asserts `i < v.len`, and `v.len` is 2 —
    // so this aborts, the process dies of SIGABRT, and `@test 134` above is what
    // turns that into a pass.
    //
    // If the assertion in `get` were ever removed, this line would read the
    // third slot of a block that really does have eight, return an
    // uninitialised `i32`, and the test would exit 0 — which `@test 134` reports
    // as a failure. That is the direction that matters: the file fails when the
    // check disappears.
    i32 past_the_end = get(v, count(v))
    fmt.println("heap.get returned ", past_the_end, " for an index past the live range")
    return 0
