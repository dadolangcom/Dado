// core:mem/heap — a growable `List`, on the heap, by hand.
//
//     import "core:mem/heap"
//     heap.List v = heap.make(8)
//     heap.push(&v, 42)
//     println(heap.get(v, 0))
//     heap.delete(&v)
//
// ## DEPRECATED — use `ref []T` and the verbs
//
// **This package is retired by first-class references.** Everything
// it does, the five allocation verbs now do in the language:
//
//     heap.List v = heap.make(8)          ->   ref []T v = #make([]T, 8)
//     heap.resize(&v, 32)                 ->   #resize(v, 32)
//     heap.get(v, i) / heap.set(&v, i, x) ->   v[i]
//     heap.delete(&v)                     ->   #delete(v)
//     heap.count(v)                       ->   #len(v)
//
// and the verbs are better on three counts rather than one: they are **not
// monomorphic** — `T` below is one line you edit, `ref []T` is any `T`; they
// allocate from `#default`, so the same code works over an arena or C's
// heap; and a reference **carries its allocator**, so nothing has to remember
// which one frees what.
//
// It was kept and not deleted because `example/snake`, `blackjack` and `editor`
// were built on it and were the **heap regression corpus**: whatever happened
// here, they had to keep compiling and keep behaving identically. **That reason
// expired**, when `corpus/` replaced `example/` and took importing a
// collection with it — the three programs now write the list inline, and
// `heap_test.dado` is the only caller left in the tree. Its header states the
// position, and whether this package survives the v1.0 library freeze is now an
// open question rather than a settled one. It also still
// declares three names that are builtins now — `make`, `resize`, `delete` — and
// a *qualified* call reaches a public package function perfectly well,
// which is exactly the property that keeps them green.
//
// **Do not build anything new on it.** A reader looking for a growable sequence
// wants `#make([]T, n)`.
//
// ## What it was for
//
// The language it was written for had no allocator and no slices, so this builds the one
// container a program reaches for most — a resizable sequence — out of the only
// materials the language ships: three functions bound from C's `<stdlib.h>`, the
// `size` builtin, and the rule that `p^[i]` is "dereference, then index". There
// is **no pointer arithmetic** anywhere — Dado has none at all — and there is no
// helper `.c`. `example/snake` discovered the mechanism inline; this is that
// mechanism, named and reused — and `corpus/snake` writes it inline again, which
// is where to read it as a program rather than as a package.
//
// **It is monomorphic, and honestly so.** A `List` holds one element type, `T`,
// declared on one line below — because a shape cannot yet be passed as a type
// parameter (generics bind an *arity* or a *width* off a value, not an arbitrary
// element type; `shapeof` needs a place and cannot nest under `^` or `[]`). To
// hold a different element, copy this file and change `T`. **First-class
// references landed**, and `ref []T` is the supplanting the paragraph
// above predicted — the API shape did move over, which is why the mapping at the
// top of this file is a rename rather than a rewrite.
//
// **It is unmanaged**, and this is the paragraph the verbs answer. `make`
// allocates, `delete` frees, and nothing does it for
// you: a `List` you `make` and never `delete` leaks, and a `List` used after
// `delete` reads freed memory. That is the raw-pointer bargain stated
// as an API. In return, `get`/`set`/`push` are ordinary indexed access with no
// bounds cost beyond the assertions below, and the whole thing erases to a
// struct of three machine words.
package heap

// The heap, borrowed from C. A byte count is `u64` in Dado, which is why
// `size` returns `u64`, but the restatement says `#c.size_t`: the emitter
// asserts each restated signature's C type with `_Generic`, and `u64` is
// `uint64_t` — `size_t`'s own type on glibc and `unsigned long long` on
// Darwin, where `size_t` is `unsigned long`. The calls convert. These hand
// back a `rawptr` (`void *`), which converts to and from any `^T`,
// and that conversion is the whole trick.
private foreign "stdlib.h":
    rawptr malloc(#c.size_t nbytes)
    rawptr realloc(rawptr ptr, #c.size_t nbytes)
    void free(rawptr ptr)

// ── The element, and the one place it is named ───────────────────────────────
//
// `T` is the element type. This is the line you edit to specialise the `List`,
// and the reason the package is one type deep rather than generic — see the
// header. Everything below is written through `T` and `#size(T)`, so changing it
// here changes the whole container and nothing else moves.
type T: i32

// `CAP_MAX` is the ceiling the backing pointer is *typed* over — `^[CAP_MAX]T` —
// not the size of any allocation. A `List` only ever `malloc`s `cap` elements and
// only ever indexes below `len ≤ cap ≤ CAP_MAX`, so every `data^[i]` lands inside
// memory that was really allocated. The type is larger than the block on purpose:
// C lets an over-typed pointer address a shorter allocation (the flexible-array
// idiom), and 65 536 is the array-length bound, so this is as large as
// the ceiling can be.
const i32 CAP_MAX = 65536

private type Arr: [CAP_MAX]T
private type Ptr: ^Arr

// A `List` is three words: where the block is, how many elements are live, and
// how many it can hold before the next grow. It is a plain value — copying a
// `List` copies the three words and *aliases* the same block, exactly as copying
// a pointer does, so pass `^List` to any function that must resize or append.
type List: (Ptr data, i32 len, i32 cap)

// ── Lifetime ─────────────────────────────────────────────────────────────────

// Allocate a `List` with room for `cap0` elements (at least one). The block is
// uninitialised; `len` is zero. On allocation failure `data` is `nil` and `ok`
// returns false.
List make(i32 cap0):
    i32 c = cap0
    if c < 1: c = 1
    rawptr raw = malloc(#c.size_t(#size(T) * u64(c)))
    return (Ptr(raw), 0, c)

// Whether the last allocation succeeded — `malloc`/`realloc` returned non-null.
bool ok(List v):
    return rawptr(v.data) != nil

// Return the block to the allocator and leave the `List` empty. Idempotent only
// in the sense that a freed, zeroed `List` will not double-free — but a `List`
// must not be read after this, and must not be deleted twice.
void delete(^List v):
    free(rawptr(v^.data))
    v^.data = Ptr(nil)
    v^.len = 0
    v^.cap = 0
    return

// ── Size and capacity ────────────────────────────────────────────────────────

// How many elements are live. Not spelled `len`, because `len` is a global
// builtin and a package may not shadow one.
i32 count(List v):
    return v.len

i32 capacity(List v):
    return v.cap

bool is_empty(List v):
    return v.len == 0

// Bytes the backing block occupies right now — `cap` elements of `T`. Handy for
// a HUD, and the clearest one-liner that `#size(T)` is doing the arithmetic.
u64 bytes(List v):
    return #size(T) * u64(v.cap)

// Drop every element without freeing the block, so the capacity is kept for
// refilling. O(1): it only moves `len`.
void clear(^List v):
    v^.len = 0
    return

// Grow or shrink the backing block to hold exactly `ncap` elements, never below
// the live `len`. Returns whether the block moved. Use it to reserve ahead of a
// burst of `push`es, or to hand memory back after a `clear`.
bool resize(^List v, i32 ncap):
    i32 c = ncap
    if c < v^.len: c = v^.len
    if c < 1: c = 1
    if c > CAP_MAX: c = CAP_MAX
    if c == v^.cap:
        return false
    v^.data = Ptr(realloc(rawptr(v^.data), #c.size_t(#size(T) * u64(c))))
    v^.cap = c
    return true

// ── Access ───────────────────────────────────────────────────────────────────

// The element at `i`. Asserted in range — an out-of-bounds read is a bug, and an
// assertion — always on, never compiled out — turns it into a named abort rather than
// silent corruption.
T get(List v, i32 i):
    #assert(i >= 0 && i < v.len, "heap.get: index ", i, " out of 0..", v.len)
    return v.data^[i]

// Overwrite the element at `i`. Same bounds contract as `get`.
void set(^List v, i32 i, T x):
    #assert(i >= 0 && i < v^.len, "heap.set: index ", i, " out of 0..", v^.len)
    v^.data^[i] = x
    return

// The last element, without removing it. Precondition: not empty.
T peek(List v):
    #assert(v.len > 0, "heap.peek: empty list")
    return v.data^[v.len - 1]

// ── Stack ends ───────────────────────────────────────────────────────────────

// Append `x`, doubling the block with `realloc` when it is full. Returns whether
// the block was reallocated — a caller counting grows (or invalidating a cached
// pointer into the block) wants to know; most can ignore it.
bool push(^List v, T x):
    bool grew = false
    if v^.len >= v^.cap:
        i32 ncap = v^.cap * 2
        if ncap > CAP_MAX: ncap = CAP_MAX
        v^.data = Ptr(realloc(rawptr(v^.data), #c.size_t(#size(T) * u64(ncap))))
        v^.cap = ncap
        grew = true
    v^.data^[v^.len] = x
    v^.len = v^.len + 1
    return grew

// Remove and return the last element. Precondition: not empty. The block is not
// shrunk — capacity is kept for the next `push`; call `resize` to give it back.
T pop(^List v):
    #assert(v^.len > 0, "heap.pop: empty list")
    v^.len = v^.len - 1
    return v^.data^[v^.len]

// ── Middle ───────────────────────────────────────────────────────────────────

// Insert `x` at `i`, shifting the tail one to the right; `i` may equal `count`,
// which is an append. O(count − i) in the shift. Grows the block first if it is
// full, and returns whether that reallocated. This is what makes a `List` usable
// as a text buffer — a cursor is an index, and typing a character is `insert`.
bool insert(^List v, i32 i, T x):
    #assert(i >= 0 && i <= v^.len, "heap.insert: index ", i, " out of 0..", v^.len)
    bool grew = false
    if v^.len >= v^.cap:
        i32 ncap = v^.cap * 2
        if ncap > CAP_MAX: ncap = CAP_MAX
        v^.data = Ptr(realloc(rawptr(v^.data), #c.size_t(#size(T) * u64(ncap))))
        v^.cap = ncap
        grew = true
    i32 j = v^.len
    for j > i:
        v^.data^[j] = v^.data^[j - 1]
        j = j - 1
    v^.data^[i] = x
    v^.len = v^.len + 1
    return grew

// Remove and return the element at `i`, shifting the tail one to the left.
// O(count − i). The block is not shrunk. Deleting a character is `remove`.
T remove(^List v, i32 i):
    #assert(i >= 0 && i < v^.len, "heap.remove: index ", i, " out of 0..", v^.len)
    T out = v^.data^[i]
    i32 j = i
    for j < (v^.len - 1):
        v^.data^[j] = v^.data^[j + 1]
        j = j + 1
    v^.len = v^.len - 1
    return out
