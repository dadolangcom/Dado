@test
// This package is **deprecated** — `ref []T` and the five allocation
// verbs do everything it does, generically and with the allocator carried, and
// it is kept for one reason the header states plainly: `example/snake`,
// `blackjack` and `editor` are built on it and are the *heap regression
// corpus*, so whatever happens here they must keep compiling and keep behaving
// identically.
//
// **That corpus is gone.** `example/` was deleted when `corpus/` replaced it, and
// `corpus/` imports nothing outside its own directories by rule — so the three
// programs that were this package's regression test are not in the gate any
// more, and nothing else in it calls a line of this file. A deprecated package
// with no callers and no tests is a package that can rot silently and be
// discovered rotten by whoever is asked to migrate off it.
//
// So this file is the replacement for what the deletion took: the behaviours the
// three programs relied on, claimed directly. It is deliberately not an argument
// for keeping the package.
//
// The **growth** claims are the ones worth the most, because they are what a
// caller cannot see: `push` returns whether the block was reallocated, and a
// program holding a cached pointer into it reads that. The **assertion** claims
// live in `heap_abort_test.dado` beside this file, because an `assert` that fires
// kills the process and the only way to observe that is `@test <status>`.
package heap

// ── Two stand-ins, and why they are here ─────────────────────────────────────
//
// `make` and `delete` cannot be called from a file inside this package — see the
// long note in `test()` for the two diagnostics that box them in. These are
// transcriptions of their bodies, so the rest of the file has lists to work on.
//
// They are **scaffolding, not coverage**: nothing below them is a claim about
// `make` or `delete`, and if either grew a bug tomorrow this file would still be
// green. Named differently from the originals so that no reader mistakes one for
// the other.

private List fresh(i32 cap0):
    i32 c = cap0
    if c < 1: c = 1
    rawptr raw = malloc(#c.size_t(#size(T) * u64(c)))
    return (Ptr(raw), 0, c)

private void release(^List v):
    free(rawptr(v^.data))
    v^.data = Ptr(nil)
    v^.len = 0
    v^.cap = 0
    return

i32 test():
    // `all_ok` rather than `ok`, because this package declares a function called
    // `ok` and a local of that name would shadow it (ERR0405).
    bool all_ok = true

    // ── make ─────────────────────────────────────────────────────────────────
    //
    // The block is uninitialised and `len` is zero, which is the one place this
    // package predates the verbs — `make` here is `malloc`, and it
    // does not zero. Nothing below reads an element it did not write.
    List v = fresh(8)
    all_ok = #expect(ok(v), "fresh(8) did not allocate") && all_ok
    all_ok = #expect(count(v) == 0, "a fresh list had count ", count(v)) && all_ok
    all_ok = #expect(capacity(v) == 8, "a fresh list had capacity ", capacity(v)) && all_ok
    all_ok = #expect(is_empty(v), "a fresh list was not empty") && all_ok
    // `bytes` is `#size(T) * cap`, which is the clearest one-liner that `#size(T)`
    // is doing the arithmetic — and `T` is `i32`, so eight of them is 32 bytes.
    all_ok = #expect(bytes(v) == #size(T) * 8, "a fresh list occupied ", bytes(v), " bytes") && all_ok
    all_ok = #expect(#size(T) == 4, "T is not four bytes wide: ", #size(T)) && all_ok

    // **At least one**, which is the guard in `make` and the reason a zero or
    // negative capacity is not a zero-byte `malloc`.
    List one = fresh(0)
    all_ok = #expect(capacity(one) == 1, "fresh(0) gave capacity ", capacity(one)) && all_ok
    all_ok = #expect(ok(one), "fresh(0) did not allocate") && all_ok
    release(&one)

    List negative = fresh(0 - 5)
    all_ok = #expect(capacity(negative) == 1, "fresh(-5) gave capacity ", capacity(negative)) && all_ok
    release(&negative)

    all_ok = #expect(CAP_MAX == 65536, "CAP_MAX was ", CAP_MAX) && all_ok

    // ── push, and the grow it reports ────────────────────────────────────────
    //
    // `push` answers whether the block was **reallocated**, which a caller
    // holding a cached pointer into it has to know. Eight pushes fit; the ninth
    // is the one that grows, and it is the only one that answers `true`.
    for i in 0..<8:
        bool grew = push(&v, i * 10)
        all_ok = #expect(!grew, "push ", i, " grew a list with room to spare") && all_ok
    all_ok = #expect(count(v) == 8, "eight pushes left count at ", count(v)) && all_ok
    all_ok = #expect(capacity(v) == 8, "eight pushes changed the capacity to ", capacity(v)) && all_ok
    all_ok = #expect(!is_empty(v), "a list with eight elements was empty") && all_ok

    bool grew_on_nine = push(&v, 80)
    all_ok = #expect(grew_on_nine, "the ninth push did not report a grow") && all_ok
    all_ok = #expect(count(v) == 9, "the ninth push left count at ", count(v)) && all_ok
    // Doubling, which is what makes a run of pushes amortised O(1).
    all_ok = #expect(capacity(v) == 16, "the grow gave capacity ", capacity(v), ", not 16") && all_ok
    all_ok = #expect(ok(v), "the grow lost the block") && all_ok

    // **The grow kept every element.** This is the claim the `realloc` is for,
    // and it is checked across the boundary rather than at one index: element 0
    // is at the start of the old block and element 7 is at the end of it.
    for i in 0..<8:
        all_ok = #expect(get(v, i) == i * 10, "the grow moved element ", i, " to ", get(v, i)) && all_ok
    all_ok = #expect(get(v, 8) == 80, "the element that caused the grow was ", get(v, 8)) && all_ok

    // ── get, set, peek ───────────────────────────────────────────────────────
    //
    // The ends of the live range, which are the two indices the assertions in
    // `get` and `set` bracket. Index `count` is out of range and lives in
    // `heap_abort_test.dado`.
    all_ok = #expect(get(v, 0) == 0, "get(0) was ", get(v, 0)) && all_ok
    all_ok = #expect(get(v, count(v) - 1) == 80, "get(last) was ", get(v, count(v) - 1)) && all_ok
    all_ok = #expect(peek(v) == get(v, count(v) - 1), "peek disagreed with get(last)") && all_ok

    set(&v, 0, 99)
    all_ok = #expect(get(v, 0) == 99, "set(0) did not take: ", get(v, 0)) && all_ok
    set(&v, count(v) - 1, 77)
    all_ok = #expect(peek(v) == 77, "set(last) did not take: ", peek(v)) && all_ok
    // `set` moves nothing else, which a shift-by-one in the addressing would
    // break and a single-index claim would not notice.
    all_ok = #expect(get(v, 1) == 10, "set(0) disturbed element 1: ", get(v, 1)) && all_ok

    // ── pop ──────────────────────────────────────────────────────────────────
    //
    // Removes and returns the last, and **does not shrink the block** —
    // capacity is kept for the next push, which is stated in the header and is
    // the difference between a stack and a container that thrashes.
    i32 cap_before_pop = capacity(v)
    T popped = pop(&v)
    all_ok = #expect(popped == 77, "pop returned ", popped) && all_ok
    all_ok = #expect(count(v) == 8, "pop left count at ", count(v)) && all_ok
    all_ok = #expect(capacity(v) == cap_before_pop, "pop shrank the block to ", capacity(v)) && all_ok
    all_ok = #expect(peek(v) == 70, "pop left the wrong element on top: ", peek(v)) && all_ok

    // push then pop is the identity on the contents, which is the property that
    // makes it a stack.
    _ = push(&v, 12345)
    all_ok = #expect(pop(&v) == 12345, "push then pop did not return what was pushed") && all_ok
    all_ok = #expect(count(v) == 8, "push then pop changed the count to ", count(v)) && all_ok

    // ── insert ───────────────────────────────────────────────────────────────
    //
    // At 0, in the middle, and at `count` — the three positions, and the last is
    // an append, which is what makes `i <= len` the bound rather than `i < len`.
    // This is what makes a `List` usable as a text buffer: a cursor is an index
    // and typing a character is `insert`.
    List b = fresh(4)
    _ = push(&b, 1)
    _ = push(&b, 2)
    _ = push(&b, 3)

    _ = insert(&b, 0, 0)
    all_ok = #expect(count(b) == 4, "insert at 0 left count at ", count(b)) && all_ok
    all_ok = #expect(get(b, 0) == 0, "insert at 0 put ", get(b, 0), " there") && all_ok
    all_ok = #expect(get(b, 1) == 1, "insert at 0 did not shift: ", get(b, 1)) && all_ok
    all_ok = #expect(get(b, 3) == 3, "insert at 0 lost the tail: ", get(b, 3)) && all_ok

    _ = insert(&b, 2, 99)
    all_ok = #expect(get(b, 2) == 99, "insert in the middle put ", get(b, 2), " there") && all_ok
    all_ok = #expect(get(b, 1) == 1, "insert in the middle disturbed the head") && all_ok
    all_ok = #expect(get(b, 3) == 2, "insert in the middle did not shift: ", get(b, 3)) && all_ok
    all_ok = #expect(count(b) == 5, "insert in the middle left count at ", count(b)) && all_ok

    // **At `count`**, which is the append and the boundary of the assertion.
    _ = insert(&b, count(b), 500)
    all_ok = #expect(count(b) == 6, "insert at count left count at ", count(b)) && all_ok
    all_ok = #expect(peek(b) == 500, "insert at count did not append: ", peek(b)) && all_ok

    // An insert into a full list grows first and says so.
    List full = fresh(1)
    _ = push(&full, 1)
    bool insert_grew = insert(&full, 0, 0)
    all_ok = #expect(insert_grew, "insert into a full list did not report a grow") && all_ok
    all_ok = #expect(capacity(full) == 2, "the insert's grow gave capacity ", capacity(full)) && all_ok
    all_ok = #expect(get(full, 0) == 0 && get(full, 1) == 1, "the insert's grow lost the order") && all_ok
    release(&full)

    // ── remove ───────────────────────────────────────────────────────────────
    //
    // The three positions again, and the returned element is the one that was
    // there. `b` is (0, 1, 99, 2, 3, 500).
    T gone = remove(&b, 0)
    all_ok = #expect(gone == 0, "remove(0) returned ", gone) && all_ok
    all_ok = #expect(count(b) == 5, "remove(0) left count at ", count(b)) && all_ok
    all_ok = #expect(get(b, 0) == 1, "remove(0) did not shift: ", get(b, 0)) && all_ok

    // (1, 99, 2, 3, 500) — remove the middle.
    T middle = remove(&b, 1)
    all_ok = #expect(middle == 99, "remove(1) returned ", middle) && all_ok
    all_ok = #expect(get(b, 1) == 2, "remove in the middle did not shift: ", get(b, 1)) && all_ok
    all_ok = #expect(count(b) == 4, "remove in the middle left count at ", count(b)) && all_ok

    // (1, 2, 3, 500) — remove the last, which is the arm where the shift loop
    // runs zero times.
    T last = remove(&b, count(b) - 1)
    all_ok = #expect(last == 500, "remove(last) returned ", last) && all_ok
    all_ok = #expect(count(b) == 3, "remove(last) left count at ", count(b)) && all_ok
    all_ok = #expect(peek(b) == 3, "remove(last) left the wrong element on top: ", peek(b)) && all_ok

    // ── clear ────────────────────────────────────────────────────────────────
    //
    // O(1), and it keeps the capacity — which is the whole reason it is not
    // `delete` followed by `make`.
    i32 cap_before_clear = capacity(b)
    clear(&b)
    all_ok = #expect(count(b) == 0, "clear left count at ", count(b)) && all_ok
    all_ok = #expect(is_empty(b), "a cleared list was not empty") && all_ok
    all_ok = #expect(capacity(b) == cap_before_clear, "clear gave back the block: capacity ", capacity(b)) && all_ok
    all_ok = #expect(ok(b), "clear released the block") && all_ok
    // And it refills without asking for anything.
    _ = push(&b, 7)
    all_ok = #expect(get(b, 0) == 7, "a cleared list would not take an element") && all_ok

    // ── the three functions this file cannot reach ───────────────────────────
    //
    // **`make`, `resize` and `delete` are not callable from here**, and the gap
    // is worth stating exactly rather than leaving as an absence somebody
    // rediscovers.
    //
    // **The reason changed, the gap did not — and it closes on its own one
    // milestone from now.** What follows is the old reason and the
    // new one, because the difference is worth having written down.
    //
    // It used to be the reservation: a call resolves to a **global
    // builtin before any scope**, which is what makes a builtin's name
    // reachable from every file with no import; this package declares three
    // functions whose names were builtins, so `make(8)` here was ERR0414
    // (*"this reads as the global builtin `make` and not as the `make` in
    // scope … write `heap.make(…)` here, or rename it"*) while `heap.make(8)`
    // was ERR0408, because a package cannot import or qualify **itself** and
    // a test file lives *inside* the package on purpose. Two
    // rules each right, and their intersection empty.
    //
    // **Both diagnostics are gone.** `make` is not a name the compiler owns any
    // more — every surviving builtin is spelled `#make` — so ERR0414 has
    // nothing to say here, and the second raise that produced that exact
    // sentence was deleted when a qualified call was allowed to reach a
    // package function. What `make(8)` gets today is **ERR0805**: the spelling is
    // *retired*, and the message names `#make`. Measured, not assumed.
    //
    // That is a different gap and a temporary one. The twelve retirement rows
    // stand for one milestone past the sweep so that a tree written the old way
    // is told what to write instead; when they go, a bare `make` stops being
    // recognised at all and resolves the ordinary way — to **this package's own
    // `make`**, from inside the package, with no qualification. Measured by
    // deleting `target::called_builtin`'s bare arm and compiling a probe here:
    // `List v = make(8)` resolved to `heap.make` and raised nothing. So the
    // three functions become reachable from this file by doing nothing, and
    // whoever writes the tests then owes `make`'s two clamps, `resize`'s four
    // and `delete`'s zeroing — listed below, which is why the list is kept.
    //
    // What that costs, precisely: `make`'s two clamps (`cap0 < 1`, and the
    // `malloc` that can fail), `resize`'s four (`c == cap` → no call, `c < len`,
    // `c < 1`, `c > CAP_MAX`), and `delete`'s zeroing of the three words. The
    // `fresh` and `release` helpers at the top of this file are transcriptions
    // of two of them, which is what lets everything else here be tested — and a
    // transcription is **not** a test of the original: if `make` grew a bug
    // tomorrow, this file would still be green.
    //
    // `push` and `insert` reallocate with their own inline `realloc` rather than
    // by calling `resize`, so the growth claims above are claims about this
    // package's real code and not about the stand-in.
    //
    // The fix is not this file's to make and is no longer needed: renaming the
    // trio would have been a source-breaking change to a **deprecated**
    // package, and the alternative — letting a package qualify itself — was a
    // language decision nobody had to take, because the sigil answered the
    // question from the other end. Recorded here so whoever picks the tests up
    // knows what was in the way and that it is not any more.

    // What the stand-in *can* still say: `bytes` and `capacity` agree after a
    // hand-built list of a written size, which is the arithmetic `#size(T)` does.
    List r = fresh(32)
    all_ok = #expect(capacity(r) == 32, "the stand-in gave capacity ", capacity(r)) && all_ok
    all_ok = #expect(bytes(r) == #size(T) * 32, "a 32-element list occupied ", bytes(r), " bytes") && all_ok
    all_ok = #expect(count(r) == 0, "the stand-in gave count ", count(r)) && all_ok
    release(&r)

    // ── the released list ────────────────────────────────────────────────────
    //
    // `release` is the test file's transcription of `delete`, so what is claimed
    // here is the *shape* the header promises — an emptied, zeroed `List` whose
    // second release is a `free(nil)` rather than a double free — and not the
    // body of `delete` itself, which is unreachable from this file.
    release(&v)
    all_ok = #expect(!ok(v), "releasing left a usable list") && all_ok
    all_ok = #expect(count(v) == 0, "releasing left count at ", count(v)) && all_ok
    all_ok = #expect(capacity(v) == 0, "releasing left capacity at ", capacity(v)) && all_ok
    all_ok = #expect(is_empty(v), "a released list was not empty") && all_ok
    all_ok = #expect(bytes(v) == 0, "a released list occupied ", bytes(v), " bytes") && all_ok

    release(&v)
    all_ok = #expect(!ok(v), "the second release disturbed the list") && all_ok

    release(&b)

    // An invariant rather than an expectation: a `List`'s live length can never
    // exceed its capacity, because every element is addressed through the block
    // the capacity describes. If it could, the *package* would be reading past
    // an allocation and there would be nothing to carry on for.
    List inv = fresh(2)
    for i in 0..<20:
        _ = push(&inv, i)
        #assert(count(inv) <= capacity(inv), "count ", count(inv), " exceeded capacity ", capacity(inv))
    #assert(capacity(inv) <= CAP_MAX)
    release(&inv)

    if all_ok:
        return 0
    return 1
