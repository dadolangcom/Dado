@test
// A `StreamSink` over a file: one line per record at its minimum or above,
// in the file, read back, and a stream sink over no stream drops what it is
// handed. Not on the web, which opens no file yet.
package log

import "core:io"
import "core:os"
import "core:os/fs"

i32 test():
    bool ok = true
    when #OS != #WEB:
        ok = to_a_file() && ok
    return 0 if ok else 1

when #OS == #WINDOWS:
    private const cstring LOG_PATH = "dado_core_log_test.log"
else:
    private const cstring LOG_PATH = "/tmp/dado_core_log_test.log"

private bool to_a_file():
    bool ok = true
    try ^io.FILE f = io.open_write(string8(LOG_PATH)) else why:
        return #expect(false, "the log file did not open: ", os.message(why))
    StreamSink file = (f, Level.Info)
    Record a = record(Level.Info, "db", "open")
    Record low = record(Level.Debug, "db", "below the minimum")
    Record b = record(Level.Error, "", "gone")
    file.take(&a)
    file.take(&low)
    file.take(&b)
    // A stream sink over no stream drops what it is handed.
    StreamSink none
    none.take(&a)
    _ = io.close(f)
    try ^io.FILE r = io.open_read(string8(LOG_PATH)) else why2:
        return #expect(false, "the log file did not reopen: ", os.message(why2))
    [64]char8 back
    i64 n = io.read_bytes(r, back[0..<64])
    _ = io.close(r)
    ok = #expect(string8(back[0..<n]) == "INFO [db] open\nERROR gone\n", "the log file held ", string8(back[0..<n])) && ok
    try fs.remove_file(string8(LOG_PATH)) else why3:
        ok = #expect(false, "the log file did not delete: ", os.message(why3)) && ok
    return ok
