// core:log — levels, a fixed-shape log record, and pluggable sinks.
//
//     import "core:log"
//
//     log.Record r = log.record(log.Level.Warn, "net", "retrying connect")
//     log.emit(log.stdout_sink(), &r)
//
// This is the mechanism — mechanism down, opinion up: it knows
// nothing about workers, frames, or a barrier — that scheduling is
// `app:log`'s job. What lives here is the shape every sink agrees
// on and the one sink every program gets free.
//
// **No allocation, ever.** `Tag` and `Msg` are fixed inline buffers, the
// same idiom `app:ui`'s `Span` uses for names and captions: a `Record` can
// sit in a caller's array — `app:log`'s per-worker ring, in particular —
// with no heap involved and nothing to `delete`. The cost is the cap: a tag
// or message longer than its buffer is silently truncated, same stance
// `core:strings.substring` and friends take rather than failing a log call.
//
// **No timestamp.** `core:time` is a separate dependency this package does
// not need for its own sake; a sink that wants one reads the clock itself
// when a record reaches it. Keeping `Record` fixed-shape and dependency-thin
// is worth more than saving every sink the two extra lines.
package log

import "core:strings"
import "core:io"

// Ascending severity — a plain (non-`distinct`) `i32`-backed enum, so
// `r.level >= Level.Warn` orders directly: no comparison helper
// needed for a sink that wants a minimum-level filter.
enum i32 Level: (Trace, Debug, Info, Warn, Error)

// `lvl`'s fixed display name. Returns `cstring` and not `string` — every
// arm is a literal, so the boundary a dynamic `string` would need
// (`clone_to_cstring` + a copy) never exists; a sink writes it straight to
// a stream with no allocation.
cstring level_name(Level lvl):
    if lvl == Level.Trace:
        return "TRACE"
    if lvl == Level.Debug:
        return "DEBUG"
    if lvl == Level.Info:
        return "INFO"
    if lvl == Level.Warn:
        return "WARN"
    return "ERROR"

// ── fixed inline buffers (no allocation) ────────────────────────────────

const i32 TAG_CAP = 24     // a subsystem/scope name: "net", "jobs.worker3"
const i32 MSG_CAP  = 160   // one line's worth; a sink joins/wraps, this doesn't

type Tag: [TAG_CAP]char8
type Msg: [MSG_CAP]char8

(Tag t, i32 n) tag_of(string8 s):
    Tag t
    i32 n = TAG_CAP
    if #len(s) < TAG_CAP:
        n = i32(#len(s))
    for i in 0..<n:
        t[i] = s[i]
    return (t, n)

// Read the first `n` bytes of a `Tag` back as a string (a window, no copy;
// mirrors `app:ui.span_str`).
string8 tag_str(^Tag t, i32 n):
    i32 m = n
    if m < 0:
        m = 0
    if m > TAG_CAP:
        m = TAG_CAP
    return string8(t^[0..<m])

(Msg m, i32 n) msg_of(string8 s):
    Msg m
    i32 n = MSG_CAP
    if #len(s) < MSG_CAP:
        n = i32(#len(s))
    for i in 0..<n:
        m[i] = s[i]
    return (m, n)

string8 msg_str(^Msg m, i32 n):
    i32 k = n
    if k < 0:
        k = 0
    if k > MSG_CAP:
        k = MSG_CAP
    return string8(m^[0..<k])

// ── the record ───────────────────────────────────────────────────────────

// One logged fact. Fixed shape, no allocation — see the package doc comment.
type Record: (
    Level level,
    Tag   tag,
    i32   tag_len,
    Msg   message,
    i32   msg_len,
)

Record record(Level lvl, string8 tag, string8 msg):
    (Tag t, i32 tn) = tag_of(tag)
    (Msg m, i32 mn) = msg_of(msg)
    return (lvl, t, tn, m, mn)

// ── sinks ────────────────────────────────────────────────────────────────
//
// The C-classic function + opaque data pair — Dado has no closures —
// the same shape `core:jobs.JobFn`/`app:app.Backend` already use for exactly
// this reason. `data` is nil for a sink with no state of its own, like
// `stdout_sink` below.
type SinkFn: void(^Record, rawptr)

type Sink: (SinkFn fn, rawptr data)

void emit(Sink sink, ^Record r):
    if sink.fn != nil:
        sink.fn(r, sink.data)

// `string ⇄ []char8` is free, but only reachable through a named alias —
// `[]T` is not a callable spelling. Used to hand a `Tag`/`Msg` window to
// `io.write_bytes`, which wants `[]char8` and not `string`.
private type Bytes: []char8

// "LEVEL [tag] message\n" to `out`.
private void write_line(^io.FILE out, ^Record r):
    io.write(out, level_name(r.level))
    io.write(out, " ")
    string8 tag = tag_str(&r.tag, r.tag_len)
    if !strings.is_empty(tag):
        io.write(out, "[")
        io.write_bytes(out, Bytes(tag))
        io.write(out, "] ")
    io.write_bytes(out, Bytes(msg_str(&r.message, r.msg_len)))
    io.write(out, "\n")

private void stdout_fn(^Record r, rawptr _data):
    write_line(io.stdout(), r)

// The one sink every program gets with no setup: a line per record on
// `io.stdout()`. Stateless (`data` is nil), so one value serves every call.
Sink stdout_sink():
    return (stdout_fn, nil)
