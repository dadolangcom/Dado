@test
// `write_line`/`stdout_sink` reach `core:io`, which is already
// tested elsewhere (`core:io`'s own suite), so what's claimed here is this
// package's own judgement:
//
//   * **`level_label`** answers all five levels, and the ordering `Level`
//     being a plain `i32`-backed enum promises (`Level.Warn > Level.Info`).
//   * **`tag_of`/`msg_of`'s truncation boundary** — a tag/message that fits
//     exactly, and one one byte over the cap, which is the input a
//     `<=`-that-should-be-`<` gets wrong.
//   * **a `Sink` value dispatches to its implementer** — the implementer's
//     own `take` is called with the record, and writes through `^self` reach
//     the implementer the value views, not a copy; `Filter` and `Fanout` are
//     sinks that hold sinks, and `discard()` takes a record and does nothing.
package log


private i32 g_calls
private Level g_last_level
private string8 g_last_tag
private string8 g_last_msg
private i32 g_last_id
// A copy of the last record: `tag_str` and `msg_str` answer windows into the
// record they read, and `write` hands the sink one on its own frame.
private Record g_last

// A sink that counts what reaches it, keeps the last record, and says which
// probe it was. `seen` is its own count, written through `^self`, so a
// dispatch that reached a copy would leave the probe's at zero. Two widths,
// not two `i32`s: a dispatch to an implementer whose slots are all one type
// (and so the same shape as an array of it) emits C that does not build.
private type Probe using Sink:
    i32 id
    i64 seen
    void take(^self, ^Record r):
        self.seen = self.seen + 1
        g_calls = g_calls + 1
        g_last = r^
        g_last_level = g_last.level
        g_last_tag = tag_str(&g_last.tag, g_last.tag_len)
        g_last_msg = msg_str(&g_last.message, g_last.msg_len)
        g_last_id = self.id

private Probe g_probe = (7, 0)
private Probe g_probe2 = (2, 0)
private Filter g_errors
private Fanout g_fan

i32 test():
    bool ok = true

    // ── level_label, and the ordering a plain enum gives for free ─────────

    ok = #expect(level_label(Level.Trace) == "TRACE", "level_label(Trace)") && ok
    ok = #expect(level_label(Level.Debug) == "DEBUG", "level_label(Debug)") && ok
    ok = #expect(level_label(Level.Info) == "INFO", "level_label(Info)") && ok
    ok = #expect(level_label(Level.Warn) == "WARN", "level_label(Warn)") && ok
    ok = #expect(level_label(Level.Error) == "ERROR", "level_label(Error)") && ok
    ok = #expect(level_label(Level(9)) == "ERROR", "a level outside the five is not ERROR") && ok
    ok = #expect(Level.Error > Level.Warn, "Error should outrank Warn") && ok
    ok = #expect(Level.Warn > Level.Info, "Warn should outrank Info") && ok
    ok = #expect(Level.Trace < Level.Debug, "Trace should be the lowest") && ok

    // ── tag_of / msg_of: exact fit and one byte over ───────────────────────

    string8 exact_tag = "abcdefghijklmnopqrstuvwx"  // exactly TAG_CAP (24) bytes
    ok = #expect(#len(exact_tag) == TAG_CAP, "fixture: exact_tag is not TAG_CAP bytes") && ok
    (Tag t1, i32 tn1) = tag_of(exact_tag)
    ok = #expect(tn1 == TAG_CAP, "tag_of at exactly TAG_CAP truncated: ", tn1) && ok
    ok = #expect(tag_str(&t1, tn1) == exact_tag, "tag_of at exactly TAG_CAP changed the bytes") && ok

    string8 over_tag = "abcdefghijklmnopqrstuvwxy"  // TAG_CAP + 1 bytes
    ok = #expect(#len(over_tag) == TAG_CAP + 1, "fixture: over_tag is not TAG_CAP+1 bytes") && ok
    (Tag t2, i32 tn2) = tag_of(over_tag)
    ok = #expect(tn2 == TAG_CAP, "tag_of one byte over TAG_CAP did not clamp: ", tn2) && ok
    ok = #expect(tag_str(&t2, tn2) == exact_tag, "tag_of one byte over TAG_CAP kept the wrong prefix") && ok

    (Tag t3, i32 tn3) = tag_of("")
    ok = #expect(tn3 == 0, "tag_of(\"\") was ", tn3) && ok
    ok = #expect(tag_str(&t3, tn3) == "", "tag_str of an empty tag was not empty") && ok

    string8 msg_short = "the quick brown fox jumps over the lazy dog"
    i64 msg_short_len = #len(msg_short)
    ok = #expect(msg_short_len < MSG_CAP, "fixture: msg_short does not fit under MSG_CAP") && ok
    (Msg m1, i32 mn1) = msg_of(msg_short)
    ok = #expect(mn1 == msg_short_len, "msg_of of a short message truncated: ", mn1) && ok
    ok = #expect(msg_str(&m1, mn1) == msg_short, "msg_of round-trip changed the bytes") && ok

    // ── record() composes both ─────────────────────────────────────────────

    Record r = record(Level.Warn, "net", "retrying connect")
    ok = #expect(r.level == Level.Warn, "record().level was wrong") && ok
    ok = #expect(tag_str(&r.tag, r.tag_len) == "net", "record().tag was ", tag_str(&r.tag, r.tag_len)) && ok
    ok = #expect(msg_str(&r.message, r.msg_len) == "retrying connect", "record().message was ", msg_str(&r.message, r.msg_len)) && ok

    // ── a Sink dispatches to the implementer it views ──────────────────────

    Sink probe = g_probe
    probe.take(&r)
    ok = #expect(g_calls == 1, "take did not reach the sink exactly once") && ok
    ok = #expect(g_probe.seen == 1, "take wrote a copy, not the probe the value views") && ok
    ok = #expect(g_last_id == 7, "take reached the wrong implementer: ", g_last_id) && ok
    ok = #expect(g_last_level == Level.Warn, "take passed the wrong level") && ok
    ok = #expect(g_last_tag == "net", "take passed the wrong tag: ", g_last_tag) && ok
    ok = #expect(g_last_msg == "retrying connect", "take passed the wrong message: ", g_last_msg) && ok

    // `discard` takes a record and does nothing with it.
    discard().take(&r)
    ok = #expect(g_calls == 1, "discard() called something") && ok

    // stdout_sink() doesn't crash. Its actual output isn't captured here —
    // core:io's own suite covers the stream primitives underneath it.
    stdout_sink().take(&r)

    ok = cut_messages() && ok
    ok = lines() && ok
    ok = composed(&r) && ok
    ok = defaults() && ok

    if ok:
        return 0
    return 1

// ── a long message is cut, and says so ──────────────────────────────────────
//
// Exactly `MSG_CAP` bytes fit whole; one more and the record keeps whole
// characters and ends in `...`, never splitting a multi-byte character.
private bool cut_messages():
    bool ok = true
    [200]char8 long_bytes
    for i in 0..<200:
        long_bytes[i] = 'a'
    string8 exact = string8(long_bytes[0..<MSG_CAP])
    (Msg m1, i32 n1) = msg_of(exact)
    ok = #expect(n1 == MSG_CAP && msg_str(&m1, n1) == exact, "a message of exactly MSG_CAP was changed") && ok

    string8 over = string8(long_bytes[0..<MSG_CAP + 1])
    (Msg m2, i32 n2) = msg_of(over)
    string8 cut = msg_str(&m2, n2)
    ok = #expect(n2 == MSG_CAP && cut[MSG_CAP - 1] == '.' && cut[MSG_CAP - 3] == '.' && cut[MSG_CAP - 4] == 'a', "a message one byte over was not cut to ...: ", cut) && ok

    // `é` is two bytes. Put one so it straddles the cut: its lead byte at
    // MSG_CAP - 4 and its continuation at MSG_CAP - 3, where the `...` starts.
    long_bytes[MSG_CAP - 4] = char8(0xC3)
    long_bytes[MSG_CAP - 3] = char8(0xA9)
    (Msg m3, i32 n3) = msg_of(string8(long_bytes[0..<200]))
    string8 cut3 = msg_str(&m3, n3)
    ok = #expect(n3 == MSG_CAP - 1 && cut3[MSG_CAP - 5] == 'a' && cut3[MSG_CAP - 4] == '.', "a cut split a character: ", n3, " bytes") && ok
    return ok

// ── put_line ────────────────────────────────────────────────────────────────
private bool lines():
    bool ok = true
    [LINE_MAX]char8 room
    Record tagged = record(Level.Warn, "net", "retrying connect")
    i64 n = put_line(&tagged, room[0..<LINE_MAX])
    ok = #expect(string8(room[0..<n]) == "WARN [net] retrying connect\n", "the tagged line was ", string8(room[0..<n])) && ok
    Record bare = record(Level.Info, "", "up")
    n = put_line(&bare, room[0..<LINE_MAX])
    ok = #expect(string8(room[0..<n]) == "INFO up\n", "the untagged line was ", string8(room[0..<n])) && ok
    n = put_line(&tagged, room[0..<4])
    ok = #expect(n == 4 && string8(room[0..<4]) == "WARN", "a short buffer did not cut the line at its end") && ok
    ok = #expect(level_label(Level.Debug) == "DEBUG" && level_label(Level.Error) == "ERROR", "level_label is wrong") && ok
    return ok

// ── Filter, Fanout and a logger ─────────────────────────────────────────────
private bool composed(^Record r):
    bool ok = true
    i32 before = g_calls
    g_errors = (Level.Error, g_probe2)
    Sink only_errors = g_errors
    only_errors.take(r)
    ok = #expect(g_calls == before, "a Warn record passed an Error filter") && ok
    Record bad = record(Level.Error, "disk", "full")
    only_errors.take(&bad)
    ok = #expect(g_calls == before + 1 && g_last_msg == "full" && g_last_id == 2, "an Error record did not pass an Error filter") && ok

    Sink probe = g_probe
    for i in 0..<FANOUT_CAP:
        ok = #expect(g_fan.add(probe), "a fanout refused sink ", i) && ok
    ok = #expect(!g_fan.add(probe), "a full fanout took another sink") && ok
    i64 seen_before = g_probe.seen
    Sink fan = g_fan
    fan.take(r)
    ok = #expect(g_calls == before + 1 + FANOUT_CAP, "a fanout of ", FANOUT_CAP, " did not call each once") && ok
    ok = #expect(g_probe.seen == seen_before + FANOUT_CAP, "the fanout's sinks wrote copies, not the probe") && ok
    // Sinks nest: a filter and a probe behind one fanout, in order.
    Fanout pair
    Sink second = g_probe2
    ok = #expect(pair.add(only_errors) && pair.add(second) && pair.count == 2, "a fanout refused a filter or a probe") && ok
    i32 at_pair = g_calls
    pair.take(r)
    ok = #expect(g_calls == at_pair + 1 && g_last_id == 2, "the filter in a fanout let a Warn through, or the probe missed it") && ok
    // An empty fanout takes a record and does nothing.
    Fanout none
    none.take(r)
    ok = #expect(g_calls == at_pair + 1, "an empty fanout called something") && ok

    Logger quiet = (g_probe, Level.Warn)
    ok = #expect(enabled(quiet, Level.Error) && !enabled(quiet, Level.Info), "enabled is wrong") && ok
    i32 at = g_calls
    write(quiet, Level.Info, "x", "dropped")
    write(quiet, Level.Warn, "x", "kept")
    ok = #expect(g_calls == at + 1 && g_last_msg == "kept", "a logger did not keep exactly its levels") && ok
    Logger silent = (discard(), Level.Trace)
    write(silent, Level.Error, "x", "y")
    ok = #expect(g_calls == at + 1, "a logger over discard() reached a sink") && ok
    return ok

// ── the default logger ──────────────────────────────────────────────────────
private bool defaults():
    bool ok = true
    Logger first = default_logger()
    ok = #expect(first.min == Level.Info, "the default logger is not at Info") && ok
    Logger probing = (g_probe2, Level.Debug)
    set_default(probing)
    i32 at = g_calls
    trace("t", "below")
    debug("t", "d")
    info("t", "i")
    warn("t", "w")
    error("t", "e")
    ok = #expect(g_calls == at + 4 && g_last_level == Level.Error && g_last_msg == "e" && g_last_id == 2, "the default logger kept ", g_calls - at, " of 4") && ok
    set_default(first)
    return ok
