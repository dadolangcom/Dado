@test
// `app:body2d` — the resolution, the boundary cases it exists for, and the
// three ways it is most likely to be broken.
//
// Nothing here needs a GPU, a window, an allocator or a file. The tilemap is
// defined by this file, as arithmetic in a `SolidFn`, which is the seam the
// package takes and is therefore the seam its own tests use — there is no test
// harness standing in for a client here.
//
// **`delta` is 1.0 throughout and `velocity` is in units per step.** A
// sixtieth of a second is not exact in binary, and half the claims below are
// exact coordinates asserted with `==`: a body resting on a tile must be on the
// *same bit pattern* a thousand steps later, and a tolerance would hide exactly
// the drift that assertion exists to catch. Folding the frame time out makes
// every number in this file an integer, so an `==` is an honest question.
//
// Coordinates are `app:draw`'s: origin top-left, y increasing downwards, `UP`
// is `(0, -1)`. Every map below uses 16-unit cells, so cell `n` spans
// `[16n, 16n+16)` and the phrase "the floor is row 8" means its top edge is at
// y = 128.
package body2d

// ── the maps ───────────────────────────────────────────────────────────────
//
// Each is a whole world, written as one predicate. `user` is unused because
// these are closed over nothing — a real client's would reach a level through
// it, and `app:graph`'s `_ = ud` idiom is what says "on purpose" here.

// A floor filling every column from row 8 down. Top edge at y = 128.
private bool floor8(rawptr user, i32 tx, i32 ty):
    _ = user
    _ = tx
    return ty >= 8

// Exactly two floor tiles, side by side: cells (2,8) and (3,8), spanning
// x in [32, 64). The join between them is at x = 48, and it is the seam a
// body walking right must not catch on.
private bool two_tiles(rawptr user, i32 tx, i32 ty):
    _ = user
    return ty == 8 && (tx == 2 || tx == 3)

// A wall filling every column from 10 rightwards. Left face at x = 160.
private bool wall10(rawptr user, i32 tx, i32 ty):
    _ = user
    _ = ty
    return tx >= 10

// A ceiling: rows 0 and 1. Bottom edge at y = 32.
private bool ceiling1(rawptr user, i32 tx, i32 ty):
    _ = user
    _ = tx
    return ty <= 1

// An inside corner: the floor of `floor8` and the wall of `wall10`, meeting at
// (160, 128).
private bool corner(rawptr user, i32 tx, i32 ty):
    _ = user
    return ty >= 8 || tx >= 10

// One solid cell and nothing else, at (4,4) — x in [64, 80), y in [64, 80).
// A single tile in open space is what a diagonal move can pass through when
// the two axes are resolved over the whole step instead of substep by substep.
private bool one_tile(rawptr user, i32 tx, i32 ty):
    _ = user
    return tx == 4 && ty == 4

private const f32 TILE = 16.0

private Solids map(SolidFn f):
    return solids(f, nil, TILE, TILE)

// A 16x16 body, the size of one cell, which is what makes the coordinates
// below readable: a body resting on row 8 has its top at 128 - 16 = 112.
private Body cube([2]f32 at):
    return body(at, (TILE, TILE))

i32 test():
    bool ok = true

    // ── falling lands exactly on the tile top ──────────────────────────────
    //
    // Not "within half a pixel of it". The landing coordinate is computed from
    // the grid — `f32(8) * 16 - 16` — so it is 112 and it is 112 exactly, and
    // the velocity that carried the body there is gone.

    Solids ground = map(floor8)
    Body fall = cube((64.0, 0.0))
    fall.velocity = (0.0, 12.0)
    i32 steps = 0
    for steps < 100 && !is_on_floor(&fall):
        fall.velocity.y = fall.velocity.y + 1.0
        move_and_slide(&fall, ground, 1.0)
        steps = steps + 1
    ok = #expect(is_on_floor(&fall), "a body dropped onto a floor never landed") && ok
    ok = #expect(fall.position.y == 112.0,
                 "landed at y = ", fall.position.y, ", not on the tile top at 112") && ok
    ok = #expect(fall.velocity.y == 0.0,
                 "landing left ", fall.velocity.y, " of downward velocity") && ok
    ok = #expect(get_floor_normal(&fall) == UP,
                 "the floor normal is ", get_floor_normal(&fall)[0], ",",
                 get_floor_normal(&fall)[1]) && ok
    ok = #expect(!is_on_wall(&fall) && !is_on_ceiling(&fall),
                 "landing on a floor also reported a wall or a ceiling") && ok
    ok = #expect(!overlaps(&fall, ground),
                 "a landed body is inside the floor it landed on") && ok

    // ── walking into a wall stops flush ───────────────────────────────────
    //
    // Flush means the body's right edge is on the wall's left face and not one
    // epsilon short of it: 160 - 16 = 144, exactly, and pushing again does not
    // move it a further fraction.

    Solids wall = map(wall10)
    Body run = cube((0.0, 64.0))
    run.velocity = (40.0, 0.0)
    steps = 0
    for steps < 100 && !is_on_wall(&run):
        run.velocity.x = 40.0
        move_and_slide(&run, wall, 1.0)
        steps = steps + 1
    ok = #expect(is_on_wall(&run), "a body run into a wall never reached it") && ok
    ok = #expect(run.position.x == 144.0,
                 "stopped at x = ", run.position.x, ", not flush against 160") && ok
    ok = #expect(run.velocity.x == 0.0,
                 "hitting a wall left ", run.velocity.x, " of horizontal velocity") && ok
    ok = #expect(get_wall_normal(&run) == LEFT,
                 "the wall normal is ", get_wall_normal(&run)[0], ",",
                 get_wall_normal(&run)[1]) && ok

    f32 flush_x = run.position.x
    i32 push = 0
    for push < 50:
        run.velocity.x = 40.0
        move_and_slide(&run, wall, 1.0)
        push = push + 1
    ok = #expect(run.position.x == flush_x,
                 "fifty more pushes against the wall moved the body to ",
                 run.position.x) && ok

    // ── the flush seam ────────────────────────────────────────────────────
    //
    // The one that looks like a physics bug and is an arithmetic one. Two floor
    // tiles side by side, a body walking right across the join at x = 48 with
    // gravity pulling it into the floor every step. If the horizontal sweep
    // ever runs against a vertical coordinate that is a hair inside the floor,
    // the floor row reads as a wall and the body stops dead on the seam.
    //
    // Sixteen steps of one unit carry it from x = 32 to x = 48, so the join is
    // crossed in the middle of the walk rather than at either end.

    Solids pair = map(two_tiles)
    Body walk = cube((32.0, 112.0))
    i32 caught = -1
    i32 s = 0
    for s < 16:
        walk.velocity = (1.0, 1.0)
        f32 before = walk.position.x
        move_and_slide(&walk, pair, 1.0)
        if walk.position.x != before + 1.0 && caught < 0:
            caught = s
        s = s + 1
    ok = #expect(caught < 0,
                 "the body caught on the tile seam at step ", caught,
                 ", x = ", walk.position.x) && ok
    ok = #expect(walk.position.x == 48.0,
                 "sixteen steps of one unit from 32 ended at ", walk.position.x) && ok
    ok = #expect(walk.position.y == 112.0,
                 "walking along the floor left the body at y = ",
                 walk.position.y) && ok
    ok = #expect(is_on_floor(&walk), "the body left the floor while walking on it") && ok
    ok = #expect(!is_on_wall(&walk),
                 "the body reported a wall while crossing a flat floor") && ok

    // ── head-bumping a ceiling ────────────────────────────────────────────

    Solids roof = map(ceiling1)
    Body jump = cube((64.0, 100.0))
    jump.velocity = (0.0, -10.0)
    steps = 0
    for steps < 100 && !is_on_ceiling(&jump):
        jump.velocity.y = -10.0
        move_and_slide(&jump, roof, 1.0)
        steps = steps + 1
    ok = #expect(is_on_ceiling(&jump),
                 "a body launched upwards never met the ceiling") && ok
    ok = #expect(jump.position.y == 32.0,
                 "stopped at y = ", jump.position.y, ", not under the ceiling at 32") && ok
    ok = #expect(jump.velocity.y == 0.0,
                 "a head bump left ", jump.velocity.y, " of upward velocity") && ok
    ok = #expect(get_ceiling_normal(&jump) == DOWN,
                 "the ceiling normal is ", get_ceiling_normal(&jump)[0], ",",
                 get_ceiling_normal(&jump)[1]) && ok
    ok = #expect(!is_on_floor(&jump), "a head bump also reported a floor") && ok

    // ── the contact report is a report ────────────────────────────────────
    //
    // This is the assertion that separates `is_on_floor` from a live query, and
    // it is the whole of point three of the package comment. A body in the air
    // reports no floor. A body that lands reports one. A body that is then
    // *teleported into the sky* still reports one, because nothing has moved it
    // — a caller who assigned `position` did not ask this package anything, and
    // the last thing it was asked is still the last thing it answered. Only the
    // next `move_and_slide` changes the answer.

    Body air = cube((64.0, 0.0))
    air.velocity = (0.0, 4.0)
    move_and_slide(&air, ground, 1.0)
    ok = #expect(!is_on_floor(&air), "a body in open air reported a floor") && ok
    ok = #expect(air.position.y == 4.0,
                 "an unobstructed step of 4 moved the body to ", air.position.y) && ok

    steps = 0
    for steps < 100 && !is_on_floor(&air):
        air.velocity.y = 8.0
        move_and_slide(&air, ground, 1.0)
        steps = steps + 1
    ok = #expect(is_on_floor(&air), "the body never landed") && ok

    air.position = (64.0, 0.0)
    ok = #expect(is_on_floor(&air),
                 "is_on_floor changed when `position` did, so it is a live query ",
                 "and not a report of the last move") && ok
    ok = #expect(!overlaps(&air, ground),
                 "the live query agrees the body is nowhere near the floor, ",
                 "which is the point: the two questions are different") && ok

    air.velocity = (0.0, 0.0)
    move_and_slide(&air, ground, 1.0)
    ok = #expect(!is_on_floor(&air),
                 "the next move recomputed the report and still said floor") && ok

    // ── tunnelling: a fall no speed gets through ──────────────────────────
    //
    // A thousand units in one step, through a floor the body is one sixty-third
    // of that fall tall. Then a hundred thousand, which is past `MAX_SUBSTEPS`,
    // so the substeps are 1562 units long — far longer than the body — and the
    // answer is the same coordinate, because the sweep is a path test and not a
    // destination test.

    Body bullet = cube((64.0, 0.0))
    bullet.velocity = (0.0, 1000.0)
    move_and_slide(&bullet, ground, 1.0)
    ok = #expect(bullet.position.y == 112.0,
                 "a 1000-unit fall ended at y = ", bullet.position.y) && ok
    ok = #expect(is_on_floor(&bullet), "a 1000-unit fall did not report a floor") && ok
    ok = #expect(substeps(&bullet) > 1 && substeps(&bullet) <= MAX_SUBSTEPS,
                 "a 1000-unit fall took ", substeps(&bullet), " substeps") && ok

    Body faster = cube((64.0, 0.0))
    faster.velocity = (0.0, 100000.0)
    move_and_slide(&faster, ground, 1.0)
    ok = #expect(faster.position.y == 112.0,
                 "a 100000-unit fall ended at y = ", faster.position.y) && ok
    ok = #expect(substeps(&faster) == MAX_SUBSTEPS,
                 "a 100000-unit fall took ", substeps(&faster),
                 " substeps, not the cap") && ok

    // ── tunnelling: the diagonal, which is what the substepping is for ────
    //
    // One solid cell at (4,4) and an 8x8 body starting at (32,32) moving
    // (+64, +64) — straight through its centre. Resolved as two whole-step axis
    // moves the body arrives at (96,96) having touched nothing, because neither
    // the pure-vertical leg nor the pure-horizontal leg crosses the tile.
    // Substepped at the body's own extent it meets the tile's left face at
    // x = 56 and drops down beside it.
    //
    // **This is the assertion that fails if the substepping is deleted**, and
    // the vertical ones above are not: a single-axis sweep is exact at any
    // speed, so a straight fall lands correctly with or without substeps.

    Solids lone = map(one_tile)
    Body diag = body((32.0, 32.0), (8.0, 8.0))
    diag.velocity = (64.0, 64.0)
    move_and_slide(&diag, lone, 1.0)
    ok = #expect(diag.position.x == 56.0,
                 "a diagonal step passed the tile: x = ", diag.position.x,
                 " (96 means it went straight through)") && ok
    ok = #expect(is_on_wall(&diag),
                 "a diagonal step through a tile reported no contact") && ok
    ok = #expect(diag.velocity.x == 0.0,
                 "the blocked axis kept ", diag.velocity.x, " of velocity") && ok
    ok = #expect(diag.position.y == 96.0,
                 "the free axis was cut short at y = ", diag.position.y) && ok

    // ── a thousand steps at rest ──────────────────────────────────────────
    //
    // Gravity is added every step, exactly as a real caller adds it, and every
    // step the contact zeroes it again. The claim is bit equality: after a
    // thousand steps the body is on the same two floats it started on, because
    // the resting coordinate is assigned out of the grid rather than arrived at
    // by subtraction.

    Body rest = cube((64.0, 112.0))
    [2]f32 origin = rest.position
    bool held = true
    i32 t = 0
    for t < 1000:
        rest.velocity.y = rest.velocity.y + 1.0
        move_and_slide(&rest, ground, 1.0)
        if rest.position != origin || !is_on_floor(&rest):
            held = false
        t = t + 1
    ok = #expect(held,
                 "a body at rest moved or lost the floor during 1000 steps") && ok
    ok = #expect(rest.position == origin,
                 "after 1000 steps at rest the body is at ", rest.position.x, ",",
                 rest.position.y, " and started at ", origin.x, ",", origin.y) && ok
    ok = #expect(rest.velocity.y == 0.0,
                 "a resting body accumulated ", rest.velocity.y,
                 " of downward velocity") && ok

    // The same thousand steps with no gravity at all, which is what
    // `floor_snap_length` is for: nothing pushes the body into the ground, so
    // the move finds nothing, and the snap probe is what keeps the report true.
    Body idle = cube((64.0, 112.0))
    i32 u = 0
    for u < 1000:
        move_and_slide(&idle, ground, 1.0)
        u = u + 1
    ok = #expect(idle.position == origin,
                 "a body nothing touched for 1000 steps drifted to ",
                 idle.position.x, ",", idle.position.y) && ok
    ok = #expect(is_on_floor(&idle),
                 "floor snapping lost a stationary body's floor") && ok

    // ── the inside corner, from two directions ────────────────────────────
    //
    // Floor at y = 128, wall at x = 160, so the corner a 16x16 body settles in
    // is (144, 112). One body arrives diagonally from above and to the left;
    // the other arrives from above, against the wall, and falls. Both end on
    // the same two numbers, because both constraints are active and each axis's
    // answer is the grid's rather than a function of what the other axis did.

    Solids inside = map(corner)
    Body from_left = cube((80.0, 64.0))
    from_left.velocity = (16.0, 16.0)
    i32 a = 0
    for a < 10:
        move_and_slide(&from_left, inside, 1.0)
        a = a + 1

    Body from_above = cube((144.0, 32.0))
    from_above.velocity = (16.0, 16.0)
    i32 c = 0
    for c < 10:
        move_and_slide(&from_above, inside, 1.0)
        c = c + 1

    ok = #expect(from_left.position == (144.0, 112.0),
                 "arriving diagonally settled at ", from_left.position.x, ",",
                 from_left.position.y) && ok
    ok = #expect(from_above.position == (144.0, 112.0),
                 "arriving along the wall settled at ", from_above.position.x, ",",
                 from_above.position.y) && ok
    ok = #expect(from_left.position == from_above.position,
                 "two arrivals at one inside corner disagree about where it is") && ok
    ok = #expect(is_on_floor(&from_left) && is_on_floor(&from_above),
                 "a body in an inside corner is not on the floor") && ok

    // ── move_and_collide reports and does not slide ───────────────────────
    //
    // And, per the package comment, leaves the contact report alone: the floor
    // the body is standing on is still the floor it was standing on.

    Body probe = cube((64.0, 112.0))
    move_and_slide(&probe, ground, 1.0)
    ok = #expect(is_on_floor(&probe), "the probe body is not standing on anything") && ok

    Body sideways = cube((0.0, 64.0))
    Collision hit = move_and_collide(&sideways, wall, (400.0, 0.0))
    ok = #expect(hit.hit, "a 400-unit motion into a wall 160 away reported no hit") && ok
    ok = #expect(hit.normal == LEFT,
                 "the contact normal is ", hit.normal[0], ",", hit.normal[1]) && ok
    ok = #expect(hit.tile_x == 10,
                 "the blocking cell is column ", hit.tile_x, ", not 10") && ok
    ok = #expect(sideways.position.x == 144.0,
                 "move_and_collide left the body at ", sideways.position.x) && ok
    ok = #expect(hit.travel == (144.0, 0.0),
                 "travel is ", hit.travel[0], ",", hit.travel[1]) && ok
    ok = #expect(hit.remainder == (256.0, 0.0),
                 "remainder is ", hit.remainder[0], ",", hit.remainder[1]) && ok
    ok = #expect(!is_on_wall(&sideways),
                 "move_and_collide wrote the contact report, which belongs to ",
                 "move_and_slide alone") && ok

    Collision clear = move_and_collide(&probe, ground, (0.0, -8.0))
    ok = #expect(!clear.hit, "an unobstructed probe reported a hit") && ok
    ok = #expect(probe.position.y == 104.0,
                 "an unobstructed probe of -8 left the body at ",
                 probe.position.y) && ok
    ok = #expect(is_on_floor(&probe),
                 "move_and_collide cleared the floor the last slide found") && ok

    // ── the degenerate world ──────────────────────────────────────────────

    Body nowhere = cube((10.0, 10.0))
    Solids empty = solids(nil, nil, TILE, TILE)
    nowhere.velocity = (100.0, 100.0)
    move_and_slide(&nowhere, empty, 1.0)
    ok = #expect(nowhere.position == (110.0, 110.0),
                 "a world with no geometry stopped the body at ",
                 nowhere.position.x, ",", nowhere.position.y) && ok
    ok = #expect(!is_on_floor(&nowhere) && !is_on_wall(&nowhere),
                 "an empty world reported a contact") && ok

    // ── a coordinate becoming a cell, at the edges ────────────────────────
    //
    // `cell_lo` and `cell_hi` are where a float becomes an `i32`, and the
    // conversion saturates — so these are the inputs that used to reach it
    // with no answer a caller could use: a zero cell size (a division giving
    // ±inf), a NaN one (which passed a `<= 0.0` guard), a NaN coordinate, and
    // a coordinate so far out that `cell_hi(...) + 1` would overflow.
    f32 zero = 0.0
    f32 nan = zero / zero
    f32 inf = 1.0 / zero
    f32 far = 3.0e38

    ok = #expect(cell_lo(40.0, zero) == 0 && cell_hi(40.0, zero) == 0 - 1,
                 "a zero cell size gave ", cell_lo(40.0, zero), "..", cell_hi(40.0, zero),
                 ", not the empty range") && ok
    ok = #expect(cell_lo(40.0, nan) == 0 && cell_hi(40.0, nan) == 0 - 1,
                 "a NaN cell size gave ", cell_lo(40.0, nan), "..", cell_hi(40.0, nan)) && ok
    ok = #expect(cell_lo(40.0, 0.0 - TILE) == 0 && cell_hi(40.0, 0.0 - TILE) == 0 - 1,
                 "a negative cell size gave a non-empty range") && ok
    ok = #expect(cell_lo(nan, TILE) == 0 && cell_hi(nan, TILE) == 0 - 1,
                 "a NaN coordinate gave ", cell_lo(nan, TILE), "..", cell_hi(nan, TILE)) && ok

    // Clamped to 2^30 cells either way, so the sweep's `+ 1` and `- 1` fit.
    ok = #expect(cell_lo(far, 1.0) == 1073741824 && cell_hi(far, 1.0) + 1 == 1073741824,
                 "a far coordinate gave ", cell_lo(far, 1.0), "..", cell_hi(far, 1.0)) && ok
    ok = #expect(cell_lo(0.0 - far, 1.0) - 1 == 0 - 1073741825,
                 "a far negative coordinate gave ", cell_lo(0.0 - far, 1.0)) && ok
    ok = #expect(cell_lo(inf, 1.0) == 1073741824 && cell_hi(inf, 1.0) == 1073741823,
                 "an infinite coordinate gave ", cell_lo(inf, 1.0), "..", cell_hi(inf, 1.0)) && ok
    // And the ordinary answers are the ordinary answers.
    ok = #expect(cell_lo(40.0, TILE) == 2 && cell_hi(48.0, TILE) == 2 && cell_hi(48.5, TILE) == 3,
                 "the half-open rule moved") && ok

    // The public entry points over the same worlds: nothing traps, nothing
    // collides, and a body is where it was told to go.
    Solids flat = solids(floor8, nil, zero, TILE)
    Body loose = cube((0.0, 0.0))
    loose.velocity = (32.0, 0.0)
    move_and_slide(&loose, flat, 1.0)
    ok = #expect(loose.position.x == 32.0 && !overlaps(&loose, flat),
                 "a zero-width world moved the body to ", loose.position.x) && ok
    Solids undefined = solids(floor8, nil, nan, nan)
    ok = #expect(!overlaps(&loose, undefined), "a NaN-sized world reported an overlap") && ok
    Body distant = cube((far, far))
    distant.velocity = (16.0, 16.0)
    move_and_slide(&distant, map(floor8), 1.0)
    ok = #expect(!overlaps(&distant, map(one_tile)),
                 "a body 3e38 out overlapped a tile at (4,4)") && ok

    if ok:
        return 0
    return 1
