@test
// app:display unit test — the part of the surface that is answerable with no
// window open.
//
// **Almost all of this package needs a window and therefore cannot be gated
// here**: `sapp_run` fuses window creation with the frame loop, the gate has no
// X server, and everything from `window_get_size` to `begin_pass` reads sokol
// state that only exists between `sapp_run`'s first and last line. What is left
// is exactly the surface E6 added — the clipboard's *capacity*, which is a
// build constant, and `clipboard_set`'s two refusals, which are decided before
// sokol is called at all — plus the two predicates that are defined when the
// display is down. `example/window` is where the rest is checked, against a
// real window under Xvfb, and it asserts these same facts again there.
package display

import "vendor:sokol/sokol_app"

i32 test():
    bool ok = true

    // ── E6: the capacity is real, and it is not sokol's 8 KB default ───────
    i32 cap = clipboard_capacity()
    ok = #expect(cap == CLIPBOARD_BYTES - 1,
                 "capacity is the buffer less its terminator, got ", cap,
                 " for a buffer of ", CLIPBOARD_BYTES) && ok
    ok = #expect(cap > 8191,
                 "the clipboard is bigger than sokol's default — the editor ",
                 "exceeded that on a 9 KB file — got ", cap) && ok

    // ── E6: `clipboard_set` answers, and refuses rather than truncating ────
    //
    // With no display up, every call is refused: sokol's clipboard entry
    // points are silent no-ops before `sapp_run`, so a `void` setter reported
    // success for a call that did nothing at all. That is the same silence the
    // 8 191-byte truncation hid behind.
    ok = #expect(!valid(), "no window is open in a unit test") && ok
    ok = #expect(!clipboard_set("short"),
                 "a set with no display open is refused, not silently dropped") && ok

    // **The length refusal is deliberately not asserted here, and saying why is
    // the point.** Both refusals answer the same `false`, and with no window
    // open the display refusal fires first — so an oversize string is rejected
    // here whether or not `clipboard_set` looks at its length at all, and an
    // assertion about it would pass over an implementation that had the check
    // deleted. That is a vacuous test, which is worth less than no test.
    // Separating the two needs a live window, so the length refusal is pinned
    // in `example/window`, which opens one: it copies a short string and an
    // over-capacity one through the same call and reports both answers.

    // ── What `clipboard_set` refuses, decided with no window ────────────────
    //
    // `clipboard_accepts` is the content half of `clipboard_set`'s refusals,
    // so unlike the call itself it can be asserted here without the display
    // refusal masking it.
    ok = #expect(clipboard_accepts("short") && clipboard_accepts(""), "ordinary text is accepted") && ok
    ok = #expect(!clipboard_accepts("ab\x00cd"), "a NUL would end the C string early: refused") && ok
    ok = #expect(!clipboard_accepts("\x00"), "a lone NUL: refused") && ok

    // ── the pass predicate is false outside a pass, including outside a run ─
    ok = #expect(!drawing(), "nothing is being drawn with no window") && ok

    // ── the UI cursor names map onto sokol's numbers, and set_cursor is a
    // no-op with no window rather than sokol's assertion ───────────────────
    ok = #expect(cursor_sapp_value(CURSOR_DEFAULT) == 0, "DEFAULT is the platform's own cursor") && ok
    ok = #expect(cursor_sapp_value(CURSOR_IBEAM) == u32(sokol_app.sapp_mouse_cursor.SAPP_MOUSECURSOR_IBEAM),
                 "IBEAM is sokol's I-beam") && ok
    ok = #expect(cursor_sapp_value(CURSOR_POINTER) == u32(sokol_app.sapp_mouse_cursor.SAPP_MOUSECURSOR_POINTING_HAND),
                 "POINTER is sokol's pointing hand") && ok
    ok = #expect(cursor_sapp_value(CURSOR_RESIZE_EW) == u32(sokol_app.sapp_mouse_cursor.SAPP_MOUSECURSOR_RESIZE_EW),
                 "RESIZE_EW is sokol's east-west arrows") && ok
    ok = #expect(cursor_sapp_value(CURSOR_RESIZE_NS) == u32(sokol_app.sapp_mouse_cursor.SAPP_MOUSECURSOR_RESIZE_NS),
                 "RESIZE_NS is sokol's north-south arrows") && ok
    ok = #expect(cursor_sapp_value(99) == 0 && cursor_sapp_value(-1) == 0, "an unknown name is the default") && ok
    set_cursor(CURSOR_IBEAM)
    ok = #expect(!valid(), "set_cursor with no window did nothing, and returned") && ok

    if ok:
        return 0
    return 1
