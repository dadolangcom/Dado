@test
// `app:sprite` — the grid arithmetic, the named-animation table, what a frame
// records, and the clock.
//
// Everything here runs against `draw.init_headless`, so it needs no GPU and no
// image file: the server records into real items and the walk that counts a
// frame is the same walk the GPU path replays. The sheet is a run of bytes
// nobody looks at — a headless texture reads its *shape* and never its
// contents, and every claim below is about a rectangle's coordinates rather
// than about a pixel.
//
// **This file reads the recorded commands back**, through
// `draw.canvas_item_command` and `draw.CMD_*`. That accessor exists for exactly
// this: the claims this package makes that a count cannot see are that a
// frame's source rectangle is in **sheet pixels**, that `flip_h` and `flip_v`
// are **negative source extents over an unchanged destination**, and that
// `centered` and `offset` move the destination by exactly what they say — and
// every one of them lives in a command's payload. `app:text`'s own test could
// not do this — it asserts against its private `glyph_src` and says so — and
// the read-back landed with the retained surface precisely so that the next
// package would not have to.
//
// The pixels themselves are somebody else's proof: `example/drawsmoke` renders
// into a target and reads it back on a real GL device.
package sprite

import "app:draw"
import "core:mem/libc"
import "core:mem"

private const [4]u8 WHITE = [255, 255, 255, 255]
private const [4]u8 TINT = [128, 64, 200, 255]

private const i32 FB_W = 800
private const i32 FB_H = 600

// The test sheet: 64x48 of 16x16 frames, so four columns, three rows, twelve
// frames. None of the three numbers is a multiple of another, which is what
// makes a row/column mix-up visible.
private const i32 SHEET_W = 64
private const i32 SHEET_H = 48
private const i32 FRAME = 16

private bool near(f32 a, f32 b, f32 eps):
    f32 d = a - b
    if d < 0.0:
        d = -d
    return d <= eps

// One item on a canvas of its own, so a render counts this item and nothing
// else, as `text_test` does and for the same reason.
private (draw.Canvas c, draw.Item it) solo():
    draw.Canvas c = draw.canvas_create()
    return (c, draw.canvas_item_create(c))

// `n` bytes of stand-in pixels. A headless texture never looks at them.
private ref []u8 g_scratch

private []u8 scratch(i32 n):
    if g_scratch != nil:
        #delete(g_scratch)
    g_scratch = #make([]u8, n, #default)
    return g_scratch[:]

i32 test():
    bool ok = true
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc = libc.allocator()

    ok = #expect(draw.init_headless() using alloc, "init_headless") && ok

    draw.Texture tex = draw.texture_create(SHEET_W, SHEET_H,
                                           scratch(SHEET_W * SHEET_H * 4))
    ok = #expect(draw.texture_valid(tex), "the sheet took a handle") && ok
    Sheet s = grid(tex, FRAME, FRAME)

    // ── the grid arithmetic, including the ends of it ──────────────────────
    //
    // Row-major from the top-left. The four indices below are the four that a
    // wrong divisor gets wrong: the first, the last of a row, the first of the
    // next row, and the last frame of the sheet.

    ok = #expect(s.cols == 4 && s.rows == 3,
                 "64x48 of 16x16 is 4x3, got ", s.cols, "x", s.rows) && ok
    ok = #expect(frame_count(s) == 12,
                 "twelve frames, got ", frame_count(s)) && ok

    ok = #expect(frame_src(s, 0) == [0.0, 0.0, 16.0, 16.0],
                 "frame 0 is the top-left cell") && ok
    ok = #expect(frame_src(s, 3) == [48.0, 0.0, 16.0, 16.0],
                 "frame 3 is the last of row 0, got ", frame_src(s, 3)[0], ",",
                 frame_src(s, 3)[1]) && ok
    ok = #expect(frame_src(s, 4) == [0.0, 16.0, 16.0, 16.0],
                 "frame 4 wraps to the start of row 1, got ", frame_src(s, 4)[0],
                 ",", frame_src(s, 4)[1]) && ok
    ok = #expect(frame_src(s, 11) == [48.0, 32.0, 16.0, 16.0],
                 "frame 11 is the last frame, got ", frame_src(s, 11)[0], ",",
                 frame_src(s, 11)[1]) && ok

    // An index past the end, and one before the start, answer a value rather
    // than trapping — `app:draw`'s rule for an overrun, restated one level up.
    ok = #expect(frame_src(s, 12) == [0.0, 0.0, 0.0, 0.0],
                 "frame 12 is past the end and answers a zero rect, got ",
                 frame_src(s, 12)[2], "x", frame_src(s, 12)[3]) && ok
    ok = #expect(frame_src(s, -1) == [0.0, 0.0, 0.0, 0.0],
                 "and so does frame -1") && ok

    // ── a frame's rect is pixels, and every one of them is inside the sheet ─
    //
    // Pixels and not uv is distinguishable by inspection and not only by
    // equality: every number of a uv rectangle is in `0..1` and a frame here is
    // sixteen across and sits at an offset of tens. And whatever the arithmetic
    // does, no frame may name a texel the texture does not have — which is the
    // claim the integer division is for.

    for i in 0..<12:
        [4]f32 r = frame_src(s, i32(i))
        ok = #expect(r[2] == 16.0 && r[3] == 16.0,
                     "frame ", i32(i), " is ", r[2], "x", r[3],
                     " where pixels would be 16x16") && ok
        ok = #expect(r[0] >= 0.0 && r[1] >= 0.0
                     && r[0] + r[2] <= f32(SHEET_W) && r[1] + r[3] <= f32(SHEET_H),
                     "frame ", i32(i), " runs to ", r[0] + r[2], ",", r[1] + r[3],
                     " outside the ", SHEET_W, "x", SHEET_H, " sheet") && ok

    // A partial trailing column is not a frame: six leftover pixels of a
    // 70-wide sheet are unaddressable rather than a fifth narrow column.
    draw.Texture ragged_tex = draw.texture_create(70, 48, scratch(70 * 48 * 4))
    Sheet ragged = grid(ragged_tex, FRAME, FRAME)
    ok = #expect(ragged.cols == 4,
                 "70 pixels of 16-pixel frames is 4 columns, got ",
                 ragged.cols) && ok

    // A frame bigger than the sheet, and a frame of no size, are both a sheet
    // of no frames rather than a division by zero.
    Sheet too_big = grid(tex, 128, 128)
    ok = #expect(frame_count(too_big) == 0,
                 "a frame bigger than the sheet gives ", frame_count(too_big),
                 " frames") && ok
    Sheet degenerate = grid(tex, 0, 16)
    ok = #expect(frame_count(degenerate) == 0
                 && frame_src(degenerate, 0) == [0.0, 0.0, 0.0, 0.0],
                 "a zero frame width gives ", frame_count(degenerate),
                 " frames") && ok
    Sheet no_tex = grid(draw.NIL_TEXTURE, FRAME, FRAME)
    ok = #expect(frame_count(no_tex) == 0,
                 "a sheet over no texture has ", frame_count(no_tex),
                 " frames") && ok

    // ── the resource: animations are looked up by name ──────────────────────
    //
    // The table is the half of the reshape that is new storage, so everything
    // it promises is asserted: that a name finds its animation, that a name it
    // does not hold answers a value rather than trapping, that Godot's defaults
    // are the defaults, and that both caps refuse rather than overrun.

    SpriteFrames frames

    ok = #expect(animation_count(&frames) == 0,
                 "a zeroed SpriteFrames holds ", animation_count(&frames),
                 " animations") && ok
    ok = #expect(!has_animation(&frames, "walk"),
                 "and has_animation says it holds one") && ok

    // Godot's own defaults, taken by a one-argument `add_animation`: 5 fps and
    // looping. A caller porting from GDScript gets the number Godot gave it.
    ok = #expect(add_animation(&frames, "default_speed"),
                 "a one-argument add_animation failed") && ok
    ok = #expect(get_animation_speed(&frames, "default_speed") == 5.0,
                 "Godot's default speed is 5 fps, got ",
                 get_animation_speed(&frames, "default_speed")) && ok
    ok = #expect(get_animation_loop(&frames, "default_speed"),
                 "and Godot's default is looping") && ok

    ok = #expect(add_animation(&frames, "loop4", 10.0, true), "loop4") && ok
    ok = #expect(add_frames(&frames, "loop4", 0, 4) == 4,
                 "four frames appended, and the animation holds ",
                 get_frame_count(&frames, "loop4")) && ok
    ok = #expect(add_animation(&frames, "high3", 10.0, true), "high3") && ok
    ok = #expect(add_frames(&frames, "high3", 8, 3) == 3, "high3 frames") && ok
    ok = #expect(add_animation(&frames, "once3", 10.0, false), "once3") && ok
    ok = #expect(add_frames(&frames, "once3", 1, 3) == 3, "once3 frames") && ok
    ok = #expect(add_animation(&frames, "exact7", 16.0, true), "exact7") && ok
    ok = #expect(add_frames(&frames, "exact7", 0, 7) == 7, "exact7 frames") && ok
    ok = #expect(add_animation(&frames, "real7", 12.05, true), "real7") && ok
    ok = #expect(add_frames(&frames, "real7", 0, 7) == 7, "real7 frames") && ok
    ok = #expect(add_animation(&frames, "still", 0.0, true), "still") && ok
    ok = #expect(add_frames(&frames, "still", 5, 4) == 4, "still frames") && ok
    ok = #expect(add_animation(&frames, "backwards", -12.0, false),
                 "backwards") && ok
    ok = #expect(add_frames(&frames, "backwards", 5, 4) == 4,
                 "backwards frames") && ok
    ok = #expect(add_animation(&frames, "scaled", 10.0, true), "scaled") && ok
    ok = #expect(add_frames(&frames, "scaled", 0, 4) == 4, "scaled frames") && ok
    ok = #expect(add_animation(&frames, "empty", 12.0, true), "empty") && ok

    ok = #expect(animation_count(&frames) == 10,
                 "ten animations, got ", animation_count(&frames)) && ok

    // The lookup: a name that is there, and one that is not.
    ok = #expect(has_animation(&frames, "loop4"), "loop4 is not found") && ok
    ok = #expect(!has_animation(&frames, "loop"),
                 "a prefix of a name is not that name") && ok
    ok = #expect(!has_animation(&frames, "loop40"),
                 "and neither is an extension of one") && ok
    ok = #expect(!has_animation(&frames, "sprint"),
                 "an unknown name is reported as present") && ok
    ok = #expect(!has_animation(&frames, ""),
                 "the empty name is never an animation") && ok
    // ...and it is never one because `add_animation` refuses it, not because
    // nobody happened to write it. `animation_name` answers `""` for a sprite
    // playing nothing, so an animation called `""` would make those two states
    // indistinguishable.
    ok = #expect(!add_animation(&frames, ""),
                 "the empty name was accepted as an animation") && ok
    ok = #expect(!has_animation(&frames, ""),
                 "and then it was there") && ok

    // Every reader answers a value for a name that is not there, so an
    // unguarded read is safe — `app:draw`'s overrun rule, one level up.
    ok = #expect(get_frame_count(&frames, "sprint") == 0,
                 "an unknown animation has ", get_frame_count(&frames, "sprint"),
                 " frames") && ok
    ok = #expect(get_frame(&frames, "sprint", 0) == -1,
                 "and no frame 0, got ", get_frame(&frames, "sprint", 0)) && ok
    ok = #expect(get_animation_speed(&frames, "sprint") == 0.0,
                 "and no speed, got ",
                 get_animation_speed(&frames, "sprint")) && ok
    ok = #expect(!get_animation_loop(&frames, "sprint"),
                 "and does not loop") && ok
    ok = #expect(!add_frame(&frames, "sprint", 0),
                 "a frame was appended to an animation that is not there") && ok

    // A frame index out of an animation's own range, at both ends.
    ok = #expect(get_frame_count(&frames, "loop4") == 4,
                 "loop4 holds ", get_frame_count(&frames, "loop4"),
                 " frames") && ok
    ok = #expect(get_frame(&frames, "loop4", 0) == 0
                 && get_frame(&frames, "loop4", 3) == 3,
                 "loop4's ends are ", get_frame(&frames, "loop4", 0), " and ",
                 get_frame(&frames, "loop4", 3)) && ok
    ok = #expect(get_frame(&frames, "loop4", 4) == -1
                 && get_frame(&frames, "loop4", -1) == -1,
                 "a frame outside the animation answered ",
                 get_frame(&frames, "loop4", 4)) && ok

    // `high3` is the one that proves a frame is a **sheet** index and an
    // animation's own index is something else: its three frames are 8, 9, 10.
    ok = #expect(get_frame(&frames, "high3", 0) == 8
                 && get_frame(&frames, "high3", 2) == 10,
                 "high3's frames are ", get_frame(&frames, "high3", 0), "..",
                 get_frame(&frames, "high3", 2)) && ok

    // A duplicate is refused rather than replacing, and refusing it changes
    // nothing about the animation already there.
    ok = #expect(!add_animation(&frames, "loop4", 99.0, false),
                 "a duplicate name was accepted") && ok
    ok = #expect(get_animation_speed(&frames, "loop4") == 10.0
                 && get_animation_loop(&frames, "loop4")
                 && get_frame_count(&frames, "loop4") == 4,
                 "and the refused duplicate overwrote the original: speed ",
                 get_animation_speed(&frames, "loop4")) && ok
    ok = #expect(animation_count(&frames) == 10,
                 "a refused duplicate grew the table to ",
                 animation_count(&frames)) && ok

    // The frames are a **list** and not a run, which is what lets a caller
    // write a ping-pong or hold a frame twice.
    ok = #expect(add_animation(&frames, "pingpong", 10.0, true), "pingpong") && ok
    ok = #expect(add_frame(&frames, "pingpong", 0)
                 && add_frame(&frames, "pingpong", 1)
                 && add_frame(&frames, "pingpong", 2)
                 && add_frame(&frames, "pingpong", 1),
                 "a hand-built animation was refused") && ok
    ok = #expect(get_frame_count(&frames, "pingpong") == 4
                 && get_frame(&frames, "pingpong", 3) == 1,
                 "pingpong is ", get_frame_count(&frames, "pingpong"),
                 " frames ending on ", get_frame(&frames, "pingpong", 3)) && ok

    // ── the two caps, and the name cap is a refusal and not a truncation ────

    SpriteFrames caps

    // `ANIMATION_NAME_MAX` bytes exactly fits; one more is refused. The two
    // names below share their first `ANIMATION_NAME_MAX` bytes on purpose:
    // that is the collision a truncating table would produce, and the whole
    // reason this one refuses.
    ok = #expect(ANIMATION_NAME_MAX == 24,
                 "the names below are written for a cap of 24, not ",
                 ANIMATION_NAME_MAX) && ok
    ok = #expect(add_animation(&caps, "abcdefghijklmnopqrstuvwx"),
                 "a name of exactly the cap was refused") && ok
    ok = #expect(has_animation(&caps, "abcdefghijklmnopqrstuvwx"),
                 "and then could not be found") && ok
    ok = #expect(!add_animation(&caps, "abcdefghijklmnopqrstuvwxy"),
                 "a name one byte over the cap was accepted") && ok
    ok = #expect(!has_animation(&caps, "abcdefghijklmnopqrstuvwxy"),
                 "and an over-long name matched its own truncation, which is ",
                 "the collision the refusal exists to prevent") && ok
    ok = #expect(animation_count(&caps) == 1,
                 "the over-long name landed anyway: ",
                 animation_count(&caps)) && ok

    // `MAX_ANIMATIONS`: fifteen more fill it and the seventeenth is refused.
    ok = #expect(MAX_ANIMATIONS == 16,
                 "the block below is written for a cap of 16, not ",
                 MAX_ANIMATIONS) && ok
    bool filled = add_animation(&caps, "n01") && add_animation(&caps, "n02")
    filled = filled && add_animation(&caps, "n03") && add_animation(&caps, "n04")
    filled = filled && add_animation(&caps, "n05") && add_animation(&caps, "n06")
    filled = filled && add_animation(&caps, "n07") && add_animation(&caps, "n08")
    filled = filled && add_animation(&caps, "n09") && add_animation(&caps, "n10")
    filled = filled && add_animation(&caps, "n11") && add_animation(&caps, "n12")
    filled = filled && add_animation(&caps, "n13") && add_animation(&caps, "n14")
    filled = filled && add_animation(&caps, "n15")
    ok = #expect(filled, "filling the table to its cap was refused early") && ok
    ok = #expect(animation_count(&caps) == 16,
                 "the table holds ", animation_count(&caps),
                 " where the cap is ", MAX_ANIMATIONS) && ok
    ok = #expect(!add_animation(&caps, "n16"),
                 "the animation past the cap was accepted") && ok
    ok = #expect(animation_count(&caps) == 16,
                 "and the table grew to ", animation_count(&caps)) && ok
    ok = #expect(!has_animation(&caps, "n16"),
                 "and the refused animation is findable") && ok

    // `MAX_FRAMES`: `add_frames` stops at the cap and reports what it stored,
    // rather than refusing the whole run or overrunning.
    SpriteFrames fcap
    ok = #expect(add_animation(&fcap, "long", 10.0, true), "long") && ok
    ok = #expect(add_frames(&fcap, "long", 0, MAX_FRAMES + 8) == MAX_FRAMES,
                 "a run past the frame cap stored ",
                 get_frame_count(&fcap, "long"), " frames") && ok
    ok = #expect(get_frame_count(&fcap, "long") == MAX_FRAMES,
                 "the animation holds ", get_frame_count(&fcap, "long")) && ok
    ok = #expect(get_frame(&fcap, "long", MAX_FRAMES - 1) == MAX_FRAMES - 1,
                 "and its last frame is ",
                 get_frame(&fcap, "long", MAX_FRAMES - 1)) && ok
    ok = #expect(!add_frame(&fcap, "long", 99),
                 "a frame past the cap was appended") && ok
    ok = #expect(get_frame_count(&fcap, "long") == MAX_FRAMES,
                 "and it grew the animation to ",
                 get_frame_count(&fcap, "long")) && ok
    ok = #expect(add_frames(&fcap, "long", 0, 0) == 0
                 && add_frames(&fcap, "long", 0, -3) == 0,
                 "a non-positive count appended something") && ok

    // The storage cost is a number rather than a promise.
    ok = #expect(FRAMES_BYTES == 2644,
                 "one SpriteFrames is ", FRAMES_BYTES,
                 " bytes, where the caps as written say 2644") && ok

    // ── one frame is one command, and it carries what it says it carries ────
    //
    // This is the read-back the package comment points at. The source is the
    // frame's pixel rectangle; the colour is the tint as written and is
    // multiplied by the item's own only at replay. The destination is where
    // `centered` shows up, so it is asserted in both settings.

    (draw.Canvas c1, draw.Item one) = solo()
    ok = #expect(draw.canvas_item_is_empty(one), "a fresh item holds nothing") && ok
    draw_frame(one, s, 6, 100.0, 40.0, 2.0, TINT, false, false, false)
    ok = #expect(draw.canvas_item_command_count(one) == 1,
                 "one frame is one command, got ",
                 draw.canvas_item_command_count(one)) && ok

    (i32 k0, draw.Texture t0, [4]f32 a0, [4]f32 b0, [4]u8 col0, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(one, 0)
    ok = #expect(k0 == draw.CMD_TEXTURE_RECT_REGION,
                 "and it is a texture region; got kind ", k0) && ok
    ok = #expect(t0 == tex, "over the sheet's own texture") && ok
    ok = #expect(b0 == [32.0, 16.0, 16.0, 16.0],
                 "frame 6 is column 2 row 1, so its source is 32,16 16x16; got ",
                 b0[0], ",", b0[1], " ", b0[2], "x", b0[3]) && ok
    ok = #expect(b0 == frame_src(s, 6),
                 "and it is exactly what frame_src answers") && ok
    ok = #expect(a0 == [100.0, 40.0, 32.0, 32.0],
                 "uncentered, the anchor is the top-left corner and the size is ",
                 "twice the frame's; got ", a0[0], ",", a0[1], " ", a0[2], "x",
                 a0[3]) && ok
    ok = #expect(col0 == TINT, "with the tint as written; got ", col0[0], " ",
                 col0[1], " ", col0[2]) && ok

    draw.canvas_render(c1, FB_W, FB_H)
    ok = #expect(draw.commands() == 1 && draw.primitives() == 1,
                 "one frame replays as one primitive; got ", draw.commands(),
                 " commands and ", draw.primitives(), " primitives") && ok
    ok = #expect(draw.state_changes() == 1,
                 "over one bind, got ", draw.state_changes()) && ok
    draw.canvas_free(c1)

    // ── centered is the default, and it moves the destination by a half ─────
    //
    // Godot's `Sprite2D.centered` defaults to true and so does this, so `(x, y)`
    // is where the frame's **centre** goes. The two commands below are the same
    // call with the one flag changed, and the destination moves by exactly half
    // the *scaled* extent — not half the frame, which is the mistake that looks
    // right at scale 1.

    (draw.Canvas c_ctr, draw.Item centred) = solo()
    draw_frame(centred, s, 6, 100.0, 40.0, 2.0, TINT)
    ok = #expect(draw.canvas_item_command_count(centred) == 1,
                 "a centred frame is still one command, got ",
                 draw.canvas_item_command_count(centred)) && ok
    (i32 kc, draw.Texture _, [4]f32 ac, [4]f32 bc, [4]u8 _, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(centred, 0)
    ok = #expect(ac == [84.0, 24.0, 32.0, 32.0],
                 "centered puts the 32x32 destination's centre on 100,40, so ",
                 "its corner is 84,24; got ", ac[0], ",", ac[1], " ", ac[2], "x",
                 ac[3]) && ok
    ok = #expect(ac[0] == a0[0] - a0[2] * 0.5 && ac[1] == a0[1] - a0[3] * 0.5,
                 "which is the uncentred corner less half the scaled extent; ",
                 "got ", ac[0], ",", ac[1], " against ", a0[0], ",", a0[1]) && ok
    ok = #expect(ac[2] == a0[2] && ac[3] == a0[3],
                 "and centering resized the sprite: ", ac[2], "x", ac[3]) && ok
    ok = #expect(kc == k0 && bc == b0,
                 "and centering touched the source rectangle") && ok
    draw.canvas_free(c_ctr)

    // ── offset is in sheet pixels and scale multiplies it ───────────────────
    //
    // Asserted at a scale that is not 1, because that is the only place the
    // claim is distinguishable from an offset in screen pixels — and it is the
    // case a 16x16 sprite drawn at 2x wants.

    (draw.Canvas c_off, draw.Item offs) = solo()
    draw_frame(offs, s, 6, 100.0, 40.0, 2.0, TINT, false, false, false,
               (3.0, -5.0))
    (i32 _, draw.Texture _, [4]f32 ao, [4]f32 _, [4]u8 _, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(offs, 0)
    ok = #expect(ao == [106.0, 30.0, 32.0, 32.0],
                 "an offset of 3,-5 sheet pixels at scale 2 moves the corner by ",
                 "6,-10; got ", ao[0], ",", ao[1], " ", ao[2], "x", ao[3]) && ok
    ok = #expect(ao[0] == a0[0] + 3.0 * 2.0 && ao[1] == a0[1] - 5.0 * 2.0,
                 "which is offset times scale and not offset; got ", ao[0], ",",
                 ao[1]) && ok

    // And the same offset with centering, to show the two compose rather than
    // one replacing the other.
    draw_frame(offs, s, 6, 100.0, 40.0, 2.0, TINT, false, false, true,
               (3.0, -5.0))
    (i32 _, draw.Texture _, [4]f32 aoc, [4]f32 _, [4]u8 _, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(offs, 1)
    ok = #expect(aoc == [90.0, 14.0, 32.0, 32.0],
                 "centered and offset is both: 100+6-16, 40-10-16; got ",
                 aoc[0], ",", aoc[1]) && ok
    ok = #expect(aoc[0] == ao[0] - 16.0 && aoc[1] == ao[1] - 16.0,
                 "so centering moved the offset rectangle by the same half; got ",
                 aoc[0], ",", aoc[1]) && ok

    // At scale 1 the offset is the offset, which is the other end of the claim.
    draw_frame(offs, s, 6, 100.0, 40.0, 1.0, TINT, false, false, false,
               (3.0, -5.0))
    (i32 _, draw.Texture _, [4]f32 ao1, [4]f32 _, [4]u8 _, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(offs, 2)
    ok = #expect(ao1 == [103.0, 35.0, 16.0, 16.0],
                 "at scale 1 the offset is 3,-5 exactly; got ", ao1[0], ",",
                 ao1[1], " ", ao1[2], "x", ao1[3]) && ok
    draw.canvas_free(c_off)

    // ── flip_h is a negative source width over the same destination ─────────
    //
    // The claim the package comment makes out of `sokol_gp.h`: the destination
    // quad is built from `dst` alone before the texture coordinates are
    // computed, and `tr = (src.x + src.w) * iw` puts a negative `src.w` to the
    // left of `tl`. So the mirrored command must differ in `b` and be identical
    // in everything else — same kind, same texture, same rectangle on screen,
    // and still exactly one command.

    (draw.Canvas c2, draw.Item flipped) = solo()
    draw_frame(flipped, s, 6, 100.0, 40.0, 2.0, TINT, true, false, false)
    ok = #expect(draw.canvas_item_command_count(flipped) == 1,
                 "a mirrored frame is still one command, got ",
                 draw.canvas_item_command_count(flipped)) && ok

    (i32 k1, draw.Texture t1, [4]f32 a1, [4]f32 b1, [4]u8 col1, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(flipped, 0)
    ok = #expect(b1[2] < 0.0,
                 "the mirrored source width is negative; got ", b1[2]) && ok
    ok = #expect(b1 == [48.0, 16.0, -16.0, 16.0],
                 "it starts at the frame's right edge and runs back; got ",
                 b1[0], ",", b1[1], " ", b1[2], "x", b1[3]) && ok
    ok = #expect(b1[0] + b1[2] == b0[0] && b1[0] == b0[0] + b0[2],
                 "so its two edges are the unflipped rect's, swapped; got ",
                 b1[0], " and ", b1[0] + b1[2]) && ok
    ok = #expect(a1 == a0,
                 "and the destination is untouched: the sprite mirrors in ",
                 "place rather than moving; got ", a1[0], ",", a1[1], " ",
                 a1[2], "x", a1[3]) && ok
    ok = #expect(k1 == k0 && t1 == t0 && col1 == col0,
                 "and nothing else about the command moved") && ok

    draw.canvas_render(c2, FB_W, FB_H)
    ok = #expect(draw.primitives() == 1,
                 "a mirror costs no second primitive; got ",
                 draw.primitives()) && ok
    draw.canvas_free(c2)

    // ── flip_v is the same mechanism on the other axis ──────────────────────
    //
    // `tb = (src.y + src.h) * ih` puts a negative `src.h` above `tt`, exactly as
    // a negative `src.w` puts `tr` left of `tl` — the two appear once each and
    // in the same form at lines 3118 and 3119, which is what was read rather
    // than assumed. So: negative height, untouched destination, one command.

    (draw.Canvas c_v, draw.Item vflipped) = solo()
    draw_frame(vflipped, s, 6, 100.0, 40.0, 2.0, TINT, false, true, false)
    ok = #expect(draw.canvas_item_command_count(vflipped) == 1,
                 "a vertically mirrored frame is still one command, got ",
                 draw.canvas_item_command_count(vflipped)) && ok
    (i32 kv, draw.Texture tv, [4]f32 av, [4]f32 bv, [4]u8 colv, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(vflipped, 0)
    ok = #expect(bv[3] < 0.0,
                 "the mirrored source height is negative; got ", bv[3]) && ok
    ok = #expect(bv == [32.0, 32.0, 16.0, -16.0],
                 "it starts at the frame's bottom edge and runs up; got ",
                 bv[0], ",", bv[1], " ", bv[2], "x", bv[3]) && ok
    ok = #expect(bv[1] + bv[3] == b0[1] && bv[1] == b0[1] + b0[3],
                 "so its two edges are the unflipped rect's, swapped; got ",
                 bv[1], " and ", bv[1] + bv[3]) && ok
    ok = #expect(bv[0] == b0[0] && bv[2] == b0[2],
                 "and the horizontal edges did not move; got ", bv[0], " ",
                 bv[2]) && ok
    ok = #expect(av == a0,
                 "and the destination is untouched here too; got ", av[0], ",",
                 av[1], " ", av[2], "x", av[3]) && ok
    ok = #expect(kv == k0 && tv == t0 && colv == col0,
                 "and nothing else about the command moved") && ok

    // Both at once is the 180 degree turn, and is still one command with the
    // same destination: the two flips touch disjoint slots of `src`.
    draw_frame(vflipped, s, 6, 100.0, 40.0, 2.0, TINT, true, true, false)
    (i32 _, draw.Texture _, [4]f32 ahv, [4]f32 bhv, [4]u8 _, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(vflipped, 1)
    ok = #expect(bhv == [48.0, 32.0, -16.0, -16.0],
                 "both flips is both negatives from the far corner; got ",
                 bhv[0], ",", bhv[1], " ", bhv[2], "x", bhv[3]) && ok
    ok = #expect(bhv[0] == b1[0] && bhv[2] == b1[2]
                 && bhv[1] == bv[1] && bhv[3] == bv[3],
                 "and it is exactly the two one-axis answers combined") && ok
    ok = #expect(ahv == a0,
                 "with the destination still untouched; got ", ahv[0], ",",
                 ahv[1]) && ok

    draw.canvas_render(c_v, FB_W, FB_H)
    ok = #expect(draw.primitives() == 2 && draw.state_changes() == 1,
                 "two mirrors are two primitives in one bind; got ",
                 draw.primitives(), " and ", draw.state_changes()) && ok
    draw.canvas_free(c_v)

    // ── what draw_frame refuses, and refuses by recording nothing ───────────

    (draw.Canvas c3, draw.Item refused) = solo()
    draw_frame(refused, s, 12, 0.0, 0.0, 1.0, WHITE)
    draw_frame(refused, s, -1, 0.0, 0.0, 1.0, WHITE)
    ok = #expect(draw.canvas_item_command_count(refused) == 0,
                 "an index outside the sheet recorded ",
                 draw.canvas_item_command_count(refused), " commands") && ok

    draw_frame(refused, s, 0, 0.0, 0.0, 0.0, WHITE)
    draw_frame(refused, s, 0, 0.0, 0.0, -1.0, WHITE)
    draw_frame(refused, s, 0, 0.0, 0.0, -1.0, WHITE, true, true)
    ok = #expect(draw.canvas_item_command_count(refused) == 0,
                 "a scale that is not positive recorded ",
                 draw.canvas_item_command_count(refused),
                 " commands — mirroring is flip_h and flip_v's job") && ok
    draw.canvas_free(c3)

    // A dead item drops the command, as everywhere in this surface.
    draw_frame(draw.NIL_ITEM, s, 0, 0.0, 0.0, 1.0, WHITE)

    // ── a looping animation wraps ──────────────────────────────────────────
    //
    // Four frames at 10 fps: one frame every 100 ms. Walking it a frame at a
    // time must give 0, 1, 2, 3, 0 — the last of those is the whole point, and
    // it is where `i32(clock * fps)` with no wrap gives 4 and an animation
    // index nobody has.

    AnimatedSprite a = animated_sprite()
    ok = #expect(a.speed_scale == 1.0 && a.centered && !a.flip_h && !a.flip_v
                 && a.offset == [0.0, 0.0] && a.animation == -1 && !a.playing,
                 "animated_sprite() is not Godot's defaults: speed_scale ",
                 a.speed_scale, " centered ", a.centered) && ok

    play(&a, &frames, "loop4")
    ok = #expect(a.frame == 0 && !a.finished && is_playing(&a),
                 "play starts at the first frame, got ", a.frame) && ok
    for i in 0..<3:
        advance(&a, &frames, 0.1)
        ok = #expect(a.frame == i32(i) + 1,
                     "step ", i32(i) + 1, " should be frame ", i32(i) + 1,
                     ", got ", a.frame) && ok
    advance(&a, &frames, 0.1)
    ok = #expect(a.frame == 0, "the fifth step wraps to 0, got ", a.frame) && ok
    ok = #expect(!a.finished, "and a looping animation never finishes") && ok

    // A step of many frames wraps the same way a run of single steps does —
    // the modulo is over the whole step and not applied one frame at a time.
    play_from_start(&a, &frames, "loop4")
    advance(&a, &frames, 0.1 * 9.0)
    ok = #expect(a.frame == 1,
                 "nine frames of a four-frame loop lands on 1, got ",
                 a.frame) && ok

    // `frame` is the animation's index and `sheet_frame` is the cell — which
    // are the same number only when an animation starts at sheet frame 0.
    // `high3` walks 8, 9, 10, so the two disagree at every step.
    play(&a, &frames, "high3")
    ok = #expect(a.frame == 0 && sheet_frame(&frames, &a) == 8,
                 "high3 starts at animation frame ", a.frame, " and sheet frame ",
                 sheet_frame(&frames, &a)) && ok
    advance(&a, &frames, 0.3)
    ok = #expect(a.frame == 0 && sheet_frame(&frames, &a) == 8,
                 "and wraps back to it, got ", a.frame, "/",
                 sheet_frame(&frames, &a)) && ok
    advance(&a, &frames, 0.2)
    ok = #expect(a.frame == 2 && sheet_frame(&frames, &a) == 10,
                 "two more frames is animation 2 and sheet 10, got ", a.frame,
                 "/", sheet_frame(&frames, &a)) && ok

    // A `frame` a client wrote outside the animation restarts from the top
    // rather than computing an offset from a frame the animation has not got.
    // `high3` holds three frames, so `3` is the first index it has not got —
    // the end a `>` in place of a `>=` would read as inside.
    a.frame = 3
    ok = #expect(sheet_frame(&frames, &a) == -1,
                 "the frame one past the animation resolves to ",
                 sheet_frame(&frames, &a)) && ok
    a.frame = 100
    ok = #expect(sheet_frame(&frames, &a) == -1,
                 "a frame far outside the animation resolves to ",
                 sheet_frame(&frames, &a)) && ok
    a.frame = -5
    ok = #expect(sheet_frame(&frames, &a) == -1,
                 "and a negative one resolves to ",
                 sheet_frame(&frames, &a)) && ok
    // 100 is chosen rather than a multiple of the count: an implementation that
    // walked on from the out-of-range value instead of restarting would answer
    // `(100 + 1) % 3 == 2` here, and `(99 + 1) % 3 == 1` — the right answer by
    // coincidence — for the value that reads more naturally.
    a.frame = 100
    advance(&a, &frames, 0.1)
    ok = #expect(a.frame == 1,
                 "one step from past the end should restart at frame 1, got ",
                 a.frame) && ok
    a.frame = -5
    advance(&a, &frames, 0.1)
    ok = #expect(a.frame == 1,
                 "and one step from before the start too, got ", a.frame) && ok

    // ── a non-looping animation finishes, and stays finished ───────────────
    //
    // It stops **on** its last frame rather than past it, so the pose a death
    // animation ended on keeps being drawn, and a later `advance` does not
    // start it moving again.

    play(&a, &frames, "once3")
    ok = #expect(!a.finished && is_playing(&a),
                 "a fresh animation is not finished") && ok
    advance(&a, &frames, 0.1)
    advance(&a, &frames, 0.1)
    ok = #expect(a.frame == 2 && !a.finished,
                 "two steps is the last frame and not yet finished; got frame ",
                 a.frame, " finished ", a.finished) && ok
    ok = #expect(sheet_frame(&frames, &a) == 3,
                 "which is sheet frame 3, got ",
                 sheet_frame(&frames, &a)) && ok
    advance(&a, &frames, 0.1)
    ok = #expect(a.finished, "the step past the end finishes it") && ok
    ok = #expect(!is_playing(&a), "and stops it playing") && ok
    ok = #expect(a.frame == 2,
                 "and leaves it on the last frame, got ", a.frame) && ok
    for i in 0..<5:
        advance(&a, &frames, 1.0)
    ok = #expect(a.finished && a.frame == 2,
                 "five more seconds changed it: finished ", a.finished,
                 " frame ", a.frame) && ok

    // ── one big step lands where many small ones do ────────────────────────
    //
    // The property that makes an animation look the same on a fast machine and
    // a slow one. It is asserted twice, and the two halves test different
    // things.
    //
    // **Exactly.** 16 fps stepped by 1/128 s: every quantity in `advance` is a
    // dyadic rational `f32` holds exactly, so the two paths agree on the frame
    // *and* on the residual clock, bit for bit. That is the algorithm checked
    // with the floating point taken out.

    AnimatedSprite small = animated_sprite()
    AnimatedSprite big = animated_sprite()
    play(&small, &frames, "exact7")
    play(&big, &frames, "exact7")
    for i in 0..<1280:
        advance(&small, &frames, 0.0078125)
    advance(&big, &frames, 10.0)
    ok = #expect(small.frame == big.frame,
                 "1280 steps of 1/128s landed on frame ", small.frame,
                 " and one 10s step on ", big.frame) && ok
    ok = #expect(small.clock == big.clock,
                 "and their clocks differ: ", small.clock, " vs ",
                 big.clock) && ok
    // 160 frames of a seven-frame loop is six, which is neither zero nor the
    // last frame — so the agreement above is not two zeroes agreeing.
    ok = #expect(big.frame == 6,
                 "ten seconds at 16 fps is 160 frames, which is 6 of 7; got ",
                 big.frame) && ok

    // **Realistically.** 12.05 fps stepped by 10 ms, neither exact in binary.
    // The fps is chosen so that ten seconds is 120.5 frames and not a whole
    // number: a test sitting exactly on a frame boundary measures `f32`'s
    // rounding rather than this function.

    AnimatedSprite rsmall = animated_sprite()
    AnimatedSprite rbig = animated_sprite()
    play(&rsmall, &frames, "real7")
    play(&rbig, &frames, "real7")
    for i in 0..<1000:
        advance(&rsmall, &frames, 0.01)
    advance(&rbig, &frames, 10.0)
    ok = #expect(rsmall.frame == rbig.frame,
                 "a thousand 10ms steps landed on frame ", rsmall.frame,
                 " and one 10s step on ", rbig.frame) && ok
    ok = #expect(near(rsmall.clock, rbig.clock, 0.001),
                 "and their clocks are ", rsmall.clock, " and ",
                 rbig.clock) && ok
    ok = #expect(rbig.frame == 1,
                 "120 frames of a seven-frame loop is 1; got ", rbig.frame) && ok

    // And the clock stays a remainder rather than growing, which is the whole
    // reason the two agree at all: it is what a minute of play does not erode.
    ok = #expect(rbig.clock >= 0.0 && rbig.clock < 1.0 / 12.05,
                 "the clock left the frame it lives in: ", rbig.clock) && ok

    // ── speed_scale multiplies the animation's own rate ─────────────────────
    //
    // The rate `advance` uses is the product, read out of both on every call.
    // `scaled` runs at 10 fps, so at 2x a frame is 50 ms and at 0.5x it is
    // 200 ms — and the same `dt` that is one frame at 2x is a quarter of one at
    // 0.5x, which is what makes this a test of the product and not of either
    // number.

    AnimatedSprite fast = animated_sprite()
    set_speed_scale(&fast, 2.0)
    play(&fast, &frames, "scaled")
    advance(&fast, &frames, 0.05)
    ok = #expect(fast.frame == 1,
                 "10 fps at 2x is a frame every 50ms; got frame ",
                 fast.frame) && ok
    advance(&fast, &frames, 0.25)
    ok = #expect(fast.frame == 2,
                 "five more frames of a four-frame loop is 2; got ",
                 fast.frame) && ok

    AnimatedSprite slow = animated_sprite()
    set_speed_scale(&slow, 0.5)
    play(&slow, &frames, "scaled")
    advance(&slow, &frames, 0.1)
    ok = #expect(slow.frame == 0,
                 "10 fps at 0.5x has not reached a frame in 100ms; got ",
                 slow.frame) && ok
    ok = #expect(near(slow.clock, 0.1, 0.0001),
                 "and the 100ms is still on the clock; got ", slow.clock) && ok
    advance(&slow, &frames, 0.1)
    ok = #expect(slow.frame == 1,
                 "200ms is one frame at 0.5x; got ", slow.frame) && ok

    // The product is the product: the same total time at half speed lands where
    // half the time at full speed does.
    AnimatedSprite ref_speed = animated_sprite()
    play(&ref_speed, &frames, "scaled")
    advance(&ref_speed, &frames, 0.35)
    advance(&slow, &frames, 0.5)
    ok = #expect(slow.frame == ref_speed.frame,
                 "0.7s at 0.5x should land where 0.35s at 1x does; got ",
                 slow.frame, " and ", ref_speed.frame) && ok

    // A zero `speed_scale` freezes without stopping: the sprite is running at
    // no rate, which is not the same state as `pause`.
    AnimatedSprite frozen = animated_sprite()
    set_speed_scale(&frozen, 0.0)
    play(&frozen, &frames, "scaled")
    advance(&frozen, &frames, 100.0)
    ok = #expect(frozen.frame == 0 && !frozen.finished,
                 "a 0x sprite moved to frame ", frozen.frame) && ok
    ok = #expect(frozen.clock == 0.0,
                 "a 0x sprite moved its clock to ", frozen.clock) && ok
    ok = #expect(is_playing(&frozen),
                 "and a rate of zero is not a stop") && ok
    // And unfreezing it resumes from exactly there rather than from a clock
    // that had been quietly accumulating.
    set_speed_scale(&frozen, 1.0)
    advance(&frozen, &frames, 0.1)
    ok = #expect(frozen.frame == 1,
                 "unfreezing it stepped to ", frozen.frame) && ok

    // A negative `speed_scale` is floored to zero by the setter, which is the
    // same floor `set_animation_speed` applies and for the same reason.
    AnimatedSprite backwards_scale = animated_sprite()
    set_speed_scale(&backwards_scale, -4.0)
    ok = #expect(backwards_scale.speed_scale == 0.0,
                 "a negative speed_scale is floored, got ",
                 backwards_scale.speed_scale) && ok

    // ── a zero-speed animation is a still frame ────────────────────────────

    play(&a, &frames, "still")
    advance(&a, &frames, 100.0)
    ok = #expect(a.frame == 0 && sheet_frame(&frames, &a) == 5 && !a.finished,
                 "a 0 fps animation stayed on ", a.frame, " and finished ",
                 a.finished) && ok
    // **And its clock does not move either**, which is the half a frame check
    // cannot see. `advance` returns before it divides by the rate; an
    // implementation that fell through would compute `steps / 0.0` and leave a
    // NaN here, and every later comparison against that clock would answer
    // false without the frame ever moving. `a.clock == 0.0` is false for a NaN,
    // which is what makes this the assertion that catches it.
    ok = #expect(a.clock == 0.0,
                 "a 0 fps animation moved its clock to ", a.clock) && ok
    // A negative speed means the same thing, because `add_animation` floors it.
    ok = #expect(get_animation_speed(&frames, "backwards") == 0.0,
                 "a negative speed is floored to a still frame, got ",
                 get_animation_speed(&frames, "backwards")) && ok
    play(&a, &frames, "backwards")
    advance(&a, &frames, 100.0)
    ok = #expect(a.frame == 0 && !a.finished && a.clock == 0.0,
                 "and it does not move either; got frame ", a.frame, " clock ",
                 a.clock) && ok
    // `set_animation_speed` floors the same way, and takes effect at once.
    set_animation_speed(&frames, "backwards", -1.0)
    ok = #expect(get_animation_speed(&frames, "backwards") == 0.0,
                 "the setter did not floor: ",
                 get_animation_speed(&frames, "backwards")) && ok
    set_animation_speed(&frames, "backwards", 10.0)
    advance(&a, &frames, 0.1)
    ok = #expect(a.frame == 1,
                 "a speed change did not take effect on the next tick; got ",
                 a.frame) && ok

    // A dt that is zero or negative does nothing at all.
    play_from_start(&a, &frames, "loop4")
    advance(&a, &frames, 0.0)
    advance(&a, &frames, -5.0)
    ok = #expect(a.frame == 0 && a.clock == 0.0,
                 "a non-positive dt moved the clock to ", a.clock,
                 " and the frame to ", a.frame) && ok

    // ── an animation with no frames ────────────────────────────────────────
    //
    // Finished the moment it is played, looping or not: `finished` means there
    // is nothing more to show, and an animation of no frames has nothing at
    // all. And it records nothing, because there is no frame to record.

    play(&a, &frames, "empty")
    ok = #expect(a.finished,
                 "an animation of no frames is finished even though it loops") && ok
    ok = #expect(!is_playing(&a), "and is not playing") && ok
    advance(&a, &frames, 1.0)
    ok = #expect(a.finished, "and stays finished") && ok
    ok = #expect(sheet_frame(&frames, &a) == -1,
                 "and resolves to no sheet frame, got ",
                 sheet_frame(&frames, &a)) && ok

    // The same rule reached from the other side, and the one case `play` does
    // not already cover: a sprite advanced against a **different** resource,
    // whose animation at that slot has no frames. `advance` is what has to
    // notice, because nothing played this sprite against `caps` — it stops and
    // finishes rather than running on a count it no longer has. `caps` holds
    // sixteen animations and no frames at all, so every slot of it is empty.
    AnimatedSprite crossed = animated_sprite()
    play(&crossed, &frames, "loop4")
    advance(&crossed, &frames, 0.15)
    ok = #expect(crossed.frame == 1 && crossed.clock > 0.0 && is_playing(&crossed),
                 "mid-frame and playing, got frame ", crossed.frame, " clock ",
                 crossed.clock) && ok
    advance(&crossed, &caps, 1.0)
    ok = #expect(crossed.finished && !is_playing(&crossed),
                 "advancing against a resource with no frames left it finished ",
                 crossed.finished, " playing ", is_playing(&crossed)) && ok
    ok = #expect(crossed.clock == 0.0,
                 "and its clock at ", crossed.clock) && ok

    (draw.Canvas c4, draw.Item nothing_item) = solo()
    draw_animated(nothing_item, s, &frames, &a, 0.0, 0.0, 1.0, WHITE)
    ok = #expect(draw.canvas_item_is_empty(nothing_item),
                 "an animation of no frames recorded ",
                 draw.canvas_item_command_count(nothing_item), " commands") && ok
    ^AnimatedSprite none
    draw_animated(nothing_item, s, &frames, none, 0.0, 0.0, 1.0, WHITE)
    ok = #expect(draw.canvas_item_is_empty(nothing_item),
                 "and a nil sprite recorded ",
                 draw.canvas_item_command_count(nothing_item), " commands") && ok
    ^SpriteFrames nof
    draw_animated(nothing_item, s, nof, &a, 0.0, 0.0, 1.0, WHITE)
    ok = #expect(draw.canvas_item_is_empty(nothing_item),
                 "and a nil resource recorded ",
                 draw.canvas_item_command_count(nothing_item), " commands") && ok
    advance(none, &frames, 0.1)
    advance(&a, nof, 0.1)
    draw.canvas_free(c4)

    // ── play continues, play_from_start restarts ───────────────────────────
    //
    // Godot's `play` reaches `set_animation`, which returns early when the name
    // is already set — so calling it every tick of a walk is how a walk is
    // written, and the restart has its own name.

    play_from_start(&a, &frames, "loop4")
    advance(&a, &frames, 0.25)
    ok = #expect(a.frame == 2, "two and a half frames in, got ", a.frame) && ok
    f32 mid = a.clock
    ok = #expect(mid > 0.0, "and mid-frame, with a clock of ", mid) && ok

    play(&a, &frames, "loop4")
    ok = #expect(a.frame == 2 && a.clock == mid,
                 "play on the current animation moved it to frame ", a.frame,
                 " clock ", a.clock) && ok

    // The same animation at a different speed is the same animation: the new
    // speed applies and the clock is kept, because speed lives in the resource
    // and `play` compares the animation and not its data.
    set_animation_speed(&frames, "loop4", 20.0)
    play(&a, &frames, "loop4")
    ok = #expect(a.frame == 2 && a.clock == mid,
                 "a speed change restarted the animation: frame ", a.frame,
                 " clock ", a.clock) && ok
    ok = #expect(get_animation_speed(&frames, "loop4") == 20.0,
                 "and the new speed did not take: ",
                 get_animation_speed(&frames, "loop4")) && ok
    set_animation_speed(&frames, "loop4", 10.0)

    // A different animation is a different animation and does restart.
    play(&a, &frames, "once3")
    ok = #expect(a.frame == 0 && a.clock == 0.0,
                 "play onto another animation should restart; got frame ",
                 a.frame, " clock ", a.clock) && ok

    // `play_from_start` restarts whatever is playing, which is what a
    // retriggered hit reaction needs and what `play` refuses to do.
    advance(&a, &frames, 0.1)
    ok = #expect(a.frame == 1, "one step in, got ", a.frame) && ok
    play_from_start(&a, &frames, "once3")
    ok = #expect(a.frame == 0 && a.clock == 0.0 && !a.finished,
                 "play_from_start on the same animation should snap back; got ",
                 "frame ", a.frame, " clock ", a.clock) && ok

    // An unknown name leaves the sprite alone rather than stopping it.
    advance(&a, &frames, 0.1)
    play(&a, &frames, "sprint")
    ok = #expect(a.frame == 1 && is_playing(&a),
                 "an unknown name disturbed the sprite: frame ", a.frame,
                 " playing ", is_playing(&a)) && ok
    ok = #expect(strings_equal(animation_name(&a, &frames), "once3"),
                 "and moved the animation off once3") && ok
    play_from_start(&a, &frames, "sprint")
    ok = #expect(a.frame == 1,
                 "play_from_start on an unknown name restarted it anyway; got ",
                 a.frame) && ok

    // ── stop rewinds, pause does not, and the name is a lookup ─────────────

    play_from_start(&a, &frames, "loop4")
    advance(&a, &frames, 0.25)
    ok = #expect(a.frame == 2 && a.clock > 0.0, "mid-frame, got ", a.frame) && ok
    f32 paused = a.clock
    pause(&a)
    ok = #expect(!is_playing(&a), "pause left it playing") && ok
    advance(&a, &frames, 1.0)
    ok = #expect(a.frame == 2 && a.clock == paused,
                 "a paused sprite advanced to frame ", a.frame) && ok
    play(&a, &frames, "loop4")
    ok = #expect(is_playing(&a) && a.frame == 2 && a.clock == paused,
                 "resuming a pause lost the position: frame ", a.frame) && ok

    stop(&a)
    ok = #expect(!is_playing(&a) && a.frame == 0 && a.clock == 0.0,
                 "stop did not rewind: frame ", a.frame, " clock ",
                 a.clock) && ok
    ok = #expect(strings_equal(animation_name(&a, &frames), "loop4"),
                 "and stop forgot which animation was playing") && ok

    ok = #expect(strings_equal(animation_name(&a, &frames), "loop4"),
                 "the current animation's name is not loop4") && ok
    AnimatedSprite fresh = animated_sprite()
    ok = #expect(strings_equal(animation_name(&fresh, &frames), ""),
                 "a sprite with no animation named one") && ok
    ok = #expect(strings_equal(animation_name(&fresh, &caps), ""),
                 "and a sprite read against another resource named one") && ok

    // ── draw_animated draws the frame the clock is on, and does not advance ─

    (draw.Canvas c5, draw.Item hero) = solo()
    play_from_start(&a, &frames, "loop4")
    advance(&a, &frames, 0.2)
    ok = #expect(a.frame == 2, "the sprite is on frame 2, got ", a.frame) && ok
    a.centered = false

    draw_animated(hero, s, &frames, &a, 10.0, 20.0, 1.0, WHITE)
    ok = #expect(a.frame == 2 && a.clock == 0.0,
                 "recording advanced the sprite: frame ", a.frame, " clock ",
                 a.clock) && ok
    ok = #expect(draw.canvas_item_command_count(hero) == 1,
                 "one sprite is one command, got ",
                 draw.canvas_item_command_count(hero)) && ok
    (i32 k2, draw.Texture _, [4]f32 a2, [4]f32 b2, [4]u8 _, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(hero, 0)
    ok = #expect(k2 == draw.CMD_TEXTURE_RECT_REGION && b2 == frame_src(s, 2),
                 "and it carries frame 2's source rect; got ", b2[0], ",",
                 b2[1]) && ok
    ok = #expect(a2 == [10.0, 20.0, 16.0, 16.0],
                 "at the anchor, unscaled; got ", a2[2], "x", a2[3]) && ok

    // It reads the sprite's own flip, centering and offset rather than taking
    // them as arguments — which is the whole of what `AnimatedSprite` is for.
    a.flip_h = true
    a.flip_v = true
    a.centered = true
    a.offset = (1.0, 2.0)
    draw_animated(hero, s, &frames, &a, 10.0, 20.0, 2.0, WHITE)
    (i32 _, draw.Texture _, [4]f32 a3, [4]f32 b3, [4]u8 _, f32 _, i32 _,
     i32 _) = draw.canvas_item_command(hero, 1)
    ok = #expect(b3 == [48.0, 16.0, -16.0, -16.0],
                 "the sprite's own flips did not reach the command; got ",
                 b3[0], ",", b3[1], " ", b3[2], "x", b3[3]) && ok
    ok = #expect(a3 == [-4.0, 8.0, 32.0, 32.0],
                 "the sprite's own centering and offset did not: 10+2-16, ",
                 "20+4-16; got ", a3[0], ",", a3[1], " ", a3[2], "x",
                 a3[3]) && ok
    a.flip_h = false
    a.flip_v = false
    a.centered = false
    a.offset = (0.0, 0.0)

    // Ten more recordings of the same item are ten more commands and still the
    // same frame: the clock is the simulation's and the tape is the renderer's.
    for i in 0..<10:
        draw_animated(hero, s, &frames, &a, 10.0, 20.0, 1.0, WHITE)
    ok = #expect(a.frame == 2,
                 "twelve recordings moved the sprite to ", a.frame) && ok
    ok = #expect(draw.canvas_item_command_count(hero) == 12,
                 "and recorded ", draw.canvas_item_command_count(hero),
                 " commands") && ok

    draw.canvas_render(c5, FB_W, FB_H)
    ok = #expect(draw.primitives() == 12,
                 "twelve frames of one sheet is twelve primitives, got ",
                 draw.primitives()) && ok
    ok = #expect(draw.state_changes() == 1,
                 "in one bind, got ", draw.state_changes()) && ok
    draw.canvas_free(c5)

    if g_scratch != nil:
        #delete(g_scratch)
        g_scratch = nil
    draw.shutdown()
    if ok:
        return 0
    return 1

// Byte equality over two `string`s. `core:strings` answers an ordering and this
// file only ever asks whether two names are the same, so the comparison is
// written once here rather than spelled `compare(...) == 0` at a dozen sites.
private bool strings_equal(string8 a, string8 b):
    if #len(a) != #len(b):
        return false
    for i in 0..<i32(#len(a)):
        if a[i] != b[i]:
            return false
    return true
