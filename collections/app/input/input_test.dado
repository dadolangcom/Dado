@test
// app:input unit test — the queue: push/deliver/poll ordering (FIFO), partial
// drains, the frame as a snapshot, and overflow dropping. Capability-gating of `poll` (empty
// on a backend without `Input`) is covered end-to-end by example/skeleton, since
// it needs a backend installed; here we install a minimal one advertising `Input`
// so `poll` runs. `push`/`poll`/`pending` are not builtins, so they call bare.
package input

import "app:app"

// A path longer than the table holds, and a drop wider than it holds — each
// one past the clamp it is there to exercise.
private const i32 OVERLONG = DROP_PATH_MAX + 8
private const i32 TOO_MANY = MAX_DROPPED + 3

private void nb_run():   return
private void nb_step():  return

// What a frame does with the queue: the runtime's `deliver` at its top, then
// the program's `poll`. Every drain in this suite goes through both, since no
// runtime is running here to make the first call.
private i32 take([]Event out):
    deliver()
    return poll(out)

i32 test():
    // a headless backend advertising Input, so poll() is not gated off
    app.set_backend((nil, nb_run, nb_step, nb_step, app.caps(app.Capability.Input),
                     nil, nil, nil, nil, nil))

    bool ok = true

    // FIFO order and codes survive the round trip
    push_key(i32('a'))
    push_key(i32('b'))
    push_key(i32('c'))
    ok = #expect(pending() == 3, "pending after 3 pushes = ", pending()) && ok

    [2]Event two
    i32 n = take(two[:])
    ok = #expect(n == 2, "partial drain returned ", n) && ok
    ok = #expect(two[0].kind == EventKind.Key, "kind is Key") && ok
    ok = #expect(two[0].code == i32('a'), "first code = ", two[0].code) && ok
    ok = #expect(two[1].code == i32('b'), "second code = ", two[1].code) && ok
    ok = #expect(pending() == 1, "one left = ", pending()) && ok

    [8]Event rest
    i32 m = take(rest[:])
    ok = #expect(m == 1, "drained last ", m) && ok
    ok = #expect(rest[0].code == i32('c'), "last code = ", rest[0].code) && ok
    ok = #expect(pending() == 0, "empty now = ", pending()) && ok

    // draining an empty queue is a safe no-op
    i32 z = take(rest[:])
    ok = #expect(z == 0, "empty poll = ", z) && ok

    // ── the frame is a snapshot ─────────────────────────────────────────
    //
    // `deliver` takes what is queued; an event pushed after it waits for the
    // next frame however often `poll` is asked, and what a frame's `poll`s
    // left unread comes out first next frame, ahead of the new delivery.
    push_key(i32('d'))
    push_key(i32('e'))
    deliver()
    push_key(i32('f'))
    [8]Event fr
    i32 snap_a = poll(fr[:])
    ok = #expect(snap_a == 2 && fr[0].code == i32('d') && fr[1].code == i32('e'),
                 "the frame holds what was delivered, got ", snap_a) && ok
    ok = #expect(poll(fr[:]) == 0, "a second poll in the frame sees nothing pushed since") && ok
    ok = #expect(pending() == 1, "which is still pending, got ", pending()) && ok
    deliver()
    [2]Event lone_buf
    []Event lone = lone_buf[0..<1]
    ok = #expect(poll(lone) == 1 && lone[0].code == i32('f'), "and arrives next frame") && ok
    push_key(i32('g'))
    push_key(i32('h'))
    push_key(i32('i'))
    deliver()
    ok = #expect(poll(lone) == 1 && lone[0].code == i32('g'), "a partial poll takes the first") && ok
    push_key(i32('j'))
    deliver()
    i32 snap_b = poll(fr[:])
    ok = #expect(snap_b == 3 && fr[0].code == i32('h') && fr[1].code == i32('i') && fr[2].code == i32('j'),
                 "the unread ones lead the next frame, in order, got ", snap_b) && ok
    ok = #expect(pending() == 0, "empty again = ", pending()) && ok

    // The convenience pushers — each fills the shape push_key already
    // fills for Key, so this checks the wiring, not the ring buffer again.
    push_key(i32('Q'), u32(Modifier.Ctrl))
    push_text(233)                          // 'é'
    push_mouse(1, 5.5, 7.25, u32(Modifier.Rmb))
    push_resize(80, 24)
    push_quit()
    push_focus(true)
    push_focus(false)
    [2]string8 one_path
    one_path[0] = "/tmp/dropped.txt"
    push_drop(one_path[0..<1])
    [8]Event five
    i32 f = take(five[:])
    ok = #expect(f == 8, "8 convenience pushes drain as 8, got ", f) && ok
    ok = #expect(five[0].kind == EventKind.Key && five[0].code == i32('Q') && five[0].mods == u32(Modifier.Ctrl), "push_key with mods") && ok
    ok = #expect(five[1].kind == EventKind.Text && five[1].code == 233, "push_text") && ok
    // C5b: x/y are f32, so a sub-pixel position survives the round trip.
    ok = #expect(five[2].kind == EventKind.Mouse && five[2].code == 1 && five[2].x == 5.5 && five[2].y == 7.25 && five[2].mods == u32(Modifier.Rmb), "push_mouse") && ok
    ok = #expect(five[3].kind == EventKind.Resize && i32(five[3].x) == 80 && i32(five[3].y) == 24, "push_resize") && ok
    ok = #expect(five[4].kind == EventKind.Quit, "push_quit") && ok
    // push_focus takes a bool; FOCUS_LOST is this package's packing and the
    // round trip is what proves the bool reaches the bit and no other field.
    ok = #expect(five[5].kind == EventKind.Focus && five[5].mods == 0,
                 "push_focus(true) is a Focus with no flag, mods = ", five[5].mods) && ok
    ok = #expect(five[6].kind == EventKind.Focus && five[6].mods == FOCUS_LOST,
                 "push_focus(false) sets FOCUS_LOST, mods = ", five[6].mods) && ok
    // push_drop takes the paths; `code` carries how many landed and the paths
    // themselves are in the package table, reached through the two readers.
    ok = #expect(five[7].kind == EventKind.Drop && five[7].code == 1,
                 "push_drop is a Drop claiming 1 path, code = ", five[7].code) && ok
    ok = #expect(dropped_count(five[7]) == 1,
                 "dropped_count = ", dropped_count(five[7])) && ok
    ok = #expect(dropped_path(five[7], 0) == "/tmp/dropped.txt",
                 "the path survived the ring buffer, got ", dropped_path(five[7], 0)) && ok

    // ── E1: a Text event carries modifiers, and `is_typed_text` reads them ──
    //
    // `push_text` grew a `mods` parameter; the round trip is what proves the
    // field is not dropped on the way through the ring buffer.
    push_text(i32('z'), u32(Modifier.Ctrl))
    push_text(i32('z'), 0)
    [4]Event tv
    i32 t = take(tv[:])
    ok = #expect(t == 2, "two text pushes drain as 2, got ", t) && ok
    ok = #expect(tv[0].mods == u32(Modifier.Ctrl),
                 "Text carries its modifiers, mods = ", tv[0].mods) && ok
    ok = #expect(!is_typed_text(tv[0]), "Ctrl+Z is not typed text") && ok
    ok = #expect(is_typed_text(tv[1]), "a bare z is typed text") && ok

    // Alt says yes — AltGr's other half on Windows, Option on macOS — even
    // when Ctrl rides with it, which is exactly how Windows spells AltGr.
    Event altgr = (EventKind.Text, i32('@'), 0.0, 0.0,
                   u32(Modifier.Ctrl) | u32(Modifier.Alt))
    ok = #expect(is_typed_text(altgr), "AltGr (Ctrl+Alt) is typed text") && ok
    Event opt = (EventKind.Text, 233, 0.0, 0.0, u32(Modifier.Alt))
    ok = #expect(is_typed_text(opt), "macOS Option-e is typed text") && ok
    Event cmd = (EventKind.Text, i32('s'), 0.0, 0.0, u32(Modifier.Super))
    ok = #expect(!is_typed_text(cmd), "Cmd+S is not typed text") && ok
    Event c0 = (EventKind.Text, 0x1A, 0.0, 0.0, 0)
    ok = #expect(!is_typed_text(c0), "a C0 control is not typed text") && ok
    Event del = (EventKind.Text, 0x7F, 0.0, 0.0, 0)
    ok = #expect(!is_typed_text(del), "DEL is not typed text") && ok
    Event notext = (EventKind.Key, i32('Z'), 0.0, 0.0, 0)
    ok = #expect(!is_typed_text(notext), "a Key event is not typed text") && ok

    // ── E8: the predicates, so the bit layout is not client knowledge ──────
    Event mp = (EventKind.Mouse, 1, 3.0, 4.0, u32(Modifier.Rmb))
    Event mr = (EventKind.Mouse, 1, 3.0, 4.0, MOUSE_UP)
    Event mm = (EventKind.Mouse, -1, 3.0, 4.0, MOUSE_MOTION | u32(Modifier.Lmb))
    Event mw = (EventKind.Mouse, 1, 3.0, 4.0, MOUSE_WHEEL)
    ok = #expect(mouse_kind(mp) == MouseKind.Press, "press") && ok
    ok = #expect(mouse_kind(mr) == MouseKind.Release, "release") && ok
    ok = #expect(mouse_kind(mm) == MouseKind.Motion, "motion") && ok
    ok = #expect(mouse_kind(mw) == MouseKind.Wheel, "wheel") && ok
    // total: a keystroke is not a mouse press, which is the trap the packing
    // left open for every client that forgot to check `kind` first.
    ok = #expect(mouse_kind(notext) == MouseKind.None, "a Key is MouseKind.None") && ok

    ok = #expect(mouse_button(mp) == 1, "press names its button, got ", mouse_button(mp)) && ok
    ok = #expect(mouse_button(mr) == 1, "release names its button, got ", mouse_button(mr)) && ok
    ok = #expect(mouse_button(mm) == -1, "motion has no button, got ", mouse_button(mm)) && ok
    ok = #expect(mouse_button(mw) == -1, "a wheel notch has no button, got ", mouse_button(mw)) && ok
    ok = #expect(mouse_button(notext) == -1, "a Key has no button") && ok

    ok = #expect(wheel_delta(mw) == 1, "wheel down is +1, got ", wheel_delta(mw)) && ok
    ok = #expect(wheel_delta(mp) == 0, "a press scrolls nothing, got ", wheel_delta(mp)) && ok
    ok = #expect(wheel_delta(notext) == 0, "a Key scrolls nothing") && ok

    // ── The wheel's distance: whole notches, and fractions of a line ──────
    //
    // A hand-built notch (no `WHEEL_FINE`) reads as it always did, in both
    // readers; a fine event rounds away from zero in `wheel_delta` and keeps
    // its fraction in `wheel_amount`.
    ok = #expect(wheel_amount(mw) == 1.0, "a whole notch down is 1.0 line, got ", wheel_amount(mw)) && ok
    ok = #expect(wheel_amount(mp) == 0.0 && wheel_amount(notext) == 0.0,
                 "a press and a Key scroll no distance") && ok
    Event f1 = (EventKind.Mouse, 100, 3.0, 4.0, MOUSE_WHEEL | WHEEL_FINE)
    ok = #expect(wheel_amount(f1) == f32(0.1), "100 thousandths is 0.1 line, got ", wheel_amount(f1)) && ok
    ok = #expect(wheel_delta(f1) == 1, "0.1 down rounds away from zero to 1, got ", wheel_delta(f1)) && ok
    Event f2 = (EventKind.Mouse, -1, 3.0, 4.0, MOUSE_WHEEL | WHEEL_FINE)
    ok = #expect(wheel_delta(f2) == -1, "a thousandth up is still a notch up, got ", wheel_delta(f2)) && ok
    Event f3 = (EventKind.Mouse, 1000, 3.0, 4.0, MOUSE_WHEEL | WHEEL_FINE)
    ok = #expect(wheel_delta(f3) == 1 && wheel_amount(f3) == 1.0,
                 "exactly one line is one notch, not two, got ", wheel_delta(f3)) && ok
    Event f4 = (EventKind.Mouse, -2001, 3.0, 4.0, MOUSE_WHEEL | WHEEL_FINE)
    ok = #expect(wheel_delta(f4) == -3, "-2.001 lines is -3 notches, got ", wheel_delta(f4)) && ok
    Event f5 = (EventKind.Mouse, 100, 3.0, 4.0, MOUSE_MOTION | WHEEL_FINE)
    ok = #expect(wheel_delta(f5) == 0 && wheel_amount(f5) == 0.0,
                 "WHEEL_FINE on a motion is not a wheel") && ok
    ok = #expect((WHEEL_FINE & (KEY_UP | MOUSE_UP | MOUSE_MOTION | MOUSE_WHEEL | FOCUS_LOST | MODIFIER_MASK)) == 0,
                 "WHEEL_FINE shares no bit with another flag or a modifier") && ok

    // `push_wheel`: packed with the flag, rounded to the nearest unit, the
    // pointer kept, and a zero (or NaN) distance pushes nothing.
    [16]Event wdrain
    for take(wdrain[:]) > 0:
        pass
    push_wheel(-0.25, 7.5, 9.0, u32(Modifier.Shift) | u32(Modifier.Lmb) | u32(Modifier.Mmb))
    push_wheel(0.0, 7.5, 9.0, 0)
    push_wheel(0.0004, 7.5, 9.0, 0)
    f32 zero = 0.0
    push_wheel(zero / zero, 7.5, 9.0, 0)
    [4]Event wq
    i32 wheel_n = take(wq[:])
    ok = #expect(wheel_n == 1, "one push_wheel lands, the zero, sub-unit and NaN ones do not, got ", wheel_n) && ok
    ok = #expect(wheel_amount(wq[0]) == -0.25 && wheel_delta(wq[0]) == -1,
                 "a quarter line up round-trips, got ", wheel_amount(wq[0])) && ok
    ok = #expect(wq[0].x == 7.5 && wq[0].y == 9.0 && (wq[0].mods & u32(Modifier.Shift)) != 0,
                 "position and modifiers ride along") && ok
    ok = #expect((wq[0].mods & (u32(Modifier.Lmb) | u32(Modifier.Rmb) | u32(Modifier.Mmb))) == 0,
                 "held-button bits are taken off a wheel event, got mods ", wq[0].mods) && ok

    ok = #expect(button_held(mm, 0), "a left-drag holds button 0") && ok
    ok = #expect(!button_held(mm, 1), "a left-drag does not hold button 1") && ok
    ok = #expect(button_held(mp, 1), "the right press's held bit is set") && ok
    ok = #expect(!button_held(mp, 7), "there is no button 7") && ok
    ok = #expect(!button_held(mr, 2), "nothing is held on this release") && ok

    Event kp = (EventKind.Key, i32('A'), 0.0, 0.0, u32(Modifier.Ctrl))
    Event kr = (EventKind.Key, i32('A'), 0.0, 0.0, u32(Modifier.Ctrl) | KEY_UP)
    ok = #expect(is_key_press(kp) && !is_key_release(kp), "a press is a press") && ok
    ok = #expect(is_key_release(kr) && !is_key_press(kr), "a release is a release") && ok
    ok = #expect(!is_key_press(mp) && !is_key_release(mp), "a Mouse event is neither") && ok

    // ── Focus: the same packing a third time, and the same totality ────────
    //
    // `FOCUS_LOST` marks the *loss*, matching `KEY_UP` and `MOUSE_UP` marking
    // the release. Getting that polarity backwards is the whole reason these
    // two readers exist, so both directions are asserted, and both readers are
    // asserted false on every other kind — the trap the packing leaves open is
    // a client that reads a bit without checking `kind` first.
    Event fg = (EventKind.Focus, 0, 0.0, 0.0, 0)
    Event fl = (EventKind.Focus, 0, 0.0, 0.0, FOCUS_LOST)
    ok = #expect(is_focus_gained(fg) && !is_focus_lost(fg), "a gain is a gain") && ok
    ok = #expect(is_focus_lost(fl) && !is_focus_gained(fl), "a loss is a loss") && ok
    ok = #expect(!is_focus_gained(kp) && !is_focus_lost(kp), "a Key press is neither") && ok
    ok = #expect(!is_focus_gained(kr) && !is_focus_lost(kr), "a Key release is neither") && ok
    ok = #expect(!is_focus_gained(mp) && !is_focus_lost(mp), "a Mouse event is neither") && ok
    ok = #expect(!is_focus_gained(notext) && !is_focus_lost(notext),
                 "a Key event is not a focus change") && ok

    // ...and the reverse: a Focus event is not a keystroke, a mouse report or
    // typed text. `FOCUS_LOST` (0x100000) sits above `KEY_UP` (0x80000) and
    // clear of every `MOUSE_*` flag and every `Modifier` bit, so a loss cannot
    // be misread as a key release or a wheel notch by a client that forgot the
    // `kind` check.
    ok = #expect(!is_key_press(fl) && !is_key_release(fl), "a Focus event is not a Key") && ok
    ok = #expect(mouse_kind(fl) == MouseKind.None, "a Focus event is MouseKind.None") && ok
    ok = #expect(mouse_button(fl) == -1, "a Focus event has no button") && ok
    ok = #expect(wheel_delta(fl) == 0, "a Focus event scrolls nothing") && ok
    ok = #expect(!is_typed_text(fl), "a Focus event is not typed text") && ok
    ok = #expect((FOCUS_LOST & (KEY_UP | MOUSE_UP | MOUSE_MOTION | MOUSE_WHEEL)) == 0,
                 "FOCUS_LOST collides with no other flag") && ok

    // ── Drop: the payload that is not in the tuple ─────────────────────────
    //
    // Everything below is about the table, because the event itself carries
    // only a count and a slot. Four claims, and the first two are the ones
    // that can be silently wrong:
    //
    //   1. the bytes are **copied** at push time, not borrowed;
    //   2. two drops still in the queue do not collide;
    //   3. the readers are total — a non-`Drop` event has no paths;
    //   4. the clamps hold, for a path too long and for a drop too wide.

    // 1. **The copy.** `push_drop` is handed a `string` over a buffer the
    // caller then overwrites — which is exactly what sokol does, since
    // `_sapp_clear_drop_buffer` zeroes its path buffer at the *start* of the
    // next drop and this queue is polled a frame later. A table that stored
    // the `string` rather than its bytes passes every other assertion in this
    // file and fails this one.
    [32]char8 pbuf
    string8 want = "/tmp/original.txt"
    i32 wn = i32(#len(want))
    for i in 0..<wn:
        pbuf[i] = want[i]
    [2]string8 moving
    moving[0] = string8(pbuf[0..<wn])
    push_drop(moving[0..<1])
    for i in 0..<32:
        pbuf[i] = 'Z'                       // the backend's buffer moves on
    [4]Event dv
    i32 dn = take(dv[:])
    ok = #expect(dn == 1, "one drop drained, got ", dn) && ok
    ok = #expect(dropped_path(dv[0], 0) == "/tmp/original.txt",
                 "the path was copied, not borrowed — got ", dropped_path(dv[0], 0)) && ok

    // 2. **Two drops, both still in the queue.** The second must not land on
    // the first's slots, or an event that waited a frame behind a newer one
    // reads the newer one's paths. This is the same shape as claim 1 and it is
    // the one a single-slot table gets wrong.
    [2]string8 first
    first[0] = "/tmp/first.txt"
    push_drop(first[0..<1])
    [2]string8 second
    second[0] = "/tmp/second-a.txt"
    second[1] = "/tmp/second-b.txt"
    push_drop(second[:])
    [4]Event tv2
    i32 tn = take(tv2[:])
    ok = #expect(tn == 2, "two drops drain as 2, got ", tn) && ok
    ok = #expect(dropped_count(tv2[0]) == 1 && dropped_count(tv2[1]) == 2,
                 "counts are per drop: ", dropped_count(tv2[0]), " then ",
                 dropped_count(tv2[1])) && ok
    ok = #expect(dropped_path(tv2[0], 0) == "/tmp/first.txt",
                 "the first drop's path survives the second, got ",
                 dropped_path(tv2[0], 0)) && ok
    ok = #expect(dropped_path(tv2[1], 0) == "/tmp/second-a.txt",
                 "the second drop's first path, got ", dropped_path(tv2[1], 0)) && ok
    ok = #expect(dropped_path(tv2[1], 1) == "/tmp/second-b.txt",
                 "the second drop's second path, got ", dropped_path(tv2[1], 1)) && ok

    // 3. **Totality.** A client that forgot the `kind` check reads nothing
    // rather than someone else's path, and an index the event does not claim
    // answers the same nothing.
    Event dropev = tv2[1]
    ok = #expect(dropped_count(kp) == 0, "a Key press drops no files") && ok
    ok = #expect(dropped_count(mp) == 0, "a Mouse event drops no files") && ok
    ok = #expect(dropped_count(fl) == 0, "a Focus loss drops no files") && ok
    ok = #expect(dropped_path(kp, 0) == "", "a Key press has no path") && ok
    ok = #expect(dropped_path(fg, 0) == "", "a focus gain has no path") && ok
    ok = #expect(dropped_path(dropev, 2) == "", "index past the count is empty") && ok
    ok = #expect(dropped_path(dropev, -1) == "", "a negative index is empty") && ok
    // ...and the other readers say nothing about a Drop, for the same reason.
    ok = #expect(!is_key_press(dropev) && !is_key_release(dropev),
                 "a Drop is not a Key") && ok
    ok = #expect(mouse_kind(dropev) == MouseKind.None, "a Drop is MouseKind.None") && ok
    ok = #expect(!is_focus_gained(dropev) && !is_focus_lost(dropev),
                 "a Drop is not a focus change") && ok
    ok = #expect(!is_typed_text(dropev), "a Drop is not typed text") && ok

    // 4a. **A path longer than the table is truncated, not written past.**
    // Under ASan a table that took the length on trust would fail here rather
    // than assert; the length check is what this pins.
    [OVERLONG]char8 big
    for i in 0..<OVERLONG:
        big[i] = 'p'
    [2]string8 longp
    longp[0] = string8(big[:])
    push_drop(longp[0..<1])
    [2]Event lv
    i32 ln = take(lv[:])
    ok = #expect(ln == 1, "the oversize drop still arrived, got ", ln) && ok
    string8 cut = dropped_path(lv[0], 0)
    ok = #expect(i32(#len(cut)) == DROP_PATH_MAX,
                 "an oversize path is cut to DROP_PATH_MAX, got ", i32(#len(cut))) && ok

    // 4b. **A drop wider than the table reports what landed, not what was
    // offered**, so a client looping to `dropped_count` never reads a slot the
    // drop did not fill.
    [TOO_MANY]string8 many
    for i in 0..<TOO_MANY:
        many[i] = "/tmp/many.txt"
    push_drop(many[:])
    [2]Event mv
    i32 mn = take(mv[:])
    ok = #expect(mn == 1, "the oversize drop is one event, got ", mn) && ok
    ok = #expect(dropped_count(mv[0]) == MAX_DROPPED,
                 "a drop wider than the table lands MAX_DROPPED, got ",
                 dropped_count(mv[0])) && ok
    ok = #expect(dropped_path(mv[0], MAX_DROPPED - 1) == "/tmp/many.txt",
                 "the last slot it claimed is filled") && ok
    ok = #expect(dropped_path(mv[0], MAX_DROPPED) == "",
                 "one past the count is empty") && ok

    // 4c. An empty drop pushes nothing at all — the same stance a
    // horizontal-only wheel event gets in the sokol decode.
    [2]string8 nopaths
    push_drop(nopaths[0..<0])
    ok = #expect(pending() == 0, "an empty drop pushes nothing, pending = ",
                 pending()) && ok

    // ── The key state table: the other question about a key ────────────────
    //
    // Everything above is the queue and none of it changes. What follows is
    // the level/edge table beside it, and the claims are the ones its section
    // in `input.dado` argues for:
    //
    //   1. a press and a release round-trip through the levels and the edges;
    //   2. `clear_edges` clears the **edges** and leaves the **levels**;
    //   3. a press and a release inside one frame are **both** visible, which
    //      is the case a level difference cannot represent at all;
    //   4. a focus loss clears every held key and **fabricates no release
    //      edge** — the one that is invisible until a player walks off a level;
    //   5. a code outside the table answers false at **both** ends and writes
    //      nothing;
    //   6. `mods_now` reads the chord back with no packing flag in it;
    //   7. the table is fed **before** the ring's capacity check, so an
    //      overflow cannot strand a key down;
    //   8. `poll` does not own the table, and the table does not touch the
    //      event.
    //
    // The table is package state and the queue tests above have been filling
    // it, so the section starts from a known one.
    [64]Event drain
    clear_keys()
    clear_edges()
    ok = #expect(keys_down_count() == 0, "the table starts empty, held = ",
                 keys_down_count()) && ok
    ok = #expect(mods_now() == 0, "and no modifier is held, mods = ",
                 mods_now()) && ok

    // 1 and 2. **The round trip across two frames.** A press sets the level
    // and latches the press edge; `clear_edges` drops the edge and must leave
    // the level, because a key held across a frame boundary is still held —
    // that is the whole difference between the two halves of this table.
    push_key(i32('W'))
    ok = #expect(key_down(i32('W')), "W is held after its press") && ok
    ok = #expect(key_pressed(i32('W')), "and its press edge is latched") && ok
    ok = #expect(!key_released(i32('W')), "and nothing has released it") && ok
    ok = #expect(keys_down_count() == 1, "exactly one key is held, got ",
                 keys_down_count()) && ok

    clear_edges()
    ok = #expect(key_down(i32('W')), "clear_edges leaves the level: W is still held") && ok
    ok = #expect(!key_pressed(i32('W')), "clear_edges drops the press edge") && ok
    ok = #expect(!key_released(i32('W')), "and there was no release edge to drop") && ok
    ok = #expect(keys_down_count() == 1, "and the count is a level, got ",
                 keys_down_count()) && ok

    push_key(i32('W'), KEY_UP)
    ok = #expect(!key_down(i32('W')), "W is up after its release") && ok
    ok = #expect(key_released(i32('W')), "and its release edge is latched") && ok
    ok = #expect(!key_pressed(i32('W')), "with no press edge, which this frame had none of") && ok
    ok = #expect(keys_down_count() == 0, "nothing is held, got ",
                 keys_down_count()) && ok

    clear_edges()
    ok = #expect(!key_released(i32('W')), "clear_edges drops the release edge too") && ok

    // 3. **Pressed and released inside one frame, both visible.** The case
    // `key_down` alone cannot see — the key is up again by the time anyone
    // looks — and the reason the edges latch rather than being derived from
    // the level. All three readers are asserted at the same instant, because
    // it is the *combination* that is the description of a tap.
    clear_keys()
    clear_edges()
    push_key(i32('J'))
    push_key(i32('J'), KEY_UP)
    ok = #expect(key_pressed(i32('J')), "the tap's press is visible") && ok
    ok = #expect(key_released(i32('J')), "and so is its release, in the same frame") && ok
    ok = #expect(!key_down(i32('J')), "and the level is back up, which is why the level alone is blind to it") && ok
    ok = #expect(keys_down_count() == 0, "a tap holds nothing, got ",
                 keys_down_count()) && ok

    // ...and the repeat rule, which is the same rule (an edge latches where
    // the level changed) seen from the other side. sokol re-sends KEY_DOWN
    // about twice a second while a key is held and `Event` has nowhere to put
    // its `key_repeat` flag, so a table latching on every KEY_DOWN would fire
    // a held jump key again half a second in.
    clear_keys()
    clear_edges()
    push_key(i32('D'))
    clear_edges()
    push_key(i32('D'))
    ok = #expect(key_down(i32('D')), "the auto-repeat leaves D held") && ok
    ok = #expect(!key_pressed(i32('D')), "and does not re-latch the press edge") && ok

    // 4. **Focus loss.** Hold a direction, alt-tab, and the releases go to the
    // window that took focus. Without this the direction is held for the rest
    // of the process. Four claims: the levels go, the modifiers go, **no
    // release edge is fabricated**, and the presses that genuinely happened
    // survive — alt-tab really is two presses followed by a loss.
    clear_keys()
    clear_edges()
    push_key(i32(Keycode.Left), 0)
    push_key(i32(Keycode.Tab), u32(Modifier.Alt))
    ok = #expect(keys_down_count() == 2, "two keys held going into the alt-tab, got ",
                 keys_down_count()) && ok
    ok = #expect(mods_now() == u32(Modifier.Alt), "with Alt held, mods = ",
                 mods_now()) && ok

    push_focus(false)
    ok = #expect(!key_down(i32(Keycode.Left)), "the focus loss releases the direction") && ok
    ok = #expect(!key_down(i32(Keycode.Tab)), "and Tab with it") && ok
    ok = #expect(keys_down_count() == 0, "nothing at all is held, got ",
                 keys_down_count()) && ok
    ok = #expect(mods_now() == 0, "and no modifier is held, mods = ",
                 mods_now()) && ok
    ok = #expect(!key_released(i32(Keycode.Left)), "no release edge is fabricated for the direction") && ok
    ok = #expect(!key_released(i32(Keycode.Tab)), "nor for Tab") && ok
    ok = #expect(key_pressed(i32(Keycode.Left)) && key_pressed(i32(Keycode.Tab)),
                 "the two presses that really happened survive the loss") && ok

    // A focus **gain** clears nothing — there is nothing left to clear, and no
    // platform reports what is held at the moment focus arrives.
    clear_keys()
    clear_edges()
    push_key(i32(Keycode.Left))
    push_focus(true)
    ok = #expect(key_down(i32(Keycode.Left)), "a focus gain clears nothing") && ok

    // ...and the late real release, for a key the loss already cleared,
    // latches nothing. This is the same rule as auto-repeat and it is what
    // keeps "fabricates no release edge" true even when the key is eventually
    // let go in front of this window.
    clear_keys()
    clear_edges()
    push_key(i32(Keycode.Left), KEY_UP)
    ok = #expect(!key_released(i32(Keycode.Left)), "a release for a key already up latches no edge") && ok
    ok = #expect(!key_down(i32(Keycode.Left)), "and leaves it up") && ok

    // 5. **Out of range, at both ends.** `Event.code` is whatever the
    // substrate reported and the decode passes codes it has no seat for
    // straight through, so a code past the table is a wrong answer here and an
    // out-of-bounds write anywhere that trusted the range.
    clear_keys()
    clear_edges()
    ok = #expect(!key_down(-1), "code -1 is not held") && ok
    ok = #expect(!key_pressed(-1), "and has no press edge") && ok
    ok = #expect(!key_released(-1), "and no release edge") && ok
    ok = #expect(!key_down(-99999), "a wildly negative code is not held") && ok
    ok = #expect(!key_down(KEY_CODE_COUNT), "one past the top is not held") && ok
    ok = #expect(!key_pressed(KEY_CODE_COUNT), "and has no press edge") && ok
    ok = #expect(!key_released(KEY_CODE_COUNT), "and no release edge") && ok
    ok = #expect(!key_down(100000), "a code far past the top is not held") && ok

    // The top of the range really is inside the table: SAPP_KEYCODE_MENU is
    // 348, the last member of sokol's own enum, and it has no `Keycode` seat.
    push_key(KEY_CODE_MAX)
    ok = #expect(key_down(KEY_CODE_MAX), "the highest sapp_keycode is inside the table") && ok
    ok = #expect(keys_down_count() == 1, "and is one key, got ",
                 keys_down_count()) && ok

    // Pushing a code outside the range stores nothing and corrupts nothing.
    // Under ASan a table that took the code on trust fails here rather than
    // asserting; the range check is what this pins.
    push_key(KEY_CODE_COUNT)
    push_key(-1)
    push_key(1 << 20)
    ok = #expect(keys_down_count() == 1, "an out-of-range push stores nothing, held = ",
                 keys_down_count()) && ok
    ok = #expect(!key_down(KEY_CODE_COUNT), "and the out-of-range code is still not held") && ok
    ok = #expect(!key_down(-1), "at the bottom end too") && ok

    // ...but it still reports its modifiers, which are true whatever key
    // produced them.
    push_key(KEY_CODE_COUNT, u32(Modifier.Ctrl))
    ok = #expect(mods_now() == u32(Modifier.Ctrl),
                 "an out-of-range key still reports its modifiers, mods = ",
                 mods_now()) && ok

    // 6. **`mods_now`**, and that no packing flag can reach it.
    clear_keys()
    clear_edges()
    ok = #expect(MODIFIER_MASK == 0x70F, "MODIFIER_MASK is the seven Modifier bits, got ",
                 MODIFIER_MASK) && ok
    push_key(i32('S'), u32(Modifier.Ctrl) | u32(Modifier.Shift))
    ok = #expect(mods_now() == (u32(Modifier.Ctrl) | u32(Modifier.Shift)),
                 "mods_now reads the chord back, got ", mods_now()) && ok
    push_key(i32('S'), u32(Modifier.Ctrl) | KEY_UP)
    ok = #expect(mods_now() == u32(Modifier.Ctrl),
                 "KEY_UP is this package's packing and is masked out, got ",
                 mods_now()) && ok
    // A Text event carries real modifiers (E1), so it moves mods_now too.
    push_text(i32('x'), u32(Modifier.Alt))
    ok = #expect(mods_now() == u32(Modifier.Alt), "a Text event moves mods_now, got ",
                 mods_now()) && ok
    // ...and a mouse motion's held-button bits are part of what is held, while
    // MOUSE_MOTION itself is not.
    push_mouse(-1, 1.0, 2.0, MOUSE_MOTION | u32(Modifier.Lmb))
    ok = #expect(mods_now() == u32(Modifier.Lmb),
                 "MOUSE_MOTION is masked out and Lmb is not, got ", mods_now()) && ok
    // A resize, a quit and a drop say nothing about what is held, and their
    // `mods` (zero, or FOCUS_LOST's neighbour flags) must not reach mods_now.
    push_resize(80, 24)
    push_quit()
    ok = #expect(mods_now() == u32(Modifier.Lmb),
                 "a resize and a quit leave mods_now alone, got ", mods_now()) && ok

    for pending() > 0:
        take(drain[:])
    ok = #expect(pending() == 0, "drained back to empty, pending = ", pending()) && ok

    // 7. **The table is fed before the ring's capacity check.** Fill the ring,
    // then release a held key: the release event is dropped by the queue and
    // must still release the key. A table fed from `poll` would strand it down
    // for the rest of the process — the exact bug this table exists to
    // prevent, arriving through the table's own mechanism.
    clear_keys()
    clear_edges()
    push_key(i32('R'))
    for i in 0..<CAP:
        push_key(i32('X'))
    ok = #expect(pending() == CAP, "the ring is full, pending = ", pending()) && ok
    ok = #expect(key_down(i32('R')), "R is held") && ok
    push_key(i32('R'), KEY_UP)
    ok = #expect(pending() == CAP, "the release did not fit in the ring, pending = ",
                 pending()) && ok
    ok = #expect(!key_down(i32('R')), "but the table saw it: a dropped release still releases") && ok
    ok = #expect(key_released(i32('R')), "and latched its edge") && ok

    for pending() > 0:
        take(drain[:])
    ok = #expect(pending() == 0, "drained the overflowed ring, pending = ",
                 pending()) && ok

    // 8. **`poll` does not own the table, and the table does not touch the
    // event.** The queue's behaviour is unchanged in both directions: the
    // event that comes out is byte for byte what went in, and draining it
    // leaves the level and the edge exactly where they were.
    clear_keys()
    clear_edges()
    push_key(i32('K'), u32(Modifier.Ctrl))
    [2]Event qv
    i32 qn = take(qv[:])
    ok = #expect(qn == 1, "the push still enqueues, got ", qn) && ok
    ok = #expect(qv[0].kind == EventKind.Key && qv[0].code == i32('K') && qv[0].mods == u32(Modifier.Ctrl),
                 "and the event is unchanged by the table, code = ", qv[0].code) && ok
    ok = #expect(is_key_press(qv[0]), "and still reads as a press") && ok
    ok = #expect(key_down(i32('K')), "draining does not clear the level") && ok
    ok = #expect(key_pressed(i32('K')), "nor the edge — poll does not own the table") && ok

    // clear_keys drops the levels and leaves the edges, which is what the
    // focus-loss path relies on.
    clear_keys()
    ok = #expect(!key_down(i32('K')), "clear_keys drops the level") && ok
    ok = #expect(key_pressed(i32('K')), "and leaves the press edge that really happened") && ok
    ok = #expect(mods_now() == 0, "and the modifiers with it, mods = ", mods_now()) && ok
    clear_edges()


    // ── Actions: the binding layer over the key table ──────────────────────
    //
    // The third surface, and the one that carries no state of its own. Every
    // claim below is one the actions section of `input.dado` argues for:
    //
    //   1.  registration, `has_action`, and re-registration spending no slot;
    //   2.  an unknown action answers emptily at **every** reader rather than
    //       trapping — the file-driven-keymap case;
    //   3.  the name is **copied**, not borrowed, which is the trap a `string`
    //       being a window lays and the one `tools/doc` was bitten by;
    //   4.  one action, two bindings, `any` — including the hold-one-tap-the-
    //       other case that makes "just pressed" ambiguous, and its mirror;
    //   5.  the edges are **inherited**: `clear_edges` clears them, a tap is
    //       visible, auto-repeat does not re-fire, a focus loss releases;
    //   6.  `get_axis` in all three states **and** with both held;
    //   7.  `get_vector`, including the diagonal, which must be length 1;
    //   8.  rebinding at run time changes the answer with no other change,
    //       and a handle resolved before the rebind still names the action;
    //   9.  a `mods` requirement is a requirement and not a prohibition;
    //   10. the name cap, the action cap and the binding cap, at their edges;
    //   11. the queue and the key table are **completely unchanged**.
    //
    // The action table is package state like everything else here, so the
    // section starts by emptying it.
    clear_actions()
    clear_keys()
    clear_edges()
    ok = #expect(action_count() == 0, "the action table starts empty, got ",
                 action_count()) && ok

    // 1. **Registration.** `has_action` before and after, and the two
    // properties that are not obvious: re-registering an existing name answers
    // true and spends no slot, and an empty name is refused.
    ok = #expect(!has_action("move_right"), "nothing is registered yet") && ok
    ok = #expect(add_action("move_right"), "add_action answers true") && ok
    ok = #expect(has_action("move_right"), "and the action is now there") && ok
    ok = #expect(action_count() == 1, "one action registered, got ",
                 action_count()) && ok
    ok = #expect(add_action("move_right"), "re-registering answers true") && ok
    ok = #expect(action_count() == 1, "and spends no second slot, got ",
                 action_count()) && ok
    ok = #expect(!add_action(""), "an empty name is refused") && ok
    ok = #expect(action_count() == 1, "and stores nothing, got ",
                 action_count()) && ok
    // a name that differs only in its last byte is a different action, which is
    // what makes truncating a long name the wrong answer.
    ok = #expect(add_action("move_righs"), "a near-miss name is its own action") && ok
    ok = #expect(action_count() == 2, "two actions now, got ", action_count()) && ok
    ok = #expect(action_key_count("move_right") == 0,
                 "a fresh action has no bindings, got ",
                 action_key_count("move_right")) && ok

    // 2. **An unknown action answers false rather than trapping.** A keymap is
    // often a file, and a file naming an action this build does not have is a
    // configuration mistake and not a program error — so every reader is total
    // on it, exactly as `key_down` is total on a code past the table.
    ok = #expect(!has_action("no_such_action"), "an unknown name is not registered") && ok
    ok = #expect(!action_valid(action_id("no_such_action")),
                 "and resolves to an invalid handle") && ok
    ok = #expect(action_name(action_id("no_such_action")) == "",
                 "which has no name") && ok
    ok = #expect(!is_action_pressed("no_such_action"), "is_action_pressed is false") && ok
    ok = #expect(!is_action_just_pressed("no_such_action"), "just_pressed is false") && ok
    ok = #expect(!is_action_just_released("no_such_action"), "just_released is false") && ok
    ok = #expect(get_axis("no_such_action", "nor_this_one") == 0.0,
                 "get_axis over two unknowns is 0") && ok
    ok = #expect(action_key_count("no_such_action") == 0, "and it has no bindings") && ok
    ok = #expect(!action_add_key("no_such_action", i32('A')),
                 "binding a key to an unknown action is refused") && ok
    ok = #expect(!action_erase_keys("no_such_action"),
                 "and so is erasing one's bindings") && ok
    [2]f32 nv = get_vector("no_such_action", "no_such_action",
                           "no_such_action", "no_such_action")
    ok = #expect(nv[0] == 0.0 && nv[1] == 0.0, "get_vector over unknowns is (0,0)") && ok

    // 3. **The name is copied, not borrowed.** A `string` is a window, so a
    // name handed to `add_action` is a borrow into the caller's bytes; a table
    // that stored the window would hold freed memory the moment those bytes
    // went away. This is the same assertion `push_drop`'s copy test makes, and
    // it is the one that fails under ASan rather than here if the copy is
    // dropped: the name is built in a buffer, registered, and the buffer is
    // then overwritten exactly as a caller reusing a line buffer would.
    [16]char8 nb
    string8 wantn = "jump"
    i32 wn2 = i32(#len(wantn))
    for i in 0..<wn2:
        nb[i] = wantn[i]
    ok = #expect(add_action(string8(nb[0..<wn2])), "a name out of a buffer registers") && ok
    for i in 0..<16:
        nb[i] = 'Z'                         // the caller's buffer moves on
    ok = #expect(has_action("jump"), "the name survived the caller's buffer") && ok
    Action jump = action_id("jump")
    ok = #expect(action_valid(jump), "and resolves to a valid handle") && ok
    ok = #expect(action_name(jump) == "jump",
                 "the stored name is the copy, not the borrow — got ",
                 action_name(jump)) && ok
    ok = #expect(!has_action("ZZZZ"), "and the overwritten bytes registered nothing") && ok

    // 4. **Two bindings and the `any` fold**, including the case the file's
    // "what makes 'just pressed' ambiguous" section decides.
    clear_actions()
    clear_keys()
    clear_edges()
    ok = #expect(add_action("move_right"), "register move_right") && ok
    ok = #expect(action_add_key("move_right", i32(Keycode.Right)),
                 "bind the Right arrow") && ok
    ok = #expect(action_add_key("move_right", i32('D')), "and D beside it") && ok
    ok = #expect(action_key_count("move_right") == 2, "two bindings, got ",
                 action_key_count("move_right")) && ok
    // binding the same pair twice spends no slot
    ok = #expect(action_add_key("move_right", i32('D')), "a duplicate binding answers true") && ok
    ok = #expect(action_key_count("move_right") == 2, "and spends no slot, got ",
                 action_key_count("move_right")) && ok

    // either binding alone presses the action — that is the `any` fold, and it
    // is the whole reason a second binding is worth having.
    push_key(i32(Keycode.Right))
    ok = #expect(is_action_pressed("move_right"), "the arrow presses the action") && ok
    ok = #expect(is_action_just_pressed("move_right"), "and latches its press edge") && ok
    ok = #expect(!is_action_just_released("move_right"), "with no release edge") && ok

    // **The ambiguous case.** Right is already held from "last frame"; this
    // frame D is tapped as well. The edge is inherited from the key table, so
    // the action reports a press it had already been in — which is not Godot's
    // answer, and is the documented one here.
    clear_edges()
    ok = #expect(is_action_pressed("move_right"), "still pressed across the frame") && ok
    ok = #expect(!is_action_just_pressed("move_right"), "with the edge cleared") && ok
    push_key(i32('D'))
    ok = #expect(is_action_just_pressed("move_right"),
                 "a second binding going down while the action is held reports a press") && ok
    ok = #expect(is_action_pressed("move_right"), "and it is of course still pressed") && ok

    // **The mirror case.** Release the arrow with D still held: a release edge
    // fires while the action is still pressed, so a program that means "no
    // longer held" writes the extra `&&` its own meaning needs.
    clear_edges()
    push_key(i32(Keycode.Right), KEY_UP)
    ok = #expect(is_action_just_released("move_right"),
                 "releasing one binding reports a release") && ok
    ok = #expect(is_action_pressed("move_right"),
                 "while the other binding keeps the action pressed") && ok
    ok = #expect(!(is_action_just_released("move_right") && !is_action_pressed("move_right")),
                 "so `just_released && !pressed` is the 'no longer held' idiom and is false here") && ok
    push_key(i32('D'), KEY_UP)
    ok = #expect(!is_action_pressed("move_right"), "the last binding up releases the action") && ok
    ok = #expect(is_action_just_released("move_right") && !is_action_pressed("move_right"),
                 "and now the idiom holds") && ok

    // 5. **The edges are inherited, not reinvented.** Three claims, each the
    // key table's own rule arriving through the action unchanged.
    clear_keys()
    clear_edges()
    // a tap: pressed and released inside one frame, both visible through the
    // action, with the level back up.
    push_key(i32('D'))
    push_key(i32('D'), KEY_UP)
    ok = #expect(is_action_just_pressed("move_right"), "a tap's press is visible through the action") && ok
    ok = #expect(is_action_just_released("move_right"), "and so is its release") && ok
    ok = #expect(!is_action_pressed("move_right"), "with the level back up") && ok
    // `clear_edges` clears them, with no action-layer call anywhere.
    clear_edges()
    ok = #expect(!is_action_just_pressed("move_right"),
                 "clear_edges clears the action's press edge — the layer has no clear of its own") && ok
    ok = #expect(!is_action_just_released("move_right"),
                 "and its release edge with it") && ok
    // auto-repeat does not re-fire a bound jump, for the same reason it does
    // not re-fire an unbound key: the edge latches where the level changed.
    clear_keys()
    clear_edges()
    push_key(i32(Keycode.Right))
    clear_edges()
    push_key(i32(Keycode.Right))
    ok = #expect(is_action_pressed("move_right"), "the repeat leaves the action pressed") && ok
    ok = #expect(!is_action_just_pressed("move_right"),
                 "and does not re-latch the action's press edge") && ok
    // a focus loss releases the action and fabricates no release edge.
    clear_edges()
    push_focus(false)
    ok = #expect(!is_action_pressed("move_right"), "a focus loss releases the action") && ok
    ok = #expect(!is_action_just_released("move_right"),
                 "and fabricates no release edge for it") && ok

    // 6. **`get_axis` in all three states, and with both ends held.** The
    // fourth is the one a hand-rolled if/if chain gets wrong by answering
    // whichever branch it wrote last.
    clear_actions()
    clear_keys()
    clear_edges()
    ok = #expect(add_action("move_left") && add_action("move_right"),
                 "register the two horizontal actions") && ok
    ok = #expect(action_add_key("move_left", i32(Keycode.Left)), "bind Left") && ok
    ok = #expect(action_add_key("move_right", i32(Keycode.Right)), "bind Right") && ok
    ok = #expect(get_axis("move_left", "move_right") == 0.0,
                 "nothing held is 0, got ", get_axis("move_left", "move_right")) && ok
    push_key(i32(Keycode.Right))
    ok = #expect(get_axis("move_left", "move_right") == 1.0,
                 "the positive action alone is +1, got ",
                 get_axis("move_left", "move_right")) && ok
    push_key(i32(Keycode.Right), KEY_UP)
    push_key(i32(Keycode.Left))
    ok = #expect(get_axis("move_left", "move_right") == -1.0,
                 "the negative action alone is -1, got ",
                 get_axis("move_left", "move_right")) && ok
    push_key(i32(Keycode.Right))
    ok = #expect(get_axis("move_left", "move_right") == 0.0,
                 "both held cancel to 0, got ", get_axis("move_left", "move_right")) && ok
    // ...and the arguments are ordered negative-then-positive, Godot's order,
    // so swapping them negates the answer rather than doing nothing.
    push_key(i32(Keycode.Left), KEY_UP)
    ok = #expect(get_axis("move_right", "move_left") == -1.0,
                 "the argument order is (negative, positive), got ",
                 get_axis("move_right", "move_left")) && ok

    // 7. **`get_vector`, including the diagonal.** `+y` is down, Godot's 2D
    // convention and `app:draw`'s, and the diagonal must have length 1 — a raw
    // (1,1) is 41% faster diagonally, which is the oldest bug in 2D movement.
    clear_keys()
    clear_edges()
    ok = #expect(add_action("move_up") && add_action("move_down"),
                 "register the two vertical actions") && ok
    ok = #expect(action_add_key("move_up", i32(Keycode.Up)), "bind Up") && ok
    ok = #expect(action_add_key("move_down", i32(Keycode.Down)), "bind Down") && ok

    [2]f32 v0 = get_vector("move_left", "move_right", "move_up", "move_down")
    ok = #expect(v0[0] == 0.0 && v0[1] == 0.0, "nothing held is (0,0)") && ok

    push_key(i32(Keycode.Right))
    [2]f32 v1 = get_vector("move_left", "move_right", "move_up", "move_down")
    ok = #expect(v1[0] == 1.0 && v1[1] == 0.0, "right alone is (1,0), got ",
                 v1[0], ",", v1[1]) && ok

    push_key(i32(Keycode.Right), KEY_UP)
    push_key(i32(Keycode.Up))
    [2]f32 v2 = get_vector("move_left", "move_right", "move_up", "move_down")
    ok = #expect(v2[0] == 0.0 && v2[1] == -1.0,
                 "up is negative y — screen coordinates, got ", v2[1]) && ok

    push_key(i32(Keycode.Up), KEY_UP)
    push_key(i32(Keycode.Down))
    [2]f32 v3 = get_vector("move_left", "move_right", "move_up", "move_down")
    ok = #expect(v3[0] == 0.0 && v3[1] == 1.0, "down is positive y, got ", v3[1]) && ok

    // the diagonal: both components are sqrt(1/2), and the length is 1.
    push_key(i32(Keycode.Right))
    [2]f32 v4 = get_vector("move_left", "move_right", "move_up", "move_down")
    ok = #expect(v4[0] == DIAGONAL && v4[1] == DIAGONAL,
                 "the down-right diagonal is (DIAGONAL, DIAGONAL), got ",
                 v4[0], ",", v4[1]) && ok
    f32 len2 = v4[0] * v4[0] + v4[1] * v4[1]
    ok = #expect(len2 > 0.9999 && len2 < 1.0001,
                 "so the diagonal has length 1 and does not move 41% faster, len^2 = ",
                 len2) && ok

    // the opposite diagonal, so the signs are not accidentally both positive.
    push_key(i32(Keycode.Right), KEY_UP)
    push_key(i32(Keycode.Down), KEY_UP)
    push_key(i32(Keycode.Left))
    push_key(i32(Keycode.Up))
    [2]f32 v5 = get_vector("move_left", "move_right", "move_up", "move_down")
    ok = #expect(v5[0] == -DIAGONAL && v5[1] == -DIAGONAL,
                 "the up-left diagonal is negative in both, got ", v5[0], ",", v5[1]) && ok

    // an axis with both ends held cancels inside the vector too, so the answer
    // is the other axis alone and is back to length 1 rather than a diagonal.
    push_key(i32(Keycode.Right))
    [2]f32 v6 = get_vector("move_left", "move_right", "move_up", "move_down")
    ok = #expect(v6[0] == 0.0 && v6[1] == -1.0,
                 "left and right together cancel, leaving up alone, got ",
                 v6[0], ",", v6[1]) && ok

    // 8. **Rebinding at run time**, which is the whole point of the layer: the
    // answer changes and nothing else does. The handle is resolved *before* the
    // rebind on purpose — a character controller hoists it at startup and must
    // not have to re-resolve it when a player changes a key in a menu.
    clear_actions()
    clear_keys()
    clear_edges()
    ok = #expect(add_action("fire"), "register fire") && ok
    ok = #expect(action_add_key("fire", i32('F')), "bound to F") && ok
    Action fire = action_id("fire")
    ok = #expect(action_valid(fire), "and resolved to a handle at startup") && ok
    push_key(i32('F'))
    ok = #expect(is_pressed(fire) && is_action_pressed("fire"), "F fires it") && ok
    push_key(i32('F'), KEY_UP)

    ok = #expect(action_erase_keys("fire"), "erase the bindings") && ok
    ok = #expect(action_key_count("fire") == 0, "leaving none, got ",
                 action_key_count("fire")) && ok
    ok = #expect(has_action("fire"), "but keeping the action itself") && ok
    ok = #expect(action_valid(fire), "and the handle a program already held") && ok
    ok = #expect(action_add_key("fire", i32('G')), "rebind it to G") && ok

    push_key(i32('F'))
    ok = #expect(!is_pressed(fire), "the old key no longer fires it") && ok
    ok = #expect(!is_action_pressed("fire"), "by either spelling") && ok
    push_key(i32('G'))
    ok = #expect(is_pressed(fire), "and the new key does — through the same handle") && ok
    ok = #expect(is_action_pressed("fire"), "and through the name") && ok
    ok = #expect(action_name(fire) == "fire", "which is still the same action, got ",
                 action_name(fire)) && ok
    // an action with no bindings at all is pressed by nothing, which is what an
    // unbound row in a settings screen should read as.
    ok = #expect(action_erase_keys("fire"), "erase again") && ok
    ok = #expect(!is_pressed(fire) && !is_action_pressed("fire"),
                 "an unbound action is pressed by nothing, though G is still down") && ok

    // 9. **A `mods` requirement is a requirement and not a prohibition.**
    clear_actions()
    clear_keys()
    clear_edges()
    ok = #expect(add_action("save") && add_action("move_right"), "register both") && ok
    ok = #expect(action_add_key("save", i32('S'), u32(Modifier.Ctrl)),
                 "bind Ctrl+S") && ok
    ok = #expect(action_add_key("move_right", i32(Keycode.Right)),
                 "and a bare Right") && ok

    push_key(i32('S'), 0)
    ok = #expect(!is_action_pressed("save"), "a bare S does not save") && ok
    push_key(i32('S'), KEY_UP)
    push_key(i32('S'), u32(Modifier.Ctrl))
    ok = #expect(is_action_pressed("save"), "Ctrl+S does") && ok
    ok = #expect(is_action_just_pressed("save"), "and reports its press edge") && ok
    // a superset satisfies a subset — the documented cost of the requirement
    // being a subset test rather than an equality.
    push_key(i32('S'), KEY_UP)
    push_key(i32('S'), u32(Modifier.Ctrl) | u32(Modifier.Shift))
    ok = #expect(is_action_pressed("save"), "Ctrl+Shift+S satisfies a Ctrl+S chord") && ok
    // ...and the polarity that makes the common case right: a bare binding
    // fires while a modifier is held, so shift-to-run does not break movement.
    push_key(i32(Keycode.Right), u32(Modifier.Shift))
    ok = #expect(is_action_pressed("move_right"),
                 "an unqualified binding fires while Shift is held") && ok
    // the modifier is a level read at the call, so dropping it un-presses the
    // chord while its key is still down — the limitation the file states.
    push_key(i32(Keycode.Left), 0)
    ok = #expect(mods_now() == 0, "the modifiers are gone, mods = ", mods_now()) && ok
    ok = #expect(key_down(i32('S')), "though S is still held") && ok
    ok = #expect(!is_action_pressed("save"),
                 "so the chord reads false — the requirement is a level at the call") && ok
    // a requirement cannot name this package's own packing flags: they are
    // masked off on the way in, so a binding asking for KEY_UP asks for nothing.
    ok = #expect(action_add_key("move_right", i32('D'), KEY_UP | u32(Modifier.Ctrl)),
                 "a binding may be written with a packing flag in its mods") && ok
    clear_keys()
    push_key(i32('D'), u32(Modifier.Ctrl))
    ok = #expect(is_action_pressed("move_right"),
                 "and the flag is masked out, leaving the Ctrl requirement") && ok

    // 10. **The caps, at their edges.**
    //
    // 10a. The name cap. A name of exactly ACTION_NAME_MAX registers; one byte
    // more is a refusal and stores nothing, because truncating would make two
    // names that differ past the cap into one action.
    clear_actions()
    ok = #expect(ACTION_NAME_MAX == 24, "the literals below are written for 24, got ",
                 ACTION_NAME_MAX) && ok
    ok = #expect(add_action("abcdefghijklmnopqrstuvwx"),
                 "a name of exactly ACTION_NAME_MAX registers") && ok
    ok = #expect(has_action("abcdefghijklmnopqrstuvwx"), "and is found again") && ok
    ok = #expect(action_count() == 1, "one action, got ", action_count()) && ok
    ok = #expect(!add_action("abcdefghijklmnopqrstuvwxy"),
                 "one byte past the cap is refused") && ok
    ok = #expect(action_count() == 1, "and stores nothing, got ", action_count()) && ok
    ok = #expect(!has_action("abcdefghijklmnopqrstuvwxy"),
                 "so the over-long name is not registered") && ok
    // ...and it is not silently the truncated one either, which is the failure
    // truncation would have produced.
    ok = #expect(!action_valid(action_id("abcdefghijklmnopqrstuvwxy")),
                 "and does not resolve to the name it would have been cut to") && ok

    // 10b. The action cap. Fill the table to MAX_ACTIONS with distinct names,
    // then ask for one more.
    clear_actions()
    [4]char8 an
    an[0] = 'a'
    bool filled = true
    for k in 0..<MAX_ACTIONS:
        an[1] = char8(i32('0') + k / 10)
        an[2] = char8(i32('0') + k % 10)
        filled = add_action(string8(an[0..<3])) && filled
    ok = #expect(filled, "MAX_ACTIONS distinct names all register") && ok
    ok = #expect(action_count() == MAX_ACTIONS, "the table is full at ",
                 action_count()) && ok
    ok = #expect(has_action("a00") && has_action("a31"),
                 "the first and last of them are both there") && ok
    ok = #expect(!add_action("one_too_many"), "the next distinct name is refused") && ok
    ok = #expect(action_count() == MAX_ACTIONS, "and the table is unchanged at ",
                 action_count()) && ok
    ok = #expect(!has_action("one_too_many"), "so it was not stored") && ok
    // a name already in the full table still answers true — a keymap reloaded
    // over a full table is not a failure.
    ok = #expect(add_action("a00"), "re-registering into a full table answers true") && ok
    ok = #expect(action_count() == MAX_ACTIONS, "and still spends no slot, got ",
                 action_count()) && ok

    // 10c. The binding cap, and the two other refusals `action_add_key` has.
    clear_actions()
    ok = #expect(add_action("crowded"), "register an action to fill") && ok
    bool bound = true
    for k in 0..<MAX_BINDINGS:
        bound = action_add_key("crowded", i32('a') + k) && bound
    ok = #expect(bound, "MAX_BINDINGS bindings all take") && ok
    ok = #expect(action_key_count("crowded") == MAX_BINDINGS,
                 "the action is full at ", action_key_count("crowded")) && ok
    ok = #expect(!action_add_key("crowded", i32('z')),
                 "the next binding is refused") && ok
    ok = #expect(action_key_count("crowded") == MAX_BINDINGS,
                 "and nothing was stored, got ", action_key_count("crowded")) && ok
    // a duplicate still answers true on a full action, for the same reason a
    // duplicate name does on a full table.
    ok = #expect(action_add_key("crowded", i32('a')),
                 "a duplicate binding on a full action answers true") && ok
    ok = #expect(action_key_count("crowded") == MAX_BINDINGS,
                 "and spends no slot, got ", action_key_count("crowded")) && ok
    // out-of-range codes are refused at both ends, the same range every reader
    // in the key table refuses — so no binding can name a key with no bit.
    ok = #expect(add_action("ranged"), "a fresh action to range-check into") && ok
    ok = #expect(!action_add_key("ranged", -1), "a negative code is refused") && ok
    ok = #expect(!action_add_key("ranged", KEY_CODE_COUNT),
                 "one past the top of the key table is refused") && ok
    ok = #expect(!action_add_key("ranged", 1 << 20), "and so is a wild one") && ok
    ok = #expect(action_key_count("ranged") == 0, "none of them stored, got ",
                 action_key_count("ranged")) && ok
    ok = #expect(action_add_key("ranged", KEY_CODE_MAX),
                 "but the top of the range itself binds") && ok
    ok = #expect(action_key_count("ranged") == 1, "as one binding, got ",
                 action_key_count("ranged")) && ok

    // 11. **The queue and the key table are completely unchanged.** The action
    // layer reads the key table and writes nothing anywhere: it enqueues no
    // event, moves no level, latches no edge and touches no modifier. Every
    // call above this block has already been made; what this asserts is that
    // making them changed nothing a pre-existing client could see.
    clear_actions()
    clear_keys()
    clear_edges()
    for pending() > 0:
        take(drain[:])
    ok = #expect(pending() == 0, "start from an empty queue, pending = ", pending()) && ok

    ok = #expect(add_action("probe"), "register") && ok
    ok = #expect(action_add_key("probe", i32('P')), "and bind") && ok
    ok = #expect(pending() == 0, "registration pushes no event, pending = ",
                 pending()) && ok
    ok = #expect(keys_down_count() == 0, "and moves no level, held = ",
                 keys_down_count()) && ok
    ok = #expect(mods_now() == 0, "and no modifier, mods = ", mods_now()) && ok

    push_key(i32('P'), u32(Modifier.Ctrl))
    // reading the action every way it can be read...
    bool r1 = is_action_pressed("probe")
    bool r2 = is_action_just_pressed("probe")
    bool r3 = is_action_just_released("probe")
    f32 r4 = get_axis("probe", "probe")
    [2]f32 r5 = get_vector("probe", "probe", "probe", "probe")
    ok = #expect(r1 && r2 && !r3, "the action reads as a fresh press") && ok
    ok = #expect(r4 == 0.0 && r5[0] == 0.0 && r5[1] == 0.0,
                 "one action on both ends of an axis cancels") && ok
    // ...leaves the key table exactly as it was...
    ok = #expect(key_down(i32('P')) && key_pressed(i32('P')) && !key_released(i32('P')),
                 "the key table is untouched by reading the action") && ok
    ok = #expect(keys_down_count() == 1, "one key held, got ", keys_down_count()) && ok
    ok = #expect(mods_now() == u32(Modifier.Ctrl), "the chord is intact, mods = ",
                 mods_now()) && ok
    // ...and leaves the queue holding exactly the event that was pushed.
    ok = #expect(pending() == 1, "one event pending, got ", pending()) && ok
    [2]Event av
    i32 an2 = take(av[:])
    ok = #expect(an2 == 1, "which drains as one, got ", an2) && ok
    ok = #expect(av[0].kind == EventKind.Key && av[0].code == i32('P') &&
                 av[0].mods == u32(Modifier.Ctrl),
                 "byte for byte what was pushed, code = ", av[0].code) && ok
    ok = #expect(is_key_press(av[0]), "and still reads as a press") && ok
    // clear_actions touches no key state, which is the other direction of the
    // same claim: the two tables do not reach into each other.
    clear_actions()
    ok = #expect(key_down(i32('P')) && key_pressed(i32('P')),
                 "clear_actions leaves the key table alone") && ok
    ok = #expect(mods_now() == u32(Modifier.Ctrl), "and the modifiers, mods = ",
                 mods_now()) && ok
    ok = #expect(action_count() == 0, "while emptying the action table, got ",
                 action_count()) && ok
    ok = #expect(!is_action_pressed("probe"),
                 "so the action is gone though its key is still held") && ok
    clear_keys()
    clear_edges()

    if ok:
        return 0
    return 1
