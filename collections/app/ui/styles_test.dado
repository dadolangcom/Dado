@test
// A text edit's style source with no window (a grid taken up headless with
// 8 x 16 cells, so the view is drawn through a region whose cells are read
// back): spans painted in their roles' colours and the bytes between them in
// the text colour; spans out of order, overlapping, past either end, empty
// or of a role outside the palette drawn safely; a source that answers
// nothing, and none at all, drawing exactly what no source draws; a tab
// before a span keeping its columns; the selection and the caret still
// painted over a span; `text_edit_restyle` repainting the rows asked for and
// only those, and nothing for lines out of view; a new theme generation
// repainting every row in the new palette; and every entry point total over
// a bad handle.
package ui

import "app:ui/cell"
import "app:ui/grid"

// Every line is this, but line 5, which is `ST_TAB`.
private const string8 ST_LINE = "let x = 42 // c"
private const string8 ST_TAB = "\tif y"

private i64 st_count(rawptr ctx):
    _ = ctx
    return 40

private string8 st_line(rawptr ctx, i64 i):
    _ = ctx
    if i == 5:
        return ST_TAB
    return ST_LINE

private cell.TextPos st_insert(rawptr ctx, cell.TextPos p, string8 text):
    _ = ctx
    _ = text
    return p

private bool st_remove(rawptr ctx, cell.TextPos a, cell.TextPos b):
    _ = ctx
    _ = a
    _ = b
    return false

// What the source answers: 0 the well-formed spans, 1 the badly formed ones,
// 2 roles outside the palette, 3 nothing.
private i32 g_st_mode
private [8]StyleSpan g_st_spans
private i32 g_st_n
// Lines asked for since the last reset of the count.
private i64 g_st_asked

private void st_put(i32 from, i32 to, i32 role):
    g_st_spans[g_st_n] = (from, to, role)
    g_st_n = g_st_n + 1

private StyleSpans st_styles(rawptr ctx, i64 line):
    _ = ctx
    g_st_asked = g_st_asked + 1
    g_st_n = 0
    if line == 5:
        st_put(1, 3, SYNTAX_KEYWORD)
        return g_st_spans[0..<g_st_n]
    if g_st_mode == 0:
        st_put(0, 3, SYNTAX_KEYWORD)
        st_put(6, 7, SYNTAX_PUNCT)
        st_put(8, 10, SYNTAX_NUMBER)
        st_put(11, 15, SYNTAX_COMMENT)
    else if g_st_mode == 1:
        st_put(-5, 1, SYNTAX_STRING)
        st_put(0, 3, SYNTAX_KEYWORD)
        st_put(2, 5, SYNTAX_NUMBER)
        st_put(8, 999, SYNTAX_COMMENT)
        st_put(6, 7, SYNTAX_TYPE)
        st_put(9, 9, SYNTAX_BUILTIN)
        st_put(14, 12, SYNTAX_BUILTIN)
    else if g_st_mode == 2:
        st_put(0, 3, 99)
        st_put(4, 5, -1)
        st_put(6, 7, SYNTAX_TYPE)
    return g_st_spans[0..<g_st_n]

private i64 st_lines(Control c):
    (i64 _, i64 lp) = text_edit_counters(c)
    return lp

// The foreground of text column `col` on view row `row`.
private [4]u8 st_fg(i32 id, i32 tx, i32 top, i32 col, i32 row):
    return grid.region_cell_at(id, tx + col, top + row).fg

// Whether text columns `[a, b)` of view row `row` are all in `fg`.
private bool st_run(i32 id, i32 tx, i32 top, i32 row, i32 a, i32 b, [4]u8 fg):
    for x in a..<b:
        if st_fg(id, tx, top, i32(x), row) != fg:
            return false
    return true

i32 test():
    bool ok = true
    ok = #expect(grid.up_headless(8, 16), "a headless grid of 8 x 16 cells") && ok
    cell.CellRect screen = cell.rect(0, 0, 30, 10)
    _ = grid.begin(30 * 8, 10 * 16)

    Control ed = text_edit(NIL)
    EditSource src = (st_count, st_line, st_insert, st_remove, nil)
    text_edit_set_source(ed, src)
    update(screen)
    EditTheme th = theme_edit()
    cell.CellRect v = edit_view(ed)
    i32 id = text_edit_region(ed)
    i32 tx = v.col + text_edit_gutter_width(ed)
    ok = #expect(id >= 0 && v.rows > 6, "a region and a view of more than six rows") && ok
    ok = #expect(!text_edit_has_styles(ed), "no style source at first") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 0, 15, th.fg), "with none, every cell is in the text colour") && ok

    // The palette's reader agrees with the compiled table, and holds a role
    // outside it to the text colour.
    ok = #expect(theme_syntax(SYNTAX_KEYWORD) == th.syntax[SYNTAX_KEYWORD] && theme_syntax(SYNTAX_KEYWORD) != th.fg,
                 "the keyword colour is the table's and is not the text's") && ok
    ok = #expect(theme_syntax(SYNTAX_PLAIN) == th.fg && theme_syntax(SYNTAX_ROLES) == th.fg && theme_syntax(-1) == th.fg,
                 "plain, and a role outside the palette, are the text colour") && ok
    bool all_differ = true
    for i in 1..<SYNTAX_ROLES:
        for j in 0..<i:
            if th.syntax[i] == th.syntax[j]:
                all_differ = false
    ok = #expect(all_differ, "the default palette's roles are all different colours") && ok

    // ── Well-formed spans ────────────────────────────────────────────────
    i64 lp = st_lines(ed)
    text_edit_set_styles(ed, st_styles, nil)
    ok = #expect(text_edit_has_styles(ed) && is_paint_dirty(ed), "set, and marked for paint") && ok
    update(screen)
    ok = #expect(st_lines(ed) - lp == i64(v.rows) + 1, "setting a source repaints the whole view: ", st_lines(ed) - lp) && ok
    // Row 1 is line 1 (the caret is on line 0).
    ok = #expect(st_run(id, tx, v.row, 1, 0, 3, th.syntax[SYNTAX_KEYWORD]), "let: keyword") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 3, 6, th.fg), " x : the text colour between spans") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 6, 7, th.syntax[SYNTAX_PUNCT]), "=: punctuation") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 7, 8, th.fg), "the space after it") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 8, 10, th.syntax[SYNTAX_NUMBER]), "42: number") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 10, 11, th.fg), "the space before the comment") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 11, 15, th.syntax[SYNTAX_COMMENT]), "// c: comment") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 15, 20, th.fg), "the blank cells past the end") && ok
    ok = #expect(grid.region_cell_at(id, tx, v.row + 1).bg == th.bg, "the background is untouched") && ok
    (i64 sp, i64 rs) = text_edit_style_counters(ed)
    ok = #expect(sp >= 4 * i64(v.rows) && rs == 0, "the spans drawn are counted: ", sp) && ok

    // A tab before a span: `if` lands after the tab's cells.
    ok = #expect(st_run(id, tx, v.row, 5, 0, 4, th.fg), "the tab's cells") && ok
    ok = #expect(st_run(id, tx, v.row, 5, 4, 6, th.syntax[SYNTAX_KEYWORD]), "if, after the tab stop") && ok
    ok = #expect(st_run(id, tx, v.row, 5, 6, 8, th.fg), " y") && ok

    // The caret still draws over a span, in the caret's colours.
    ok = #expect(grid.region_cell_at(id, tx, v.row).fg == th.caret_fg && grid.region_cell_at(id, tx, v.row).bg == th.caret_bg,
                 "the caret over a keyword") && ok
    ok = #expect(st_run(id, tx, v.row, 0, 1, 3, th.syntax[SYNTAX_KEYWORD]), "and the rest of it in colour") && ok

    // The selection draws its cells in the text colour on its background.
    text_edit_set_selection(ed, cell.pos(2, 0), cell.pos(2, 3))
    update(screen)
    ok = #expect(st_run(id, tx, v.row, 2, 0, 2, th.fg) && grid.region_cell_at(id, tx, v.row + 2).bg == th.sel_bg,
                 "a selected keyword is in the selection's colours") && ok
    text_edit_set_caret(ed, cell.pos(0, 0))
    update(screen)
    ok = #expect(st_run(id, tx, v.row, 2, 0, 3, th.syntax[SYNTAX_KEYWORD]), "deselected, the keyword is coloured again") && ok

    // ── Badly formed spans ───────────────────────────────────────────────
    g_st_mode = 1
    text_edit_restyle(ed, 0, 40)
    update(screen)
    ok = #expect(st_run(id, tx, v.row, 1, 0, 1, th.syntax[SYNTAX_STRING]), "a span from before the line: held to byte 0") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 1, 3, th.syntax[SYNTAX_KEYWORD]), "an overlapping span draws past the one before") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 3, 5, th.syntax[SYNTAX_NUMBER]), "and so does the next") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 5, 8, th.fg), "the gap before the next span") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 8, 15, th.syntax[SYNTAX_COMMENT]), "a span past the line's end: held to it") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 15, 20, th.fg), "nothing past the line") && ok
    ok = #expect(st_fg(id, tx, v.row, 6, 1) != th.syntax[SYNTAX_TYPE], "a span out of order behind the last is skipped") && ok

    // Roles outside the palette are the text colour.
    g_st_mode = 2
    text_edit_restyle(ed, 0, 40)
    update(screen)
    ok = #expect(st_run(id, tx, v.row, 1, 0, 6, th.fg), "roles 99 and -1 draw in the text colour") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 6, 7, th.syntax[SYNTAX_TYPE]), "and a good role after them still draws") && ok

    // A source that answers nothing draws what no source draws.
    g_st_mode = 3
    text_edit_restyle(ed, 0, 40)
    update(screen)
    ok = #expect(st_run(id, tx, v.row, 1, 0, 15, th.fg), "an empty answer: the text colour") && ok

    // ── Restyle: the rows asked for, and only those ──────────────────────
    g_st_mode = 0
    (i64 top, i64 _) = text_edit_position(ed)
    lp = st_lines(ed)
    i64 gp = text_edit_gutter_painted(ed)
    (i64 _, i64 rs0) = text_edit_style_counters(ed)
    g_st_asked = 0
    text_edit_restyle(ed, top + 2, top + 4)
    ok = #expect(is_paint_dirty(ed), "a restyle in view marks the edit") && ok
    update(screen)
    ok = #expect(st_lines(ed) - lp == 2 && g_st_asked == 2, "two lines asked, two painted: ", st_lines(ed) - lp, " asked ", g_st_asked) && ok
    ok = #expect(text_edit_gutter_painted(ed) == gp, "and no gutter") && ok
    ok = #expect(st_run(id, tx, v.row, 2, 0, 3, th.syntax[SYNTAX_KEYWORD]) && st_run(id, tx, v.row, 3, 0, 3, th.syntax[SYNTAX_KEYWORD]),
                 "rows 2 and 3 took the new answer") && ok
    ok = #expect(st_run(id, tx, v.row, 4, 0, 3, th.fg), "row 4 was not asked, and kept the old one") && ok
    (i64 _, i64 rs1) = text_edit_style_counters(ed)
    ok = #expect(rs1 == rs0 + 1, "one restyle counted") && ok

    // Out of view, empty or inverted: nothing marked, nothing counted.
    text_edit_restyle(ed, top + i64(v.rows) + 2, 40)
    text_edit_restyle(ed, 3, 3)
    text_edit_restyle(ed, 9, 2)
    ok = #expect(!is_paint_dirty(ed), "a restyle out of view, or of no lines, marks nothing") && ok
    (i64 _, i64 rs2) = text_edit_style_counters(ed)
    ok = #expect(rs2 == rs1, "and counts nothing") && ok
    lp = st_lines(ed)
    update(screen)
    ok = #expect(st_lines(ed) == lp, "nothing painted") && ok
    // The spare row below the view is in view: the line after the last whole
    // one, which a sub-row offset shows the top of.
    text_edit_restyle(ed, top + i64(v.rows), top + i64(v.rows) + 1)
    update(screen)
    ok = #expect(st_lines(ed) - lp == 1, "the spare row's line is restyled") && ok

    // The pure range: clipped to the view and the spare row.
    (i64 a, i64 b) = edit_restyle_range(0, 100, 10, 5)
    ok = #expect(a == 10 && b == 15, "clipped to 10..15: ", a, " ", b) && ok
    (a, b) = edit_restyle_range(12, 13, 10, 5)
    ok = #expect(a == 12 && b == 12, "one line inside") && ok
    (a, b) = edit_restyle_range(0, 10, 10, 5)
    ok = #expect(a > b, "ending at the first line: none") && ok
    (a, b) = edit_restyle_range(0, 100, 10, 0)
    ok = #expect(a > b, "no rows: none") && ok

    // ── A new theme generation repaints every row in the new palette ─────
    lp = st_lines(ed)
    ThemeDesc d = theme_default()
    d.syntax[SYNTAX_KEYWORD] = [1, 2, 3, 255]
    theme_set(&d)
    update(screen)
    ok = #expect(st_lines(ed) - lp == i64(v.rows) + 1, "a theme repaints the whole view: ", st_lines(ed) - lp) && ok
    ok = #expect(st_run(id, tx, v.row, 1, 0, 3, [1, 2, 3, 255]) && theme_syntax(SYNTAX_KEYWORD) == [1, 2, 3, 255],
                 "in the new keyword colour") && ok
    ThemeDesc defaults = theme_default()
    theme_set(&defaults)
    update(screen)

    // ── Off again: the text colour, everything repainted ─────────────────
    lp = st_lines(ed)
    text_edit_set_styles(ed, nil, nil)
    update(screen)
    ok = #expect(!text_edit_has_styles(ed) && st_lines(ed) - lp == i64(v.rows) + 1, "unset: a whole repaint") && ok
    ok = #expect(st_run(id, tx, v.row, 1, 0, 15, th.fg), "in the text colour") && ok

    // ── Bad handles ──────────────────────────────────────────────────────
    Control lb = label(NIL, "x")
    text_edit_set_styles(NIL, st_styles, nil)
    text_edit_set_styles(lb, st_styles, nil)
    text_edit_restyle(NIL, 0, 5)
    text_edit_restyle(lb, 0, 5)
    ok = #expect(!text_edit_has_styles(NIL) && !text_edit_has_styles(lb), "no handle, or a label, has no styles") && ok
    (i64 bs, i64 br) = text_edit_style_counters(NIL)
    ok = #expect(bs == 0 && br == 0, "a bad handle counts zeros") && ok
    remove(ed)
    text_edit_set_styles(ed, st_styles, nil)
    text_edit_restyle(ed, 0, 5)
    ok = #expect(!text_edit_has_styles(ed), "a removed edit is a bad handle") && ok

    reset()
    grid.down()
    if ok:
        return 0
    return 1
