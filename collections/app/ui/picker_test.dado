@test
// The tree as a picker, with no window (a grid taken up headless with 8 x 16
// cells, its cells read back): `tree_detail_columns` and
// `tree_flat_label_column`; a flat row's label one cell in with no chevron
// and no ink; a detail right-aligned one cell in from the edge in its own
// colour on the row's background, the label cut before it; the selected look
// while focus is in the focus proxy and the unfocused look when it leaves; a
// press never on a chevron; a million-row source asked for the rows painted
// only; and bad handles.
package ui

import "app:ui/cell"
import "app:ui/grid"

private i64 g_pk_asked

private i64 pk_count(rawptr ctx):
    _ = ctx
    return 1000000

private string8 pk_label(rawptr ctx, i64 i):
    _ = ctx
    g_pk_asked = g_pk_asked + 1
    if i == 0:
        return "a label far too long to fit in front of its detail"
    return "Save"

private string8 pk_detail(rawptr ctx, i64 i):
    _ = ctx
    _ = i
    return "Ctrl+S"

private bool pk_has(rawptr ctx, i64 i):
    _ = ctx
    _ = i
    return true

i32 test():
    bool ok = true
    // ── The arithmetic ─────────────────────────────────────────────────────
    ok = #expect(tree_flat_label_column(10, 0) == 11 && tree_flat_label_column(10, 2) == 15, "one cell in, then the indent") && ok
    ok = #expect(tree_flat_label_column(0, -4) == 1, "a negative depth reads as zero") && ok
    (i32 le, i32 da) = tree_detail_columns(1, 30, 6)
    ok = #expect(da == 23 && le == 22, "a detail of 6 ends one in from 30: at 23, the label ending at 22") && ok
    (le, da) = tree_detail_columns(1, 30, 0)
    ok = #expect(le == 30 && da == 30, "no detail: the label runs to the edge") && ok
    (le, da) = tree_detail_columns(5, 8, 20)
    ok = #expect(da == 5 && le == 5, "a detail wider than the row: both held to the label's start") && ok

    // ── Painting ───────────────────────────────────────────────────────────
    ok = #expect(grid.up_headless(8, 16), "a headless grid") && ok
    cell.CellRect screen = cell.rect(0, 0, 30, 6)
    _ = grid.begin(30 * 8, 6 * 16)
    Control box = vbox(NIL)
    set_expand(box, true, true)
    Control field = line_edit(box)
    Control list = tree_view(box)
    Control other = line_edit(box)
    TreeSource src
    src.count = pk_count
    src.label = pk_label
    src.has_children = pk_has
    tree_set_source(list, src)
    tree_set_flat(list, true)
    tree_set_detail(list, pk_detail)
    tree_set_focus_proxy(list, field)
    ok = #expect(tree_flat(list) && !tree_flat(field), "flat") && ok
    set_focus(field)
    update(screen)
    tree_select(list, 1)
    g_pk_asked = 0
    update(screen)
    TreeTheme th = theme_tree()
    cell.CellRect r = rect(list)
    ok = #expect(r.row == 1 && r.rows == 4, "the list between the fields: ", r.row, " ", r.rows) && ok
    ok = #expect(g_pk_asked == i64(r.rows), "a million rows, asked for the four painted: ", g_pk_asked) && ok
    // Row 1 (screen row 2): "Save" from column 1; "Ctrl+S" at 23..28.
    i32 y = r.row + 1
    ok = #expect(grid.cell_at(0, y).bg == th.selected.bg && grid.cell_at(29, y).bg == th.selected.bg,
                 "the selected row in the focused look, focus being in the proxy") && ok
    // A headless grid makes no glyph resident, so a cell's slot says nothing
    // here; where each part lies is read from the colours.
    ok = #expect(grid.cell_at(1, y).fg == th.selected.fg && grid.cell_at(22, y).fg == th.selected.fg, "the label's cells in the row's colour") && ok
    ok = #expect(grid.cell_at(23, y).fg == th.detail && grid.cell_at(28, y).fg == th.detail, "the detail in its colour") && ok
    ok = #expect(grid.cell_at(23, y).bg == th.selected.bg, "on the row's background") && ok
    ok = #expect(grid.cell_at(29, y).fg == th.selected.fg && grid.cell_at(22, y).fg != th.detail, "one cell after it, and one before, not the detail's") && ok
    // Row 0 is cut before its detail: column 22 is the ellipsis, the last the
    // label may take.
    ok = #expect(grid.cell_at(22, r.row).fg == th.row.fg && grid.cell_at(23, r.row).fg == th.detail, "the long label cut before the detail") && ok
    cell.CellPoint at = (1, r.row)
    (i64 hr, bool chev) = tree_hit(list, at)
    ok = #expect(hr == 0 && !chev, "a press where a chevron would be is on the row") && ok

    // Focus leaves the proxy and the list: the unfocused look.
    set_focus(other)
    update(screen)
    ok = #expect(grid.cell_at(0, y).bg == th.selected_unfocused.bg, "focus elsewhere: the unfocused look") && ok

    // ── Bad handles ────────────────────────────────────────────────────────
    tree_set_flat(NIL, true)
    tree_set_detail(field, pk_detail)
    tree_set_focus_proxy(NIL, field)
    ok = #expect(!tree_flat(NIL) && !tree_flat(field), "nothing but a tree is flat") && ok

    reset()
    grid.down()
    if ok:
        return 0
    return 1
