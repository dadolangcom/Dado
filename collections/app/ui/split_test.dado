@test
// The split boxes: `split_extents` and `split_minimum` with no tree; then an
// hsplit in a real tree at several screen widths — the ratio kept across a
// resize, the minimums held, the first child giving way when the screen is too
// small, a hidden child collapsing the split to one pane; cells set before any
// arrange; then the handle dragged by synthesized mouse events under capture,
// with `split_moved` counted, the resize cursor through a sink, the hot look,
// a drag ended by a focus loss, a double-click resetting to 1/2, and a
// vsplit's rows and cursor.
package ui

import "app:input"
import "app:ui/cell"

private bool rect_is(cell.CellRect r, i32 col, i32 row, i32 cols, i32 rows):
    return r.col == col && r.row == row && r.cols == cols && r.rows == rows

private bool rect_ok(cell.CellRect r, i32 col, i32 row, i32 cols, i32 rows, string8 what):
    return #expect(rect_is(r, col, row, cols, rows), what, ": ", r.col, ",", r.row, " ", r.cols, "x", r.rows, " want ", col, ",", row, " ", cols, "x", rows)

private cell.CellPoint spt(i32 c, i32 r):
    cell.CellPoint p = (c, r)
    return p

private type SSize: (i32 cols, i32 rows)
private type SSizePtr: ^SSize

private cell.CellPoint ssized(Control c, rawptr st):
    _ = c
    ^SSize s = SSizePtr(st)
    cell.CellPoint p = (s.cols, s.rows)
    return p

private Kind g_sleaf = NO_KIND

private Control sleaf(Control parent, i32 cols, i32 rows):
    if !kind_ok(g_sleaf):
        Hooks h
        h.measure = ssized
        g_sleaf = register_kind("split_test_leaf", h)
    Control c = create_owned(g_sleaf, parent, i64(#size(SSize)))
    ^SSize s = SSizePtr(state(c))
    s.cols = cols
    s.rows = rows
    set_expand(c, true, true)
    return c

private i32 g_moved
private Control g_moved_by

private void on_moved(Control c, rawptr ctx):
    _ = ctx
    g_moved = g_moved + 1
    g_moved_by = c

private i32 g_sunk
private i32 g_sunk_last = -99

private void sink(i32 cursor):
    g_sunk = g_sunk + 1
    g_sunk_last = cursor

private f64 g_now = 100.0

private f64 test_clock():
    return g_now

private input.Event mouse(i32 code, i32 col, i32 row, u32 mods):
    input.Event e = (input.EventKind.Mouse, code, f32(col) + f32(0.5), f32(row) + f32(0.5), mods)
    return e

private bool press(i32 col, i32 row):
    return dispatch(mouse(0, col, row, u32(input.Modifier.Lmb)))

private bool drag(i32 col, i32 row):
    return dispatch(mouse(-1, col, row, input.MOUSE_MOTION | u32(input.Modifier.Lmb)))

private bool hover(i32 col, i32 row):
    return dispatch(mouse(-1, col, row, input.MOUSE_MOTION))

private bool let_go(i32 col, i32 row):
    return dispatch(mouse(0, col, row, input.MOUSE_UP))

i32 test():
    bool ok = true

    // ── Arithmetic ────────────────────────────────────────────────────────
    (i32 f, i32 h, i32 s) = split_extents(41, 5, 8, 1, 2, true, true)
    ok = #expect(f == 20 && h == 1 && s == 20, "half of 40 ", f, " ", h, " ", s) && ok
    (f, h, s) = split_extents(41, 5, 8, 1, 3, true, true)
    ok = #expect(f == 13 && s == 27, "a third, rounded ", f) && ok
    (f, h, s) = split_extents(41, 5, 8, 1, 0, true, true)
    ok = #expect(f == 20, "no denominator: half") && ok
    (f, h, s) = split_extents(41, 5, 8, 9, 2, true, true)
    ok = #expect(f == 32 && s == 8, "past one: all but the second's minimum ", f) && ok
    (f, h, s) = split_extents(41, 5, 8, 0, 2, true, true)
    ok = #expect(f == 5, "zero: the first's minimum ", f) && ok
    (f, h, s) = split_extents(12, 5, 8, 1, 2, true, true)
    ok = #expect(f == 3 && h == 1 && s == 8, "too small: the first gives way ", f, " ", s) && ok
    (f, h, s) = split_extents(6, 5, 8, 1, 2, true, true)
    ok = #expect(f == 0 && h == 1 && s == 5, "smaller still: the second takes the rest ", f, " ", s) && ok
    (f, h, s) = split_extents(41, 5, 8, 1, 2, false, true)
    ok = #expect(f == 0 && h == 0 && s == 41, "first hidden: all to the second") && ok
    (f, h, s) = split_extents(41, 5, 8, 1, 2, true, false)
    ok = #expect(f == 41 && h == 0 && s == 0, "second hidden: all to the first") && ok
    (f, h, s) = split_extents(41, 5, 8, 1, 2, false, false)
    ok = #expect(f == 0 && h == 0 && s == 0, "both hidden: nothing") && ok
    (f, h, s) = split_extents(0, 5, 8, 1, 2, true, true)
    ok = #expect(f == 0 && h == 0 && s == 0, "no room: nothing") && ok
    cell.CellPoint m = split_minimum(spt(5, 2), spt(8, 3), false, true, true)
    ok = #expect(m.col == 14 && m.row == 3, "hsplit minimum ", m.col, "x", m.row) && ok
    m = split_minimum(spt(5, 2), spt(8, 3), true, true, true)
    ok = #expect(m.col == 8 && m.row == 6, "vsplit minimum ", m.col, "x", m.row) && ok
    m = split_minimum(spt(5, 2), spt(8, 3), false, false, true)
    ok = #expect(m.col == 8 && m.row == 3, "one shown: no handle") && ok
    (cell.CellRect ra, cell.CellRect rh, cell.CellRect rb) = split_rects(cell.rect(2, 3, 10, 4), true, 1, 1, 2)
    ok = rect_ok(ra, 2, 3, 10, 1, "vsplit top") && rect_ok(rh, 2, 4, 10, 1, "vsplit handle row") && rect_ok(rb, 2, 5, 10, 2, "vsplit bottom") && ok

    // ── Arrange in a tree ─────────────────────────────────────────────────
    Control sp = hsplit_box(NIL)
    set_expand(sp, true, true)
    Control a = sleaf(sp, 5, 1)
    Control b = sleaf(sp, 8, 1)
    Control c3 = sleaf(sp, 2, 1)
    update(cell.rect(0, 0, 41, 10))
    ok = rect_ok(rect(a), 0, 0, 20, 10, "left half") && ok
    ok = rect_ok(split_handle_rect(sp), 20, 0, 1, 10, "the handle column") && ok
    ok = rect_ok(rect(b), 21, 0, 20, 10, "right half") && ok
    ok = rect_ok(rect(c3), 0, 0, 0, 0, "a third child gets nothing") && ok
    ok = #expect(split_first(sp) == 20 && !split_is_vertical(sp), "first 20") && ok
    ok = #expect(minimum(sp).col == 14, "split minimum in the tree") && ok
    ok = #expect(hit(20, 4) == sp && hit(19, 4) == a && hit(21, 4) == b, "the split owns its handle") && ok

    update(cell.rect(0, 0, 81, 10))
    ok = #expect(split_first(sp) == 40, "a wider window keeps 1/2: ", split_first(sp)) && ok
    split_set_first(sp, 10)
    (i32 num, i32 den) = split_ratio(sp)
    ok = #expect(num == 10 && den == 80, "cells stored as a fraction ", num, "/", den) && ok
    update(cell.rect(0, 0, 81, 10))
    ok = #expect(split_first(sp) == 10, "ten cells") && ok
    update(cell.rect(0, 0, 41, 10))
    ok = #expect(split_first(sp) == 5, "halved window, halved first: ", split_first(sp)) && ok
    update(cell.rect(0, 0, 161, 10))
    ok = #expect(split_first(sp) == 20, "doubled window, doubled first: ", split_first(sp)) && ok
    update(cell.rect(0, 0, 21, 10))
    ok = #expect(split_first(sp) == 5, "held at the first's minimum: ", split_first(sp)) && ok
    update(cell.rect(0, 0, 12, 10))
    ok = #expect(split_first(sp) == 3 && rect(b).cols == 8, "too small: the first gives way ", split_first(sp)) && ok
    update(cell.rect(0, 0, 81, 10))
    ok = #expect(split_first(sp) == 10, "and the ratio survived it: ", split_first(sp)) && ok

    // Collapse to one pane, and back.
    set_visible(a, false)
    update(cell.rect(0, 0, 81, 10))
    ok = rect_ok(rect(b), 0, 0, 81, 10, "first hidden: the second has everything") && ok
    ok = #expect(cell.is_empty(split_handle_rect(sp)), "no handle") && ok
    ok = #expect(hit(10, 4) == b, "and no handle in the hit map") && ok
    set_visible(a, true)
    set_visible(b, false)
    update(cell.rect(0, 0, 81, 10))
    ok = rect_ok(rect(a), 0, 0, 81, 10, "second hidden: the first has everything") && ok
    set_visible(b, true)
    update(cell.rect(0, 0, 81, 10))
    ok = #expect(split_first(sp) == 10 && rect(b).cols == 70, "shown again: the ratio is back") && ok

    split_set_ratio(sp, 3, 4)
    update(cell.rect(0, 0, 81, 10))
    ok = #expect(split_first(sp) == 60, "3/4 ", split_first(sp)) && ok
    remove(sp)

    // Cells before any arrange become the first arrange's fraction.
    Control early = hsplit_box(NIL)
    set_expand(early, true, true)
    _ = sleaf(early, 1, 1)
    _ = sleaf(early, 1, 1)
    split_set_first(early, 7)
    (num, den) = split_ratio(early)
    ok = #expect(num == 7 && den == 0, "pending cells") && ok
    update(cell.rect(0, 0, 41, 10))
    (num, den) = split_ratio(early)
    ok = #expect(split_first(early) == 7 && num == 7 && den == 40, "seven of forty ", num, "/", den) && ok
    remove(early)

    // ── The mouse ─────────────────────────────────────────────────────────
    g_edit_clock = test_clock
    set_cursor_sink(sink)
    cell.CellRect screen = cell.rect(0, 0, 41, 10)
    sp = hsplit_box(NIL)
    set_expand(sp, true, true)
    a = sleaf(sp, 5, 1)
    b = sleaf(sp, 8, 1)
    on_split_moved(sp, on_moved, nil)
    update(screen)
    ok = #expect(cursor_at(sp, spt(20, 3)) == CURSOR_RESIZE_EW, "over the handle: east-west") && ok
    ok = #expect(cursor_at(a, spt(3, 3)) == CURSOR_DEFAULT, "over a child: not the split's") && ok

    ok = #expect(!hover(20, 3), "a hover is not taken") && ok
    (bool dragging, bool hot) = split_handle_state(sp)
    ok = #expect(!dragging && hot, "hovering lights the handle") && ok
    ok = #expect(is_paint_dirty(sp), "and repaints it") && ok
    _ = hover(5, 3)
    (dragging, hot) = split_handle_state(sp)
    ok = #expect(!hot, "moving onto a child puts it out") && ok
    sync_cursor()
    i32 sets = g_sunk

    ok = #expect(press(20, 3), "a press on the handle is taken") && ok
    ok = #expect(captured() == sp, "and captures") && ok
    (dragging, hot) = split_handle_state(sp)
    ok = #expect(dragging && hot, "dragging") && ok
    sync_cursor()
    ok = #expect(g_sunk == sets + 1 && g_sunk_last == CURSOR_RESIZE_EW, "the resize cursor") && ok
    ok = #expect(drag(30, 3), "drag right") && ok
    ok = #expect(g_moved == 1 && g_moved_by == sp && split_first(sp) == 30, "moved once to 30: ", split_first(sp)) && ok
    update(screen)
    ok = rect_ok(split_handle_rect(sp), 30, 0, 1, 10, "the handle under the pointer") && ok
    ok = rect_ok(rect(b), 31, 0, 10, 10, "the second child narrower") && ok
    sync_cursor()
    ok = #expect(g_sunk == sets + 1, "over a child mid-drag the capture keeps the cursor") && ok
    _ = drag(40, 7)
    ok = #expect(g_moved == 2 && split_first(sp) == 32, "held to the second's minimum: ", split_first(sp)) && ok
    _ = drag(41, 7)
    ok = #expect(g_moved == 2, "no change, no signal") && ok
    _ = drag(-5, 3)
    ok = #expect(g_moved == 3 && split_first(sp) == 5, "held to the first's minimum: ", split_first(sp)) && ok
    ok = #expect(let_go(-5, 3), "the release is the split's") && ok
    ok = #expect(captured() == NIL, "released") && ok
    (dragging, hot) = split_handle_state(sp)
    ok = #expect(!dragging && !hot, "not dragging, not over the handle") && ok
    update(screen)
    sync_cursor()
    ok = #expect(g_sunk_last == CURSOR_DEFAULT, "released off the handle: the default cursor") && ok
    (num, den) = split_ratio(sp)
    ok = #expect(num == 5 && den == 40, "a drag stores a fraction ", num, "/", den) && ok

    // A lost release: a buttonless motion ends the drag.
    g_now = g_now + 5.0
    _ = press(5, 3)
    ok = #expect(captured() == sp, "pressed on the handle at 5") && ok
    _ = hover(9, 3)
    (dragging, hot) = split_handle_state(sp)
    ok = #expect(captured() == NIL && !dragging, "a motion with no button ends it") && ok
    update(screen)

    // A lost capture: the window losing focus mid-drag ends the drag, and a
    // later drag that reaches the split through a child moves nothing.
    g_now = g_now + 5.0
    i32 held = split_first(sp)
    _ = press(held, 3)
    ok = #expect(captured() == sp, "pressed on the handle again") && ok
    input.Event lost = (input.EventKind.Focus, 0, f32(0.0), f32(0.0), input.FOCUS_LOST)
    _ = dispatch(lost)
    ok = #expect(cursor_at(sp, spt(2, 3)) == CURSOR_DEFAULT, "no capture: the resize cursor only over the handle") && ok
    _ = press(10, 3)
    _ = drag(15, 3)
    (dragging, hot) = split_handle_state(sp)
    ok = #expect(split_first(sp) == held && !dragging, "a drag over a child after the focus loss: ", split_first(sp), " want ", held) && ok
    _ = let_go(15, 3)
    update(screen)

    // Double-click: two presses within the double-click time reset to 1/2.
    g_now = g_now + 5.0
    i32 before = g_moved
    _ = press(5, 3)
    _ = let_go(5, 3)
    g_now = g_now + 0.1
    ok = #expect(press(5, 3), "the second press is taken") && ok
    ok = #expect(split_first(sp) == 20 && g_moved == before + 1, "reset to half, one signal: ", split_first(sp)) && ok
    (num, den) = split_ratio(sp)
    ok = #expect(num == 1 && den == 2, "the ratio is 1/2") && ok
    _ = let_go(5, 3)
    update(screen)
    ok = rect_ok(split_handle_rect(sp), 20, 0, 1, 10, "the handle back in the middle") && ok
    // Presses too far apart are two drags, not a double-click.
    g_now = g_now + 5.0
    _ = press(20, 3)
    _ = drag(25, 3)
    _ = let_go(25, 3)
    g_now = g_now + 1.0
    update(screen)
    _ = press(25, 3)
    _ = let_go(25, 3)
    ok = #expect(split_first(sp) == 25, "slow presses do not reset ", split_first(sp)) && ok
    remove(sp)

    // ── A vsplit: rows, and the north-south cursor ────────────────────────
    Control vs = vsplit_box(NIL)
    set_expand(vs, true, true)
    Control top = sleaf(vs, 1, 2)
    Control bot = sleaf(vs, 1, 3)
    update(cell.rect(0, 0, 20, 11))
    ok = #expect(split_is_vertical(vs), "a vsplit") && ok
    ok = rect_ok(rect(top), 0, 0, 20, 5, "top half") && ok
    ok = rect_ok(split_handle_rect(vs), 0, 5, 20, 1, "the handle row") && ok
    ok = rect_ok(rect(bot), 0, 6, 20, 5, "bottom half") && ok
    ok = #expect(cursor_at(vs, spt(4, 5)) == CURSOR_RESIZE_NS, "north-south over the handle") && ok
    g_now = g_now + 5.0
    _ = press(4, 5)
    _ = drag(4, 2)
    ok = #expect(split_first(vs) == 2, "dragged up to the top's minimum ", split_first(vs)) && ok
    _ = let_go(4, 2)
    update(cell.rect(0, 0, 20, 11))
    ok = rect_ok(rect(bot), 0, 3, 20, 8, "the bottom grew") && ok

    set_cursor_sink(nil)
    g_edit_clock = nil
    reset()
    if ok:
        return 0
    return 1
