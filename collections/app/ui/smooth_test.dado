@test
// A TextEdit scrolling by pixels through a grid region: the grid taken up
// headless with 8 x 16 cells (`grid.up_headless`), so a row is 16 pixels and a
// region can be made. What a sub-row scroll repaints (nothing) and what it
// sets (the region's offset, and a frame asked for); what a scroll by whole
// lines shifts and repaints (the rows it exposes); a press, a double-click and
// a drag at a pixel row read through the offset; the caret drawn in the
// region's cells with the layer transparent under it; a hidden edit's region
// emptied; and the region freed with the widget.
package ui

import "app:input"
import "app:ui/cell"
import "app:ui/grid"

private i64 s_count(rawptr ctx):
    _ = ctx
    return 200

private string8 s_line(rawptr ctx, i64 i):
    _ = ctx
    _ = i
    return "alpha beta"

private cell.TextPos s_insert(rawptr ctx, cell.TextPos p, string8 text):
    _ = ctx
    _ = text
    return p

private bool s_remove(rawptr ctx, cell.TextPos a, cell.TextPos b):
    _ = ctx
    _ = a
    _ = b
    return false

private f64 g_s_now
private f64 s_clock():
    return g_s_now

private const u32 S_LMB = 0x100

// A mouse event at pixel (`x`, `y`).
private input.Event s_mouse(f32 x, f32 y, u32 mods):
    input.Event e = (input.EventKind.Mouse, 0, x, y, mods)
    return e

private i64 s_lines(Control c):
    (i64 _, i64 lp) = text_edit_counters(c)
    return lp

private i64 s_offset(Control c):
    (i64 _, i64 px) = text_edit_position(c)
    return px

i32 test():
    bool ok = true
    ok = #expect(grid.up_headless(8, 16) && grid.cell_h() == 16, "a headless grid of 8 x 16 cells") && ok
    ok = #expect(!grid.up_headless(0, 16), "a cell under 1 x 1 is refused") && ok
    cell.CellRect screen = cell.rect(0, 0, 30, 10)
    _ = grid.begin(30 * 8, 10 * 16)
    g_edit_clock = s_clock

    Control ed = text_edit(NIL)
    EditSource src = (s_count, s_line, s_insert, s_remove, nil)
    text_edit_set_source(ed, src)
    update(screen)
    cell.CellRect v = edit_view(ed)
    i32 id = text_edit_region(ed)
    ok = #expect(id >= 0 && grid.region_valid(id) && node_region(ed) == id, "a region, made at the first paint: ", id) && ok
    ok = #expect(grid.region_rect(id) == v && v.rows > 3, "its rect is the view: ", v.col, " ", v.row, " ", v.cols, " ", v.rows) && ok
    ok = #expect(grid.region_layer(id) == grid.BASE, "on the edit's layer") && ok
    ok = #expect(s_lines(ed) == i64(v.rows) + 1, "the whole paint is the view's rows and the spare row: ", s_lines(ed)) && ok

    // The caret, at (0, 0), is in the region's cells, and the layer is
    // transparent under the view.
    EditTheme th = theme_edit()
    i32 tx = v.col + text_edit_gutter_width(ed)
    ok = #expect(grid.region_cell_at(id, tx, v.row).bg == th.caret_bg, "the caret is drawn in the region") && ok
    ok = #expect(grid.cell_at(tx, v.row) == cell.blank() && grid.cell_at(tx + 3, v.row + 2) == cell.blank(),
                 "the layer under the view is left transparent") && ok
    // The spare row holds line v.rows (the line after the last whole one).
    [8]char8 buf
    ok = #expect(grid.region_cell_at(id, tx + 1, v.row + v.rows).bg == th.bg, "the spare row is painted") && ok

    // ── A sub-row scroll: no paint, the region's offset, a frame asked ──
    i64 lp = s_lines(ed)
    g_frame_asked = false
    ok = #expect(!text_edit_scroll_to_px(ed, 5), "5 px keeps the first line") && ok
    ok = #expect(grid.region_offset(id) == 5 && g_frame_asked, "the offset is 5 and a frame was asked for") && ok
    ok = #expect(!is_paint_dirty(ed), "nothing marked for paint") && ok
    update(screen)
    ok = #expect(stats().painted == 0 && s_lines(ed) == lp, "0 rows repainted: ", s_lines(ed) - lp) && ok

    // The wheel's fraction does the same: 0.1 line x 3 x 16 px = 5 px more.
    input.Event fine = (input.EventKind.Mouse, 100, f32(tx * 8 + 4), f32(v.row * 16 + 4), input.MOUSE_WHEEL | input.WHEEL_FINE)
    ok = #expect(dispatch(fine) && s_offset(ed) == 10 && grid.region_offset(id) == 10, "a trackpad's fraction: ", s_offset(ed)) && ok
    update(screen)
    ok = #expect(s_lines(ed) == lp, "and repaints nothing") && ok

    // ── One line down: one memmove, one row painted ──────────────────────
    i64 shifted = grid.region_stats(id).rows_shifted
    i64 gp = text_edit_gutter_painted(ed)
    ok = #expect(text_edit_scroll_to_px(ed, 16 + 10), "a new first line") && ok
    update(screen)
    ok = #expect(grid.region_stats(id).rows_shifted - shifted == 1, "one row shifted: ", grid.region_stats(id).rows_shifted - shifted) && ok
    ok = #expect(s_lines(ed) - lp == 1, "one row painted, the exposed one: ", s_lines(ed) - lp) && ok
    ok = #expect(text_edit_gutter_painted(ed) - gp == 1, "and its gutter: ", text_edit_gutter_painted(ed) - gp) && ok
    ok = #expect(grid.region_offset(id) == 10, "the offset kept") && ok
    ok = #expect(text_edit_gutter_text(ed, v.row, buf[:]) == "  2", "the top row numbers line 2 now") && ok

    // Three lines down: three rows. One up: one row, at the top.
    lp = s_lines(ed)
    _ = text_edit_scroll_to_px(ed, 4 * 16 + 10)
    update(screen)
    ok = #expect(s_lines(ed) - lp == 3, "three rows for three lines: ", s_lines(ed) - lp) && ok
    lp = s_lines(ed)
    _ = text_edit_scroll_to_px(ed, 3 * 16 + 10)
    update(screen)
    ok = #expect(s_lines(ed) - lp == 1, "one row for one line up: ", s_lines(ed) - lp) && ok

    // A jump of the view's rows or more repaints the whole view.
    lp = s_lines(ed)
    shifted = grid.region_stats(id).rows_shifted
    _ = text_edit_scroll_to_px(ed, i64(3 + v.rows) * 16 + 10)
    update(screen)
    ok = #expect(s_lines(ed) - lp == i64(v.rows) + 1, "a page's jump repaints all: ", s_lines(ed) - lp) && ok
    ok = #expect(grid.region_stats(id).rows_shifted == shifted, "and shifts nothing") && ok

    // ── A press through the offset ───────────────────────────────────────
    _ = text_edit_scroll_to_px(ed, 16 + 5)
    update(screen)
    ok = #expect(grid.region_offset(id) == 5, "top line 1, 5 px into it") && ok
    // 12 px into the view's first screen row is 17 px into the content: the
    // second line shown, line 2 — not line 1, which that screen cell alone
    // would say.
    f32 px = f32(tx * 8 + 2 * 8 + 3)
    g_s_now = 10.0
    ok = #expect(dispatch(s_mouse(px, f32(v.row * 16 + 12), S_LMB)), "a press") && ok
    ok = #expect(text_edit_caret(ed) == cell.pos(2, 2), "lands on line 2, byte 2: ", text_edit_caret(ed).line, " ", text_edit_caret(ed).byte) && ok
    ok = #expect(s_offset(ed) == 21, "line 2 is in view, so nothing scrolled") && ok
    _ = dispatch(s_mouse(px, f32(v.row * 16 + 12), input.MOUSE_UP))
    update(screen)
    ok = #expect(grid.region_cell_at(id, tx + 2, v.row + 1).bg == th.caret_bg, "the caret drawn where it was pressed") && ok

    // A double-click there selects the word on that line.
    g_s_now = 10.1
    _ = dispatch(s_mouse(f32(tx * 8 + 7 * 8 + 1), f32(v.row * 16 + 12), S_LMB))
    g_s_now = 10.2
    _ = dispatch(s_mouse(f32(tx * 8 + 7 * 8 + 1), f32(v.row * 16 + 12), S_LMB))
    (cell.TextPos wf, cell.TextPos wt) = text_edit_selection(ed)
    ok = #expect(wf == cell.pos(2, 6) && wt == cell.pos(2, 10), "the double-click selects line 2's second word: ",
                 wf.line, ":", wf.byte, " ", wt.line, ":", wt.byte) && ok
    _ = dispatch(s_mouse(f32(tx * 8 + 7 * 8 + 1), f32(v.row * 16 + 12), input.MOUSE_UP))
    update(screen)

    // A drag: the motion's pixel row goes through the offset too. 30 px into
    // the view is 35 px into the content: the third line shown, line 3.
    g_s_now = 20.0
    _ = dispatch(s_mouse(f32(tx * 8 + 1), f32(v.row * 16 + 12), S_LMB))
    ok = #expect(text_edit_caret(ed) == cell.pos(2, 0), "pressed at line 2's start") && ok
    _ = dispatch(s_mouse(f32(tx * 8 + 4 * 8 + 1), f32(v.row * 16 + 30), S_LMB | input.MOUSE_MOTION))
    ok = #expect(text_edit_caret(ed) == cell.pos(3, 4) && text_edit_anchor(ed) == cell.pos(2, 0),
                 "dragged to line 3, byte 4: ", text_edit_caret(ed).line, " ", text_edit_caret(ed).byte) && ok
    _ = dispatch(s_mouse(f32(tx * 8 + 4 * 8 + 1), f32(v.row * 16 + 30), input.MOUSE_UP))
    update(screen)

    // A press on the top line, which the offset cuts, brings the view back
    // to that line's top edge: a whole line, no repaint of the rows.
    g_s_now = 30.0
    _ = dispatch(s_mouse(px, f32(v.row * 16 + 3), S_LMB))
    ok = #expect(text_edit_caret(ed).line == 1, "3 px + 5 px is still the first line shown, line 1") && ok
    ok = #expect(s_offset(ed) == 16 && grid.region_offset(id) == 0, "the view snapped to line 1: ", s_offset(ed)) && ok
    _ = dispatch(s_mouse(px, f32(v.row * 16 + 3), input.MOUSE_UP))
    update(screen)

    // ── Keys land on whole lines ─────────────────────────────────────────
    _ = text_edit_scroll_to_px(ed, 16 + 7)
    input.Event pgdn = (input.EventKind.Key, i32(input.Keycode.PageDown), 0.0, 0.0, 0)
    set_focus(ed)
    _ = dispatch(pgdn)
    ok = #expect(s_offset(ed) % 16 == 0, "PageDown lands on a whole line: ", s_offset(ed)) && ok
    update(screen)
    ok = #expect(grid.region_offset(id) == 0, "and shows no offset") && ok

    // ── Hidden: the region draws nothing; shown: whole again ─────────────
    set_visible(ed, false)
    update(screen)
    ok = #expect(cell.is_empty(grid.region_rect(id)) && grid.region_valid(id), "hidden, the region's rect is empty") && ok
    set_visible(ed, true)
    lp = s_lines(ed)
    update(screen)
    ok = #expect(grid.region_rect(id) == v && s_lines(ed) - lp == i64(v.rows) + 1, "shown, it is back and repainted whole") && ok

    // ── Freed with the widget ────────────────────────────────────────────
    remove(ed)
    ok = #expect(!grid.region_valid(id) && grid.region_count() == 0, "the region is freed with the edit") && ok

    g_edit_clock = nil
    reset()
    grid.down()
    if ok:
        return 0
    return 1
