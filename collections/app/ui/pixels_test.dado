@test
// Pixel boxes and ink over a headless 8 x 16 grid: the draw function runs on
// a repaint and on nothing else (an idle update rebuilds no ink); the box's
// cells are punched, transparent, and only inside its clip; the ink list is
// scissored to the clip an ancestor cuts, emptied when the box leaves the
// picture, moved with the box's layer and freed with the node. Then each icon
// through the ink calls: a sane number of triangles, every vertex inside the
// icon's square, `Icon.None` nothing; and the ink calls outside an open list.
package ui

import "app:ui/cell"
import "app:ui/grid"

private type PDraw: (i32 calls, PixelRect whole, PixelRect seen, i32 icon)
private type PDrawPtr: ^PDraw

// A background, a circle and a rounded rect; or one icon when `icon` is set.
private void pdraw(rawptr ctx, PixelRect whole, PixelRect seen):
    ^PDraw d = PDrawPtr(ctx)
    d.calls = d.calls + 1
    d.whole = whole
    d.seen = seen
    if d.icon >= 0:
        draw_icon(Icon(d.icon), whole, [200, 180, 90, 255])
        return
    ink_rect(f32(whole.x), f32(whole.y), f32(whole.w), f32(whole.h), [10, 20, 30, 255])
    ink_circle(f32(whole.x) + 16.0, f32(whole.y) + 16.0, 10.0, [200, 60, 60, 255])
    ink_round_rect(f32(whole.x) + 2.0, f32(whole.y) + 2.0, 20.0, 12.0, 4.0, [60, 200, 60, 255])

private type PHold: (i32 dc, i32 dr, i32 cols, i32 rows)
private type PHoldPtr: ^PHold

private cell.CellPoint phold_measure(Control c, rawptr st):
    _ = c
    _ = st
    cell.CellPoint p = (6, 4)
    return p

// Places its one child at an offset, at a size that may overhang it.
private void phold_arrange(Control c, rawptr st, cell.CellRect r):
    ^PHold h = PHoldPtr(st)
    Control ch = first_child(c)
    set_rect(ch, cell.rect(r.col + h.dc, r.row + h.dr, h.cols, h.rows))

private Kind g_phold = NO_KIND

private Control phold(Control parent, i32 dc, i32 dr, i32 cols, i32 rows):
    if !kind_ok(g_phold):
        Hooks k
        k.measure = phold_measure
        k.arrange = phold_arrange
        g_phold = register_kind("pixels_test_holder", k)
    Control c = create_owned(g_phold, parent, i64(#size(PHold)))
    ^PHold h = PHoldPtr(state(c))
    h.dc = dc
    h.dr = dr
    h.cols = cols
    h.rows = rows
    return c

private bool punched(i32 layer, i32 col, i32 row):
    cell.Cell x = grid.cell_at_layer(layer, col, row)
    return (x.flags & cell.REGION_PUNCH) != 0 && x.bg[3] == 0

private bool px_is(PixelRect p, i32 x, i32 y, i32 w, i32 h):
    return p.x == x && p.y == y && p.w == w && p.h == h

// Every vertex of list `id` inside `r`, give or take a hair of float error.
private bool inside(i32 id, PixelRect r):
    for k in 0..<grid.ink_count(id):
        grid.ChromeTri t = grid.ink_at(id, i32(k))
        [3]grid.ChromePt v = [t.a, t.b, t.c]
        for j in 0..<3:
            if v[j].x < f32(r.x) - 0.01 || v[j].x > f32(r.x + r.w) + 0.01:
                return false
            if v[j].y < f32(r.y) - 0.01 || v[j].y > f32(r.y + r.h) + 0.01:
                return false
    return true

i32 test():
    bool ok = true
    ok = #expect(grid.up_headless(8, 16), "a headless grid") && ok
    cell.CellRect screen = cell.rect(0, 0, 40, 10)
    _ = grid.begin(40 * 8, 10 * 16)

    // ── Outside a paint nothing is inked ─────────────────────────────────
    ink_rect(0.0, 0.0, 10.0, 10.0, [255, 255, 255, 255])
    ok = #expect(grid.ink_lists() == 0, "no list is open outside a paint") && ok

    //  root 40 x 10
    //  ├── hold (0,0 40x4): the box at (2,1) 8 x 6, cut to rows 1..3
    //  └── box2 (0,4 40x3): the root's vbox gives it the full width
    PDraw d
    d.icon = -1
    Control hold = phold(NIL, 2, 1, 8, 6)
    Control box = pixel_box(hold, 8, 6, pdraw, rawptr(&d))
    PDraw d2
    d2.icon = -1
    Control box2 = pixel_box(NIL, 5, 3, pdraw, rawptr(&d2))
    ok = #expect(valid(box) && !is_focusable(box) && minimum(box).col == 0, "a pixel box (unmeasured yet)") && ok
    update(screen)
    ok = #expect(minimum(box2).col == 5 && minimum(box2).row == 3, "its minimum is its cells") && ok
    ok = #expect(d.calls == 1 && pixel_box_draws(box) == 1, "drawn once by the first update") && ok
    ok = #expect(px_is(d.whole, 16, 16, 64, 96), "the whole rect in pixels") && ok
    ok = #expect(px_is(d.seen, 16, 16, 64, 48), "the visible part: cut by the holder at row 4") && ok
    i32 id = node_ink(box)
    ok = #expect(grid.ink_valid(id) && grid.ink_lists() == 2 && grid.ink_layer(id) == grid.BASE, "one list per box, on the base") && ok
    grid.ChromeRect sc = grid.ink_scissor(id)
    ok = #expect(sc.x == 16 && sc.y == 16 && sc.w == 64 && sc.h == 48, "scissored to the clip, not the rect") && ok
    i32 tris = grid.ink_count(id)
    ok = #expect(tris > 2 + 8 && grid.ink_clears(id) == 1, "rect, circle and rounded rect; one build: ", tris) && ok

    // Punched cells: the box's clip, and nothing past it.
    ok = #expect(punched(0, 2, 1) && punched(0, 9, 3), "the box's cells are holes") && ok
    ok = #expect(!punched(0, 2, 0) && !punched(0, 1, 1) && !punched(0, 10, 1), "and nothing outside its clip") && ok
    ok = #expect(punched(0, 0, 4) && punched(0, 39, 6) && !punched(0, 0, 7), "the second box's, full width in the root") && ok
    ok = #expect(px_is(d2.whole, 0, 64, 320, 48), "which it was drawn at") && ok

    // ── Idle: nothing rebuilt ────────────────────────────────────────────
    update(screen)
    update(screen)
    ok = #expect(d.calls == 1 && grid.ink_clears(id) == 1 && grid.ink_count(id) == tris, "idle updates rebuild no ink") && ok
    pixel_box_changed(box)
    update(screen)
    ok = #expect(d.calls == 2 && grid.ink_clears(id) == 2 && grid.ink_count(id) == tris, "a repaint rebuilds it, same size") && ok
    ok = #expect(d2.calls == 1, "and only the box that repainted") && ok

    // ── Moving: the holder shifts it, the scissor follows ────────────────
    ^PHold h = PHoldPtr(state(hold))
    h.dc = 30
    mark_layout(hold)
    update(screen)
    sc = grid.ink_scissor(id)
    ok = #expect(d.calls == 3 && sc.x == 240 && sc.w == 64, "moved: redrawn, scissor moved") && ok
    h.dc = 36
    mark_layout(hold)
    update(screen)
    sc = grid.ink_scissor(id)
    ok = #expect(sc.x == 288 && sc.w == 32 && d.seen.w == 32, "cut by the screen's right edge") && ok

    // ── Leaving the picture ──────────────────────────────────────────────
    set_visible(hold, false)
    update(screen)
    ok = #expect(grid.ink_count(id) == 0 && grid.ink_valid(id), "hidden: the list is emptied, kept") && ok
    set_visible(hold, true)
    update(screen)
    ok = #expect(grid.ink_count(id) == tris && d.calls == 5, "shown: drawn again") && ok
    h.dc = 50
    mark_layout(hold)
    update(screen)
    ok = #expect(grid.ink_count(id) == 0, "clipped away whole: emptied") && ok
    h.dc = 2
    mark_layout(hold)
    update(screen)
    ok = #expect(grid.ink_count(id) == tris, "back in view") && ok

    // ── Layers ───────────────────────────────────────────────────────────
    grid.set_layers(2)
    set_layer(hold, 1)
    update(screen)
    ok = #expect(grid.ink_layer(id) == 1 && node_ink(box) == id, "the list follows the node's layer") && ok
    ok = #expect(punched(1, 2, 1), "the holes are in the layer the box paints into") && ok
    set_layer(hold, -1)
    update(screen)
    ok = #expect(grid.ink_layer(id) == grid.BASE, "and back") && ok

    // ── Removal frees the list ───────────────────────────────────────────
    remove(hold)
    ok = #expect(!grid.ink_valid(id) && grid.ink_lists() == 1 && node_ink(box) == -1, "freed with the node") && ok
    update(screen)

    // ── Icons ────────────────────────────────────────────────────────────
    // One 2 x 1 cell icon box (16 x 16 px) per kind, each checked alone.
    PDraw di
    di.icon = i32(Icon.None)
    Control row = hbox(NIL)
    Control ib = pixel_box(row, 2, 1, pdraw, rawptr(&di))
    update(screen)
    i32 iid = node_ink(ib)
    ok = #expect(grid.ink_count(iid) == 0, "Icon.None draws nothing") && ok
    [5]i32 lo = [6, 6, 10, 4, 4]
    for k in 1..=5:
        di.icon = i32(k)
        pixel_box_changed(ib)
        update(screen)
        i32 n = grid.ink_count(iid)
        PixelRect sq = di.whole
        ok = #expect(sq.w == 16 && sq.h == 16, "a 16 px square") && ok
        ok = #expect(n >= lo[k - 1] && n <= 64, "icon ", k, ": a sane triangle count, got ", n) && ok
        ok = #expect(inside(iid, sq), "icon ", k, ": every vertex inside its square") && ok
    // A wide rect: the icon keeps its square, centred.
    pixel_box_set_size(ib, 6, 1)
    di.icon = i32(Icon.File)
    update(screen)
    PixelRect mid = (di.whole.x + 16, di.whole.y, 16, 16)
    ok = #expect(inside(iid, mid), "a wide rect centres the square") && ok

    // ── Pure pieces ──────────────────────────────────────────────────────
    ok = #expect(px_is(cell_pixels(cell.rect(2, 3, 4, 5)), 16, 48, 32, 80), "cell_pixels") && ok
    ok = #expect(px_is(cell_pixels(cell.rect(2, 3, 0, 5)), 0, 0, 0, 0), "an empty rect has no pixels") && ok
    [4]u8 sh = ink_shade([200, 100, 50, 77], 0.5)
    ok = #expect(sh[0] == 100 && sh[1] == 50 && sh[2] == 25 && sh[3] == 77, "shade keeps alpha") && ok
    grid.ChromeRect big = (-5, -5, 30, 30)
    grid.ChromeRect cut = grid.ink_scissor_on(big, 20, 10)
    ok = #expect(cut.x == 0 && cut.y == 0 && cut.w == 20 && cut.h == 10, "a scissor is cut to the framebuffer") && ok
    grid.ChromeRect off = (50, 0, 10, 10)
    ok = #expect(grid.ink_scissor_on(off, 20, 10).w == 0, "off the framebuffer: nothing") && ok

    reset()
    grid.down()
    ok = #expect(grid.ink_lists() == 0, "down frees every list") && ok
    if ok:
        return 0
    return 1
