@test
// The column index answers exactly what the plain walk answers. Two long
// lines of tabs, wide CJK, combining marks and ASCII behind an edit source;
// the index is built, then the line is edited through the widget — inserts
// and removals at the start, the end, in the middle, on a mark's own byte and
// just after it, a combining mark that joins the cluster before a mark, a
// removal spanning marks — and after each edit every question the widget asks
// (`edit_col`, `edit_logical`, `edit_byte_at`, `edit_snap_in`) is compared
// with `cell.visual_of`, `cell.logical_of`, `cell.byte_at_column` and
// `edit_snap` over the whole line. Then: marks kept across an edit at the
// end, another line claiming the index, and `text_edit_set_source` dropping
// it.
package ui

import "app:ui/cell"

// ── A document of two owned lines; edits within a line only ────────────────

private [2]ref []char8 g_text
private [2]i32 g_len

private string8 cline(i64 i):
    if i < 0 || i > 1 || g_text[i] == nil:
        return ""
    return string8(g_text[i][0..<g_len[i]])

// Line `i` becomes `a ++ b ++ c`, copied before the old bytes go.
private void cset(i64 i, string8 a, string8 b, string8 c):
    i64 n = #len(a) + #len(b) + #len(c)
    ref []char8 t = #make([]char8, n + 1)
    i64 k = 0
    for j in 0..<#len(a):
        t[k] = a[j]
        k = k + 1
    for j in 0..<#len(b):
        t[k] = b[j]
        k = k + 1
    for j in 0..<#len(c):
        t[k] = c[j]
        k = k + 1
    if g_text[i] != nil:
        #delete(g_text[i])
    g_text[i] = t
    g_len[i] = i32(n)

private i64 ccount(rawptr ctx):
    _ = ctx
    return 2

private string8 cline_fn(rawptr ctx, i64 i):
    _ = ctx
    return cline(i)

private cell.TextPos cinsert(rawptr ctx, cell.TextPos p, string8 text):
    _ = ctx
    if p.line < 0 || p.line > 1 || p.byte < 0 || p.byte > g_len[p.line] || #len(text) == 0:
        return p
    for j in 0..<#len(text):
        if text[j] == '\n':
            return p
    string8 s = cline(p.line)
    cset(p.line, s[0..<i64(p.byte)], text, s[i64(p.byte)..<#len(s)])
    return cell.pos(p.line, p.byte + i32(#len(text)))

private bool cremove(rawptr ctx, cell.TextPos from, cell.TextPos to):
    _ = ctx
    if from.line != to.line || from.line < 0 || from.line > 1 || from.byte < 0 || to.byte > g_len[from.line] || to.byte < from.byte:
        return false
    string8 s = cline(from.line)
    cset(from.line, s[0..<i64(from.byte)], "", s[i64(to.byte)..<#len(s)])
    return true

// ── The line ───────────────────────────────────────────────────────────────

// `n` pieces chosen by a fixed LCG: ASCII runs, tabs (whose widths depend on
// where they start), a wide ideograph, `e` and a combining acute, a stray
// control.
private ref []char8 make_line(i32 n, u32 seed):
    ref []char8 t = #make([]char8, i64(n) * 6 + 1)
    i64 k = 0
    u32 x = seed
    for _ in 0..<n:
        x = x * 1664525 + 1013904223
        u32 r = (x >> 16) % 10
        string8 piece = "ab"
        if r == 0 || r == 1:
            piece = "\t"
        else if r == 2 || r == 3:
            piece = "\xE6\x97\xA5"
        else if r == 4:
            piece = "e\xCC\x81"
        else if r == 5:
            piece = "\x01"
        else if r == 6:
            piece = "xyz"
        for j in 0..<#len(piece):
            t[k] = piece[j]
            k = k + 1
    ref []char8 out = #make([]char8, k)
    for j in 0..<k:
        out[j] = t[j]
    #delete(t)
    return out

// ── The comparison ─────────────────────────────────────────────────────────

// Every question on line `li` through the index against the plain walk:
// every `step`-th byte (clusters' insides included) and every `step`-th
// column, past both ends. `step` keeps the quadratic oracle affordable.
private bool same(^EditState s, i64 li, i32 step, string8 what):
    string8 line = cline(li)
    i32 n = i32(#len(line))
    i32 w = cell.columns(line)
    i32 bad = 0
    i32 b = 0
    for b <= n + 2:
        i32 want = i32(cell.visual_of(line, cell.LogicalOffset(b)))
        i32 got = edit_col(s, li, line, b, true)
        if got != want:
            if bad < 3:
                _ = #expect(false, what, ": column of byte ", b, " is ", got, ", the walk says ", want)
            bad = bad + 1
        i32 ws = edit_snap(line, b)
        i32 gs = edit_snap_in(s, li, line, b, true)
        if gs != ws:
            if bad < 3:
                _ = #expect(false, what, ": snap of byte ", b, " is ", gs, ", the walk says ", ws)
            bad = bad + 1
        b = b + step
    i32 c = 0
    for c <= w + 2:
        i32 wl = i32(cell.logical_of(line, cell.VisualCol(c)))
        i32 gl = edit_logical(s, li, line, c, true)
        (i32 wb, i32 wst) = cell.byte_at_column(line, c)
        (i32 gb, i32 gst) = edit_byte_at(s, li, line, c, true)
        if gl != wl || gb != wb || gst != wst:
            if bad < 3:
                _ = #expect(false, what, ": column ", c, " gives ", gl, " / (", gb, ", ", gst, "), the walk says ", wl, " / (", wb, ", ", wst, ")")
            bad = bad + 1
        c = c + step
    return #expect(bad == 0, what, ": ", bad, " answers differ from the walk over ", n, " bytes")

// The first mark at or past byte `b` of the index, as a byte; -1 when none.
private i32 mark_after(^EditState s, i32 b):
    for k in 0..<s.ncols:
        if s.cols[k].byte >= b:
            return s.cols[k].byte
    return -1

private bool insert_at(Control ed, i32 b, string8 text):
    text_edit_set_caret(ed, cell.pos(0, b))
    return text_edit_insert(ed, text)

private bool cut_span(Control ed, i32 a, i32 b):
    text_edit_set_selection(ed, cell.pos(0, a), cell.pos(0, b))
    return text_edit_insert(ed, "")

i32 test():
    bool ok = true
    ref []char8 l0 = make_line(2600, 7)
    ref []char8 l1 = make_line(1500, 99)
    cset(0, string8(l0[:]), "", "")
    cset(1, string8(l1[:]), "", "")
    #delete(l0)
    #delete(l1)

    Control ed = text_edit(NIL)
    EditSource src = (ccount, cline_fn, cinsert, cremove, nil)
    text_edit_set_source(ed, src)
    set_focus(ed)
    update(cell.rect(0, 0, 40, 6))
    ^EditState s = EditPtr(state(ed))

    // Built by the questions themselves, and right from the first.
    ok = same(s, 0, 3, "fresh") && ok
    (i32 m0, i64 ml0) = text_edit_column_marks(ed)
    ok = #expect(ml0 == 0 && m0 > g_len[0] / EDIT_COLUMN_STRIDE - 2, "marks laid over line 0: ", m0, " for line ", ml0) && ok

    // Edits, each checked over the whole line.
    i32 mb = mark_after(s, 3000)
    ok = #expect(mb > 0, "a mark past byte 3000: ", mb) && ok
    string8 t = cline(0)
    // A cluster boundary somewhere before the mark, to insert at.
    i32 mid = edit_snap(t, mb - 200)
    ok = #expect(insert_at(ed, mid, "\t"), "insert a tab mid-line") && ok
    ok = same(s, 0, 5, "tab inserted mid-line") && ok
    mb = mark_after(s, 0 + 2000)
    if mb < 0:
        _ = edit_col(s, 0, cline(0), g_len[0], true)
        mb = mark_after(s, 2000)
    ok = #expect(insert_at(ed, mb, "\xE6\x97\xA5"), "insert wide at a mark's own byte") && ok
    ok = same(s, 0, 5, "wide at a mark") && ok
    // A combining mark on a mark's byte joins the cluster before it: the
    // boundary the mark sat on is gone.
    _ = edit_col(s, 0, cline(0), g_len[0], true)
    mb = mark_after(s, 4000)
    ok = #expect(mb > 0, "a mark past byte 4000: ", mb) && ok
    ok = #expect(insert_at(ed, mb, "\xCC\x81"), "insert a combining mark at a mark's byte") && ok
    ok = same(s, 0, 5, "combining mark on a mark's byte") && ok
    // An edit behind the widget, told the way a program tells it, by setting
    // the source again: the index is rebuilt from nothing.
    _ = edit_col(s, 0, cline(0), g_len[0], true)
    ok = #expect(cinsert(nil, cell.pos(0, 10), "\t").byte == 11, "a tab inserted behind the widget") && ok
    text_edit_set_source(ed, src)
    ok = same(s, 0, 5, "after set_source") && ok
    // The same through the widget: `insert_at` on a boundary just after a
    // mark, so the marks at and after the edit's reach go.
    _ = edit_col(s, 0, cline(0), g_len[0], true)
    mb = mark_after(s, 5000)
    ok = #expect(insert_at(ed, mb, "a\xCC\x81\tb"), "insert with a mark and a tab at a mark's byte") && ok
    ok = same(s, 0, 5, "mark and tab at a mark") && ok
    _ = edit_col(s, 0, cline(0), g_len[0], true)
    mb = mark_after(s, 1000)
    ok = #expect(insert_at(ed, edit_snap_forward(cline(0), mb + 1), "\t\t"), "insert just after a mark") && ok
    ok = same(s, 0, 5, "tabs just after a mark") && ok
    // A removal spanning several marks, from a cluster boundary.
    _ = edit_col(s, 0, cline(0), g_len[0], true)
    i32 ra = edit_snap(cline(0), 1500)
    i32 rb = edit_snap(cline(0), 3300)
    ok = #expect(cut_span(ed, ra, rb), "remove across marks") && ok
    ok = same(s, 0, 5, "removed across marks") && ok
    // At the start and at the end.
    ok = #expect(insert_at(ed, 0, "\tq"), "insert at the start") && ok
    ok = same(s, 0, 5, "inserted at the start") && ok
    i32 n = g_len[0]
    ok = #expect(cut_span(ed, edit_snap(cline(0), n - 40), n), "remove at the end") && ok
    ok = same(s, 0, 5, "removed at the end") && ok

    // Typing at the end keeps every mark but the last few: the walk after it
    // is a stride, not the line.
    n = g_len[0]
    _ = edit_col(s, 0, cline(0), n, true)
    (i32 before, i64 _) = text_edit_column_marks(ed)
    text_edit_set_caret(ed, cell.pos(0, n))
    ok = #expect(text_edit_insert(ed, "x"), "type at the end") && ok
    (i32 kept, i64 kl) = text_edit_column_marks(ed)
    ok = #expect(kl == 0 && kept >= before - 1 && kept > 1, "marks kept at the end: ", kept, " of ", before) && ok
    update(cell.rect(0, 0, 40, 6))
    ok = same(s, 0, 7, "typed at the end") && ok
    ok = #expect(text_edit_caret_column(ed) == cell.columns(cline(0)), "caret column at the end ", text_edit_caret_column(ed), " vs ", cell.columns(cline(0))) && ok
    // The follow put the end in view.
    i32 tc = edit_text_rect(s, edit_view(ed)).cols
    i32 lc = text_edit_left_col(ed)
    i32 wc = cell.columns(cline(0))
    ok = #expect(lc <= wc && wc < lc + tc && lc > 0, "follow at the end: left ", lc, ", width ", wc, ", text cols ", tc) && ok

    // Another line claims it through the caret; line 0's questions then walk.
    text_edit_set_caret(ed, cell.pos(1, 700))
    update(cell.rect(0, 0, 40, 6))
    (i32 _, i64 l1n) = text_edit_column_marks(ed)
    ok = #expect(l1n == 1, "the caret's new line holds the index: ", l1n) && ok
    ok = same(s, 1, 5, "line 1") && ok
    ok = #expect(edit_col(s, 0, cline(0), 3000, false) == i32(cell.visual_of(cline(0), cell.LogicalOffset(3000))), "unclaimed line walks") && ok
    (i32 _, i64 still) = text_edit_column_marks(ed)
    ok = #expect(still == 1, "an unclaimed question leaves it: ", still) && ok

    // A new source drops it.
    text_edit_set_source(ed, src)
    (i32 zm, i64 zl) = text_edit_column_marks(ed)
    ok = #expect(zm == 0 && zl == -1, "set_source drops the index: ", zm, " ", zl) && ok

    reset()
    for i in 0..<2:
        if g_text[i] != nil:
            #delete(g_text[i])
            g_text[i] = nil
    if ok: return 0
    return 1
