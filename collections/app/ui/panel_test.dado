@test
// The panel and the boxed label in a real tree, with no window: a child inset
// by the content margin, nested panels, the minimum, a per-node box (the
// normal one relayouts, another state's only repaints), the state following
// focus into a descendant and out, and a label whose box's margins count into
// its minimum, from its own box and from the status table.
package ui

import "app:ui/cell"

private bool rect_is(cell.CellRect r, i32 col, i32 row, i32 cols, i32 rows):
    return r.col == col && r.row == row && r.cols == cols && r.rows == rows

private bool rect_ok(cell.CellRect r, i32 col, i32 row, i32 cols, i32 rows, string8 what):
    return #expect(rect_is(r, col, row, cols, rows), what, ": ", r.col, ",", r.row, " ", r.cols, "x", r.rows, " want ", col, ",", row, " ", cols, "x", rows)

private type PSize: (i32 cols, i32 rows)
private type PSizePtr: ^PSize

private cell.CellPoint psized(Control c, rawptr st):
    _ = c
    ^PSize s = PSizePtr(st)
    cell.CellPoint p = (s.cols, s.rows)
    return p

private Kind g_leaf_kind = NO_KIND

// A focusable leaf wanting `cols` x `rows`, expanding both ways.
private Control leaf(Control parent, i32 cols, i32 rows):
    if !kind_ok(g_leaf_kind):
        Hooks h
        h.measure = psized
        h.arrange = nil
        h.paint = nil
        h.input = nil
        h.free = nil
        g_leaf_kind = register_kind("panel_test_leaf", h)
    Control c = create_owned(g_leaf_kind, parent, i64(#size(PSize)))
    ^PSize s = PSizePtr(state(c))
    s.cols = cols
    s.rows = rows
    set_expand(c, true, true)
    set_focusable(c, true)
    return c

i32 test():
    bool ok = true
    cell.CellRect screen = cell.rect(0, 0, 30, 10)
    [4]u8 ink = [200, 0, 0, 255]

    // ── One panel: the child in the content rect, one cell in ──────────────
    Control p = panel(NIL)
    set_expand(p, true, true)
    Control a = leaf(p, 5, 2)
    update(screen)
    ok = rect_ok(rect(a), 1, 1, 28, 8, "child inset by the default one-cell margin") && ok
    ok = rect_ok(panel_rect(p), 0, 0, 30, 10, "the chrome covers the whole rect") && ok
    ok = rect_ok(panel_content_rect(p), 1, 1, 28, 8, "content rect") && ok
    cell.CellPoint pm = minimum(p)
    ok = #expect(pm.col == 7 && pm.row == 4, "minimum is the child's plus the margins: ", pm.col, "x", pm.row) && ok

    // ── Nested: each level takes its margin ────────────────────────────────
    remove(p)
    Control outer = panel(NIL)
    set_expand(outer, true, true)
    Control mid = panel(outer)
    set_expand(mid, true, true)
    Control b = leaf(mid, 5, 2)
    update(screen)
    ok = rect_ok(rect(mid), 1, 1, 28, 8, "the inner panel") && ok
    ok = rect_ok(rect(b), 2, 2, 26, 6, "its child, two cells in") && ok
    cell.CellPoint om = minimum(outer)
    ok = #expect(om.col == 9 && om.row == 6, "nested minimum ", om.col, "x", om.row) && ok

    // ── A per-node box: the normal one's margins relayout ──────────────────
    panel_set_style(mid, STATE_NORMAL, style_with_margins(style_flat([0, 0, 0, 255], ink, 3, 2, 0), 2, 0, 3, 1))
    ok = #expect(is_layout_dirty(mid), "a normal box marks layout") && ok
    update(screen)
    ok = rect_ok(rect(b), 3, 1, 23, 7, "child inset by the node's own margins") && ok
    ok = #expect(panel_style(mid, STATE_NORMAL).border_l == 3 && panel_style(outer, STATE_NORMAL).border_l == 1, "own box on one node only") && ok
    // Another state's box is ink: the panel repaints, nothing relayouts.
    panel_set_style(mid, STATE_FOCUS, style_flat([0, 0, 0, 255], ink, 1, 0, 5))
    ok = #expect(!is_layout_dirty(mid) && is_paint_dirty(mid), "a focus box marks paint only") && ok
    update(screen)
    // A bad state and a non-panel are refused.
    panel_set_style(mid, 7, style_empty())
    panel_set_style(b, STATE_NORMAL, style_empty())
    ok = #expect(!is_layout_dirty(mid) && !is_paint_dirty(mid), "refused") && ok
    ok = #expect(panel_style(NIL, STATE_NORMAL).kind == StyleKind.Empty && panel_style(mid, -1).kind == StyleKind.Empty, "reads of nothing are empty") && ok
    ok = rect_ok(panel_rect(b), 0, 0, 0, 0, "a leaf has no panel rect") && ok

    // ── State: focus anywhere inside ───────────────────────────────────────
    ok = #expect(panel_state(outer) == STATE_NORMAL && panel_state(mid) == STATE_NORMAL, "normal with nothing focused") && ok
    set_focus(b)
    ok = #expect(panel_state(outer) == STATE_FOCUS && panel_state(mid) == STATE_FOCUS, "focus held two levels down") && ok
    StyleBox now = panel_style_now(mid)
    ok = #expect(now.margin_l == 5 && now.border_l == 1, "the node's own focus box") && ok
    ok = #expect(panel_style_now(outer).border[0] == 88, "the theme's focus box") && ok
    ok = rect_ok(rect(b), 3, 1, 23, 7, "the focus box's margins do not move the child") && ok
    update(screen)
    ok = #expect(stats().painted == 0, "a focus change repaints nothing") && ok
    Control other = leaf(NIL, 1, 1)
    set_focus(other)
    ok = #expect(panel_state(outer) == STATE_NORMAL && panel_style_now(outer).border[0] == 52, "focus outside: normal again") && ok
    panel_clear_style(mid)
    update(screen)
    ok = rect_ok(rect(b), 2, 2, 26, 4, "cleared: the theme's margins again") && ok
    remove(other)
    remove(outer)

    // ── A panel writes its margins, never its child's content ──────────────
    // 30 x 10 with a one-cell margin: 300 cells, 28 x 8 = 224 of them the
    // child's, 76 the panel's.
    Control q = panel(NIL)
    set_expand(q, true, true)
    Control qc = leaf(q, 1, 1)
    update(screen)
    i64 c0 = g_panel_cells
    mark_paint(q)
    update(screen)
    ok = #expect(g_panel_cells - c0 == 76, "a repaint writes the 76 margin cells: ", g_panel_cells - c0) && ok
    // With no child in view, nobody covers the content: the panel does.
    set_visible(qc, false)
    c0 = g_panel_cells
    update(screen)
    ok = #expect(g_panel_cells - c0 == 300, "childless, the whole panel: ", g_panel_cells - c0) && ok
    // A text edit writes no cell outside its view with an empty box, and
    // only its margins with one.
    remove(q)
    Control te = text_edit(NIL)
    update(screen)
    i64 e0 = g_edit_margin_cells
    _ = text_edit_scroll_lines(te, 0)
    mark_layout(te)
    update(screen)
    ok = #expect(g_edit_margin_cells == e0, "an empty box: no margin cells, ", g_edit_margin_cells - e0) && ok
    ThemeDesc bd = theme_default()
    bd.edit_box = style_flat([0, 0, 0, 0], ink, 1, 0, 1)
    theme_set(&bd)
    update(screen)
    ok = #expect(g_edit_margin_cells - e0 == 300 - 28 * 8, "a one-cell box: its 76 margin cells, ", g_edit_margin_cells - e0) && ok
    ThemeDesc defaults = theme_default()
    theme_set(&defaults)
    remove(te)

    // ── A label with a box ─────────────────────────────────────────────────
    Control l = label(NIL, "abc")
    update(screen)
    ok = #expect(minimum(l).col == 3 && minimum(l).row == 1, "no box by default") && ok
    label_set_style(l, style_flat([0, 0, 0, 255], ink, 1, 0, 1))
    update(screen)
    ok = #expect(minimum(l).col == 5 && minimum(l).row == 3, "a one-cell box: ", minimum(l).col, "x", minimum(l).row) && ok
    ok = #expect(label_style_now(l).kind == StyleKind.Flat, "its own box") && ok
    label_clear_style(l)
    label_set_status(l, true)
    update(screen)
    ok = #expect(minimum(l).col == 3 && label_style_now(l).kind == StyleKind.Empty, "the status table's empty box") && ok
    // A theme whose status line has room either side.
    ThemeDesc d = theme_default()
    d.status_box = style_with_margins(style_flat(d.status_bg, ink, 1, 0, 0), 1, 0, 1, 0)
    theme_set(&d)
    update(screen)
    ok = #expect(minimum(l).col == 5 && minimum(l).row == 1, "a status label takes the status box: ", minimum(l).col) && ok
    label_set_status(l, false)
    update(screen)
    ok = #expect(minimum(l).col == 3, "a plain label does not") && ok
    ok = #expect(label_style_now(NIL).kind == StyleKind.Empty, "NIL label") && ok

    reset()
    if ok: return 0
    return 1
