@test
// Drawing only when the picture changes (frame.dado): the decision alone
// (`redraw_decide`), and then the real `process` hook run headless over a
// queue this test fills, reading what it decided (`frame_stats().drawn`) and
// what it measured (`input_to_render_us`).
//
// With no window the grid is not up and the screen is 0 x 0 cells, so no node
// ever paints here; the causes that do not need a picture — the first frame,
// the settling frames, `request_frame`, a focus gain, a resize event, the
// clear colour — are what the integrated half covers, and the pure half covers
// every cause, painting included.
package ui

import "app:app"
import "app:graphical"
import "app:input"
import "app:ui/cell"
import "app:ui/grid"

private i32 g_sunk
private i32 g_sunk_last = -99
private void count_sink(i32 cursor):
    g_sunk = g_sunk + 1
    g_sunk_last = cursor

private i32 pointer_cursor(Control c, rawptr st, cell.CellPoint p):
    _ = c
    _ = st
    _ = p
    return CURSOR_POINTER

private void nb_run():   return
private void nb_step():  return

private FrameChange none():
    FrameChange ch = (false, false, false, false, false, false, false)
    return ch

// Run one frame's `process` (and its `draw` when it decided to), answering
// whether it was drawn.
private bool frame_once():
    input.deliver()                    // the runtime's step 0, which this skips
    try ui_process(0.016) else code:
        _ = code
        return false
    FrameStats fs = frame_stats()
    if fs.drawn:
        try ui_draw() else code:
            _ = code
    return fs.drawn

i32 test():
    bool ok = true

    // ── The decision, pure ────────────────────────────────────────────────
    (bool d0, i32 s0) = redraw_decide(none(), 0)
    ok = #expect(!d0 && s0 == 0, "nothing changed and nothing settling: not drawn") && ok

    // Every cause alone draws, and restarts the settling count.
    for k in 0..<7:
        FrameChange ch = none()
        if k == 0:
            ch.painted = true
        if k == 1:
            ch.chrome = true
        if k == 2:
            ch.upload = true
        if k == 3:
            ch.resized = true
        if k == 4:
            ch.exposed = true
        if k == 5:
            ch.background = true
        if k == 6:
            ch.asked = true
        (bool d, i32 s) = redraw_decide(ch, 0)
        ok = #expect(d && s == SETTLE_FRAMES, "cause ", k, " alone draws and settles ", SETTLE_FRAMES,
                     " more, got ", d, " / ", s) && ok

    // A change, then quiet: the change's frame and SETTLE_FRAMES identical
    // ones — every buffer of the swapchain gets the picture — and then none.
    FrameChange painted = none()
    painted.painted = true
    i32 settle = 0
    i32 drawn = 0
    [8]bool seq
    for f in 0..<8:
        FrameChange ch = none()
        if f == 0:
            ch = painted
        (bool d, i32 s) = redraw_decide(ch, settle)
        settle = s
        seq[f] = d
        if d:
            drawn = drawn + 1
    ok = #expect(drawn == 1 + SETTLE_FRAMES, "a change draws 1 + ", SETTLE_FRAMES, " frames, drew ", drawn) && ok
    ok = #expect(seq[0] && seq[SETTLE_FRAMES] && !seq[SETTLE_FRAMES + 1] && !seq[7],
                 "the drawn frames are the first ones, then it goes quiet") && ok

    // A change while settling restarts the count rather than adding to it.
    (bool dr, i32 sr) = redraw_decide(painted, 1)
    ok = #expect(dr && sr == SETTLE_FRAMES, "a change mid-settle restarts at ", SETTLE_FRAMES, ", got ", sr) && ok

    // ── The real process hook, headless ──────────────────────────────────
    //
    // A backend advertising Input, so the frame's `input.poll` drains what
    // this test pushes.
    app.set_backend((nil, nb_run, nb_step, nb_step, app.caps(app.Capability.Input),
                     nil, nil, nil, nil, nil))
    _ = root()

    // The first frame draws (it was asked for, and the window size and the
    // clear colour are new), then SETTLE_FRAMES, then nothing.
    i32 first = 0
    for f in 0..<(SETTLE_FRAMES + 4):
        if frame_once():
            first = first + 1
    ok = #expect(first == 1 + SETTLE_FRAMES, "startup draws 1 + ", SETTLE_FRAMES, " frames, drew ", first) && ok
    ok = #expect(!frame_once() && !frame_once(), "an idle frame is not drawn") && ok
    ok = #expect(frame_stats().render_us == 0.0 && frame_stats().input_to_render_us == 0.0,
                 "an undrawn frame reports no render and no latency") && ok

    // `request_frame` draws the next frame (and its settling ones).
    request_frame()
    ok = #expect(frame_once(), "request_frame draws") && ok
    for f in 0..<(SETTLE_FRAMES + 2):
        _ = frame_once()
    ok = #expect(!frame_once(), "and then it is quiet again") && ok

    // Input that changes no pixel is processed and not drawn: a motion over a
    // tree with nothing under the pointer.
    input.push_mouse(-1, 3.0, 3.0, input.MOUSE_MOTION)
    ok = #expect(!frame_once(), "a motion that changes nothing is not drawn") && ok
    ok = #expect(frame_stats().events == 1, "but it was processed: events = ", frame_stats().events) && ok
    ok = #expect(input.pending() == 0, "and drained") && ok

    // The window coming back draws: a focus gain, and a resize event.
    input.push_focus(true)
    ok = #expect(frame_once(), "a focus gain draws") && ok
    ok = #expect(frame_stats().input_to_render_us > 0.0,
                 "a drawn frame with events has an input-to-render span, got ",
                 frame_stats().input_to_render_us) && ok
    for f in 0..<(SETTLE_FRAMES + 2):
        _ = frame_once()
    ok = #expect(frame_stats().input_to_render_us == 0.0, "a frame with no events has none") && ok
    input.push_focus(false)
    ok = #expect(!frame_once(), "a focus loss alone changes nothing here") && ok
    input.push_resize(640, 480)
    ok = #expect(frame_once(), "a resize event draws") && ok

    // Continuous mode draws every frame, and the runtime is told.
    for f in 0..<(SETTLE_FRAMES + 2):
        _ = frame_once()
    set_continuous(true)
    ok = #expect(continuous() && app.redraw_pending(), "continuous: the runtime draws every frame") && ok
    ok = #expect(frame_once() && frame_once() && frame_once() && frame_once(),
                 "continuous: every frame drawn") && ok
    set_continuous(false)
    for f in 0..<(SETTLE_FRAMES + 2):
        _ = frame_once()
    ok = #expect(!frame_once(), "on demand again: quiet") && ok

    // ── The cursor is synced every frame, not only on event or paint ─────
    // A program's `process` taking the capture changes the wanted cursor
    // with no event and no paint this frame.
    Hooks ph
    ph.cursor = pointer_cursor
    Control holder = create(register_kind("redraw_pointer", ph), NIL, nil)
    set_cursor_sink(count_sink)
    input.push_mouse(-1, 1.0, 1.0, input.MOUSE_MOTION)
    _ = frame_once()
    i32 sunk0 = g_sunk
    capture(holder)
    _ = frame_once()
    ok = #expect(frame_stats().events == 0 && stats().painted == 0, "a frame with no events and no paint") && ok
    ok = #expect(g_sunk == sunk0 + 1 && g_sunk_last == CURSOR_POINTER,
                 "still sets the capturing node's cursor, got ", g_sunk - sunk0, " calls") && ok
    release()
    _ = frame_once()
    ok = #expect(g_sunk == sunk0 + 2 && g_sunk_last == CURSOR_DEFAULT, "and the release puts the default back") && ok
    set_cursor_sink(nil)
    for f in 0..<(SETTLE_FRAMES + 2):
        _ = frame_once()

    // ── A region emptied under a hidden root asks for a frame ─────────────
    // A hidden root paints nothing, so only the region sweep can say the
    // picture changed.
    ok = #expect(grid.up_headless(8, 16), "a headless grid for a region") && ok
    i32 rid = grid.region_make(grid.BASE)
    ok = #expect(rid >= 0 && grid.region_set_rect(rid, cell.rect(0, 0, 2, 2)), "a region with cells") && ok
    set_region(holder, rid)
    g_frame_asked = false
    set_visible(root(), false)
    update(cell.rect(0, 0, 10, 6))
    ok = #expect(cell.is_empty(grid.region_rect(rid)), "the hidden root's region is emptied") && ok
    ok = #expect(g_frame_asked, "and a frame is asked for") && ok
    g_frame_asked = false
    update(cell.rect(0, 0, 10, 6))
    ok = #expect(!g_frame_asked, "an already empty region asks for nothing") && ok
    set_visible(root(), true)
    set_region(holder, -1)
    grid.region_free(rid)
    grid.down()

    // ── The idle nap is a budget: the swap's wait counts against it ───────
    ok = #expect(graphical.idle_nap_ms(8, 0.001) == 7, "1 ms spent of 8: nap 7, got ",
                 graphical.idle_nap_ms(8, 0.001)) && ok
    ok = #expect(graphical.idle_nap_ms(8, 0.0167) == 0, "a refresh-long swap wait spent it all: no nap") && ok
    ok = #expect(graphical.idle_nap_ms(8, 0.0) == 8 && graphical.idle_nap_ms(8, -1.0) == 8,
                 "nothing spent: the whole budget") && ok
    ok = #expect(graphical.idle_nap_ms(0, 0.0) == 0 && graphical.idle_nap_ms(-3, 0.0) == 0, "no budget, no nap") && ok
    ok = #expect(graphical.idle_nap_ms(8, 0.0075) == 0, "under a millisecond left rounds down to none") && ok

    reset()
    if ok:
        return 0
    return 1
