@test
// The layout arithmetic with no tree: `vbox_arrange` and `vbox_minimum` over
// hand-built runs — the expand remainder, a shortage, zero children, a
// zero-height box — and the margin helpers. Then the two containers in a real
// tree, through `update`.
package ui

import "app:ui/cell"

private bool rect_is(cell.CellRect r, i32 col, i32 row, i32 cols, i32 rows):
    return r.col == col && r.row == row && r.cols == cols && r.rows == rows

private cell.CellPoint pt(i32 c, i32 r):
    cell.CellPoint p = (c, r)
    return p

// A leaf whose minimum is whatever its state points at.
private type Size: (i32 cols, i32 rows)
private type SizePtr: ^Size

private cell.CellPoint sized_measure(Control c, rawptr st):
    _ = c
    ^Size s = SizePtr(st)
    cell.CellPoint p = (s.cols, s.rows)
    return p

i32 test():
    bool ok = true
    [8]cell.CellPoint mins
    [8]bool grow
    [8]cell.CellRect out

    // ── Minimums only, no expanders, room to spare ─────────────────────────
    mins[0] = pt(4, 2)
    mins[1] = pt(7, 1)
    mins[2] = pt(2, 3)
    grow[0] = false
    grow[1] = false
    grow[2] = false
    i32 used = vbox_arrange(cell.rect(10, 5, 20, 10), mins[0..<3], grow[0..<3], out[0..<3])
    ok = #expect(used == 6, "used ", used) && ok
    ok = #expect(rect_is(out[0], 10, 5, 20, 2), "child 0 ", out[0].col, ",", out[0].row, " ", out[0].cols, "x", out[0].rows) && ok
    ok = #expect(rect_is(out[1], 10, 7, 20, 1), "child 1") && ok
    ok = #expect(rect_is(out[2], 10, 8, 20, 3), "child 2") && ok
    cell.CellPoint vm = vbox_minimum(mins[0..<3])
    ok = #expect(vm.col == 7 && vm.row == 6, "vbox minimum ", vm.col, "x", vm.row) && ok

    // ── Expand: leftover 10 - 6 = 4 among two expanders is 2 each ──────────
    grow[0] = true
    grow[2] = true
    used = vbox_arrange(cell.rect(0, 0, 5, 10), mins[0..<3], grow[0..<3], out[0..<3])
    ok = #expect(used == 10, "all rows used ", used) && ok
    ok = #expect(out[0].rows == 4 && out[1].rows == 1 && out[2].rows == 5, "even share ", out[0].rows, " ", out[1].rows, " ", out[2].rows) && ok
    ok = #expect(out[1].row == 4 && out[2].row == 5, "stacked") && ok

    // ── The remainder: leftover 7 among three expanders is 2 each and 1
    // over, which goes to the first expander in order ─────────────────────
    mins[0] = pt(1, 1)
    mins[1] = pt(1, 1)
    mins[2] = pt(1, 1)
    mins[3] = pt(1, 1)
    grow[0] = false
    grow[1] = true
    grow[2] = true
    grow[3] = true
    used = vbox_arrange(cell.rect(0, 0, 3, 11), mins[0..<4], grow[0..<4], out[0..<4])
    ok = #expect(used == 11, "remainder used ", used) && ok
    ok = #expect(out[0].rows == 1 && out[1].rows == 4 && out[2].rows == 3 && out[3].rows == 3, "remainder to the first expander ", out[1].rows, " ", out[2].rows, " ", out[3].rows) && ok
    // Leftover 8 among three: 2 each and 2 over, to the first two expanders.
    used = vbox_arrange(cell.rect(0, 0, 3, 12), mins[0..<4], grow[0..<4], out[0..<4])
    ok = #expect(out[1].rows == 4 && out[2].rows == 4 && out[3].rows == 3, "two over ", out[1].rows, " ", out[2].rows, " ", out[3].rows) && ok

    // ── Shortage: minimums 3, 3, 3 in 7 rows are 3, 3, 1 ───────────────────
    mins[0] = pt(1, 3)
    mins[1] = pt(1, 3)
    mins[2] = pt(1, 3)
    grow[0] = true
    grow[1] = false
    grow[2] = true
    used = vbox_arrange(cell.rect(0, 0, 3, 7), mins[0..<3], grow[0..<3], out[0..<3])
    ok = #expect(used == 7, "shortage used ", used) && ok
    ok = #expect(out[0].rows == 3 && out[1].rows == 3 && out[2].rows == 1, "shortage in order ", out[0].rows, " ", out[1].rows, " ", out[2].rows) && ok
    // In 4 rows: 3, 1, 0 — never negative.
    used = vbox_arrange(cell.rect(0, 0, 3, 4), mins[0..<3], grow[0..<3], out[0..<3])
    ok = #expect(out[0].rows == 3 && out[1].rows == 1 && out[2].rows == 0 && out[2].row == 4, "zero rows at the end") && ok

    // ── Zero children, zero-height box, negative extents ──────────────────
    ok = #expect(vbox_arrange(cell.rect(0, 0, 5, 5), mins[0..<0], grow[0..<0], out[0..<0]) == 0, "no children") && ok
    cell.CellPoint none = vbox_minimum(mins[0..<0])
    ok = #expect(none.col == 0 && none.row == 0, "no children minimum") && ok
    used = vbox_arrange(cell.rect(2, 3, 5, 0), mins[0..<3], grow[0..<3], out[0..<3])
    ok = #expect(used == 0 && out[0].rows == 0 && out[2].rows == 0 && out[2].row == 3, "zero-height box") && ok
    used = vbox_arrange(cell.rect(0, 0, -4, -2), mins[0..<3], grow[0..<3], out[0..<3])
    ok = #expect(used == 0 && out[0].cols == 0 && out[0].rows == 0, "negative box") && ok
    mins[0] = pt(-3, -3)
    used = vbox_arrange(cell.rect(0, 0, 5, 10), mins[0..<1], grow[0..<1], out[0..<1])
    ok = #expect(out[0].rows == 10, "negative minimum is zero, then expands ", out[0].rows) && ok
    // Runs of different lengths: the shortest decides.
    used = vbox_arrange(cell.rect(0, 0, 5, 10), mins[0..<3], grow[0..<3], out[0..<1])
    ok = #expect(used == 10, "shortest run decides ", used) && ok

    // ── Margin helpers ────────────────────────────────────────────────────
    mins[0] = pt(4, 1)
    mins[1] = pt(2, 5)
    cell.CellPoint mm = margin_minimum(mins[0..<2], 1, 2, 3, 4)
    ok = #expect(mm.col == 4 + 1 + 3 && mm.row == 5 + 2 + 4, "margin minimum ", mm.col, "x", mm.row) && ok
    cell.CellPoint me = margin_minimum(mins[0..<0], 1, 2, 3, 4)
    ok = #expect(me.col == 4 && me.row == 6, "margin minimum, no children") && ok
    ok = #expect(rect_is(margin_inner(cell.rect(0, 0, 10, 10), 1, 2, 3, 4), 1, 2, 6, 4), "margin inner") && ok
    ok = #expect(rect_is(margin_inner(cell.rect(0, 0, 3, 3), 2, 2, 2, 2), 2, 2, 0, 0), "margin inner floors at zero") && ok

    // ── In a tree ─────────────────────────────────────────────────────────
    Hooks h
    h.measure = sized_measure
    h.arrange = nil
    h.paint = nil
    h.input = nil
    h.free = nil
    Kind sized = register_kind("sized", h)
    [4]Size sizes
    sizes[0] = (6, 2)
    sizes[1] = (3, 1)
    sizes[2] = (9, 1)
    sizes[3] = (1, 1)

    //  root (vbox, the screen 40x20 at 0,0)
    //  ├── m  margin 1,2,3,4
    //  │   └── v  vbox
    //  │       ├── a  6x2
    //  │       └── b  3x1  expands
    //  └── c  9x1
    Control m = margin_box(NIL, 1, 2, 3, 4)
    Control v = vbox(m)
    Control a = create(sized, v, rawptr(&sizes[0]))
    Control b = create(sized, v, rawptr(&sizes[1]))
    Control c = create(sized, NIL, rawptr(&sizes[2]))
    set_expand(b, false, true)
    set_expand(m, false, true)
    update(cell.rect(0, 0, 40, 20))
    cell.CellPoint vmin = minimum(v)
    ok = #expect(vmin.col == 6 && vmin.row == 3, "inner vbox minimum ", vmin.col, "x", vmin.row) && ok
    cell.CellPoint mmin = minimum(m)
    ok = #expect(mmin.col == 6 + 4 && mmin.row == 3 + 6, "margin box minimum ", mmin.col, "x", mmin.row) && ok
    cell.CellPoint rmin = minimum(root())
    ok = #expect(rmin.col == 10 && rmin.row == 10, "root minimum ", rmin.col, "x", rmin.row) && ok
    // The root has 20 rows: c takes 1, m takes 9 + the 10 left over.
    ok = #expect(rect_is(rect(m), 0, 0, 40, 19), "m ", rect(m).col, ",", rect(m).row, " ", rect(m).cols, "x", rect(m).rows) && ok
    ok = #expect(rect_is(rect(c), 0, 19, 40, 1), "c") && ok
    // v is m inset by 1,2,3,4: (1, 2, 36, 13).
    ok = #expect(rect_is(rect(v), 1, 2, 36, 13), "v ", rect(v).col, ",", rect(v).row, " ", rect(v).cols, "x", rect(v).rows) && ok
    ok = #expect(rect_is(rect(a), 1, 2, 36, 2), "a") && ok
    ok = #expect(rect_is(rect(b), 1, 4, 36, 11), "b ", rect(b).rows) && ok

    // Changing the margins moves everything inside.
    set_margins(m, 0, 0, 0, 0)
    update(cell.rect(0, 0, 40, 20))
    ok = #expect(rect_is(rect(v), 0, 0, 40, 19), "v after margins") && ok
    ok = #expect(rect_is(rect(b), 0, 2, 40, 17), "b after margins") && ok

    // A margin box with two children gives both the same inner rectangle.
    Control second = create(sized, m, rawptr(&sizes[3]))
    update(cell.rect(0, 0, 40, 20))
    ok = #expect(rect(second) == rect(v), "both children of a margin box share its inside") && ok

    // Hiding b gives it an empty rectangle and its rows to nobody.
    set_visible(b, false)
    update(cell.rect(0, 0, 40, 20))
    ok = #expect(cell.is_empty(rect(b)), "hidden b is empty") && ok
    ok = #expect(minimum(v).row == 2, "hidden b measures zero ", minimum(v).row) && ok

    reset()
    if ok: return 0
    return 1
