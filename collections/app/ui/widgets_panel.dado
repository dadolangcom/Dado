// app:ui — `Panel`: a container drawn as a `StyleBox`.
//
// A panel arranges every child into its **content rect** — its own rect less
// its box's content margins — and its minimum is the largest child minimum
// on each axis plus those margins, as a margin box's is. It draws no pixels:
// the box's fill, border and shadow are the chrome pass's, which reads
// `panel_style_now` and `panel_rect`. What a panel paints is its whole clip in
// blank cells of `PanelTheme.bg` (alpha 0 in every theme that has a chrome
// pass), so the fill shows through the margins, and its children then paint
// the content rect over that.
//
// **State.** A panel is in `STATE_FOCUS` while it or any descendant has focus,
// and in `STATE_NORMAL` otherwise; hover, pressed and disabled are in the
// tables but nothing puts a panel in them yet. The state is read at the call,
// not cached, because a change of focus marks nothing.
//
// **The layout reads the normal box only.** The content margins are the
// `STATE_NORMAL` box's in every state, so a focus change is a change of ink
// and never of layout: nothing re-measures and no cell repaints when focus
// moves in or out. A theme that gives the focus box other margins has them
// ignored — refused, rather than a relayout on every focus change.
//
// **Per node.** `panel_set_style` gives one panel its own box for one state,
// the exception to reading the theme; `panel_clear_style` gives it back.
//
// ## Popup and Dialog
//
// A **popup** is a panel that floats: it reads `PopupTheme` rather than
// `PanelTheme` — a filled box lifted by a shadow — and it paints into a layer
// of its own, one above its parent's, chosen here, so a program never names a
// layer. Put in a `stack` with an anchor (`set_anchor`) it sits over the
// stack's other children — a find bar over an editor — and showing and hiding
// it costs its own cells and nothing under it (`set_visible`). Two popups on
// one layer must not overlap (layers.dado says why), which popups under
// different parents' stacks, side by side, do not.
//
// A **dialog** is a popup that is modal while open. It sits two layers above
// its parent's — above any popup of the same parent, so a palette opened over
// a find bar is drawn over it — starts hidden, and `dialog_open` shows it and
// makes it the modal in force (modal.dado: focus moves inside, keys go to it,
// the mouse outside is swallowed and `outside_pressed` emitted); `dialog_close`
// gives the modality up, focus goes back where it was, and hides it. Hiding or
// removing it by any other means releases the modality just the same.
package ui

import "app:ui/cell"
import "app:ui/grid"

private type PanelState: (
    [5]StyleBox own,
    [5]bool     has_own,
    // A popup reads `PopupTheme`; a dialog is a popup that opens modal.
    bool        popup,
    bool        dialog,
)
private type PanelPtr: ^PanelState

private Kind g_panel_kind = NO_KIND
// Cells panels have written, ever; read by the tests.
private i64  g_panel_cells


private Kind panel_kind():
    if !kind_ok(g_panel_kind):
        Hooks h
        h.measure = panel_measure_hook
        h.arrange = panel_arrange_hook
        h.paint = panel_paint_hook
        h.input = nil
        h.free = nil
        h.style = panel_style_hook
        g_panel_kind = register_kind("panel", h)
    return g_panel_kind

private bool is_panel(Control c):
    return kind(c) == g_panel_kind && state(c) != nil

private bool state_ok(i32 st):
    return st >= 0 && st < STATE_COUNT

// The box for `st`: the node's own when it has one, else the theme's.
private StyleBox panel_box(^PanelState s, i32 st):
    if s.has_own[st]:
        return s.own[st]
    if s.popup:
        return theme_popup().box[st]
    return theme_panel().box[st]

// The background of the panel's margin cells, from its table.
private [4]u8 panel_bg(^PanelState s):
    if s.popup:
        return theme_popup().bg
    return theme_panel().bg

private cell.CellPoint panel_measure_hook(Control c, rawptr st):
    StyleBox b = panel_box(PanelPtr(st), STATE_NORMAL)
    i32 n = gather(c)
    if n < 0:
        n = 0
    return margin_minimum(g_mins[0..<n], b.margin_l, b.margin_t, b.margin_r, b.margin_b)

private void panel_arrange_hook(Control c, rawptr st, cell.CellRect r):
    cell.CellRect inner = inner_rect(panel_box(PanelPtr(st), STATE_NORMAL), r)
    Control ch = first_child(c)
    for valid(ch):
        set_rect(ch, inner)
        ch = next_sibling(ch)

private StyleBox panel_style_hook(Control c, rawptr st):
    _ = st
    return panel_style_now(c)

// Only the margin cells: the content rect is its children's, and writing it
// too would make every panel repaint write the window twice. A panel with no
// child in view has no one to cover its content, and fills it as well.
private void panel_paint_hook(Control c, rawptr st, cell.CellRect clip):
    [4]u8 bg = panel_bg(PanelPtr(st))
    bool covered = false
    Control ch = first_child(c)
    for valid(ch):
        if is_visible(ch):
            covered = true
        ch = next_sibling(ch)
    if !covered:
        grid.fill(clip, bg, bg)
        g_panel_cells = g_panel_cells + i64(clip.cols) * i64(clip.rows)
        return
    cell.CellRect inner = inner_rect(panel_box(PanelPtr(st), STATE_NORMAL), rect(c))
    g_panel_cells = g_panel_cells + fill_outside(clip, inner, bg, bg)

// Blank every cell of `clip` that is not in `inner`, as at most four bands:
// above, below, left and right of it. Answers how many cells that is.
private i64 fill_outside(cell.CellRect clip, cell.CellRect inner, [4]u8 fg, [4]u8 bg):
    cell.CellRect ir = cell.intersect(clip, inner)
    i64 all = i64(clip.cols) * i64(clip.rows)
    if cell.is_empty(ir):
        grid.fill(clip, fg, bg)
        return all
    grid.fill(cell.rect(clip.col, clip.row, clip.cols, ir.row - clip.row), fg, bg)
    grid.fill(cell.rect(clip.col, ir.row + ir.rows, clip.cols, clip.row + clip.rows - ir.row - ir.rows), fg, bg)
    grid.fill(cell.rect(clip.col, ir.row, ir.col - clip.col, ir.rows), fg, bg)
    grid.fill(cell.rect(ir.col + ir.cols, ir.row, clip.col + clip.cols - ir.col - ir.cols, ir.rows), fg, bg)
    return all - i64(ir.cols) * i64(ir.rows)

// A panel under `parent` (under the root for `NIL`), drawing its theme's
// boxes; `NIL` wherever `create` would answer it.
Control panel(Control parent):
    return create_owned(panel_kind(), parent, i64(#size(PanelState)))

// Give this panel its own box for state `st` (`STATE_NORMAL` ...
// `STATE_DISABLED`). The normal box's margins are the layout's, so setting
// it marks the panel for layout; any other state's is ink only, and marks it
// for paint so whatever draws its chrome sees the change. Does nothing for a
// state out of range, a node that is not a live panel, or while `update`
// runs.
void panel_set_style(Control c, i32 st, StyleBox b):
    if !is_panel(c) || !state_ok(st) || g_phase != PHASE_IDLE:
        return
    ^PanelState s = PanelPtr(state(c))
    s.own[st] = b
    s.has_own[st] = true
    chrome_changed()
    if st == STATE_NORMAL:
        mark_layout(c)
    else:
        mark_paint(c)

// Drop every box of this panel's own; it reads the theme's again.
void panel_clear_style(Control c):
    if !is_panel(c) || g_phase != PHASE_IDLE:
        return
    ^PanelState s = PanelPtr(state(c))
    for i in 0..<STATE_COUNT:
        s.has_own[i] = false
    chrome_changed()
    mark_layout(c)

// `STATE_FOCUS` while the panel or a descendant has focus, else
// `STATE_NORMAL`; `STATE_NORMAL` for anything that is not a live panel.
i32 panel_state(Control c):
    if is_panel(c) && focus_within(c):
        return STATE_FOCUS
    return STATE_NORMAL

// The box for state `st` as the panel would draw it: its own, or the
// theme's. `style_empty()` for a bad state or a node that is not a panel.
StyleBox panel_style(Control c, i32 st):
    if !is_panel(c) || !state_ok(st):
        return style_empty()
    return panel_box(PanelPtr(state(c)), st)

// The box for the panel's state now: what its chrome is drawn with this
// frame.
StyleBox panel_style_now(Control c):
    return panel_style(c, panel_state(c))

// The rect the panel's chrome covers: its whole rect, unclipped. Its bleed
// past that is `bleed_cells(panel_style_now(c), grid.cell_w(),
// grid.cell_h())`.
cell.CellRect panel_rect(Control c):
    if !is_panel(c):
        return cell.rect(0, 0, 0, 0)
    return rect(c)

// The rect the panel gives its children.
cell.CellRect panel_content_rect(Control c):
    if !is_panel(c):
        return cell.rect(0, 0, 0, 0)
    return inner_rect(panel_style(c, STATE_NORMAL), rect(c))

// ── Popup and Dialog ───────────────────────────────────────────────────────

// A popup under `parent` (under the root for `NIL`), on the layer above its
// parent's; `NIL` wherever `create` would answer it.
Control popup(Control parent):
    return popup_make(parent, false)

private Control popup_make(Control under, bool dialog):
    Control c = create_owned(panel_kind(), under, i64(#size(PanelState)))
    if !valid(c):
        return NIL
    ^PanelState s = PanelPtr(state(c))
    s.popup = true
    s.dialog = dialog
    i32 up = 1
    if dialog:
        up = 2
    set_layer(c, node_layer(parent(c)) + up)
    return c

// Whether `c` is a live popup (a dialog is one).
bool is_popup(Control c):
    return is_panel(c) && PanelPtr(state(c)).popup

// A dialog under `parent`, hidden, two layers above its parent's; `NIL`
// wherever `create` would answer it.
Control dialog(Control parent):
    Control c = popup_make(parent, true)
    set_visible(c, false)
    return c

private bool is_dialog(Control c):
    return is_panel(c) && PanelPtr(state(c)).dialog

// Show the dialog and make it the modal in force. Does nothing to anything
// that is not a live dialog, to one already open, or while `update` runs.
void dialog_open(Control c):
    if !is_dialog(c) || g_phase != PHASE_IDLE || dialog_is_open(c):
        return
    set_visible(c, true)
    modal_open(c)

// Give the modality up — focus goes back to what had it when the dialog
// opened — and hide the dialog. Does nothing to anything that is not a live
// dialog, or while `update` runs.
void dialog_close(Control c):
    if !is_dialog(c) || g_phase != PHASE_IDLE:
        return
    modal_close(c)
    set_visible(c, false)

// Whether the dialog is shown and the modal stack holds it.
bool dialog_is_open(Control c):
    return is_dialog(c) && is_visible(c) && is_modal(c)
