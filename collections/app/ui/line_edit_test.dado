@test
// The line edit with no window (a grid taken up headless with 8 x 16 cells,
// so its cells are read back): typing, the caret through clusters, selection
// and replacing it, undo and redo, the clipboard pair with line breaks made
// spaces, no fixed cap on the text, horizontal scroll that keeps the caret in
// view, the placeholder drawn only while empty and never over the caret,
// Enter and Escape as signals with the modifiers kept, Tab and the wheel left
// to bubble, the vertical keys offered to a list that the field drives while
// keeping focus, and every entry point total over a bad handle.
package ui

import "app:input"
import "app:ui/cell"
import "app:ui/grid"

private const u32 LE_SHIFT = 0x1
private const u32 LE_SUPER = 0x8

private bool le_key(i32 code, u32 mods):
    input.Event e = (input.EventKind.Key, code, 0.0, 0.0, mods)
    return dispatch(e)

private bool le_type(string8 s):
    bool all = true
    for i in 0..<#len(s):
        input.Event e = (input.EventKind.Text, i32(u8(s[i])), 0.0, 0.0, 0)
        all = dispatch(e) && all
    return all

private bool text_is(Control c, string8 want, string8 what):
    string8 got = line_edit_text(c)
    return #expect(got == want, what, ": text '", got, "' want '", want, "'")

private bool caret_at(Control c, i32 byte, string8 what):
    cell.TextPos p = text_edit_caret(c)
    return #expect(p.line == 0 && p.byte == byte, what, ": caret ", p.line, ",", p.byte, " want 0,", byte)

// A fake clipboard.
private [64]char8 g_le_clip
private i32 g_le_clip_n

private bool le_clip_set(string8 t):
    if #len(t) > 64:
        return false
    for k in 0..<#len(t):
        g_le_clip[k] = t[k]
    g_le_clip_n = i32(#len(t))
    return true

private string8 le_clip_get():
    return string8(g_le_clip[0..<g_le_clip_n])

// Signals.
private i32 g_le_submits
private i32 g_le_cancels
private i32 g_le_changes

private void le_on_submit(Control c, rawptr ctx):
    _ = c
    _ = ctx
    g_le_submits = g_le_submits + 1

private void le_on_cancel(Control c, rawptr ctx):
    _ = c
    _ = ctx
    g_le_cancels = g_le_cancels + 1

private void le_on_change(Control c, rawptr ctx):
    _ = c
    _ = ctx
    g_le_changes = g_le_changes + 1

// A parent that records the keys that bubble to it.
private i32 g_le_bubbled
private i32 g_le_last

private bool le_parent_input(Control c, rawptr st, input.Event e):
    _ = c
    _ = st
    if !input.is_key_press(e) && input.wheel_amount(e) == 0.0:
        return false
    g_le_bubbled = g_le_bubbled + 1
    g_le_last = e.code
    return true

private Kind g_le_parent = NO_KIND

// The list the field drives: 50 rows.
private i64 le_rows(rawptr ctx):
    _ = ctx
    return 50

private string8 le_row(rawptr ctx, i64 i):
    _ = ctx
    _ = i
    return "row"

i32 test():
    bool ok = true
    ok = #expect(grid.up_headless(8, 16), "a headless grid") && ok
    cell.CellRect screen = cell.rect(0, 0, 20, 12)
    _ = grid.begin(20 * 8, 12 * 16)
    text_edit_set_clipboard(le_clip_set, le_clip_get)

    Hooks ph
    ph.measure = vbox_measure_hook
    ph.arrange = vbox_arrange_hook
    ph.input = le_parent_input
    g_le_parent = register_kind("le_parent", ph)
    Control box = create(g_le_parent, NIL, nil)
    set_expand(box, true, true)
    Control le = line_edit(box)
    Control multi = text_edit(NIL)
    update(screen)

    ok = #expect(is_line_edit(le) && is_edit(le) && !is_line_edit(multi), "a line edit is a text edit in single-line mode") && ok
    ok = #expect(rect(le).rows == 1 && rect(le).cols == 20, "one row, the box's width: ", rect(le).cols, "x", rect(le).rows) && ok
    ok = #expect(minimum(le).row == 1 && !expands_v(le) && expands_h(le) && is_focusable(le), "a row tall, growing sideways") && ok
    ok = text_is(le, "", "empty") && ok
    ok = #expect(text_edit_region(le) < 0, "no grid region for one row") && ok
    ok = #expect(!text_edit_gutter(le), "no gutter") && ok

    on_submitted(le, le_on_submit, nil)
    on_cancelled(le, le_on_cancel, nil)
    on_text_changed(le, le_on_change, nil)
    set_focus(le)

    // ── Typing, the caret, the selection ───────────────────────────────────
    ok = #expect(le_type("hello"), "typed") && text_is(le, "hello", "five letters") && caret_at(le, 5, "at the end") && ok
    ok = #expect(g_le_changes == 5, "text_changed per letter: ", g_le_changes) && ok
    ok = #expect(le_key(i32(input.Keycode.Left), 0) && le_key(i32(input.Keycode.Left), 0), "left twice") && caret_at(le, 3, "two back") && ok
    ok = #expect(le_key(i32(input.Keycode.Home), LE_SHIFT), "shift+home") && ok
    (cell.TextPos sf, cell.TextPos st) = text_edit_selection(le)
    ok = #expect(sf == cell.pos(0, 0) && st == cell.pos(0, 3), "selected 0..3") && ok
    ok = #expect(le_type("J"), "typed over") && text_is(le, "Jlo", "the selection replaced") && ok
    ok = #expect(le_key(i32('Z'), LE_SUPER), "undo") && text_is(le, "hello", "undone") && ok
    (sf, st) = text_edit_selection(le)
    ok = #expect(sf == cell.pos(0, 0) && st == cell.pos(0, 3), "the selection comes back with the undo") && ok
    ok = #expect(le_key(i32('Z'), LE_SUPER | LE_SHIFT), "redo") && text_is(le, "Jlo", "redone") && ok
    // A cluster: e and a combining acute are one step for the caret.
    line_edit_set_text(le, "e\xCC\x81x")
    ok = text_is(le, "e\xCC\x81x", "set") && caret_at(le, 4, "set puts the caret at the end") && ok
    ok = #expect(!text_edit_can_undo(le), "a set text empties the log") && ok
    ok = #expect(le_key(i32(input.Keycode.Left), 0) && le_key(i32(input.Keycode.Left), 0), "left twice") && caret_at(le, 0, "over the cluster whole") && ok
    ok = #expect(le_key(i32(input.Keycode.Delete), 0), "delete") && text_is(le, "x", "the whole cluster went") && ok

    // ── The clipboard, and line breaks ─────────────────────────────────────
    line_edit_set_text(le, "copy me")
    text_edit_select_all(le)
    ok = #expect(le_key(i32('C'), LE_SUPER), "copy") && ok
    ok = #expect(le_clip_get() == "copy me", "copied") && ok
    _ = le_clip_set("a\nb\r\nc")
    ok = #expect(le_key(i32('V'), LE_SUPER), "paste over the selection") && text_is(le, "a b c", "breaks made spaces") && ok
    ok = #expect(le_key(i32('Z'), LE_SUPER), "undo the paste") && text_is(le, "copy me", "one step") && ok
    ok = #expect(text_edit_insert(le, "\n!"), "a program's insert") && ok
    ok = #expect(line_edit_text(le) == " !", "its break a space too: '", line_edit_text(le), "'") && ok
    text_edit_set_caret(le, cell.pos(3, 99))
    ok = caret_at(le, 2, "a caret asked past the line lands at its end, on line 0") && ok

    // ── No cap, and the horizontal scroll ──────────────────────────────────
    [300]char8 big
    for k in 0..<300:
        big[k] = char8(u8(97 + k % 26))
    line_edit_set_text(le, string8(big[:]))
    string8 held = line_edit_text(le)
    ok = #expect(#len(held) == 300, "300 bytes held: ", #len(held)) && ok
    update(screen)
    i32 lc = text_edit_left_col(le)
    ok = #expect(lc == 300 - 20 + 1, "scrolled so the caret, past the last byte, is the last column: ", lc) && ok
    ok = #expect(grid.cell_at(19, 0).bg == theme_line_edit().caret_bg, "the caret drawn in the last cell") && ok
    ok = #expect(le_key(i32(input.Keycode.Home), 0), "home") && ok
    ok = #expect(text_edit_left_col(le) == 0, "back to column 0") && ok
    update(screen)
    ok = #expect(grid.cell_at(0, 0).bg == theme_line_edit().caret_bg, "the caret in the first cell") && ok

    // ── The placeholder ────────────────────────────────────────────────────
    line_edit_set_text(le, "")
    line_edit_set_placeholder(le, "Find")
    ok = #expect(line_edit_placeholder(le) == "Find", "kept") && ok
    update(screen)
    LineEditTheme lt = theme_line_edit()
    ok = #expect(grid.cell_at(0, 0).bg == lt.caret_bg, "the caret over the placeholder's first cell") && ok
    ok = #expect(grid.cell_at(1, 0).fg == lt.placeholder_fg && grid.cell_at(3, 0).fg == lt.placeholder_fg, "the rest in the placeholder colour") && ok
    ok = #expect(grid.cell_at(4, 0).fg == lt.fg, "and nothing past it") && ok
    ok = #expect(lt.placeholder_fg != lt.fg, "a colour of its own") && ok
    ok = #expect(le_type("q"), "typed") && ok
    update(screen)
    ok = #expect(grid.cell_at(0, 0).fg == lt.fg && grid.cell_at(0, 0).bg == lt.bg, "the typed letter in the text colour") && ok
    ok = #expect(grid.cell_at(2, 0).fg == lt.fg && grid.cell_at(3, 0).fg == lt.fg, "the placeholder gone") && ok

    // ── Enter, Escape, Tab, the wheel ──────────────────────────────────────
    i32 changes = g_le_changes
    ok = #expect(le_key(i32(input.Keycode.Enter), 0) && g_le_submits == 1, "enter submits") && ok
    ok = #expect(line_edit_submit_mods(le) == 0, "with no modifier") && ok
    ok = #expect(le_key(i32(input.Keycode.Enter), LE_SHIFT) && g_le_submits == 2 && (line_edit_submit_mods(le) & LE_SHIFT) != 0, "shift+enter, the shift kept") && ok
    ok = #expect(le_key(i32(input.Keycode.KpEnter), 0) && g_le_submits == 3, "keypad enter") && ok
    ok = #expect(le_key(i32(input.Keycode.Escape), 0) && g_le_cancels == 1, "escape cancels") && ok
    ok = text_is(le, "q", "neither changed the text") && ok
    ok = #expect(g_le_changes == changes, "nor announced a change") && ok
    (i64 subs, i64 cans) = line_edit_counters(le)
    ok = #expect(subs == 3 && cans == 1, "counted") && ok
    g_le_bubbled = 0
    ok = #expect(le_key(i32(input.Keycode.Tab), 0) && g_le_bubbled == 1 && g_le_last == i32(input.Keycode.Tab), "tab bubbles to the parent") && ok
    ok = text_is(le, "q", "and types nothing") && ok
    input.Event wh = (input.EventKind.Mouse, 1, 2.5, 0.5, input.MOUSE_WHEEL)
    ok = #expect(dispatch(wh) && g_le_bubbled == 2, "the wheel bubbles") && ok
    ok = #expect(le_key(i32(input.Keycode.Down), 0) && g_le_bubbled == 3, "with no key target, down bubbles") && ok
    // A command chord with Alt is the program's: it bubbles too.
    ok = #expect(le_key(i32('C'), LE_SUPER | 0x4) && g_le_bubbled == 4, "cmd+alt+c bubbles") && ok

    // ── Driving a list ─────────────────────────────────────────────────────
    Control list = tree_view(box)
    TreeSource src
    src.count = le_rows
    src.label = le_row
    tree_set_source(list, src)
    tree_set_flat(list, true)
    line_edit_set_key_target(le, list)
    ok = #expect(line_edit_key_target(le) == list, "the target is kept") && ok
    update(screen)
    g_le_bubbled = 0
    ok = #expect(le_key(i32(input.Keycode.Down), 0) && tree_selection(list) == 0, "down selects the first row") && ok
    ok = #expect(le_key(i32(input.Keycode.Down), 0) && le_key(i32(input.Keycode.Down), 0) && tree_selection(list) == 2, "and on") && ok
    ok = #expect(le_key(i32(input.Keycode.Up), 0) && tree_selection(list) == 1, "up") && ok
    i64 page = i64(rect(list).rows) - 1
    ok = #expect(le_key(i32(input.Keycode.PageDown), 0) && tree_selection(list) == 1 + page, "a page: ", tree_selection(list)) && ok
    ok = #expect(le_key(i32(input.Keycode.PageUp), 0) && tree_selection(list) == 1, "and back") && ok
    ok = #expect(focused() == le && g_le_bubbled == 0, "focus stayed in the field, nothing bubbled") && ok
    ok = caret_at(le, 1, "and its caret did not move") && ok
    line_edit_set_key_target(le, le)
    ok = #expect(le_key(i32(input.Keycode.Down), 0) && g_le_bubbled == 1, "never its own target: it bubbles") && ok

    // ── Bad handles ────────────────────────────────────────────────────────
    ok = #expect(!is_line_edit(NIL) && line_edit_text(NIL) == "" && line_edit_text(multi) == "", "NIL and a text edit have no text") && ok
    line_edit_set_text(NIL, "x")
    line_edit_set_text(multi, "x")
    line_edit_set_placeholder(multi, "x")
    line_edit_set_key_target(multi, list)
    ok = #expect(line_edit_placeholder(multi) == "" && line_edit_key_target(multi) == NIL && line_edit_submit_mods(NIL) == 0, "reads of a text edit are empty") && ok
    (i64 bs, i64 bc) = line_edit_counters(NIL)
    ok = #expect(bs == 0 && bc == 0, "zeros") && ok
    // A source set on a line edit is refused; its own stays.
    EditSource none
    text_edit_set_source(le, none)
    ok = text_is(le, "q", "set_source refused") && ok
    text_edit_set_gutter(le, true)
    ok = #expect(!text_edit_gutter(le), "no gutter, ever") && ok
    remove(le)
    ok = #expect(!is_line_edit(le) && line_edit_text(le) == "", "removed: a bad handle") && ok
    line_edit_set_text(le, "x")

    text_edit_set_clipboard(nil, nil)
    reset()
    grid.down()
    if ok:
        return 0
    return 1
