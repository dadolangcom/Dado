@test
// Focus and input routing, and signals: an event offered to the focused node
// bubbles to the first ancestor that handles it; focus refuses a node that is
// not focusable and clears when its node goes; connections run in order with
// their own context pointers, count only their own signal, and go with their
// node.
package ui

import "app:ui/cell"
import "app:input"

// ── Input ──────────────────────────────────────────────────────────────────

// Which nodes were offered an event, in order.
private [16]Control g_offered
private i32 g_offered_n

private void offer(Control c):
    if g_offered_n < #len(g_offered):
        g_offered[g_offered_n] = c
    g_offered_n = g_offered_n + 1

// Handles nothing.
private bool ignore_input(Control c, rawptr st, input.Event e):
    _ = st
    _ = e
    offer(c)
    return false

// Handles keys only; its state counts how many it took.
private type Counter: (i32 taken, i32 pad)
private type CounterPtr: ^Counter

private bool take_keys(Control c, rawptr st, input.Event e):
    offer(c)
    if e.kind != input.EventKind.Key:
        return false
    ^Counter k = CounterPtr(st)
    k.taken = k.taken + 1
    return true

// ── Signals ────────────────────────────────────────────────────────────────

private [16]i32 g_calls
private i32 g_calls_n

// Records the value its context points at.
private void record(Control c, rawptr ctx):
    _ = c
    ^Counter k = CounterPtr(ctx)
    if g_calls_n < #len(g_calls):
        g_calls[g_calls_n] = k.taken
    g_calls_n = g_calls_n + 1

// Removes the node it was emitted on.
private void remove_self(Control c, rawptr ctx):
    _ = ctx
    g_calls_n = g_calls_n + 1
    remove(c)

// Connects another handler to the node it was emitted on.
private void connect_more(Control c, rawptr ctx):
    g_calls_n = g_calls_n + 1
    connect(c, SIG_PRESSED, record, ctx)

i32 test():
    bool ok = true
    Hooks h
    h.measure = nil
    h.arrange = nil
    h.paint = nil
    h.input = ignore_input
    h.free = nil
    Kind deaf = register_kind("deaf", h)
    h.input = take_keys
    Kind keys = register_kind("keys", h)
    h.input = nil
    Kind mute = register_kind("mute", h)

    // ── Bubbling ──────────────────────────────────────────────────────────
    //  root
    //  └── outer (keys)
    //      └── middle (mute: no input hook)
    //          └── inner (deaf)
    Counter taken = (0, 0)
    Control outer = create(keys, NIL, rawptr(&taken))
    Control middle = create(mute, outer, nil)
    Control inner = create(deaf, middle, nil)
    input.Event key
    key.kind = input.EventKind.Key
    key.code = 65
    input.Event text
    text.kind = input.EventKind.Text
    text.code = 97

    ok = #expect(!dispatch(key) && g_offered_n == 0, "nothing focused, nothing offered") && ok
    set_focus(inner)
    ok = #expect(focused() == NIL, "a node that is not focusable is refused") && ok
    set_focusable(inner, true)
    set_focus(inner)
    ok = #expect(focused() == inner, "focus taken") && ok

    ok = #expect(dispatch(key), "the key is handled by an ancestor") && ok
    ok = #expect(taken.taken == 1, "outer took it ", taken.taken) && ok
    ok = #expect(g_offered_n == 2 && g_offered[0] == inner && g_offered[1] == outer, "inner, then outer ", g_offered_n) && ok
    g_offered_n = 0
    ok = #expect(!dispatch(text), "text is handled by nobody") && ok
    // inner, outer — and the root, a vbox with no input hook, is not logged.
    ok = #expect(g_offered_n == 2 && taken.taken == 1, "text bubbled to the top ", g_offered_n) && ok

    // NIL clears focus; a stale handle does not change it.
    set_focus(NIL)
    ok = #expect(focused() == NIL, "NIL clears focus") && ok
    set_focus(inner)
    Control dead = create(deaf, NIL, nil)
    remove(dead)
    set_focus(dead)
    ok = #expect(focused() == inner, "a dead handle leaves focus alone") && ok
    set_focusable(inner, false)
    ok = #expect(focused() == NIL, "losing focusability clears focus") && ok
    set_focusable(inner, true)
    set_focus(inner)
    remove(middle)
    ok = #expect(focused() == NIL && !valid(inner), "removing the focused node clears focus") && ok
    g_offered_n = 0
    ok = #expect(!dispatch(key) && g_offered_n == 0, "and nothing is offered after") && ok

    // ── Signals ───────────────────────────────────────────────────────────
    ok = #expect(signal("pressed") == SIG_PRESSED, "pressed is interned first") && ok
    i32 toggled = signal("toggled")
    ok = #expect(toggled > SIG_PRESSED && signal("toggled") == toggled, "interned once ", toggled) && ok
    ok = #expect(signal_name(toggled) == "toggled" && signal_name(-1) == "" && signal_name(999) == "", "names") && ok

    Control button = create(deaf, NIL, nil)
    Counter one = (1, 0)
    Counter two = (2, 0)
    Counter three = (3, 0)
    on_pressed(button, record, rawptr(&one))
    connect(button, toggled, record, rawptr(&three))
    connect(button, SIG_PRESSED, record, rawptr(&two))
    connect(button, 999, record, rawptr(&two))
    connect(button, -1, record, rawptr(&two))
    ok = #expect(connection_count(button) == 3, "unknown signals refused ", connection_count(button)) && ok

    g_calls_n = 0
    ok = #expect(emit(button, SIG_PRESSED) == 2, "two pressed handlers") && ok
    ok = #expect(g_calls_n == 2 && g_calls[0] == 1 && g_calls[1] == 2, "in connection order, each with its context") && ok
    g_calls_n = 0
    ok = #expect(emit(button, toggled) == 1 && g_calls[0] == 3, "toggled alone") && ok
    ok = #expect(emit(button, 999) == 0, "unknown signal runs nothing") && ok

    // Many connections: the connection pool grows.
    Control many = create(deaf, NIL, nil)
    for i in 0..<100:
        on_pressed(many, record, rawptr(&one))
    g_calls_n = 0
    ok = #expect(emit(many, SIG_PRESSED) == 100, "a hundred ran") && ok

    // A handler that connects another: the new one waits for the next emit.
    Control grower = create(deaf, NIL, nil)
    on_pressed(grower, connect_more, rawptr(&two))
    g_calls_n = 0
    ok = #expect(emit(grower, SIG_PRESSED) == 1, "only the connection present at the start ran") && ok
    ok = #expect(emit(grower, SIG_PRESSED) == 2, "then both") && ok

    // Removal drops the connections, and a handler that removes its own
    // node stops the rest.
    remove(many)
    ok = #expect(emit(many, SIG_PRESSED) == 0 && connection_count(many) == 0, "removed node emits nothing") && ok
    Control fragile = create(deaf, NIL, nil)
    on_pressed(fragile, remove_self, nil)
    on_pressed(fragile, record, rawptr(&one))
    g_calls_n = 0
    ok = #expect(emit(fragile, SIG_PRESSED) == 1 && g_calls_n == 1 && !valid(fragile), "stopped after the removal") && ok
    // A node minted into a slot whose connections were dropped starts with
    // none.
    Control fresh = create(deaf, NIL, nil)
    ok = #expect(connection_count(fresh) == 0 && emit(fresh, SIG_PRESSED) == 0, "a fresh node has no connections") && ok
    ok = #expect(connection_count(button) == 3, "button kept its own") && ok

    // Signals are independent of layout: an update changes nothing here.
    update(cell.rect(0, 0, 10, 10))
    ok = #expect(emit(button, SIG_PRESSED) == 2, "still two after an update") && ok

    reset()
    ok = #expect(signal("toggled") == toggled, "names survive reset") && ok
    ok = #expect(emit(button, SIG_PRESSED) == 0, "reset dropped every connection") && ok
    if ok: return 0
    return 1
