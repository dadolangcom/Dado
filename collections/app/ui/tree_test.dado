@test
// The tree's handles: every public entry point on `NIL`, on a slot past the
// pool, and on a removed handle whose slot a new node has since taken — the
// stale handle must read as empty and must not reach the new node. Then
// recursive removal (free hooks once per node, children first), generations,
// sibling links, and `reset`.
package ui

import "app:ui/cell"

// ── A leaf kind whose free hook records what it freed ───────────────────────

private i32 g_freed
private [16]Control g_free_order

private void leaf_free(Control c, rawptr st):
    _ = st
    if g_freed < #len(g_free_order):
        g_free_order[g_freed] = c
    g_freed = g_freed + 1

private cell.CellPoint leaf_measure(Control c, rawptr st):
    _ = c
    _ = st
    cell.CellPoint p = (3, 1)
    return p

private i32 g_signalled

private void count_signal(Control c, rawptr ctx):
    _ = c
    _ = ctx
    g_signalled = g_signalled + 1

private Kind leaf_kind():
    Hooks h
    h.measure = leaf_measure
    h.arrange = nil
    h.paint = nil
    h.input = nil
    h.free = leaf_free
    return register_kind("leaf", h)

// Every reader answers the empty thing for `c`, and every writer leaves the
// tree as it was: the node count, the root's child count and the focus.
private bool reads_empty(Control c, string8 what):
    bool ok = true
    ok = #expect(!valid(c), what, ": valid") && ok
    ok = #expect(parent(c) == NIL, what, ": parent") && ok
    ok = #expect(first_child(c) == NIL, what, ": first_child") && ok
    ok = #expect(last_child(c) == NIL, what, ": last_child") && ok
    ok = #expect(next_sibling(c) == NIL, what, ": next_sibling") && ok
    ok = #expect(prev_sibling(c) == NIL, what, ": prev_sibling") && ok
    ok = #expect(child_count(c) == 0, what, ": child_count") && ok
    ok = #expect(state(c) == nil, what, ": state") && ok
    ok = #expect(kind(c) == NO_KIND, what, ": kind") && ok
    ok = #expect(cell.is_empty(rect(c)), what, ": rect") && ok
    cell.CellPoint m = minimum(c)
    ok = #expect(m.col == 0 && m.row == 0, what, ": minimum") && ok
    ok = #expect(!expands_h(c) && !expands_v(c), what, ": expands") && ok
    ok = #expect(!is_visible(c) && !is_focusable(c), what, ": visible/focusable") && ok
    ok = #expect(!is_layout_dirty(c) && !is_paint_dirty(c), what, ": dirty") && ok
    ok = #expect(connection_count(c) == 0, what, ": connections") && ok
    ok = #expect(emit(c, SIG_PRESSED) == 0, what, ": emit") && ok
    (i32 ml, i32 mt, i32 mr, i32 mb) = margins(c)
    ok = #expect(ml == 0 && mt == 0 && mr == 0 && mb == 0, what, ": margins") && ok
    return ok

private bool writes_nothing(Control c, string8 what):
    bool ok = true
    i32 live = stats().nodes_live
    i32 kids = child_count(root())
    Control f = focused()
    set_expand(c, true, true)
    set_visible(c, false)
    set_focusable(c, true)
    set_focus(c)
    mark_layout(c)
    mark_paint(c)
    set_margins(c, 1, 1, 1, 1)
    connect(c, SIG_PRESSED, count_signal, nil)
    on_pressed(c, count_signal, nil)
    // `NIL` as a parent means the root, so only a non-`NIL` bad handle is a
    // bad parent.
    if c != NIL:
        ok = #expect(create(leaf_kind_id, c, nil) == NIL, what, ": create under it") && ok
        ok = #expect(vbox(c) == NIL, what, ": vbox under it") && ok
        ok = #expect(margin_box(c, 1, 1, 1, 1) == NIL, what, ": margin_box under it") && ok
    remove(c)
    ok = #expect(stats().nodes_live == live, what, ": node count moved ", stats().nodes_live) && ok
    ok = #expect(child_count(root()) == kids, what, ": root children moved") && ok
    ok = #expect(focused() == f, what, ": focus moved") && ok
    ok = #expect(g_signalled == 0, what, ": a signal ran") && ok
    return ok

private Kind leaf_kind_id = NO_KIND

i32 test():
    bool ok = true

    // ── Before anything exists: every reader is total over an empty pool ──
    ok = reads_empty(NIL, "NIL, no pool") && ok
    ok = reads_empty(Control((5, 0)), "slot 5, no pool") && ok
    ok = #expect(stats().nodes_live == 0, "nodes before root") && ok

    leaf_kind_id = leaf_kind()
    ok = #expect(kind_name(leaf_kind_id) == "leaf", "kind name") && ok
    ok = #expect(kind_name(NO_KIND) == "" && kind_name(Kind(99)) == "", "unknown kind name") && ok
    ok = #expect(create(NO_KIND, NIL, nil) == NIL && create(Kind(99), NIL, nil) == NIL, "unknown kind creates") && ok

    // ── The root and a child ──────────────────────────────────────────────
    Control r = root()
    ok = #expect(valid(r) && parent(r) == NIL, "root") && ok
    ok = #expect(kind_name(kind(r)) == "vbox", "root is a vbox") && ok
    Control a = create(leaf_kind_id, NIL, nil)
    ok = #expect(parent(a) == r && child_count(r) == 1, "NIL parent is the root") && ok
    ok = #expect(stats().nodes_live == 2, "two live ", stats().nodes_live) && ok

    // ── NIL and out-of-range, with a live tree ────────────────────────────
    ok = reads_empty(NIL, "NIL") && ok
    ok = writes_nothing(NIL, "NIL") && ok
    ok = reads_empty(Control((1000, 0)), "slot 1000") && ok
    ok = writes_nothing(Control((1000, 0)), "slot 1000") && ok
    ok = reads_empty(Control((-7, 3)), "slot -7") && ok
    ok = writes_nothing(Control((-7, 3)), "slot -7") && ok
    // A live slot with the wrong generation.
    ok = reads_empty(Control((a.slot, a.generation + 1)), "wrong generation") && ok
    ok = writes_nothing(Control((a.slot, a.generation + 1)), "wrong generation") && ok

    // ── A stale handle whose slot has been recycled ───────────────────────
    remove(a)
    ok = #expect(g_freed == 1, "free hook ran once ", g_freed) && ok
    ok = #expect(!valid(a) && child_count(r) == 0, "a is gone") && ok
    Control b = create(leaf_kind_id, NIL, nil)
    ok = #expect(b.slot == a.slot, "the slot is recycled ", b.slot, " ", a.slot) && ok
    ok = #expect(b.generation == a.generation + 1, "generation moved ", b.generation) && ok
    set_focusable(b, true)
    set_focus(b)
    ok = reads_empty(a, "stale") && ok
    ok = writes_nothing(a, "stale") && ok
    // And none of that reached `b`.
    ok = #expect(valid(b) && is_visible(b) && !expands_v(b) && is_focusable(b), "b untouched") && ok
    ok = #expect(focused() == b, "b keeps focus") && ok
    ok = #expect(connection_count(b) == 0, "no connection reached b") && ok
    remove(a)
    ok = #expect(valid(b) && g_freed == 1, "removing the stale handle removed nothing") && ok

    // ── Recursive removal ─────────────────────────────────────────────────
    //     b
    //     ├── c1
    //     │   └── g1
    //     └── c2
    Control c1 = create(leaf_kind_id, b, nil)
    Control g1 = create(leaf_kind_id, c1, nil)
    Control c2 = create(leaf_kind_id, b, nil)
    ok = #expect(child_count(b) == 2 && first_child(b) == c1 && last_child(b) == c2, "b's children") && ok
    ok = #expect(next_sibling(c1) == c2 && prev_sibling(c2) == c1 && next_sibling(c2) == NIL, "siblings") && ok
    ok = #expect(first_child(c1) == g1 && parent(g1) == c1, "grandchild") && ok
    set_focusable(g1, true)
    set_focus(g1)
    g_freed = 0
    remove(b)
    ok = #expect(g_freed == 4, "four free hooks ", g_freed) && ok
    // Children first: g1 before c1 before c2, and b last.
    ok = #expect(g_free_order[0] == g1 && g_free_order[1] == c1 && g_free_order[2] == c2 && g_free_order[3] == b, "free order") && ok
    ok = #expect(!valid(b) && !valid(c1) && !valid(g1) && !valid(c2), "all dead") && ok
    ok = #expect(focused() == NIL, "focus inside a removed subtree clears") && ok
    ok = #expect(stats().nodes_live == 1 && child_count(r) == 0, "only the root left") && ok

    // Removing a middle child keeps the links whole.
    Control x = create(leaf_kind_id, NIL, nil)
    Control y = create(leaf_kind_id, NIL, nil)
    Control z = create(leaf_kind_id, NIL, nil)
    remove(y)
    ok = #expect(next_sibling(x) == z && prev_sibling(z) == x && child_count(r) == 2, "unlinked from the middle") && ok
    remove(x)
    ok = #expect(first_child(r) == z && prev_sibling(z) == NIL, "unlinked from the front") && ok
    remove(z)
    ok = #expect(first_child(r) == NIL && last_child(r) == NIL, "empty again") && ok

    // ── Many nodes: the pool grows past its first run ─────────────────────
    Control first = create(leaf_kind_id, NIL, nil)
    for i in 0..<200:
        create(leaf_kind_id, NIL, nil)
    ok = #expect(child_count(r) == 201 && valid(first), "grown pool ", child_count(r)) && ok
    ok = #expect(stats().nodes_live == 202, "202 live ", stats().nodes_live) && ok

    // ── Owned state is zeroed and freed with the node ─────────────────────
    Control m = margin_box(NIL, 1, 2, 3, 4)
    (i32 ml, i32 mt, i32 mr, i32 mb) = margins(m)
    ok = #expect(ml == 1 && mt == 2 && mr == 3 && mb == 4, "margins stored") && ok
    set_margins(m, -5, 0, 0, 0)
    (i32 nl, i32 nt, i32 nr, i32 nb) = margins(m)
    ok = #expect(nl == 0 && nt == 0 && nr == 0 && nb == 0, "margins clamp at zero") && ok

    // ── Removing the root, and reset ──────────────────────────────────────
    g_freed = 0
    remove(r)
    ok = #expect(g_freed == 201, "every leaf freed with the root ", g_freed) && ok
    ok = #expect(!valid(r) && !valid(first) && !valid(m), "the old root is dead") && ok
    ok = #expect(stats().nodes_live == 0, "no nodes ", stats().nodes_live) && ok
    Control r2 = root()
    ok = #expect(valid(r2) && r2 != r, "a fresh root") && ok

    // From a fresh pool, so the slots are known: the root takes slot 0 and the
    // first node slot 1.
    reset()
    r2 = root()
    Control k1 = create(leaf_kind_id, NIL, nil)
    ok = #expect(r2.slot == 0 && k1.slot == 1, "fresh pool slots ", r2.slot, " ", k1.slot) && ok
    g_freed = 0
    reset()
    ok = #expect(g_freed == 1, "reset ran the free hook ", g_freed) && ok
    ok = #expect(!valid(k1) && !valid(r2) && stats().nodes_live == 0, "reset killed everything") && ok
    // The pool is rebuilt from nothing and slots 0 and 1 are minted again: a
    // handle from before the reset must still not match.
    Control r3 = root()
    Control k2 = create(leaf_kind_id, NIL, nil)
    ok = #expect(k2.slot == k1.slot && !valid(k1) && valid(k2), "slot reused across reset, handle refused") && ok
    ok = #expect(r3.slot == r2.slot && !valid(r2), "root slot reused, old root refused") && ok
    ok = #expect(kind_name(leaf_kind_id) == "leaf", "kinds survive reset") && ok
    reset()

    if ok: return 0
    return 1
