@test
// The capture's ends and the hit map's economy: an automatic capture ends at
// the first buttonless motion when its release was lost, not at a wheel
// notch, and every capture ends when the window loses focus; a hidden node,
// or one under a hidden ancestor, is neither hit nor captured, and hiding it
// ends its capture; a capture cannot be given to a hidden node; a childless
// node repainting inside an unchanged clip writes no ownership, and the map
// stays right when that skip would be wrong — a node shown again, a parent
// left childless, a screen that changes and changes back.
package ui

import "app:input"
import "app:ui/cell"

private type CState: (i32 rows, i32 takes)
private type CStatePtr: ^CState

private [32]Control g_c_node
private i32 g_c_n

private bool c_input(Control c, rawptr st, input.Event e):
    if g_c_n < #len(g_c_node):
        g_c_node[g_c_n] = c
    g_c_n = g_c_n + 1
    ^CState s = CStatePtr(st)
    _ = e
    return s.takes != 0

private cell.CellPoint c_measure(Control c, rawptr st):
    _ = c
    ^CState s = CStatePtr(st)
    cell.CellPoint p = (4, s.rows)
    return p

private void c_paint(Control c, rawptr st, cell.CellRect r):
    _ = c
    _ = st
    _ = r

private Kind g_c_leaf = NO_KIND
private Kind g_c_box = NO_KIND

private void c_kinds():
    Hooks h
    h.measure = c_measure
    h.arrange = nil
    h.paint = c_paint
    h.input = c_input
    h.free = nil
    g_c_leaf = register_kind("c_leaf", h)
    h.measure = vbox_measure_hook
    h.arrange = vbox_arrange_hook
    h.paint = nil
    g_c_box = register_kind("c_box", h)

private const u32 C_LMB = 0x100

private input.Event c_ev(i32 code, i32 col, i32 row, u32 mods):
    input.Event e = (input.EventKind.Mouse, code, f32(col) + f32(0.5), f32(row) + f32(0.5), mods)
    return e

private input.Event c_press(i32 col, i32 row):
    return c_ev(0, col, row, C_LMB)

i32 test():
    bool ok = true
    c_kinds()
    //  root (20 x 10)
    //  └── box (c_box, takes nothing, expands)       rows 0..9
    //      ├── e1 (c_leaf, 2 rows, takes, focusable) rows 0..1
    //      └── e2 (c_leaf, 3 rows, takes, focusable) rows 2..4
    CState sbox = (0, 0)
    CState s1 = (2, 1)
    CState s2 = (3, 1)
    Control box = create(g_c_box, NIL, rawptr(&sbox))
    set_expand(box, false, true)
    Control e1 = create(g_c_leaf, box, rawptr(&s1))
    Control e2 = create(g_c_leaf, box, rawptr(&s2))
    set_focusable(e1, true)
    set_focusable(e2, true)
    cell.CellRect scr = cell.rect(0, 0, 20, 10)
    update(scr)
    ok = #expect(hit(0, 0) == e1 && hit(0, 3) == e2 && hit(0, 7) == box, "laid out") && ok

    // ── A lost release ────────────────────────────────────────────────────
    ok = #expect(dispatch(c_press(0, 0)) && captured() == e1 && focused() == e1, "e1 pressed") && ok
    // A wheel notch mid-drag carries no button bits: it is no evidence.
    ok = #expect(dispatch(c_ev(1, 0, 3, input.MOUSE_WHEEL)) && captured() == e1, "the wheel keeps the capture") && ok
    // The release never came; the next motion says no button is held.
    g_c_n = 0
    ok = #expect(dispatch(c_ev(-1, 0, 3, input.MOUSE_MOTION)), "buttonless motion") && ok
    ok = #expect(g_c_n == 1 && g_c_node[0] == e1, "the captor still saw it ", g_c_n) && ok
    ok = #expect(captured() == NIL, "and the capture ended") && ok
    g_c_n = 0
    ok = #expect(dispatch(c_press(0, 3)) && g_c_n == 1 && g_c_node[0] == e2, "the next press reaches e2") && ok
    ok = #expect(focused() == e2 && captured() == e2, "focused and captured") && ok
    // A drag's motion has its button held and keeps it.
    ok = #expect(dispatch(c_ev(-1, 0, 0, C_LMB | input.MOUSE_MOTION)) && captured() == e2, "a held drag keeps it") && ok

    // ── Focus loss ends every capture ─────────────────────────────────────
    input.Event lost = (input.EventKind.Focus, 0, f32(0.0), f32(0.0), input.FOCUS_LOST)
    input.Event gained = (input.EventKind.Focus, 0, f32(0.0), f32(0.0), u32(0))
    _ = dispatch(gained)
    ok = #expect(captured() == e2, "gaining focus changes nothing") && ok
    _ = dispatch(lost)
    ok = #expect(captured() == NIL, "automatic, ended by the focus loss") && ok
    capture(e1)
    _ = dispatch(c_ev(-1, 0, 7, input.MOUSE_MOTION))
    ok = #expect(captured() == e1, "an explicit capture outlasts a buttonless motion") && ok
    _ = dispatch(lost)
    ok = #expect(captured() == NIL, "explicit, ended by the focus loss") && ok

    // ── Hidden nodes are out of mouse routing ─────────────────────────────
    ok = #expect(dispatch(c_press(0, 0)) && captured() == e1, "e1 captures") && ok
    set_visible(e1, false)
    ok = #expect(captured() == NIL, "hiding the captor ends the capture") && ok
    ok = #expect(hit(0, 0) == NIL, "before the repaint, e1's cells answer nobody") && ok
    ok = #expect(dispatch(c_ev(0, 0, 0, input.MOUSE_UP)) == false, "the release lands on nothing") && ok
    set_focus(e2)
    ok = #expect(!dispatch(c_press(0, 0)) && focused() == e2 && captured() == NIL, "a press there neither focuses nor captures e1") && ok
    capture(e1)
    ok = #expect(captured() == NIL, "a hidden node cannot take the capture") && ok
    update(scr)
    ok = #expect(hit(0, 0) == e2 && hit(0, 5) == box, "after the repaint e2 moved up") && ok
    set_visible(e1, true)
    update(scr)
    ok = #expect(hit(0, 0) == e1 && hit(0, 2) == e2, "shown again") && ok

    // Hiding an ancestor takes the whole subtree out.
    ok = #expect(dispatch(c_press(0, 3)) && captured() == e2, "e2 captures") && ok
    set_visible(box, false)
    ok = #expect(captured() == NIL && hit(0, 3) == NIL && hit(0, 0) == NIL && hit(0, 7) == NIL, "under a hidden box") && ok
    set_visible(box, true)
    update(scr)
    ok = #expect(hit(0, 0) == e1 && hit(0, 3) == e2 && hit(0, 7) == box, "the box shown again") && ok
    _ = dispatch(c_ev(0, 0, 3, input.MOUSE_UP))

    // ── An unforced repaint in an unchanged clip claims nothing ───────────
    i32 w0 = g_owner_writes
    mark_paint(e1)
    update(scr)
    ok = #expect(stats().painted == 1, "e1 alone repainted ", stats().painted) && ok
    ok = #expect(g_owner_writes == w0, "and wrote no ownership ", g_owner_writes - w0) && ok
    ok = #expect(hit(0, 1) == e1, "which it still has") && ok
    // A parent that repaints for itself still writes: a child may have given
    // cells back.
    w0 = g_owner_writes
    mark_paint(box)
    update(scr)
    ok = #expect(g_owner_writes == w0 + 3, "the box and, forced, both children ", g_owner_writes - w0) && ok

    // Hidden, the parent paints over e2; shown again with the same clip, e2
    // must claim its cells back.
    set_visible(e2, false)
    update(scr)
    ok = #expect(hit(0, 3) == box, "the box's while e2 is hidden") && ok
    set_visible(e2, true)
    update(scr)
    ok = #expect(hit(0, 3) == e2, "e2's again") && ok

    // A screen that changes and changes back: the new map is refilled.
    update(cell.rect(0, 0, 20, 12))
    update(scr)
    ok = #expect(hit(0, 0) == e1 && hit(0, 3) == e2 && hit(0, 9) == box, "after two resizes") && ok

    // A parent left childless reclaims its cells with its clip unchanged.
    //  root
    //  └── box
    //      ├── e1, e2
    //      └── shell (c_leaf, 2 rows)          rows 5..6
    //          └── only (c_leaf, 2 rows)
    CState ss = (2, 0)
    Control shell = create(g_c_leaf, box, rawptr(&ss))
    Control only = create(g_c_leaf, shell, rawptr(&ss))
    update(scr)
    ok = #expect(hit(0, 5) == only && hit(0, 6) == only, "only covers the shell") && ok
    remove(only)
    update(scr)
    ok = #expect(hit(0, 5) == shell && hit(0, 6) == shell, "the shell, childless, claims its cells back") && ok
    if ok: return 0
    return 1
