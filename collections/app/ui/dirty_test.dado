@test
// The two dirty bits and the two walks: the climbs and where they stop, an
// idle update that touches nothing, one leaf's change re-measuring only its
// ancestor chain and repainting only the nodes whose rectangles moved, a
// resize repainting everything, paint order and clipping, the forced subtree
// repaint, a container clearing rows its children left, and an invisible
// subtree skipped by both walks.
package ui

import "app:ui/cell"

// ── Test kinds ─────────────────────────────────────────────────────────────
//
// `leaf`: its minimum is the `Size` its state points at. `panel`: a vbox that
// paints. `shove`: a container that places its children 15 columns right of
// its own corner, 10 wide, to push them past its edge. All three log every
// paint into `g_log` as (node, clipped rectangle).

private type Size: (i32 cols, i32 rows)
private type SizePtr: ^Size

private [64]Control g_log_node
private [64]cell.CellRect g_log_rect
private i32 g_log_n

private void log_paint(Control c, rawptr st, cell.CellRect clip):
    _ = st
    if g_log_n < #len(g_log_node):
        g_log_node[g_log_n] = c
        g_log_rect[g_log_n] = clip
    g_log_n = g_log_n + 1

private cell.CellPoint leaf_measure(Control c, rawptr st):
    _ = c
    ^Size s = SizePtr(st)
    cell.CellPoint p = (s.cols, s.rows)
    return p

private void shove_arrange(Control c, rawptr st, cell.CellRect r):
    _ = st
    Control ch = first_child(c)
    for valid(ch):
        set_rect(ch, cell.rect(r.col + 15, r.row, 10, 2))
        ch = next_sibling(ch)

private Kind g_leaf = NO_KIND
private Kind g_panel = NO_KIND
private Kind g_shove = NO_KIND

private void kinds():
    Hooks h
    h.measure = leaf_measure
    h.arrange = nil
    h.paint = log_paint
    h.input = nil
    h.free = nil
    g_leaf = register_kind("leaf", h)
    h.measure = vbox_measure_hook
    h.arrange = vbox_arrange_hook
    g_panel = register_kind("panel", h)
    h.measure = nil
    h.arrange = shove_arrange
    g_shove = register_kind("shove", h)

private bool logged(i32 at, Control c):
    return at < g_log_n && g_log_node[at] == c

private bool stats_are(i32 measured, i32 arranged, i32 painted, string8 what):
    Stats s = stats()
    return #expect(s.measured == measured && s.arranged == arranged && s.painted == painted,
        what, ": measured ", s.measured, " arranged ", s.arranged, " painted ", s.painted)

i32 test():
    bool ok = true
    kinds()
    [8]Size sizes
    sizes[0] = (5, 2)
    sizes[1] = (5, 2)
    sizes[2] = (5, 3)

    //  root (vbox, 20x10)
    //  ├── p1 panel, expands vertically
    //  │   ├── l1 5x2
    //  │   └── l2 5x2
    //  └── p2 panel
    //      └── l3 5x3
    Control p1 = create(g_panel, NIL, nil)
    Control l1 = create(g_leaf, p1, rawptr(&sizes[0]))
    Control l2 = create(g_leaf, p1, rawptr(&sizes[1]))
    Control p2 = create(g_panel, NIL, nil)
    Control l3 = create(g_leaf, p2, rawptr(&sizes[2]))
    set_expand(p1, false, true)
    cell.CellRect screen = cell.rect(0, 0, 20, 10)

    // ── The first update does everything, parents before children ─────────
    g_log_n = 0
    update(screen)
    ok = stats_are(6, 6, 6, "first update") && ok
    ok = #expect(g_log_n == 5, "five paint hooks ", g_log_n) && ok
    ok = #expect(logged(0, p1) && logged(1, l1) && logged(2, l2) && logged(3, p2) && logged(4, l3), "paint order") && ok
    ok = #expect(rect(p1) == cell.rect(0, 0, 20, 7) && rect(p2) == cell.rect(0, 7, 20, 3), "panels") && ok
    ok = #expect(rect(l2) == cell.rect(0, 2, 20, 2), "l2") && ok
    ok = #expect(!is_layout_dirty(root()) && !is_paint_dirty(l3), "bits clear after update") && ok

    // ── Idle: nothing measured, arranged or painted ───────────────────────
    i32 idle_before = stats().updates_idle
    g_log_n = 0
    update(screen)
    ok = stats_are(0, 0, 0, "idle") && ok
    ok = #expect(g_log_n == 0 && stats().updates_idle == idle_before + 1, "idle counted") && ok
    update(screen)
    ok = #expect(stats().updates_idle == idle_before + 2, "idle twice") && ok

    // ── The climbs, and where they stop ───────────────────────────────────
    // l1 → p1 → root: two layout bits and two paint-below bits.
    i32 before = g_climbed
    mark_layout(l1)
    ok = #expect(g_climbed - before == 4, "first climb sets 2 + 2 ", g_climbed - before) && ok
    ok = #expect(is_layout_dirty(l1) && is_layout_dirty(p1) && is_layout_dirty(root()), "chain dirty") && ok
    ok = #expect(!is_layout_dirty(p2) && !is_layout_dirty(l2), "siblings clean") && ok
    ok = #expect(is_paint_dirty(l1) && !is_paint_dirty(p1), "paint-dirty on l1 only") && ok
    // l2's parent is already dirty on both counts: the climb stops at once.
    before = g_climbed
    mark_layout(l2)
    ok = #expect(g_climbed == before, "second climb stops at p1 ", g_climbed - before) && ok
    // l3's parent p2 is clean and root is dirty: it stops after one on each.
    before = g_climbed
    mark_paint(l3)
    ok = #expect(g_climbed - before == 1, "paint climb stops at root ", g_climbed - before) && ok
    ok = #expect(!is_layout_dirty(l3), "mark_paint leaves layout alone") && ok
    update(screen)
    // Measured: l1, l2, p1, root. Arranged: root, p1, l1, l2. Painted: l1,
    // l2 (dirty) and l3 (marked).
    ok = stats_are(4, 4, 3, "after marks") && ok

    // ── One leaf grows: only its ancestor chain re-measures, and only the
    // nodes whose rectangles moved repaint ────────────────────────────────
    sizes[0].rows = 3
    mark_layout(l1)
    g_log_n = 0
    update(screen)
    // Measured: l1, p1, root. Arranged: root, p1 (dirty), l1 (dirty), l2
    // (moved); p2 kept its rectangle and is clean. p1 still fills 7 rows, so
    // it keeps its rectangle and does not repaint; l1 grew and l2 moved down.
    ok = stats_are(3, 4, 2, "one leaf grows") && ok
    ok = #expect(logged(0, l1) && logged(1, l2) && g_log_n == 2, "only l1 and l2 repaint") && ok
    ok = #expect(rect(l2) == cell.rect(0, 3, 20, 2), "l2 moved ", rect(l2).row) && ok

    // ── It shrinks back: the panel's children now cover fewer rows, so the
    // panel repaints to clear them, and its subtree with it ───────────────
    sizes[0].rows = 1
    mark_layout(l1)
    g_log_n = 0
    update(screen)
    ok = stats_are(3, 4, 3, "one leaf shrinks") && ok
    ok = #expect(logged(0, p1) && logged(1, l1) && logged(2, l2), "the panel repaints first") && ok

    // ── A repaint forces the subtree, and nothing else ────────────────────
    mark_paint(p2)
    g_log_n = 0
    update(screen)
    ok = stats_are(0, 0, 2, "forced subtree") && ok
    ok = #expect(logged(0, p2) && logged(1, l3) && g_log_n == 2, "p2 then l3") && ok
    mark_paint(l3)
    g_log_n = 0
    update(screen)
    ok = stats_are(0, 0, 1, "a leaf alone") && ok

    // ── A resize makes everything dirty ───────────────────────────────────
    g_log_n = 0
    update(cell.rect(0, 0, 30, 12))
    ok = stats_are(6, 6, 6, "resize") && ok
    ok = #expect(g_log_n == 5, "every paint hook ", g_log_n) && ok
    // The same screen again is idle.
    update(cell.rect(0, 0, 30, 12))
    ok = stats_are(0, 0, 0, "after resize, idle") && ok

    // ── Invisible subtrees are skipped by both walks ──────────────────────
    set_visible(p2, false)
    g_log_n = 0
    update(cell.rect(0, 0, 30, 12))
    ok = #expect(cell.is_empty(rect(p2)), "hidden p2 is empty") && ok
    ok = #expect(rect(p1) == cell.rect(0, 0, 30, 12), "p1 takes the screen") && ok
    for i in 0..<g_log_n:
        ok = #expect(g_log_node[i] != p2 && g_log_node[i] != l3, "a hidden node painted") && ok
    // Changing a leaf inside the hidden subtree measures nothing.
    sizes[2].rows = 4
    mark_layout(l3)
    update(cell.rect(0, 0, 30, 12))
    ok = #expect(stats().measured == 0 && stats().painted == 0, "hidden change measured ", stats().measured) && ok
    // Shown again, it is measured with the new size and painted whole.
    set_visible(p2, true)
    g_log_n = 0
    update(cell.rect(0, 0, 30, 12))
    ok = #expect(rect(l3) == cell.rect(0, 8, 30, 4), "l3 back at 4 rows ", rect(l3).row, " ", rect(l3).rows) && ok
    bool saw_p2 = false
    bool saw_l3 = false
    for i in 0..<g_log_n:
        if g_log_node[i] == p2:
            saw_p2 = true
        if g_log_node[i] == l3:
            saw_l3 = saw_p2
    ok = #expect(saw_p2 && saw_l3, "p2 then l3 repainted when shown") && ok

    // ── Clipping to every ancestor ────────────────────────────────────────
    //  root (vbox, 20x6)
    //  └── outer shove, 20x6 at (0,0) → its child at (15,0) 10x2
    //      └── mid shove → its child at (30,0) 10x2, wholly outside
    //          └── deep leaf
    reset()
    Control outer = create(g_shove, NIL, nil)
    set_expand(outer, false, true)
    Control mid = create(g_shove, outer, nil)
    Control deep = create(g_leaf, mid, rawptr(&sizes[1]))
    g_log_n = 0
    update(cell.rect(0, 0, 20, 6))
    ok = #expect(rect(mid) == cell.rect(15, 0, 10, 2), "mid unclipped") && ok
    ok = #expect(rect(deep) == cell.rect(30, 0, 10, 2), "deep unclipped") && ok
    ok = #expect(logged(0, outer) && g_log_rect[0] == cell.rect(0, 0, 20, 6), "outer clip") && ok
    ok = #expect(logged(1, mid) && g_log_rect[1] == cell.rect(15, 0, 5, 2), "mid clipped to the root ", g_log_rect[1].cols) && ok
    ok = #expect(g_log_n == 2, "deep is clipped away entirely ", g_log_n) && ok

    reset()
    if ok: return 0
    return 1
