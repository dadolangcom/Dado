@test
// The editor's version: undo back to a remembered text answers the version it
// had then, redo forward answers the later one, a typed word extending a
// record moves the version, and a fresh source starts a new one.
package ui

import "app:ui/cell"

// A one-line document in a fixed buffer; edits never contain a newline here.
private [256]char8 g_buf
private i32 g_len

private i64 v_count(rawptr ctx):
    _ = ctx
    return 1

private string8 v_line(rawptr ctx, i64 i):
    _ = ctx
    _ = i
    return string8(g_buf[0..<g_len])

private cell.TextPos v_insert(rawptr ctx, cell.TextPos at, string8 text):
    _ = ctx
    i32 n = i32(#len(text))
    if at.line != 0 || at.byte < 0 || at.byte > g_len || g_len + n > 256:
        return at
    i32 k = g_len - 1
    for k >= at.byte:
        g_buf[k + n] = g_buf[k]
        k = k - 1
    for j in 0..<n:
        g_buf[at.byte + j] = text[j]
    g_len = g_len + n
    return cell.pos(0, at.byte + n)

private bool v_remove(rawptr ctx, cell.TextPos from, cell.TextPos to):
    _ = ctx
    i32 d = to.byte - from.byte
    if from.line != 0 || to.line != 0 || d < 0 || to.byte > g_len:
        return false
    for k in from.byte..<(g_len - d):
        g_buf[k] = g_buf[k + d]
    g_len = g_len - d
    return true

i32 test():
    bool ok = true
    g_len = 0
    Control ed = text_edit(NIL)
    EditSource src = (v_count, v_line, v_insert, v_remove, nil)
    text_edit_set_source(ed, src)
    i64 saved = text_edit_version(ed)
    ok = #expect(text_edit_version(NIL) == 0, "NIL version") && ok

    ok = #expect(text_edit_insert(ed, "ab"), "insert ab") && ok
    i64 v1 = text_edit_version(ed)
    ok = #expect(v1 != saved, "an edit moves the version") && ok
    ok = #expect(text_edit_insert(ed, "c"), "insert c") && ok
    i64 v2 = text_edit_version(ed)
    ok = #expect(v2 != v1 && v2 != saved, "a second edit moves it again") && ok

    // Undo all the way: back to the version the source started at.
    for text_edit_undo(ed):
        pass
    ok = #expect(g_len == 0, "undone to empty, length ", g_len) && ok
    ok = #expect(text_edit_version(ed) == saved, "undone to the saved version") && ok

    // Redo all the way: back to the last version.
    for text_edit_redo(ed):
        pass
    ok = #expect(text_edit_version(ed) == v2, "redone to the last version") && ok

    // A new edit after an undo is a new version, never an old one.
    ok = #expect(text_edit_undo(ed), "undo once") && ok
    ok = #expect(text_edit_version(ed) == v1, "one undo returns to v1") && ok
    ok = #expect(text_edit_insert(ed, "z"), "insert z") && ok
    i64 v3 = text_edit_version(ed)
    ok = #expect(v3 != v1 && v3 != v2 && v3 != saved, "a branch is a new version") && ok

    // A fresh source starts a fresh version.
    text_edit_set_source(ed, src)
    ok = #expect(text_edit_version(ed) != v3 && text_edit_version(ed) != saved, "a new source is a new base") && ok

    reset()
    if ok: return 0
    return 1
