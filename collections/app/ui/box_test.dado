@test
// The boxes of widgets_box.dado other than the splits: the HBox, CenterBox,
// GridBox and ScrollBox arithmetic over hand-built runs, then each in a real
// tree through `update`, and the scroll box moved by the wheel and by keys
// bubbling up from a focused child.
package ui

import "app:input"
import "app:ui/cell"

private bool rect_is(cell.CellRect r, i32 col, i32 row, i32 cols, i32 rows):
    return r.col == col && r.row == row && r.cols == cols && r.rows == rows

private bool rect_ok(cell.CellRect r, i32 col, i32 row, i32 cols, i32 rows, string8 what):
    return #expect(rect_is(r, col, row, cols, rows), what, ": ", r.col, ",", r.row, " ", r.cols, "x", r.rows, " want ", col, ",", row, " ", cols, "x", rows)

private cell.CellPoint pt(i32 c, i32 r):
    cell.CellPoint p = (c, r)
    return p

private type BSize: (i32 cols, i32 rows)
private type BSizePtr: ^BSize

private cell.CellPoint bsized(Control c, rawptr st):
    _ = c
    ^BSize s = BSizePtr(st)
    cell.CellPoint p = (s.cols, s.rows)
    return p

private Kind g_bleaf = NO_KIND

private Control bleaf(Control parent, i32 cols, i32 rows):
    if !kind_ok(g_bleaf):
        Hooks h
        h.measure = bsized
        g_bleaf = register_kind("box_test_leaf", h)
    Control c = create_owned(g_bleaf, parent, i64(#size(BSize)))
    ^BSize s = BSizePtr(state(c))
    s.cols = cols
    s.rows = rows
    return c

private input.Event key(i32 code):
    input.Event e = (input.EventKind.Key, code, f32(0), f32(0), u32(0))
    return e

private input.Event wheel_at(i32 col, i32 row, i32 notches):
    input.Event e = (input.EventKind.Mouse, notches, f32(col) + f32(0.5), f32(row) + f32(0.5), input.MOUSE_WHEEL)
    return e

i32 test():
    bool ok = true
    [8]cell.CellPoint mins
    [8]bool grow
    [8]bool growv
    [8]cell.CellRect out

    // ── HBox arithmetic: the VBox rule along columns ──────────────────────
    mins[0] = pt(4, 2)
    mins[1] = pt(7, 1)
    mins[2] = pt(2, 3)
    grow[0] = true
    grow[1] = false
    grow[2] = true
    cell.CellPoint hm = hbox_minimum(mins[0..<3])
    ok = #expect(hm.col == 13 && hm.row == 3, "hbox minimum ", hm.col, "x", hm.row) && ok
    // 20 - 13 = 7 among two expanders: 3 each and 1 over to the first.
    i32 used = hbox_arrange(cell.rect(5, 2, 20, 4), mins[0..<3], grow[0..<3], out[0..<3])
    ok = #expect(used == 20, "hbox used ", used) && ok
    ok = rect_ok(out[0], 5, 2, 8, 4, "hbox child 0") && ok
    ok = rect_ok(out[1], 13, 2, 7, 4, "hbox child 1") && ok
    ok = rect_ok(out[2], 20, 2, 5, 4, "hbox child 2") && ok
    // Shortage: 4, 7, 2 in 9 columns are 4, 5, 0.
    used = hbox_arrange(cell.rect(0, 0, 9, 1), mins[0..<3], grow[0..<3], out[0..<3])
    ok = #expect(used == 9 && out[0].cols == 4 && out[1].cols == 5 && out[2].cols == 0, "hbox shortage ", out[0].cols, " ", out[1].cols, " ", out[2].cols) && ok
    used = hbox_arrange(cell.rect(0, 0, -3, -1), mins[0..<3], grow[0..<3], out[0..<3])
    ok = #expect(used == 0 && out[0].cols == 0 && out[0].rows == 0, "a negative box gives nothing") && ok
    ok = #expect(hbox_arrange(cell.rect(0, 0, 9, 1), mins[0..<0], grow[0..<0], out[0..<0]) == 0, "no children") && ok

    // ── CenterBox arithmetic ──────────────────────────────────────────────
    ok = rect_ok(center_rect(cell.rect(10, 10, 20, 9), pt(6, 3), false, false), 17, 13, 6, 3, "centred") && ok
    ok = rect_ok(center_rect(cell.rect(0, 0, 7, 4), pt(2, 1), false, false), 2, 1, 2, 1, "odd leftover: the extra cell after") && ok
    ok = rect_ok(center_rect(cell.rect(0, 0, 7, 4), pt(2, 1), true, false), 0, 1, 7, 1, "fill horizontally") && ok
    ok = rect_ok(center_rect(cell.rect(0, 0, 7, 4), pt(20, 9), false, false), 0, 0, 7, 4, "bigger than the box: cut to it") && ok

    // ── GridBox arithmetic ────────────────────────────────────────────────
    // Five children in two columns: rows (a b) (c d) (e).
    [4]GridTrack tc
    [4]GridTrack tr
    mins[0] = pt(3, 1)
    mins[1] = pt(5, 2)
    mins[2] = pt(4, 1)
    mins[3] = pt(1, 1)
    mins[4] = pt(2, 4)
    for k in 0..<5:
        grow[k] = false
        growv[k] = false
    grow[1] = true
    growv[4] = true
    i32 nr = gridbox_tracks(mins[0..<5], grow[0..<5], growv[0..<5], 2, tc[:], tr[:])
    ok = #expect(nr == 3, "three rows ", nr) && ok
    ok = #expect(tc[0].extent == 4 && tc[1].extent == 5 && !tc[0].grow && tc[1].grow, "column widths ", tc[0].extent, " ", tc[1].extent) && ok
    ok = #expect(tr[0].extent == 2 && tr[1].extent == 1 && tr[2].extent == 4 && tr[2].grow && !tr[0].grow, "row heights") && ok
    ok = #expect(gridbox_sum(tc[0..<2]) == 9 && gridbox_sum(tr[0..<3]) == 7, "the minimum is the tracks summed") && ok
    ok = #expect(gridbox_tracks(mins[0..<5], grow[0..<5], growv[0..<5], 0, tc[:], tr[:]) == -1, "zero columns refused") && ok
    ok = #expect(gridbox_tracks(mins[0..<5], grow[0..<5], growv[0..<5], 1, tc[:], tr[:]) == -1, "too few row tracks refused") && ok
    ok = #expect(gridbox_arrange(cell.rect(1, 1, 12, 10), 2, mins[0..<5], grow[0..<5], growv[0..<5], tc[:], tr[:], out[0..<5]), "arranged") && ok
    // Columns 4 and 5 + 3 over = 8; rows 2, 1, 4 + 3 over = 7.
    ok = rect_ok(out[0], 1, 1, 4, 2, "grid a") && ok
    ok = rect_ok(out[1], 5, 1, 8, 2, "grid b") && ok
    ok = rect_ok(out[3], 5, 3, 8, 1, "grid d") && ok
    ok = rect_ok(out[4], 1, 4, 4, 7, "grid e") && ok
    // Shortage in order: tracks 4, 5 in 6 columns are 4, 2.
    ok = #expect(gridbox_arrange(cell.rect(0, 0, 6, 3), 2, mins[0..<5], grow[0..<5], growv[0..<5], tc[:], tr[:], out[0..<5]), "arranged short") && ok
    ok = #expect(out[0].cols == 4 && out[1].cols == 2 && out[4].rows == 0 && out[2].rows == 1, "grid shortage") && ok

    // ── ScrollBox arithmetic ──────────────────────────────────────────────
    ok = #expect(scroll_box_max(30, 10) == 20 && scroll_box_max(5, 10) == 0 && scroll_box_max(5, -2) == 5, "max top") && ok
    ok = rect_ok(scroll_box_child(cell.rect(2, 3, 10, 5), 12, 4), 2, -1, 10, 12, "child four rows up") && ok
    ok = rect_ok(scroll_box_child(cell.rect(2, 3, 10, 5), 12, 99), 2, -4, 10, 12, "top clamped to the max") && ok
    ok = rect_ok(scroll_box_child(cell.rect(2, 3, 10, 5), 2, 3), 2, 3, 10, 5, "a short child fills the box, unscrolled") && ok
    cell.CellPoint sm = scroll_box_minimum(pt(9, 40))
    ok = #expect(sm.col == 9 && sm.row == 1, "scroll minimum one row") && ok

    // ── In a tree ─────────────────────────────────────────────────────────
    cell.CellRect screen = cell.rect(0, 0, 30, 12)
    Control hb = hbox(NIL)
    Control h1 = bleaf(hb, 5, 1)
    Control h2 = bleaf(hb, 3, 2)
    set_expand(h2, true, false)
    update(screen)
    ok = rect_ok(rect(hb), 0, 0, 30, 2, "hbox takes its minimum rows in the root") && ok
    ok = rect_ok(rect(h1), 0, 0, 5, 2, "hbox child 0") && ok
    ok = rect_ok(rect(h2), 5, 0, 25, 2, "the expander takes the rest") && ok
    set_visible(h1, false)
    update(screen)
    ok = rect_ok(rect(h2), 0, 0, 30, 2, "a hidden child takes nothing") && ok
    remove(hb)

    Control cb = center_box(NIL)
    set_expand(cb, true, true)
    Control cc = bleaf(cb, 6, 2)
    update(screen)
    ok = rect_ok(rect(cc), 12, 5, 6, 2, "centred in the screen") && ok
    ok = #expect(minimum(cb).col == 6 && minimum(cb).row == 2, "center minimum") && ok
    remove(cb)

    Control gb = grid_box(NIL, 3)
    ok = #expect(grid_box_columns(gb) == 3, "columns") && ok
    for k in 0..<7:
        _ = bleaf(gb, 2 + i32(k), 1)
    update(screen)
    ok = #expect(minimum(gb).col == 7 + 8 + 6 && minimum(gb).row == 3, "grid minimum ", minimum(gb).col, "x", minimum(gb).row) && ok
    Control g4 = next_sibling(next_sibling(next_sibling(first_child(gb))))
    ok = rect_ok(rect(g4), 0, 1, 8, 1, "the fourth child starts row two, in the widest column") && ok
    grid_box_set_columns(gb, 7)
    update(screen)
    ok = rect_ok(rect(g4), 2 + 3 + 4, 0, 5, 1, "one row of seven") && ok
    grid_box_set_columns(gb, 0)
    ok = #expect(grid_box_columns(gb) == 1, "columns held at one") && ok
    remove(gb)

    // A scroll box eight rows high over a focusable 20-row child.
    Control sb = scroll_box(NIL)
    set_expand(sb, true, true)
    Control content = bleaf(sb, 10, 20)
    set_focusable(content, true)
    Control extra = bleaf(sb, 3, 3)
    update(cell.rect(0, 0, 30, 8))
    ok = rect_ok(rect(sb), 0, 0, 30, 8, "the box fills the screen") && ok
    ok = rect_ok(rect(content), 0, 0, 30, 20, "the child at full height") && ok
    ok = rect_ok(rect(extra), 0, 0, 0, 0, "a second child gets nothing") && ok
    (i32 top, i32 max) = scroll_box_position(sb)
    ok = #expect(top == 0 && max == 12, "top 0 of 12 ", max) && ok
    ok = #expect(hit(3, 7) == content, "the child owns the box's cells") && ok
    ok = #expect(dispatch(wheel_at(3, 3, 1)), "a wheel notch scrolls") && ok
    update(cell.rect(0, 0, 30, 8))
    (top, max) = scroll_box_position(sb)
    ok = #expect(top == WHEEL_LINES, "a notch is WHEEL_LINES rows ", top) && ok
    ok = rect_ok(rect(content), 0, 0 - WHEEL_LINES, 30, 20, "the child moved up") && ok
    set_focus(content)
    ok = #expect(dispatch(key(i32(input.Keycode.End))), "End bubbles to the box") && ok
    update(cell.rect(0, 0, 30, 8))
    (top, max) = scroll_box_position(sb)
    ok = #expect(top == 12, "End is the bottom ", top) && ok
    ok = #expect(dispatch(key(i32(input.Keycode.PageUp))), "PageUp") && ok
    update(cell.rect(0, 0, 30, 8))
    (top, max) = scroll_box_position(sb)
    ok = #expect(top == 5, "a page is the rows less one ", top) && ok
    ok = #expect(dispatch(key(i32(input.Keycode.Up))) && scroll_box_scroll_to(sb, 0), "Up, then to the top") && ok
    ok = #expect(!scroll_box_scroll_to(sb, 0), "already at the top") && ok
    ok = #expect(!scroll_box_scroll_by(sb, -3), "nothing above the top") && ok
    // A taller screen shrinks the range, and the top is held to it.
    ok = #expect(scroll_box_scroll_to(sb, 12), "back to the bottom") && ok
    update(cell.rect(0, 0, 30, 15))
    (top, max) = scroll_box_position(sb)
    ok = #expect(top == 5 && max == 5, "clamped by a resize ", top, " of ", max) && ok
    update(cell.rect(0, 0, 30, 25))
    ok = #expect(!dispatch(wheel_at(3, 3, 1)), "nothing to scroll: the wheel is not taken") && ok

    reset()
    if ok:
        return 0
    return 1
