@test
// The text edit and the mouse, through `dispatch` and the tree's routing, with
// no window (a pixel is a cell): a press placing the caret on a tab, on the
// right half of a wide cluster, past a line's end and below the last line; a
// press focusing the edit; Shift+press extending; a drag across lines, one
// held past the bottom and top edges scrolling a line per motion, and its
// release outside the edit; a double-click selecting a word and the timing and
// place that make one; and the events left to bubble.
package ui

import "app:input"
import "app:ui/cell"

// ── A fixed document; edits are refused ────────────────────────────────────

private [32]string8 g_ml
private i64 g_mn

private i64 m_count(rawptr ctx):
    _ = ctx
    return g_mn

private string8 m_line(rawptr ctx, i64 i):
    _ = ctx
    return g_ml[i]

private cell.TextPos m_insert(rawptr ctx, cell.TextPos at, string8 text):
    _ = ctx
    _ = text
    return at

private bool m_remove(rawptr ctx, cell.TextPos from, cell.TextPos to):
    _ = ctx
    _ = from
    _ = to
    return false

private void mdoc(Control ed):
    EditSource src = (m_count, m_line, m_insert, m_remove, nil)
    text_edit_set_source(ed, src)

// ── A clock the test moves ─────────────────────────────────────────────────

private f64 g_now = 100.0

private f64 m_clock():
    return g_now

// ── Events: a pixel is a cell while the grid is down ───────────────────────

private const u32 SHIFT = 0x1

private bool press_at(i32 col, i32 row, u32 mods):
    input.Event e = (input.EventKind.Mouse, 0, f32(col), f32(row), mods | u32(input.Modifier.Lmb))
    return dispatch(e)

private bool move_to(i32 col, i32 row):
    input.Event e = (input.EventKind.Mouse, -1, f32(col), f32(row), input.MOUSE_MOTION | u32(input.Modifier.Lmb))
    return dispatch(e)

private bool release_at(i32 col, i32 row):
    input.Event e = (input.EventKind.Mouse, 0, f32(col), f32(row), input.MOUSE_UP)
    return dispatch(e)

// A press and its release, a second after the last, so no two clicks here
// make a double-click unless a test says so.
private void click(i32 col, i32 row):
    g_now = g_now + 1.0
    _ = press_at(col, row, 0)
    _ = release_at(col, row)

private bool caret_is(Control c, i64 line, i32 byte, string8 what):
    cell.TextPos p = text_edit_caret(c)
    return #expect(p.line == line && p.byte == byte, what, ": caret ", p.line, ",", p.byte, " want ", line, ",", byte)

private bool sel_is(Control c, i64 fl, i32 fb, i64 tl, i32 tb, string8 what):
    (cell.TextPos f, cell.TextPos t) = text_edit_selection(c)
    return #expect(f == cell.pos(fl, fb) && t == cell.pos(tl, tb), what, ": selection ", f.line, ",", f.byte, " .. ", t.line, ",", t.byte, " want ", fl, ",", fb, " .. ", tl, ",", tb)

private bool collapsed_at(Control c, i64 line, i32 byte, string8 what):
    return sel_is(c, line, byte, line, byte, what)

private i64 top_of(Control c):
    (i64 top, i64 _) = text_edit_position(c)
    return top

i32 test():
    bool ok = true
    g_edit_clock = m_clock
    cell.CellRect scr = cell.rect(0, 0, 20, 5)
    Control ed = text_edit(NIL)
    text_edit_set_gutter(ed, false)

    // ── Placing the caret ──────────────────────────────────────────────────
    // "a", a tab from column 1 to the tab stop, "b" at the stop; "xx", a wide
    // cluster over columns 2..3, "y" at 4.
    g_ml[0] = "a\tb"
    g_ml[1] = "xx\xE6\x97\xA5y"
    g_ml[2] = "short"
    g_mn = 3
    mdoc(ed)
    update(scr)
    ok = #expect(focused() == NIL, "nothing focused yet") && ok
    i32 stop = cell.TAB_COLUMNS
    ok = #expect(press_at(stop - 1, 0, 0), "a left press is handled") && ok
    ok = #expect(focused() == ed, "the press focused the edit") && ok
    ok = #expect(release_at(stop - 1, 0), "its release is handled") && ok
    ok = collapsed_at(ed, 0, 1, "inside the tab: its start") && ok
    click(stop, 0)
    ok = caret_is(ed, 0, 2, "on b") && ok
    click(stop + 1, 0)
    ok = caret_is(ed, 0, 3, "one past the end: the end") && ok
    click(3, 1)
    ok = caret_is(ed, 1, 2, "the right half of the wide cluster: its start") && ok
    click(4, 1)
    ok = caret_is(ed, 1, 5, "y, after the wide cluster") && ok
    click(15, 2)
    ok = caret_is(ed, 2, 5, "far past a line's end: its end") && ok
    click(0, 0)
    click(5, 4)
    ok = caret_is(ed, 2, 5, "below the last line: the document's end") && ok

    // ── Shift+press extends ────────────────────────────────────────────────
    click(0, 1)
    g_now = g_now + 1.0
    ok = #expect(press_at(2, 2, SHIFT), "shift+press") && ok
    _ = release_at(2, 2)
    ok = sel_is(ed, 1, 0, 2, 2, "shift+press extends from the caret") && caret_is(ed, 2, 2, "the caret at the press") && ok
    g_now = g_now + 1.0
    _ = press_at(0, 0, SHIFT)
    _ = release_at(0, 0)
    ok = sel_is(ed, 0, 0, 1, 0, "and again, past the anchor") && ok
    click(1, 2)
    ok = collapsed_at(ed, 2, 1, "a plain press collapses") && ok

    // ── Left alone ─────────────────────────────────────────────────────────
    input.Event rp = (input.EventKind.Mouse, 1, 3.0, 0.0, u32(input.Modifier.Rmb))
    ok = #expect(!dispatch(rp), "a right press bubbles") && caret_is(ed, 2, 1, "and moves nothing") && ok
    input.Event rr = (input.EventKind.Mouse, 1, 3.0, 0.0, input.MOUSE_UP)
    ok = #expect(!dispatch(rr), "its release bubbles") && ok
    ok = #expect(!release_at(3, 0), "a left release with no drag bubbles") && ok
    input.Event hover = (input.EventKind.Mouse, -1, 3.0, 0.0, input.MOUSE_MOTION)
    ok = #expect(!dispatch(hover), "a hover bubbles") && caret_is(ed, 2, 1, "and moves nothing") && ok

    // ── Dragging ───────────────────────────────────────────────────────────
    g_now = g_now + 1.0
    _ = press_at(0, 0, 0)
    ok = #expect(move_to(2, 1), "a drag motion is handled") && ok
    ok = sel_is(ed, 0, 0, 1, 2, "dragged onto the wide cluster") && ok
    ok = #expect(move_to(1, 2), "and on") && sel_is(ed, 0, 0, 2, 1, "dragged a line further") && ok
    ok = #expect(release_at(1, 2), "the release ends it") && ok
    ok = #expect(!move_to(4, 0), "motion after the release is not a drag") && sel_is(ed, 0, 0, 2, 1, "the selection stays") && ok
    // A motion with the button no longer held ends a drag whose release went
    // elsewhere.
    g_now = g_now + 1.0
    _ = press_at(0, 0, 0)
    ok = #expect(!dispatch(hover), "motion with no button ends the drag") && ok
    ok = #expect(!move_to(3, 1), "and a later held motion does not drag") && collapsed_at(ed, 0, 0, "nothing selected") && ok
    _ = release_at(3, 1)

    // Past the bottom and the top of a scrolling view, a line per motion; the
    // capture keeps the motion coming from outside the edit.
    for i in 0..<20:
        g_ml[i] = "line"
    g_mn = 20
    mdoc(ed)
    update(scr)
    g_now = g_now + 1.0
    _ = press_at(0, 1, 0)
    ok = collapsed_at(ed, 1, 0, "drag start") && ok
    ok = #expect(move_to(3, 7), "motion below the view") && ok
    ok = sel_is(ed, 1, 0, 5, 3, "one line past the bottom") && ok
    ok = #expect(top_of(ed) == 1, "scrolled one: top ", top_of(ed)) && ok
    update(scr)
    _ = move_to(3, 9)
    ok = sel_is(ed, 1, 0, 6, 3, "another line") && ok
    ok = #expect(top_of(ed) == 2, "scrolled again: top ", top_of(ed)) && ok
    update(scr)
    _ = move_to(2, -3)
    ok = caret_is(ed, 1, 2, "above the view: the line before the top") && ok
    ok = #expect(top_of(ed) == 1, "scrolled up: top ", top_of(ed)) && ok
    update(scr)
    _ = move_to(2, -3)
    ok = sel_is(ed, 0, 2, 1, 0, "past the anchor upwards") && ok
    ok = #expect(top_of(ed) == 0, "scrolled up again") && ok
    update(scr)
    ok = #expect(release_at(40, 40), "the release off the screen still reaches the edit") && ok
    ok = sel_is(ed, 0, 2, 1, 0, "selection kept after the drag") && ok

    // ── Double-click ───────────────────────────────────────────────────────
    g_ml[0] = "foo bar_baz, x"
    g_mn = 1
    mdoc(ed)
    update(scr)
    g_now = 500.0
    _ = press_at(5, 0, 0)
    _ = release_at(5, 0)
    g_now = 500.1
    _ = press_at(5, 0, 0)
    _ = release_at(5, 0)
    ok = sel_is(ed, 0, 4, 0, 11, "a double-click selects the word") && caret_is(ed, 0, 11, "caret at its end") && ok
    g_now = 500.2
    _ = press_at(5, 0, 0)
    _ = release_at(5, 0)
    ok = collapsed_at(ed, 0, 5, "a third press is a single one") && ok
    g_now = 500.3
    _ = press_at(11, 0, 0)
    _ = release_at(11, 0)
    g_now = 500.4
    _ = press_at(11, 0, 0)
    _ = release_at(11, 0)
    ok = sel_is(ed, 0, 11, 0, 12, "double-clicking punctuation selects its run") && ok
    g_now = 501.0
    _ = press_at(3, 0, 0)
    _ = release_at(3, 0)
    g_now = 501.1
    _ = press_at(3, 0, 0)
    _ = release_at(3, 0)
    ok = sel_is(ed, 0, 3, 0, 4, "a blank's run") && ok
    g_now = 510.0
    _ = press_at(1, 0, 0)
    _ = release_at(1, 0)
    g_now = 510.5
    _ = press_at(1, 0, 0)
    _ = release_at(1, 0)
    ok = collapsed_at(ed, 0, 1, "half a second apart is two clicks") && ok
    g_now = 520.0
    _ = press_at(1, 0, 0)
    _ = release_at(1, 0)
    g_now = 520.1
    _ = press_at(2, 0, 0)
    _ = release_at(2, 0)
    ok = collapsed_at(ed, 0, 2, "another cell is two clicks") && ok
    g_now = 530.0
    _ = press_at(17, 0, 0)
    _ = release_at(17, 0)
    g_now = 530.1
    _ = press_at(17, 0, 0)
    _ = release_at(17, 0)
    ok = sel_is(ed, 0, 13, 0, 14, "past the end: the last word") && ok

    // Held after a double-click: motion in the pressed cell keeps the word,
    // and a drag extends by whole words either way, never dropping it.
    g_now = 600.0
    _ = press_at(5, 0, 0)
    _ = release_at(5, 0)
    g_now = 600.1
    _ = press_at(5, 0, 0)
    ok = #expect(move_to(5, 0), "motion in the pressed cell is taken") && ok
    ok = sel_is(ed, 0, 4, 0, 11, "and keeps the word") && ok
    _ = move_to(7, 0)
    ok = sel_is(ed, 0, 4, 0, 11, "inside the word: the word") && ok
    _ = move_to(13, 0)
    ok = sel_is(ed, 0, 4, 0, 14, "on to the next word, whole") && caret_is(ed, 0, 14, "caret at its end") && ok
    _ = move_to(1, 0)
    ok = sel_is(ed, 0, 0, 0, 11, "back before it: the clicked word kept") && caret_is(ed, 0, 0, "caret at the start") && ok
    _ = release_at(1, 0)
    // A single press held in its cell selects nothing.
    g_now = 610.0
    _ = press_at(2, 0, 0)
    _ = move_to(2, 0)
    ok = collapsed_at(ed, 0, 2, "a single press trembling in its cell") && ok
    _ = release_at(2, 0)

    // The wheel still scrolls without moving the caret.
    for i in 0..<20:
        g_ml[i] = "line"
    g_mn = 20
    mdoc(ed)
    update(scr)
    input.Event wheel = (input.EventKind.Mouse, 1, 0.0, 0.0, input.MOUSE_WHEEL)
    ok = #expect(dispatch(wheel), "wheel handled") && caret_is(ed, 0, 0, "wheel leaves the caret") && ok
    ok = #expect(top_of(ed) == i64(WHEEL_LINES), "wheel scrolled") && ok

    g_edit_clock = nil
    reset()
    if ok: return 0
    return 1
