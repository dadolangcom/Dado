@test
// Horizontal follow over a wide cluster: the caret covers both of its cells,
// so a view whose right edge falls between them scrolls to show the whole
// cluster, and the caret on a tab needs only the tab's first cell.
package ui

import "app:ui/cell"

private string8 g_line = "aaaa\xE6\x97\xA5x\tz"

private i64 one_count(rawptr ctx):
    _ = ctx
    return 1

private string8 one_line(rawptr ctx, i64 i):
    _ = ctx
    _ = i
    return g_line

private cell.TextPos no_insert(rawptr ctx, cell.TextPos at, string8 text):
    _ = ctx
    _ = text
    return at

private bool no_remove(rawptr ctx, cell.TextPos from, cell.TextPos to):
    _ = ctx
    _ = from
    _ = to
    return false

i32 test():
    bool ok = true
    Control ed = text_edit(NIL)
    text_edit_set_gutter(ed, false)
    EditSource src = (one_count, one_line, no_insert, no_remove, nil)
    text_edit_set_source(ed, src)
    set_focus(ed)
    update(cell.rect(0, 0, 5, 3))
    cell.CellRect r = rect(ed)
    ok = #expect(r.cols == 5, "the view is five columns: ", r.cols) && ok

    // The wide cluster takes columns 4 and 5; the view shows 0..4. Its left
    // cell is on screen and its right is not, so the view scrolls one.
    text_edit_set_caret(ed, cell.pos(0, 4))
    update(cell.rect(0, 0, 5, 3))
    ok = #expect(text_edit_left_col(ed) == 1, "a wide caret at the edge scrolls: left ", text_edit_left_col(ed)) && ok

    // Back to the start, then onto the tab at column 7 (`x` is 6): the tab's
    // caret is its first cell, so the view scrolls to put column 7 last.
    text_edit_set_caret(ed, cell.pos(0, 0))
    update(cell.rect(0, 0, 5, 3))
    ok = #expect(text_edit_left_col(ed) == 0, "back to the start: left ", text_edit_left_col(ed)) && ok
    text_edit_set_caret(ed, cell.pos(0, 8))
    update(cell.rect(0, 0, 5, 3))
    ok = #expect(text_edit_left_col(ed) == 3, "a tab needs its first cell only: left ", text_edit_left_col(ed)) && ok

    reset()
    if ok: return 0
    return 1
