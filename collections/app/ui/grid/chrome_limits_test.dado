@test
// The chrome at its limits, with no GPU: the chunking rule that fits a layer's
// boxes into sokol_gp's per-flush and per-frame budgets, and boxes whose pixel
// quantities sit at the ends of `i32`.
package grid

i32 test():
    bool ok = true

    // ── One step ──
    ok = #expect(chunk_step(100, 0, 1000, 5000) == ChunkStep.Draw, "fits") && ok
    ok = #expect(chunk_step(100, 950, 1000, 5000) == ChunkStep.FlushThenDraw, "flush first") && ok
    ok = #expect(chunk_step(100, 900, 1000, 5000) == ChunkStep.Draw, "exactly full") && ok
    ok = #expect(chunk_step(100, 0, 1000, 99) == ChunkStep.Drop, "frame spent") && ok
    ok = #expect(chunk_step(1001, 0, 1000, 5000) == ChunkStep.Drop, "never fits a flush") && ok
    ok = #expect(chunk_step(0, 1000, 1000, 0) == ChunkStep.Draw, "an empty box costs nothing") && ok

    // ── Plans ──
    [300]i32 hundred
    for i in 0..<300:
        hundred[i] = 100
    (i32 d0, i32 f0) = chunk_plan(hundred[:], 1000, 1000000)
    ok = #expect(d0 == 300 && f0 == 30, "300 x 100 in flushes of 1000: ", d0, " ", f0) && ok
    (i32 d1, i32 f1) = chunk_plan(hundred[0..<10], 1000, 1000000)
    ok = #expect(d1 == 10 && f1 == 1, "one flush when it fits") && ok
    [10]i32 three
    for i in 0..<10:
        three[i] = 300
    (i32 d2, i32 f2) = chunk_plan(three[:], 1000, 1000000)
    ok = #expect(d2 == 10 && f2 == 4, "3 + 3 + 3 + 1: ", f2) && ok
    // The frame runs out after 8 x 300 = 2400 of 2500: the ninth and tenth
    // are dropped, a suffix.
    (i32 d3, i32 f3) = chunk_plan(three[:], 1000, 2500)
    ok = #expect(d3 == 8 && f3 == 3, "frame budget: ", d3, " ", f3) && ok
    // A box too big for any flush stops the list there, even though a later
    // one would fit: what is dropped is always the tail.
    [3]i32 mixed = [10, 2000, 10]
    (i32 d4, i32 f4) = chunk_plan(mixed[:], 1000, 1000000)
    ok = #expect(d4 == 1 && f4 == 1, "stops at the oversized box") && ok
    (i32 d5, i32 f5) = chunk_plan(mixed[0..<0], 1000, 1000000)
    ok = #expect(d5 == 0 && f5 == 0, "nothing, no flush") && ok

    // ── The case that used to lose everything ──
    // A rounded, bordered, shadowed card. At `app:draw`'s default budget of
    // 65536 vertices a flush holds 21845 triangles and the chrome's share of
    // a frame is 75 percent, 16384 triangles.
    ChromeBox card = chrome_box(0, 0, 120, 60)
    card.fill = [230, 230, 238, 255]
    card.border = [90, 90, 110, 255]
    card.border_l = 1
    card.border_t = 1
    card.border_r = 1
    card.border_b = 1
    card.radius = 6
    card.shadow = [0, 0, 0, 120]
    card.shadow_size = 6
    card.shadow_dy = 3
    [MAX_BOX_TRIS]ChromeTri tris
    i32 per = box_triangles(card, tris[:])
    [320]i32 cards
    for i in 0..<320:
        cards[i] = per
    i32 frame = 65536 * CHROME_FRAME_PERCENT / 100 / 3
    ok = #expect(frame == 16384, "frame share ", frame) && ok
    (i32 dc, i32 fc) = chunk_plan(cards[:], 65536 / 3, frame)
    ok = #expect(dc == frame / per && fc == 1, "cards drawn ", dc, " of 320 at ", per, " triangles, ", fc, " flush") && ok
    // With the whole buffer as the frame budget the per-flush cap is what
    // splits the list.
    (i32 dw, i32 fw) = chunk_plan(cards[:], 65536 / 3, 1000000)
    // Whole boxes only: floor(21845 / per) to a flush.
    i32 per_flush = 21845 / per
    i32 want = (320 + per_flush - 1) / per_flush
    ok = #expect(dw == 320 && fw == want && fw > 1, "split into ", fw, " flushes, expected ", want) && ok

    // ── Extremes ──
    // Every pixel quantity at the top of `i32`: held to MAX_CHROME_PX before
    // any arithmetic, so the sanitized build sees no overflow.
    i32 big = 2147483647
    i32 low = 0 - 2147483647 - 1
    ChromeBox x = chrome_box(big, low, big, big)
    x.fill = [1, 2, 3, 255]
    x.border = [4, 5, 6, 255]
    x.border_l = big
    x.border_t = big
    x.border_r = big
    x.border_b = big
    x.radius = big
    x.shadow = [0, 0, 0, 200]
    x.shadow_size = big
    x.shadow_dx = low
    x.shadow_dy = big
    ChromeBox c = chrome_clamped(x)
    ok = #expect(c.x == MAX_CHROME_PX && c.y == 0 - MAX_CHROME_PX && c.w == MAX_CHROME_PX, "rect held") && ok
    ok = #expect(c.shadow_size == MAX_CHROME_PX && c.shadow_dx == 0 - MAX_CHROME_PX && c.radius == MAX_CHROME_PX, "shadow and radius held") && ok
    i32 nx = box_triangles(x, tris[:])
    ok = #expect(nx > 0 && nx <= MAX_BOX_TRIS, "tessellates: ", nx) && ok
    (ChromeRect so, i32 srad, u8 sa) = shadow_ring(x, 3)
    ok = #expect(so.w == 3 * MAX_CHROME_PX && so.x == MAX_CHROME_PX - MAX_CHROME_PX - MAX_CHROME_PX && sa > 0, "outer shadow copy ", so.w) && ok
    ok = #expect(srad == 2 * MAX_CHROME_PX, "shadow radius ", srad) && ok

    // A shadow size near 1.5e9 keeps its shadow: the outermost copy is the
    // box grown by MAX_CHROME_PX, not a wrapped negative width.
    ChromeBox s = chrome_box(10, 10, 100, 50)
    s.shadow = [0, 0, 0, 128]
    s.shadow_size = 1500000000
    (ChromeRect r3, i32 _, u8 a3) = shadow_ring(s, 3)
    ok = #expect(r3.w == 100 + 2 * MAX_CHROME_PX && r3.h == 50 + 2 * MAX_CHROME_PX && a3 > 0, "huge shadow kept: ", r3.w) && ok
    i32 ns = box_triangles(s, tris[:])
    // Each copy's corner radius is its growth, so all four are fans at the
    // chord cap: 4 x 68 triangles.
    ok = #expect(ns == SHADOW_STEPS * MAX_OUTLINE_POINTS && tris[0].col[3] > 0, "huge shadow draws its copies: ", ns) && ok

    // Borders wider than anything fill the box and never invert.
    [4]ChromeRect rs
    ChromeBox bb = chrome_box(0, 0, 40, 20)
    bb.border_l = big
    bb.border_t = big
    ok = #expect(border_rects(bb, rs[:]) == 1 && rs[0] == ChromeRect((0, 0, 40, 20)), "overwide border") && ok
    // Negative sizes draw nothing.
    ChromeBox neg = chrome_box(0, 0, low, -5)
    neg.fill = [1, 1, 1, 255]
    neg.shadow = [0, 0, 0, 255]
    ok = #expect(box_triangles(neg, tris[:]) == 0, "negative box") && ok

    if ok:
        return 0
    return 1
