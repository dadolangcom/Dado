@test
// Layer bookkeeping with no GPU: the count, the target, lazy cells, the
// touched flag, clearing, resizing, and each layer's chrome list. The cell is
// set by hand to 8 x 16 where `up` would derive it, and the allocator is
// captured by hand where `up` would capture it; nothing here calls sokol.
package grid

import "app:ui/cell"

private void reset():
    for i in 0..<MAX_LAYERS:
        release_layer(i32(i))
    g_nlayers = 1
    g_target = BASE
    g_cols = 0
    g_rows = 0
    g_cw = 0
    g_ch = 0
    g_have_alloc = false
    g_clipping = false

i32 test():
    bool ok = true
    [4]u8 fg = [230, 230, 230, 255]
    [4]u8 bg = [20, 30, 40, 255]
    [4]u8 tip = [250, 240, 200, 255]

    g_cw = 8
    g_ch = 16
    g_alloc = #default
    g_have_alloc = true

    // ── The count ──
    ok = #expect(layers() == 1 && targeted() == BASE, "one layer, targeting the base") && ok
    set_layers(0)
    ok = #expect(layers() == 1, "at least one") && ok
    set_layers(99)
    ok = #expect(layers() == MAX_LAYERS, "at most MAX_LAYERS") && ok
    set_layers(3)
    ok = #expect(layers() == 3, "three") && ok

    // ── Sizing: 80 x 48 px of 8 x 16 cells is 10 x 3 ──
    ok = #expect(begin(80, 48), "first begin sizes") && ok
    ok = #expect(cols() == 10 && rows() == 3, "10 x 3") && ok
    ok = #expect(g_layers[0].cells != nil && g_layers[1].cells == nil && g_layers[2].cells == nil, "only the base is made") && ok
    ok = #expect(!begin(80, 48), "same size keeps") && ok

    // ── The default target is the base ──
    cell.Cell c = (7, 0, fg, bg)
    put(1, 1, c)
    ok = #expect(cell_at(1, 1) == c && cell_at_layer(BASE, 1, 1) == c, "base written") && ok
    ok = #expect(cell_at_layer(1, 1, 1) == cell.blank(), "layer 1 untouched") && ok
    ok = #expect(g_layers[1].cells == nil && !layer_touched(1), "still not made") && ok

    // ── Layer 1: made at its first write, transparent elsewhere ──
    target(1)
    fill(cell.rect(2, 0, 3, 2), fg, tip)
    ok = #expect(g_layers[1].cells != nil && layer_touched(1), "made and touched") && ok
    ok = #expect(cell_at_layer(1, 3, 1).bg == tip, "layer 1 filled") && ok
    ok = #expect(cell_at(3, 1).bg[3] == 0 && cell_at(1, 1) == c, "the base untouched by layer 1's writes") && ok
    cell.Cell hole = cell_at_layer(1, 9, 2)
    ok = #expect(hole.slot == BLANK_SLOT && hole.bg[3] == 0 && hole.fg[3] == 0, "unwritten upper cells are transparent") && ok
    ok = #expect(!layer_touched(2) && g_layers[2].cells == nil, "layer 2 still nothing") && ok
    ok = #expect(g_cells_written == 1 + 6, "cells written counts every layer: ", g_cells_written) && ok

    // Clipping applies to whichever layer is targeted.
    clip(cell.rect(0, 0, 1, 1))
    fill(cell.rect(0, 0, 10, 3), fg, bg)
    unclip()
    ok = #expect(cell_at_layer(1, 0, 0).bg == bg && cell_at_layer(1, 1, 0).bg[3] == 0, "clip holds on layer 1") && ok

    // ── A target that names no layer writes nowhere ──
    i32 before = g_cells_written
    target(3)
    put(0, 0, c)
    _ = text(0, 0, "abc", 3, fg, bg)
    target(-1)
    fill(cell.rect(0, 0, 10, 3), fg, bg)
    ok = #expect(g_cells_written == before && g_layers[3].cells == nil, "out of range writes nothing") && ok
    ok = #expect(cell_at_layer(3, 0, 0) == cell.blank() && cell_at_layer(-1, 0, 0) == cell.blank(), "and reads blank") && ok

    // ── What draws ──
    ok = #expect(layer_draws(BASE, false) && !layer_draws(1, false) && layer_draws(1, true), "base always; others when touched") && ok

    // ── begin points back at the base, and keeps every layer's cells ──
    target(1)
    ok = #expect(!begin(80, 48) && targeted() == BASE, "begin retargets the base") && ok
    ok = #expect(cell_at_layer(1, 3, 1).bg == tip && layer_touched(1), "layer 1 retained across frames") && ok

    // ── clear_layer ──
    clear_layer(1)
    ok = #expect(!layer_touched(1) && cell_at_layer(1, 3, 1) == cell.blank(), "cleared to transparent") && ok
    ok = #expect(cell_at(1, 1) == c, "clearing layer 1 leaves the base") && ok
    clear_layer(BASE)
    ok = #expect(cell_at(1, 1) == cell.blank(), "the base clears too") && ok
    clear_layer(7)

    // ── A resize clears every layer ──
    target(2)
    put(0, 0, c)
    target(BASE)
    put(0, 0, c)
    ok = #expect(layer_touched(2) && begin(160, 48), "resize") && ok
    ok = #expect(cols() == 20 && rows() == 3, "20 x 3") && ok
    ok = #expect(!layer_touched(2) && g_layers[2].cells == nil && g_layers[1].cells == nil, "upper layers given back") && ok
    ok = #expect(cell_at(0, 0) == cell.blank() && g_layers[BASE].cells != nil, "base remade blank") && ok

    // ── Chrome lists ──
    ChromeBox p = chrome_box(8, 16, 80, 32)
    p.fill = bg
    ok = #expect(chrome_add(BASE, p) && chrome_add(1, p) && chrome_add(1, chrome_box(1, 2, 3, 4)), "added") && ok
    ok = #expect(chrome_count(BASE) == 1 && chrome_count(1) == 2 && chrome_count(2) == 0, "counts") && ok
    ok = #expect(chrome_at(1, 1).x == 1 && chrome_at(1, 0) == p && chrome_at(1, 5).w == 0, "in order") && ok
    ok = #expect(!chrome_add(3, p) && !chrome_add(-1, p) && chrome_count(3) == 0, "no such layer") && ok
    // A resize keeps chrome: it is in pixels.
    ok = #expect(begin(80, 48) && chrome_count(1) == 2, "chrome survives a resize") && ok
    chrome_clear(1)
    ok = #expect(chrome_count(1) == 0 && chrome_count(BASE) == 1, "cleared one layer's chrome") && ok
    // Before the allocator is captured nothing is added.
    g_have_alloc = false
    ok = #expect(!chrome_add(BASE, p) && chrome_count(BASE) == 1, "no allocator, no add") && ok
    g_have_alloc = true

    // ── Shrinking gives dropped layers back ──
    target(2)
    put(0, 0, c)
    _ = chrome_add(2, p)
    set_layers(2)
    ok = #expect(layers() == 2 && g_layers[2].cells == nil && g_layers[2].chrome.boxes == nil, "layer 2 released") && ok
    ok = #expect(cell_at_layer(2, 0, 0) == cell.blank() && chrome_count(2) == 0, "and reads empty") && ok
    before = g_cells_written
    put(0, 0, c)
    ok = #expect(g_cells_written == before, "a target past the new count writes nowhere") && ok

    // Nothing rendered, so nothing drawn.
    Stats st = stats()
    ok = #expect(st.layers_drawn == 0 && st.draw_calls == 0 && st.chrome_triangles == 0, "no render, no draws") && ok

    reset()
    if ok:
        return 0
    return 1
