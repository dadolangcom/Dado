@test
// The chrome's geometry with no GPU: corner segments, the square border's four
// rectangles, the rounded outline, the shadow's copies and alphas, the
// triangles a box becomes (by area, colour and order) and the retained list.
package grid

import "core:math"

private f64 tri_area(ChromeTri t):
    f64 cr = f64(t.b.x - t.a.x) * f64(t.c.y - t.a.y) - f64(t.c.x - t.a.x) * f64(t.b.y - t.a.y)
    if cr < 0.0:
        cr = 0.0 - cr
    return cr * 0.5

// The summed area of the triangles in `tris[0..<n]` whose colour is `col`.
private f64 area_of([]ChromeTri tris, i32 n, [4]u8 col):
    f64 a = 0.0
    for i in 0..<n:
        if tris[i].col == col:
            a = a + tri_area(tris[i])
    return a

// The area of a `w` x `h` box whose four corners are quarter-circles of radius
// `r` cut into `segs` chords each: the box, less four corner squares, plus
// four quarter-polygons of `segs` isosceles triangles with apex angle
// `pi / 2 / segs`.
private f64 rounded_area(f64 w, f64 h, f64 r, i32 segs):
    f64 quarter = f64(segs) * 0.5 * r * r * math.sine(math.PI / 2.0 / f64(segs))
    return w * h - 4.0 * (r * r - quarter)

private bool near(f64 a, f64 b, f64 eps):
    f64 d = a - b
    if d < 0.0:
        d = 0.0 - d
    return d <= eps

private bool pt(ChromePt p, f32 x, f32 y):
    return near(f64(p.x), f64(x), 0.0001) && near(f64(p.y), f64(y), 0.0001)

i32 test():
    bool ok = true

    // ── Corner segments ──
    // Sag r * (1 - cos(pi / 4 / s)): at r = 6, s = 2 sags 0.46 and s = 3
    // sags 0.20, so 3; at r = 1, s = 1 sags 0.29 and s = 2 sags 0.08, so 2.
    ok = #expect(corner_segments(0.0) == 0 && corner_segments(-3.0) == 0, "no radius, no arc") && ok
    ok = #expect(corner_segments(6.0) == 3, "r 6: ", corner_segments(6.0)) && ok
    ok = #expect(corner_segments(1.0) == 2, "r 1: ", corner_segments(1.0)) && ok
    ok = #expect(corner_segments(100000.0) == MAX_CORNER_SEGMENTS, "held at the cap") && ok
    ok = #expect(clamp_radius(50.0, 40.0, 20.0) == 10.0 && clamp_radius(4.0, 40.0, 20.0) == 4.0, "radius held to half the short side") && ok

    // ── A square border is four rectangles on whole pixels ──
    [4]ChromeRect rs
    ChromeBox b = chrome_box(10, 20, 100, 50)
    b.border_l = 1
    b.border_t = 1
    b.border_r = 1
    b.border_b = 1
    ok = #expect(border_rects(b, rs[:]) == 4, "four edges") && ok
    ok = #expect(rs[0] == ChromeRect((10, 20, 100, 1)), "top row") && ok
    ok = #expect(rs[1] == ChromeRect((10, 69, 100, 1)), "bottom row") && ok
    ok = #expect(rs[2] == ChromeRect((10, 21, 1, 48)), "left column") && ok
    ok = #expect(rs[3] == ChromeRect((109, 21, 1, 48)), "right column") && ok
    // Their areas are the box's perimeter in pixels, 2 * (100 + 50) - 4: no
    // pixel twice, none missed.
    i32 sum = 0
    for i in 0..<4:
        sum = sum + rs[i].w * rs[i].h
    ok = #expect(sum == 296, "perimeter ", sum) && ok
    // Unequal widths, and a missing edge.
    b.border_l = 2
    b.border_t = 3
    b.border_r = 0
    b.border_b = 1
    ok = #expect(border_rects(b, rs[:]) == 3, "no right edge") && ok
    ok = #expect(rs[0] == ChromeRect((10, 20, 100, 3)) && rs[1] == ChromeRect((10, 69, 100, 1)) && rs[2] == ChromeRect((10, 23, 2, 46)), "unequal") && ok
    // A border wider than the box fills it and never inverts.
    b.border_t = 60
    ok = #expect(border_rects(b, rs[:]) == 1 && rs[0] == ChromeRect((10, 20, 100, 50)), "overfull border") && ok

    // ── The rounded outline ──
    // A 40 x 20 box with radius 6: three chords a corner, four points each,
    // clockwise from the top-left corner's leftmost point.
    [MAX_OUTLINE_POINTS]ChromePt pts
    [4]f32 r6 = [6.0, 6.0, 6.0, 6.0]
    i32 m = rounded_outline(0.0, 0.0, 40.0, 20.0, r6, r6, 3, pts[:])
    ok = #expect(m == 16, "16 points ", m) && ok
    ok = #expect(pt(pts[0], 0.0, 6.0) && pt(pts[3], 6.0, 0.0), "top-left arc") && ok
    ok = #expect(pt(pts[4], 34.0, 0.0) && pt(pts[7], 40.0, 6.0), "top-right arc") && ok
    ok = #expect(pt(pts[8], 40.0, 14.0) && pt(pts[11], 34.0, 20.0), "bottom-right arc") && ok
    ok = #expect(pt(pts[12], 6.0, 20.0) && pt(pts[15], 0.0, 14.0), "bottom-left arc") && ok
    bool inside = true
    for i in 0..<m:
        if pts[i].x < 0.0 || pts[i].x > 40.0 || pts[i].y < 0.0 || pts[i].y > 20.0:
            inside = false
    ok = #expect(inside, "the outline stays in the box") && ok
    ok = #expect(rounded_outline(0.0, 0.0, 40.0, 20.0, r6, r6, 3, pts[0..<15]) == 0, "short output refused") && ok

    // ── Shadows ──
    ChromeBox s = chrome_box(100, 100, 60, 30)
    ok = #expect(shadow_steps(s) == 0, "no colour, no shadow") && ok
    s.shadow = [0, 0, 0, 128]
    s.shadow_size = 8
    s.shadow_dx = 2
    s.shadow_dy = 4
    s.radius = 3
    ok = #expect(shadow_steps(s) == SHADOW_STEPS, "8 px: four copies") && ok
    // 1 - (127 / 255)^(1 / 4) = 0.160, times 255 is 40.8.
    u8 sa = shadow_step_alpha(128, 4)
    ok = #expect(sa == 41, "step alpha ", sa) && ok
    // Four copies of 41 compose back to the asked 128, within a unit.
    f64 left = math.raised(1.0 - f64(sa) / 255.0, 4.0)
    ok = #expect(near((1.0 - left) * 255.0, 128.0, 1.0), "composes to 128: ", (1.0 - left) * 255.0) && ok
    ok = #expect(shadow_step_alpha(200, 1) == 200 && shadow_step_alpha(0, 4) == 0, "one step is the alpha") && ok
    (ChromeRect r0, i32 rad0, u8 a0) = shadow_ring(s, 0)
    (ChromeRect r3, i32 rad3, u8 a3) = shadow_ring(s, 3)
    ok = #expect(r0 == ChromeRect((100, 102, 64, 34)) && rad0 == 5 && a0 == sa, "innermost copy grows 2") && ok
    ok = #expect(r3 == ChromeRect((94, 96, 76, 46)) && rad3 == 11 && a3 == sa, "outermost copy grows 8") && ok
    s.shadow_size = 2
    ok = #expect(shadow_steps(s) == 2, "2 px: two copies") && ok
    s.shadow_size = 0
    (ChromeRect hard, i32 hrad, u8 ha) = shadow_ring(s, 0)
    ok = #expect(shadow_steps(s) == 1 && hard == ChromeRect((102, 104, 60, 30)) && hrad == 3 && ha == 128, "0 px: one hard copy") && ok

    // ── Triangles ──
    [MAX_BOX_TRIS]ChromeTri tris
    [4]u8 fill = [40, 44, 52, 255]
    [4]u8 edge = [200, 200, 210, 255]
    [4]u8 dark = [0, 0, 0, 128]

    // A square box: its fill is its area, its 1 px border its perimeter.
    ChromeBox q = chrome_box(10, 20, 100, 50)
    q.fill = fill
    i32 n = box_triangles(q, tris[:])
    ok = #expect(n == 2 && near(area_of(tris[:], n, fill), 5000.0, 0.001), "square fill") && ok
    q.border = edge
    q.border_l = 1
    q.border_t = 1
    q.border_r = 1
    q.border_b = 1
    n = box_triangles(q, tris[:])
    ok = #expect(n == 10 && near(area_of(tris[:], n, edge), 296.0, 0.001), "square border: ", area_of(tris[:], n, edge)) && ok
    // Every vertex of a square box is a whole pixel.
    bool whole = true
    for i in 0..<n:
        ChromeTri t = tris[i]
        if t.a.x != f32(i32(t.a.x)) || t.b.y != f32(i32(t.b.y)) || t.c.x != f32(i32(t.c.x)) || t.c.y != f32(i32(t.c.y)):
            whole = false
    ok = #expect(whole, "square corners land on pixel edges") && ok

    // A rounded fill is the box less its corners' polygon deficit, and its
    // 1 px border is the difference between the outer shape and the inner one
    // (inset 1, radius 5, the same three chords).
    ChromeBox rb = chrome_box(0, 0, 40, 20)
    rb.fill = fill
    rb.radius = 6
    n = box_triangles(rb, tris[:])
    f64 outer = rounded_area(40.0, 20.0, 6.0, 3)
    ok = #expect(n == 16 && near(area_of(tris[:], n, fill), outer, 0.01), "rounded fill ", area_of(tris[:], n, fill), " vs ", outer) && ok
    rb.border = edge
    rb.border_l = 1
    rb.border_t = 1
    rb.border_r = 1
    rb.border_b = 1
    n = box_triangles(rb, tris[:])
    f64 ring = outer - rounded_area(38.0, 18.0, 5.0, 3)
    ok = #expect(n == 16 + 32 && near(area_of(tris[:], n, edge), ring, 0.01), "rounded border ", area_of(tris[:], n, edge), " vs ", ring) && ok

    // Shadow first, then fill, then border: the colours come in that order
    // and never interleave.
    rb.shadow = dark
    rb.shadow_size = 4
    n = box_triangles(rb, tris[:])
    i32 phase = 0
    bool ordered = true
    for i in 0..<n:
        i32 p = 0
        if tris[i].col == fill:
            p = 1
        else if tris[i].col == edge:
            p = 2
        if p < phase:
            ordered = false
        phase = p
    ok = #expect(ordered && tris[0].col[3] == shadow_step_alpha(128, 4) && tris[n - 1].col == edge, "shadow, fill, border") && ok

    // The largest box there can be fits `MAX_BOX_TRIS`: every shape at the
    // chord cap, four shadow copies, a fill and a ring.
    ChromeBox big = chrome_box(0, 0, 3000, 3000)
    big.fill = fill
    big.border = edge
    big.border_l = 1
    big.border_t = 1
    big.border_r = 1
    big.border_b = 1
    big.radius = 1000
    big.shadow = dark
    big.shadow_size = 8
    n = box_triangles(big, tris[:])
    ok = #expect(n == SHADOW_STEPS * MAX_OUTLINE_POINTS + MAX_OUTLINE_POINTS + 2 * MAX_OUTLINE_POINTS, "worst box ", n) && ok
    ok = #expect(n <= MAX_BOX_TRIS, "fits the bound") && ok

    // Nothing for a box with no area, shadow included.
    ChromeBox empty = chrome_box(5, 5, 0, 10)
    empty.fill = fill
    empty.shadow = dark
    ok = #expect(box_triangles(empty, tris[:]) == 0, "no area") && ok

    // ── The retained list ──
    ChromeList l
    for i in 0..<40:
        ok = #expect(chrome_list_add(&l, chrome_box(i32(i), 0, 1, 1), #default), "add ", i) && ok
    ok = #expect(l.n == 40 && #len(l.boxes) >= 40, "grew past the first 16") && ok
    bool in_order = true
    for i in 0..<40:
        if l.boxes[i].x != i32(i):
            in_order = false
    ok = #expect(in_order, "list order kept") && ok
    chrome_list_clear(&l)
    ok = #expect(l.n == 0 && l.boxes != nil, "clear keeps storage") && ok
    chrome_list_free(&l)
    ok = #expect(l.boxes == nil, "freed") && ok

    if ok:
        return 0
    return 1
