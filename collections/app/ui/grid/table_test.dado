@test
// The cluster table: insert, look up, grow, and keep keys apart that differ
// only in pixel height or face chain.
package grid

i32 test():
    bool ok = true

    Table t = table_make(4)
    ok = #expect(table_capacity(&t) == 16, "starts at the minimum ", table_capacity(&t)) && ok
    (u16 _, bool miss) = table_get(&t, 1, 16.0, "a")
    ok = #expect(!miss, "empty table misses") && ok
    ok = #expect(table_put(&t, 1, 16.0, "a", 2), "put a") && ok
    (u16 sa, bool fa) = table_get(&t, 1, 16.0, "a")
    ok = #expect(fa && sa == 2, "get a") && ok

    // Same bytes, another height or another chain: three different keys.
    ok = #expect(key_hash(1, 16.0, "a") != key_hash(1, 15.5, "a"), "px in the hash") && ok
    ok = #expect(key_hash(1, 16.0, "a") != key_hash(2, 16.0, "a"), "chain in the hash") && ok
    (u16 _, bool fpx) = table_get(&t, 1, 15.5, "a")
    (u16 _, bool fch) = table_get(&t, 2, 16.0, "a")
    ok = #expect(!fpx && !fch, "no cross talk") && ok
    ok = #expect(table_put(&t, 1, 15.5, "a", 3) && table_put(&t, 2, 16.0, "a", 4), "put the others") && ok
    (u16 s1, bool _) = table_get(&t, 1, 16.0, "a")
    (u16 s2, bool _) = table_get(&t, 1, 15.5, "a")
    (u16 s3, bool _) = table_get(&t, 2, 16.0, "a")
    ok = #expect(s1 == 2 && s2 == 3 && s3 == 4, "three slots ", s1, s2, s3) && ok
    // A prefix is a different key.
    ok = #expect(table_put(&t, 1, 16.0, "ab", 5), "put ab") && ok
    (u16 sab, bool _) = table_get(&t, 1, 16.0, "ab")
    (u16 s1b, bool _) = table_get(&t, 1, 16.0, "a")
    ok = #expect(sab == 5 && s1b == 2, "prefix apart") && ok
    // Putting an existing key replaces its slot and adds no entry.
    i32 before = table_count(&t)
    ok = #expect(table_put(&t, 1, 16.0, "ab", 6) && table_count(&t) == before, "replace") && ok

    // Grow well past the initial capacity: 3000 two-byte keys. At three
    // quarters full the array doubles, so 3004 keys need 4096 entries.
    [2]char8 k
    for i in 0..<3000:
        k[0] = char8(u8(i % 200 + 32))
        k[1] = char8(u8(i / 200 + 32))
        if !table_put(&t, 9, 16.0, string8(k[0..<2]), u16(i)):
            ok = #expect(false, "put ", i) && ok
    ok = #expect(table_count(&t) == 3004, "count ", table_count(&t)) && ok
    ok = #expect(table_capacity(&t) == 4096, "grew to ", table_capacity(&t)) && ok
    i32 wrong = 0
    for i in 0..<3000:
        k[0] = char8(u8(i % 200 + 32))
        k[1] = char8(u8(i / 200 + 32))
        (u16 v, bool f) = table_get(&t, 9, 16.0, string8(k[0..<2]))
        if !f || v != u16(i):
            wrong = wrong + 1
    ok = #expect(wrong == 0, "lookups after growth, wrong: ", wrong) && ok
    // The early keys survived the rehash.
    (u16 sa2, bool fa2) = table_get(&t, 1, 16.0, "a")
    ok = #expect(fa2 && sa2 == 2, "a after growth") && ok
    // The bytes were copied: a key built in a buffer that is then changed
    // still finds its own entry, and not the buffer's new contents.
    k[0] = 'Q'
    k[1] = 'Q'
    ok = #expect(table_put(&t, 3, 16.0, string8(k[0..<2]), 77), "put QQ") && ok
    k[0] = 'R'
    (u16 _, bool frq) = table_get(&t, 3, 16.0, string8(k[0..<2]))
    (u16 sqq, bool fqq) = table_get(&t, 3, 16.0, "QQ")
    ok = #expect(!frq && fqq && sqq == 77, "key owns its bytes") && ok

    table_free(&t)
    ok = #expect(table_capacity(&t) == 0 && !table_put(&t, 1, 16.0, "a", 1), "freed refuses") && ok
    (u16 _, bool ff) = table_get(&t, 1, 16.0, "a")
    ok = #expect(!ff, "freed misses") && ok
    table_free(&t)

    // The minimum size rule.
    ok = #expect(table_size_for(0) == 16 && table_size_for(17) == 32 && table_size_for(64) == 64, "sizes") && ok

    if ok: return 0
    return 1
