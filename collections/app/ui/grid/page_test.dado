@test
// The page ladder, growth that keeps every slot where it was, the prewarmed
// set, and the upload readers before `up` — all with no face and no GPU.
package grid

// A distinct two-byte ASCII key for `i` below 94 * 94 = 8836: both bytes
// 33..126, so no key begins with a control and none collapses onto U+FFFD's
// slot.
private string8 key_for([]char8 b, i32 i):
    b[0] = char8(u8(33 + i % 94))
    b[1] = char8(u8(33 + i / 94))
    return string8(b[0..<2])

i32 test():
    bool ok = true

    // ── The ladder ──
    // 8 x 16: a 128 square is 16 x 8 = 128 slots, short of 384; a 256 square
    // is 32 x 16 = 512. 16 x 32: 256 holds 16 x 8 = 128, 512 holds 32 x 16 =
    // 512. 17 x 33 (DejaVu Sans Mono at a requested 32 px): 512 holds 30 x 15
    // = 450.
    ok = #expect(page_width_for(8, 16, MIN_SLOTS, 1024) == 256, "8x16 width ", page_width_for(8, 16, MIN_SLOTS, 1024)) && ok
    ok = #expect(page_width_for(16, 32, MIN_SLOTS, 1024) == 512, "16x32 width") && ok
    ok = #expect(page_width_for(17, 33, MIN_SLOTS, 1024) == 512, "17x33 width") && ok
    ok = #expect(page_capacity(256, 256, 8, 16) == 512 && page_capacity(512, 512, 17, 33) == 450, "first rungs") && ok
    // Held at the cap, and refused for no cell.
    ok = #expect(page_width_for(8, 16, 100000, 1024) == 1024, "width capped") && ok
    ok = #expect(page_width_for(8, 16, MIN_SLOTS, 128) == 128, "device cap") && ok
    ok = #expect(page_width_for(0, 16, MIN_SLOTS, 1024) == 0, "no cell") && ok
    // The height cap is one 1024 square's texels over the width, and the
    // device's side when that is less.
    ok = #expect(page_height_cap(256, 1024, 0) == 4096, "256 wide cap") && ok
    ok = #expect(page_height_cap(512, 1024, 0) == 2048, "512 wide cap") && ok
    ok = #expect(page_height_cap(256, 1024, 2048) == 2048, "device-held cap") && ok
    ok = #expect(page_height_cap(0, 1024, 0) == 0, "no width") && ok
    // Rungs double and stop at the cap.
    i32 h = 256
    i32 rungs = 0
    for page_grown(h, 4096) > h:
        h = page_grown(h, 4096)
        rungs = rungs + 1
    ok = #expect(h == 4096 && rungs == 4, "256 -> 4096 in ", rungs) && ok
    ok = #expect(page_grown(1024, 1536) == 1536, "held at a cap that is not a rung") && ok
    ok = #expect(page_grown(4096, 4096) == 4096, "top") && ok

    // ── Growth ──
    // An 8 x 16 atlas starts 256 square: 64 KiB, 32 across, 512 slots.
    Atlas a = atlas_make(8, 16, 16.0, 1)
    ok = #expect(a.page.w == 256 && a.page.h == 256 && a.page.max_h == 4096, "start ", a.page.w, "x", a.page.h) && ok
    ok = #expect(#len(a.page.pixels) == 65536 && a.slots.across == 32 && a.slots.capacity == 512, "start size") && ok
    [2]Face nothing
    []Face faces = nothing[0..<0]
    [2]char8 kb
    // Fill all 510 free slots: no growth yet.
    for i in 0..<510:
        _ = atlas_slot(&a, faces, key_for(kb[:], i32(i)), 1)
    ok = #expect(a.page.grows == 0 && slots_used(&a.slots) == 512, "full, not grown") && ok
    // Mark slot 300's origin texel and remember where it is.
    (i32 x0, i32 y0, bool on0) = slot_origin(300, a.slots.across, a.slots.capacity, 8, 16)
    i64 at0 = i64(y0) * i64(a.page.w) + i64(x0)
    a.page.pixels[at0] = 77
    // The 511th cluster grows the page to 256 x 512 and takes slot 512.
    u16 s512 = atlas_slot(&a, faces, key_for(kb[:], 510), 1)
    ok = #expect(s512 == 512 && a.page.grows == 1 && a.page.h == 512 && a.slots.capacity == 1024, "grew ", s512, " ", a.page.h) && ok
    ok = #expect(a.slots.across == 32, "across unchanged") && ok
    (i32 x1, i32 y1, bool on1) = slot_origin(300, a.slots.across, a.slots.capacity, 8, 16)
    ok = #expect(on0 && on1 && x1 == x0 && y1 == y0, "slot 300 stays at ", x1, ",", y1) && ok
    ok = #expect(a.page.pixels[at0] == 77, "its ink stays") && ok
    // The new rows are zero, and slot 512 is the first slot of row 16.
    i64 tail = 0
    for i in 65536..<131072:
        tail = tail + i64(a.page.pixels[i])
    ok = #expect(tail == 0 && #len(a.page.pixels) == 131072, "new rows zero") && ok
    (i32 x2, i32 y2, bool _) = slot_origin(512, a.slots.across, a.slots.capacity, 8, 16)
    ok = #expect(x2 == 0 && y2 == 256, "slot 512 at ", x2, ",", y2) && ok
    // Old keys still answer their slots.
    (u16 s7, bool f7) = table_get(&a.table, a.chain, a.px, key_for(kb[:], 5))
    ok = #expect(f7 && s7 == 7, "key 5 still in slot 7 ", s7) && ok
    // A wide pair that would start on the last slot of the page grows it too:
    // fill up to 1023, then a pair.
    for i in 511..<1021:
        _ = atlas_slot(&a, faces, key_for(kb[:], i32(i)), 1)
    ok = #expect(slots_used(&a.slots) == 1023 && a.page.h == 512, "one slot left ", slots_used(&a.slots)) && ok
    u16 pair = atlas_slot(&a, faces, "\xE6\x97\xA5", 2)
    ok = #expect(pair == 1024 && a.page.h == 1024 && a.slots.spare == 1023, "pair on the new rung ", pair) && ok
    // Climb to the top: 8192 slots at 256 x 4096 (1 MiB), four rungs, then
    // overflow. Slots up to 1022 and the pair 1024, 1025 are taken; 1023
    // waits as the spare and the next single takes it.
    i32 i = 1021
    for a.overflows == 0 && i < 8836:
        _ = atlas_slot(&a, faces, key_for(kb[:], i), 1)
        i = i + 1
    ok = #expect(a.page.grows == 4 && a.page.h == 4096 && a.slots.capacity == 8192, "top ", a.page.grows, " ", a.page.h) && ok
    ok = #expect(#len(a.page.pixels) == 1048576, "1 MiB at the top") && ok
    ok = #expect(a.overflows == 1 && slots_used(&a.slots) == 8192, "overflow at the top ", slots_used(&a.slots)) && ok
    ok = #expect(!atlas_grow(&a), "no rung above the top") && ok
    atlas_free(&a)
    ok = #expect(a.page.w == 0 && a.page.h == 0 && !atlas_grow(&a), "freed") && ok

    // A device limit of 1024 caps the ladder at 256 x 1024: 2048 slots.
    Atlas lim = atlas_make(8, 16, 16.0, 1, 1024)
    ok = #expect(lim.page.w == 256 && lim.page.max_h == 1024, "limited ", lim.page.max_h) && ok
    atlas_free(&lim)

    // ── The prewarmed set ──
    ok = #expect(prewarm_count() == 95, "95 printable ASCII") && ok
    ok = #expect(prewarm_code_point(0) == 0x20 && prewarm_code_point(94) == 0x7E, "ends") && ok
    ok = #expect(prewarm_code_point(95) == -1 && prewarm_code_point(-1) == -1, "off the ends") && ok
    i32 printable = 0
    for k in 0..<prewarm_count():
        i32 cp = prewarm_code_point(i32(k))
        if cp >= 0x20 && cp < 0x7F:
            printable = printable + 1
    ok = #expect(printable == 95, "all printable") && ok
    // Prewarming a fresh 8 x 16 atlas: 95 resident in slots 2..96, no growth,
    // and the one dirty page still waiting for its first upload.
    Atlas w = atlas_make(8, 16, 16.0, 1)
    ok = #expect(atlas_prewarm(&w, faces) == 95, "prewarm answers 95") && ok
    ok = #expect(atlas_resident(&w) == 95 && slots_used(&w.slots) == 97 && w.page.grows == 0, "resident ", atlas_resident(&w)) && ok
    (u16 sp, bool fsp) = table_get(&w.table, w.chain, w.px, " ")
    (u16 st, bool fst) = table_get(&w.table, w.chain, w.px, "~")
    ok = #expect(fsp && sp == 2 && fst && st == 96, "space in 2, tilde in 96") && ok
    // Typing any of them again takes nothing.
    ok = #expect(atlas_slot(&w, faces, "q", 1) != NOTDEF_SLOT && slots_used(&w.slots) == 97, "typing is a hit") && ok
    ok = #expect(w.page.dirty, "first upload pending") && ok
    atlas_free(&w)

    // ── Readers before `up` ──
    Stats s = stats()
    ok = #expect(s.frame_page_upload_bytes == 0 && s.page_grows == 0 && s.page_uploads == 0, "stats before up") && ok
    ok = #expect(atlas_page_w() == 0 && atlas_page_h() == 0 && atlas_page_max_h() == 0, "page readers before up") && ok

    if ok: return 0
    return 1
