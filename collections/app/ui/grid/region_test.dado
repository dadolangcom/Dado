@test
// Scrolling regions with no GPU: making and freeing ids, the buffer's shape
// (the rect plus one spare row), writes through a region in screen cells and
// the clip rule for its spare row, `region_scroll_rows`' arithmetic, the
// dirty flag the upload keys on, and every call with a bad id. The cell is set
// by hand to 8 x 16 and the allocator captured by hand, as `layers_test`
// does; nothing here calls sokol.
package grid

import "app:ui/cell"

private void reset():
    release_regions()
    for i in 0..<MAX_LAYERS:
        release_layer(i32(i))
    g_nlayers = 1
    g_target = BASE
    g_cols = 0
    g_rows = 0
    g_cw = 0
    g_ch = 0
    g_have_alloc = false
    g_clipping = false

private cell.Cell mark(i32 slot):
    cell.Cell c = (u16(slot), 0, [200, 200, 200, 255], [10, 10, 10, 255])
    return c

i32 test():
    bool ok = true
    [4]u8 fg = [230, 230, 230, 255]
    [4]u8 bg = [20, 30, 40, 255]

    // ── Before the allocator is captured nothing is made ──
    ok = #expect(region_make(BASE) == -1 && region_count() == 0, "no allocator, no region") && ok

    g_cw = 8
    g_ch = 16
    g_alloc = #default
    g_have_alloc = true
    // 80 x 96 px of 8 x 16 cells: 10 x 6.
    ok = #expect(begin(80, 96) && cols() == 10 && rows() == 6, "10 x 6") && ok

    ok = #expect(region_make(-1) == -1 && region_make(1) == -1 && region_make(MAX_LAYERS) == -1, "no such layer") && ok
    i32 id = region_make(BASE)
    ok = #expect(id == 0 && region_valid(id) && region_count() == 1 && region_layer(id) == BASE, "made ", id) && ok
    ok = #expect(cell.is_empty(region_rect(id)) && g_regions[id].cells == nil, "starts empty") && ok

    // ── The buffer: rect cols x (rect rows + 1) ──
    cell.CellRect r = cell.rect(2, 1, 5, 3)
    ok = #expect(region_set_rect(id, r), "a new rect answers true") && ok
    ok = #expect(!region_set_rect(id, r), "the same rect answers false") && ok
    ok = #expect(region_rect(id) == r && #len(g_regions[id].cells) == 5 * 4, "5 x (3 + 1) = 20 cells") && ok
    ok = #expect(region_extent(r) == cell.rect(2, 1, 5, 4), "the extent is the rect and the spare row") && ok
    ok = #expect(cell.is_empty(region_extent(cell.rect(2, 1, 0, 3))), "an empty rect has no extent") && ok

    // ── Writes in screen cells ──
    target_region(id)
    ok = #expect(targeted_region() == id, "targeted") && ok
    i32 w0 = g_cells_written
    put(2, 1, mark(10))
    put(6, 4, mark(11))
    put(7, 1, mark(12))
    put(1, 1, mark(12))
    put(2, 0, mark(12))
    put(2, 5, mark(12))
    ok = #expect(g_cells_written - w0 == 2, "two inside the extent: ", g_cells_written - w0) && ok
    ok = #expect(region_cell_at(id, 2, 1) == mark(10) && region_cell_at(id, 6, 4) == mark(11), "the top-left and the spare row's last") && ok
    ok = #expect(g_regions[id].cells[0] == mark(10) && g_regions[id].cells[19] == mark(11), "buffer index = (row - rect.row) * cols + (col - rect.col)") && ok
    ok = #expect(cell_at(2, 1) == cell.blank() && !layer_touched(BASE), "the layer under it is untouched") && ok
    ok = #expect(region_cell_at(id, 7, 1) == cell.blank() && region_cell_at(id, 2, 5) == cell.blank(), "outside reads blank") && ok

    // `fill` is held to the extent: all 20 cells, whatever it asks for.
    w0 = g_cells_written
    fill(cell.rect(0, 0, 10, 10), fg, bg)
    ok = #expect(g_cells_written - w0 == 20, "fill covers the extent: ", g_cells_written - w0) && ok
    ok = #expect(region_cell_at(id, 4, 4).bg == bg && cell_at(0, 0) == cell.blank(), "the spare row filled; the screen not") && ok

    // `text` too: from column 0, only columns 2..6 land.
    w0 = g_cells_written
    i32 used = text(0, 2, "abcdefghij", 10, fg, bg)
    ok = #expect(used == 10 && g_cells_written - w0 == 5, "text laid out 10, kept 5: ", g_cells_written - w0) && ok

    // ── The clip and the spare row ──
    // A clip whose bottom is the rect's admits the spare row.
    ok = #expect(region_clip_for(r, r) == cell.rect(2, 1, 5, 4), "the rect as clip grows by a row") && ok
    ok = #expect(region_clip_for(cell.rect(0, 0, 10, 4), r) == cell.rect(0, 0, 10, 5), "any clip ending on the rect's last row grows") && ok
    ok = #expect(region_clip_for(cell.rect(2, 1, 5, 2), r) == cell.rect(2, 1, 5, 2), "a clip ending higher does not") && ok
    ok = #expect(region_clip_for(cell.rect(0, 0, 10, 6), r) == cell.rect(0, 0, 10, 6), "a clip already past the spare row is as it was") && ok
    clip(r)
    w0 = g_cells_written
    put(3, 4, mark(20))
    ok = #expect(g_cells_written - w0 == 1 && region_cell_at(id, 3, 4) == mark(20), "clip = rect still writes the spare row") && ok
    clip(cell.rect(2, 1, 5, 2))
    w0 = g_cells_written
    put(3, 3, mark(21))
    put(3, 4, mark(21))
    put(3, 2, mark(22))
    ok = #expect(g_cells_written - w0 == 1 && region_cell_at(id, 3, 2) == mark(22), "a shorter clip holds rows 3 and 4 out") && ok
    unclip()

    // The screen's edge does not clip a region: its spare row may be below it.
    i32 low = region_make(BASE)
    ok = #expect(low == 1 && region_set_rect(low, cell.rect(0, 4, 3, 2)), "a region on the last two rows") && ok
    target_region(low)
    put(1, 6, mark(30))
    ok = #expect(region_cell_at(low, 1, 6) == mark(30), "row 6 is off the 6-row screen and still the spare row") && ok

    // ── target(layer) and begin point back at a layer ──
    target(BASE)
    ok = #expect(targeted_region() == -1, "target clears the region") && ok
    put(0, 0, mark(40))
    ok = #expect(cell_at(0, 0) == mark(40), "the base again") && ok
    target_region(id)
    ok = #expect(!begin(80, 96) && targeted_region() == -1 && targeted() == BASE, "begin clears it too") && ok

    // ── region_scroll_rows ──
    // Rows 0..3 of the buffer (screen rows 1..4) marked 10 + row.
    target_region(id)
    for y in 0..<4:
        for x in 0..<5:
            put(2 + i32(x), 1 + i32(y), mark(10 + i32(y)))
    // 5 cols x 12 bytes = 60 bytes a row.
    region_scroll_rows(id, 1)
    ok = #expect(region_cell_at(id, 2, 1).slot == 11 && region_cell_at(id, 6, 2).slot == 12, "up 1: rows 1, 2 moved up") && ok
    ok = #expect(region_cell_at(id, 4, 3).slot == 13, "up 1: the spare row moved into the rect") && ok
    ok = #expect(region_cell_at(id, 2, 4) == cell.blank() && region_cell_at(id, 6, 4) == cell.blank(), "up 1: the spare row exposed blank") && ok
    RegionStats rs = region_stats(id)
    ok = #expect(rs.rows_shifted == 1 && rs.bytes_moved == 3 * 60, "1 row, 3 rows x 60 bytes moved: ", rs.bytes_moved) && ok
    region_scroll_rows(id, -2)
    ok = #expect(region_cell_at(id, 2, 1) == cell.blank() && region_cell_at(id, 6, 2) == cell.blank(), "down 2: the top two rows exposed blank") && ok
    ok = #expect(region_cell_at(id, 3, 3).slot == 11 && region_cell_at(id, 3, 4).slot == 12, "down 2: rows moved to the bottom") && ok
    rs = region_stats(id)
    ok = #expect(rs.rows_shifted == 3 && rs.bytes_moved == 180 + 2 * 60, "2 more rows, 2 x 60 bytes more: ", rs.bytes_moved) && ok
    region_scroll_rows(id, 0)
    ok = #expect(region_stats(id).rows_shifted == 3, "0 shifts nothing") && ok
    // |n| at rows + 1 or past clears it all, moving nothing; counted as 4.
    region_scroll_rows(id, 4)
    bool clear = true
    for y in 1..<5:
        for x in 2..<7:
            clear = clear && region_cell_at(id, i32(x), i32(y)) == cell.blank()
    ok = #expect(clear, "4 = rows + 1 clears every row") && ok
    region_scroll_rows(id, -2147483647)
    rs = region_stats(id)
    ok = #expect(rs.rows_shifted == 3 + 4 + 4 && rs.bytes_moved == 300, "clears count rows + 1, move nothing: ", rs.rows_shifted) && ok
    ok = #expect(stats().region_rows_shifted == 11, "the frame's count: ", stats().region_rows_shifted) && ok
    ok = #expect(begin(80, 96) == false && stats().region_rows_shifted == 0, "begin zeroes the frame's count") && ok

    // ── The dirty flag the upload keys on ──
    // `render`'s upload clears it; clear it by hand where that would.
    g_regions[id].dirty = false
    region_set_offset(id, 5)
    ok = #expect(!region_stats(id).dirty && region_offset(id) == 5, "an offset is a uniform: not dirty") && ok
    region_set_offset(id, -3)
    ok = #expect(region_offset(id) == 0, "held at 0") && ok
    region_set_offset(id, 99)
    ok = #expect(region_offset(id) == 15, "held at cell_h - 1") && ok
    target_region(id)
    put(0, 0, mark(50))
    ok = #expect(!region_stats(id).dirty, "a write clipped away is not a change") && ok
    put(2, 1, mark(50))
    ok = #expect(region_stats(id).dirty, "a write is") && ok
    g_regions[id].dirty = false
    region_scroll_rows(id, 1)
    ok = #expect(region_stats(id).dirty, "a scroll is") && ok
    g_regions[id].dirty = false
    ok = #expect(!region_set_rect(id, r) && !region_stats(id).dirty, "the same rect is not") && ok
    ok = #expect(region_set_rect(id, cell.rect(1, 1, 8, 4)) && region_stats(id).dirty, "a new rect is") && ok
    ok = #expect(#len(g_regions[id].cells) == 8 * 5 && region_cell_at(id, 2, 1) == cell.blank(), "remade blank, 8 x 5") && ok

    // Empty and oversized rects leave no cells and take no writes.
    ok = #expect(region_set_rect(id, cell.rect(0, 0, 0, 0)) && g_regions[id].cells == nil, "emptied") && ok
    ok = #expect(!region_set_rect(id, cell.rect(3, 3, -1, 2)), "any empty rect is the same empty rect") && ok
    ok = #expect(!region_set_rect(id, cell.rect(0, 0, MAX_REGION_SIDE + 1, 2)), "too wide reads as empty") && ok
    w0 = g_cells_written
    fill(cell.rect(0, 0, 10, 6), fg, bg)
    region_scroll_rows(id, 1)
    ok = #expect(g_cells_written == w0, "no cells, no writes") && ok

    // ── The scissor, in framebuffer pixels ──
    (i32 sx, i32 sy, i32 sw, i32 sh) = region_scissor(r, 8, 16, 80, 96)
    ok = #expect(sx == 16 && sy == 16 && sw == 40 && sh == 48, "(2,1) 5 x 3 cells is (16,16) 40 x 48 px") && ok
    (sx, sy, sw, sh) = region_scissor(cell.rect(-1, 5, 3, 3), 8, 16, 80, 96)
    ok = #expect(sx == 0 && sy == 80 && sw == 16 && sh == 16, "cut to the framebuffer: ", sx, ",", sy, " ", sw, "x", sh) && ok
    (sx, sy, sw, sh) = region_scissor(cell.rect(20, 0, 3, 3), 8, 16, 80, 96)
    ok = #expect(sw == 0 && sh == 0, "wholly off it") && ok
    (sx, sy, sw, sh) = region_scissor(cell.rect(2147483000, 0, 4000, 3), 8, 16, 80, 96)
    ok = #expect(sw == 0, "far off it, with no overflow") && ok

    // ── Bad ids ──
    w0 = g_cells_written
    region_free(-1)
    region_free(99)
    region_set_offset(99, 3)
    region_scroll_rows(-1, 1)
    ok = #expect(!region_valid(99) && !region_valid(-1) && !region_set_rect(99, r), "bad ids answer nothing") && ok
    ok = #expect(cell.is_empty(region_rect(99)) && region_layer(-5) == -1 && region_offset(99) == 0, "and read empty") && ok
    ok = #expect(region_cell_at(99, 0, 0) == cell.blank() && region_stats(99).uploads == 0, "and blank") && ok
    target_region(99)
    put(0, 0, mark(60))
    fill(cell.rect(0, 0, 10, 6), fg, bg)
    _ = text(0, 0, "abc", 3, fg, bg)
    ok = #expect(g_cells_written == w0 && cell_at(0, 0) == mark(40), "a bad target writes nowhere") && ok

    // ── Freeing, reuse, creation order, growth ──
    target_region(low)
    region_free(low)
    ok = #expect(!region_valid(low) && region_count() == 1, "freed") && ok
    put(1, 5, mark(61))
    ok = #expect(g_cells_written == w0, "a freed target writes nowhere") && ok
    set_layers(3)
    i32 a = region_make(2)
    i32 b = region_make(1)
    i32 c = region_make(BASE)
    ok = #expect(a == 1 && b == 2 && c == 3, "ids: the freed 1, then new: ", a, " ", b, " ", c) && ok
    // Freed while the writers aim at it: the aim goes to no region, so the
    // id's next owner is not written through the stale aim.
    target_region(b)
    region_free(b)
    ok = #expect(targeted_region() == -1, "freeing the targeted region drops the aim, got ", targeted_region()) && ok
    i32 d = region_make(1)
    ok = #expect(d == b, "the freed id is reused") && ok
    ok = #expect(region_set_rect(d, cell.rect(0, 0, 3, 2)), "the new owner has cells") && ok
    i32 wd = g_cells_written
    put(1, 1, mark(55))
    ok = #expect(g_cells_written == wd && region_cell_at(d, 1, 1) != mark(55),
                 "a write through the stale aim lands nowhere, not in the id's new region") && ok
    ok = #expect(region_set_rect(d, cell.rect(0, 0, 0, 0)), "back to empty") && ok
    target(BASE)
    ok = #expect(d == b && region_rect(d) == cell.rect(0, 0, 0, 0) && region_stats(d).rows_shifted == 0, "a reused id starts fresh") && ok
    ok = #expect(g_region_live == 4 && g_region_order[0] == id && g_region_order[1] == a && g_region_order[2] == c && g_region_order[3] == d, "drawn in creation order") && ok
    for i in 0..<20:
        _ = region_make(BASE)
    ok = #expect(region_count() == 24 && region_valid(23) && region_capacity() >= 24, "the table grows: ", region_capacity()) && ok

    // ── A resize keeps regions; the rect is the caller's ──
    ok = #expect(region_set_rect(a, cell.rect(0, 0, 4, 2)), "a on layer 2") && ok
    target_region(a)
    put(1, 1, mark(70))
    ok = #expect(begin(160, 96) && cols() == 20, "resize") && ok
    ok = #expect(region_cell_at(a, 1, 1) == mark(70) && region_rect(a) == cell.rect(0, 0, 4, 2), "kept through the resize") && ok
    // Dropping its layer keeps it, not drawn.
    set_layers(1)
    ok = #expect(region_valid(a) && region_layer(a) == 2, "kept past its layer") && ok

    Stats st = stats()
    ok = #expect(st.region_draws == 0 && st.region_uploads == 0 && st.region_upload_bytes == 0, "no render, no draws") && ok

    reset()
    ok = #expect(region_count() == 0 && !region_valid(0), "down's release gives every region back") && ok
    if ok:
        return 0
    return 1
