@test
// Which cells a string occupies, with no face: tabs, wide clusters, marks,
// controls and the column limit.
package grid

import "app:ui/cell"

private bool span(Span s, i32 at, i32 end, i32 col, i32 cols, SpanKind kind):
    return s.at == at && s.end == end && s.col == col && s.cols == cols && s.kind == kind

i32 test():
    bool ok = true
    [16]Span out

    ok = #expect(layout("ab", 0, 0, 10, out[:]) == 2, "ab") && ok
    ok = #expect(span(out[0], 0, 1, 0, 1, SpanKind.Glyph) && span(out[1], 1, 2, 1, 1, SpanKind.Glyph), "ab spans") && ok

    // A tab from column 1 reaches the next stop: TAB_COLUMNS - 1 blank columns.
    ok = #expect(layout("a\tb", 0, 0, 20, out[:]) == 3, "a tab b") && ok
    i32 tw = cell.TAB_COLUMNS - 1
    ok = #expect(span(out[1], 1, 2, 1, tw, SpanKind.Blank), "tab ", out[1].col, " ", out[1].cols) && ok
    ok = #expect(span(out[2], 2, 3, cell.TAB_COLUMNS, 1, SpanKind.Glyph), "after the tab") && ok
    // A tab cut short by the limit.
    ok = #expect(layout("\tx", 0, 0, 2, out[:]) == 1 && span(out[0], 0, 1, 0, 2, SpanKind.Blank), "tab cut") && ok

    // Wide clusters (U+65E5, U+672C: three bytes, two columns each). With a
    // limit of 3 the second would straddle it and is one blank column.
    string8 wide = "\xE6\x97\xA5\xE6\x9C\xAC"
    ok = #expect(layout(wide, 0, 0, 3, out[:]) == 2, "wide count") && ok
    ok = #expect(span(out[0], 0, 3, 0, 2, SpanKind.Glyph), "wide glyph") && ok
    ok = #expect(span(out[1], 3, 6, 2, 1, SpanKind.Blank), "straddle blank") && ok
    ok = #expect(layout(wide, 0, 0, 4, out[:]) == 2 && out[1].kind == SpanKind.Glyph && out[1].cols == 2, "both fit") && ok

    // e + U+0301 is one cluster: three bytes, one column.
    ok = #expect(layout("e\xCC\x81x", 0, 0, 10, out[:]) == 2, "marks ride") && ok
    ok = #expect(span(out[0], 0, 3, 0, 1, SpanKind.Glyph) && span(out[1], 3, 4, 1, 1, SpanKind.Glyph), "e acute x") && ok
    // Hebrew alef + qamats (U+05D0 U+05B8): one cluster, one column.
    ok = #expect(layout("\xD7\x90\xD6\xB8", 0, 0, 10, out[:]) == 1 && span(out[0], 0, 4, 0, 1, SpanKind.Glyph), "nikud") && ok

    // A control is a one-column glyph (drawn as U+FFFD).
    ok = #expect(layout("a\x01b", 0, 0, 10, out[:]) == 3 && span(out[1], 1, 2, 1, 1, SpanKind.Glyph), "control") && ok

    // The limit, and an out slice that fills: resume from the last span.
    ok = #expect(layout("abcdef", 0, 0, 3, out[:]) == 3, "limit 3") && ok
    [2]Span two
    ok = #expect(layout("abcde", 0, 0, 10, two[:]) == 2, "out full") && ok
    i32 at = two[1].end
    i32 col = two[1].col + two[1].cols
    ok = #expect(layout("abcde", at, col, 10, two[:]) == 2 && two[0].at == 2 && two[0].col == 2, "resume") && ok

    // Refusals: nothing to lay out answers zero spans.
    ok = #expect(layout("", 0, 0, 10, out[:]) == 0, "empty") && ok
    ok = #expect(layout("abc", 0, 0, 0, out[:]) == 0, "zero limit") && ok
    ok = #expect(layout("abc", 0, 0, -4, out[:]) == 0, "negative limit") && ok
    ok = #expect(layout("abc", 9, 0, 10, out[:]) == 0, "past the end") && ok
    ok = #expect(layout("abc", 0, 0, 10, out[0..<0]) == 0, "no room") && ok
    ok = #expect(layout("abc", -3, -1, 10, out[:]) == 3 && out[0].at == 0 && out[0].col == 0, "negatives read as zero") && ok

    if ok: return 0
    return 1
