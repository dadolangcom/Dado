@test
// The atlas with no face: slot arithmetic, the slot allocator, the clipped
// copy, and residency through `atlas_slot` with an empty face chain (which
// allocates slots and inks nothing).
package grid

i32 test():
    bool ok = true

    // An 8 x 16 cell on a 1024 square page: 1024 / 8 = 128 slots across,
    // 1024 / 16 = 64 rows down, 128 * 64 = 8192 slots; on 256 x 4096, 32
    // across and 256 down, the same 8192.
    ok = #expect(slots_across(1024, 8) == 128, "across") && ok
    ok = #expect(slots_down(1024, 16) == 64, "down") && ok
    ok = #expect(page_capacity(1024, 1024, 8, 16) == 8192, "capacity ", page_capacity(1024, 1024, 8, 16)) && ok
    ok = #expect(page_capacity(256, 4096, 8, 16) == 8192, "tall capacity") && ok
    // The u16 cap: a 1-pixel cell on 1024 x 1024 would be 1 048 576 slots.
    ok = #expect(page_capacity(1024, 1024, 1, 1) == 65536, "u16 cap") && ok
    // A 9-pixel cell leaves a 1024 - 113 * 9 = 7-pixel strip unused.
    ok = #expect(slots_across(1024, 9) == 113, "9 px across") && ok
    ok = #expect(page_capacity(1024, 1024, 0, 16) == 0 && page_capacity(0, 1024, 8, 16) == 0, "empty page") && ok

    // Slot 130 is column 130 % 128 = 2, row 130 / 128 = 1: pixel (16, 16).
    (i32 x, i32 y, bool on) = slot_origin(130, 128, 8192, 8, 16)
    ok = #expect(on && x == 16 && y == 16, "slot 130 at ", x, ",", y) && ok
    (i32 lx, i32 ly, bool lon) = slot_origin(8191, 128, 8192, 8, 16)
    ok = #expect(lon && lx == 127 * 8 && ly == 63 * 16, "last slot") && ok
    (i32 _, i32 _, bool off) = slot_origin(8192, 128, 8192, 8, 16)
    ok = #expect(!off, "past the page") && ok
    (i32 _, i32 _, bool neg) = slot_origin(-1, 128, 8192, 8, 16)
    ok = #expect(!neg, "negative slot") && ok

    // The allocator on a page 4 across and 3 down (12 slots; 0 and 1 are
    // taken). One-column clusters take slots in order.
    Slots s = slots_make(4, 12)
    ok = #expect(slots_take(&s, 1) == 2, "first single is 2") && ok
    // A pair from slot 3 would wrap (3 is the last of row 0), so 3 becomes the
    // spare and the pair is 4, 5 — both on page row 1.
    i32 p = slots_take(&s, 2)
    ok = #expect(p == 4 && s.spare == 3, "pair skips the row end ", p) && ok
    ok = #expect(slots_used(&s) == 5, "used with a spare waiting ", slots_used(&s)) && ok
    // The next single fills the spare.
    ok = #expect(slots_take(&s, 1) == 3 && s.spare == -1, "spare reused") && ok
    // 6, 7 are on one row: no skip.
    ok = #expect(slots_take(&s, 2) == 6, "pair 6") && ok
    // Row 2 is 8..11. A pair at 8, then a single at 10, then a pair would
    // start at 11 (the row's end) and there is no row after it: full.
    ok = #expect(slots_take(&s, 2) == 8, "pair 8") && ok
    ok = #expect(slots_take(&s, 1) == 10, "single 10") && ok
    ok = #expect(slots_take(&s, 2) == -1, "no pair past the page") && ok
    // Slot 11 was set aside as the spare, so one more single fits, then none.
    ok = #expect(slots_take(&s, 1) == 11, "last single ", s.spare) && ok
    ok = #expect(slots_take(&s, 1) == -1, "full") && ok
    // A page one slot across holds no pair at all.
    Slots narrow = slots_make(1, 12)
    ok = #expect(slots_take(&narrow, 2) == -1, "no pair on a 1-wide page") && ok
    Slots none = slots_make(0, 0)
    ok = #expect(slots_take(&none, 1) == -1, "no page") && ok

    // The clipped copy: a 4 x 4 page, a 2 x 2 rectangle at (2, 2), a 3 x 2
    // box of full coverage placed one pixel left of the rectangle. Column -1
    // falls outside on both rows: 2 texels clipped, 4 copied.
    [16]u8 page
    [6]u8 box = [255, 255, 255, 255, 255, 255]
    i32 c = blend_clipped(page[:], 4, 4, 2, 2, 2, 2, box[:], 3, 2, -1, 0)
    ok = #expect(c == 2, "clipped ", c) && ok
    ok = #expect(page[10] == 255 && page[11] == 255 && page[14] == 255 && page[15] == 255, "copied") && ok
    ok = #expect(page[9] == 0 && page[0] == 0, "nothing outside the rectangle") && ok
    // Max-blend: a fainter box over the same texels leaves them at 255, and a
    // zero-coverage texel is neither copied nor counted.
    [2]u8 faint = [100, 0]
    ok = #expect(blend_clipped(page[:], 4, 4, 2, 2, 2, 2, faint[:], 2, 1, 0, 0) == 0, "faint") && ok
    ok = #expect(page[10] == 255, "max kept") && ok
    // A rectangle off the page clips everything with ink, and a short source
    // copies nothing.
    ok = #expect(blend_clipped(page[:], 4, 4, 3, 3, 2, 2, box[:], 3, 2, 0, 0) == 6, "off-page rectangle") && ok
    ok = #expect(blend_clipped(page[:], 4, 4, 0, 0, 2, 2, box[:], 4, 4, 0, 0) == 0, "short source") && ok

    // A 4 x 2 page (row-major, 4 bytes a row) and a 2 x 1 rectangle on its
    // second row: the texel at (1, 1) lands at 1 * 4 + 1 = 5; indexing rows
    // by the height would have put it at 1 * 2 + 1 = 3.
    [8]u8 wide_page
    [2]u8 dot = [9, 0]
    ok = #expect(blend_clipped(wide_page[:], 4, 2, 1, 1, 2, 1, dot[:], 1, 1, 0, 0) == 0, "non-square") && ok
    ok = #expect(wide_page[5] == 9, "non-square index") && ok

    // Residency with no faces. A 256 x 256 cell never reaches MIN_SLOTS, so
    // its page is the widest there is, PAGE_PX (1024) square: 4 x 4 slots,
    // 14 free, and the ladder has no rung above (1024 * 1024 / 1024 rows).
    Atlas a = atlas_make(256, 256, 16.0, 7)
    ok = #expect(a.page.w == 1024 && a.page.h == 1024 && a.page.max_h == 1024, "big cell page ", a.page.w, "x", a.page.h) && ok
    [2]Face nothing
    []Face faces = nothing[0..<0]
    u16 sa = atlas_slot(&a, faces, "a", 1)
    ok = #expect(sa == 2, "first cluster in slot 2 ", sa) && ok
    ok = #expect(atlas_slot(&a, faces, "a", 1) == sa, "resident") && ok
    ok = #expect(atlas_resident(&a) == 1, "one resident") && ok
    // Slot 3 is the last of row 0, so a wide cluster starts row 1 and 3 waits.
    u16 w = atlas_slot(&a, faces, "\xE6\x97\xA5", 2)
    ok = #expect(w == 4, "wide at 4 ", w) && ok
    ok = #expect(atlas_slot(&a, faces, "\xE6\x97\xA5", 2) == 4, "wide resident") && ok
    ok = #expect(atlas_slot(&a, faces, "b", 1) == 3, "spare taken") && ok
    // Tabs and empty clusters are the blank slot and take nothing.
    ok = #expect(atlas_slot(&a, faces, "\t", 1) == BLANK_SLOT, "tab blank") && ok
    ok = #expect(atlas_slot(&a, faces, "", 1) == BLANK_SLOT, "empty blank") && ok
    // Every control shares U+FFFD's one slot.
    u16 c1 = atlas_slot(&a, faces, "\x01", 1)
    ok = #expect(c1 == 6 && atlas_slot(&a, faces, "\x7F", 1) == c1, "controls share ", c1) && ok
    ok = #expect(atlas_resident(&a) == 4, "four resident ", atlas_resident(&a)) && ok
    // Fill the page: slots 7..15 are nine singles, then overflow.
    [2]char8 k
    for i in 0..<9:
        k[0] = char8(u8(65 + i))
        u16 got = atlas_slot(&a, faces, string8(k[0..<1]), 1)
        ok = #expect(got == u16(7 + i), "fill ", i, " -> ", got) && ok
    ok = #expect(atlas_slot(&a, faces, "z", 1) == NOTDEF_SLOT && a.overflows == 1, "overflow") && ok
    ok = #expect(a.page.grows == 0, "no rung to grow to") && ok
    ok = #expect(atlas_slot(&a, faces, "\xE6\x9C\xAC", 2) == NOTDEF_SLOT && a.overflows == 2, "wide overflow") && ok
    // What was resident stays resident.
    ok = #expect(atlas_slot(&a, faces, "a", 1) == sa, "still resident") && ok
    // A fresh page is dirty so that its blank texels go up once; with no
    // faces nothing was inked into it.
    ok = #expect(a.page.dirty, "fresh page awaits upload") && ok
    i64 inked = 0
    for i in 0..<#len(a.page.pixels):
        inked = inked + i64(a.page.pixels[i])
    ok = #expect(inked == 0, "no faces, no ink ", inked) && ok
    atlas_free(&a)
    ok = #expect(atlas_slot(&a, faces, "a", 1) == NOTDEF_SLOT, "freed atlas answers notdef") && ok
    atlas_free(&a)

    // The squeeze: a glyph that fits is left alone; one 9.74 px wide in an
    // 8 px cell is rasterised at 8 / 9.74 of its width.
    ok = #expect(squeeze_for(8, 8.0) == 1.0 && squeeze_for(16, 15.5) == 1.0, "fits") && ok
    ok = #expect(squeeze_for(8, 9.74) == 8.0 / 9.74, "squeezed") && ok
    ok = #expect(squeeze_for(0, 9.74) == 1.0 && squeeze_for(8, -1.0) == 1.0, "refused") && ok
    // The pen centres a glyph: an 8 px advance in 8 px is at 0, 15.47 in 16
    // is at round(0.265) = 0, 5 in 8 at round(1.5) = 2.
    ok = #expect(pen_x(8, 8.0) == 0 && pen_x(16, 15.47) == 0 && pen_x(8, 5.0) == 2, "pen") && ok

    // A cell too big for the page makes an atlas with no page.
    Atlas big = atlas_make(2048, 16, 16.0, 1)
    ok = #expect(big.page.pixels == nil && atlas_slot(&big, faces, "a", 1) == NOTDEF_SLOT, "no page") && ok
    atlas_free(&big)

    if ok: return 0
    return 1
