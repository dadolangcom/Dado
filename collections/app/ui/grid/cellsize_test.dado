@test
// The cell derivation, with no face: the numbers a face would hand over are
// written in as arguments.
package grid

private bool near(f32 a, f32 b, f32 eps):
    f32 d = a - b
    if d < 0.0:
        d = -d
    return d <= eps

i32 test():
    bool ok = true

    // DejaVu Sans Mono's '0' advance at some requested height: 8.39801 rounds
    // to 8, and 16 * 8 / 8.39801 = 15.2417 is the height whose advance is 8.
    (i32 cw, f32 px) = cell_size_for(16.0, 8.39801)
    ok = #expect(cw == 8, "cw ", cw) && ok
    ok = #expect(near(px, 15.2417, 0.001), "px ", px) && ok
    // The defining identity: the advance scales with the height, so at `px`
    // it is `cw` whole pixels.
    ok = #expect(near(8.39801 * px / 16.0, 8.0, 0.0001), "advance at px") && ok

    // Rounding goes up past the half: 8.6 is a 9-pixel cell, and the face is
    // grown to fit it.
    (i32 cw2, f32 px2) = cell_size_for(16.0, 8.6)
    ok = #expect(cw2 == 9 && near(px2, 16.0 * 9.0 / 8.6, 0.0001), "8.6 -> ", cw2, " ", px2) && ok
    (i32 cw3, f32 _) = cell_size_for(16.0, 8.5)
    ok = #expect(cw3 == 9, "8.5 rounds up ", cw3) && ok

    // An advance below half a pixel still makes a one-pixel cell.
    (i32 cw4, f32 px4) = cell_size_for(16.0, 0.3)
    ok = #expect(cw4 == 1 && near(px4, 16.0 / 0.3, 0.01), "tiny ", cw4, " ", px4) && ok

    // No advance: the requested height unchanged and a guessed cell.
    (i32 cw5, f32 px5) = cell_size_for(16.0, 0.0)
    ok = #expect(cw5 == 8 && px5 == 16.0, "adv 0 -> ", cw5, " ", px5) && ok
    (i32 cw6, f32 px6) = cell_size_for(16.0, -3.0)
    ok = #expect(cw6 == 8 && px6 == 16.0, "adv < 0") && ok
    f32 zero = 0.0
    (i32 cw7, f32 px7) = cell_size_for(16.0, zero / zero)
    ok = #expect(cw7 == 8 && px7 == 16.0, "adv NaN -> ", cw7, " ", px7) && ok
    // No requested height reads as 1.
    (i32 cw8, f32 px8) = cell_size_for(0.0, 0.0)
    ok = #expect(cw8 == 1 && px8 == 1.0, "nothing requested -> ", cw8, " ", px8) && ok

    // Height: ascent - descent + gap, ceiled, with the f32 noise forgiven.
    ok = #expect(cell_height_for(12.7584, -3.24161, 0.0) == 16, "16.00001 is 16 ", cell_height_for(12.7584, -3.24161, 0.0)) && ok
    ok = #expect(cell_height_for(12.0, -3.2, 0.0) == 16, "15.2 ceils to 16") && ok
    ok = #expect(cell_height_for(12.0, -3.0, 1.5) == 17, "gap counts") && ok
    ok = #expect(cell_height_for(0.0, 0.0, 0.0) == 1, "nothing is one row") && ok
    ok = #expect(cell_height_for(zero / zero, 0.0, 0.0) == 1, "NaN is one row") && ok

    // Baseline: round(ascent), inside the cell.
    ok = #expect(baseline_for(12.34, 16) == 12, "baseline 12.34") && ok
    ok = #expect(baseline_for(12.5, 16) == 13, "baseline 12.5") && ok
    ok = #expect(baseline_for(40.0, 16) == 16, "baseline held in the cell") && ok
    ok = #expect(baseline_for(-1.0, 16) == 0, "baseline of nothing") && ok

    // Lines: underline 1.5 px below a baseline at 12, 0.8 px thick, x-height
    // 8: thickness 1, underline row 12 + 2 = 14, strike 12 - 4 - 0 = 8.
    (i32 u, i32 s, i32 t) = lines_for(12, 16, 1.5, 0.8, 8.0)
    ok = #expect(u == 14 && s == 8 && t == 1, "lines ", u, " ", s, " ", t) && ok
    // An underline below the cell is pulled up into it.
    (i32 u2, i32 _, i32 t2) = lines_for(12, 16, 9.0, 2.0, 8.0)
    ok = #expect(u2 == 14 && t2 == 2, "underline held ", u2) && ok
    (i32 u3, i32 s3, i32 t3) = lines_for(0, 0, 1.0, 1.0, 1.0)
    ok = #expect(u3 == 0 && s3 == 0 && t3 == 0, "no cell, no lines") && ok
    // Offsets no `i32` holds are held to a cell first: `baseline` plus a
    // saturated one was an overflow and a trap. The answers are the ones the
    // clamps below give any offset past the cell, and NaN is an offset of 0.
    f32 fzero = 0.0
    f32 nan = fzero / fzero
    (i32 u4, i32 s4, i32 t4) = lines_for(12, 16, 1.0e30, 1.0, 1.0e30)
    ok = #expect(u4 == 15 && s4 == 0 && t4 == 1, "far-positive offsets ", u4, " ", s4) && ok
    (i32 u5, i32 s5, i32 _) = lines_for(12, 16, 0.0 - 1.0e30, 1.0, 0.0 - 1.0e30)
    ok = #expect(u5 == 0 && s5 == 15, "far-negative offsets ", u5, " ", s5) && ok
    (i32 u6, i32 s6, i32 _) = lines_for(12, 16, nan, 1.0, nan)
    ok = #expect(u6 == 12 && s6 == 12, "NaN offsets ", u6, " ", s6) && ok
    // `round_half_up` converts only what an `i32` holds; past 2^23 an `f32`
    // is whole and its own rounding.
    ok = #expect(round_half_up(3.0e9) == 3.0e9 && round_half_up(0.0 - 3.0e9) == 0.0 - 3.0e9,
                 "round_half_up(3e9) is ", round_half_up(3.0e9)) && ok
    ok = #expect(round_half_up(2.5) == 3.0 && round_half_up(0.0 - 2.5) == 0.0 - 2.0,
                 "round_half_up moved on halves") && ok
    ok = #expect(round_half_up(nan) != round_half_up(nan), "round_half_up(NaN) is a number") && ok

    // The screen in whole cells.
    (i32 c, i32 r) = grid_size_for(1280, 720, 8, 16)
    ok = #expect(c == 160 && r == 45, "1280x720 ", c, "x", r) && ok
    (i32 c2, i32 r2) = grid_size_for(1287, 735, 8, 16)
    ok = #expect(c2 == 160 && r2 == 45, "partial cells dropped") && ok
    (i32 c3, i32 r3) = grid_size_for(1280, 720, 0, 16)
    ok = #expect(c3 == 0 && r3 == 0, "no cell, no screen") && ok
    (i32 c4, i32 r4) = grid_size_for(-5, 720, 8, 16)
    ok = #expect(c4 == 0 && r4 == 0, "negative framebuffer") && ok

    if ok: return 0
    return 1
