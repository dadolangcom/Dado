@test
// The ASCII fast path with no GPU and no face: the table `atlas_prewarm`
// fills, and `text_from` against the general path it replaces for plain
// bytes. The atlas is made with an empty face chain, which hands out slots
// and inks nothing (`atlas_test`); `g_up` is set by hand so `slot_of` looks
// clusters up as it would after `up`.
package grid

import "app:ui/cell"

// `text_from` as it was before the fast path: every cluster through `layout`
// and `slot_of`. The reference the fast path must agree with.
private i32 general_text_from(i32 col, i32 row, string8 s, i32 at, i32 at_col, i32 max_cols, [4]u8 fg, [4]u8 bg):
    if max_cols <= 0:
        return at_col
    [32]Span spans
    i32 limit = at_col + max_cols
    i32 c = at_col
    for:
        i32 k = layout(s, at, c, limit, spans[:])
        if k == 0:
            break
        for i in 0..<k:
            Span sp = spans[i]
            i32 x = col + sp.col - at_col
            if sp.kind == SpanKind.Blank:
                for j in 0..<sp.cols:
                    poke(x + j, row, BLANK_SLOT, 0, fg, bg)
            else if sp.cols == 2:
                u16 left = slot_of(s, sp.at, sp.end)
                u16 right = BLANK_SLOT
                if left != NOTDEF_SLOT && left != BLANK_SLOT:
                    right = left + 1
                poke(x, row, left, cell.WIDE_LEFT, fg, bg)
                poke(x + 1, row, right, cell.WIDE_RIGHT, fg, bg)
            else:
                poke(x, row, slot_of(s, sp.at, sp.end), 0, fg, bg)
        at = spans[k - 1].end
        c = spans[k - 1].col + spans[k - 1].cols
    return c

// Whether rows 0 and 1 of the base hold the same cells.
private bool rows_agree():
    for x in 0..<g_cols:
        if cell_at(i32(x), 0) != cell_at(i32(x), 1):
            return false
    return true

// Write `s` with the fast path on row 0 and the reference on row 1, from
// `at` / `at_col` into `max_cols` at screen column `col`, both rows cleared
// first; answers whether the cells and the returned columns agree, and how
// many cells took the fast path.
private (bool same, i32 fast) agree(string8 s, i32 col, i32 at, i32 at_col, i32 max_cols):
    clear_layer(BASE)
    [4]u8 fg = [230, 230, 230, 255]
    [4]u8 bg = [0, 0, 0, 0]
    i32 before = g_ascii_cells
    i32 a = text_from(col, 0, s, at, at_col, max_cols, fg, bg)
    i32 fast = g_ascii_cells - before
    i32 b = general_text_from(col, 1, s, at, at_col, max_cols, fg, bg)
    return (a == b && rows_agree(), fast)

// Write `s` once whole with `text_from` on row 0, and on row 1 as runs of
// `step` bytes through `text_span`, each run in a colour of its own (its
// index in the red channel); answers whether the two rows hold the same
// slots and flags cell by cell with every row-1 cell in the colour of the
// run its cluster began in, and how many cells took the fast path each way.
private (bool same, i32 runs_fast, i32 whole_fast) runs_agree(string8 s, i32 step, i32 max_cols):
    clear_layer(BASE)
    [4]u8 bg = [0, 0, 0, 0]
    i32 before = g_ascii_cells
    i32 wc = text_from(0, 0, s, 0, 0, max_cols, [255, 255, 255, 255], bg)
    i32 whole = g_ascii_cells - before
    before = g_ascii_cells
    i32 at = 0
    i32 c = 0
    i32 k = 0
    i32 n = i32(#len(s))
    // The run each column's cluster began in; -1 for none.
    [256]i32 run_of
    for i in 0..<256:
        run_of[i] = -1
    for at < n && c < max_cols:
        i32 end = at + step
        [4]u8 fg = [u8(k), 7, 7, 255]
        (i32 na, i32 nc) = text_span(c, 1, s, at, end, c, max_cols - c, fg, bg)
        for x in c..<nc:
            if x < 256:
                run_of[x] = k
        if na == at && nc == c:
            break
        at = na
        c = nc
        k = k + 1
    i32 runs = g_ascii_cells - before
    bool same = c == wc
    for x in 0..<g_cols:
        cell.Cell a = cell_at(i32(x), 0)
        cell.Cell b = cell_at(i32(x), 1)
        if a.slot != b.slot || a.flags != b.flags:
            same = false
        if x < 256 && run_of[x] >= 0 && b.fg[0] != u8(run_of[x]):
            same = false
    return (same, runs, whole)

i32 test():
    bool ok = true
    []Face none = g_faces[0..<0]

    // ── The table ──
    Atlas a = atlas_make(8, 16, 16.0, CHAIN_ID)
    for i in 0..<PREWARM_COUNT:
        ok = #expect(a.ascii[i] == BLANK_SLOT, "a new atlas knows no byte") && ok
    ok = #expect(atlas_prewarm(&a, none) == 95, "95 resident") && ok
    [2]char8 k
    bool all = true
    for i in 0..<PREWARM_COUNT:
        u8 byte = u8(PREWARM_FIRST + i32(i))
        k[0] = char8(byte)
        u16 fast = atlas_ascii_slot(&a, byte)
        u16 general = atlas_slot(&a, none, string8(k[0..<1]), 1)
        if fast == BLANK_SLOT || fast != general:
            all = false
            ok = #expect(false, "byte ", i32(byte), ": table ", i32(fast), ", general ", i32(general)) && ok
    ok = #expect(all, "every printable byte's table slot is the general path's") && ok
    // The space has a slot of its own, so 0 can mean "not known".
    ok = #expect(atlas_ascii_slot(&a, u8(0x20)) >= u16(FIRST_FREE), "the space is not the blank slot") && ok
    ok = #expect(atlas_ascii_slot(&a, u8(0x09)) == BLANK_SLOT && atlas_ascii_slot(&a, u8(0x7F)) == BLANK_SLOT, "tab and DEL are not in it") && ok
    ok = #expect(atlas_ascii_slot(&a, u8(0x1F)) == BLANK_SLOT && atlas_ascii_slot(&a, u8(0xC3)) == BLANK_SLOT, "nor controls, nor UTF-8 lead bytes") && ok
    // A rebuilt atlas starts with it empty; a freed one keeps none.
    atlas_free(&a)
    ok = #expect(atlas_ascii_slot(&a, u8(0x41)) == BLANK_SLOT, "freed, forgotten") && ok

    // ── text_from against the general path ──
    g_cw = 8
    g_ch = 16
    g_alloc = #default
    g_have_alloc = true
    g_atlas = atlas_make(8, 16, 16.0, CHAIN_ID)
    g_atlas_made = true
    _ = atlas_prewarm(&g_atlas, none)
    g_nfaces = 0
    g_up = true
    // 1600 x 32 px of 8 x 16 cells: 200 x 2.
    ok = #expect(begin(1600, 32) && cols() == 200 && rows() == 2, "200 x 2") && ok

    string8 line = "The quick brown fox jumps over the lazy dog; 0123456789 !@#$%^&*()-=+[]{}<>?/|~ The quick brown fox jumps over the lazy dog. ABCDEFGHIJKLMNOPQRSTUVWXYZabc"
    (bool same, i32 fast) = agree(line, 0, 0, 0, 150)
    ok = #expect(same && fast == 150, "a 150-column ASCII line: all fast, same cells; fast ", fast) && ok
    // Each fast cell's slot is the table's for its byte.
    ok = #expect(cell_at(4, 0).slot == atlas_ascii_slot(&g_atlas, u8('q')) && cell_at(4, 0).flags == 0, "q from the table") && ok

    // A byte followed by a combining mark is not its own cluster: general.
    string8 accent = "e\xCC\x81x"
    (same, fast) = agree(accent, 0, 0, 0, 10)
    ok = #expect(same && fast == 1, "e + U+0301 general, x fast: ", fast) && ok
    ok = #expect(cell_at(0, 0).slot != atlas_ascii_slot(&g_atlas, u8('e')), "e with its accent is not e") && ok
    ok = #expect(cell_at(0, 0).slot == slot_of(accent, 0, 3) && cell_at(1, 0).slot == atlas_ascii_slot(&g_atlas, u8('x')), "the cluster's slot, then x's") && ok

    // Tabs, wide clusters, controls, CR LF, the column limit, a start part-way
    // in, a negative start column, an empty string: the same cells and the
    // same answer either way.
    (same, fast) = agree("a\tb", 0, 0, 0, 20)
    ok = #expect(same && fast == 2, "a tab is general, a and b fast: ", fast) && ok
    (same, fast) = agree("a\xE6\x97\xA5b", 0, 0, 0, 20)
    ok = #expect(same && fast == 1, "a before a wide cluster is general, b fast: ", fast) && ok
    (same, fast) = agree("x\xE6\x97\xA5", 0, 0, 0, 2)
    ok = #expect(same, "a wide cluster cut at the limit") && ok
    (same, fast) = agree("ab\x01cd\r\nef\x7Fg", 3, 0, 0, 40)
    ok = #expect(same && fast == 7, "controls, CR LF and DEL general, the rest fast: ", fast) && ok
    (same, fast) = agree("abcdef", 0, 0, 0, 3)
    ok = #expect(same && fast == 3, "held to max_cols") && ok
    (same, fast) = agree("ab\tcdef", 5, 3, 8, 10)
    ok = #expect(same && fast == 4, "text_from part-way, after the tab") && ok
    (same, fast) = agree("abc", 0, 0, -3, 10)
    ok = #expect(same, "a negative start column") && ok
    (same, fast) = agree("", 0, 0, -3, 10)
    ok = #expect(same, "empty, negative start column") && ok
    (same, fast) = agree("abc", 0, 0, -9, 5)
    ok = #expect(same, "a limit at or below 0") && ok
    (same, fast) = agree("abc\xC3\xA9", 0, 0, 0, 10)
    ok = #expect(same && fast == 2, "c before a two-byte letter is general: ", fast) && ok
    (same, fast) = agree("abc", 0, 7, 0, 10)
    ok = #expect(same && fast == 0, "a start past the end") && ok

    // ── text_span: a line written as coloured runs ──
    // The same cells as one `text_from` (colours aside), the same cells
    // through the fast path, and each run's colour on the cells its clusters
    // begin in.
    (bool rs, i32 rfast, i32 wfast) = runs_agree(line, 7, 150)
    ok = #expect(rs && rfast == wfast && rfast == 150, "150 ASCII columns in runs of 7 bytes: all fast; runs ", rfast, " whole ", wfast) && ok
    (rs, rfast, wfast) = runs_agree(line, 1, 150)
    ok = #expect(rs && rfast == 150, "in runs of one byte, still all fast: ", rfast) && ok
    // A run ending just before a two-byte letter: the byte before it is general
    // either way, because the lookahead reads past the run's end.
    (rs, rfast, wfast) = runs_agree("abc\xC3\xA9def", 3, 20)
    ok = #expect(rs && rfast == wfast && rfast == 5, "a run boundary before a letter: ", rfast, " whole ", wfast) && ok
    // A boundary inside a cluster (after the base, before its mark) lays the
    // cluster out whole in the first run, and the next resumes after it.
    (rs, rfast, wfast) = runs_agree("ae\xCC\x81xyz", 2, 20)
    ok = #expect(rs && rfast == wfast, "a boundary inside a cluster: ", rfast, " whole ", wfast) && ok
    // Tabs and wide clusters inside runs keep their columns.
    (rs, rfast, wfast) = runs_agree("a\tbb\xE6\x97\xA5c\td", 2, 40)
    ok = #expect(rs && rfast == wfast, "tabs and a wide cluster across runs") && ok
    (rs, rfast, wfast) = runs_agree("abcdefghij", 3, 5)
    ok = #expect(rs && rfast == 5, "the column limit stops the runs") && ok
    (i32 sa, i32 sc) = text_span(0, 0, "abcdef", 2, 2, 2, 10, [1, 1, 1, 255], [0, 0, 0, 0])
    ok = #expect(sa == 2 && sc == 2, "an empty run answers where it began: ", sa, " ", sc) && ok
    (sa, sc) = text_span(0, 0, "abc", 1, 99, 1, 10, [1, 1, 1, 255], [0, 0, 0, 0])
    ok = #expect(sa == 3 && sc == 3, "an end past the string is its length: ", sa, " ", sc) && ok

    // A table that knows nothing (a rebuilt, unprewarmed atlas) sends every
    // byte the general way, with the same cells.
    [PREWARM_COUNT]u16 saved = g_atlas.ascii
    for i in 0..<PREWARM_COUNT:
        g_atlas.ascii[i] = BLANK_SLOT
    (same, fast) = agree(line, 0, 0, 0, 150)
    ok = #expect(same && fast == 0, "an empty table: all general") && ok
    g_atlas.ascii = saved

    ok = #expect(stats().ascii_cells == g_ascii_cells && g_ascii_cells > 0, "stats reads the count") && ok
    ok = #expect(!begin(1600, 32) && stats().ascii_cells == 0, "begin zeroes it") && ok

    // Before `up` there is no atlas: the fast path is empty and every cell is
    // the general path's blank.
    atlas_free(&g_atlas)
    Atlas zero
    g_atlas = zero
    g_atlas_made = false
    g_up = false
    (same, fast) = agree("hello", 0, 0, 0, 10)
    ok = #expect(same && fast == 0 && cell_at(0, 0).slot == BLANK_SLOT, "before up: general, blank") && ok

    for i in 0..<MAX_LAYERS:
        release_layer(i32(i))
    g_cols = 0
    g_rows = 0
    g_cw = 0
    g_ch = 0
    g_have_alloc = false
    if ok:
        return 0
    return 1
