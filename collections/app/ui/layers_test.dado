@test
// Layer groups in the tree, with no window: a floating node over a base node
// in the same cells; `hit` answering the topmost layer's owner, and the base
// again the moment the float is hidden, removed or moved away, with no
// repaint below; the grid's target set to each node's layer before its paint
// hook (read by the hooks themselves); what the float left blanked in its
// layer and the layer cleared whole when nothing is left in it; and
// `layers_used`. The grid is not up, so its cells cannot be read here: the
// blanking and the clearing are read from the package's counters, and the
// pixels from the ide run under Xvfb.
package ui

import "app:ui/cell"
import "app:ui/grid"

// Every child of a stack gets the stack's rectangle, except that child 1 is
// moved right by `g_shift` columns: a float over child 0.
private i32 g_shift

private void stack_arrange(Control c, rawptr st, cell.CellRect r):
    _ = st
    Control ch = first_child(c)
    i32 k = 0
    for valid(ch):
        cell.CellRect q = r
        if k == 1:
            q = cell.rect(r.col + g_shift, r.row, 4, 2)
        set_rect(ch, q)
        k = k + 1
        ch = next_sibling(ch)

// What target each painting node saw, by slot; -1 for none yet.
private [16]i32 g_seen

private void seen_paint(Control c, rawptr st, cell.CellRect r):
    _ = st
    _ = r
    if c.slot >= 0 && c.slot < 16:
        g_seen[c.slot] = grid.targeted()

private Kind g_stack_kind = NO_KIND
private Kind g_paint_kind = NO_KIND

private void kinds():
    Hooks s
    s.arrange = stack_arrange
    g_stack_kind = register_kind("stack", s)
    Hooks p
    p.paint = seen_paint
    g_paint_kind = register_kind("seen", p)

private bool hit_is(i32 col, i32 row, Control want, string8 what):
    Control got = hit(col, row)
    return #expect(got == want, what, ": hit(", col, ",", row, ") is slot ", got.slot)

i32 test():
    bool ok = true
    kinds()
    for k in 0..<16:
        g_seen[k] = -1
    cell.CellRect screen = cell.rect(0, 0, 10, 4)
    Control st = create(g_stack_kind, NIL, nil)
    set_expand(st, true, true)
    Control base = create(g_paint_kind, st, nil)
    Control fl = create(g_paint_kind, st, nil)
    Control inside = create(g_paint_kind, fl, nil)
    ok = #expect(node_layer(fl) == grid.BASE && layers_used() == 1, "everything on the base") && ok
    set_layer(fl, 2)
    ok = #expect(node_layer(fl) == 2 && node_layer(inside) == 2 && node_layer(base) == grid.BASE, "a float and its subtree") && ok
    ok = #expect(layers_used() == 3, "three layers needed: ", layers_used()) && ok
    update(screen)
    ok = #expect(g_seen[base.slot] == 0 && g_seen[fl.slot] == 2 && g_seen[inside.slot] == 2, "each paint targeted its node's layer") && ok
    ok = #expect(grid.targeted() == grid.BASE, "the walk points back at the base") && ok
    ok = hit_is(1, 1, inside, "the float's cells answer its deepest node") && ok
    ok = hit_is(6, 1, base, "past the float, the base") && ok
    ok = hit_is(1, 3, base, "under the float's rows, the base") && ok

    // The base repainting alone does not take the float's cells.
    mark_paint(base)
    update(screen)
    ok = #expect(stats().painted == 1, "the base alone repainted") && ok
    ok = hit_is(1, 1, inside, "still the float") && ok

    // ── Hidden: the base answers at once, and the layer is cleared ─────────
    i32 blanks = g_layer_blanks
    i32 wipes = g_layer_wipes
    set_visible(fl, false)
    ok = hit_is(1, 1, base, "hidden: the base answers before any repaint") && ok
    update(screen)
    ok = #expect(g_layer_blanks == blanks + 1 && g_layer_wipes == wipes + 1, "its cells blanked and the empty layer cleared whole") && ok
    ok = #expect(layers_used() == 1, "no layer above the base in use: ", layers_used()) && ok
    ok = hit_is(1, 1, base, "hidden, after the update") && ok
    set_visible(fl, true)
    ok = #expect(layers_used() == 3, "shown again, its layer is needed again") && ok
    update(screen)
    ok = hit_is(1, 1, inside, "shown again: the float") && ok

    // ── Moved: the cells it left answer the base, its new ones the float ───
    blanks = g_layer_blanks
    g_shift = 5
    mark_layout(st)
    update(screen)
    ok = #expect(rect(fl) == cell.rect(5, 0, 4, 2), "moved") && ok
    ok = hit_is(1, 1, base, "left behind: the base") && ok
    ok = hit_is(6, 1, inside, "moved to: the float") && ok
    ok = #expect(g_layer_blanks == blanks + 1, "the old cells blanked in its layer") && ok
    ok = #expect(layers_used() == 3, "still in use, not cleared") && ok

    // ── Back to the base: drawn in tree order there, the later sibling ─────
    set_layer(fl, -1)
    ok = #expect(node_layer(inside) == grid.BASE, "the subtree follows") && ok
    update(screen)
    ok = #expect(g_seen[fl.slot] == 0 && g_seen[inside.slot] == 0, "now painting the base") && ok
    ok = hit_is(6, 1, inside, "on the base, the later sibling on top") && ok
    ok = #expect(layers_used() == 1, "layer 2 cleared: ", layers_used()) && ok

    // ── Removed: the base answers at once ──────────────────────────────────
    set_layer(fl, 1)
    update(screen)
    ok = hit_is(6, 1, inside, "on layer 1") && ok
    wipes = g_layer_wipes
    remove(fl)
    ok = hit_is(6, 1, base, "removed: the base answers before any repaint") && ok
    update(screen)
    ok = #expect(g_layer_wipes == wipes + 1 && layers_used() == 1, "its layer cleared") && ok
    ok = hit_is(6, 1, base, "removed, after the update") && ok

    // Out-of-range layers are held; a dead handle reads the base.
    set_layer(base, 99)
    ok = #expect(node_layer(base) == grid.MAX_LAYERS - 1, "held below MAX_LAYERS") && ok
    ok = #expect(node_layer(NIL) == grid.BASE, "NIL") && ok

    // ── Cut by an ancestor, its own rect unchanged ─────────────────────────
    // A margin box narrows the stack under it; the float keeps its rect
    // (0, 0, 4, 2) but its clip shrinks to two columns. The two it lost are
    // blanked in its layer and answer the base again.
    reset()
    g_shift = 0
    Control mb = margin_box(NIL, 0, 0, 0, 0)
    set_expand(mb, true, true)
    Control s2 = create(g_stack_kind, mb, nil)
    Control b2 = create(g_paint_kind, s2, nil)
    Control f2 = create(g_paint_kind, s2, nil)
    set_layer(f2, 1)
    update(screen)
    ok = hit_is(3, 0, f2, "the float, uncut") && ok
    blanks = g_layer_blanks
    set_margins(mb, 0, 0, 8, 0)
    update(screen)
    ok = #expect(rect(f2) == cell.rect(0, 0, 4, 2) && rect(s2).cols == 2, "cut, not moved") && ok
    ok = hit_is(1, 0, f2, "still the float where it shows") && ok
    ok = hit_is(3, 0, mb, "the cut-away cells answer the base") && ok
    ok = #expect(g_layer_blanks == blanks + 1, "its old claim blanked in its layer") && ok
    _ = b2

    reset()
    ok = #expect(layers_used() == 1, "reset") && ok
    if ok: return 0
    return 1
