@test
// Focus between panes: `focus_next`/`focus_prev` step through the focusable
// nodes in view in tree order and wrap, skipping hidden subtrees and nodes
// that are not focusable; `focus_within` answers whether focus is inside a
// subtree; two panels' focus boxes follow focus from one to the other, in
// their state and in the chrome list; and a node that asked to be repainted on
// focus moves is marked by a move, by a clear, and by the removal of the
// focused node.
package ui

import "app:ui/cell"
import "app:ui/grid"

private type FSize: (i32 cols, i32 rows)
private type FSizePtr: ^FSize

private cell.CellPoint fsized(Control c, rawptr st):
    _ = c
    ^FSize s = FSizePtr(st)
    cell.CellPoint p = (s.cols, s.rows)
    return p

private Kind g_fleaf = NO_KIND

private Control fleaf(Control parent, bool focusable):
    if !kind_ok(g_fleaf):
        Hooks h
        h.measure = fsized
        g_fleaf = register_kind("focus_test_leaf", h)
    Control c = create_owned(g_fleaf, parent, i64(#size(FSize)))
    ^FSize s = FSizePtr(state(c))
    s.cols = 2
    s.rows = 1
    set_expand(c, true, true)
    set_focusable(c, focusable)
    return c

// The border colour of `p`'s box in the chrome list, or clear when it has none.
private [4]u8 chrome_border(Control p):
    [16]ChromeItem items
    i32 n = chrome_collect(items[:], 8, 16)
    for k in 0..<n:
        if k < 16 && items[k].node == p:
            grid.ChromeBox b = items[k].box
            return b.border
    [4]u8 none = [0, 0, 0, 0]
    return none

i32 test():
    bool ok = true
    cell.CellRect screen = cell.rect(0, 0, 40, 12)

    ok = #expect(focus_next() == NIL && focus_prev() == NIL && focused() == NIL, "nothing focusable: NIL") && ok

    //  root
    //  ├── pa (panel) ── ea
    //  ├── hid (vbox, hidden) ── eh
    //  ├── pb (panel) ── box (vbox) ── eb1, plain (not focusable), eb2
    //  └── watcher (vbox, repaints on focus moves)
    Control pa = panel(NIL)
    set_expand(pa, true, true)
    Control ea = fleaf(pa, true)
    Control hid = vbox(NIL)
    Control eh = fleaf(hid, true)
    set_visible(hid, false)
    Control pb = panel(NIL)
    set_expand(pb, true, true)
    Control bx = vbox(pb)
    set_expand(bx, true, true)
    Control eb1 = fleaf(bx, true)
    Control plain = fleaf(bx, false)
    Control eb2 = fleaf(bx, true)
    Control watcher = vbox(NIL)
    set_focus_repaint(watcher, true)
    update(screen)

    // ── Forward, wrapping, skipping ───────────────────────────────────────
    ok = #expect(focus_next() == ea && focused() == ea, "nothing focused: the first") && ok
    ok = #expect(focus_next() == eb1, "the hidden subtree is skipped") && ok
    ok = #expect(focus_next() == eb2, "the unfocusable leaf is skipped") && ok
    ok = #expect(focus_next() == ea, "wraps to the first") && ok
    // ── Backward ──────────────────────────────────────────────────────────
    ok = #expect(focus_prev() == eb2, "back wraps to the last") && ok
    ok = #expect(focus_prev() == eb1 && focus_prev() == ea, "and steps back") && ok
    set_focus(NIL)
    ok = #expect(focus_prev() == eb2, "nothing focused: back is the last") && ok
    // Showing the hidden pane puts its node in the order.
    set_visible(hid, true)
    set_focus(ea)
    ok = #expect(focus_next() == eh, "shown again: in the order") && ok
    set_visible(hid, false)
    ok = #expect(focus_next() == eb1, "from a node hidden since, the walk goes on") && ok
    _ = plain

    // ── focus_within ──────────────────────────────────────────────────────
    ok = #expect(focus_within(pb) && focus_within(bx) && focus_within(eb1) && focus_within(root()), "inside pb, bx, itself and the root") && ok
    ok = #expect(!focus_within(pa) && !focus_within(eb2) && !focus_within(NIL), "not in pa, a sibling or NIL") && ok

    // ── Panels follow ─────────────────────────────────────────────────────
    ok = #expect(panel_state(pb) == STATE_FOCUS && panel_state(pa) == STATE_NORMAL, "pb shows focus") && ok
    ok = #expect(chrome_border(pb) == PANEL_FOCUS_BORDER && chrome_border(pa) == PANEL_BORDER, "and so does its chrome") && ok
    _ = focus_next()
    _ = focus_next()
    ok = #expect(focused() == ea, "to the other pane") && ok
    ok = #expect(panel_state(pa) == STATE_FOCUS && panel_state(pb) == STATE_NORMAL, "pa shows focus now") && ok
    ok = #expect(chrome_border(pa) == PANEL_FOCUS_BORDER && chrome_border(pb) == PANEL_BORDER, "the chrome moved with it") && ok

    // ── Repaint on focus moves ────────────────────────────────────────────
    update(screen)
    ok = #expect(!is_paint_dirty(watcher), "clean") && ok
    set_focus(ea)
    ok = #expect(!is_paint_dirty(watcher), "focus unchanged: no mark") && ok
    _ = focus_next()
    ok = #expect(is_paint_dirty(watcher), "a move marks the watcher") && ok
    update(screen)
    set_focus(NIL)
    ok = #expect(is_paint_dirty(watcher), "a clear marks it") && ok
    update(screen)
    set_focus(eb2)
    update(screen)
    remove(eb2)
    ok = #expect(focused() == NIL && is_paint_dirty(watcher), "removing the focused node marks it, after the removal") && ok
    update(screen)
    set_focus(eb1)
    update(screen)
    set_focusable(eb1, false)
    ok = #expect(focused() == NIL && is_paint_dirty(watcher), "making it unfocusable marks it") && ok
    update(screen)
    set_focus_repaint(watcher, false)
    set_focus(ea)
    ok = #expect(!is_paint_dirty(watcher), "switched off: no mark") && ok
    set_focus_repaint(watcher, true)
    remove(watcher)
    set_focus(NIL)
    ok = #expect(g_focus_watchers == 0, "a removed watcher is not counted") && ok

    reset()
    if ok:
        return 0
    return 1
