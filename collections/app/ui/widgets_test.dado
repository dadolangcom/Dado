@test
// The text widgets with no window: the scroll arithmetic, the label's
// minimum, and the rule that a setter called while `update` runs is refused.
package ui

import "app:ui/cell"

private Control g_lab
private i32 g_paints

private cell.CellPoint poke_measure(Control c, rawptr st):
    _ = c
    _ = st
    cell.CellPoint p = (1, 1)
    return p

// A sibling whose paint tries to change the label: refused, so the label
// keeps the text it had and nothing is left dirty.
private void poke_paint(Control c, rawptr st, cell.CellRect r):
    _ = c
    _ = st
    _ = r
    g_paints = g_paints + 1
    set_label_text(g_lab, "changed during paint")

i32 test():
    bool ok = true

    // Scroll arithmetic.
    ok = #expect(max_scroll_px(100, 10, 16) == 90 * 16, "max 100 lines 10 rows") && ok
    ok = #expect(max_scroll_px(5, 10, 16) == 0, "fits") && ok
    ok = #expect(max_scroll_px(0, 10, 16) == 0, "empty") && ok
    ok = #expect(max_scroll_px(100, 0, 16) == 0, "no rows") && ok
    ok = #expect(max_scroll_px(100, 10, 0) == 0, "no cell height") && ok
    ok = #expect(clamp_scroll(-5, 100) == 0 && clamp_scroll(500, 100) == 100 && clamp_scroll(40, 100) == 40, "clamp") && ok
    ok = #expect(top_line(0, 16) == 0 && top_line(15, 16) == 0 && top_line(16, 16) == 1 && top_line(33, 16) == 2, "top_line") && ok
    ok = #expect(top_line(100, 0) == 0 && top_line(-3, 16) == 0, "top_line degenerate") && ok

    // A label measures its text in columns, tabs and wide clusters included.
    Control l = label(NIL, "ab\t\xE6\x97\xA5")
    update(cell.rect(0, 0, 40, 10))
    cell.CellPoint m = minimum(l)
    ok = #expect(m.col == cell.TAB_COLUMNS + 2 && m.row == 1, "label minimum ", m.col, "x", m.row) && ok
    set_label_text(l, "abcdef")
    update(cell.rect(0, 0, 40, 10))
    ok = #expect(minimum(l).col == 6, "label re-measured ", minimum(l).col) && ok
    ok = #expect(!is_layout_dirty(l) && !is_paint_dirty(l), "label clean after update") && ok

    // A setter during update is refused.
    g_lab = l
    Hooks h
    h.measure = poke_measure
    h.arrange = nil
    h.paint = poke_paint
    h.input = nil
    h.free = nil
    Control p = create(register_kind("poker", h), NIL, nil)
    update(cell.rect(0, 0, 40, 10))
    ok = #expect(g_paints == 1, "poker painted ", g_paints) && ok
    ok = #expect(label_text(l) == "abcdef", "label kept its text: ", label_text(l)) && ok
    ok = #expect(minimum(l).col == 6, "label kept its minimum ", minimum(l).col) && ok
    ok = #expect(!is_layout_dirty(l), "label not left dirty") && ok
    remove(p)

    // A text view on no source is total, and scrolling it does nothing.
    Control v = text_view(NIL)
    ok = #expect(valid(v) && is_focusable(v), "view made") && ok
    ok = #expect(!text_view_scroll_lines(v, 5), "no source, no scroll") && ok
    (i64 top, i64 off) = text_view_position(v)
    ok = #expect(top == 0 && off == 0, "position") && ok
    ok = #expect(!text_view_scroll_lines(NIL, 1), "NIL view") && ok
    (i64 tn, i64 on) = text_view_position(l)
    ok = #expect(tn == 0 && on == 0, "a label is not a view") && ok

    reset()
    if ok: return 0
    return 1
