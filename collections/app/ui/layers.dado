// app:ui — layer groups in the tree.
//
// **A node paints into one layer.** `set_layer(c, l)` puts `c` and every
// descendant that has no layer of its own into the grid's layer `l`; every
// other node paints into its parent's, and the root into `grid.BASE`. The
// paint walk points the grid's writers at a node's layer (`grid.target`)
// before its paint hook and back at the base when the walk is done, so a
// widget never names a layer. A node whose layer differs from its parent's is
// a **layer root**: the top of a floating subtree.
//
// **What a floating subtree leaves, it clears.** The layer below never
// repainted under it, so nothing below needs to repaint when it goes: when a
// node that paints above the base is hidden or removed, when a layer root's
// rectangle changes, and when a node's layer changes, the cells it last
// claimed in its old layer are queued, and before the next paint walk each is
// blanked in that layer (transparent both ways, so the layers under it show
// through) and dropped from that layer's hit map, so `hit` answers the node
// under it at once. A layer left with no node in view is then cleared whole
// (`grid.clear_layer`), which also stops the grid drawing it. The base is
// never blanked: its cells are always some node's, and the parent that is
// marked for paint by every one of those changes repaints them, as it always
// has.
//
// **Refused:** two floating subtrees overlapping in one layer. Blanking what
// one left would take the other's cells with it, and nothing repaints them;
// a layer is one floating window, menu or tooltip, and there are
// `grid.MAX_LAYERS` of them. Nothing refuses it at run time — it is the
// program's to avoid.
//
// **How many layers the grid needs** is `layers_used()`: one more than the
// highest layer `set_layer` has given out since the last time a clear found
// it unused. The frame hands that to `grid.set_layers` before every
// `update`.
package ui

import "app:ui/cell"
import "app:ui/grid"

private type LayerClear: (i32 layer, cell.CellRect r)

private ref []LayerClear g_lclears
private i32              g_nlclears
private i32              g_layers_used = 1
// How many rectangles have been blanked, and how many layers cleared whole,
// ever. Read by the tests, which cannot read the grid's cells with no window.
private i32 g_layer_blanks
private i32 g_layer_wipes

private void reset_layers():
    g_nlclears = 0
    g_layers_used = 1

private void queue_clear(i32 layer, cell.CellRect r):
    if layer <= grid.BASE || cell.is_empty(r):
        return
    capture_alloc()
    if g_lclears == nil:
        g_lclears = #make([]LayerClear, 8, g_alloc)
        if g_lclears == nil:
            return
        g_nlclears = 0
    if g_nlclears >= i32(#len(g_lclears)):
        if !#resize(g_lclears, i64(g_nlclears) * 2):
            return
    g_lclears[g_nlclears].layer = layer
    g_lclears[g_nlclears].r = r
    g_nlclears = g_nlclears + 1

// Node `i` (whose parent is, or was, `p`) and its subtree leave the view:
// queue the claim of `i` itself when it paints above the base, and of every
// layer root in view below it.
private void leaving_layers(i32 i, i32 p):
    if !g_nodes[i].in_view:
        return
    queue_clear(g_nodes[i].layer, g_nodes[i].claimed)
    i32 ch = g_nodes[i].first_child
    for ch >= 0:
        leaving_below(ch)
        ch = g_nodes[ch].next_sibling
    _ = p

private void leaving_below(i32 j):
    if !g_nodes[j].in_view:
        return
    i32 p = g_nodes[j].parent
    if p >= 0 && g_nodes[p].layer != g_nodes[j].layer:
        queue_clear(g_nodes[j].layer, g_nodes[j].claimed)
    i32 ch = g_nodes[j].first_child
    for ch >= 0:
        leaving_below(ch)
        ch = g_nodes[ch].next_sibling

// Node `i`'s rectangle is about to change: a layer root queues what it
// claimed, because nothing in its layer under it will repaint there.
private void moving_layer_root(i32 i):
    i32 p = g_nodes[i].parent
    if g_nodes[i].layer <= grid.BASE || !g_nodes[i].in_view:
        return
    if p >= 0 && g_nodes[p].layer == g_nodes[i].layer:
        return
    queue_clear(g_nodes[i].layer, g_nodes[i].claimed)
    g_nodes[i].claimed = empty_rect()

// Before the paint walk: blank and disown every queued rectangle, then clear
// whole any layer those left with no node in view.
private void flush_layer_clears():
    if g_nlclears <= 0:
        return
    [4]u8 none = [0, 0, 0, 0]
    u32 touched = 0
    grid.unclip()
    for k in 0..<g_nlclears:
        LayerClear q = g_lclears[k]
        grid.target(q.layer)
        grid.fill(q.r, none, none)
        disown(q.layer, q.r)
        touched = touched | (u32(1) << u32(q.layer))
        g_layer_blanks = g_layer_blanks + 1
    g_nlclears = 0
    grid.target(grid.BASE)
    u32 used = 1
    for i in 0..<g_used:
        if g_nodes[i].live && g_nodes[i].in_view:
            used = used | (u32(1) << u32(g_nodes[i].layer))
    i32 top = 1
    for l in 1..<grid.MAX_LAYERS:
        u32 bit = u32(1) << u32(l)
        if (used & bit) != 0:
            top = i32(l) + 1
        else if (touched & bit) != 0:
            grid.clear_layer(i32(l))
            g_layer_wipes = g_layer_wipes + 1
    g_layers_used = top

// Resolve the layer of `i`'s subtree below a parent painting into `above`.
private void resolve_layers(i32 i, i32 above):
    i32 l = g_nodes[i].layer_own
    if l < 0:
        l = above
    g_nodes[i].layer = l
    i32 ch = g_nodes[i].first_child
    for ch >= 0:
        resolve_layers(ch, l)
        ch = g_nodes[ch].next_sibling

// Paint `c` and every descendant without a layer of its own into layer
// `layer` — held to `[0, grid.MAX_LAYERS)` — or, for a negative `layer`,
// into its parent's again. A change clears what the subtree painted in its
// old layer (the base's cells are repainted by the parent instead), marks the
// parent for paint and the node for layout, and rebuilds the chrome. Does
// nothing to a dead handle or while `update` runs.
void set_layer(Control c, i32 layer):
    i32 i = index(c)
    if i < 0 || g_phase != PHASE_IDLE:
        return
    i32 own = layer
    if own < 0:
        own = -1
    if own >= grid.MAX_LAYERS:
        own = grid.MAX_LAYERS - 1
    if g_nodes[i].layer_own == own:
        return
    i32 p = g_nodes[i].parent
    i32 above = grid.BASE
    if p >= 0:
        above = g_nodes[p].layer
    i32 was = g_nodes[i].layer
    g_nodes[i].layer_own = own
    i32 now = own
    if now < 0:
        now = above
    if now != was:
        leaving_layers(i, p)
        disown(was, g_nodes[i].claimed)
        resolve_layers(i, above)
        g_nodes[i].claimed = empty_rect()
        if now + 1 > g_layers_used:
            g_layers_used = now + 1
        if p >= 0:
            g_nodes[p].claimed = empty_rect()
            paint_up(p)
        layout_up(i)
        g_chrome_dirty = true

// The layer `c` paints into; `grid.BASE` for a dead handle.
i32 node_layer(Control c):
    i32 i = index(c)
    if i < 0:
        return grid.BASE
    return g_nodes[i].layer

// How many layers the grid must have for every node's: at least one.
i32 layers_used():
    return g_layers_used

// Inside the paint walk, before `i` claims `clip`: a layer root whose clip
// is not the one it last claimed — an ancestor narrowed and cut it, with its
// own rectangle unchanged, which `moving_layer_root` never sees — blanks and
// disowns its old claim in its layer now, so no cell it no longer covers
// keeps its paint or answers `hit` for it. What it still covers it repaints
// at once.
private void refit_layer_root(i32 i, cell.CellRect clip):
    i32 l = g_nodes[i].layer
    cell.CellRect old = g_nodes[i].claimed
    if l <= grid.BASE || cell.is_empty(old) || old == clip:
        return
    i32 p = g_nodes[i].parent
    if p >= 0 && g_nodes[p].layer == l:
        return
    [4]u8 none = [0, 0, 0, 0]
    grid.unclip()
    grid.target(l)
    grid.fill(old, none, none)
    disown(l, old)
    g_layer_blanks = g_layer_blanks + 1
