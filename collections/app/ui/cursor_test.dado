@test
// The mouse cursor (input.dado, "The cursor"): which node's cursor is the
// effective one, and that the system cursor is set only when it changes —
// counted through a sink this test installs in place of the display.
package ui

import "app:input"
import "app:ui/cell"

// What the sink was told, in order.
private [32]i32 g_sunk
private i32 g_nsunk

private void count_sink(i32 cursor):
    if g_nsunk < 32:
        g_sunk[g_nsunk] = cursor
    g_nsunk = g_nsunk + 1

private i32 last_sunk():
    if g_nsunk <= 0 || g_nsunk > 32:
        return -99
    return g_sunk[g_nsunk - 1]

// A leaf `rows` tall answering `cursor`, taking presses (so a press captures).
private type CState: (i32 cursor, i32 rows)
private type CPtr: ^CState

private cell.CellPoint c_measure(Control c, rawptr st):
    _ = c
    cell.CellPoint p = (4, CPtr(st).rows)
    return p

private void c_paint(Control c, rawptr st, cell.CellRect r):
    _ = c
    _ = st
    _ = r

private bool c_input(Control c, rawptr st, input.Event e):
    _ = c
    _ = st
    return input.mouse_kind(e) == input.MouseKind.Press

private i32 c_cursor(Control c, rawptr st, cell.CellPoint p):
    _ = c
    _ = p
    return CPtr(st).cursor

private Kind g_c_leaf = NO_KIND
private Kind g_c_box = NO_KIND

private void c_kinds():
    Hooks h
    h.measure = c_measure
    h.paint = c_paint
    h.input = c_input
    h.cursor = c_cursor
    g_c_leaf = register_kind("cursor_leaf", h)
    Hooks b
    b.measure = vbox_measure_hook
    b.arrange = vbox_arrange_hook
    b.cursor = c_cursor
    g_c_box = register_kind("cursor_box", b)

private Control leaf(Control parent, i32 cursor, i32 rows):
    Control c = create_owned(g_c_leaf, parent, i64(#size(CState)))
    ^CState s = CPtr(state(c))
    s.cursor = cursor
    s.rows = rows
    return c

private void move_to(i32 col, i32 row, u32 held):
    input.Event e = (input.EventKind.Mouse, -1, f32(col) + f32(0.5), f32(row) + f32(0.5), input.MOUSE_MOTION | held)
    _ = dispatch(e)

private void press_at(i32 col, i32 row):
    input.Event e = (input.EventKind.Mouse, 0, f32(col) + f32(0.5), f32(row) + f32(0.5), u32(input.Modifier.Lmb))
    _ = dispatch(e)

private void release_at(i32 col, i32 row):
    input.Event e = (input.EventKind.Mouse, 0, f32(col) + f32(0.5), f32(row) + f32(0.5), input.MOUSE_UP)
    _ = dispatch(e)

// ── A read-only source for the TextEdit half ──────────────────────────────

private i64 lines_count(rawptr ctx):
    _ = ctx
    return 30

private string8 lines_line(rawptr ctx, i64 i):
    _ = ctx
    _ = i
    return "some text on a line"

private cell.TextPos no_insert(rawptr ctx, cell.TextPos p, string8 text):
    _ = ctx
    _ = text
    return p

private bool no_remove(rawptr ctx, cell.TextPos a, cell.TextPos b):
    _ = ctx
    _ = a
    _ = b
    return false

i32 test():
    bool ok = true
    c_kinds()
    set_cursor_sink(count_sink)
    cell.CellRect screen = cell.rect(0, 0, 20, 10)

    // Rows 0-1: a pointer leaf. Rows 2-3: a leaf that inherits, under the
    // root, which declares nothing. Rows 4-5: a leaf that inherits, in a box
    // that declares the east-west arrows. Rows 6-9: the root's own cells.
    Control a = leaf(NIL, CURSOR_POINTER, 2)
    Control b = leaf(NIL, CURSOR_INHERIT, 2)
    Control box = create_owned(g_c_box, NIL, i64(#size(CState)))
    ^CState bs = CPtr(state(box))
    bs.cursor = CURSOR_RESIZE_EW
    Control d = leaf(box, CURSOR_INHERIT, 2)
    update(screen)

    // ── Resolution, pure ─────────────────────────────────────────────────
    cell.CellPoint p0 = (1, 1)
    ok = #expect(cursor_at(a, p0) == CURSOR_POINTER, "a node's own answer") && ok
    ok = #expect(cursor_at(b, p0) == CURSOR_DEFAULT, "inherit up to a root that declares nothing: default") && ok
    ok = #expect(cursor_at(d, p0) == CURSOR_RESIZE_EW, "inherit from the nearest ancestor that declares one") && ok
    ok = #expect(cursor_at(NIL, p0) == CURSOR_DEFAULT, "a dead handle: default") && ok

    // ── The sink, through dispatch and the frame's sync ───────────────────
    sync_cursor()
    ok = #expect(g_nsunk == 0, "before any mouse event nothing is set, got ", g_nsunk) && ok
    move_to(1, 2, 0)
    sync_cursor()
    ok = #expect(g_nsunk == 0, "over a default-cursor node, the default already shown: no call, got ", g_nsunk) && ok
    move_to(1, 0, 0)
    sync_cursor()
    ok = #expect(g_nsunk == 1 && last_sunk() == CURSOR_POINTER, "onto the pointer leaf: one call, POINTER") && ok

    // Motion inside the same node, frame after frame, sets nothing more.
    for k in 0..<6:
        move_to(k % 4, k % 2, 0)
        sync_cursor()
    ok = #expect(g_nsunk == 1, "six motions over the same cursor: still one call, got ", g_nsunk) && ok

    move_to(2, 4, 0)
    sync_cursor()
    ok = #expect(g_nsunk == 2 && last_sunk() == CURSOR_RESIZE_EW, "onto the inheriting leaf in the box: the box's arrows") && ok
    move_to(2, 8, 0)
    sync_cursor()
    ok = #expect(g_nsunk == 3 && last_sunk() == CURSOR_DEFAULT, "onto the root's own cells: default") && ok
    ok = #expect(cursor_shown() == CURSOR_DEFAULT && cursor_sets() == 3, "the readers agree") && ok

    // ── The capture wins ─────────────────────────────────────────────────
    press_at(1, 0)
    sync_cursor()
    ok = #expect(captured() == a, "the press captured the pointer leaf") && ok
    ok = #expect(g_nsunk == 4 && last_sunk() == CURSOR_POINTER, "the press is over the pointer leaf") && ok
    move_to(2, 4, u32(input.Modifier.Lmb))
    sync_cursor()
    move_to(2, 8, u32(input.Modifier.Lmb))
    sync_cursor()
    ok = #expect(g_nsunk == 4, "dragging over other nodes keeps the captured node's cursor: no call, got ", g_nsunk) && ok
    release_at(2, 4)
    sync_cursor()
    ok = #expect(captured() == NIL, "the release ended the capture") && ok
    ok = #expect(g_nsunk == 5 && last_sunk() == CURSOR_RESIZE_EW, "released over the box: its arrows, got ", last_sunk()) && ok

    // ── A relayout moves the cursor with no motion ────────────────────────
    // Hiding the pointer leaf slides everything up two rows, and the still
    // pointer at row 4 is over the root's cells now.
    set_visible(a, false)
    update(screen)
    sync_cursor()
    ok = #expect(g_nsunk == 6 && last_sunk() == CURSOR_DEFAULT, "a relayout under a still pointer: default") && ok

    // ── TextEdit: the I-beam over the text, the arrow over the gutter ─────
    reset()
    Control ed = text_edit(NIL)
    EditSource src = (lines_count, lines_line, no_insert, no_remove, nil)
    text_edit_set_source(ed, src)
    update(cell.rect(0, 0, 30, 8))
    cell.CellRect v = edit_view(ed)
    i32 g = text_edit_gutter_width(ed)
    ok = #expect(g > 0, "the gutter is on") && ok
    cell.CellPoint in_gutter = (v.col + g - 1, v.row + 1)
    cell.CellPoint in_text = (v.col + g, v.row + 1)
    ok = #expect(cursor_at(ed, in_gutter) == CURSOR_DEFAULT, "the gutter's last column: the arrow") && ok
    ok = #expect(cursor_at(ed, in_text) == CURSOR_IBEAM, "the text's first column: the I-beam") && ok
    i32 before = g_nsunk
    move_to(in_text.col, in_text.row, 0)
    sync_cursor()
    move_to(in_text.col + 3, in_text.row + 1, 0)
    sync_cursor()
    ok = #expect(g_nsunk == before + 1 && last_sunk() == CURSOR_IBEAM, "into the text: one call, I-beam") && ok
    move_to(in_gutter.col, in_gutter.row, 0)
    sync_cursor()
    ok = #expect(g_nsunk == before + 2 && last_sunk() == CURSOR_DEFAULT, "into the gutter: the arrow") && ok
    text_edit_set_gutter(ed, false)
    update(cell.rect(0, 0, 30, 8))
    ok = #expect(cursor_at(ed, in_gutter) == CURSOR_IBEAM, "with the gutter off the text starts at the view's edge") && ok

    set_cursor_sink(nil)
    reset()
    if ok:
        return 0
    return 1
