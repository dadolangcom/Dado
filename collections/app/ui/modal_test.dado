@test
// Modal focus with no window: a dialog opened over a base takes focus to its
// first focusable node; focus cannot be set outside it and Tab, `focus_next`
// and `focus_prev` cycle inside it; keys and text go to it and what it leaves
// is swallowed, never reaching the base; a quit request is not a key and is
// not swallowed; a press outside is swallowed and tells the modal; the cursor
// outside is the arrow; closing restores the focus it found exactly, or
// nothing when that node is gone; a modal removed or hidden releases the
// modality; closing a lower modal closes those above it; a capture held
// outside ends at the open; and every entry point is total over a bad handle.
package ui

import "app:input"
import "app:ui/cell"

// A focusable leaf that records every event offered to it and handles none
// but a press and the key `MD_TAKEN`.
private const i32 MD_TAKEN = 90
private [32]i32 g_md_seen
private i32 g_md_outside

private bool md_input(Control c, rawptr st, input.Event e):
    _ = st
    if c.slot >= 0 && c.slot < 32:
        g_md_seen[c.slot] = g_md_seen[c.slot] + 1
    if input.mouse_kind(e) == input.MouseKind.Press:
        return true
    return input.is_key_press(e) && e.code == MD_TAKEN

private cell.CellPoint md_measure(Control c, rawptr st):
    _ = c
    _ = st
    cell.CellPoint p = (2, 1)
    return p

private i32 md_cursor(Control c, rawptr st, cell.CellPoint p):
    _ = c
    _ = st
    _ = p
    return CURSOR_IBEAM

private Kind g_md_leaf = NO_KIND

private Control md_leaf(Control parent):
    if !kind_ok(g_md_leaf):
        Hooks h
        h.measure = md_measure
        h.input = md_input
        h.cursor = md_cursor
        g_md_leaf = register_kind("md_leaf", h)
    Control c = create(g_md_leaf, parent, nil)
    set_expand(c, true, true)
    set_focusable(c, true)
    return c

private void md_on_outside(Control c, rawptr ctx):
    _ = c
    _ = ctx
    g_md_outside = g_md_outside + 1

private i32 seen(Control c):
    return g_md_seen[c.slot]

private bool md_key(i32 code, u32 mods):
    input.Event e = (input.EventKind.Key, code, 0.0, 0.0, mods)
    return dispatch(e)

private input.Event md_mouse(i32 code, i32 col, i32 row, u32 mods):
    input.Event e = (input.EventKind.Mouse, code, f32(col) + f32(0.5), f32(row) + f32(0.5), mods)
    return e

i32 test():
    bool ok = true
    cell.CellRect screen = cell.rect(0, 0, 40, 12)
    //  root ── st (stack) ── base (leaf, fills)
    //                     └─ dl (dialog, centre, 20 x 6) ── col (vbox) ── d1, d2
    //                     └─ d2l (a second dialog, top left, 8 x 4) ── e1
    Control st = stack(NIL)
    set_expand(st, true, true)
    Control base = md_leaf(st)
    Control dl = dialog(st)
    set_anchor(dl, ANCHOR_CENTER, 20, 6, 0, 0)
    Control col = vbox(dl)
    set_expand(col, true, true)
    Control d1 = md_leaf(col)
    Control d2 = md_leaf(col)
    Control d2l = dialog(st)
    set_anchor(d2l, ANCHOR_TOP_LEFT, 8, 4, 0, 0)
    Control e1 = md_leaf(d2l)
    on_outside_pressed(dl, md_on_outside, nil)
    update(screen)
    set_focus(base)
    ok = #expect(!is_visible(dl) && modal() == NIL && !dialog_is_open(dl), "a dialog starts hidden, and nothing is modal") && ok

    // ── Open ───────────────────────────────────────────────────────────────
    dialog_open(dl)
    update(screen)
    ok = #expect(is_visible(dl) && modal() == dl && dialog_is_open(dl) && is_modal(dl), "open and modal") && ok
    ok = #expect(focused() == d1, "focus moved to its first focusable node") && ok
    ok = #expect(rect(dl) == cell.rect(10, 3, 20, 6), "centred: ", rect(dl).col, ",", rect(dl).row) && ok
    set_focus(base)
    ok = #expect(focused() == d1, "focus cannot be set outside it") && ok
    ok = #expect(focus_next() == d2 && focus_next() == d1, "focus_next cycles inside") && ok
    ok = #expect(focus_prev() == d2, "focus_prev wraps inside") && ok
    set_focus(d1)

    // ── Keys ───────────────────────────────────────────────────────────────
    i32 b0 = seen(base)
    i32 s0 = seen(d1)
    i64 sw = modal_swallowed()
    ok = #expect(md_key(65, 0), "a key nobody takes is answered as handled") && ok
    ok = #expect(seen(d1) == s0 + 1 && seen(base) == b0, "offered to the focused node, never the base") && ok
    ok = #expect(modal_swallowed() == sw + 1, "and swallowed") && ok
    ok = #expect(md_key(MD_TAKEN, 0) && modal_swallowed() == sw + 1, "a key the focused node takes is not swallowed") && ok
    input.Event tx = (input.EventKind.Text, 97, 0.0, 0.0, 0)
    ok = #expect(dispatch(tx) && seen(base) == b0, "text swallowed too") && ok
    ok = #expect(md_key(i32(input.Keycode.Tab), 0) && focused() == d2, "tab moves focus inside") && ok
    ok = #expect(md_key(i32(input.Keycode.Tab), 0x1) && focused() == d1, "shift+tab back") && ok
    ok = #expect(md_key(i32(input.Keycode.Tab), 0x2) && focused() == d1, "ctrl+tab is a key like another, swallowed") && ok
    input.Event quit = (input.EventKind.Quit, 0, 0.0, 0.0, 0)
    ok = #expect(!dispatch(quit), "a quit request is not a key: nobody took it, and it is not swallowed") && ok

    // ── The mouse ──────────────────────────────────────────────────────────
    i32 out0 = g_md_outside
    ok = #expect(dispatch(md_mouse(0, 1, 1, 0x100)), "a press outside is answered as handled") && ok
    ok = #expect(g_md_outside == out0 + 1 && seen(base) == b0, "the modal told; the base offered nothing") && ok
    ok = #expect(focused() == d1, "focus did not move") && ok
    ok = #expect(dispatch(md_mouse(-1, 2, 1, input.MOUSE_MOTION)) && g_md_outside == out0 + 1, "motion outside: swallowed, not a press") && ok
    ok = #expect(cursor_wanted() == CURSOR_DEFAULT, "the arrow over what is under the modal") && ok
    // The dialog's content is its rect less the popup box's one-cell margin,
    // (11, 4) to (28, 7); d1 has rows 4 and 5, d2 rows 6 and 7.
    ok = #expect(dispatch(md_mouse(0, 12, 6, 0x100)) && focused() == d2, "a press inside reaches it and focuses") && ok
    ok = #expect(!dispatch(md_mouse(0, 12, 6, input.MOUSE_UP)) && captured() == NIL, "its release, offered and not taken") && ok
    ok = #expect(cursor_wanted() == CURSOR_IBEAM, "the cursor inside is the node's") && ok

    // ── Close restores focus ───────────────────────────────────────────────
    dialog_close(dl)
    ok = #expect(!is_visible(dl) && modal() == NIL && !is_modal(dl), "closed") && ok
    ok = #expect(focused() == base, "focus back where it was") && ok
    b0 = seen(base)
    ok = #expect(md_key(MD_TAKEN, 0) && seen(base) == b0 + 1, "keys reach the base again") && ok
    ok = #expect(!md_key(65, 0), "and one nobody takes is unhandled again") && ok

    // ── Nothing to restore: the node that had focus is gone ────────────────
    Control spare = md_leaf(st)
    update(screen)
    set_focus(spare)
    dialog_open(dl)
    remove(spare)
    dialog_close(dl)
    ok = #expect(focused() == NIL, "the node that had focus is gone: nothing, not a guess") && ok

    // ── A modal removed or hidden releases the modality ───────────────────
    set_focus(base)
    dialog_open(dl)
    set_visible(dl, false)
    ok = #expect(modal() == NIL && focused() == base, "hidden: released, focus back") && ok
    set_visible(dl, true)
    ok = #expect(modal() == NIL, "shown again by hand is not modal") && ok
    set_visible(dl, false)
    set_visible(st, true)
    dialog_open(dl)
    set_visible(st, false)
    ok = #expect(modal() == NIL, "an ancestor hidden: released") && ok
    set_visible(st, true)
    update(screen)
    set_focus(base)
    Control gone = dialog(st)
    Control gin = md_leaf(gone)
    dialog_open(gone)
    ok = #expect(modal() == gone && focused() == gin, "a third dialog open") && ok
    remove(gone)
    ok = #expect(modal() == NIL && focused() == base, "removed: released, focus back") && ok
    ok = #expect(!is_modal(gone) && !dialog_is_open(gone), "and a bad handle now") && ok

    // ── Two open; closing the lower closes both ───────────────────────────
    set_focus(base)
    dialog_open(dl)
    dialog_open(d2l)
    ok = #expect(modal() == d2l && focused() == e1 && modal_depth() == 2, "the second is in force") && ok
    set_focus(d1)
    ok = #expect(focused() == e1, "the lower one's nodes are outside the one in force") && ok
    dialog_close(d2l)
    ok = #expect(modal() == dl && focused() == d1, "closing the top gives focus back inside the lower") && ok
    dialog_open(d2l)
    modal_close(dl)
    ok = #expect(modal() == NIL && modal_depth() == 0 && focused() == base, "closing the lower pops both, focus as the lower found it") && ok
    set_visible(dl, false)
    set_visible(d2l, false)

    // ── A capture held outside ends at the open ───────────────────────────
    update(screen)
    ok = #expect(dispatch(md_mouse(0, 1, 11, 0x100)) && captured() == base, "a press on the base captures") && ok
    dialog_open(dl)
    ok = #expect(captured() == NIL, "the open ended it") && ok
    dialog_close(dl)

    // ── Bad handles ────────────────────────────────────────────────────────
    modal_open(NIL)
    modal_close(NIL)
    dialog_open(NIL)
    dialog_close(NIL)
    dialog_open(base)
    ok = #expect(modal() == NIL && !is_modal(NIL) && !dialog_is_open(NIL) && !dialog_is_open(base), "nothing opened") && ok
    ok = #expect(!is_popup(base) && is_popup(dl) && is_popup(d2l), "a dialog is a popup; a leaf is not") && ok
    Control hid = md_leaf(st)
    set_visible(hid, false)
    modal_open(hid)
    ok = #expect(modal() == NIL, "a node out of view cannot be made modal") && ok
    modal_open(base)
    modal_open(base)
    ok = #expect(modal_depth() == 1, "a node is on the stack once") && ok
    modal_close(base)
    ok = #expect(modal() == NIL, "and off it") && ok

    reset()
    ok = #expect(modal() == NIL && modal_depth() == 0, "reset") && ok
    if ok:
        return 0
    return 1
