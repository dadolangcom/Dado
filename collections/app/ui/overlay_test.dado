@test
// Overlays with no window (a grid taken up headless with 8 x 16 cells, so the
// cells written are counted and read back): `anchor_rect`'s arithmetic; a
// stack filling its plain children and placing its anchored ones, whose
// minimums it leaves out of its own; a popup one layer above its parent and a
// dialog two; the hit test answering the topmost layer's owner first — the
// dialog over the popup over the base — and the base again the moment an
// overlay goes; and the cost of opening and closing one: its own cells, and
// not one cell of the base layer, where a child of the base hidden the same
// way (the positive control) repaints its parent.
package ui

import "app:ui/cell"
import "app:ui/grid"

// A leaf that fills its clip with blank cells in its own colours and counts
// its paints.
private [32]i32 g_ov_paints

private void ov_paint(Control c, rawptr st, cell.CellRect clip):
    _ = st
    if c.slot >= 0 && c.slot < 32:
        g_ov_paints[c.slot] = g_ov_paints[c.slot] + 1
    [4]u8 fg = [200, 200, 200, 255]
    [4]u8 bg = [10, 20, 30, 255]
    grid.fill(clip, fg, bg)

private cell.CellPoint ov_measure(Control c, rawptr st):
    _ = c
    _ = st
    cell.CellPoint p = (3, 2)
    return p

private Kind g_ov_leaf = NO_KIND

private Control ov_leaf(Control parent):
    if !kind_ok(g_ov_leaf):
        Hooks h
        h.measure = ov_measure
        h.paint = ov_paint
        g_ov_leaf = register_kind("ov_leaf", h)
    Control c = create(g_ov_leaf, parent, nil)
    set_expand(c, true, true)
    return c

private i32 paints(Control c):
    return g_ov_paints[c.slot]

// One frame as `frame.dado` runs it: the counters restarted, as many layers
// as the tree uses, the walk.
private void ov_frame(cell.CellRect screen):
    _ = grid.begin(screen.cols * 8, screen.rows * 16)
    grid.set_layers(layers_used())
    update(screen)

private bool hit_at(i32 col, i32 row, Control want, string8 what):
    Control got = hit(col, row)
    return #expect(got == want, what, ": hit(", col, ",", row, ") is slot ", got.slot, " want ", want.slot)

i32 test():
    bool ok = true

    // ── anchor_rect ────────────────────────────────────────────────────────
    cell.CellRect r = cell.rect(10, 5, 40, 20)
    cell.CellPoint sz = (10, 4)
    cell.CellPoint no = (0, 0)
    cell.CellPoint in2 = (2, 1)
    ok = #expect(anchor_rect(r, sz, ANCHOR_TOP_LEFT, no) == cell.rect(10, 5, 10, 4), "top left") && ok
    ok = #expect(anchor_rect(r, sz, ANCHOR_TOP_RIGHT, in2) == cell.rect(38, 6, 10, 4), "top right, inset 2 and 1") && ok
    ok = #expect(anchor_rect(r, sz, ANCHOR_CENTER, no) == cell.rect(25, 13, 10, 4), "centre") && ok
    ok = #expect(anchor_rect(r, sz, ANCHOR_BOTTOM, no) == cell.rect(25, 21, 10, 4), "bottom middle") && ok
    ok = #expect(anchor_rect(r, sz, ANCHOR_BOTTOM_RIGHT, in2) == cell.rect(38, 20, 10, 4), "bottom right, inset") && ok
    cell.CellPoint huge = (100, 100)
    ok = #expect(anchor_rect(r, huge, ANCHOR_CENTER, in2) == r, "too big: cut to the rect, inset and all") && ok
    ok = #expect(anchor_rect(r, sz, 42, no) == anchor_rect(r, sz, ANCHOR_TOP_LEFT, no), "an anchor out of range is the top left") && ok
    cell.CellPoint neg = (-3, -3)
    ok = #expect(anchor_rect(r, neg, ANCHOR_CENTER, neg) == cell.rect(30, 15, 0, 0), "negatives read as zero") && ok

    // ── The tree ───────────────────────────────────────────────────────────
    ok = #expect(grid.up_headless(8, 16), "a headless grid") && ok
    cell.CellRect screen = cell.rect(0, 0, 30, 10)
    _ = grid.begin(30 * 8, 10 * 16)
    //  root ── st (stack) ── base (leaf, fills)
    //                     ├─ pop (popup, top right, 10 x 4) ── pl (leaf)
    //                     └─ dl (dialog, centre, 12 x 6) ── dleaf (leaf)
    //                     └─ side (panel, later) ── plain (leaf, base layer)
    Control st = stack(NIL)
    set_expand(st, true, true)
    Control base = ov_leaf(st)
    Control pop = popup(st)
    set_anchor(pop, ANCHOR_TOP_RIGHT, 10, 4, 0, 0)
    Control pl = ov_leaf(pop)
    Control dl = dialog(st)
    set_anchor(dl, ANCHOR_CENTER, 12, 6, 0, 0)
    Control dleaf = ov_leaf(dl)
    set_focusable(dleaf, true)
    ov_frame(screen)
    ok = #expect(node_layer(base) == grid.BASE && node_layer(pop) == 1 && node_layer(pl) == 1 && node_layer(dl) == 2, "popup one up, dialog two") && ok
    ok = #expect(rect(pop) == cell.rect(20, 0, 10, 4) && rect(pl) == cell.rect(21, 1, 8, 2), "the popup at the top right, its leaf inside its margin") && ok
    ok = #expect(minimum(st).col == 3 && minimum(st).row == 2, "the stack's minimum is the base's: the anchored popups are not in it") && ok
    ok = #expect(anchor_of(pop) == ANCHOR_TOP_RIGHT && anchor_of(base) == ANCHOR_NONE && anchor_of(NIL) == ANCHOR_NONE, "anchors read back") && ok
    ok = hit_at(22, 2, pl, "over the popup: its leaf, on layer 1") && ok
    ok = hit_at(20, 0, pop, "its margin: the popup") && ok
    ok = hit_at(5, 5, base, "elsewhere: the base") && ok

    // ── Hide the popup: its cells blanked in its layer; the base untouched ─
    i32 bp = paints(base)
    set_visible(pop, false)
    ok = hit_at(22, 2, base, "hidden: the base answers at once") && ok
    ov_frame(screen)
    grid.Stats gs = grid.stats()
    ok = #expect(gs.base_cells == 0 && paints(base) == bp, "closing an overlay writes no base cell: ", gs.base_cells) && ok
    ok = #expect(gs.cells_written == 40, "it blanks the 40 cells it covered in its layer: ", gs.cells_written) && ok
    ok = #expect(grid.cell_at_layer(1, 22, 2).bg[3] == 0, "blank, transparent") && ok
    ok = #expect(layers_used() == 1, "no layer above the base in use") && ok

    // ── Show it: its own cells only ────────────────────────────────────────
    set_visible(pop, true)
    ov_frame(screen)
    gs = grid.stats()
    ok = #expect(gs.base_cells == 0 && paints(base) == bp, "opening writes no base cell") && ok
    ok = #expect(gs.cells_written == 40, "it paints its 40 cells, margins and leaf: ", gs.cells_written) && ok
    ok = hit_at(22, 2, pl, "shown: the popup's leaf again") && ok
    ok = #expect(grid.cell_at_layer(1, 22, 2).bg == [10, 20, 30, 255], "its leaf's cells on layer 1") && ok
    ok = #expect(grid.cell_at(22, 2).bg == [10, 20, 30, 255], "and the base's still under it") && ok

    // ── The dialog over the popup ──────────────────────────────────────────
    dialog_open(dl)
    ov_frame(screen)
    gs = grid.stats()
    ok = #expect(rect(dl) == cell.rect(9, 2, 12, 6), "centred: ", rect(dl).col, ",", rect(dl).row) && ok
    ok = #expect(gs.base_cells == 0 && paints(base) == bp && paints(pl) >= 1, "opening a dialog writes no base cell") && ok
    ok = #expect(gs.cells_written == 72, "its 72 cells: ", gs.cells_written) && ok
    ok = hit_at(20, 3, dl, "where dialog and popup overlap: the dialog, the higher layer") && ok
    ok = hit_at(19, 3, dleaf, "the dialog's leaf") && ok
    ok = hit_at(25, 1, pl, "the popup where the dialog is not") && ok
    ok = hit_at(2, 8, base, "the base where neither is") && ok
    i32 pp = paints(pl)
    dialog_close(dl)
    ov_frame(screen)
    gs = grid.stats()
    ok = #expect(gs.base_cells == 0 && paints(base) == bp && paints(pl) == pp, "closing it: no base cell, and the popup under it not repainted") && ok
    ok = #expect(gs.cells_written == 72, "only its own 72 blanked: ", gs.cells_written) && ok
    ok = hit_at(20, 3, pop, "the popup answers where the dialog was") && ok
    ok = hit_at(21, 2, pl, "and its leaf") && ok
    ok = #expect(grid.cell_at_layer(1, 21, 2).bg == [10, 20, 30, 255], "its cells on layer 1 kept") && ok

    // ── Removed: the same ──────────────────────────────────────────────────
    remove(pop)
    ov_frame(screen)
    gs = grid.stats()
    ok = #expect(gs.base_cells == 0 && paints(base) == bp, "removing a popup writes no base cell") && ok
    ok = hit_at(22, 2, base, "and the base answers") && ok

    // ── The positive control: a child on the base layer hidden ─────────────
    // A panel, which paints the cells its hidden child leaves; a box would
    // paint none and leave them.
    Control side = panel(st)
    Control plain = ov_leaf(side)
    ov_frame(screen)
    set_visible(plain, false)
    ov_frame(screen)
    gs = grid.stats()
    ok = #expect(gs.base_cells > 0, "a base child's parent repaints: the counter counts, ", gs.base_cells) && ok
    ok = #expect(gs.cells_written == gs.base_cells, "and every cell of that is the base's") && ok

    reset()
    grid.down()
    if ok:
        return 0
    return 1
