// The root's container and the arithmetic every stacking box shares.
//
// Layout is two-phase and in whole cells: a container's minimum is computed
// from its children's minimums (the measure hook), and its children's
// rectangles from its own final rectangle (the arrange hook). Each hook here
// only gathers the children's numbers and hands them to a pure helper —
// `vbox_minimum`, `vbox_arrange`, `margin_minimum`, `margin_inner` — which
// takes everything as arguments, so the arithmetic is tested with no tree, no
// window and no face. The VBox lives here because the root is one; every other
// box (widgets_box.dado) follows the same split and gathers its children
// through `gather` below.
package ui

import "app:ui/cell"

// ── VBox ───────────────────────────────────────────────────────────────────
//
// Children stacked top to bottom in child order, each as wide as the box.
// Each child gets its minimum rows. Rows left over are shared equally among
// the children that expand vertically, and the remainder of that division
// goes one row each to the first expanding children in order. When the box is
// shorter than the sum of minimums, children get their minimums in order
// until the rows run out, and the rest get zero rows.

// A VBox's minimum: the widest child's columns and the sum of the children's
// rows. Negative entries count as zero.
cell.CellPoint vbox_minimum([]cell.CellPoint mins):
    i32 cols = 0
    i32 rows = 0
    for m in mins:
        if m.col > cols:
            cols = m.col
        if m.row > 0:
            rows = rows + m.row
    cell.CellPoint p = (cols, rows)
    return p

// Fill `out[k]` with the rectangle of child `k` inside `inside`, for `k` below
// the shortest of the three runs; answers the rows used, which is at most
// `inside.rows` (and zero when that is zero or less). Negative minimums count
// as zero; a negative box width gives zero-width children.
i32 vbox_arrange(cell.CellRect inside, []cell.CellPoint mins, []bool expand, []cell.CellRect out):
    return axis_arrange(inside, mins, expand, out, false)

// The stack rule on one axis — rows when `across` is false, columns when it is
// true — and the full extent of the other: each child its minimum along the
// axis, leftover shared equally among the expanding children with the
// remainder one each to the first expanders in order, and in a shortage the
// minimums in order until the room runs out. Answers the extent used.
private i32 axis_arrange(cell.CellRect inside, []cell.CellPoint mins, []bool expand, []cell.CellRect out, bool across):
    i32 n = i32(#len(mins))
    if i32(#len(expand)) < n:
        n = i32(#len(expand))
    if i32(#len(out)) < n:
        n = i32(#len(out))
    if n <= 0:
        return 0
    i32 avail = inside.rows
    i32 thick = inside.cols
    i32 at = inside.row
    if across:
        avail = inside.cols
        thick = inside.rows
        at = inside.col
    if avail < 0:
        avail = 0
    if thick < 0:
        thick = 0
    i32 sum = 0
    i32 growers = 0
    for k in 0..<n:
        i32 m = along(mins[k], across)
        if m > 0:
            sum = sum + m
        if expand[k]:
            growers = growers + 1
    i32 share = 0
    i32 extra = 0
    if avail > sum && growers > 0:
        share = (avail - sum) / growers
        extra = (avail - sum) % growers
    i32 left = avail
    i32 seen = 0
    for k in 0..<n:
        i32 ext = along(mins[k], across)
        if ext < 0:
            ext = 0
        if expand[k]:
            ext = ext + share
            if seen < extra:
                ext = ext + 1
            seen = seen + 1
        if ext > left:
            ext = left
        cell.CellRect r = (inside.col, at, thick, ext)
        if across:
            r = cell.rect(at, inside.row, ext, thick)
        out[k] = r
        at = at + ext
        left = left - ext
    return avail - left

// A point's extent on the stacking axis: columns across, rows down.
private i32 along(cell.CellPoint p, bool across):
    if across:
        return p.col
    return p.row

// ── MarginBox ──────────────────────────────────────────────────────────────
//
// Every child gets the box's rectangle inset by the four margins; the box's
// minimum is the largest child minimum on each axis plus the margins.

// Margins are never negative; `set_margins` and `margin_box` clamp at zero.
private type Margins: (i32 left, i32 top, i32 right, i32 bottom)

private type MarginsPtr: ^Margins

cell.CellPoint margin_minimum([]cell.CellPoint mins, i32 left, i32 top, i32 right, i32 bottom):
    i32 cols = 0
    i32 rows = 0
    for m in mins:
        if m.col > cols:
            cols = m.col
        if m.row > rows:
            rows = m.row
    // Summed in i64 and saturated, so margins near the top of `i32` cannot
    // wrap into a small minimum.
    i64 wc = i64(cols) + i64(left) + i64(right)
    i64 wr = i64(rows) + i64(top) + i64(bottom)
    if wc > 2147483647:
        wc = 2147483647
    if wr > 2147483647:
        wr = 2147483647
    cell.CellPoint p = (i32(wc), i32(wr))
    return p

cell.CellRect margin_inner(cell.CellRect r, i32 left, i32 top, i32 right, i32 bottom):
    return cell.inset(r, left, top, right, bottom)

// ── The kinds ──────────────────────────────────────────────────────────────

private Kind g_vbox_kind = NO_KIND
private Kind g_margin_kind = NO_KIND

// Scratch runs for gathering one container's children, grown to the largest
// child count seen and kept. A hook runs to completion before the walk enters
// any child, so one set serves every container.
private ref []cell.CellPoint g_mins
private ref []bool           g_expand
private ref []bool           g_expand_h
private ref []cell.CellRect  g_out

private Kind vbox_kind():
    if !kind_ok(g_vbox_kind):
        Hooks h
        h.measure = vbox_measure_hook
        h.arrange = vbox_arrange_hook
        h.paint = nil
        h.input = nil
        h.free = nil
        g_vbox_kind = register_kind("vbox", h)
    return g_vbox_kind

private Kind margin_kind():
    if !kind_ok(g_margin_kind):
        Hooks h
        h.measure = margin_measure_hook
        h.arrange = margin_arrange_hook
        h.paint = nil
        h.input = nil
        h.free = nil
        g_margin_kind = register_kind("margin_box", h)
    return g_margin_kind

private bool scratch(i32 n):
    capture_alloc()
    i32 want = n
    if want < 8:
        want = 8
    if g_mins == nil:
        g_mins = #make([]cell.CellPoint, want, g_alloc)
        g_expand = #make([]bool, want, g_alloc)
        g_expand_h = #make([]bool, want, g_alloc)
        g_out = #make([]cell.CellRect, want, g_alloc)
        if g_mins == nil || g_expand == nil || g_expand_h == nil || g_out == nil:
            g_mins = nil
            g_expand = nil
            g_expand_h = nil
            g_out = nil
            return false
    if i32(#len(g_mins)) < n:
        i32 grow = i32(#len(g_mins)) * 2
        if grow < n:
            grow = n
        if !#resize(g_mins, grow) || !#resize(g_expand, grow) || !#resize(g_expand_h, grow) || !#resize(g_out, grow):
            return false
    return true

// Gather every child's minimum (zero for an invisible child) and whether it
// expands vertically (`g_expand`) and horizontally (`g_expand_h`); an
// invisible child expands neither way. Answers the count, or -1 when the
// scratch runs cannot grow.
private i32 gather(Control c):
    i32 n = child_count(c)
    if !scratch(n):
        return -1
    i32 k = 0
    Control ch = first_child(c)
    for valid(ch) && k < n:
        g_mins[k] = minimum(ch)
        g_expand[k] = is_visible(ch) && expands_v(ch)
        g_expand_h[k] = is_visible(ch) && expands_h(ch)
        k = k + 1
        ch = next_sibling(ch)
    return k

private cell.CellPoint vbox_measure_hook(Control c, rawptr st):
    _ = st
    i32 n = gather(c)
    if n <= 0:
        return zero_point()
    return vbox_minimum(g_mins[0..<n])

// The children tile rows `[top, top + used)` at full width, so with the box's
// rectangle unchanged they cover less than they did exactly when `used`
// shrank; the box then repaints to clear the rows they left.
private void vbox_arrange_hook(Control c, rawptr st, cell.CellRect r):
    _ = st
    i32 n = gather(c)
    if n <= 0:
        return
    i32 before = 0
    Control ch = first_child(c)
    for valid(ch):
        before = before + rect(ch).rows
        ch = next_sibling(ch)
    i32 used = vbox_arrange(r, g_mins[0..<n], g_expand[0..<n], g_out[0..<n])
    i32 k = 0
    ch = first_child(c)
    for valid(ch) && k < n:
        set_rect(ch, g_out[k])
        k = k + 1
        ch = next_sibling(ch)
    if used < before:
        mark_paint(c)

private cell.CellPoint margin_measure_hook(Control c, rawptr st):
    ^Margins m = MarginsPtr(st)
    i32 n = gather(c)
    if n < 0:
        n = 0
    return margin_minimum(g_mins[0..<n], m.left, m.top, m.right, m.bottom)

private void margin_arrange_hook(Control c, rawptr st, cell.CellRect r):
    ^Margins m = MarginsPtr(st)
    cell.CellRect inner = margin_inner(r, m.left, m.top, m.right, m.bottom)
    Control ch = first_child(c)
    for valid(ch):
        set_rect(ch, inner)
        ch = next_sibling(ch)

// ── Constructors ───────────────────────────────────────────────────────────

// A vertical box under `parent` (under the root for `NIL`); `NIL` wherever
// `create` would answer it.
Control vbox(Control parent):
    return create(vbox_kind(), parent, nil)

// A margin box under `parent`, its margins clamped at zero.
Control margin_box(Control parent, i32 left, i32 top, i32 right, i32 bottom):
    Control c = create_owned(margin_kind(), parent, i64(#size(Margins)))
    set_margins(c, left, top, right, bottom)
    return c

// Change a margin box's margins and mark it for layout. Does nothing to a node
// that is not a live margin box, and nothing while `update` runs.
void set_margins(Control c, i32 left, i32 top, i32 right, i32 bottom):
    if !valid(c) || kind(c) != g_margin_kind || g_phase != PHASE_IDLE:
        return
    rawptr st = state(c)
    if st == nil:
        return
    ^Margins m = MarginsPtr(st)
    m.left = clamp0(left)
    m.top = clamp0(top)
    m.right = clamp0(right)
    m.bottom = clamp0(bottom)
    mark_layout(c)

// A margin box's margins as `(left, top, right, bottom)`; zeros for anything
// else.
(i32 left, i32 top, i32 right, i32 bottom) margins(Control c):
    if !valid(c) || kind(c) != g_margin_kind || state(c) == nil:
        return (0, 0, 0, 0)
    ^Margins m = MarginsPtr(state(c))
    return (m.left, m.top, m.right, m.bottom)

private i32 clamp0(i32 v):
    if v < 0:
        return 0
    return v
