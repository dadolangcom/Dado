@test
// The vocabulary's arithmetic, with no window and no face: rectangles, column
// measurement with tabs, wide and combining clusters, and the seam's
// identities.
package cell

i32 test():
    bool ok = true

    // The record is the GPU's instance layout, twelve bytes.
    ok = #expect(i32(#size(Cell)) == CELL_BYTES, "sizeof Cell ", #size(Cell)) && ok

    // Rectangles.
    CellRect a = rect(0, 0, 10, 5)
    CellRect b = rect(8, 3, 10, 10)
    CellRect i = intersect(a, b)
    ok = #expect(i.col == 8 && i.row == 3 && i.cols == 2 && i.rows == 2, "intersect ", i.col, ",", i.row, " ", i.cols, "x", i.rows) && ok
    ok = #expect(is_empty(intersect(a, rect(10, 0, 3, 3))), "touching is empty") && ok
    ok = #expect(contains(a, 9, 4) && !contains(a, 10, 4), "contains edge") && ok
    ok = #expect(!contains(rect(0, 0, 0, 5), 0, 0), "empty contains nothing") && ok
    CellRect s = inset(a, 1, 1, 1, 1)
    ok = #expect(s.col == 1 && s.cols == 8 && s.rows == 3, "inset") && ok
    ok = #expect(inset(a, 6, 0, 6, 0).cols == 0, "inset floors at zero") && ok

    // Columns: ASCII, a tab from column 0 and from column 1, a wide cluster,
    // a combining mark, a stray control.
    ok = #expect(columns("abc") == 3, "abc") && ok
    ok = #expect(columns("\tx") == TAB_COLUMNS + 1, "tab from 0 ", columns("\tx")) && ok
    ok = #expect(columns("a\tx") == TAB_COLUMNS + 1, "tab from 1 ", columns("a\tx")) && ok
    ok = #expect(columns("\xE6\x97\xA5x") == 3, "wide ", columns("\xE6\x97\xA5x")) && ok
    ok = #expect(columns("e\xCC\x81x") == 2, "e+acute,x ", columns("e\xCC\x81x")) && ok
    ok = #expect(columns("a\x01b") == 3, "control takes a column ", columns("a\x01b")) && ok

    // column_of lands a byte inside a cluster at the cluster's own column.
    ok = #expect(column_of("e\xCC\x81x", 2) == 0, "inside the accent") && ok
    ok = #expect(column_of("e\xCC\x81x", 3) == 1, "after the accent") && ok
    ok = #expect(column_of("\xE6\x97\xA5x", 3) == 2, "after wide") && ok
    ok = #expect(column_of("ab", 99) == 2, "past end") && ok

    // byte_at_column: inside a tab and inside a wide cluster answer its start.
    (i32 tb, i32 tc) = byte_at_column("a\tx", 2)
    ok = #expect(tb == 1 && tc == 1, "inside a tab ", tb, " ", tc) && ok
    (i32 wb, i32 wc) = byte_at_column("\xE6\x97\xA5x", 1)
    ok = #expect(wb == 0 && wc == 0, "right half of wide ", wb, " ", wc) && ok
    (i32 eb, i32 ec) = byte_at_column("ab", 7)
    ok = #expect(eb == 2 && ec == 2, "past the end ", eb, " ", ec) && ok

    // Walked from a mark (a boundary a walk from the start reaches, and its
    // column), every answer at or past it is the plain walk's; a tab after
    // the mark still reaches its stop from the line's column 0.
    string8 ml = "a\t\xE6\x97\xA5e\xCC\x81\tz"
    ColumnMark mk = mark(2, column_of(ml, 2))
    bool from_ok = true
    for b in 2..<14:
        from_ok = from_ok && column_from(ml, mk.byte, mk.col, b) == column_of(ml, b)
        from_ok = from_ok && i32(visual_from(ml, mk, LogicalOffset(b))) == i32(visual_of(ml, LogicalOffset(b)))
    for c in mk.col..<14:
        (i32 fb, i32 fs) = byte_at_column_from(ml, mk.byte, mk.col, c)
        (i32 pb, i32 ps) = byte_at_column(ml, c)
        from_ok = from_ok && fb == pb && fs == ps
        from_ok = from_ok && i32(logical_from(ml, mk, VisualCol(c))) == i32(logical_of(ml, VisualCol(c)))
    ok = #expect(from_ok, "walks from a mark answer as walks from the start") && ok

    // The seam: identities today, and the types keep offsets and columns apart.
    string8 line = "e\xCC\x81\xE6\x97\xA5z"
    ok = #expect(i32(visual_of(line, LogicalOffset(3))) == 1, "visual_of") && ok
    ok = #expect(i32(logical_of(line, VisualCol(2))) == 3, "logical_of inside wide") && ok
    Caret c = caret(0)
    c = next_visual(line, c)
    ok = #expect(i32(c.offset) == 3, "next over the accent ", i32(c.offset)) && ok
    c = next_visual(line, c)
    ok = #expect(i32(c.offset) == 6, "next over wide ", i32(c.offset)) && ok
    c = next_visual(line, next_visual(line, c))
    ok = #expect(i32(c.offset) == 7, "stays at the end ", i32(c.offset)) && ok
    c = prev_visual(line, caret(6))
    ok = #expect(i32(c.offset) == 3, "prev over wide ", i32(c.offset)) && ok
    ok = #expect(i32(prev_visual(line, caret(0)).offset) == 0, "stays at the start") && ok

    [2]Run rs
    ok = #expect(runs(line, Direction.Rtl, rs[:]) == 1 && rs[0].end == 7 && rs[0].dir == Direction.Ltr, "one ltr run") && ok
    [2]CellRect out
    ok = #expect(span_rects(line, 4, LogicalOffset(7), LogicalOffset(3), out[:]) == 1, "span count") && ok
    ok = #expect(out[0].col == 1 && out[0].cols == 3 && out[0].row == 4, "span rect ", out[0].col, " ", out[0].cols) && ok
    ok = #expect(span_rects(line, 0, LogicalOffset(3), LogicalOffset(3), out[:]) == 0, "empty span") && ok

    if ok: return 0
    return 1
