// app:ui/cell — the bidirectional seam: built now, filled later.
//
// Right-to-left text is in scope and its algorithm is not written. What makes
// that deferral safe is that bidi is a *permutation*: it changes which column
// each cluster sits in, and nothing else — not a cluster's width, not a line's
// width, not a column count. So a text widget that never computes a column or
// moves a caret except through the functions here can have bidi added later by
// changing their bodies, and one that does arithmetic on offsets cannot.
//
// The six parts of the seam, each an identity or a length of one today:
//
// 1. **`LogicalOffset` and `VisualCol` are different types.** A byte offset
//    into the text and a column on the screen are distinct, so passing one
//    where the other is wanted does not compile. `visual_of` and `logical_of`
//    convert, and today they are `column_of` and `byte_at_column`.
//    `visual_from` and `logical_from` are the same conversions walked from a
//    `ColumnMark` a caller kept, so a long line need not be walked from its
//    start for every question; a mark is a place in logical order, and bidi
//    will have to answer from one by the runs that follow it.
// 2. **A line is a list of runs with a direction.** `runs` answers one
//    left-to-right run covering the line.
// 3. **A selection is a list of rectangles.** `span_rects` answers one.
// 4. **A caret is an offset and an affinity**, and the affinity is carried and
//    ignored: at a direction boundary one offset has two screen positions, and
//    the affinity is what will choose between them.
// 5. **A caret moves through `next_visual` and `prev_visual`**, never by
//    adding to its offset. Today they step one cluster in logical order.
// 6. **A paragraph has a direction**, a field on whatever holds the text,
//    defaulting to `Direction.Ltr`. It is passed to `runs` and not read yet.
package cell

import "core:chars"

enum Direction: (
    Ltr = 0,
    Rtl = 1,
)

// Which side of an offset a caret belongs to when one offset has two screen
// positions. `After` is the ordinary case: the caret sits before the cluster
// that begins at its offset.
enum Affinity: (
    Before = 0,
    After  = 1,
)

distinct type LogicalOffset: i32
distinct type VisualCol: i32

// A stretch of a line in one direction: bytes `start` up to `end`.
type Run: (i32 start, i32 end, Direction dir)

type Caret: (LogicalOffset offset, Affinity affinity)

// A place in a multi-line text: a line index and a byte offset into that
// line. The byte offset is logical — it becomes a column only through
// `visual_of` — and a position is always at a cluster boundary once a text
// widget has placed it.
type TextPos: (i64 line, i32 byte)

TextPos pos(i64 line, i32 byte):
    TextPos p = (line, byte)
    return p

// Whether `a` comes before `b` in the text.
bool pos_before(TextPos a, TextPos b):
    if a.line != b.line:
        return a.line < b.line
    return a.byte < b.byte

Caret caret(i32 offset):
    Caret c = (LogicalOffset(offset), Affinity.After)
    return c

// The runs of `line` in visual order, written into `out`; answers how many.
// Today: one left-to-right run over the whole line, whatever `paragraph` says,
// and zero when `out` has no room.
i32 runs(string8 line, Direction paragraph, []Run out):
    if #len(out) < 1:
        return 0
    Run r = (0, i32(#len(line)), Direction.Ltr)
    out[0] = r
    return 1

VisualCol visual_of(string8 line, LogicalOffset at):
    return VisualCol(column_of(line, i32(at)))

LogicalOffset logical_of(string8 line, VisualCol col):
    (i32 byte, i32 _) = byte_at_column(line, i32(col))
    return LogicalOffset(byte)

// A place on a line that a walk from its start reaches: a cluster boundary
// `byte` and the column `col` it begins at. `column_from` says why nothing
// else will do.
type ColumnMark: (i32 byte, i32 col)

ColumnMark mark(i32 byte, i32 col):
    ColumnMark m = (byte, col)
    return m

// `visual_of`, walked from `from`; the same answer for any `at` at or past
// `from.byte`.
VisualCol visual_from(string8 line, ColumnMark from, LogicalOffset at):
    return VisualCol(column_from(line, from.byte, from.col, i32(at)))

// `logical_of`, walked from `from`; the same answer for any `col` at or past
// `from.col`.
LogicalOffset logical_from(string8 line, ColumnMark from, VisualCol col):
    (i32 byte, i32 _) = byte_at_column_from(line, from.byte, from.col, i32(col))
    return LogicalOffset(byte)

// One cluster to the right on screen. At the end of the line it stays put;
// crossing to the next line is the caller's business, because only the caller
// knows there is one.
Caret next_visual(string8 line, Caret c):
    i32 n = i32(#len(line))
    i32 at = i32(c.offset)
    if at >= n:
        return caret(n)
    return caret(chars.cluster_end(line, at))

// One cluster to the left on screen. At the start of the line it stays put.
Caret prev_visual(string8 line, Caret c):
    i32 at = i32(c.offset)
    if at <= 0:
        return caret(0)
    return caret(chars.cluster_start(line, at))

// The screen rectangles covering bytes `a` up to `b` of `line`, drawn on
// `row`, written into `out`; answers how many. Today one rectangle, or none
// when the span is empty or `out` has no room. The order of `a` and `b` does
// not matter.
i32 span_rects(string8 line, i32 row, LogicalOffset a, LogicalOffset b, []CellRect out):
    if #len(out) < 1:
        return 0
    i32 lo = i32(a)
    i32 hi = i32(b)
    if hi < lo:
        i32 t = lo
        lo = hi
        hi = t
    i32 c0 = column_of(line, lo)
    i32 c1 = column_of(line, hi)
    if c1 <= c0:
        return 0
    out[0] = rect(c0, row, c1 - c0, 1)
    return 1
