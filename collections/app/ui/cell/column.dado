// app:ui/cell — columns: text measurement on a grid, which is counting.
//
// A line of text occupies a whole number of columns, and how many is a
// property of its bytes alone: no face, no kerning, no advance. That is the
// point of the grid. A cluster takes the columns `chars.cluster_width` gives
// it, with two exceptions that belong to an editor rather than to text:
//
// - **A tab reaches the next tab stop.** Stops are every `TAB_COLUMNS`
//   columns from the start of the line, so a tab's width depends on the column
//   it starts at, and a line must be measured from its start.
// - **Any other control takes one column and is drawn as a replacement
//   glyph.** `chars` gives a control zero columns, which is right for a
//   terminal and wrong for an editor: a zero-width byte in a file cannot be
//   seen, selected or deleted. A CR before an LF is not in a line at all by
//   the time it gets here — the loader splits lines on the pair.
//
// Every function takes byte offsets as `i32` because `chars` does, and answers
// any offset: below zero reads as zero, past the end as the end.
package cell

import "core:chars"

// Columns between tab stops. A `@const`, so `-D TAB_COLUMNS=8` changes it for
// a build.
@const i32 TAB_COLUMNS = 4

// Columns taken by the cluster that begins at byte `at`, when it begins at
// column `col`. Zero only at or past the end.
i32 cluster_columns_at(string8 s, i32 at, i32 col):
    i32 n = i32(#len(s))
    if at < 0:
        at = 0
    if at >= n:
        return 0
    if col < 0:
        col = 0
    u8 b = u8(s[at])
    if b == 9:
        i32 stop = TAB_COLUMNS
        if stop < 1:
            stop = 1
        return stop - col % stop
    i32 w = chars.cluster_width(s, at)
    if w == 0:
        return 1
    return w

// Columns `s` takes, measured from column 0.
i32 columns(string8 s):
    i32 n = i32(#len(s))
    i32 at = 0
    i32 col = 0
    for at < n:
        col = col + cluster_columns_at(s, at, col)
        at = chars.cluster_end(s, at)
    return col

// The column where the cluster containing byte `upto` begins — the columns of
// everything before it. A byte in the middle of a cluster answers the
// cluster's own column, so a caret can never be drawn inside an accent.
i32 column_of(string8 s, i32 upto):
    return column_from(s, 0, 0, upto)

// `column_of`, walking from byte `at` at column `col` rather than from the
// line's start. `(at, col)` must be a place a walk from the start reaches: a
// cluster boundary and the columns before it, as `column_of(s, at)` answers
// them (a tab's width depends on its column, so any other pair measures the
// rest of the line wrongly). The answer is `column_of`'s for every `upto` at
// or past `at`; below `at` it is `col`. The cost is the bytes from `at` to
// `upto`, which is what lets a caller that keeps such places measure a long
// line without walking it from its start.
i32 column_from(string8 s, i32 at, i32 col, i32 upto):
    i32 n = i32(#len(s))
    if at < 0:
        at = 0
    for at < n:
        i32 next = chars.cluster_end(s, at)
        if next > upto:
            return col
        col = col + cluster_columns_at(s, at, col)
        at = next
    return col

// The byte where the cluster covering column `col` begins, and the column
// that cluster begins at (which is less than `col` inside a tab or the right
// half of a wide cluster). A column past the end answers the end of the line
// and the line's width.
(i32 byte, i32 start) byte_at_column(string8 s, i32 col):
    return byte_at_column_from(s, 0, 0, col)

// `byte_at_column`, walking from byte `at` at column `c`, a place as
// `column_from` requires. The answer is `byte_at_column`'s for every `col` at
// or past `c`; below `c` it is `(at, c)`.
(i32 byte, i32 start) byte_at_column_from(string8 s, i32 at, i32 c, i32 col):
    i32 n = i32(#len(s))
    if at < 0:
        at = 0
    for at < n:
        i32 w = cluster_columns_at(s, at, c)
        if col < c + w:
            return (at, c)
        c = c + w
        at = chars.cluster_end(s, at)
    return (n, c)
