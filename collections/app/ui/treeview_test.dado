@test
// The Tree over a headless 8 x 16 grid. Its arithmetic with no tree
// (`tree_clamp_top`, `tree_follow`, `tree_index_after_toggle`,
// `tree_row_columns`). A synthetic source of a million flat rows whose every
// function counts its calls: a paint asks only for the rows in view, and so
// do the keys that cross the whole list; PageDown and End bring the selection
// into view; the wheel scrolls without moving it, a fraction of a notch kept,
// and the hover look stays on the row under a still pointer.
// A small folder source: Right and Left expanding, entering, collapsing and
// climbing; Enter toggling a folder and activating a file; the selection kept
// on its row across a toggle; a click on a chevron toggling and nothing else;
// clicks selecting (every click signalled) and double-clicks toggling and
// activating; the looks as focus comes and goes; one icon per row inked, and
// a chevron for each folder; and the arrow cursor.
package ui

import "app:input"
import "app:ui/cell"
import "app:ui/grid"

// ── A million flat rows ────────────────────────────────────────────────────

private type Flat: (i64 n, i64 counts, i64 depths, i64 labels, i64 flags, i64 icons)
private type FlatPtr: ^Flat

private i64 flat_count(rawptr ctx):
    ^Flat f = FlatPtr(ctx)
    f.counts = f.counts + 1
    return f.n

private i32 flat_depth(rawptr ctx, i64 i):
    _ = i
    ^Flat f = FlatPtr(ctx)
    f.depths = f.depths + 1
    return 0

private string8 flat_label(rawptr ctx, i64 i):
    _ = i
    ^Flat f = FlatPtr(ctx)
    f.labels = f.labels + 1
    return "row"

private bool flat_flag(rawptr ctx, i64 i):
    _ = i
    ^Flat f = FlatPtr(ctx)
    f.flags = f.flags + 1
    return false

private Icon flat_icon(rawptr ctx, i64 i):
    _ = i
    ^Flat f = FlatPtr(ctx)
    f.icons = f.icons + 1
    return Icon.File

// ── A small folder tree ────────────────────────────────────────────────────
//
//   0 src/         depth 0
//   1   a.dado      depth 1
//   2   lib/       depth 1
//   3     x.dado    depth 2
//   4     y.dado    depth 2
//   5   b.dado      depth 1
//   6 README       depth 0
//
// Every folder starts collapsed. `vis` holds the nodes in view, rebuilt on
// each toggle.

private type Files: (
    [7]i32  depth,
    [7]bool dir,
    [7]bool open,
    [7]i32  vis,
    i32     nvis,
    i32     toggles,
)
private type FilesPtr: ^Files

private void files_rebuild(^Files f):
    f.nvis = 0
    i32 hide_below = -1
    for k in 0..<7:
        if hide_below >= 0 && f.depth[k] > hide_below:
            continue
        hide_below = -1
        f.vis[f.nvis] = i32(k)
        f.nvis = f.nvis + 1
        if f.dir[k] && !f.open[k]:
            hide_below = f.depth[k]

private i64 files_count(rawptr ctx):
    return i64(FilesPtr(ctx).nvis)

private i32 files_depth(rawptr ctx, i64 i):
    ^Files f = FilesPtr(ctx)
    return f.depth[f.vis[i]]

private string8 files_label(rawptr ctx, i64 i):
    ^Files f = FilesPtr(ctx)
    [7]string8 names = ["src", "a.dado", "lib", "x.dado", "y.dado", "b.dado", "README"]
    return names[f.vis[i]]

private bool files_has(rawptr ctx, i64 i):
    ^Files f = FilesPtr(ctx)
    return f.dir[f.vis[i]]

private bool files_open(rawptr ctx, i64 i):
    ^Files f = FilesPtr(ctx)
    return f.open[f.vis[i]]

private void files_toggle(rawptr ctx, i64 i):
    ^Files f = FilesPtr(ctx)
    i32 k = f.vis[i]
    f.open[k] = !f.open[k]
    f.toggles = f.toggles + 1
    files_rebuild(f)

// ── Driving it ─────────────────────────────────────────────────────────────

private i32 g_tv_sel_n
private i32 g_tv_act_n
private i32 g_tv_tog_tv_n
private i64 g_tv_last = -9

private void tv_on_sel(Control c, rawptr ctx):
    _ = ctx
    g_tv_sel_n = g_tv_sel_n + 1
    g_tv_last = tree_signal_index(c)

private void tv_on_act(Control c, rawptr ctx):
    _ = ctx
    g_tv_act_n = g_tv_act_n + 1
    g_tv_last = tree_signal_index(c)

private void tv_on_tog(Control c, rawptr ctx):
    _ = ctx
    g_tv_tog_tv_n = g_tv_tog_tv_n + 1
    g_tv_last = tree_signal_index(c)

private f64 g_tv_now = 100.0

private f64 tv_fake_clock():
    return g_tv_now

private bool tv_key(input.Keycode k):
    input.Event e = (input.EventKind.Key, i32(k), 0.0, 0.0, 0)
    return dispatch(e)

// A left press and release at the middle of cell `(col, row)`.
private bool tv_click(i32 col, i32 row):
    input.Event e = (input.EventKind.Mouse, 0, f32(col * 8 + 4), f32(row * 16 + 8), u32(input.Modifier.Lmb))
    bool took = dispatch(e)
    input.Event up = (input.EventKind.Mouse, 0, f32(col * 8 + 4), f32(row * 16 + 8), input.MOUSE_UP)
    _ = dispatch(up)
    return took

private bool tv_motion(i32 col, i32 row):
    input.Event e = (input.EventKind.Mouse, -1, f32(col * 8 + 4), f32(row * 16 + 8), input.MOUSE_MOTION)
    return dispatch(e)

private bool tv_wheel(i32 col, i32 row, i32 notches, u32 fine):
    input.Event e = (input.EventKind.Mouse, notches, f32(col * 8 + 4), f32(row * 16 + 8), input.MOUSE_WHEEL | fine)
    return dispatch(e)

private cell.CellPoint tv_pt(i32 col, i32 row):
    cell.CellPoint p = (col, row)
    return p

private bool tv_bg_is(i32 col, i32 row, [4]u8 want):
    return grid.cell_at(col, row).bg == want

private Kind g_tv_leaf = NO_KIND

private cell.CellPoint tv_leaf_measure(Control c, rawptr st):
    _ = c
    _ = st
    cell.CellPoint p = (1, 1)
    return p

// A focusable one-row leaf to move focus to.
private Control tv_leaf(Control parent):
    if !kind_ok(g_tv_leaf):
        Hooks h
        h.measure = tv_leaf_measure
        g_tv_leaf = register_kind("treeview_test_leaf", h)
    Control c = create(g_tv_leaf, parent, nil)
    set_focusable(c, true)
    return c

i32 test():
    bool ok = true

    // ── Arithmetic ────────────────────────────────────────────────────────
    ok = #expect(tree_clamp_top(5, 100, 10) == 5 && tree_clamp_top(95, 100, 10) == 90 && tree_clamp_top(-3, 100, 10) == 0, "clamp top") && ok
    ok = #expect(tree_clamp_top(4, 3, 10) == 0, "everything fits: top 0") && ok
    ok = #expect(tree_follow(10, 5, 8) == 5 && tree_follow(10, 17, 8) == 10 && tree_follow(10, 18, 8) == 11, "follow") && ok
    ok = #expect(tree_follow(10, -1, 8) == 10, "no selection: no move") && ok
    ok = #expect(tree_index_after_toggle(3, 5, 4) == 3 && tree_index_after_toggle(5, 5, -2) == 5, "at or before: kept") && ok
    ok = #expect(tree_index_after_toggle(9, 5, 4) == 13, "after an expand: moved down") && ok
    ok = #expect(tree_index_after_toggle(7, 5, -2) == 5 && tree_index_after_toggle(8, 5, -2) == 6, "inside a collapse: to it; after: up") && ok
    ok = #expect(tree_index_after_toggle(-1, 5, 3) == -1, "no row stays none") && ok
    (i32 rc, i32 ri, i32 rl) = tree_row_columns(3, 2)
    ok = #expect(rc == 3 + 2 * TREE_INDENT && ri == rc + TREE_CHEVRON_COLS && rl == ri + TREE_ICON_COLS + TREE_LABEL_GAP, "row columns") && ok

    ok = #expect(grid.up_headless(8, 16), "a headless grid") && ok
    //  root 40 x 12
    //  ├── tv   (0,0 40 x 11)
    //  └── other (0,11 40 x 1)
    cell.CellRect screen = cell.rect(0, 0, 40, 12)
    _ = grid.begin(40 * 8, 12 * 16)
    Control tv = tree_view(NIL)
    Control other = tv_leaf(NIL)
    on_tree_selected(tv, tv_on_sel, nil)
    on_tree_activated(tv, tv_on_act, nil)
    on_tree_toggled(tv, tv_on_tog, nil)
    g_tree_clock = tv_fake_clock
    ok = #expect(is_focusable(tv) && expands_h(tv) && expands_v(tv), "focusable, expanding") && ok
    ok = #expect(tree_selection(tv) == -1 && tree_top(tv) == 0, "empty") && ok
    update(screen)
    ok = #expect(rect(tv).rows == 11, "eleven rows of tree") && ok

    // ── A million rows cost the rows in view ─────────────────────────────
    Flat fl
    fl.n = 1000000
    TreeSource fs = (flat_count, flat_depth, flat_label, flat_flag, flat_flag, flat_icon, nil, rawptr(&fl))
    tree_set_source(tv, fs)
    set_focus(tv)
    update(screen)
    ok = #expect(fl.labels == 11 && fl.depths == 11 && fl.icons == 11, "one label, depth and icon a row in view: ", fl.labels) && ok
    ok = #expect(fl.flags == 11 && fl.counts <= 2, "has_children once a row (a leaf asks no more); count once: ", fl.flags, " ", fl.counts) && ok
    (i64 rp, i64 paints) = tree_counters(tv)
    ok = #expect(rp == 11 && paints >= 1, "eleven rows painted") && ok
    i32 fid = node_ink(tv)
    ok = #expect(grid.ink_valid(fid) && grid.ink_count(fid) > 0, "icons inked") && ok
    i32 per_row = grid.ink_count(fid) / 11
    ok = #expect(grid.ink_count(fid) == per_row * 11, "the same icon on every row: ", grid.ink_count(fid)) && ok

    // Keys across the whole list.
    fl.labels = 0
    fl.counts = 0
    ok = #expect(tv_key(input.Keycode.End), "End") && ok
    ok = #expect(tree_selection(tv) == 999999 && tree_top(tv) == 999989, "the last row, at the bottom: ", tree_top(tv)) && ok
    ok = #expect(g_tv_sel_n == 1 && g_tv_last == 999999, "signalled") && ok
    update(screen)
    ok = #expect(fl.labels == 11 && fl.counts <= 4, "still only the rows in view: ", fl.labels, " labels, ", fl.counts, " counts") && ok
    ok = #expect(tv_bg_is(0, 10, theme_tree().selected.bg), "the selection drawn on the bottom row") && ok
    _ = tv_key(input.Keycode.Home)
    ok = #expect(tree_selection(tv) == 0 && tree_top(tv) == 0, "Home") && ok
    tree_select(tv, 500000)
    ok = #expect(tree_top(tv) == 499990 && g_tv_sel_n == 2, "a call selects into view, emitting nothing: ", tree_top(tv)) && ok
    _ = tv_key(input.Keycode.PageDown)
    ok = #expect(tree_selection(tv) == 500010 && tree_top(tv) == 500000, "PageDown: a screen less one, followed") && ok
    _ = tv_key(input.Keycode.PageUp)
    _ = tv_key(input.Keycode.PageUp)
    ok = #expect(tree_selection(tv) == 499990 && tree_top(tv) == 499990, "PageUp twice") && ok
    _ = tv_key(input.Keycode.Up)
    ok = #expect(tree_selection(tv) == 499989 && tree_top(tv) == 499989, "Up past the top scrolls one row") && ok
    _ = tv_key(input.Keycode.Down)
    ok = #expect(tree_selection(tv) == 499990 && tree_top(tv) == 499989, "Down inside the view: no scroll") && ok
    update(screen)

    // The wheel moves the view, not the selection.
    ok = #expect(tv_wheel(5, 5, 1, 0), "a notch is taken") && ok
    ok = #expect(tree_top(tv) == 499989 + i64(WHEEL_LINES) && tree_selection(tv) == 499990, "a notch: WHEEL_LINES rows") && ok
    _ = tv_wheel(5, 5, -2, 0)
    ok = #expect(tree_top(tv) == 499989 + i64(WHEEL_LINES) - 2 * i64(WHEEL_LINES), "two up") && ok
    i64 t0 = tree_top(tv)
    // A tenth of a notch is 0.3 of a row: three are 0.9, the fourth tips it.
    for k in 0..<3:
        _ = k
        _ = tv_wheel(5, 5, input.WHEEL_UNIT / 10, input.WHEEL_FINE)
    ok = #expect(tree_top(tv) == t0, "fractions are kept, not rounded up: ", tree_top(tv) - t0) && ok
    _ = tv_wheel(5, 5, input.WHEEL_UNIT / 10, input.WHEEL_FINE)
    ok = #expect(tree_top(tv) == t0 + 1, "and add up to a row") && ok
    // The selection, scrolled out, comes back into view on the next key.
    ok = #expect(tree_scroll_to(tv, 0) && tree_top(tv) == 0, "scrolled to the top") && ok
    _ = tv_key(input.Keycode.Down)
    ok = #expect(tree_selection(tv) == 499991 && tree_top(tv) == 499981, "a key brings the selection back into view") && ok
    ok = #expect(!tree_scroll_to(tv, 2000000) || tree_top(tv) == 999989, "held to the last screen") && ok
    update(screen)

    // The hover look follows the rows under a still pointer: a notch moves
    // them, and the look stays on the row the pointer is over.
    _ = tv_motion(5, 3)
    update(screen)
    ok = #expect(tree_hover(tv) == tree_top(tv) + 3 && tv_bg_is(0, 3, theme_tree().hover.bg), "hovering screen row 3") && ok
    _ = tv_wheel(5, 3, -1, 0)
    update(screen)
    ok = #expect(tree_hover(tv) == tree_top(tv) + 3 && tv_bg_is(0, 3, theme_tree().hover.bg), "after a notch, still screen row 3: row ", tree_hover(tv)) && ok
    ok = #expect(!tv_bg_is(0, 3 + WHEEL_LINES, theme_tree().hover.bg), "and not the row it was over before") && ok

    // ── Folders ───────────────────────────────────────────────────────────
    Files f
    f.depth = [0, 1, 1, 2, 2, 1, 0]
    f.dir = [true, false, true, false, false, false, false]
    files_rebuild(&f)
    TreeSource src = (files_count, files_depth, files_label, files_has, files_open, nil, files_toggle, rawptr(&f))
    tree_set_source(tv, src)
    ok = #expect(tree_selection(tv) == -1 && tree_top(tv) == 0 && f.nvis == 2, "a new source: top, nothing selected, two rows") && ok
    update(screen)
    g_tv_sel_n = 0
    g_tv_tog_tv_n = 0
    g_tv_act_n = 0

    ok = #expect(tv_key(input.Keycode.Down) && tree_selection(tv) == 0 && g_tv_sel_n == 1, "Down with nothing selected: the first row") && ok
    ok = #expect(!tree_signal_by_mouse(tv), "a key's selection is not the mouse's") && ok
    ok = #expect(tv_key(input.Keycode.Right) && f.nvis == 5 && g_tv_tog_tv_n == 1 && g_tv_last == 0, "Right expands src") && ok
    ok = #expect(tree_selection(tv) == 0 && g_tv_sel_n == 1, "and keeps the selection") && ok
    _ = tv_key(input.Keycode.Right)
    ok = #expect(tree_selection(tv) == 1 && g_tv_sel_n == 2, "Right again enters it: a.dado") && ok
    _ = tv_key(input.Keycode.Right)
    ok = #expect(tree_selection(tv) == 1 && g_tv_tog_tv_n == 1, "Right on a file: nothing") && ok
    _ = tv_key(input.Keycode.Down)
    _ = tv_key(input.Keycode.Right)
    ok = #expect(tree_selection(tv) == 2 && f.nvis == 7 && g_tv_tog_tv_n == 2, "lib expanded") && ok
    _ = tv_key(input.Keycode.Down)
    _ = tv_key(input.Keycode.Down)
    ok = #expect(tree_selection(tv) == 4, "y.dado") && ok
    _ = tv_key(input.Keycode.Left)
    ok = #expect(tree_selection(tv) == 2, "Left on a file: its parent, lib") && ok
    _ = tv_key(input.Keycode.Left)
    ok = #expect(tree_selection(tv) == 2 && f.nvis == 5 && g_tv_tog_tv_n == 3, "Left on an open folder collapses it") && ok
    _ = tv_key(input.Keycode.Left)
    ok = #expect(tree_selection(tv) == 0, "Left on a closed folder: its parent, src") && ok
    _ = tv_key(input.Keycode.Left)
    ok = #expect(f.nvis == 2 && tree_selection(tv) == 0, "collapsed src") && ok
    _ = tv_key(input.Keycode.Left)
    ok = #expect(tree_selection(tv) == 0 && g_tv_tog_tv_n == 4, "Left at the top level: nothing") && ok

    // Enter: a folder toggles, a file activates.
    _ = tv_key(input.Keycode.Enter)
    ok = #expect(f.nvis == 5 && g_tv_tog_tv_n == 5 && g_tv_act_n == 0, "Enter on a folder toggles it") && ok
    _ = tv_key(input.Keycode.Down)
    _ = tv_key(input.Keycode.Enter)
    ok = #expect(g_tv_act_n == 1 && g_tv_last == 1 && f.toggles == 5, "Enter on a.dado activates it") && ok

    // The selection stays on its row across toggles.
    _ = tree_toggle(tv, 2)
    ok = #expect(f.nvis == 7 && g_tv_tog_tv_n == 5, "a call toggles and emits nothing") && ok
    tree_select(tv, 6)
    ok = #expect(tree_toggle(tv, 0) && f.nvis == 2 && tree_selection(tv) == 1, "collapsing above: README moves up to 1") && ok
    ok = #expect(tree_toggle(tv, 0) && f.nvis == 7 && tree_selection(tv) == 6, "and back down to 6") && ok
    tree_select(tv, 4)
    ok = #expect(tree_toggle(tv, 2) && tree_selection(tv) == 2, "a selection inside a collapse moves to the folder") && ok
    ok = #expect(!tree_toggle(tv, 1), "a file does not toggle") && ok
    update(screen)

    // ── Looks and ink ─────────────────────────────────────────────────────
    //  rows: src, a.dado, lib, b.dado, README; lib selected.
    TreeTheme th = theme_tree()
    ok = #expect(tv_bg_is(0, 2, th.selected.bg) && tv_bg_is(39, 2, th.selected.bg), "the selected row, focused, full width") && ok
    ok = #expect(tv_bg_is(0, 1, th.row.bg) && tv_bg_is(0, 9, th.row.bg), "other rows and the blank below") && ok
    i32 tid = node_ink(tv)
    i32 inked = grid.ink_count(tid)
    // Five icons and two chevrons (src and lib).
    ok = #expect(inked > 7 && inked < 7 * 64, "icons and chevrons inked: ", inked) && ok
    set_focus(other)
    update(screen)
    ok = #expect(tv_bg_is(0, 2, th.selected_unfocused.bg), "unfocused") && ok
    set_focus(tv)
    update(screen)
    ok = #expect(tv_bg_is(0, 2, th.selected.bg), "focused again") && ok
    ok = #expect(!tv_motion(20, 3) && tree_hover(tv) == 3, "motion: the hover row") && ok
    update(screen)
    ok = #expect(tv_bg_is(0, 3, th.hover.bg) && tv_bg_is(0, 2, th.selected.bg), "hover drawn; the selection wins its row") && ok
    cell.CellPoint at = (3, 3)
    ok = #expect(cursor_at(tv, at) == CURSOR_DEFAULT && tree_cursor_hook(tv, state(tv), at) == CURSOR_DEFAULT, "the arrow") && ok

    // ── The mouse ─────────────────────────────────────────────────────────
    //  src at depth 0: chevron cells 0..1, icon 2..3, label from 5.
    (i64 hr, bool hc) = tree_hit(tv, tv_pt(1, 0))
    ok = #expect(hr == 0 && hc, "src's chevron") && ok
    (hr, hc) = tree_hit(tv, tv_pt(1, 1))
    ok = #expect(hr == 1 && !hc, "a.dado has no chevron (its cell 1 is indent)") && ok
    (hr, hc) = tree_hit(tv, tv_pt(3, 2))
    ok = #expect(hr == 2 && hc, "lib's chevron, indented") && ok
    (hr, hc) = tree_hit(tv, tv_pt(5, 9))
    ok = #expect(hr == -1, "below the last row") && ok
    i32 sel_before = g_tv_sel_n
    ok = #expect(tv_click(3, 2) && f.nvis == 7 && g_tv_tog_tv_n == 6 && g_tv_last == 2, "a chevron click expands lib") && ok
    ok = #expect(tree_selection(tv) == 2 && g_tv_sel_n == sel_before, "and selects nothing") && ok
    g_tv_now = 200.0
    ok = #expect(tv_click(10, 3) && tree_selection(tv) == 3 && g_tv_sel_n == sel_before + 1 && g_tv_last == 3, "a click selects x.dado") && ok
    ok = #expect(tree_signal_by_mouse(tv), "and says the mouse made it") && ok
    g_tv_now = 201.0
    ok = #expect(tv_click(10, 3) && g_tv_sel_n == sel_before + 2 && g_tv_act_n == 1, "a slow second click: selected again, not activated") && ok
    g_tv_now = 201.2
    ok = #expect(tv_click(10, 3) && g_tv_act_n == 2 && g_tv_last == 3, "a double-click activates the file") && ok
    ok = #expect(tree_signal_by_mouse(tv), "by the mouse") && ok
    _ = tv_key(input.Keycode.Enter)
    ok = #expect(g_tv_act_n == 3 && !tree_signal_by_mouse(tv), "Enter activates it by a key") && ok
    ok = #expect(!tree_signal_by_mouse(other), "not a tree: false") && ok
    g_tv_now = 202.0
    _ = tv_click(10, 3)
    g_tv_now = 202.1
    _ = tv_click(10, 4)
    ok = #expect(g_tv_act_n == 3 && tree_selection(tv) == 4, "two presses on two rows are two clicks") && ok
    g_tv_now = 203.0
    _ = tv_click(10, 0)
    g_tv_now = 203.1
    ok = #expect(tv_click(10, 0) && f.nvis == 2 && tree_selection(tv) == 0 && g_tv_act_n == 3, "a double-click on a folder toggles it") && ok
    ok = #expect(tv_click(10, 9) && tree_selection(tv) == 0, "a click below the rows is taken and selects nothing") && ok
    set_focus(other)
    _ = tv_click(10, 1)
    ok = #expect(focused() == tv, "a click focuses the tree") && ok

    tree_changed(tv)
    ok = #expect(is_paint_dirty(tv), "tree_changed repaints") && ok
    update(screen)

    g_tree_clock = nil
    reset()
    grid.down()
    if ok:
        return 0
    return 1
