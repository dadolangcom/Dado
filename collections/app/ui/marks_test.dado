@test
// A text edit's mark source with no window (a grid taken up headless with
// 8 x 16 cells, so the view's region is read back): marks paint their roles'
// backgrounds under exactly their bytes; the style source's foregrounds are
// kept under them, runs splitting wherever either changes; the current match
// differs from the others; overlapping, inverted and out-of-range marks and
// roles outside the palette are drawn safely; the selection and the caret
// paint over a mark; `text_edit_remark` repaints the rows asked for and only
// those, counting no restyle; a line with no marks costs one run as before;
// and every entry point is total over a bad handle.
package ui

import "app:ui/cell"
import "app:ui/grid"

private const string8 MK_LINE = "let x = 42 // c"

private i64 mk_count(rawptr ctx):
    _ = ctx
    return 40

private string8 mk_line(rawptr ctx, i64 i):
    _ = ctx
    _ = i
    return MK_LINE

private cell.TextPos mk_insert(rawptr ctx, cell.TextPos p, string8 text):
    _ = ctx
    _ = text
    return p

private bool mk_remove(rawptr ctx, cell.TextPos a, cell.TextPos b):
    _ = ctx
    _ = a
    _ = b
    return false

private [8]StyleSpan g_mk_spans
private i32 g_mk_n
private [8]StyleSpan g_mk_marks
private i32 g_mk_m
// 0: two matches and the current one; 1: badly formed; 2: none.
private i32 g_mk_mode
private i64 g_mk_asked

// Keyword `let`, number `42`, comment `// c`, on every line.
private StyleSpans mk_styles(rawptr ctx, i64 line):
    _ = ctx
    _ = line
    g_mk_n = 0
    g_mk_spans[0] = (0, 3, SYNTAX_KEYWORD)
    g_mk_spans[1] = (8, 10, SYNTAX_NUMBER)
    g_mk_spans[2] = (11, 15, SYNTAX_COMMENT)
    g_mk_n = 3
    return g_mk_spans[0..<g_mk_n]

private void mk_put(i32 from, i32 to, i32 role):
    g_mk_marks[g_mk_m] = (from, to, role)
    g_mk_m = g_mk_m + 1

// On line 1: `et` and `2 ` matched, `x` the current one. On every other line
// the same two without a current one.
private StyleSpans mk_marks(rawptr ctx, i64 line):
    _ = ctx
    g_mk_asked = g_mk_asked + 1
    g_mk_m = 0
    if g_mk_mode == 0:
        mk_put(1, 3, MARK_MATCH)
        if line == 1:
            mk_put(4, 5, MARK_CURRENT)
        mk_put(9, 11, MARK_MATCH)
    else if g_mk_mode == 1:
        mk_put(-4, 2, MARK_MATCH)
        mk_put(1, 4, MARK_CURRENT)
        mk_put(8, 6, MARK_MATCH)
        mk_put(9, 10, 77)
        mk_put(12, 999, MARK_MATCH)
    return g_mk_marks[0..<g_mk_m]

// The cell at text column `col` of view row `row`.
private cell.Cell mk_cell(i32 id, i32 tx, i32 top, i32 col, i32 row):
    return grid.region_cell_at(id, tx + col, top + row)

// Whether text columns `[a, b)` of view row `row` all have background `bg`.
private bool mk_bg(i32 id, i32 tx, i32 top, i32 row, i32 a, i32 b, [4]u8 bg):
    for x in a..<b:
        if mk_cell(id, tx, top, i32(x), row).bg != bg:
            return false
    return true

private i64 mk_lines(Control c):
    (i64 _, i64 lp) = text_edit_counters(c)
    return lp

i32 test():
    bool ok = true
    ok = #expect(grid.up_headless(8, 16), "a headless grid") && ok
    cell.CellRect screen = cell.rect(0, 0, 30, 10)
    _ = grid.begin(30 * 8, 10 * 16)
    Control ed = text_edit(NIL)
    EditSource src = (mk_count, mk_line, mk_insert, mk_remove, nil)
    text_edit_set_source(ed, src)
    text_edit_set_styles(ed, mk_styles, nil)
    update(screen)
    EditTheme th = theme_edit()
    cell.CellRect v = edit_view(ed)
    i32 id = text_edit_region(ed)
    i32 tx = v.col + text_edit_gutter_width(ed)
    ok = #expect(id >= 0 && !text_edit_has_marks(ed), "a region, and no marks yet") && ok
    ok = #expect(mk_bg(id, tx, v.row, 1, 0, 15, th.bg), "with none, the text background") && ok
    ok = #expect(th.mark[MARK_MATCH] != th.mark[MARK_CURRENT] && th.mark[MARK_MATCH] != th.bg && th.mark[MARK_MATCH] != th.sel_bg,
                 "the match, the current match, the text and the selection all differ") && ok
    ok = #expect(theme_mark(MARK_CURRENT) == th.mark[MARK_CURRENT] && theme_mark(MARK_ROLES)[3] == 0 && theme_mark(-1)[3] == 0,
                 "the reader agrees; a role outside is no mark") && ok

    // ── Marks under the colour ─────────────────────────────────────────────
    text_edit_set_marks(ed, mk_marks, nil)
    ok = #expect(text_edit_has_marks(ed) && is_paint_dirty(ed), "set, and marked for paint") && ok
    i64 lp = mk_lines(ed)
    update(screen)
    ok = #expect(mk_lines(ed) - lp == i64(v.rows) + 1, "setting marks repaints the view") && ok
    [4]u8 m = th.mark[MARK_MATCH]
    [4]u8 cur = th.mark[MARK_CURRENT]
    ok = #expect(mk_bg(id, tx, v.row, 1, 0, 1, th.bg) && mk_bg(id, tx, v.row, 1, 1, 3, m), "`et` matched") && ok
    ok = #expect(mk_bg(id, tx, v.row, 1, 3, 4, th.bg) && mk_bg(id, tx, v.row, 1, 4, 5, cur), "`x` the current match") && ok
    ok = #expect(mk_bg(id, tx, v.row, 1, 5, 9, th.bg) && mk_bg(id, tx, v.row, 1, 9, 11, m) && mk_bg(id, tx, v.row, 1, 11, 20, th.bg),
                 "`2 ` matched, the rest plain") && ok
    ok = #expect(mk_bg(id, tx, v.row, 2, 4, 5, th.bg), "no current match on the other lines") && ok
    // The keyword's foreground kept under a mark that splits it.
    ok = #expect(mk_cell(id, tx, v.row, 0, 1).fg == th.syntax[SYNTAX_KEYWORD] && mk_cell(id, tx, v.row, 2, 1).fg == th.syntax[SYNTAX_KEYWORD],
                 "`let` stays a keyword, marked or not") && ok
    ok = #expect(mk_cell(id, tx, v.row, 9, 1).fg == th.syntax[SYNTAX_NUMBER] && mk_cell(id, tx, v.row, 10, 1).fg == th.fg,
                 "the number's last digit, marked, a number; the marked space after it plain") && ok
    ok = #expect(mk_cell(id, tx, v.row, 11, 1).fg == th.syntax[SYNTAX_COMMENT], "the comment unmarked") && ok
    ok = #expect(text_edit_marks_painted(ed) >= 2 * i64(v.rows), "mark runs counted: ", text_edit_marks_painted(ed)) && ok
    (i64 sp, i64 rs) = text_edit_style_counters(ed)
    ok = #expect(sp >= 3 * i64(v.rows) && rs == 0, "every span still drawn once a line, split or not: ", sp) && ok

    // The selection and the caret over a mark.
    text_edit_set_selection(ed, cell.pos(2, 0), cell.pos(2, 3))
    update(screen)
    ok = #expect(mk_bg(id, tx, v.row, 2, 0, 3, th.sel_bg), "the selection over the match") && ok
    ok = #expect(mk_bg(id, tx, v.row, 2, 9, 11, m), "the rest of the line's marks kept") && ok
    text_edit_set_caret(ed, cell.pos(3, 1))
    update(screen)
    ok = #expect(mk_cell(id, tx, v.row, 1, 3).bg == th.caret_bg && mk_bg(id, tx, v.row, 3, 2, 3, m), "the caret over a mark") && ok

    // ── Badly formed ───────────────────────────────────────────────────────
    g_mk_mode = 1
    text_edit_remark(ed, 0, 40)
    update(screen)
    ok = #expect(mk_bg(id, tx, v.row, 1, 0, 2, m), "a mark from before the line: held to byte 0") && ok
    ok = #expect(mk_bg(id, tx, v.row, 1, 2, 4, cur), "an overlapping mark draws past the one before") && ok
    ok = #expect(mk_bg(id, tx, v.row, 1, 4, 9, th.bg), "an inverted one draws nothing") && ok
    ok = #expect(mk_bg(id, tx, v.row, 1, 9, 12, th.bg), "a role outside the palette is no mark") && ok
    ok = #expect(mk_bg(id, tx, v.row, 1, 12, 15, m) && mk_bg(id, tx, v.row, 1, 15, 20, th.bg), "one past the end: held to it") && ok
    ok = #expect(mk_cell(id, tx, v.row, 0, 1).fg == th.syntax[SYNTAX_KEYWORD] && mk_cell(id, tx, v.row, 12, 1).fg == th.syntax[SYNTAX_COMMENT],
                 "foregrounds kept") && ok

    // ── remark: the rows asked for, and only those ─────────────────────────
    g_mk_mode = 2
    (i64 top, i64 _) = text_edit_position(ed)
    lp = mk_lines(ed)
    (i64 _, i64 rs0) = text_edit_style_counters(ed)
    g_mk_asked = 0
    text_edit_remark(ed, top + 4, top + 6)
    update(screen)
    ok = #expect(mk_lines(ed) - lp == 2 && g_mk_asked == 2, "two lines asked, two painted: ", mk_lines(ed) - lp) && ok
    ok = #expect(mk_bg(id, tx, v.row, 4, 0, 15, th.bg) && mk_bg(id, tx, v.row, 5, 0, 15, th.bg), "rows 4 and 5 took the new answer: none") && ok
    ok = #expect(mk_bg(id, tx, v.row, 6, 12, 15, m), "row 6 was not asked, and kept the old") && ok
    (i64 _, i64 rs1) = text_edit_style_counters(ed)
    ok = #expect(rs1 == rs0, "a remark is not a restyle") && ok
    text_edit_remark(ed, top + i64(v.rows) + 2, 40)
    text_edit_remark(ed, 7, 3)
    ok = #expect(!is_paint_dirty(ed), "out of view, or inverted: nothing marked") && ok
    (i64 vt, i32 vr) = text_edit_view_lines(ed)
    ok = #expect(vt == top && vr == v.rows, "the view's lines read back") && ok

    // ── Off: the text background everywhere ────────────────────────────────
    g_mk_mode = 0
    text_edit_set_marks(ed, nil, nil)
    update(screen)
    ok = #expect(!text_edit_has_marks(ed) && mk_bg(id, tx, v.row, 6, 0, 15, th.bg), "unset: no marks") && ok

    // ── Bad handles ────────────────────────────────────────────────────────
    Control lb = label(NIL, "x")
    text_edit_set_marks(NIL, mk_marks, nil)
    text_edit_set_marks(lb, mk_marks, nil)
    text_edit_remark(NIL, 0, 5)
    text_edit_remark(lb, 0, 5)
    ok = #expect(!text_edit_has_marks(NIL) && !text_edit_has_marks(lb) && text_edit_marks_painted(NIL) == 0, "no handle, or a label, has no marks") && ok
    (i64 bt, i32 br) = text_edit_view_lines(lb)
    ok = #expect(bt == 0 && br == 0, "nor lines") && ok
    remove(ed)
    text_edit_set_marks(ed, mk_marks, nil)
    ok = #expect(!text_edit_has_marks(ed), "a removed edit is a bad handle") && ok

    reset()
    grid.down()
    if ok:
        return 0
    return 1
