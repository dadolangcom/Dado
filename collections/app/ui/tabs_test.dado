@test
// The tab bar: its arithmetic with no tree (`tab_title_cap`, `tab_follow`,
// `tab_hit`); then a bar in a real tree over a headless 8 x 16 grid — clicks
// that select and emit `tab_selected`, clicks on the close mark and middle
// clicks that emit `tab_close_requested` and change nothing, the index each
// signal refers to, removal moving the selection, the modified flag, the
// looks read back from the cells as focus moves in and out of the bar's pane,
// and a strip too wide for the bar cut and then scrolled to the selected tab.
package ui

import "app:input"
import "app:ui/cell"
import "app:ui/grid"

private bool rect_is(cell.CellRect r, i32 col, i32 row, i32 cols, i32 rows):
    return r.col == col && r.row == row && r.cols == cols && r.rows == rows

private type TSize: (i32 cols, i32 rows)
private type TSizePtr: ^TSize

private cell.CellPoint tsized(Control c, rawptr st):
    _ = c
    ^TSize s = TSizePtr(st)
    cell.CellPoint p = (s.cols, s.rows)
    return p

private Kind g_tleaf = NO_KIND

// A focusable leaf that expands both ways: an editor's stand-in.
private Control tleaf(Control parent):
    if !kind_ok(g_tleaf):
        Hooks h
        h.measure = tsized
        g_tleaf = register_kind("tabs_test_leaf", h)
    Control c = create_owned(g_tleaf, parent, i64(#size(TSize)))
    ^TSize s = TSizePtr(state(c))
    s.cols = 1
    s.rows = 1
    set_expand(c, true, true)
    set_focusable(c, true)
    return c

private i32 g_selected_n
private i32 g_selected_at = -9
private i32 g_close_n
private i32 g_close_at = -9

private void on_sel(Control c, rawptr ctx):
    _ = ctx
    g_selected_n = g_selected_n + 1
    g_selected_at = tab_bar_signal_index(c)

private void on_close(Control c, rawptr ctx):
    _ = ctx
    g_close_n = g_close_n + 1
    g_close_at = tab_bar_signal_index(c)

// A press of `button` at the middle of cell `(col, row)` of the 8 x 16 grid.
private bool click(i32 col, i32 row, i32 button):
    u32 held = u32(input.Modifier.Lmb)
    if button == 2:
        held = u32(input.Modifier.Mmb)
    input.Event e = (input.EventKind.Mouse, button, f32(col * 8 + 4), f32(row * 16 + 8), held)
    bool took = dispatch(e)
    input.Event up = (input.EventKind.Mouse, button, f32(col * 8 + 4), f32(row * 16 + 8), input.MOUSE_UP)
    _ = dispatch(up)
    return took

private bool fg_is(i32 col, i32 row, [4]u8 want):
    return grid.cell_at(col, row).fg == want

private bool bg_is(i32 col, i32 row, [4]u8 want):
    return grid.cell_at(col, row).bg == want

i32 test():
    bool ok = true

    // ── Arithmetic ────────────────────────────────────────────────────────
    [8]i32 tc
    tc[0] = 5
    tc[1] = 4
    tc[2] = 9
    ok = #expect(tab_title_cap(tc[0..<3], 40) == 9, "everything fits: no cut") && ok
    ok = #expect(tab_title_cap(tc[0..<3], 30) == 6, "5+4+6 + 15 = 30: cut to 6, got ", tab_title_cap(tc[0..<3], 30)) && ok
    ok = #expect(tab_title_cap(tc[0..<3], 10) == TAB_TITLE_MIN, "never below the minimum") && ok
    for k in 0..<6:
        tc[k] = 14
    ok = #expect(tab_title_cap(tc[0..<3], 40) == 8, "three of 14 in 40: 8, got ", tab_title_cap(tc[0..<3], 40)) && ok
    ok = #expect(tab_title_cap(tc[0..<6], 40) == TAB_TITLE_MIN, "six of 14 in 40: the minimum") && ok
    ok = #expect(tab_width(14, 8) == 13 && tab_width(3, 8) == 8, "a tab is its cut title and TAB_EXTRA") && ok
    [8]i32 w
    for k in 0..<6:
        w[k] = 9
    ok = #expect(tab_follow(w[0..<6], 5, 40, 0) == 14, "the last tab: scroll to its end") && ok
    ok = #expect(tab_follow(w[0..<6], 0, 40, 14) == 0, "the first tab: scroll back to it") && ok
    ok = #expect(tab_follow(w[0..<6], 2, 40, 14) == 14, "already in view: no change") && ok
    ok = #expect(tab_follow(w[0..<6], 3, 40, 99) == 14, "held to the range") && ok
    ok = #expect(tab_follow(w[0..<6], 2, 5, 0) == 18, "a tab wider than the bar: its start") && ok
    ok = #expect(tab_follow(w[0..<2], 1, 40, 7) == 0, "everything fits: no scroll") && ok
    w[0] = 10
    w[1] = 9
    w[2] = 14
    (i32 hi, bool hc) = tab_hit(w[0..<3], 0, 8)
    ok = #expect(hi == 0 && hc, "the first tab's close mark") && ok
    (hi, hc) = tab_hit(w[0..<3], 0, 12)
    ok = #expect(hi == 1 && !hc, "the second tab's title") && ok
    (hi, hc) = tab_hit(w[0..<3], 0, 33)
    ok = #expect(hi == -1, "past the last tab") && ok
    (hi, hc) = tab_hit(w[0..<3], 5, 3)
    ok = #expect(hi == 0 && hc, "scrolled by five") && ok
    (hi, hc) = tab_hit(w[0..<3], 0, -1)
    ok = #expect(hi == -1, "left of the bar") && ok

    // ── In a tree ─────────────────────────────────────────────────────────
    //  root 40 x 6
    //  ├── pane1 (vbox): bar, ed1
    //  └── pane2 (vbox): ed2
    ok = #expect(grid.up_headless(8, 16), "a headless grid") && ok
    cell.CellRect screen = cell.rect(0, 0, 40, 6)
    _ = grid.begin(40 * 8, 6 * 16)
    Control pane1 = vbox(NIL)
    set_expand(pane1, true, true)
    Control bar = tab_bar(pane1)
    Control ed1 = tleaf(pane1)
    Control pane2 = vbox(NIL)
    set_expand(pane2, true, true)
    Control ed2 = tleaf(pane2)
    on_tab_selected(bar, on_sel, nil)
    on_tab_close_requested(bar, on_close, nil)
    ok = #expect(!is_focusable(bar) && expands_h(bar), "not focusable; expands across") && ok
    ok = #expect(tab_bar_selected(bar) == -1 && tab_bar_count(bar) == 0, "empty") && ok
    ok = #expect(tab_bar_add(bar, "alpha") == 0 && tab_bar_add(bar, "beta") == 1 && tab_bar_add(bar, "gamma.toy") == 2, "three tabs") && ok
    ok = #expect(tab_bar_count(bar) == 3 && tab_bar_selected(bar) == 0, "the first is selected") && ok
    ok = #expect(tab_bar_title(bar, 2) == "gamma.toy" && tab_bar_title(bar, 3) == "", "titles") && ok
    set_focus(ed1)
    update(screen)
    ok = #expect(rect_is(rect(bar), 0, 0, 40, 1), "the bar is the pane's first row") && ok
    ok = #expect(minimum(bar).col == TAB_TITLE_MIN + TAB_EXTRA && minimum(bar).row == 1, "minimum: one minimal tab") && ok
    ok = #expect(rect_is(tab_bar_tab_rect(bar, 0), 0, 0, 10, 1) && rect_is(tab_bar_tab_rect(bar, 2), 19, 0, 14, 1), "tab rects") && ok
    ok = #expect(tab_bar_scroll(bar) == 0, "no scroll") && ok

    // The looks: focus is in the bar's pane.
    TabTheme th = theme_tab()
    ok = #expect(fg_is(3, 0, th.selected.fg) && bg_is(3, 0, th.selected.bg), "the selected tab, focused") && ok
    ok = #expect(fg_is(12, 0, th.tab.fg) && bg_is(12, 0, th.tab.bg), "an unselected tab") && ok
    ok = #expect(bg_is(36, 0, th.bar_bg), "the bar after the tabs") && ok

    // Focus moves to the other pane: the bar repaints unfocused.
    set_focus(ed2)
    ok = #expect(is_paint_dirty(bar), "a focus move marks the bar") && ok
    update(screen)
    ok = #expect(fg_is(3, 0, th.selected_unfocused.fg) && bg_is(3, 0, th.selected_unfocused.bg), "the selected tab, unfocused") && ok
    tab_bar_set_pane(bar, pane2)
    update(screen)
    ok = #expect(fg_is(3, 0, th.selected.fg), "a pane named explicitly") && ok
    tab_bar_set_pane(bar, NIL)
    set_focus(ed1)
    update(screen)

    // ── Clicks ────────────────────────────────────────────────────────────
    ok = #expect(click(12, 0, 0), "a click on a tab is taken") && ok
    ok = #expect(g_selected_n == 1 && g_selected_at == 1 && tab_bar_selected(bar) == 1, "selected tab 1, signalled") && ok
    ok = #expect(focused() == ed1, "clicking the bar does not take focus") && ok
    _ = click(13, 0, 0)
    ok = #expect(g_selected_n == 1, "the selected tab again: no signal") && ok
    update(screen)
    ok = #expect(fg_is(12, 0, th.selected.fg) && fg_is(3, 0, th.tab.fg), "the looks followed the selection") && ok
    ok = #expect(click(31, 0, 0), "the close mark") && ok
    ok = #expect(g_close_n == 1 && g_close_at == 2, "close requested for tab 2") && ok
    ok = #expect(tab_bar_count(bar) == 3 && tab_bar_selected(bar) == 1 && g_selected_n == 1, "the bar changed nothing") && ok
    ok = #expect(click(3, 0, 2), "a middle click") && ok
    ok = #expect(g_close_n == 2 && g_close_at == 0, "close requested for tab 0") && ok
    ok = #expect(!click(36, 0, 0), "past the tabs: not taken") && ok
    ok = #expect(g_close_n == 2 && g_selected_n == 1, "and nothing emitted") && ok

    // The program decides: it removes what it was asked to.
    tab_bar_remove(bar, 0)
    ok = #expect(tab_bar_count(bar) == 2 && tab_bar_selected(bar) == 0 && tab_bar_title(bar, 0) == "beta", "removing before the selection moves it with its tab") && ok
    tab_bar_remove(bar, 0)
    ok = #expect(tab_bar_count(bar) == 1 && tab_bar_selected(bar) == 0 && tab_bar_title(bar, 0) == "gamma.toy", "removing the selected: the next takes its place") && ok
    ok = #expect(tab_bar_add(bar, "delta") == 1, "append") && ok
    tab_bar_select(bar, 1)
    tab_bar_remove(bar, 1)
    ok = #expect(tab_bar_selected(bar) == 0, "removing the selected last tab selects the new last") && ok
    tab_bar_remove(bar, 0)
    ok = #expect(tab_bar_count(bar) == 0 && tab_bar_selected(bar) == -1, "none left: nothing selected") && ok
    tab_bar_remove(bar, 0)
    ok = #expect(g_selected_n == 1 && g_close_n == 2, "calls emit nothing") && ok
    update(screen)
    ok = #expect(minimum(bar).col == 0, "no tabs: no minimum width") && ok

    // Titles are copies; modified is a flag.
    _ = tab_bar_add(bar, "one")
    tab_bar_set_title(bar, 0, "renamed")
    tab_bar_set_modified(bar, 0, true)
    ok = #expect(is_paint_dirty(bar) && tab_bar_modified(bar, 0) && !tab_bar_modified(bar, 1), "modified, and repainting") && ok
    ok = #expect(tab_bar_title(bar, 0) == "renamed", "retitled") && ok
    update(screen)
    tab_bar_remove(bar, 0)

    // ── Overflow: six long titles in 40 columns ───────────────────────────
    for k in 0..<6:
        _ = tab_bar_add(bar, "document_x.toy")
    update(screen)
    ok = #expect(rect_is(tab_bar_tab_rect(bar, 1), 9, 0, 9, 1), "cut to the minimum title: nine cells a tab") && ok
    ok = #expect(tab_bar_scroll(bar) == 0, "the first selected: no scroll") && ok
    tab_bar_select(bar, 5)
    ok = #expect(tab_bar_scroll(bar) == 14, "the last selected: scrolled to its end, got ", tab_bar_scroll(bar)) && ok
    update(screen)
    ok = #expect(rect_is(tab_bar_tab_rect(bar, 5), 31, 0, 9, 1), "the last tab ends at the bar's edge") && ok
    ok = #expect(fg_is(35, 0, th.selected.fg), "and is drawn there, selected") && ok
    ok = #expect(click(0, 0, 0) && tab_bar_selected(bar) == 1 && g_selected_at == 1, "the bar's first column is tab 1 now") && ok
    ok = #expect(tab_bar_scroll(bar) == 9, "which scrolls back to show it whole, got ", tab_bar_scroll(bar)) && ok
    update(cell.rect(0, 0, 60, 6))
    ok = #expect(tab_bar_scroll(bar) == 0, "a wider window needs no scroll") && ok

    reset()
    grid.down()
    if ok:
        return 0
    return 1
