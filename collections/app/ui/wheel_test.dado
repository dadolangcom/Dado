@test
// The wheel's fraction (`input.wheel_amount`) reaching a view's pixel offset:
// `wheel_scroll_px`, pure, and a TextEdit scrolled by whole-notch and
// fractional wheel events. With no grid up a TextEdit's row is one pixel
// (`edit_unit`), which keeps the arithmetic exact here.
package ui

import "app:input"
import "app:ui/cell"

private i64 lines_count(rawptr ctx):
    _ = ctx
    return 200

private string8 lines_line(rawptr ctx, i64 i):
    _ = ctx
    _ = i
    return "line"

private cell.TextPos no_insert(rawptr ctx, cell.TextPos p, string8 text):
    _ = ctx
    _ = text
    return p

private bool no_remove(rawptr ctx, cell.TextPos a, cell.TextPos b):
    _ = ctx
    _ = a
    _ = b
    return false

private input.Event notch(i32 n):
    input.Event e = (input.EventKind.Mouse, n, 2.0, 2.0, input.MOUSE_WHEEL)
    return e

// A fine wheel event of `thousandths` of a line, as the sokol decode packs it.
private input.Event fine(i32 thousandths):
    input.Event e = (input.EventKind.Mouse, thousandths, 2.0, 2.0, input.MOUSE_WHEEL | input.WHEEL_FINE)
    return e

private i64 offset(Control c):
    (i64 _, i64 px) = text_edit_position(c)
    return px

i32 test():
    bool ok = true

    // ── Pure ─────────────────────────────────────────────────────────────
    ok = #expect(wheel_scroll_px(1.0, 17, 1000) == i64(WHEEL_LINES) * 17, "a notch is WHEEL_LINES rows") && ok
    ok = #expect(wheel_scroll_px(-2.0, 17, 1000) == 0 - i64(WHEEL_LINES) * 34, "two notches up") && ok
    ok = #expect(wheel_scroll_px(0.1, 20, 1000) == 6, "0.1 line x 3 x 20 px is 6 px, got ",
                 wheel_scroll_px(0.1, 20, 1000)) && ok
    ok = #expect(wheel_scroll_px(-0.25, 20, 1000) == -15, "a quarter line up is -15 px") && ok
    ok = #expect(wheel_scroll_px(0.05, 3, 1000) == 0, "under half a pixel moves nothing") && ok
    ok = #expect(wheel_scroll_px(1000000.0, 10, 5) == 50 && wheel_scroll_px(-1000000.0, 10, 5) == -50,
                 "cut to max_lines either way") && ok
    ok = #expect(wheel_scroll_px(1.0, 0, 1000) == i64(WHEEL_LINES), "a row under one pixel is one") && ok
    f32 zero = 0.0
    ok = #expect(wheel_scroll_px(zero / zero, 20, 1000) == 0, "NaN moves nothing") && ok

    // ── A TextEdit ───────────────────────────────────────────────────────
    Control ed = text_edit(NIL)
    EditSource src = (lines_count, lines_line, no_insert, no_remove, nil)
    text_edit_set_source(ed, src)
    update(cell.rect(0, 0, 30, 10))
    ok = #expect(offset(ed) == 0, "starts at the top") && ok

    // A whole notch moves exactly what it always did: WHEEL_LINES rows,
    // the same as scrolling that many lines.
    ok = #expect(dispatch(notch(1)), "a notch is handled") && ok
    ok = #expect(offset(ed) == i64(WHEEL_LINES), "a notch down is WHEEL_LINES rows, got ", offset(ed)) && ok
    ok = #expect(dispatch(notch(-1)) && offset(ed) == 0, "and one up comes back") && ok
    _ = text_edit_scroll_lines(ed, i64(WHEEL_LINES) * 2)
    i64 by_lines = offset(ed)
    _ = text_edit_scroll_lines(ed, 0 - i64(WHEEL_LINES) * 2)
    _ = dispatch(notch(2))
    ok = #expect(offset(ed) == by_lines, "two notches equal 2 x WHEEL_LINES lines: ", offset(ed), " vs ", by_lines) && ok
    _ = dispatch(notch(-2))

    // A fine event of exactly a line is a notch.
    _ = dispatch(fine(1000))
    ok = #expect(offset(ed) == i64(WHEEL_LINES), "1.000 line, fine, is a notch, got ", offset(ed)) && ok
    _ = dispatch(fine(-1000))

    // A fraction scrolls that fraction: 10/3 lines x 3 = 10 rows. Cut to its
    // sign, as the decode used to, it would have been a whole notch (3).
    _ = dispatch(fine(3334))
    ok = #expect(offset(ed) == 10, "3.334 lines scroll 10 rows, not a whole number of notches, got ", offset(ed)) && ok
    // And a fraction too small for one pixel moves nothing, where
    // `wheel_delta` would have moved a whole notch.
    i64 here = offset(ed)
    ok = #expect(input.wheel_delta(fine(100)) == 1, "wheel_delta rounds 0.1 up to a notch") && ok
    ok = #expect(dispatch(fine(100)), "a sub-pixel turn is still handled") && ok
    ok = #expect(offset(ed) == here, "0.1 line x 3 x 1 px rounds to nothing, got ", offset(ed) - here) && ok
    _ = dispatch(fine(-500))
    ok = #expect(offset(ed) == here - 2, "half a line up is -1.5 px, rounded away to -2, got ", offset(ed) - here) && ok

    reset()
    if ok:
        return 0
    return 1
