@test
// The text edit's line-number gutter with no window (a pixel is a cell): its
// width by line count, the text of a row, the rows it numbers after a
// scroll, presses and the horizontal follow reckoned from its right edge, and
// what a keystroke repaints with it on — the text of the one line and no
// gutter; the gutter too when the caret changes lines or the count changes;
// everything when its width changes or the theme does.
package ui

import "app:input"
import "app:ui/cell"

// ── An in-memory document ──────────────────────────────────────────────────

private type GLine: (ref []char8 text, i32 len)
private type GDoc: (ref []GLine lines, i64 n)
private type GDocPtr: ^GDoc

private GDoc g_gdoc

private string8 gline(^GDoc d, i64 i):
    if i < 0 || i >= d.n || d.lines[i].text == nil || d.lines[i].len == 0:
        return ""
    return string8(d.lines[i].text[0..<d.lines[i].len])

private void gset(^GDoc d, i64 i, string8 a, string8 b):
    i64 n = #len(a) + #len(b)
    i64 cap = n
    if cap < 1:
        cap = 1
    ref []char8 t = #make([]char8, cap)
    for k in 0..<#len(a):
        t[k] = a[k]
    for k in 0..<#len(b):
        t[#len(a) + i64(k)] = b[k]
    if d.lines[i].text != nil:
        #delete(d.lines[i].text)
    d.lines[i].text = t
    d.lines[i].len = i32(n)

private void gopen(^GDoc d, i64 at):
    if d.lines == nil:
        d.lines = #make([]GLine, 4)
    if d.n >= #len(d.lines):
        _ = #resize(d.lines, #len(d.lines) * 2)
    i64 k = d.n
    for k > at:
        d.lines[k] = d.lines[k - 1]
        k = k - 1
    d.lines[at].text = nil
    d.lines[at].len = 0
    d.n = d.n + 1

private void gpush(string8 s):
    gopen(&g_gdoc, g_gdoc.n)
    gset(&g_gdoc, g_gdoc.n - 1, s, "")

private void gclear():
    for i in 0..<g_gdoc.n:
        if g_gdoc.lines[i].text != nil:
            #delete(g_gdoc.lines[i].text)
            g_gdoc.lines[i].text = nil
    g_gdoc.n = 0

private i64 gcount(rawptr ctx):
    return GDocPtr(ctx).n

private string8 gline_fn(rawptr ctx, i64 i):
    return gline(GDocPtr(ctx), i)

// Inserts one line's worth of text, or one "\n"; enough for this test.
private cell.TextPos ginsert(rawptr ctx, cell.TextPos p, string8 text):
    ^GDoc d = GDocPtr(ctx)
    if p.line < 0 || p.line >= d.n || #len(text) == 0:
        return p
    string8 line = gline(d, p.line)
    i64 tn = #len(line) - i64(p.byte)
    ref []char8 tail = #make([]char8, tn + 1)
    for k in 0..<tn:
        tail[k] = line[i64(p.byte) + i64(k)]
    string8 tail_s = string8(tail[0..<tn])
    cell.TextPos end = p
    if text == "\n":
        string8 whole = gline(d, p.line)
        gset(d, p.line, whole[0..<i64(p.byte)], "")
        gopen(d, p.line + 1)
        gset(d, p.line + 1, tail_s, "")
        end = cell.pos(p.line + 1, 0)
    else:
        string8 whole = gline(d, p.line)
        gset(d, p.line, whole[0..<i64(p.byte)], text)
        string8 done = gline(d, p.line)
        gset(d, p.line, done, tail_s)
        end = cell.pos(p.line, p.byte + i32(#len(text)))
    #delete(tail)
    return end

private bool gremove(rawptr ctx, cell.TextPos from, cell.TextPos to):
    ^GDoc d = GDocPtr(ctx)
    if from.line < 0 || to.line >= d.n || !cell.pos_before(from, to):
        return false
    string8 head = gline(d, from.line)
    string8 a = head[0..<i64(from.byte)]
    string8 b = gline(d, to.line)
    gset(d, from.line, a, b[i64(to.byte)..<#len(b)])
    i64 gone = to.line - from.line
    if gone > 0:
        for k in (from.line + 1)..<(to.line + 1):
            if d.lines[k].text != nil:
                #delete(d.lines[k].text)
        for k in (to.line + 1)..<d.n:
            d.lines[k - gone] = d.lines[k]
        d.n = d.n - gone
    return true

private EditSource gsource():
    EditSource s = (gcount, gline_fn, ginsert, gremove, rawptr(&g_gdoc))
    return s

// ── Events ─────────────────────────────────────────────────────────────────

private f64 g_gnow = 50.0

private f64 g_clock():
    return g_gnow

private bool gkey(input.Keycode k):
    input.Event e = (input.EventKind.Key, i32(k), 0.0, 0.0, 0)
    return dispatch(e)

private bool gtyped(i32 cp):
    input.Event e = (input.EventKind.Text, cp, 0.0, 0.0, 0)
    return dispatch(e)

// A press and its release a second after the last, so never a double-click.
private void gclick(i32 col, i32 row):
    g_gnow = g_gnow + 1.0
    input.Event p = (input.EventKind.Mouse, 0, f32(col), f32(row), u32(input.Modifier.Lmb))
    _ = dispatch(p)
    input.Event r = (input.EventKind.Mouse, 0, f32(col), f32(row), input.MOUSE_UP)
    _ = dispatch(r)

// ── Observers ──────────────────────────────────────────────────────────────

private cell.CellRect g_gscreen

// Text lines and gutter rows painted by one `update`.
private (i64 lines, i64 gutter) gframe(Control c):
    (i64 e0, i64 l0) = text_edit_counters(c)
    i64 g0 = text_edit_gutter_painted(c)
    update(g_gscreen)
    (i64 e1, i64 l1) = text_edit_counters(c)
    _ = e0
    _ = e1
    return (l1 - l0, text_edit_gutter_painted(c) - g0)

private bool painted(Control c, i64 lines, i64 gutter, string8 what):
    (i64 l, i64 g) = gframe(c)
    return #expect(l == lines && g == gutter, what, ": painted ", l, " lines, ", g, " gutter rows; want ", lines, ", ", gutter)

private bool gat(Control c, i64 line, i32 byte, string8 what):
    cell.TextPos p = text_edit_caret(c)
    return #expect(p.line == line && p.byte == byte, what, ": caret ", p.line, ",", p.byte, " want ", line, ",", byte)

private bool row_says(Control c, i32 row, string8 want, string8 what):
    [16]char8 buf
    string8 got = text_edit_gutter_text(c, row, buf[:])
    return #expect(got == want, what, ": row ", row, " '", got, "' want '", want, "'")

// Every child two columns left of the holder and two wider.
private void left_cut_arrange(Control c, rawptr st, cell.CellRect r):
    _ = st
    Control ch = first_child(c)
    for valid(ch):
        set_rect(ch, cell.rect(r.col - 2, r.row, r.cols + 2, r.rows))
        ch = next_sibling(ch)

i32 test():
    bool ok = true
    [8]char8 buf

    // ── Width by line count ────────────────────────────────────────────────
    ok = #expect(edit_gutter_digits(0) == 3 && edit_gutter_digits(9) == 3 && edit_gutter_digits(999) == 3, "three digits at least") && ok
    ok = #expect(edit_gutter_digits(1000) == 4 && edit_gutter_digits(9999) == 4 && edit_gutter_digits(10000) == 5, "a digit per power of ten") && ok
    ok = #expect(edit_gutter_width(9, 1) == 4 && edit_gutter_width(1000, 2) == 6 && edit_gutter_width(5, -3) == 3, "digits plus padding") && ok

    // ── The text of a row ──────────────────────────────────────────────────
    ok = #expect(edit_gutter_text(0, 9, 3, buf[:]) == "  1", "line 0 is 1") && ok
    ok = #expect(edit_gutter_text(8, 9, 3, buf[:]) == "  9", "line 8 is 9") && ok
    ok = #expect(edit_gutter_text(9, 9, 3, buf[:]) == "   " && edit_gutter_text(-1, 9, 3, buf[:]) == "   ", "no such line: blank") && ok
    ok = #expect(edit_gutter_text(999, 1000, 4, buf[:]) == "1000" && edit_gutter_text(41, 1000, 4, buf[:]) == "  42", "right-aligned in four") && ok
    ok = #expect(edit_gutter_text(0, 9, 9, buf[:]) == "" && edit_gutter_text(0, 9, 0, buf[:]) == "", "too short a buffer, no digits") && ok

    // ── In a tree: 30 lines in a 20 x 5 view ───────────────────────────────
    g_edit_clock = g_clock
    g_gscreen = cell.rect(0, 0, 20, 5)
    for i in 0..<29:
        gpush("line")
    gpush("0123456789abcdefghijklmnopqrstuvwxyz0123")
    Control ed = text_edit(NIL)
    ok = #expect(text_edit_gutter(ed), "on by default") && ok
    set_focus(ed)
    text_edit_set_source(ed, gsource())
    ok = painted(ed, 5, 5, "first paint: every row, gutter and text") && ok
    ok = #expect(text_edit_gutter_width(ed) == 4, "three digits and a pad: ", text_edit_gutter_width(ed)) && ok
    ok = row_says(ed, 0, "  1", "top") && row_says(ed, 4, "  5", "bottom") && row_says(ed, 5, "", "below the view") && ok
    ok = painted(ed, 0, 0, "idle") && ok

    // ── What a keystroke repaints ──────────────────────────────────────────
    _ = gtyped(i32('x'))
    ok = painted(ed, 1, 0, "typing: its line, no gutter") && ok
    _ = gkey(input.Keycode.Right)
    ok = painted(ed, 1, 0, "along the line: its line, no gutter") && ok
    _ = gkey(input.Keycode.Down)
    ok = painted(ed, 2, 2, "to the next line: both lines and both numbers") && ok
    _ = gkey(input.Keycode.Enter)
    ok = painted(ed, 4, 4, "a new line: from it down, numbers too") && ok
    ok = #expect(g_gdoc.n == 31, "31 lines") && ok
    _ = gkey(input.Keycode.Backspace)
    ok = painted(ed, 4, 4, "a joined line: from it down, numbers too") && ok

    // ── Scrolled, the numbers follow the text ──────────────────────────────
    ok = #expect(text_edit_scroll_lines(ed, 10), "scrolled") && ok
    ok = painted(ed, 5, 5, "a scroll repaints all") && ok
    ok = row_says(ed, 0, " 11", "scrolled top") && row_says(ed, 3, " 14", "scrolled row 3") && ok

    // ── Presses: in the gutter, the line's start; beyond, text columns ─────
    gclick(1, 2)
    ok = gat(ed, 12, 0, "a press in the gutter") && ok
    gclick(6, 1)
    ok = gat(ed, 11, 2, "a press two cells right of the gutter") && ok
    gclick(4, 3)
    ok = gat(ed, 13, 0, "a press on the text's first column") && ok
    // The horizontal follow is in text columns: 16 of them here.
    text_edit_set_caret(ed, cell.pos(29, 0))
    _ = gkey(input.Keycode.End)
    ok = gat(ed, 29, 40, "end of the long line") && ok
    ok = #expect(text_edit_left_col(ed) == 40 - 16 + 1, "follow in text columns: left ", text_edit_left_col(ed)) && ok
    _ = gframe(ed)
    gclick(4, 4)
    ok = gat(ed, 29, 25, "a press at the text's left edge is the left column") && ok
    gclick(1, 4)
    ok = gat(ed, 29, 0, "scrolled sideways, a press in the gutter is still the line's start") && ok
    _ = gkey(input.Keycode.Home)
    _ = gframe(ed)

    // ── Off: the text starts at the view's edge ────────────────────────────
    text_edit_set_gutter(ed, false)
    ok = #expect(text_edit_gutter_width(ed) == 0 && row_says(ed, 0, "", "off"), "off: no gutter") && ok
    ok = painted(ed, 5, 0, "turned off: all text, no gutter") && ok
    (i64 top, i64 _) = text_edit_position(ed)
    gclick(2, 0)
    ok = gat(ed, top, 2, "off: column 2 is byte 2") && ok
    text_edit_set_gutter(ed, true)
    ok = painted(ed, 5, 5, "turned on: all") && ok

    // ── A width change repaints all ────────────────────────────────────────
    for g_gdoc.n < 999:
        gpush("more")
    text_edit_set_source(ed, gsource())
    _ = gframe(ed)
    ok = #expect(text_edit_gutter_width(ed) == 4, "999 lines: still three digits") && ok
    text_edit_set_caret(ed, cell.pos(998, 4))
    _ = gframe(ed)
    _ = gkey(input.Keycode.Enter)
    ok = #expect(g_gdoc.n == 1000 && text_edit_gutter_width(ed) == 5, "1000 lines: four digits") && ok
    ok = painted(ed, 5, 5, "a wider gutter repaints all") && ok
    ok = row_says(ed, 4, "1000", "the last row") && row_says(ed, 0, " 996", "four digits, right-aligned") && ok
    _ = gtyped(i32('q'))
    ok = painted(ed, 1, 0, "typing at four digits: one line") && ok
    _ = gkey(input.Keycode.Backspace)
    _ = gkey(input.Keycode.Backspace)
    ok = #expect(g_gdoc.n == 999 && text_edit_gutter_width(ed) == 4, "back to 999") && ok
    ok = painted(ed, 5, 5, "a narrower gutter repaints all") && ok

    // ── A theme change repaints all; the highlight damages like the caret ──
    ThemeDesc d = theme_default()
    d.current_line_bg = [30, 33, 40, 255]
    d.gutter_padding = 2
    theme_set(&d)
    ok = #expect(text_edit_gutter_width(ed) == 5, "the theme's padding") && ok
    ok = painted(ed, 5, 5, "a new theme repaints all") && ok
    _ = gkey(input.Keycode.Up)
    ok = painted(ed, 2, 2, "the highlighted line moves: two lines") && ok
    _ = gtyped(i32('z'))
    ok = painted(ed, 1, 0, "typing under the highlight: one line") && ok

    // ── Cut on its left by an ancestor: the digits keep their columns ─────
    // The holder places the edit two columns left of itself, so its first two
    // columns fall outside every clip: the gutter is drawn from column -2,
    // and "  1" shows its "1" at column 0 rather than moving right.
    reset()
    Hooks lh
    lh.arrange = left_cut_arrange
    Control holder = create(register_kind("left_cut", lh), NIL, nil)
    set_expand(holder, true, true)
    Control cut = text_edit(holder)
    text_edit_set_source(cut, gsource())
    update(g_gscreen)
    ok = #expect(rect(cut).col == -2 && g_gutter_x == -2, "drawn from the gutter's own column: ", g_gutter_x) && ok
    g_edit_clock = nil
    reset()
    gclear()
    if g_gdoc.lines != nil:
        #delete(g_gdoc.lines)
    if ok: return 0
    return 1
