@test
// Mouse routing: the hit map answers the deepest painter of each cell, off
// the screen `NIL`, and stays right across a relayout, a hide, a removal (a
// stale owner reads `NIL`, never the node that reused its slot) and a new
// screen; a press goes to the node under the pointer and bubbles, focuses a
// focusable node first, and captures the mouse for its handler until every
// button is up; explicit capture outlasts a release and goes with its node;
// the wheel goes to the node under the pointer, not the focus; keys still go
// to the focus; the hover follows the pointer.
package ui

import "app:input"
import "app:ui/cell"
import "app:ui/grid"

// ── Test kinds ─────────────────────────────────────────────────────────────
//
// `m_leaf`: its minimum is `(4, rows)` from its state, it paints nothing, and
// its input hook logs every event offered as (node, mouse kind) and handles
// mouse events when bit 1 of `takes` is set and keys when bit 2 is.
// `m_box`: a vbox with the same input hook.

private type MState: (i32 rows, i32 takes)
private type MStatePtr: ^MState

private const i32 MOUSE = 1
private const i32 KEYS = 2

private [32]Control g_m_node
private [32]input.MouseKind g_m_kind
private i32 g_m_n

private bool m_input(Control c, rawptr st, input.Event e):
    if g_m_n < #len(g_m_node):
        g_m_node[g_m_n] = c
        g_m_kind[g_m_n] = input.mouse_kind(e)
    g_m_n = g_m_n + 1
    ^MState s = MStatePtr(st)
    if e.kind == input.EventKind.Mouse:
        return (s.takes & MOUSE) != 0
    return (s.takes & KEYS) != 0

private cell.CellPoint m_measure(Control c, rawptr st):
    _ = c
    ^MState s = MStatePtr(st)
    cell.CellPoint p = (4, s.rows)
    return p

private void m_paint(Control c, rawptr st, cell.CellRect r):
    _ = c
    _ = st
    _ = r

private Kind g_m_leaf = NO_KIND
private Kind g_m_box = NO_KIND

private void m_kinds():
    Hooks h
    h.measure = m_measure
    h.arrange = nil
    h.paint = m_paint
    h.input = m_input
    h.free = nil
    g_m_leaf = register_kind("m_leaf", h)
    h.measure = vbox_measure_hook
    h.arrange = vbox_arrange_hook
    h.paint = nil
    g_m_box = register_kind("m_box", h)

// A mouse event at the middle of cell `(col, row)`: the grid is not up, so a
// pixel is a cell, and the half shows the position is floored, not rounded.
private input.Event m_ev(i32 code, i32 col, i32 row, u32 mods):
    input.Event e = (input.EventKind.Mouse, code, f32(col) + f32(0.5), f32(row) + f32(0.5), mods)
    return e

private const u32 LMB = 0x100
private const u32 RMB = 0x200

private input.Event m_press(i32 col, i32 row):
    return m_ev(0, col, row, LMB)

private input.Event m_release(i32 col, i32 row):
    return m_ev(0, col, row, input.MOUSE_UP)

private input.Event m_motion(i32 col, i32 row, u32 held):
    return m_ev(-1, col, row, held | input.MOUSE_MOTION)

private input.Event m_wheel(i32 col, i32 row):
    return m_ev(1, col, row, input.MOUSE_WHEEL)

private bool m_offered(i32 at, Control c, input.MouseKind k):
    return at < g_m_n && g_m_node[at] == c && g_m_kind[at] == k

i32 test():
    bool ok = true
    m_kinds()
    ok = #expect(grid.cell_w() == 0 && grid.cell_h() == 0, "no grid: a pixel is a cell") && ok

    // ── Coordinates ───────────────────────────────────────────────────────
    input.Event e = (input.EventKind.Mouse, 0, f32(3.7), f32(2.2), LMB)
    cell.CellPoint p = event_cell(e)
    ok = #expect(p.col == 3 && p.row == 2, "floored ", p.col, " ", p.row) && ok
    e.x = f32(-0.5)
    e.y = f32(-3.2)
    p = event_cell(e)
    ok = #expect(p.col == -1 && p.row == -4, "negative floors down, not to zero ", p.col, " ", p.row) && ok
    e.x = f32(1.0e30)
    p = event_cell(e)
    ok = #expect(p.col == 1000000000, "an absurd position is clamped ", p.col) && ok

    // ── The map before anything is laid out ───────────────────────────────
    ok = #expect(hit(0, 0) == NIL && hovered() == NIL, "no screen, no owner") && ok

    //  root (20 x 10)
    //  └── box (m_box: handles mouse and keys)       rows 0..4
    //      ├── a (m_leaf, 2 rows)                   rows 0..1
    //      └── b (m_leaf, 3 rows, focusable)        rows 2..4
    //  rows 5..9: the root's
    MState sbox = (0, MOUSE | KEYS)
    MState sa = (2, 0)
    MState sb = (3, 0)
    Control box = create(g_m_box, NIL, rawptr(&sbox))
    Control a = create(g_m_leaf, box, rawptr(&sa))
    Control b = create(g_m_leaf, box, rawptr(&sb))
    set_focusable(b, true)
    Control top = root()
    update(cell.rect(0, 0, 20, 10))

    ok = #expect(hit(0, 0) == a && hit(19, 1) == a, "a owns rows 0..1 across the width") && ok
    ok = #expect(hit(0, 2) == b && hit(19, 4) == b, "b owns rows 2..4") && ok
    ok = #expect(hit(0, 5) == top && hit(19, 9) == top, "the gap below is the root's") && ok
    ok = #expect(hit(-1, 0) == NIL && hit(0, -1) == NIL && hit(20, 0) == NIL && hit(0, 10) == NIL, "off the screen") && ok

    // An idle update writes nothing and changes nothing.
    Stats before = stats()
    update(cell.rect(0, 0, 20, 10))
    ok = #expect(stats().updates_idle == before.updates_idle + 1 && stats().painted == 0, "idle") && ok
    ok = #expect(hit(0, 3) == b, "and the map stands") && ok

    // ── Press: routed by position, bubbles, focuses, captures ─────────────
    g_m_n = 0
    ok = #expect(dispatch(m_press(1, 3)), "the press is handled by box") && ok
    ok = #expect(m_offered(0, b, input.MouseKind.Press) && m_offered(1, box, input.MouseKind.Press) && g_m_n == 2,
        "b first, then box ", g_m_n) && ok
    ok = #expect(focused() == b, "the press focused b") && ok
    ok = #expect(captured() == box, "the handler captured the mouse") && ok

    // A drag leaving the box still goes to the box.
    g_m_n = 0
    ok = #expect(dispatch(m_motion(15, 8, LMB)), "motion outside, handled") && ok
    ok = #expect(m_offered(0, box, input.MouseKind.Motion) && g_m_n == 1, "to the capturing node alone ", g_m_n) && ok
    ok = #expect(hovered() == top, "the hover is where the pointer is, capture or not") && ok
    g_m_n = 0
    ok = #expect(dispatch(m_release(15, 8)), "release, to the captor") && ok
    ok = #expect(m_offered(0, box, input.MouseKind.Release) && g_m_n == 1, "the captor saw the release") && ok
    ok = #expect(captured() == NIL, "every button up ends the capture") && ok
    g_m_n = 0
    ok = #expect(!dispatch(m_motion(15, 8, 0)) && g_m_n == 0, "free again: the root has no hook") && ok

    // Two buttons: releasing one keeps the capture.
    sa.takes = MOUSE
    ok = #expect(dispatch(m_press(0, 0)) && captured() == a, "a takes it") && ok
    ok = #expect(focused() == b, "a is not focusable and nor is anything above it: focus stays") && ok
    ok = #expect(dispatch(m_ev(1, 10, 9, LMB | RMB)) && captured() == a, "a second button, off a, to a") && ok
    ok = #expect(dispatch(m_ev(1, 10, 9, LMB | input.MOUSE_UP)) && captured() == a, "one still held") && ok
    ok = #expect(dispatch(m_ev(0, 10, 9, input.MOUSE_UP)) && captured() == NIL, "none held") && ok

    // A press nobody handles captures nothing.
    ok = #expect(!dispatch(m_press(3, 7)) && captured() == NIL, "the root's gap") && ok
    // Off the screen: nothing under it, nothing offered.
    g_m_n = 0
    input.Event far = (input.EventKind.Mouse, 0, f32(-5.0), f32(-5.0), LMB)
    ok = #expect(!dispatch(far) && g_m_n == 0, "off the screen") && ok

    // ── Wheel: the node under the pointer, not the focus ──────────────────
    ok = #expect(focused() == b, "b still has focus") && ok
    g_m_n = 0
    ok = #expect(dispatch(m_wheel(2, 1)), "wheel handled") && ok
    ok = #expect(m_offered(0, a, input.MouseKind.Wheel) && g_m_n == 1, "a, under the pointer, took it") && ok
    ok = #expect(focused() == b, "the wheel does not focus") && ok

    // ── Keys still go to the focus ────────────────────────────────────────
    input.Event key
    key.kind = input.EventKind.Key
    key.code = 65
    g_m_n = 0
    ok = #expect(dispatch(key), "key handled") && ok
    ok = #expect(m_offered(0, b, input.MouseKind.None) && m_offered(1, box, input.MouseKind.None) && g_m_n == 2,
        "b then box, wherever the pointer is ", g_m_n) && ok

    // ── Explicit capture ──────────────────────────────────────────────────
    capture(b)
    ok = #expect(captured() == b, "captured") && ok
    g_m_n = 0
    ok = #expect(dispatch(m_motion(0, 0, 0)), "motion over a") && ok
    ok = #expect(m_offered(0, b, input.MouseKind.Motion) && m_offered(1, box, input.MouseKind.Motion), "went to b and bubbled") && ok
    ok = #expect(dispatch(m_press(0, 0)) && dispatch(m_release(0, 0)) && captured() == b, "a release does not end it") && ok
    release()
    ok = #expect(captured() == NIL, "released") && ok
    capture(NIL)
    ok = #expect(captured() == NIL, "NIL captures nothing") && ok

    // ── Relayout: ownership follows ───────────────────────────────────────
    sa.rows = 4
    mark_layout(a)
    update(cell.rect(0, 0, 20, 10))
    ok = #expect(hit(0, 3) == a && hit(0, 4) == b && hit(0, 6) == b && hit(0, 7) == top, "a grew to 4 rows") && ok
    sa.rows = 1
    mark_layout(a)
    update(cell.rect(0, 0, 20, 10))
    ok = #expect(hit(0, 0) == a && hit(0, 1) == b && hit(0, 3) == b && hit(0, 4) == top && hit(0, 6) == top,
        "shrank to 1: the rows given back are the root's again") && ok

    // The box fills the screen: the gap is now its own.
    set_expand(box, false, true)
    update(cell.rect(0, 0, 20, 10))
    ok = #expect(hit(0, 4) == box && hit(19, 9) == box && hit(0, 2) == b, "the box's gap") && ok
    ok = #expect(hovered() == a, "the hover follows the relayout: (0, 0) is a ") && ok

    // ── Hiding: the parent repaints and owns the cells ────────────────────
    set_visible(b, false)
    update(cell.rect(0, 0, 20, 10))
    ok = #expect(hit(0, 1) == box && hit(0, 3) == box && hit(0, 0) == a, "b's rows are the box's") && ok
    set_visible(b, true)
    update(cell.rect(0, 0, 20, 10))
    ok = #expect(hit(0, 2) == b, "shown again") && ok

    // ── Removal: stale owners read NIL, the reused slot is not reachable ──
    remove(b)
    ok = #expect(hit(0, 2) == NIL, "before the repaint: the removed owner reads NIL") && ok
    MState sc = (3, 0)
    Control c = create(g_m_leaf, box, rawptr(&sc))
    ok = #expect(c.slot == b.slot, "c reuses b's slot ", c.slot, " ", b.slot) && ok
    ok = #expect(hit(0, 2) == NIL, "and is not reached through b's old owner") && ok
    update(cell.rect(0, 0, 20, 10))
    ok = #expect(hit(0, 2) == c && hit(0, 1) == c && hit(0, 4) == box, "after the repaint: c, then the box") && ok

    // A removed captor releases the capture.
    ok = #expect(dispatch(m_press(0, 0)) && captured() == a, "a captures") && ok
    remove(a)
    ok = #expect(captured() == NIL, "gone with a") && ok
    g_m_n = 0
    ok = #expect(dispatch(m_motion(0, 5, LMB)) && m_offered(0, box, input.MouseKind.Motion), "motion falls to what is under it") && ok
    ok = #expect(hit(0, 0) == NIL, "a's rows read NIL until the repaint") && ok
    update(cell.rect(0, 0, 20, 10))
    ok = #expect(hit(0, 0) == c, "c moved up") && ok

    // ── A new screen, not at the origin ───────────────────────────────────
    update(cell.rect(2, 1, 30, 12))
    ok = #expect(hit(0, 0) == NIL && hit(1, 1) == NIL && hit(2, 1) == c && hit(31, 12) == box && hit(32, 12) == NIL,
        "the map moved with the screen") && ok

    // Hiding the root: nothing is under the pointer.
    set_visible(top, false)
    ok = #expect(hit(2, 1) == NIL, "hidden root") && ok
    set_visible(top, true)

    reset()
    ok = #expect(hit(2, 1) == NIL && hovered() == NIL && captured() == NIL, "reset forgets the map") && ok
    if ok: return 0
    return 1
