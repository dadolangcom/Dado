@test
// Themes with no window: the StyleBox helpers (bleed rounded up at several
// cell sizes, the content rect clamped, the minimum), the lazy compile of the
// default, the default equal to the colours the widgets were drawn in before
// themes, and `theme_set` changing a field, bumping the generation, marking
// the tree, and refused during `update`.
package ui

import "app:ui/cell"

private bool same([4]u8 a, u8 r, u8 g, u8 b, u8 al):
    return a[0] == r && a[1] == g && a[2] == b && a[3] == al

private bool rect_is(cell.CellRect r, i32 col, i32 row, i32 cols, i32 rows):
    return r.col == col && r.row == row && r.cols == cols && r.rows == rows

private bool bleed_is(StyleBox b, i32 cw, i32 ch, i32 l, i32 t, i32 r, i32 d, string8 what):
    (i32 bl, i32 bt, i32 br, i32 bd) = bleed_cells(b, cw, ch)
    return #expect(bl == l && bt == t && br == r && bd == d, what, ": bleed ", bl, " ", bt, " ", br, " ", bd, " want ", l, " ", t, " ", r, " ", d)

private i64 g_gen_seen
private i32 g_poked

private cell.CellPoint poke_min(Control c, rawptr st):
    _ = c
    _ = st
    cell.CellPoint p = (1, 1)
    return p

// A paint that tries to change the theme mid-update: refused.
private void poke_theme(Control c, rawptr st, cell.CellRect r):
    _ = c
    _ = st
    _ = r
    g_poked = g_poked + 1
    ThemeDesc d = theme_default()
    d.text_fg = [1, 1, 1, 255]
    theme_set(&d)
    g_gen_seen = theme_generation()

i32 test():
    bool ok = true
    [4]u8 ink = [0, 0, 0, 128]

    // ── Nothing is compiled until something reads ──────────────────────────
    ok = #expect(!g_theme_ready && g_theme_gen == 0, "nothing compiled before the first read") && ok
    LabelTheme lt = theme_label()
    ok = #expect(g_theme_ready && theme_generation() == 1, "the first read compiles the default once: gen ", theme_generation()) && ok
    _ = theme_edit()
    _ = theme_panel()
    ok = #expect(theme_generation() == 1, "later reads compile nothing") && ok

    // ── The default is the old look, exactly ───────────────────────────────
    EditTheme et = theme_edit()
    ok = #expect(same(et.fg, 216, 222, 233, 255) && same(et.bg, 22, 24, 29, 255), "edit text colours") && ok
    ok = #expect(same(et.sel_bg, 58, 74, 110, 255), "selection") && ok
    ok = #expect(et.caret_swap && same(et.caret_fg, 22, 24, 29, 255) && same(et.caret_bg, 216, 222, 233, 255), "caret is the text swapped") && ok
    ok = #expect(et.current_line_bg[3] == 0 && et.gutter_padding == 1, "no current-line highlight; one pad cell") && ok
    ok = #expect(same(et.gutter_bg, 22, 24, 29, 255) && same(et.current_line_number_fg, 216, 222, 233, 255), "gutter on the text background") && ok
    ok = #expect(same(lt.fg, 150, 160, 176, 255) && same(lt.bg, 32, 35, 42, 255), "label colours") && ok
    StatusTheme stt = theme_status()
    ok = #expect(same(stt.fg, 150, 160, 176, 255) && same(stt.bg, 32, 35, 42, 255), "status colours") && ok
    ok = #expect(lt.box.kind == StyleKind.Empty && stt.box.kind == StyleKind.Empty && et.box[STATE_NORMAL].kind == StyleKind.Empty, "no box takes room by default") && ok
    PanelTheme pt = theme_panel()
    StyleBox pn = pt.box[STATE_NORMAL]
    ok = #expect(pn.kind == StyleKind.Flat && pn.border_l == 1 && pn.margin_l == 1 && pn.margin_b == 1, "panel: a hairline in a one-cell margin") && ok
    // No fill: a window-sized fill is paid every frame to be hidden by the
    // text. The window is cleared to the text background instead, and the
    // margin cells are transparent so the border shows.
    ok = #expect(pn.fill[3] == 0 && pt.bg[3] == 0, "panel: no fill, transparent margin cells") && ok
    ok = #expect(same(theme_window_bg(), 22, 24, 29, 255), "the window cleared to the text background") && ok
    ok = #expect(same(pt.box[STATE_FOCUS].border, 88, 110, 160, 255) && same(pt.box[STATE_HOVER].border, 52, 57, 68, 255), "focus has its own border; hover takes normal's") && ok
    ok = #expect(pt.box[STATE_DISABLED].kind == StyleKind.Flat, "every state filled") && ok

    // ── Constructors ───────────────────────────────────────────────────────
    StyleBox e = style_empty()
    ok = #expect(e.kind == StyleKind.Empty && e.margin_l == 0 && !style_has_shadow(e), "empty") && ok
    StyleBox f = style_flat([10, 20, 30, 255], [1, 2, 3, 255], -2, 4, -1)
    ok = #expect(f.border_t == 0 && f.radius == 4 && f.margin_r == 0, "negative widths and margins clamp at zero") && ok
    StyleBox ln = style_line([9, 9, 9, 255], 2, true)
    ok = #expect(ln.kind == StyleKind.Line && ln.line_px == 2 && ln.vertical && same(ln.border, 9, 9, 9, 255), "line") && ok

    // ── Bleed: shadow reach over the cell size, rounded up ─────────────────
    // size 12 moved (4, -2): left 8, right 16, top 14, bottom 10 pixels.
    StyleBox sh = style_with_shadow(style_flat([0, 0, 0, 255], ink, 1, 0, 1), ink, 12, 4, -2)
    ok = bleed_is(sh, 8, 16, 1, 1, 2, 1, "8x16") && ok
    ok = bleed_is(sh, 7, 14, 2, 1, 3, 1, "7x14") && ok
    ok = bleed_is(sh, 16, 32, 1, 1, 1, 1, "16x32") && ok
    ok = bleed_is(sh, 0, 0, 8, 14, 16, 10, "no grid: a pixel a cell") && ok
    // An offset past the size pulls the shadow wholly inside on that side.
    StyleBox far = style_with_shadow(style_flat([0, 0, 0, 255], ink, 1, 0, 1), ink, 4, 10, 0)
    ok = bleed_is(far, 8, 16, 0, 1, 2, 1, "offset past the size") && ok
    // No shadow bleeds nothing, however wide its border: ink inside the rect.
    StyleBox fat = style_flat([0, 0, 0, 255], ink, 30, 0, 1)
    ok = bleed_is(fat, 8, 16, 0, 0, 0, 0, "a border does not bleed") && ok
    ok = bleed_is(style_with_shadow(fat, [0, 0, 0, 0], 12, 0, 0), 8, 16, 0, 0, 0, 0, "a transparent shadow") && ok
    StyleBox eshadow = style_with_shadow(style_empty(), ink, 12, 0, 0)
    ok = bleed_is(eshadow, 8, 16, 0, 0, 0, 0, "an empty box casts nothing") && ok
    // Absurd pixels are held to STYLE_PX_MAX (4096) before they are summed.
    StyleBox huge = style_with_shadow(style_flat([0, 0, 0, 255], ink, 1, 0, 1), ink, 2000000000, -2000000000, 0)
    ok = bleed_is(huge, 8, 16, 1024, 256, 0, 256, "held to 4096 px: size 4096, offset -4096") && ok

    // ── Content rect and minimum: margins in cells, ink ignored ────────────
    StyleBox m = style_with_margins(fat, 1, 2, 3, 0)
    ok = #expect(rect_is(inner_rect(m, cell.rect(2, 3, 10, 5)), 3, 5, 6, 3), "inner rect") && ok
    ok = #expect(rect_is(inner_rect(m, cell.rect(0, 0, 3, 1)), 1, 1, 0, 0), "inner rect clamps at zero extent") && ok
    cell.CellPoint mm = style_minimum(m)
    ok = #expect(mm.col == 4 && mm.row == 2, "minimum ", mm.col, "x", mm.row) && ok
    StyleBox hair = style_flat([0, 0, 0, 255], ink, 1, 0, 1)
    StyleBox bevel = style_flat([0, 0, 0, 255], ink, 3, 0, 1)
    ok = #expect(style_minimum(hair) == style_minimum(bevel) && inner_rect(hair, cell.rect(0, 0, 9, 9)) == inner_rect(bevel, cell.rect(0, 0, 9, 9)), "a hairline and a bevel cost the same room") && ok
    ok = #expect(style_minimum(style_with_margins(e, -4, 2, -1, 0)).col == 0, "negative margins read as zero") && ok

    // ── theme_set: a field, the generation, the tree marked ────────────────
    Control lab = label(NIL, "x")
    update(cell.rect(0, 0, 20, 4))
    ok = #expect(!is_layout_dirty(lab), "clean before") && ok
    ThemeDesc d = theme_default()
    d.gutter_fg = [1, 2, 3, 255]
    d.caret_swap = false
    d.caret_fg = [4, 5, 6, 255]
    d.caret_bg = [7, 8, 9, 255]
    theme_set(&d)
    ok = #expect(theme_generation() == 2, "theme_set bumps the generation") && ok
    EditTheme e2 = theme_edit()
    ok = #expect(same(e2.gutter_fg, 1, 2, 3, 255) && same(e2.fg, 216, 222, 233, 255), "one field changed, the rest kept") && ok
    ok = #expect(same(e2.caret_fg, 4, 5, 6, 255) && same(e2.caret_bg, 7, 8, 9, 255), "no swap: the desc's caret colours") && ok
    ok = #expect(is_layout_dirty(lab) && is_layout_dirty(root()), "every node marked for layout") && ok
    update(cell.rect(0, 0, 20, 4))

    // During update it is refused: generation and tables stay.
    Hooks h
    h.measure = poke_min
    h.arrange = nil
    h.paint = poke_theme
    h.input = nil
    h.free = nil
    Control pk = create(register_kind("theme_poker", h), NIL, nil)
    update(cell.rect(0, 0, 20, 4))
    ok = #expect(g_poked == 1 && g_gen_seen == 2 && theme_generation() == 2, "refused during update") && ok
    ok = #expect(same(theme_edit().fg, 216, 222, 233, 255), "the tables kept") && ok
    remove(pk)

    reset()
    ThemeDesc defaults = theme_default()
    theme_set(&defaults)
    ok = #expect(theme_generation() == 3, "with no tree, still compiles") && ok
    if ok: return 0
    return 1
