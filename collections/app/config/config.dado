// app:config — self-provisioning settings, over core:cfg.
//
//     import "app:config"
//
//     void seed(^config.Config c):
//         config.set_i32(c, "window", "width", 1280)
//         config.set_i32(c, "window", "height", 720)
//
//     (config.Config c, bool created, bool ok, i32 bad) = config.load("settings.ini", seed)
//     defer config.destroy(&c)
//     i32 width = config.get_i32(c, "window", "width", 1280)
//
// **Self-provisioning** is the whole point: `load` on a path with
// nothing there yet calls the caller's `DefaultsFn` to seed sane values into
// a fresh `Config`, writes it, and hands that back with `created` true. A
// later run finds the file and just reads it — same call either way, so a
// program does not carry two code paths for "first run" vs "every run
// after." `example/` demonstrates the round-trip end to end.
//
// **Neutral**: this imports `app:app` for its persistent allocator
// and nothing backend-specific, so a server reads config the same way a
// terminal or graphical program does.
//
// **Opinion over mechanism.** Everything here forwards to `core:cfg`, fixing
// one allocator (`app.allocator()`) so a program never plumbs one through —
// that is the entire value add. A program that wants its own allocator, or
// the untyped `Config` value's own shape, reaches for `core:cfg` directly;
// nothing here is otherwise reachable only through this package.
//
// **Where a `Config` lands, and how a caller says so.** `core:cfg` takes an
// allocator in every signature, which is the convention this collection does
// not use: an allocator is not threaded through parameter lists here, it is
// the ambient one and `using` is how it is changed. So the two forms this
// package offers are the ambient and the opinion, and neither is a parameter:
//
//     config.load(path, seed)                              // app.allocator()
//     config.load_with(path, seed)                         // the caller's own default
//     config.load_with(path, seed) using arena.allocator(&a)   // in `a`
//
// `load` is now literally `load_with` under a `using`, which is the whole of
// what "fixing one allocator" means and is one line rather than an argument
// threaded down. `load_with` writes `#default` where `core:cfg` insists on a
// value, and `#default` *is* the ambient — so the caller's `using` reaches the
// `core:cfg` call underneath without this file naming a place.
//
// **Who ends a `Config`.** The caller that loaded it, with `destroy(&c)` —
// every value, every section and the map, wherever `load`/`load_with` put
// them; or, for one loaded under a `using` arena, the arena's own end, and no
// `destroy` at all. A `set_*` over an existing key frees the value it
// replaces, so a program that reloads or rewrites its settings holds one
// config's worth, not one per reload (`core:cfg` has the why).
// One seam: the `set_*` forwarders below allocate from `app.allocator()`, not
// the ambient, so a value *set* on an arena-loaded `Config` is not the
// arena's — `destroy` such a config too, before the arena ends (a `Free`
// through an arena is a no-op, so that is safe).
//
// `DefaultsFn` lost its allocator for the same reason. A seed function is
// called from inside `load_with`, under whatever the caller arranged, so an
// allocator parameter on it was a value with exactly one correct argument.
package config

import "core:cfg"
import "app:app"

// section -> key -> value: **`core:cfg`'s `Config` itself**, by a qualified
// alias. This used to be a second declaration of the same map shape, kept
// because an alias to an imported type was once a false ERR0501 (fixed
// 2026-09-18). Making values freeable changed the shape — a value is an owned
// `ref []char8` now, so `destroy` can end it — and a copy that has to be kept
// in step by hand is one that eventually is not, so it is the alias now.
type Config: cfg.Config

// Called once, only when `load` finds nothing at the path, to seed a fresh
// `Config` before it is written to disk for the first time.
//
// It takes no allocator: it is called from inside `load_with`, so the ambient
// it runs under is already the one the `Config` is being built in.
// **It takes the `Config` by pointer**, because seeding one is inserting into
// it and a map arrives by value: a seed function given a `Config` would be
// filling its own copy of the table pointer, and `load_with` would write an
// empty file. ERR0819 refuses the body that would do it, so this signature is
// what a seed function can be written against at all.
type DefaultsFn: void(^Config)

// Load `path` with `app.allocator()`. See `load_with` for the form that takes
// the caller's own ambient instead.
(Config c, bool created, bool ok, i32 bad_lines) load(cstring path, DefaultsFn defaults):
    return load_with(path, defaults) using app.allocator()

// Load `path`, or self-provision it. If `path` exists, this is exactly
// `core:cfg.load` — `created` is false and `ok`/`bad_lines` report on the
// parse. If it does not, `defaults` (which may be `nil` for an empty file)
// seeds a fresh `Config`, `core:cfg.save` writes it, and `created` is true,
// `ok` true, `bad_lines` 0 — a fresh file has nothing to have gotten wrong.
//
// **It takes no allocator.** The `Config` lands in the ambient one, so
// `load_with(path, seed) using a` puts it in `a` and `load` is this same call
// under `app.allocator()`. The `#default`s written below are not a place this
// file chose: `#default` names whatever the caller installed, and it is
// written only because `core:cfg`'s signatures still require a value where
// this collection would leave the slot unwritten.
(Config c, bool created, bool ok, i32 bad_lines) load_with(cstring path, DefaultsFn defaults):
    if !cfg.exists(path):
        Config seeded = cfg.fresh(#default)
        if defaults != nil:
            defaults(&seeded)
        _ = cfg.save(seeded, path, #default)
        return (seeded, true, true, 0)
    (Config loaded, bool ok, i32 bad) = cfg.load(path, #default)
    return (loaded, false, ok, bad)

// Write `c` back to `path` — after a program has changed a value at
// runtime, for instance. Uses `app.allocator()`; see `core:cfg.save` for an
// allocator-explicit form.
bool save(Config c, cstring path):
    return cfg.save(c, path, app.allocator())

// End `c`: every value, every section's map, and the map. See the package
// doc comment on who calls this; `c` is the zero `Config` afterwards.
void destroy(^Config c):
    cfg.destroy(c)

// ── typed reads/writes, forwarded onto core:cfg with app.allocator() fixed ─

string8 get_string(Config c, string8 section, string8 key, string8 fallback):
    return cfg.get_string(c, section, key, fallback)

i32 get_i32(Config c, string8 section, string8 key, i32 fallback):
    return cfg.get_i32(c, section, key, fallback, app.allocator())

f64 get_f64(Config c, string8 section, string8 key, f64 fallback):
    return cfg.get_f64(c, section, key, fallback, app.allocator())

bool get_bool(Config c, string8 section, string8 key, bool fallback):
    return cfg.get_bool(c, section, key, fallback)

// The four setters take the map **by pointer**, following `core:cfg`'s, and
// for the reason stated there: a map arrives by value, so an insert through a
// copy of the handle can reallocate the table the caller is still holding.
void set_string(^Config c, string8 section, string8 key, string8 val):
    cfg.set_string(c, section, key, val, app.allocator())

void set_i32(^Config c, string8 section, string8 key, i32 val):
    cfg.set_i32(c, section, key, val, app.allocator())

void set_f64(^Config c, string8 section, string8 key, f64 val):
    cfg.set_f64(c, section, key, val, app.allocator())

void set_bool(^Config c, string8 section, string8 key, bool val):
    cfg.set_bool(c, section, key, val, app.allocator())
