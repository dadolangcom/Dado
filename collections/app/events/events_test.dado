@test
// app:events, retired onto channels — the migration note's pattern, running.
//
// Everything the old ring promised, asserted on the channels that replace it:
//
//   * **typed kinds**: two event kinds are two channels, and neither can be
//     read as the other.
//   * **FULL, seen by the sender**: an emit past capacity fails at its own
//     `else`, the newest is the one refused, and the drain gets the oldest in
//     order — the old ring's overflow, reported where it happens instead of
//     counted where nobody looks.
//   * **the real scenario, across threads**: a `core:jobs` pool's workers emit
//     from inside jobs, frame after frame, and one thread — this one, for the
//     whole test — drains between frames. A value is copied into the slot, so
//     no package array has to outlive the job; a `ref` payload moves from the
//     worker that allocated it to the thread that frees it.
//
// Run it under `--sanitize=thread` as well as the default.
package appevents

import "core:jobs"
import "core:threads"

const i32 FRAMES = 20
const i32 PER_FRAME = 48
const i32 LOADS = 8

#channel(64) ev_hit(i32 target, i32 damage)
#channel(16) ev_note(i32 id)
#channel(8) ev_loaded(i32 id, ref []i32 values)

private jobs.Scheduler g_sched

// What the senders saw as FULL; nothing in the threaded part should see any,
// because each channel is sized for one frame's worth.
private i32 g_full = 0

// Each target's damage is its own index plus one, so a total over a frame is
// known in advance and a lost, doubled or misread message moves it.
void collide_job(^jobs.JobArgs a):
    for i in a.begin..<a.end:
        try #send(ev_hit, i, i + 1) else:
            _ = #atomic_fetch_add(&g_full, 1, #RELAXED)

// A payload that is not copied: a `ref` the worker allocates and the drain
// frees. Its values say which job made it.
void load_job(^jobs.JobArgs a):
    for i in a.begin..<a.end:
        ref []i32 values = #make([]i32, 3)
        values[0] = i
        values[1] = i * 10
        values[2] = i * 100
        try #send(ev_loaded, i, values) else:
            #delete(values)
            _ = #atomic_fetch_add(&g_full, 1, #RELAXED)

private bool typed_and_full():
    bool ok = true

    // Two kinds, two channels: a hit is not a note.
    try #send(ev_note, 7) else:
        ok = #expect(false, "an empty ev_note refused an emit") && ok
    ok = #expect(#len(ev_hit) == 0 && #len(ev_note) == 1, "a note lands in ev_note only") && ok
    for id in #drain(ev_note):
        ok = #expect(id == 7, "note id = ", id) && ok

    // FULL is the sender's to see: 64 fit, the next 5 are refused at the emit.
    i32 refused = 0
    for i in 0..<(64 + 5):
        try #send(ev_hit, 200 + i, 1) else:
            refused += 1
    ok = #expect(refused == 5, "the sender saw FULL ", refused, " times, want 5") && ok
    ok = #expect(#len(ev_hit) == 64, "the channel holds its capacity, got ", #len(ev_hit)) && ok
    i32 next = 200
    bool in_order = true
    for target, damage in #drain(ev_hit):
        if target != next || damage != 1:
            in_order = false
        next += 1
    ok = #expect(in_order && next == 264, "the oldest 64 drained in order, up to ", next) && ok
    ok = #expect(#len(ev_hit) == 0, "and the channel is empty") && ok

    // A partial drain leaves the rest for the next walk.
    for i in 0..<5:
        try #send(ev_hit, i, 0) else:
            ok = #expect(false, "an emptied channel refused a send") && ok
    i32 took = 0
    for target, damage in #drain(ev_hit, 2):
        took += 1
    ok = #expect(took == 2 && #len(ev_hit) == 3, "#drain(ch, 2) took 2, left ", #len(ev_hit)) && ok
    i32 first_left = -1
    for target, damage in #drain(ev_hit):
        if first_left < 0:
            first_left = target
    ok = #expect(first_left == 2, "the rest came next, from target ", first_left) && ok
    return ok

// Frames on a real pool: workers emit, this thread drains between frames —
// always this thread, so the channel has one consumer for its life.
private bool frames_across_threads():
    bool ok = true
    i32 nt = threads.hardware_concurrency() - 1
    if nt < 1:
        nt = 1
    ok = #expect(jobs.start(&g_sched, nt), "pool start (", nt, " workers)") && ok

    i32 want = 0
    for i in 0..<PER_FRAME:
        want += i + 1

    i32 bad_frames = 0
    for f in 0..<FRAMES:
        jobs.parallel_for(&g_sched, PER_FRAME, 5, collide_job, nil)
        i32 total = 0
        i32 count = 0
        for target, damage in #drain(ev_hit):
            if damage != target + 1:
                bad_frames += 1
            total += damage
            count += 1
        if total != want || count != PER_FRAME:
            bad_frames += 1
    ok = #expect(bad_frames == 0, bad_frames, " frames lost, doubled or misread a hit") && ok

    // `ref` payloads: allocated on a worker, owned by the drain, freed here.
    jobs.parallel_for(&g_sched, LOADS, 1, load_job, nil)
    i32 loaded = 0
    i32 wrong = 0
    for id, values in #drain(ev_loaded):
        if values[0] != id || values[1] != id * 10 || values[2] != id * 100:
            wrong += 1
        loaded += 1
        #delete(values)
    ok = #expect(loaded == LOADS && wrong == 0, "loaded ", loaded, ", wrong ", wrong) && ok

    ok = #expect(#atomic_load(&g_full, #RELAXED) == 0, "a sender saw FULL on a frame-sized channel") && ok
    jobs.stop(&g_sched)
    return ok

i32 test():
    bool ok = typed_and_full()
    ok = frames_across_threads() && ok
    if ok:
        return 0
    return 1
