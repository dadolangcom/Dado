// Suites, statements, expressions and types.
package fmt

import "language:syntax"

private const u8 POSTFIX = 255
private const u8 PREFIX = 254

private bool sink_name(^F u, u32 e):
    if e == NONE || u.tag(e) != syntax.E_NAME: return false
    string8 s = u.text(u.a.main[e])
    return s == "out" || s == "err"

// -- suites --------------------------------------------------------------

void suite_as(^F u, i64 policy, u32 he, u32 b):
    []u32 st = u.kids(b)
    bool one = policy == i64(FOLD) || policy == i64(FIT)
    if policy == i64(AS_WRITTEN): one = #len(st) > 0 && u.same_line(he, u.a.lo[st[0]])
    if one && #len(st) == 1 && !governs(u, st[0]) && !u.pending_comment_before(u.a.lo[st[0]]):
        Mark m = u.mark()
        u.colon()
        _ = u.take_before(u.a.lo[st[0]])
        stmt(u, st[0])
        u.close(u.a.hi[st[0]])
        if policy == i64(FOLD) || policy == i64(AS_WRITTEN) || u.within_budget(m.out): return
        u.restore(m)
    suite_below(u, he, b)

private void suite(^F u, u32 he, u32 b):
    suite_as(u, u.k(F_SUITE), he, b)

private void suite_below(^F u, u32 he, u32 b):
    u.put(":\n")
    u.close(he)
    block(u, b)

private bool governs(^F u, u32 s):
    switch u.tag(s):
        case syntax.S_FOR, syntax.S_IF, syntax.S_SWITCH, syntax.S_WHEN, syntax.S_SUITE: return true
        case syntax.S_DEFER, syntax.S_AWAIT: return governs(u, u.a.a[s])
        case syntax.S_TRY:
            u32 e = u.a.b[s]
            return (e != NONE && u.a.b[e] == 0) || governs(u, u.a.a[s])
        case syntax.S_RETURN, syntax.S_EXPR: return ends_in_block(u, u.a.a[s])
        case syntax.S_LET, syntax.S_ASSIGN: return ends_in_block(u, u.kids(s)[1])
        else: return false
    return false

private bool ends_in_block(^F u, u32 e):
    return e != NONE && u.tag(e) == syntax.E_LAMBDA && inline_body(u, e) == NONE

private u32 inline_body(^F u, u32 l):
    []u32 st = u.kids(u.kids(l)[1])
    if #len(st) == 1 && !governs(u, st[0]): return st[0]
    return NONE

private u32 tail_lambda(^F u, u32 s):
    u32 v = NONE
    switch u.tag(s):
        case syntax.S_RETURN, syntax.S_EXPR: v = u.a.a[s]
        case syntax.S_LET, syntax.S_ASSIGN: v = u.kids(s)[1]
        case syntax.S_DEFER, syntax.S_AWAIT, syntax.S_TRY: return tail_lambda(u, u.a.a[s])
        else: return NONE
    if v != NONE && u.tag(v) == syntax.E_LAMBDA: return v
    return NONE

private bool open_try(^F u, u32 s):
    u8 g = u.tag(s)
    if g == syntax.S_TRY: return u.a.b[s] == NONE
    if g == syntax.S_DEFER || g == syntax.S_AWAIT: return open_try(u, u.a.a[s])
    return false

private bool ends_open_try(^F u, u32 b):
    []u32 st = u.kids(b)
    return #len(st) > 0 && open_try(u, st[#len(st) - 1])

private bool suite_below_written(^F u, i64 opened, i64 indent):
    i64 i = opened
    for i < #len(u.out) && u.out[i] != '\n': i += 1
    for i < #len(u.out):
        i += 1
        i64 w = 0
        for i + w < #len(u.out) && u.out[i + w] == ' ': w += 1
        if w > indent: return true
        for i < #len(u.out) && u.out[i] != '\n': i += 1
    return false

void block(^F u, u32 b):
    u.depth += 1
    []u32 st = u.kids(b)
    for i in 0..<#len(st):
        u32 s = st[i]
        i64 above = #len(u.out)
        u.open(u.a.lo[s])
        if !governs(u, s):
            within(u, u.k(F_STATEMENT), s, u.a.hi[s], W_STMT)
            u.close(u.a.hi[s])
            continue
        i64 opened = #len(u.out)
        stmt(u, s)
        if !suite_below_written(u, opened, u.depth * 4): continue
        if i > 0: u.separate_at(above, u.k(B_BEFORE_BLOCK))
        if i + 1 < #len(st): u.blanks(u.k(B_AFTER_BLOCK))
    if #len(st) == 0:
        u.indent()
        u.put("return\n")
    u.depth -= 1

// -- statements ----------------------------------------------------------

void stmt(^F u, u32 s):
    u32 outer = u.lambda_tail
    u.lambda_tail = tail_lambda(u, s)
    stmt_written(u, s)
    u.lambda_tail = outer

private void stmt_written(^F u, u32 s):
    switch u.tag(s):
        case syntax.S_RETURN:
            u.put("return")
            if u.a.a[s] != NONE:
                u.ch(' ')
                expr(u, u.a.a[s])
            u.end_line()
        case syntax.S_VIEW:
            u.put("view ")
            u.tok(u.a.main[s])
            u.colon()
            []u32 k = u.kids(s)
            u.opens('(', #len(k) == 0)
            for i in 0..<#len(k):
                if i > 0: u.comma()
                u.tok(u.a.main[k[i]])
            u.closes(')', #len(k) == 0)
            u.ch('\n')
        case syntax.S_FOR:
            u.put("for")
            u32 h = u.a.a[s]
            u32 he = u.a.lo[s]
            if h != NONE && u.tag(h) == syntax.S_FOR_IN:
                u.ch(' ')
                []u32 k = u.kids(h)
                for i in 0..<#len(k) - 1:
                    if i > 0: u.comma()
                    if u.a.a[k[i]] == 1: u.ch('&')
                    u.tok(u.a.main[k[i]])
                u.put(" in ")
                expr(u, k[#len(k) - 1])
                he = u.a.hi[k[#len(k) - 1]]
            else if h != NONE:
                u.ch(' ')
                expr(u, h)
                he = u.a.hi[h]
            suite(u, he, u.a.b[s])
        case syntax.S_SUITE:
            u.tok_sp(u.a.main[s])
            u32 h = u.a.a[s]
            using_head(u, h, true)
            []u32 hk = u.kids(h)
            if #len(hk) == 1 && sink_name(u, hk[0]): suite_below(u, u.a.hi[h], u.a.b[s])
            else: suite(u, u.a.hi[h], u.a.b[s])
        case syntax.S_IF: if_stmt(u, s)
        case syntax.S_SWITCH: switch_stmt(u, s)
        case syntax.S_DEFER:
            u.put("defer! " if u.a.main[s] != NONE else "defer ")
            if u.a.b[s] != NONE: u.put("fail ")
            stmt(u, u.a.a[s])
        case syntax.S_BREAK: u.put("break\n")
        case syntax.S_CONTINUE: u.put("continue\n")
        case syntax.S_PASS: u.put("pass\n")
        case syntax.S_FALLTHROUGH: u.put("fallthrough\n")
        case syntax.S_QUIT, syntax.S_FAIL:
            u.put("quit " if u.tag(s) == syntax.S_QUIT else "fail ")
            expr(u, u.a.a[s])
            u.ch('\n')
        case syntax.S_TRY:
            u.put("try ")
            stmt(u, u.a.a[s])
            u32 e = u.a.b[s]
            if e == NONE: return
            if u.ends("\n"): u.pop()
            u.put(" else")
            if u.a.b[e] == 1:
                u.ch(' ')
                expr(u, u.a.a[e])
                u.ch('\n')
                return
            u32 he = u.a.hi[u.a.a[s]]
            if u.a.main[e] != NONE:
                u.sp_tok(u.a.main[e])
                he = u.tend(u.a.main[e])
            suite(u, he, u.a.a[e])
        case syntax.S_LET:
            []u32 k = u.kids(s)
            c_body_attr(u, k[2])
            type_expr(u, k[0])
            if u.a.main[s] != NONE:
                u.sp_tok(u.a.main[s])
            if k[1] != NONE:
                u.decl_eq()
                expr(u, k[1])
            u.end_line()
        case syntax.S_WHEN:
            []u32 k = u.kids(s)
            u32 last = NONE
            for arm in k:
                if arm == NONE: continue
                if u.tag(arm) == syntax.S_WHEN_ARM:
                    if last != NONE:
                        u32 head = u.code_at(u.a.hi[u.a.b[last]])
                        u.leading_tight(head)
                        u.indent()
                        u.put("else ")
                    u.put("when ")
                    expr(u, u.a.a[arm])
                    suite_below(u, u.a.hi[u.a.a[arm]], u.a.b[arm])
                    last = arm
                else:
                    u32 head = u.code_at(u.a.hi[u.a.b[last]] if last != NONE else u.a.lo[arm])
                    u.leading_tight(head)
                    u.indent()
                    u.put("else")
                    suite_below(u, head, arm)
            u.blanks(u.k(B_WHEN))
        case syntax.N_CONST: const_decl(u, s)
        case syntax.S_ASSIGN:
            []u32 k = u.kids(s)
            expr(u, k[0])
            u.spaces(u.k(S_ASSIGN))
            u.tok(u.a.main[s])
            u.spaces(u.k(S_ASSIGN))
            if u.a.a[s] != NONE:
                u.tok_sp(u.a.a[s])
            expr(u, k[1])
            u.end_line()
        case syntax.S_EXPR:
            expr(u, u.a.a[s])
            u.end_line()
        case syntax.S_AWAIT:
            u.put("await ")
            stmt(u, u.a.a[s])
        case syntax.S_ASSERT:
            u.put("assert ")
            expr(u, u.a.a[s])
            if u.a.b[s] != NONE:
                u.comma()
                expr(u, u.a.b[s])
            u.ch('\n')
        else: return

private void if_stmt(^F u, u32 s):
    []u32 k = u.kids(s)
    u.put("if ")
    expr(u, k[0])
    if k[2] != NONE && ends_open_try(u, k[1]): suite_below(u, u.a.hi[k[0]], k[1])
    else: suite(u, u.a.hi[k[0]], k[1])
    if k[2] == NONE: return
    u32 head = u.code_at(u.a.hi[k[1]])
    u.leading_tight(head)
    u.indent()
    if u.tag(k[2]) == syntax.S_IF:
        u.put("else ")
        if_stmt(u, k[2])
    else:
        u.put("else")
        suite(u, head, k[2])

private void switch_stmt(^F u, u32 s):
    []u32 k = u.kids(s)
    u.put("switch ")
    expr(u, k[0])
    u.put(":\n")
    u.close(u.a.hi[k[0]])
    u.depth += 1
    for j in 2..<#len(k):
        u32 arm = k[j]
        []u32 ak = u.kids(arm)
        u.open(u.a.lo[arm])
        u.put("case ")
        for i in 1..<#len(ak):
            if i > 1: u.comma()
            expr(u, ak[i])
        u32 head = u.a.lo[arm]
        if #len(ak) > 1: head = u.a.hi[ak[#len(ak) - 1]]
        if u.a.main[arm] != NONE:
            u.sp_tok(u.a.main[arm])
            head = u.tend(u.a.main[arm])
        if j + 1 == #len(k) && k[1] != NONE && ends_open_try(u, ak[0]): suite_below(u, head, ak[0])
        else: suite(u, head, ak[0])
    if k[1] != NONE:
        u32 from = u.a.hi[k[0]]
        if #len(k) > 2: from = u.a.hi[u.kids(k[#len(k) - 1])[0]]
        u32 head = u.code_at(from)
        u.leading_tight(head)
        u.indent()
        u.put("else")
        suite(u, head, k[1])
    if #len(k) == 2 && k[1] == NONE:
        u.indent()
        u.put("else:\n")
        u.depth += 1
        u.indent()
        u.put("break\n")
        u.depth -= 1
    u.depth -= 1

// -- expressions ---------------------------------------------------------

private u8 level(^F u, u32 e):
    switch u.tag(e):
        case syntax.E_BINARY: return syntax.binary_power(u.t.tag[u.a.main[e]])
        case syntax.E_RANGE: return 10
        case syntax.E_IN, syntax.E_IS, syntax.E_HAS: return 40
        case syntax.E_COND: return 5
        case syntax.E_LAMBDA: return 0
        case syntax.E_SPLAT, syntax.E_UNARY: return PREFIX
        case syntax.E_CALL: return PREFIX if u.kids(e)[1] != NONE else POSTFIX
        else: return POSTFIX
    return POSTFIX

private void grouped(^F u, u32 e):
    u.opens('(', false)
    expr(u, e)
    u.closes(')', false)

private void at_bp(^F u, u32 e, u8 min):
    u8 l = level(u, e)
    if l < PREFIX && l < min: grouped(u, e)
    else: expr(u, e)

private void at_comparison(^F u, u32 e, u8 min):
    if u.tag(e) == syntax.E_BINARY:
        u8 op = u.t.tag[u.a.main[e]]
        if op == syntax.PIPE || op == syntax.TILDE || op == syntax.AMP || op == syntax.AMP_TILDE:
            grouped(u, e)
            return
    at_bp(u, e, min)

private void at_prefix(^F u, u32 e):
    if level(u, e) < PREFIX: grouped(u, e)
    else: expr(u, e)

private void at_postfix(^F u, u32 e):
    if level(u, e) != POSTFIX: grouped(u, e)
    else: expr(u, e)

void expr(^F u, u32 e):
    []u32 k = u.a.extra[0..<0]
    if syntax.SHAPES[u.tag(e)] == syntax.S_L: k = u.kids(e)
    switch u.tag(e):
        case syntax.E_LAMBDA: lambda(u, e)
        case syntax.E_INT, syntax.E_FLOAT, syntax.E_STR, syntax.E_CHAR, syntax.E_NAME: u.tok(u.a.main[e])
        case syntax.E_TUPLE:
            u.opens('(', #len(k) == 0)
            for i in 0..<#len(k):
                if i > 0: u.comma()
                expr(u, k[i])
            if #len(k) == 1: u.ch(',')
            u.closes(')', #len(k) == 0)
        case syntax.E_IN, syntax.E_IS:
            at_bp(u, u.a.a[e], 40)
            u.infix("in" if u.tag(e) == syntax.E_IN else "is")
            at_bp(u, u.a.b[e], 41)
        case syntax.E_HAS:
            at_bp(u, k[0], 40)
            u.infix("has")
            if u.a.a[e] == 1: at_bp(u, k[1], 41)
            else:
                for i in 1..<#len(k):
                    if i > 1: u.comma()
                    u32 w = k[i]
                    u.span(u.t.start[u.a.main[w]], u.t.end[u.a.a[w]])
        case syntax.E_MAP:
            u.opens('{', #len(k) == 0)
            for i in 0..<#len(k):
                if i > 0: u.comma()
                u32 x = k[i]
                expr(u, u.a.a[x])
                u.colon()
                u32 v = u.a.b[x]
                if u.tag(v) == syntax.E_CALL && u.kids(v)[1] != NONE && i + 1 < #len(k) && sink_name(u, u.a.a[k[i + 1]]): grouped(u, v)
                else: expr(u, v)
            u.closes('}', #len(k) == 0)
        case syntax.E_ARRAY:
            u.opens('[', #len(k) == 0)
            for i in 0..<#len(k):
                if i > 0: u.comma()
                expr(u, k[i])
            u.closes(']', #len(k) == 0)
        case syntax.E_CALL:
            if u.tag(k[0]) == syntax.E_TYPE: type_in(u, u.a.a[k[0]], true)
            else: at_postfix(u, k[0])
            bool empty = #len(k) == 2
            u.opens('(', empty)
            for i in 2..<#len(k):
                if i > 2: u.comma()
                u32 g = k[i]
                bool named_after = i + 1 < #len(k) && u.a.main[k[i + 1]] != NONE && sink_word(u, u.a.main[k[i + 1]])
                u32 v = u.a.a[g]
                if u.a.main[g] != NONE:
                    u.tok(u.a.main[g])
                    u.colon()
                if named_after && u.tag(v) == syntax.E_CALL && u.kids(v)[1] != NONE: grouped(u, v)
                else: expr(u, v)
            u.closes(')', empty)
            if k[1] != NONE:
                u.put(" using ")
                using_head(u, k[1], false)
        case syntax.E_FIELD:
            at_postfix(u, u.a.a[e])
            u.ch('.')
            u.tok(u.a.main[e])
        case syntax.E_INDEX:
            at_postfix(u, u.a.a[e])
            u.opens('[', false)
            if u.a.main[e] != NONE:
                u.tok_sp(u.a.main[e])
            u32 x = u.a.b[e]
            if u.tag(x) == syntax.E_COND: expr(u, x)
            else: at_bp(u, x, 11)
            u.closes(']', false)
        case syntax.E_SLICE:
            at_postfix(u, k[0])
            u.opens('[', false)
            if k[1] == NONE && k[2] == NONE: u.ch(':')
            else:
                if k[1] != NONE: at_bp(u, k[1], 11)
                u.tok(u.a.main[e])
                if k[2] != NONE: expr(u, k[2])
            u.closes(']', false)
        case syntax.E_DEREF:
            at_postfix(u, u.a.a[e])
            u.ch('^')
        case syntax.E_UNARY:
            u.tok(u.a.main[e])
            u32 o = u.a.a[e]
            if u.tag(o) == syntax.E_UNARY: grouped(u, o)
            else: at_prefix(u, o)
        case syntax.E_BINARY:
            u8 p = syntax.binary_power(u.t.tag[u.a.main[e]])
            if p == 40:
                at_comparison(u, u.a.a[e], p)
                u.infix_tok(u.a.main[e])
                at_comparison(u, u.a.b[e], p + 1)
            else:
                at_bp(u, u.a.a[e], p)
                u.infix_tok(u.a.main[e])
                at_bp(u, u.a.b[e], p + 1)
        case syntax.E_SPLAT:
            u.put("..")
            at_prefix(u, u.a.a[e])
        case syntax.E_NARROW:
            at_postfix(u, u.a.a[e])
            u.ch('.')
            u.opens('(', false)
            type_expr(u, u.a.b[e])
            u.closes(')', false)
        case syntax.E_COND:
            at_bp(u, k[0], 6)
            u.infix_word("if")
            at_bp(u, k[1], 6)
            u.infix_word("else")
            at_bp(u, k[2], 5)
        case syntax.E_TYPE: type_expr(u, u.a.a[e])
        case syntax.E_RANGE:
            at_bp(u, u.a.a[e], 10)
            u.tok(u.a.main[e])
            at_bp(u, u.a.b[e], 11)
        else: return

private bool sink_word(^F u, u32 t):
    string8 s = u.text(t)
    return s == "out" || s == "err"

private void using_head(^F u, u32 h, bool suite):
    []u32 k = u.kids(h)
    bool first = true
    if k[0] != NONE:
        if !suite && sink_name(u, k[0]): grouped(u, k[0])
        else if suite: expr(u, k[0])
        else: at_prefix(u, k[0])
        first = false
    for i in 1..<#len(k):
        if !first: u.comma()
        first = false
        u32 s = k[i]
        if u.a.main[s] != NONE:
            u.tok(u.a.main[s])
            u.colon()
        if suite: expr(u, u.a.a[s])
        else: at_prefix(u, u.a.a[s])

private void lambda(^F u, u32 l):
    []u32 k = u.kids(l)
    if u.a.a[l] != NONE: u.put("async ")
    type_in(u, k[0], true)
    bool empty = #len(k) == 2
    u.opens('(', empty)
    for i in 2..<#len(k):
        if i > 2: u.comma()
        param(u, k[i], true)
    u.closes(')', empty)
    u32 only = inline_body(u, l)
    if only != NONE:
        u.colon()
        stmt(u, only)
        if u.ends("\n"): u.pop()
        return
    u32 head = u.a.hi[k[0]]
    if #len(k) > 2: head = u.a.hi[k[#len(k) - 1]]
    suite_below(u, head, k[1])
    if u.lambda_tail != l: u.indent()

// -- types ---------------------------------------------------------------

void type_expr(^F u, u32 t):
    type_in(u, t, false)

private void type_in(^F u, u32 t, bool closed):
    u8 g = u.tag(t)
    switch g:
        case syntax.T_NAME, syntax.T_PACK: u.tok(u.a.main[t])
        case syntax.T_REF:
            u.put("ref")
            u32 h = u.a.a[t]
            bool tuple = u.tag(h) == syntax.T_TUPLE && u.a.a[h] != 1
            if closed || tuple:
                u.opens('(', false)
                type_in(u, h, false)
                u.closes(')', false)
            else:
                u.ch(' ')
                type_in(u, h, false)
        case syntax.T_BOUND:
            u.tok(u.a.main[t])
            u.put(" $")
            u.tok(u.a.a[t])
        case syntax.T_KIND: u.put("type")
        case syntax.T_LAYOUT, syntax.T_QUAL:
            u.tok_sp(u.a.main[t])
            type_in(u, u.a.a[t], closed)
        case syntax.T_BINDING:
            u.ch('$')
            u.tok(u.a.main[t])
        case syntax.T_PATH:
            u.tok(u.a.a[t])
            u.ch('.')
            u.tok(u.a.main[t])
            if u.a.b[t] != NONE:
                u.ch('.')
                u.tok(u.a.b[t])
        case syntax.T_POINTER:
            u.ch('^')
            type_in(u, u.a.a[t], closed)
        case syntax.T_SLICE:
            u.put("[]")
            type_in(u, u.a.a[t], closed)
        case syntax.T_ARRAY:
            u.opens('[', false)
            if u.a.main[t] != NONE: u.ch('$')
            expr(u, u.a.a[t])
            u.closes(']', false)
            type_in(u, u.a.b[t], closed)
        case syntax.T_MATRIX:
            []u32 k = u.kids(t)
            u.opens('[', false)
            if u.a.a[t] != NONE: u.ch('$')
            expr(u, k[0])
            u.ch(',')
            if u.a.main[t] != NONE: u.ch('$')
            expr(u, k[1])
            u.closes(']', false)
            type_in(u, k[2], closed)
        case syntax.T_SHAPEOF:
            u.put("typeof" if u.a.b[t] == 1 else "shapeof")
            u.opens('(', false)
            expr(u, u.a.a[t])
            u.closes(')', false)
        case syntax.T_MAP:
            u.opens('{', false)
            type_expr(u, u.a.a[t])
            u.colon()
            type_expr(u, u.a.b[t])
            u.closes('}', false)
        case syntax.T_TUPLE:
            []u32 k = u.kids(t)
            bool cu = u.a.a[t] == 1
            if cu: u.put("cunion ")
            u.opens('(', #len(k) == 0)
            for i in 0..<#len(k):
                if i > 0: u.comma()
                member(u, k[i], false)
            if !cu && #len(k) == 1 && u.a.main[k[0]] == NONE: u.ch(',')
            u.closes(')', #len(k) == 0)
        case syntax.T_CHANNEL:
            channel_capacity(u, t)
            channel_params(u, t)
        case syntax.T_FN:
            []u32 k = u.kids(t)
            u32 f = u.a.a[t]
            if (f & syntax.F_ASYNC) != 0: u.put("async ")
            if (f & syntax.F_FAILABLE) != 0:
                if k[1] != NONE: type_expr(u, k[1])
                u.ch('!')
            u8 r = u.tag(k[0])
            if r == syntax.T_POINTER || r == syntax.T_SLICE || r == syntax.T_ARRAY || r == syntax.T_MATRIX || r == syntax.T_LAYOUT || r == syntax.T_QUAL:
                u.ch('(')
                type_in(u, k[0], false)
                u.ch(')')
            else: type_in(u, k[0], true)
            bool empty = #len(k) == 2
            u.opens('(', empty)
            for i in 2..<#len(k):
                if i > 2: u.comma()
                type_expr(u, k[i])
            u.closes(')', empty)
        else: return

void channel_named(^F u, u32 t, u32 name):
    channel_capacity(u, t)
    u.sp_tok(name)
    channel_params(u, t)

private void channel_capacity(^F u, u32 t):
    u.tok(u32(syntax.token_at(u.t, u.a.lo[t])))
    u.ch('(')
    if u.a.a[t] != NONE: u.put("latest")
    else: expr(u, u.kids(t)[0])
    u.ch(')')

private void channel_params(^F u, u32 t):
    []u32 k = u.kids(t)
    bool empty = #len(k) == 1
    u.opens('(', empty)
    for i in 1..<#len(k):
        if i > 1: u.comma()
        param(u, k[i], false)
    u.closes(')', empty)
