// Files, items, declarations and member lists.
package fmt

import "language:syntax"

// What a measured line renders (`within`), and a member list's members.
const u8 W_STMT = 0
const u8 W_CONST = 1
const u8 W_VAR = 2
const u8 W_SASSERT = 3
const u8 W_ARAISES = 4
const u8 W_FFN = 5
const u8 W_HEADER = 6
const u8 L_LIST = 0
const u8 L_UNION = 1
const u8 L_ENUM = 2
const u8 L_FENUM = 3
const u8 L_TYPE = 4

private bool is_type(u8 g):
    return g >= syntax.T_NAME && g <= syntax.T_CHANNEL

private i64 newlines(^F u, i64 from):
    i64 n = 0
    for i in from..<#len(u.out):
        if u.out[i] == '\n': n += 1
    return n

// Formats `src` (parsed as `t` and `a`) under `s` into `out`.
void format(string8 src, ^syntax.Tokens t, ^syntax.Ast a, ^const Style s, ^ref []char8 out):
    F u
    u.src = src
    u.t = t
    u.a = a
    u.s = s^
    u.lambda_tail = NONE
    u.out = #reserve(u.out, #len(src) + #len(src) / 8 + 64)
    file(&u)
    string8 o = u.out
    align(o, u.stops, u.k(BUDGET), u.origins, out)
    #delete(u.out)
    #delete(u.stops)
    #delete(u.junctions)
    #delete(u.origins)

private void file(^F u):
    u32 r = u.a.root
    u.dado_file = u.a.a[r] == 0
    []u32 k = u.kids(r)
    if k[0] != NONE:
        u32 n = k[0]
        u.open(u.a.lo[n])
        u.put("@test")
        if u.a.a[n] != NONE:
            u.ch(' ')
            u.num(u.a.a[n])
        u.ch('\n')
        u.close(u.a.hi[n])
    if k[1] != NONE:
        u.open(u.a.lo[k[1]])
        u.put("package ")
        u.tok(u.a.main[k[1]])
        u.ch('\n')
        u.close(u.a.hi[k[1]])
    if k[2] != NONE:
        u32 n = k[2]
        u.open(u.a.lo[n])
        if (u.a.a[n] & syntax.F_VIS) == syntax.VIS_EXPORT: u.put("export ")
        u32 end = class_head(u, n)
        u.ch('\n')
        u.close(end)
    i64 i = 3
    for i < #len(k) && u.tag(k[i]) == syntax.N_IMPORT:
        u32 n = k[i]
        if i == 3: u.blanks(u.k(B_PACKAGE))
        u.open(u.a.lo[n])
        u.put("import ")
        if u.a.a[n] != NONE:
            u.tok_sp(u.a.a[n])
        else if u.a.b[n] != NONE: u.put(". ")
        u.tok(u.a.main[n])
        u.ch('\n')
        u.close(u.a.hi[n])
        i += 1
    i64 first = u.k(B_ITEM)
    if i > 3: first = u.k(B_IMPORTS)
    else if k[1] != NONE || k[2] != NONE: first = u.k(B_PACKAGE)
    items(u, r, i, first)
    i64 from = u.take_before(NONE)
    i64 to = u.next
    for to > from && !u.is_comment(to - 1): to -= 1
    u.place(from, to, true)
    for u.ends("\n\n"): u.pop()
    u.mend()

private u8 declares(^F u, u32 n):
    u8 g = u.tag(n)
    if g == syntax.N_F_OPAQUE: return syntax.N_TYPE
    return g

// Items, each above its blank lines (`Unparser::items`); `fgn`: a `foreign`
// block's members.
private void items(^F u, u32 owner, i64 from, i64 first, bool fgn = false):
    []u32 k = u.kids(owner)
    i64 prev = -1
    bool prev_one = false
    bool promised = false
    for i in from..<#len(k):
        u32 n = k[i]
        if n == NONE || u.tag(n) == syntax.N_CLAUSE: continue
        i64 sep = u.k(B_FOREIGN if fgn else B_ITEM)
        if prev < 0: sep = first
        else if promised: sep = 0
        else if prev_one && prev == i64(declares(u, n)): sep = u.k(B_ONE_LINE)
        u.blanks(sep)
        u.open(u.a.lo[n])
        i64 opened = #len(u.out)
        if fgn: foreign_item(u, n)
        else: item(u, n)
        bool one = newlines(u, opened) <= 1
        if one: u.close(u.a.hi[n])
        prev = i64(declares(u, n))
        prev_one = one
        promised = u.tag(n) == syntax.N_ASSERT_RAISES && u.a.a[n] == 1

private void visibility(^F u, u32 flags):
    switch flags & syntax.F_VIS:
        case syntax.VIS_PUBLIC: u.put("public ")
        case syntax.VIS_PACKAGE: u.put("private ")
        case syntax.VIS_FILE: u.put("private \"file\" ")
        case syntax.VIS_EXPORT: u.put("export ")
        else: return

private void item(^F u, u32 n):
    u8 g = u.tag(n)
    if g == syntax.N_FN || g == syntax.N_TYPE || g == syntax.N_TRAIT || g == syntax.N_VAR || g == syntax.N_CONST || g == syntax.N_ENUM || g == syntax.N_UNION || g == syntax.N_FOREIGN || g == syntax.N_CLASS:
        visibility(u, u.a.a[n])
    []u32 k = u.a.extra[0..<0]
    if syntax.SHAPES[g] == syntax.S_L: k = u.kids(n)
    switch g:
        case syntax.N_WHEN: item_when(u, n)
        case syntax.N_FN: fn_decl(u, n)
        case syntax.N_CLASS: class_decl(u, n)
        case syntax.N_TYPE: type_decl(u, n, u.k(F_MEMBERS))
        case syntax.N_TRAIT: trait_decl(u, n)
        case syntax.N_STATIC_ASSERT: within(u, u.k(F_STATEMENT), n, u.a.hi[n], W_SASSERT)
        case syntax.N_ASSERT_RAISES:
            if u.a.a[n] == 1: u.put("#assert_raises\n")
            else: within(u, u.k(F_STATEMENT), n, u.a.hi[n], W_ARAISES)
        case syntax.N_CONST: within(u, u.k(F_STATEMENT), n, u.a.hi[n], W_CONST)
        case syntax.N_VAR: within(u, u.k(F_STATEMENT), n, u.a.hi[n], W_VAR)
        case syntax.N_UNION: union_decl(u, n, u.k(F_MEMBERS))
        case syntax.N_FOREIGN:
            if (u.a.a[n] & syntax.F_FREE) != 0: u.put("@freestanding ")
            u.put("foreign ")
            if k[0] != NONE:
                u.tok_sp(u.a.main[k[0]])
            u.tok(u.a.main[n])
            bool clauses = false
            bool any = false
            for i in 1..<#len(k):
                if u.tag(k[i]) == syntax.N_CLAUSE:
                    clauses = true
                    u.sp_tok(u.a.main[k[i]])
                    u.sp_tok(u.a.a[k[i]])
                else: any = true
            if !any && clauses:
                u.ch('\n')
                return
            u.put(":\n")
            u.close(u.tend(u.a.main[n]))
            u.depth += 1
            items(u, n, 1, u.k(B_FOREIGN), true)
            if !any:
                u.indent()
                u.put("type _unparse_empty_foreign\n")
            u.depth -= 1
        case syntax.N_ENUM:
            if (u.a.a[n] & syntax.F_DISTINCT) != 0: u.put("distinct ")
            u.put("enum ")
            if k[0] != NONE:
                type_expr(u, k[0])
                u.ch(' ')
            u.tok(u.a.main[n])
            u.ch(':')
            u32 end = u.tend(u.a.main[n])
            if #len(k) > 1: end = u.a.hi[k[#len(k) - 1]]
            _ = member_list(u, u.k(F_ENUM), u.tend(u.a.main[n]), end, L_ENUM, n)
        else: return

private void item_when(^F u, u32 n):
    []u32 k = u.kids(n)
    u32 last = NONE
    for arm in k:
        if arm == NONE: continue
        if u.tag(arm) == syntax.N_WHEN_ARM:
            []u32 ak = u.kids(arm)
            if last != NONE:
                u32 head = u.code_at(u.a.hi[last])
                u.leading_tight(head)
                u.indent()
                u.put("else ")
            u.put("when ")
            expr(u, ak[0])
            u.put(":\n")
            u.close(u.a.hi[ak[0]])
            u.depth += 1
            items(u, arm, 1, u.k(B_ITEM))
            u.depth -= 1
            last = arm
        else:
            u32 head = u.code_at(u.a.hi[last] if last != NONE else u.a.lo[n])
            u.leading_tight(head)
            u.indent()
            u.put("else:\n")
            u.close(head)
            u.depth += 1
            items(u, arm, 0, u.k(B_ITEM))
            u.depth -= 1

// One logical line, kept flat when it fits, else the author's lines.
private void within(^F u, i64 policy, u32 n, u32 hi, u8 what):
    u32 lo = u.a.lo[n]
    Mark m = u.mark()
    flat(u, what, n)
    if policy == i64(FOLD) || (policy != i64(AS_WRITTEN) && u.within_budget(m.out)): return
    bool ended = u.ends("\n")
    u32 end = u.written_end(lo, hi)
    if end == NONE: return
    bool multi = false
    for i in i64(lo)..<i64(end):
        if u.src[i] == '\n':
            multi = true
            break
    if !multi: return
    u.restore(m)
    u.as_written(lo, end)
    if ended: u.ch('\n')

private void flat(^F u, u8 what, u32 n):
    switch what:
        case W_STMT: stmt(u, n)
        case W_CONST: const_decl(u, n)
        case W_HEADER: fn_header_flat(u, n)
        case W_FFN: foreign_fn(u, n)
        case W_SASSERT:
            u.put("#static_assert(")
            expr(u, u.a.a[n])
            u.put(", ")
            expr(u, u.a.b[n])
            u.put(")\n")
        case W_ARAISES:
            u.put("#assert_raises(")
            []u32 k = u.kids(n)
            for i in 0..<#len(k):
                if i > 0: u.put(", ")
                u.tok(u.a.main[k[i]])
            u.put(")\n")
        case W_VAR:
            []u32 k = u.kids(n)
            align_attr(u, k[2])
            c_body_attr(u, k[3])
            if k[4] != NONE: u.put("@thread_local ")
            if u.tag(k[0]) == syntax.T_CHANNEL: channel_named(u, k[0], u.a.main[n])
            else if (u.a.a[n] & syntax.F_EMBED) != 0: type_expr(u, k[0])
            else:
                type_expr(u, k[0])
                u.sp_tok(u.a.main[n])
            if k[1] != NONE:
                u.decl_eq()
                expr(u, k[1])
            u.end_line()
        else: return

void const_decl(^F u, u32 n):
    []u32 k = u.kids(n)
    if (u.a.a[n] & syntax.F_BUILD) != 0: u.ch('@')
    u.put("const ")
    if k[0] != NONE:
        type_expr(u, k[0])
        u.ch(' ')
    u.tok(u.a.main[n])
    u.decl_eq()
    expr(u, k[1])
    u.ch('\n')

private void c_name(^F u, u32 c):
    if c == NONE: return
    u.put(" @c(")
    u.tok(u.a.main[c])
    u.ch(')')

private void align_attr(^F u, u32 n):
    if n == NONE: return
    u.put("@align(")
    expr(u, u.a.a[n])
    u.put(") ")

void c_body_attr(^F u, u32 n):
    if n == NONE: return
    u.put("@c_body(")
    u.tok(u.a.main[n])
    u.put(") ")

// -- functions -----------------------------------------------------------

private void fn_decl(^F u, u32 n):
    u32 he = fn_header(u, n)
    suite_as(u, u.k(F_FN_BODY), he, u.kids(n)[5])

private u32 fn_header(^F u, u32 n):
    []u32 k = u.kids(n)
    u32 he = u.tend(u.a.main[n])
    if k[4] != NONE: he = u.a.hi[k[4]]
    else if #len(k) > 6: he = u.a.hi[k[#len(k) - 1]]
    else if k[3] != NONE: he = u.a.hi[k[3]]
    within(u, u.k(F_PARAMS), n, he, W_HEADER)
    return he

private void fn_header_flat(^F u, u32 n):
    []u32 k = u.kids(n)
    u32 f = u.a.a[n]
    if k[2] != NONE:
        u.put("@symbol(")
        []u32 w = u.kids(k[2])
        for i in 0..<#len(w):
            if i > 0: u.put(", ")
            u.tok(u.a.main[w[i]])
        u.put(") ")
    if (f & syntax.F_ASYNC) != 0: u.put("async ")
    if (f & syntax.F_FAILABLE) != 0:
        if k[1] != NONE: type_expr(u, k[1])
        u.ch('!')
    type_expr(u, k[0])
    u.sp_tok(u.a.main[n])
    bool empty = #len(k) == 6 && k[3] == NONE
    u.opens('(', empty)
    if k[3] != NONE:
        if u.a.a[k[3]] == 1: u.ch('^')
        u.put("self")
    for i in 6..<#len(k):
        if i > 6 || k[3] != NONE: u.comma()
        param(u, k[i], true)
    u.closes(')', empty)
    if k[4] != NONE:
        u.put(" where ")
        expr(u, k[4])

void param(^F u, u32 p, bool default):
    if u.tag(p) == syntax.N_PARAM_V: u.put("..")
    if u.a.a[p] != NONE:
        type_expr(u, u.a.a[p])
        u.ch(' ')
    u.tok(u.a.main[p])
    if default && u.a.b[p] != NONE:
        u.decl_eq()
        expr(u, u.a.b[p])

private void method(^F u, u32 f, bool required, bool promised):
    u.open(u.a.lo[f])
    if promised:
        u.put("#assert_raises\n")
        u.indent()
    visibility(u, u.a.a[f])
    i64 opened = #len(u.out)
    if required:
        u32 he = fn_header(u, f)
        u.ch('\n')
        u.close(he)
        return
    fn_decl(u, f)
    if newlines(u, opened) <= 1: u.close(u.a.hi[f])

// -- types, traits, classes ----------------------------------------------

private u32 binders(^F u, u32 n, i64 from, u32 he):
    []u32 all = u.kids(n)
    []u32 k = all[from..<#len(all)]
    u32 h = he
    bool any = false
    for b in k:
        if u.tag(b) != syntax.N_BINDER: continue
        if !any: u.opens('(', false)
        else: u.comma()
        any = true
        u.ch('$')
        u.tok(u.a.main[b])
        h = u.a.hi[b]
    if any: u.closes(')', false)
    return h

private u32 tail(^F u, string8 word, u32 n, i64 from, u32 he):
    []u32 all = u.kids(n)
    []u32 k = all[from..<#len(all)]
    u32 h = he
    bool any = false
    for t in k:
        if t == NONE || !is_type(u.tag(t)): continue
        if !any:
            u.ch(' ')
            u.put(word)
            u.ch(' ')
        else: u.comma()
        any = true
        type_expr(u, t)
        h = u.a.hi[t]
    return h

private void type_decl(^F u, u32 n, i64 policy):
    []u32 k = u.kids(n)
    u32 f = u.a.a[n]
    if (f & syntax.F_DISTINCT) != 0: u.put("distinct ")
    u.put("contract" if (f & syntax.F_CONTRACT) != 0 else "type")
    c_name(u, k[0])
    u.sp_tok(u.a.main[n])
    u32 he = binders(u, n, 3, u.tend(u.a.main[n]))
    he = tail(u, "using", n, 3, he)
    if k[1] != NONE:
        u.put(" where ")
        expr(u, u.a.a[k[1]])
        he = u.a.hi[u.a.a[k[1]]]
    u.ch(':')
    bool methods = false
    for i in 3..<#len(k):
        if u.tag(k[i]) == syntax.N_FN: methods = true
    u32 b = k[2]
    if !methods:
        if u.tag(b) == syntax.N_ALIAS:
            u.ch(' ')
            type_expr(u, u.a.a[b])
            u.ch('\n')
        else: _ = member_list(u, policy, he, u.a.hi[b], L_LIST, b)
        return
    bool interleaved = false
    if u.tag(b) == syntax.N_ALIAS:
        u.ch(' ')
        type_expr(u, u.a.a[b])
        u.ch('\n')
        u.close(u.a.hi[u.a.a[b]])
    else: interleaved = member_list(u, policy, he, u.a.hi[b], L_TYPE, n)
    if interleaved: return
    u.depth += 1
    for i in 3..<#len(k):
        if u.tag(k[i]) == syntax.N_FN: method(u, k[i], false, promised(u, n, k[i]))
    u.depth -= 1

private bool promised(^F u, u32 t, u32 f):
    []u32 k = u.kids(t)
    for p in k:
        if p == NONE || u.tag(p) != syntax.N_ASSERT_RAISES: continue
        for nm in u.kids(p):
            if u.a.main[nm] == u.a.main[f]: return true
    return false

private void trait_decl(^F u, u32 n):
    []u32 k = u.kids(n)
    u.put("trait ")
    u.tok(u.a.main[n])
    u32 he = binders(u, n, 0, u.tend(u.a.main[n]))
    he = tail(u, "extends", n, 0, he)
    u.put(":\n")
    u.close(he)
    u.depth += 1
    for m in k:
        if u.tag(m) == syntax.N_FN: method(u, m, (u.a.a[m] & syntax.F_REQUIRED) != 0, false)
    u.depth -= 1

private u32 class_head(^F u, u32 n):
    []u32 k = u.kids(n)
    u.put("class ")
    u.tok(u.a.main[n])
    u32 he = u.tend(u.a.main[n])
    if k[0] != NONE:
        u.put(" extends ")
        type_expr(u, k[0])
        he = u.a.hi[k[0]]
    return tail(u, "using", n, 1, he)

private void class_decl(^F u, u32 n):
    u32 he = class_head(u, n)
    u.put(":\n")
    u.close(he)
    bool boundary = u.dado_file && u.origin == 0
    i64 first_line = newlines(u, 0)
    u.depth += 1
    if boundary: u.origin = u.depth * 4
    []u32 k = u.kids(n)
    i64 from = 1
    for from < #len(k) && is_type(u.tag(k[from])): from += 1
    items(u, n, from, u.k(B_ITEM))
    if boundary:
        u.origins = #append(u.origins, first_line)
        u.origins = #append(u.origins, newlines(u, 0))
        u.origins = #append(u.origins, u.origin)
        u.origin = 0
    u.depth -= 1

private void union_decl(^F u, u32 n, i64 policy):
    u32 f = u.a.a[n]
    if (f & syntax.F_DISTINCT) != 0: u.put("distinct ")
    u.put("cunion" if (f & syntax.F_RAW) != 0 else "union")
    c_name(u, u.kids(n)[0])
    u.sp_tok(u.a.main[n])
    u.ch(':')
    _ = member_list(u, policy, u.tend(u.a.main[n]), u.a.hi[n], L_UNION, n)

// -- member lists --------------------------------------------------------

private []u32 members_of(^F u, u8 kind, u32 n):
    []u32 k = u.kids(n)
    if kind == L_LIST: return k
    if kind == L_TYPE: return u.kids(k[2])
    if kind == L_FENUM: return k[2..<#len(k)]
    return k[1..<#len(k)]

// True when written exploded.
private bool member_list(^F u, i64 policy, u32 he, u32 list_end, u8 kind, u32 n):
    []u32 ms = members_of(u, kind, n)
    if #len(ms) == 0:
        u.put(" ()\n")
        u.close(list_end)
        return false
    bool one = policy == i64(FIT) || policy == i64(FOLD) || (policy == i64(AS_WRITTEN) && u.same_line(he, u.a.lo[ms[0]]))
    if one && !u.pending_comment_before(list_end):
        Mark m = u.mark()
        u.ch(' ')
        u.opens('(', false)
        for i in 0..<#len(ms):
            if i > 0: u.comma()
            if kind == L_ENUM: enum_member(u, ms[i], false)
            else if kind == L_FENUM: foreign_enum_member(u, ms[i])
            else: member(u, ms[i], false)
        u.closes(')', false)
        u.ch('\n')
        u.close(list_end)
        if policy == i64(FOLD) || policy == i64(AS_WRITTEN) || u.within_budget(m.out): return false
        u.restore(m)
    u.ch('\n')
    u.close(he)
    u.depth += 1
    if kind == L_TYPE: members_and_methods(u, n)
    else:
        for m in ms:
            u.open_tight(u.a.lo[m])
            if kind == L_ENUM: enum_member(u, m, true)
            else if kind == L_FENUM: foreign_enum_member(u, m)
            else: member(u, m, true)
            u.put(",\n")
            u.close(u.a.hi[m])
    u.depth -= 1
    return true

private void members_and_methods(^F u, u32 t):
    []u32 ms = members_of(u, L_TYPE, t)
    []u32 k = u.kids(t)
    i64 i = 0
    i64 j = 3
    for:
        for j < #len(k) && u.tag(k[j]) != syntax.N_FN: j += 1
        bool slot = false
        if i < #len(ms) && j < #len(k): slot = u.a.lo[ms[i]] < u.a.lo[k[j]]
        else if i < #len(ms): slot = true
        else if j >= #len(k): break
        if slot:
            u32 m = ms[i]
            u.open_tight(u.a.lo[m])
            member(u, m, true)
            u.put(",\n")
            u.close(u.a.hi[m])
            i += 1
        else:
            method(u, k[j], false, promised(u, t, k[j]))
            j += 1

private void enum_member(^F u, u32 m, bool own_line):
    u.tok(u.a.main[m])
    if u.a.a[m] == NONE: return
    if own_line: u.stop(STOP_ENUM)
    u.decl_eq()
    expr(u, u.a.a[m])

private void foreign_enum_member(^F u, u32 m):
    if u.a.a[m] != NONE:
        u.put("@c(")
        u.tok(u.a.main[u.a.a[m]])
        u.put(") ")
    u.tok(u.a.main[m])

void member(^F u, u32 m, bool own_line):
    []u32 k = u.kids(m)
    align_attr(u, k[3])
    if u.tag(k[0]) == syntax.T_CHANNEL && u.a.main[m] != NONE:
        channel_named(u, k[0], u.a.main[m])
        return
    type_expr(u, k[0])
    c_name(u, k[1])
    if u.a.main[m] != NONE:
        if own_line: u.stop(STOP_MEMBER)
        u.sp_tok(u.a.main[m])
    if k[2] != NONE:
        u.put(" : ")
        expr(u, u.a.a[k[2]])

// -- foreign -------------------------------------------------------------

private void foreign_item(^F u, u32 n):
    u8 g = u.tag(n)
    u32 vis = u.a.a[n]
    if g == syntax.N_F_OPAQUE || g == syntax.N_F_CONST || g == syntax.N_F_VAR: vis = u.a.b[n]
    visibility(u, vis)
    switch g:
        case syntax.N_F_FN: within(u, u.k(F_PARAMS), n, u.a.hi[n], W_FFN)
        case syntax.N_UNION: union_decl(u, n, u.k(F_FOREIGN))
        case syntax.N_F_OPAQUE:
            u.put("type")
            if (u.a.b[n] & syntax.F_INCOMPLETE) != 0: u.put(" @incomplete")
            c_name(u, u.a.a[n])
            u.sp_tok(u.a.main[n])
            u.ch('\n')
        case syntax.N_TYPE: type_decl(u, n, u.k(F_FOREIGN))
        case syntax.N_F_CONST, syntax.N_F_VAR:
            if g == syntax.N_F_CONST: u.put("const ")
            type_expr(u, u.a.a[n])
            u.sp_tok(u.a.main[n])
            u.ch('\n')
        case syntax.N_F_ENUM:
            []u32 k = u.kids(n)
            u.put("enum")
            c_name(u, k[0])
            u.sp_tok(u.a.main[n])
            u.ch(':')
            u32 end = u.tend(u.a.main[n])
            if #len(k) > 2: end = u.a.hi[k[#len(k) - 1]]
            _ = member_list(u, u.k(F_ENUM), u.tend(u.a.main[n]), end, L_FENUM, n)
        else: return

private void foreign_fn(^F u, u32 n):
    []u32 k = u.kids(n)
    u32 f = u.a.a[n]
    if (f & syntax.F_MACRO) != 0: u.put("@macro ")
    if (f & syntax.F_FAILABLE) != 0:
        if k[1] != NONE: type_expr(u, k[1])
        u.ch('!')
    type_expr(u, k[0])
    c_name(u, k[2])
    u.sp_tok(u.a.main[n])
    bool empty = #len(k) == 3
    u.opens('(', empty)
    for i in 3..<#len(k):
        if i > 3: u.comma()
        param(u, k[i], false)
    if (f & syntax.F_CVAR) != 0:
        u.comma()
        u.put("...")
    u.closes(')', empty)
    u.ch('\n')
