// `dado fmt` over language:syntax: unparse, format and align in one walk,
// with the trivia beside it.
package fmt

import "language:syntax"
import "language:types"

const u32 NONE = 0xFFFFFFFF
const u8 STOP_MEMBER = 0
const u8 STOP_ENUM = 1
const u8 STOP_COMMENT = 2

type Mark:
    i64 out
    i64 next
    i64 stops
    i64 junctions
    i64 origins

type F:
    string8 src
    ^syntax.Tokens t
    ^syntax.Ast a
    Style s
    ref []char8 out
    i64 depth
    i64 next
    // (offset, kind) pairs.
    ref []u32 stops
    ref []u32 junctions
    u32 lambda_tail
    i64 origin
    bool dado_file
    // (first line, end line, column) triples.
    ref []i64 origins

    i64 k(^self, i64 key):
        return self.s.n[key]

    string8 text(^self, u32 tok):
        return self.src[i64(self.t.start[tok])..<i64(self.t.end[tok])]

    u32 tend(^self, u32 tok):
        return self.t.end[tok]

    []u32 kids(^self, u32 n):
        return self.a.list(self.a.b[n])

    u8 tag(^self, u32 n):
        return self.a.tag[n]

    void put(^self, string8 s):
        self.out = #append(self.out, ..s)

    void ch(^self, char8 c):
        self.out = #append(self.out, c)

    void tok(^self, u32 t):
        string8 s = self.src[i64(self.t.start[t])..<i64(self.t.end[t])]
        self.out = #append(self.out, ..s)

    void sp_tok(^self, u32 t):
        self.ch(' ')
        self.tok(t)

    void tok_sp(^self, u32 t):
        self.tok(t)
        self.ch(' ')

    void num(^self, u32 v):
        syntax.put_num(&self.out, i64(v))

    bool ends(^self, string8 s):
        i64 n = #len(self.out)
        if n < #len(s): return false
        for i in 0..<#len(s):
            if self.out[n - #len(s) + i] != s[i]: return false
        return true

    void pop(^self):
        #truncate(self.out, #len(self.out) - 1)

    void end_line(^self):
        if !self.ends("\n"): self.ch('\n')

    // -- spaces ----------------------------------------------------------

    void spaces(^self, i64 n):
        if n == 0:
            self.junctions = #append(self.junctions, u32(#len(self.out)))
            return
        for _ in 0..<n: self.ch(' ')

    void comma(^self):
        self.ch(',')
        self.spaces(self.k(S_COMMA))

    void colon(^self):
        self.ch(':')
        self.spaces(self.k(S_COLON))

    void decl_eq(^self):
        self.spaces(self.k(S_DECL_EQ))
        self.ch('=')
        self.spaces(self.k(S_DECL_EQ))

    void infix(^self, string8 op):
        self.spaces(self.k(S_BINARY))
        self.put(op)
        self.spaces(self.k(S_BINARY))

    void infix_tok(^self, u32 t):
        self.spaces(self.k(S_BINARY))
        self.tok(t)
        self.spaces(self.k(S_BINARY))

    void span(^self, u32 lo, u32 hi):
        string8 s = self.src[i64(lo)..<i64(hi)]
        self.out = #append(self.out, ..s)

    void infix_word(^self, string8 w):
        i64 n = self.k(S_BINARY)
        if n < 1: n = 1
        self.spaces(n)
        self.put(w)
        self.spaces(n)

    i64 inside(^self, char8 b):
        if b == '(' || b == ')': return self.k(S_PARENS)
        if b == '[' || b == ']': return self.k(S_BRACKETS)
        return self.k(S_BRACES)

    void opens(^self, char8 b, bool empty):
        self.ch(b)
        if !empty: self.spaces(self.inside(b))

    void closes(^self, char8 b, bool empty):
        if !empty: self.spaces(self.inside(b))
        self.ch(b)

    void stop(^self, u8 kind):
        i64 key = ALIGN_MEMBERS
        if kind == STOP_ENUM: key = ALIGN_ENUM
        if kind == STOP_COMMENT: key = ALIGN_COMMENTS
        if self.k(key) == 0: return
        self.stops = #append(self.stops, u32(#len(self.out)))
        self.stops = #append(self.stops, u32(kind))

    void indent(^self):
        for _ in 0..<self.depth: self.put("    ")

    // -- trivia ----------------------------------------------------------

    i64 ntv(^self):
        return #len(self.t.trivia) / 2

    u32 tv_lo(^self, i64 i):
        return self.t.trivia[2 * i]

    u32 tv_hi(^self, i64 i):
        return self.t.trivia[2 * i + 1]

    bool is_comment(^self, i64 i):
        return self.src[i64(self.t.trivia[2 * i])] == '/'

    // A comment's text, trailing blanks trimmed.
    string8 tv_text(^self, i64 i):
        i64 a = i64(self.tv_lo(i))
        i64 b = i64(self.tv_hi(i))
        for b > a && (self.src[b - 1] == ' ' || self.src[b - 1] == '\t' || self.src[b - 1] == '\r' || self.src[b - 1] == '\n'):
            b -= 1
        return self.src[a..<b]

    bool same_line(^self, u32 x, u32 y):
        i64 lo = i64(x if x <= y else y)
        i64 hi = i64(y if x <= y else x)
        if hi > #len(self.src): return true
        for i in lo..<hi:
            if self.src[i] == '\n': return false
        return true

    // Claims the trivia before `before`; answers where the claim began.
    i64 take_before(^self, u32 before):
        i64 from = self.next
        for self.next < self.ntv() && self.tv_lo(self.next) < before: self.next += 1
        return from

    bool pending_comment_before(^self, u32 before):
        for i in self.next..<self.ntv():
            if self.tv_lo(i) >= before: return false
            if self.is_comment(i): return true
        return false

    // Index of the trivia starting at `at`, or -1.
    i64 tv_at(^self, u32 at):
        i64 i = 0
        i64 h = self.ntv()
        for i < h:
            i64 m = (i + h) / 2
            if self.tv_lo(m) < at: i = m + 1
            else: h = m
        if i < self.ntv() && self.tv_lo(i) == at: return i
        return -1

    bool inside_a_comment(^self, u32 at):
        i64 i = 0
        i64 h = self.ntv()
        for i < h:
            i64 m = (i + h) / 2
            if self.tv_lo(m) < at: i = m + 1
            else: h = m
        return i > 0 && self.is_comment(i - 1) && at < self.tv_hi(i - 1)

    i64 column_of(^self, u32 at):
        i64 i = i64(at)
        if i > #len(self.src): i = #len(self.src)
        i64 c = 0
        for i > 0 && self.src[i - 1] != '\n':
            i -= 1
            if (u8(self.src[i]) & 0xC0) != 0x80: c += 1
        return c

    u32 past_blanks(^self, u32 at):
        i64 i = i64(at)
        for i < #len(self.src):
            char8 c = self.src[i]
            if c != ' ' && c != '\t' && c != '\n' && c != '\r' && c != '\x0c' && c != '\x0b': break
            i += 1
        return u32(i)

    // The first byte of code at or after `at`.
    u32 code_at(^self, u32 at):
        u32 p = at
        for _ in 0..<self.ntv():
            p = self.past_blanks(p)
            i64 i = self.tv_at(p)
            if i < 0: return p
            p = self.tv_hi(i)
        return self.past_blanks(p)

    // -- placing ---------------------------------------------------------

    void blanks(^self, i64 n):
        if #len(self.out) == 0 || self.ends(":\n") || !self.ends("\n"): return
        i64 nl = 0
        for nl < #len(self.out) && self.out[#len(self.out) - 1 - nl] == '\n': nl += 1
        i64 have = nl - 1
        if n == 0 && have == 0: return
        i64 want = n if n > self.k(B_CAP) else self.k(B_CAP)
        for _ in have..<want: self.ch('\n')

    void place(^self, i64 from, i64 to, bool air):
        i64 opens = -1
        for i in from..<to:
            if self.is_comment(i):
                opens = i
                break
        for i in from..<to:
            if !self.is_comment(i):
                self.blanks(self.k(B_CAP))
                continue
            if air && i == opens: self.blanks(self.k(B_COMMENT))
            self.indent()
            self.put(self.tv_text(i))
            self.ch('\n')

    void leading(^self, u32 before):
        i64 from = self.take_before(before)
        self.place(from, self.next, true)

    void leading_tight(^self, u32 before):
        i64 from = self.take_before(before)
        self.place(from, self.next, false)

    void open(^self, u32 lo):
        self.leading(lo)
        self.indent()

    void open_tight(^self, u32 lo):
        self.leading_tight(lo)
        self.indent()

    void close(^self, u32 at):
        if !self.ends("\n") || self.ends("\n\n"): return
        bool first = true
        for self.next < self.ntv() && self.is_comment(self.next) && self.same_line(at, self.tv_lo(self.next)):
            self.pop()
            if first: self.stop(STOP_COMMENT)
            first = false
            self.spaces(self.k(S_COMMENT))
            self.put(self.tv_text(self.next))
            self.ch('\n')
            self.next += 1

    void separate_at(^self, i64 at, i64 n):
        i64 led = 0
        for at + led < #len(self.out) && self.out[at + led] == '\n': led += 1
        ref []char8 tail
        for i in at + led..<#len(self.out): tail = #append(tail, self.out[i])
        #truncate(self.out, at + led)
        self.blanks(n)
        u32 by = u32(#len(self.out) - at - led)
        self.out = #append(self.out, ..tail)
        #delete(tail)
        if by == 0: return
        i64 i = #len(self.stops) - 2
        for i >= 0 && i64(self.stops[i]) >= at:
            self.stops[i] += by
            i -= 2
        i = #len(self.junctions) - 1
        for i >= 0 && i64(self.junctions[i]) >= at:
            self.junctions[i] += by
            i -= 1

    // -- marks and the budget --------------------------------------------

    Mark mark(^self):
        return Mark(#len(self.out), self.next, #len(self.stops), #len(self.junctions), #len(self.origins))

    void restore(^self, Mark m):
        #truncate(self.out, m.out)
        self.next = m.next
        #truncate(self.stops, m.stops)
        #truncate(self.junctions, m.junctions)
        #truncate(self.origins, m.origins)

    bool within_budget(^self, i64 mark):
        i64 o = mark
        for o > 0 && self.out[o - 1] != '\n': o -= 1
        i64 e = #len(self.out)
        for e > o && (self.out[e - 1] == ' ' || self.out[e - 1] == '\n' || self.out[e - 1] == '\t' || self.out[e - 1] == '\r'):
            e -= 1
        i64 c = 0
        for i in o..<e:
            if (u8(self.out[i]) & 0xC0) != 0x80: c += 1
        c -= self.origin
        return c <= self.k(BUDGET)

    i64 column(^self):
        i64 o = #len(self.out)
        i64 c = 0
        for o > 0 && self.out[o - 1] != '\n':
            o -= 1
            if (u8(self.out[o]) & 0xC0) != 0x80: c += 1
        return c

    // The end of what the author wrote for lo..hi, brackets balanced, or NONE.
    u32 written_end(^self, u32 lo, u32 hi):
        string8 s = self.src
        i64 at = i64(lo)
        i64 depth = 0
        for at < i64(hi) || depth > 0:
            if at >= #len(s): return NONE
            i64 tv = self.tv_at(u32(at))
            if tv >= 0:
                at = i64(self.tv_hi(tv))
                continue
            char8 c = s[at]
            if c == '"' || c == '\'': at = past_literal(s, at)
            else if c == '(' || c == '[' || c == '{': depth += 1
            else if c == ')' || c == ']' || c == '}': depth -= 1
            at += 1
        return u32(at)

    // `text` (the author's lines, src[start..<end]) moved to this column.
    void as_written(^self, u32 start, u32 end):
        i64 by = self.column() - self.column_of(start)
        string8 s = self.src
        i64 at = i64(start)
        bool lit = false
        bool first = true
        for at < i64(end):
            i64 e = at
            for e < i64(end) && s[e] != '\n': e += 1
            string8 line = s[at..<e]
            u32 here = u32(at)
            at = e + 1
            bool opened_in = lit
            if odd_triples(line): lit = !lit
            if first:
                first = false
                if lit: self.put(line)
                else: self.put(rtrim(line))
                continue
            self.ch('\n')
            if opened_in || self.inside_a_comment(here):
                self.put(line)
                continue
            string8 w = rtrim(line)
            i64 lead = 0
            for lead < #len(w) && (w[lead] == ' ' || w[lead] == '\t'): lead += 1
            if lead == #len(w): continue
            i64 pad = lead + by
            for _ in 0..<pad: self.ch(' ')
            self.put(w[lead..<#len(w)])
        _ = self.take_before(end)

    // -- junctions -------------------------------------------------------

    bool fuses_at(^self, i64 at):
        i64 a = at
        for a > 0 && self.out[a - 1] != '\n': a -= 1
        for a < at && (self.out[a] == ' ' || self.out[a] == '\t'): a += 1
        i64 b = at
        for b < #len(self.out) && self.out[b] != '\n': b += 1
        if a == at || b == at: return false
        if !shares(self.out[at - 1]) || !shares(self.out[at]): return false
        ref []char8 x
        ref []char8 y
        for i in a..<at:
            x = #append(x, self.out[i])
            y = #append(y, self.out[i])
        y = #append(y, ' ')
        for i in at..<b:
            x = #append(x, self.out[i])
            y = #append(y, self.out[i])
        bool f = !same_tokens(x, y)
        #delete(x)
        #delete(y)
        return f

    void mend(^self):
        i64 j = #len(self.junctions) - 1
        for j >= 0:
            i64 at = i64(self.junctions[j])
            j -= 1
            if !self.fuses_at(at): continue
            self.ch(' ')
            i64 i = #len(self.out) - 1
            for i > at:
                self.out[i] = self.out[i - 1]
                i -= 1
            self.out[at] = ' '
            i64 s = #len(self.stops) - 2
            for s >= 0 && i64(self.stops[s]) >= at:
                self.stops[s] += 1
                s -= 2

private i64 past_literal(string8 s, i64 at):
    char8 q = s[at]
    if at + 2 < #len(s) && s[at + 1] == '"' && s[at + 2] == '"' && q == '"':
        i64 i = at + 3
        for i + 2 < #len(s):
            if s[i] == '"' && s[i + 1] == '"' && s[i + 2] == '"': return i + 2
            i += 1
        return #len(s)
    i64 i = at + 1
    for i < #len(s):
        if s[i] == '\\': i += 1
        else if s[i] == q: return i
        i += 1
    return i

private bool odd_triples(string8 l):
    i64 n = 0
    i64 i = 0
    for i + 2 < #len(l):
        if l[i] == '"' && l[i + 1] == '"' && l[i + 2] == '"':
            n += 1
            i += 3
        else: i += 1
    return n % 2 == 1

private string8 rtrim(string8 s):
    i64 b = #len(s)
    for b > 0 && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r'): b -= 1
    return s[0..<b]

// Whether `c` is part of a token longer than itself.
private bool shares(char8 c):
    u8 b = u8(c)
    if b >= 0x80: return true
    if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_': return true
    return c == '.' || c == '<' || c == '=' || c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '&' || c == '|' || c == '~' || c == '>' || c == '!'

private bool same_tokens(string8 x, string8 y):
    syntax.Tokens a = syntax.lex(x)
    syntax.Tokens b = syntax.lex(y)
    bool same = a.count() == b.count()
    if same:
        for i in 0..<a.count():
            if a.tag[i] != b.tag[i] || x[i64(a.start[i])..<i64(a.end[i])] != y[i64(b.start[i])..<i64(b.end[i])]:
                same = false
                break
    a.free()
    b.free()
    return same

private i64 chars(string8 s, i64 a, i64 b):
    i64 c = 0
    for i in a..<b:
        if (u8(s[i]) & 0xC0) != 0x80: c += 1
    return c

// The column pass: runs of lines with stops pad each cell to the
// widest in the run.
private void align(string8 text, []u32 stops, i64 budget, []i64 origins, ^ref []char8 out):
    i64 ns = #len(stops) / 2
    if ns == 0:
        syntax.put(out, text)
        return
    // Per line: start, body end, first stop, stop count, flags (alignable | indent << 1).
    ref []i64 rows
    ref []i64 pad = #make([]i64, ns)
    i64 next = 0
    i64 at = 0
    i64 row = 0
    for at < #len(text):
        i64 e = at
        for e < #len(text) && text[e] != '\n': e += 1
        i64 s0 = next
        for next < ns && i64(stops[2 * next]) < e: next += 1
        i64 origin = 0
        i64 o = 0
        for o + 2 < #len(origins):
            if row >= origins[o] && row < origins[o + 1]:
                origin = origins[o + 2]
                break
            o += 3
        i64 w = chars(text, at, e) - origin
        i64 ind = 0
        for at + ind < e && (text[at + ind] == ' ' || text[at + ind] == '\t'): ind += 1
        bool own = at + ind == e || (at + ind + 1 < e && text[at + ind] == '/' && (text[at + ind + 1] == '/' || text[at + ind + 1] == '*'))
        bool ok = next > s0 && w <= budget && !own
        rows = #append(rows, at)
        rows = #append(rows, e)
        rows = #append(rows, s0)
        rows = #append(rows, next - s0)
        rows = #append(rows, (1 if ok else 0) | (ind << 1))
        at = e + 1
        row += 1
    i64 nr = #len(rows) / 5
    ref []i64 cw
    i64 r = 0
    for r < nr:
        if (rows[5 * r + 4] & 1) == 0:
            r += 1
            continue
        i64 end = r + 1
        for end < nr && continues(rows, stops, end - 1, end): end += 1
        #truncate(cw, 0)
        i64 cols = 0
        for i in r..<end:
            i64 first = rows[5 * i + 2]
            i64 stop0 = i64(stops[2 * first])
            cw = #append(cw, chars(text, rows[5 * i], stop0))
            if rows[5 * i + 3] > cols: cols = rows[5 * i + 3]
        for j in 0..<cols:
            i64 width = 0
            for c in cw:
                if c > width: width = c
            for i in r..<end:
                i64 nk = rows[5 * i + 3]
                if j >= nk: continue
                i64 s = rows[5 * i + 2] + j
                i64 from = i64(stops[2 * s])
                i64 to = rows[5 * i + 1] if j + 1 == nk else i64(stops[2 * s + 2])
                pad[s] = width - cw[i - r]
                cw[i - r] = width + chars(text, from, to)
        r = end
    for i in 0..<nr:
        i64 a = rows[5 * i]
        i64 e = rows[5 * i + 1]
        bool aligned = (rows[5 * i + 4] & 1) != 0
        i64 s = rows[5 * i + 2]
        for x in s..<s + rows[5 * i + 3]:
            i64 cut = i64(stops[2 * x])
            syntax.put(out, text[a..<cut])
            if aligned:
                for _ in 0..<pad[x]: out^ = #append(out^, ' ')
            a = cut
        syntax.put(out, text[a..<e])
        if e < #len(text): out^ = #append(out^, '\n')
    #delete(rows)
    #delete(pad)
    #delete(cw)

private bool continues([]i64 r, []u32 stops, i64 p, i64 n):
    if (r[5 * n + 4] & 1) == 0 || (r[5 * n + 4] >> 1) != (r[5 * p + 4] >> 1): return false
    i64 k = r[5 * p + 3] if r[5 * p + 3] < r[5 * n + 3] else r[5 * n + 3]
    for j in 0..<k:
        if stops[2 * (r[5 * p + 2] + j) + 1] != stops[2 * (r[5 * n + 2] + j) + 1]: return false
    return true

private bool dados(string8 f):
    return #len(f) > 6 && f[#len(f) - 6..<#len(f)] == ".dados"

// `dadoc --format`'s contract: 0 and the text in `out`; 1 when `src` does not
// parse (diagnostics in `err`); 3 when the result fails the formatter's own
// check (it parses, the same tree, the same comments).
i32 format_text(string8 path, string8 src, ^const Style s, ^ref []char8 out, ^ref []char8 err):
    types.Interner names = syntax.names()
    syntax.Tokens t = syntax.lex(src)
    syntax.intern(&t, src, &names)
    syntax.Ast a = syntax.parse(src, &t, dados(path))
    syntax.render_diags(err, path, src, &t)
    syntax.render_parse_diags(err, path, src, &a)
    i32 status = 0
    if #len(t.diags) + #len(a.diags) > 0: status = 1
    else:
        format(src, &t, &a, s, out)
        string8 o = out^
        syntax.Tokens t2 = syntax.lex(o)
        syntax.intern(&t2, o, &names)
        syntax.Ast a2 = syntax.parse(o, &t2, dados(path))
        ref []u8 x
        ref []u8 y
        shape(&a, &x)
        shape(&a2, &y)
        bool same = #len(t2.diags) + #len(a2.diags) == 0 && #len(x) == #len(y)
        if same:
            for i in 0..<#len(x):
                if x[i] != y[i]:
                    same = false
                    break
        #delete(x)
        #delete(y)
        if same: same = same_comments(src, &t, o, &t2)
        if !same:
            syntax.put(err, "dadoc: ")
            syntax.put(err, path)
            syntax.put(err, " is not formatted: formatting it changes the program, which is a defect in the formatter and not in the file. Nothing was written\n")
            status = 3
        a2.free()
        t2.free()
    a.free()
    t.free()
    names.free()
    return status

private bool same_comments(string8 x, ^syntax.Tokens a, string8 y, ^syntax.Tokens b):
    i64 i = 0
    i64 j = 0
    for:
        for i < #len(a.trivia) && x[i64(a.trivia[i])] != '/': i += 2
        for j < #len(b.trivia) && y[i64(b.trivia[j])] != '/': j += 2
        if i >= #len(a.trivia) || j >= #len(b.trivia): return i >= #len(a.trivia) && j >= #len(b.trivia)
        if rtrim(x[i64(a.trivia[i])..<i64(a.trivia[i + 1])]) != rtrim(y[i64(b.trivia[j])..<i64(b.trivia[j + 1])]): return false
        i += 2
        j += 2
    return true

// The tree's tags in preorder: what "the same program" means here.
private void shape(^syntax.Ast a, ^ref []u8 out):
    ref []u32 stack
    ref []u32 kids
    stack = #append(stack, a.root)
    for #len(stack) > 0:
        u32 n = stack[#len(stack) - 1]
        #truncate(stack, #len(stack) - 1)
        out^ = #append(out^, a.tag[n])
        #truncate(kids, 0)
        a.kids(n, &kids)
        i64 i = #len(kids)
        for i > 0:
            i -= 1
            stack = #append(stack, kids[i])
    #delete(stack)
    #delete(kids)
