// Items and declarations: types, signatures, attributes, channels, and a
// script's classes.
package syntax

private u32 join_lo(u32 a, u32 b):
    return a if a < b else b

private u32 join_hi(u32 a, u32 b):
    return a if a > b else b

u32 package_decl(^Parser p):
    u32 kw = p.bump()
    u32 name = p.ident("a package name")
    if name == BAD: return BAD
    _ = p.expect(NEWLINE)
    return p.node(N_PACKAGE, name, NONE, NONE, p.st[kw], p.en[name])

u32 import_decl(^Parser p):
    u32 kw = p.bump()
    u32 alias = NONE
    u32 dot = NONE
    if p.at(IDENT):
        alias = p.ident("an import binding name")
        if alias == BAD: return BAD
    else if p.at(DOT):
        dot = p.bump()
    u32 t = p.expect(STRING)
    if t == BAD: return BAD
    check_string(p, t)
    _ = p.expect(NEWLINE)
    return p.node(N_IMPORT, t, alias, dot, p.st[kw], p.en[t])

u32 visibility(^Parser p):
    u32 first = visibility_word(p)
    if first == NONE: return VIS_UNMARKED
    u32 vis = take_visibility_word(p, first)
    u32 lo = p.vlo
    for:
        u32 second = visibility_word(p)
        if second == NONE: break
        _ = take_visibility_word(p, second)
        p.begin(203, lo, p.vhi)
        p.say("`")
        p.say(vis_spelling(vis))
        p.say("` and `")
        p.say(WORDS[second])
        p.say("` are both visibility modifiers and a declaration has one slot for them")
        p.seal_diag()
    return vis

string8 vis_spelling(u32 v):
    if v == VIS_PACKAGE || v == VIS_FILE: return "private"
    if v == VIS_EXPORT: return "export"
    return "public"

u32 take_visibility_word(^Parser p, u32 word):
    u32 t = p.bump()
    p.vlo = p.st[t]
    p.vhi = p.en[t]
    if word == W_EXPORT: return VIS_EXPORT
    if word == W_PUBLIC: return VIS_PUBLIC
    if !p.at(STRING): return VIS_PACKAGE
    u32 s = p.bump()
    p.vhi = p.en[s]
    if p.text(s) == "\"file\"": return VIS_FILE
    p.begin(201, p.st[s], p.en[s])
    p.say("`private` takes `\"file\"` or nothing; found ")
    p.say_tok(s)
    p.seal_diag()
    return VIS_PACKAGE

u32 visibility_word(^Parser p):
    u32 w = p.word(0)
    if p.kind(0) != IDENT || (w != W_PUBLIC && w != W_PRIVATE && w != W_EXPORT): return NONE
    u8 next = p.kind(1)
    if w == W_PRIVATE && next == STRING: return w
    switch next:
        case KW_CONST, KW_TYPE, KW_ENUM, KW_FOREIGN, KW_DISTINCT, IDENT, CARET, LBRACKET, LBRACE, LPAREN, AT, DOLLAR, HASH_NAME, KW_ASYNC, BANG:
            return w
        else:
            return NONE
    return NONE

u32 item(^Parser p):
    p.block_ended = false
    if at_test_marker(p):
        u32 at = p.peek()
        u32 m = test_marker(p)
        u32 lo = p.st[at]
        u32 hi = p.en[at]
        if m != NONE:
            lo = p.lo(m)
            hi = p.hi(m)
        p.error(307, lo, hi, "`@test` marks a whole file, so it is the first line of one — above `package`, with nothing before it")
        return BAD
    u32 vis = visibility(p)
    if p.at(KW_DISTINCT):
        u32 kw = p.bump()
        if p.at(KW_TYPE): return type_decl(p, vis, kw)
        if p.at(KW_ENUM): return enum_decl(p, vis, kw)
        if at_union_head(p): return union_decl(p, vis, kw)
        u32 t = p.peek()
        p.begin(201, p.st[t], p.en[t])
        p.say("`distinct` is a modifier on a declaration, not a declaration of its own: write `distinct type Name: <type>` or `distinct enum <backing> Name:`; found ")
        p.say_kind(p.tg[t])
        p.seal_diag()
        return BAD
    if p.at(KW_TYPE): return type_decl(p, vis, NONE)
    if p.at(KW_CONST): return const_decl(p, vis, NONE)
    if at_build_const(p):
        u32 at = p.bump()
        return const_decl(p, vis, at)
    if p.at(KW_ENUM): return enum_decl(p, vis, NONE)
    if p.at(KW_FOREIGN): return foreign_block(p, vis, NONE)
    if at_freestanding_mark(p):
        u32 at = p.bump()
        u32 w = p.bump()
        if !p.at(KW_FOREIGN):
            u32 t = p.peek()
            p.begin(418, p.st[at], p.en[w])
            p.say("`@freestanding` marks a `foreign` block whose header exists on a target whose `#OS` is `#NONE`, so it is written in front of `foreign`; found ")
            p.say_kind(p.tg[t])
            p.seal_diag()
            return BAD
        return foreign_block(p, vis, at)
    if at_when_head(p): return when_item(p)
    if at_channel_head(p): return channel_item(p, vis)
    if p.at(HASH_NAME) && p.word(0) == H_STATIC_ASSERT:
        if vis != VIS_UNMARKED:
            p.error_tok(201, p.peek(), "a `#static_assert` declares nothing, so there is nothing for a visibility word to say about it; write the assertion on its own line")
        return static_assert_item(p)
    if p.at(HASH_NAME) && p.word(0) == H_ASSERT_RAISES:
        if vis != VIS_UNMARKED:
            p.error_tok(201, p.peek(), "an `#assert_raises` declares nothing, so there is nothing for a visibility word to say about it; write the promise on its own line")
        if p.kind(1) == NEWLINE: return assert_raises_on_declaration(p)
        return assert_raises_item(p)
    if at_union_head(p): return union_decl(p, vis, NONE)
    if at_trait_head(p): return trait_decl(p, vis)
    if at_cunion_head(p): return cunion_decl(p, vis, false)
    if at_contract_head(p): return contract_decl(p, vis)
    if at_class_head(p, 0): return class_decl(p, vis)
    if p.in_scripts() && p.at(IDENT) && p.text(p.peek()) == "signal" && p.kind(1) == IDENT && p.kind(2) == LPAREN: return signal_decl(p, vis)
    return fn_or_var_decl(p, vis)

// `signal died(int hp)`, a class member.
private u32 signal_decl(^Parser p, u32 vis):
    u32 kw = p.bump()
    u32 name = p.bump()
    _ = p.bump()
    i64 base = p.base()
    if !p.at(RPAREN):
        for:
            u32 q = param(p, true)
            if q == BAD:
                p.drop(base)
                return BAD
            if p.ast.b[q] != NONE: p.error(201, p.lo(p.ast.b[q]), p.hi(p.ast.b[q]), "a signal's parameters take no defaults: an emit passes every value")
            p.push(q)
            if p.at(COMMA): _ = p.bump()
            else: break
    u32 rp = p.expect(RPAREN)
    if rp == BAD:
        p.drop(base)
        return BAD
    _ = p.expect(NEWLINE)
    return p.node(N_SIGNAL, name, vis, p.seal(base), p.st[kw], p.en[rp])

private bool call_of_two(^Parser p, u32 e):
    if e == BAD || p.tag_of(e) != E_CALL: return false
    []u32 k = p.ast.list(p.ast.b[e])
    if k[1] != NONE || #len(k) != 4: return false
    return p.ast.main[k[2]] == NONE && p.ast.main[k[3]] == NONE

u32 static_assert_item(^Parser p):
    u32 e = expr(p)
    if e == BAD: return BAD
    string8 shape = "`#static_assert` takes a condition and a message, `#static_assert(COND, \"message\")`: the condition is folded as a `when` condition is, and the message is what the build is refused with when it folds to `false`"
    if !call_of_two(p, e):
        p.error(201, p.lo(e), p.hi(e), shape)
        return BAD
    if p.expect(NEWLINE) == BAD: return BAD
    []u32 k = p.ast.list(p.ast.b[e])
    return p.node(N_STATIC_ASSERT, NONE, p.ast.a[k[2]], p.ast.a[k[3]], p.lo(e), p.hi(e))

u32 assert_raises_item(^Parser p):
    u32 e = expr(p)
    if e == BAD: return BAD
    string8 shape = "`#assert_raises` names the functions of this package it promises raise into a script, `#assert_raises(dot)` or `#assert_raises(dot, cross, length)`: each argument a function's bare name, at least one"
    if p.tag_of(e) != E_CALL:
        p.error(201, p.lo(e), p.hi(e), shape)
        return BAD
    []u32 k = p.ast.list(p.ast.b[e])
    i64 base = p.base()
    for i in 2..<#len(k):
        u32 v = p.ast.a[k[i]]
        if p.ast.main[k[i]] != NONE || p.tag_of(v) != E_NAME:
            p.drop(base)
            p.error(201, p.lo(v), p.hi(v), shape)
            return BAD
        p.push(v)
    if k[1] != NONE || #len(k) == 2:
        p.drop(base)
        p.error(201, p.lo(e), p.hi(e), shape)
        return BAD
    if p.expect(NEWLINE) == BAD:
        p.drop(base)
        return BAD
    return p.node(N_ASSERT_RAISES, NONE, 0, p.seal(base), p.lo(e), p.hi(e))

private u32 assert_raises_on_declaration(^Parser p):
    u32 w = p.bump()
    if p.expect(NEWLINE) == BAD: return BAD
    u32 below = item(p)
    if below == BAD: return BAD
    if p.tag_of(below) == N_FN:
        i64 base = p.base()
        p.push(p.leaf(E_NAME, p.ast.main[below]))
        u32 promise = p.node(N_ASSERT_RAISES, NONE, 1, p.seal(base), p.st[w], p.en[w])
        p.pending_item = below
        return promise
    string8 what = "no function"
    if p.tag_of(below) == N_ASSERT_RAISES: what = "another `#assert_raises`, and one promise is written once"
    p.begin(1228, p.st[w], p.en[w])
    p.say("`#assert_raises` on its own line promises the function declared on the line below it, and that is ")
    p.say(what)
    p.help("write it directly above the package-level function it promises, or delete it")
    p.seal_diag()
    return below

u32 take_pending_item(^Parser p):
    u32 i = p.pending_item
    p.pending_item = NONE
    return i

bool at_freestanding_mark(^Parser p):
    return p.at(AT) && p.kind(1) == IDENT && p.word(1) == W_FREESTANDING

bool at_build_const(^Parser p):
    return p.at(AT) && p.kind(1) == KW_CONST

bool at_test_marker(^Parser p):
    return p.at(AT) && p.kind(1) == IDENT && p.word(1) == W_TEST

u32 test_marker(^Parser p):
    p.skip_layout()
    if !at_test_marker(p): return NONE
    u32 at = p.bump()
    u32 w = p.bump()
    u32 hi = p.en[w]
    u32 status = NONE
    if p.at(INT):
        u32 t = p.bump()
        hi = p.en[t]
        string8 raw = p.text(t)
        u64 v = 0
        bool ok = #len(raw) > 0 && #len(raw) <= 10
        for c in raw:
            if c < '0' || c > '9':
                ok = false
                break
            v = v * 10 + u64(u8(c) - u8('0'))
        if ok && v <= 2147483647:
            status = u32(v)
        else:
            p.begin(201, p.st[t], p.en[t])
            p.say("`@test ")
            p.say(raw)
            p.say("` names an exit status, and a process exit status is a small number; C truncates it to 8 bits")
            p.seal_diag()
    p.skip_layout()
    return p.node(N_TEST, at, status, NONE, p.st[at], hi)

bool at_union_head(^Parser p):
    return p.at(IDENT) && p.word(0) == W_UNION && p.kind(1) == IDENT

bool at_trait_head(^Parser p):
    if !p.at(IDENT) || p.word(0) != W_TRAIT || p.kind(1) != IDENT: return false
    u8 k = p.kind(2)
    if k == COLON || k == LPAREN: return true
    return k == IDENT && (p.word(2) == W_EXTENDS || p.word(2) == W_USING)

bool at_cunion_head(^Parser p):
    return p.at(IDENT) && p.word(0) == W_CUNION && (p.kind(1) == IDENT || p.kind(1) == AT)

bool at_contract_head(^Parser p):
    return p.at(IDENT) && p.word(0) == W_CONTRACT && p.kind(1) == IDENT

bool at_class_head(^Parser p, i64 skip):
    if p.kind(skip) != IDENT || p.word(skip) != W_CLASS || p.kind(skip + 1) != IDENT: return false
    u8 k = p.kind(skip + 2)
    if k == COLON || k == NEWLINE || k == EOF: return true
    return k == IDENT && (p.word(skip + 2) == W_EXTENDS || p.word(skip + 2) == W_USING)

bool at_script_header(^Parser p):
    return at_class_head(p, 0) && !p.line_ends_in_colon(p.pos)

bool at_exported_script_header(^Parser p):
    return p.at(IDENT) && p.word(0) == W_EXPORT && at_class_head(p, 1) && !p.line_ends_in_colon(p.pos)

// Whether the token ahead is a type qualifier in front of a type.
bool at_qualifier(^Parser p):
    u8 k = p.kind(0)
    u32 w = p.word(0)
    bool named = k == KW_CONST || (k == IDENT && (w == W_VOLATILE || w == W_RESTRICT || w == W_ATOMIC))
    return named && starts_type(p.kind(1))

bool starts_type(u8 k):
    return k == BANG || k == DOLLAR || k == KW_TYPE || k == LBRACKET || k == LBRACE || k == CARET || k == IDENT || k == HASH_NAME || k == KW_CONST

// -- traits, contracts, unions -------------------------------------------

u32 trait_decl(^Parser p, u32 vis):
    u32 kw = p.bump()
    u32 name = p.ident("a trait name")
    if name == BAD: return BAD
    i64 base = p.base()
    if binder_list(p) == BAD || decl_tail(p, 2, name) == BAD || p.expect(COLON) == BAD:
        p.drop(base)
        return BAD
    u32 head_end = p.previous_end()
    if p.at(NEWLINE): _ = p.bump()
    if !p.at(INDENT):
        u32 t = p.peek()
        p.begin(202, p.st[t], p.en[t])
        p.say("a trait's body is the methods it prescribes, indented under its head; found ")
        p.say_kind(p.tg[t])
        p.help("write each method on a line of its own under `trait ")
        p.help_tok(name)
        p.help(":` — `void draw(self)` for one every implementer writes, or with a `:` and a body for a default")
        p.seal_diag()
        return p.node(N_TRAIT, name, vis, p.seal(base), p.st[kw], join_hi(p.en[kw], head_end))
    _ = p.bump()
    u32 end = head_end
    for:
        p.skip_newlines()
        if p.at(DEDENT) || p.at(EOF): break
        i64 keep = p.base()
        u32 m = trait_line(p)
        p.drop(keep)
        if m != BAD:
            p.push(m)
            end = p.hi(m)
        else if !p.recover_to_stmt():
            break
    if p.at(DEDENT): _ = p.bump()
    return p.node(N_TRAIT, name, vis, p.seal(base), p.st[kw], join_hi(p.en[kw], end))

u32 trait_line(^Parser p):
    u32 start = p.peek()
    u32 vis = VIS_UNMARKED
    if visibility_word(p) != NONE: vis = visibility(p)
    if !at_channel_head(p):
        u32 ty = type_expr_marked(p)
        if ty == BAD: return BAD
        u32 fl = p.tm_lo
        if p.at(IDENT) && p.kind(1) == LPAREN:
            u32 name = p.ident("a method name")
            if name == BAD: return BAD
            u32 mlo = p.lo(ty)
            if fl != NONE: mlo = join_lo(fl, mlo)
            return method_after(p, vis, mlo, ty, fl, name, true)
        ref []char8 slot
        unparse_type(p, ty, &slot)
        i64 written = #len(slot)
        u32 end = p.hi(ty)
        bool named = false
        if p.at(IDENT):
            u32 n = p.bump()
            slot = #append(slot, ' ')
            slot = #append(slot, ..p.text(n))
            end = p.en[n]
            named = true
        p.begin(201, p.st[start], join_hi(p.en[start], end))
        p.say("`")
        p.say(slot)
        p.say("` is a slot, and a trait prescribes methods, never a shape — a slot belongs in the implementing `type`")
        p.help("write `")
        p.help(slot)
        p.help("` in the `type` that takes the trait on, or prescribe a method here: ")
        if named && (p.at(NEWLINE) || p.at(COMMA)):
            p.help("`")
            p.help(slot)
            p.help("(self)`")
        else:
            p.help("`")
            string8 sv = slot
            p.help(sv[0..<written])
            p.help(" get(self)`")
        p.seal_diag()
        #delete(slot)
        return BAD
    p.error_help(201, p.st[p.peek()], p.en[p.peek()], "a channel is a slot of the value that holds it, and a trait prescribes methods, never a shape", "declare the channel in the `type` that takes the trait on")
    return BAD

u32 contract_decl(^Parser p, u32 vis):
    u32 kw = p.bump()
    u32 name = p.ident("a contract name")
    if name == BAD: return BAD
    if p.expect(COLON) == BAD: return BAD
    u32 body = BAD
    if p.at(LPAREN):
        body = member_list_parenthesized(p, false)
    else:
        body = member_list(p, false, false)
    if body == BAD: return BAD
    i64 base = p.base()
    p.push(NONE)
    p.push(NONE)
    p.push(body)
    return p.node(N_TYPE, name, vis | F_CONTRACT, p.seal(base), p.st[kw], join_hi(p.en[kw], p.hi(body)))

private u32 union_tail(^Parser p, u32 name, u32 c_name, bool fgn, u32 flags, u32 lo):
    if p.expect(COLON) == BAD: return BAD
    bool paren = p.at(LPAREN)
    u32 body = BAD
    if paren:
        body = member_list_parenthesized(p, fgn)
    else:
        body = member_list(p, fgn, false)
    if body == BAD: return BAD
    i64 base = p.base()
    p.push(c_name)
    for m in p.ast.list(p.ast.b[body]):
        p.push(m)
    if paren: flags = flags | F_PAREN
    return p.node(N_UNION, name, flags, p.seal(base), lo, join_hi(lo, p.hi(body)))

u32 union_decl(^Parser p, u32 vis, u32 dist):
    u32 kw = p.bump()
    u32 lo = p.st[kw]
    u32 flags = vis
    if dist != NONE:
        lo = p.st[dist]
        flags = flags | F_DISTINCT
    u32 name = p.ident("a union name")
    if name == BAD: return BAD
    return union_tail(p, name, NONE, false, flags, lo)

u32 cunion_decl(^Parser p, u32 vis, bool fgn):
    u32 kw = p.bump()
    u32 c = foreign_type_c_name(p)
    if c == BAD: return BAD
    u32 name = p.ident("a union name")
    if name == BAD: return BAD
    return union_tail(p, name, c, fgn, vis | F_RAW, p.st[kw])

bool at_member_comma(^Parser p):
    return p.receivers && p.at(COMMA) && p.kind(1) == NEWLINE

void member_comma(^Parser p):
    if at_member_comma(p): _ = p.bump()

// -- functions and variables ---------------------------------------------

private string8 function_not_aligned():
    return "`@align(n)` states the alignment of an object's storage, and a function is not an object\x1fC aligns code by its own rules and gives a program no say in it\x1ewrite the attribute on a package-level declaration or on a member of a `type`"

string8 failure_stored():
    return "a failure is never stored, so `!` is not part of a value's type\x1f`!` marks a function's return type in its signature (`!i32 parse(string8 s):`, or `Why!i32 parse(string8 s):` when its failures are members of the enum `Why`) and a failable function type (`!i32(string8)`, `Why!i32(string8)`), and nothing else\x1emake a failable call with `try`, which puts the value it answers in an ordinary `i32`"

u32 fn_or_var_decl(^Parser p, u32 vis):
    u32 start = p.peek()
    u32 align = align_attr(p)
    if align == BAD: return BAD
    u32 symbol = symbol_attr(p)
    if symbol == BAD: return BAD
    u32 c_body = c_body_attr(p)
    if c_body == BAD: return BAD
    u32 tl = thread_local_attr(p)
    u32 ty = type_expr_marked(p)
    if ty == BAD: return BAD
    u32 fl = p.tm_lo
    u32 lo = p.st[start]
    if p.in_scripts() && fl == NONE && align == NONE && symbol == NONE && c_body == NONE && tl == NONE && p.head_async == NONE && (p.at(NEWLINE) || at_member_comma(p)):
        u32 label = embedded_name(p, ty)
        if label != NONE:
            member_comma(p)
            _ = p.expect(NEWLINE)
            i64 base = p.base()
            p.push(ty)
            p.push(NONE)
            p.push(NONE)
            p.push(NONE)
            p.push(NONE)
            return p.node(N_VAR, label, vis | F_EMBED, p.seal(base), lo, join_hi(lo, p.hi(ty)))
    u32 name = keyword_name(p, "a function's or a variable's name", LPAREN, ASSIGN, NEWLINE, EOF)
    if name == NONE:
        name = p.ident("a function or variable name")
        if name == BAD: return BAD
    if p.at(LPAREN):
        if align != NONE: p.error(1026, p.lo(align), p.hi(align), function_not_aligned())
        if c_body != NONE:
            p.error_help(1028, p.lo(c_body), p.hi(c_body), "`@c_body(\"…\")` places verbatim C beside storage the compiler emits, and a function emits a body written in Dado instead", "write the attribute on a `private` package-level variable or on a local")
        if tl != NONE:
            p.error(418, p.lo(tl), p.hi(tl), "`@thread_local` gives each thread its own copy of a package-level variable's storage, and a function is not storage\x1fIts code is shared by every thread and its locals are already per call\x1ewrite the attribute on a package-level variable")
        return fn_decl_after(p, vis, lo, ty, fl, name, symbol)
    if symbol != NONE:
        p.error(1027, p.lo(symbol), p.hi(symbol), "`@symbol(…)` states what the C compiler must be told about a function's emitted symbol, and a variable is not a function\x1fWhat is emitted for a variable is storage, which `@align` is the word for\x1ewrite the attribute on a function declaration")
    if c_body != NONE && (vis == VIS_UNMARKED || vis == VIS_PUBLIC || vis == VIS_EXPORT):
        p.error_help(1028, p.lo(c_body), p.hi(c_body), "`@c_body(\"…\")` goes on a `private` package-level variable, and this declaration is visible outside its package", "write `private`, or put the C where it is compiled once")
    if p.head_async != NONE:
        u32 m = p.head_async
        p.head_async = NONE
        ty = async_value(p, m, ty)
    u32 value = NONE
    if p.at(ASSIGN):
        _ = p.bump()
        value = expr(p)
        if value == BAD: return BAD
    u32 hi = p.en[name]
    if value != NONE: hi = p.hi(value)
    member_comma(p)
    _ = p.expect(NEWLINE)
    i64 base = p.base()
    p.push(ty)
    p.push(value)
    p.push(align)
    p.push(c_body)
    p.push(tl)
    return p.node(N_VAR, name, vis, p.seal(base), lo, join_hi(lo, hi))

// The name an embedded slot is known by: a type's own name.
private u32 embedded_name(^Parser p, u32 ty):
    u8 g = p.tag_of(ty)
    if g == T_NAME: return p.ast.main[ty]
    if g == T_PATH:
        if p.ast.b[ty] != NONE: return p.ast.b[ty]
        return p.ast.main[ty]
    return NONE

// -- constants and enums -------------------------------------------------

u32 const_decl(^Parser p, u32 vis, u32 sigil):
    u32 kw = p.bump()
    u32 lo = p.st[kw]
    u32 flags = vis
    if sigil != NONE:
        lo = p.st[sigil]
        flags = flags | F_BUILD
    u32 first = type_expr(p)
    if first == BAD: return BAD
    u32 ty = NONE
    u32 name = NONE
    if p.at(ASSIGN):
        if p.tag_of(first) != T_NAME:
            p.error(201, p.lo(first), p.hi(first), "a constant with no type is written `const NAME = <literal>`, so what comes before `=` has to be a plain name")
            return BAD
        name = p.ast.main[first]
    else:
        ty = first
        name = keyword_name(p, "a constant's name", ASSIGN, 255, 255, 255)
        if name == NONE:
            name = p.ident("a constant name")
            if name == BAD: return BAD
    if ty != NONE && p.tag_of(ty) == T_SLICE && p.at(LPAREN):
        ref []char8 el
        unparse_type(p, p.ast.a[ty], &el)
        p.begin(201, lo, p.en[name])
        p.say("`const []")
        p.say(el)
        p.say("` is not a type, so this reads as a constant named `")
        p.say_tok(name)
        p.say("`: a read-only window is `[]const ")
        p.say(el)
        p.say("`, the word on its elements")
        p.help("write `[]const ")
        p.help(el)
        p.help(" ")
        p.help_tok(name)
        p.help("(…)`")
        p.seal_diag()
        #delete(el)
        return BAD
    if p.expect(ASSIGN) == BAD: return BAD
    u32 value = expr(p)
    if value == BAD: return BAD
    _ = p.expect(NEWLINE)
    i64 base = p.base()
    p.push(ty)
    p.push(value)
    return p.node(N_CONST, name, flags, p.seal(base), lo, join_hi(lo, p.hi(value)))

u32 enum_decl(^Parser p, u32 vis, u32 dist):
    u32 kw = p.bump()
    u32 lo = p.st[kw]
    u32 flags = vis
    if dist != NONE:
        lo = p.st[dist]
        flags = flags | F_DISTINCT
    u32 first = type_expr(p)
    if first == BAD: return BAD
    u32 backing = NONE
    u32 name = NONE
    if p.at(IDENT):
        backing = first
        name = p.ident("an enum name")
        if name == BAD: return BAD
    else:
        if p.tag_of(first) != T_NAME:
            p.error(201, p.lo(first), p.hi(first), "an enum is `enum Name:` or `enum <backing> Name:`; this names neither")
            return BAD
        name = p.ast.main[first]
    if p.expect(COLON) == BAD: return BAD
    bool paren = p.at(LPAREN)
    if paren: flags = flags | F_PAREN
    i64 base = p.base()
    p.push(backing)
    if enum_members(p, paren) == BAD:
        p.drop(base)
        return BAD
    u32 hi = p.en[name]
    if #len(p.scratch) > base + 1: hi = p.hi(p.scratch[#len(p.scratch) - 1])
    return p.node(N_ENUM, name, flags, p.seal(base), lo, join_hi(lo, hi))

// Pushes the members; BAD on failure.
private u32 enum_members(^Parser p, bool paren):
    if paren:
        _ = p.expect(LPAREN)
        for !p.at(RPAREN) && !p.at(EOF):
            u32 m = enum_member(p)
            if m == BAD: return BAD
            p.push(m)
            if p.at(COMMA): _ = p.bump()
            else: break
        if p.expect(RPAREN) == BAD: return BAD
        _ = p.expect(NEWLINE)
        misplaced_method_block(p)
        return 0
    if p.at(NEWLINE): _ = p.bump()
    if !p.at(INDENT):
        u32 t = p.peek()
        p.begin(202, p.st[t], p.en[t])
        p.say("expected an enum body — `(` or an indented block — found ")
        p.say_kind(p.tg[t])
        p.seal_diag()
        return BAD
    _ = p.bump()
    for:
        p.skip_newlines()
        if p.at(DEDENT) || p.at(EOF): break
        i64 keep = p.base()
        if at_plain_method_line(p):
            u32 r = member_line(p, false)
            p.drop(keep)
            if r != BAD && p.tag_of(r) == N_FN:
                method_misplaced(p, r)
            else if !p.recover_to_stmt():
                break
            continue
        u32 m = enum_member(p)
        p.drop(keep)
        if m != BAD:
            p.push(m)
            if p.at(COMMA): _ = p.bump()
            _ = p.expect(NEWLINE)
        else if !p.recover_to_stmt():
            break
    if p.at(DEDENT): _ = p.bump()
    return 0

private u32 enum_member(^Parser p):
    u32 name = keyword_name(p, "an enum member's name", COMMA, RPAREN, ASSIGN, NEWLINE)
    if name == NONE:
        name = p.ident("an enum member name")
        if name == BAD: return BAD
    u32 value = NONE
    u32 hi = p.en[name]
    if p.at(ASSIGN):
        _ = p.bump()
        value = expr(p)
        if value == BAD: return BAD
        hi = join_hi(hi, p.hi(value))
    return p.node(N_ENUM_MEMBER, name, value, NONE, p.st[name], hi)

// -- types ---------------------------------------------------------------

u32 type_decl(^Parser p, u32 vis, u32 dist):
    u32 kw = p.bump()
    u32 lo = p.st[kw]
    u32 flags = vis
    if dist != NONE:
        lo = p.st[dist]
        flags = flags | F_DISTINCT
    u32 name = keyword_name(p, "a type's name", COLON, NEWLINE, ASSIGN, 255)
    if name == NONE:
        name = p.ident("a type name")
        if name == BAD: return BAD
    i64 base = p.base()
    p.push(NONE)
    p.push(NONE)
    p.push(NONE)
    if binder_list(p) == BAD || decl_tail(p, 1, name) == BAD:
        p.drop(base)
        return BAD
    u32 where = where_clause(p)
    if where == BAD || p.expect(COLON) == BAD:
        p.drop(base)
        return BAD
    if where != NONE: p.scratch[base + 1] = p.node(N_WHERE, NONE, where, NONE, p.lo(where), p.hi(where))
    i64 outer = #len(p.promised)
    i64 methods = p.base()
    u32 body = type_body_with_methods(p)
    if body == BAD:
        #truncate(p.promised, outer)
        p.drop(base)
        return BAD
    p.scratch[base + 2] = body
    u32 hi = join_hi(p.en[kw], p.hi(body))
    if #len(p.scratch) > methods: hi = join_hi(hi, p.hi(p.scratch[#len(p.scratch) - 1]))
    i64 k = outer
    i64 mend = #len(p.scratch)
    for k < #len(p.promised):
        u32 w = p.promised[k]
        u32 m = p.promised[k + 1]
        for i in methods..<mend:
            if p.scratch[i] == m:
                i64 nb = p.base()
                p.push(p.node(E_NAME, p.ast.main[m], name, NONE, p.st[p.ast.main[m]], p.en[p.ast.main[m]]))
                p.push(p.node(N_ASSERT_RAISES, NONE, 1, p.seal(nb), p.st[w], p.en[w]))
                break
        k += 2
    #truncate(p.promised, outer)
    return p.node(N_TYPE, name, flags, p.seal(base), lo, hi)

// `($T, $U)` after a type's or trait's name: pushes N_BINDERs.
u32 binder_list(^Parser p):
    if !p.at(LPAREN): return 0
    _ = p.bump()
    for:
        u32 d = p.expect(DOLLAR)
        if d == BAD: return BAD
        u32 n = p.ident("a name to bind after `$`")
        if n == BAD: return BAD
        p.push(p.node(N_BINDER, n, NONE, NONE, p.st[d], p.en[n]))
        if !p.at(COMMA): break
        _ = p.bump()
    if p.expect(RPAREN) == BAD: return BAD
    return 0

// `extends A, B` / `using C` (kind 1 type, 2 trait, 3 class): pushes the
// kept `extends` types, then the `using` ones.
u32 decl_tail(^Parser p, u32 kind, u32 name):
    ref []u32 ext
    ref []u32 use
    ref []char8 first_ext
    ref []char8 first_use
    bool seen_ext = false
    bool seen_use = false
    u32 r = 0
    for:
        if !p.at(IDENT): break
        u32 w = p.word(0)
        if w != W_EXTENDS && w != W_USING: break
        u32 at = p.bump()
        i64 names = p.base()
        bool bad = false
        for:
            u32 t = type_expr(p)
            if t == BAD:
                bad = true
                break
            p.push(t)
            if !p.at(COMMA): break
            _ = p.bump()
        if bad:
            p.drop(names)
            r = BAD
            break
        ref []char8 listed
        for i in names..<#len(p.scratch):
            if i > names: listed = #append(listed, ..", ")
            unparse_type(p, p.scratch[i], &listed)
        bool seen = seen_ext if w == W_EXTENDS else seen_use
        if seen:
            p.begin(201, p.st[at], p.en[at])
            p.say("`")
            p.say(WORDS[w])
            p.say("` is written once at a declaration's head, with every name it takes after it")
            p.help("join the two lists: `")
            p.help(WORDS[w])
            p.help(" ")
            if w == W_EXTENDS: p.help(first_ext)
            else: p.help(first_use)
            p.help(", ")
            p.help(listed)
            p.help("`")
            p.seal_diag()
        else if kind == 1 && w == W_EXTENDS:
            seen_ext = true
            string8 lv = listed
            first_ext = #append(first_ext, ..lv)
            p.begin(201, p.st[at], p.en[at])
            p.say("`extends` is between traits; a type takes a trait on with `using`")
            p.help("write `type ")
            p.help_tok(name)
            p.help(" using ")
            p.help(listed)
            p.help(":`")
            p.seal_diag()
        else if kind == 2 && w == W_USING:
            seen_use = true
            string8 lv = listed
            first_use = #append(first_use, ..lv)
            p.begin(201, p.st[at], p.en[at])
            p.say("a trait takes nothing on — it prescribes methods, and a `type` takes it on with `using`")
            p.help("a trait builds on another with `extends`: write `trait ")
            p.help_tok(name)
            p.help(" extends ")
            p.help(listed)
            p.help(":`")
            p.seal_diag()
        else if w == W_EXTENDS:
            seen_ext = true
            string8 lv = listed
            first_ext = #append(first_ext, ..lv)
            for i in names..<#len(p.scratch):
                ext = #append(ext, p.scratch[i])
        else:
            seen_use = true
            string8 lv = listed
            first_use = #append(first_use, ..lv)
            for i in names..<#len(p.scratch):
                use = #append(use, p.scratch[i])
        p.drop(names)
        #delete(listed)
    if r != BAD:
        for t in ext:
            p.push(t)
        for t in use:
            p.push(t)
    p.tail_ext = u32(#len(ext))
    #delete(ext)
    #delete(use)
    #delete(first_ext)
    #delete(first_use)
    return r

// The body after `type Name:`; methods are pushed after it is answered.
u32 type_body_with_methods(^Parser p):
    if p.at(LPAREN) && !tuple_return_ahead(p):
        u32 list = member_list_parenthesized(p, false)
        if list == BAD: return BAD
        method_block(p, true)
        return list
    if p.at(NEWLINE):
        return member_list(p, false, true)
    u32 t = type_expr(p)
    if t == BAD: return BAD
    _ = p.expect(NEWLINE)
    u32 alias = p.node(N_ALIAS, NONE, t, NONE, p.lo(t), p.hi(t))
    method_block(p, true)
    return alias

// Methods indented under a head line that wrote the shape; pushed when
// `keep`, else refused as misplaced.
void method_block(^Parser p, bool keep):
    if !p.at(INDENT): return
    _ = p.bump()
    for:
        p.skip_newlines()
        if p.at(DEDENT) || p.at(EOF): break
        if nested_declaration_refused(p) || listed_promise_refused(p): continue
        i64 b = p.base()
        u32 line = member_line_promised(p, false, keep)
        p.drop(b)
        if line == BAD:
            if !p.recover_to_stmt(): break
            continue
        if p.tag_of(line) == N_FN:
            if keep: p.push(line)
            else: method_misplaced(p, line)
            continue
        ref []char8 slot
        slot_text(p, line, &slot)
        p.begin(201, p.lo(line), p.hi(line))
        p.say("`")
        p.say(slot)
        p.say("` is a slot, and the block under a head line that wrote the shape holds methods only — the head's `( … )` or alias already said what the value is")
        p.help("put `")
        p.help(slot)
        p.help("` inside the head's `( … )`, or write the body as an indented list with every slot and method on a line of its own")
        p.seal_diag()
        #delete(slot)
        if p.at(COMMA): _ = p.bump()
        _ = p.expect(NEWLINE)
    if p.at(DEDENT): _ = p.bump()

private void slot_text(^Parser p, u32 m, ^ref []char8 out):
    []u32 k = p.ast.list(p.ast.b[m])
    unparse_type(p, k[0], out)
    if p.ast.main[m] != NONE:
        out^ = #append(out^, ' ')
        out^ = #append(out^, ..p.text(p.ast.main[m]))

u32 type_body(^Parser p, bool fgn):
    if p.at(LPAREN) && !tuple_return_ahead(p):
        u32 list = member_list_parenthesized(p, fgn)
        if list == BAD: return BAD
        misplaced_method_block(p)
        return list
    if p.at(NEWLINE): return member_list(p, fgn, false)
    u32 t = type_expr(p)
    if t == BAD: return BAD
    _ = p.expect(NEWLINE)
    u32 alias = p.node(N_ALIAS, NONE, t, NONE, p.lo(t), p.hi(t))
    misplaced_method_block(p)
    return alias

bool tuple_return_ahead(^Parser p):
    i64 depth = 0
    i64 ahead = 0
    for:
        u8 k = p.kind(ahead)
        if k == EOF: return false
        if opens(k):
            depth += 1
        else if closes(k):
            if depth <= 1:
                return depth == 1 && k == RPAREN && p.kind(ahead + 1) == LPAREN
            depth -= 1
        ahead += 1
    return false

void misplaced_method_block(^Parser p):
    method_block(p, false)

bool at_plain_method_line(^Parser p):
    return p.at(IDENT) && p.kind(1) == IDENT && p.kind(2) == LPAREN

u32 member_list_parenthesized(^Parser p, bool fgn):
    u32 list = member_list_inline(p, fgn)
    if list == BAD: return BAD
    _ = p.expect(NEWLINE)
    return list

u32 member_list_inline(^Parser p, bool fgn):
    u32 open = p.bump()
    i64 base = p.base()
    for !p.at(RPAREN) && !p.at(EOF):
        i64 keep = p.base()
        u32 line = member_line(p, fgn)
        p.drop(keep)
        if line == BAD:
            p.drop(base)
            return BAD
        if p.tag_of(line) == N_FN: method_misplaced(p, line)
        else: p.push(line)
        if p.at(COMMA): _ = p.bump()
        else: break
    u32 close = p.expect(RPAREN)
    if close == BAD:
        p.drop(base)
        return BAD
    return p.node(N_MEMBERS, open, 1, p.seal(base), p.st[open], p.en[close])

// An indented member list; with `methods`, the methods it holds are pushed
// after the list is answered.
u32 member_list(^Parser p, bool fgn, bool methods):
    if p.expect(NEWLINE) == BAD: return BAD
    if !p.at(INDENT):
        u32 t = p.peek()
        p.begin(202, p.st[t], p.en[t])
        p.say("expected an indented type body, found ")
        p.say_kind(p.tg[t])
        p.seal_diag()
        return BAD
    u32 open = p.bump()
    i64 base = p.base()
    ref []u32 fns
    for:
        p.skip_newlines()
        if p.at(DEDENT) || p.at(EOF): break
        if nested_declaration_refused(p) || listed_promise_refused(p): continue
        i64 keep = p.base()
        u32 line = member_line_promised(p, fgn, methods)
        p.drop(keep)
        if line == BAD:
            if !p.recover_to_stmt(): break
            continue
        if p.tag_of(line) == N_FN:
            if methods: fns = #append(fns, line)
            else: method_misplaced(p, line)
            continue
        p.push(line)
        if p.at(COMMA): _ = p.bump()
        _ = p.expect(NEWLINE)
    u32 close = p.peek()
    if p.at(DEDENT): _ = p.bump()
    u32 list = p.node(N_MEMBERS, open, 0, p.seal(base), join_lo(p.st[open], p.st[close]), join_hi(p.en[open], p.en[close]))
    for f in fns:
        p.push(f)
    #delete(fns)
    return list

u32 member_line_promised(^Parser p, bool fgn, bool methods):
    if !at_promise_word(p): return member_line(p, fgn)
    u32 w = p.bump()
    if p.expect(NEWLINE) == BAD: return BAD
    if at_promise_word(p):
        misplaced_method_promise(p, w, "another `#assert_raises`, and one promise is written once")
        return member_line_promised(p, fgn, methods)
    u32 line = member_line(p, fgn)
    if line == BAD: return BAD
    if p.tag_of(line) == N_FN:
        if methods:
            p.promised = #append(p.promised, w)
            p.promised = #append(p.promised, line)
    else:
        misplaced_method_promise(p, w, "a slot")
    return line

private bool at_promise_word(^Parser p):
    return p.at(HASH_NAME) && p.word(0) == H_ASSERT_RAISES && p.kind(1) == NEWLINE

bool listed_promise_refused(^Parser p):
    if !(p.at(HASH_NAME) && p.word(0) == H_ASSERT_RAISES && p.kind(1) == LPAREN): return false
    u32 at = p.peek()
    u32 lo = p.st[at]
    u32 hi = p.en[at]
    u32 a = assert_raises_item(p)
    if a != BAD:
        lo = p.lo(a)
        hi = p.hi(a)
    p.error_help(1228, lo, hi, "`#assert_raises( … )` is a package-level list, and a `type` body holds slots and methods: a method is promised on its own declaration", "write `#assert_raises` alone on the line directly above the method it promises")
    return true

private void misplaced_method_promise(^Parser p, u32 w, string8 what):
    p.begin(1228, p.st[w], p.en[w])
    p.say("`#assert_raises` alone in a `type` body promises the method on the line below it, and that is ")
    p.say(what)
    p.help("write it directly above the method it promises, or delete it")
    p.seal_diag()

// A slot (N_MEMBER) or a method (N_FN).
u32 member_line(^Parser p, bool fgn):
    if at_channel_head(p): return member(p, fgn)
    u32 start = p.peek()
    u32 vis = VIS_UNMARKED
    if visibility_word(p) != NONE: vis = visibility(p)
    u32 align = align_attr(p)
    if align == BAD: return BAD
    refuse_foreign_align(p, fgn, align)
    u32 ty = BAD
    u32 fl = NONE
    if at_anonymous_cunion(p):
        ty = anonymous_cunion(p, fgn)
    else:
        ty = type_expr_marked(p)
        fl = p.tm_lo
    if ty == BAD: return BAD
    u32 fh = p.tm_hi
    if p.at(IDENT) && p.kind(1) == LPAREN:
        u32 name = p.ident("a method name")
        if name == BAD: return BAD
        if align != NONE: p.error(1026, p.lo(align), p.hi(align), function_not_aligned())
        u32 mlo = p.lo(ty)
        if fl != NONE: mlo = join_lo(fl, mlo)
        return method_after(p, vis, mlo, ty, fl, name, false)
    if p.head_async != NONE:
        u32 m = p.head_async
        p.head_async = NONE
        async_misplaced(p, m)
    if fl != NONE: p.error(523, fl, fh, failure_stored())
    if vis != VIS_UNMARKED:
        p.begin(201, p.st[start], p.en[start])
        p.say("`")
        p.say(vis_spelling(vis))
        p.say("` is a visibility word, and a slot has none of its own: it is as visible as the declaration that holds it")
        p.help("drop the word from the slot, or write it on the declaration; a method in the body may carry one")
        p.seal_diag()
    return member_after(p, fgn, align, ty)

bool nested_declaration_refused(^Parser p):
    u8 k = p.kind(0)
    u32 w = p.word(0)
    bool declares = k == KW_TYPE || k == KW_ENUM || w == W_UNION || w == W_CUNION || w == W_TRAIT || w == W_CLASS
    if !(declares && p.kind(1) == IDENT && (p.kind(2) == COLON || p.kind(2) == LPAREN)): return false
    u32 t0 = p.peek()
    u32 t1 = u32(p.at_index(1))
    p.begin(201, p.st[t0], p.en[t1])
    p.say("`")
    p.say_tok(t0)
    p.say(" ")
    p.say_tok(t1)
    p.say("` is a declaration, and a type holds slots and methods, never a declaration: nesting ends at a type")
    p.help("declare `")
    p.help_tok(t1)
    p.help("` beside the type that would hold it — in the same class, or the same file — and name it in a slot")
    p.seal_diag()
    _ = p.recover_to_stmt()
    p.skip_indented_region()
    return true

void method_misplaced(^Parser p, u32 m):
    u32 n = p.ast.main[m]
    p.begin(533, p.st[n], p.en[n])
    p.say("`")
    p.say_tok(n)
    p.say("` is a method, and this declaration holds none: a method is written in a `type` body on a line of its own")
    p.help("in a `type`, write the slots in the head's `( … )` and each method indented under the head line; a `union`, `cunion`, `enum` or `foreign` declaration holds no methods, so declare a `type` over it and write the method there")
    p.seal_diag()

u32 member(^Parser p, bool fgn):
    if at_channel_head(p): return channel_member(p)
    u32 align = align_attr(p)
    if align == BAD: return BAD
    refuse_foreign_align(p, fgn, align)
    u32 ty = BAD
    if at_anonymous_cunion(p): ty = anonymous_cunion(p, fgn)
    else: ty = type_expr(p)
    if ty == BAD: return BAD
    return member_after(p, fgn, align, ty)

private void refuse_foreign_align(^Parser p, bool fgn, u32 align):
    if fgn && align != NONE:
        p.error_help(1026, p.lo(align), p.hi(align), "`@align(n)` on a member of a transparent `foreign` type, whose layout is the C header's", "declare the member without it; where the alignment matters, give the storage a Dado declaration of its own and put the attribute there")

u32 member_after(^Parser p, bool fgn, u32 align, u32 ty):
    u32 c = slot_c_name(p, fgn)
    if c == BAD: return BAD
    u32 name = NONE
    if p.at(IDENT):
        name = p.ident("a member name")
        if name == BAD: return BAD
    else:
        name = keyword_name(p, "a member's name", NEWLINE, EOF, COMMA, RPAREN)
    u32 width = bit_width(p, fgn)
    if width == BAD: return BAD
    u32 hi = p.hi(ty)
    if width != NONE: hi = p.hi(width)
    else if name != NONE: hi = p.en[name]
    u32 lo = p.lo(ty)
    if align != NONE: lo = p.lo(align)
    i64 base = p.base()
    p.push(ty)
    p.push(c)
    p.push(width)
    p.push(align)
    return p.node(N_MEMBER, name, NONE, p.seal(base), join_lo(lo, hi), join_hi(lo, hi))

bool at_anonymous_cunion(^Parser p):
    return p.at(IDENT) && p.word(0) == W_CUNION && p.kind(1) == LPAREN

u32 anonymous_cunion(^Parser p, bool fgn):
    u32 kw = p.bump()
    u32 body = member_list_inline(p, true)
    if body == BAD: return BAD
    u32 lo = p.st[kw]
    u32 hi = p.hi(body)
    if !fgn:
        p.error_help(1024, lo, hi, "`cunion (…)` is C11's anonymous union, which restates a header and belongs in a transparent `foreign` type", "write `cunion <name>: (…)` and hold it as an ordinary member, or drop `cunion`")
    p.ast.tag[body] = T_TUPLE
    p.ast.a[body] = 1
    p.ast.lo[body] = lo
    return body

u32 bit_width(^Parser p, bool fgn):
    if !p.at(COLON): return NONE
    u32 open = p.bump()
    u32 v = expr(p)
    if v == BAD: return BAD
    u32 lo = p.st[open]
    u32 hi = join_hi(p.en[open], p.hi(v))
    if !fgn:
        p.error_help(1023, lo, hi, "`: W` gives a member the width in bits C lays it out in, and only a member list restating C inside a `foreign` block carries one", "drop the `: W`, or restate the C declaration inside a `foreign` block")
    return p.node(N_WIDTH, open, v, NONE, lo, hi)

// -- signatures ----------------------------------------------------------

u32 fn_decl_after(^Parser p, u32 vis, u32 lo, u32 ret, u32 fl, u32 name, u32 symbol):
    u32 flags = vis
    if p.head_async != NONE: flags = flags | F_ASYNC
    if fl != NONE: flags = flags | F_FAILABLE
    p.head_async = NONE
    u32 failure = p.head_failure
    p.head_failure = NONE
    i64 base = p.base()
    p.push(ret)
    p.push(failure)
    p.push(symbol)
    p.push(NONE)
    p.push(NONE)
    p.push(NONE)
    if signature(p, base, p.receivers) == BAD || p.expect(COLON) == BAD:
        p.drop(base)
        return BAD
    u32 body = block(p)
    if body == BAD:
        p.drop(base)
        return BAD
    p.scratch[base + 5] = body
    return p.node(N_FN, name, flags, p.seal(base), join_lo(lo, p.lo(body)), join_hi(lo, p.hi(body)))

// `(receiver?, params...) where?`: the receiver and constraint go in the
// slots at `base + 3` and `base + 4`, the params are pushed.
u32 signature(^Parser p, i64 base, bool method):
    if p.expect(LPAREN) == BAD: return BAD
    u32 r = NONE
    if method: r = receiver(p)
    p.scratch[base + 3] = r
    bool more = false
    if r != NONE:
        if p.at(COMMA):
            _ = p.bump()
            more = true
    else:
        more = !p.at(RPAREN)
    if more:
        for:
            u32 q = param(p, true)
            if q == BAD: return BAD
            p.push(q)
            if p.at(COMMA): _ = p.bump()
            else: break
    if p.expect(RPAREN) == BAD: return BAD
    u32 c = where_clause(p)
    if c == BAD: return BAD
    p.scratch[base + 4] = c
    return 0

u32 where_clause(^Parser p):
    if p.at(IDENT) && p.word(0) == W_WHERE:
        _ = p.bump()
        return expr(p)
    return NONE

private bool self_word(^Parser p, i64 n):
    return p.kind(n) == IDENT && p.word(n) == W_SELF && (p.kind(n + 1) == COMMA || p.kind(n + 1) == RPAREN)

u32 receiver(^Parser p):
    bool pointer = false
    if self_word(p, 0):
        pointer = false
    else if p.at(CARET) && self_word(p, 1):
        pointer = true
    else:
        return NONE
    u32 first = p.bump()
    u32 last = first
    if pointer: last = p.bump()
    return p.node(N_RECEIVER, last, 1 if pointer else 0, NONE, p.st[first], p.en[last])

// A method's signature and body; a trait's may be bodiless (F_REQUIRED).
u32 method_after(^Parser p, u32 vis, u32 lo, u32 ret, u32 fl, u32 name, bool in_trait):
    u32 flags = vis
    if p.head_async != NONE: flags = flags | F_ASYNC
    if fl != NONE: flags = flags | F_FAILABLE
    p.head_async = NONE
    u32 failure = p.head_failure
    p.head_failure = NONE
    i64 base = p.base()
    p.push(ret)
    p.push(failure)
    p.push(NONE)
    p.push(NONE)
    p.push(NONE)
    p.push(NONE)
    if signature(p, base, true) == BAD:
        p.drop(base)
        return BAD
    u32 c = p.scratch[base + 4]
    u32 header_end = p.previous_end()
    if c != NONE: header_end = p.hi(c)
    u32 body = NONE
    if p.at(COLON):
        _ = p.bump()
        body = block(p)
        if body == BAD:
            p.drop(base)
            return BAD
        p.scratch[base + 5] = body
        return p.node(N_FN, name, flags, p.seal(base), join_lo(lo, p.lo(body)), join_hi(lo, p.hi(body)))
    if in_trait && (p.at(NEWLINE) || p.at(COMMA)):
        if p.at(COMMA): _ = p.bump()
        if p.expect(NEWLINE) == BAD:
            p.drop(base)
            return BAD
        p.scratch[base + 5] = p.node(S_BLOCK, NONE, 0, p.seal(p.base()), header_end, header_end)
        return p.node(N_FN, name, flags | F_REQUIRED, p.seal(base), join_lo(lo, header_end), join_hi(lo, header_end))
    if !in_trait && p.at(NEWLINE):
        p.begin(201, p.st[name], p.en[name])
        p.say("`")
        p.say_tok(name)
        p.say("` is a method of a `type`, and a method in a `type` is written whole — a signature with no body prescribes a method, which is what a `trait` does")
        p.help("end the signature with `:` and write the body under it; a signature alone belongs in a `trait` the type takes on with `using`")
        p.seal_diag()
        p.drop(base)
        return BAD
    _ = p.expect(COLON)
    p.drop(base)
    return BAD

u32 param(^Parser p, bool defaults):
    bool variadic = p.at(DOTDOT)
    if variadic:
        u32 dots = p.bump()
        if p.at(DOT):
            u32 d = p.bump()
            p.error(1009, p.st[dots], p.en[d], "`...` is C's calling convention, and a function Dado compiles has neither its type information nor its machinery\x1fIt carries no type information and the tail is read with C's own machinery; `...` belongs in a `foreign` signature, where C is what reads it\x1ewrite `..T name` for a pack the body reads as a `[]T`")
            return BAD
    u8 k2 = p.kind(2)
    if variadic && p.at(HASH_NAME) && p.kind(1) == IDENT && (k2 == COMMA || k2 == RPAREN || k2 == ASSIGN):
        u32 m = p.bump()
        u32 ty = p.leaf(T_PACK, m)
        u32 name = p.ident("a parameter name")
        if name == BAD: return BAD
        u32 d = param_default(p, defaults)
        if d == BAD: return BAD
        u32 hi = p.en[name]
        if d != NONE: hi = p.hi(d)
        return p.node(N_PARAM_V, name, ty, d, p.st[m], hi)
    u8 k1 = p.kind(1)
    bool alone = k1 == COMMA || k1 == RPAREN || k1 == ASSIGN
    if variadic && p.at(IDENT) && alone:
        u32 t = p.peek()
        p.begin(206, p.st[t], p.en[t])
        p.say("`..` writes the type of one **element**, and the grouping shorthand takes the type of the parameter before it — which for a pack would mean *more of that*, and is not a rule the language has; write `")
        p.say_tok(t)
        p.say("`'s element type")
        p.seal_diag()
        return BAD
    if !variadic && p.at(IDENT) && alone:
        u32 name = p.ident("a parameter name")
        if name == BAD: return BAD
        u32 d = param_default(p, defaults)
        if d == BAD: return BAD
        u32 hi = p.en[name]
        if d != NONE: hi = join_hi(hi, p.hi(d))
        return p.node(N_PARAM, name, NONE, d, p.st[name], hi)
    u32 ty = type_expr(p)
    if ty == BAD: return BAD
    u32 name = keyword_name(p, "a parameter's name", COMMA, RPAREN, ASSIGN, 255)
    if name == NONE:
        name = p.ident("a parameter name")
        if name == BAD: return BAD
    u32 d = param_default(p, defaults)
    if d == BAD: return BAD
    u32 hi = p.en[name]
    if d != NONE: hi = p.hi(d)
    return p.node(N_PARAM_V if variadic else N_PARAM, name, ty, d, p.lo(ty), join_hi(p.lo(ty), hi))

u32 param_default(^Parser p, bool allowed):
    if !p.at(ASSIGN): return NONE
    u32 eq = p.bump()
    u32 v = expr(p)
    if v == BAD: return BAD
    if !allowed:
        p.error(201, p.st[eq], join_hi(p.en[eq], p.hi(v)), "a `foreign` declaration restates what C provides, and a default argument is Dado-side call sugar with nothing on the other side to restate")
        return NONE
    return v
