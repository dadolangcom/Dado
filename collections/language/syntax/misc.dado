// The named refusals for a misplaced `try` and a misread conversion,
// classes and script headers, and the type unparser messages quote.
package syntax

bool at_misplaced_try(^Parser p):
    return p.at(IDENT) && p.word(0) == W_TRY && (p.kind(1) == IDENT || p.kind(1) == HASH_NAME)

private string8 span_text(^Parser p, u32 lo, u32 hi):
    return p.src[i64(lo)..<i64(hi)]

// The start of the logical line holding token `at`.
private i64 line_start(^Parser p, i64 at):
    i64 f = at
    for f > 0:
        u8 k = p.tg[f - 1]
        if k == NEWLINE || k == INDENT || k == DEDENT: break
        f -= 1
    return f

// The text of the line before byte `at`, from its first non-blank.
private string8 line_text_before(^Parser p, u32 at):
    i64 b = i64(at)
    i64 a = b
    for a > 0 && p.src[a - 1] != '\n':
        a -= 1
    for a < b && (p.src[a] == ' ' || p.src[a] == '\t'):
        a += 1
    return p.src[a..<b]

// `head = ` before a `try` written after `=`, or "".
private string8 line_head_before(^Parser p, u32 at, ^ref []char8 out):
    string8 head = line_text_before(p, at)
    i64 e = #len(head)
    for e > 0 && (head[e - 1] == ' ' || head[e - 1] == '\t' || head[e - 1] == '\r'):
        e -= 1
    if e == 0 || head[e - 1] != '=': return ""
    string8 target = head[0..<e - 1]
    if #len(target) > 0:
        char8 c = target[#len(target) - 1]
        if c == '=' || c == '!' || c == '<' || c == '>': return ""
    i64 t = #len(target)
    for t > 0 && (target[t - 1] == ' ' || target[t - 1] == '\t'):
        t -= 1
    out^ = #append(out^, ..target[0..<t])
    out^ = #append(out^, ..string8(" = "))
    return "ok"

u32 misplaced_try(^Parser p):
    i64 kw_at = p.pos
    u8 before = EOF
    bool has_before = p.pos > 0
    if has_before: before = p.tg[p.pos - 1]
    u32 kw = p.bump()
    Mark m = p.mark()
    u32 operand = prefix(p)
    if operand == BAD: p.unsay(m)
    bool whole = operand != BAD && (p.at(NEWLINE) || p.at(EOF))
    // the rest of the line after an `else`
    u32 tail_lo = NONE
    u32 tail_hi = NONE
    if operand != BAD && p.at(KW_ELSE):
        tail_lo = p.st[p.peek()]
        for i in p.pos..<p.last + 1:
            u8 k = p.tg[i]
            if k == NEWLINE || k == EOF || k == DEDENT || k == INDENT: break
            tail_hi = p.en[i]
    ref []char8 call
    ref []char8 callee
    if operand != BAD:
        call = #append(call, ..span_text(p, p.lo(operand), p.hi(operand)))
        if p.tag_of(operand) == E_CALL:
            u32 c = p.ast.extra[p.ast.b[operand] + 1]
            callee = #append(callee, ..span_text(p, p.lo(c), p.hi(c)))
    else:
        call = #append(call, ..string8("…"))
    bool is_call = operand != BAD && p.tag_of(operand) == E_CALL
    bool in_return = p.tg[line_start(p, kw_at)] == KW_RETURN
    ref []char8 head
    string8 hh = line_head_before(p, p.st[kw], &head)
    bool has_head = #len(hh) > 0
    bool moved = !in_return && whole && has_head && has_before && before == ASSIGN
    bool kept = (in_return || moved) && operand != BAD
    u32 lo = p.st[kw]
    u32 hi = p.en[kw]
    if operand != BAD: hi = join_hi(hi, p.hi(operand))
    if !kept: p.rewind(m)
    bool at_return = whole && has_before && before == KW_RETURN
    bool after_assign = (whole || tail_lo != NONE) && has_before && before == ASSIGN
    p.begin(716, lo, hi)
    if at_return:
        p.say("`try` is a statement, not an operator: it stands at the start of a line, so `return try ")
        p.say(call)
        p.say("` never makes the call. A failable function passes a failure on whole by returning the call")
        p.help("write `return ")
        p.help(call)
        p.help("` — or, to use the value first, `try T v = ")
        p.help(call)
        p.help("`, then `return v`")
    else if after_assign && has_head:
        p.say("`try` is a statement, not an operator: it goes at the start of the line, in front of the declaration or assignment it makes, not after the `=`")
        bool hashed = #len(callee) > 0 && callee[0] == '#'
        if tail_lo != NONE && (!is_call || hashed):
            p.help("write `try ")
            p.help(head)
            p.help(call)
            p.help(" ")
            p.help(span_text(p, tail_lo, tail_hi))
            p.help("`")
        else if tail_lo != NONE:
            string8 tail = span_text(p, tail_lo, tail_hi)
            string8 value = trim(tail[4..<#len(tail)])
            ref []char8 what
            if #len(callee) > 0:
                what = #append(what, '`')
                string8 cv = callee
                what = #append(what, ..cv)
                what = #append(what, '`')
            else:
                what = #append(what, ..string8("the call"))
            i64 assign = kw_at - 1
            i64 first = line_start(p, assign)
            bool declared = assign - first >= 2 && p.tg[assign - 1] == IDENT && p.tg[assign - 2] != DOT
            if declared:
                u32 name = u32(assign - 1)
                string8 ty = span_text(p, p.st[first], p.en[assign - 2])
                p.help("for `")
                p.help_tok(name)
                p.help("` to be ")
                p.help(value)
                p.help(" when ")
                p.help(what)
                p.help(" fails, write `")
                p.help(ty)
                p.help(" ")
                p.help_tok(name)
                p.help(" = ")
                p.help(value)
                p.help("` and then `try ")
                p.help_tok(name)
                p.help(" = ")
                p.help(call)
                p.help(" else:` over a `pass`; `try ")
                p.help(head)
                p.help(call)
                p.help("` passes the failure on")
            else:
                string8 target = head
                i64 e = #len(target)
                for e > 0 && (target[e - 1] == ' ' || target[e - 1] == '='):
                    e -= 1
                target = target[0..<e]
                p.help("for `")
                p.help(target)
                p.help("` to be ")
                p.help(value)
                p.help(" when ")
                p.help(what)
                p.help(" fails, write `try ")
                p.help(target)
                p.help(" = ")
                p.help(call)
                p.help(" else:` and `")
                p.help(target)
                p.help(" = ")
                p.help(value)
                p.help("` on the line below; `try ")
                p.help(head)
                p.help(call)
                p.help("` passes the failure on")
            #delete(what)
        else:
            p.help("write `try ")
            p.help(head)
            p.help(call)
            p.help("`")
    else:
        p.say("`try` is a statement, not an operator: it stands at the start of a line over one failable call, so ")
        if #len(callee) > 0:
            p.say("`")
            p.say(callee)
            p.say("`")
        else:
            p.say("the call")
        p.say(" cannot be tried inside an expression. Bind the call first, then use the name")
        p.help("write `try T v = ")
        p.help(call)
        p.help("` on the line before, and `v` here")
    #delete(call)
    #delete(callee)
    #delete(head)
    if kept:
        if moved: p.moved_try = lo
        return operand
    for !(p.at(NEWLINE) || p.at(EOF) || p.at(DEDENT)):
        _ = p.bump()
    return BAD

bool misplaced_try_since(^Parser p, i64 before):
    for i in before..<p.ndiags():
        if p.ast.diags[i].code == 716: return true
    return false

u32 tried_as_meant(^Parser p, u32 s, i64 before):
    u32 at = p.moved_try
    if at == NONE: return s
    p.moved_try = NONE
    bool reported = false
    for i in before..<p.ndiags():
        if p.ast.diags[i].code == 716 && p.ast.diags[i].start == at: reported = true
    if !reported: return s
    return p.node(S_TRY, NONE, s, NONE, p.lo(s), p.hi(s))

bool recover_statement(^Parser p, i64 before):
    if !misplaced_try_since(p, before): return p.recover_to_stmt()
    if !p.recover_to_stmt(): return false
    skip_opened_suite(p)
    for p.at(KW_ELSE):
        if !p.recover_to_stmt(): return false
        skip_opened_suite(p)
    return true

private void skip_opened_suite(^Parser p):
    bool opened = p.pos >= 2 && p.tg[p.pos - 2] == COLON
    if opened && p.at(INDENT): p.skip_indented_region()

// -- misread conversions -----------------------------------------------------

private bool misread_conversion_ahead(^Parser p):
    i64 n = 0
    i64 brackets = 0
    for:
        u8 k = p.kind(n)
        if k == CARET:
            n += 1
            continue
        if k != LBRACKET: break
        i64 depth = 0
        for:
            u8 inner = p.kind(n)
            if inner == LBRACKET:
                depth += 1
            else if inner == RBRACKET:
                depth -= 1
                if depth == 0: break
            else if inner == NEWLINE || inner == EOF:
                return false
            n += 1
        n += 1
        brackets += 1
    if brackets == 0 || !(p.kind(n) == IDENT || p.kind(n) == HASH_NAME): return false
    n += 1
    if p.kind(n) == DOT && p.kind(n + 1) == IDENT: n += 2
    return p.kind(n) == LPAREN

// A type, or a refused `[]f64(d)`; NONE when neither reads.
u32 type_or_misread_conversion(^Parser p):
    if !misread_conversion_ahead(p): return NONE
    Mark m = p.mark()
    u32 e = type_arg(p)
    if e != BAD: return e
    p.rewind(m)
    e = misread_prefix_conversion(p)
    if e != BAD: return e
    p.rewind(m)
    return NONE

private u32 misread_prefix_conversion(^Parser p):
    bool outer = p.bare_type
    p.bare_type = true
    u32 target = type_expr(p)
    p.bare_type = outer
    if target == BAD: return BAD
    if p.expect(LPAREN) == BAD: return BAD
    i64 base = p.base()
    u32 callee = p.node(E_TYPE, NONE, target, NONE, p.lo(target), p.hi(target))
    p.push(callee)
    p.push(NONE)
    if arg_list(p) == BAD:
        p.drop(base)
        return BAD
    u32 close = p.expect(RPAREN)
    if close == BAD:
        p.drop(base)
        return BAD
    u32 lo = p.lo(target)
    u32 hi = p.en[close]
    string8 written = span_text(p, p.lo(target), p.hi(target))
    string8 within = ""
    if p.base() > base + 2:
        within = span_text(p, p.lo(p.scratch[base + 2]), p.hi(p.scratch[p.base() - 1]))
    i64 carets = 0
    for carets < #len(written) && written[carets] == '^':
        carets += 1
    string8 named = written[carets..<#len(written)]
    p.begin(201, lo, hi)
    p.say("`")
    p.say(written)
    p.say("(")
    p.say(within)
    p.say(")` reads as a function type, not a conversion")
    p.help("name the type, then convert through the name: `type ")
    suggest(p, named)
    p.help(" = ")
    p.help(named)
    p.help("` in this function (or `type ")
    suggest(p, named)
    p.help(": ")
    p.help(named)
    p.help("` beside it), then `")
    p.help(written[0..<carets])
    suggest(p, named)
    p.help("(")
    bool fixed = #len(named) > 1 && named[0] == '[' && named[1] != ']'
    if top_level_comma(within) && !fixed:
        p.help("(")
        p.help(within)
        p.help(")")
    else:
        p.help(within)
    p.help(")`")
    return p.node(E_CALL, NONE, NONE, p.seal(base), lo, hi)

private bool top_level_comma(string8 s):
    i64 depth = 0
    char8 quote = char8(0)
    bool escaped = false
    for c in s:
        if quote != char8(0):
            if escaped: escaped = false
            else if c == '\\': escaped = true
            else if c == quote: quote = char8(0)
            continue
        if c == '"' || c == '\'': quote = c
        else if c == '(' || c == '[' || c == '{': depth += 1
        else if c == ')' || c == ']' || c == '}': depth -= 1
        else if c == ',' && depth == 0: return true
    return false

private bool word_like(string8 s):
    if #len(s) == 0: return false
    for c in s:
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'): return false
    return true

private void capital(^ref []char8 out, string8 w):
    if #len(w) == 0: return
    char8 c = w[0]
    if c >= 'a' && c <= 'z': c = char8(u8(c) - 32)
    out^ = #append(out^, c)
    out^ = #append(out^, ..w[1..<#len(w)])

private void suggest(^Parser p, string8 named):
    ref []char8 out
    suggested_name(named, &out)
    p.help(out)
    #delete(out)

// A name for written type `named`, for the misread conversion's repair.
void suggested_name(string8 named, ^ref []char8 out):
    if #len(named) > 2 && named[0..<2] == "[]" && word_like(named[2..<#len(named)]):
        capital(out, named[2..<#len(named)])
        out^ = #append(out^, 's')
        return
    if #len(named) > 0 && named[0] == '[':
        i64 c = 1
        for c < #len(named) && named[c] != ']':
            c += 1
        if c < #len(named):
            string8 len = named[1..<c]
            string8 el = named[c + 1..<#len(named)]
            bool digits = #len(len) > 0
            for d in len:
                if d < '0' || d > '9': digits = false
            if word_like(el) && digits:
                capital(out, el)
                out^ = #append(out^, 'x')
                out^ = #append(out^, ..len)
                return
    out^ = #append(out^, ..string8("Target"))

// -- classes and script headers ----------------------------------------------

// `class Name extends A using B`: pushes [extends, using...]; answers the
// name token.
private u32 class_head(^Parser p):
    u32 kw = p.bump()
    p.note_dados(p.st[kw])
    u32 name = p.ident("a class name")
    if name == BAD: return BAD
    bool outer = p.class_head
    p.class_head = true
    i64 base = p.base()
    p.push(NONE)
    u32 r = decl_tail(p, 3, name)
    p.class_head = outer
    if r == BAD:
        p.drop(base)
        return BAD
    i64 ext = i64(p.tail_ext)
    if ext >= 2:
        u32 second = p.scratch[base + 2]
        ref []char8 listed
        for i in base + 2..<base + 1 + ext:
            if i > base + 2: listed = #append(listed, ..", ")
            unparse_type(p, p.scratch[i], &listed)
        ref []char8 parent
        unparse_type(p, p.scratch[base + 1], &parent)
        p.begin(201, p.lo(second), p.hi(second))
        p.say("a class extends one class — inheritance is single — so `")
        p.say(listed)
        p.say("` cannot be parents of `")
        p.say_tok(name)
        p.say("` beside `")
        p.say(parent)
        p.say("`")
        p.help("keep `extends ")
        p.help(parent)
        p.help("`, and take behaviour the others share on as traits: `using ")
        p.help(listed)
        p.help("`")
        p.seal_diag()
        #delete(listed)
        #delete(parent)
    if ext >= 1:
        p.scratch[base] = p.scratch[base + 1]
        for i in base + 1 + ext..<p.base():
            p.scratch[i - ext] = p.scratch[i]
        p.drop(p.base() - ext)
    return name

u32 script_header(^Parser p):
    u32 vis = VIS_UNMARKED
    u32 lo = p.st[p.peek()]
    if at_exported_script_header(p):
        _ = take_visibility_word(p, W_EXPORT)
        vis = VIS_EXPORT
    u32 kw = p.peek()
    if vis == VIS_UNMARKED: lo = p.st[kw]
    i64 base = p.base()
    u32 name = class_head(p)
    if name == BAD:
        p.drop(base)
        return BAD
    u32 hi = p.en[name]
    if p.base() > base + 1: hi = p.hi(p.scratch[p.base() - 1])
    else if p.scratch[base] != NONE: hi = p.hi(p.scratch[base])
    _ = p.expect(NEWLINE)
    return p.node(N_SCRIPT, name, vis, p.seal(base), lo, join_hi(lo, hi))

u32 class_decl(^Parser p, u32 vis):
    bool header = at_script_header(p)
    u32 kw = p.peek()
    i64 base = p.base()
    u32 name = class_head(p)
    if name == BAD:
        p.drop(base)
        return BAD
    u32 lo = p.st[kw]
    if header:
        p.begin(201, lo, join_hi(lo, p.previous_end()))
        p.say("`class ")
        p.say_tok(name)
        p.say("` with no `:` is a script's header, and a header is its file's first line")
        p.help("move the line to the top of the file to make the file the class, or end it with `:` and indent the members under it to declare a class block: `class ")
        p.help_tok(name)
        p.help(":`")
        p.seal_diag()
        p.drop(base)
        return BAD
    if p.expect(COLON) == BAD:
        p.drop(base)
        return BAD
    u32 head_end = p.previous_end()
    if p.at(NEWLINE): _ = p.bump()
    if !p.at(INDENT):
        u32 t = p.peek()
        p.begin(202, p.st[t], p.en[t])
        p.say("a class's body is its members, indented under its head; found ")
        p.say_kind(p.tg[t])
        p.help("write each field and method on a line of its own under `class ")
        p.help_tok(name)
        p.help(":` — `int hp = 3`, `void hit(self, int n):`")
        p.seal_diag()
        return p.node(N_CLASS, name, vis, p.seal(base), lo, join_hi(lo, head_end))
    _ = p.bump()
    bool outer = p.receivers
    p.receivers = true
    u32 end = head_end
    for:
        p.skip_newlines()
        if p.at(DEDENT) || p.at(EOF): break
        i64 keep = p.base()
        u32 it = item(p)
        p.drop(keep)
        if it != BAD:
            p.push(it)
            end = p.hi(it)
            u32 more = take_pending_item(p)
            if more != NONE:
                p.push(more)
                end = p.hi(more)
        else if !p.recover_to_stmt():
            break
    p.receivers = outer
    if p.at(DEDENT): _ = p.bump()
    return p.node(N_CLASS, name, vis, p.seal(base), lo, join_hi(lo, end))

// -- the type unparser -------------------------------------------------------

// dado_parse's unparse_type, an expression written as its source text.
void unparse_type(^Parser p, u32 t, ^ref []char8 out):
    u8 g = p.tag_of(t)
    switch g:
        case T_NAME:
            out^ = #append(out^, ..p.text(p.ast.main[t]))
        case T_REF:
            out^ = #append(out^, ..string8("ref "))
            unparse_type(p, p.ast.a[t], out)
        case T_BOUND:
            out^ = #append(out^, ..p.text(p.ast.main[t]))
            out^ = #append(out^, ..string8(" $"))
            out^ = #append(out^, ..p.text(p.ast.a[t]))
        case T_KIND:
            out^ = #append(out^, ..string8("type"))
        case T_PACK:
            out^ = #append(out^, ..p.text(p.ast.main[t]))
        case T_LAYOUT, T_QUAL:
            out^ = #append(out^, ..p.text(p.ast.main[t]))
            out^ = #append(out^, ' ')
            unparse_type(p, p.ast.a[t], out)
        case T_BINDING:
            out^ = #append(out^, '$')
            out^ = #append(out^, ..p.text(p.ast.main[t]))
        case T_PATH:
            out^ = #append(out^, ..p.text(p.ast.a[t]))
            out^ = #append(out^, '.')
            out^ = #append(out^, ..p.text(p.ast.main[t]))
            if p.ast.b[t] != NONE:
                out^ = #append(out^, '.')
                out^ = #append(out^, ..p.text(p.ast.b[t]))
        case T_POINTER:
            out^ = #append(out^, '^')
            unparse_type(p, p.ast.a[t], out)
        case T_SLICE:
            out^ = #append(out^, ..string8("[]"))
            unparse_type(p, p.ast.a[t], out)
        case T_ARRAY:
            out^ = #append(out^, '[')
            if p.ast.main[t] != NONE: out^ = #append(out^, '$')
            u32 l = p.ast.a[t]
            out^ = #append(out^, ..span_text(p, p.lo(l), p.hi(l)))
            out^ = #append(out^, ']')
            unparse_type(p, p.ast.b[t], out)
        else:
            out^ = #append(out^, ..span_text(p, p.lo(t), p.hi(t)))
