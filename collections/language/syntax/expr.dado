// Expressions: Pratt, lambdas, and the named
// refusals for a misplaced `try` and a misread conversion.
package syntax

private const u8 BP_COND = 5
private const u8 BP_RANGE = 10
private const u8 BP_COMPARE = 40

u8 binary_power(u8 k):
    switch k:
        case PIPE_PIPE: return 20
        case AMP_AMP: return 30
        case EQ_EQ, BANG_EQ, LT, LT_EQ, GT, GT_EQ: return 40
        case PLUS_PLUS: return 45
        case PIPE: return 50
        case TILDE: return 55
        case AMP, AMP_TILDE: return 60
        case SHL, SHR: return 70
        case PLUS, MINUS: return 80
        case STAR, SLASH, PERCENT: return 90
        else: return 0
    return 0

bool is_range(u8 k):
    return k == DOTDOT || k == DOTDOT_LESS || k == DOTDOT_EQ

bool is_assign(u8 k):
    return k >= ASSIGN && k <= SHR_EQ

u32 expr(^Parser p):
    return expr_bp(p, 0)

u32 expr_bp(^Parser p, u8 min):
    if p.too_deep(): return BAD
    p.depth += 1
    u32 e = expr_bp_inner(p, min)
    p.depth -= 1
    return e

private u32 expr_bp_inner(^Parser p, u8 min):
    u32 lhs = prefix(p)
    if lhs == BAD: return BAD
    u32 folds = 0
    for:
        if p.block_ended: break
        u8 k = p.kind(0)
        if k == KW_IF:
            if BP_COND < min: break
            folds += 1
            if p.tree_too_deep(folds): return BAD
            lhs = conditional_tail(p, lhs)
            if lhs == BAD: return BAD
            continue
        if is_range(k):
            if BP_RANGE < min: break
            folds += 1
            if p.tree_too_deep(folds): return BAD
            u32 op = p.bump()
            u32 rhs = expr_bp(p, BP_RANGE + 1)
            if rhs == BAD: return BAD
            lhs = p.node(E_RANGE, op, lhs, rhs, join_lo(p.lo(lhs), p.lo(rhs)), join_hi(p.hi(lhs), p.hi(rhs)))
            continue
        if k == KW_IN:
            if BP_COMPARE < min: break
            folds += 1
            if p.tree_too_deep(folds): return BAD
            u32 op = p.bump()
            u32 rhs = expr_bp(p, BP_COMPARE + 1)
            if rhs == BAD: return BAD
            lhs = p.node(E_IN, op, lhs, rhs, join_lo(p.lo(lhs), p.lo(rhs)), join_hi(p.hi(lhs), p.hi(rhs)))
            continue
        if at_is(p):
            if BP_COMPARE < min: break
            folds += 1
            if p.tree_too_deep(folds): return BAD
            u32 op = p.bump()
            u32 ty = is_operand(p)
            if ty == BAD: return BAD
            lhs = p.node(E_IS, op, lhs, ty, join_lo(p.lo(lhs), p.lo(ty)), join_hi(p.hi(lhs), p.hi(ty)))
            continue
        if at_has(p):
            if BP_COMPARE < min: break
            folds += 1
            if p.tree_too_deep(folds): return BAD
            u32 op = p.bump()
            i64 base = p.base()
            p.push(lhs)
            u32 named = has_asked(p)
            if named == BAD:
                p.drop(base)
                return BAD
            u32 end = p.hi(lhs)
            if p.base() > base + 1: end = p.hi(p.scratch[p.base() - 1])
            u32 lo = p.lo(lhs)
            lhs = p.node(E_HAS, op, named, p.seal(base), lo, join_hi(lo, end))
            continue
        u8 power = binary_power(k)
        if power == 0 || power < min: break
        folds += 1
        if p.tree_too_deep(folds): return BAD
        u32 op = p.bump()
        u32 rhs = expr_bp(p, power + 1)
        if rhs == BAD: return BAD
        lhs = p.node(E_BINARY, op, lhs, rhs, join_lo(p.lo(lhs), p.lo(rhs)), join_hi(p.hi(lhs), p.hi(rhs)))
    return lhs

u32 conditional_tail(^Parser p, u32 then):
    _ = p.bump()
    u32 cond = expr_bp(p, BP_COND + 1)
    if cond == BAD: return BAD
    if !p.at(KW_ELSE):
        u32 f = p.peek()
        p.begin(201, p.st[f], p.en[f])
        p.say("a conditional value is `a if c else b` and needs its `else` on the same line, found ")
        p.say_kind(p.tg[f])
        p.say("\x1ewrite the value it takes when the condition is false — `… else b` — or, to run something only when it holds, write an `if` statement")
        p.seal_diag()
        return then
    _ = p.bump()
    u32 other = expr_bp(p, BP_COND)
    if other == BAD: return BAD
    i64 base = p.base()
    p.push(then)
    p.push(cond)
    p.push(other)
    return p.node(E_COND, NONE, NONE, p.seal(base), join_lo(p.lo(then), p.lo(other)), join_hi(p.hi(then), p.hi(other)))

bool at_is(^Parser p):
    if !p.at(IDENT) || p.word(0) != W_IS: return false
    u8 k = p.kind(1)
    return k == IDENT || k == HASH_NAME || k == DOLLAR || k == CARET || k == LBRACKET || k == LPAREN || k == LBRACE

bool at_has(^Parser p):
    return p.at(IDENT) && p.word(0) == W_HAS && (has_word_at(p, 1) > 0 || has_name_at(p, 1))

private bool ends_has_operand(u8 k):
    return k == COMMA || k == COLON || k == RPAREN || k == RBRACKET || k == RBRACE || k == AMP_AMP || k == PIPE_PIPE || k == NEWLINE || k == EOF

// The length of an operator spelling at `n` that a `has` asks about, or 0.
private i64 has_word_at(^Parser p, i64 n):
    u8 k = p.kind(n)
    i64 len = 0
    if k == LBRACKET:
        if p.kind(n + 1) != RBRACKET: return 0
        len = 2
    else if (k >= DOTDOT && k <= DOLLAR) || k == HASH_NAME:
        len = 1
    else:
        return 0
    return len if ends_has_operand(p.kind(n + len)) else 0

private bool has_name_at(^Parser p, i64 n):
    if p.kind(n) != IDENT: return false
    u8 after = p.kind(n + 1)
    if after == DOT: return p.kind(n + 2) == IDENT && ends_has_operand(p.kind(n + 3))
    return ends_has_operand(after)

// Pushes the words asked about (N_WORD), or the one name; 1 for a name.
private u32 has_asked(^Parser p):
    i64 first = has_word_at(p, 0)
    if first == 0:
        u32 e = expr_bp(p, BP_COMPARE + 1)
        if e == BAD: return BAD
        p.push(e)
        return 1
    p.push(has_word(p, first))
    for p.at(COMMA):
        i64 len = has_word_at(p, 1)
        if len == 0: break
        _ = p.bump()
        p.push(has_word(p, len))
    return 0

private u32 has_word(^Parser p, i64 len):
    u32 f = p.bump()
    u32 l = f
    for _ in 1..<len:
        l = p.bump()
    return p.node(N_WORD, f, l, NONE, p.st[f], p.en[l])

private u32 is_operand(^Parser p):
    if p.at(CARET) || p.at(DOLLAR): return type_arg(p)
    return expr_bp(p, BP_COMPARE + 1)

u32 prefix(^Parser p):
    if p.too_deep(): return BAD
    p.depth += 1
    u32 e = prefix_inner(p)
    p.depth -= 1
    return e

private u32 prefix_inner(^Parser p):
    u8 k = p.kind(0)
    if k == MINUS || k == BANG || k == TILDE || k == AMP:
        u32 op = p.bump()
        u32 operand = prefix(p)
        if operand == BAD: return BAD
        return p.node(E_UNARY, op, operand, NONE, p.st[op], join_hi(p.en[op], p.hi(operand)))
    if k == DOTDOT:
        u32 op = p.bump()
        u32 operand = prefix(p)
        if operand == BAD: return BAD
        return p.node(E_SPLAT, op, operand, NONE, p.st[op], join_hi(p.en[op], p.hi(operand)))
    u32 e = primary(p)
    if e == BAD: return BAD
    return postfix(p, e)

u32 primary(^Parser p):
    if p.too_deep(): return BAD
    p.depth += 1
    u32 e = primary_inner(p)
    p.depth -= 1
    return e

private u32 primary_inner(^Parser p):
    u32 t = p.peek()
    u8 k = p.tg[t]
    if k == IDENT || k == LBRACKET || k == LBRACE || k == CARET || k == KW_ASYNC:
        u32 l = lambda(p)
        if l != NONE: return l
    if k == KW_ASYNC:
        u32 at = p.bump()
        async_misplaced(p, at)
        return BAD
    if k == KW_AWAIT:
        u32 at = p.bump()
        p.error_help(201, p.st[at], p.en[at], "`await` heads a statement, as `try` does, so it cannot stand inside an expression", "await the call on a line of its own and use the name it binds: `await int v = load()`, then `v`")
        return BAD
    if k == KW_SUPER:
        _ = p.bump()
        p.note_dados(p.st[t])
        return p.leaf(E_NAME, t)
    if k == INT:
        _ = p.bump()
        (u64 v, bool ok) = int_literal(p.text(t))
        if !ok:
            p.begin(539, p.st[t], p.en[t])
            p.say("`")
            p.say_tok(t)
            p.say("` is larger than any Dado integer holds; the widest is `u64`, which holds 0 to 18446744073709551615")
            p.help("write a number from 0 to 18446744073709551615, or a float if an approximation will do")
            p.seal_diag()
            v = 0
        return p.node(E_INT, t, u32(v & 0xFFFFFFFF), u32(v >> 32), p.st[t], p.en[t])
    if k == FLOAT:
        return p.leaf(E_FLOAT, p.bump())
    if k == STRING:
        _ = p.bump()
        check_string(p, t)
        return p.leaf(E_STR, t)
    if k == CHAR:
        _ = p.bump()
        return p.node(E_CHAR, t, char_value(p.text(t)), NONE, p.st[t], p.en[t])
    if k == HASH_NAME:
        return p.leaf(E_NAME, p.bump())
    if at_misplaced_try(p): return misplaced_try(p)
    if k == IDENT:
        u32 w = p.word(0)
        if (w == W_TYPEOF || w == W_SHAPEOF) && p.kind(1) == LPAREN: return type_arg(p)
        return p.leaf(E_NAME, p.bump())
    if k == CARET:
        if caret_opens_a_conversion(p):
            Mark m = p.mark()
            u32 e = pointer_conversion(p)
            if e != BAD: return e
            p.rewind(m)
        u32 e = type_or_misread_conversion(p)
        if e != NONE: return e
        return type_arg(p)
    if k == LPAREN: return tuple_expr(p)
    if k == LBRACKET: return bracket_expr(p)
    if k == LBRACE: return map_expr(p)
    u32 kw = keyword_use(p)
    if kw != NONE: return kw
    p.begin(201, p.st[t], p.en[t])
    p.say("expected an expression, found ")
    p.say_kind(k)
    p.seal_diag()
    return BAD

private u32 tuple_expr(^Parser p):
    if tuple_may_name_its_slots(p):
        Mark m = p.mark()
        u32 e = type_arg(p)
        if e != BAD:
            if names_a_slot(p, p.ast.a[e]): return e
        else:
            p.unsay(m)
        p.rewind(m)
    u32 open = p.bump()
    i64 base = p.base()
    bool comma = false
    for !p.at(RPAREN) && !p.at(EOF):
        u32 e = expr(p)
        if e == BAD:
            p.drop(base)
            return BAD
        p.push(e)
        if p.at(COMMA):
            _ = p.bump()
            comma = true
        else:
            break
    u32 close = p.expect(RPAREN)
    if close == BAD:
        p.drop(base)
        return BAD
    if p.base() == base + 1 && !comma:
        u32 e = p.scratch[base]
        p.drop(base)
        return e
    return p.node(E_TUPLE, open, NONE, p.seal(base), p.st[open], p.en[close])

// Whether a tuple type names a slot (a declaration that binds its slots).
bool names_a_slot(^Parser p, u32 ty):
    if p.tag_of(ty) != T_TUPLE: return false
    for m in p.ast.list(p.ast.b[ty]):
        if p.ast.main[m] != NONE: return true
    return false

private bool tuple_may_name_its_slots(^Parser p):
    i64 depth = 0
    i64 i = p.pos
    for i <= p.last:
        u8 k = p.tg[i]
        if opens(k):
            depth += 1
        else if closes(k):
            depth -= 1
            if depth == 0: return false
        else if k == NEWLINE || k == EOF:
            return false
        else if k == IDENT && i + 1 <= p.last && p.tg[i + 1] == IDENT:
            return true
        i += 1
    return false

private u32 bracket_expr(^Parser p):
    u8 k2 = p.kind(2)
    if p.kind(1) == RBRACKET && (k2 == NEWLINE || k2 == EOF || k2 == DEDENT || k2 == RPAREN || k2 == RBRACKET || k2 == RBRACE || k2 == COMMA):
        return array_expr(p)
    u32 e = type_or_misread_conversion(p)
    if e != NONE: return e
    if p.kind(1) == RBRACKET: return type_arg(p)
    Mark m = p.mark()
    e = type_arg(p)
    if e != BAD: return e
    p.rewind(m)
    return array_expr(p)

private bool caret_opens_a_conversion(^Parser p):
    u32 w = p.word(1)
    if p.kind(1) == IDENT && p.kind(2) == LPAREN:
        if w != W_REF && w != W_TYPEOF && w != W_SHAPEOF: return true
        i64 depth = 0
        i64 n = 2
        for:
            u8 k = p.kind(n)
            if k == LPAREN:
                depth += 1
            else if k == RPAREN:
                depth -= 1
                if depth == 0: return p.kind(n + 1) == LPAREN
            else if k == NEWLINE || k == EOF:
                return false
            n += 1
    u8 k1 = p.kind(1)
    return (k1 == IDENT || k1 == HASH_NAME) && p.kind(2) == DOT && p.kind(3) == IDENT && p.kind(4) == LPAREN

// `^T(x)`, quietly: BAD (diagnostics dropped) when it is not one.
private u32 pointer_conversion(^Parser p):
    Mark m = p.mark()
    u32 c = p.bump()
    u32 pointee = type_core(p)
    if pointee == BAD:
        p.unsay(m)
        return BAD
    u32 lo = p.st[c]
    u32 hi = join_hi(p.en[c], p.hi(pointee))
    u32 ptr = p.node(T_POINTER, c, pointee, NONE, lo, hi)
    u32 callee = p.node(E_TYPE, NONE, ptr, NONE, lo, hi)
    if p.expect(LPAREN) == BAD:
        p.unsay(m)
        return BAD
    i64 base = p.base()
    p.push(callee)
    p.push(NONE)
    if arg_list(p) == BAD:
        p.drop(base)
        p.unsay(m)
        return BAD
    u32 close = p.expect(RPAREN)
    if close == BAD:
        p.drop(base)
        p.unsay(m)
        return BAD
    return p.node(E_CALL, NONE, NONE, p.seal(base), lo, p.en[close])

u32 type_arg(^Parser p):
    u32 t = type_expr(p)
    if t == BAD: return BAD
    return p.node(E_TYPE, NONE, t, NONE, p.lo(t), p.hi(t))

private u32 map_expr(^Parser p):
    u32 open = p.bump()
    i64 base = p.base()
    for !p.at(RBRACE) && !p.at(EOF):
        u32 key = head_expr(p)
        if key == BAD || p.expect(COLON) == BAD:
            p.drop(base)
            return BAD
        u32 v = expr(p)
        if v == BAD:
            p.drop(base)
            return BAD
        p.push(p.node(E_ENTRY, NONE, key, v, join_lo(p.lo(key), p.lo(v)), join_hi(p.hi(key), p.hi(v))))
        if p.at(COMMA): _ = p.bump()
        else: break
    u32 close = p.expect(RBRACE)
    if close == BAD:
        p.drop(base)
        return BAD
    return p.node(E_MAP, open, NONE, p.seal(base), p.st[open], p.en[close])

private u32 array_expr(^Parser p):
    u32 open = p.bump()
    i64 base = p.base()
    for !p.at(RBRACKET) && !p.at(EOF):
        u32 e = expr(p)
        if e == BAD:
            p.drop(base)
            return BAD
        p.push(e)
        if p.at(COMMA): _ = p.bump()
        else: break
    u32 close = p.expect(RBRACKET)
    if close == BAD:
        p.drop(base)
        return BAD
    return p.node(E_ARRAY, open, NONE, p.seal(base), p.st[open], p.en[close])

// `#no_bounds` in front of an index or a stored value: its token, or NONE.
u32 operand_marker(^Parser p):
    if !p.at(HASH_NAME): return NONE
    u8 k = p.kind(1)
    if k == IDENT || k == HASH_NAME || k == INT || k == FLOAT || k == STRING || k == CHAR || k == LBRACE:
        return p.bump()
    return NONE

u32 postfix(^Parser p, u32 e):
    u32 links = 0
    for:
        if p.block_ended: break
        u8 k = p.kind(0)
        if k == QUESTION:
            u32 m = p.bump()
            p.error(523, p.st[m], p.en[m], RETIRED_QUESTION)
            continue
        if k == LPAREN || k == LBRACKET || k == CARET || k == DOT:
            links += 1
            if p.tree_too_deep(links): return BAD
        if k == LPAREN:
            _ = p.bump()
            i64 base = p.base()
            p.push(e)
            p.push(NONE)
            if arg_list(p) == BAD:
                p.drop(base)
                return BAD
            u32 close = p.expect(RPAREN)
            if close == BAD:
                p.drop(base)
                return BAD
            e = p.node(E_CALL, NONE, NONE, p.seal(base), p.lo(e), join_hi(p.hi(e), p.en[close]))
            continue
        if at_postfix_suite_word(p):
            links += 1
            if p.tree_too_deep(links): return BAD
            _ = p.bump()
            u32 head = using_head(p, false)
            if head == BAD: return BAD
            u32 lo = join_lo(p.lo(e), p.lo(head))
            u32 hi = join_hi(p.hi(e), p.hi(head))
            if p.tag_of(e) != E_CALL:
                p.error(208, lo, hi, "`using` written after an expression scopes **that call's** evaluation, and this is not a call\x1fThere is nothing for it to be in force during\x1ewrite it after the call whose allocations it is meant to change, or open a suite with `using <subject>:` and indent the statements it governs")
                return BAD
            p.ast.lo[e] = lo
            p.ast.hi[e] = hi
            p.ast.extra[p.ast.b[e] + 2] = head
            continue
        if k == LBRACKET:
            _ = p.bump()
            u32 marker = operand_marker(p)
            u32 r = bracket_tail(p)
            if r == BAD: return BAD
            u32 close = p.expect(RBRACKET)
            if close == BAD: return BAD
            u32 lo = p.lo(e)
            u32 hi = join_hi(p.hi(e), p.en[close])
            if r != NONE:
                e = p.node(E_INDEX, marker, e, r, lo, hi)
                continue
            if marker != NONE:
                p.begin(201, p.st[marker], p.en[close])
                p.say("`")
                p.say_tok(marker)
                p.say("` is written in front of **one** index — `a[")
                p.say_tok(marker)
                p.say(" i]` — and this is a window, which is a run of positions rather than a position. There is no single subscript here for it to be about")
                p.seal_diag()
            i64 base = p.base()
            p.push(e)
            p.push(p.slice_start)
            p.push(p.slice_end)
            e = p.node(E_SLICE, p.slice_kind, NONE, p.seal(base), lo, hi)
            continue
        if k == CARET:
            u32 c = p.bump()
            e = p.node(E_DEREF, c, e, NONE, p.lo(e), join_hi(p.hi(e), p.en[c]))
            continue
        if k == DOT:
            u32 dot = p.bump()
            if p.at(LPAREN):
                _ = p.bump()
                u32 ty = type_expr(p)
                if ty == BAD: return BAD
                u32 close = p.expect(RPAREN)
                if close == BAD: return BAD
                e = p.node(E_NARROW, dot, e, ty, p.lo(e), join_hi(p.hi(e), p.en[close]))
                continue
            u32 t = p.peek()
            if is_keyword(p.tg[t]):
                p.begin(201, p.st[t], p.en[t])
                p.say("`")
                p.say_tok(t)
                p.say("` is a keyword, so it is no name after `.`")
                p.help("read a member named by a keyword with an index: `")
                p.help(p.src[i64(p.lo(e))..<i64(p.hi(e))])
                p.help("[\"")
                p.help_tok(t)
                p.help("\"]`")
                p.seal_diag()
                _ = p.bump()
                e = p.node(E_FIELD, t, e, NONE, p.lo(e), join_hi(p.hi(e), p.en[t]))
                continue
            u32 f = p.ident("a field name")
            if f == BAD:
                e = p.node(E_FIELD, NONE, e, NONE, p.lo(e), join_hi(p.hi(e), p.en[dot]))
                break
            e = p.node(E_FIELD, f, e, NONE, p.lo(e), join_hi(p.hi(e), p.en[f]))
            continue
        break
    return e

// After `[`: an index (answered), or a window (NONE; its parts in
// slice_start, slice_end and slice_kind).
private u32 bracket_tail(^Parser p):
    p.slice_start = NONE
    p.slice_end = NONE
    p.slice_kind = NONE
    if p.at(COLON) && p.kind(1) == RBRACKET:
        _ = p.bump()
        return NONE
    if is_range(p.kind(0)):
        u32 k = p.bump()
        u32 end = expr(p)
        if end == BAD: return BAD
        p.slice_start = NONE
        p.slice_end = end
        p.slice_kind = k
        return NONE
    u32 first = expr_bp(p, BP_RANGE + 1)
    if first == BAD: return BAD
    if p.at(KW_IF): return conditional_tail(p, first)
    if !is_range(p.kind(0)): return first
    u32 k = p.bump()
    if p.at(RBRACKET):
        p.slice_start = first
        p.slice_end = NONE
        p.slice_kind = k
        return NONE
    u32 end = expr(p)
    if end == BAD: return BAD
    p.slice_start = first
    p.slice_end = end
    p.slice_kind = k
    return NONE

// Pushes the arguments (E_ARG); BAD on failure.
u32 arg_list(^Parser p):
    i64 first = p.base()
    i64 assigned = 0
    u32 first_eq = NONE
    bool all_named = true
    for !p.at(RPAREN) && !p.at(EOF):
        u32 start = p.peek()
        u32 name = NONE
        if p.at(IDENT) && p.kind(1) == COLON:
            name = p.bump()
            _ = p.bump()
        else if p.at(IDENT) && p.kind(1) == ASSIGN:
            name = p.bump()
            u32 eq = p.bump()
            if first_eq == NONE: first_eq = eq
            assigned += 1
        u32 v = expr(p)
        if v == BAD: return BAD
        if name == NONE: all_named = false
        p.push(p.node(E_ARG, name, v, NONE, join_lo(p.st[start], p.lo(v)), join_hi(p.en[start], p.hi(v))))
        if p.at(COMMA): _ = p.bump()
        else: break
    if first_eq != NONE && all_named && p.base() > first:
        report_assigned(p, first)
    return 0

// ERR0604 for `f(a = 1)`: the arguments rewritten with `:`.
private void report_assigned(^Parser p, i64 first):
    u32 a0 = p.scratch[first]
    u32 a1 = p.scratch[p.base() - 1]
    u32 lo = p.lo(a0)
    u32 hi = p.hi(a1)
    ref []char8 fixed
    i64 from = i64(lo)
    u32 at = NONE
    // the `=` tokens of the arguments, in order
    i64 i = 0
    for i <= p.last:
        if p.st[i] >= lo: break
        i += 1
    for i <= p.last && p.st[i] < hi:
        if p.tg[i] == ASSIGN && i > 0 && p.tg[i - 1] == IDENT && arg_named_by(p, first, u32(i - 1)):
            if at == NONE: at = u32(i)
            i64 eq = i64(p.st[i])
            i64 upto = eq
            for upto > from && (p.src[upto - 1] == ' ' || p.src[upto - 1] == '\t' || p.src[upto - 1] == '\n' || p.src[upto - 1] == '\r'):
                upto -= 1
            fixed = #append(fixed, ..p.src[from..<upto])
            fixed = #append(fixed, ':')
            from = i64(p.en[i])
            char8 c = p.src[from] if from < #len(p.src) else ' '
            if !(c == ' ' || c == '\t' || c == '\n' || c == '\r'): fixed = #append(fixed, ' ')
        i += 1
    fixed = #append(fixed, ..p.src[from..<i64(hi)])
    p.begin(604, p.st[at], p.en[at])
    p.say("a named argument is written `name: value`; `name = value` is an assignment, and an assignment is a statement, not an argument")
    p.help("write the arguments `")
    p.help(fixed)
    p.help("`")
    #delete(fixed)

private bool arg_named_by(^Parser p, i64 first, u32 tok):
    for i in first..<p.base():
        if p.ast.main[p.scratch[i]] == tok: return true
    return false

// -- statement heads read as expressions ------------------------------------

u32 head_expr(^Parser p):
    i64 outer = p.head_start
    p.head_start = p.pos
    u32 e = expr(p)
    p.head_start = outer
    return e

private bool at_head_top(^Parser p):
    if p.head_start < 0: return false
    i64 depth = 0
    i64 e = p.pos
    if e > p.last + 1: e = p.last + 1
    for i in p.head_start..<e:
        if opens(p.tg[i]): depth += 1
        else if closes(p.tg[i]): depth -= 1
    return depth <= 0

private bool at_lambda(^Parser p):
    i64 i = p.pos
    if p.tg[i] == KW_ASYNC: i += 1
    i64 first = i
    i64 steps = 0
    for:
        steps += 1
        if steps > 256: return false
        u8 k = EOF if i > p.last else p.tg[i]
        if k == LPAREN && i > first: break
        if opens(k):
            i64 close = matching_close(p.tg, i)
            if close < 0: return false
            i = close + 1
            continue
        if !(k == IDENT || k == DOT || k == CARET || k == DOLLAR || k == HASH_NAME || k == KW_CONST): return false
        i += 1
    i64 open = i
    u8 k1 = EOF if open + 1 > p.last else p.tg[open + 1]
    if k1 == RPAREN:
        u8 k2 = EOF if open + 2 > p.last else p.tg[open + 2]
        return k2 == COLON && !at_head_top(p)
    return declares_a_parameter(p.tg, open)

// A lambda, NONE when there is none here, or BAD.
private u32 lambda(^Parser p):
    if !at_lambda(p): return NONE
    Mark m = p.mark()
    u32 asy = NONE
    if p.at(KW_ASYNC): asy = p.bump()
    bool outer = p.bare_type
    p.bare_type = true
    u32 ret = type_expr(p)
    p.bare_type = outer
    i64 base = p.base()
    p.push(ret)
    p.push(NONE)
    p.push(NONE)
    p.push(NONE)
    p.push(NONE)
    bool ok = ret != BAD && signature(p, base, false) != BAD
    if ok:
        bool typed = p.base() == base + 5 || p.ast.a[p.scratch[base + 5]] != NONE
        ok = p.scratch[base + 3] == NONE && p.scratch[base + 4] == NONE && typed && p.at(COLON)
    if !ok || p.ndiags() > m.diags:
        p.rewind(m)
        return NONE
    // [ret, body, params...]
    for i in base + 5..<p.base():
        p.scratch[i - 3] = p.scratch[i]
    p.drop(p.base() - 3)
    u32 lo = p.lo(ret)
    if asy != NONE: lo = p.st[asy]
    p.note_dados(lo)
    u32 colon = p.bump()
    bool below = p.at(NEWLINE)
    if below && p.kind(1) != INDENT:
        u32 t = u32(p.at_index(1))
        p.begin(202, p.st[t], p.en[t])
        p.say("a lambda whose `:` ends its line takes its body on the lines below, indented deeper than the line holding the `:`; found ")
        p.say_kind(p.tg[t])
        p.help("indent the body one level under the line the lambda is written on — `xs.filter(bool(int v):` then `    return v > 2` — or write one statement after the `:`")
        p.seal_diag()
        u8 g = p.tg[t]
        if g == DEDENT || g == EOF || g == NEWLINE:
            p.drop(base)
            return BAD
        _ = p.bump()
        below = false
    u32 body = BAD
    if below:
        u32 o = p.lambda_inline
        p.lambda_inline = 0
        body = block(p)
        p.lambda_inline = o
        u8 g = p.kind(0)
        if !(g == COMMA || g == RPAREN || g == RBRACKET || g == RBRACE): p.block_ended = true
    else:
        u32 next = p.peek()
        bool newline = false
        for i in i64(p.en[colon])..<i64(p.st[next]):
            if p.src[i] == '\n': newline = true
        if newline && p.ndiags() == m.diags:
            p.error_help(201, p.st[next], p.en[next], "this lambda's body begins on a line below its `:`, but the `:` does not end its line", "end the line at the `:` and indent the body under it — move what follows the `:` onto the body's first line — or write one statement after the `:`")
            p.drop(base)
            return BAD
        p.lambda_inline += 1
        body = block(p)
        p.lambda_inline -= 1
        if p.pos > 0 && p.tg[p.pos - 1] == DEDENT: p.block_ended = true
    if body == BAD:
        p.drop(base)
        return BAD
    p.scratch[base + 1] = body
    return p.node(E_LAMBDA, NONE, asy, p.seal(base), lo, join_hi(lo, p.hi(body)))

// -- keyword names -----------------------------------------------------------

// A keyword written as a name, when the next token is one of `e1`..`e4`:
// refused, and bound under anyway (its token), else NONE.
u32 keyword_name(^Parser p, string8 what, u8 e1, u8 e2, u8 e3, u8 e4):
    u32 t = p.peek()
    u8 k = p.tg[t]
    u8 n = p.kind(1)
    if !is_keyword(k) || !(n == e1 || n == e2 || n == e3 || n == e4): return NONE
    _ = p.bump()
    p.begin(209, p.st[t], p.en[t])
    p.say("`")
    p.say_tok(t)
    p.say("` is a keyword, and a keyword cannot be ")
    p.say(what)
    p.help("rename it — `")
    p.help_tok(t)
    p.help("_` keeps the word, or name what it holds")
    p.seal_diag()
    p.keyword_names = p.keyword_names | (u32(1) << u32(k - KW_PACKAGE))
    return t

u32 keyword_use(^Parser p):
    u8 k = p.kind(0)
    if !is_keyword(k) || (p.keyword_names & (u32(1) << u32(k - KW_PACKAGE))) == 0: return NONE
    return p.leaf(E_NAME, p.bump())
