// Type expressions.
package syntax

private const string8 RETIRED_QUESTION = "the failable mark is written `!` in front of the return type now, not `?` after it: `!i32 parse(string8 s):` and `!i32(string8)`. It moved because `?` reads as *a type that may be absent*, which is what it means in every other language that spells it — and a failure here is never a value and never stored, so it was never part of the type"

u32 type_expr(^Parser p):
    u32 o_lo = p.pend_fail_lo
    u32 o_hi = p.pend_fail_hi
    u32 o_failure = p.pend_failure
    u32 o_async = p.pend_async
    p.pend_fail_lo = NONE
    p.pend_failure = NONE
    p.pend_async = NONE
    u32 ty = BAD
    if !p.too_deep():
        p.depth += 1
        ty = type_expr_inner(p)
        p.depth -= 1
    p.pend_failure = NONE
    if p.pend_fail_lo != NONE:
        p.error(523, p.pend_fail_lo, p.pend_fail_hi, failure_stored())
        p.pend_fail_lo = NONE
    u32 m = p.pend_async
    p.pend_async = NONE
    if m != NONE && ty != BAD: ty = async_value(p, m, ty)
    p.pend_fail_lo = o_lo
    p.pend_fail_hi = o_hi
    p.pend_failure = o_failure
    p.pend_async = o_async
    return ty

u32 async_value(^Parser p, u32 mark, u32 ty):
    return p.node(T_QUAL, mark, ty, NONE, join_lo(p.st[mark], p.lo(ty)), join_hi(p.en[mark], p.hi(ty)))

void async_misplaced(^Parser p, u32 mark):
    p.error_help(201, p.st[mark], p.en[mark], "`async` marks a function — its return type in a signature (`async int load():`) or a function type (`async int(string)`) — and nothing else here", "`await` the call where its value is wanted: `await int x = load()`")

// A declaration head's type: its `!` mark goes to tm_lo/tm_hi, its `E!`
// enum to head_failure, an `async` to head_async.
u32 type_expr_marked(^Parser p):
    u32 o_lo = p.pend_fail_lo
    u32 o_hi = p.pend_fail_hi
    u32 o_failure = p.pend_failure
    u32 o_async = p.pend_async
    p.pend_fail_lo = NONE
    p.pend_failure = NONE
    p.pend_async = NONE
    p.head_async = NONE
    p.head_failure = NONE
    u32 ty = BAD
    if !p.too_deep():
        p.depth += 1
        ty = type_expr_inner(p)
        p.depth -= 1
    p.tm_lo = p.pend_fail_lo
    p.tm_hi = p.pend_fail_hi
    if p.tm_lo != NONE: p.head_failure = p.pend_failure
    p.head_async = p.pend_async
    p.pend_fail_lo = o_lo
    p.pend_fail_hi = o_hi
    p.pend_failure = o_failure
    p.pend_async = o_async
    return ty

private u32 type_expr_inner(^Parser p):
    if p.at(KW_ASYNC):
        u32 mark = p.bump()
        p.note_dados(p.st[mark])
        u32 inner = type_expr_inner(p)
        if inner == BAD: return BAD
        if p.tag_of(inner) == T_FN:
            if (p.ast.a[inner] & F_ASYNC) != 0:
                async_misplaced(p, mark)
            else:
                p.ast.a[inner] = p.ast.a[inner] | F_ASYNC
                p.ast.lo[inner] = join_lo(p.st[mark], p.lo(inner))
            return inner
        if p.pend_async != NONE: async_misplaced(p, mark)
        else: p.pend_async = mark
        return inner
    if p.at(BANG):
        u32 bang = p.bump()
        u32 inner = type_expr_inner(p)
        if inner == BAD: return BAD
        if p.tag_of(inner) == T_FN:
            if (p.ast.a[inner] & F_FAILABLE) != 0:
                p.error(523, p.st[bang], p.en[bang], failure_stored())
            else:
                p.ast.a[inner] = p.ast.a[inner] | F_FAILABLE
                p.ast.lo[inner] = join_lo(p.st[bang], p.lo(inner))
            return inner
        p.pend_fail_lo = p.st[bang]
        p.pend_fail_hi = p.en[bang]
        return inner
    u32 core = type_core(p)
    if core == BAD: return BAD
    u8 g = p.tag_of(core)
    if p.at(BANG) && (g == T_NAME || g == T_PATH): return failure_enum(p, core)
    if p.at(DOLLAR):
        if g != T_NAME:
            u32 t = p.peek()
            p.error_tok(201, t, "`$` after a type binds nothing: a type parameter is `$T` on its own, and what it may be goes in a `where` — `$T f(T x) where T is float`")
            return BAD
        _ = p.bump()
        u32 binds = p.ident("a name to bind after `$`")
        if binds == BAD: return BAD
        return p.node(T_BOUND, p.ast.main[core], binds, NONE, p.lo(core), p.en[binds])
    return type_postfix(p, core)

private u32 failure_enum(^Parser p, u32 failure):
    u32 bang = p.bump()
    u32 mlo = join_lo(p.lo(failure), p.st[bang])
    u32 mhi = join_hi(p.hi(failure), p.en[bang])
    u32 inner = type_expr_inner(p)
    if inner == BAD: return BAD
    if p.tag_of(inner) == T_FN:
        if (p.ast.a[inner] & F_FAILABLE) != 0:
            p.error(523, p.st[bang], p.en[bang], failure_stored())
        else:
            p.ast.a[inner] = p.ast.a[inner] | F_FAILABLE
            p.ast.extra[p.ast.b[inner] + 2] = failure
            p.ast.lo[inner] = join_lo(mlo, p.lo(inner))
            p.ast.hi[inner] = join_hi(mhi, p.hi(inner))
        return inner
    if p.pend_fail_lo != NONE:
        p.error(523, p.st[bang], p.en[bang], failure_stored())
        return inner
    p.pend_fail_lo = mlo
    p.pend_fail_hi = mhi
    p.pend_failure = failure
    return inner

u32 type_core(^Parser p):
    if p.too_deep(): return BAD
    p.depth += 1
    u32 t = type_core_inner(p)
    p.depth -= 1
    return t

private bool attribute_word(u32 w):
    return w == W_TEST || w == W_C || w == W_INCOMPLETE || w == W_ALIGN || w == W_SYMBOL || w == W_MACRO || w == W_C_BODY || w == W_FREESTANDING || w == W_THREAD_LOCAL

private u32 type_core_inner(^Parser p):
    u32 t = p.peek()
    u8 k = p.tg[t]
    if at_channel_head(p):
        channel_misplaced(p, "a type written here")
        return BAD
    if k == DOLLAR:
        u32 d = p.bump()
        u32 binds = p.ident("a name to bind after `$`")
        if binds == BAD: return BAD
        return p.node(T_BINDING, binds, NONE, NONE, p.st[d], p.en[binds])
    if k == HASH_NAME && p.kind(1) == DOT:
        u32 pkg = p.bump()
        _ = p.bump()
        u32 m = p.ident("a type name after `.`")
        if m == BAD: return BAD
        return p.node(T_PATH, m, pkg, NONE, p.st[pkg], p.en[m])
    if k == HASH_NAME && starts_type(p.kind(1)):
        u32 l = p.bump()
        u32 inner = type_expr(p)
        if inner == BAD: return BAD
        return p.node(T_LAYOUT, l, inner, NONE, p.st[l], join_hi(p.en[l], p.hi(inner)))
    if k == AT:
        u32 next = t + 1
        u8 nk = p.kind(1)
        bool has_word = nk == IDENT || nk == KW_CONST
        u32 hi = p.en[t]
        if has_word: hi = p.en[next]
        p.begin(418, p.st[t], hi)
        bool known = has_word && (nk == KW_CONST || attribute_word(p.sym[next]))
        if known:
            p.say("`@")
            p.say_tok(next)
            p.say("` is an attribute, and no attribute is written inside a type")
            p.help("move `@")
            p.help_tok(next)
            p.help("` out of the type, to where it is written (`--explain` says where)")
        else:
            if has_word:
                p.say("`@")
                p.say_tok(next)
                p.say("` is not an attribute")
            else:
                p.say("`@` with no attribute named after it")
            p.help("remove the `@`, or write one of the ten registered attributes, which `--explain` lists")
        return BAD
    if k == KW_TYPE:
        return p.leaf(T_KIND, p.bump())
    if k == IDENT && p.word(0) == W_REF:
        if p.kind(1) == LPAREN:
            u32 r = p.bump()
            if p.expect(LPAREN) == BAD: return BAD
            u32 holds = type_expr(p)
            if holds == BAD: return BAD
            u32 close = p.expect(RPAREN)
            if close == BAD: return BAD
            return p.node(T_REF, r, holds, NONE, p.st[r], p.en[close])
        if starts_type(p.kind(1)):
            u32 r = p.bump()
            u32 holds = type_expr(p)
            if holds == BAD: return BAD
            return p.node(T_REF, r, holds, NONE, p.st[r], join_hi(p.en[r], p.hi(holds)))
    if at_qualifier(p):
        u32 q = p.bump()
        u32 inner = type_expr(p)
        if inner == BAD: return BAD
        return p.node(T_QUAL, q, inner, NONE, p.st[q], join_hi(p.en[q], p.hi(inner)))
    if k == CARET:
        u32 c = p.bump()
        u32 pointee = type_expr(p)
        if pointee == BAD: return BAD
        return p.node(T_POINTER, c, pointee, NONE, p.st[c], join_hi(p.en[c], p.hi(pointee)))
    if k == LBRACKET: return slice_or_array_type(p)
    if k == LPAREN: return tuple_type(p)
    if k == LBRACE: return map_type(p)
    if k == IDENT:
        u32 w = p.word(0)
        if (w == W_SHAPEOF || w == W_TYPEOF) && p.kind(1) == LPAREN:
            u32 s = p.bump()
            _ = p.expect(LPAREN)
            u32 operand = expr(p)
            if operand == BAD: return BAD
            u32 close = p.expect(RPAREN)
            if close == BAD: return BAD
            return p.node(T_SHAPEOF, s, operand, 1 if w == W_TYPEOF else 0, p.st[s], p.en[close])
        u32 name = p.bump()
        if p.at(DOT):
            _ = p.bump()
            u32 second = p.ident("a type name after `.`")
            if second == BAD: return BAD
            u32 member = NONE
            u32 hi = p.en[second]
            if p.in_scripts() && p.at(DOT):
                _ = p.bump()
                member = p.ident("a type name after `.`")
                if member == BAD: return BAD
                hi = p.en[member]
            return p.node(T_PATH, second, name, member, p.st[name], hi)
        return p.leaf(T_NAME, name)
    p.begin(201, p.st[t], p.en[t])
    p.say("expected a type, found ")
    p.say_kind(k)
    p.seal_diag()
    return BAD

private u32 slice_or_array_type(^Parser p):
    u32 open = p.bump()
    if p.at(RBRACKET):
        _ = p.bump()
        u32 el = type_expr(p)
        if el == BAD: return BAD
        return p.node(T_SLICE, open, el, NONE, p.st[open], join_hi(p.en[open], p.hi(el)))
    if matrix_type_ahead(p):
        u32 rows = dimension(p)
        if rows == BAD: return BAD
        u32 rb = p.dim_binds
        if p.expect(COMMA) == BAD: return BAD
        u32 cols = dimension(p)
        if cols == BAD: return BAD
        u32 cb = p.dim_binds
        if p.expect(RBRACKET) == BAD: return BAD
        u32 el = type_expr(p)
        if el == BAD: return BAD
        i64 base = p.base()
        p.push(rows)
        p.push(cols)
        p.push(el)
        return p.node(T_MATRIX, cb, rb, p.seal(base), p.st[open], join_hi(p.en[open], p.hi(el)))
    u32 len = dimension(p)
    if len == BAD: return BAD
    u32 binds = p.dim_binds
    if p.expect(RBRACKET) == BAD: return BAD
    u32 el = type_expr(p)
    if el == BAD: return BAD
    return p.node(T_ARRAY, binds, len, el, p.st[open], join_hi(p.en[open], p.hi(el)))

// A length: an expression, or `$N` (its name to dim_binds).
private u32 dimension(^Parser p):
    p.dim_binds = NONE
    if !p.at(DOLLAR): return expr(p)
    u32 d = p.bump()
    u32 name = p.ident("an arity to bind after `$`")
    if name == BAD: return BAD
    p.dim_binds = name
    return p.node(E_NAME, name, NONE, NONE, p.st[d], p.en[name])

private bool matrix_type_ahead(^Parser p):
    i64 depth = 1
    i64 commas = 0
    i64 ahead = 0
    for:
        u8 k = p.kind(ahead)
        if k == LBRACKET || k == LPAREN:
            depth += 1
        else if k == RBRACKET && depth == 1:
            u8 after = p.kind(ahead + 1)
            bool follows = after == IDENT || after == CARET || after == LBRACKET || after == LPAREN || after == DOLLAR
            return commas == 1 && follows
        else if k == RBRACKET || k == RPAREN:
            if depth == 1: return false
            depth -= 1
        else if k == COMMA && depth == 1:
            commas += 1
        else if k == EOF:
            return false
        ahead += 1
    return false

private u32 map_type(^Parser p):
    u32 open = p.bump()
    u32 key = type_expr(p)
    if key == BAD: return BAD
    if p.expect(COLON) == BAD: return BAD
    u32 value = type_expr(p)
    if value == BAD: return BAD
    u32 close = p.expect(RBRACE)
    if close == BAD: return BAD
    return p.node(T_MAP, open, key, value, p.st[open], p.en[close])

private u32 tuple_type(^Parser p):
    u32 open = p.bump()
    i64 base = p.base()
    bool comma = false
    for !p.at(RPAREN) && !p.at(EOF):
        u32 m = member(p, false)
        if m == BAD:
            p.drop(base)
            return BAD
        p.push(m)
        if p.at(COMMA):
            _ = p.bump()
            comma = true
        else:
            break
    u32 close = p.expect(RPAREN)
    if close == BAD:
        p.drop(base)
        return BAD
    if p.base() == base + 1 && !comma && p.ast.main[p.scratch[base]] == NONE:
        u32 m = p.scratch[base]
        p.drop(base)
        return p.ast.extra[p.ast.b[m] + 1]
    return p.node(T_TUPLE, open, 0, p.seal(base), p.st[open], p.en[close])

private u32 type_postfix(^Parser p, u32 core):
    for:
        if p.at(QUESTION):
            u32 m = p.bump()
            p.error(523, p.st[m], p.en[m], RETIRED_QUESTION)
            continue
        if !p.at(LPAREN) || p.bare_type: break
        _ = p.bump()
        i64 base = p.base()
        p.push(core)
        p.push(NONE)
        for !p.at(RPAREN) && !p.at(EOF):
            if p.at(DOTDOT):
                p.drop(base)
                p.error_tok(206, p.peek(), "`..` is a calling convention and not part of a function's type, so a function type cannot write one; a variadic's body already holds a `[]T`, so write that slot's type as `[]T` and pass the window")
                return BAD
            u32 t = type_expr(p)
            if t == BAD:
                p.drop(base)
                return BAD
            p.push(t)
            if p.at(COMMA): _ = p.bump()
            else: break
        u32 close = p.expect(RPAREN)
        if close == BAD:
            p.drop(base)
            return BAD
        core = p.node(T_FN, NONE, 0, p.seal(base), p.lo(core), join_hi(p.hi(core), p.en[close]))
    return core
