// The normalised tree dump the oracle compares: dump_ast's walk,
// without ids and quoted text, spans snapped to significant tokens.
package syntax

private type Dumper:
    ^Ast a
    string8 src
    ^Tokens t
    ^ref []char8 out
    ref []u32 sig
    i64 depth

    void pad(^self):
        for _ in 0..<self.depth:
            self.out^ = #append(self.out^, ..string8("  "))

    void put(^self, string8 s):
        self.out^ = #append(self.out^, ..s)

    void num(^self, u32 v):
        u64 p = 1
        for p * 10 <= u64(v):
            p *= 10
        for p > 0:
            self.out^ = #append(self.out^, char8(u8('0') + u8(u64(v) / p % 10)))
            p /= 10

    void span(^self, u32 lo, u32 hi):
        i64 i = 0
        i64 n = #len(self.sig)
        i64 h = n
        for i < h:
            i64 m = (i + h) / 2
            if self.t.end[self.sig[m]] <= lo: i = m + 1
            else: h = m
        i64 j = 0
        h = n
        for j < h:
            i64 m = (j + h) / 2
            if self.t.start[self.sig[m]] < hi: j = m + 1
            else: h = m
        if i >= j:
            self.put("-")
            return
        self.num(self.t.start[self.sig[i]])
        self.put("..")
        self.num(self.t.end[self.sig[j - 1]])

    // A node line: role, kind, the node's span.
    void line(^self, string8 role, string8 kind, u32 n):
        self.pad()
        if #len(role) > 0:
            self.put(role)
            self.put(":")
        self.put(kind)
        self.put(" ")
        self.span(self.a.lo[n], self.a.hi[n])
        self.put("\n")

    void line_vis(^self, string8 kind, u32 n, u32 vis):
        self.pad()
        self.put(kind)
        self.put(vis_suffix(vis))
        self.put(" ")
        self.span(self.a.lo[n], self.a.hi[n])
        self.put("\n")

    void label(^self, string8 s):
        self.pad()
        self.put(s)
        self.put("\n")

    []u32 kids(^self, u32 n):
        return self.a.list(self.a.b[n])

    string8 text(^self, u32 tok):
        return self.src[i64(self.t.start[tok])..<i64(self.t.end[tok])]

private string8 vis_suffix(u32 v):
    switch v & F_VIS:
        case VIS_PUBLIC: return ":public"
        case VIS_PACKAGE: return ":private"
        case VIS_FILE: return ":private-file"
        case VIS_EXPORT: return ":export"
        else: return ""
    return ""

// Appends the dump of `a` to `out`.
void dump_tree(^ref []char8 out, string8 src, ^Tokens t, ^Ast a):
    Dumper d
    d.a = a
    d.src = src
    d.t = t
    d.out = out
    d.sig = #reserve(d.sig, #len(t.tag))
    for i in 0..<#len(t.tag):
        if t.tag[i] > EOF: d.sig = #append(d.sig, u32(i))
    u32 r = a.root
    d.line("", "File", r)
    d.depth = 1
    for n in d.kids(r):
        if n == NONE: continue
        switch a.tag[n]:
            case N_TEST: d.line("", "Test", n)
            case N_PACKAGE: d.line("", "Package", n)
            case N_IMPORT: d.line("", "Import", n)
            case N_SCRIPT:
                d.line("", "Script", n)
                d.depth += 1
                class_tail(&d, n)
                d.depth -= 1
            else: d_item(&d, n)
    #delete(d.sig)

private void class_tail(^Dumper d, u32 n):
    []u32 k = d.kids(n)
    if k[0] != NONE: ty(d, "extends", k[0])
    for i in 1..<#len(k):
        if is_type(d.a.tag[k[i]]): ty(d, "using", k[i])

private bool is_type(u8 g):
    return g >= T_NAME && g <= T_CHANNEL

private void d_item(^Dumper d, u32 n):
    ^Ast a = d.a
    u32 f = a.a[n]
    switch a.tag[n]:
        case N_FN: fn_like(d, "Fn", n, true)
        case N_TYPE:
            string8 form = "Type"
            if (f & F_CONTRACT) != 0: form = "Contract"
            else if (f & F_DISTINCT) != 0: form = "Distinct"
            d.line_vis(form, n, f)
            d.depth += 1
            []u32 k = d.kids(n)
            for i in 3..<#len(k):
                if a.tag[k[i]] == N_BINDER: d.line("", "Binder", k[i])
            for i in 3..<#len(k):
                if is_type(a.tag[k[i]]): ty(d, "using", k[i])
            if k[1] != NONE: ex(d, "where", a.a[k[1]])
            d_type_body(d, k[2])
            for i in 3..<#len(k):
                if a.tag[k[i]] == N_FN: fn_like(d, "Method", k[i], true)
            for i in 3..<#len(k):
                if a.tag[k[i]] == N_ASSERT_RAISES:
                    d.line("", "AssertRaises", k[i])
                    d.depth += 1
                    for m in d.kids(k[i]):
                        d.line("", "Name", m)
                    d.depth -= 1
            d.depth -= 1
        case N_TRAIT:
            d.line_vis("Trait", n, f)
            d.depth += 1
            []u32 k = d.kids(n)
            for m in k:
                if a.tag[m] == N_BINDER: d.line("", "Binder", m)
            for m in k:
                if is_type(a.tag[m]): ty(d, "extends", m)
            for m in k:
                if a.tag[m] == N_FN:
                    if (a.a[m] & F_REQUIRED) != 0: fn_like(d, "Required", m, false)
                    else: fn_like(d, "Method", m, true)
            d.depth -= 1
        case N_WHEN:
            d.line("", "When", n)
            d.depth += 1
            for arm in d.kids(n):
                if a.tag[arm] == N_WHEN_ARM:
                    d.line("", "arm", arm)
                    d.depth += 1
                    []u32 k = d.kids(arm)
                    ex(d, "cond", k[0])
                    for i in 1..<#len(k):
                        d_item(d, k[i])
                    d.depth -= 1
                else:
                    d.line("", "else", n)
                    d.depth += 1
                    for i in d.kids(arm):
                        d_item(d, i)
                    d.depth -= 1
            d.depth -= 1
        case N_CLASS:
            d.line_vis("Class", n, f)
            d.depth += 1
            []u32 k = d.kids(n)
            class_tail(d, n)
            for i in 1..<#len(k):
                if !is_type(a.tag[k[i]]): d_item(d, k[i])
            d.depth -= 1
        case N_STATIC_ASSERT:
            d.line("", "StaticAssert", n)
            d.depth += 1
            ex(d, "cond", a.a[n])
            ex(d, "message", a.b[n])
            d.depth -= 1
        case N_ASSERT_RAISES:
            d.line("", "AssertRaises", n)
            d.depth += 1
            for m in d.kids(n):
                d.line("", "Name", m)
            d.depth -= 1
        case N_CONST: d_const_decl(d, n)
        case N_VAR:
            []u32 k = d.kids(n)
            d.line_vis("Embed" if (f & F_EMBED) != 0 else "Var", n, f)
            d.depth += 1
            if k[2] != NONE: ex(d, "align", a.a[k[2]])
            if k[3] != NONE: c_body_label(d, k[3])
            if k[4] != NONE: d.label("@thread_local")
            ty(d, "type", k[0])
            if k[1] != NONE: ex(d, "value", k[1])
            else: d.label("value:zero")
            d.depth -= 1
        case N_FOREIGN:
            d.line_vis("Foreign", n, f)
            d.depth += 1
            []u32 k = d.kids(n)
            for i in 1..<#len(k):
                if a.tag[k[i]] == N_CLAUSE:
                    u32 c = k[i]
                    d.pad()
                    d.put(WORDS[d.t.sym[a.main[c]]])
                    d.put(":")
                    ref []char8 body
                    string_body(d.text(a.a[c]), &body)
                    debug_quote(d, body)
                    #delete(body)
                    d.put("\n")
            if (f & F_FREE) != 0: d.label("@freestanding")
            for i in 1..<#len(k):
                if a.tag[k[i]] != N_CLAUSE: d_foreign_item(d, k[i])
            d.depth -= 1
        case N_UNION:
            union_line(d, n, false)
        case N_ENUM:
            d.line_vis(enum_form(f), n, f)
            d.depth += 1
            []u32 k = d.kids(n)
            if k[0] != NONE: ty(d, "backing", k[0])
            else: d.label("backing:default")
            for i in 1..<#len(k):
                u32 m = k[i]
                d.line("", "Member", m)
                d.depth += 1
                if a.a[m] != NONE: ex(d, "value", a.a[m])
                else: d.label("value:implicit")
                d.depth -= 1
            d.depth -= 1
        else:
            d.label("?")

private string8 enum_form(u32 f):
    bool dist = (f & F_DISTINCT) != 0
    bool paren = (f & F_PAREN) != 0
    if dist: return "DistinctEnum(paren)" if paren else "DistinctEnum(indented)"
    return "Enum(paren)" if paren else "Enum(indented)"

private void union_line(^Dumper d, u32 n, bool fgn):
    u32 f = d.a.a[n]
    if fgn:
        d.line_vis("ForeignCUnion", n, f)
    else:
        bool paren = (f & F_PAREN) != 0
        string8 form = "Union(paren)" if paren else "Union(indented)"
        if (f & F_RAW) != 0: form = "CUnion(paren)" if paren else "CUnion(indented)"
        if (f & F_DISTINCT) != 0:
            if (f & F_RAW) != 0: form = "DistinctCUnion(paren)" if paren else "DistinctCUnion(indented)"
            else: form = "DistinctUnion(paren)" if paren else "DistinctUnion(indented)"
        d.line_vis(form, n, f)
    d.depth += 1
    []u32 k = d.kids(n)
    for i in 1..<#len(k):
        d_member(d, k[i])
    d.depth -= 1

private void debug_quote(^Dumper d, string8 s):
    d.put("\"")
    for c in s:
        if c == '"': d.put("\\\"")
        else if c == '\\': d.put("\\\\")
        else if c == '\n': d.put("\\n")
        else if c == '\t': d.put("\\t")
        else if c == '\r': d.put("\\r")
        else: d.out^ = #append(d.out^, c)
    d.put("\"")

private void c_body_label(^Dumper d, u32 c):
    d.pad()
    d.put("c_body: ")
    d.put(d.text(d.a.main[c]))
    d.put("\n")

private void d_foreign_item(^Dumper d, u32 n):
    ^Ast a = d.a
    switch a.tag[n]:
        case N_F_FN:
            u32 f = a.a[n]
            d.line_vis("ForeignFn", n, f)
            d.depth += 1
            []u32 k = d.kids(n)
            ty(d, "ret", k[0])
            if (f & F_FAILABLE) != 0: d.label("failable")
            if k[1] != NONE: ty(d, "fails", k[1])
            for i in 3..<#len(k):
                u32 q = k[i]
                d.line("", "Param", q)
                d.depth += 1
                if a.a[q] != NONE: ty(d, "type", a.a[q])
                else: d.label("type:inherited")
                d.depth -= 1
            if (f & F_CVAR) != 0: d.label("c-variadic")
            d.depth -= 1
        case N_UNION: union_line(d, n, true)
        case N_F_OPAQUE: d.line_vis("ForeignOpaque", n, a.b[n])
        case N_TYPE:
            d.line_vis("ForeignType", n, a.a[n])
            d.depth += 1
            d_type_body(d, d.kids(n)[2])
            d.depth -= 1
        case N_F_CONST:
            d.line_vis("ForeignConst", n, a.b[n])
            d.depth += 1
            ty(d, "type", a.a[n])
            d.depth -= 1
        case N_F_VAR:
            d.line_vis("ForeignVar", n, a.b[n])
            d.depth += 1
            ty(d, "type", a.a[n])
            d.depth -= 1
        case N_F_ENUM:
            d.line_vis("ForeignEnum", n, a.a[n])
            d.depth += 1
            []u32 k = d.kids(n)
            for i in 2..<#len(k):
                d.line("", "Member", k[i])
            d.depth -= 1
        else:
            d.label("?")

private void d_const_decl(^Dumper d, u32 n):
    u32 f = d.a.a[n]
    d.line_vis("BuildConst" if (f & F_BUILD) != 0 else "Const", n, f)
    d.depth += 1
    []u32 k = d.kids(n)
    if k[0] != NONE: ty(d, "type", k[0])
    ex(d, "value", k[1])
    d.depth -= 1

private void d_param(^Dumper d, u32 q):
    d.line("", "Param(..)" if d.a.tag[q] == N_PARAM_V else "Param", q)
    d.depth += 1
    if d.a.a[q] != NONE: ty(d, "type", d.a.a[q])
    else: d.label("type:inherited")
    if d.a.b[q] != NONE: ex(d, "default", d.a.b[q])
    d.depth -= 1

private void fn_like(^Dumper d, string8 kind, u32 n, bool body):
    ^Ast a = d.a
    u32 f = a.a[n]
    d.line_vis(kind, n, f)
    d.depth += 1
    []u32 k = d.kids(n)
    if k[2] != NONE:
        d.pad()
        d.put("@symbol(")
        []u32 w = d.kids(k[2])
        for i in 0..<#len(w):
            if i > 0: d.put(", ")
            d.put(d.text(a.main[w[i]]))
        d.put(")\n")
    ty(d, "ret", k[0])
    if (f & F_FAILABLE) != 0: d.label("failable")
    if k[1] != NONE: ty(d, "fails", k[1])
    if (f & F_ASYNC) != 0: d.label("async")
    if k[3] != NONE: d.label("receiver:^self" if a.a[k[3]] == 1 else "receiver:self")
    for i in 6..<#len(k):
        d_param(d, k[i])
    if k[4] != NONE: ex(d, "where", k[4])
    if body: d_block(d, k[5])
    d.depth -= 1

private void d_type_body(^Dumper d, u32 b):
    if d.a.tag[b] == N_ALIAS:
        ty(d, "alias", d.a.a[b])
        return
    d.line("", "Members(paren)" if d.a.a[b] == 1 else "Members(indented)", b)
    d.depth += 1
    for m in d.kids(b):
        d_member(d, m)
    d.depth -= 1

private void d_member(^Dumper d, u32 m):
    []u32 k = d.kids(m)
    if d.a.main[m] != NONE:
        d.line("", "Field", m)
        d.depth += 1
        if k[3] != NONE: ex(d, "align", d.a.a[k[3]])
        ty(d, "type", k[0])
        if k[2] != NONE: ex(d, "bits", d.a.a[k[2]])
        d.depth -= 1
    else if k[2] != NONE:
        d.line("", "Bits", m)
        d.depth += 1
        ty(d, "type", k[0])
        ex(d, "bits", d.a.a[k[2]])
        d.depth -= 1
    else:
        d.line("", "Embed", m)
        d.depth += 1
        ty(d, "type", k[0])
        d.depth -= 1

private void ty(^Dumper d, string8 role, u32 t):
    ^Ast a = d.a
    switch a.tag[t]:
        case T_NAME: d.line(role, "TypeName", t)
        case T_REF:
            d.line(role, "Ref", t)
            d.depth += 1
            ty(d, "holds", a.a[t])
            d.depth -= 1
        case T_BOUND: d.line(role, "TypeBound", t)
        case T_BINDING: d.line(role, "TypeBinding", t)
        case T_KIND: d.line(role, "TypeKind", t)
        case T_PACK: d.line(role, "PackMarker", t)
        case T_LAYOUT, T_QUAL:
            d.line(role, "Layout" if a.tag[t] == T_LAYOUT else "Qualified", t)
            d.depth += 1
            ty(d, "of", a.a[t])
            d.depth -= 1
        case T_PATH: d.line(role, "TypePath", t)
        case T_POINTER:
            d.line(role, "Pointer", t)
            d.depth += 1
            ty(d, "pointee", a.a[t])
            d.depth -= 1
        case T_SLICE:
            d.line(role, "Slice", t)
            d.depth += 1
            ty(d, "element", a.a[t])
            d.depth -= 1
        case T_ARRAY:
            d.line(role, "Array", t)
            d.depth += 1
            ex(d, "length", a.a[t])
            ty(d, "element", a.b[t])
            d.depth -= 1
        case T_MATRIX:
            d.line(role, "Matrix", t)
            d.depth += 1
            []u32 k = d.kids(t)
            ex(d, "rows", k[0])
            ex(d, "cols", k[1])
            ty(d, "element", k[2])
            d.depth -= 1
        case T_SHAPEOF:
            d.line(role, "ShapeOf(typeof)" if a.b[t] == 1 else "ShapeOf", t)
            d.depth += 1
            ex(d, "operand", a.a[t])
            d.depth -= 1
        case T_CHANNEL:
            d.line(role, "Channel", t)
            d.depth += 1
            []u32 k = d.kids(t)
            if k[0] != NONE: ex(d, "capacity", k[0])
            for i in 1..<#len(k):
                u32 q = k[i]
                d.line("", "Param", q)
                d.depth += 1
                if a.a[q] != NONE: ty(d, "type", a.a[q])
                else: d.label("type:inherited")
                d.depth -= 1
            d.depth -= 1
        case T_MAP:
            d.line(role, "Map", t)
            d.depth += 1
            ty(d, "key", a.a[t])
            ty(d, "value", a.b[t])
            d.depth -= 1
        case T_TUPLE:
            d.line(role, "TupleType", t)
            d.depth += 1
            for m in d.kids(t):
                d_member(d, m)
            d.depth -= 1
        case T_FN:
            u32 f = a.a[t]
            bool asy = (f & F_ASYNC) != 0
            bool fl = (f & F_FAILABLE) != 0
            string8 form = "FnType"
            if asy && fl: form = "async !FnType"
            else if asy: form = "async FnType"
            else if fl: form = "!FnType"
            d.line(role, form, t)
            d.depth += 1
            []u32 k = d.kids(t)
            ty(d, "ret", k[0])
            if k[1] != NONE: ty(d, "fails", k[1])
            for i in 2..<#len(k):
                ty(d, "param", k[i])
            d.depth -= 1
        else:
            d.label("?type")

private void d_block(^Dumper d, u32 b):
    d.line("", "Block", b)
    d.depth += 1
    for s in d.kids(b):
        d_stmt(d, s)
    d.depth -= 1

private void d_stmt(^Dumper d, u32 s):
    ^Ast a = d.a
    switch a.tag[s]:
        case S_WHEN:
            d.line("", "When", s)
            d.depth += 1
            for arm in d.kids(s):
                if a.tag[arm] == S_WHEN_ARM:
                    d.line("", "arm", arm)
                    d.depth += 1
                    ex(d, "cond", a.a[arm])
                    d_block(d, a.b[arm])
                    d.depth -= 1
                else:
                    d.line("", "else", s)
                    d.depth += 1
                    d_block(d, arm)
                    d.depth -= 1
            d.depth -= 1
        case S_RETURN:
            d.line("", "Return", s)
            if a.a[s] != NONE:
                d.depth += 1
                ex(d, "value", a.a[s])
                d.depth -= 1
        case S_VIEW:
            d.line("", "View", s)
            d.depth += 1
            []u32 k = d.kids(s)
            for i in 0..<#len(k):
                d.pad()
                d.put("slot")
                d.num(u32(i))
                d.put(" ")
                d.span(a.lo[k[i]], a.hi[k[i]])
                d.put("\n")
            d.depth -= 1
        case S_FOR:
            d.line("", "For", s)
            d.depth += 1
            u32 h = a.a[s]
            if h == NONE:
                d.label("header:infinite")
            else if a.tag[h] == S_FOR_IN:
                d.line("", "header:in", h)
                d.depth += 1
                []u32 k = d.kids(h)
                for i in 0..<#len(k) - 1:
                    u32 bnd = k[i]
                    d.pad()
                    d.put("bind")
                    d.num(u32(i))
                    d.put(" ")
                    u32 nm = a.main[bnd]
                    d.span(d.t.start[nm], d.t.end[nm])
                    d.put("\n")
                ex(d, "iterable", k[#len(k) - 1])
                d.depth -= 1
            else:
                ex(d, "header:while", h)
            d_block(d, a.b[s])
            d.depth -= 1
        case S_IF: d_if_stmt(d, s)
        case S_SWITCH:
            d.line("", "Switch", s)
            d.depth += 1
            []u32 k = d.kids(s)
            ex(d, "scrutinee", k[0])
            for i in 2..<#len(k):
                u32 arm = k[i]
                d.line("", "Case", arm)
                d.depth += 1
                []u32 ak = d.kids(arm)
                for j in 1..<#len(ak):
                    ex(d, "value", ak[j])
                d_block(d, ak[0])
                d.depth -= 1
            if k[1] != NONE:
                d.label("else")
                d.depth += 1
                d_block(d, k[1])
                d.depth -= 1
            else:
                d.label("else:absent")
            d.depth -= 1
        case S_SUITE:
            d.line("", "Suite", s)
            d.depth += 1
            d_using_head(d, "subject", a.a[s])
            d_block(d, a.b[s])
            d.depth -= 1
        case S_DEFER:
            string8 form = "Defer"
            if a.b[s] != NONE: form = "Defer fail"
            else if a.main[s] != NONE: form = "Defer!"
            d.line("", form, s)
            d.depth += 1
            d_stmt(d, a.a[s])
            d.depth -= 1
        case S_BREAK: d.line("", "Break", s)
        case S_CONTINUE: d.line("", "Continue", s)
        case S_PASS: d.line("", "Pass", s)
        case S_FALLTHROUGH: d.line("", "Fallthrough", s)
        case S_QUIT, S_FAIL:
            d.line("", "Quit" if a.tag[s] == S_QUIT else "Fail", s)
            d.depth += 1
            ex(d, "status" if a.tag[s] == S_QUIT else "code", a.a[s])
            d.depth -= 1
        case S_AWAIT:
            d.line("", "Await", s)
            d.depth += 1
            d_stmt(d, a.a[s])
            d.depth -= 1
        case S_ASSERT:
            d.line("", "Assert", s)
            d.depth += 1
            ex(d, "cond", a.a[s])
            if a.b[s] != NONE: ex(d, "message", a.b[s])
            d.depth -= 1
        case S_TRY:
            d.line("", "Try", s)
            d.depth += 1
            d_stmt(d, a.a[s])
            u32 e = a.b[s]
            if e != NONE:
                d.line("", "else", e)
                d.depth += 1
                if a.b[e] == 1: ex(d, "code", a.a[e])
                else: d_block(d, a.a[e])
                d.depth -= 1
            d.depth -= 1
        case S_LET:
            d.line("", "Let" if a.main[s] != NONE else "Let:destructuring", s)
            d.depth += 1
            []u32 k = d.kids(s)
            if k[2] != NONE: c_body_label(d, k[2])
            ty(d, "type", k[0])
            if k[1] != NONE: ex(d, "value", k[1])
            d.depth -= 1
        case N_CONST: d_const_decl(d, s)
        case S_ASSIGN:
            d.line("", "Assign", s)
            d.depth += 1
            []u32 k = d.kids(s)
            ex(d, "place", k[0])
            ex(d, "value", k[1])
            d.depth -= 1
        case S_EXPR:
            d.line("", "ExprStmt", s)
            d.depth += 1
            ex(d, "expr", a.a[s])
            d.depth -= 1
        else:
            d.label("?stmt")

private void d_if_stmt(^Dumper d, u32 s):
    d.line("", "If", s)
    d.depth += 1
    []u32 k = d.kids(s)
    ex(d, "cond", k[0])
    d_block(d, k[1])
    if k[2] != NONE:
        if d.a.tag[k[2]] == S_IF:
            d.label("else-if")
            d.depth += 1
            d_if_stmt(d, k[2])
            d.depth -= 1
        else:
            d.label("else")
            d.depth += 1
            d_block(d, k[2])
            d.depth -= 1
    d.depth -= 1

private void elements(^Dumper d, string8 kind, string8 role, string8 each, u32 e):
    d.line(role, kind, e)
    d.depth += 1
    for x in d.kids(e):
        ex(d, each, x)
    d.depth -= 1

private void pair(^Dumper d, string8 kind, string8 role, string8 r1, string8 r2, u32 e):
    d.line(role, kind, e)
    d.depth += 1
    ex(d, r1, d.a.a[e])
    ex(d, r2, d.a.b[e])
    d.depth -= 1

private void ex(^Dumper d, string8 role, u32 e):
    ^Ast a = d.a
    switch a.tag[e]:
        case E_INT: d.line(role, "Int", e)
        case E_FLOAT: d.line(role, "Float", e)
        case E_STR: d.line(role, "Str", e)
        case E_CHAR: d.line(role, "Char", e)
        case E_NAME: d.line(role, "Name", e)
        case E_TUPLE: elements(d, "Tuple", role, "element", e)
        case E_ARRAY: elements(d, "Array", role, "element", e)
        case E_IN: pair(d, "In", role, "key", "map", e)
        case E_IS: pair(d, "Is", role, "subject", "type", e)
        case E_HAS:
            d.line(role, "Has", e)
            d.depth += 1
            []u32 k = d.kids(e)
            ex(d, "subject", k[0])
            if a.a[e] == 1:
                ex(d, "name", k[1])
            else:
                for i in 1..<#len(k):
                    u32 w = k[i]
                    d.pad()
                    d.put("operator \"")
                    for tk in a.main[w]..<a.a[w] + 1:
                        d.put(d.text(tk))
                    d.put("\" ")
                    d.num(a.lo[w])
                    d.put("..")
                    d.num(a.hi[w])
                    d.put("\n")
            d.depth -= 1
        case E_MAP:
            d.line(role, "Map", e)
            d.depth += 1
            for x in d.kids(e):
                d.line("", "entry", x)
                d.depth += 1
                ex(d, "key", a.a[x])
                ex(d, "value", a.b[x])
                d.depth -= 1
            d.depth -= 1
        case E_CALL:
            d.line(role, "Call", e)
            d.depth += 1
            []u32 k = d.kids(e)
            ex(d, "callee", k[0])
            for i in 2..<#len(k):
                u32 g = k[i]
                d.line("", "Arg" if a.main[g] == NONE else "Arg:named", g)
                d.depth += 1
                ex(d, "value", a.a[g])
                d.depth -= 1
            if k[1] != NONE: d_using_head(d, "using", k[1])
            d.depth -= 1
        case E_FIELD:
            d.line(role, "Field", e)
            d.depth += 1
            ex(d, "base", a.a[e])
            d.depth -= 1
        case E_INDEX: pair(d, "Index", role, "base", "index", e)
        case E_SLICE:
            d.line(role, "Slice", e)
            d.depth += 1
            []u32 k = d.kids(e)
            ex(d, "base", k[0])
            if k[1] != NONE: ex(d, "start", k[1])
            if k[2] != NONE: ex(d, "end", k[2])
            d.depth -= 1
        case E_UNARY, E_DEREF:
            d.line(role, "Unary", e)
            d.depth += 1
            ex(d, "operand", a.a[e])
            d.depth -= 1
        case E_BINARY: pair(d, "Binary", role, "lhs", "rhs", e)
        case E_SPLAT:
            d.line(role, "Splat", e)
            d.depth += 1
            ex(d, "operand", a.a[e])
            d.depth -= 1
        case E_NARROW:
            d.line(role, "Narrow", e)
            d.depth += 1
            ex(d, "base", a.a[e])
            ty(d, "member", a.b[e])
            d.depth -= 1
        case E_LAMBDA:
            d.line(role, "Lambda" if a.a[e] == NONE else "async Lambda", e)
            d.depth += 1
            []u32 k = d.kids(e)
            ty(d, "ret", k[0])
            for i in 2..<#len(k):
                d_param(d, k[i])
            d_block(d, k[1])
            d.depth -= 1
        case E_COND:
            d.line(role, "Cond", e)
            d.depth += 1
            []u32 k = d.kids(e)
            ex(d, "then", k[0])
            ex(d, "cond", k[1])
            ex(d, "else", k[2])
            d.depth -= 1
        case E_TYPE:
            d.line(role, "TypeArg", e)
            d.depth += 1
            ty(d, "type", a.a[e])
            d.depth -= 1
        case E_RANGE: pair(d, "Range", role, "start", "end", e)
        else:
            d.label("?expr")

private void d_using_head(^Dumper d, string8 role, u32 u):
    []u32 k = d.kids(u)
    if k[0] != NONE: ex(d, role, k[0])
    for i in 1..<#len(k):
        u32 s = k[i]
        d.pad()
        d.put(role)
        d.put(":sink ")
        d.span(d.a.lo[s], d.a.hi[s])
        d.put("\n")
        d.depth += 1
        ex(d, "value", d.a.a[s])
        d.depth -= 1
