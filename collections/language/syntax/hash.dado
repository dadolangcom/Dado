// Item hashes: per top-level item, a 128-bit `sig` (its significant tokens
// outside function bodies; all of them for a template) and `body` (those in
// its bodies), over item-relative positions, so a moved item keeps both.
package syntax

private type H128:
    u64 a
    u64 b

    void mix(^self, u64 x):
        self.a = rotl(self.a ~ x, 29) * 0x9E3779B97F4A7C15
        self.b = rotl(self.b + x * 0xC2B2AE3D27D4EB4F, 31) * 0x165667B19E3779F9

private u64 rotl(u64 x, u64 n):
    return (x << n) | (x >> (64 - n))

private u64 fmix(u64 k):
    u64 x = k
    x = (x ~ (x >> 33)) * 0xFF51AFD7ED558CCD
    x = (x ~ (x >> 33)) * 0xC4CEB9FE1A85EC53
    return x ~ (x >> 33)

// Byte ranges of the function bodies under node `n`, appended as pairs.
private void bodies(^Ast a, u32 n, ^ref []u32 out, ^ref []u32 stack):
    #truncate(stack^, 0)
    stack^ = #append(stack^, n)
    for #len(stack^) > 0:
        u32 x = stack^[#len(stack^) - 1]
        #truncate(stack^, #len(stack^) - 1)
        u8 g = a.tag[x]
        if g == N_FN:
            u32 body = a.list(a.b[x])[5]
            if body != NONE:
                out^ = #append(out^, a.lo[body])
                out^ = #append(out^, a.hi[body])
            continue
        if g == N_TYPE || g == N_TRAIT || g == N_CLASS || g == N_WHEN || g == N_WHEN_ARM || g == N_WHEN_ELSE:
            i64 before = #len(stack^)
            a.kids(x, stack)
            if #len(stack^) == before: continue

private bool template(^Ast a, u32 n, ^ref []u32 stack):
    #truncate(stack^, 0)
    stack^ = #append(stack^, n)
    for #len(stack^) > 0:
        u32 x = stack^[#len(stack^) - 1]
        #truncate(stack^, #len(stack^) - 1)
        u8 g = a.tag[x]
        if g == T_BINDING || g == T_BOUND || g == T_PACK || g == N_BINDER: return true
        if g == T_ARRAY && a.main[x] != NONE: return true
        if g == T_MATRIX && (a.main[x] != NONE || a.a[x] != NONE): return true
        if g == S_BLOCK: continue
        a.kids(x, stack)
    return false

void item_hashes(^Ast a, string8 src, ^Tokens t):
    ref []u32 ranges
    ref []u32 stack
    []u32 top = a.list(a.b[a.root])
    for n in top:
        if n == NONE: continue
        u8 g = a.tag[n]
        if g == N_TEST || g == N_PACKAGE || g == N_SCRIPT || g == N_IMPORT: continue
        #truncate(ranges, 0)
        bodies(a, n, &ranges, &stack)
        bool whole = template(a, n, &stack)
        u32 lo = a.lo[n]
        u32 hi = a.hi[n]
        H128 sig = H128(0x243F6A8885A308D3, 0x13198A2E03707344)
        H128 body = H128(0xA4093822299F31D0, 0x082EFA98EC4E6C89)
        sig.mix(u64(g))
        i64 i = token_at(t, lo)
        for i < #len(t.tag) && t.start[i] < hi:
            u8 k = t.tag[i]
            if k <= EOF:
                i += 1
                continue
            u32 s = t.start[i]
            bool inside = false
            i64 r = 0
            for r + 1 < #len(ranges):
                if s >= ranges[r] && s < ranges[r + 1]:
                    inside = true
                    break
                r += 2
            u64 x = u64(k) | (u64(s - lo) << 8) | (u64(t.end[i] - s) << 40)
            if inside: body.mix(x)
            if !inside || whole: sig.mix(x)
            if has_text(k):
                for c in src[i64(s)..<i64(t.end[i])]:
                    if inside: body.mix(u64(u8(c)))
                    if !inside || whole: sig.mix(u64(u8(c)))
            i += 1
        a.hashes = #append(a.hashes, u64(n))
        a.hashes = #append(a.hashes, fmix(sig.a))
        a.hashes = #append(a.hashes, fmix(sig.b ~ sig.a))
        a.hashes = #append(a.hashes, fmix(body.a))
        a.hashes = #append(a.hashes, fmix(body.b ~ body.a))
    #delete(ranges)
    #delete(stack)
