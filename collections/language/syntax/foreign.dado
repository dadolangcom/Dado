// Attributes, string checks, channels, `foreign` blocks, classes and
// script headers, keyword names, and the type unparser messages quote.
package syntax

// -- strings -------------------------------------------------------------

// dado_ast's string_body: a literal's text between its quotes, a
// multi-line one's margin stripped; escapes are kept.
void string_body(string8 w, ^ref []char8 out):
    i64 n = #len(w)
    bool multi = n >= 3 && w[0..<3] == "\"\"\""
    if !multi:
        if n >= 2 && w[0] == '"' && w[n - 1] == '"':
            out^ = #append(out^, ..w[1..<n - 1])
        else:
            out^ = #append(out^, ..w)
        return
    if n < 6 || w[n - 3..<n] != "\"\"\"":
        out^ = #append(out^, ..w)
        return
    string8 inner = w[3..<n - 3]
    i64 first = 0
    for first < #len(inner) && inner[first] != '\n':
        first += 1
    i64 last = #len(inner)
    for last > 0 && inner[last - 1] != '\n':
        last -= 1
    if first >= #len(inner):
        out^ = #append(out^, ..inner)
        return
    string8 margin = inner[last..<#len(inner)]
    if last <= first:
        return
    i64 i = first + 1
    bool lead = true
    for i < last:
        i64 e = i
        for inner[e] != '\n':
            e += 1
        string8 line = inner[i..<e]
        i = e + 1
        if !lead: out^ = #append(out^, '\n')
        lead = false
        if #len(line) > 0 && line[#len(line) - 1] == '\r': line = line[0..<#len(line) - 1]
        if blank(line): continue
        if #len(line) >= #len(margin) && line[0..<#len(margin)] == margin:
            out^ = #append(out^, ..line[#len(margin)..<#len(line)])
        else:
            i64 k = 0
            for k < #len(line) && (line[k] == ' ' || line[k] == '\t' || line[k] == '\r' || line[k] == '\n'):
                k += 1
            out^ = #append(out^, ..line[k..<#len(line)])

private void fault(^Parser p, u16 code, u32 t, i64 a, i64 b):
    u32 base = p.st[t]
    u32 end = p.en[t]
    u32 lo = base + u32(a)
    if lo > end: lo = end
    u32 hi = base + u32(b)
    if hi > end: hi = end
    if hi < lo: hi = lo
    p.begin(code, lo, hi)

// dado_ast's literal_faults (ERR0112) and, for a multi-line literal,
// escape_faults (ERR0107).
void check_string(^Parser p, u32 t):
    string8 w = p.text(t)
    i64 n = #len(w)
    if n < 3 || w[0..<3] != "\"\"\"": return
    if n >= 6 && w[n - 3..<n] == "\"\"\"":
        string8 inner = w[3..<n - 3]
        i64 h = 0
        for h < #len(inner) && inner[h] != '\n':
            h += 1
        string8 head = inner[0..<h]
        if !blank(head):
            fault(p, 112, t, 3, 3 + h)
            p.say("nothing follows the opening `\"\"\"` on its line: the text of a multi-line string begins on the line after it")
        if h >= #len(inner):
            if blank(head):
                fault(p, 112, t, 0, n)
                p.say("a multi-line string opens on one line, holds its text on the lines after it, and closes on a line of its own; `\"\"` is the empty string")
        else:
            i64 last = #len(inner)
            for last > 0 && inner[last - 1] != '\n':
                last -= 1
            string8 margin = inner[last..<#len(inner)]
            i64 at = 3 + h + 1
            bool blank_margin = true
            for c in margin:
                if c != ' ' && c != '\t': blank_margin = false
            if !blank_margin:
                i64 s = 3 + #len(inner) - #len(margin)
                fault(p, 112, t, s, s + #len(margin))
                p.say("the closing `\"\"\"` stands alone on its line, because its own indentation is the margin every line of the text is measured against")
            i64 i = h + 1
            for i < last:
                i64 e = i
                for inner[e] != '\n':
                    e += 1
                string8 line = inner[i..<e]
                i64 line_end = at + #len(line)
                string8 text = line
                if #len(text) > 0 && text[#len(text) - 1] == '\r': text = text[0..<#len(text) - 1]
                bool starts = #len(text) >= #len(margin) && text[0..<#len(margin)] == margin
                if !blank(text) && !starts:
                    fault(p, 112, t, at, line_end)
                    p.say("this line is less indented than the closing `\"\"\"`, which sets the margin at ")
                    p.num(u64(#len(margin)))
                    p.say(" character" if #len(margin) == 1 else " characters")
                    p.say(" and strips it from every line")
                at = line_end + 1
                i = e + 1
    string8 body = w[3..<n]
    if n >= 6 && w[n - 3..<n] == "\"\"\"": body = w[3..<n - 3]
    else: body = w
    i64 open = 3 if n >= 6 && w[n - 3..<n] == "\"\"\"" else 0
    i64 i = 0
    i64 m = #len(body)
    for i < m:
        if body[i] != '\\':
            i += 1
            continue
        i64 s = open + i
        if i + 1 >= m:
            fault(p, 107, t, s, s + 1)
            p.say("a `\\` at the end of a string literal escapes nothing; `\\\\` is a backslash")
            i += 1
            continue
        char8 c = body[i + 1]
        if c == 'n' || c == 'r' || c == 't' || c == '0' || c == '\\' || c == '"' || c == '\'':
            i += 2
        else if c == 'x':
            bool ok = i + 3 < m && is_hex(body[i + 2]) && is_hex(body[i + 3])
            if ok:
                i += 4
            else:
                fault(p, 107, t, s, s + 2)
                p.say("`\\x` needs exactly two hex digits")
                i += 2
        else:
            i64 wd = utf8_len(c)
            if i + 1 + wd > m: wd = m - i - 1
            fault(p, 107, t, s, s + 1 + wd)
            p.say("unknown escape `")
            p.say(body[i..<i + 1 + wd])
            p.say("`")
            i += 1 + wd

private bool is_hex(char8 c):
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')

private i64 utf8_len(char8 c):
    u8 b = u8(c)
    if b < 0xC0: return 1
    if b < 0xE0: return 2
    if b < 0xF0: return 3
    return 4

bool c_identifier(string8 s):
    if #len(s) == 0: return false
    char8 f = s[0]
    if !((f >= 'a' && f <= 'z') || (f >= 'A' && f <= 'Z') || f == '_'): return false
    for c in s:
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'): return false
    return true

private bool tag_word(string8 s):
    return s == "struct" || s == "union" || s == "enum"

bool c_type_name(string8 s):
    if tag_word(s): return false
    if c_identifier(s): return true
    for i in 0..<#len(s):
        if s[i] == ' ':
            return tag_word(s[0..<i]) && c_identifier(s[i + 1..<#len(s)])
    return false

// -- attributes ----------------------------------------------------------

// `@c("name")`: bumps through `)`, answering N_C_NAME (BAD on a missing
// piece); `ok` says whether the text passes `check`.
private u32 c_name_text(^Parser p, u32 kind):
    u32 at = p.bump()
    _ = p.bump()
    if p.expect(LPAREN) == BAD: return BAD
    u32 t = p.expect(STRING)
    if t == BAD: return BAD
    u32 close = p.expect(RPAREN)
    if close == BAD: return BAD
    check_string(p, t)
    ref []char8 text
    string_body(p.text(t), &text)
    string8 s = text
    bool ok = c_type_name(s) if kind == 1 else c_identifier(s)
    if !ok:
        p.begin(1014, p.st[t], p.en[t])
        p.say("`@c(\"")
        p.say(s)
        if kind == 1:
            p.say("\")` is not a name a C header could give a type\x1fA qualifier, a pointer or a second word is C's grammar rather than C's name, and Dado writes those itself\x1ewrite a C identifier, or `struct`, `union` or `enum` and one — `struct timespec`")
        else if kind == 0:
            p.say("\")` is the name a C header gave this member, and that is a C identifier — a letter or `_`, then letters, digits and `_`. A member C cannot name is one Dado cannot restate; declare the type opaque")
        else if kind == 2:
            p.say("\")` is the name a C header gave this enumerator, and that is a C identifier — a letter or `_`, then letters, digits and `_`. An enumerator is a constant, so `enum`, `struct` and `union` are no part of its name")
        else:
            p.say("\")` is the name a C header gave this function, and that is a C identifier — a letter or `_`, then letters, digits and `_`. A function is not a type, so `struct`, `union` and `enum` are no part of its name")
        p.seal_diag()
        #delete(text)
        return NONE
    #delete(text)
    return p.node(N_C_NAME, t, NONE, NONE, p.st[at], p.en[close])

private bool at_c(^Parser p):
    return p.kind(1) == IDENT && p.word(1) == W_C

// A slot's `@c("…")` (kind 0), a type's (1), an enumerator's (2), a function's (3).
u32 c_name_attr(^Parser p, u32 kind, bool allowed):
    if !p.at(AT): return NONE
    if !at_c(p) || !allowed:
        _ = type_core(p)
        return BAD
    return c_name_text(p, kind)

u32 slot_c_name(^Parser p, bool fgn):
    return c_name_attr(p, 0, fgn)

u32 foreign_type_c_name(^Parser p):
    return c_name_attr(p, 1, true)

u32 align_attr(^Parser p):
    if !p.at(AT): return NONE
    u32 w = NONE
    if p.kind(1) == IDENT: w = p.word(1)
    if w == W_SYMBOL || w == W_C_BODY || w == W_THREAD_LOCAL: return NONE
    if w != W_ALIGN:
        _ = type_core(p)
        return BAD
    u32 at = p.bump()
    _ = p.bump()
    if p.expect(LPAREN) == BAD: return BAD
    u32 v = expr(p)
    if v == BAD: return BAD
    u32 close = p.expect(RPAREN)
    if close == BAD: return BAD
    return p.node(N_ALIGN, at, v, NONE, p.st[at], p.en[close])

// `@symbol(…)` in a `foreign` block: refused; BAD when written.
u32 foreign_symbol_attr(^Parser p):
    if !p.at(AT) || p.kind(1) != IDENT || p.word(1) != W_SYMBOL: return 0
    u32 at = p.peek()
    p.error(1027, p.st[at], p.en[at + 1], "a `foreign` declaration restates a function C has already defined, so its symbol is the header's and not this program's\x1f`@symbol(…)` says what the C compiler must be told about a definition Dado emits\x1ewrite the attribute in C, beside the definition")
    return BAD

private u32 marker_attr(^Parser p, u32 w, u8 tag):
    if !p.at(AT) || p.kind(1) != IDENT || p.word(1) != w: return NONE
    u32 at = p.bump()
    u32 word = p.bump()
    return p.node(tag, word, NONE, NONE, p.st[at], p.en[word])

u32 symbol_attr(^Parser p):
    if !p.at(AT) || p.kind(1) != IDENT || p.word(1) != W_SYMBOL: return NONE
    u32 at = p.bump()
    _ = p.bump()
    if p.expect(LPAREN) == BAD: return BAD
    i64 base = p.base()
    bool seen_noinline = false
    bool seen_nosan = false
    for:
        u32 t = p.expect(IDENT)
        if t == BAD:
            p.drop(base)
            return BAD
        u32 w = p.sym[t]
        bool known = w == W_NOINLINE || w == W_NO_SANITIZE
        bool seen = (w == W_NOINLINE && seen_noinline) || (w == W_NO_SANITIZE && seen_nosan)
        if known && seen:
            p.begin(1027, p.st[t], p.en[t])
            p.say("`")
            p.say_tok(t)
            p.say("` is already written in this `@symbol(…)`, and saying it twice says nothing the once did not")
            p.seal_diag()
        else if known:
            if w == W_NOINLINE: seen_noinline = true
            else: seen_nosan = true
            p.push(p.leaf(N_WORD, t))
        else:
            p.begin(1027, p.st[t], p.en[t])
            p.say("`")
            p.say_tok(t)
            p.say("` is not a symbol attribute this compiler registers\x1fA symbol attribute is a property of the emitted symbol that no Dado type can state and whose absence is a defect, not a slower program. A program cannot introduce one\x1ewrite one of the set: `noinline` and `no_sanitize_address`")
            p.seal_diag()
        if p.at(COMMA):
            _ = p.bump()
            continue
        break
    u32 close = p.expect(RPAREN)
    if close == BAD:
        p.drop(base)
        return BAD
    return p.node(N_SYMBOL, at, NONE, p.seal(base), p.st[at], p.en[close])

u32 thread_local_attr(^Parser p):
    return marker_attr(p, W_THREAD_LOCAL, N_THREAD_LOCAL)

bool at_c_body(^Parser p):
    return p.at(AT) && p.kind(1) == IDENT && p.word(1) == W_C_BODY

u32 c_body_attr(^Parser p):
    if !at_c_body(p): return NONE
    u32 at = p.bump()
    _ = p.bump()
    if p.expect(LPAREN) == BAD: return BAD
    u32 t = p.expect(STRING)
    if t == BAD: return BAD
    u32 close = p.expect(RPAREN)
    if close == BAD: return BAD
    check_shape_only(p, t)
    no_local_names(p, t)
    return p.node(N_C_BODY, t, NONE, NONE, p.st[at], p.en[close])

// literal_shape alone: the multi-line faults, not the escape ones.
private void check_shape_only(^Parser p, u32 t):
    i64 d = p.ndiags()
    check_string(p, t)
    i64 k = d
    for k < p.ndiags():
        if p.ast.diags[k].code == 107:
            for j in k + 1..<p.ndiags():
                p.ast.diags[j - 1] = p.ast.diags[j]
            #truncate(p.ast.diags, p.ndiags() - 1)
        else:
            k += 1

private void no_local_names(^Parser p, u32 t):
    string8 w = p.text(t)
    i64 i = 0
    for i + 7 <= #len(w):
        if w[i..<i + 7] != "dado_l_":
            i += 1
            continue
        bool before = i > 0 && name_char(w[i - 1])
        if !before:
            i64 e = i
            for e < #len(w) && name_char(w[e]):
                e += 1
            fault(p, 1028, t, i, e)
            p.say("`")
            p.say(w[i..<e])
            p.say("` is how the emitter spells a Dado local, and inline C may not name one")
            p.help("pass what the C needs through a `private` package-level variable or a function")
        i += 7

private bool name_char(char8 c):
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'

// -- channels ------------------------------------------------------------

bool at_channel_head(^Parser p):
    u32 w = p.word(0)
    return p.at(HASH_NAME) && (w == H_CHANNEL || w == H_SIGNAL) && p.kind(1) == LPAREN

u32 channel_item(^Parser p, u32 vis):
    u32 start = p.peek()
    u32 sg = channel_named(p)
    if sg == BAD: return BAD
    if p.expect(NEWLINE) == BAD: return BAD
    i64 base = p.base()
    p.push(sg)
    p.push(NONE)
    p.push(NONE)
    p.push(NONE)
    p.push(NONE)
    return p.node(N_VAR, p.ast.main[sg], vis, p.seal(base), p.st[start], p.hi(sg))

u32 channel_member(^Parser p):
    u32 sg = channel_named(p)
    if sg == BAD: return BAD
    i64 base = p.base()
    p.push(sg)
    p.push(NONE)
    p.push(NONE)
    p.push(NONE)
    return p.node(N_MEMBER, p.ast.main[sg], NONE, p.seal(base), p.lo(sg), p.hi(sg))

private u32 channel_named(^Parser p):
    u32 word = p.bump()
    if p.expect(LPAREN) == BAD: return BAD
    i64 base = p.base()
    u32 latest = NONE
    if p.at(IDENT) && p.word(0) == W_LATEST && p.kind(1) == RPAREN:
        latest = p.bump()
        p.push(NONE)
    else:
        u32 e = expr(p)
        if e == BAD: return BAD
        p.push(e)
    if p.expect(RPAREN) == BAD || p.ident("a channel name") == BAD:
        p.drop(base)
        return BAD
    u32 name = u32(p.pos - 1)
    if p.expect(LPAREN) == BAD:
        p.drop(base)
        return BAD
    if !p.at(RPAREN):
        for:
            u32 q = param(p, false)
            if q == BAD:
                p.drop(base)
                return BAD
            p.push(q)
            if p.at(COMMA): _ = p.bump()
            else: break
    u32 close = p.expect(RPAREN)
    if close == BAD:
        p.drop(base)
        return BAD
    return p.node(T_CHANNEL, name, latest, p.seal(base), p.st[word], p.en[close])

void channel_misplaced(^Parser p, string8 what):
    u32 t = p.peek()
    p.begin(528, p.st[t], p.en[t])
    p.say("a channel is one mailbox at one address, named after the declaration that holds it, and ")
    p.say(what)
    p.say(" declares nothing for it to be named after")
    p.help("declare it at package level — `#channel(8) name(i32 x)` — or as a named member of a `type`, and reach it through that declaration, or through a `^` to the type holding it")

// -- foreign -------------------------------------------------------------

u32 foreign_block(^Parser p, u32 vis, u32 free):
    u32 kw = p.bump()
    i64 base = p.base()
    p.push(NONE)
    if p.at(IDENT):
        u32 b = p.ident("a foreign block binding name")
        if b == BAD:
            p.drop(base)
            return BAD
        p.scratch[base] = p.leaf(N_WORD, b)
    u32 t = p.expect(STRING)
    if t == BAD:
        p.drop(base)
        return BAD
    check_string(p, t)
    u32 end = p.en[t]
    i64 clauses = p.base()
    foreign_clauses(p)
    if p.base() > clauses: end = p.hi(p.scratch[p.base() - 1])
    i64 items = p.base()
    u32 r = 0
    if p.at(COLON):
        _ = p.bump()
        r = foreign_items(p)
    else if p.base() > clauses && (p.at(NEWLINE) || p.at(EOF)):
        r = 0
    else:
        if p.expect(COLON) == BAD:
            r = BAD
        else:
            r = foreign_items(p)
    if r == BAD:
        p.drop(base)
        return BAD
    if p.base() > items: end = p.hi(p.scratch[p.base() - 1])
    u32 flags = vis
    u32 lo = p.st[kw]
    if free != NONE:
        flags = flags | F_FREE
        lo = p.st[free]
    return p.node(N_FOREIGN, t, flags, p.seal(base), lo, join_hi(lo, end))

private void foreign_clauses(^Parser p):
    for p.at(IDENT) && p.kind(1) == STRING:
        u32 w = p.word(0)
        if w != W_DEFINE && w != W_FLAGS && w != W_LINK: break
        u32 word = p.bump()
        u32 t = p.bump()
        check_string(p, t)
        if w == W_DEFINE:
            ref []char8 text
            string_body(p.text(t), &text)
            string8 s = text
            i64 e = 0
            for e < #len(s) && s[e] != '=':
                e += 1
            if !c_identifier(s[0..<e]):
                p.begin(1010, p.st[t], p.en[t])
                p.say("`define \"")
                p.say(s)
                p.say("\"` is not a macro definition; write `NAME` or `NAME=replacement`")
                p.seal_diag()
            #delete(text)
        p.push(p.node(N_CLAUSE, word, t, NONE, p.st[t], p.en[t]))

private u32 foreign_items(^Parser p):
    if p.at(NEWLINE): _ = p.bump()
    if !p.at(INDENT):
        u32 t = p.peek()
        p.begin(202, p.st[t], p.en[t])
        p.say("expected an indented `foreign` body, found ")
        p.say_kind(p.tg[t])
        p.seal_diag()
        return BAD
    _ = p.bump()
    for:
        p.skip_newlines()
        if p.at(DEDENT) || p.at(EOF): break
        i64 keep = p.base()
        u32 it = foreign_item(p)
        p.drop(keep)
        if it != BAD: p.push(it)
        else if !p.recover_to_stmt(): break
    if p.at(DEDENT): _ = p.bump()
    return 0

private u32 foreign_item(^Parser p):
    u32 vis = visibility(p)
    if p.at(KW_TYPE): return foreign_type(p, vis)
    if p.at(KW_CONST) && !const_opens_a_signature(p): return foreign_const(p, vis)
    if p.at(KW_ENUM): return foreign_enum(p, vis)
    if at_cunion_head(p): return cunion_decl(p, vis, true)
    if at_union_head(p):
        u32 w = p.peek()
        p.begin(1024, p.st[w], p.en[w])
        p.say("a `foreign` block restates what C provides, and C's union carries no discriminant — write `cunion ")
        p.say_tok(w + 1)
        p.say(":`, whose members are read and written by name with no guard. Dado's `union` stays discriminated and stays native")
        p.seal_diag()
        return BAD
    return foreign_fn_or_var(p, vis)

private bool const_opens_a_signature(^Parser p):
    i64 depth = 0
    i64 n = 1
    for:
        u8 k = p.kind(n)
        if k == NEWLINE || k == EOF || k == COLON: return false
        if k == LPAREN && depth == 0:
            u8 name = p.kind(n - 1)
            u8 before = p.kind(n - 2)
            if before == AT:
                depth += 1
                n += 1
                continue
            return n >= 3 && name == IDENT && (before == IDENT || before == RBRACKET || before == RPAREN)
        if k == LPAREN || k == LBRACKET:
            depth += 1
        else if k == RPAREN || k == RBRACKET:
            if depth > 0: depth -= 1
        n += 1
    return false

private u32 foreign_fn_or_var(^Parser p, u32 vis):
    u32 start = p.peek()
    if foreign_symbol_attr(p) == BAD: return BAD
    u32 mac = marker_attr(p, W_MACRO, N_WORD)
    u32 ret = type_expr_marked(p)
    if ret == BAD: return BAD
    u32 fl = p.tm_lo
    u32 fh = p.tm_hi
    u32 failure = p.head_failure
    p.head_failure = NONE
    if p.head_async != NONE:
        u32 m = p.head_async
        p.head_async = NONE
        p.error_help(201, p.st[m], p.en[m], "`async` marks a DadoScript function, and a `foreign` declaration restates one C wrote, which C never marks", "drop `async`")
    if fl != NONE && mac != NONE:
        p.error_help(1030, fl, fh, "a `foreign` function marked `@macro` may not be marked failable", "declare the C name as C wrote it, and wrap it in a Dado function marked `!` that decides what counts as a failure")
        fl = NONE
        failure = NONE
    if foreign_symbol_attr(p) == BAD: return BAD
    u32 c = c_name_attr(p, 3, true)
    if c == BAD: return BAD
    u32 name = p.ident("a foreign function or object name")
    if name == BAD: return BAD
    if p.at(LPAREN):
        return foreign_fn(p, vis, start, ret, name, c, mac, fl, failure)
    if fl != NONE: p.error(523, fl, fh, failure_stored())
    if mac != NONE:
        p.error_help(418, p.lo(mac), p.hi(mac), "`@macro` marks a `foreign` **function** the header spells as a macro, and this is an object", "drop the attribute")
        return BAD
    if c != NONE:
        p.error(418, p.lo(c), p.hi(c), "`@c(…)` renames a C **function**, a slot of a transparent `foreign` type, or such a type itself — not a `foreign` object, which is restated under the name C gave it. Drop the attribute and name the declaration `errno`, or declare the object in a `.c` sidecar under the name you want")
        return BAD
    _ = p.expect(NEWLINE)
    return p.node(N_F_VAR, name, ret, vis, p.st[start], join_hi(p.st[start], p.en[name]))

private u32 foreign_type(^Parser p, u32 vis):
    u32 kw = p.bump()
    u32 inc = NONE
    if p.at(AT) && p.kind(1) == IDENT && p.word(1) == W_INCOMPLETE:
        u32 at = p.bump()
        u32 w = p.bump()
        inc = p.node(N_WORD, w, NONE, NONE, p.st[at], p.en[w])
    u32 c = foreign_type_c_name(p)
    if c == BAD: return BAD
    u32 name = p.ident("a foreign type name")
    if name == BAD: return BAD
    if !p.at(COLON):
        _ = p.expect(NEWLINE)
        u32 flags = vis
        if inc != NONE: flags = flags | F_INCOMPLETE
        return p.node(N_F_OPAQUE, name, c, flags, p.st[kw], p.en[name])
    if inc != NONE:
        p.error(418, p.lo(inc), p.hi(inc), "`@incomplete` says the header declares this type and never defines it, so there is nothing to restate — a `foreign` type written with a body is complete by construction. Drop the `@incomplete`, or drop the body")
    _ = p.bump()
    u32 body = type_body(p, true)
    if body == BAD: return BAD
    i64 base = p.base()
    p.push(c)
    p.push(NONE)
    p.push(body)
    return p.node(N_TYPE, name, vis, p.seal(base), p.st[kw], join_hi(p.en[kw], p.hi(body)))

private u32 foreign_const(^Parser p, u32 vis):
    u32 kw = p.bump()
    u32 ty = type_expr(p)
    if ty == BAD: return BAD
    u32 name = p.ident("a foreign constant name")
    if name == BAD: return BAD
    _ = p.expect(NEWLINE)
    return p.node(N_F_CONST, name, ty, vis, p.st[kw], p.en[name])

private u32 foreign_enum(^Parser p, u32 vis):
    u32 kw = p.bump()
    u32 c = foreign_type_c_name(p)
    if c == BAD: return BAD
    u32 first = type_expr(p)
    if first == BAD: return BAD
    u32 backing = NONE
    u32 name = NONE
    if p.at(IDENT):
        name = p.ident("a foreign enum name")
        if name == BAD: return BAD
        backing = first
    else:
        if p.at(AT):
            u32 at = p.peek()
            ref []char8 ty
            unparse_type(p, first, &ty)
            p.begin(201, p.st[at], p.en[at])
            p.say("a `foreign enum` head is `enum @c(\"…\") ")
            p.say(ty)
            p.say(" Name:` — the C name first, as on every `foreign` type, then the backing, then the Dado name")
            p.seal_diag()
            #delete(ty)
            return BAD
        if p.tag_of(first) != T_NAME:
            p.error(201, p.lo(first), p.hi(first), "a foreign enum is `enum Name:`; this names neither a name nor a backing type")
            return BAD
        name = p.ast.main[first]
    if p.expect(COLON) == BAD: return BAD
    bool paren = p.at(LPAREN)
    i64 base = p.base()
    p.push(c)
    p.push(backing)
    if foreign_enum_members(p, paren) == BAD:
        p.drop(base)
        return BAD
    u32 hi = p.en[name]
    if p.base() > base + 2: hi = p.hi(p.scratch[p.base() - 1])
    u32 flags = vis
    if paren: flags = flags | F_PAREN
    return p.node(N_F_ENUM, name, flags, p.seal(base), p.st[kw], join_hi(p.en[kw], hi))

private u32 foreign_enum_members(^Parser p, bool paren):
    if paren:
        if p.expect(LPAREN) == BAD: return BAD
        for !p.at(RPAREN) && !p.at(EOF):
            u32 m = foreign_enum_member(p)
            if m == BAD: return BAD
            p.push(m)
            if p.at(COMMA): _ = p.bump()
            else: break
        if p.expect(RPAREN) == BAD: return BAD
        _ = p.expect(NEWLINE)
        return 0
    if p.at(NEWLINE): _ = p.bump()
    if !p.at(INDENT):
        u32 t = p.peek()
        p.begin(202, p.st[t], p.en[t])
        p.say("expected a foreign enum body — `(` or an indented block — found ")
        p.say_kind(p.tg[t])
        p.seal_diag()
        return BAD
    _ = p.bump()
    for:
        p.skip_newlines()
        if p.at(DEDENT) || p.at(EOF): break
        i64 keep = p.base()
        u32 m = foreign_enum_member(p)
        p.drop(keep)
        if m != BAD:
            p.push(m)
            if p.at(COMMA): _ = p.bump()
            _ = p.expect(NEWLINE)
        else if !p.recover_to_stmt():
            break
    if p.at(DEDENT): _ = p.bump()
    return 0

private u32 foreign_enum_member(^Parser p):
    u32 start = p.peek()
    u32 c = c_name_attr(p, 2, true)
    if c == BAD: return BAD
    u32 name = p.ident("a foreign enum member name")
    if name == BAD: return BAD
    if p.at(ASSIGN):
        u32 eq = p.bump()
        u32 v = expr(p)
        u32 hi = p.en[eq]
        if v != BAD: hi = join_hi(hi, p.hi(v))
        p.begin(1021, p.st[eq], hi)
        p.say("`")
        p.say_tok(name)
        p.say("` is a member of a `foreign enum`, and C supplies its value\x1fA use emits the enumerator and never a number, so there is nothing here for a number to be checked against\x1edelete the `=`; `@c(\"…\")` is how a member says what C calls it")
        p.seal_diag()
    return p.node(N_F_ENUM_MEMBER, name, c, NONE, p.st[start], join_hi(p.st[start], p.en[name]))

private u32 foreign_fn(^Parser p, u32 vis, u32 start, u32 ret, u32 name, u32 c, u32 mac, u32 fl, u32 failure):
    if p.expect(LPAREN) == BAD: return BAD
    u32 flags = vis
    if mac != NONE: flags = flags | F_MACRO
    if fl != NONE: flags = flags | F_FAILABLE
    i64 base = p.base()
    p.push(ret)
    p.push(failure)
    p.push(c)
    i64 params = p.base()
    if !p.at(RPAREN):
        for:
            if p.at(DOTDOT) && p.kind(1) == DOT:
                u32 d0 = p.bump()
                u32 d1 = p.bump()
                if p.base() == params:
                    p.begin(1016, p.st[d0], p.en[d1])
                    p.say("`")
                    p.say_tok(name)
                    p.say("` writes `...` with nothing in front of it, and that is not a prototype a C header could have given\x1fThe tail is read off the last fixed argument, so a signature with none declares a function whose arguments nobody can reach\x1ewrite the fixed arguments this call actually passes")
                    p.seal_diag()
                else if p.at(COMMA):
                    p.begin(1016, p.st[d0], p.en[d1])
                    p.say("`...` says *and whatever else this call passes*, so it is the last thing `")
                    p.say_tok(name)
                    p.say("`'s parameter list writes; a parameter after it is one no call could ever reach. Move it in front of the `...`")
                    p.seal_diag()
                else:
                    flags = flags | F_CVAR
                if p.at(COMMA):
                    _ = p.bump()
                    continue
                break
            u32 q = param(p, false)
            if q == BAD:
                p.drop(base)
                return BAD
            p.push(q)
            if p.at(COMMA): _ = p.bump()
            else: break
    u32 close = p.expect(RPAREN)
    if close == BAD:
        p.drop(base)
        return BAD
    _ = p.expect(NEWLINE)
    return p.node(N_F_FN, name, flags, p.seal(base), p.st[start], join_hi(p.st[start], p.en[close]))
