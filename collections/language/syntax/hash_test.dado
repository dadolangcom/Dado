@test
package syntax

import "language:types"

private const string8 A = "package p\n\ni32 add(i32 a, i32 b):\n    return a + b\n\ntype P:\n    i32 x\n    i32 get(self):\n        return self.x\n\n$T first([]$T xs):\n    return xs[0]\n"
private const string8 B = "package p\n// moved, and the file grew\n\n\n$T first([]$T xs):\n    return xs[0]\n\ntype P:\n    i32 x\n    i32 get(self):\n        return self.x\n\n\ni32 add(i32 a, i32 b):\n    return a + b\n"
private const string8 C = "package p\n\ni32 add(i32 a, i32 b):\n    return a - b\n\ntype P:\n    i32 x\n    i32 get(self):\n        return self.x + 0\n\n$T first([]$T xs):\n    return xs[1]\n"

private type Item:
    string8 name
    u64 s0
    u64 s1
    u64 b0
    u64 b1

private ref []Item hashes(string8 src, ^types.Interner names):
    Tokens t = lex(src)
    intern(&t, src, names)
    Ast a = parse(src, &t)
    ref []Item out
    i64 i = 0
    for i < #len(a.hashes):
        u32 n = u32(a.hashes[i])
        u32 m = a.main[n]
        out = #append(out, Item(src[i64(t.start[m])..<i64(t.end[m])], a.hashes[i + 1], a.hashes[i + 2], a.hashes[i + 3], a.hashes[i + 4]))
        i += 5
    a.free()
    t.free()
    return out

private Item find([]Item xs, string8 name):
    for x in xs:
        if x.name == name: return x
    return Item("", 0, 0, 0, 0)

i32 test():
    types.Interner names = names()
    ref []Item a = hashes(A, &names)
    ref []Item b = hashes(B, &names)
    ref []Item c = hashes(C, &names)
    bool ok = #expect(#len(a) == 3 && #len(b) == 3, "three items each")
    for x in a:
        Item y = find(b, x.name)
        Item z = find(c, x.name)
        ok = #expect(x.s0 == y.s0 && x.s1 == y.s1, x.name, ": a moved item keeps its sig") && ok
        ok = #expect(x.b0 == y.b0 && x.b1 == y.b1, x.name, ": a moved item keeps its body hash") && ok
        ok = #expect(x.b0 != z.b0 || x.b1 != z.b1, x.name, ": an edited body changes the body hash") && ok
        bool sig_same = x.s0 == z.s0 && x.s1 == z.s1
        if x.name == "first":
            ok = #expect(!sig_same, "a template's sig covers its body") && ok
        else:
            ok = #expect(sig_same, x.name, ": a body edit keeps the sig") && ok
    #delete(a)
    #delete(b)
    #delete(c)
    names.free()
    return 0 if ok else 1
