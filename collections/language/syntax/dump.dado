// `--emit=tokens` and the human form of lex diagnostics, as dadoc prints them.
package syntax

// A line and a column (in characters), from 1.
type Place:
    i64 line
    i64 col

// Walks a text forward to answer places; moving back starts it over.
type Liner:
    string8 src
    // Another file follows this one in the compilation: dadoc's combined map
    // then places this file's end at the next one's 1:1.
    bool followed
    i64 pos
    i64 line
    i64 col

    Place place(^self, i64 at):
        i64 n = #len(self.src)
        if self.followed && at >= n && n > 0 && self.src[n - 1] == '\n':
            return Place(1, 1)
        i64 to = at if at < #len(self.src) else #len(self.src)
        if self.line == 0 || to < self.pos:
            self.pos = 0
            self.line = 1
            self.col = 1
        string8 s = self.src
        i64 i = self.pos
        for i < to:
            u8 b = u8(s[i])
            if b == 10:
                self.line += 1
                self.col = 1
            else if b < 0x80 || b >= 0xC0:
                self.col += 1
            i += 1
        self.pos = to
        return Place(self.line, self.col)

void put(^ref []char8 out, string8 s):
    out^ = #append(out^, ..s)

void put_num(^ref []char8 out, i64 n):
    u64 v = u64(n)
    u64 p = 1
    for p * 10 <= v:
        p *= 10
    for p > 0:
        out^ = #append(out^, char8(u8('0') + u8(v / p % 10)))
        p /= 10

private i64 num_width(i64 n):
    i64 w = 1
    i64 v = n
    for v >= 10:
        v /= 10
        w += 1
    return w

private void pad(^ref []char8 out, i64 n):
    for _ in 0..<n:
        out^ = #append(out^, ' ')

private void put_hex(^ref []char8 out, u32 v):
    string8 digits = "0123456789abcdef"
    i32 shift = 28
    bool any = false
    for shift >= 0:
        u32 d = (v >> u32(shift)) & 15
        if d != 0 || any || shift == 0:
            any = true
            out^ = #append(out^, digits[d])
        shift -= 4

// Whether Rust's `{:?}` writes code point `c` as `\u{…}`.
private bool escaped(u32 c):
    if c < 0x20 || c == 0x7F: return true
    if c < 0x80: return false
    if c < 0xA0 || c == 0xAD: return true
    if c >= 0x300 && c < 0x370: return true
    if c >= 0x200B && c <= 0x200F: return true
    if c >= 0x2028 && c <= 0x202E: return true
    if c >= 0x2060 && c <= 0x206F: return true
    if c >= 0xFE00 && c <= 0xFE0F: return true
    if c == 0xFEFF: return true
    if c >= 0xE000 && c <= 0xF8FF: return true
    if c >= 0xFFF0 && c <= 0xFFFB: return true
    return false

// `s` as Rust's `{:?}` quotes a `str`.
void put_debug(^ref []char8 out, string8 s):
    out^ = #append(out^, '"')
    i64 i = 0
    i64 n = #len(s)
    for i < n:
        char8 c = s[i]
        u8 b = u8(c)
        if b < 0x80:
            i += 1
            if c == '"': put(out, "\\\"")
            else if c == '\\': put(out, "\\\\")
            else if c == '\n': put(out, "\\n")
            else if c == '\r': put(out, "\\r")
            else if c == '\t': put(out, "\\t")
            else if b == 0: put(out, "\\0")
            else if escaped(u32(b)):
                put(out, "\\u{")
                put_hex(out, u32(b))
                put(out, "}")
            else:
                out^ = #append(out^, c)
            continue
        i64 w = 2 if b < 0xE0 else (3 if b < 0xF0 else 4)
        if i + w > n: w = n - i
        u32 cp = u32(b) & (0x1F if w == 2 else (0x0F if w == 3 else 0x07))
        for k in 1..<w:
            cp = (cp << 6) | (u32(u8(s[i + k])) & 0x3F)
        if escaped(cp):
            put(out, "\\u{")
            put_hex(out, cp)
            put(out, "}")
        else:
            put(out, s[i..<i + w])
        i += w
    out^ = #append(out^, '"')

// One file's `--emit=tokens` block, `name` in its header. `base` is where the
// file starts in the compilation, and `followed` whether another comes after.
void dump_tokens(^ref []char8 out, string8 name, string8 src, ^Tokens t, i64 base = 0, bool followed = false):
    i64 n = t.count()
    put(out, "# tokens: ")
    put_num(out, n)
    put(out, " (")
    put(out, name)
    put(out, ")\n")
    Liner l
    l.src = src
    l.followed = followed
    for i in 0..<n:
        u8 tg = t.tag[i]
        u32 ls = t.start[i]
        Place p = l.place(i64(ls))
        i64 s = base + i64(ls)
        i64 e = base + i64(token_end(src, tg, ls))
        pad(out, 4 - num_width(i))
        put_num(out, i)
        put(out, "  ")
        string8 nm = tag_name(tg)
        put(out, nm)
        pad(out, 11 - #len(nm))
        put(out, " ")
        put_num(out, s)
        put(out, "..")
        put_num(out, e)
        i64 sw = num_width(s) + 2 + num_width(e)
        if has_text(tg):
            pad(out, 9 - sw)
            put(out, " ")
            put_num(out, p.line)
            put(out, ":")
            put_num(out, p.col)
            pad(out, 7 - (num_width(p.line) + 1 + num_width(p.col)))
            put(out, " ")
            put_debug(out, src[s - base..<e - base])
        else:
            pad(out, 9 - sw)
            put(out, " ")
            put_num(out, p.line)
            put(out, ":")
            put_num(out, p.col)
        put(out, "\n")

private string8 line_text(string8 src, i64 at):
    i64 a = at if at < #len(src) else #len(src)
    i64 b = a
    for a > 0 && src[a - 1] != '\n':
        a -= 1
    for b < #len(src) && src[b] != '\n':
        b += 1
    if b > a && src[b - 1] == '\r': b -= 1
    return src[a..<b]

private i64 chars(string8 s):
    i64 n = 0
    for i in 0..<#len(s):
        u8 b = u8(s[i])
        if b < 0x80 || b >= 0xC0: n += 1
    return n

// The diagnostics in dadoc's human form: header, excerpt, caret, help.
void render_diags(^ref []char8 out, string8 name, string8 src, ^Tokens t, bool followed = false):
    render_list(out, name, src, t.diags, t.text, followed)

void render_parse_diags(^ref []char8 out, string8 name, string8 src, ^Ast a, bool followed = false):
    render_list(out, name, src, a.diags, a.text, followed)

void render_list(^ref []char8 out, string8 name, string8 src, []Diag diags, []char8 text, bool followed):
    Liner l
    l.src = src
    l.followed = followed
    for d in diags:
        put(out, "error[ERR")
        if d.code < 1000: put(out, "0")
        if d.code < 100: put(out, "0")
        if d.code < 10: put(out, "0")
        put_num(out, i64(d.code))
        put(out, "]: ")
        put(out, string8(text[i64(d.msg)..<i64(d.mend)]))
        put(out, "\n  --> ")
        put(out, name)
        put(out, ":")
        Place p = l.place(i64(d.start))
        Place q = l.place(i64(d.end))
        put_num(out, p.line)
        put(out, ":")
        put_num(out, p.col)
        put(out, "\n")
        string8 line = line_text(src, i64(d.start))
        i64 g = 4 if p.line < 10000 else num_width(p.line)
        pad(out, g - num_width(p.line))
        put_num(out, p.line)
        put(out, " | ")
        put(out, line)
        put(out, "\n")
        pad(out, g + 3 + p.col - 1)
        i64 w = q.col - p.col
        if q.line != p.line: w = chars(line) - (p.col - 1)
        if w < 1: w = 1
        for _ in 0..<w:
            out^ = #append(out^, '^')
        put(out, "\n")
        string8 h = string8(text[i64(d.help)..<i64(d.stop)])
        if #len(h) > 0:
            put(out, "  help: ")
            put(out, h)
            put(out, "\n")
