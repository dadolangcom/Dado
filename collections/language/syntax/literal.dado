// Literal values, decoded from the text the lexer accepted: integers, code
// points and string bodies.
package syntax

private u32 hex_value(char8 c):
    if c >= '0' && c <= '9': return u32(u8(c) - u8('0'))
    if c >= 'a' && c <= 'f': return u32(u8(c) - u8('a')) + 10
    if c >= 'A' && c <= 'F': return u32(u8(c) - u8('A')) + 10
    return 99

// An integer literal's value; `ok` is false past u64's range. A malformed
// one (already ERR0108) is 0.
(u64 value, bool ok) int_value(string8 text):
    u64 radix = 10
    i64 i = 0
    if #len(text) > 2 && text[0] == '0':
        char8 b = text[1]
        if b == 'x' || b == 'X': radix = 16
        else if b == 'b' || b == 'B': radix = 2
        else if b == 'o' || b == 'O': radix = 8
        if radix != 10: i = 2
    u64 v = 0
    bool any = false
    for i < #len(text):
        char8 c = text[i]
        i += 1
        if c == '_': continue
        u32 d = hex_value(c)
        if u64(d) >= radix: return (0, true)
        any = true
        (u64 m, bool f1) = #mul_fits(v, radix)
        (u64 s, bool f2) = #add_fits(m, u64(d))
        if !f1 || !f2: return (0, false)
        v = s
    if !any: return (0, true)
    return (v, true)

// A character literal's code point; 0 for one the lexer refused.
u32 char_value(string8 text):
    i64 n = #len(text)
    if n < 3 || text[0] != '\'' || text[n - 1] != '\'': return 0
    char8 c = text[1]
    u8 b = u8(c)
    if c != '\\':
        if b < 0x80: return u32(b)
        i64 w = 2 if b < 0xE0 else (3 if b < 0xF0 else 4)
        if 1 + w > n - 1: return 0
        u32 cp = u32(b) & (0x1F if w == 2 else (0x0F if w == 3 else 0x07))
        for k in 2..<1 + w:
            cp = (cp << 6) | (u32(u8(text[k])) & 0x3F)
        return cp
    if n < 4: return 0
    switch text[2]:
        case 'n': return 10
        case 'r': return 13
        case 't': return 9
        case '0': return 0
        case '\\': return 92
        case '"': return 34
        case '\'': return 39
        case 'x':
            if n < 6: return 0
            u32 h = hex_value(text[3])
            u32 l = hex_value(text[4])
            if h > 15 || l > 15: return 0
            return h * 16 + l
        else: return 0
    return 0

// Appends a string literal's text to `out`: quotes off, a multi-line one's
// first line and margin stripped, escapes resolved.
void string_value(string8 written, ^ref []char8 out):
    i64 n = #len(written)
    bool multi = n >= 6 && written[0..<3] == "\"\"\"" && written[n - 3..<n] == "\"\"\""
    if !multi:
        if n >= 2:
            unescape(written[1..<n - 1], out)
        return
    string8 inner = written[3..<n - 3]
    i64 first = 0
    for first < #len(inner) && inner[first] != '\n':
        first += 1
    i64 last = #len(inner)
    for last > 0 && inner[last - 1] != '\n':
        last -= 1
    if first >= #len(inner) || last <= first:
        unescape(inner, out)
        return
    string8 margin = inner[last..<#len(inner)]
    i64 m = #len(margin)
    i64 i = first + 1
    bool lead = true
    for i < last:
        i64 e = i
        for inner[e] != '\n':
            e += 1
        string8 line = inner[i..<e]
        if #len(line) > 0 && line[#len(line) - 1] == '\r':
            line = line[0..<#len(line) - 1]
        i = e + 1
        if !lead:
            out^ = #append(out^, '\n')
        lead = false
        if blank(line): continue
        if #len(line) >= m && line[0..<m] == margin:
            unescape(line[m..<#len(line)], out)
        else:
            i64 k = 0
            for k < #len(line) && (line[k] == ' ' || line[k] == '\t'):
                k += 1
            unescape(line[k..<#len(line)], out)

private bool blank(string8 s):
    for c in s:
        if c != ' ' && c != '\t' && c != '\r' && c != '\n': return false
    return true

// `body` with its escapes resolved, appended to `out`; a bad escape is kept.
void unescape(string8 body, ^ref []char8 out):
    i64 i = 0
    i64 n = #len(body)
    for i < n:
        char8 c = body[i]
        if c != '\\' || i + 1 >= n:
            out^ = #append(out^, c)
            i += 1
            continue
        char8 e = body[i + 1]
        i += 2
        switch e:
            case 'n': out^ = #append(out^, '\n')
            case 'r': out^ = #append(out^, '\r')
            case 't': out^ = #append(out^, '\t')
            case '0': out^ = #append(out^, char8(0))
            case '\\', '"', '\'': out^ = #append(out^, e)
            case 'x':
                if i + 1 < n && hex_value(body[i]) < 16 && hex_value(body[i + 1]) < 16:
                    out^ = #append(out^, char8(u8(hex_value(body[i]) * 16 + hex_value(body[i + 1]))))
                    i += 2
                else:
                    out^ = #append(out^, '\\')
                    out^ = #append(out^, e)
            else:
                out^ = #append(out^, '\\')
                out^ = #append(out^, e)

// dado_parse's parse_int: the value of an integer literal read as Rust's
// i128 would read it; `ok` is false when it is past u64 (ERR0539). A
// malformed one (already ERR0108) is 0.
(u64 value, bool ok) int_literal(string8 text):
    u64 radix = 10
    i64 i = 0
    i64 n = 0
    for c in text:
        if c != '_': n += 1
    if n > 2 && text[0] == '0':
        i64 k = 1
        for text[k] == '_':
            k += 1
        char8 b = text[k]
        if b == 'x' || b == 'X': radix = 16
        else if b == 'b' || b == 'B': radix = 2
        else if b == 'o' || b == 'O': radix = 8
        if radix != 10: i = k + 1
    u64 hi = 0
    u64 lo = 0
    bool any = false
    for i < #len(text):
        char8 c = text[i]
        i += 1
        if c == '_': continue
        u32 d = hex_value(c)
        if u64(d) >= radix: return (0, true)
        any = true
        u64 l0 = (lo & 0xFFFFFFFF) * radix + u64(d)
        u64 l1 = (lo >> 32) * radix + (l0 >> 32)
        (u64 h, bool f1) = #mul_fits(hi, radix)
        (u64 h2, bool f2) = #add_fits(h, l1 >> 32)
        if !f1 || !f2 || h2 > 0x7FFFFFFFFFFFFFFF: return (0, false)
        hi = h2
        lo = (l1 << 32) | (l0 & 0xFFFFFFFF)
    if !any: return (0, true)
    if hi != 0: return (0, false)
    return (lo, true)
