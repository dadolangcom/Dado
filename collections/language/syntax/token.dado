// Token tags, in dado_lex's TokenKind order. A token is a tag and a start;
// its end is re-derived (`token_end`).
package syntax

const u8 NEWLINE = 0
const u8 INDENT = 1
const u8 DEDENT = 2
const u8 EOF = 3
const u8 IDENT = 4
const u8 HASH_NAME = 5
const u8 INT = 6
const u8 FLOAT = 7
const u8 STRING = 8
const u8 CHAR = 9
const u8 KW_PACKAGE = 10
const u8 KW_IMPORT = 11
const u8 KW_TYPE = 12
const u8 KW_DISTINCT = 13
const u8 KW_CONST = 14
const u8 KW_ENUM = 15
const u8 KW_FOREIGN = 16
const u8 KW_VIEW = 17
const u8 KW_FOR = 18
const u8 KW_IN = 19
const u8 KW_IF = 20
const u8 KW_ELSE = 21
const u8 KW_RETURN = 22
const u8 KW_BREAK = 23
const u8 KW_CONTINUE = 24
const u8 KW_ASYNC = 25
const u8 KW_AWAIT = 26
const u8 KW_SUPER = 27
const u8 LPAREN = 28
const u8 RPAREN = 29
const u8 LBRACKET = 30
const u8 RBRACKET = 31
const u8 LBRACE = 32
const u8 RBRACE = 33
const u8 COMMA = 34
const u8 COLON = 35
const u8 DOT = 36
const u8 AT = 37
const u8 QUESTION = 38
const u8 DOTDOT = 39
const u8 DOTDOT_LESS = 40
const u8 DOTDOT_EQ = 41
const u8 ASSIGN = 42
const u8 PLUS_EQ = 43
const u8 MINUS_EQ = 44
const u8 STAR_EQ = 45
const u8 SLASH_EQ = 46
const u8 PERCENT_EQ = 47
const u8 AMP_EQ = 48
const u8 PIPE_EQ = 49
const u8 TILDE_EQ = 50
const u8 AMP_TILDE_EQ = 51
const u8 SHL_EQ = 52
const u8 SHR_EQ = 53
const u8 PLUS = 54
const u8 MINUS = 55
const u8 STAR = 56
const u8 SLASH = 57
const u8 PERCENT = 58
const u8 PLUS_PLUS = 59
const u8 EQ_EQ = 60
const u8 BANG_EQ = 61
const u8 LT = 62
const u8 LT_EQ = 63
const u8 GT = 64
const u8 GT_EQ = 65
const u8 AMP_AMP = 66
const u8 PIPE_PIPE = 67
const u8 BANG = 68
const u8 AMP = 69
const u8 PIPE = 70
const u8 TILDE = 71
const u8 AMP_TILDE = 72
const u8 SHL = 73
const u8 SHR = 74
const u8 CARET = 75
const u8 DOLLAR = 76
const u8 TAG_COUNT = 77

// Dump names (`--emit=tokens`), by tag.
const [77]string8 TAG_NAMES = ("NEWLINE", "INDENT", "DEDENT", "EOF", "IDENT", "HASH_NAME", "INT", "FLOAT", "STRING", "CHAR", "KW_PACKAGE", "KW_IMPORT", "KW_TYPE", "KW_DISTINCT", "KW_CONST", "KW_ENUM", "KW_FOREIGN", "KW_VIEW", "KW_FOR", "KW_IN", "KW_IF", "KW_ELSE", "KW_RETURN", "KW_BREAK", "KW_CONTINUE", "KW_ASYNC", "KW_AWAIT", "KW_SUPER", "LPAREN", "RPAREN", "LBRACKET", "RBRACKET", "LBRACE", "RBRACE", "COMMA", "COLON", "DOT", "AT", "QUESTION", "DOTDOT", "DOTDOT_LESS", "DOTDOT_EQ", "ASSIGN", "PLUS_EQ", "MINUS_EQ", "STAR_EQ", "SLASH_EQ", "PERCENT_EQ", "AMP_EQ", "PIPE_EQ", "TILDE_EQ", "AMP_TILDE_EQ", "SHL_EQ", "SHR_EQ", "PLUS", "MINUS", "STAR", "SLASH", "PERCENT", "PLUS_PLUS", "EQ_EQ", "BANG_EQ", "LT", "LT_EQ", "GT", "GT_EQ", "AMP_AMP", "PIPE_PIPE", "BANG", "AMP", "PIPE", "TILDE", "AMP_TILDE", "SHL", "SHR", "CARET", "DOLLAR")

// Fixed spellings, by tag; "" where the text varies or there is none.
const [77]string8 SPELLINGS = ("", "", "", "", "", "", "", "", "", "", "package", "import", "type", "distinct", "const", "enum", "foreign", "view", "for", "in", "if", "else", "return", "break", "continue", "async", "await", "super", "(", ")", "[", "]", "{", "}", ",", ":", ".", "@", "?", "..", "..<", "..=", "=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "~=", "&~=", "<<=", ">>=", "+", "-", "*", "/", "%", "++", "==", "!=", "<", "<=", ">", ">=", "&&", "||", "!", "&", "|", "~", "&~", "<<", ">>", "^", "$")

string8 tag_name(u8 t):
    return TAG_NAMES[t]

// The fixed text of tag `t`, or "".
string8 spelling(u8 t):
    return SPELLINGS[t]

bool is_layout(u8 t):
    return t <= EOF

bool is_keyword(u8 t):
    return t >= KW_PACKAGE && t <= KW_SUPER

// Whether a token of this tag carries text worth printing (names, literals).
bool has_text(u8 t):
    return t >= IDENT && t <= CHAR

bool opens(u8 t):
    return t == LPAREN || t == LBRACKET || t == LBRACE

bool closes(u8 t):
    return t == RPAREN || t == RBRACKET || t == RBRACE

// The keyword spelled by `w`, or IDENT.
u8 keyword(string8 w):
    i64 n = #len(w)
    if n < 2 || n > 8:
        return IDENT
    switch w[0]:
        case 'a':
            if w == "async": return KW_ASYNC
            if w == "await": return KW_AWAIT
        case 'b':
            if w == "break": return KW_BREAK
        case 'c':
            if w == "const": return KW_CONST
            if w == "continue": return KW_CONTINUE
        case 'd':
            if w == "distinct": return KW_DISTINCT
        case 'e':
            if w == "else": return KW_ELSE
            if w == "enum": return KW_ENUM
        case 'f':
            if w == "for": return KW_FOR
            if w == "foreign": return KW_FOREIGN
        case 'i':
            if w == "if": return KW_IF
            if w == "in": return KW_IN
            if w == "import": return KW_IMPORT
        case 'p':
            if w == "package": return KW_PACKAGE
        case 'r':
            if w == "return": return KW_RETURN
        case 's':
            if w == "super": return KW_SUPER
        case 't':
            if w == "type": return KW_TYPE
        case 'v':
            if w == "view": return KW_VIEW
        else:
            return IDENT
    return IDENT
