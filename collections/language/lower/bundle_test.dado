@test
// The release bundle reads the emitter's import lines: one statement a line, or several on the
// classes' line (rc.10.2: a class that uses two script classes; SawboxPlanner, r04).
package lower

import "core:strings"

private const string8 RT = "export function __dados_lines() {}\n"
private const string8 COPY = "// module \"ui/Copy\"\nimport { __dados_lines } from \"../dados/runtime.js\";\n\nvar Copy$;\nexport function Copy$class() {\n    return Copy$;\n}\n"
private const string8 CHROME = "// module \"ui/Chrome\"\nimport { __dados_lines } from \"../dados/runtime.js\";\n\nvar Chrome$;\nexport function Chrome$class() {\n    return Chrome$;\n}\n"

// The registry for a `main/Shell.js` whose third line is `classes`, and why it was refused.
private (string8 reg, string8 why) shell(string8 classes):
    ref []char8 text = #format("// module \"main/Shell\"\nimport { __dados_lines } from \"../dados/runtime.js\";\n", classes, "\nvar Shell$;\nexport function Shell$class() {\n    return Shell$;\n}\n")
    [6]string8 paths = ["dados/runtime.js", "dados/web.js", "dados/stop.js", "ui/Copy.js", "ui/Chrome.js", "main/Shell.js"]
    string8 shell_js = text
    [6]string8 texts = [RT, "export const web = 1;\n", "export const stop = 1;\n", COPY, CHROME, shell_js]
    [5]string8 rs = ["main/Shell.js", "dados/web.js", "dados/stop.js", "ui/Copy.js", "ui/Chrome.js"]
    string8 why = ""
    string8 reg = bundle(paths[:], texts[:], nil, rs[:], nil, "dados/runtime.js", "dados/web.js", "dados/stop.js", "", &why)
    return (reg, why)

i32 test():
    // Two class imports on one line, as the emitter writes them.
    (string8 two, string8 why2) = shell("import { Copy$class as class$ui$Copy } from \"../ui/Copy.js\"; import { Chrome$class as class$ui$Chrome } from \"../ui/Chrome.js\";")
    bool ok = #expect(why2 == "" && #len(two) > 0, "two imports on a line are bundled: ", why2)
    ok = #expect(strings.contains(two, "class$ui$Copy") && strings.contains(two, "class$ui$Chrome"), "both locals are linked") && ok
    // One a line reads the same.
    (string8 one, string8 why1) = shell("import { Copy$class as class$ui$Copy } from \"../ui/Copy.js\";\nimport { Chrome$class as class$ui$Chrome } from \"../ui/Chrome.js\";")
    ok = #expect(why1 == "" && #len(one) > 0, "one import a line is bundled: ", why1) && ok
    // Three on a line, a namespace among them.
    (string8 three, string8 why3) = shell("import { Copy$class as class$ui$Copy } from \"../ui/Copy.js\"; import * as ns from \"../ui/Chrome.js\"; import { web } from \"../dados/web.js\";")
    ok = #expect(why3 == "" && #len(three) > 0, "three imports on a line, one a namespace: ", why3) && ok
    // A module the build did not write is named by its specifier alone.
    (string8 none, string8 whyn) = shell("import { Copy$class as class$ui$Copy } from \"../ui/Copy.js\"; import { Gone } from \"../ui/Gone.js\";")
    ok = #expect(none == "" && strings.contains(whyn, "`../ui/Gone.js`") && strings.contains(whyn, "did not write"), "an unwritten module is refused by name: ", whyn) && ok
    // Anything after a statement that is not another import is refused, never dropped.
    (string8 odd, string8 whyo) = shell("import { Copy$class as class$ui$Copy } from \"../ui/Copy.js\"; var x = 1;")
    ok = #expect(odd == "" && strings.contains(whyo, "another shape"), "a trailing statement is refused: ", whyo) && ok
    (string8 bare, string8 whyb) = shell("import \"../ui/Copy.js\";")
    ok = #expect(bare == "" && strings.contains(whyb, "another shape"), "a bare import is refused: ", whyb) && ok
    return 0 if ok else 1
