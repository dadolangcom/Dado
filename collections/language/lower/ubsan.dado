// `--ubsan-handlers`: on `#WEB` and `#NONE`, which have no
// UBSan runtime, the handlers C's `-fsanitize=undefined` calls. Rust's text;
// `#NONE` traps with `__builtin_trap`, the web reports through its console.
package lower

const string8 UBSAN_NONE = "/* C's undefined-behaviour checks (--ubsan-handlers): this target has no UBSan\n   runtime, so the C defines the handlers the reporting checks call, in the\n   shape gcc and clang share. Weak: a handler linked from elsewhere wins. */\ntypedef struct { const char *file; uint32_t line; uint32_t column; } dado_rt__ubsan_at;\ntypedef struct { uint16_t kind; uint16_t info; char name[]; } dado_rt__ubsan_type;\ntypedef struct { dado_rt__ubsan_at at; const dado_rt__ubsan_type *type; } dado_rt__ubsan_overflow;\ntypedef struct { dado_rt__ubsan_at at; const dado_rt__ubsan_type *lhs; const dado_rt__ubsan_type *rhs; } dado_rt__ubsan_shift;\ntypedef struct { dado_rt__ubsan_at at; const dado_rt__ubsan_type *from; const dado_rt__ubsan_type *to; } dado_rt__ubsan_cast;\nstatic uint32_t dado_rt__ubsan_width(const dado_rt__ubsan_type *t) { uint32_t log2 = (uint32_t)t->info >> 1; return log2 < 7u ? 1u << log2 : 128u; }\nstatic void dado_rt__ubsan_value(const dado_rt__ubsan_type *t, void *v, uint64_t *lo, uint64_t *hi) {\n    uint32_t w = dado_rt__ubsan_width(t);\n    const uint64_t *p = (const uint64_t *)v;\n    if (w <= sizeof(void *) * 8u) { *lo = (uint64_t)(uintptr_t)v; *hi = 0u; }\n    else if (w <= 64u) { *lo = p[0]; *hi = 0u; }\n#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__\n    else { *lo = p[1]; *hi = p[0]; }\n#else\n    else { *lo = p[0]; *hi = p[1]; }\n#endif\n    if (w < 64u) { *lo &= ((uint64_t)1 << w) - 1u; }\n    if ((t->info & 1u) != 0u && (w > 64u ? (*hi >> 63) != 0u : ((*lo >> (w - 1u)) & 1u) != 0u)) {\n        if (w < 64u) { *lo |= ~(((uint64_t)1 << w) - 1u); }\n        if (w <= 64u) { *hi = ~(uint64_t)0; }\n    }\n}\nstatic const dado_rt__ubsan_at *dado_rt__ubsan_cast_data(void *data, const dado_rt__ubsan_type **from, const dado_rt__ubsan_type **to) {\n    const unsigned char *first = *(const unsigned char *const *)data;\n    if (first[0] + first[1] < 2) { *from = ((const dado_rt__ubsan_type *const *)data)[0]; *to = ((const dado_rt__ubsan_type *const *)data)[1]; return 0; }\n    *from = ((const dado_rt__ubsan_cast *)data)->from; *to = ((const dado_rt__ubsan_cast *)data)->to; return &((const dado_rt__ubsan_cast *)data)->at;\n}\nextern void undefined_behavior(const char *check, const char *file, unsigned line, unsigned column) __attribute__((weak));\nstatic void dado_rt__ubsan_end(const char *check, const dado_rt__ubsan_at *at) {\n    if (undefined_behavior != 0) { undefined_behavior(check, at != 0 && at->file != 0 ? at->file : \"<unknown>\", at != 0 ? (unsigned)at->line : 0u, at != 0 ? (unsigned)at->column : 0u); }\n    __builtin_trap();\n}\nstatic void dado_rt__ubsan_arith(void *data) {\n    const dado_rt__ubsan_overflow *d = (const dado_rt__ubsan_overflow *)data;\n    dado_rt__ubsan_end((d->type->info & 1u) != 0u ? \"signed-integer-overflow\" : \"unsigned-integer-overflow\", &d->at);\n}\nvoid __ubsan_handle_add_overflow_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_add_overflow_abort(void *data, void *lhs, void *rhs) { (void)lhs; (void)rhs; dado_rt__ubsan_arith(data); }\nvoid __ubsan_handle_sub_overflow_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_sub_overflow_abort(void *data, void *lhs, void *rhs) { (void)lhs; (void)rhs; dado_rt__ubsan_arith(data); }\nvoid __ubsan_handle_mul_overflow_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_mul_overflow_abort(void *data, void *lhs, void *rhs) { (void)lhs; (void)rhs; dado_rt__ubsan_arith(data); }\nvoid __ubsan_handle_negate_overflow_abort(void *data, void *value) __attribute__((weak));\nvoid __ubsan_handle_negate_overflow_abort(void *data, void *old) { (void)old; dado_rt__ubsan_arith(data); }\nvoid __ubsan_handle_divrem_overflow_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_divrem_overflow_abort(void *data, void *lhs, void *rhs) {\n    const dado_rt__ubsan_overflow *d = (const dado_rt__ubsan_overflow *)data;\n    uint64_t lo = 0u, hi = 0u;\n    (void)lhs;\n    if (d->type->kind == 0u) { dado_rt__ubsan_value(d->type, rhs, &lo, &hi); }\n    if (d->type->kind != 0u || (lo == 0u && hi == 0u)) { dado_rt__ubsan_end(\"integer-divide-by-zero\", &d->at); }\n    dado_rt__ubsan_arith(data);\n}\nvoid __ubsan_handle_shift_out_of_bounds_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_shift_out_of_bounds_abort(void *data, void *lhs, void *rhs) {\n    const dado_rt__ubsan_shift *d = (const dado_rt__ubsan_shift *)data;\n    uint64_t lo, hi;\n    (void)lhs;\n    dado_rt__ubsan_value(d->rhs, rhs, &lo, &hi);\n    dado_rt__ubsan_end(hi != 0u || lo >= dado_rt__ubsan_width(d->lhs) ? \"shift-exponent\" : \"shift-base\", &d->at);\n}\nvoid __ubsan_handle_float_cast_overflow_abort(void *data, void *value) __attribute__((weak));\nvoid __ubsan_handle_float_cast_overflow_abort(void *data, void *from) {\n    const dado_rt__ubsan_type *f, *t;\n    (void)from;\n    dado_rt__ubsan_end(\"float-cast-overflow\", dado_rt__ubsan_cast_data(data, &f, &t));\n}\n"

const string8 UBSAN_WEB = "void dado_rt__web_report(const char *format, ...);\n__attribute__((noreturn)) void dado_rt__web_abort(void);\nint dado_rt__fmt_g(char *buf, double v);\n/* C's undefined-behaviour checks (--ubsan-handlers): this target has no UBSan\n   runtime, so the C defines the handlers the reporting checks call, in the\n   shape gcc and clang share. Weak: a handler linked from elsewhere wins. */\ntypedef struct { const char *file; uint32_t line; uint32_t column; } dado_rt__ubsan_at;\ntypedef struct { uint16_t kind; uint16_t info; char name[]; } dado_rt__ubsan_type;\ntypedef struct { dado_rt__ubsan_at at; const dado_rt__ubsan_type *type; } dado_rt__ubsan_overflow;\ntypedef struct { dado_rt__ubsan_at at; const dado_rt__ubsan_type *lhs; const dado_rt__ubsan_type *rhs; } dado_rt__ubsan_shift;\ntypedef struct { dado_rt__ubsan_at at; const dado_rt__ubsan_type *from; const dado_rt__ubsan_type *to; } dado_rt__ubsan_cast;\nstatic uint32_t dado_rt__ubsan_width(const dado_rt__ubsan_type *t) { uint32_t log2 = (uint32_t)t->info >> 1; return log2 < 7u ? 1u << log2 : 128u; }\nstatic void dado_rt__ubsan_value(const dado_rt__ubsan_type *t, void *v, uint64_t *lo, uint64_t *hi) {\n    uint32_t w = dado_rt__ubsan_width(t);\n    const uint64_t *p = (const uint64_t *)v;\n    if (w <= sizeof(void *) * 8u) { *lo = (uint64_t)(uintptr_t)v; *hi = 0u; }\n    else if (w <= 64u) { *lo = p[0]; *hi = 0u; }\n#if defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__\n    else { *lo = p[1]; *hi = p[0]; }\n#else\n    else { *lo = p[0]; *hi = p[1]; }\n#endif\n    if (w < 64u) { *lo &= ((uint64_t)1 << w) - 1u; }\n    if ((t->info & 1u) != 0u && (w > 64u ? (*hi >> 63) != 0u : ((*lo >> (w - 1u)) & 1u) != 0u)) {\n        if (w < 64u) { *lo |= ~(((uint64_t)1 << w) - 1u); }\n        if (w <= 64u) { *hi = ~(uint64_t)0; }\n    }\n}\nstatic const dado_rt__ubsan_at *dado_rt__ubsan_cast_data(void *data, const dado_rt__ubsan_type **from, const dado_rt__ubsan_type **to) {\n    const unsigned char *first = *(const unsigned char *const *)data;\n    if (first[0] + first[1] < 2) { *from = ((const dado_rt__ubsan_type *const *)data)[0]; *to = ((const dado_rt__ubsan_type *const *)data)[1]; return 0; }\n    *from = ((const dado_rt__ubsan_cast *)data)->from; *to = ((const dado_rt__ubsan_cast *)data)->to; return &((const dado_rt__ubsan_cast *)data)->at;\n}\nstatic int dado_rt__ubsan_put(char *b, int k, const char *s) { while (*s != '\\0' && k < 480) { b[k++] = *s++; } return k; }\nstatic int dado_rt__ubsan_dec(char *b, int k, uint64_t n) { char d[20]; int m = 0; do { d[m++] = (char)('0' + (int)(n % 10u)); n /= 10u; } while (n != 0u); while (m > 0 && k < 480) { b[k++] = d[--m]; } return k; }\nstatic int dado_rt__ubsan_hex(char *b, int k, uint64_t n, int all) { int i; for (i = 15; i >= 0 && k < 480; i--) { uint32_t x = (uint32_t)(n >> (4u * (uint32_t)i)) & 15u; if (all || x != 0u || i == 0) { all = 1; b[k++] = (char)(x < 10u ? '0' + (int)x : 'a' + (int)x - 10); } } return k; }\nstatic int dado_rt__ubsan_int(char *b, int k, const dado_rt__ubsan_type *t, void *v) {\n    uint64_t lo, hi;\n    int is_signed = (t->info & 1u) != 0u;\n    dado_rt__ubsan_value(t, v, &lo, &hi);\n    if (is_signed && hi == ~(uint64_t)0 && (lo >> 63) != 0u) { k = dado_rt__ubsan_put(b, k, \"-\"); return dado_rt__ubsan_dec(b, k, ~lo + 1u); }\n    if (hi == 0u && (!is_signed || (lo >> 63) == 0u)) { return dado_rt__ubsan_dec(b, k, lo); }\n    k = dado_rt__ubsan_put(b, k, \"0x\"); k = dado_rt__ubsan_hex(b, k, hi, 1); return dado_rt__ubsan_hex(b, k, lo, 1);\n}\nstatic int dado_rt__ubsan_float(char *b, int k, const dado_rt__ubsan_type *t, void *v) {\n    char g[32];\n    int n = 0, i;\n    union { uint32_t u; float f; } s;\n    union { uint64_t u; double d; } d;\n    if (t->kind == 1u && t->info == 32u) { s.u = (uint32_t)(uintptr_t)v; n = dado_rt__fmt_g(g, (double)s.f); }\n    else if (t->kind == 1u && t->info == 64u) { d.u = sizeof(void *) >= 8u ? (uint64_t)(uintptr_t)v : *(const uint64_t *)v; n = dado_rt__fmt_g(g, d.d); }\n    else { k = dado_rt__ubsan_put(b, k, \"a value of type \"); return dado_rt__ubsan_put(b, k, t->name); }\n    for (i = 0; i < n && k < 480; i++) { b[k++] = g[i]; }\n    return k;\n}\nstatic int dado_rt__ubsan_where(char *b, const dado_rt__ubsan_at *at) {\n    int k = dado_rt__ubsan_put(b, 0, at != 0 && at->file != 0 ? at->file : \"<unknown>\");\n    if (at != 0 && at->line != 0u) { k = dado_rt__ubsan_put(b, k, \":\"); k = dado_rt__ubsan_dec(b, k, at->line); }\n    if (at != 0 && at->line != 0u && at->column != 0u) { k = dado_rt__ubsan_put(b, k, \":\"); k = dado_rt__ubsan_dec(b, k, at->column); }\n    return k;\n}\nstatic void dado_rt__ubsan_end(const dado_rt__ubsan_at *at, char *m, int k) {\n    char w[512];\n    w[dado_rt__ubsan_where(w, at)] = '\\0';\n    m[k] = '\\0';\n    dado_rt__web_report(\"ubsan: %s: %s\\n\", w, m);\n    dado_rt__web_abort();\n}\nstatic void dado_rt__ubsan_arith(void *data, void *lhs, void *rhs, const char *op) {\n    const dado_rt__ubsan_overflow *d = (const dado_rt__ubsan_overflow *)data;\n    char m[512];\n    int k = dado_rt__ubsan_put(m, 0, (d->type->info & 1u) != 0u ? \"signed integer overflow: \" : \"unsigned integer overflow: \");\n    k = dado_rt__ubsan_int(m, k, d->type, lhs); k = dado_rt__ubsan_put(m, k, op); k = dado_rt__ubsan_int(m, k, d->type, rhs);\n    k = dado_rt__ubsan_put(m, k, \" cannot be represented in type \"); k = dado_rt__ubsan_put(m, k, d->type->name);\n    dado_rt__ubsan_end(&d->at, m, k);\n}\nvoid __ubsan_handle_add_overflow_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_add_overflow_abort(void *data, void *lhs, void *rhs) { dado_rt__ubsan_arith(data, lhs, rhs, \" + \"); }\nvoid __ubsan_handle_sub_overflow_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_sub_overflow_abort(void *data, void *lhs, void *rhs) { dado_rt__ubsan_arith(data, lhs, rhs, \" - \"); }\nvoid __ubsan_handle_mul_overflow_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_mul_overflow_abort(void *data, void *lhs, void *rhs) { dado_rt__ubsan_arith(data, lhs, rhs, \" * \"); }\nvoid __ubsan_handle_negate_overflow_abort(void *data, void *value) __attribute__((weak));\nvoid __ubsan_handle_negate_overflow_abort(void *data, void *old) {\n    const dado_rt__ubsan_overflow *d = (const dado_rt__ubsan_overflow *)data;\n    char m[512];\n    int k = dado_rt__ubsan_put(m, 0, \"negation of \"); k = dado_rt__ubsan_int(m, k, d->type, old);\n    k = dado_rt__ubsan_put(m, k, \" cannot be represented in type \"); k = dado_rt__ubsan_put(m, k, d->type->name);\n    if ((d->type->info & 1u) != 0u) { k = dado_rt__ubsan_put(m, k, \"; cast to an unsigned type to negate this value to itself\"); }\n    dado_rt__ubsan_end(&d->at, m, k);\n}\nvoid __ubsan_handle_divrem_overflow_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_divrem_overflow_abort(void *data, void *lhs, void *rhs) {\n    const dado_rt__ubsan_overflow *d = (const dado_rt__ubsan_overflow *)data;\n    char m[512];\n    uint64_t lo = 0u, hi = 0u;\n    int k;\n    if (d->type->kind == 0u) { dado_rt__ubsan_value(d->type, rhs, &lo, &hi); }\n    if (d->type->kind != 0u || (lo == 0u && hi == 0u)) { k = dado_rt__ubsan_put(m, 0, \"division by zero\"); dado_rt__ubsan_end(&d->at, m, k); }\n    k = dado_rt__ubsan_put(m, 0, \"division of \"); k = dado_rt__ubsan_int(m, k, d->type, lhs); k = dado_rt__ubsan_put(m, k, \" by \"); k = dado_rt__ubsan_int(m, k, d->type, rhs);\n    k = dado_rt__ubsan_put(m, k, \" cannot be represented in type \"); k = dado_rt__ubsan_put(m, k, d->type->name);\n    dado_rt__ubsan_end(&d->at, m, k);\n}\nvoid __ubsan_handle_shift_out_of_bounds_abort(void *data, void *lhs, void *rhs) __attribute__((weak));\nvoid __ubsan_handle_shift_out_of_bounds_abort(void *data, void *lhs, void *rhs) {\n    const dado_rt__ubsan_shift *d = (const dado_rt__ubsan_shift *)data;\n    char m[512];\n    uint64_t lo, hi, blo, bhi;\n    int k;\n    dado_rt__ubsan_value(d->rhs, rhs, &lo, &hi);\n    dado_rt__ubsan_value(d->lhs, lhs, &blo, &bhi);\n    if ((d->rhs->info & 1u) != 0u && (hi >> 63) != 0u) { k = dado_rt__ubsan_put(m, 0, \"shift exponent \"); k = dado_rt__ubsan_int(m, k, d->rhs, rhs); k = dado_rt__ubsan_put(m, k, \" is negative\"); }\n    else if (hi != 0u || lo >= dado_rt__ubsan_width(d->lhs)) { k = dado_rt__ubsan_put(m, 0, \"shift exponent \"); k = dado_rt__ubsan_int(m, k, d->rhs, rhs); k = dado_rt__ubsan_put(m, k, \" is too large for \"); k = dado_rt__ubsan_dec(m, k, dado_rt__ubsan_width(d->lhs)); k = dado_rt__ubsan_put(m, k, \"-bit type \"); k = dado_rt__ubsan_put(m, k, d->lhs->name); }\n    else if ((d->lhs->info & 1u) != 0u && (bhi >> 63) != 0u) { k = dado_rt__ubsan_put(m, 0, \"left shift of negative value \"); k = dado_rt__ubsan_int(m, k, d->lhs, lhs); }\n    else { k = dado_rt__ubsan_put(m, 0, \"left shift of \"); k = dado_rt__ubsan_int(m, k, d->lhs, lhs); k = dado_rt__ubsan_put(m, k, \" by \"); k = dado_rt__ubsan_int(m, k, d->rhs, rhs); k = dado_rt__ubsan_put(m, k, \" places cannot be represented in type \"); k = dado_rt__ubsan_put(m, k, d->lhs->name); }\n    dado_rt__ubsan_end(&d->at, m, k);\n}\nvoid __ubsan_handle_float_cast_overflow_abort(void *data, void *value) __attribute__((weak));\nvoid __ubsan_handle_float_cast_overflow_abort(void *data, void *from) {\n    const dado_rt__ubsan_type *f, *t;\n    const dado_rt__ubsan_at *at = dado_rt__ubsan_cast_data(data, &f, &t);\n    char m[512];\n    int k = dado_rt__ubsan_float(m, 0, f, from); k = dado_rt__ubsan_put(m, k, \" is outside the range of representable values of type \"); k = dado_rt__ubsan_put(m, k, t->name);\n    dado_rt__ubsan_end(at, m, k);\n}\n"
