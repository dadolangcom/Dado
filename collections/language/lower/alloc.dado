// The ambient allocator's ops (`check/alloc.dado`): `dado_context` is
// `dado_alloc`, a Dado allocator value is its own two-slot shape.
package lower

import "language:check"
import "language:index"
import "language:ir"
import "language:types"

// Operand `x` as a `dado_alloc`: a rung constant, or the two words.
string8 ambient(^C c, ^ir.Fn f, u32 x):
    if ir.is_const(x):
        i64 r = i64(c.k.w0[x & ~ir.OPD_CONST])
        if r == 2: return "((dado_alloc){ dado_heap, 0 })"
        if r == 3: return "((dado_alloc){ dado_stack, 0 })"
        return "dado_context"
    string8 v = text(c, f, x)
    return index.hold(#format("((dado_alloc){ (dado_alloc_fn)(", v, ").s0, (", v, ").s1 })"))

// `d` (of the two-word shape `t`) set from the `dado_alloc` `src`.
private string8 words(^C c, string8 d, u32 t, string8 src):
    u32 ft = c.t.slots(t)[0]
    return index.hold(#format("{ dado_alloc dado_a = ", src, "; ", d, ".s0 = (", ty(c, ft), ")dado_a.s0; ", d, ".s1 = dado_a.s1; }"))

void alloc_op(^C c, ^ir.Fn f, u32 i):
    u8 s = f.sub[i]
    []u32 xs = ir.args(f, i)
    string8 d = text(c, f, f.dst[i]) if f.dst[i] != NONE else ""
    if s == check.B_AL_GET: put(&c.out, words(c, d, f.ty_of[i], "dado_context"))
    else if s == check.B_AL_HEAP: put(&c.out, words(c, d, f.ty_of[i], "((dado_alloc){ dado_heap, 0 })"))
    else if s == check.B_AL_PUSH: put(&c.out, index.hold(#format(words(c, d, f.ty_of[i], "dado_context"), " dado_context = ", ambient(c, f, xs[0]), ";")))
    else if s == check.B_AL_POP: put(&c.out, index.hold(#format("dado_context = ", ambient(c, f, xs[0]), ";")))
    else if s == check.B_AL_NEW:
        string8 e = ty(c, c.t.a[c.t.resolve(f.ty_of[i])])
        bool st = ir.is_const(xs[0]) && c.k.w0[xs[0] & ~ir.OPD_CONST] == 3
        string8 frame = stack_frame(c, e, 1, i) if st else "0"
        put(&c.out, index.hold(#format(d, " = dado_make(1, DADO_ES(", e, "), ", ambient(c, f, xs[0]), ", ", frame, ");")))
    else if s == check.B_AL_COPY:
        u32 rt = c.t.resolve(f.ty_of[i])
        u32 of = c.t.a[rt]
        u32 st = f.place_ty[xs[0]]
        string8 x = text(c, f, xs[0])
        string8 a = ambient(c, f, xs[1])
        u32 sr = c.t.resolve(of)
        if c.t.tag[sr] == types.T_SLICE:
            string8 e = ty(c, c.t.a[sr])
            string8 p = "(const char *)" if c.t.resolve(st) == types.STRING8 else ""
            put(&c.out, index.hold(#format("{ int64_t n = (", x, ").len; ", d, " = (", x, ").ptr == 0 ? (dado_ref){ 0 } : dado_make(n, DADO_ES(", e, "), ", a, ", 0); for (int64_t j = 0; j < (", d, ").len; j++) ((", e, " *)(", d, ").ptr)[j] = ((", e, " *)", p, "(", x, ").ptr)[j]; }")))
        else:
            string8 e = ty(c, of)
            string8 p = x if c.t.tag[c.t.resolve(st)] == types.T_PTR else index.hold(#format("((", e, " *)(", x, ").ptr)"))
            put(&c.out, index.hold(#format("{ ", e, " *p = ", p, "; ", d, " = p ? dado_make(1, DADO_ES(", e, "), ", a, ", 0) : (dado_ref){ 0 }; if ((", d, ").ptr) *(", e, " *)(", d, ").ptr = *p; }")))
    else if s == check.B_AL_FORMAT:
        put(&c.out, index.hold(#format("{ dado_fmtbuf dado_fb = { { 0 }, 0 }; dado_fb.r.alloc = ", ambient(c, f, xs[0]), "; struct { int64_t (*s0)(void *, void *, int64_t); void *s1; } dado_fk = { dado_fmt_put, &dado_fb }; int64_t n = 0; ")))
        for x in xs[1..<#len(xs)]:
            rend(c, text(c, f, x), f.place_ty[x] if !ir.is_const(x) else f.ty_of[i], "dado_fk", 0)
        put(&c.out, index.hold(#format("(void)n; ", d, " = dado_fmt_done(&dado_fb); }")))
    put(&c.out, "\n")
