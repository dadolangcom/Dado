// Maps in C: one open-addressed table per `(K, V)` (linear probing,
// power-of-two capacity, tombstones, growth at 75%, a seeded FNV-1a hash),
// the layout and the walk order Rust's dadoc emits.
package lower

import "language:check"
import "language:index"
import "language:ir"
import "language:types"
import "core:strings"

const string8 MAP_RT = """
    #ifndef DADO_NO_SEED
    extern uint64_t dado_hash_seed;
    #ifdef DADO_WEB
    static void dado_hash_seed_init(void) { dado_hash_seed = (uint64_t)dado_rt__import_dado_seed(); }
    #else
    #include <time.h>
    static void dado_hash_seed_init(void) {
        int here = 0;
        const char *pinned = getenv("DADO_HASH_SEED");
        uint64_t x = (uint64_t)(uintptr_t)&here ^ (uint64_t)(uintptr_t)&dado_hash_seed;
        x ^= ((uint64_t)time(((void *)0)) << 20) ^ (uint64_t)clock();
        x ^= x >> 30; x *= 0xBF58476D1CE4E5B9ULL; x ^= x >> 27; x *= 0x94D049BB133111EBULL; x ^= x >> 31;
        dado_hash_seed = pinned != ((void *)0) ? (uint64_t)strtoull(pinned, ((void *)0), 0) : x;
    }
    #endif
    #endif
    static int dado_map_bytes_eq(const char *a, const char *b, int64_t n) {
        for (int64_t i = 0; i < n; i++) if (a[i] != b[i]) return 0;
        return 1;
    }
    static void dado_map_walk(int32_t how, const char *where) {
    #ifdef DADO_NO_WALK_GUARDS
        (void)how; (void)where; return;
    #endif
        if (how == 0) return;
        fprintf(stderr, "map written during a walk: %s, through a call inside this loop, and the walk cannot go on\\n", how == 1 ? "the map was grown, rehashed or freed" : "an entry was inserted or deleted");
        dado_where(where);
        abort();
    }
    """

// `@M` the map, `@K` / `@V` its key and value, `@H` the hash's body, `@E`
// key equality over `a` and `b`, `@O` / `@D` the key's own and drop.
const string8 MAP_FNS = """
    struct @M__e { @K key; @V value; uint8_t state; };
    struct @M__t { int64_t len; int64_t used; int64_t cap; uint64_t gen; struct @M__e e[]; };
    static uint64_t @M__hash(@K k) { uint64_t h = 14695981039346656037ULL ^ dado_hash_seed;
    @H
        return h; }
    static int @M__eq(@K a, @K b) { return @E; }
    static int64_t @M__probe(struct @M__t *t, @K k, int *found) {
        uint64_t mask = (uint64_t)t->cap - 1u, i = @M__hash(k) & mask;
        int64_t tomb = -1;
        for (;;) {
            uint8_t st = t->e[i].state;
            if (st == 0) { *found = 0; return tomb >= 0 ? tomb : (int64_t)i; }
            if (st == 2) { if (tomb < 0) tomb = (int64_t)i; }
            else if (@M__eq(t->e[i].key, k)) { *found = 1; return (int64_t)i; }
            i = (i + 1u) & mask;
        }
    }
    static int @M__grow(@M *m, int64_t want) {
        struct @M__t *old = m->t, *fresh;
        int64_t cap = 8;
        dado_alloc a = m->alloc;
        if (a.s0 == 0) a = dado_context;
        if (a.s0 == 0 || want > 4294967295LL) return 0;
        while (cap * 3 < want * 4) cap = cap * 2;
        fresh = (struct @M__t *)a.s0(a.s1, 0, sizeof(struct @M__t) + sizeof(struct @M__e) * (uint64_t)cap, DADO_MAX_ALIGN, ((void *)0), 0);
        if (fresh == ((void *)0)) return 0;
        fresh->len = 0; fresh->used = 0; fresh->cap = cap;
        fresh->gen = old == ((void *)0) ? (uint64_t)cap << 32 : old->gen + 1u;
        m->alloc = a; m->t = fresh;
        if (old != ((void *)0)) {
            for (int64_t i = 0; i < old->cap; i++) {
                int found = 0;
                if (old->e[i].state != 1) continue;
                fresh->e[@M__probe(fresh, old->e[i].key, &found)] = old->e[i];
                fresh->len++; fresh->used++;
            }
            a.s0(a.s1, 2, 0, DADO_MAX_ALIGN, (void *)old, 0);
        }
        return 1;
    }
    static int @M__own(dado_alloc a, @K *k) { @O }
    static void @M__drop(dado_alloc a, @K *k) { @D }
    static @V @M__sink;
    static @V *@M__slot(@M *m, @K k) {
        int found = 0;
        int64_t at;
        if (m->t == ((void *)0) || (m->t->used + 1) * 4 > m->t->cap * 3) {
            int64_t held = m->t == ((void *)0) ? 0 : m->t->len;
            if (!@M__grow(m, held + 1)) { @M__sink = (@V){ 0 }; return &@M__sink; }
        }
        at = @M__probe(m->t, k, &found);
        if (!found) {
            if (!@M__own(m->alloc, &k)) { @M__sink = (@V){ 0 }; return &@M__sink; }
            if (m->t->e[at].state == 0) m->t->used++;
            m->t->e[at].state = 1; m->t->e[at].key = k; m->t->e[at].value = (@V){ 0 };
            m->t->len++; m->t->gen++;
        }
        return &m->t->e[at].value;
    }
    static int @M__get(@M m, @K k, @V *out) {
        int found = 0;
        int64_t at;
        if (m.t == ((void *)0) || m.t->len == 0) { *out = (@V){ 0 }; return 0; }
        at = @M__probe(m.t, k, &found);
        if (!found) { *out = (@V){ 0 }; return 0; }
        *out = m.t->e[at].value;
        return 1;
    }
    static int @M__has(@M m, @K k) {
        int found = 0;
        if (m.t == ((void *)0) || m.t->len == 0) return 0;
        (void)@M__probe(m.t, k, &found);
        return found;
    }
    static void @M__remove(@M *m, @K k) {
        int found = 0;
        int64_t at;
        if (m->t == ((void *)0) || m->t->len == 0) return;
        at = @M__probe(m->t, k, &found);
        if (!found) return;
        @M__drop(m->alloc, &m->t->e[at].key);
        m->t->e[at].state = 2; m->t->len--; m->t->gen++;
    }
    static void @M__free(@M *m) {
        if (m->t == ((void *)0)) return;
        for (int64_t i = 0; i < m->t->cap; i++) if (m->t->e[i].state == 1) @M__drop(m->alloc, &m->t->e[i].key);
        m->alloc.s0(m->alloc.s1, 2, 0, DADO_MAX_ALIGN, (void *)m->t, 0);
        m->t = ((void *)0);
    }
    static @M @M__copy(@M src, dado_alloc a) {
        @M out;
        out.t = ((void *)0); out.alloc = a;
        if (src.t == ((void *)0) || src.t->len == 0 || !@M__grow(&out, src.t->len)) return out;
        for (int64_t i = 0; i < src.t->cap; i++) {
            int found = 0;
            int64_t at;
            if (src.t->e[i].state != 1) continue;
            at = @M__probe(out.t, src.t->e[i].key, &found);
            out.t->e[at] = src.t->e[i];
            if (!@M__own(a, &out.t->e[at].key)) return out;
            out.t->len++; out.t->used++;
        }
        return out;
    }
    static @M @M__make(int64_t n, dado_alloc a) {
        @M out;
        out.t = ((void *)0); out.alloc = a;
        if (n > 0) (void)@M__grow(&out, n);
        return out;
    }
    """

// The map type `r`'s C name; its table and helpers go to `c.maps`.
string8 map_ty(^C c, u32 r):
    string8 name = shape_name(c, r)
    // Scalar keys and values: Rust's spelling, `dado_map_string_i32`, which a header may restate.
    string8 mk = map_part(c, c.t.a[r])
    string8 mv = map_part(c, c.t.b[r])
    if #len(mk) > 0 && #len(mv) > 0: name = index.hold(#format("dado_map_", mk, "_", mv))
    for d in c.done:
        if d == r: return name
    c.done = #append(c.done, r)
    put(&c.decls, index.hold(#format("typedef struct ", name, " ", name, ";\nstruct ", name, " { struct ", name, "__t *t; dado_alloc alloc; };\n")))
    u32 k = c.t.a[r]
    string8 kc = ty(c, k)
    string8 vc = ty(c, c.t.b[r])
    ref []char8 h
    hash_of(c, k, "k", &h)
    ref []string8 ss
    strings_in(c, k, "(*k)", &ss)
    ref []char8 own
    ref []char8 drop
    if #len(ss) == 0:
        put(&own, "(void)a; (void)k; return 1;")
        put(&drop, "(void)a; (void)k;")
    else:
        ref []char8 total
        for i in 0..<#len(ss):
            if i > 0: put(&total, " + ")
            put(&total, index.hold(#format("(uint64_t)", ss[i], ".len")))
        put(&own, index.hold(#format("uint64_t at = 0, total = ", total, "; unsigned char *b = (unsigned char *)a.s0(a.s1, 0, total + 1u, DADO_MAX_ALIGN, ((void *)0), 0); if (b == ((void *)0)) return 0;")))
        for s in ss:
            put(&own, index.hold(#format(" for (int64_t i = 0; i < ", s, ".len; i++) b[at + (uint64_t)i] = (unsigned char)", s, ".ptr[i]; ", s, ".ptr = (const char *)(b + at); at += (uint64_t)", s, ".len;")))
        put(&own, " return 1;")
        put(&drop, index.hold(#format("a.s0(a.s1, 2, 0, DADO_MAX_ALIGN, (void *)", ss[0], ".ptr, ", total, " + 1u);")))
    ref []char8 o
    string8 tpl = MAP_FNS
    i64 i = 0
    for i < #len(tpl):
        if tpl[i] != '@' || i + 1 >= #len(tpl):
            o = #append(o, tpl[i])
            i += 1
            continue
        char8 x = tpl[i + 1]
        if x == 'M': put(&o, name)
        else if x == 'K': put(&o, kc)
        else if x == 'V': put(&o, vc)
        else if x == 'H': put(&o, h)
        else if x == 'E': put(&o, eq_of(c, k, "a", "b"))
        else if x == 'O': put(&o, own)
        else if x == 'D': put(&o, drop)
        i += 2
    put(&c.maps, o)
    return name

// The hash's mix of key `e` of type `t`, slot by slot.
private void hash_of(^C c, u32 t, string8 e, ^ref []char8 o):
    u32 r = c.t.resolve(t)
    if r == types.STRING8:
        put(o, index.hold(#format("    for (int64_t i = 0; i < ", e, ".len; i++) { h ^= (uint64_t)(unsigned char)", e, ".ptr[i]; h *= 1099511628211ULL; }\n")))
        return
    if c.t.tag[r] == types.T_TUPLE:
        []u32 xs = c.t.slots(r)
        for j in 0..<#len(xs):
            hash_of(c, xs[j], slot_at(c, t, e, u32(j)), o)
        return
    if c.t.tag[r] == types.T_DISTINCT:
        hash_of(c, c.t.b[r], e, o)
        return
    put(o, index.hold(#format("    { uint64_t x = (uint64_t)", e, " ^ h; x ^= x >> 33; x *= 18397679294719823053ULL; x ^= x >> 29; x *= 14181476777654086739ULL; x ^= x >> 32; h ^= x; h *= 1099511628211ULL; }\n")))

// `x == y` over values of type `t`, as C.
string8 eq_of(^C c, u32 t, string8 x, string8 y):
    u32 r = c.t.resolve(t)
    if r == types.STRING8: return index.hold(#format("(", x, ".len == ", y, ".len && dado_map_bytes_eq(", x, ".ptr, ", y, ".ptr, ", x, ".len))"))
    if c.t.tag[r] == types.T_DISTINCT: return eq_of(c, c.t.b[r], x, y)
    if c.t.tag[r] == types.T_SLICE: return index.hold(#format(seq_of(c, r), "(", x, ", ", y, ")"))
    if c.t.tag[r] != types.T_TUPLE: return index.hold(#format("(", x, " == ", y, ")"))
    []u32 xs = c.t.slots(r)
    ref []char8 o
    put(&o, "(")
    for j in 0..<#len(xs):
        if j > 0: put(&o, " && ")
        put(&o, eq_of(c, xs[j], slot_at(c, t, x, u32(j)), slot_at(c, t, y, u32(j))))
    put(&o, ")")
    return index.hold(o)

private void strings_in(^C c, u32 t, string8 e, ^ref []string8 o):
    u32 r = c.t.resolve(t)
    if r == types.STRING8:
        o^ = #append(o^, e)
        return
    if c.t.tag[r] == types.T_DISTINCT:
        strings_in(c, c.t.b[r], e, o)
        return
    if c.t.tag[r] != types.T_TUPLE: return
    []u32 xs = c.t.slots(r)
    for j in 0..<#len(xs):
        strings_in(c, xs[j], slot_at(c, t, e, u32(j)), o)

// A map intrinsic as C.
void map_op(^C c, ^ir.Fn f, u32 i, string8 where):
    []u32 xs = ir.args(f, i)
    u8 s = f.sub[i]
    string8 m = ty(c, f.ty_of[i])
    string8 d = ""
    if f.dst[i] != NONE: d = text(c, f, f.dst[i])
    [3]string8 v = ["", "", ""]
    for j in 0..<#len(xs):
        if j < 3: v[j] = text(c, f, xs[j])
    string8 x = v[0]
    string8 y = v[1]
    string8 z = v[2]
    if s == check.B_MAP_SLOT: put(&c.out, index.hold(#format(d, " = ", m, "__slot(", x, ", ", y, ");\n")))
    else if s == check.B_MAP_GET:
        u32 pt = f.slot_ty[f.root[f.dst[i]]]
        put(&c.out, index.hold(#format("{ int dado_f = ", m, "__get(", x, ", ", y, ", &(", d, ")", member(c, pt, 0), "); (", d, ")", member(c, pt, 1), " = dado_f; }\n")))
    else if s == check.B_MAP_HAS: put(&c.out, index.hold(#format(d, " = ", m, "__has(", x, ", ", y, ") != 0;\n")))
    else if s == check.B_MAP_REMOVE: put(&c.out, index.hold(#format(m, "__remove(&(", x, "), ", y, ");\n")))
    else if s == check.B_MAP_FREE: put(&c.out, index.hold(#format(m, "__free(&(", x, "));\n")))
    else if s == check.B_MAP_COPY: put(&c.out, index.hold(#format(d, " = ", m, "__copy(", x, ", dado_context);\n")))
    else if s == check.B_MAP_MAKE: put(&c.out, index.hold(#format(d, " = ", m, "__make(", x, ", ", ambient(c, f, xs[1]), ");\n")))
    else if s == check.B_MAP_LEN: put(&c.out, index.hold(#format(d, " = (", x, ").t ? (", x, ").t->len : 0;\n")))
    else if s == check.B_MAP_CAP: put(&c.out, index.hold(#format(d, " = (", x, ").t ? (", x, ").t->cap : 0;\n")))
    else if s == check.B_MAP_GEN: put(&c.out, index.hold(#format(d, " = (", x, ").t ? (", x, ").t->gen : 0;\n")))
    else if s == check.B_MAP_LIVE: put(&c.out, index.hold(#format(d, " = (", x, ").t->e[", y, "].state == 1;\n")))
    else if s == check.B_MAP_KEY: put(&c.out, index.hold(#format(d, " = (", x, ").t->e[", y, "].key;\n")))
    else if s == check.B_MAP_VAL: put(&c.out, index.hold(#format(d, " = &(", x, ").t->e[", y, "].value;\n")))
    else if s == check.B_MAP_WALK: put(&c.out, index.hold(#format("dado_map_walk((", x, ").t != (", y, ").t ? 1 : (", y, ").t->gen != ", z, " ? 2 : 0, \"", where, "\");\n")))
    else if s == check.B_SCAN:
        u32 t = f.place_ty[xs[0]]
        Elem e = elem(c, t)
        put(&c.out, index.hold(#format(d, " = 0; for (int64_t dado_j = 0; dado_j < ", base_len(x, e), "; dado_j++) if (", eq_of(c, e.ty, index.hold(#format(base_ptr(c, x, e), "[dado_j]")), y), ") { ", d, " = 1; break; }\n")))

// A map rendered `{k: v, …}` into sink `k`, in table order.
void rend_map(^C c, string8 e, u32 r, string8 k, i64 d):
    string8 m = index.hold(#format("m", d))
    string8 j = index.hold(#format("j", d))
    string8 n1 = index.hold(#format("f", d))
    put(&c.out, index.hold(#format("{ ", ty(c, r), " ", m, " = ", e, "; int ", n1, " = 1; ")))
    emit(c, k, "\"{\"", "1")
    put(&c.out, index.hold(#format("if (", m, ".t) for (int64_t ", j, " = 0; ", j, " < ", m, ".t->cap; ", j, "++) { if (", m, ".t->e[", j, "].state != 1) continue; if (!", n1, ") ")))
    emit(c, k, "\", \"", "2")
    put(&c.out, index.hold(#format(n1, " = 0; ")))
    rend(c, index.hold(#format(m, ".t->e[", j, "].key")), c.t.a[r], k, d + 1)
    emit(c, k, "\": \"", "2")
    rend(c, index.hold(#format(m, ".t->e[", j, "].value")), c.t.b[r], k, d + 1)
    put(&c.out, "} ")
    emit(c, k, "\"}\"", "1")
    put(&c.out, "} ")

// The element-wise `==` of slice type `r`, defined once in `c.maps`.
private string8 seq_of(^C c, u32 r):
    string8 name = index.hold(#format(shape_name(c, r), "_eq"))
    for d in c.done:
        if d == r: return name
    c.done = #append(c.done, r)
    string8 e = ty(c, c.t.a[r])
    string8 q = eq_of(c, c.t.a[r], index.hold(#format("((", e, " *)a.ptr)[i]")), index.hold(#format("((", e, " *)b.ptr)[i]")))
    put(&c.maps, index.hold(#format("static int ", name, "(dado_view a, dado_view b) {\n    if (a.len != b.len) return 0;\n    for (int64_t i = 0; i < a.len; i++) if (!", q, ") return 0;\n    return 1;\n}\n")))
    return name

// A map's key or value as Rust's mangling spells it, for a fixed-width prim or
// `string8`; "" for anything else.
private string8 map_part(^C c, u32 t):
    if t == types.STRING8: return "string"
    if t == NONE || c.t.tag[t] != types.T_PRIM: return ""
    types.PrimRow p = types.PRIM[c.t.a[t]]
    if p.flexible || c.t.a[t] == u32(types.P_VOID) || c.t.a[t] == u32(types.P_RAWPTR): return ""
    return types.PRIM[p.canon].name
