        void *p = frame ? frame : (a.s0 == 0 || (uint64_t)n > UINT64_MAX / esz ? 0 : a.s0(a.s1, 0, esz * (uint64_t)n, al, 0, 0));
        r.ptr = p; r.len = p ? n : 0; r.alloc = a; r.cap = (uint32_t)(r.len > 4294967295LL ? 4294967295LL : r.len);
