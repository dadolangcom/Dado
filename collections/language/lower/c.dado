            k = dado_rt__trace_put(t, 0, "  at ", 5); k = dado_rt__trace_put(t, k, dado_rt__frames[kept].fn->file, dado_rt__frames[kept].fn->file_len); k = dado_rt__trace_put(t, k, ":", 1); k = dado_rt__trace_num(t, k, (uint32_t)(dado_rt__frames[kept].at >> 32)); k = dado_rt__trace_put(t, k, ":", 1); k = dado_rt__trace_num(t, k, (uint32_t)dado_rt__frames[kept].at);
            k = dado_rt__trace_put(t, k, " in ", 4); k = dado_rt__trace_put(t, k, dado_rt__frames[kept].fn->name, dado_rt__frames[kept].fn->name_len); k = dado_rt__trace_put(t, k, "\\n", 1);
            dado_rt__trace_say(t, k);
