    __attribute__((no_sanitize("undefined"))) static void dado_rt__pop(dado_rt__frame **s) { uint32_t d = (uint32_t)(*s - dado_rt__frames); dado_rt__depth = d < 4096u ? d : dado_rt__depth - 1u; }
    static int32_t dado_rt__trace_put(char *t, int32_t k, const char *s, int64_t n) { int64_t i; for (i = 0; (n < 0 ? s[i] != '\\0' : i < n) && k < 480; i++) { t[k++] = s[i]; } return k; }
    static int32_t dado_rt__trace_num(char *t, int32_t k, uint32_t n) { char d[12]; int32_t m = 0; do { d[m++] = (char)('0' + (int)(n % 10u)); n /= 10u; } while (n != 0u); while (m > 0) { t[k++] = d[--m]; } return k; }
    static void dado_rt__trace_say(char *t, int32_t k) { fwrite(t, 1, (size_t)k, stderr); }
