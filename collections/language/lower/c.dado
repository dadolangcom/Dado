    static int64_t dado_ewrite(void *c, void *p, int64_t n) { (void)c; return (int64_t)fwrite(p, 1, (size_t)n, stderr); }
    static const struct { int64_t (*s0)(void *, void *, int64_t); void *s1; } dado_stderr = { dado_ewrite, 0 };
    typedef struct dado_nw { const char *where; uint64_t count; struct dado_nw *next; } dado_nw;
    static dado_nw *dado_nws;
    static int dado_nw_kept;
    static void dado_nw_report(void) {
        dado_nw *s = __atomic_exchange_n(&dado_nws, (dado_nw *)0, __ATOMIC_ACQ_REL), *order = 0;
        while (s) { dado_nw *n = s->next; s->next = order; order = s; s = n; }
        for (s = order; s; s = s->next) { uint64_t n = __atomic_load_n(&s->count, __ATOMIC_RELAXED); if (n > 1) fprintf(stderr, "warning: %s: implicit narrowing changed the value: %llu times in all\\n", s->where, (unsigned long long)n); }
    }
    static int dado_nw_first(dado_nw *s) {
        dado_nw *head;
        if (__atomic_fetch_add(&s->count, 1, __ATOMIC_RELAXED) != 0) return 0;
        head = __atomic_load_n(&dado_nws, __ATOMIC_RELAXED);
        do { s->next = head; } while (!__atomic_compare_exchange_n(&dado_nws, &head, s, 1, __ATOMIC_RELEASE, __ATOMIC_RELAXED));
        if (__atomic_exchange_n(&dado_nw_kept, 1, __ATOMIC_RELAXED) == 0) (void)atexit(dado_nw_report);
        return 1;
    }
    static int64_t dado_nwi(int64_t v, int64_t to, const char *w, dado_nw *s) {
        if (v != to && dado_nw_first(s)) fprintf(stderr, "warning: %s: implicit narrowing changed the value: the int %lld does not fit in %s, and wraps to %lld\\n", s->where, (long long)v, w, (long long)to);
        return to;
    }
    static uint64_t dado_nwu(int64_t v, dado_nw *s) {
        if (v < 0 && dado_nw_first(s)) fprintf(stderr, "warning: %s: implicit narrowing changed the value: the int %lld does not fit in u64, and wraps to %llu\\n", s->where, (long long)v, (unsigned long long)v);
        return (uint64_t)v;
    }
    static float dado_nwf(double v, dado_nw *s) {
        float r = (float)v;
        if (isinf(r) && !isinf(v) && dado_nw_first(s)) fprintf(stderr, "warning: %s: implicit narrowing changed the value: the float %g does not fit in f32, and becomes %s\\n", s->where, v, v < 0.0 ? "-inf" : "inf");
        return r;
    }
    static void dado_mul_wide(int64_t a, int64_t b, int64_t *hi, uint64_t *lo) {
        uint64_t ua = (uint64_t)a, ub = (uint64_t)b, a0 = ua & 0xFFFFFFFFu, a1 = ua >> 32, b0 = ub & 0xFFFFFFFFu, b1 = ub >> 32;
        uint64_t p00 = a0 * b0, p01 = a0 * b1, p10 = a1 * b0, p11 = a1 * b1;
        uint64_t mid = (p00 >> 32) + (p01 & 0xFFFFFFFFu) + (p10 & 0xFFFFFFFFu);
        uint64_t h = p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);
        *lo = (mid << 32) | (p00 & 0xFFFFFFFFu);
        if (a < 0) h -= ub;
        if (b < 0) h -= ua;
        *hi = (int64_t)h;
    }
    static inline void dado_div_zero(unsigned long long a, int sg, const char *op, const char *where) {
        if (sg) fprintf(stderr, "division by zero: %lld %s 0 has no answer\\n", (long long)a, op);
        else fprintf(stderr, "division by zero: %llu %s 0 has no answer\\n", a, op);
        dado_where(where);
        abort();
    }
    typedef union { long double ld; void *p; long long ll; } dado_widest;
    struct dado_align_probe { char c; dado_widest t; };
    #define DADO_MAX_ALIGN ((uint64_t)offsetof(struct dado_align_probe, t))
    typedef void *(*dado_alloc_fn)(void *, int32_t, uint64_t, uint64_t, void *, uint64_t);
    typedef struct { dado_alloc_fn s0; void *s1; } dado_alloc;
    typedef struct { void *ptr; int64_t len; } dado_view;
    typedef struct { void *s0; uint32_t s1; } dado_trait;
    typedef struct { void *ptr; int64_t len; dado_alloc alloc; uint32_t cap; } dado_ref;
    static void *dado_heap(void *data, int32_t mode, uint64_t size, uint64_t align, void *old, uint64_t old_size) {
        (void)data;
    #ifdef _WIN32
        /* Windows' C runtime has no aligned_alloc: every block is
           _aligned_malloc's, so a free needs no alignment to find its start. */
        if (mode == 2) { _aligned_free(old); return 0; }
        if (mode <= 1) {
            size_t al = (size_t)(align > DADO_MAX_ALIGN ? align : DADO_MAX_ALIGN);
            unsigned char *g = (unsigned char *)(mode == 0 ? _aligned_malloc(size ? (size_t)size : 1, al) : _aligned_realloc(old, size ? (size_t)size : 1, al));
            if (g) for (uint64_t at = mode == 0 ? 0 : old_size; at < size; at++) g[at] = 0;
            return g;
        }
        return 0;
    #else
    #ifdef DADO_WEB
        /* No aligned_alloc on the web: over-allocate, the block's own address in the word in front. */
        if (align > DADO_MAX_ALIGN) {
            if (mode == 2) { if (old) free(((void **)old)[-1]); return 0; }
            unsigned char *raw = (unsigned char *)calloc(1, (size_t)size + (size_t)align + sizeof(void *));
            if (!raw) return 0;
            unsigned char *g = (unsigned char *)(((uintptr_t)raw + sizeof(void *) + (uintptr_t)align - 1) & ~((uintptr_t)align - 1));
            ((void **)g)[-1] = raw;
            if (mode == 1 && old) { memcpy(g, old, (size_t)(old_size < size ? old_size : size)); free(((void **)old)[-1]); }
            return g;
        }
    #endif
        if (align > DADO_MAX_ALIGN && mode <= 1) {
            size_t n = (size_t)((size + align - 1) / align * align);
            unsigned char *g = (unsigned char *)aligned_alloc((size_t)align, n ? n : (size_t)align);
            if (g) for (size_t at = 0; at < n; at++) g[at] = 0;
            if (g && mode == 1 && old) { memcpy(g, old, (size_t)(old_size < size ? old_size : size)); free(old); }
            return g;
        }
        if (mode == 0) return calloc(1, size ? (size_t)size : 1);
        if (mode == 1) {
            unsigned char *g = (unsigned char *)realloc(old, size ? (size_t)size : 1);
            if (g) for (uint64_t at = old_size; at < size; at++) g[at] = 0;
            return g;
        }
        if (mode == 2) free(old);
        return 0;
    #endif
    }
    static void *dado_stack(void *data, int32_t mode, uint64_t size, uint64_t align, void *old, uint64_t old_size) {
        (void)data; (void)mode; (void)size; (void)align; (void)old; (void)old_size;
        return 0;
    }
    extern _Thread_local dado_alloc dado_context;
    /* the checks inline, their faults out of line */
    #if defined(__GNUC__)
    #define DADO_COLD __attribute__((noinline, cold, noreturn, unused))
    #define DADO_SLOW __attribute__((noinline, unused))
    #define DADO_SYMBOL(x) __attribute__((x))
    #else
    #define DADO_COLD
