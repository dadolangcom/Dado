    /* the code point at p[*i] (a pair is one; a lone half U+FFFD), *i past it */
    static uint32_t dado_cp16(const uint16_t *p, int64_t n, int64_t *i) {
        uint32_t u = p[(*i)++];
        if (u >= 0xD800 && u < 0xDC00 && *i < n && p[*i] >= 0xDC00 && p[*i] < 0xE000) return 0x10000 + ((u - 0xD800) << 10) + (p[(*i)++] - 0xDC00u);
        return u >= 0xD800 && u < 0xE000 ? 0xFFFD : u;
    }
    static uint32_t dado_cp32(uint32_t u) { return u > 0x10FFFF || (u >= 0xD800 && u < 0xE000) ? 0xFFFD : u; }
    static void dado_grow_failed(int64_t want, int nil, const char *verb, const char *place, const char *where) {
        fprintf(stderr, "%s(%s): cannot grow the run to %lld elements: %s\\n", verb, place, (long long)want, nil ? "it has no allocator to grow from" : "its allocator declined");
        dado_where(where);
        abort();
