        return p;
    }
    static int dado_str_eq(dado_string a, dado_string b) {
        if (a.len != b.len) return 0;
        for (int64_t i = 0; i < a.len; i++) if (a.ptr[i] != b.ptr[i]) return 0;
        return 1;
    }
    static int dado_str16_eq(dado_string16 a, dado_string16 b) {
        if (a.len != b.len) return 0;
