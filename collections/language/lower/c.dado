    #define DADO_SYMBOL(x)
    #endif
    /* `#fence`: under ThreadSanitizer, which cannot model a fence (gcc refuses
       one), a read-modify-write with the same ordering on one shared cell */
    #if defined(__SANITIZE_THREAD__)
    #define DADO_FENCE_UNDER_TSAN 1
    #elif defined(__has_feature)
    #if __has_feature(thread_sanitizer)
    #define DADO_FENCE_UNDER_TSAN 1
    #endif
    #endif
    #if defined(DADO_FENCE_UNDER_TSAN)
    __attribute__((weak)) int dado_fence_cell;
    #define DADO_FENCE(order) ((void)__atomic_fetch_add(&dado_fence_cell, 0, (order)))
    #else
    #define DADO_FENCE(order) __atomic_thread_fence(order)
    #endif
    static DADO_COLD void dado_at_fail(int64_t at, int64_t len, const char *where) {
        fprintf(stderr, "index out of bounds: %lld is not a position in a run of %lld\\n", (long long)at, (long long)len);
        dado_where(where);
        abort();
    }
    static inline int64_t dado_at(int64_t at, int64_t len, const char *where) {
        if (at < 0 || at >= len) dado_at_fail(at, len, where);
        return at;
    }
    static DADO_COLD void dado_window_fail(int64_t lo, int64_t hi, int64_t len, const char *where) {
        fprintf(stderr, "window out of bounds: %lld..<%lld is not inside a run of %lld\\n", (long long)lo, (long long)hi, (long long)len);
        dado_where(where);
        abort();
    }
    static inline int64_t dado_window(int64_t lo, int64_t hi, int64_t len, const char *where) {
        if (lo < 0 || lo > hi || hi > len) dado_window_fail(lo, hi, len, where);
        return lo;
    }
    static DADO_COLD void dado_copy_fail(int64_t to, int64_t from, const char *where) {
        fprintf(stderr, "copy length mismatch: a window of %lld is assigned a run of %lld\\n", (long long)to, (long long)from);
        dado_where(where);
        abort();
    }
    static void dado_bits(int64_t v, int64_t lo, int64_t hi, int sg, const char *where) {
        if (sg ? (v < lo || v > hi) : ((uint64_t)v > (uint64_t)hi)) {
            if (sg) fprintf(stderr, "bitfield out of range: %lld does not fit in %lld..%lld\\n", (long long)v, (long long)lo, (long long)hi);
            else fprintf(stderr, "bitfield out of range: %llu does not fit in 0..%llu\\n", (unsigned long long)v, (unsigned long long)hi);
            dado_where(where);
            abort();
