    typedef struct { const uint16_t *ptr; int64_t len; } dado_string16;
    typedef struct { const uint32_t *ptr; int64_t len; } dado_string32;
    static inline int64_t dado_clen(const char *s) { int64_t n = 0; while (s[n] != '\\0') n++; return n; }
    static inline int dado_u64(unsigned long long v, char *out) {
        char d[20]; int n = 0, i;
        do { d[n++] = (char)('0' + (int)(v % 10u)); v /= 10u; } while (v != 0u);
        for (i = 0; i < n; i++) out[i] = d[n - 1 - i];
