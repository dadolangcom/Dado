    __attribute__((no_sanitize("undefined"))) static dado_rt__frame *dado_rt__push(const dado_rt__fn *f) { uint32_t d = dado_rt__depth++; dado_rt__frame *s = &dado_rt__frames[d < 4096u ? d : 4096u]; s->fn = f; return s; }
