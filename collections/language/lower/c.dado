        if (r->ptr == 0 && r->alloc.s0 == 0) r->alloc = ambient;
        block = (r->alloc.s0 == 0 || (uint64_t)n > UINT64_MAX / esz) ? 0 : r->alloc.s0(r->alloc.s1, r->ptr == 0 ? 0 : 1, esz * (uint64_t)n, al, r->ptr, esz * (uint64_t)r->cap);
