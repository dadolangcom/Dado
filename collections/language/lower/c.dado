    static inline void dado_room(dado_ref *r, int64_t more, uint64_t esz, dado_alloc ambient, const char *verb, const char *place, const char *where) {
        if (r->len + more > (int64_t)r->cap) dado_room_grow(r, more, esz, ambient, verb, place, where);
    }
    static void dado_resize(dado_ref *r, int64_t n, uint64_t esz, dado_alloc ambient, const char *verb, const char *place, const char *where) {
        void *block;
