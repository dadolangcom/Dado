        if (r->ptr == 0 && r->alloc.s0 == 0) r->alloc = ambient;
        block = want > 4294967295LL ? 0 : (r->alloc.s0 == 0 || (uint64_t)want > UINT64_MAX / esz ? 0 : r->alloc.s0(r->alloc.s1, r->ptr == 0 ? 0 : 1, esz * (uint64_t)want, al, r->ptr, esz * (uint64_t)r->cap));
        if (block) { r->ptr = block; r->cap = (uint32_t)want; }
        else dado_grow_failed(want, r->alloc.s0 == 0, verb, place, where);
    }
    static DADO_SLOW void dado_room_grow(dado_ref *r, int64_t more, uint64_t esz, dado_alloc ambient, const char *verb, const char *place, const char *where) {
        int64_t want = (int64_t)r->cap * 2 + (r->cap == 0);
        want = want - (want > 4294967295LL) * (want - 4294967295LL);
        if (want < r->len + more) want = r->len + more;
        dado_reserve(r, want, esz, ambient, verb, place, where);
