        char t[512];
        int32_t k = dado_rt__trace_put(t, 0, "  at ", -1);
        k = dado_rt__trace_put(t, k, where, -1);
        if (inner > 0u) { k = dado_rt__trace_put(t, k, "\\n  \\342\\200\\246 ", -1); k = dado_rt__trace_num(t, k, inner); k = dado_rt__trace_put(t, k, " calls deeper not recorded\\n", -1); }
        else if (kept > 0u) { kept--; shown = 1u; k = dado_rt__trace_put(t, k, " in ", 4); k = dado_rt__trace_put(t, k, dado_rt__frames[kept].fn->name, dado_rt__frames[kept].fn->name_len); k = dado_rt__trace_put(t, k, "\\n", 1); }
        else { k = dado_rt__trace_put(t, k, "\\n", 1); }
        dado_rt__trace_say(t, k);
        while (kept > 0u) {
