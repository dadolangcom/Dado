    }
    typedef struct { dado_ref r; int bad; } dado_fmtbuf;
    static int64_t dado_fmt_put(void *b, void *p, int64_t n) {
        dado_fmtbuf *f = (dado_fmtbuf *)b;
        if (f->bad || n <= 0) return n;
        if (f->r.len + n > (int64_t)f->r.cap) {
            int64_t want = (int64_t)f->r.cap * 2 + n + 16;
            void *g = f->r.alloc.s0 == 0 ? 0 : f->r.alloc.s0(f->r.alloc.s1, f->r.ptr ? 1 : 0, (uint64_t)want, DADO_MAX_ALIGN, f->r.ptr, f->r.cap);
            if (!g) { f->bad = 1; return n; }
            f->r.ptr = g; f->r.cap = (uint32_t)want;
        }
        for (int64_t i = 0; i < n; i++) ((char *)f->r.ptr)[f->r.len + i] = ((const char *)p)[i];
        f->r.len += n;
        return n;
    }
    static dado_ref dado_fmt_done(dado_fmtbuf *f) {
        if (!f->bad && f->r.ptr == 0) { char z = 0; (void)dado_fmt_put(f, &z, 1); f->r.len = 0; }
        if (f->bad) { if (f->r.ptr) (void)f->r.alloc.s0(f->r.alloc.s1, 2, 0, 0, f->r.ptr, f->r.cap); return (dado_ref){ 0 }; }
        return f->r;
    }
    static void dado_delete(dado_ref *r, uint64_t esz) {
        if (r->ptr) (void)r->alloc.s0(r->alloc.s1, 2, 0, 0, r->ptr, esz * (uint64_t)r->cap);
        *r = (dado_ref){ 0 };
    }
    typedef struct { uintptr_t p; const char *freed; } dado_stale;
    static void dado_stale_moved(dado_stale *w, uintptr_t lo, uint64_t n, uintptr_t now, int frees, const char *s) {
        if (frees && now != lo && w->freed == 0 && w->p - lo < n) w->freed = s;
    }
    static void dado_stale_trap(const dado_stale *w, const char *where) {
        fprintf(stderr, "stale read: %s\\n", w->freed); dado_where(where); fprintf(stderr, "  (the build warned of this read: WRN0803; --no-sanitize drops the check)\\n");
        abort();
    }
    static int32_t dado_fail(int32_t code, const char *where) {
        if (code == 0) { fprintf(stderr, "fail with code 0: a failure's code is never 0\\n"); dado_where(where); abort(); }
        return code;
    }
    #define dado_exit_status(c) ((((uint32_t)(c) & 255u) == 0u) ? 70 : (int)(c))
    static void dado_truncate(dado_ref *r, int64_t n, uint64_t esz, const char *where) {
        if (n < 0 || n > r->len) {
            fprintf(stderr, "truncate out of bounds: %lld is not a length a run of %lld can be shortened to\\n", (long long)n, (long long)r->len);
            dado_where(where);
            abort();
        }
        for (uint64_t at = (uint64_t)n * esz; at < (uint64_t)r->len * esz; at++) ((unsigned char *)r->ptr)[at] = 0;
        r->len = n;
    }
    """

// The C spelling of `x`, its shape written into `decls` first.
// `x` with every name under it read as its body (a header's kept): one C
// spelling for structurally equal shapes.
private u32 canon(^C c, u32 x):
    if foreign_row(c, x) != NONE: return x
    u32 r = c.t.resolve(x)
    if r == NONE: return r
    u8 g = c.t.tag[r]
    if g == types.T_PTR: return r
    for v in c.seen:
        if v == r: return r
    c.seen = #append(c.seen, r)
    u32 out = canon_(c, r, g)
    #truncate(c.seen, #len(c.seen) - 1)
    return out

private u32 canon_(^C c, u32 r, u8 g):
    if g == types.T_SLICE: return c.t.slice_of(canon(c, c.t.a[r]))
    if g == types.T_REF: return c.t.ref_of(canon(c, c.t.a[r]))
    if g != types.T_TUPLE && g != types.T_FUNC: return r
    ref []u32 xs
    for e in c.t.list(r):
        xs = #append(xs, e)
    for i in 0..<#len(xs):
        if c.t.tag[xs[i]] == types.T_ALIGNED: xs[i] = c.t.make(types.T_ALIGNED, c.t.a[xs[i]], canon(c, c.t.b[xs[i]]), nil)
        else: xs[i] = canon(c, xs[i])
    u32 rt = canon(c, c.t.a[r]) if g == types.T_FUNC else NONE
    u32 out = c.t.tuple(xs) if g == types.T_TUPLE else c.t.func(rt, c.t.b[r], xs)
    #delete(xs)
    return out

string8 ty(^C c, u32 x):
    if check.handle_ty(c.w, x): return "void *"
    u32 fx = foreign_row(c, x)
    if fx != NONE: return index.hold(strings.clone(c.t.text(c.t.b[fx])))
    u32 r = canon(c, x)
    u8 g = c.t.tag[r]
    // `const rawptr`: clang refuses a function stored where C's const pointer is.
    if g == types.T_PRIM && c.t.a[r] == u32(types.P_RAWPTR) && (c.t.quals(x) & 1) != 0: return "const void *"
    if g == types.T_PRIM: return PRIM_C[c.t.a[r]]
    if r == types.STRING8: return "dado_string"
    if r == types.STRING16: return "dado_string16"
    if r == types.STRING32: return "dado_string32"
    if r == types.CSTRING: return "const char *"
    if g == types.T_CSCALAR: return types.C_SCALARS[c.t.a[r]].c
    if g == types.T_OPAQUE: return index.hold(strings.clone(c.t.text(c.t.a[r])))
    if g == types.T_PTR:
        // `^const ev_t` of a header's type is C's `const ev_t *` (Rust's), so a
        // callback member's typedef is the header's `void (*)(const ev_t *)`.
        if foreign_row(c, c.t.a[r]) != NONE:
            if (c.t.quals(c.t.a[r]) & 1) != 0: return index.hold(#format("const ", ty(c, c.t.a[r]), " *"))
            return index.hold(#format(ty(c, c.t.a[r]), " *"))
        u32 q = canon(c, c.t.a[r])
        // `^const #c.char`, `^const u16` are C's `const char *`, `const uint16_t *` (else `-Wdiscarded-qualifiers`).
        if q != NONE && (c.t.tag[q] == types.T_CSCALAR || c.t.tag[q] == types.T_PRIM && c.t.a[q] != u32(types.P_RAWPTR)) && (c.t.quals(c.t.a[r]) & 1) != 0: return index.hold(#format("const ", ty(c, c.t.a[r]), " *"))
        if q == NONE || c.t.tag[q] != types.T_TUPLE: return index.hold(#format(ty(c, c.t.a[r]), " *"))
        // A pointee is declared now and defined later: it may hold this.
        string8 pn = shape_name(c, q)
        if !forwarded(c, q):
            put(&c.decls, index.hold(#format("typedef struct ", pn, " ", pn, ";\n")))
            c.pending = #append(c.pending, q)
        return index.hold(#format(pn, " *"))
    if g == types.T_DISTINCT: return ty(c, c.t.b[r])
    if g == types.T_SOA: return soa_ty(c, r)
    if g == types.T_SLICE: return "dado_view"
    if g == types.T_REF: return "dado_ref"
    if g == types.T_MAP: return map_ty(c, r)
    if g == types.T_TRAIT: return "dado_trait"
    if g == types.T_CHANNEL: return chan_ty(c, r)
    string8 name = shape_name(c, r)
    for d in c.done:
        if d == r: return name
    u32 e = NONE
    i64 n = 0
    bool u = c.t.uniform(r, &e, &n)
    if g == types.T_UNION && c.t.b[r] != 0:
        if !forwarded(c, r): put(&c.decls, index.hold(#format("typedef union ", name, " ", name, ";\n")))
        c.done = #append(c.done, r)
        ref []char8 body
        put(&body, index.hold(#format("union ", name, " { ")))
        []u32 ms = c.t.list(r)
        for j in 0..<#len(ms):
            put(&body, index.hold(#format(ty(c, c.t.list(r)[j]), " s", j, "; ")))
        put(&body, "};\n")
        put(&c.decls, body)
        return name
    if g == types.T_UNION:
        if !forwarded(c, r): put(&c.decls, index.hold(#format("typedef struct ", name, " ", name, ";\n")))
        c.done = #append(c.done, r)
        ref []char8 body
        put(&body, index.hold(#format("struct ", name, " { uint32_t tag; union { ")))
        []u32 ms = c.t.list(r)
        for j in 0..<#len(ms):
            put(&body, index.hold(#format(ty(c, c.t.list(r)[j]), " m", j, "; ")))
        put(&body, "} u; };\n")
        put(&c.decls, body)
        return name
    if u || g == types.T_TUPLE:
        // Declared first: a slot may point back at this shape.
        if !forwarded(c, r): put(&c.decls, index.hold(#format("typedef struct ", name, " ", name, ";\n")))
        c.done = #append(c.done, r)
        ref []char8 body
        put(&body, index.hold(#format("struct ", name, " { ")))
        if u: put(&body, index.hold(#format(ty(c, e), " a[", n, "]; ")))
        else:
            []u32 xs = c.t.list(r)
            for i in 0..<#len(xs):
                if c.t.tag[xs[i]] == types.T_ALIGNED: put(&body, index.hold(#format("_Alignas(", c.t.a[xs[i]], ") ")))
                put(&body, ty(c, xs[i]))
                put(&body, index.hold(#format(" s", i, "; ")))
        put(&body, "};\n")
        put(&c.decls, body)
        return name
    else if g == types.T_FUNC:
        ref []char8 body
        bool fl = c.t.b[r] != types.F_NONE
        bool out = fl && c.t.a[r] != u32(types.P_VOID)
        string8 rt = "int32_t"
        if !fl: rt = ty(c, c.t.a[r])
        put(&body, index.hold(#format("typedef ", rt, " (*", name, ")(")))
        if out: put(&body, index.hold(#format(ty(c, c.t.a[r]), " *")))
        []u32 xs = c.t.params(r)
        for i in 0..<#len(xs):
            if i > 0 || out: put(&body, ", ")
            put(&body, ty(c, xs[i]))
        if #len(xs) == 0 && !out: put(&body, "void")
        put(&body, ");\n")
        put(&c.decls, body)
    c.done = #append(c.done, r)
    return name

// The `foreign` row `x` names (through Dado names for it), or NONE.
private u32 foreign_row(^C c, u32 x):
    u32 t = x
    for _ in 0..<64:
        if t != NONE && (c.t.tag[t] == types.T_QUAL || c.t.tag[t] == types.T_DISTINCT):
            t = c.t.b[t]
            continue
        if t == NONE || c.t.tag[t] != types.T_NAMED: return NONE
        if c.t.text(c.t.a[t]) == "#c": return t
        t = c.t.body[t]
    return NONE

// Slot `i` of a value of type `t`, as C reaches it: a header's member by
// name, else Dado's own spelling.
string8 member(^C c, u32 t, u32 i):
    u32 fx = foreign_row(c, t)
    if fx != NONE:
        u64 key = (u64(fx) << 32) | u64(i)
        if key in c.w.cmember:
            try u32 m = c.w.cmember[key] else: return ""
            // An anonymous member has no C name: C11 lifts what it holds.
            string8 mn = c.t.text(m)
            if #len(mn) == 0: return ""
            return index.hold(#format(".", c.t.text(m)))
        []u32 ns = c.t.slot_names(fx)
        return index.hold(#format(".", c.t.text(ns[i])))
    u32 e = NONE
    i64 n = 0
    u32 r = c.t.resolve(t)
    if r != NONE && r in c.w.canon_u: return index.hold(#format(".", c.t.text(c.t.slot_names(r)[i])))
    for r != NONE && c.t.tag[r] == types.T_DISTINCT:
        r = c.t.resolve(c.t.b[r])
    // As the struct was written: over the canonical shape (an enum slot is its integer).
    if c.t.uniform(canon(c, r), &e, &n): return index.hold(#format(".a[", i, "]"))
    return index.hold(#format(".s", i))

// Dado array (or pointer) value `e` as the initializer of a header's
// array member: its elements in braces, or the address as `void *`.
// `ones`: each element is C's one-element array (`[3][1]i32`), braced.
private string8 c_init(^C c, string8 e, u32 t, bool ones = false):
    u32 r = c.t.resolve(t)
    if r != NONE && c.t.tag[r] == types.T_PTR: return index.hold(#format("(void *)(", e, ")"))
    if !check.c_array(c.w, t): return e
    u32 el = NONE
    i64 n = 0
    bool un = c.t.uniform(canon(c, r), &el, &n)
    []u32 xs = c.t.list(r)
    ref []char8 o
    put(&o, "{ ")
    for k in 0..<#len(xs):
        if k > 0: put(&o, ", ")
        string8 ek = index.hold(#format("(", e, ").s", k))
        if un: ek = index.hold(#format("(", e, ").a[", k, "]"))
        string8 v = c_init(c, ek, xs[k])
        if ones: v = index.hold(#format("{ ", v, " }"))
        put(&o, v)
    put(&o, " }")
    return index.hold(o)

// Whether operand `x` is a `const rawptr` (a slot's own type keeps the qualifier).
private bool cvoid(^C c, ^ir.Fn f, u32 x):
    if ir.is_const(x): return false
    u32 t = f.place_ty[x]
    if f.plo[x] == f.phi[x] && (f.root[x] & ir.ROOT_GLOBAL) == 0: t = f.slot_ty[f.root[x]]
    return ty(c, t) == "const void *"

// `x` of type `from` read as `to` (same bytes): a union, not a cast pointer, so -O2's
// strict aliasing keeps the store.
private string8 pun(^C c, u32 from, u32 to, string8 x):
    return index.hold(#format("((union { ", ty(c, from), " f; ", ty(c, to), " t; }){ .f = ", x, " }).t"))

// Slot `i` of `e`, a value of type `t`; a header's array (or pointer to
// one) member is read as Dado's array.
string8 slot_at(^C c, u32 t, string8 e, u32 i):
    string8 x = index.hold(#format(e, member(c, t, i)))
    u32 fx = foreign_row(c, t)
    // A header's array member, or a member list it named (held as Dado's shape).
    if fx == NONE || !check.c_array(c.w, check.slot_ty(c.t, t, i)) && !(((u64(fx) << 32) | u64(i)) in c.w.carray) && !(c.t.resolve(check.slot_ty(c.t, t, i)) in c.w.cnl): return x
    // Through a union of the two (gcc's rule for a pun), not a cast pointer: -O2's strict aliasing.
    return index.hold(#format("(((union { __typeof__(", x, ") f; ", ty(c, check.slot_ty(c.t, t, i)), " t; } *)&(", x, "))->t)"))

// Whether each of a header struct's first `n` slots has a C name, so a
// value of it is built with designators (`.x = …`, Rust's): an anonymous
// member's lifted names, and no brace elision for `-Wmissing-braces`.
private bool designated(^C c, u32 t, u32 n):
    u32 fx = foreign_row(c, t)
    if fx == NONE: return false
    []u32 ns = c.t.slot_names(fx)
    if i64(n) != #len(ns): return false
    for j in 0..<n:
        string8 mn = member(c, t, j)
        if #len(mn) == 0: return false
    return true

// A header struct of one array member (`(ap_one){ .b = { … } }`): Dado holds
// it as the array, so its `n` values are the member's elements.
private bool whole_array(^C c, u32 t, u32 n):
    u32 fx = foreign_row(c, t)
    if fx == NONE || n < 2: return false
    []u32 ns = c.t.slot_names(fx)
    if #len(ns) != 1: return false
    string8 mn = member(c, t, 0)
    return #len(mn) > 0

// The braces a value of `t` is built inside: a header's struct and Dado's
// tuples are flat, Dado's arrays hold one member.
private bool nested(^C c, u32 t):
    u32 e = NONE
    i64 n = 0
    return foreign_row(c, t) == NONE && c.t.uniform(canon(c, check.under(c.t, t)), &e, &n)

private string8 shape_name(^C c, u32 r):
    return check.shape_c_name(c.t, r)

private bool forwarded(^C c, u32 r):
    for d in c.done:
        if d == r: return true
    for d in c.pending:
        if d == r: return true
    return false

private void quoted(^ref []char8 o, string8 s):
    o^ = #append(o^, '"')
    char8 prev = '\x00'
    for ch in s:
        u8 b = u8(ch)
        // `?\?`: no trigraph (`??/` is `\` under -std=c11).
        if ch == '"' || ch == '\\' || ch == '?' && prev == '?': o^ = #append(o^, '\\')
        prev = ch
        if b < 32 || b >= 127:
            put(o, index.hold(#format("\\", char8(u8('0') + (b >> 6)), char8(u8('0') + ((b >> 3) & 7)), char8(u8('0') + (b & 7)))))
            continue
        o^ = #append(o^, ch)
    o^ = #append(o^, '"')

// A string's bytes as C: a literal, or past C's 4095 (`-Woverlength-strings`)
// a function-scope `static const char` array (Rust's `long_string`).
private void strlit(^C c, ^ir.Fn f, ^ref []char8 o, string8 s, u32 k):
    if #len(s) <= 4095 || f == nil:
        quoted(o, s)
        return
    string8 nm = index.hold(#format("dado_ls", k))
    put(o, nm)
    for x in c.longs:
        if x == k: return
    c.longs = #append(c.longs, k)
    ref []char8 h
    put(&h, index.hold(#format("    static const char ", nm, "[] = {")))
    for i in 0..<#len(s):
        if i % 16 == 0: put(&h, "\n       ")
        u8 b = u8(s[i])
        if b >= 32 && b < 127 && s[i] != '\'' && s[i] != '\\': put(&h, index.hold(#format(" '", s[i], "',")))
        else: put(&h, index.hold(#format(" '\\", char8(u8('0') + (b >> 6)), char8(u8('0') + ((b >> 3) & 7)), char8(u8('0') + (b & 7)), "',")))
    put(&h, " 0 };\n")
    put(&c.hoist, index.hold(h))

private bool lent_ptr(^C c, u32 t):
    u8 k = check.run_shape(c.w, t).kind
    return k == check.RK_TEXT || k == check.RK_SLICE || k == check.RK_REF

// Parameter `j`'s type of the call at op `i`, or NONE.
private u32 param_ty(^C c, ^ir.Fn f, u32 i, i64 j):
    if f.op[i] == ir.O_CALL_INDIRECT:
        u32 ft = c.t.resolve(f.place_ty[f.a[i]]) if !ir.is_const(f.a[i]) else NONE
        if ft == NONE || c.t.tag[ft] != types.T_FUNC: return NONE
        []u32 ps = c.t.params(ft)
        return ps[j] if j < #len(ps) else NONE
    if #len(c.fn_at) == 0:
        for k in 0..<#len(c.w.fns):
            c.fn_at[c.w.fns[k].name] = u32(k)
    u32 nm = f.ref_name[f.a[i]]
    if !(nm in c.fn_at): return NONE
    try u32 k = c.fn_at[nm] else: return NONE
    ^ir.Fn g = &c.w.fns[k]
    return g.slot_ty[j] if j < i64(g.params) else NONE

// `--implementations=`: single-header libraries' `define X_IMPL` (or
// `_IMPLEMENTATION`) left out of `dado.h`, their unit in `g_impl_text`.
bool g_impl_split
ref []char8 g_impl_text

private bool impl_switch(string8 d):
    i64 sp = strings.index_of(d, ' ')
    string8 n = d if sp < 0 else d[0..<sp]
    return strings.ends_with(n, "_IMPL") || strings.ends_with(n, "_IMPLEMENTATION")

// The last program written holds a map: its `main` seeds the hash (the web's `seed` call).
bool g_seeded

// `--line-directives`: a `#line` per source line, naming each file as
// `g_line_paths` has it (absolute, `--source-prefix-map`ped).
bool g_lines
// `--full-trace`: the shadow stack.
bool g_trace
ref []string8 g_line_paths

// An operand as C.
private void opd(^C c, ^ir.Fn f, u32 x):
    put(&c.out, text(c, f, x))

private string8 text(^C c, ^ir.Fn f, u32 x):
    if ir.is_const(x):
        u32 k = x & ~ir.OPD_CONST
        u8 kind = c.k.kind[k]
        if kind == types.C_INT:
            u64 lo = c.k.w0[k]
            if i64(c.k.w1[k]) < 0:
                if lo == 0x8000000000000000: return "(-9223372036854775807LL - 1)"
                return index.hold(#format("(-", 0 - lo, "LL)"))
            if lo > 0x7FFFFFFFFFFFFFFF: return index.hold(#format(lo, "ULL"))
            return index.hold(#format(lo, "LL"))
        if kind == types.C_BOOL: return "1" if c.k.a[k] != 0 else "0"
        if kind == types.C_FLOAT && c.k.a[k] == 32: return index.hold(#format("((float)", hexf(c.k.w0[k]), ")"))
        if kind == types.C_FLOAT: return hexf(c.k.w0[k])
        if kind == types.C_STR && c.k.b[k] == 1:
            ref []char8 o
            strlit(c, f, &o, c.t.text(c.k.a[k]), k)
            return index.hold(o)
        if kind == types.C_STR && c.k.b[k] >= 2: return wide_lit(c.t.text(c.k.a[k]), c.k.b[k] == 2)
        if kind == types.C_STR:
            string8 s = c.t.text(c.k.a[k])
            ref []char8 o
            put(&o, "((dado_string){ ")
            strlit(c, f, &o, s, k)
            put(&o, index.hold(#format(", ", #len(s), " })")))
            return index.hold(o)
        if kind == types.C_FN || kind == types.C_FOREIGN: return index.hold(strings.clone(c.t.text(c.k.b[k] if kind == types.C_FN else c.k.a[k])))
        return "{0}"
    u32 t = NONE
    if check.soa_whole(c.w, f, x) != NONE:
        ref []string8 ls
        u32 et = lanes(c, f, x, &ls)
        bool u = nested(c, et)
        ref []char8 o
        put(&o, index.hold(#format("((", ty(c, et), "){ ", "{ " if u else "")))
        for j in 0..<#len(ls):
            if j > 0: put(&o, ", ")
            put(&o, ls[j])
        put(&o, " } })" if u else " })")
        return index.hold(o)
    return path(c, f, x, f.phi[x], &t)

// The C place of `x`'s root and steps up to `hi`, its type in `tout`.
private string8 path(^C c, ^ir.Fn f, u32 x, u32 hi, ^u32 tout):
    u32 root = f.root[x]
    bool g = (root & ir.ROOT_GLOBAL) != 0
    u32 gi = root & ~ir.ROOT_GLOBAL
    string8 e = global_name(c, f.glob_pkg[gi], f.glob_name[gi]) if g else slot_name(c, f, root)
    u32 t = f.glob_ty[gi] if g else f.slot_ty[root]
    // A header's object, read as the Dado type it was declared.
    if g && c.t.text(f.glob_pkg[gi]) == "#c": e = index.hold(#format("(*(", ty(c, t), " *)&(", c.t.text(f.glob_name[gi]), "))"))
    bool skip = false
    for j in f.plo[x]..<hi:
        u8 st = f.step[j]
        u32 v = f.step_val[j]
        u32 r = c.t.resolve(t)
        if skip: skip = false
        else if st == ir.ST_INDEX && check.soa_row(c.t, t) != NONE:
            // A `#soa` position: the lane the next step names, at `v`.
            u32 et = soa_el(c, t)
            u32 le = NONE
            i64 k = 0
            u32 er = c.t.resolve(et)
            string8 i = text(c, f, v)
            if j + 1 < hi && c.t.uniform(er, &le, &k):
                u32 nv = f.step_val[j + 1]
                string8 q = text(c, f, nv) if f.step[j + 1] == ir.ST_INDEX else index.hold(#format(nv))
                e = index.hold(#format(e, ".s[", q, "][", i, "]"))
                t = le
                skip = true
            else if j + 1 < hi && er != NONE && c.t.tag[er] == types.T_TUPLE:
                u32 nv = f.step_val[j + 1]
                e = index.hold(#format(e, ".s", nv, "[", i, "]"))
                t = c.t.list(er)[nv]
                skip = true
            else:
                e = index.hold(#format(e, ".s0[", i, "]"))
                t = et
        else if st == ir.ST_FIELD:
            e = slot_at(c, t, e, v)
            t = check.slot_ty(c.t, t, v)
        else if st == ir.ST_INDEX:
            Elem m = elem(c, t)
            string8 i = text(c, f, v)
            // A header struct's slots by position, through an element pointer (no punned struct).
            if m.kind == check.RK_FIXED && foreign_row(c, t) != NONE: e = index.hold(#format("((", ty(c, m.ty), " *)&(", e, "))[", i, "]"))
            else if m.kind == check.RK_FIXED: e = index.hold(#format(e, ".a[", i, "]"))
            else if m.kind == check.RK_TEXT && m.ty == u32(types.P_CHAR8): e = index.hold(#format("((uint8_t)(", e, ").ptr[", i, "])"))
            else if m.kind == check.RK_TEXT: e = index.hold(#format("(", e, ").ptr[", i, "]"))
            else if m.kind == check.RK_PTR: e = index.hold(#format("(", e, ")[", i, "]"))
            else if m.kind != check.RK_ONE: e = index.hold(#format("((", ty(c, m.ty), " *)(", e, ").ptr)[", i, "]"))
            t = m.ty
        else if c.t.tag[r] == types.T_REF:
            e = index.hold(#format("(*(", ty(c, c.t.a[r]), " *)(", e, ").ptr)"))
            t = c.t.a[r]
        else:
            e = index.hold(#format("(*", e, ")"))
            t = c.t.a[r]
    tout^ = t
    return e

private u32 soa_el(^C c, u32 t):
    u32 e = NONE
    i64 k = 0
    _ = c.t.uniform(c.t.a[check.soa_row(c.t, t)], &e, &k)
    return e

// The lanes of the whole `#soa` element `x` names, as C places; its type.
private u32 lanes(^C c, ^ir.Fn f, u32 x, ^ref []string8 ls):
    u32 t = NONE
    string8 pre = path(c, f, x, f.phi[x] - 1, &t)
    string8 i = text(c, f, f.step_val[f.phi[x] - 1])
    u32 et = soa_el(c, t)
    u32 er = c.t.resolve(et)
    u32 le = NONE
    i64 k = 0
    if c.t.uniform(er, &le, &k):
        for j in 0..<k:
            ls^ = #append(ls^, index.hold(#format(pre, ".s[", j, "][", i, "]")))
    else if er != NONE && c.t.tag[er] == types.T_TUPLE:
        []u32 xs = c.t.list(er)
        for j in 0..<#len(xs):
            ls^ = #append(ls^, index.hold(#format(pre, ".s", j, "[", i, "]")))
    else: ls^ = #append(ls^, index.hold(#format(pre, ".s0[", i, "]")))
    return et

// `struct { E0 s0[N]; E1 s1[N]; … }`, or `E s[K][N]` over a run element.
private string8 soa_ty(^C c, u32 r):
    string8 name = check.shape_c_name(c.t, r)
    for d in c.done:
        if d == r: return name
    c.done = #append(c.done, r)
    u32 e = NONE
    i64 n = 0
    _ = c.t.uniform(c.t.a[r], &e, &n)
    u32 er = c.t.resolve(e)
    u32 le = NONE
    i64 k = 0
    ref []char8 body
    put(&body, index.hold(#format("typedef struct ", name, " { ")))
    if c.t.uniform(er, &le, &k): put(&body, index.hold(#format(ty(c, le), " s[", k, "][", n, "]; ")))
    else if er != NONE && c.t.tag[er] == types.T_TUPLE:
        []u32 xs = c.t.list(er)
        for j in 0..<#len(xs):
            put(&body, index.hold(#format(ty(c, c.t.list(er)[j]), " s", j, "[", n, "]; ")))
    else: put(&body, index.hold(#format(ty(c, e), " s0[", n, "]; ")))
    put(&body, index.hold(#format("} ", name, ";\n")))
    put(&c.decls, body)
    return name

string8 global_name(^C c, u32 pkg, u32 name):
    return index.hold(#format("dado_g_", c.t.text(pkg), "_", c.t.text(name)))

// A float's bits as a C hex literal.
string8 hexf(u64 bits):
    string8 sign = "-" if (bits >> 63) != 0 else ""
    u64 e = (bits >> 52) & 0x7FF
    u64 m = bits & 0xFFFFFFFFFFFFF
    if e == 0x7FF: return "(0.0 / 0.0)" if m != 0 else index.hold(#format("(", sign, "1.0 / 0.0)"))
    if e == 0 && m == 0: return index.hold(#format("(", sign, "0.0)"))
    ref []char8 o
    put(&o, index.hold(#format("(", sign, "0x", "1" if e != 0 else "0", ".")))
    for i in 0..<13:
        o = #append(o, "0123456789abcdef"[i64((m >> u64(48 - 4 * i)) & 15)])
    put(&o, index.hold(#format("p", i64(e) - 1023 if e != 0 else -1022, ")")))
    return index.hold(o)

private bool opaque(^C c, u32 t):
    u32 r = c.t.resolve(t)
    return r != NONE && c.t.tag[r] == types.T_OPAQUE

private bool composite(^C c, u32 x):
    u8 k = c.k.kind[x & ~ir.OPD_CONST]
    return k == types.C_TUPLE || k == types.C_UNION

// A constant as a C initializer for type `t` (`flat`: a header's array
// member, which has no Dado wrapper braces).
string8 cinit(^C c, u32 k, u32 t, bool flat = false):
    if c.k.kind[k] == types.C_UNION:
        u32 m = c.t.list(c.t.resolve(t))[c.k.a[k]]
        return index.hold(#format("{ ", c.k.a[k], ", { .m", c.k.a[k], " = ", cinit(c, c.k.list(k)[0], m), " } }"))
    if c.k.kind[k] == types.C_WINDOW: return index.hold(#format("{ (void *)&(", c.t.text(c.k.a[k]), ".a[", c.k.w0[k], "]), ", c.k.w1[k], " }"))
    // A static initializer takes no compound literal (`-pedantic`).
    if c.k.kind[k] == types.C_STR && c.k.b[k] == 0:
        string8 s = c.t.text(c.k.a[k])
        ref []char8 so
        put(&so, "{ ")
        quoted(&so, s)
        put(&so, index.hold(#format(", ", #len(s), " }")))
        return index.hold(so)
    if c.k.kind[k] == types.C_STR && c.k.b[k] >= 2: return wide_lit(c.t.text(c.k.a[k]), c.k.b[k] == 2, true)
    if c.k.kind[k] != types.C_TUPLE: return text(c, nil, ir.konst(k))
    []u32 xs = c.k.list(k)
    if #len(xs) == 0: return "{ 0 }"
    u32 r = c.t.resolve(t)
    []u32 sl = c.t.slots(r)
    bool u = nested(c, t) && !flat
    u32 fx = foreign_row(c, t)
    bool fr = fx != NONE
    bool named = designated(c, t, u32(#len(xs)))
    bool whole = !named && whole_array(c, t, u32(#len(xs)))
    ref []char8 o
    put(&o, "{ { " if u else "{ ")
    if whole:
        string8 wn = member(c, t, 0)
        put(&o, index.hold(#format(wn, " = { ")))
    for i in 0..<#len(xs):
        if i > 0: put(&o, ", ")
        u32 st = NONE
        if i < #len(sl): st = sl[i]
        if named:
            string8 mn = member(c, t, u32(i))
            put(&o, index.hold(#format(mn, " = ")))
        u64 key = (u64(fx) << 32) | u64(i)
        if whole:
            put(&o, cinit(c, xs[i], st))
            continue
        if fr && key in c.w.carray:
            put(&o, index.hold(#format("{ ", cinit(c, xs[i], st), " }")))
            continue
        if fr && key in c.w.cinner && c.k.kind[xs[i]] == types.C_TUPLE:
            // `[3][1]i32`: each element is C's one-element array.
            u32 el = NONE
            i64 n = 0
            _ = c.t.uniform(c.t.resolve(st), &el, &n)
            put(&o, "{ ")
            []u32 es = c.k.list(xs[i])
            for q in 0..<#len(es):
                if q > 0: put(&o, ", ")
                put(&o, index.hold(#format("{ ", cinit(c, es[q], el), " }")))
            put(&o, " }")
            continue
        put(&o, cinit(c, xs[i], st, flat || fr && st != NONE && check.c_array(c.w, st)))
    if whole: put(&o, " }")
    put(&o, " } }" if u else " }")
    return index.hold(o)

// What a run holds: its kind (`check.RK_*`), element and fixed count.
type Elem:
    u8 kind
    u32 ty
    i64 n
    // A header struct read as Dado's array: the shape it is read as, else NONE.
    u32 run

private Elem elem(^C c, u32 t):
    u32 r = check.under(c.t, t)
    if types.is_text(r): return Elem(check.RK_TEXT, u32(types.text_unit(r)), 0, NONE)
    if c.t.tag[r] == types.T_SLICE: return Elem(check.RK_SLICE, c.t.a[r], 0, NONE)
    if c.t.tag[r] == types.T_PTR: return Elem(check.RK_PTR, c.t.a[r], 0, NONE)
    if c.t.tag[r] == types.T_REF && check.one_ref(c.w, r): return Elem(check.RK_REF, c.t.a[r], 0, NONE)
    if c.t.tag[r] == types.T_REF: return Elem(check.RK_REF, c.t.a[c.t.resolve(c.t.a[r])], 0, NONE)
    u32 e = NONE
    i64 n = 0
    u32 fr = NONE
    if foreign_row(c, t) != NONE: fr = r
    if c.t.uniform(r, &e, &n): return Elem(check.RK_FIXED, e, n, fr)
    return Elem(check.RK_ONE, r, 1, NONE)

// A run's element pointer and length, as C.
private string8 base_ptr(^C c, string8 e, Elem m):
    if m.kind == check.RK_FIXED && m.run != NONE: return index.hold(#format("((", ty(c, m.ty), " *)&(", e, "))"))
    if m.kind == check.RK_FIXED: return index.hold(#format("(", e, ").a"))
    if m.kind == check.RK_ONE: return index.hold(#format("(&(", e, "))"))
    if m.kind == check.RK_TEXT: return index.hold(#format("(", e, ").ptr"))
    if m.kind == check.RK_PTR: return index.hold(#format("(", e, ")"))
    return index.hold(#format("((", ty(c, m.ty), " *)(", e, ").ptr)"))

private string8 base_len(string8 e, Elem m):
    if m.kind == check.RK_FIXED || m.kind == check.RK_ONE: return index.hold(#format(m.n, "LL"))
    return index.hold(#format("(", e, ").len"))

private string8 slot_name(^C c, ^ir.Fn f, u32 s):
    if f.slot_name[s] == NONE: return index.hold(#format("dado_t", s))
    return index.hold(#format("dado_l_", c.t.text(f.slot_name[s]), "_", s))

private string8 sig(^C c, ^ir.Fn f):
    ref []char8 o
    // One program of several `@test` files: each `test()` keeps its name.
    if (f.flags & ir.H_ENTRY) != 0 && #len(index.g_tests) > 1: return index.hold(#format("int ", c.t.text(f.name), "(void)"))
    if (f.flags & ir.H_ENTRY) != 0: return "int main(void)" if f.params == 0 else "int main(int argc, char **argv)"
    u32 ret = c.t.a[f.ty]
    bool fl = (f.flags & ir.H_FAILABLE) != 0
    bool out = fl && ret != u32(types.P_VOID)
    put(&o, symbol_attrs(c, f))
    if fl: put(&o, "int32_t")
    else: put(&o, ty(c, ret))
    put(&o, " ")
    put(&o, c.t.text(f.name))
    put(&o, "(")
    if out: put(&o, index.hold(#format(ty(c, ret), " *dado_out")))
    for i in 0..<f.params:
        if i > 0 || out: put(&o, ", ")
        put(&o, ty(c, f.slot_ty[i]))
        put(&o, " ")
        put(&o, slot_name(c, f, i))
    if f.params == 0 && !out: put(&o, "void")
    put(&o, ")")
    return index.hold(o)

private void wide(^C c, u32 t):
    u8 p = check.int_prim_of(c.t, t)
    bool big = types.integer_bits(p) == 64
    put(&c.out, "(uint64_t)" if big else "(uint32_t)")

private void bin(^C c, ^ir.Fn f, u32 i, string8 where):
    u8 s = f.sub[i]
    u32 t = f.ty_of[i]
    if c.t.resolve(t) == u32(types.P_RAWPTR) && s != ir.B_EQ && s != ir.B_NE:
        [16]string8 os = ["+", "-", "", "", "", "", "", "", "", "", "", "", "<", "<=", ">", ">="]
        bool raw = false
        if !ir.is_const(f.b[i]): raw = c.t.resolve(f.place_ty[f.b[i]]) == u32(types.P_RAWPTR)
        string8 rb = text(c, f, f.b[i])
        if raw: rb = index.hold(#format("(char *)(", rb, ")"))
        string8 x = index.hold(#format("((char *)(", text(c, f, f.a[i]), ") ", os[s], " ", rb, ")"))
        if !raw && s <= ir.B_SUB: put(&c.out, "(void *)")
        put(&c.out, x)
        return
    u8 rk = check.run_shape(c.w, t).kind
    bool one = c.t.tag[c.t.resolve(t)] == types.T_REF
    if one && (s == ir.B_EQ || s == ir.B_NE) && !ir.is_const(f.a[i]) && !ir.is_const(f.b[i]):
        put(&c.out, index.hold(#format("((", text(c, f, f.a[i]), ").ptr ", "==" if s == ir.B_EQ else "!=", " (", text(c, f, f.b[i]), ").ptr)")))
        return
    if (rk == check.RK_SLICE || rk == check.RK_REF || one) && (s == ir.B_EQ || s == ir.B_NE) && (ir.is_const(f.a[i]) || ir.is_const(f.b[i])):
        // Against `nil`: whether it points anywhere.
        u32 x = f.b[i] if ir.is_const(f.a[i]) else f.a[i]
        put(&c.out, index.hold(#format("((", text(c, f, x), ").ptr ", "==" if s == ir.B_EQ else "!=", " 0)")))
        return
    if rk == check.RK_SLICE && (s == ir.B_EQ || s == ir.B_NE):
        put(&c.out, index.hold(#format("!" if s == ir.B_NE else "", eq_of(c, t, text(c, f, f.a[i]), text(c, f, f.b[i])))))
        return
    if types.is_text(c.t.resolve(t)):
        string8 eq = "dado_str_eq(" if c.t.resolve(t) == types.STRING8 else "dado_str16_eq(" if c.t.resolve(t) == types.STRING16 else "dado_str32_eq("
        put(&c.out, index.hold(#format("!" if s == ir.B_NE else "", eq, text(c, f, f.a[i]), ", ", text(c, f, f.b[i]), ")")))
        return
    if (s == ir.B_SHL || s == ir.B_SHR) && !ir.is_const(f.b[i]):
        // A count outside `0..<width` shifts every bit out.
        u8 p = check.int_prim_of(c.t, t)
        u8 q = check.int_prim_of(c.t, f.place_ty[f.b[i]])
        string8 n = text(c, f, f.b[i])
        string8 x = text(c, f, f.a[i])
        string8 cty = ty(c, t)
        string8 u = index.hold(#format("(uint64_t)(int64_t)(", n, ")") if types.is_signed(q) else #format("(uint64_t)(", n, ")"))
        string8 fill = "0"
        if s == ir.B_SHR && types.is_signed(p): fill = index.hold(#format("(", x, " < 0 ? -1 : 0)"))
        string8 big = "(uint64_t)" if types.integer_bits(p) == 64 else "(uint32_t)"
        string8 op = "<<" if s == ir.B_SHL else ">>"
        string8 l = index.hold(#format(big, x) if s == ir.B_SHL else #format(x))
        put(&c.out, index.hold(#format("(", u, " < ", types.integer_bits(p), " ? (", cty, ")(", l, " ", op, " ", n, ") : (", cty, ")", fill, ")")))
        return
    string8 cty = ty(c, t)
    if check.int_prim_of(c.t, t) == types.PRIMS && s <= ir.B_DIV:
        [4]string8 fo = ["+", "-", "*", "/"]
        put(&c.out, index.hold(#format("(", cty, ")(", text(c, f, f.a[i]), " ", fo[s], " ", text(c, f, f.b[i]), ")")))
        return
    if s == ir.B_ADD || s == ir.B_SUB || s == ir.B_MUL || s == ir.B_SHL:
        string8 op = "+" if s == ir.B_ADD else ("-" if s == ir.B_SUB else ("*" if s == ir.B_MUL else "<<"))
        put(&c.out, index.hold(#format("(", cty, ")(")))
        wide(c, t)
        opd(c, f, f.a[i])
        put(&c.out, index.hold(#format(" ", op, " ")))
        if s != ir.B_SHL: wide(c, t)
        opd(c, f, f.b[i])
        put(&c.out, ")")
        return
    if s == ir.B_DIV || s == ir.B_REM:
        string8 op = "/" if s == ir.B_DIV else "%"
        put(&c.out, "(")
        opd(c, f, f.b[i])
        put(&c.out, " == 0 ? (dado_div_zero((unsigned long long)")
        opd(c, f, f.a[i])
        bool sg = types.is_signed(check.int_prim_of(c.t, t))
        i64 sgn = 0
        if sg: sgn = 1
        put(&c.out, index.hold(#format(", ", sgn, ", \"", "%" if s == ir.B_REM else "/", "\", \"", where, "\"), (", cty, ")0) : (")))
        if sg:
            opd(c, f, f.b[i])
            put(&c.out, " == -1 ? (")
            if s == ir.B_DIV:
                put(&c.out, index.hold(#format("(", cty, ")(0 - ")))
                wide(c, t)
                opd(c, f, f.a[i])
                put(&c.out, ")")
            else: put(&c.out, "0")
            put(&c.out, ") : ")
        put(&c.out, index.hold(#format("(", cty, ")(")))
        opd(c, f, f.a[i])
        put(&c.out, index.hold(#format(" ", op, " ")))
        opd(c, f, f.b[i])
        put(&c.out, ")))")
        return
    [16]string8 ops = ["+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>", "==", "!=", "<", "<=", ">", ">="]
    if s < ir.B_EQ: put(&c.out, index.hold(#format("(", cty, ")")))
    // A comparison against a constant: the constant behind a comma (no
    // constant expression), so gcc's `-Wtype-limits` and clang's range checks
    // do not decide it from the other operand's type (`u8 x < 0`).
    bool hide = s >= ir.B_EQ && ir.is_const(f.a[i]) != ir.is_const(f.b[i]) && check.int_prim_of(c.t, t) != types.PRIMS
    put(&c.out, "(")
    if hide && ir.is_const(f.a[i]): put(&c.out, index.hold(#format("((void)0, ", text(c, f, f.a[i]), ")")))
    else: opd(c, f, f.a[i])
    put(&c.out, index.hold(#format(" ", ops[s], " ")))
    if hide && ir.is_const(f.b[i]): put(&c.out, index.hold(#format("((void)0, ", text(c, f, f.b[i]), ")")))
    else: opd(c, f, f.b[i])
    put(&c.out, ")")

const [5]string8 ORDERS = ("__ATOMIC_RELAXED", "__ATOMIC_ACQUIRE", "__ATOMIC_RELEASE", "__ATOMIC_ACQ_REL", "__ATOMIC_SEQ_CST")
const [5]string8 FETCHES = ("add", "sub", "and", "or", "xor")

// The atomics as gcc/clang `__atomic` builtins.
private void atomic(^C c, ^ir.Fn f, u32 i):
    []u32 xs = ir.args(f, i)
    u8 m = f.sub[i]
    ref []string8 os
    for x in xs:
        if ir.is_const(x) && c.k.kind[x & ~ir.OPD_CONST] == types.C_INT && c.k.w0[x & ~ir.OPD_CONST] >= 10 && c.k.w0[x & ~ir.OPD_CONST] <= 50: os = #append(os, ORDERS[i64(c.k.w0[x & ~ir.OPD_CONST]) / 10 - 1])
    if m == check.B_FENCE:
        put(&c.out, index.hold(#format("DADO_FENCE(", os[0], ");\n")))
        return
    string8 p = text(c, f, xs[0])
    string8 d = ""
    if f.dst[i] != NONE: d = index.hold(#format(text(c, f, f.dst[i]), " = "))
    if m == check.B_ATOMIC_LOAD: put(&c.out, index.hold(#format(d, "__atomic_load_n(", p, ", ", os[0], ");\n")))
    else if m == check.B_ATOMIC_STORE: put(&c.out, index.hold(#format("__atomic_store_n(", p, ", ", text(c, f, xs[1]), ", ", os[0], ");\n")))
    else if m == check.B_ATOMIC_EXCHANGE: put(&c.out, index.hold(#format(d, "__atomic_exchange_n(", p, ", ", text(c, f, xs[1]), ", ", os[0], ");\n")))
    else if m == check.B_ATOMIC_COMPARE_EXCHANGE:
        put(&c.out, index.hold(#format("{ ", ty(c, f.ty_of[i]), " dado_e = ", text(c, f, xs[1]), "; _Bool dado_s = __atomic_compare_exchange_n(", p, ", &dado_e, ", text(c, f, xs[2]), ", ", text(c, f, xs[3]), ", ", os[0], ", ", os[1], "); ", d, "(", ty(c, f.place_ty[f.dst[i]]), "){ dado_e, dado_s }; }\n")))
    else: put(&c.out, index.hold(#format(d, "__atomic_fetch_", FETCHES[i64(m - check.B_ATOMIC_FETCH_ADD)], "(", p, ", ", text(c, f, xs[1]), ", ", os[0], ");\n")))

// What `#panic`, `#assert` and `#expect` say on stderr, as Rust's.
private void said(^C c, ^ir.Fn f, u32 i, string8 where):
    []u32 xs = ir.args(f, i)
    u8 m = f.sub[i]
    string8 head = "panic: "
    if m == check.B_EXPECT: head = "expectation failed: "
    if m == check.B_ASSERT && #len(xs) == 0: head = "assertion failed"
    else if m == check.B_ASSERT: head = "assertion failed: "
    put(&c.out, index.hold(#format("{ int64_t n = 0; fputs(\"", head, "\", stderr); ")))
    for x in xs:
        rend(c, text(c, f, x), f.place_ty[x], "dado_stderr", 0)
    put(&c.out, index.hold(#format("(void)n; fputs(\"\\n\", stderr); dado_where(\"", where, "\"); }\n")))

private void render(^C c, ^ir.Fn f, u32 i):
    []u32 xs = ir.args(f, i)
    put(&c.out, "{ int64_t n = 0; ")
    rend(c, text(c, f, xs[0]), f.place_ty[xs[0]], text(c, f, xs[1]), 0)
    put(&c.out, index.hold(#format(text(c, f, f.dst[i]), " = n; }")))

private void emit(^C c, string8 k, string8 p, string8 n):
    put(&c.out, index.hold(#format("n += ", k, ".s0(", k, ".s1, (void *)(", p, "), ", n, "); ")))

// Value `e` of type `t` into sink `k`: text and `char8` runs as their
// bytes, other runs and tuples as `[a, b]`.
void rend(^C c, string8 e, u32 t, string8 k, i64 d):
    u32 r = c.t.resolve(t)
    string8 b = index.hold(#format("b", d))
    if r in c.w.cnl:
        rend(c, e, c.t.b[r], k, d)
        return
    if c.t.tag[r] == types.T_MAP:
        rend_map(c, e, r, k, d)
        return
    if r == types.STRING8:
        emit(c, k, index.hold(#format("(", e, ").ptr")), index.hold(#format("(", e, ").len")))
        return
    if r == types.STRING16 || r == types.STRING32:
        // Transcoded to UTF-8, a code point at a time.
        string8 cp = index.hold(#format("dado_cp32((", b, "s).ptr[", b, "i++])"))
        if r == types.STRING16: cp = index.hold(#format("dado_cp16((", b, "s).ptr, (", b, "s).len, &", b, "i)"))
        put(&c.out, index.hold(#format("{ ", ty(c, r), " ", b, "s = ", e, "; int64_t ", b, "i = 0; while (", b, "i < ", b, "s.len) { char ", b, "[4]; int ", b, "n = dado_utf8(", cp, ", ", b, "); ")))
        emit(c, k, b, index.hold(#format(b, "n")))
        put(&c.out, "} } ")
        return
    if r == types.CSTRING:
        put(&c.out, index.hold(#format("{ const char *", b, " = (", e, ") ? (", e, ") : \"\"; ")))
        emit(c, k, b, index.hold(#format("dado_clen(", b, ")")))
        put(&c.out, "} ")
        return
    bool cs = c.t.tag[r] == types.T_CSCALAR
    if r == u32(types.P_BOOL) || cs && types.C_SCALARS[c.t.a[r]].class == types.CS_BOOL:
        put(&c.out, index.hold(#format("{ const char *", b, " = (", e, ") ? \"true\" : \"false\"; ")))
        emit(c, k, b, index.hold(#format("(", e, ") ? 4 : 5")))
        put(&c.out, "} ")
        return
    if c.t.tag[r] == types.T_PRIM && types.in_float(types.PRIM[c.t.a[r]].canon) || cs && types.C_SCALARS[c.t.a[r]].class == types.CS_FLOAT:
        put(&c.out, index.hold(#format("{ char ", b, "[32]; int ", b, "n = snprintf(", b, ", sizeof ", b, ", \"%g\", dado_g((double)(", e, "))); ")))
        emit(c, k, b, index.hold(#format(b, "n")))
        put(&c.out, "} ")
        return
    if r == u32(types.P_RAWPTR) || c.t.tag[r] == types.T_PTR:
        put(&c.out, index.hold(#format("{ char ", b, "[24]; int ", b, "n = snprintf(", b, ", sizeof ", b, ", \"0x%llx\", (unsigned long long)(uintptr_t)(", e, ")); ")))
        emit(c, k, b, index.hold(#format(b, "n")))
        put(&c.out, "} ")
        return
    u8 p = check.int_prim_of(c.t, r)
    bool cch = cs && types.C_SCALARS[c.t.a[r]].class == types.CS_CHARACTER
    if cch || p != types.PRIMS && types.PRIM[p].kind == types.K_CHAR && types.PRIM[p].bits > 8:
        put(&c.out, index.hold(#format("{ char ", b, "[4]; int ", b, "n = dado_utf8((uint32_t)(", e, "), ", b, "); ")))
        emit(c, k, b, index.hold(#format(b, "n")))
        put(&c.out, "} ")
        return
    if p != types.PRIMS && types.PRIM[p].kind == types.K_CHAR:
        put(&c.out, index.hold(#format("{ char ", b, " = (char)(", e, "); ")))
        emit(c, k, index.hold(#format("&", b)), "1")
        put(&c.out, "} ")
        return
    if c.t.tag[r] == types.T_DISTINCT && t in c.w.type_decl:
        // A distinct enum renders the member a value is, else the number.
        try u32 ed = c.w.type_decl[t] else: return
        for key in c.w.order:
            if u32(key >> 32) != ed: continue
            try u32 m = c.w.members[key] else: continue
            if m == NONE: continue
            string8 nm = check.name_of(c.w, u32(key & 0xFFFFFFFF))
            put(&c.out, index.hold(#format("if ((", e, ") == ", text(c, nil, ir.konst(m)), ") { ")))
            emit(c, k, index.hold(#format("\"", nm, "\"")), index.hold(#format(#len(nm))))
            put(&c.out, "} else ")
        put(&c.out, "{ ")
        rend(c, e, c.t.b[r], k, d)
        put(&c.out, "} ")
        return
    if p != types.PRIMS:
        put(&c.out, index.hold(#format("{ char ", b, "[20]; ")))
        string8 f = "dado_i64((long long)" if types.is_signed(p) else "dado_u64((unsigned long long)"
        emit(c, k, b, index.hold(#format(f, "(", e, "), ", b, ")")))
        put(&c.out, "} ")
        return
    if c.t.tag[r] == types.T_UNION:
        []u32 ms = c.t.list(r)
        for j in 0..<#len(ms):
            put(&c.out, index.hold(#format("if ((", e, ").tag == ", j, ") { ")))
            rend(c, index.hold(#format("(", e, ").u.m", j)), c.t.list(r)[j], k, d + 1)
            put(&c.out, "} else ")
        put(&c.out, "{ } ")
        return
    Elem m = elem(c, r)
    if c.t.tag[r] == types.T_REF:
        put(&c.out, index.hold(#format("if ((", e, ").ptr == 0) { ")))
        emit(c, k, "\"nil\"", "3")
        put(&c.out, "} else { ")
    if m.kind != check.RK_ONE && c.t.resolve(m.ty) == u32(types.P_CHAR8):
        emit(c, k, base_ptr(c, e, m), base_len(e, m))
        if c.t.tag[r] == types.T_REF: put(&c.out, "} ")
        return
    rend_run(c, e, t, k, d, m)
    if c.t.tag[r] == types.T_REF: put(&c.out, "} ")

private void rend_run(^C c, string8 e, u32 t, string8 k, i64 d, Elem m):
    u32 r = c.t.resolve(t)
    bool paren = c.t.tag[r] == types.T_TUPLE && m.kind != check.RK_FIXED
    emit(c, k, "\"(\"" if paren else "\"[\"", "1")
    if m.kind == check.RK_SLICE || m.kind == check.RK_REF:
        string8 i = index.hold(#format("i", d))
        put(&c.out, index.hold(#format("for (int64_t ", i, " = 0; ", i, " < (", e, ").len; ", i, "++) { if (", i, ") ")))
        emit(c, k, "\", \"", "2")
        rend(c, index.hold(#format(base_ptr(c, e, m), "[", i, "]")), m.ty, k, d + 1)
        put(&c.out, "} ")
    else if c.t.tag[r] == types.T_TUPLE && m.kind == check.RK_FIXED && m.n > MAX_UNROLLED && foreign_row(c, t) == NONE:
        // Past the threshold a fixed array renders through a loop (Rust's).
        string8 i = index.hold(#format("i", d))
        put(&c.out, index.hold(#format("for (int64_t ", i, " = 0; ", i, " < ", m.n, "; ", i, "++) { if (", i, ") ")))
        emit(c, k, "\", \"", "2")
        rend(c, index.hold(#format("(", e, ").a[", i, "]")), m.ty, k, d + 1)
        put(&c.out, "} ")
    else if c.t.tag[r] == types.T_TUPLE:
        []u32 xs = c.t.list(r)
        for j in 0..<#len(xs):
            if j > 0: emit(c, k, "\", \"", "2")
            rend(c, slot_at(c, t, e, u32(j)), xs[j], k, d + 1)
    emit(c, k, "\")\"" if paren else "\"]\"", "1")

private void indent(^C c, i64 d):
    for _ in 0..<d:
        put(&c.out, "    ")

// `(void)` for each declared slot no op reads, so a set-but-unread one is
// `-Werror` clean. An operand missed here only costs an extra `(void)`.
private void unread(^C c, ^ir.Fn f, bool entry, []u8 sc):
    ref []bool read
    for _ in f.slot_ty:
        read = #append(read, false)
    for i in 0..<ir.count(f):
        u8 op = f.op[i]
        if sc[i] == SC_SKIP: continue
        if op == ir.O_BLOCK || op == ir.O_LOOP || op == ir.O_BREAK || op == ir.O_CONTINUE || op == ir.O_C_INLINE || op == ir.O_SCOPE_END: continue
        if op != ir.O_CALL && op != ir.O_INTRINSIC: mark(f, f.a[i], &read)
        if op == ir.O_BIN || op == ir.O_CHECK || op == ir.O_VIEW: mark(f, f.b[i], &read)
        if op == ir.O_VIEW: mark(f, f.c[i], &read)
        if op == ir.O_MAKE || op == ir.O_CALL || op == ir.O_CALL_INDIRECT || op == ir.O_INTRINSIC:
            for x in ir.args(f, i):
                mark(f, x, &read)
    for s in 0..<u32(#len(f.slot_ty)):
        bool local = s >= f.params || entry
        // Every local: clang's set-but-unused sees C reads, not IR reads (a
        // struct only written). `&`: no load (UBSan's bool check, -Wmaybe-uninitialized).
        if read[s] && !local: continue
        put(&c.out, index.hold(#format("    (void)", "&" if local else "", slot_name(c, f, s), ";\n")))
    #delete(read)

private void mark(^ir.Fn f, u32 x, ^ref []bool read):
    if x == NONE || ir.is_const(x) || x >= u32(#len(f.root)): return
    u32 r = f.root[x]
    if (r & ir.ROOT_GLOBAL) == 0 && r < u32(#len(read^)): read^[r] = true

// `--full-trace`: the frame naming `f` (`pkg.name`), pushed at entry,
// popped on every way out.
// `@symbol(noinline, no_sanitize_address)` on `f`'s declaration, as
// `DADO_SYMBOL(word) ` each, in written order; "" without one.
private string8 symbol_attrs(^C c, ^ir.Fn f):
    ^check.World w = c.w
    for i in 0..<#len(w.fns):
        if &w.fns[i] != f || w.jobs[i].decl == NONE: continue
        u32 d = w.jobs[i].decl
        syntax.Ast a = w.p.files[w.decls[d].file].a
        u32 n = w.decls[d].node
        if a.tag[n] != syntax.N_FN: return ""
        []u32 ks = a.list(a.b[n])
        if #len(ks) < 3 || ks[2] == NONE: return ""
        ref []char8 o
        for wd in a.list(a.b[ks[2]]):
            if wd == NONE: continue
            put(&o, index.hold(#format("DADO_SYMBOL(", w.p.files[w.decls[d].file].src[i64(w.p.files[w.decls[d].file].t.start[a.main[wd]])..<i64(w.p.files[w.decls[d].file].t.end[a.main[wd]])], ") ")))
        return index.hold(o)
    return ""

private void frame(^C c, ^ir.Fn f, string8 path, ^check.World w):
    string8 nm = c.t.text(f.name)
    for i in 0..<#len(w.fns):
        if &w.fns[i] != f || w.jobs[i].decl == NONE: continue
        u32 d = w.jobs[i].decl
        u32 p = w.decls[d].pkg
        string8 pn = check.name_of(w, w.p.pkgs[p].name) if w.p.pkgs[p].name != NONE else "main"
        string8 dn = check.name_of(w, w.decls[d].name)
        if strings.starts_with(dn, "test__file"): dn = "test"
        u32 bl = w.decls[d].block
        if bl != NONE && w.decls[d].kind == check.K_METHOD: dn = index.hold(#format(check.name_of(w, w.decls[bl].name), ".", dn))
        nm = index.hold(#format(pn, ".", dn))
        break
    string8 file = path
    put(&c.out, index.hold(#format("    static const dado_rt__fn dado_tf = { \"", nm, "\", ", #len(nm), ", \"", file, "\", ", #len(file), " };\n    dado_rt__frame *dado_sf __attribute__((cleanup(dado_rt__pop))) = dado_rt__push(&dado_tf);\n")))

// Web runtime file `name` (built in, `assets.dado`) with its own
// `#include "web.h"`/`"rt/X.c"` lines replaced by those files.
private string8 expanded(string8 name):
    ref []char8 o
    for line in strings.split(asset(name), "\n"):
        if strings.starts_with(line, "#include \"") && strings.ends_with(line, "\""):
            string8 inc = line[10..<#len(line) - 1]
            string8 sub = "web/web.h" if inc == "web.h" else index.hold(#format("web/", inc))
            string8 st = asset(sub)
            if #len(st) > 0:
                put(&o, expanded(sub))
                continue
        put(&o, line)
        put(&o, "\n")
    if #len(o) > 0: #truncate(o, #len(o) - 1)
    if !strings.ends_with(index.hold(o), "\n"): put(&o, "\n")
    return index.hold(o)

// Whether `f`'s last op returns (else a block's exit code follows a return).
private bool ends_returning(^ir.Fn f):
    u32 n = ir.count(f)
    return n == 0 || f.op[n - 1] == ir.O_RETURN || f.op[n - 1] == ir.O_RETURN_FAIL

// Function `f`'s definition.
void define(^C c, ^ir.Fn f, string8 path, ^check.World w):
    put(&c.out, sig(c, f))
    put(&c.out, " {\n")
    if g_trace: frame(c, f, path, w)
    bool entry = (f.flags & ir.H_ENTRY) != 0
    for s in 0..<u32(#len(f.slot_ty)):
        if s < f.params && !entry: continue
        put(&c.out, index.hold(#format("    ", ty(c, f.slot_ty[s]), " ", slot_name(c, f, s))))
        if entry && s < f.params: put(&c.out, " = argc" if s == 0 else " = (void *)argv")
        put(&c.out, ";\n")
        if (f.slot_flags[s] & ir.S_WATCH) != 0: put(&c.out, index.hold(#format("    dado_stale dado_sw", s, " = { 0, 0 }; (void)dado_sw", s, ";\n")))  // a watch may go unchecked (reads through calls)
    ref []u8 sc = sc_plan(c, f)
    unread(c, f, entry, sc[:])
    // A failable body that only fails never writes its answer (a web stub).
    if (f.flags & ir.H_FAILABLE) != 0 && !entry && c.t.a[f.ty] != u32(types.P_VOID): put(&c.out, "    (void)dado_out;\n")
    // Seeded only when the program holds a map (`DADO_SEED_INIT`, in dado.h).
    if entry: put(&c.out, "    DADO_SEED_INIT();\n")
    put(&c.out, "    uintptr_t dado_mlo = 0; uint64_t dado_mn = 0; int dado_mf = 0; (void)dado_mlo; (void)dado_mn; (void)dado_mf;\n")
    i64 mark = #len(c.out)
    #truncate(c.hoist, 0)
    #truncate(c.longs, 0)
    #truncate(c.targeted, 0)
    for _ in 0..<ir.count(f):
        c.targeted = #append(c.targeted, false)
    ref []u32 heads
    for i in 0..<ir.count(f):
        for #len(heads) > 0 && heads[#len(heads) - 1] + 1 + ir.span(f, heads[#len(heads) - 1]) <= i:
            #truncate(heads, #len(heads) - 1)
        if f.op[i] == ir.O_BREAK: c.targeted[heads[#len(heads) - 1 - i64(f.a[i])]] = true
        if f.op[i] == ir.O_IF || f.op[i] == ir.O_LOOP || f.op[i] == ir.O_BLOCK: heads = #append(heads, i)
    #truncate(heads, 0)
    i64 last = -1
    for i in 0..<ir.count(f):
        for #len(heads) > 0 && heads[#len(heads) - 1] + 1 + ir.span(f, heads[#len(heads) - 1]) <= i:
            close(c, f, heads[#len(heads) - 1], #len(heads))
            #truncate(heads, #len(heads) - 1)
        if sc[i] == SC_SKIP: continue
        if #len(heads) > 0 && f.op[heads[#len(heads) - 1]] == ir.O_IF && f.c[heads[#len(heads) - 1]] > 0 && i == heads[#len(heads) - 1] + 1 + f.b[heads[#len(heads) - 1]]:
            indent(c, #len(heads))
            put(&c.out, "} else {\n")
        check.Where at = check.where(w, f.file, f.item, f.node[i])
        if g_lines && at.line != last:
            put(&c.out, index.hold(#format("#line ", at.line, " ")))
            quoted(&c.out, g_line_paths[f.file] if i64(f.file) < #len(g_line_paths) else path)
            put(&c.out, "\n")
            last = at.line
        indent(c, #len(heads) + 1)
        if sc[i] == SC_OR || sc[i] == SC_AND:
            sc_emit(c, f, i, index.hold(#format(path, ":", at.line, ":", at.col)))
            continue
        if g_trace && (f.op[i] == ir.O_CALL || f.op[i] == ir.O_CALL_INDIRECT): put(&c.out, index.hold(#format("dado_rt__note(dado_sf, ((uint64_t)", at.line, "u << 32 | ", at.col, "u));\n")))
        stmt(c, f, i, index.hold(#format(path, ":", at.line, ":", at.col)))
        watch(c, f, i, path)
        if f.op[i] == ir.O_IF || f.op[i] == ir.O_LOOP || f.op[i] == ir.O_BLOCK: heads = #append(heads, i)
    for #len(heads) > 0:
        close(c, f, heads[#len(heads) - 1], #len(heads))
        #truncate(heads, #len(heads) - 1)
    #delete(sc)
    if (f.flags & (ir.H_ENTRY | ir.H_FAILABLE)) != 0: put(&c.out, "    return 0;\n")
    else if c.t.a[f.ty] != u32(types.P_VOID) && !ends_returning(f): put(&c.out, "    __builtin_unreachable();\n")
    put(&c.out, "}\n")
    #delete(heads)
    if #len(c.hoist) > 0:
        ref []char8 tail
        tail = #append(tail, ..c.out[mark..<#len(c.out)])
        #truncate(c.out, mark)
        c.out = #append(c.out, ..c.hoist)
        c.out = #append(c.out, ..tail)
        #delete(tail)

// Short-circuits as C's `||`/`&&`, so gcc sees the chain Rust writes (a run
// of compares becomes a bit test): `d = !t; if d { x = e; t = x }` is
// `t = t || e`, and `if t { x = e; t = x }` is `t = t && e`.
const u8 SC_SKIP = 1
const u8 SC_OR = 2
const u8 SC_AND = 3

private u32 sc_slot(^ir.Fn f, u32 x):
    if x == NONE || ir.is_const(x) || i64(x) >= #len(f.root) || f.plo[x] != f.phi[x] || (f.root[x] & ir.ROOT_GLOBAL) != 0: return NONE
    u32 r = f.root[x]
    if (f.slot_flags[r] & ir.S_WATCH) != 0: return NONE
    return r

// `x = e` at op `k`: a compare or arithmetic into a temp read once.
private bool sc_rhs(^C c, ^ir.Fn f, u32 k, []u32 uses):
    if f.op[k] != ir.O_BIN && f.op[k] != ir.O_UN: return false
    u32 x = sc_slot(f, f.dst[k])
    if x == NONE || (f.slot_flags[x] & ir.S_TEMP) == 0 || uses[x] != 2: return false
    return check.soa_whole(c.w, f, f.dst[k]) == NONE

private ref []u8 sc_plan(^C c, ^ir.Fn f):
    u32 n = ir.count(f)
    ref []u8 out
    for _ in 0..<n:
        out = #append(out, 0)
    ref []u32 uses
    for _ in 0..<#len(f.slot_ty):
        uses = #append(uses, 0)
    ref []u32 rs
    for k in 0..<n:
        jroots(f, k, &rs)
        for r in rs:
            uses[r] += 1
    #delete(rs)
    // Each op's region: its innermost head, and the side of an `if`.
    ref []u32 reg
    ref []u32 hs
    for k in 0..<n:
        for #len(hs) > 0 && hs[#len(hs) - 1] + 1 + ir.span(f, hs[#len(hs) - 1]) <= k:
            #truncate(hs, #len(hs) - 1)
        u32 r = NONE
        if #len(hs) > 0:
            u32 top = hs[#len(hs) - 1]
            r = top * 2
            if f.op[top] == ir.O_IF && k >= top + 1 + f.b[top]: r += 1
        reg = #append(reg, r)
        if f.op[k] == ir.O_IF || f.op[k] == ir.O_LOOP || f.op[k] == ir.O_BLOCK: hs = #append(hs, k)
    #delete(hs)
    u32 i = 0
    for i + 2 < n:
        u32 h = i
        u8 kind = 0
        if f.op[i] == ir.O_UN && f.sub[i] == ir.U_NOT && i + 3 < n:
            u32 d = sc_slot(f, f.dst[i])
            if d != NONE && (f.slot_flags[d] & ir.S_TEMP) != 0 && uses[d] == 2 && f.op[i + 1] == ir.O_IF && sc_slot(f, f.a[i + 1]) == d && reg[i] == reg[i + 1]:
                h = i + 1
                kind = SC_OR
        else if f.op[i] == ir.O_IF: kind = SC_AND
        if kind != 0 && f.b[h] == 2 && f.c[h] == 0 && sc_rhs(c, f, h + 1, uses[:]) && f.op[h + 2] == ir.O_SET:
            u32 t = sc_slot(f, f.dst[h + 2])
            bool ok = t != NONE && sc_slot(f, f.a[h + 2]) == sc_slot(f, f.dst[h + 1]) && c.t.resolve(f.slot_ty[t]) == u32(types.P_BOOL)
            if ok && kind == SC_OR: ok = sc_slot(f, f.a[i]) == t
            if ok && kind == SC_AND: ok = sc_slot(f, f.a[h]) == t
            if ok:
                out[i] = kind
                for k in i + 1..=h + 2:
                    out[k] = SC_SKIP
                i = h + 3
                continue
        i += 1
    #delete(uses)
    #delete(reg)
    return out

// `t = t || e` for the short-circuit at op `i`; `e` is the right side's own
// text, written once by `stmt` and cut from its line.
private void sc_emit(^C c, ^ir.Fn f, u32 i, string8 where):
    bool or = f.op[i] == ir.O_UN
    u32 h = i
    string8 op = " && "
    string8 neg = ""
    if or:
        h = i + 1
        op = " || "
        neg = "!"
    string8 t = text(c, f, f.dst[h + 2])
    string8 x = text(c, f, f.dst[h + 1])
    i64 m = #len(c.out)
    stmt(c, f, h + 1, where)
    string8 d0 = index.hold(#format(x, " = "))
    ref []char8 ln = #make([]char8, 0)
    for k in m..<#len(c.out):
        ln = #append(ln, c.out[k])
    #truncate(c.out, m)
    string8 lv = string8(ln[:])
    i64 e = #len(lv) - 2
    bool one = strings.starts_with(lv, d0) && strings.ends_with(lv, ";\n")
    i64 nl = 0
    if one: nl = strings.index_of(lv[#len(d0)..<e], '\n')
    if one && nl < 0:
        put(&c.out, index.hold(#format(t, " = ", t, op, "(")))
        for k in #len(d0)..<e:
            c.out = #append(c.out, ln[k])
        put(&c.out, ");\n")
    else:
        // Not one line: as written.
        put(&c.out, index.hold(#format("if (", neg, t, ") { ")))
        for k in 0..<#len(ln) - 1:
            c.out = #append(c.out, ln[k])
        put(&c.out, index.hold(#format(" ", t, " = ", x, "; }\n")))
    #delete(ln)

// `#stack` storage of `n` `e`s for op `i`: declared at the function's top
// (it lives to the end of the body, past any block C opens), zeroed here.
string8 stack_frame(^C c, string8 e, i64 n, u32 i):
    put(&c.hoist, index.hold(#format("    ", e, " dado_stk", i, "[", n if n > 0 else 1, "];\n")))
    return index.hold(#format("dado_zero(dado_stk", i, ", sizeof(dado_stk", i, "))"))

private void close(^C c, ^ir.Fn f, u32 h, i64 depth):
    indent(c, depth)
    put(&c.out, "}\n")
    if c.targeted[h]:
        indent(c, depth)
        put(&c.out, index.hold(#format("L", h, ": ;\n")))

private void stmt(^C c, ^ir.Fn f, u32 i, string8 where):
    u8 o = f.op[i]
    if o == ir.O_C_INLINE && f.sub[i] == 1:
        put(&c.out, c.t.text(f.a[i]))
        return
    if o == ir.O_IF:
        put(&c.out, "if (")
        opd(c, f, f.a[i])
        put(&c.out, ") {\n")
        return
    if o == ir.O_LOOP:
        put(&c.out, "for (;;) {\n")
        return
    if o == ir.O_BLOCK:
        put(&c.out, "{\n")
        return
    if o == ir.O_BREAK:
        u32 h = target(f, i)
        put(&c.out, index.hold(#format("goto L", h, ";\n")))
        return
    if o == ir.O_QUIT && f.sub[i] == 1:
        put(&c.out, "abort();\n")
        return
    if o == ir.O_QUIT:
        put(&c.out, "exit((int)(")
        opd(c, f, f.a[i])
        put(&c.out, "));\n")
        return
    bool entry = (f.flags & ir.H_ENTRY) != 0
    if o == ir.O_RETURN_FAIL:
        string8 x = text(c, f, f.a[i])
        if f.sub[i] == 0: x = index.hold(#format("dado_fail(", x, ", \"", where, "\")"))
        if entry: x = index.hold(#format("dado_exit_status(", x, ")"))
        put(&c.out, index.hold(#format("return ", x, ";\n")))
        return
    string8 rv = ""
    if o == ir.O_RETURN && f.a[i] != NONE:
        rv = text(c, f, f.a[i])
        if ir.is_const(f.a[i]) && composite(c, f.a[i]): rv = index.hold(#format("(", ty(c, c.t.a[f.ty]), ")", rv))
    if o == ir.O_RETURN && !entry && (f.flags & ir.H_FAILABLE) != 0:
        if f.a[i] != NONE: put(&c.out, index.hold(#format("*dado_out = ", rv, "; ")))
        put(&c.out, "return 0;\n")
        return
    if o == ir.O_RETURN:
        put(&c.out, "return")
        if f.a[i] != NONE:
            put(&c.out, " ")
            put(&c.out, rv)
        else if (f.flags & ir.H_ENTRY) != 0: put(&c.out, " 0")
        put(&c.out, ";\n")
        return
    if o == ir.O_INTRINSIC && (f.sub[i] == check.B_POPCOUNT || f.sub[i] == check.B_CLZ || f.sub[i] == check.B_CTZ || f.sub[i] == check.B_BSWAP || f.sub[i] == check.B_ROTL || f.sub[i] == check.B_ROTR):
        []u32 xs = ir.args(f, i)
        u8 s = f.sub[i]
        string8 x = index.hold(#format("(unsigned long long)(", text(c, f, xs[0]), ")"))
        i64 wd = i64(types.integer_bits(check.int_prim_of(c.t, f.ty_of[i])))
        string8 tn = ty(c, f.ty_of[i])
        string8 e = index.hold(#format("(int64_t)__builtin_popcountll(", x, ")"))
        if s == check.B_CLZ: e = index.hold(#format("(", x, " == 0 ? (int64_t)", wd, " : (int64_t)__builtin_clzll(", x, ") - ", 64 - wd, ")"))
        if s == check.B_CTZ: e = index.hold(#format("(", x, " == 0 ? (int64_t)", wd, " : (int64_t)__builtin_ctzll(", x, "))"))
        if s == check.B_BSWAP: e = index.hold(#format("(", tn, ")__builtin_bswap", wd, "((uint", wd, "_t)", x, ")"))
        if s == check.B_ROTL || s == check.B_ROTR:
            string8 k = index.hold(#format("((unsigned long long)(", text(c, f, xs[1]), ") % ", wd, "u)"))
            string8 a = "<<"
            string8 z = ">>"
            if s == check.B_ROTR:
                a = ">>"
                z = "<<"
            e = index.hold(#format("(", tn, ")((", tn, ")(", x, " ", a, " ", k, ") | (", tn, ")(", x, " ", z, " ((", wd, "u - ", k, ") % ", wd, "u)))"))
        put(&c.out, index.hold(#format(text(c, f, f.dst[i]), " = ", e, ";\n")))
        return
    if o == ir.O_INTRINSIC && f.sub[i] == check.B_COPY_INTO:
        // Decision 15: memmove over two views; c 1: an exact window.
        []u32 xs = ir.args(f, i)
        string8 e = ty(c, elem(c, f.place_ty[xs[0]]).ty)
        string8 ck = ""
        if f.c[i] == 1: ck = index.hold(#format("if (dado_d.len != dado_s.len) dado_copy_fail(dado_d.len, dado_s.len, \"", where, "\"); "))
        string8 d = ""
        if f.dst[i] != NONE: d = index.hold(#format(" ", text(c, f, f.dst[i]), " = dado_n;"))
        put(&c.out, index.hold(#format("{ dado_view dado_d = ", text(c, f, xs[0]), ", dado_s = ", text(c, f, xs[1]), "; ", ck, "int64_t dado_n = dado_d.len < dado_s.len ? dado_d.len : dado_s.len; if (dado_n > 0) memmove(dado_d.ptr, dado_s.ptr, (size_t)dado_n * sizeof(", e, "));", d, " }\n")))
        return
    if o == ir.O_INTRINSIC && f.sub[i] == check.B_MUL_WIDE:
        []u32 xs = ir.args(f, i)
        put(&c.out, index.hold(#format("{ int64_t dado_h; uint64_t dado_l; dado_mul_wide(", text(c, f, xs[0]), ", ", text(c, f, xs[1]), ", &dado_h, &dado_l); ", text(c, f, f.dst[i]), " = (", ty(c, f.place_ty[f.dst[i]]), "){ dado_h, dado_l }; }\n")))
        return
    if o == ir.O_INTRINSIC && (f.sub[i] == check.B_ADD_OVERFLOW || f.sub[i] == check.B_SUB_OVERFLOW || f.sub[i] == check.B_MUL_OVERFLOW):
        []u32 xs = ir.args(f, i)
        string8 v = "add"
        if f.sub[i] == check.B_SUB_OVERFLOW: v = "sub"
        if f.sub[i] == check.B_MUL_OVERFLOW: v = "mul"
        put(&c.out, index.hold(#format("{ ", ty(c, f.ty_of[i]), " dado_v; _Bool dado_o = __builtin_", v, "_overflow(", text(c, f, xs[0]), ", ", text(c, f, xs[1]), ", &dado_v); ", text(c, f, f.dst[i]), " = (", ty(c, f.place_ty[f.dst[i]]), "){ dado_v, !dado_o }; }\n")))
        return
    if o == ir.O_INTRINSIC && f.sub[i] >= check.B_ATOMIC_LOAD && f.sub[i] <= check.B_FENCE:
        atomic(c, f, i)
        return
    if o == ir.O_INTRINSIC && (f.sub[i] == check.B_EXPECT || f.sub[i] == check.B_ASSERT || f.sub[i] == check.B_PANIC):
        said(c, f, i, where)
        return
    if o == ir.O_INTRINSIC && f.sub[i] == check.B_RENDER:
        render(c, f, i)
        put(&c.out, "\n")
        return
    if o == ir.O_INTRINSIC && f.sub[i] >= check.B_AL_GET && f.sub[i] <= check.B_AL_FORMAT:
        alloc_op(c, f, i)
        return
    if o == ir.O_INTRINSIC && f.sub[i] == check.B_ALIGN_FORWARD:
        []u32 xs = ir.args(f, i)
        string8 al = index.hold(#format("((uintptr_t)(", text(c, f, xs[1]), ") - 1u)"))
        put(&c.out, index.hold(#format(text(c, f, f.dst[i]), " = (", ty(c, f.ty_of[i]), ")(((uintptr_t)(", text(c, f, xs[0]), ") + ", al, ") & ~", al, ");\n")))
        return
    if o == ir.O_INTRINSIC && f.sub[i] >= check.B_MATH:
        math(c, f, i)
        return
    if o == ir.O_INTRINSIC && f.sub[i] >= check.B_CH_SEND:
        chan_op(c, f, i, where)
        return
    if o == ir.O_INTRINSIC && f.sub[i] >= check.B_MAP_SLOT:
        map_op(c, f, i, where)
        return
    if o == ir.O_INTRINSIC && (f.sub[i] == check.B_TRACE || f.sub[i] == check.B_LOCATION):
        trace_op(c, f, i)
        return
    if o == ir.O_INTRINSIC:
        growth(c, f, i, where)
        return
    if o == ir.O_SCOPE_END: return
    if o == ir.O_MOVE:
        if f.sub[i] != ir.MV_REBIND && f.sub[i] != ir.MV_DRAIN && !check.is_map(c.w, f.place_ty[f.a[i]]):
            string8 x = text(c, f, f.a[i])
            Elem m = elem(c, f.place_ty[f.a[i]])
            put(&c.out, index.hold(#format("dado_mlo = (uintptr_t)(", x, ").ptr; dado_mn = sizeof(", ty(c, m.ty), ") * (uint64_t)(", x, ").cap; dado_mf = (", x, ").alloc.s0 == dado_heap;")))
        put(&c.out, "\n")
        if f.sub[i] != ir.MV_RESET: return
        for s in 0..<u32(#len(f.slot_ty)):
            if (f.slot_flags[s] & ir.S_WATCH) != 0: put(&c.out, index.hold(#format("    dado_stale_moved(&dado_sw", s, ", dado_mlo, dado_mn, 1, 1, \"", stale_what(c, f, s, f.a[i], index.hold(#format("taken back by the arena's end at ", where))), "\");\n")))
        return
    if o == ir.O_CHECK && f.sub[i] == ir.CK_SENT: return
    if o == ir.O_CHECK:
        []u32 xs = ir.args(f, i)
        if #len(xs) > 0 && !ir.is_const(xs[0]) && (f.root[xs[0]] & ir.ROOT_GLOBAL) == 0 && (f.slot_flags[f.root[xs[0]]] & ir.S_WATCH) != 0:
            put(&c.out, index.hold(#format("if (dado_sw", f.root[xs[0]], ".freed) { dado_stale_trap(&dado_sw", f.root[xs[0]], ", \"", where, "\"); } ")))
        if f.sub[i] == ir.CK_BITS:
            u8 p = check.int_prim_of(c.t, f.ty_of[i])
            bool sg = p != types.PRIMS && types.is_signed(p)
            i64 bw = i64(c.k.w0[f.b[i] & ~ir.OPD_CONST])
            i64 hi = (i64(1) << u64(bw - 1)) - 1 if sg else i64((u64(1) << u64(bw)) - 1)
            put(&c.out, index.hold(#format("dado_bits((int64_t)(", text(c, f, f.a[i]), "), ", -hi - 1 if sg else 0, ", ", hi, "LL, ", 1 if sg else 0, ", \"", where, "\");\n")))
            return
        if f.sub[i] == ir.CK_STALE:
            put(&c.out, "\n")
            return
        put(&c.out, index.hold(#format("(void)dado_at(", text(c, f, f.a[i]), ", ", text(c, f, f.b[i]), ", \"", where, "\");\n")))
        return
    if o == ir.O_VIEW:
        window(c, f, i, where)
        return
    if o == ir.O_ADDR:
        put(&c.out, index.hold(#format(text(c, f, f.dst[i]), " = &(", text(c, f, f.a[i]), ");\n")))
        return
    if o == ir.O_SET && ir.is_const(f.a[i]) && f.dst[i] != NONE && opaque(c, f.ty_of[i]):
        // A foreign type's zero, byte by byte: C assigns no array typedef.
        string8 d = text(c, f, f.dst[i])
        put(&c.out, index.hold(#format("{ unsigned char *z = (unsigned char *)&(", d, "); for (size_t k = 0; k < sizeof(", d, "); k++) z[k] = 0; }\n")))
        return
    bool failing = (o == ir.O_CALL || o == ir.O_CALL_INDIRECT) && f.c[i] != NONE
    ref []char8 scat
    // A header's struct with a `const` member is not assigned in C: copied in.
    string8 cm = ""
    if !failing && f.dst[i] != NONE && foreign_row(c, f.ty_of[i]) != NONE && check.const_member(c.w, f.ty_of[i], 0) != NONE: cm = ty(c, f.ty_of[i])
    if failing:
        opd(c, f, f.c[i])
        put(&c.out, " = ")
    else if cm != "":
        put(&c.out, "memcpy(&(")
        opd(c, f, f.dst[i])
        put(&c.out, index.hold(#format("), (", cm, "[1]){ ")))
    else if f.dst[i] != NONE && check.soa_whole(c.w, f, f.dst[i]) != NONE:
        // A whole `#soa` element: built once, scattered into its lanes.
        ref []string8 ls
        u32 et = lanes(c, f, f.dst[i], &ls)
        string8 m = "a" if nested(c, et) else "s"
        put(&c.out, index.hold(#format("{ ", ty(c, et), " dado_sc = ")))
        for j in 0..<#len(ls):
            put(&scat, index.hold(#format(" ", ls[j], " = dado_sc.", m, "[" if m == "a" else "", j, "]" if m == "a" else "", ";")))
        put(&scat, " }")
    else if f.dst[i] != NONE:
        opd(c, f, f.dst[i])
        put(&c.out, " = ")
    if o == ir.O_SET:
        if ir.is_const(f.a[i]) && composite(c, f.a[i]): put(&c.out, index.hold(#format("(", ty(c, f.ty_of[i]), ")", cinit(c, f.a[i] & ~ir.OPD_CONST, f.ty_of[i]))))
        else if f.dst[i] != NONE && cvoid(c, f, f.a[i]) && (f.plo[f.dst[i]] < f.phi[f.dst[i]] || ty(c, f.place_ty[f.dst[i]]) == "void *"):
            // A `const rawptr` into a shape's member: C's member is a `void *` (shapes drop qualifiers).
            put(&c.out, "((void *)")
            opd(c, f, f.a[i])
            put(&c.out, ")")
        else: opd(c, f, f.a[i])
    else if o == ir.O_UN:
        string8 cty = ty(c, f.ty_of[i])
        if f.sub[i] == ir.U_NOT:
            put(&c.out, "!")
            opd(c, f, f.a[i])
        else:
            put(&c.out, index.hold(#format("(", cty, ")(", "-" if f.sub[i] == ir.U_NEG else "~")))
            if f.sub[i] == ir.U_NEG && check.int_prim_of(c.t, f.ty_of[i]) != types.PRIMS: wide(c, f.ty_of[i])
            opd(c, f, f.a[i])
            put(&c.out, ")")
    else if o == ir.O_BIN: bin(c, f, i, where)
    else if o == ir.O_C_INLINE: put(&c.out, c.t.text(f.a[i]))
    else if o == ir.O_CONV && (f.sub[i] == ir.CV_LEND || f.sub[i] == ir.CV_RETAG) && c.t.tag[c.t.resolve(f.ty_of[i])] == types.T_PTR: put(&c.out, index.hold(#format("((", ty(c, f.ty_of[i]), ")(", text(c, f, f.a[i]), ").ptr)")))
    else if o == ir.O_CONV && (f.sub[i] == ir.CV_LEND || f.sub[i] == ir.CV_RETAG):
        string8 x = text(c, f, f.a[i])
        bool s = c.t.resolve(f.ty_of[i]) == types.STRING8
        put(&c.out, index.hold(#format("(", "dado_string){ (const char *)" if s else "dado_view){ (void *)", "(", x, ").ptr, (", x, ").len }")))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_TO_RAWPTR && (!ir.is_const(f.a[i]) && lent_ptr(c, f.place_ty[f.a[i]]) || ir.is_const(f.a[i]) && c.k.kind[f.a[i] & ~ir.OPD_CONST] == types.C_STR && c.k.b[f.a[i] & ~ir.OPD_CONST] != 1): put(&c.out, index.hold(#format("((void *)(", text(c, f, f.a[i]), ").ptr)")))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_CROSS && !ir.is_const(f.a[i]): put(&c.out, pun(c, f.place_ty[f.a[i]], f.ty_of[i], text(c, f, f.a[i])))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_CROSS && f.b[i] == 1: put(&c.out, index.hold(#format("(*(", ty(c, f.ty_of[i]), " *)&(", text(c, f, f.a[i]), "))")))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_CROSS:
        string8 x = text(c, f, f.a[i])
        u32 from = f.place_ty[f.a[i]] if !ir.is_const(f.a[i]) else f.ty_of[i]
        bool u = nested(c, f.ty_of[i])
        bool fo = check.one_row(c.t, from) != NONE
        if check.one_row(c.t, f.ty_of[i]) == NONE && fo: put(&c.out, slot_at(c, from, index.hold(#format("(", x, ")")), 0))
        else if check.one_row(c.t, f.ty_of[i]) != NONE:
            string8 sx = x
            if fo: sx = slot_at(c, from, index.hold(#format("(", x, ")")), 0)
            else: sx = c_init(c, x, check.slot_ty(c.t, f.ty_of[i], 0))
            put(&c.out, index.hold(#format("(", ty(c, f.ty_of[i]), "){ ", sx, " }")))
        else:
            put(&c.out, index.hold(#format("(", ty(c, f.ty_of[i]), "){ ", "{ " if u else "")))
            []u32 sl = c.t.slots(f.ty_of[i])
            for j in 0..<u32(#len(sl)):
                if j > 0: put(&c.out, ", ")
                put(&c.out, slot_at(c, from, index.hold(#format("(", x, ")")), j))
            put(&c.out, " } }" if u else " }")
    else if o == ir.O_CONV && f.sub[i] == ir.CV_UNION: put(&c.out, index.hold(#format("(", ty(c, f.ty_of[i]), "){ .tag = ", f.b[i], ", .u = { .m", f.b[i], " = ", text(c, f, f.a[i]), " } }")))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_TAIL: put(&c.out, index.hold(#format("((", ty(c, f.ty_of[i]), ")((", text(c, f, f.a[i]), ")->", c.t.text(f.b[i]), "))")))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_TAG: put(&c.out, index.hold(#format("(", text(c, f, f.a[i]), ").tag")))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_MEMBER && f.c[i] == 1: put(&c.out, index.hold(#format("((", text(c, f, f.a[i]), ").tag == ", f.b[i], " ? (", text(c, f, f.a[i]), ").u.m", f.b[i], " : (", ty(c, f.ty_of[i]), "){ 0 })")))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_MEMBER: put(&c.out, index.hold(#format("(", text(c, f, f.a[i]), ").u.m", f.b[i])))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_CSTRING: put(&c.out, index.hold(#format("((const char *)(", text(c, f, f.a[i]), ").ptr)")))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_FROM_CSTRING:
        string8 x = text(c, f, f.a[i])
        put(&c.out, index.hold(#format("((dado_string){ (", x, ") ? (", x, ") : \"\", (", x, ") ? dado_clen(", x, ") : 0 })")))
    else if o == ir.O_CONV && f.sub[i] == ir.CV_FLOAT_INT && !ir.is_const(f.a[i]) && c.t.tag[check.under(c.t, f.ty_of[i])] == types.T_PRIM:
        // Saturating: NaN is 0, a value at or past either end is that end.
        u8 p = check.int_prim_of(c.t, f.ty_of[i])
        u8 bits = types.integer_bits(p)
        bool sg = types.is_signed(p)
        string8 sfx = "f" if c.t.resolve(f.place_ty[f.a[i]]) == u32(types.P_F32) else ""
        string8 x = text(c, f, f.a[i])
        string8 n = index.hold(#format("INT", bits)) if sg else index.hold(#format("UINT", bits))
        string8 lo = index.hold(#format("-0x1p", bits - 1, sfx)) if sg else "0"
        string8 mn = index.hold(#format(n, "_MIN")) if sg else "0"
        string8 hi = index.hold(#format("0x1p", bits - 1 if sg else bits, sfx))
        put(&c.out, index.hold(#format("(", ty(c, f.ty_of[i]), ")((", x, ") != (", x, ") ? 0 : (", x, ") <= ", lo, " ? ", mn, " : (", x, ") >= ", hi, " ? ", n, "_MAX : (", ty(c, f.ty_of[i]), ")(", x, "))")))
    else if o == ir.O_CONV && f.b[i] == 1 && !c.w.no_narrowing && (f.sub[i] == ir.CV_WIDEN || f.sub[i] == ir.CV_FLOAT_WIDTH):
        put(&c.hoist, index.hold(#format("    static dado_nw dado_nw", i, " = { \"", where, "\", 0, 0 };\n")))
        string8 tn = ty(c, f.ty_of[i])
        string8 x = text(c, f, f.a[i])
        u8 p = check.int_prim_of(c.t, f.ty_of[i])
        if f.sub[i] == ir.CV_FLOAT_WIDTH: put(&c.out, index.hold(#format("dado_nwf(", x, ", &dado_nw", i, ")")))
        else if p == types.P_U64: put(&c.out, index.hold(#format("dado_nwu(", x, ", &dado_nw", i, ")")))
        else: put(&c.out, index.hold(#format("(", tn, ")dado_nwi(", x, ", (int64_t)(", tn, ")(", x, "), \"", types.PRIM[p].name, "\", &dado_nw", i, ")")))
    else if o == ir.O_CONV:
        put(&c.out, index.hold(#format("(", ty(c, f.ty_of[i]), ")(")))
        opd(c, f, f.a[i])
        put(&c.out, ")")
    else if o == ir.O_MAKE && foreign_row(c, f.ty_of[i]) != NONE && holds_cnl(c, f.ty_of[i]):
        // A header struct holding a named member list: built as its Dado shape,
        // read as itself through a union (no pointer pun for gcc's aliasing).
        put(&c.out, index.hold(#format("(((union { ", ty(c, c.t.resolve(f.ty_of[i])), " a; ", ty(c, f.ty_of[i]), " b; }){ .a = { ")))
        []u32 xs = ir.args(f, i)
        for j in 0..<#len(xs):
            if j > 0: put(&c.out, ", ")
            opd(c, f, xs[j])
        put(&c.out, " } }).b)")
    else if o == ir.O_MAKE:
        bool u = nested(c, f.ty_of[i])
        u32 fx = foreign_row(c, f.ty_of[i])
        bool fr = fx != NONE
        put(&c.out, index.hold(#format("(", ty(c, f.ty_of[i]), "){ ", "{ " if u else "")))
        []u32 xs = ir.args(f, i)
        []u32 sl = c.t.slots(f.ty_of[i])
        bool named = designated(c, f.ty_of[i], u32(#len(xs)))
        bool whole = !named && whole_array(c, f.ty_of[i], u32(#len(xs)))
        if whole:
            string8 wn = member(c, f.ty_of[i], 0)
            put(&c.out, index.hold(#format(wn, " = { ")))
        for j in 0..<#len(xs):
            if j > 0: put(&c.out, ", ")
            if named:
                string8 mn = member(c, f.ty_of[i], u32(j))
                put(&c.out, index.hold(#format(mn, " = ")))
            u64 key = (u64(fx) << 32) | u64(j)
            bool one = fr && !whole && key in c.w.carray
            if one: put(&c.out, index.hold(#format("{ ", text(c, f, xs[j]), " }")))
            else if fr && !whole && j < #len(sl) && check.c_array(c.w, sl[j]): put(&c.out, c_init(c, text(c, f, xs[j]), sl[j], key in c.w.cinner))
            else: opd(c, f, xs[j])
        if whole: put(&c.out, " }")
        put(&c.out, " } }" if u else " }")
    else if o == ir.O_CALL || o == ir.O_CALL_INDIRECT:
        if o == ir.O_CALL: put(&c.out, c.t.text(f.ref_name[f.a[i]]))
        else: put(&c.out, index.hold(#format("(", text(c, f, f.a[i]), ")")))
        put(&c.out, "(")
        bool out = failing && f.dst[i] != NONE
        if out: put(&c.out, index.hold(#format("&", text(c, f, f.dst[i]))))
        []u32 xs = ir.args(f, i)
        for j in 0..<#len(xs):
            if j > 0 || out: put(&c.out, ", ")
            // A composite constant (`nil` for a `[]T`) as a compound literal.
            u32 pt = NONE
            if ir.is_const(xs[j]) && composite(c, xs[j]): pt = param_ty(c, f, i, j)
            if pt != NONE: put(&c.out, index.hold(#format("(", ty(c, pt), ")", cinit(c, xs[j] & ~ir.OPD_CONST, pt))))
            else: opd(c, f, xs[j])
        put(&c.out, ")")
    if cm != "": put(&c.out, index.hold(#format(" }, sizeof(", cm, "))")))
    put(&c.out, ";")
    put(&c.out, index.hold(scat))
    put(&c.out, "\n")

// A dev build's stale-read witnesses: minted where a watched view is
// bound, noted where a block under a handle frees or moves.
private void watch(^C c, ^ir.Fn f, u32 i, string8 path):
    u32 d = f.dst[i]
    u8 o = f.op[i]
    if d != NONE && o != ir.O_IF && o != ir.O_LOOP && o != ir.O_BLOCK && f.plo[d] == f.phi[d] && (f.root[d] & ir.ROOT_GLOBAL) == 0 && (f.slot_flags[f.root[d]] & ir.S_WATCH) != 0:
        string8 x = text(c, f, d)
        bool p = c.t.tag[c.t.resolve(f.slot_ty[f.root[d]])] == types.T_PTR
        bool tv = c.t.tag[c.t.resolve(f.slot_ty[f.root[d]])] == types.T_TRAIT
        string8 at = index.hold(#format("(uintptr_t)", x) if p else #format("((", x, ").len > 0 ? (uintptr_t)(", x, ").ptr : (uintptr_t)0)"))
        if tv: at = index.hold(#format("(uintptr_t)(", x, ").s0"))
        put(&c.out, index.hold(#format("    dado_sw", f.root[d], " = (dado_stale){ ", at, ", 0 };\n")))
    if i == 0 || f.op[i - 1] != ir.O_MOVE || f.sub[i - 1] == ir.MV_REBIND || f.sub[i - 1] >= ir.MV_SEND || o != ir.O_INTRINSIC || check.is_map(c.w, f.place_ty[f.a[i - 1]]): return
    // Only the verb that made the move (an `#append` whose operands are
    // bounded reads first places them between).
    []u32 vs = ir.args(f, i)
    if #len(vs) == 0 || vs[0] != f.a[i - 1]: return
    u32 after = f.a[i - 1] if f.sub[i - 1] == ir.MV_FREE else d
    // A bounds read placed after the move (`#len` of the grown run) is not the verb.
    if f.sub[i] == check.B_LEN || f.sub[i] == check.B_CAP || after == NONE: return
    string8 now = index.hold(#format("(uintptr_t)(", text(c, f, after), ").ptr"))
    string8 how = "freed at " if f.sub[i - 1] == ir.MV_FREE else "freed by a growth that moved the block at "
    check.Where at = check.where(c.w, f.file, f.item, f.node[i - 1])
    string8 where = index.hold(#format(how, path, ":", at.line, ":", at.col))
    for s in 0..<u32(#len(f.slot_ty)):
        if (f.slot_flags[s] & ir.S_WATCH) == 0: continue
        put(&c.out, index.hold(#format("    dado_stale_moved(&dado_sw", s, ", dado_mlo, dado_mn, ", now, ", dado_mf, \"", stale_what(c, f, s, f.a[i - 1], where), "\");\n")))

// What a stale read names: the view, the handle whose block moved, and how.
private string8 stale_what(^C c, ^ir.Fn f, u32 s, u32 h, string8 how):
    string8 v = c.t.text(f.slot_name[s])
    string8 hn = ""
    if (f.root[h] & ir.ROOT_GLOBAL) == 0 && f.slot_name[f.root[h]] != NONE: hn = c.t.text(f.slot_name[f.root[h]])
    if hn == v || #len(hn) == 0: return index.hold(#format("`", v, "` holds a block an arena minted, ", how))
    return index.hold(#format("`", v, "` points into the block under `", hn, "`, ", how))

// `dst = place[lo..<hi]`: a window, checked against the run.
private void window(^C c, ^ir.Fn f, u32 i, string8 where):
    string8 x = text(c, f, f.a[i])
    Elem m = elem(c, f.place_ty[f.a[i]])
    if f.ahi[i] > f.alo[i]: m = Elem(check.RK_ONE, f.place_ty[f.a[i]], 1, NONE)
    string8 lo = "0" if f.b[i] == NONE else text(c, f, f.b[i])
    string8 hi = base_len(x, m) if f.c[i] == NONE else text(c, f, f.c[i])
    string8 len = hi if m.kind == check.RK_PTR else base_len(x, m)
    string8 kind = "dado_view){ (void *)"
    if m.kind == check.RK_TEXT: kind = index.hold(#format(ty(c, check.text_of(m.ty)), "){ "))
    put(&c.out, index.hold(#format("{ int64_t lo = ", lo, ", hi = ", hi, "; (void)dado_window(lo, hi, ", len, ", \"", where, "\"); ", text(c, f, f.dst[i]), " = (", kind, "(", base_ptr(c, x, m), " + lo), hi - lo }; }\n")))

// `#trace()`: `B_TRACE` its count, `B_LOCATION` the fill — element 0 the
// place written, then each frame's noted call outward (`--full-trace`).
private void trace_op(^C c, ^ir.Fn f, u32 i):
    if f.sub[i] == check.B_TRACE:
        string8 n = "1"
        if g_trace: n = "(dado_rt__depth == 0u ? 1 : (dado_rt__depth <= 4096u ? (int64_t)dado_rt__depth : 4097))"
        put(&c.out, index.hold(#format(text(c, f, f.dst[i]), " = ", n, ";\n")))
        return
    []u32 xs = ir.args(f, i)
    string8 r = text(c, f, xs[0])
    u32 lt = elem(c, f.place_ty[xs[0]]).ty
    string8 l = ty(c, lt)
    put(&c.out, index.hold(#format("{ ", l, " *dado_o = (", l, " *)(", r, ").ptr; int64_t dado_n = (", r, ").len; if (dado_n > 0) dado_o[0] = ", text(c, f, xs[1]), ";")))
    if g_trace:
        string8 o = "dado_o[dado_k]"
        put(&c.out, index.hold(#format(" uint32_t dado_d = dado_rt__depth; uint32_t dado_f = (dado_d <= 4096u ? dado_d : 4097u) - 1u; for (int64_t dado_k = 1; dado_k < dado_n; dado_k++) { const dado_rt__frame *dado_s = &dado_rt__frames[dado_f - (uint32_t)dado_k]; ", slot_at(c, lt, o, 0), " = (dado_string){ dado_s->fn->file, dado_s->fn->file_len }; ", slot_at(c, lt, o, 1), " = (int32_t)(uint32_t)(dado_s->at >> 32); ", slot_at(c, lt, o, 2), " = (int32_t)(uint32_t)dado_s->at; ", slot_at(c, lt, o, 3), " = (dado_string){ dado_s->fn->name, dado_s->fn->name_len }; }")))
    put(&c.out, " }\n")

// The growth verbs over a `ref []T`, and `#len`.
private void growth(^C c, ^ir.Fn f, u32 i, string8 where):
    []u32 xs = ir.args(f, i)
    u8 s = f.sub[i]
    string8 d = text(c, f, f.dst[i]) if f.dst[i] != NONE else ""
    if s == check.B_SIZE || s == check.B_ALIGN_OF:
        put(&c.out, index.hold(#format(d, " = (uint64_t)", "sizeof" if s == check.B_SIZE else "_Alignof", "(", ty(c, f.ty_of[i]), ");\n")))
        return
    if s == check.B_LEN:
        put(&c.out, index.hold(#format(d, " = ", base_len(text(c, f, xs[0]), elem(c, f.place_ty[xs[0]])), ";\n")))
        return
    if s == check.B_CAP:
        put(&c.out, index.hold(#format(d, " = (int64_t)(", text(c, f, xs[0]), ").cap;\n")))
        return
    if s == check.B_MAKE:
        Elem m = elem(c, f.ty_of[i])
        string8 e = ty(c, m.ty)
        i64 rung = i64(c.k.w0[xs[1] & ~ir.OPD_CONST]) if ir.is_const(xs[1]) else 0
        string8 a = ambient(c, f, xs[1])
        string8 frame = "0"
        if rung == 3 && ir.is_const(xs[0]):
            i64 n = i64(c.k.w0[xs[0] & ~ir.OPD_CONST])
            frame = stack_frame(c, e, n, i)
        put(&c.out, index.hold(#format(d, " = dado_make(", text(c, f, xs[0]), ", DADO_ES(", e, "), ", a, ", ", frame, ");\n")))
        return
    string8 x = text(c, f, xs[0])
    Elem m = elem(c, f.place_ty[xs[0]])
    string8 e = ty(c, m.ty)
    string8 nm = "run"
    u32 xr = f.root[xs[0]]
    if (xr & ir.ROOT_GLOBAL) != 0: nm = index.hold(strings.clone(c.t.text(f.glob_name[xr & ~ir.ROOT_GLOBAL])))
    else if f.slot_name[xr] != NONE: nm = index.hold(strings.clone(c.t.text(f.slot_name[xr])))
    string8 tail = index.hold(#format(", DADO_ES(", e, "), dado_context, \"", BUILTIN_NAMES[s], "\", \"", nm, "\", \"", where, "\")"))
    if s == check.B_DELETE:
        if !c.w.no_assert: held_refs(c, x, f.place_ty[xs[0]])
        put(&c.out, index.hold(#format("dado_delete(&(", x, "), sizeof(", e, "));\n")))
    else if s == check.B_TRUNCATE:
        put(&c.out, index.hold(#format("dado_truncate(&(", x, "), ", text(c, f, xs[1]), ", sizeof(", e, "), \"", where, "\");\n")))
    else if s == check.B_RESIZE:
        put(&c.out, index.hold(#format("{ dado_ref r = ", x, "; dado_resize(&r, ", text(c, f, xs[1]), tail, "; ", d, " = r; }\n")))
    else if s == check.B_RESERVE:
        put(&c.out, index.hold(#format("{ dado_ref r = ", x, "; dado_reserve(&r, ", text(c, f, xs[1]), tail, "; ", d, " = r; }\n")))
    else if f.c[i] == 1:
        string8 y = text(c, f, xs[1])
        Elem v = elem(c, f.place_ty[xs[1]])
        // A source inside the block being grown follows it if it moves.
        put(&c.out, index.hold(#format("{ dado_ref r = ", x, "; int64_t m = ", base_len(y, v), "; const ", e, " *src = (const ", e, " *)", base_ptr(c, y, v), "; uintptr_t o = (uintptr_t)r.ptr, oc = (uintptr_t)r.cap * sizeof(", e, "), sp = (uintptr_t)src; dado_room(&r, m", tail, "; if ((uintptr_t)r.ptr != o && o != 0 && sp >= o && sp < o + oc) src = (const ", e, " *)((uintptr_t)r.ptr + (sp - o)); for (int64_t j = 0; j < m; j++) ((", e, " *)r.ptr)[r.len + j] = src[j]; r.len += m; ", d, " = r; }\n")))
    else:
        // The value is read before the block can move (`#append(p, p[i])`).
        put(&c.out, index.hold(#format("{ dado_ref r = ", x, "; ", e, " dado_v = ", text(c, f, xs[1]), "; dado_room(&r, 1", tail, "; ((", e, " *)r.ptr)[r.len++] = dado_v; ", d, " = r; }\n")))

// `#delete` of a `ref T` whose queue channels (its own slots) still hold
// `ref`s: a trap naming the channel (Rust's `channel_delete_checks`).
private void held_refs(^C c, string8 x, u32 t):
    u32 r = c.t.resolve(t)
    if r == NONE || !check.one_ref(c.w, r): return
    u32 pt = c.t.a[r]
    u32 pr = c.t.resolve(pt)
    if pr == NONE: return
    string8 at = index.hold(#format("(*(", ty(c, pt), " *)(", x, ").ptr)"))
    if c.t.tag[pr] == types.T_CHANNEL:
        held_ref(c, x, at, pr)
        return
    []u32 sl = c.t.slots(pt)
    if #len(sl) == 1 && c.t.resolve(sl[0]) == pr: return
    for i in 0..<#len(sl):
        u32 st = c.t.resolve(sl[i])
        if st != NONE && c.t.tag[st] == types.T_CHANNEL: held_ref(c, x, index.hold(#format(at, member(c, pt, u32(i)))), st)

private void held_ref(^C c, string8 x, string8 at, u32 ch):
    if c.t.b[ch] == 0: return
    bool refs = false
    for p in c.t.list(ch):
        u32 q = c.t.resolve(p)
        if q != NONE && c.t.tag[q] == types.T_REF: refs = true
    if !refs: return
    _ = ty(c, ch)
    put(&c.out, index.hold(#format("if ((", x, ").ptr != ((void *)0) && dado_chq_len(&", at, ".tail, &", at, ".head, ", c.t.b[ch] - 1, ") != 0) { fprintf(stderr, \"#delete of a value whose channel still holds `ref`s: %s\\n\", \"", c.t.text(c.t.a[ch]), "\"); abort(); }\n")))

private const [19]string8 BUILTIN_NAMES = ("", "", "", "", "#len", "", "", "", "", "", "#make", "#resize", "#delete", "", "", "", "#append", "#reserve", "#truncate")

// The head a BREAK at `i` leaves.
private u32 target(^ir.Fn f, u32 i):
    ref []u32 heads
    for j in 0..<i:
        for #len(heads) > 0 && heads[#len(heads) - 1] + 1 + ir.span(f, heads[#len(heads) - 1]) <= j:
            #truncate(heads, #len(heads) - 1)
        if f.op[j] == ir.O_IF || f.op[j] == ir.O_LOOP || f.op[j] == ir.O_BLOCK: heads = #append(heads, j)
    for #len(heads) > 0 && heads[#len(heads) - 1] + 1 + ir.span(f, heads[#len(heads) - 1]) <= i:
        #truncate(heads, #len(heads) - 1)
    u32 h = heads[#len(heads) - 1 - i64(f.a[i])]
    #delete(heads)
    return h

// The bytes of a run of one-byte elements, through nested runs; else 0.
private i64 byte_run(^C c, u32 t):
    u32 e = NONE
    i64 n = 0
    if !c.t.uniform(t, &e, &n):
        u32 r = c.t.resolve(t)
        return 1 if r != NONE && c.t.tag[r] == types.T_PRIM && types.PRIM[c.t.a[r]].bits == 8 else 0
    return n * byte_run(c, e)

// The header every unit includes, and one unit per file holding a body.
// Rust's `test_dispatch`: C's `main` runs the `test__file<k>` its one
// argument names, else exits 2; in the unit of the first.
private void test_dispatch(^C c, ^check.World w, ^ref []CUnit units):
    ref []i64 ks
    ref []u32 fs
    for i in 0..<#len(w.fns):
        if (w.fns[i].flags & ir.H_ENTRY) == 0 || #len(w.live) > 0 && !w.live[i]: continue
        string8 nm = check.name_of(w, w.decls[w.jobs[i].decl].name)
        if !strings.starts_with(nm, "test__file"): continue
        i64 k = 0
        for ch in nm[10..<#len(nm)]:
            k = k * 10 + i64(u8(ch) - u8('0'))
        i64 j = #len(ks)
        ks = #append(ks, k)
        fs = #append(fs, u32(i))
        for j > 0 && ks[j - 1] > k:
            ks[j] = ks[j - 1]
            fs[j] = fs[j - 1]
            j -= 1
        ks[j] = k
        fs[j] = u32(i)
    if #len(fs) == 0: return
    ref []char8 o
    if w.os == "WEB": put(&o, "#error \"a web build holds one @test file: give dadoc --test= once\"\n")
    else:
        put(&o, "int main(int dado_argc, char **dado_argv) {\n\tlong dado_which = -1;\n\tif (dado_argc == 2 && dado_argv[1][0] != 0) {\n\t\tdado_which = 0;\n\t\tfor (const char *dado_c = dado_argv[1]; *dado_c != 0; dado_c++) {\n\t\t\tif (*dado_c < '0' || *dado_c > '9' || dado_which > 1000000) { dado_which = -1; break; }\n\t\t\tdado_which = dado_which * 10 + (*dado_c - '0');\n\t\t}\n\t}\n\tswitch (dado_which) {\n")
        for j in 0..<#len(fs):
            put(&o, index.hold(#format("\tcase ", ks[j], ": return ", c.t.text(w.fns[fs[j]].name), "();\n")))
        put(&o, "\tdefault: return 2;\n\t}\n}\n")
    u32 file = w.fns[fs[0]].file
    for j in 0..<#len(units^):
        if units^[j].file == file:
            put(&units^[j].text, index.hold(o))
            return

void program(^check.World w, ^ref []char8 header, ^ref []CUnit units):
    C c
    c.w = w
    c.t = &w.t
    c.k = &w.k
    for i in 0..<#len(w.fns):
        if #len(w.live) > 0 && !w.live[i] || w.fns[i].dialect == ir.D_SCRIPT: continue
        u32 file = w.fns[i].file
        i64 u = -1
        for j in 0..<#len(units^):
            if units^[j].file == file: u = j
        if u < 0:
            units^ = #append(units^, CUnit(file, nil))
            u = #len(units^) - 1
        #truncate(c.out, 0)
        define(&c, &w.fns[i], w.p.files[file].path, w)
        put(&units^[u].text, c.out)
    if w.testing && #len(index.g_tests) > 1: test_dispatch(&c, w, units)
    i64 pi = 0
    for pi < #len(c.pending):
        _ = ty(&c, c.pending[pi])
        pi += 1
    ref []char8 protos
    ref []char8 globs
    for d in w.globals:
        u32 gt = w.decls[d].ty
        string8 nm = global_name(&c, check.tstr(w, check.pkg_key(w, w.decls[d].pkg)), check.tstr(w, check.name_of(w, w.decls[d].name)))
        string8 tl = "_Thread_local " if check.thread_local(w, d) else ""
        put(&protos, index.hold(#format("extern ", tl, ty(&c, gt), " ", nm, ";\n")))
        string8 al = "_Alignas(DADO_MAX_ALIGN) " if byte_run(&c, gt) >= 16 else ""
        if d in w.galign:
            u64 an = 0
            try an = w.galign[d] else: pass
            al = index.hold(#format("_Alignas(", an, ") "))
        put(&globs, index.hold(#format(al, tl, ty(&c, gt), " ", nm, " = ", cinit(&c, w.decls[d].value, gt), ";\n")))
    ref []char8 cb
    c_bodies(&c, &cb)
    // One consumer id per thread across every unit (a `static` would be one per unit);
    // 8-aligned, as bit 0 of an owner word marks an open walk.
    if c.chans: put(&globs, "_Thread_local uint64_t dado_ch_tid;\n")
    if g_trace: put(&globs, "DADO_TRACE_TLS dado_rt__frame dado_rt__frames[4097];\nDADO_TRACE_TLS uint32_t dado_rt__depth;\n")
    reexports(&c, &protos, &globs)
    if #len(w.classes) > 0 && check.rt_pkg(w) != NONE:
        put(&globs, js_tables(w))
        put(&globs, seam_glue(&c))
        put(&protos, hrun_protos(&c))
    if #len(units^) > 0: put(&units^[0].text, globs)
    for i in 0..<#len(w.fns):
        if #len(w.live) > 0 && !w.live[i] || w.fns[i].dialect == ir.D_SCRIPT: continue
        put(&protos, sig(&c, &w.fns[i]))
        put(&protos, ";\n")
    // `#WEB` has no C library: the runtime's own header, and a unit of its C.
    if w.os == "WEB":
        put(header, expanded("web/web.h"))
        // `main(argc, argv)`: the loader hands the host's arguments (web.c).
        if web_args(w): put(header, "#define DADO_WEB_ARGS 1\n")
        units^ = #append(units^, CUnit(u32(#len(w.p.files)), nil))
        put(&units^[#len(units^) - 1].text, expanded("web/web.c"))
        // The engine's own unit, without dado.h (its types are the engine's).
        if check.reaches_header(w, "quickjs.h"):
            put(header, expanded("web/quickjs.h"))
            units^ = #append(units^, CUnit(RAW_UNIT, nil))
            put(&units^[#len(units^) - 1].text, expanded("web/engine.c"))
    // `define` clauses before every `#include` (Rust's): a feature macro
    // read after `<stdint.h>` is read by nothing.
    string8 heads = check.foreign_heads(w)
    ref []char8 incs
    ref []char8 impls
    ref []char8 defs
    for ln in strings.split(heads, "\n"):
        if g_impl_split && strings.starts_with(ln, "#define ") && impl_switch(ln[8..<#len(ln)]): put(&impls, index.hold(#format(ln, "\n")))
        else if strings.starts_with(ln, "#define "):
            put(header, index.hold(#format(ln, "\n")))
            put(&defs, index.hold(#format(ln, "\n")))
        else if #len(ln) > 0: put(&incs, index.hold(#format(ln, "\n")))
    put(header, "#include <stdint.h>\n#include <stddef.h>\n")
    put(header, index.hold(incs))
    // `--implementations=`: the `*_IMPL` switches and the headers, a unit apart.
    #truncate(g_impl_text, 0)
    if #len(impls) > 0:
        put(&g_impl_text, index.hold(impls))
        // The feature macros the headers read (`SOKOL_GLCORE`), as the program's.
        put(&g_impl_text, index.hold(defs))
        put(&g_impl_text, index.hold(incs))
    // `--no-assert` drops the walk checks (Rust's `walk_guards`): maps, channels.
    if w.no_assert: put(header, "#define DADO_NO_WALK_GUARDS 1\n")
    if g_trace: put(header, "#define DADO_TRACE 1\n#define DADO_TRACE_TLS _Thread_local\n" if w.os != "NONE" else "#define DADO_TRACE 1\n#define DADO_TRACE_TLS\n")
    // `#NONE`: no C library (Rust's freestanding C): its shim, and the
    // runtime's hosted `#include`s left out.
    bool none = w.os == "NONE"
    if none:
        put(header, NONE_RT)
        put(header, "\n")
        put(header, hosted_off(PRELUDE))
    else: put(header, PRELUDE)
    bool js = #len(w.classes) > 0 && check.rt_pkg(w) != NONE
    if js: put(header, JS_HEAD)
    if js && #len(w.recv) > 0: put(header, RECV_HEAD)
    put(header, "\n")
    // The seed and the ambient allocator only where something reads them (a
    // plain program links neither, as Rust's).
    put(&protos, cb)
    bool seed = uses(&c, &protos, units^, "dado_hash_seed")
    bool ctx = seed || uses(&c, &protos, units^, "dado_context")
    #truncate(protos, #len(protos) - #len(cb))
    c.seeded = seed
    g_seeded = seed
    if #len(units^) > 0 && (seed || ctx):
        ref []char8 pre
        if seed: put(&pre, "uint64_t dado_hash_seed = 0x9E3779B97F4A7C15ULL;\n")
        if ctx: put(&pre, "_Thread_local dado_alloc dado_context = { dado_heap, 0 };\n")
        string8 u0 = units^[0].text
        put(&pre, u0)
        units^[0].text = pre
    if !c.seeded: put(header, "#define DADO_NO_SEED 1\n")
    if none: put(header, hosted_off(MAP_RT))
    else: put(header, MAP_RT)
    put(header, "\n#define DADO_SEED_INIT() dado_hash_seed_init()" if c.seeded else "\n#define DADO_SEED_INIT() ((void)0)")
    put(header, "\n")
    if c.chans && none: put(header, hosted_off(CHAN_RT))
    else if c.chans: put(header, CHAN_RT)
    put(header, c.decls)
    put(header, c.maps)
    put(header, protos)
    put(header, cb)
    #truncate(c.out, 0)
    for d in w.dispatches:
        dispatch(&c, d)
    put(header, c.out)
    // `#WEB`: the `DADO_WEB` conditionals settled, so the C names no header
    // the web has no C library for (as Rust's web C).
    if w.os == "WEB":
        string8 hv = header^
        string8 hs = web_settled(hv)
        #truncate(header^, 0)
        put(header, hs)
        for k in 0..<#len(units^):
            if units^[k].file == RAW_UNIT: continue
            string8 uv = units^[k].text
            string8 ut = web_settled(uv)
            ref []char8 nt
            put(&nt, ut)
            units^[k].text = nt

// `#NONE`'s C library: nothing. A failed check traps with nothing to report
// it on, `#default` allocates nothing, and there is no clock or environment.
const string8 NONE_RT = """
    #define DADO_NONE 1
    typedef struct dado_none_file dado_none_file;
    #define stderr ((dado_none_file *)0)
    #define stdout ((dado_none_file *)0)
    static inline int dado_none_fprintf(dado_none_file *f, const char *fmt, ...) { (void)f; (void)fmt; return 0; }
    static inline size_t dado_none_fwrite(const void *p, size_t s, size_t n, dado_none_file *f) { (void)p; (void)s; (void)f; return n; }
    static inline int dado_none_fputs(const char *s, dado_none_file *f) { (void)s; (void)f; return 0; }
    static inline void *dado_none_alloc(size_t a, size_t b) { (void)a; (void)b; return (void *)0; }
    static inline void *dado_none_realloc(void *p, size_t n) { (void)p; (void)n; return (void *)0; }
    static inline void dado_none_free(void *p) { (void)p; }
    static inline char *dado_none_getenv(const char *n) { (void)n; return (char *)0; }
    static inline unsigned long long dado_none_strtoull(const char *s, char **e, int b) { (void)s; (void)e; (void)b; return 0; }
    #define fprintf dado_none_fprintf
    #define fwrite dado_none_fwrite
    #define fputs dado_none_fputs
    #define calloc dado_none_alloc
    #define realloc dado_none_realloc
    #define free dado_none_free
    #define getenv dado_none_getenv
    #define strtoull dado_none_strtoull
    #define time(t) ((long long)0)
    #define clock() ((long long)0)
    #define abort() __builtin_trap()
    #define memcpy __builtin_memcpy
    #define memset __builtin_memset
    #define memmove __builtin_memmove
    #define memcmp __builtin_memcmp
    #define abs __builtin_abs
    #define aligned_alloc dado_none_alloc
    """

// Runtime C with its hosted `#include`s (the C library's) left out, for `#NONE`.
private string8 hosted_off(string8 s):
    ref []char8 o
    []string8 lines = strings.split(s, "\n")
    for li in 0..<#len(lines):
        string8 t = strings.trim(lines[li])
        if t == "#include <stdio.h>" || t == "#include <stdlib.h>" || t == "#include <string.h>" || t == "#include <time.h>" || t == "#include <math.h>" || t == "#include <malloc.h>": continue
        put(&o, lines[li])
        if li + 1 < #len(lines): put(&o, "\n")
    return index.hold(o)

// C text with `#ifdef DADO_WEB` / `#ifndef DADO_WEB` decided as defined (and
// `_WIN32` as not):
// the arm that holds kept, the other and both directives dropped.
private string8 web_settled(string8 s):
    ref []char8 o
    // Per open `#if`: 0 kept as written, 1 decided and keeping, 2 decided and
    // dropping, 3 inside a dropped arm.
    ref []u8 st
    i64 dropping = 0
    []string8 lines = strings.split(s, "\n")
    for li in 0..<#len(lines):
        string8 ln = lines[li]
        string8 t = strings.trim(ln)
        bool dir = #len(t) > 0 && t[0] == '#'
        string8 w = strings.trim_left(t[1..<#len(t)]) if dir else ""
        bool keep = dropping == 0
        if dir && strings.starts_with(w, "if"):
            if dropping > 0: st = #append(st, 3)
            else if w == "ifndef DADO_WEB" || w == "ifdef _WIN32": st = #append(st, 2)
            else if w == "ifdef DADO_WEB" || w == "ifndef _WIN32": st = #append(st, 1)
            else: st = #append(st, 0)
            if st[#len(st) - 1] != 0: keep = false
            if st[#len(st) - 1] == 2: dropping += 1
        else if dir && #len(st) > 0 && (strings.starts_with(w, "else") || strings.starts_with(w, "endif")):
            u8 top = st[#len(st) - 1]
            if top != 0: keep = false
            if strings.starts_with(w, "else"):
                if top == 1:
                    st[#len(st) - 1] = 2
                    dropping += 1
                else if top == 2:
                    st[#len(st) - 1] = 1
                    dropping -= 1
            else:
                if top == 2: dropping -= 1
                #truncate(st, #len(st) - 1)
        if keep:
            put(&o, ln)
            if li + 1 < #len(lines): put(&o, "\n")
    #delete(st)
    return index.hold(o)

// Whether the program's own C (not the runtime's) names `id`.
private bool uses(^C c, ^ref []char8 more, []CUnit units, string8 id):
    string8 m = more^
    string8 mp = c.maps
    string8 dc = c.decls
    if strings.contains(m, id) || strings.contains(mp, id) || strings.contains(dc, id): return true
    for u in units:
        string8 ut = u.text
        if strings.contains(ut, id): return true
    return false

// Package variables' `@c_body` C, after the externs; each package holding one
// also gets Rust's promised names, `dado_<package>_<name>`, for its variables.
private void c_bodies(^C c, ^ref []char8 o):
    ^check.World w = c.w
    ref []u32 ps
    for d in w.globals:
        syntax.Ast a = w.p.files[w.decls[d].file].a
        u32 n = w.decls[d].node
        if a.tag[n] != syntax.N_VAR || a.list(a.b[n])[3] == NONE: continue
        bool seen = false
        for p in ps:
            if p == w.decls[d].pkg: seen = true
        if !seen: ps = #append(ps, w.decls[d].pkg)
    for d in w.globals:
        bool on = false
        for p in ps:
            if p == w.decls[d].pkg: on = true
        if !on: continue
        string8 pk = check.pkg_key(w, w.decls[d].pkg)
        string8 nm = check.name_of(w, w.decls[d].name)
        put(o, index.hold(#format("#define dado_", unders(pk), "_", unders(nm), " ", global_name(c, check.tstr(w, pk), check.tstr(w, nm)), "\n")))
    // Every variable's block in a package the build reaches (Rust's: pruned
    // with its package), read or not.
    ref []bool live
    for _ in w.p.pkgs: live = #append(live, false)
    for i in 0..<#len(w.fns):
        if i < #len(w.live) && w.live[i] && w.jobs[i].decl != NONE: live[w.decls[w.jobs[i].decl].pkg] = true
    for d in w.globals: live[w.decls[d].pkg] = true
    for d in 0..<u32(#len(w.decls)):
        if w.decls[d].kind != check.K_VAR || !live[w.decls[d].pkg]: continue
        syntax.Ast a = w.p.files[w.decls[d].file].a
        u32 n = w.decls[d].node
        if a.tag[n] != syntax.N_VAR: continue
        u32 k = a.list(a.b[n])[3]
        if k == NONE: continue
        put(o, check.c_text(w.p.spell(w.decls[d].file, k)))
        put(o, "\n")
        // Its file's `foreign` headers come with it, as Rust's do.
        for e in 0..<u32(#len(w.decls)):
            if w.decls[e].file == w.decls[d].file && check.foreign_kind(w.decls[e].kind): check.reach_foreign(w, w.decls[e].file, w.decls[e].block)

// `_` doubled, as Rust's mangling escapes it.
private string8 unders(string8 s):
    ref []char8 r
    for ch in s:
        r = #append(r, ch)
        if ch == '_': r = #append(r, '_')
    return index.hold(r)

// A call through a trait value: a switch over the implementers' numbers.
private void dispatch(^C c, check.Dispatch d):
    []u32 ps = c.t.params(d.fty)
    u32 ret = c.t.a[d.fty]
    bool fl = c.t.b[d.fty] != types.F_NONE
    bool vd = ret == u32(types.P_VOID)
    string8 rt = "int32_t" if fl else ty(c, ret)
    ref []char8 o
    string8 out = ""
    if fl && !vd: out = index.hold(#format(ty(c, ret), " *dado_out, "))
    put(&o, index.hold(#format("static ", rt, " ", c.t.text(d.name), "(", out, "dado_trait v")))
    ref []char8 args
    for i in 1..<#len(ps):
        put(&o, index.hold(#format(", ", ty(c, ps[i]), " a", i)))
        put(&args, index.hold(#format(", a", i)))
    put(&o, ") {\n    switch (v.s1) {\n")
    string8 al = index.hold(args)
    string8 tn = check.name_of(c.w, c.w.decls[d.trait].name)
    string8 mn = check.name_of(c.w, d.method)
    for a in d.arms:
        string8 recv = index.hold(#format("(", ty(c, a.ty), " *)v.s0")) if a.pointer else index.hold(#format("*(", ty(c, a.ty), " *)v.s0"))
        string8 call = index.hold(#format(c.t.text(a.cname), "(", recv, al, ")"))
        if fl && !vd: call = index.hold(#format(c.t.text(a.cname), "(dado_out, ", recv, al, ")"))
        if vd && !fl: put(&o, index.hold(#format("    case ", a.number, ": ", call, "; return;\n")))
        else: put(&o, index.hold(#format("    case ", a.number, ": return ", call, ";\n")))
    put(&o, index.hold(#format("    case 0: fprintf(stderr, \"a call through an empty `", tn, "` — it was never assigned, calling `", mn, "`\\n\"); abort();\n")))
    put(&o, index.hold(#format("    default: fprintf(stderr, \"a `", tn, "` from an implementer this program was not built with, calling `", mn, "`\\n\"); abort();\n    }\n}\n")))
    put(&c.out, o)

// `export const NAME = fn`: a C function `NAME` that is `fn`.
private void reexports(^C c, ^ref []char8 protos, ^ref []char8 defs):
    ^check.World w = c.w
    for d in 0..<#len(w.decls):
        check.Decl x = w.decls[d]
        if x.kind != check.K_CONST || x.value == NONE || c.k.kind[x.value] != types.C_FN || x.ty == NONE: continue
        syntax.Ast a = w.p.files[x.file].a
        if (a.a[x.node] & syntax.F_VIS) != syntax.VIS_EXPORT: continue
        u32 ft = c.t.resolve(x.ty)
        if c.t.tag[ft] != types.T_FUNC || c.t.b[ft] != types.F_NONE: continue
        ref []char8 head
        ref []char8 call
        string8 rt = ty(c, c.t.a[ft])
        put(&head, index.hold(#format(rt, " ", check.name_of(w, x.name), "(")))
        put(&call, index.hold(#format(c.t.text(c.k.b[x.value]), "(")))
        []u32 ps = c.t.params(ft)
        for i in 0..<#len(ps):
            string8 sep = ", " if i > 0 else ""
            put(&head, index.hold(#format(sep, ty(c, ps[i]), " a", i)))
            put(&call, index.hold(#format(sep, "a", i)))
        if #len(ps) == 0: put(&head, "void")
        put(&head, ")")
        put(protos, index.hold(#format(head, ";\n")))
        string8 ret = "return " if c.t.a[ft] != u32(types.P_VOID) else ""
        put(defs, index.hold(#format(head, " { ", ret, call, "); }\n")))

// A math intrinsic: libm (`f` for `f32`), or C's own for integers.
private void math(^C c, ^ir.Fn f, u32 i):
    i64 k = i64(f.sub[i] - check.B_MATH)
    []u32 xs = ir.args(f, i)
    string8 d = text(c, f, f.dst[i])
    string8 a = text(c, f, xs[0])
    u32 t = f.ty_of[i]
    if check.int_prim_of(c.t, t) != types.PRIMS:
        string8 cty = ty(c, t)
        string8 e = ""
        if k == 26 && types.is_signed(check.int_prim_of(c.t, t)): e = index.hold(#format("(", a, " < 0 ? (", cty, ")(0u - (uint64_t)", a, ") : ", a, ")"))
        else if k == 26: e = a
        else: e = index.hold(#format("(", a, " ", "<" if k == 27 else ">", " ", text(c, f, xs[1]), " ? ", a, " : ", text(c, f, xs[1]), ")"))
        put(&c.out, index.hold(#format(d, " = ", e, ";\n")))
        return
    put(&c.out, index.hold(#format(d, " = ", check.MATH[k].c, "f" if check.float_bits(c.w, t) == 32 else "", "(")))
    for j in 0..<#len(xs):
        if j > 0: put(&c.out, ", ")
        put(&c.out, text(c, f, xs[j]))
    put(&c.out, ");\n")

// A wide literal: `text` (UTF-8) as UTF-16 or UTF-32 units, each escaped;
// `bare`, a static initializer's braces (no compound literal: `-pedantic`).
private string8 wide_lit(string8 text, bool w16, bool bare = false):
    ref []char8 o
    if !bare: put(&o, "((dado_string16)" if w16 else "((dado_string32)")
    put(&o, "{ (const uint16_t *)u\"" if w16 else "{ (const uint32_t *)U\"")
    i64 n = 0
    i64 i = 0
    for i < #len(text):
        u32 c = u32(u8(text[i]))
        i64 k = 1
        if c >= 0xF0:
            c = c & 7
            k = 4
        else if c >= 0xE0:
            c = c & 15
            k = 3
        else if c >= 0xC0:
            c = c & 31
            k = 2
        for j in 1..<k:
            if i + j < #len(text): c = (c << 6) | (u32(u8(text[i + j])) & 63)
        i += k
        if w16 && c >= 0x10000:
            put(&o, index.hold(#format("\\x", hex(0xD800 + ((c - 0x10000) >> 10)), "\\x", hex(0xDC00 + ((c - 0x10000) & 0x3FF)))))
            n += 2
        else:
            put(&o, index.hold(#format("\\x", hex(c))))
            n += 1
    put(&o, index.hold(#format("\", ", n, " }")))
    if !bare: put(&o, ")")
    return index.hold(o)

private string8 hex(u32 v):
    ref []char8 o
    u32 x = v
    ref []char8 d
    for x > 0 || #len(d) == 0:
        d = #append(d, "0123456789abcdef"[x & 15])
        x = x >> 4
    for j in 0..<#len(d):
        o = #append(o, d[#len(d) - 1 - j])
    return index.hold(o)

// Whether shape `t` has a slot of a header's named member list.
private bool holds_cnl(^C c, u32 t):
    for x in c.t.slots(t):
        if c.t.resolve(x) in c.w.cnl: return true
    return false

// A header struct of one array member (its slots are that member's elements).
private bool one_array(^C c, u32 fx):
    []u32 ns = c.t.slot_names(fx)
    u32 ue = NONE
    i64 un = 0
    return #len(ns) == 1 && c.t.uniform(c.t.resolve(fx), &ue, &un) && un > 1
