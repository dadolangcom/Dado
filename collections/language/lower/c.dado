// C from IR: one shared header (shapes, prototypes, foreign heads, the
// render routines) and one unit per Dado file, each op under a `#line`.
package lower

import "language:check"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:os/fs"
import "core:strings"

const u32 NONE = 0xFFFFFFFF

type CUnit:
    u32 file
    ref []char8 text

// Slots past which a fixed array's render is a loop (Rust's `MAX_UNROLLED_SLOTS`).
private const i64 MAX_UNROLLED = 16

// A unit's `file` when its text is written without `#include "dado.h"`.
const u32 RAW_UNIT = 0xFFFFFFFF

type C:
    ^check.World w
    ^types.Types t
    ^types.Consts k
    ref []char8 decls
    ref []u32 done
    ref []char8 out
    // `#stack` storage, declared at the top of the function being written.
    ref []char8 hoist
    ref []bool targeted
    // Shapes declared ahead (a pointer to them was written), defined last.
    ref []u32 pending
    // The map tables and their helpers, after every shape.
    ref []char8 maps
    bool chans
    // The program holds a map: `main` seeds the hash.
    bool seeded
    ref []u32 seen
    // The long strings (`strlit`) the function being written holds.
    ref []u32 longs
    // A function's C name to its index in `w.fns`, built on first use.
    {u32: u32} fn_at

private void put(^ref []char8 o, string8 s):
    for c in s:
        o^ = #append(o^, c)

private const [19]string8 PRIM_C = ("void", "_Bool", "int8_t", "int16_t", "int32_t", "int64_t", "uint8_t", "uint16_t", "uint32_t", "uint64_t", "float", "double", "void *", "uint8_t", "int64_t", "double", "uint8_t", "uint16_t", "uint32_t")

