// `--emit=js-package`: the program's
// scripts as a JavaScript library — `package.json`, `index.js` (a facade per
// exported class, a function per published one), the runtime, `dados/io.js`,
// `dados/glue.js`, a module per class in the library's flavour (`g_pkg`) and
// the JavaScript modules. `index.d.ts` is the `dts` extension's (tools/dadoc).
package lower

import "language:check"
import "language:index"
import "language:syntax"
import "language:types"
import "core:os/fs"
import "core:strings"

// The library's flavour for `js_module_as`.
bool g_pkg
// The classes a module names (`jclass`): what `index.js` reaches by `X$class()`.
ref []u32 g_reached

private type Ix:
    ref []string8 kinds

private string8 raw_of(^check.World w, u32 ci):
    return index.hold(#format(jid(check.name_of(w, w.decls[w.classes[ci].decl].name)), "$script"))

// Rust's `Shape::kind_text`.
private string8 kind_text(^check.World w, u32 ty):
    if ty == check.NONE: return "\"void\""
    u32 r = w.t.resolve(ty)
    u8 k = check.s_kind(w, ty)
    if k == 1:
        u32 e = w.t.a[r]
        if w.t.resolve(e) == u32(types.P_U8): return "[\"[]\", \"byte\"]"
        return index.hold(#format("[\"[]\", ", kind_text(w, e), "]"))
    if k == 2: return index.hold(#format("[\"{}\", ", kind_text(w, w.t.a[r]), ", ", kind_text(w, w.t.b[r]), "]"))
    u32 inner = check.sa_inner(w, ty)
    if inner != check.NONE: return index.hold(#format("[\"async\", ", kind_text(w, inner), "]"))
    if check.s_fn(w, ty):
        ref []string8 xs
        for p in w.t.params(r):
            xs = #append(xs, kind_text(w, p))
        return index.hold(#format("[\"fn\", [", strings.join(xs[:], ", "), "], ", kind_text(w, w.t.a[r]), "]"))
    if ty == w.serror: return "\"error\""
    if ty == w.sloc: return "\"location\""
    u32 ci = check.s_class_of_ty(w, ty)
    if ci != check.NONE: return index.hold(#format("[\"class\", ", raw_of(w, ci), ", ", jstring(check.name_of(w, w.decls[w.classes[ci].decl].name)), "]"))
    if check.s_enum(w, ty):
        u32 ed = check.NONE
        try ed = w.type_decl[ty] else: ed = check.NONE
        ref []string8 ms
        for key in w.order:
            if u32(key >> 32) == ed: ms = #append(ms, jstring(check.name_of(w, u32(key & 0xFFFFFFFF))))
        return index.hold(#format("[\"enum\", [", strings.join(ms[:], ", "), "]]"))
    if check.s_tup(w, ty):
        ref []string8 xs
        for x in w.t.slots(ty):
            xs = #append(xs, kind_text(w, x))
        if #len(xs) > 0: return index.hold(#format("[\"()\", [", strings.join(xs[:], ", "), "]]"))
    if ty == w.sany: return "\"any\""
    if ty == w.sstr: return "\"string\""
    if r == u32(types.P_INT): return "\"int\""
    if r == u32(types.P_FLOAT): return "\"float\""
    if r == u32(types.P_BOOL): return "\"bool\""
    if r == u32(types.P_U8): return "\"byte\""
    return "\"void\""

private string8 kind_of(^check.World w, ^Ix x, u32 ty):
    string8 t = kind_text(w, ty)
    for i in 0..<#len(x.kinds):
        if x.kinds[i] == t: return index.hold(#format("K", i))
    x.kinds = #append(x.kinds, t)
    return index.hold(#format("K", #len(x.kinds) - 1))

private void entry(^ref []char8 body, string8 head, string8 line):
    put(body, index.hold(#format("    ", head, " {\n        try {\n            ", line, "\n        } catch (e) {\n            throw $thrown(e);\n        }\n    }\n")))

// A method's parameters as locals, and its arguments checked (`checked_args`).
private void checked_args(^check.World w, ^Ix x, u32 m, string8 what, ^ref []string8 params, ^ref []string8 args):
    u32 ft = check.resolve(w, m)
    if ft == check.NONE: return
    u32 f = w.decls[m].file
    syntax.Ast a = w.p.files[f].a
    []u32 ks = a.list(a.b[w.decls[m].node])
    []u32 qs = ks[6..<#len(ks)]
    ref []u32 ps = check.s_mparams(w, w.t.resolve(ft))
    for i in 0..<#len(ps):
        string8 pn = ""
        if i < #len(qs) && qs[i] != check.NONE: pn = index.hold(strings.clone(w.p.spell(f, qs[i])))
        string8 k = kind_of(w, x, ps[i])
        string8 local = js_param(pn)
        args^ = #append(args^, index.hold(#format("$in(", k, ", ", local, ", ", jstring(index.hold(#format(what, ": argument `", pn, "`"))), ")")))
        params^ = #append(params^, local)

private u32 ret_of(^check.World w, u32 m):
    u32 ft = w.t.resolve(check.resolve(w, m))
    if ft == check.NONE: return u32(types.P_VOID)
    return w.t.a[ft]

// The line answering `call` (`answer`); `awaits` when it is `async`.
private string8 answer(^check.World w, ^Ix x, u32 ret, string8 call, ^bool awaits):
    u32 inner = check.sa_inner(w, ret)
    if inner != check.NONE:
        awaits^ = true
        if w.t.resolve(inner) == u32(types.P_VOID): return index.hold(#format("await ", call, ";"))
        return index.hold(#format("return $out(", kind_of(w, x, inner), ", await ", call, ");"))
    if w.t.resolve(ret) == u32(types.P_VOID): return index.hold(#format(call, ";"))
    return index.hold(#format("return $out(", kind_of(w, x, ret), ", ", call, ");"))

private string8 method_key(string8 n):
    if n == "constructor": return "[\"constructor\"]"
    return n

private void facade(^check.World w, ^Ix x, u32 ci, ^ref []char8 body):
    string8 cn = check.name_of(w, w.decls[w.classes[ci].decl].name)
    string8 name = jid(cn)
    string8 raw = raw_of(w, ci)
    put(body, index.hold(#format("export class ", name, " {\n")))
    ref []string8 ps
    ref []string8 as
    u32 init = w.p.names.intern("init")
    u32 im = check.s_method_in(w, ci, init)
    if im != check.NONE: checked_args(w, x, im, index.hold(#format("new ", name)), &ps, &as)
    entry(body, index.hold(#format("constructor(", strings.join(ps[:], ", "), ")")), index.hold(#format("$bind(this, new ", raw, "(", strings.join(as[:], ", "), "));")))
    u32 row = check.resolve(w, w.classes[ci].decl)
    []u32 fts = w.t.slots(row)
    ref []check.SField fs = check.s_fields_of(w, ci)
    for k in 0..<#len(fs):
        if fs[k].emb >= 0 || !ds_publishes(w, fs[k].file, fs[k].node) || k >= #len(fts): continue
        string8 fname = check.name_of(w, fs[k].sym)
        string8 kk = kind_of(w, x, fts[k])
        string8 at = jstring(index.hold(#format(name, ".", fname)))
        put(body, "\n")
        entry(body, index.hold(#format("get ", method_key(fname), "()")), index.hold(#format("return $out(", kk, ", $self(this, ", at, ").", fname, ");")))
        put(body, "\n")
        entry(body, index.hold(#format("set ", method_key(fname), "(value)")), index.hold(#format("$self(this, ", at, ").", fname, " = $in(", kk, ", value, ", jstring(index.hold(#format(name, ".", fname, ": the value written"))), ");")))
    // The chain, root first: each name once, the most derived method.
    ref []u32 chain
    u32 c = ci
    for _ in 0..<64:
        if c == check.NONE: break
        chain = #append(chain, c)
        c = check.s_parent(w, c)
    ref []u32 names
    i64 j = #len(chain)
    for j > 0:
        j -= 1
        for m in w.classes[chain[j]].methods:
            u32 sy = w.decls[m].name
            if sy == init: continue
            bool have = false
            for y in names:
                if y == sy: have = true
            if !have: names = #append(names, sy)
    for sy in names:
        u32 r = check.s_method_in(w, ci, sy)
        if r == check.NONE || !ds_publishes(w, w.decls[r].file, w.decls[r].node): continue
        string8 mn = check.name_of(w, w.decls[r].name)
        string8 what = index.hold(#format(name, ".", mn))
        ref []string8 mps
        ref []string8 mas
        checked_args(w, x, r, what, &mps, &mas)
        string8 call = index.hold(#format("$self(this, ", jstring(what), ").", mn, "(", strings.join(mas[:], ", "), ")"))
        bool awaits = false
        string8 line = answer(w, x, ret_of(w, r), call, &awaits)
        string8 mark = ""
        if awaits: mark = "async "
        put(body, "\n")
        entry(body, index.hold(#format(mark, method_key(mn), "(", strings.join(mps[:], ", "), ")")), line)
    put(body, index.hold(#format("}\n$publish(", name, ", ", raw, ");\n\n")))

private void pfunction(^check.World w, ^Ix x, u32 ci, u32 m, ^ref []char8 body):
    string8 mn = check.name_of(w, w.decls[m].name)
    ref []string8 ps
    ref []string8 as
    checked_args(w, x, m, mn, &ps, &as)
    ref []string8 all
    all = #append(all, "undefined")
    for a in as:
        all = #append(all, a)
    string8 call = index.hold(#format(raw_of(w, ci), ".prototype.", mn, ".call(", strings.join(all[:], ", "), ")"))
    bool awaits = false
    string8 line = answer(w, x, ret_of(w, m), call, &awaits)
    string8 mark = ""
    if awaits: mark = "async "
    put(body, index.hold(#format("export ", mark, "function ", mn, "(", strings.join(ps[:], ", "), ") {\n    try {\n        ", line, "\n    } catch (e) {\n        throw $thrown(e);\n    }\n}\n\n")))

private bool exported_class(^check.World w, u32 ci):
    u32 cd = w.classes[ci].decl
    return (w.p.files[w.decls[cd].file].a.a[w.decls[cd].node] & syntax.F_VIS) == syntax.VIS_EXPORT && check.s_outer(w, ci) == check.NONE

// Whether another module reaches class `ci` (Rust's `reached_from_elsewhere`).
private bool reached(^check.World w, u32 ci):
    for x in g_reached:
        if x == ci: return true
    for k in 0..<#len(w.classes):
        if check.s_parent(w, u32(k)) == ci: return true
    return false

private void import_class(^check.World w, u32 ci, ^ref []char8 imports):
    string8 cn = check.name_of(w, w.decls[w.classes[ci].decl].name)
    string8 name = jid(cn)
    string8 file = js_file(jmod(w, ci))
    string8 raw = raw_of(w, ci)
    if reached(w, ci): put(imports, index.hold(#format("import { ", name, "$class } from \"./", file, "\";\nconst ", raw, " = ", name, "$class();\n")))
    else: put(imports, index.hold(#format("import { ", name, " as ", raw, " } from \"./", file, "\";\n")))

// `index.js` (Rust's `Surface::index_js`).
private string8 index_js(^check.World w, string8 pname):
    Ix x
    ref []char8 imports
    ref []char8 body
    u32 init = w.p.names.intern("init")
    for ci in 0..<#len(w.classes):
        if exported_class(w, u32(ci)): import_class(w, u32(ci), &imports)
    ref []u32 fcs
    ref []u32 fms
    for ci in 0..<#len(w.classes):
        for m in w.classes[ci].methods:
            if (w.p.files[w.decls[m].file].a.a[w.decls[m].node] & syntax.F_VIS) != syntax.VIS_EXPORT || w.decls[m].name == init: continue
            if !check.s_published_fn(w, u32(ci), m): continue
            fcs = #append(fcs, u32(ci))
            fms = #append(fms, m)
    for i in 0..<#len(fcs):
        if exported_class(w, fcs[i]): continue
        if strings.contains(fresh(imports), index.hold(#format(raw_of(w, fcs[i]), " "))): continue
        import_class(w, fcs[i], &imports)
    for ci in 0..<#len(w.classes):
        if exported_class(w, u32(ci)): facade(w, &x, u32(ci), &body)
    for i in 0..<#len(fcs):
        pfunction(w, &x, fcs[i], fms[i], &body)
    ref []char8 out
    put(&out, index.hold(#format("// index.js: the package `", pname, "`, DadoScript scripts built by dadoc as a JavaScript\n// library. Each exported class is published as a facade over the script's own\n// class, whose entries check what a caller hands in (`dados/glue.js`).\n")))
    put(&out, "import { $bind, $in, $out, $publish, $self, $thrown, DadosError } from \"./dados/glue.js\";\n")
    put(&out, "import { __dados_Location as Location } from \"./dados/runtime.js\";\n")
    put(&out, fresh(imports))
    put(&out, "\nexport { Location, DadosError };\n\n")
    for i in 0..<#len(x.kinds):
        put(&out, index.hold(#format("const K", i, " = ", x.kinds[i], ";\n")))
    if #len(x.kinds) > 0: put(&out, "\n")
    put(&out, fresh(body))
    return fresh(out)

private string8 package_json(string8 name, string8 version):
    return index.hold(#format("{\n  \"name\": ", jstring(name), ",\n  \"version\": ", jstring(version), ",\n  \"description\": \"DadoScript scripts built as a JavaScript library by dadoc\",\n  \"type\": \"module\",\n  \"main\": \"./index.js\",\n  \"types\": \"./index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./index.d.ts\",\n      \"default\": \"./index.js\"\n    }\n  },\n  \"files\": [\n    \"index.js\",\n    \"index.d.ts\",\n    \"toys/\",\n    \"*/\"\n  ]\n}\n"))

// Writes the library under `dir`; "" when written, else what went wrong.
string8 js_package(^check.World w, string8 dir, string8 name, string8 version):
    if #len(w.classes) == 0: return "the program holds no DadoScript, so there is no JavaScript library to write: --emit=js-package builds a package of scripts"
    ref []string8 paths
    ref []string8 texts
    // The class modules first: `index.js` asks which of them another reaches.
    g_pkg = true
    #truncate(g_reached, 0)
    ref []string8 mods
    for ci in 0..<#len(w.classes):
        mods = #append(mods, js_module_as(w, u32(ci), false))
    g_pkg = false
    for x in ["package.json", "index.js", "dados/runtime.js", "dados/io.js", "dados/glue.js"]:
        paths = #append(paths, x)
    texts = #append(texts, package_json(name, version))
    texts = #append(texts, index_js(w, name))
    texts = #append(texts, asset("runtime.js"))
    texts = #append(texts, asset("io.js"))
    texts = #append(texts, asset("glue.js"))
    for ci in 0..<#len(w.classes):
        paths = #append(paths, js_file(jmod(w, u32(ci))))
        texts = #append(texts, mods[ci])
    for m in 0..<#len(w.jsn):
        if #len(w.jss[m]) < 2 || w.jsn[m] == "dados:exports": continue
        string8 f = js_file(w.jsn[m])
        ref []string8 im
        string8 t = js_linked(f, w.jss[m], &im)
        paths = #append(paths, f)
        texts = #append(texts, t)
    for i in 0..<#len(paths):
        for k in 0..<i:
            if strings.equal_fold(paths[k], paths[i]): return index.hold(#format("two files of the package would be written to `", paths[i], "`: a package's own files are `package.json`, `index.js`, `index.d.ts` and `dados/`, so rename the package or the class that meets them"))
    for i in 0..<#len(paths):
        string8 p = index.hold(#format(dir, "/", paths[i]))
        i64 sl = strings.last_index_of(p, '/')
        try fs.make_dirs(p[0..<sl]) else: return index.hold(#format("cannot make ", p[0..<sl]))
        try fs.write_file(p, texts[i]) else: return index.hold(#format("cannot write ", p))
    return ""
