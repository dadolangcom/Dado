// A `#WEB` build's manifest and scripts: the imports and exports the module has, and each script
// module as a file beside it, listed by `registry.js`.
package lower

import "core:fmt"
import "core:os/fs"
import "core:strings"
import "language:check"
import "language:index"
import "language:ir"
import "language:syntax"

// The engine's host calls (`engine.c`), in Rust's order.
private const [41]string8 DADOS_IMPORTS = ("ctx_new (i32)->()", "ctx_free (i32)->()", "dup (i32)->()", "free (i32)->()", "string (i32,i32,i32,i32)->()", "string16 (i32,i32,i32,i32)->()", "bigint (i32,i64,i32)->()", "array (i32,i32)->()", "map_new (i32,i32)->()", "map_entries (i32,i32,i32)->()", "to_bigint (i32,i32,i32)->(i32)", "to_cstring (i32,i32,i32,i32)->(i32)", "to_utf16 (i32,i32,i32)->(i32)", "is (i32,i32)->(i32)", "length (i32,i32,i32)->(i32)", "global (i32,i32)->()", "get (i32,i32,i32,i32)->()", "set (i32,i32,i32,i32)->(i32)", "define (i32,i32,i32,i32,i32)->(i32)", "get_index (i32,i32,i64,i32)->()", "set_index (i32,i32,i64,i32)->(i32)", "read_run (i32,i32,i32,i32,i64)->(i32)", "array_from (i32,i32,i32,i64,i32)->()", "call (i32,i32,i32,i32,i32,i32)->()", "construct (i32,i32,i32,i32,i32)->()", "cfunction (i32,i32,i32,i32,i32,i32)->()", "exception (i32,i32)->()", "throw (i32,i32)->()", "error (i32,i32,i32,i32)->()", "module_new (i32,i32,i32,i32)->(i32)", "module_export (i32,i32,i32)->(i32)", "module_set (i32,i32,i32,i32)->(i32)", "eval_module (i32,i32,i32)->()", "load_module (i32,i32,i32,i32)->()", "namespace (i32,i32,i32)->()", "promise_state (i32,i32)->(i32)", "promise_result (i32,i32,i32)->()", "hold (i32)->()", "counters (i32,i32)->()", "frame (i32)->()", "fn_take (i32)->()")
private const [8]string8 DADOS_EXPORTS = ("dados_call (i32,i32,i32,i32,i32,i32)->()", "dados_alloc (i32,i32)->(i32)", "dados_free (i32,i32)->()", "dados_normalize (i32,i32,i32)->(i32)", "dados_load (i32,i32)->(i32)", "dados_init (i32,i32)->(i32)", "dados_interrupt (i32)->(i32)", "dados_word (i32)->(i32)")
// A `dado` host call, and the runtime function whose mention brings it.
private const [5]string8 HOST_CALLS = ("seed ()->(i64)", "now_ns ()->(i64)", "wall_ns ()->(i64)", "cores ()->(i32)", "exit (i32)->()")
private const [5]string8 HOST_BY = ("dado_hash_seed_init", "dado_rt__web_now_ns", "dado_rt__web_wall_ns", "dado_rt__web_thread_cores", "dado_rt__web_exit_status")

private const string8 WEB_EXPORTS = "// dado-exports.js (`dados:exports`): the running program's own `export`s, each a function of\n// its wasm instance under its C symbol, and its memory. Filled by the loader right after\n// instantiation, before `main` runs. Written by dadoc.\nexport let exports = null;\nexport let memory = null;\nlet filled = false;\n\nexport function __dado_exports_fill(published, mem) {\n    if (filled) {\n        throw new Error(\"dados:exports is filled once, by the loader\");\n    }\n    filled = true;\n    exports = published;\n    memory = mem;\n}\n"

// The manifest of the module these units make (`<P>.wasm.build`): the host
// calls its C makes and the names it exports; `stem` names the scripts'
// directory (`<stem>.scripts/`) for its `js-module` lines.
string8 web_manifest(^check.World w, []CUnit units, string8 stem):
    ref []char8 o
    o = #append(o, .."target wasm32-unknown-web\nos #WEB\narch #WASM32\n")
    // The console's flush is exported, so every module writes.
    o = #append(o, .."wasm-import dado write (i32,i32,i32)->()\n")
    bool engine = false
    for k in 0..<#len(HOST_CALLS):
        bool named = k == 0 && g_seeded
        for u in units:
            if mentions(u.text, HOST_BY[k]): named = true
        if named: o = #append(o, ..#format("wasm-import dado ", HOST_CALLS[k], "\n"))
    for u in units:
        if u.file == RAW_UNIT: engine = true
    if engine:
        for x in DADOS_IMPORTS:
            o = #append(o, ..#format("wasm-import dados ", x, "\n"))
    bool args = web_args(w)
    if args: o = #append(o, .."wasm-import dado arg_get (i32,i32,i32)->(i32)\n")
    o = #append(o, .."wasm-export memory memory\nwasm-export __indirect_function_table table\n")
    // The program's own `export`s, which `DADO_WASM_EXPORT` names in the module.
    C cs
    cs.w = w
    cs.t = &w.t
    cs.k = &w.k
    for e in exports_of(w):
        o = #append(o, ..#format("wasm-export ", e.name, " ", wasm_sig(&cs, e.ft, e.fl), "\n"))
    if args: o = #append(o, .."wasm-export main (i32,i32)->(i32)\nwasm-export dado_flush ()->()\nwasm-export dado_argv (i32)->(i32)\n")
    else: o = #append(o, .."wasm-export main ()->(i32)\nwasm-export dado_flush ()->()\n")
    if engine:
        for x in DADOS_EXPORTS:
            o = #append(o, ..#format("wasm-export ", x, "\n"))
        IPlan ip = inline_plan(w)
        if ip.count > 0: o = #append(o, .."wasm-export dados_glue ()->(i32)\nwasm-export dados_settle (i32)->()\nwasm-export dados_channels (i32)->(i32)\n")
        if ip.encodes: o = #append(o, .."wasm-export dados_room (i32)->(i32)\nwasm-export dados_unroom (i32)->()\n")
        if ip.owned: o = #append(o, .."wasm-export dados_drop ()->()\n")
        // A release build's scripts are one `registry.js` and the files it
        // keeps (`web_bundle`): the page loads those and no other, so the
        // modules the bundle holds are not listed (rc.9's `manifest_lines`).
        ref []string8 kept = web_kept(w)
        for e in web_entries(w):
            if w.release && !kept_file(kept[:], e.file): continue
            o = #append(o, ..#format("js-module ", stem, ".scripts/", e.file))
            if e.name == "dados:exports": o = #append(o, .." dados:exports")
            o = #append(o, '\n')
        o = #append(o, ..#format("js-module ", stem, ".scripts/registry.js\n"))
    return index.hold(o)

// An `export` of the program: its C symbol, and its function type and
// failability, which its wasm signature is read from.
type ExportFn:
    string8 name
    u32 ft
    bool fl

// The program's `export`s in declaration order (`c-export`, and on the web
// `wasm-export`): each `export` function compiled (live), and each
// `export const` alias, which is always written.
ref []ExportFn exports_of(^check.World w):
    ref []u32 at
    for _ in w.decls: at = #append(at, NONE)
    for i in 0..<#len(w.fns):
        if !check.export_fn(w, u32(i)): continue
        if #len(w.live) > 0 && (i >= #len(w.live) || !w.live[i]): continue
        at[w.jobs[i].decl] = u32(i)
    ref []ExportFn out
    for d in 0..<#len(w.decls):
        if at[d] != NONE:
            syntax.Ast a = w.p.files[w.decls[d].file].a
            u32 ft = w.t.resolve(check.resolve(w, u32(d)))
            out = #append(out, ExportFn(w.t.text(w.fns[at[d]].name), ft, (a.a[w.decls[d].node] & syntax.F_FAILABLE) != 0))
            continue
        u32 aft = alias_export(w, u32(d))
        if aft != NONE: out = #append(out, ExportFn(check.name_of(w, w.decls[d].name), aft, false))
    #delete(at)
    return out

// Whether the entry point takes C's `argc` and `argv`.
bool web_args(^check.World w):
    for f in w.fns:
        if (f.flags & ir.H_ENTRY) != 0 && f.params > 0: return true
    return false

// Whether `text` names `name` (no identifier character on either side).
private bool mentions(string8 text, string8 name):
    i64 from = 0
    for:
        i64 k = strings.find(text[from..<#len(text)], name)
        if k < 0: return false
        i64 a = from + k
        i64 b = a + #len(name)
        bool left = a == 0
        if !left: left = !ident(text[a - 1])
        bool right = b == #len(text)
        if !right: right = !ident(text[b])
        if left && right: return true
        from = a + 1
    return false

private bool ident(char8 c):
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'

// A module of the scripts: its name, its file, its text, what it imports.
private type WebEntry:
    string8 name
    string8 file
    string8 text
    ref []string8 imports

// Every module the registry lists, in Rust's order: the runtime, the
// classes, the JavaScript modules, the published exports.
private ref []WebEntry web_entries(^check.World w):
    ref []WebEntry es
    es = #append(es, WebEntry("dados:runtime", "dados/runtime.js", asset("runtime.js"), nil))
    if w.sloads: es = #append(es, WebEntry("dados:mods", "dados/mods.js", asset("mods.js"), nil))
    IPlan ip
    IPlan none
    if #len(w.classes) > 0: ip = inline_plan(w)
    for ci in 0..<#len(w.classes):
        string8 nm = jmod(w, u32(ci))
        es = #append(es, WebEntry(nm, js_file(nm), js_module_planned(w, u32(ci), true, &ip), imports_of(js_module_planned(w, u32(ci), false, &none))))
    for m in 0..<#len(w.jsn):
        if #len(w.jss[m]) < 2 || w.jsn[m] == "dados:exports": continue
        string8 f = js_file(w.jsn[m])
        ref []string8 im
        string8 t = js_linked(f, w.jss[m], &im)
        es = #append(es, WebEntry(w.jsn[m], f, t, im))
    es = #append(es, WebEntry("dados:exports", "dado-exports.js", WEB_EXPORTS, nil))
    return es

// The names a module's `import` lines import from.
private ref []string8 imports_of(string8 src):
    ref []string8 out
    for line in strings.split(src, "\n"):
        if !strings.starts_with(strings.trim_left(line), "import "): continue
        string8 rest = line
        for:
            i64 k = strings.find(rest, " from ")
            if k < 0: break
            rest = rest[k + 6..<#len(rest)]
            if #len(rest) == 0: break
            char8 q = rest[0]
            if q != '"' && q != '\'': continue
            i64 e = strings.index_of(rest[1..<#len(rest)], q)
            if e < 0: break
            out = #append(out, rest[1..<e + 1])
            rest = rest[e + 2..<#len(rest)]
    return out

// The registry's tables: each module by name, its namespace, its imports.
private string8 web_tables([]WebEntry es):
    ref []char8 r
    r = #append(r, .."export const modules = [\n")
    for i in 0..<#len(es):
        ref []string8 qs
        for x in es[i].imports:
            qs = #append(qs, jstr(x))
        r = #append(r, ..#format("    [", jstr(es[i].name), ", m", i, ", [", index.hold(strings.join(qs[:], ", ")), "]],\n"))
    r = #append(r, .."];\nexport const sites = [\n];\n")
    return index.hold(r)

// The files a release build's scripts keep beside `registry.js`: the
// scripts' JavaScript modules, as written, and `dado-exports.js`.
private ref []string8 web_kept(^check.World w):
    ref []string8 kept
    for m in 0..<#len(w.jsn):
        if #len(w.jss[m]) >= 2: kept = #append(kept, js_file(w.jsn[m]))
    kept = #append(kept, "dado-exports.js")
    return kept

private bool kept_file([]string8 kept, string8 file):
    for x in kept:
        if x == file: return true
    return false

// A release build's scripts (Rust's T21): one `registry.js` wrapping every
// module written here; the scripts' JavaScript and `dado-exports.js` kept.
private bool web_bundle(^check.World w, string8 dir, []WebEntry es, []string8 files, []string8 texts):
    // Rust's order: the runtime, web.js, stop.js, then the rest.
    ref []string8 ps
    ref []string8 ts
    ps = #append(ps, files[0])
    ts = #append(ts, texts[0])
    ps = #append(ps, files[#len(files) - 2])
    ts = #append(ts, texts[#len(files) - 2])
    ps = #append(ps, files[#len(files) - 1])
    ts = #append(ts, texts[#len(files) - 1])
    for i in 1..<#len(files) - 2:
        ps = #append(ps, files[i])
        ts = #append(ts, texts[i])
    ref []string8 kept = web_kept(w)
    ref []string8 roots
    roots = #append(roots, "dados/web.js")
    roots = #append(roots, "dado-exports.js")
    roots = #append(roots, "dados/stop.js")
    ref []string8 ents
    for e in es:
        roots = #append(roots, e.file)
        ents = #append(ents, e.file)
    string8 why = ""
    string8 reg = bundle(ps[:], ts[:], kept[:], roots[:], ents[:], "dados/runtime.js", "dados/web.js", "dados/stop.js", web_tables(es), &why)
    if #len(why) > 0:
        fmt.eprintln("dadoc: ", why)
        return false
    for i in 0..<#len(ps):
        bool k = false
        for x in kept:
            if x == ps[i]: k = true
        if !k: continue
        string8 p = index.hold(#format(dir, "/", ps[i]))
        try fs.make_dirs(p[0..<strings.last_index_of(p, '/')]) else: return false
        try fs.write_file(p, ts[i]) else: return false
    try fs.make_dirs(dir) else: return false
    try fs.write_file(index.hold(#format(dir, "/registry.js")), reg) else: return false
    return true

// Writes the scripts of a web build into `dir` (`<P>.scripts/`): each
// module's file, `dados/web.js` and `dados/stop.js` (beside this file), and
// `registry.js`. False when a file cannot be written.
bool web_scripts(^check.World w, string8 dir):
    ref []WebEntry es = web_entries(w)
    ref []string8 files
    ref []string8 texts
    for e in es:
        files = #append(files, e.file)
        texts = #append(texts, e.text)
    files = #append(files, "dados/web.js")
    texts = #append(texts, asset("web.js"))
    files = #append(files, "dados/stop.js")
    texts = #append(texts, asset("stop.js"))
    if w.release: return web_bundle(w, dir, es[:], files[:], texts[:])
    ref []char8 r
    r = #append(r, .."// registry.js: every module of this program's scripts, by the name its host\n// knows it by, with the names of the modules it imports. Written by dadoc.\nexport { __dados_bind, __dados_attach, __dados_vm, __dados_hold, __dados_counts } from \"./dados/web.js\";\nexport { __dado_exports_fill } from \"./dado-exports.js\";\nimport * as stop$ from \"./dados/stop.js\";\nexport { stop$ as __dados_stop };\n")
    for i in 0..<#len(es):
        r = #append(r, ..#format("import * as m", i, " from \"./", es[i].file, "\";\n"))
    r = #append(r, .."export const modules = [\n")
    for i in 0..<#len(es):
        ref []string8 qs
        for x in es[i].imports:
            qs = #append(qs, jstr(x))
        r = #append(r, ..#format("    [", jstr(es[i].name), ", m", i, ", [", index.hold(strings.join(qs[:], ", ")), "]],\n"))
    r = #append(r, .."];\nexport const sites = [\n];\n")
    files = #append(files, "registry.js")
    texts = #append(texts, index.hold(r))
    for i in 0..<#len(files):
        string8 p = index.hold(#format(dir, "/", files[i]))
        try fs.make_dirs(p[0..<strings.last_index_of(p, '/')]) else: return false
        try fs.write_file(p, texts[i]) else: return false
    return true
