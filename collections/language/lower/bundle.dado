// A release build's scripts as one `registry.js`:
// every module dadoc wrote wrapped in a generator, linked and run in the
// engine's order; the copied JavaScript modules and `dado-exports.js` kept as
// files. Read off the emitter's one-declaration lines; nothing is parsed.
package lower

import "core:strings"
import "language:index"

private const u8 BK_FN = 0
private const u8 BK_LEX = 1
private const u8 BK_LIVE = 2

// One `import` line: its target (k >= 0 wrapped, -(k + 1) kept), and a
// namespace's local or the named pairs.
private type BImport:
    i64 to
    bool ns
    string8 local
    ref []string8 names
    ref []string8 locals

private type BModule:
    string8 path
    ref []string8 lines
    ref []BImport imports
    ref []string8 ex_names      // sorted
    ref []u8 ex_kinds

private i64 ex_at(^BModule m, string8 n):
    for i in 0..<#len(m.ex_names):
        if m.ex_names[i] == n: return i
    return -1

private void ex_put(^BModule m, string8 n, u8 k):
    i64 at = ex_at(m, n)
    if at >= 0:
        m.ex_kinds[at] = k
        return
    i64 j = #len(m.ex_names)
    m.ex_names = #append(m.ex_names, n)
    m.ex_kinds = #append(m.ex_kinds, k)
    for j > 0 && strings.compare(m.ex_names[j - 1], n) > 0:
        m.ex_names[j] = m.ex_names[j - 1]
        m.ex_kinds[j] = m.ex_kinds[j - 1]
        j -= 1
    m.ex_names[j] = n
    m.ex_kinds[j] = k

private string8 bident(string8 s):
    i64 e = 0
    for e < #len(s):
        char8 c = s[e]
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '$'): break
        e += 1
    return s[0..<e]

// `spec` against module `path`'s directory; "" when not relative.
private string8 bresolve(string8 path, string8 spec):
    ref []string8 parts
    for p in strings.split(path, "/"):
        parts = #append(parts, p)
    #truncate(parts, #len(parts) - 1)
    string8 rest = ""
    if strings.starts_with(spec, "./"): rest = spec[2..<#len(spec)]
    else if strings.starts_with(spec, "../"): rest = spec
    else: return ""
    for seg in strings.split(rest, "/"):
        if seg == ".": continue
        if seg == "..":
            if #len(parts) == 0: return ""
            #truncate(parts, #len(parts) - 1)
            continue
        parts = #append(parts, seg)
    return index.hold(strings.join(parts[:], "/"))

private i64 target_of(string8 p, []string8 wrapped, []string8 kept):
    for i in 0..<#len(wrapped):
        if wrapped[i] == p: return i
    for i in 0..<#len(kept):
        if kept[i] == p: return 0 - i - 1
    return -1000000

// Module `path` read off its lines; "" or the refusal in `why`.
private BModule bread(string8 path, string8 text, []string8 wrapped, []string8 kept, ^string8 why):
    BModule m
    m.path = path
    string8 t = text
    if strings.ends_with(t, "\n"): t = t[0..<#len(t) - 1]
    for line in strings.split(t, "\n"):
        if strings.starts_with(line, "import "):
            // One statement or several on the line (the emitter's classes'
            // line): each `import <clause> from "<spec>";`, and one line kept.
            string8 shape = index.hold(#format("`", path, "`'s line `", line, "` is an import of another shape, which the bundle takes from no module"))
            string8 left = strings.trim_right(line)
            for #len(left) > 0:
                if !strings.starts_with(left, "import "):
                    why^ = shape
                    return m
                string8 rest = left[7..<#len(left)]
                i64 fk = strings.find(rest, " from \"")
                if fk < 0:
                    why^ = shape
                    return m
                string8 clause = rest[0..<fk]
                string8 from = rest[fk + 7..<#len(rest)]
                i64 q = strings.index_of(from, '"')
                if q < 1 || q + 1 >= #len(from) || from[q + 1] != ';':
                    why^ = shape
                    return m
                string8 spec = from[0..<q]
                left = strings.trim_left(from[q + 2..<#len(from)])
                string8 rp = bresolve(path, spec)
                i64 to = target_of(rp, wrapped, kept) if #len(rp) > 0 else -1000000
                if to == -1000000:
                    why^ = index.hold(#format("`", path, "` imports `", spec, "`, a module the build did not write, which the bundle takes from no module"))
                    return m
                BImport im
                im.to = to
                if strings.starts_with(clause, "* as "):
                    im.ns = true
                    im.local = index.hold(strings.clone(strings.trim(clause[5..<#len(clause)])))
                else if strings.starts_with(clause, "{") && strings.ends_with(strings.trim_right(clause), "}"):
                    string8 c2 = strings.trim_right(clause)
                    for item in strings.split(c2[1..<#len(c2) - 1], ","):
                        string8 it = strings.trim(item)
                        i64 ak = strings.find(it, " as ")
                        string8 nm = it
                        string8 lc = it
                        if ak >= 0:
                            nm = strings.trim(it[0..<ak])
                            lc = strings.trim(it[ak + 4..<#len(it)])
                        im.names = #append(im.names, index.hold(strings.clone(nm)))
                        im.locals = #append(im.locals, index.hold(strings.clone(lc)))
                else:
                    why^ = shape
                    return m
                m.imports = #append(m.imports, im)
            m.lines = #append(m.lines, "")
        else if strings.starts_with(line, "export "):
            string8 rest = line[7..<#len(line)]
            u8 k = BK_FN
            string8 after = ""
            if strings.starts_with(rest, "function* "): after = rest[10..<#len(rest)]
            else if strings.starts_with(rest, "function "): after = rest[9..<#len(rest)]
            else if strings.starts_with(rest, "async function "): after = rest[15..<#len(rest)]
            else if strings.starts_with(rest, "class "):
                k = BK_LEX
                after = rest[6..<#len(rest)]
            else if strings.starts_with(rest, "const "):
                k = BK_LEX
                after = rest[6..<#len(rest)]
            else if strings.starts_with(rest, "let ") || strings.starts_with(rest, "var "):
                k = BK_LIVE
                after = rest[4..<#len(rest)]
            else:
                why^ = index.hold(#format("`", path, "`'s line `", line, "` is an export of another shape, which the bundle takes from no module"))
                return m
            string8 nm = bident(after)
            if #len(nm) == 0:
                why^ = index.hold(#format("`", path, "`'s line `", line, "` is an export of another shape, which the bundle takes from no module"))
                return m
            ex_put(&m, index.hold(strings.clone(nm)), k)
            if k == BK_LIVE:
                string8 init = after[#len(nm)..<#len(after)]
                if strings.trim(init) == ";": m.lines = #append(m.lines, "")
                else if strings.starts_with(init, " = "): m.lines = #append(m.lines, after)
                else:
                    why^ = index.hold(#format("`", path, "`'s line `", line, "` is an exported `let` of another shape, which the bundle takes from no module"))
                    return m
            else: m.lines = #append(m.lines, rest)
        else: m.lines = #append(m.lines, line)
    return m

private void bvisit(i64 t, []BModule ms, ^ref []bool seen_w, ^ref []bool seen_k, ^ref []i64 ran, ^ref []i64 asked):
    if t < 0:
        i64 k = 0 - t - 1
        if !seen_k^[k]:
            seen_k^[k] = true
            asked^ = #append(asked^, k)
        return
    if seen_w^[t]: return
    seen_w^[t] = true
    for im in ms[t].imports:
        bvisit(im.to, ms, seen_w, seen_k, ran, asked)
    ran^ = #append(ran^, t)

private i64 nl_count(string8 s):
    i64 n = 0
    for c in s:
        if c == '\n': n += 1
    return n

private const string8 BLINES = "const $$tables = [];\nfunction $$lines(at, end) {\n    return (file, fns, table, files) => {\n        $$tables.push([at, end, file, fns, table, files]);\n    };\n}\nfunction $$merged(register) {\n    $$tables.sort((a, b) => a[0] - b[0]);\n    const fns = [], table = [], files = [];\n    for (const [at, end, file, f, t, w] of $$tables) {\n        const base = fns.length;\n        table.push(at + 1, 0, 0, -1);\n        for (let i = 0; i < t.length; i += 4) {\n            table.push(t[i] + at, t[i + 1], t[i + 2], t[i + 3] < 0 ? -1 : t[i + 3] + base);\n        }\n        table.push(end + 1, 0, 0, -1);\n        for (let i = 0; i < f.length; i++) {\n            fns.push(f[i]);\n            files.push(w === undefined ? file : w[i]);\n        }\n    }\n    register(\"\", fns, table, files);\n}\n"

// The bundle of `paths`/`texts` (kept: those left as files), rooted at
// `roots`; `entries` the registry's (path of each); `tail` its tables.
// "" and `why` set on a refusal.
string8 bundle([]string8 paths, []string8 texts, []string8 kept_in, []string8 roots, []string8 entries, string8 rt, string8 web, string8 stop, string8 tail, ^string8 why):
    ref []string8 kept
    ref []string8 wrapped
    ref []string8 wtexts
    for i in 0..<#len(paths):
        bool k = false
        for x in kept_in:
            if x == paths[i]: k = true
        if k: kept = #append(kept, paths[i])
        else:
            wrapped = #append(wrapped, paths[i])
            wtexts = #append(wtexts, texts[i])
    ref []BModule ms
    for i in 0..<#len(wrapped):
        ms = #append(ms, bread(wrapped[i], wtexts[i], wrapped[:], kept[:], why))
        if #len(why^) > 0: return ""
    i64 rti = target_of(rt, wrapped[:], nil)
    i64 wbi = target_of(web, wrapped[:], nil)
    i64 sti = target_of(stop, wrapped[:], nil)
    // The exported `let`s, held once, by name.
    ref []string8 live
    for k in 0..<#len(ms):
        for e in 0..<#len(ms[k].ex_names):
            if ms[k].ex_kinds[e] != BK_LIVE: continue
            string8 n = ms[k].ex_names[e]
            for x in live:
                if x == n:
                    why^ = index.hold(#format("two modules both export a `let` named `", n, "`, which the bundle holds once"))
                    return ""
            i64 j = #len(live)
            live = #append(live, n)
            for j > 0 && strings.compare(live[j - 1], n) > 0:
                live[j] = live[j - 1]
                j -= 1
            live[j] = n
    ref []i64 ran
    ref []i64 asked
    ref []bool seen_w
    ref []bool seen_k
    for _ in ms:
        seen_w = #append(seen_w, false)
    for _ in kept:
        seen_k = #append(seen_k, false)
    for r in roots:
        i64 t = target_of(r, wrapped[:], kept[:])
        if t == -1000000:
            why^ = index.hold(#format("the registry imports `", r, "`, which is not written"))
            return ""
        bvisit(t, ms[:], &seen_w, &seen_k, &ran, &asked)
    for k in 0..<#len(ms):
        if !seen_w[k]:
            why^ = index.hold(#format("`", ms[k].path, "` is written and nothing imports it"))
            return ""
    ref []char8 out
    out = #append(out, .."// registry.js: every module of this program's scripts in one file, each wrapped in a\n// function that is handed what it imports, and the table of them by the name its host\n// knows it by. A release build's (`--release`); written by dadoc.\nexport { __dado_exports_fill } from \"./dado-exports.js\";\n")
    for k in asked:
        out = #append(out, ..#format("import * as $$x", k, " from \"./", kept[k], "\";\n"))
    for k in 0..<#len(kept):
        bool a = false
        for x in asked:
            if x == k: a = true
        if !a: out = #append(out, ..#format("import * as $$x", k, " from \"./", kept[k], "\";\n"))
    if #len(live) > 0: out = #append(out, ..#format("let ", index.hold(strings.join(live[:], ", ")), ";\n"))
    out = #append(out, ..BLINES)
    i64 at_line = nl_count(index.hold(out)) + 1
    ref []i64 sp0
    ref []i64 sp1
    for i in 0..<#len(ms):
        ref []string8 decls
        ref []string8 early
        // `late`: per module k, its assignments.
        ref []i64 late_k
        ref []string8 late_s
        string8 param = ""
        for im in ms[i].imports:
            if im.ns:
                decls = #append(decls, im.local)
                if im.to >= 0: early = #append(early, index.hold(#format(im.local, " = $$n", im.to, ";")))
                else: early = #append(early, index.hold(#format(im.local, " = $$x", 0 - im.to - 1, ";")))
                continue
            if im.to < 0:
                why^ = index.hold(#format("`", ms[i].path, "` imports names from `", kept[0 - im.to - 1], "`, which the bundle keeps as a file and takes by its namespace only"))
                return ""
            i64 k = im.to
            for q in 0..<#len(im.names):
                string8 name = im.names[q]
                string8 local = im.locals[q]
                i64 e = ex_at(&ms[k], name)
                if e < 0:
                    why^ = index.hold(#format("`", ms[i].path, "` imports `", name, "` from `", ms[k].path, "`, which exports no such name"))
                    return ""
                if k == rti && name == "__dados_lines":
                    param = local
                    continue
                u8 kd = ms[k].ex_kinds[e]
                if kd == BK_LIVE:
                    if local != name:
                        why^ = index.hold(#format("`", ms[i].path, "` imports the `let` `", name, "` of `", ms[k].path, "` as `", local, "`, and the bundle holds it under its own name"))
                        return ""
                else if kd == BK_FN:
                    decls = #append(decls, local)
                    early = #append(early, index.hold(#format(local, " = $$n", k, ".", name, ";")))
                else:
                    decls = #append(decls, local)
                    // In k's order (Rust's map by module).
                    i64 j = #len(late_k)
                    late_k = #append(late_k, k)
                    late_s = #append(late_s, index.hold(#format(local, " = $$n", k, ".", name, ";")))
                    for j > 0 && late_k[j - 1] > k:
                        late_k[j] = late_k[j - 1]
                        late_s[j] = late_s[j - 1]
                        j -= 1
                    late_k[j] = k
                    late_s[j] = index.hold(#format(local, " = $$n", k, ".", name, ";"))
        ref []string8 getters
        for n in ms[i].ex_names:
            getters = #append(getters, index.hold(#format("get ", n, "() { return ", n, "; }")))
        string8 nsp = "Object.freeze({ __proto__: null, [Symbol.toStringTag]: \"Module\" })"
        if #len(getters) > 0: nsp = index.hold(#format("Object.freeze({ __proto__: null, [Symbol.toStringTag]: \"Module\", ", index.hold(strings.join(getters[:], ", ")), " })"))
        string8 ea = "() => {}"
        if #len(early) > 0: ea = index.hold(#format("() => { ", index.hold(strings.join(early[:], " ")), " }"))
        string8 lt = "() => {}"
        if #len(late_k) > 0:
            ref []string8 arms
            i64 a = 0
            for a < #len(late_k):
                i64 b = a
                ref []string8 set
                for b < #len(late_k) && late_k[b] == late_k[a]:
                    set = #append(set, late_s[b])
                    b += 1
                arms = #append(arms, index.hold(#format("if (j === ", late_k[a], ") { ", index.hold(strings.join(set[:], " ")), " }")))
                a = b
            lt = index.hold(#format("(j) => { ", index.hold(strings.join(arms[:], " else ")), " }"))
        ref []char8 head
        head = #append(head, ..#format("// ", ms[i].path, "\nfunction* $$m", i, "(", param, ") {\n"))
        if #len(decls) > 0: head = #append(head, ..#format("    let ", index.hold(strings.join(decls[:], ", ")), ";\n"))
        head = #append(head, ..#format("    yield [", nsp, ", ", ea, ", ", lt, "];\n"))
        at_line += nl_count(index.hold(head))
        out = #append(out, ..head)
        i64 start = at_line
        for ln in ms[i].lines:
            out = #append(out, ..ln)
            out = #append(out, '\n')
        at_line += #len(ms[i].lines)
        sp0 = #append(sp0, start)
        sp1 = #append(sp1, at_line - 1)
        out = #append(out, .."}\n")
        at_line += 1
    out = #append(out, .."\n// Every module instantiated, then linked, then run in the engine's order.\n")
    for i in 0..<#len(ms):
        string8 arg = ""
        for im in ms[i].imports:
            if im.to != rti || im.ns: continue
            for n in im.names:
                if n == "__dados_lines": arg = index.hold(#format("$$lines(", sp0[i] - 1, ", ", sp1[i], ")"))
        out = #append(out, ..#format("const $$g", i, " = $$m", i, "(", arg, "), [$$n", i, ", $$e", i, ", $$v", i, "] = $$g", i, ".next().value;\n"))
    for i in 0..<#len(ms):
        out = #append(out, ..#format("$$e", i, "();\n"))
    for k in ran:
        out = #append(out, ..#format("$$g", k, ".next();"))
        for i in 0..<#len(ms):
            bool lex = false
            for im in ms[i].imports:
                if im.to != k || im.ns: continue
                for n in im.names:
                    i64 e = ex_at(&ms[k], n)
                    if e >= 0 && ms[k].ex_kinds[e] == BK_LEX: lex = true
            if lex: out = #append(out, ..#format(" $$v", i, "(", k, ");"))
        out = #append(out, '\n')
    out = #append(out, ..#format("$$tables.length === 0 || $$merged($$n", rti, ".__dados_lines);\n"))
    for n in ["__dados_bind", "__dados_attach", "__dados_vm", "__dados_hold", "__dados_counts"]:
        out = #append(out, ..#format("export const ", n, " = $$n", wbi, ".", n, ";\n"))
    out = #append(out, ..#format("export const __dados_stop = $$n", sti, ";\n"))
    for i in 0..<#len(entries):
        i64 t = target_of(entries[i], wrapped[:], kept[:])
        if t == -1000000:
            why^ = index.hold(#format("the registry lists `", entries[i], "`, which is not written"))
            return ""
        if t >= 0: out = #append(out, ..#format("const m", i, " = $$n", t, ";\n"))
        else: out = #append(out, ..#format("const m", i, " = $$x", 0 - t - 1, ";\n"))
    out = #append(out, ..tail)
    return index.hold(out)
