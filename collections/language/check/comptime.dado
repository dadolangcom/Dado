// `when`: its condition is checked like any expression into a scratch body
// and decided by the one const evaluator (`decl.dado` runs the IR).
package check

import "core:strings"
import "language:diag"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"

// Whether condition `n` of file `f` holds; ERR0001 when it does not fold.
bool holds(^World w, u32 f, u32 base, u32 n):
    Body b
    b.decl = NONE
    b.file = f
    b.base = base
    b.ret = NONE
    b.pack = NONE
    b.pack_name = NONE
    b.grown = NONE
    b.f.item = n
    b.f.file = f
    b.flat = true
    b.when_fold = true
    i64 errs = #len(w.d.list)
    if when_fails(w, &b, n):
        b.f.free()
        return false
    Val v = expr(w, &b, n, u32(types.P_BOOL))
    if v.ty != NONE && !(v.kind == V_VAL && w.t.resolve(v.ty) == u32(types.P_BOOL)):
        wsay(w, &b, n, 702, "a `when` condition is a constant expression of type `bool`; there is no truthiness in Dado", "")
        b.f.free()
        return false
    u32 c = NONE
    if v.ty != NONE: c = folded(w, &b, 0, v.opd)
    if c == NONE && v.ty != NONE: c = str_eq(w, &b, n)
    u32 al = call_named(w, f, n, "#alignof")
    if c == NONE && #len(w.d.list) == errs && al != NONE: err(w, &b, al, 917, "`#alignof` cannot be a `when` condition: an alignment is a number the **C** compiler produces\x1fIt is not a matter of when the compiler gets round to it: Dado owns the layout of the types Dado invents and C owns the layout of the types C invents, so an alignment comes out of the emitted `_Alignof(…)`. That makes `#alignof` available anywhere C accepts a constant expression — an initializer, an argument, a `#make` count — and available nowhere in this compiler, which has finished before `cc` starts. A `when` selects on what the *build* settled", "branch on `#OS`, `#ARCH`, `#TRIPLE` or a `@const`; a question about C's layout is asked in C, over `_Alignof`", "It is not a matter of when the compiler gets round to it: Dado owns the layout of the types Dado invents and C owns the layout of the types C invents, so an alignment comes out of the emitted `_Alignof(…)`. That makes `#alignof` available anywhere C accepts a constant expression — an initializer, an argument, a `#make` count — and available nowhere in this compiler, which has finished before `cc` starts. A `when` selects on what the *build* settled")
    if c == NONE && #len(w.d.list) == errs: err(w, &b, n, 1, "this `when` condition is outside the slice the port builds so far")
    b.f.free()
    return c != NONE && w.k.kind[c] == types.C_BOOL && w.k.a[c] != 0

private const string8 WHEN_REPAIR = "branch on `#OS`, `#ARCH`, `#TRIPLE` or a `@const` instead"

// A `when` refusal, worded for a `#static_assert` when one is folding.
private void wsay(^World w, ^Body b, u32 n, u16 code, string8 msg, string8 help):
    string8 m = msg
    if w.asserting: m = index.hold(#format("in a `#static_assert`, as in a `when`: ", msg))
    err(w, b, n, code, m, help)

// What a `when` condition cannot be folded from (Rust's fold failures), said
// before it is checked; true when said.
private bool when_fails(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    if n == NONE: return false
    u8 g = a.tag[n]
    string8 gen = "a `when` condition is folded before the program is checked, and this is an expression a `when` condition cannot be folded from"
    if g == syntax.E_INT || g == syntax.E_FLOAT || g == syntax.E_STR || g == syntax.E_CHAR || g == syntax.E_FIELD: return false
    if g == syntax.E_UNARY: return when_fails(w, b, a.a[n])
    if g == syntax.E_BINARY: return when_fails(w, b, a.a[n]) || when_fails(w, b, a.b[n])
    if g == syntax.E_NAME:
        string8 s = spell(w, b, n)
        if #len(s) > 1 && s[0] == '#':
            if s[1] >= 'a' && s[1] <= 'z':
                wsay(w, b, n, 917, index.hold(#format("`", s, "` is a `#lower` name, and only a `#UPPER` name is known before the program runs")), WHEN_REPAIR)
                return true
            return false
        if s == "true" || s == "false": return false
        u8 bk = 0
        if bound(w, w.p.sym(b.file, n), &bk) != NONE:
            wsay(w, b, n, 911, index.hold(#format("`", s, "` is a binding of this signature, so it cannot be a `when` condition")), index.hold(#format("branch on a fact the *build* settles — `#OS`, `#ARCH`, a `@const` — and ask about `", s, "` in a header `where`")))
            return true
        for p in 0..<#len(w.p.pkgs):
            u32 d = lookup(w, u32(p), w.p.sym(b.file, n))
            if d != NONE && w.decls[d].kind == K_CONST: return false
        wsay(w, b, n, 906, index.hold(#format("a `when` condition is folded before the program is checked, and this is `", s, "`, which is not a constant this branch may see", "\x1fA `when` condition is folded before any branch is taken")), "name only `#` definitions and package-level constants declared outside every `when`")
        return true
    if g == syntax.E_IS:
        wsay(w, b, n, 906, "a `when` is folded **before types exist**, so `is` has no types to compare\x1fSelection is what decides which declarations exist, and typing needs that answer first. `is` folds in a function body and in a header `where`, which both run after selection", WHEN_REPAIR)
        return true
    if g == syntax.E_HAS:
        wsay(w, b, n, 906, "a `when` is folded **before types exist**, so `has` has no type to ask about", WHEN_REPAIR)
        return true
    if g == syntax.E_CALL:
        []u32 cs = a.list(a.b[n])
        u32 cn = cs[0]
        string8 s = spell(w, b, cn) if a.tag[cn] == syntax.E_NAME else ""
        if #len(s) > 1 && s[0] == '#' && s[1] >= 'a' && s[1] <= 'z':
            if s == "#size" || s == "#alignof":
                string8 fact = "a size" if s == "#size" else "an alignment"
                string8 op = "sizeof" if s == "#size" else "_Alignof"
                wsay(w, b, n, 917, index.hold(#format("`", s, "` cannot be a `when` condition: ", fact, " is a number the **C** compiler produces")), index.hold(#format("branch on `#OS`, `#ARCH`, `#TRIPLE` or a `@const`; a question about C's layout is asked in C, over `", op, "`")))
            else: wsay(w, b, n, 917, index.hold(#format("`", s, "` is a `#lower` name, and only a `#UPPER` name is known before the program runs")), WHEN_REPAIR)
            return true
        if s == "#LEN":
            wsay(w, b, n, 906, "a `when` is folded **before types exist**, so `#LEN` has nothing to answer from", WHEN_REPAIR)
            return true
        if s == "size":
            wsay(w, b, n, 907, "`size` never folds, so it cannot be a `when` condition\x1fIt is not a matter of when the compiler gets round to it: Dado owns the layout of the types Dado invents and C owns the layout of the types C invents, so a size is a number the **C** compiler produces out of the emitted `sizeof(…)`. That makes it available anywhere C accepts a constant expression and available nowhere in this compiler, which has finished before `cc` starts — which is why `#ARCH == #X86_64` is available and `size(rawptr) == 8` is not", WHEN_REPAIR)
            return true
        if types.prim_named(s) != types.PRIMS && #len(cs) == 3:
            u32 x = cs[2]
            if a.tag[x] == syntax.E_ARG: x = NONE if a.main[x] != NONE else a.a[x]
            if x != NONE && (a.tag[x] == syntax.E_INT || a.tag[x] == syntax.E_FLOAT || a.tag[x] == syntax.E_CHAR): return false
        if #len(s) > 1 && s[0] == '#': return false
        wsay(w, b, n, 906, gen, "")
        return true
    if g == syntax.E_COND: return false
    wsay(w, b, n, 906, gen, "")
    return true

// A string side as written: a literal's source between its quotes (the
// multi-line form keeps its `"""`), else its text.
private string8 spelled_str(^World w, ^Body b, u32 n, string8 text):
    syntax.Ast a = tree(w, b)
    if a.tag[n] != syntax.E_STR: return text
    string8 s = spell(w, b, n)
    if strings.starts_with(s, "\"\"\""): return s
    if #len(s) >= 2 && s[0] == '"': return s[1..<#len(s) - 1]
    return s

// ERR0908 (Rust's `unenumerated_os`): a chain branching on `#OS` under a
// supplied triple whose OS is not enumerated, with no arm for `#UNKNOWN_OS`
// and no `#TRIPLE`; once per chain, at its first `#OS` condition.
void unenumerated_os(^World w, u32 f, u32 base, []u32 conds):
    if #len(w.triple) == 0 || w.os != "UNKNOWN_OS": return
    syntax.Ast a = w.p.files[f].a
    u32 at = NONE
    bool handled = false
    for c in conds:
        ref []string8 ns
        hash_names(w, f, c, &ns)
        for x in ns:
            if x == "#OS" && at == NONE: at = c
            if x == "#UNKNOWN_OS" || x == "#TRIPLE": handled = true
    if at == NONE || handled: return
    say(w, f, base, a.lo[at], a.hi[at], 908, index.hold(#format("`--target=", w.triple, "` names an operating system this compiler does not enumerate, so `#OS` is `#UNKNOWN_OS` here")), "give the chain an arm for `#UNKNOWN_OS`, or compare `#TRIPLE`", "This `when` would select on a fallback rather than on an answer. Nothing was said and something was said this compiler does not recognise are different claims, and only the first is silent. `#TRIPLE` is the escape hatch for a platform Dado does not enumerate")

// The `#` names under condition `n`.
private void hash_names(^World w, u32 f, u32 n, ^ref []string8 out):
    syntax.Ast a = w.p.files[f].a
    if n == NONE: return
    if a.tag[n] == syntax.E_NAME:
        string8 s = w.p.spell(f, n)
        if #len(s) > 1 && s[0] == '#': out^ = #append(out^, s)
        return
    ref []u32 ks
    a.kids(n, &ks)
    for k in ks:
        hash_names(w, f, k, out)

// The first call of builtin `nm` under node `n`, or NONE.
private u32 call_named(^World w, u32 f, u32 n, string8 nm):
    syntax.Ast a = w.p.files[f].a
    if n == NONE: return NONE
    if a.tag[n] == syntax.E_CALL && a.tag[a.list(a.b[n])[0]] == syntax.E_NAME && w.p.spell(f, a.list(a.b[n])[0]) == nm: return n
    ref []u32 ks
    a.kids(n, &ks)
    for k in ks:
        u32 x = call_named(w, f, k, nm)
        if x != NONE: return x
    return NONE

// A bare name in a `when` condition: the one package constant of that
// name in the compilation (ERR0903 when there are more).
Val flat_name(^World w, ^Body b, u32 n, u32 sym):
    ref []u32 ds
    for p in 0..<#len(w.p.pkgs):
        u32 d = lookup(w, u32(p), sym)
        if d == NONE || w.decls[d].kind != K_CONST: continue
        i64 at = #len(ds)
        ds = #append(ds, d)
        for at > 0 && bytes_less(name_of(w, w.p.pkgs[w.decls[d].pkg].name), name_of(w, w.p.pkgs[w.decls[ds[at - 1]].pkg].name)):
            ds[at] = ds[at - 1]
            at -= 1
        ds[at] = d
    if #len(ds) == 1: return decl_val(w, b, ds[0], n)
    if #len(ds) == 0: return bad()
    ref []char8 pk
    ref []char8 qs
    string8 nm = name_of(w, sym)
    for i in 0..<#len(ds):
        string8 pn = name_of(w, w.p.pkgs[w.decls[ds[i]].pkg].name)
        if i > 0: pk = #append(pk, ..", ")
        if i > 0: qs = #append(qs, ..CONJ)
        pk = #append(pk, ..#format("`", pn, "`"))
        qs = #append(qs, ..#format("`", pn, ".", nm, "`"))
    err(w, b, n, 903, index.hold(#format("`", nm, "` is declared by more than one package in this compilation (", pk, "), and this condition names it with no package")), index.hold(#format("name the one you mean: ", qs, ", spelled with the binding this file's own `import` line gives that package")), "A bare name in a `when` condition is looked up in one flat table over every package at once. One name, two answers, so the comparison is refused rather than settled by the order the `import` lines are written in, which is what used to decide it. Reordering two imports would have compiled a different program, and the arm that was not taken is never checked, so nothing else would have said so")
    return Val(V_LIT, NONE, NONE, NONE, 0, 0)

private const string8 CONJ = " or "

// `when` in a body: the arm whose condition holds, else the `else`.
void when_stmt(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    if b.ds:
        u32 arm = s_when_arm(w, b.file, n)
        if arm != NONE: block(w, b, a.b[arm] if a.tag[arm] == syntax.S_WHEN_ARM else arm)
        return
    ref []u32 cs
    for x in a.list(a.b[n]):
        if a.tag[x] == syntax.S_WHEN_ARM: cs = #append(cs, a.a[x])
    unenumerated_os(w, b.file, b.base, cs[:])
    for x in a.list(a.b[n]):
        if a.tag[x] != syntax.S_WHEN_ARM:
            block(w, b, x)
            return
        if holds(w, b.file, b.base, a.a[x]):
            block(w, b, a.b[x])
            return

// `#OS` and the other queries, `#LINUX` and the other members: constants of
// the query's builtin type.
Val platform(^World w, string8 s):
    if s == "#TRIPLE": return value(ir.konst(w.k.str(&w.t, w.triple)), types.STRING8)
    if s == "#DADO_VERSION": return value(ir.konst(w.k.str(&w.t, DADO_VERSION)), types.STRING8)
    for i in 0..<#len(QUERIES):
        if QUERIES[i] != s || i > 2: continue
        string8 want = w.os if i == 0 else (w.arch if i == 1 else w.endian)
        for m in MEMBERS:
            if m.query == u8(i) && m.name[1..<#len(m.name)] == want: return value(ir.konst(w.k.small(&w.t, i64(m.value))), query_type(w, u8(i)))
    for m in MEMBERS:
        if m.name == s: return value(ir.konst(w.k.small(&w.t, i64(m.value))), query_type(w, m.query))
    return bad()

u32 query_type(^World w, u8 q):
    string8 t = "#.ORDERING"
    if q == Q_OS: t = "#.OS"
    if q == Q_ARCH: t = "#.ARCH"
    if q == Q_ENDIAN: t = "#.ENDIAN"
    return w.t.distinct_of(t, u32(types.P_I32))

// Package-level `#static_assert(COND, "message")`: folded as a `when`
// condition; ERR0930 with the message when it folds to `false`.
void static_asserts(^World w):
    for x in w.sasserts:
        u32 f = u32(x >> 32)
        u32 n = u32(x & 0xFFFFFFFF)
        syntax.Ast a = w.p.files[f].a
        u32 mn = a.b[n]
        i64 errs = #len(w.d.list)
        w.asserting = true
        bool h = holds(w, f, 0, a.a[n])
        w.asserting = false
        bool folded = #len(w.d.list) == errs
        string8 msg = ""
        bool mok = false
        if mn != NONE && a.tag[mn] == syntax.E_STR:
            ref []char8 s
            syntax.string_value(w.p.spell(f, mn), &s)
            msg = index.hold(s)
            mok = true
        if !mok:
            u32 at = mn if mn != NONE else n
            say(w, f, 0, a.lo[at], a.hi[at], 504, "a `#static_assert`'s message is a string the build is refused with — a literal, or a string constant a `when` condition could name — `#static_assert(COND, \"what must hold\")`", "")
        if !folded || h || !mok: continue
        string8 repair = "change the declaration so the condition holds, or the assertion if it is the one that is wrong"
        if names_target(w, f, a.a[n]) && !names_const(w, f, a.a[n]): repair = TARGET_REPAIR
        say(w, f, 0, a.lo[n], a.hi[n], 930, index.hold(#format(msg, " — this `#static_assert` folds to `false`")), repair)

const string8 TARGET_REPAIR = "build for a target the assertion accepts, or change the assertion if it is the one that is wrong"

// A package refusing the build with its own `#static_assert` (ERR0930) says
// only that: below the root package any failed assertion, at the root one
// whose repair is the target's. Its other diagnostics follow from the target
// it refuses and are dropped (Rust's `refused_packages_said_once`).
void refused_said_once(^World w):
    ^diag.Diags ds = &w.p.diags
    ref []bool refused
    for _ in w.p.pkgs: refused = #append(refused, false)
    bool any = false
    for d in ds.list:
        if d.code != 930 || i64(d.file) >= #len(w.p.files): continue
        u32 p = w.p.files[d.file].pkg
        if p != 0 || ds.run(d.help, d.why) == TARGET_REPAIR:
            refused[p] = true
            any = true
    if any:
        i64 k = 0
        for i in 0..<#len(ds.list):
            diag.Diag d = ds.list[i]
            if d.code == 930 || i64(d.file) >= #len(w.p.files) || !refused[w.p.files[d.file].pkg]:
                ds.list[k] = d
                k += 1
        #truncate(ds.list, k)
    #delete(refused)

private bool names_target(^World w, u32 f, u32 n):
    if n == NONE: return false
    syntax.Ast a = w.p.files[f].a
    if a.tag[n] == syntax.E_NAME:
        string8 s = w.p.spell(f, n)
        return s == "#OS" || s == "#ARCH" || s == "#ENDIAN"
    ref []u32 ks
    a.kids(n, &ks)
    for k in ks:
        if names_target(w, f, k): return true
    return false

private bool names_const(^World w, u32 f, u32 n):
    if n == NONE: return false
    syntax.Ast a = w.p.files[f].a
    if a.tag[n] == syntax.E_NAME && w.p.spell(f, n)[0] != '#':
        for p in 0..<#len(w.p.pkgs):
            u32 d = lookup(w, u32(p), w.p.sym(f, n))
            if d != NONE && w.decls[d].kind == K_CONST: return true
        return false
    ref []u32 ks
    a.kids(n, &ks)
    for k in ks:
        if names_const(w, f, k): return true
    return false

// `ROLE == "standalone"`: two folded strings compared (fold_string_eq).
private u32 str_eq(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    string8 op = spell(w, b, n)
    if a.tag[n] != syntax.E_BINARY || op != "==" && op != "!=": return NONE
    u32 at = ir.count(&b.f)
    Val l = expr(w, b, a.a[n], NONE)
    u32 cl = folded(w, b, at, l.opd) if l.ty != NONE else NONE
    at = ir.count(&b.f)
    Val r = expr(w, b, a.b[n], NONE)
    u32 cr = folded(w, b, at, r.opd) if r.ty != NONE else NONE
    if cl == NONE || cr == NONE || w.k.kind[cl] != types.C_STR || w.k.kind[cr] != types.C_STR: return NONE
    // Rust compares spellings: equal is equal; an escape or the multi-line
    // form on either side is refused, not decoded a second time.
    string8 sa = spelled_str(w, b, a.a[n], w.t.text(w.k.a[cl]))
    string8 sb = spelled_str(w, b, a.b[n], w.t.text(w.k.a[cr]))
    bool same = sa == sb
    if !same && (strings.index_of(sa, '\\') >= 0 || strings.index_of(sb, '\\') >= 0 || strings.starts_with(sa, "\"\"\"") || strings.starts_with(sb, "\"\"\"")):
        wsay(w, b, n, 906, "a `when` condition is folded before the program is checked, and this is two string literals spelled differently, which a `when` condition does not compare as text", "spell both sides the same way")
        return NONE
    return w.k.boolean(&w.t, same if op == "==" else !same)
