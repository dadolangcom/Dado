// ERR1029 against the C names this lowering emits: a
// `foreign` name that is the C name of a shape the program holds, of one of
// the runtime's own types, or of a Dado function.
package check

import "core:strings"
import "language:diag"
import "language:index"
import "language:syntax"
import "language:types"

// The C name the lowering gives shape `r` (a tuple, array, union, function
// type, map or channel); `dado_soa…` for a `#soa`.
string8 shape_c_name(^types.Types t, u32 r):
    types.Hash h = t.hash(r)
    if t.tag[r] == types.T_SOA: return index.hold(#format("dado_soa", h.lo % 1000000007, "_", h.hi % 1000003))
    return index.hold(#format("dado_t", h.lo % 1000000007, "_", h.hi % 1000003))

// Typedefs every program's `dado.h` declares, and what the first six are.
private const [14]string8 RT_NAMES = ["dado_string", "dado_string16", "dado_string32", "dado_view", "dado_ref", "dado_trait", "dado_alloc", "dado_widest", "dado_stale", "dado_fmtbuf", "dado_jtake", "dado_jwide", "dado_nw", "dado_rt__narrowing"]
private const [6]string8 RT_SHOWN = ["`string8`", "`string16`", "`string32`", "`[]T`", "`ref []T`", "a trait value"]

// What runtime name `n` is: its shape, "-" for an internal one, "" for none.
private string8 rt_type(string8 n):
    for k in 0..<14:
        if RT_NAMES[k] != n: continue
        if k < 6: return RT_SHOWN[k]
        return "-"
    return ""

void foreign_mangled(^World w):
    w.d.phase = diag.PH_FACTS
    string8 why = "\x1fThe emitted C would have to reach both by that one name, and emitting either would be a program that compiles and is wrong"
    // Held shapes by name, computed only when a claim could meet one.
    {string8: u32} held
    bool hashed = false
    for d in 0..<#len(w.decls):
        u8 k = w.decls[d].kind
        if k != K_FTYPE && k != K_FSTRUCT && k != K_FFN: continue
        string8 cn = w.t.text(c_name(w, u32(d)))
        if !strings.starts_with(cn, "dado_"): continue
        u32 f = w.decls[d].file
        u32 n = w.decls[d].node
        string8 sp = name_of(w, w.decls[d].name)
        if k == K_FFN:
            syntax.Ast a = w.p.files[f].a
            u32 at = n
            if a.tag[n] == syntax.N_F_FN && a.list(a.b[n])[2] != NONE: at = a.list(a.b[n])[2]
            fn_mangled(w, u32(d), f, at, sp, cn)
            continue
        string8 shape = rt_type(cn)
        bool always = #len(shape) > 0
        if shape == "-":
            say_tok(w, f, 0, n, 1029, index.hold(#format("`", sp, "` declares the C type `", cn, "`, which this compiler's runtime declares in every program", why, "\x1egive the C type a name the runtime does not use")), "")
            continue
        if #len(shape) == 0:
            if !hashed:
                hashed = true
                for r in 0..<u32(w.t.count()):
                    u8 g = w.t.tag[r]
                    if g != types.T_TUPLE && g != types.T_UNION && g != types.T_FUNC && g != types.T_MAP && g != types.T_CHANNEL && g != types.T_SOA: continue
                    string8 hn = shape_c_name(&w.t, r)
                    if !(hn in held): held[hn] = r
            if !(cn in held): continue
            try u32 r = held[cn] else: continue
            shape = index.hold(#format("`", shown(w, r), "`"))
        string8 held_by = ", which this program also holds"
        if always: held_by = " in every program"
        say_tok(w, f, 0, n, 1029, index.hold(#format("`", sp, "` declares the C type `", cn, "`, which is the name this compiler's mangling gives the shape ", shape, held_by, why, "\x1egive the C type a name the mangling cannot produce")), "")

// A function's C name: one the mangling's form `dado_<package>_<function>`
// can produce (Rust's rule; the form is unchanged), or one a body of this
// program is emitted under (a method's `dado_<p>_<T>_<m>`, an instance's).
private void fn_mangled(^World w, u32 d, u32 f, u32 at, string8 sp, string8 cn):
    string8 why = "\x1fA program holding both would reach two functions by one C name"
    (string8 pk, string8 fname, bool ok) = unmangle(cn[5..<#len(cn)])
    if ok:
        say_tok(w, f, 0, at, 1029, index.hold(#format("`", sp, "` declares the C function `", cn, "`, which is the name this compiler's mangling gives function `", fname, "` of a package `", pk, "`", why, "\x1egive the C function a name the mangling cannot produce — more than one single `_` after `dado_` (`dado_sys_", pk, "_", fname, "`), or no `dado_` prefix")), "", "a `foreign` type whose C name is the one this compiler's mangling gives a shape the program holds, or a `foreign` function whose C name the function mangling can produce — two different things the emitted C would have to reach by one name (the emitted C reaches what this compiler named by the name this compiler's mangling gives it, so a `foreign` type may not be declared under one of those names while the program holds the shape it belongs to, and a `foreign` function may not be declared under any name the function mangling can produce)")
        return
    for j in w.jobs:
        if j.decl == d || w.decls[j.decl].kind == K_FFN || w.t.text(j.cname) != cn: continue
        say_tok(w, f, 0, at, 1029, index.hold(#format("`", sp, "` declares the C function `", cn, "`, which is the name this compiler gives `", name_of(w, w.decls[j.decl].name), "`, a function this program also holds", why, "\x1egive the C function a name this compiler does not emit, or no `dado_` prefix")), "")
        return

// `rest` (after `dado_`) as package and function: exactly one odd run of
// `_` joins them, `__` is an escaped `_`, and both are identifiers.
private (string8, string8, bool) unmangle(string8 rest):
    i64 js = -1
    i64 je = -1
    i64 i = 0
    for i < #len(rest):
        if rest[i] != '_':
            i += 1
            continue
        i64 s = i
        for i < #len(rest) && rest[i] == '_': i += 1
        if (i - s) % 2 == 1:
            if js >= 0: return ("", "", false)
            js = s
            je = i
    if js < 0: return ("", "", false)
    i64 pairs = (je - js) / 2
    for j in 0..=pairs:
        string8 a = index.hold(strings.repeat("__", j))
        string8 b = index.hold(strings.repeat("__", pairs - j))
        string8 pk = unescape(index.hold(#format(rest[0..<js], a)))
        string8 fu = unescape(index.hold(#format(b, rest[je..<#len(rest)])))
        if ident(pk) && ident(fu): return (pk, fu, true)
    return ("", "", false)

private string8 unescape(string8 s):
    return index.hold(strings.replace(s, "__", "_"))

private bool ident(string8 s):
    if #len(s) == 0: return false
    for i in 0..<#len(s):
        char8 c = s[i]
        bool al = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
        if !al && (i == 0 || c < '0' || c > '9'): return false
    return true
