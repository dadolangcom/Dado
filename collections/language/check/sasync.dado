// A script's async: `async T`, an `async`
// method or lambda, and the `await` statement that unwraps one (`B_SAWAIT`).
package check

import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:strings"

const u8 B_SAWAIT = 162    // dst = await args[0]

// `async T`.
u32 sa_type(^World w, u32 inner):
    if inner == NONE: return NONE
    try u32 t = w.sasync_ty[inner] else:
        u32 nt = w.t.builtin(index.hold(#format("async ", s_written(w, inner))))
        w.sasync_ty[inner] = nt
        w.sasync_in[nt] = inner
        return nt
    return t

// What `async T` answers, or NONE when `t` is none.
u32 sa_inner(^World w, u32 t):
    if t == NONE: return NONE
    try u32 i = w.sasync_in[t] else: return NONE
    return i

// The `async T` `ty` holds (itself, or in an element, a map or a slot), or NONE.
u32 sa_held(^World w, u32 ty, i64 depth = 0):
    if ty == NONE || depth > 32: return NONE
    if sa_inner(w, ty) != NONE: return ty
    u8 k = s_kind(w, ty)
    u32 r = w.t.resolve(ty)
    if k == 1: return sa_held(w, w.t.a[r], depth + 1)
    if k == 2:
        u32 x = sa_held(w, w.t.a[r], depth + 1)
        if x != NONE: return x
        return sa_held(w, w.t.b[r], depth + 1)
    if s_tup(w, ty):
        for s in w.t.slots(ty):
            u32 x = sa_held(w, s, depth + 1)
            if x != NONE: return x
    return NONE

// ERR1330 for an `async` `init` or generic method (`m` its node in file `f`).
bool sa_refused(^World w, u32 f, u32 m, bool generic):
    syntax.Ast a = w.p.files[f].a
    if (a.a[m] & syntax.F_ASYNC) == 0: return false
    string8 nm = w.p.spell(f, m)
    u32 k = sa_kw(w, f, m)
    if nm == "init": say(w, f, 0, k, k + 5, 1330, "`init` runs as an instance is made, and the call that makes one answers the instance, so nothing could wait for an `async` `init`", "drop `async`, and move the waiting into an `async` method the caller awaits after construction: `async void start():`")
    else if generic: say(w, f, 0, k, k + 5, 1330, index.hold(#format("`", nm, "` is generic, and a generic method is not `async` yet")), "drop `async`, or write the method for the types it takes")
    else: return false
    return true

// The value an awaited statement `s` waits on, or NONE.
private u32 sa_value(^World w, ^Body b, u32 s):
    syntax.Ast a = tree(w, b)
    u8 g = a.tag[s]
    if g == syntax.S_LET: return a.list(a.b[s])[1]
    if g == syntax.S_ASSIGN && spell(w, b, s) == "=": return a.list(a.b[s])[1]
    if g == syntax.S_EXPR: return a.a[s]
    return NONE

// `await <stmt>`.
void sa_await(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    u32 s = a.a[n]
    u32 v = sa_value(w, b, s)
    if v == NONE:
        if a.tag[s] == syntax.S_LET:
            string8 ty = src(w, b, a.list(a.b[s])[0])
            string8 nm = "x"
            if a.main[s] != NONE: nm = index.hold(strings.clone(spell(w, b, s)))
            err(w, b, s, 1330, index.hold(#format("`await` waits for a value, and `", ty, " ", nm, "` is declared with none")), index.hold(#format("write the call it waits on: `await ", ty, " ", nm, " = load()`")))
            return
        string8 inner = src(w, b, s)
        err(w, b, s, 1330, index.hold(#format("`await` heads a declaration with its value, an assignment with `=` or a call, as `try` does, and `", inner, "` is none of them")), "await the value on a line of its own — `await int x = load()` — and use the name it binds")
        return
    if !b.sinside:
        string8 what = "this lambda is not `async`"
        string8 rep = index.hold(#format("mark the lambda `async` — `async ", shown(w, b.ret), "(…): …` — and await what calling it answers"))
        if b.slambda == 0:
            string8 nm = name_of(w, w.decls[b.decl].name)
            what = index.hold(#format("`", nm, "` is not `async`"))
            rep = index.hold(#format("mark it `async` — `async ", shown(w, b.ret), " ", nm, "(…):` — and its callers then `await` it in turn"))
        say(w, b.file, b.base, a.lo[n], a.lo[n] + 5, 1330, index.hold(#format("`await` waits only inside an `async` method or lambda, and ", what, ": a method that waits returns its value later, so it is waited for too")), rep)
    u64 outer = w.sawaiting
    w.sawaiting = (u64(b.file) << 32) | u64(v)
    stmt(w, b, s)
    w.sawaiting = outer

// The awaited value `n` (its expected type `want`): its `T`.
Val sa_awaited(^World w, ^Body b, u32 n, u32 want):
    w.sawaiting = u64(NONE)
    u32 wa = NONE
    if want != NONE: wa = sa_type(w, want)
    Val v = finish(w, b, expr(w, b, n, wa), n)
    if v.ty == NONE: return v
    u32 inner = sa_inner(w, v.ty)
    if inner == NONE:
        err(w, b, n, 1330, index.hold(#format("`await` waits for what an `async` method answers, and `", src(w, b, n), "` is ", shown(w, v.ty), ", which is already there")), "drop `await` and use the value as it is")
        return v
    u32 t = temp(w, b, inner, n)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SAWAIT, inner, n, t, NONE)
    ir.arg(&b.f, spill(w, b, v, n))
    return value(t, inner)

// `return x` where `x` is the `async T` of the method's `T`: ERR1330.
bool sa_returned(^World w, ^Body b, u32 vn, Val v):
    u32 inner = sa_inner(w, v.ty)
    if inner == NONE || b.ret == NONE || inner != b.ret: return false
    string8 x = src(w, b, vn)
    string8 sh = shown(w, b.ret)
    string8 rep = index.hold(#format("await it first — `await ", sh, " v = ", x, "` — and return `v`"))
    if !b.sinside: rep = index.hold(#format("a method that waits is `async` too: mark it — `async ", sh, " ", name_of(w, w.decls[b.decl].name), "(…):` — then `await ", sh, " v = ", x, "` and return `v`"))
    err(w, b, vn, 1330, index.hold(#format("`return` answers the method's ", sh, ", and `", x, "` is ", shown(w, v.ty), ", which nothing has waited for")), rep)
    return true

// A call answering `async T` alone on a line: ERR1330.
void sa_discarded(^World w, ^Body b, u32 s, u32 e, u32 ty):
    if sa_inner(w, ty) == NONE: return
    string8 call = src(w, b, e)
    string8 sh = shown(w, ty)
    err(w, b, s, 1330, index.hold(#format("`", call, "` answers `", sh, "`, and alone on a line nothing waits for it: what it does may not have happened when the next line runs, and a failure inside it reaches no one")), index.hold(#format("wait for it — `await ", call, "` — or hold what it answers and await that later: `", sh, " pending = ", call, "`")))

// `defer await …`: ERR1330.
bool sa_deferred(^World w, ^Body b, u32 s):
    syntax.Ast a = tree(w, b)
    bool aw = a.tag[s] == syntax.S_AWAIT || a.tag[s] == syntax.S_TRY && a.tag[a.a[s]] == syntax.S_AWAIT
    if !aw: return false
    string8 inner = src(w, b, s)
    err(w, b, s, 1330, "a deferred statement runs as its scope leaves, on the way out, and a scope's exit does not wait", index.hold(#format("await before the scope ends instead: write `", inner, "` as the scope's last line, and on each path that leaves it early")))
    return true

// An operator over `async T`: ERR0607; false when refused.
bool sa_operator(^World w, ^Body b, u32 n, string8 op, u32 lt, u32 rt):
    u32 side = NONE
    if sa_inner(w, lt) != NONE: side = lt
    else if sa_inner(w, rt) != NONE: side = rt
    if side == NONE: return true
    err(w, b, n, 607, index.hold(#format("`", op, "` is not defined for ", shown(w, side), ": it is a value to wait for, not one that is there yet")), index.hold(#format("await it first — `await ", shown(w, sa_inner(w, side)), " v = …` — and use `v`")))
    return false

// `print` of a value holding `async T`: ERR1330; false when refused.
bool sa_printed(^World w, ^Body b, u32 g, u32 ty, string8 verb):
    u32 h = sa_held(w, ty)
    if h == NONE: return true
    string8 what = ""
    if h != ty: what = index.hold(#format(", which holds an `", shown(w, h), "`"))
    err(w, b, g, 1330, index.hold(#format("`", verb, "` writes a value that is there, and this is `", shown(w, ty), "`", what, ": a value to wait for, not one that is there yet")), index.hold(#format("await it first — `await ", shown(w, sa_inner(w, h)), " v = …` — and write `v`")))
    return false

// Where the `async` heading method node `m` of file `f` begins.
u32 sa_kw(^World w, u32 f, u32 m):
    u32 lo = w.p.files[f].a.lo[m]
    string8 s = w.p.files[f].src
    if i64(lo) >= 5 && s[i64(lo) - 5..<i64(lo)] == "async": return lo - 5
    u32 at = lo
    for at > 0 && (s[i64(at) - 1] == ' ' || s[i64(at) - 1] == '\t'):
        at -= 1
    if i64(at) >= 5 && s[i64(at) - 5..<i64(at)] == "async": return at - 5
    return lo

// A trait method `async Self m(…)`: not built.
bool st_async_self(^World w, u32 m):
    u32 f = w.decls[m].file
    syntax.Ast a = w.p.files[f].a
    u32 mn = w.decls[m].node
    u32 rn = a.list(a.b[mn])[0]
    return (a.a[mn] & syntax.F_ASYNC) != 0 && rn != NONE && a.tag[rn] == syntax.T_NAME && w.p.spell(f, rn) == "Self"
