// A script's failure forms: `Error(…)`,
// `Location()`, a parameter's default filled at the call (`Location()`
// there is the call's own place).
package check

import "language:diag"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"

const u8 B_SERR = 159    // dst = new Error(message, code, location)

// `pkg.Class.method` of the body being checked, "" outside a method.
string8 sf_fname(^World w, ^Body b):
    if b.cls == NONE || w.decls[b.decl].kind != K_METHOD: return ""
    return s_mpath(w, b.decl)

// Method `m` as Rust names it: `pkg.Class.m`, or `pkg.Class.Trait.m` for a
// trait's (the package and class the trait is written in).
string8 s_mpath(^World w, u32 m):
    u32 wc = w.decls[m].block
    string8 pk = name_of(w, w.p.pkgs[w.decls[wc].pkg].name)
    string8 mn = name_of(w, w.decls[m].name)
    u32 st = st_of_decl(w, wc)
    if st == NONE: return index.hold(#format(pk, ".", name_of(w, w.decls[wc].name), ".", mn))
    return index.hold(#format(pk, ".", name_of(w, w.decls[w.classes[w.straits[st].cls].decl].name), ".", name_of(w, w.decls[wc].name), ".", mn))

// `Location()`: where `n` is.
Val sf_here(^World w, ^Body b, u32 n):
    return s_located(w, b, n, b.file, tree(w, b).lo[n], sf_fname(w, b))

// `Error(message)`, `Error(message, code)`, `Error(message, code, at)`.
Val sf_error(^World w, ^Body b, u32 n):
    []u32 args = call_args(w, b, n)
    if #len(args) == 0 || #len(args) > 3:
        err(w, b, n, 601, index.hold(#format("`Error` takes a message, then optionally a code and a `Location`, and this call passes ", #len(args))), "write `Error(\"what went wrong\")`, `Error(\"what went wrong\", 16)` or `Error(\"what went wrong\", 16, Location())`")
        for g in args:
            _ = expr(w, b, arg_value(w, b, g), NONE)
        return bad()
    [3]u32 wants = [w.sstr, u32(types.P_INT), w.sloc]
    [3]string8 whats = ["a message, a `string`", "a code, an `int`", "where it happened, a `Location`"]
    ref []u32 opds
    bool ok = true
    for i in 0..<#len(args):
        u32 vn = arg_value(w, b, args[i])
        Val v = expr(w, b, vn, wants[i])
        if v.kind == V_LIT && i == 1: v = coerce(w, b, v, wants[i], vn)
        else: v = finish(w, b, v, vn)
        if v.ty == NONE:
            ok = false
            continue
        if v.ty != wants[i]:
            string8 h = s_conv_help(w, b, wants[i], v.ty, vn)
            if #len(h) == 0 && i == 2: h = "write `Location()` for here, or `Location(m)` for where the method `m` begins"
            err(w, b, vn, 504, index.hold(#format("`Error`'s argument ", i + 1, " is ", whats[i], ", and this is ", shown(w, v.ty))), h)
            ok = false
            continue
        opds = #append(opds, v.opd)
    if !ok: return bad()
    if #len(opds) < 2: opds = #append(opds, ir.konst(w.k.small(&w.t, 70)))
    if #len(opds) < 3: opds = #append(opds, sf_here(w, b, n).opd)
    u32 t = temp(w, b, w.serror, n)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SERR, w.serror, n, t, NONE)
    for o in opds:
        ir.arg(&b.f, o)
    return value(t, w.serror)

// Whether default `x` of file `f` is `Location()`.
bool sf_here_default(^World w, u32 f, u32 x):
    syntax.Ast a = w.p.files[f].a
    if x == NONE || a.tag[x] != syntax.E_CALL: return false
    []u32 ks = a.list(a.b[x])
    return #len(ks) == 2 && a.tag[ks[0]] == syntax.E_NAME && w.p.spell(f, ks[0]) == "Location"

// Parameter `q`'s default (file `mf`) at call `n`, as `pt`.
Val sf_default(^World w, ^Body b, u32 n, u32 mf, u32 q, u32 pt):
    syntax.Ast ma = w.p.files[mf].a
    if sf_here_default(w, mf, ma.b[q]): return sf_here(w, b, n)
    u32 bf = b.file
    u32 bb = b.base
    b.file = mf
    b.base = 0
    Val v = coerce(w, b, expr(w, b, ma.b[q], pt), pt, ma.b[q])
    b.file = bf
    b.base = bb
    return v

// A method's `Location()` default whose parameter is no `Location`: ERR0504.
void sf_defaults(^World w, ^Body b):
    syntax.Ast a = tree(w, b)
    []u32 ps = params(w, b.decl)
    u32 ft = resolve(w, b.decl)
    if ft == NONE: return
    ref []u32 pts = s_mparams(w, ft)
    for i in 0..<#len(ps):
        u32 q = ps[i]
        if q == NONE || i >= #len(pts) || !sf_here_default(w, b.file, a.b[q]) || pts[i] == w.sloc: continue
        err(w, b, a.b[q], 504, index.hold(#format("`Location()` is a `Location`, and `", w.p.spell(b.file, q), "` is ", shown(w, pts[i]))), index.hold(#format("declare it `Location ", w.p.spell(b.file, q), "`")))

const u8 B_SASSERT = 160    // if !args[0]: throw assert(args[2] or null, args[1])

// A failure's literal code: nonzero and an `i32` (ERR0715, ERR0539).
bool sf_code_fits(^World w, ^Body b, Val v, u32 n):
    if v.kind != V_LIT: return true
    if v.lo == 0 && v.hi == 0:
        err(w, b, n, 715, "a failure's code is never 0, because 0 is what success answers: a host reading this failure's code would read a success", "give the failure a nonzero code — `fail 1` — or leave the code to its default, 70: `fail \"what went wrong\"`; 70 is what a failure with no code of its own has")
        return false
    bool neg = v.hi != 0
    if !neg && v.lo <= 2147483647 || neg && i64(v.lo) >= -2147483648: return true
    string8 shown_ = index.hold(#format(v.lo))
    if neg: shown_ = index.hold(#format(i64(v.lo)))
    err(w, b, n, 539, index.hold(#format("a failure's code is an `i32`, as Dado's is, so a host can be handed it, and ", shown_, " is past -2147483648..=2147483647")), "pick a code inside the `i32` range, and put the number itself in the message")
    return false

// `fail x` in a script: sub 0 a code, 2 a message, 3 an `Error`.
void sf_fail(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    u32 x = a.a[n]
    Val sv = expr(w, b, x, NONE)
    if sv.ty == NONE: return
    if sv.kind == V_LIT:
        if !sf_code_fits(w, b, sv, x): return
        sv = coerce(w, b, sv, u32(types.P_INT), x)
    else: sv = finish(w, b, sv, x)
    if sv.ty == NONE: return
    u8 k = 0
    u32 r = w.t.resolve(sv.ty)
    if r == w.sstr: k = 2
    else if r == w.serror: k = 3
    else if r != u32(types.P_INT):
        string8 h = "write the message, `fail \"what went wrong\"`, the code, `fail 16`, or an `Error`, `fail Error(\"what went wrong\", 16)`"
        if is_float(w, r) || r == u32(types.P_BOOL): h = index.hold(#format("a code is an `int` and a message a `string`: write `fail string(", src(w, b, x), ")` to say it, or `fail Error(\"…\", n)` to give the failure a code"))
        err(w, b, x, 504, index.hold(#format("`fail` raises a message (a `string`), a code (an `int`) or an `Error`, and this is ", shown(w, sv.ty))), h)
        return
    _ = ir.op(&b.f, ir.O_RETURN_FAIL, k, NONE, n, NONE, sv.opd)

// `assert cond` / `assert cond, message`.
void sf_assert(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    u32 c = cond(w, b, a.a[n], "an assertion's condition")
    u32 m = NONE
    if a.b[n] != NONE:
        Val mv = finish(w, b, expr(w, b, a.b[n], w.sstr), a.b[n])
        if mv.ty != NONE && mv.ty != w.sstr:
            string8 h = ""
            if is_num(w, mv.ty) || mv.ty == u32(types.P_BOOL): h = index.hold(#format("make it one: `string(", src(w, b, a.b[n]), ")`"))
            err(w, b, a.b[n], 504, index.hold(#format("an assertion's message is a `string`, which a failed one raises as `assertion failed: …`, and this is ", shown(w, mv.ty))), h)
            return
        if mv.ty == NONE: return
        m = mv.opd
    if c == NONE: return
    Val at = sf_here(w, b, n)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SASSERT, u32(types.P_VOID), n, NONE, NONE)
    ir.arg(&b.f, c)
    ir.arg(&b.f, at.opd)
    if m != NONE: ir.arg(&b.f, m)

// Whether `try` statement `s` tries a call or an index.
bool sf_tried(^World w, ^Body b, u32 s):
    syntax.Ast a = tree(w, b)
    u32 v = NONE
    u8 g = a.tag[s]
    if g == syntax.S_LET: v = a.list(a.b[s])[1]
    else if g == syntax.S_ASSIGN && spell(w, b, s) == "=": v = a.list(a.b[s])[1]
    else if g == syntax.S_EXPR: v = a.a[s]
    else if g == syntax.S_AWAIT: return true
    return v != NONE && (a.tag[v] == syntax.E_CALL || a.tag[v] == syntax.E_INDEX)

// ERR0716 for a `try` over statement `s` with nothing that can fail.
void sf_untried(^World w, ^Body b, u32 s):
    syntax.Ast a = tree(w, b)
    u32 v = NONE
    u8 g = a.tag[s]
    if g == syntax.S_LET: v = a.list(a.b[s])[1]
    else if g == syntax.S_ASSIGN && spell(w, b, s) == "=": v = a.list(a.b[s])[1]
    else if g == syntax.S_EXPR: v = a.a[s]
    string8 what = "this statement"
    if v != NONE: what = index.hold(#format("`", src(w, b, v), "`"))
    err(w, b, v if v != NONE else s, 716, index.hold(#format("`try` handles the failure of one call or one index, and ", what, " is neither: nothing in it is a call that can fail")), "write the statement without `try`; to handle a failure of the work it does, put that work in a method and try its call — `try int n = parse(text) else e:`")

// Whether an `any` leaves through a check in the ops from `from` on (a `try` can catch it).
bool sf_left(^World w, ^Body b, i64 from):
    for i in u32(from)..<ir.count(&b.f):
        if b.f.op[i] == ir.O_INTRINSIC && b.f.sub[i] == B_SANY && b.f.b[i] == 5: return true
    return false

// `Location(m)` and `Location(m, k)`: where method `m` begins, or `k` lines into it.
Val sf_location(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    []u32 args = call_args(w, b, n)
    if #len(args) > 2:
        err(w, b, n, 601, index.hold(#format("`Location` takes nothing, a method, or a method and a line count, and this call passes ", #len(args))), "write `Location()` for here, `Location(m)` for where the method `m` begins, or `Location(m, 2)` for two lines into it")
        for g in args:
            _ = expr(w, b, arg_value(w, b, g), NONE)
        return bad()
    u32 fx = arg_value(w, b, args[0])
    if a.tag[fx] != syntax.E_NAME:
        string8 x = src(w, b, fx)
        err(w, b, fx, 405, index.hold(#format("`Location(f)` names a method of the class by its name, and `", x, "` is no name")), "write the method's name, `Location(hit)`")
        return bad()
    u32 m = s_method_of(w, b, w.p.sym(b.file, fx))
    string8 cn = name_of(w, w.decls[w.classes[b.cls].decl].name)
    if m == NONE:
        ref []string8 pool
        u32 at = b.cls
        for _ in 0..<64:
            if at == NONE: break
            for x in w.classes[at].methods:
                pool = #append(pool, name_of(w, w.decls[x].name))
            at = s_parent(w, at)
        string8 s = spell(w, b, fx)
        string8 h = nearest(s, pool[:])
        if #len(h) > 0: h = index.hold(#format("did you mean `", h, "`?"))
        else: h = index.hold(#format("name a method `", cn, "` declares, or write `Location()` for the place it is written"))
        err(w, b, fx, 405, index.hold(#format("`", s, "` is not a method of `", cn, "`, and `Location(f)` names one: where it begins is known when the script is compiled")), h)
        return bad()
    u32 mf = w.decls[m].file
    syntax.Ast ma = w.p.files[mf].a
    u32 md = w.decls[m].node
    string8 mn = name_of(w, w.decls[m].name)
    string8 fname = s_mpath(w, m)
    if #len(args) == 1: return s_located(w, b, n, mf, ma.lo[md], fname)
    u32 kx = arg_value(w, b, args[1])
    Val kv = expr(w, b, kx, NONE)
    if kv.ty == NONE: return bad()
    diag.Place p0 = w.p.map.place(w.p.map.base[mf] + ma.lo[md])
    u32 end = ma.hi[md]
    for end > ma.lo[md] && (w.p.files[mf].src[i64(end - 1)] == '\n' || w.p.files[mf].src[i64(end - 1)] == ' ' || w.p.files[mf].src[i64(end - 1)] == '\r'):
        end -= 1
    diag.Place p1 = w.p.map.place(w.p.map.base[mf] + end - 1)
    i64 lines = i64(p1.line) - i64(p0.line)
    if kv.kind != V_LIT:
        err(w, b, kx, 504, "`Location(f, n)` counts `n` lines into the method's body, a whole number", index.hold(#format("write a count from 0 to ", lines)))
        return bad()
    i64 k = i64(kv.lo)
    if kv.hi != 0 || k > lines:
        string8 ks = index.hold(#format(k))
        if kv.hi != 0: ks = index.hold(#format(i64(kv.lo)))
        err(w, b, kx, 539, index.hold(#format("`", mn, "` runs from line ", p0.line, " to line ", p1.line, ", so `Location(", mn, ", n)` counts 0 to ", lines, " lines into it, and ", ks, " is outside that")), index.hold(#format("write a count from 0 to ", lines, "; `Location(", mn, ")` is where the method begins")))
        return bad()
    // The first column on that line that is not a space.
    u32 off = ma.lo[md]
    i64 down = k
    for down > 0 && off < u32(#len(w.p.files[mf].src)):
        if w.p.files[mf].src[i64(off)] == '\n': down -= 1
        off += 1
    if k > 0:
        for off < u32(#len(w.p.files[mf].src)) && (w.p.files[mf].src[i64(off)] == ' ' || w.p.files[mf].src[i64(off)] == '\t'):
            off += 1
    return s_located(w, b, n, mf, off, fname)

// `Script.load(path, ..args)`, checked; a valid one is not built (ERR0001).
Val sf_load(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    []u32 args = call_args(w, b, n)
    if #len(args) == 0:
        err(w, b, n, 601, "`Script.load` loads a script by its path, and this names none", "write the path without `.js` — `Script.load(\"mods/goblin\")` — and after it what the mod's init method takes")
        return bad()
    if a.tag[args[0]] == syntax.E_ARG && a.main[args[0]] != NONE:
        err_tok(w, b, args[0], 601, "`Script.load` takes its path and the mod's init arguments in order, none by name", "write `Script.load(\"mods/goblin\", …)`")
        return bad()
    u32 pn = arg_value(w, b, args[0])
    Val pv = finish(w, b, expr(w, b, pn, w.sstr), pn)
    if pv.ty == NONE: return bad()
    if pv.ty != w.sstr:
        err(w, b, pn, 504, index.hold(#format("`Script.load`'s first argument is the path of the script it loads, a `string`, and `", src(w, b, pn), "` is ", shown(w, pv.ty))), "write the path as a string — `Script.load(\"mods/goblin\")` — without `.js`")
        return bad()
    bool ok = true
    ref []u32 opds
    opds = #append(opds, spill(w, b, pv, pn))
    for g in args[1..<#len(args)]:
        u32 vn = arg_value(w, b, g)
        Val v = finish(w, b, expr(w, b, vn, NONE), vn)
        if v.ty == NONE:
            ok = false
            continue
        opds = #append(opds, spill(w, b, v, vn))
        if s_fn(w, v.ty):
            ok = false
            err(w, b, vn, 504, index.hold(#format("what `Script.load` hands a mod's init method goes in as an `any`, and `", src(w, b, vn), "` is ", shown(w, v.ty), ", which no `any` holds")), "hand the mod an instance of a class of yours, or a value a script holds — a scalar, an array or a map of them")
    if !ok: return bad()
    if h_web(w, b, n, 1, "Script.load"): return value(NONE, w.sany)
    if w.js_package: err(w, b, n, 1341, "`Script.load` loads a script by its path through its Dado host, and a package built as a JavaScript library (`--emit=js-package`) has none", "import the class the script loads and construct it, or build the scripts with the Dado program that hosts them (`./dado build`)")
    w.sloads = true
    u32 t = temp(w, b, w.sany, n)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SLOAD, w.sany, n, t, NONE)
    for x in opds:
        ir.arg(&b.f, x)
    return value(t, w.sany)

// `Script.load(path, ..args)`: args the path and the mod's init arguments.
const u8 B_SLOAD = 163
