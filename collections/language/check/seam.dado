// A script calling a Dado function of its package (Rust's `dados/seam`):
// scalars cross, an `int` into a narrower integer and a `float` into an
// `f32` narrowing as Dado's do, reported at run time the first time a place
// loses (`B_SNARROW`); the call is `B_SDADO`, and each function bound gets a
// C thunk (`lower.seam_glue`).
package check

import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:strings"

const u8 B_SDADO = 152    // dst = the Dado function a names (args…)
const u8 B_SNARROW = 153  // dst = a, narrowed to ty_of; b the site
const u8 SK_NONE = 0
const u8 SK_INT = 1
const u8 SK_FLOAT = 2
const u8 SK_BOOL = 3
const u8 SK_STR = 4
const u8 SK_OWNED = 5
const u8 SK_RUN = 6       // a `[]U` (an answer's `ref []U` too) of crossing elements
const u8 SK_INST = 7      // a class's handle, a parameter
const u8 SK_C32 = 8       // a `char32`, a one-character `string`
const u8 SK_C16 = 9
const u8 SK_CB = 10       // a script's function: bare, a `(proc, data)` pair, a `Sink`
const u8 SK_TUP = 11      // a fixed array or a tuple of crossing slots: the same type
const u8 SK_MAP = 12      // a map keyed by an integer, `bool` or string, of crossing values
const u8 SK_FNV = 13      // a Dado function value into a script: one the program names as a value
const u8 SK_UNION = 14    // a Dado union: the script's pair `[member, payload]`
const u8 SK_ENUM = 15     // a Dado enum: its member's name, else its number
const u8 SK_WIDE = 16     // a `string16`, `string32` or `cstring`: the script's `string`, transcoded

// The `core:script` glue a wide string crosses by.
const [12]string8 SEAM_WIDE_RT = ("read_units", "drop_units", "give_units", "mix_units", "read_points", "drop_points", "give_points", "mix_points", "read_cstring", "drop_cstring", "give_cstring", "mix_cstring")

// A kind crossing as the script's `string`.
bool sk_str(u8 k):
    return k == SK_STR || k == SK_WIDE

// What a run's glue calls, from `core:script`.
const [24]string8 SEAM_RUN_RT = ("new_array", "put", "give_float", "give_bool", "read_int", "read_float", "read_bool", "read_string", "read_length", "element", "free_value", "scratch", "unscratch", "put_in", "array_length", "same_object", "read_exactly", "lend_script", "unlend_script", "lent_written", "mix", "clear_exception", "read_owned_string", "read_same_length")

// The helpers a thunk calls, from `core:script`.
const [16]string8 SEAM_RT = ("typed_entered", "typed_left", "take_int", "take_float", "take_bool", "take_string", "drop_string", "give_int", "give_string", "give_owned_string", "raised", "failed", "take_char32", "take_char16", "give_char32", "give_char16")

// How a Dado type crosses (`ret`: as an answer).
u8 seam_kind(^World w, u32 ty, bool ret):
    if ty == NONE: return SK_NONE
    u32 r = w.t.resolve(ty)
    // A `distinct` type crosses as its shape; a union as its members' pair.
    u32 dr = s_ddist(w, ty)
    if dr != NONE: return seam_kind(w, w.t.b[dr], ret)
    if s_denum(w, ty) != NONE:
        u32 eb = r
        if eb != NONE && w.t.tag[eb] == types.T_DISTINCT: eb = w.t.resolve(w.t.b[eb])
        if is_int(w, eb) && !is_float(w, eb) && !is_char(w, eb): return SK_ENUM
        return SK_NONE
    if s_dunion(w, ty) != NONE:
        u32 part = NONE
        string8 why = s_union_refused(w, ty, &part)
        if #len(why) > 0: return SK_NONE
        return SK_UNION
    if r == types.STRING8: return SK_STR
    if r == types.STRING16 || r == types.STRING32 || r == types.CSTRING: return SK_WIDE
    if ret && r == w.t.ref_of(w.t.slice_of(u32(types.P_CHAR8))): return SK_OWNED
    u32 el = run_elem(w, r, ret)
    if el != NONE:
        u8 ek = seam_kind(w, el, false)
        u32 er = w.t.resolve(el)
        if er == w.t.ref_of(w.t.slice_of(u32(types.P_CHAR8))): ek = SK_STR
        bool byte_ = er == u32(types.P_U8) || er == u32(types.P_CHAR8)
        if ek == SK_INT && !byte_ || ek == SK_ENUM || ek == SK_FLOAT || ek == SK_BOOL || sk_str(ek) || ek == SK_TUP || ek == SK_RUN && w.t.tag[er] == types.T_SLICE: return SK_RUN
        return SK_NONE
    if r != NONE && w.t.tag[r] != types.T_PTR && s_class_of_ty(w, ty) != NONE: return SK_INST
    if !ret && cb_form(w, ty) != 0: return SK_CB
    if ret && r != NONE && w.t.tag[r] == types.T_FUNC && fnv_sty(w, r) != NONE: return SK_FNV
    if r != NONE && w.t.tag[r] == types.T_SOA:
        // Each lane a scalar or a string: the glue scatters it by one store.
        if s_soa_lane(w, r) != NONE: return SK_NONE
        return SK_TUP
    if s_tup(w, ty):
        for x in w.t.slots(ty):
            u8 xk = seam_kind(w, x, false)
            if ret && seam_kind(w, x, true) == SK_OWNED: xk = SK_STR
            if xk != SK_INT && xk != SK_ENUM && xk != SK_FLOAT && xk != SK_BOOL && !sk_str(xk) && xk != SK_TUP && xk != SK_RUN && xk != SK_MAP: return SK_NONE
        return SK_TUP
    if r != NONE && w.t.tag[r] == types.T_MAP:
        u8 kk = seam_kind(w, w.t.a[r], false)
        u8 vk = seam_kind(w, w.t.b[r], ret)
        if (kk == SK_INT || kk == SK_ENUM || kk == SK_BOOL || kk == SK_STR) && vk != SK_NONE && vk != SK_INST && vk != SK_CB && vk != SK_C32 && vk != SK_C16: return SK_MAP
        return SK_NONE
    if r == NONE || w.t.tag[r] != types.T_PRIM: return SK_NONE
    u8 p = types.PRIM[w.t.a[r]].canon
    if p == types.P_BOOL: return SK_BOOL
    if p == types.P_F32 || p == types.P_F64: return SK_FLOAT
    if p >= types.P_I8 && p <= types.P_U64 || p == types.P_CHAR8: return SK_INT
    if p == types.P_CHAR32: return SK_C32
    if p == types.P_CHAR16: return SK_C16
    return SK_NONE

// The first lane of `#soa` row `r` that is no scalar or string, or NONE.
u32 s_soa_lane(^World w, u32 r):
    []u32 els = w.t.slots(r)
    u32 e = els[0]
    ref []u32 ls
    if s_tup(w, e):
        for x in w.t.slots(e): ls = #append(ls, x)
    else: ls = #append(ls, e)
    for x in ls:
        u8 k = seam_kind(w, x, false)
        if k != SK_INT && k != SK_FLOAT && k != SK_BOOL && !sk_str(k) && k != SK_ENUM: return x
    return NONE

// The script function type Dado function type `r` crosses as: scalar and
// string parameters and answer; NONE.
u32 fnv_sty(^World w, u32 r):
    ref []u32 ps
    for p in w.t.params(r):
        u8 k = seam_kind(w, p, false)
        if k != SK_INT && k != SK_FLOAT && k != SK_BOOL && !sk_str(k): return NONE
        ps = #append(ps, sk_script(w, k))
    u32 rt = w.t.a[r]
    u32 srt = u32(types.P_VOID)
    if w.t.resolve(rt) != u32(types.P_VOID):
        u8 k = seam_kind(w, rt, true)
        if k != SK_INT && k != SK_FLOAT && k != SK_BOOL && !sk_str(k) && k != SK_OWNED: return NONE
        srt = sk_script(w, k)
    return w.t.func(srt, types.F_NONE, ps[:])

// Each function the program names as a value of Dado type `r`, bound so a
// script may call it.
void fnv_bind(^World w, u32 r):
    bool had = false
    for x in w.fnvt:
        if x == r: had = true
    if !had: w.fnvt = #append(w.fnvt, r)
    _ = fnv_settle(w)

// After the bodies: every function named as a value of a type that crosses
// bound; whether that queued more bodies.
bool fnv_settle(^World w):
    i64 n = #len(w.jobs)
    for d in w.fnvals:
        for r in w.fnvt:
            if w.t.resolve(resolve(w, d)) == r: seam_bind(w, d)
    return #len(w.jobs) > n

// What a map's glue calls, kept live.
void seam_maps(^World w):
    _ = seam_rt(w, "map_entries")
    _ = seam_rt(w, "new_map")
    _ = seam_rt(w, "map_set")

// A `[]U` (with `ret`, a `ref []U` too): `U`, else NONE.
u32 run_elem(^World w, u32 r, bool ret):
    if r == NONE: return NONE
    if w.t.tag[r] == types.T_SLICE: return w.t.a[r]
    if !ret || w.t.tag[r] != types.T_REF: return NONE
    u32 s = w.t.resolve(w.t.a[r])
    if s != NONE && w.t.tag[s] == types.T_SLICE: return w.t.a[s]
    return NONE

// The script type Dado type `ty` crosses as.
u32 seam_sty(^World w, u32 ty, bool ret):
    u8 k = seam_kind(w, ty, ret)
    if k == SK_RUN: return w.t.slice_of(seam_sty(w, run_elem(w, w.t.resolve(ty), ret), false))
    if k == SK_INST || k == SK_TUP: return ty
    // A Dado enum crosses as itself.
    if k == SK_ENUM: return ty
    if k == SK_UNION || s_ddist(w, ty) != NONE: return s_dview(w, ty)
    if k == SK_FNV: return fnv_sty(w, w.t.resolve(ty))
    if k == SK_MAP: return w.t.map_of(seam_sty(w, w.t.a[w.t.resolve(ty)], false), s_sview(w, seam_sty(w, w.t.b[w.t.resolve(ty)], ret)))
    return sk_script(w, k)

// A Dado shape as the script's own: its slots' script types.
u32 s_sview(^World w, u32 ty):
    if !s_tup(w, ty): return ty
    ref []u32 xs
    for x in w.t.slots(ty):
        u8 k = seam_kind(w, x, false)
        u32 sx = sk_script(w, k)
        if k == SK_TUP: sx = s_sview(w, x)
        if k == SK_RUN: sx = seam_sty(w, x, false)
        xs = #append(xs, sx)
    return w.t.tuple(xs[:])

// Whether a script value of `got` fits tuple type `want` slot by slot: the
// same shape, each slot crossing.
bool s_tup_fits(^World w, u32 got, u32 want):
    if !s_tup(w, got) || !s_tup(w, want): return false
    []u32 gs = w.t.slots(got)
    []u32 ws = w.t.slots(want)
    if #len(gs) != #len(ws): return false
    for i in 0..<#len(gs):
        if !s_slot_fits(w, w.t.resolve(gs[i]), w.t.resolve(ws[i])): return false
    return true

bool s_slot_fits(^World w, u32 g, u32 x):
    if g == x || s_tup_fits(w, g, x) || (g == types.STRING8 || g == w.sstr) && (x == types.STRING8 || x == w.sstr): return true
    if g != NONE && x != NONE && w.t.tag[g] == types.T_SLICE && w.t.tag[x] == types.T_SLICE: return s_slot_fits(w, w.t.resolve(w.t.a[g]), w.t.resolve(w.t.a[x]))
    if is_float(w, g) && is_float(w, x): return true
    return is_int(w, g) && is_int(w, x) && !is_float(w, g) && !is_float(w, x) && !is_char(w, g) && !is_char(w, x)

u32 sk_script(^World w, u8 k):
    if k == SK_INT: return u32(types.P_INT)
    if k == SK_FLOAT: return u32(types.P_FLOAT)
    if k == SK_BOOL: return u32(types.P_BOOL)
    return w.sstr

// A script's call of Dado function `d`, written `c(args…)`.
// `recv`: a promoted method's receiver, the embedded slots (`sembed.dado`).
Val s_dado_call(^World w, ^Body b, u32 n, u32 d, u32 recv = NONE):
    syntax.Ast a = tree(w, b)
    []u32 ks = a.list(a.b[n])
    string8 nm = index.hold(strings.clone(spell(w, b, ks[0])))
    if w.js_package: err(w, b, n, 1341, index.hold(#format("`", nm, "` is a Dado function of package `", name_of(w, w.p.pkgs[w.decls[d].pkg].name), "`, and a package built as a JavaScript library (`--emit=js-package`) runs with no Dado to call")), index.hold(#format("write `", nm, "` as a method in DadoScript, or build the scripts with the Dado program that hosts them (`./dado build`)")))
    u32 fty = resolve(w, d)
    if fty == NONE: return bad()
    []u32 ps = w.t.params(fty)
    if recv != NONE: ps = ps[1..<#len(ps)]
    u32 rt = w.t.a[fty]
    bool ok = (w.t.b[fty] == types.F_NONE || w.t.b[fty] == types.F_PLAIN) && (rt == u32(types.P_VOID) || seam_kind(w, rt, true) != SK_NONE)
    for p in ps:
        if seam_kind(w, p, false) == SK_NONE: ok = false
    u32 df = w.decls[d].file
    syntax.Ast da = w.p.files[df].a
    []u32 dks = da.list(da.b[w.decls[d].node])
    []u32 qs = dks[6..<#len(dks)]
    // ERR1206: a function type that does not cross.
    for i in 0..<#len(ps):
        if seam_kind(w, ps[i], false) != SK_CB: continue
        u32 part = NONE
        string8 why = cb_refused(w, ps[i], &part)
        if #len(why) == 0: continue
        string8 what = index.hold(#format("its parameter `", w.p.spell(df, qs[i]), "` is `", shown(w, ps[i]), "`"))
        if part != NONE: what = index.hold(#format(what, ", whose function takes a Dado `", shown(w, part), "`"))
        string8 rep = "make the procedure's first parameter the `rawptr` its `data` is passed as"
        if part != NONE: rep = "give the function type scalar parameters and answer, or give the script a Dado function over scalars that calls this one"
        err(w, b, ks[0], 1206, index.hold(#format("`", nm, "` cannot be called from a script: ", what, ", and ", why)), rep)
        return bad()
    if true:
        for i in 0..<#len(ps) + 1:
            string8 step = ""
            u32 part = NONE
            string8 rep = ""
            u32 t = rt
            if i < #len(ps): t = ps[i]
            if i == #len(ps) && rt == u32(types.P_VOID): break
            if i < #len(ps) && seam_kind(w, t, false) == SK_CB: continue
            string8 why = s_uncross(w, t, i == #len(ps), &step, &part, &rep)
            if #len(why) == 0: continue
            // Said in the script pass, which spells scalars as a script does.
            w.t.dspell = true
            string8 what = index.hold(#format("it answers `", s_cshown(w, t), "`"))
            if i < #len(ps): what = index.hold(#format("its parameter `", w.p.spell(df, qs[i]), "` is `", s_cshown(w, t), "`"))
            if part != NONE: what = index.hold(#format(what, ", ", step, " a Dado `", s_cshown(w, part), "`"))
            w.t.dspell = false
            err(w, b, ks[0], 1206, index.hold(#format("`", nm, "` cannot be called from a script: ", what, ", and ", why)), rep)
            return bad()
    if !ok:
        err(w, b, n, 1, "this call is outside the slice the port builds so far")
        return bad()
    []u32 args = ks[2..<#len(ks)]
    if #len(args) != #len(ps):
        ref []string8 ls
        for i in 0..<#len(ps):
            ls = #append(ls, index.hold(#format("`", shown(w, ps[i]), " ", w.p.spell(df, qs[i]), "`")))
        string8 takes = "takes no arguments"
        if #len(ps) == 1: takes = index.hold(#format("takes 1 argument, ", ls[0]))
        if #len(ps) > 1: takes = index.hold(#format("takes ", #len(ps), " arguments, ", strings.join(ls[:], ", ")))
        for g in args:
            _ = expr(w, b, a.a[g], NONE)
        err(w, b, n, 601, index.hold(#format("`", nm, "` ", takes, ", and this call passes ", #len(args))), index.hold(#format("pass `", nm, "` exactly ", #len(ps), " argument", "" if #len(ps) == 1 else "s")))
        return bad()
    ref []u32 opds
    if recv != NONE: opds = #append(opds, recv)
    for i in 0..<#len(args):
        u32 g = a.a[args[i]]
        u8 k = seam_kind(w, ps[i], false)
        if k == SK_CB:
            u32 lv = s_cb_arg(w, b, g, nm, index.hold(strings.clone(w.p.spell(df, qs[i]))), ps[i])
            if lv == NONE: ok = false
            else: opds = #append(opds, lv)
            continue
        if k == SK_RUN || k == SK_TUP || k == SK_MAP:
            // A container as the script typed it, checked part by part.
            Val cv = finish(w, b, expr(w, b, g, NONE), g)
            if cv.ty == NONE:
                ok = false
                continue
            string8 at = ""
            u32 part = NONE
            u32 pg = NONE
            if s_cmiss(w, b, ps[i], cv.ty, "", g, &at, &part, &pg):
                s_crefuse(w, b, g, nm, index.hold(strings.clone(w.p.spell(df, qs[i]))), ps[i], cv.ty, at, part, pg)
                ok = false
                continue
            opds = #append(opds, spill(w, b, cv, g))
            continue
        if k == SK_ENUM:
            Val ev = finish(w, b, expr(w, b, g, NONE), g)
            if ev.ty == NONE:
                ok = false
                continue
            u32 ed = s_denum(w, ps[i])
            if s_denum(w, ev.ty) != ed:
                string8 en = name_of(w, w.decls[ed].name)
                ref []string8 ems = s_enum_names(w, ed, nil)
                if ev.ty == u32(types.P_INT): err(w, b, g, 1201, index.hold(#format("`", nm, "`'s parameter `", w.p.spell(df, qs[i]), "` is a Dado `", shown(w, ps[i]), "`, and this is `int`: a number becomes a `", en, "` only by the written conversion, which keeps a value no member names")), index.hold(#format("write `", en, "(", src(w, b, g), ")`, or name a member: `", en, ".", ems[0], "`")))
                else: s_refuse(w, b, g, nm, index.hold(strings.clone(w.p.spell(df, qs[i]))), ps[i], k, ev.ty)
                ok = false
                continue
            for rn in ["give_string", "drop_string", "read_string", "read_int", "give_int"]:
                _ = seam_rt(w, rn)
            opds = #append(opds, spill(w, b, ev, g))
            continue
        u32 want = seam_sty(w, ps[i], false)
        u32 dw = s_ddist(w, want)
        u32 ex = s_sview(w, want)
        if dw != NONE: ex = w.t.b[dw]
        Val v = expr(w, b, g, ex)
        if v.ty == w.sany:
            string8 cv = "int"
            if k == SK_FLOAT: cv = "float"
            if sk_str(k): cv = "string"
            err(w, b, g, 1201, index.hold(#format("`", nm, "`'s parameter `", w.p.spell(df, qs[i]), "` is a Dado `", shown(w, ps[i]), "`, and this is any: an `any` crosses into Dado only once it is converted, which checks what it holds")), index.hold(#format("convert it first: `", cv, "(", src(w, b, g), ")`")))
            ok = false
            continue
        if v.ty == NONE:
            ok = false
            continue
        if dw != NONE && w.t.resolve(v.ty) != want:
            if v.ty != NONE:
                string8 dn = shown(w, want)
                u32 pd = s_tdecl(w, ps[i])
                if pd != NONE: dn = name_of(w, w.decls[pd].name)
                err(w, b, g, 1201, index.hold(#format("`", nm, "`'s parameter `", w.p.spell(df, qs[i]), "` is a Dado `", shown(w, ps[i]), "`, and this is `", shown(w, v.ty), "`: `", dn, "` is a `distinct` type, so nothing becomes one by itself")), index.hold(#format("write `", dn, "(", src(w, b, g), ")`")))
            ok = false
            continue
        if dw != NONE: pass
        else if v.kind == V_LIT || v.kind == V_FLIT: v = coerce(w, b, v, want, g)
        else if k == SK_INST && s_class_of_ty(w, v.ty) == s_class_of_ty(w, want): _ = seam_rt(w, "take_instance")
        else if k == SK_INST:
            string8 cn = s_short(w, w.classes[s_class_of_ty(w, want)].decl)
            err(w, b, g, 1201, index.hold(#format("`", nm, "`'s parameter `", w.p.spell(df, qs[i]), "` is a Dado `", s_cshown(w, ps[i]), "`, a handle of the script class `", cn, "`, and this is ", s_cshown(w, v.ty), ": it takes an instance of `", cn, "`, or of a class extending it")), index.hold(#format("pass a `", cn, "`")))
            ok = false
            continue
        else if w.t.resolve(v.ty) != want:
            s_refuse(w, b, g, nm, index.hold(strings.clone(w.p.spell(df, qs[i]))), ps[i], k, v.ty)
            ok = false
            continue
        if v.ty == NONE:
            ok = false
            continue
        opds = #append(opds, s_narrow(w, b, g, v, s_erase(w, ps[i]), k))
    if !ok: return bad()
    seam_bind(w, d)
    Where wh = where(w, b.file, NONE, n)
    w.bsite_cls = #append(w.bsite_cls, b.cls)
    w.bsite_fn = #append(w.bsite_fn, d)
    w.bsite_at = #append(w.bsite_at, index.hold(#format(w.p.files[b.file].path, ":", wh.line)))
    bool runs = seam_kind(w, rt, true) == SK_RUN || seam_kind(w, rt, true) == SK_TUP || seam_kind(w, rt, true) == SK_MAP
    for p in w.t.params(fty):
        if seam_kind(w, p, false) == SK_RUN || seam_kind(w, p, false) == SK_TUP || seam_kind(w, p, false) == SK_MAP: runs = true
    if seam_kind(w, rt, true) == SK_FNV: fnv_bind(w, w.t.resolve(rt))
    if seam_kind(w, rt, true) == SK_INST: _ = seam_rt(w, "give_instance")
    if runs:
        seam_maps(w)
        for nm in SEAM_RUN_RT:
            _ = seam_rt(w, nm)
    u32 st = u32(types.P_VOID)
    if rt != u32(types.P_VOID): st = seam_sty(w, rt, true)
    u32 t = NONE
    if st != u32(types.P_VOID): t = temp(w, b, st, n)
    u32 r = ir.fn_ref(&b.f, tstr(w, name_of(w, w.p.pkgs[w.decls[d].pkg].name)), tstr(w, seam_name(w, d)), 0)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SDADO, st, n, t, r)
    for o in opds:
        ir.arg(&b.f, o)
    return value(t, st)

// ERR1201: an argument of the wrong script type.
private void s_refuse(^World w, ^Body b, u32 g, string8 fname, string8 param, u32 pt, u8 k, u32 got):
    u32 r = w.t.resolve(got)
    string8 sh = named(w, got)
    if s_denum(w, got) != NONE: sh = index.hold(#format("a `", name_of(w, w.decls[s_denum(w, got)].name), "`"))
    else if r == u32(types.P_INT): sh = "an `int`"
    else if r == u32(types.P_FLOAT) || r == u32(types.P_BOOL) || r == w.sstr: sh = index.hold(#format("a `", shown(w, r), "`"))
    string8 rep = ""
    string8 why = s_why(w, k, got, src(w, b, g), &rep)
    err(w, b, g, 1201, index.hold(#format("`", fname, "`'s parameter `", param, "` is a Dado `", shown(w, pt), "`, and this is ", sh, ": ", why)), rep)

// Why script `got` (written `x`) does not cross into a Dado scalar of kind
// `k`, and the repair (Rust's `scalar_refusal`).
private string8 s_why(^World w, u8 k, u32 got, string8 x, ^string8 rep):
    u32 r = w.t.resolve(got)
    string8 ds = "string"
    if k == SK_INT: ds = "int"
    if k == SK_FLOAT: ds = "float"
    if k == SK_BOOL: ds = "bool"
    rep^ = index.hold(#format("pass ", h_article(ds), " `", ds, "`"))
    if k == SK_INT && r == u32(types.P_FLOAT):
        rep^ = index.hold(#format("write `int(", x, ")`, which drops the fraction toward zero"))
        return "a `float` becomes an integer only by a written conversion, which drops the fraction"
    if k == SK_FLOAT && r == u32(types.P_INT):
        rep^ = index.hold(#format("write `float(", x, ")`"))
        return "an `int` becomes a float only by a written conversion"
    if (k == SK_INT || k == SK_FLOAT) && r == u32(types.P_BOOL):
        rep^ = index.hold(#format("write the number you mean for each: `1 if ", x, " else 0`"))
        return "a `bool` is not a number"
    if k == SK_BOOL && r == u32(types.P_INT):
        rep^ = index.hold(#format("say which values are true: `", x, " != 0`"))
        return "a number is not a `bool`"
    if sk_str(k) && (r == u32(types.P_INT) || r == u32(types.P_FLOAT) || r == u32(types.P_BOOL)):
        rep^ = index.hold(#format("write `string(", x, ")`"))
        return "DadoScript never makes a string of a value by itself"
    return index.hold(#format("it takes a script's `", ds, "`"))

// Where script value `got` (written `lit`) fails Dado container `pt`
// (Rust's `seam_container_mismatch`): the place, the Dado part and the
// script part; false when it crosses.
private bool s_cmiss(^World w, ^Body b, u32 pt, u32 got, string8 place, u32 lit, ^string8 at, ^u32 part, ^u32 pg):
    u32 d = w.t.resolve(pt)
    u32 r = w.t.resolve(got)
    at^ = place
    part^ = pt
    pg^ = got
    syntax.Ast a = tree(w, b)
    ref []u32 ws
    if lit != NONE && (a.tag[lit] == syntax.E_ARRAY || a.tag[lit] == syntax.E_TUPLE):
        for x in a.list(a.b[lit]): ws = #append(ws, x)
    if w.t.tag[d] == types.T_MAP:
        if r == NONE || w.t.tag[r] != types.T_MAP: return true
        string8 kp = "its key"
        string8 vp = "its value"
        if #len(place) > 0:
            kp = index.hold(#format("the key of ", place))
            vp = index.hold(#format("the value of ", place))
        return s_pmiss(w, b, w.t.a[d], w.t.a[r], kp, NONE, at, part, pg) || s_pmiss(w, b, w.t.b[d], w.t.b[r], vp, NONE, at, part, pg)
    bool arr = w.t.tag[d] == types.T_SLICE || s_tup(w, d) && h_fixed(w, d)
    if arr:
        u32 el = w.t.a[d]
        if w.t.tag[d] != types.T_SLICE:
            []u32 dsl0 = w.t.slots(d)
            el = dsl0[0]
        ref []u32 items
        if r != NONE && w.t.tag[r] == types.T_SLICE: items = #append(items, w.t.a[r])
        else if s_tup(w, r):
            []u32 rs = w.t.slots(r)
            []u32 dsl = w.t.slots(d)
            if w.t.tag[d] != types.T_SLICE && #len(rs) != #len(dsl): return true
            for x in rs: items = #append(items, x)
        else: return true
        string8 inner = "its element"
        if #len(place) > 0: inner = index.hold(#format("the element of ", place))
        if #len(ws) > 0 && r != NONE && w.t.tag[r] == types.T_SLICE:
            for x in ws:
                if s_pmiss(w, b, el, items[0], inner, x, at, part, pg): return true
            return false
        for k in 0..<#len(items):
            u32 x = NONE
            if k < #len(ws): x = ws[k]
            if s_pmiss(w, b, el, items[k], inner, x, at, part, pg): return true
        return false
    if !s_tup(w, r): return true
    []u32 ds = w.t.slots(d)
    []u32 gs = w.t.slots(r)
    if #len(ds) != #len(gs): return true
    for k in 0..<#len(ds):
        string8 inner = index.hold(#format("its slot ", k))
        if #len(place) > 0: inner = index.hold(#format("slot ", k, " of ", place))
        u32 x = NONE
        if k < #len(ws): x = ws[k]
        if s_pmiss(w, b, ds[k], gs[k], inner, x, at, part, pg): return true
    return false

// One part: an `any` checked where it crosses, a container part by part, a
// scalar by its kind (a literal number adapts to a float).
private bool s_pmiss(^World w, ^Body b, u32 pt, u32 got, string8 place, u32 lit, ^string8 at, ^u32 part, ^u32 pg):
    if got == w.sany: return false
    u8 k = seam_kind(w, pt, false)
    if k == SK_RUN || k == SK_TUP || k == SK_MAP: return s_cmiss(w, b, pt, got, place, lit, at, part, pg)
    at^ = place
    part^ = pt
    pg^ = got
    u32 r = w.t.resolve(got)
    syntax.Ast a = tree(w, b)
    if k == SK_ENUM: return s_denum(w, got) != s_denum(w, pt)
    // A Dado scalar a script holds (a slot of a Dado shape) is the script's own.
    if k == SK_INT: return !(is_int(w, r) && !is_float(w, r) && !is_char(w, r))
    if k == SK_FLOAT: return !is_float(w, r) && !(r == u32(types.P_INT) && lit != NONE && a.tag[lit] == syntax.E_INT)
    if k == SK_BOOL: return r != u32(types.P_BOOL)
    return r != w.sstr && r != types.STRING8

// ERR1201 for a container argument at the part `s_cmiss` found.
private void s_crefuse(^World w, ^Body b, u32 g, string8 fname, string8 param, u32 pt, u32 got, string8 place, u32 part, u32 pg):
    string8 why = ""
    string8 rep = ""
    u8 pk = seam_kind(w, part, false)
    string8 pd = shown(w, s_sview(w, seam_sty(w, part, false)))
    if pk == SK_RUN || pk == SK_TUP || pk == SK_MAP || #len(place) == 0:
        string8 takes = index.hold(#format("a script's `", pd, "`"))
        u32 pr = w.t.resolve(part)
        if s_tup(w, pr) && h_fixed(w, pr):
            []u32 psl = w.t.slots(pr)
            takes = index.hold(#format(takes, " or a `[]", shown(w, sk_script(w, seam_kind(w, psl[0], false))), "` of ", #len(psl), " elements"))
        string8 has = ""
        u32 gr = w.t.resolve(pg)
        if s_tup(w, gr):
            []u32 gsl = w.t.slots(gr)
            has = index.hold(#format(", and this tuple has ", #len(gsl)))
            if h_fixed(w, gr): has = index.hold(#format(", and this one has ", #len(gsl)))
        why = index.hold(#format("a Dado `", shown(w, pr), "` takes ", takes, has))
        rep = index.hold(#format("pass ", h_article(pd), " `", pd, "`"))
    else:
        string8 el = index.hold(#format("`", shown(w, pg), "`"))
        if w.t.resolve(pg) == u32(types.P_U8): el = "`byte`"
        string8 rp = ""
        why = s_why(w, pk, pg, "x", &rp)
        string8 sd = shown(w, s_sview(w, seam_sty(w, pt, false)))
        if strings.starts_with(rp, "pass "): rep = index.hold(#format("pass ", h_article(sd), " `", sd, "` — an array of what the element takes"))
        else if w.t.tag[w.t.resolve(pt)] == types.T_MAP: rep = index.hold(#format("build the map from each key or value `x` so: ", rp))
        else: rep = index.hold(#format("build the array from each element `x` so: ", rp))
        why = index.hold(#format(place, ", ", el, ", does not cross into a Dado `", shown(w, part), "`: ", why))
    err(w, b, g, 1201, index.hold(#format("`", fname, "`'s parameter `", param, "` is a Dado `", shown(w, w.t.resolve(pt)), "`, and `", src(w, b, g), "` is a `", shown(w, got), "`: ", why)), rep)

// A value that narrows as it crosses, checked at run time unless constant.
private u32 s_narrow(^World w, ^Body b, u32 g, Val v, u32 pt, u8 k):
    if ir.is_const(v.opd) || k != SK_INT && k != SK_FLOAT || w.no_narrowing: return v.opd
    u8 p = types.PRIM[w.t.a[w.t.resolve(pt)]].canon
    if k == SK_FLOAT && p != types.P_F32: return v.opd
    if k == SK_INT && (p == types.P_I64 || p == types.P_U64): return v.opd
    Where at = where(w, b.file, NONE, g)
    _ = seam_rt(w, "narrowed")
    i64 site = #len(w.narrows)
    w.narrows = #append(w.narrows, index.hold(#format(w.p.files[b.file].path, ":", at.line, ":", at.col)))
    u32 t = temp(w, b, v.ty, g)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SNARROW, pt, g, t, v.opd, ir.konst(w.k.small(&w.t, site)))
    return t

// `d` bound: a thunk for it, it and the runtime's helpers kept live.
private void seam_bind(^World w, u32 d):
    for x in w.bound:
        if x == d: return
    w.bound = #append(w.bound, d)
    w.bound_c = #append(w.bound_c, job(w, d, NONE))
    w.seam_roots = #append(w.seam_roots, w.bound_c[#len(w.bound_c) - 1])
    u32 sp = rt_pkg(w)
    if sp == NONE || #len(w.bound) > 1: return
    for nm in SEAM_RT:
        seam_rt(w, nm)
    for nm in SEAM_WIDE_RT:
        seam_rt(w, nm)
    // The web's inline crossings' settle and safe point (`lower/inline.dado`).
    if w.os == "WEB":
        seam_rt(w, "inline_entered")
        seam_rt(w, "inline_left")

// The C name of `core:script`'s `nm`, kept live.
u32 seam_rt(^World w, string8 nm):
    u32 sp = rt_pkg(w)
    if sp == NONE: return NONE
    u32 d = lookup(w, sp, w.p.names.intern(nm))
    if d == NONE || resolve(w, d) == NONE: return NONE
    u32 have = seam_c(w, nm)
    if have != NONE: return have
    u32 c = job(w, d, NONE)
    w.seam_rt_names = #append(w.seam_rt_names, nm)
    w.seam_rt_c = #append(w.seam_rt_c, c)
    w.seam_roots = #append(w.seam_roots, c)
    return c

// The C name `seam_rt` kept for `nm`, or NONE.
u32 seam_c(^World w, string8 nm):
    for i in 0..<#len(w.seam_rt_names):
        if w.seam_rt_names[i] == nm: return w.seam_rt_c[i]
    return NONE

// `g.sig.connect(f)` from Dado: the class's module gets `$connect_sig$f`,
// which connects the imported thunk, and Dado runs it.
// A method bound to pointer `p` (`T.m, p`) is `$connect_sig$T$m(p)`.
Val host_connect(^World w, ^Body b, u32 n, u32 h, u32 ci, u32 sg, u32 d, bool on, u32 p):
    seam_bind(w, d)
    bool have = false
    for i in 0..<#len(w.sd_fn):
        if w.sd_class[i] == ci && w.sd_sig[i] == sg && w.sd_fn[i] == d: have = true
    if !have:
        w.sd_class = #append(w.sd_class, ci)
        w.sd_sig = #append(w.sd_sig, sg)
        w.sd_fn = #append(w.sd_fn, d)
    string8 sn = name_of(w, w.p.sym(w.classes[ci].file, sg))
    string8 e = index.hold(#format("$", "connect" if on else "disconnect", "_", sn, "$", seam_name(w, d)))
    if p != NONE:
        u32 rp = temp(w, b, u32(types.P_RAWPTR), n)
        _ = ir.op(&b.f, ir.O_CONV, ir.CV_TO_RAWPTR, u32(types.P_RAWPTR), n, rp, p)
        u32 t = temp(w, b, u32(types.P_I64), n)
        _ = ir.op(&b.f, ir.O_CONV, ir.CV_WRAP, u32(types.P_I64), n, t, rp)
        host_push(w, b, n, h, value(t, u32(types.P_I64)), "push_int")
    return host_run(w, b, n, h, e)

// The name a bound Dado function is imported by: `f`, or `T$m` for a method.
string8 seam_name(^World w, u32 d):
    if w.decls[d].kind != K_METHOD: return name_of(w, w.decls[d].name)
    return index.hold(#format(name_of(w, w.decls[w.decls[d].block].name), "$", name_of(w, w.decls[d].name)))

const u8 B_SRECV = 155    // receive: args the row in `w.recv`, 1 for a method, the handler

// `receive(ch, handler)` in a script (Rust's `dados_receive`): `ch` a
// package-level channel of scalars, `handler` a `void` over its fields.
Val s_receive(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    []u32 ks = a.list(a.b[n])
    []u32 args = ks[2..<#len(ks)]
    if #len(args) != 2:
        err(w, b, n, 1213, index.hold(#format("`receive` takes a channel of the program and the function to call with each of its messages, and this gives ", #len(args), " argument", "" if #len(args) == 1 else "s")), "write `receive(hits, on_hit)`")
        for g in args[1..<#len(args)]:
            s_handler_rest(w, b, a.a[g])
        return bad()
    u32 sg = a.a[args[0]]
    u32 hd = a.a[args[1]]
    string8 sp = src(w, b, sg)
    u32 pk = NONE
    u32 sym = NONE
    u32 fp = w.p.files[b.file].pkg
    if a.tag[sg] == syntax.E_NAME && find_local(w, b, w.p.sym(b.file, sg), false) == NONE && s_field_ix(w, b, w.p.sym(b.file, sg)) < 0:
        pk = fp
        sym = w.p.sym(b.file, sg)
    if a.tag[sg] == syntax.E_FIELD && a.tag[a.a[sg]] == syntax.E_NAME && spell(w, b, a.a[sg]) != "self":
        u32 bs = w.p.sym(b.file, a.a[sg])
        if find_local(w, b, bs, false) == NONE && s_field_ix(w, b, bs) < 0:
            for im in w.p.pkgs[fp].imports:
                u32 ib = im.name
                if ib == NONE: ib = w.p.pkgs[im.pkg].name
                if im.file == b.file && ib == bs: pk = im.pkg
            sym = w.p.sym(b.file, sg)
    if pk == NONE:
        err(w, b, sg, 1213, index.hold(#format("`receive`'s first argument names a channel a Dado file declares at package level — `hits`, or `lib.hits` of an imported package — and `", sp, "` is a value of the script's")), "name the channel itself: a script receives the program's channels, never a value it holds")
        s_handler_rest(w, b, hd)
        return bad()
    string8 pn = name_of(w, w.p.pkgs[pk].name)
    string8 nm = name_of(w, sym)
    u32 d = lookup(w, pk, sym)
    if d == NONE || w.decls[d].kind != K_VAR || ds_at(w, w.decls[d].file, w.decls[d].node):
        err(w, b, sg, 1213, index.hold(#format("`receive`'s first argument names a channel a Dado file declares at package level, and `", sp, "` is no package-level declaration of package `", pn, "`")), index.hold(#format("declare it in a Dado file of `", pn, "` — `#channel(16) ", nm, "(i32 n)` — or name one that is")))
        s_handler_rest(w, b, hd)
        return bad()
    u32 ct = resolve(w, d)
    u32 r = chan_of(w, ct)
    if r == NONE:
        if ct != NONE: err(w, b, sg, 1213, index.hold(#format("`receive`'s first argument is a channel, and `", sp, "` is a `", shown(w, ct), "`")), index.hold(#format("receive a channel — declare one in Dado, `#channel(16) ", nm, "_changed(i32 n)`, and `#send` into it where `", nm, "` changes")))
        s_handler_rest(w, b, hd)
        return bad()
    []u32 fs = w.t.list(r)
    []u32 fns = w.t.slot_names(r)
    ref []u32 ps
    ref []string8 pss
    ref []string8 lam
    for i in 0..<#len(fs):
        u32 fr = w.t.resolve(fs[i])
        string8 fd = index.hold(#format("`", shown(w, fs[i]), " ", w.t.text(fns[i]), "`"))
        if w.t.tag[fr] == types.T_REF:
            err(w, b, sg, 1214, index.hold(#format("`", sp, "` carries ", fd, ", a `ref` its message moves, and a script holds no Dado allocation to take it or to end it")), index.hold(#format("drain `", sp, "` in Dado and hand the script what it needs — a Dado function the script calls, or a channel of plain values the Dado side sends for it")))
            s_handler_rest(w, b, hd)
            return bad()
        u8 k = seam_kind(w, fs[i], false)
        if k != SK_INT && k != SK_FLOAT && k != SK_BOOL:
            err(w, b, sg, 1214, index.hold(#format("`", sp, "` carries ", fd, ", and a script's handler takes scalars — a sized integer, `f32`, `f64`, `bool` or a character")), index.hold(#format("carry `", w.t.text(fns[i]), "`'s values as scalar fields of their own, or drain `", sp, "` in Dado and give the script a Dado function that reads it")))
            s_handler_rest(w, b, hd)
            return bad()
        u32 st = sk_script(w, k)
        ps = #append(ps, st)
        pss = #append(pss, shown(w, st))
        lam = #append(lam, index.hold(#format(shown(w, st), " ", w.t.text(fns[i]))))
    // The handler: a lambda, or a method of the class.
    ref []u32 gps
    u32 gret = u32(types.P_VOID)
    u32 hv = NONE
    u32 meth = NONE
    if a.tag[hd] == syntax.E_LAMBDA:
        []u32 lks = a.list(a.b[hd])
        for q in lks[2..<#len(lks)]:
            u32 t = resolve_type(w, b.file, a.a[q])
            if t == NONE: return bad()
            gps = #append(gps, t)
        if lks[0] != NONE: gret = resolve_type(w, b.file, lks[0])
        hv = s_lambda_value(w, b, hd, gps[:], gret)
    else if a.tag[hd] == syntax.E_NAME && find_local(w, b, w.p.sym(b.file, hd), false) == NONE && s_method_of(w, b, w.p.sym(b.file, hd)) != NONE:
        meth = s_method_of(w, b, w.p.sym(b.file, hd))
        u32 ft = resolve(w, meth)
        if ft == NONE: return bad()
        []u32 all = w.t.params(ft)
        for p in all[1..<#len(all)]:
            gps = #append(gps, p)
        gret = w.t.a[ft]
    else:
        err(w, b, hd, 1, "this handler is outside the slice the port builds so far")
        return bad()
    bool same = gret == u32(types.P_VOID) && #len(gps) == #len(ps)
    if same:
        for i in 0..<#len(ps):
            if gps[i] != ps[i]: same = false
    if !same:
        ref []string8 gs
        for p in gps:
            gs = #append(gs, shown(w, p))
        string8 sl = strings.join(pss[:], ", ")
        err(w, b, hd, 1213, index.hold(#format("`receive` calls its handler with each message of `", sp, "`, a `void(", sl, ")`, and this is `", shown(w, gret), "(", strings.join(gs[:], ", "), ")`")), index.hold(#format("pass a `void(", sl, ")` — a lambda, `void(", strings.join(lam[:], ", "), "): …`, or a method of that type")))
        return bad()
    i64 row = -1
    for i in 0..<#len(w.recv):
        if w.recv[i] == d: row = i
    if row < 0:
        row = #len(w.recv)
        w.recv = #append(w.recv, d)
        _ = global(w, b, d)
        if #len(w.recv) == 65:
            string8 q = w.t.text(w.t.a[r])
            err(w, b, n, 1222, index.hold(#format("the program's scripts bind handlers to 65 channels, and a program's scripts bind at most 64: `", q, "` is past the last")), "bind at most 64 channels to scripts: merge channels that carry one kind of message into one, with a field saying which, or walk some in Dado", "a VM's receivers are one bit each in a word of 64, one per channel scripts bind a handler to, so the `receive` of a channel past them would fail every time it ran; the count is over every script class the program declares, whether a run reaches it or not, and a channel Dado walks with `#peek` or `#drain` is not counted")
    for nm2 in RECV_RT:
        _ = seam_rt(w, nm2)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SRECV, u32(types.P_VOID), n, NONE, NONE)
    ir.arg(&b.f, ir.konst(w.k.small(&w.t, row)))
    if meth != NONE:
        ir.arg(&b.f, ir.konst(w.k.small(&w.t, 1)))
        ir.arg(&b.f, ir.konst(w.k.str(&w.t, name_of(w, w.decls[meth].name))))
    else:
        ir.arg(&b.f, ir.konst(w.k.small(&w.t, 0)))
        ir.arg(&b.f, hv)
    return value(NONE, u32(types.P_VOID))

// What a channel's drain and `receive` call, from `core:script`.
const [5]string8 RECV_RT = ("receive_channel", "deliver_one", "give_int", "give_float", "give_bool")

// A refused `receive`'s handler, checked for what it says itself.
private void s_handler_rest(^World w, ^Body b, u32 hd):
    syntax.Ast a = tree(w, b)
    if a.tag[hd] != syntax.E_LAMBDA:
        _ = expr(w, b, hd, NONE)
        return
    ref []u32 gps
    []u32 lks = a.list(a.b[hd])
    for q in lks[2..<#len(lks)]:
        u32 t = resolve_type(w, b.file, a.a[q])
        if t == NONE: return
        gps = #append(gps, t)
    u32 gret = u32(types.P_VOID)
    if lks[0] != NONE: gret = resolve_type(w, b.file, lks[0])
    _ = s_lambda_value(w, b, hd, gps[:], gret)

// A callback's form: 1 a bare function type, 2 a `(proc, rawptr data)`
// pair, 3 a `Sink`; 0 none.
u8 cb_form(^World w, u32 ty):
    u32 r = w.t.resolve(ty)
    if r == NONE: return 0
    if w.t.tag[r] == types.T_FUNC: return 1
    if w.t.tag[r] != types.T_TUPLE: return 0
    []u32 sl = w.t.slots(r)
    if #len(sl) != 2 || w.t.resolve(sl[1]) != u32(types.P_RAWPTR): return 0
    u32 pr = w.t.resolve(sl[0])
    if pr == NONE || w.t.tag[pr] != types.T_FUNC: return 0
    []u32 pp = w.t.params(pr)
    if w.t.b[pr] == types.F_NONE && w.t.resolve(w.t.a[pr]) == u32(types.P_I64) && #len(pp) == 3 && w.t.resolve(pp[0]) == u32(types.P_RAWPTR) && w.t.resolve(pp[1]) == u32(types.P_RAWPTR) && w.t.resolve(pp[2]) == u32(types.P_I64): return 3
    return 2

// A callback's function type, its parameters past a pair's `data`.
u32 cb_fn(^World w, u32 ty):
    u32 r = w.t.resolve(ty)
    if w.t.tag[r] == types.T_FUNC: return r
    return w.t.resolve(w.t.slots(r)[0])

private bool cb_scalar(^World w, u32 t):
    u8 k = seam_kind(w, t, false)
    return k == SK_INT || k == SK_FLOAT || k == SK_BOOL || k == SK_C32 || k == SK_C16 || sk_str(k)

// Why callback type `ty` does not cross ("" when it does); `part` the
// Dado type that does not.
string8 cb_refused(^World w, u32 ty, ^u32 part):
    u8 f = cb_form(w, ty)
    if f == 3: return ""
    u32 fr = cb_fn(w, ty)
    []u32 pp = w.t.params(fr)
    i64 from = 0
    if f == 2:
        if #len(pp) == 0 || w.t.resolve(pp[0]) != u32(types.P_RAWPTR): return "a `(proc, data)` pair carries a script's function when its procedure takes the `rawptr data` first, as a `Sink` and an allocator do"
        from = 1
    for p in pp[from..<#len(pp)]:
        if !cb_scalar(w, p):
            part^ = p
            return CB_PART
    u32 rt = w.t.a[fr]
    if rt != u32(types.P_VOID) && !cb_scalar(w, rt):
        part^ = rt
        return CB_PART
    return ""

private const string8 CB_PART = "a script's function Dado calls takes scalars — a sized integer, `f32`, `f64`, `bool`, a character or a `string8` — and answers one or nothing"

// A callback's script parameters (`ps`) and answer.
u32 cb_script(^World w, u32 ty, ^ref []u32 ps):
    if cb_form(w, ty) == 3:
        ps^ = #append(ps^, w.sstr)
        return u32(types.P_VOID)
    u32 fr = cb_fn(w, ty)
    []u32 pp = w.t.params(fr)
    i64 from = 1 if cb_form(w, ty) == 2 else 0
    for p in pp[from..<#len(pp)]:
        ps^ = #append(ps^, sk_script(w, seam_kind(w, p, false)))
    if w.t.a[fr] == u32(types.P_VOID): return u32(types.P_VOID)
    return sk_script(w, seam_kind(w, w.t.a[fr], false))

// A script's function given to Dado parameter `pn` of `fname` (a lambda):
// its value, or NONE having said ERR1201.
private u32 s_cb_arg(^World w, ^Body b, u32 g, string8 fname, string8 pn, u32 pt):
    syntax.Ast a = tree(w, b)
    ref []u32 ps
    u32 rt = cb_script(w, pt, &ps)
    // A method of the class: `m` or `self.m`, bound to `self`.
    u32 m = NONE
    if a.tag[g] == syntax.E_NAME && find_local(w, b, w.p.sym(b.file, g), false) == NONE: m = s_method_of(w, b, w.p.sym(b.file, g))
    if a.tag[g] == syntax.E_FIELD && a.tag[a.a[g]] == syntax.E_NAME && spell(w, b, a.a[g]) == "self": m = s_method_of(w, b, w.p.sym(b.file, g))
    if a.tag[g] != syntax.E_LAMBDA && (m == NONE || resolve(w, m) == NONE):
        err(w, b, g, 1, "this crossing is outside the slice the port builds so far")
        return NONE
    ref []u32 gps
    u32 gret = u32(types.P_VOID)
    if m != NONE:
        gps = s_mparams(w, resolve(w, m))
        gret = w.t.a[resolve(w, m)]
    else:
        []u32 lks = a.list(a.b[g])
        for q in lks[2..<#len(lks)]:
            u32 t = resolve_type(w, b.file, a.a[q])
            if t == NONE: return NONE
            gps = #append(gps, t)
        if lks[0] != NONE: gret = resolve_type(w, b.file, lks[0])
    bool same = gret == rt && #len(gps) == #len(ps)
    for i in 0..<#len(ps):
        if same && gps[i] != ps[i]: same = false
    if !same:
        ref []string8 ws
        ref []string8 gs
        ref []string8 ls
        [4]string8 nms = ["x", "y", "z", "w"]
        for i in 0..<#len(ps):
            ws = #append(ws, shown(w, ps[i]))
            string8 vn = "v"
            if i < 4: vn = nms[i]
            ls = #append(ls, index.hold(#format(shown(w, ps[i]), " ", vn)))
        for p in gps:
            gs = #append(gs, shown(w, p))
        string8 sp = index.hold(#format(shown(w, rt), "(", strings.join(ws[:], ", "), ")"))
        err(w, b, g, 1201, index.hold(#format("`", fname, "`'s parameter `", pn, "` is a Dado `", shown(w, pt), "`, which takes a script's function of type `", sp, "`, and this is `", shown(w, gret), "(", strings.join(gs[:], ", "), ")`")), index.hold(#format("pass a `", sp, "` — a lambda, `", shown(w, rt), "(", strings.join(ls[:], ", "), "): …`, or a method of that type")))
        return NONE
    for nm in CB_RT:
        _ = seam_rt(w, nm)
    if m == NONE: return s_lambda_value(w, b, g, gps[:], gret)
    Val sv = s_self(w, b, g)
    if sv.ty == NONE: return NONE
    u32 t = temp(w, b, u32(types.P_RAWPTR), g)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SPROP, u32(types.P_RAWPTR), g, t, NONE, NONE, 1)
    ir.arg(&b.f, sv.opd)
    ir.arg(&b.f, ir.konst(w.k.str(&w.t, name_of(w, w.decls[m].name))))
    return t

// What a callback's glue calls, from `core:script`.
const [14]string8 CB_RT = ("thunk_entered", "thunk_left", "take_callback", "drop_callback", "take_bare_callback", "callback_begin", "callback_begin_bare", "callback_call", "callback_failed", "callback_end", "give_bytes", "read_int", "read_float", "free_value")

// Rust's escape check (`script_callbacks`), once every body is checked: a
// bound function keeping a script's function past the call — a bare one is
// ERR1220, a pair is kept (`w.cb_kept`).
void cb_escapes(^World w):
    for d in w.bound:
        u32 ft = resolve(w, d)
        if ft == NONE: continue
        []u32 ps = w.t.params(ft)
        for i in 0..<#len(ps):
            if seam_kind(w, ps[i], false) != SK_CB: continue
            u32 at = cb_esc(w, d, u32(i))
            if at == NONE: continue
            if cb_form(w, ps[i]) != 1:
                w.cb_kept = #append(w.cb_kept, (u64(d) << 32) | u64(i))
                continue
            u32 f = w.decls[d].file
            syntax.Ast a = w.p.files[f].a
            []u32 dks = a.list(a.b[w.decls[d].node])
            string8 nm = name_of(w, w.decls[d].name)
            string8 pn = w.p.spell(f, dks[6 + i])
            say(w, f, 0, a.lo[at], a.hi[at], 1220, index.hold(#format("`", nm, "` keeps its parameter `", pn, "` past the call here, and a script passes it a function: a bare function reference reaches a script's function only during the call that passed it, through a slot the call fills")), index.hold(#format("take a context instead — a `(proc, rawptr data)` pair, `(void(rawptr, …) proc, rawptr data)`, carries a script's function past the call — or call `", pn, "` only while `", nm, "` runs")))

// Where Dado function `d` keeps its parameter `i` past the call, or NONE.
private u32 cb_esc(^World w, u32 d, u32 i):
    u64 key = (u64(d) << 32) | u64(i)
    if key in w.cb_memo:
        try u32 m = w.cb_memo[key] else: return NONE
        return m
    w.cb_memo[key] = NONE
    if w.decls[d].kind != K_FN: return NONE
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    []u32 dks = a.list(a.b[w.decls[d].node])
    if 6 + i64(i) >= #len(dks): return NONE
    ref []string8 names
    names = #append(names, index.hold(strings.clone(w.p.spell(f, dks[6 + i]))))
    ref []u32 seen
    ref []u32 used
    u32 kept = NONE
    cb_walk(w, f, dks[5], &names, &seen, &used, &kept)
    if kept == NONE:
        for x in seen:
            bool u = false
            for y in used:
                if y == x: u = true
            if !u && kept == NONE: kept = x
    w.cb_memo[key] = kept
    return kept

private u32 cb_named(^World w, u32 f, u32 n, ^ref []string8 names):
    syntax.Ast a = w.p.files[f].a
    if n != NONE && a.tag[n] == syntax.E_FIELD: n = a.a[n]
    if n == NONE || a.tag[n] != syntax.E_NAME: return NONE
    for x in names^:
        if x == w.p.spell(f, n): return n
    return NONE

private void cb_walk(^World w, u32 f, u32 n, ^ref []string8 names, ^ref []u32 seen, ^ref []u32 used, ^u32 kept):
    if n == NONE: return
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[n]
    if g == syntax.E_NAME:
        if cb_named(w, f, n, names) != NONE: seen^ = #append(seen^, n)
        return
    if g == syntax.S_LET:
        []u32 lk = a.list(a.b[n])
        u32 v = cb_named(w, f, lk[1], names)
        if v != NONE && a.tag[lk[1]] == syntax.E_NAME:
            used^ = #append(used^, v)
            if a.main[n] != NONE: names^ = #append(names^, index.hold(strings.clone(w.p.files[f].src[i64(w.p.files[f].t.start[a.main[n]])..<i64(w.p.files[f].t.end[a.main[n]])])))
    if g == syntax.E_BINARY:
        string8 op = w.p.files[f].src[i64(w.p.files[f].t.start[a.main[n]])..<i64(w.p.files[f].t.end[a.main[n]])]
        if op == "==" || op == "!=":
            for sd in [a.a[n], a.b[n]]:
                u32 v = cb_named(w, f, sd, names)
                if v != NONE: used^ = #append(used^, v)
    if g == syntax.E_CALL:
        []u32 ck = a.list(a.b[n])
        u32 cv = cb_named(w, f, ck[0], names)
        if cv != NONE:
            used^ = #append(used^, cv)
            for q in ck[2..<#len(ck)]:
                u32 v = cb_named(w, f, a.a[q], names)
                if v != NONE: used^ = #append(used^, v)
        else:
            u32 cd = NONE
            if a.tag[ck[0]] == syntax.E_NAME: cd = lookup(w, w.p.files[f].pkg, w.p.sym(f, ck[0]))
            for k in 2..<#len(ck):
                u32 v = a.a[ck[k]]
                if v == NONE || a.tag[v] != syntax.E_NAME || cb_named(w, f, v, names) == NONE: continue
                if cd != NONE && cb_esc(w, cd, u32(k - 2)) != NONE:
                    if kept^ == NONE: kept^ = v
                else: used^ = #append(used^, v)
    ref []u32 ks
    a.kids(n, &ks)
    for k in ks:
        cb_walk(w, f, k, names, seen, used, kept)

// Why Dado type `ty` does not cross (Rust's `seam_or_refused`), "" when it
// does or is not told here; `step`/`part` the part refused, `rep` the repair.
string8 s_uncross(^World w, u32 ty, bool answer, ^string8 step, ^u32 part, ^string8 rep):
    string8 addr = "nothing a script holds crosses into Dado as an address"
    string8 addr_r = "give the script a Dado function that takes the values the pointer would reach, and call that one"
    u32 r = w.t.resolve(ty)
    if r == NONE || s_class_of_ty(w, ty) != NONE: return ""
    if s_dunion(w, ty) != NONE:
        u32 up = NONE
        string8 uw = s_union_refused(w, ty, &up)
        if #len(uw) == 0: return ""
        if up == NONE:
            rep^ = "make the members of the union distinct types — `distinct type Meters: f32` beside `distinct type Seconds: f32` — and the script tells them apart by those"
            return uw
        []u32 ums = w.t.list(r)
        for k in 0..<#len(ums):
            if ums[k] == up: return s_unelem(w, up, index.hold(#format("whose member ", k, " is")), step, part, rep)
    u32 dd = s_ddist(w, ty)
    if dd != NONE: return s_uncross(w, w.t.b[dd], answer, step, part, rep)
    u8 g = w.t.tag[r]
    if g == types.T_SOA:
        u32 lane = s_soa_lane(w, r)
        if lane == NONE: return ""
        step^ = "whose lane is"
        part^ = lane
        rep^ = "copy it into an array of its elements, `[N]P`, in Dado, and pass that"
        return "no lane may hold a container"
    if answer && g == types.T_FUNC && fnv_sty(w, r) == NONE:
        rep^ = "answer a function over values that cross, or call it in Dado and answer what it answers"
        return "a function value crosses only when its parameters and answer cross as values"
    if r == types.STRING16 || r == types.STRING32 || r == types.CSTRING: return ""
    if g == types.T_PRIM:
        if r == u32(types.P_RAWPTR):
            rep^ = addr_r
            return addr
        return ""
    if r == types.STRING8 || g == types.T_SLICE && w.t.a[r] == u32(types.P_CHAR8) && !answer: return ""
    if g == types.T_REF:
        u32 h = w.t.resolve(w.t.a[r])
        if answer && h != NONE && w.t.tag[h] == types.T_SLICE:
            if w.t.a[h] == u32(types.P_CHAR8): return ""
            return s_unelem(w, w.t.a[h], "whose element is", step, part, rep)
        rep^ = "pass the values themselves — a slice, an array or a tuple of them; a new string or a new array is answered as `ref([]char8)` or `ref([]T)`"
        return "a script holds no Dado allocation to hand over or to end"
    if g == types.T_PTR:
        u32 to = w.t.resolve(w.t.a[r])
        if to != NONE && w.t.tag[to] == types.T_SLICE:
            rep^ = "take the `[]T` itself and answer the array it should become, as a `ref([]T)`, and let the script assign it"
            return "a script's array crosses as a copy for the call, and nothing a script holds crosses into Dado as an address: a copy written back through `^[]T` is not built"
        rep^ = addr_r
        return addr
    if g == types.T_SLICE: return s_unelem(w, w.t.a[r], "whose element is", step, part, rep)
    if g == types.T_MAP:
        string8 k = s_unelem(w, w.t.a[r], "whose key is", step, part, rep)
        if #len(k) > 0: return k
        u32 kr = w.t.resolve(w.t.a[r])
        if !(kr != NONE && w.t.tag[kr] == types.T_PRIM && kr != u32(types.P_F32) && kr != u32(types.P_F64) || kr == types.STRING8):
            if #len(step^) == 0:
                step^ = "whose key is"
                part^ = w.t.a[r]
            rep^ = "key the map by one of those, or pass its keys and its values as two arrays"
            return "a map crosses keyed by an integer, `bool`, string or enum"
        return s_unelem(w, w.t.b[r], "whose value is", step, part, rep)
    if g == types.T_TUPLE:
        []u32 ss = w.t.list(r)
        bool one = #len(ss) >= 2
        for x in ss:
            if x != ss[0]: one = false
        if one: return s_unelem(w, ss[0], "whose element is", step, part, rep)
        for k in 0..<#len(ss):
            string8 why = s_unelem(w, ss[k], index.hold(#format("whose slot ", k, " is")), step, part, rep)
            if #len(why) > 0: return why
    return ""

// An element of a container: `step` names where.
private string8 s_unelem(^World w, u32 e, string8 st, ^string8 step, ^u32 part, ^string8 rep):
    u32 r = w.t.resolve(e)
    string8 why = ""
    if s_class_of_ty(w, e) != NONE:
        why = "a script's instance crosses as its handle by itself, and a container of handles does not cross yet"
        rep^ = "take or answer one handle at a time, or give the script a Dado function that takes the instances one by one"
    else if r != NONE && w.t.tag[r] == types.T_REF:
        why = "a script holds no Dado allocation, and a `ref` crosses only whole, as the answer, where the glue copies it and ends it"
        rep^ = "answer the values themselves — a slice or an array of them — or the whole `ref([]T)`"
    else: why = s_uncross(w, e, false, step, part, rep)
    if #len(why) > 0 && #len(step^) == 0:
        step^ = st
        part^ = e
    return why

// A Dado type with a narrow integer slot constructed in a script: built over
// its view (each such slot the script's `int`), wrapping only as it crosses
// back (Rust's; `script_views`' `Rgb(1, 255, 300)`). NONE-typed when it does
// not apply (named arguments, no narrow slot).
Val s_view_make(^World w, ^Body b, u32 n, u32 td, ^bool done):
    syntax.Ast a = tree(w, b)
    if ds_at(w, w.decls[td].file, w.decls[td].node): return bad()
    u32 ty = resolve(w, td)
    if ty == NONE || !s_tup(w, ty): return bad()
    []u32 ss = w.t.slots(ty)
    bool narrow = false
    for x in ss:
        u32 r = w.t.resolve(x)
        if r >= u32(types.P_I8) && r <= u32(types.P_U32) && r != u32(types.P_I64): narrow = true
    []u32 ks = a.list(a.b[n])
    []u32 args = ks[2..<#len(ks)]
    if !narrow || #len(args) != #len(ss): return bad()
    for g in args:
        if g == NONE || a.main[g] != NONE: return bad()
    done^ = true
    u32 vt = s_sview(w, ty)
    []u32 vs = w.t.slots(vt)
    ref []u32 opds
    for i in 0..<#len(args):
        u32 g = a.a[args[i]]
        Val v = coerce(w, b, expr(w, b, g, vs[i]), vs[i], g)
        if v.ty == NONE: return bad()
        opds = #append(opds, v.opd)
    u32 t = temp(w, b, ty, n)
    _ = ir.op(&b.f, ir.O_MAKE, 0, ty, n, t, NONE)
    for x in opds:
        ir.arg(&b.f, x)
    return value(t, ty)
