// A prefix C, POSIX or this compiler reserves; `follow` 1: a lowercase
// letter must come next, 2: an uppercase one.
type Prefix:
    string8 prefix
    u8 follow
    string8 owner

const [16]Prefix PREFIXES = (
    Prefix("dado_", 0, "this compiler"),
    Prefix("DADO_", 0, "this compiler"),
    Prefix("atomic_", 1, "C11's `<stdatomic.h>`"),
    Prefix("memory_order_", 1, "C11's `<stdatomic.h>`"),
    Prefix("ATOMIC_", 2, "C11's `<stdatomic.h>`"),
    Prefix("cnd_", 1, "C11's `<threads.h>`"),
    Prefix("mtx_", 1, "C11's `<threads.h>`"),
    Prefix("thrd_", 1, "C11's `<threads.h>`"),
    Prefix("tss_", 1, "C11's `<threads.h>`"),
    Prefix("aio_", 0, "POSIX's `<aio.h>`"),
    Prefix("lio_", 0, "POSIX's `<aio.h>`"),
    Prefix("mq_", 0, "POSIX's `<mqueue.h>`"),
    Prefix("posix_", 0, "POSIX, for all of its headers"),
    Prefix("pthread_", 0, "POSIX's `<pthread.h>`"),
    Prefix("sched_", 0, "POSIX's `<sched.h>`"),
    Prefix("sem_", 0, "POSIX's `<semaphore.h>`"),
)

const string8 REPLACES = "an export is defined at file scope of the one translation unit that also holds Dado's runtime and every included header, so it replaces the library's symbol for the whole program — the runtime's own calls included — or collides with the header's declaration of it"

// Who reserves C symbol `s`, or ""; `why` is the consequence and `lib`
// whether a library owns it.
string8 reserved_by(string8 s, ^string8 why, ^bool lib):
    lib^ = false
    if #len(s) > 1 && s[0] == '_':
        why^ = "the C implementation may already define it, as a symbol or as a macro, and a program that does too has undefined behaviour"
        if s[1] == '_' || s[1] >= 'A' && s[1] <= 'Z': return "C11's reserved-identifier rule (7.1.3), which reserves every identifier beginning `__` or `_` and an uppercase letter to the implementation for any use"
        return "C11's reserved-identifier rule (7.1.3), which reserves every identifier beginning `_` at file scope to the implementation — and file scope is where an export is defined"
    for k in C_KEYWORDS:
        if k == s:
            why^ = "C cannot parse a function named by a keyword, so the emitted C does not compile"
            return "C, which spells it as a keyword"
    for l in LIBS:
        i64 at = 0
        for at <= #len(l.names):
            i64 e = at
            for e < #len(l.names) && l.names[e] != ' ':
                e += 1
            if l.names[at..<e] == s:
                why^ = REPLACES
                lib^ = true
                return index.hold(#format(l.standard, "'s `", l.header, "`"))
            at = e + 1
    for p in PREFIXES:
        i64 n = #len(p.prefix)
        if #len(s) < n || s[0..<n] != p.prefix: continue
        if p.follow != 0 && (#len(s) == n || p.follow == 1 && !(s[n] >= 'a' && s[n] <= 'z') || p.follow == 2 && !(s[n] >= 'A' && s[n] <= 'Z')): continue
        bool ours = p.owner == "this compiler"
        lib^ = !ours
        why^ = REPLACES
        if ours: why^ = "the symbol can be one the emitter already defines — a mangled function of some package, a shape, a runtime helper or a macro — and the second definition lands somewhere nobody wrote it"
        return index.hold(#format(p.owner, ", which reserves the prefix `", p.prefix, "`"))
    return ""

// ERR1007: an export's C name is someone else's.
void export_name(^World w, u32 d):
    u32 f = w.decls[d].file
    string8 s = name_of(w, w.decls[d].name)
    if w.decls[d].kind == K_FN && templated(w, d):
        w.d.phase = diag.PH_INTERFACE
        syntax.Ast a = w.p.files[f].a
        for q in params(w, d):
            if q == NONE || a.tag[q] != syntax.N_PARAM: continue
            u32 td = using_decl(w, f, a.a[q])
            if td == NONE || w.decls[td].kind != K_TRAIT || name_of(w, w.decls[td].name) != "Allocator" || w.p.pkgs[w.decls[td].pkg].key != "core:mem": continue
            string8 pn = w.p.spell(f, q)
            say_tok(w, f, 0, w.decls[d].node, 1005, index.hold(#format("`", s, "` is a template, and `export` promises one C symbol: its parameter `", pn, "` is written as the `Allocator` trait, which is a binder — one function per implementer — and a trait never crosses to C")), index.hold(#format("take the two words the trait's `data()` answers — `(rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) ", pn, "` — which C can hand over, and which a Dado caller's implementer converts to")))
            return
        say_tok(w, f, 0, w.decls[d].node, 1005, index.hold(#format("`", s, "` is a template, and `export` promises one C symbol: a template has one function per set of bindings and so no single name to promise")), "")
        return
    string8 why = ""
    bool lib = false
    string8 by = reserved_by(s, &why, &lib)
    if #len(by) == 0: return
    i64 u = 0
    for u < #len(s) && s[u] == '_':
        u += 1
    string8 pkg = name_of(w, w.p.pkgs[w.decls[d].pkg].name)
    string8 renamed = index.hold(#format(pkg, "_", s[u..<#len(s)]))
    string8 w2 = ""
    bool l2 = false
    string8 again = reserved_by(renamed, &w2, &l2)
    if #len(again) > 0: renamed = index.hold(#format("mylib_", s[u..<#len(s)]))
    string8 help = index.hold(#format("give the export a prefix — `", renamed, "` — or drop `export` and export an alias: `export const <its function type> ", renamed, " = ", s, "`"))
    if w.decls[d].kind == K_CONST: help = index.hold(#format("export the alias under a name nobody reserves, such as `", renamed, "`"))
    if lib: why = index.hold(#format(why, ". To call C's own `", s, "`, declare it in a `foreign` block, which this does not touch"))
    w.d.phase = diag.PH_INTERFACE
    say_tok(w, f, 0, w.decls[d].node, 1007, index.hold(#format("`", s, "` is reserved as a C symbol by ", by)), help, why)

// What `export` may stand on, and the names an export may not claim (ERR1005,
// ERR1007, ERR0901 for an untyped alias).
void export_rules(^World w):
    ref []u32 fns
    ref []u32 by
    for d in 0..<#len(w.decls):
        u32 f = w.decls[d].file
        if index.collection_key(w.p.pkgs[w.decls[d].pkg].key): continue
        syntax.Ast a = w.p.files[f].a
        u32 n = w.decls[d].node
        u8 k = w.decls[d].kind
        if k == K_FFN: continue
        if (a.a[n] & syntax.F_VIS) != syntax.VIS_EXPORT: continue
        w.d.phase = diag.PH_INTERFACE
        string8 nm = name_of(w, w.decls[d].name)
        string8 what = ""
        if k == K_TYPE || k == K_FSTRUCT || k == K_UNION || k == K_TRAIT: what = "a type"
        if k == K_ENUM: what = "an enum"
        if k == K_VAR: what = "a package-level variable"
        if #len(what) > 0:
            say_tok(w, f, 0, n, 1005, index.hold(#format("`export` is legal on a function and on a `const` alias of one, and not on ", what)), "drop `export`")
            continue
        if k == K_FN && nm == "main":
            say_tok(w, f, 0, n, 1007, "`main` is the C entry point, which the main package's `main` already emits: an export cannot claim it", "")
            continue
        if k == K_FN:
            for x in 0..<#len(w.decls):
                if w.decls[x].kind == K_FFN && w.t.text(c_name(w, u32(x))) == nm:
                    say_tok(w, f, 0, n, 1007, index.hold(#format("`", nm, "` is a `foreign` name, so C already has that symbol: a second definition of one external name is a link error, which is later and further away than this line")), "")
                    break
            continue
        if k != K_CONST: continue
        []u32 ks = a.list(a.b[n])
        u32 vn = ks[1]
        u32 fd = NONE
        if vn != NONE && a.tag[vn] == syntax.E_NAME:
            u32 x = lookup(w, w.decls[d].pkg, w.p.sym(f, vn))
            if x != NONE && w.decls[x].kind == K_FN: fd = x
        if fd == NONE:
            say_tok(w, f, 0, n, 1005, index.hold(#format("`export const ", nm, "` names a value and not a function: a constant emits no storage, so the only thing an exported one can be is another name for a function's body")), "")
            continue
        if ks[0] == NONE:
            u32 ft = resolve(w, fd)
            say(w, f, 0, a.lo[vn], a.hi[vn], 901, index.hold(#format("`", nm, "` has no type written, so it is a **literal**, and a function reference is not a literal in that sense")), index.hold(#format("write the type: `const ", shown(w, ft), " ", nm, " = ...`")), "A literal adapts to wherever it is used, and a function reference denotes one function, with one signature, and nothing at a use could adapt")
        for i in 0..<#len(fns):
            if fns[i] == fd:
                say_tok(w, f, 0, n, 1007, index.hold(#format("`", name_of(w, w.p.pkgs[w.decls[fd].pkg].name), ".", name_of(w, w.decls[fd].name), "` is already exported as `", name_of(w, w.decls[by[i]].name), "`: one body emits one definition, so it carries one unmangled name — the second export wants a symbol C cannot portably alias")), "")
                break
        fns = #append(fns, fd)
        by = #append(by, u32(d))
