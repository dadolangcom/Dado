// `#soa [N]T`: one run per slot of `T` (a lane), N long; `#aos` is inert.
// Indexed and measured as the `[N]T` it holds; a whole run, an element's
// address and slotwise operators are refused.
package check

import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"

u32 layout_type(^World w, u32 f, u32 n):
    syntax.Ast a = w.p.files[f].a
    string8 s = w.p.spell(f, n)
    if s != "#soa" && s != "#aos":
        if builtin(s) < 0: say_tok(w, f, 0, n, 417, index.hold(#format("`", s, "` is written where a **layout** goes, and it is not a `#` name the compiler owns at all")), "write `#soa` or `#aos`, or no layout at all", "a layout is written in front of the type it qualifies: `#soa` transposes a fixed array into one run per slot, and `#aos` is the arrangement every `[N]T` already has, written down. the compiler's `#lower` names are #default #stack #return #caller #heap #make #new #delete #resize #copy #format #len #size #alignof #assert #expect #breakpoint #transpose #render #append #reserve #cap #truncate #popcount #clz #ctz #bswap #add_fits #sub_fits #mul_fits #is_int #is_float #is_number #is_bool #is_char #is_string #is_slice #is_map #is_ref #is_pointer #has_eq #is_key #is_declared #mul_wide #panic #rotl #rotr #align_forward #atomic_load #atomic_store #atomic_exchange #atomic_compare_exchange #atomic_fetch_add #atomic_fetch_sub #atomic_fetch_and #atomic_fetch_or #atomic_fetch_xor #fence #soa #aos #no_bounds #slots #any #names #spell #static_assert #assert_raises #channel #send #peek #drain #shader_load #script_vm #script_run #script_new #script_stop #script_pause #script_resume #script_is_running #script_is_paused #script_pump #script_reload #script_error #trace #location #release")
        else: say_tok(w, f, 0, n, 417, index.hold(#format("`", s, "` is a name the compiler owns and it is not a **layout**, which is what goes in front of a type")), index.hold(#format("`", s, "` is written somewhere else — read what it is for and put it there")), "a name written in front of a type qualifies how that type is laid out, and the layouts are #soa and #aos")
        return NONE
    u32 e = resolve_type(w, f, a.a[n])
    if e == NONE || s == "#aos": return e
    u32 el = NONE
    i64 k = 0
    if !w.t.uniform(e, &el, &k):
        say(w, f, 0, a.lo[n], a.hi[n], 504, index.hold(#format("`#soa` transposes a fixed array of more than one element into one run per slot, and `", shown(w, e), "` is not one")), "write it over `[N]T`", "There is nothing here to interleave, so the tag would change no byte and refuse every assignment. A slice's length is in the value and is not part of its type, so it has no arity to transpose")
        return NONE
    return w.t.make(types.T_SOA, e, 0, nil)

// The `#soa` row under names, qualifiers and tags, or NONE.
u32 soa_row(^types.Types t, u32 ty):
    u32 x = ty
    for _ in 0..<64:
        if x == NONE: return NONE
        u8 g = t.tag[x]
        if g == types.T_SOA: return x
        if g == types.T_NAMED: x = t.body[x]
        else if g == types.T_QUAL || g == types.T_DISTINCT: x = t.b[x]
        else: return NONE
    return NONE

bool is_soa(^World w, u32 ty):
    return ty != NONE && soa_row(&w.t, ty) != NONE

// `s.x` over a `#soa`: ERR0525 at the base.
bool soa_run_named(^World w, ^Body b, u32 n, u32 ty):
    if !is_soa(w, ty): return false
    string8 s = spell(w, b, n)
    err(w, b, tree(w, b).a[n], 525, index.hold(#format(shown(w, ty), " holds one run per slot, so `", s, "` here would name a whole **run** and not a slot of anything")), index.hold(#format("subscript first: `s[i].", s, "` is the one value, `&s[i].", s, "` is its address")), "A subscript names the element first, and a loop over the elements is how the run is read. The mark is the whole of what refuses this, and a `distinct` over it changes nothing")
    return true

u32 soa_elem(^World w, u32 ty):
    u32 el = NONE
    i64 k = 0
    _ = w.t.uniform(w.t.a[soa_row(&w.t, ty)], &el, &k)
    return el

// The `#soa` type whose element place `x` names whole (its last step
// indexes the `#soa`, whose element is a tuple), or NONE.
u32 soa_whole(^World w, ^ir.Fn f, u32 x):
    u32 t = before_last(w, f, x)
    if t == NONE || f.step[f.phi[x] - 1] != ir.ST_INDEX || !is_soa(w, t): return NONE
    u32 er = w.t.resolve(soa_elem(w, t))
    return t if er != NONE && w.t.tag[er] == types.T_TUPLE else NONE

// The type of place `x` before its last step, or NONE (no steps).
u32 before_last(^World w, ^ir.Fn f, u32 x):
    if x == NONE || ir.is_const(x) || f.plo[x] == f.phi[x]: return NONE
    u32 r = f.root[x]
    u32 t = f.glob_ty[r & ~ir.ROOT_GLOBAL] if (r & ir.ROOT_GLOBAL) != 0 else f.slot_ty[r]
    for j in f.plo[x]..<f.phi[x] - 1:
        u8 st = f.step[j]
        if st == ir.ST_FIELD: t = slot_ty(&w.t, t, f.step_val[j])
        else if st == ir.ST_INDEX:
            Run k = run_shape(w, t)
            if k.kind != RK_ONE: t = k.elem
        else: t = w.t.a[w.t.resolve(t)]
    return t

// The bit width of the foreign bitfield place `x` names, or -1.
i64 bits_of(^World w, ^ir.Fn f, u32 x):
    u32 t = before_last(w, f, x)
    if t == NONE || f.step[f.phi[x] - 1] != ir.ST_FIELD: return -1
    return field_bits(w, t, f.step_val[f.phi[x] - 1])

i64 field_bits(^World w, u32 t, u32 i):
    u32 x = w.t.bare(t)
    for _ in 0..<16:
        if x == NONE || w.t.tag[x] != types.T_NAMED: return -1
        u64 key = (u64(x) << 32) | u64(i)
        if key in w.cwidth:
            try u32 bw = w.cwidth[key] else: return -1
            return i64(bw)
        x = w.t.body[x]
    return -1

// `v` stored into a bitfield of `bw` bits: a constant that does not fit is
// ERR1023, else a dev build checks it (`#no_bounds` waives it).
void bits_store(^World w, ^Body b, Val v, u32 ty, i64 bw, u32 at, bool waived):
    bool sg = int_prim(w, ty) != types.PRIMS && types.is_signed(int_prim(w, ty))
    i64 hi = (i64(1) << u64(bw - 1)) - 1 if sg else i64((u64(1) << u64(bw)) - 1)
    i64 lo = -(i64(1) << u64(bw - 1)) if sg else 0
    if bw >= 64 || w.t.resolve(ty) == u32(types.P_BOOL): return
    if ir.is_const(v.opd):
        u32 c = v.opd & ~ir.OPD_CONST
        if w.k.kind[c] != types.C_INT: return
        i64 x = i64(w.k.w0[c])
        if !sg && i64(w.k.w1[c]) == 0 && w.k.w0[c] <= u64(hi) || sg && x >= lo && x <= hi: return
        err(w, b, at, 1023, index.hold(#format("`", spell_src(w, b, at), "` does not fit ", bw, " bits: a bitfield that wide holds ", lo, "..", hi, ", and C would store the low ", bw, " bits of this and say nothing")))
        return
    if waived: return
    _ = ir.op(&b.f, ir.O_CHECK, ir.CK_BITS, ty, at, NONE, v.opd, ir.konst(w.k.small(&w.t, bw)))

string8 spell_src(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    return w.p.files[b.file].src[i64(a.lo[n])..<i64(a.hi[n])]
