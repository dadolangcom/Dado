// The math intrinsics: one row each, generic over
// `f32`/`f64` (`#abs`, `#min`, `#max` also over integers). Constant
// arguments always fold, with the host's libm; otherwise C calls libm.
package check

import "language:index"
import "language:ir"
import "language:types"

type MathRow:
    string8 name
    u8 arity
    bool ints
    // C (libm; `f` appended for `f32`), JS, the DadoScript global.
    string8 c
    string8 js
    string8 ds

const [29]MathRow MATH = (MathRow("#sin", 1, false, "sin", "Math.sin", "sin"), MathRow("#cos", 1, false, "cos", "Math.cos", "cos"), MathRow("#tan", 1, false, "tan", "Math.tan", "tan"), MathRow("#asin", 1, false, "asin", "Math.asin", "asin"), MathRow("#acos", 1, false, "acos", "Math.acos", "acos"), MathRow("#atan", 1, false, "atan", "Math.atan", "atan"), MathRow("#atan2", 2, false, "atan2", "Math.atan2", "atan2"), MathRow("#sinh", 1, false, "sinh", "Math.sinh", "sinh"), MathRow("#cosh", 1, false, "cosh", "Math.cosh", "cosh"), MathRow("#tanh", 1, false, "tanh", "Math.tanh", "tanh"), MathRow("#asinh", 1, false, "asinh", "Math.asinh", "asinh"), MathRow("#acosh", 1, false, "acosh", "Math.acosh", "acosh"), MathRow("#atanh", 1, false, "atanh", "Math.atanh", "atanh"), MathRow("#pow", 2, false, "pow", "Math.pow", "pow"), MathRow("#sqrt", 1, false, "sqrt", "Math.sqrt", "sqrt"), MathRow("#cbrt", 1, false, "cbrt", "Math.cbrt", "cbrt"), MathRow("#exp", 1, false, "exp", "Math.exp", "exp"), MathRow("#exp2", 1, false, "exp2", "2 ** ", "exp2"), MathRow("#log", 1, false, "log", "Math.log", "log"), MathRow("#log2", 1, false, "log2", "Math.log2", "log2"), MathRow("#log10", 1, false, "log10", "Math.log10", "log10"), MathRow("#fma", 3, false, "fma", "", "fma"), MathRow("#floor", 1, false, "floor", "Math.floor", "floor"), MathRow("#ceil", 1, false, "ceil", "Math.ceil", "ceil"), MathRow("#round", 1, false, "round", "", "round"), MathRow("#trunc", 1, false, "trunc", "Math.trunc", "trunc"), MathRow("#abs", 1, true, "fabs", "Math.abs", "abs"), MathRow("#min", 2, true, "fmin", "Math.min", "min"), MathRow("#max", 2, true, "fmax", "Math.max", "max"))

// dst = MATH[sub - B_MATH](args…), over `ty`.
const u8 B_MATH = 100

i64 math_row(string8 s):
    for i in 0..<#len(MATH):
        if MATH[i].name == s: return i
    return -1

// The row of DadoScript global `s`, or -1.
i64 math_global(string8 s):
    for i in 0..<#len(MATH):
        if MATH[i].ds == s: return i
    return -1

Val math_(^World w, ^Body b, u32 n, i64 k):
    MathRow r = MATH[k]
    string8 nm = r.ds if b.ds else r.name
    []u32 args = call_args(w, b, n)
    if #len(args) != i64(r.arity):
        string8 one = "an argument" if r.arity == 1 else index.hold(#format(r.arity, " arguments"))
        err(w, b, n, 601, index.hold(#format("`", nm, "` takes ", one, ", and this passes ", #len(args))))
        return bad()
    ref []Val vs
    u32 ty = NONE
    for g in args:
        Val v = expr(w, b, arg_value(w, b, g), NONE)
        if v.ty == NONE: return bad()
        if v.kind == V_VAL && ty == NONE: ty = v.ty
        vs = #append(vs, v)
    bool lits = ty == NONE
    if lits:
        bool fl = !r.ints
        for v in vs:
            if v.kind == V_FLIT: fl = true
        if !fl:
            i64 x = i64(vs[0].lo)
            if k == 26 && x < 0: x = 0 - x
            for v in vs[1..<#len(vs)]:
                if k == 27 && i64(v.lo) < x || k == 28 && i64(v.lo) > x: x = i64(v.lo)
            return Val(V_LIT, NONE, w.untyped, NONE, u64(x), -1 if x < 0 else 0)
        ref []f64 xs
        for v in vs:
            xs = #append(xs, lit_f(v))
        return Val(V_FLIT, NONE, w.untyped, NONE, fbits(fold64(k, xs[:])), 0)
    if !is_float(w, ty) && !(r.ints && is_int(w, ty)):
        string8 what = "a float — `f32` or `f64` — or an integer" if r.ints else "a float, `f32` or `f64`"
        if b.ds: what = "a `float` or an `int`" if r.ints else "a `float`"
        err(w, b, arg_value(w, b, args[0]), 504, index.hold(#format("`", nm, "` takes ", what, "; this is ", shown(w, ty))))
        return bad()
    ref []u32 ops
    bool folds = true
    for i in 0..<#len(vs):
        u32 vn = arg_value(w, b, args[i])
        Val c = coerce(w, b, vs[i], ty, vn)
        if c.ty == NONE: return bad()
        if !ir.is_const(c.opd): folds = false
        ops = #append(ops, c.opd)
    if folds && is_float(w, ty):
        ref []f64 xs
        for x in ops:
            xs = #append(xs, fval(w.k.w0[x & ~ir.OPD_CONST]))
        f64 y = fold64(k, xs[:])
        if float_bits(w, ty) == 32: y = f64(fold32(k, xs[:]))
        return value(ir.konst(fconst(w, y, ty)), ty)
    if folds:
        i64 x = i64(w.k.w0[ops[0] & ~ir.OPD_CONST])
        if k == 26 && x < 0: x = 0 - x
        for o in ops[1..<#len(ops)]:
            i64 y = i64(w.k.w0[o & ~ir.OPD_CONST])
            if k == 27 && y < x || k == 28 && y > x: x = y
        Val lv = Val(V_LIT, NONE, w.untyped, NONE, u64(x), -1 if x < 0 else 0)
        b.wrapping = true
        Val cv = coerce(w, b, lv, ty, n)
        b.wrapping = false
        return cv
    u32 t = temp(w, b, ty, n)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_MATH + u8(k), ty, n, t, NONE)
    for x in ops:
        ir.arg(&b.f, x)
    return value(t, ty)

private f64 fold64(i64 k, []f64 x):
    if k == 0: return sin(x[0])
    if k == 1: return cos(x[0])
    if k == 2: return tan(x[0])
    if k == 3: return asin(x[0])
    if k == 4: return acos(x[0])
    if k == 5: return atan(x[0])
    if k == 6: return atan2(x[0], x[1])
    if k == 7: return sinh(x[0])
    if k == 8: return cosh(x[0])
    if k == 9: return tanh(x[0])
    if k == 10: return asinh(x[0])
    if k == 11: return acosh(x[0])
    if k == 12: return atanh(x[0])
    if k == 13: return pow(x[0], x[1])
    if k == 14: return sqrt(x[0])
    if k == 15: return cbrt(x[0])
    if k == 16: return exp(x[0])
    if k == 17: return exp2(x[0])
    if k == 18: return log(x[0])
    if k == 19: return log2(x[0])
    if k == 20: return log10(x[0])
    if k == 21: return fma(x[0], x[1], x[2])
    if k == 22: return floor(x[0])
    if k == 23: return ceil(x[0])
    if k == 24: return round(x[0])
    if k == 25: return trunc(x[0])
    if k == 26: return fabs(x[0])
    if k == 27: return fmin(x[0], x[1])
    return fmax(x[0], x[1])

private f32 fold32(i64 k, []f64 x):
    f32 a = f32(x[0])
    f32 p = 0.0
    f32 q = 0.0
    if #len(x) > 1: p = f32(x[1])
    if #len(x) > 2: q = f32(x[2])
    if k == 0: return sinf(a)
    if k == 1: return cosf(a)
    if k == 2: return tanf(a)
    if k == 3: return asinf(a)
    if k == 4: return acosf(a)
    if k == 5: return atanf(a)
    if k == 6: return atan2f(a, p)
    if k == 7: return sinhf(a)
    if k == 8: return coshf(a)
    if k == 9: return tanhf(a)
    if k == 10: return asinhf(a)
    if k == 11: return acoshf(a)
    if k == 12: return atanhf(a)
    if k == 13: return powf(a, p)
    if k == 14: return sqrtf(a)
    if k == 15: return cbrtf(a)
    if k == 16: return expf(a)
    if k == 17: return exp2f(a)
    if k == 18: return logf(a)
    if k == 19: return log2f(a)
    if k == 20: return log10f(a)
    if k == 21: return fmaf(a, p, q)
    if k == 22: return floorf(a)
    if k == 23: return ceilf(a)
    if k == 24: return roundf(a)
    if k == 25: return truncf(a)
    if k == 26: return fabsf(a)
    if k == 27: return fminf(a, p)
    return fmaxf(a, p)

private foreign "math.h" link "-lm":
    f64 sin(f64 x)
    f64 cos(f64 x)
    f64 tan(f64 x)
    f64 asin(f64 x)
    f64 acos(f64 x)
    f64 atan(f64 x)
    f64 atan2(f64 y, f64 x)
    f64 sinh(f64 x)
    f64 cosh(f64 x)
    f64 tanh(f64 x)
    f64 asinh(f64 x)
    f64 acosh(f64 x)
    f64 atanh(f64 x)
    f64 pow(f64 x, f64 y)
    f64 sqrt(f64 x)
    f64 cbrt(f64 x)
    f64 exp(f64 x)
    f64 exp2(f64 x)
    f64 log(f64 x)
    f64 log2(f64 x)
    f64 log10(f64 x)
    f64 fma(f64 x, f64 y, f64 z)
    f64 floor(f64 x)
    f64 ceil(f64 x)
    f64 round(f64 x)
    f64 trunc(f64 x)
    f64 fabs(f64 x)
    f64 fmin(f64 x, f64 y)
    f64 fmax(f64 x, f64 y)
    f32 sinf(f32 x)
    f32 cosf(f32 x)
    f32 tanf(f32 x)
    f32 asinf(f32 x)
    f32 acosf(f32 x)
    f32 atanf(f32 x)
    f32 atan2f(f32 y, f32 x)
    f32 sinhf(f32 x)
    f32 coshf(f32 x)
    f32 tanhf(f32 x)
    f32 asinhf(f32 x)
    f32 acoshf(f32 x)
    f32 atanhf(f32 x)
    f32 powf(f32 x, f32 y)
    f32 sqrtf(f32 x)
    f32 cbrtf(f32 x)
    f32 expf(f32 x)
    f32 exp2f(f32 x)
    f32 logf(f32 x)
    f32 log2f(f32 x)
    f32 log10f(f32 x)
    f32 fmaf(f32 x, f32 y, f32 z)
    f32 floorf(f32 x)
    f32 ceilf(f32 x)
    f32 roundf(f32 x)
    f32 truncf(f32 x)
    f32 fabsf(f32 x)
    f32 fminf(f32 x, f32 y)
    f32 fmaxf(f32 x, f32 y)
