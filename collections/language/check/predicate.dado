// Type questions: a `where`'s answers (bool, arity, type), `is` in a body,
// `has` operators. Two operands that may each name a declaration compare
// by declaration; otherwise as one type.
package check

import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:strings"

// A `where` value: k 0 not read here, 1 bool, 2 arity, 3 type.
type WV:
    u8 k
    i64 v
    u32 t

private WV no():
    return WV(0, 0, NONE)

// A refusal of the clause itself, said by the caller at `at`.
private WV refuse(^World w, u32 at, u16 code, string8 msg, string8 help):
    w.wr_at = at
    w.wr_code = code
    w.wr_msg = msg
    w.wr_help = help
    return WV(0, 0, NONE)

private const [13]string8 WHERE_WORDS = ("#is_int", "#is_float", "#is_number", "#is_bool", "#is_char", "#is_string", "#is_slice", "#is_map", "#is_ref", "#is_pointer", "#has_eq", "#is_key", "#is_declared")

private bool where_word(string8 s):
    for x in WHERE_WORDS:
        if x == s: return true
    return false

private const [19]string8 HAS_WORDS = ("+", "-", "*", "/", "%", "==", "!=", "<", "<=", ">", ">=", "&&", "||", "!", "&", "|", "~", "&~", "<<")

private bool has_word(string8 s):
    for x in HAS_WORDS:
        if x == s: return true
    return s == ">>"

// A `where` refused where it is declared (ERR0920 and its staged forms):
// an operator `has` cannot ask, a pattern, a value asked, no binding named.
void where_check(^World w, u32 d):
    u32 x = where_of(w, d)
    if x == NONE: return
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u32 at = NONE
    u16 code = 0
    string8 msg = ""
    string8 help = ""
    staged(w, d, x, &at, &code, &msg, &help)
    if at == NONE: asked_value(w, d, x, &at, &code, &msg, &help)
    if at != NONE:
        say(w, f, 0, a.lo[at], a.hi[at], code, msg, help)
        w.where_bad[d] = 1
        return
    []u32 bs = binders(w, d)
    if names_binder(w, d, x): return
    w.where_bad[d] = 1
    string8 fname = name_of(w, w.decls[d].name)
    if #len(bs) == 0:
        say(w, f, 0, a.lo[x], a.hi[x], 920, index.hold(#format("`", fname, "` has no bindings, so there is nothing for a `where` to be about")), "write `$T`, a category word or a `type T` parameter if this is meant to be a template; use `when` if the question is about the build", "A `where` states the **domain** of a template — which shapes a call may bind it at — and a function whose signature is written has exactly one shape already")
        return
    string8 all = ""
    for i in 0..<#len(bs):
        string8 pre = "" if i == 0 else index.hold(#format(all, ", "))
        all = index.hold(#format(pre, "$", name_of(w, bs[i])))
    say(w, f, 0, a.lo[x], a.hi[x], 920, index.hold(#format("this `where` on `", fname, "` names none of the bindings it could be about (", all, ")")), "ask about a binding, or move the question to a `when`")

private bool names_binder(^World w, u32 d, u32 x):
    if x == NONE: return false
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[x]
    if (g == syntax.E_NAME || g == syntax.T_NAME || g == syntax.T_BINDING) && slot_of(w, d, w.p.sym(f, x)) >= 0: return true
    ref []u32 ks
    a.kids(x, &ks)
    for k in ks:
        if names_binder(w, d, k): return true
    return false

private void staged(^World w, u32 d, u32 x, ^u32 at, ^u16 code, ^string8 msg, ^string8 help):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[x]
    if g == syntax.E_UNARY:
        staged(w, d, a.a[x], at, code, msg, help)
        return
    if g == syntax.E_BINARY:
        staged(w, d, a.a[x], at, code, msg, help)
        if at^ == NONE: staged(w, d, a.b[x], at, code, msg, help)
        return
    if g == syntax.E_HAS:
        []u32 ks = a.list(a.b[x])
        if a.a[x] == 1: return
        for q in ks[1..<#len(ks)]:
            string8 s = w.p.spell(f, q)
            if has_word(s): continue
            at^ = q
            code^ = 920
            string8 near = ""
            if #len(s) >= 2 && s[#len(s) - 1] == '=' && has_word(s[0..<#len(s) - 1]): near = index.hold(#format("; `x ", s, " y` is `x = x ", s[0..<#len(s) - 1], " y`, so `has ", s[0..<#len(s) - 1], "` asks it"))
            else if s == "=": near = "; assignment is not something a type provides — every type can be assigned"
            msg^ = index.hold(#format("`", s, "` is not an operator `has` can ask about", near))
            return
        return
    u32 ops = NONE
    if g == syntax.E_IS: ops = a.b[x]
    if g == syntax.E_IN && a.tag[a.b[x]] == syntax.E_TUPLE:
        for q in a.list(a.b[a.b[x]]):
            if a.tag[q] == syntax.E_NAME && w.p.spell(f, q) == "string":
                at^ = q
                code^ = 401
                msg^ = STRING_OPERAND
                return
            if a.tag[q] == syntax.E_NAME && w.p.spell(f, q) == "number":
                at^ = q
                code^ = 401
                msg^ = "`number` is not a category any more; the list after `in` holds types and the categories `int`, `float` and `scalar`, so `scalar` is the member to write"
                return
        return
    if ops == NONE: return
    if a.tag[ops] == syntax.E_NAME && w.p.spell(f, ops) == "string":
        at^ = ops
        code^ = 401
        msg^ = STRING_OPERAND
        return
    if a.tag[ops] == syntax.E_NAME && w.p.spell(f, ops) == "number":
        at^ = ops
        code^ = 401
        msg^ = "`number` is not a category any more: the ten numeric primitives are spelled `scalar`, so `T is scalar` asks it"
        return
    if pattern(w, f, ops):
        at^ = ops
        code^ = 1
        msg^ = index.hold(#format("`", w.p.files[f].src[i64(a.lo[ops])..<i64(a.hi[ops])], "` is a pattern, and patterns are not part of `is` yet"))
        help^ = "ask the constructor with its predicate word — `#is_slice(T)`, `#is_map(T)`, `#is_ref(T)`, `#is_pointer(T)` — or write the whole type"

// Whether written type `n` declares a binding (`$E`).
private bool pattern(^World w, u32 f, u32 n):
    if n == NONE: return false
    syntax.Ast a = w.p.files[f].a
    if a.tag[n] == syntax.T_BINDING: return true
    if a.tag[n] == syntax.E_NAME || a.tag[n] == syntax.E_FIELD: return false
    ref []u32 ks
    a.kids(n, &ks)
    for k in ks:
        if pattern(w, f, k): return true
    return false

// `n is T` over parameter `n` (not a binding): settled before values exist.
private void asked_value(^World w, u32 d, u32 x, ^u32 at, ^u16 code, ^string8 msg, ^string8 help):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[x]
    if g == syntax.E_UNARY:
        asked_value(w, d, a.a[x], at, code, msg, help)
        return
    if g == syntax.E_BINARY:
        asked_value(w, d, a.a[x], at, code, msg, help)
        if at^ == NONE: asked_value(w, d, a.b[x], at, code, msg, help)
        return
    if g != syntax.E_IS || a.tag[a.a[x]] != syntax.E_NAME: return
    u32 sym = w.p.sym(f, a.a[x])
    if slot_of(w, d, sym) >= 0: return
    u32 tn = NONE
    for q in params(w, d):
        if q != NONE && w.p.sym(f, q) == sym: tn = a.a[q]
    if tn == NONE || a.tag[tn] == syntax.T_KIND || a.tag[tn] == syntax.T_PACK || a.tag[tn] == syntax.T_CHANNEL: return
    string8 nm = w.p.spell(f, a.a[x])
    string8 asked = w.p.files[f].src[i64(a.lo[x])..<i64(a.hi[x])]
    bool un = false
    if a.tag[tn] == syntax.T_NAME:
        u32 td = lookup(w, w.p.files[f].pkg, w.p.sym(f, tn))
        un = td != NONE && w.decls[td].kind == K_UNION
    at^ = x
    code^ = 920
    if un:
        msg^ = index.hold(#format("`", asked, "` reads the tag of `", nm, "`, a union parameter, while the program runs, and a `where` is settled before any value exists"))
        help^ = index.hold(#format("ask it in the body: `if ", asked, ":`, or `switch ", nm, ":` with a `case` per member"))
    else:
        msg^ = index.hold(#format("`", asked, "` asks about `", nm, "`, a parameter, and a `where` is settled at each instantiation, before any value exists"))
        help^ = "ask about a binding the type names instead"

private WV yes(bool x):
    return WV(1, 1 if x else 0, NONE)

// `where` expression `x` of template `d` under bindings `env`.
WV wv(^World w, u32 d, u32 x, u32 env):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[x]
    string8 op = w.p.spell(f, x)
    if g == syntax.E_INT && a.b[x] == 0: return WV(2, i64(a.a[x]), NONE)
    if g == syntax.E_UNARY:
        WV o = wv(w, d, a.a[x], env)
        if op == "!" && o.k == 1: return yes(o.v == 0)
        if op == "-" && o.k == 2: return WV(2, -o.v, NONE)
        return no()
    if g == syntax.E_BINARY:
        WV l = wv(w, d, a.a[x], env)
        if l.k == 0: return l
        WV r = wv(w, d, a.b[x], env)
        if r.k == 0 || l.k != r.k: return no()
        if l.k == 1:
            if op == "&&": return yes(l.v != 0 && r.v != 0)
            if op == "||": return yes(l.v != 0 || r.v != 0)
            if op == "==": return yes(l.v == r.v)
            if op == "!=": return yes(l.v != r.v)
            return no()
        if l.k == 3:
            if op == "==": return yes(one_type(w, l.t, r.t, 0))
            if op == "!=": return yes(!one_type(w, l.t, r.t, 0))
            return no()
        if op == "==": return yes(l.v == r.v)
        if op == "!=": return yes(l.v != r.v)
        if op == "<": return yes(l.v < r.v)
        if op == "<=": return yes(l.v <= r.v)
        if op == ">": return yes(l.v > r.v)
        if op == ">=": return yes(l.v >= r.v)
        if op == "+": return WV(2, l.v + r.v, NONE)
        if op == "-": return WV(2, l.v - r.v, NONE)
        if op == "*": return WV(2, l.v * r.v, NONE)
        if (op == "/" || op == "%") && r.v == 0: return no()
        if op == "/": return WV(2, l.v / r.v, NONE)
        if op == "%": return WV(2, l.v % r.v, NONE)
        return no()
    if g == syntax.E_IS:
        WV s = wv(w, d, a.a[x], env)
        if s.k != 3: return no()
        string8 c = w.p.spell(f, a.b[x]) if a.tag[a.b[x]] == syntax.E_NAME || a.tag[a.b[x]] == syntax.T_NAME else ""
        if c == "int" || c == "float" || c == "scalar": return yes(in_cat(w, s.t, c))
        WV t = wv(w, d, a.b[x], env)
        if t.k != 3: return no()
        return yes(same_type(w, f, a.a[x], s.t, a.b[x], t.t))
    if g == syntax.E_IN:
        WV s = wv(w, d, a.a[x], env)
        u32 ln = a.b[x]
        if s.k == 3 && a.tag[ln] != syntax.E_TUPLE:
            string8 one = w.p.files[f].src[i64(a.lo[ln])..<i64(a.hi[ln])]
            return refuse(w, ln, 920, index.hold(#format("`in` in a `where` asks whether a type is one of a **parenthesised list** of types, `T in (i32, i64)`, and `", one, "` is not a list. For one type, `T is ", one, "` asks it")), "")
        if s.k != 3: return no()
        bool found = false
        for q in a.list(a.b[ln]):
            string8 c = w.p.spell(f, q) if a.tag[q] == syntax.E_NAME else ""
            if c == "int" || c == "float" || c == "scalar":
                if in_cat(w, s.t, c): found = true
                continue
            WV t = wv(w, d, q, env)
            if t.k != 3: return no()
            if same_type(w, f, a.a[x], s.t, q, t.t): found = true
        return yes(found)
    if g == syntax.E_HAS:
        []u32 ks = a.list(a.b[x])
        WV s = wv(w, d, ks[0], env)
        if s.k != 3: return no()
        if a.a[x] == 1:
            for q in ks[1..<#len(ks)]:
                u32 td = decl_named(w, f, q)
                if td != NONE && w.decls[td].kind == K_TYPE && w.decls[td].ty != NONE:
                    if !embeds_ty(w, s.t, w.decls[td].ty, 0): return yes(false)
                    continue
                if td == NONE && named_type(w, f, q) == NONE: return refuse(w, q, 920, index.hold(#format("`", w.p.spell(f, q), "` names no type here", "\x1f`has` asks whether operators apply to a type — arithmetic `+ - * / %`; comparison `== != < <= > >=`; logic `&& || !`; bitwise `& | ~ &~ << >>` — each binary operator as `T op T`, with `-` and `~` meaning the binary operators; or, with a name, whether the type's declaration embeds that declared type: `T has Vector2`")), "")
                if td == NONE || w.decls[td].kind != K_TRAIT: return no()
                if !implements(w, s.t, td): return yes(false)
            return yes(true)
        for q in ks[1..<#len(ks)]:
            if !op_applies(w, s.t, w.p.spell(f, q)): return yes(false)
        return yes(true)
    if g == syntax.E_CALL:
        []u32 cs = a.list(a.b[x])
        if #len(cs) < 2 || a.tag[cs[0]] != syntax.E_NAME: return no()
        string8 pn = w.p.spell(f, cs[0])
        if !where_word(pn): return refuse(w, x, 920, index.hold(#format("`", pn, "` is not a `where` predicate", "\x1fThe only call a `where` admits is one of the compiler's own predicate words, because a predicate runs at compile time and a program's function does not run then at all: #is_int #is_float #is_number #is_bool #is_char #is_string #is_slice #is_map #is_ref #is_pointer #has_eq #is_key #is_declared")), "ask with one of the compiler's predicate words, which `--explain` lists")
        if #len(cs) != 3: return no()
        u32 an = a.a[cs[2]] if a.tag[cs[2]] == syntax.E_ARG else cs[2]
        WV t = wv(w, d, an, env)
        if t.k != 3: return no()
        u32 cr = under(&w.t, t.t)
        u8 cp = types.PRIM[w.t.a[cr]].canon if cr != NONE && w.t.tag[cr] == types.T_PRIM && decl_of(w, t.t) == NONE else types.P_VOID
        if pn == "#is_declared": return yes(decl_of(w, t.t) != NONE)
        if pn == "#is_int": return yes(types.in_int(cp))
        if pn == "#is_float": return yes(types.in_float(cp))
        if pn == "#is_number": return yes(types.in_int(cp) || types.in_float(cp))
        if pn == "#is_bool": return yes(cp == types.P_BOOL)
        if pn == "#has_eq": return yes(op_applies(w, t.t, "=="))
        string8 why = unkeyable(w, t.t) if pn == "#is_key" else ""
        if pn == "#is_key": return yes(#len(why) == 0)
        return no()
    u32 t = where_type(w, d, x, env)
    if t != NONE: return WV(3, 0, t)
    if (g == syntax.E_NAME || g == syntax.T_NAME) && slot_of(w, d, w.p.sym(f, x)) >= 0:
        i64 j = slot_of(w, d, w.p.sym(f, x))
        if binder_kind(w, d, j) == BK_LEN: return WV(2, i64(w.t.a[w.t.list(env)[j]]), NONE)
    return no()

// The type `where` operand `x` names: a binding, a declared or builtin
// name, `pkg.T`, a written type, a tuple of types.
private u32 where_type(^World w, u32 d, u32 x, u32 env):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[x]
    if g == syntax.E_NAME || g == syntax.T_NAME || g == syntax.T_BINDING:
        i64 j = slot_of(w, d, w.p.sym(f, x))
        if j >= 0:
            u8 k = binder_kind(w, d, j)
            return w.t.list(env)[j] if k == BK_TYPE || k == BK_TRAIT else NONE
        if g == syntax.E_NAME: return named_type(w, f, x)
    if g == syntax.E_FIELD:
        u32 td = decl_named(w, f, x)
        return resolve(w, td) if td != NONE && typeish(w.decls[td].kind) && w.decls[td].kind != K_TRAIT else NONE
    if g == syntax.E_TUPLE:
        ref []u32 xs
        for q in a.list(a.b[x]):
            u32 t = where_type(w, d, q, env)
            if t == NONE: return NONE
            xs = #append(xs, t)
        return w.t.tuple(xs)
    if g == syntax.E_TYPE: x = a.a[x]
    else if g < syntax.T_NAME || g > syntax.T_CHANNEL: return NONE
    u32 e = w.env
    u32 ed = w.envd
    w.env = env
    w.envd = d
    i64 errs = #len(w.d.list)
    u32 t = resolve_type(w, f, x)
    w.env = e
    w.envd = ed
    #truncate(w.d.list, errs)
    return t

// `t` in category `c` (an enum is in none).
private bool in_cat(^World w, u32 t, string8 c):
    u32 r = under(&w.t, t)
    u32 td = decl_of(w, t)
    bool en = td != NONE && w.decls[td].kind == K_ENUM
    u8 p = types.PRIM[w.t.a[r]].canon if r != NONE && w.t.tag[r] == types.T_PRIM && !en else types.P_VOID
    if c == "int": return types.in_int(p)
    if c == "float": return types.in_float(p)
    return types.in_scalar(p)

// Whether expression `n` may name a declaration: a name that is no builtin
// type, or `pkg.T`.
bool may_name(^World w, u32 f, u32 n):
    if n == NONE: return false
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[n]
    if g == syntax.E_NAME || g == syntax.T_NAME:
        string8 s = w.p.spell(f, n)
        return types.prim_named(s) == types.PRIMS && s != "string8" && s != "cstring" && s != "string16" && s != "string32" && s != "string"
    if g == syntax.E_FIELD: return a.tag[a.a[n]] == syntax.E_NAME && w.p.spell(f, a.a[n])[0] != '#'
    return g == syntax.T_PATH

// `is` between types: by declaration when both operands may name one.
bool same_type(^World w, u32 f, u32 ea, u32 a, u32 eb, u32 b):
    if may_name(w, f, ea) && may_name(w, f, eb) && decl_of(w, w.t.bare(a)) != NONE && decl_of(w, w.t.bare(b)) != NONE: return w.t.bare(a) == w.t.bare(b)
    return one_type(w, a, b, 0)

// One type: the same after declared names, element by element.
bool one_type(^World w, u32 a, u32 b, i64 depth):
    if a == b: return true
    if depth > 32: return false
    u32 ra = w.t.resolve(a)
    u32 rb = w.t.resolve(b)
    if ra == NONE || rb == NONE: return false
    if ra == rb: return true
    if w.t.tag[ra] != w.t.tag[rb]: return false
    u8 g = w.t.tag[ra]
    if g == types.T_TUPLE:
        []u32 xs = w.t.list(ra)
        []u32 ys = w.t.list(rb)
        if #len(xs) != #len(ys): return false
        for i in 0..<#len(xs):
            if !one_type(w, xs[i], ys[i], depth + 1): return false
        return true
    if g == types.T_MATRIX: return w.t.a[ra] == w.t.a[rb] && w.t.b[ra] == w.t.b[rb] && one_type(w, w.t.list(ra)[0], w.t.list(rb)[0], depth + 1)
    if g == types.T_QUAL: return w.t.a[ra] == w.t.a[rb] && one_type(w, w.t.list(ra)[0], w.t.list(rb)[0], depth + 1)
    return false

// Whether operator `op` (as `has` spells it) applies between two `t`s.
bool op_applies(^World w, u32 t, string8 op):
    u32 m = matrix(w, t)
    if m != NONE:
        bool sq = w.t.a[m] == w.t.b[m]
        return op == "+" || op == "-" || op == "==" || op == "!=" || op == "*" && sq
    u32 r = under(&w.t, t)
    if r == NONE: return false
    u8 g = w.t.tag[r]
    bool eq = op == "==" || op == "!="
    bool ord = op == "<" || op == "<=" || op == ">" || op == ">="
    bool arith = op == "+" || op == "-" || op == "*" || op == "/"
    bool bits = op == "%" || op == "&" || op == "|" || op == "~" || op == "&~" || op == "<<" || op == ">>"
    if g == types.T_TUPLE:
        if ord || op == "&&" || op == "||" || op == "!": return false
        for x in w.t.list(r):
            if !op_applies(w, x, op): return false
        return true
    if g == types.T_UNION || g == types.T_MAP: return false
    if g == types.T_CSCALAR:
        u8 cl = types.C_SCALARS[w.t.a[r]].class
        if cl == types.CS_FLOAT: return arith || eq || ord
        if types.C_SCALARS[w.t.a[r]].name == "bool": return eq || op == "&&" || op == "||" || op == "!"
        if types.C_SCALARS[w.t.a[r]].name == "char": return eq
        return arith || eq || ord || bits
    if g == types.T_PRIM:
        u8 p = types.PRIM[w.t.a[r]].canon
        if p == types.P_BOOL: return eq || op == "&&" || op == "||" || op == "!"
        if p == types.P_RAWPTR: return op == "-" || eq || ord
        if types.in_float(p): return arith || eq || ord
        if types.in_int(p) || p == types.P_CHAR8 || p == types.P_CHAR16 || p == types.P_CHAR32: return arith || eq || ord || bits
        return eq
    return eq

// `x is T` in a body: a union value's tag, else answered from types.
Val is_expr(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    u32 sn = a.a[n]
    u32 tn = a.b[n]
    Val sv = expr(w, b, sn, NONE)
    Val tv = tuple_type(w, b, tn) if a.tag[tn] == syntax.E_TUPLE else expr(w, b, tn, NONE)
    if sv.ty == NONE || tv.ty == NONE: return bad()
    if tv.kind != V_TYPE:
        string8 ts = src(w, b, tn)
        err(w, b, tn, 913, index.hold(#format("`", ts, "` is a value of type `", shown(w, final_ty(w, tv)), "`, and the right side of `is` is a **type**: `is` asks whether its left operand is of that type. `typeof(", ts, ")` is the type of the value, which is the question this reads as")))
        return bad()
    u32 bt = u32(types.P_BOOL)
    if sv.kind == V_TYPE: return value(ir.konst(w.k.boolean(&w.t, same_type(w, b.file, sn, sv.x, tn, tv.x))), bt)
    if sv.kind != V_VAL: sv = finish(w, b, sv, sn)
    u32 rw = raw_of(&w.t, sv.ty)
    if rw != NONE:
        string8 ms = ""
        []u32 rms = w.t.list(rw)
        []u32 rns = w.t.slot_names(rw)
        for i in 0..<#len(rms):
            string8 pre = "" if i == 0 else index.hold(#format(ms, ", "))
            string8 mn = index.hold(#format(" ", w.t.text(rns[i]))) if i < #len(rns) else ""
            ms = index.hold(#format(pre, "`", shown(w, rms[i]), mn, "`"))
        err(w, b, n, 1024, index.hold(#format("`is` over a union value reads its tag, and `", src(w, b, sn), "` is ", shown(w, sv.ty), ", C's union, which carries no tag\x1fC does not say which member was written last")), index.hold(#format("read the member the program knows is there by name; its members are ", ms)))
        return bad()
    u32 pr = w.t.resolve(sv.ty)
    if pr != NONE && (w.t.tag[pr] == types.T_PTR || w.t.tag[pr] == types.T_REF) && union_of(w, w.t.a[pr]) != NONE && member_at(w, union_of(w, w.t.a[pr]), tv.x) >= 0:
        string8 ss = src(w, b, sn)
        err(w, b, sn, 416, index.hold(#format("`", ss, "` is ", shown(w, sv.ty), ", which points at a union and is not one, so `is` would answer from its own type and never read the tag. Ask the union it reaches: `", ss, "^ is ", src(w, b, tn), "`")))
        return bad()
    u32 u = union_of(w, sv.ty)
    if u == NONE && !is_inert(w, b, sn):
        err(w, b, sn, 504, index.hold(#format("`", src(w, b, sn), "` is not an inert place, and `is` over a value that is not a union never runs it\x1fAn inert place is a name, a slot of one, or what a named pointer points at. `is` over a value that is not a union answers from the value's static type, so this would be typed and then dropped along with everything it did\x1ebind the value to a name first and ask it of the name")))
        return bad()
    if u != NONE && w.t.resolve(sv.ty) != w.t.resolve(tv.x):
        i64 i = member_at(w, u, tv.x)
        if i < 0:
            err(w, b, tn, 416, index.hold(#format(shown(w, tv.x), " is not a member of ", shown(w, sv.ty), ", so `", src(w, b, sn), "` could never hold one and this `is` could never be true; its members are ", members_text(w, u), ". `is` over a union value asks which member its tag names")))
            return bad()
        u32 x = spill(w, b, sv, sn)
        u32 tg = temp(w, b, u32(types.P_U32), n)
        _ = ir.op(&b.f, ir.O_CONV, ir.CV_TAG, u32(types.P_U32), n, tg, x)
        u32 ok = temp(w, b, bt, n)
        _ = ir.op(&b.f, ir.O_BIN, ir.B_EQ, u32(types.P_U32), n, ok, tg, ir.konst(w.k.small(&w.t, i)))
        return value(ok, bt)
    bool same = w.t.resolve(sv.ty) == w.t.resolve(tv.x)
    if decl_of(w, w.t.bare(sv.ty)) != NONE && may_name(w, b.file, tn) && decl_of(w, w.t.bare(tv.x)) != NONE: same = w.t.bare(sv.ty) == w.t.bare(tv.x)
    return value(ir.konst(w.k.boolean(&w.t, same)), bt)

// A name, a slot of one, or what a named pointer points at.
private bool is_inert(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    u8 g = a.tag[n]
    if g == syntax.E_NAME: return true
    if g == syntax.E_FIELD: return is_inert(w, b, a.a[n])
    if g == syntax.E_INDEX: return a.tag[a.b[n]] == syntax.E_INT && is_inert(w, b, a.a[n])
    return g == syntax.E_DEREF && a.tag[a.a[n]] == syntax.E_NAME

// `T has +` in a body: not built (as Rust).
Val has_expr(^World w, ^Body b, u32 n):
    err(w, b, n, 1, index.hold(#format("`", src(w, b, n), "` asks what a type provides, and `has` is answered in a template's header `where` — `where T has +` states what the body needs, at each instantiation. Asking it in a body is not built yet")))
    return bad()

// `(f32, f32)` written where a type is asked: the tuple of its types.
private Val tuple_type(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    ref []u32 xs
    for e in a.list(a.b[n]):
        Val t = expr(w, b, e, NONE)
        if t.kind != V_TYPE: return bad()
        xs = #append(xs, t.x)
    return Val(V_TYPE, NONE, types.TYPE, w.t.tuple(xs), 0, 0)

// One layout where only a transparent `foreign` struct and its shape differ.
bool fx_eq(^World w, u32 a, u32 b, i64 depth):
    u32 ra = w.t.resolve(a)
    u32 rb = w.t.resolve(b)
    if ra == rb: return true
    if depth > 16 || ra == NONE || rb == NONE || w.t.tag[ra] != types.T_TUPLE || w.t.tag[rb] != types.T_TUPLE: return false
    []u32 xs = w.t.list(ra)
    []u32 ys = w.t.list(rb)
    if #len(xs) != #len(ys): return false
    for i in 0..<#len(xs):
        if xs[i] == ys[i]: continue
        if !(foreign_struct(w, xs[i]) || foreign_struct(w, ys[i]) || w.t.tag[w.t.resolve(xs[i])] == types.T_TUPLE) || !fx_eq(w, xs[i], ys[i], depth + 1): return false
    return true

// `#names(T)`, `#names(v)`: the names a declared type's view (or a `view`
// statement) binds, one `string8` or an array of them.
Val names_call(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    []u32 args = call_args(w, b, n)
    u32 vn = arg_value(w, b, args[0])
    if b.decl != NONE && w.decls[b.decl].kind == K_CONST:
        syntax.Ast da = w.p.files[w.decls[b.decl].file].a
        u32 cv = da.list(da.b[w.decls[b.decl].node])[1]
        err(w, b, cv if cv != NONE else n, 901, "a constant is folded before the program runs, and the compiler cannot evaluate a `#names` in a package-level `const`\x1fPackage constants fold before any `type` body resolves, because a body may be sized by one, so no declaration has a view to read yet", "declare the `const` inside the function that uses it, where it folds after every view exists, or write the `#names` at the use")
        return bad()
    ref []string8 out
    string8 subject = ""
    string8 repair = ""
    string8 binder = ""
    u32 ty = NONE
    i64 why = -1
    u32 sl = find_local(w, b, w.p.sym(b.file, vn), false) if a.tag[vn] == syntax.E_NAME else NONE
    if sl != NONE:
        subject = index.hold(#format("`", src(w, b, vn), "`"))
        ty = b.f.slot_ty[sl]
        binder = local_binder(w, b, sl)
        i64 i = #len(b.locals)
        bool viewed = false
        for i > 0:
            i -= 1
            if b.locals[i].viewed != sl: continue
            viewed = true
            why = 0
            for x in a.list(a.b[b.locals[i].node]):
                string8 s = spell(w, b, x)
                if s == "_" && why == 0: why = #len(out) + 1
                out = #append(out, s)
            break
        if !viewed: why = names_of(w, ty, &out)
        if why < 0 && #len(binder) == 0: repair = index.hold(#format("declare it with a named type — `Vector2 ", src(w, b, vn), " = …` — or ask the declaration itself: `#names(Vector2)`"))
    else:
        if a.tag[vn] == syntax.E_FIELD && find_local(w, b, w.p.sym(b.file, a.a[vn]), false) != NONE || a.tag[vn] == syntax.E_INDEX:
            _ = expr(w, b, vn, NONE)
            err(w, b, vn, 504, "`#names` takes a type written by its declared name — `#names(Vector2)` — or a name bound to a value whose type was written that way — `#names(v)`\x1fA slot's names belong to the declaration that wrote them and not to the shape, since `Vector2` and `Size` over `(f32, f32)` are one type, so they are read where that name is written\x1ebind this value to a name declared with its type first")
            return bad()
        Val v = tuple_type(w, b, vn) if a.tag[vn] == syntax.E_TUPLE else expr(w, b, vn, NONE)
        if v.ty == NONE: return bad()
        if v.kind != V_TYPE:
            err(w, b, vn, 504, "`#names` takes a type written by its declared name — `#names(Vector2)` — or a name bound to a value whose type was written that way — `#names(v)`\x1fA slot's names belong to the declaration that wrote them and not to the shape, since `Vector2` and `Size` over `(f32, f32)` are one type, so they are read where that name is written\x1ebind this value to a name declared with its type first")
            return bad()
        ty = v.x
        u8 bk = 0
        if a.tag[vn] == syntax.E_NAME && bound(w, w.p.sym(b.file, vn), &bk) != NONE: binder = spell(w, b, vn)
        subject = index.hold(#format("`", src(w, b, vn), "`")) if a.tag[vn] == syntax.E_NAME || a.tag[vn] == syntax.E_FIELD else "a type written as a shape"
        why = names_of(w, ty, &out) if a.tag[vn] == syntax.E_NAME || a.tag[vn] == syntax.E_FIELD else -1
    if why > 0:
        string8 held = "is written `_`" if why <= #len(out) && out[why - 1] == "_" else "holds an anonymous member, whose names name what is inside it and not the position"
        err(w, b, vn, 410, index.hold(#format("position ", why - 1, " of ", subject, " ", held, ", so it has no name to answer\x1f`#names` answers every position of a shape or none, and never invents a name")), "name the position where it is declared, or reach it by position")
        return bad()
    if why < 0 && #len(binder) > 0:
        err(w, b, vn, 410, index.hold(#format("`", binder, "` is bound to ", shown(w, ty), " here, a shape the call wrote out rather than a declared type, so nothing names its slots\x1f`#names` of a binding answers the declaration the call's argument was typed by, and never invents a name")), "type the argument by a declared name — `Vector2 v = …` — at the call")
        return bad()
    if why < 0:
        err(w, b, vn, 410, index.hold(#format(subject, " is ", shown(w, ty), ", and nothing written for it names its slots, so there are no names to answer\x1f`#names` reads the names a declaration binds and never invents one for a position")), repair)
        return bad()
    ref []u32 cs
    ref []u32 ts
    for s in out:
        string8 own = index.hold(strings.clone(s))
        cs = #append(cs, w.k.str(&w.t, own))
        ts = #append(ts, types.STRING8)
    if #len(cs) == 1: return value(ir.konst(cs[0]), types.STRING8)
    u32 at = w.t.tuple(ts)
    return konst_val(w, b, w.k.tuple(&w.t, cs), at, n)

// The binding a local's written type names (`T v`), or "".
private string8 local_binder(^World w, ^Body b, u32 sl):
    syntax.Ast a = tree(w, b)
    u32 d = b.f.slot_node[sl]
    if d == NONE: return ""
    u32 tn = NONE
    if a.tag[d] == syntax.S_LET: tn = a.list(a.b[d])[0]
    else if a.tag[d] == syntax.N_PARAM: tn = a.a[d]
    if tn == NONE || a.tag[tn] != syntax.T_NAME && a.tag[tn] != syntax.T_BINDING: return ""
    u8 bk = 0
    return spell(w, b, tn) if bound(w, w.p.sym(b.file, tn), &bk) != NONE && bk == BK_TYPE else ""

// The slot names declared type `ty` binds (a name an embedding shadows
// spelled by its path): 0; the first unnamed position + 1; -1 when nothing
// is declared.
private i64 names_of(^World w, u32 ty, ^ref []string8 out):
    u32 t = w.t.bare(ty)
    if decl_of(w, t) == NONE: return -1
    []u32 ns = w.t.slot_names(t)
    if #len(ns) == 0: return -1
    for i in 0..<#len(ns):
        string8 nm = w.t.text(ns[i])
        if #len(nm) == 0 || nm == "_":
            out^ = #append(out^, "_" if nm == "_" else "")
            return i + 1
        i64 own = -1
        for j in 0..<#len(ns):
            if w.t.text(ns[j]) == nm && (own < 0 || in_embed(w, t, own) && !in_embed(w, t, j)): own = j
        if own == i: out^ = #append(out^, nm)
        else: out^ = #append(out^, index.hold(#format(emb_path(w, t, i), nm)))
    return 0

// `Outer.Inner.` for the embeddings slot `i` of `t` sits in.
private string8 emb_path(^World w, u32 t, i64 i):
    for e in w.embeds:
        if e.outer != t || w.t.tag[e.inner] != types.T_NAMED: continue
        []u32 sl = w.t.slots(e.inner)
        if i < i64(e.at) || i >= i64(e.at) + #len(sl): continue
        return index.hold(#format(emb_name(w.t.text(w.t.b[e.inner])), ".", emb_path(w, e.inner, i - i64(e.at))))
    return ""

private const string8 GL_TODAY = "to build the program today, leave the call out and hand your graphics backend the shader's source in the language it loads — WGSL, GLSL, HLSL or MSL — as a string"

// A `.dadogl` file of a program's own package: reserved, refused at the
// `package` line.
void shader_units(^World w):
    for p in 0..<#len(w.p.pkgs):
        if index.collection_key(w.p.pkgs[p].key) || w.p.pkgs[p].flo >= w.p.pkgs[p].fhi: continue
        u32 f = w.p.pkgs[p].flo
        syntax.Ast a = w.p.files[f].a
        u32 at = NONE
        for x in a.list(a.b[a.root]):
            if x != NONE && a.tag[x] == syntax.N_PACKAGE: at = x
        if at == NONE: continue
        string8 pn = name_of(w, w.p.pkgs[p].name)
        for u in w.p.pkgs[p].units:
            say(w, f, 0, a.lo[at], a.hi[at], 1, index.hold(#format("`", u, ".dadogl` in package `", pn, "` is a DadoGL shader unit, and DadoGL is not built yet: the `.dadogl` file is reserved, so this compiler recognises it by its name and reads nothing in it")), index.hold(#format("to build the package today, move `", u, ".dadogl` out of its directory and write the shader in the language your graphics backend loads — WGSL, GLSL, HLSL or MSL — handing it the source as a string; `#shader_load(", u, ")` will load the unit once DadoGL is built")))

// `#shader_load(Lit)`: DadoGL is reserved, so every call is refused.
Val shader_load(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    []u32 args = call_args(w, b, n)
    if #len(args) == 0:
        err(w, b, n, 1, "`#shader_load` names the DadoGL unit it loads, and names none here — and DadoGL is not built yet", GL_TODAY)
        return bad()
    u32 vn = arg_value(w, b, args[0])
    u32 pk = NONE
    string8 unit = ""
    string8 shown_ = src(w, b, vn)
    if a.tag[vn] == syntax.E_NAME:
        pk = w.p.files[b.file].pkg
        unit = spell(w, b, vn)
    else if a.tag[vn] == syntax.E_FIELD && a.tag[a.a[vn]] == syntax.E_NAME:
        for im in w.p.pkgs[w.p.files[b.file].pkg].imports:
            if im.file == b.file && (im.name if im.name != NONE else w.p.pkgs[im.pkg].name) == w.p.sym(b.file, a.a[vn]): pk = im.pkg
        unit = spell(w, b, vn)
    if pk == NONE:
        err(w, b, vn, 1, index.hold(#format("`#shader_load` names a DadoGL unit — `Lit` for `Lit.dadogl` in this package, `pkg.Lit` for one in an imported package — and `", shown_, "` is not a unit's name; DadoGL is not built yet in any case")), GL_TODAY)
        return bad()
    string8 pn = name_of(w, w.p.pkgs[pk].name)
    for u in w.p.pkgs[pk].units:
        if u == unit:
            err(w, b, n, 1, index.hold(#format("`#shader_load(", shown_, ")` loads the DadoGL unit `", unit, ".dadogl` of package `", pn, "` and answers a `core:shader` `Shader`, and DadoGL is not built yet: the verb is reserved, and refused")), GL_TODAY)
            return bad()
    err(w, b, vn, 1, index.hold(#format("`", shown_, "` names no DadoGL unit: `#shader_load` loads a `.dadogl` file by its name, and package `", pn, "` holds no `", unit, ".dadogl` — and DadoGL is not built yet, so a call naming one is refused too")), GL_TODAY)
    return bad()

private const string8 STRING_OPERAND = "`string` is the kind of a string literal and not a type: a `\"…\"` has no width until it is placed, so no type is it. Ask for the width — `T is string8` — or for every width, `T in (string8, string16, string32)`"
