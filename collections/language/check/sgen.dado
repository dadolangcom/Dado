// A script's generic methods: each call binds
// the `$` names from its arguments, asks `where`, and calls the instance —
// a job over the bindings, its body checked under them, its errors labelled
// with the call that asked first. Called elsewhere than inside the class
// that writes it, ERR0001.
package check

import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:strings"

// Instance labels: job, then (file << 32 | node) of the call and its text.
type SGLab:
    u32 job
    u32 file
    u32 lo
    u32 hi
    string8 text

private string8 sg_src(^World w, u32 f, u32 n):
    syntax.Ast a = w.p.files[f].a
    return w.p.files[f].src[i64(a.lo[n])..<i64(a.hi[n])]

private i64 sg_slot(^World w, u32 d, u32 sym):
    []u32 bs = binders(w, d)
    for i in 0..<#len(bs):
        if bs[i] == sym: return i
    return -1

// Binds what pattern `p` (file `f`) writes from `got`; "" or the clause saying why not.
private string8 sg_bind(^World w, u32 d, u32 f, u32 p, u32 got, ^ref []u32 bound):
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[p]
    u32 r = w.t.resolve(got)
    if g == syntax.T_SLICE:
        if r == NONE || w.t.tag[r] != types.T_SLICE: return ": an array is what binds its element"
        return sg_bind(w, d, f, a.a[p], w.t.a[r], bound)
    if g == syntax.T_MAP:
        if r == NONE || w.t.tag[r] != types.T_MAP: return ": a map is what binds its key and value"
        string8 k = sg_bind(w, d, f, a.a[p], w.t.a[r], bound)
        if #len(k) > 0: return k
        return sg_bind(w, d, f, a.b[p], w.t.b[r], bound)
    if g != syntax.T_BINDING && g != syntax.T_NAME: return ""
    i64 i = sg_slot(w, d, w.p.sym(f, p))
    if i < 0: return ""
    u32 e = bound^[i]
    if e == NONE:
        bound^[i] = got
        return ""
    if e == got: return ""
    string8 nm = name_of(w, w.p.sym(f, p))
    return index.hold(#format(", where an earlier argument bound `", nm, "` to `", shown(w, e), "`: one `", nm, "` is one type"))

private bool sg_has_eq(^World w, u32 ty):
    u32 r = w.t.resolve(ty)
    if ty == w.sstr || s_enum(w, ty): return true
    return r != NONE && w.t.tag[r] == types.T_PRIM && (r == u32(types.P_INT) || r == u32(types.P_FLOAT) || r == u32(types.P_BOOL) || r == u32(types.P_U8))

// Whether `x` asks a bound name `T is …`/`T has …`.
bool sg_asks(^World w, u32 f, u32 x):
    if w.env == NONE: return false
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[x]
    if g == syntax.E_UNARY: return sg_asks(w, f, a.a[x])
    if g == syntax.E_BINARY: return sg_asks(w, f, a.a[x]) || sg_asks(w, f, a.b[x])
    u32 s = NONE
    if g == syntax.E_IS: s = a.a[x]
    if g == syntax.E_HAS: s = a.list(a.b[x])[0]
    u8 k = 0
    return s != NONE && a.tag[s] == syntax.E_NAME && bound(w, w.p.sym(f, s), &k) != NONE

// A `where` or `when` over the bindings in hand (`w.env`): 1, 0, or -1
// with `at`/`why` set.
i8 sg_pred(^World w, u32 f, u32 x, ^u32 at, ^string8 why):
    syntax.Ast a = w.p.files[f].a
    u8 g = a.tag[x]
    string8 sp = w.p.spell(f, x)
    at^ = x
    why^ = "a script's generic method asks its bindings `T is …` and `T has ==`, joined by `&&`, `||` and `!`, and nothing else"
    if g == syntax.E_NAME && (sp == "true" || sp == "false"): return 1 if sp == "true" else 0
    if g == syntax.E_UNARY && sp == "!":
        i8 v = sg_pred(w, f, a.a[x], at, why)
        return v if v < 0 else 1 - v
    if g == syntax.E_BINARY && (sp == "&&" || sp == "||"):
        i8 l = sg_pred(w, f, a.a[x], at, why)
        if l < 0: return l
        if sp == "&&" && l == 0 || sp == "||" && l == 1: return l
        return sg_pred(w, f, a.b[x], at, why)
    u32 s = NONE
    if g == syntax.E_IS: s = a.a[x]
    if g == syntax.E_HAS: s = a.list(a.b[x])[0]
    if s == NONE: return -1
    u8 k = 0
    u32 ty = bound(w, w.p.sym(f, s), &k) if a.tag[s] == syntax.E_NAME else NONE
    if ty == NONE:
        at^ = s
        return -1
    if g == syntax.E_HAS:
        []u32 hs = a.list(a.b[x])
        for q in hs[1..<#len(hs)]:
            if w.p.spell(f, q) != "==" && w.p.spell(f, q) != "!=":
                at^ = x
                why^ = "a script asks `T has ==` and nothing else: its other operators belong to `int` and `float`, which `T is scalar` names"
                return -1
        return 1 if sg_has_eq(w, ty) else 0
    u32 tn = a.b[x]
    u32 other = NONE
    if a.tag[tn] == syntax.E_NAME || a.tag[tn] == syntax.T_NAME:
        string8 c = w.p.spell(f, tn)
        u32 r = w.t.resolve(ty)
        if c == "scalar": return 1 if r == u32(types.P_INT) || r == u32(types.P_FLOAT) else 0
        other = bound(w, w.p.sym(f, tn), &k)
        if other == NONE: other = s_type_name(w, f, tn)
        if other == NONE - 1: other = resolve_type(w, f, tn) if a.tag[tn] == syntax.T_NAME else NONE
    else if a.tag[tn] == syntax.E_TYPE: other = resolve_type(w, f, a.a[tn])
    else:
        at^ = tn
        return -1
    if other == NONE:
        at^ = tn
        why^ = "this names no type a script has"
        return -1
    return 1 if other == ty else 0

// `m(…)` or `self.m(…)` of generic method `m`.
Val sg_call(^World w, ^Body b, u32 n, u32 m):
    syntax.Ast a = tree(w, b)
    []u32 args = call_args(w, b, n)
    u32 f = w.decls[m].file
    syntax.Ast ma = w.p.files[f].a
    []u32 ps = params(w, m)
    string8 mn = name_of(w, w.decls[m].name)
    if #len(args) != #len(ps):
        ref []string8 sig
        u32 cur = NONE
        for q in ps:
            if ma.a[q] != NONE: cur = ma.a[q]
            string8 ct = "?"
            if cur != NONE: ct = sg_src(w, f, cur)
            sig = #append(sig, index.hold(#format(ct, " ", w.p.spell(f, q))))
        u32 rn = ma.list(ma.b[w.decls[m].node])[0]
        string8 rs = "void"
        if rn != NONE: rs = sg_src(w, f, rn)
        err(w, b, n, 601, index.hold(#format("`", mn, "` takes ", #len(ps), " arguments, and this call passes ", #len(args))), index.hold(#format("call it as `", rs, " (", strings.join(sig[:], ", "), ")`")))
        for g in args:
            _ = expr(w, b, arg_value(w, b, g), NONE)
        return bad()
    ref []Val vs
    bool ok = true
    for g in args:
        Val v = finish(w, b, expr(w, b, arg_value(w, b, g), NONE), arg_value(w, b, g))
        if v.ty == NONE: ok = false
        vs = #append(vs, v)
    if !ok: return bad()
    []u32 bs = binders(w, m)
    ref []u32 got
    for _ in bs:
        got = #append(got, NONE)
    u32 last = NONE
    for i in 0..<#len(ps):
        u32 p = ma.a[ps[i]] if ma.a[ps[i]] != NONE else last
        last = p
        if p == NONE: continue
        string8 why = sg_bind(w, m, f, p, vs[i].ty, &got)
        if #len(why) == 0: continue
        u32 vn = arg_value(w, b, args[i])
        string8 help = index.hold(#format("pass a value of the shape `", sg_src(w, f, p), "`"))
        if vs[i].ty == w.sany: help = index.hold(#format("convert it first to what it holds — `[]int xs = ", src(w, b, vn), "` — which raises if it holds something else, and pass that"))
        else if why[0] == ',': help = "pass values of one type wherever the signature writes one name"
        err(w, b, vn, 504, index.hold(#format("`", mn, "`'s parameter `", w.p.spell(f, ps[i]), "` is `", sg_src(w, f, p), "`, and this is `", shown(w, vs[i].ty), "`", why)), help)
        return bad()
    for i in 0..<#len(bs):
        if got[i] != NONE: continue
        string8 bn = name_of(w, bs[i])
        err(w, b, n, 504, index.hold(#format("`", mn, "` writes `$", bn, "` where no argument binds it, so this call cannot say what `", bn, "` is")), index.hold(#format("write `$", bn, "` in a parameter's type, so the argument passed there binds it")))
        return bad()
    u32 env = w.t.tuple(got[:])
    u32 we = where_of(w, m)
    if we != NONE:
        u32 oe = w.env
        u32 od = w.envd
        w.env = env
        w.envd = m
        u32 at = NONE
        string8 why = ""
        i8 v = sg_pred(w, f, we, &at, &why)
        w.env = oe
        w.envd = od
        if v < 0:
            say(w, f, 0, ma.lo[at], ma.hi[at], 920, why, "write `where T has ==`, `where T is int` or `where T is scalar`, joined by `&&`, `||` and `!`")
            return bad()
        if v == 0:
            ref []string8 sh
            for i in 0..<#len(bs):
                sh = #append(sh, index.hold(#format("`", name_of(w, bs[i]), "` to `", shown(w, got[i]), "`")))
            string8 ws = sg_src(w, f, we)
            err(w, b, n, 919, index.hold(#format("`", mn, "` is written `where ", ws, "`, and this call binds ", strings.join(sh[:], " and "), ", which it does not admit")), index.hold(#format("pass a value `where ", ws, "` holds for, or write the method for this type")))
            return bad()
    u64 key = (u64(m) << 32) | u64(env)
    bool fresh = !(key in w.jobs_by)
    _ = job(w, m, env)
    try u32 j = w.jobs_by[key] else: return bad()
    if fresh:
        w.jobs[j].note = ""
        ref []string8 said
        for i in 0..<#len(bs):
            said = #append(said, index.hold(#format("`", name_of(w, bs[i]), "` bound to `", shown(w, got[i]), "`")))
        w.sglabs = #append(w.sglabs, SGLab(j, b.file, a.lo[n], a.hi[n], index.hold(#format("in `", mn, "` with ", strings.join(said[:], " and "), ", which this call asked for"))))
    u32 fty = sig(w, m, env)
    if fty == NONE: return bad()
    []u32 pts = w.t.params(fty)
    ref []u32 opds
    Val sv = s_self(w, b, n)
    if sv.ty == NONE: return bad()
    opds = #append(opds, sv.opd)
    for i in 0..<#len(vs):
        u32 vn = arg_value(w, b, args[i])
        Val v = coerce(w, b, vs[i], pts[i + 1], vn, index.hold(#format("the parameter `", w.p.spell(f, ps[i]), "` of `", mn, "` is")))
        if v.ty == NONE: return bad()
        opds = #append(opds, v.opd)
    u32 rt = w.t.a[fty]
    u32 t = NONE
    if rt != u32(types.P_VOID): t = temp(w, b, rt, n)
    u32 r = ir.fn_ref(&b.f, b.f.pkg, tstr(w, index.hold(#format(mn, "$", j))), 0)
    _ = ir.op(&b.f, ir.O_CALL, 0, rt, n, t, r)
    for o in opds:
        ir.arg(&b.f, o)
    return value(t, rt)

// ERR0001: generic method `m` reached on an instance, from a subclass or through `super`.
Val sg_elsewhere(^World w, ^Body b, u32 n, u32 at, u32 m):
    for g in call_args(w, b, n):
        _ = expr(w, b, arg_value(w, b, g), NONE)
    string8 mn = name_of(w, w.decls[m].name)
    err_tok(w, b, at, 1, index.hold(#format("`", mn, "`, a generic method, called on an instance, from a subclass or through `super`, is DadoScript that is not built yet")), index.hold(#format("call `", mn, "(…)` inside the class that writes it, and reach that through a method of its own that is not generic")))
    return bad()

// Job `j`'s diagnostics from `mark` on carry its asking call's label.
void sg_label(^World w, u32 j, i64 mark):
    for l in w.sglabs:
        if l.job != j: continue
        for i in mark..<#len(w.d.list):
            i64 last = #len(w.d.list) - 1
            u32 le = w.d.list[last].lab_end
            w.d.label(l.file, 0, l.lo, l.hi, l.text)
            u32 p = u32(#len(w.d.labels)) - 1
            w.d.list[last].lab_end = le
            u32 lo = u32(#len(w.d.labels))
            for k in w.d.list[i].lab..<w.d.list[i].lab_end:
                w.d.labels = #append(w.d.labels, w.d.labels[k])
            w.d.labels = #append(w.d.labels, w.d.labels[p])
            w.d.list[i].lab = lo
            w.d.list[i].lab_end = u32(#len(w.d.labels))
        return
