// Traits in scripts: a `trait` written in a class,
// taken on with `using`, conformance, defaults given to a class (checked once,
// `self` the trait's `Self`), trait values and the call through one.
package check

import "language:diag"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:strings"

type STrait:
    u32 decl
    u32 cls
    ref []u32 ext
    // Method declarations (K_METHOD, block the trait), required or default.
    ref []u32 ms
    u32 ty
    u32 self_ty
    bool failed
    bool declared

private const u32 ST_SELF = 0xFFFFFFFD

// The script trait declaration `d` is, or NONE.
u32 st_of_decl(^World w, u32 d):
    if d == NONE || w.decls[d].kind != K_TRAIT: return NONE
    for i in 0..<#len(w.straits):
        if w.straits[i].decl == d: return u32(i)
    return NONE

// The trait a value of `ty` is (a trait value or a default's `Self`); `self_` set for `Self`.
u32 st_of_ty(^World w, u32 ty, ^bool self_):
    self_^ = false
    if ty == NONE: return NONE
    for i in 0..<#len(w.straits):
        if w.straits[i].ty == ty: return u32(i)
        if w.straits[i].self_ty == ty:
            self_^ = true
            return u32(i)
    return NONE

// Registers trait node `n` of class `ci` (its declaration `d`).
void st_register(^World w, u32 ci, u32 d):
    STrait t
    t.decl = d
    t.cls = ci
    string8 pk = name_of(w, w.p.pkgs[w.decls[d].pkg].name)
    string8 q = s_qual(w, d)
    t.ty = w.t.builtin(index.hold(#format(pk, ".", q)))
    t.self_ty = w.t.builtin(index.hold(#format("Self.", pk, ".", q)))
    w.straits = #append(w.straits, t)
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    for x in a.list(a.b[w.decls[d].node]):
        if x == NONE || a.tag[x] != syntax.N_FN: continue
        w.straits[#len(w.straits) - 1].ms = #append(w.straits[#len(w.straits) - 1].ms, u32(#len(w.decls)))
        w.decls = #append(w.decls, Decl(w.p.sym(f, x), K_METHOD, w.decls[d].pkg, f, x, d, 0, NONE, false, NONE))

// Whether method decl `m` is a default (written with a body).
bool st_default(^World w, u32 m):
    syntax.Ast a = w.p.files[w.decls[m].file].a
    return (a.a[w.decls[m].node] & syntax.F_REQUIRED) == 0

// The trait and its ancestors.
ref []u32 st_family(^World w, u32 t):
    ref []u32 out
    out = #append(out, t)
    i64 i = 0
    for i < #len(out):
        for u in w.straits[out[i]].ext:
            bool seen = false
            for o in out:
                if o == u: seen = true
            if !seen: out = #append(out, u)
        i += 1
    return out

// The methods trait `t` prescribes, its own first, one per name.
ref []u32 st_methods(^World w, u32 t):
    ref []u32 out
    ref []u32 fam = st_family(w, t)
    for k in fam:
        for m in w.straits[k].ms:
            if st_async_self(w, m): continue
            bool seen = false
            for o in out:
                if w.decls[o].name == w.decls[m].name: seen = true
            if !seen: out = #append(out, m)
    return out

// A trait method's parameter or answer type: `ST_SELF` for `Self`.
private u32 st_sig_ty(^World w, u32 f, u32 tn):
    if tn == NONE: return u32(types.P_VOID)
    syntax.Ast a = w.p.files[f].a
    if a.tag[tn] == syntax.T_NAME && w.p.spell(f, tn) == "Self": return ST_SELF
    return resolve_type(w, f, tn)

private u32 st_as(u32 s, u32 itself):
    if s == ST_SELF: return itself
    return s

// Method `m`'s signature, `Self` as `itself` (NONE: written `Self`).
string8 st_sig_written(^World w, u32 m, u32 itself):
    u32 f = w.decls[m].file
    syntax.Ast a = w.p.files[f].a
    []u32 ks = a.list(a.b[w.decls[m].node])
    ref []string8 ps
    u32 last = NONE
    for q in ks[6..<#len(ks)]:
        if a.a[q] != NONE: last = st_sig_ty(w, f, a.a[q])
        ps = #append(ps, index.hold(#format(st_shown(w, last, itself), " ", w.p.spell(f, q))))
    string8 asy = ""
    if (a.a[w.decls[m].node] & syntax.F_ASYNC) != 0: asy = "async "
    return index.hold(#format(asy, st_shown(w, st_sig_ty(w, f, ks[0]), itself), " ", name_of(w, w.decls[m].name), "(", strings.join(ps[:], ", "), ")"))

private string8 st_shown(^World w, u32 t, u32 itself):
    if t == ST_SELF && itself == NONE: return "Self"
    return s_written(w, st_as(t, itself))

// A script type as a script writes it (Rust's `dados_type_written`).
string8 s_written(^World w, u32 t):
    if t == NONE: return "?"
    u32 ci = s_class_of_ty(w, t)
    if ci != NONE: return name_of(w, w.decls[w.classes[ci].decl].name)
    bool sf = false
    u32 st = st_of_ty(w, t, &sf)
    if st != NONE: return s_qual(w, w.straits[st].decl)
    if t == w.sstr: return "string"
    u8 k = s_kind(w, t)
    u32 r = w.t.resolve(t)
    if k == 1: return index.hold(#format("[]", s_written(w, w.t.a[r])))
    if k == 2: return index.hold(#format("{", s_written(w, w.t.a[r]), ": ", s_written(w, w.t.b[r]), "}"))
    if s_tup(w, t):
        ref []string8 xs
        for x in w.t.slots(t):
            xs = #append(xs, s_written(w, x))
        return index.hold(#format("(", strings.join(xs[:], ", "), ")"))
    return shown(w, t)

// The trait a `using` names (ERR0401, ERR0535, ERR1310), or NONE.
private u32 st_using(^World w, u32 ci, u32 un):
    u32 f = w.classes[ci].file
    syntax.Ast a = w.p.files[f].a
    string8 cn = name_of(w, w.decls[w.classes[ci].decl].name)
    string8 x = index.hold(strings.clone(w.p.files[f].src[i64(a.lo[un])..<i64(a.hi[un])]))
    u32 d = lookup(w, w.decls[w.classes[ci].decl].pkg, w.p.sym(f, un))
    if a.tag[un] == syntax.T_PATH:
        ref []u32 tps = s_tpath(w, f, un)
        d = s_path_decl(w, f, tps[:])
    u32 t = st_of_decl(w, d)
    if t != NONE:
        if w.straits[t].failed: return NONE
        return t
    w.d.phase = diag.PH_INTERFACE
    if d != NONE && w.decls[d].kind == K_TRAIT:
        say(w, f, 0, a.lo[un], a.hi[un], 1310, index.hold(#format("`", cn, "` takes on `", x, "`, a trait Dado declares: a script class implementing a Dado trait, to be handed to Dado as one, is the boundary between classes and Dado's types, which is not built yet")), index.hold(#format("declare the trait in a class of the scripts — `trait ", w.p.spell(f, un), ":` in `", cn, "` — and take that on, or write the methods without `using`")))
        return NONE
    u32 kd = s_inner(w, f, un, w.decls[w.classes[ci].decl].pkg)
    if kd == NONE: kd = d
    if kd != NONE && w.decls[kd].kind == K_CLASS:
        say(w, f, 0, a.lo[un], a.hi[un], 535, index.hold(#format("`", cn, "` takes on `", x, "`, which is a class: `using` names traits, and a class builds on another with `extends`")), index.hold(#format("write `extends ", x, "`, or name a trait")))
        return NONE
    ref []string8 pool
    for st in w.straits:
        if w.decls[st.decl].pkg == w.decls[w.classes[ci].decl].pkg: pool = #append(pool, name_of(w, w.decls[st.decl].name))
    string8 last = w.p.spell(f, un)
    if a.tag[un] == syntax.T_PATH && a.b[un] != NONE: last = w.p.files[f].src[i64(w.p.files[f].t.start[a.b[un]])..<i64(w.p.files[f].t.end[a.b[un]])]
    u32 top = ci
    for _ in 0..<16:
        u32 o = s_outer(w, top)
        if o == NONE: break
        top = o
    string8 h = nearest(last, pool[:])
    if #len(h) > 0: h = index.hold(#format("did you mean `", h, "`?"))
    else: h = index.hold(#format("declare it — `trait ", last, ":` and its methods — in `", name_of(w, w.decls[w.classes[top].decl].name), "`, or name a trait another class declares through it, `Goblin.", last, "`"))
    say(w, f, 0, a.lo[un], a.hi[un], 401, index.hold(#format("`", cn, "` takes on `", x, "`, and no trait of that name is written where it can see it")), h)
    return NONE

// The class a class block `ci` is written in, or NONE.
u32 s_outer(^World w, u32 ci):
    string8 n = name_of(w, w.decls[w.classes[ci].decl].name)
    i64 k = strings.last_index_of(n, '.')
    if k < 0: return NONE
    u32 od = lookup(w, w.decls[w.classes[ci].decl].pkg, w.p.names.intern(index.hold(strings.clone(n[0..<k]))))
    if od == NONE || !(od in w.class_of): return NONE
    try u32 oc = w.class_of[od] else: return NONE
    return oc

// Whether class `ci` (its chain) takes trait `t` on, directly or through a trait extending it.
bool st_adopts(^World w, u32 ci, u32 t):
    u32 at = ci
    for _ in 0..<64:
        if at == NONE: return false
        for k in w.classes[at].traits:
            for u in st_family(w, k):
                if u == t: return true
        at = s_parent(w, at)
    return false

// Whether a value of `got` stands where trait-typed `want` is asked.
bool st_fits(^World w, u32 got, u32 want):
    bool sf = false
    u32 t = st_of_ty(w, want, &sf)
    if t == NONE: return false
    u32 ci = s_class_of_ty(w, got)
    if ci != NONE: return st_adopts(w, ci, t)
    if sf: return false
    bool gs = false
    u32 g = st_of_ty(w, got, &gs)
    if g == NONE: return false
    for u in st_family(w, g):
        if u == t: return true
    return false

// Every trait's head and methods, then each class's `using`: conformance and defaults.
void st_declare(^World w):
    for i in 0..<#len(w.straits):
        u32 d = w.straits[i].decl
        u32 f = w.decls[d].file
        syntax.Ast a = w.p.files[f].a
        string8 tn = w.p.spell(f, w.decls[d].node)
        w.d.phase = diag.PH_INTERFACE
        for x in a.list(a.b[w.decls[d].node]):
            if x == NONE || a.tag[x] == syntax.N_FN || a.tag[x] == syntax.N_BINDER: continue
            u32 ud = lookup(w, w.decls[d].pkg, w.p.sym(f, x))
            if a.tag[x] == syntax.T_PATH: ud = decl_named(w, f, x)
            u32 u = st_of_decl(w, ud)
            if u != NONE:
                w.straits[i].ext = #append(w.straits[i].ext, u)
                continue
            w.straits[i].failed = true
            say(w, f, 0, a.lo[x], a.hi[x], 535, index.hold(#format("`", tn, "` extends `", w.p.files[f].src[i64(a.lo[x])..<i64(a.hi[x])], "`, which is no trait a script declares here: a trait extends traits only")), "name a trait written in a class of the package — `Goblin.Drawable` — or drop it")
    // `async Self`: not built.
    for i in 0..<#len(w.straits):
        u32 d = w.straits[i].decl
        for m in w.straits[i].ms:
            u32 f = w.decls[m].file
            syntax.Ast a = w.p.files[f].a
            u32 mn = w.decls[m].node
            u32 rn = a.list(a.b[mn])[0]
            if (a.a[mn] & syntax.F_ASYNC) == 0 || rn == NONE || a.tag[rn] != syntax.T_NAME || w.p.spell(f, rn) != "Self": continue
            string8 nm = w.p.spell(f, mn)
            u32 k = sa_kw(w, f, mn)
            say(w, f, 0, k, k + 5, 1330, index.hold(#format("`", nm, "` answers `Self` later, and an `async` trait method answering `Self` is not built yet")), index.hold(#format("answer the trait's own type, `async ", name_of(w, w.decls[d].name), " ", nm, "(…)`, or drop `async`")))
    // A cycle, then a default replaced.
    for i in 0..<#len(w.straits):
        bool cyc = false
        for u in w.straits[i].ext:
            for v in st_family(w, u):
                if v == u32(i): cyc = true
        if !cyc: continue
        u32 d = w.straits[i].decl
        say_tok(w, w.decls[d].file, 0, w.decls[d].node, 535, index.hold(#format("`", s_qual(w, d), "` extends itself, through the traits it extends: a trait builds on other traits")), "end the chain: one of the traits extends none")
        w.straits[i].failed = true
    for i in 0..<#len(w.straits):
        if w.straits[i].failed: continue
        u32 d = w.straits[i].decl
        for m in w.straits[i].ms:
            ref []u32 fam = st_family(w, u32(i))
            for up in fam[1..<#len(fam)]:
                for o in w.straits[up].ms:
                    if w.decls[o].name != w.decls[m].name || !st_default(w, o): continue
                    string8 mn = name_of(w, w.decls[m].name)
                    string8 child = s_qual(w, d)
                    say_tok(w, w.decls[d].file, 0, w.decls[d].node, 535, index.hold(#format("`", child, "` writes `", mn, "`, which `", s_qual(w, w.straits[up].decl), "` already defaults: a trait may default a parent's required method, never replace a parent's default — only a class taking it on replaces one")), index.hold(#format("drop `", mn, "` from `", child, "`, or write it in each class that wants another body")))
    // Each class's `using`, the shortest chains first.
    ref []u32 order
    for depth in 0..<64:
        for ci in 0..<#len(w.classes):
            u32 dd = 0
            u32 at = s_parent(w, u32(ci))
            for at != NONE && dd < 64:
                dd += 1
                at = s_parent(w, at)
            if dd == u32(depth): order = #append(order, u32(ci))
    for ci in order:
        []u32 us = w.classes[ci].usings[:]
        for un in us:
            u32 t = st_using(w, ci, un)
            if t == NONE: continue
            bool dup = false
            for x in w.classes[ci].traits:
                if x == t: dup = true
            if dup: continue
            w.classes[ci].traits = #append(w.classes[ci].traits, t)
            st_conform(w, ci, t, un)
    // Defaults checked once, against the trait.
    for i in 0..<#len(w.straits):
        if w.straits[i].failed: continue
        for m in w.straits[i].ms:
            if st_default(w, m): _ = job(w, m, NONE)

// The methods `t` asks of class `ci`: each written with the trait's
// signature (ERR0536), else given its default.
private void st_conform(^World w, u32 ci, u32 t, u32 un):
    u32 itself = resolve(w, w.classes[ci].decl)
    string8 cn = name_of(w, w.decls[w.classes[ci].decl].name)
    string8 short = name_of(w, w.decls[w.straits[t].decl].name)
    u32 cf = w.classes[ci].file
    syntax.Ast ca = w.p.files[cf].a
    for m in st_methods(w, t):
        string8 wanted = st_sig_written(w, m, itself)
        string8 mn = name_of(w, w.decls[m].name)
        u32 have = s_method_in(w, ci, w.decls[m].name)
        if have != NONE && w.decls[w.decls[have].block].kind == K_TRAIT: have = NONE
        if have == NONE:
            if st_default(w, m):
                w.methods[(u64(w.classes[ci].decl) << 32) | u64(w.decls[m].name)] = m
                w.classes[ci].given = #append(w.classes[ci].given, m)
                continue
            string8 help = se_answers(w, ci, w.decls[m].name)
            if #len(help) == 0: help = index.hold(#format("write it in `", cn, "` — `", wanted, ":` and its body"))
            say(w, cf, 0, ca.lo[un], ca.hi[un], 536, index.hold(#format("`", cn, "` takes on `", short, "`, which asks `", wanted, "`, and `", cn, "` has no method `", mn, "`")), help)
            continue
        if st_same(w, have, m, itself): continue
        string8 ours = st_sig_written(w, have, itself)
        u32 oc = s_class_of_ty(w, resolve(w, w.decls[have].block))
        string8 owner = name_of(w, w.decls[w.decls[have].block].name)
        w.d.phase = diag.PH_INTERFACE
        if oc == ci: say_tok(w, w.decls[have].file, 0, w.decls[have].node, 536, index.hold(#format("`", cn, "` takes on `", short, "`, which asks `", wanted, "`, and `", owner, "`'s `", mn, "` is `", ours, "`")), index.hold(#format("write `", mn, "` as `", short, "` asks it — `", wanted, "`")))
        else: say(w, cf, 0, ca.lo[un], ca.hi[un], 536, index.hold(#format("`", cn, "` takes on `", short, "`, which asks `", wanted, "`, and `", owner, "`'s `", mn, "` is `", ours, "`")), index.hold(#format("write `", mn, "` as `", short, "` asks it — `", wanted, "`")))

// Whether method `have` has trait method `m`'s signature, `Self` as `itself`.
private bool st_same(^World w, u32 have, u32 m, u32 itself):
    u32 hf = w.decls[have].file
    u32 mf = w.decls[m].file
    syntax.Ast ha = w.p.files[hf].a
    syntax.Ast ma = w.p.files[mf].a
    []u32 hk = ha.list(ha.b[w.decls[have].node])
    []u32 mk = ma.list(ma.b[w.decls[m].node])
    if #len(hk) != #len(mk): return false
    if (ha.a[w.decls[have].node] & syntax.F_ASYNC) != (ma.a[w.decls[m].node] & syntax.F_ASYNC): return false
    if st_as(st_sig_ty(w, hf, hk[0]), itself) != st_as(st_sig_ty(w, mf, mk[0]), itself): return false
    u32 hl = NONE
    u32 ml = NONE
    for i in 6..<#len(hk):
        if ha.a[hk[i]] != NONE: hl = st_sig_ty(w, hf, ha.a[hk[i]])
        if ma.a[mk[i]] != NONE: ml = st_sig_ty(w, mf, ma.a[mk[i]])
        if st_as(hl, itself) != st_as(ml, itself): return false
    return true

// `v.m(…)` through a trait value or a default's `self` (`inst` its operand).
Val st_call(^World w, ^Body b, u32 n, u32 cn, u32 t, bool self_, u32 inst):
    string8 short = name_of(w, w.decls[w.straits[t].decl].name)
    string8 s = index.hold(strings.clone(spell(w, b, cn)))
    u32 m = NONE
    ref []string8 pool
    for x in st_methods(w, t):
        pool = #append(pool, name_of(w, w.decls[x].name))
        if name_of(w, w.decls[x].name) == s: m = x
    if m == NONE:
        for g in call_args(w, b, n):
            _ = expr(w, b, arg_value(w, b, g), NONE)
        string8 h = nearest(s, pool[:])
        if #len(h) > 0: h = index.hold(#format("did you mean `", h, "`?"))
        if self_:
            if #len(h) == 0: h = index.hold(#format("make `", s, "` a required method of `", short, "`, which every class taking it on then writes"))
            err_tok(w, b, cn, 410, index.hold(#format("`", s, "` is no method of `", short, "`, and a default body reaches `self` only through `", short, "`'s methods — a trait prescribes methods, never fields")), h)
        else:
            if #len(h) == 0: h = index.hold(#format("make `", s, "` a method of `", short, "`, or hold the value as its class"))
            err_tok(w, b, cn, 410, index.hold(#format("`", s, "` is no method of `", short, "`, and a value of a trait reaches only its trait's methods")), h)
        return bad()
    u32 mf = w.decls[m].file
    syntax.Ast ma = w.p.files[mf].a
    []u32 mk = ma.list(ma.b[w.decls[m].node])
    u32 itself = w.straits[t].ty
    if self_: itself = w.straits[t].self_ty
    ref []u32 pts
    u32 last = NONE
    bool takes_self = false
    for q in mk[6..<#len(mk)]:
        if ma.a[q] != NONE: last = st_sig_ty(w, mf, ma.a[q])
        if last == ST_SELF: takes_self = true
        pts = #append(pts, st_as(last, itself))
    if takes_self && !self_:
        for g in call_args(w, b, n):
            _ = expr(w, b, arg_value(w, b, g), NONE)
        string8 art = h_article(short)
        err_tok(w, b, cn, 616, index.hold(#format("`", st_sig_written(w, m, NONE), "` takes a `Self`, which ", art, " `", short, "` value cannot name: a trait value knows its class only when the script runs")), index.hold(#format("call `", s, "` on a value of the class itself, or take ", art, " `", short, "` in place of the `Self`")))
        return bad()
    u32 rt = st_as(st_sig_ty(w, mf, mk[0]), itself)
    if (ma.a[w.decls[m].node] & syntax.F_ASYNC) != 0: rt = sa_type(w, rt)
    ref []u32 opds
    opds = #append(opds, inst)
    if !s_args_of(w, b, n, pts[:], mf, mk[6..<#len(mk)], s, &opds): return bad()
    u32 dt = NONE
    if rt != u32(types.P_VOID): dt = temp(w, b, rt, n)
    u32 r = ir.fn_ref(&b.f, b.f.pkg, tstr(w, s), 0)
    _ = ir.op(&b.f, ir.O_CALL, 0, rt, n, dt, r)
    for o in opds:
        ir.arg(&b.f, o)
    return value(dt, rt)

// `v.f` of a trait value or a default's `self`: ERR0410.
Val st_field(^World w, ^Body b, u32 n, u32 t, bool self_):
    string8 short = name_of(w, w.decls[w.straits[t].decl].name)
    string8 s = index.hold(strings.clone(spell(w, b, n)))
    for x in st_methods(w, t):
        if name_of(w, w.decls[x].name) == s:
            err_tok(w, b, n, 410, index.hold(#format("`", s, "` is a method of `", short, "`, and reading one without calling it is not built for a trait")), index.hold(#format("call it — `", src(w, b, n), "(…)` — or wrap the call in a lambda")))
            return bad()
    if self_: err_tok(w, b, n, 410, index.hold(#format("`", s, "` is no method of `", short, "`, and a default body reaches `self` only through `", short, "`'s methods — a trait prescribes methods, never fields")), index.hold(#format("make it a required method of `", short, "` — `int ", s, "()` — which every class taking it on then writes")))
    else: err_tok(w, b, n, 410, index.hold(#format(h_article(short), " `", short, "` value has no field `", s, "`: a trait prescribes methods, never fields")), index.hold(#format("make it a required method of `", short, "` — `int ", s, "()` — and call it")))
    return bad()

// Whether a value of `ty` has no zero: an instance, a trait value, or a tuple holding one.
bool st_no_zero(^World w, u32 ty):
    if sa_inner(w, ty) != NONE: return true
    bool sf = false
    if s_class_of_ty(w, ty) != NONE || st_of_ty(w, ty, &sf) != NONE: return true
    if s_tup(w, ty):
        for x in w.t.slots(ty):
            if st_no_zero(w, x): return true
    return false

// A slot of `ty` named by node `n` (file `f`) declared with no value: ERR1310.
void st_needs(^World w, u32 f, u32 n, u32 ty):
    if ty == NONE || !st_no_zero(w, ty): return
    string8 nm = w.p.spell(f, n)
    if sa_inner(w, ty) != NONE:
        string8 sh = shown(w, ty)
        say_tok(w, f, 0, n, 1330, index.hold(#format("`", nm, "` is `", sh, "`, and a script has no null to start it at: an `async` slot holds what an `async` call answered")), index.hold(#format("give it its first value where it is declared, the call it waits on: `", sh, " ", nm, " = load()`")))
        return
    if s_tup(w, ty):
        u32 inner = NONE
        for x in w.t.slots(ty):
            if inner == NONE && st_no_zero(w, x): inner = x
        if s_tup(w, inner):
            st_needs(w, f, n, inner)
            return
        string8 sh = s_written(w, ty)
        string8 hd = s_written(w, inner)
        u16 code = 1310
        if sa_inner(w, inner) != NONE: code = 1330
        say_tok(w, f, 0, n, code, index.hold(#format("`", nm, "` is ", h_article(sh), " `", sh, "`, which holds ", h_article(hd), " `", hd, "`, and a script has no null to start it at: a tuple's slots always hold their values")), index.hold(#format("give it its first value where it is declared: `", sh, " ", nm, " = (…)`")))
        return
    u32 ci = s_class_of_ty(w, ty)
    if ci != NONE:
        string8 cs = name_of(w, w.decls[w.classes[ci].decl].name)
        say_tok(w, f, 0, n, 1310, index.hold(#format("`", nm, "` is ", h_article(cs), " `", cs, "`, and a script has no null to start it at: a slot of a class's type always holds an instance")), index.hold(#format("construct its first value where it is declared: `", cs, " ", nm, " = ", cs, "(…)`")))
        return
    bool sf = false
    u32 t = st_of_ty(w, ty, &sf)
    string8 ts = name_of(w, w.decls[w.straits[t].decl].name)
    say_tok(w, f, 0, n, 1310, index.hold(#format("`", nm, "` is ", h_article(ts), " `", ts, "`, and a script has no null to start it at: a slot of a trait's type always holds an instance of a class taking it on")), index.hold(#format("give it its first value where it is declared — an instance of a class taking `", ts, "` on: `", ts, " ", nm, " = Goblin(…)`")))

// The declaration a written path names from file `f` — `Name`,
// `Class.Name`, `pkg.Name`, `pkg.Class.Name` — by its parts' symbols, or NONE.
u32 s_path_decl(^World w, u32 f, []u32 parts):
    if #len(parts) == 0: return NONE
    u32 pkg = w.p.files[f].pkg
    i64 from = 0
    if #len(parts) > 1:
        for im in w.p.pkgs[pkg].imports:
            u32 nm = im.name
            if nm == NONE: nm = w.p.pkgs[im.pkg].name
            if im.file == f && nm == parts[0]:
                pkg = im.pkg
                from = 1
    []u32 rest = parts[from..<#len(parts)]
    if #len(rest) == 1: return lookup(w, pkg, rest[0])
    ref []string8 ss
    for x in rest:
        ss = #append(ss, name_of(w, x))
    string8 j = index.hold(strings.join(ss[:], "."))
    u32 d = lookup(w, pkg, w.p.names.intern(j))
    if d != NONE: return d
    d = lookup(w, pkg, rest[#len(rest) - 1])
    if d == NONE: return NONE
    string8 q = index.hold(#format(".", s_qual(w, d)))
    string8 jj = index.hold(#format(".", j))
    if strings.ends_with(q, jj): return d
    return NONE

// A `T_PATH`'s parts.
ref []u32 s_tpath(^World w, u32 f, u32 n):
    syntax.Ast a = w.p.files[f].a
    ref []u32 ps
    if a.a[n] != NONE: ps = #append(ps, w.p.files[f].t.sym[a.a[n]])
    ps = #append(ps, w.p.sym(f, n))
    if a.b[n] != NONE: ps = #append(ps, w.p.files[f].t.sym[a.b[n]])
    return ps

// An expression path's parts (`a.b.c` of names), or empty.
ref []u32 s_epath(^World w, u32 f, u32 n):
    syntax.Ast a = w.p.files[f].a
    ref []u32 ps
    if a.tag[n] == syntax.E_NAME:
        ps = #append(ps, w.p.sym(f, n))
        return ps
    if a.tag[n] != syntax.E_FIELD: return ps
    ps = s_epath(w, f, a.a[n])
    if #len(ps) == 0: return ps
    ps = #append(ps, w.p.sym(f, n))
    return ps
