// Dado's enums, `distinct` types and unions as a script holds them:
// an enum is itself; a `distinct` type over a
// scalar is the script's `distinct` over the scalar's script type, one tag
// with Dado's; a union is the script's union of its members' script types.
package check

import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:strings"

// Whether declaration `d` is a script's.
bool s_decl_ds(^World w, u32 d):
    return ds_at(w, w.decls[d].file, w.decls[d].node)

// The Dado enum declaration type `ty` names, or NONE.
u32 s_denum(^World w, u32 ty):
    if ty == NONE || !(ty in w.type_decl): return NONE
    try u32 d = w.type_decl[ty] else: return NONE
    if w.decls[d].kind != K_ENUM || s_decl_ds(w, d): return NONE
    return d

// A `distinct` row of Dado's own under `ty` (no handle, enum or `#` tag),
// or NONE.
u32 s_ddist(^World w, u32 ty):
    if ty == NONE || s_denum(w, ty) != NONE || s_class_of_ty(w, ty) != NONE: return NONE
    u32 r = w.t.resolve(ty)
    if r == NONE || w.t.tag[r] != types.T_DISTINCT: return NONE
    string8 tg = w.t.text(w.t.a[r])
    if #len(tg) == 0 || tg[0] == '#': return NONE
    return r

// `ty` with Dado's `distinct` tags taken off.
u32 s_erase(^World w, u32 ty):
    u32 t = ty
    for _ in 0..<16:
        u32 r = s_ddist(w, t)
        if r == NONE: return t
        t = w.t.b[r]
    return t

// The union row of Dado's own `ty` declares, or NONE.
u32 s_dunion(^World w, u32 ty):
    u32 u = union_of(w, ty)
    if u == NONE || !(ty in w.type_decl): return NONE
    try u32 d = w.type_decl[ty] else: return NONE
    if w.decls[d].kind != K_UNION || s_decl_ds(w, d): return NONE
    return u

// The script's type of Dado type `ty`.
u32 s_dview(^World w, u32 ty):
    if ty == NONE || s_denum(w, ty) != NONE: return ty
    u32 dr = s_ddist(w, ty)
    if dr != NONE:
        u8 k = seam_kind(w, w.t.b[dr], false)
        if k != SK_INT && k != SK_FLOAT && k != SK_BOOL && !sk_str(k): return ty
        string8 tg = index.hold(strings.clone(w.t.text(w.t.a[dr])))
        return w.t.distinct_of(tg, sk_script(w, k))
    u32 ur = s_dunion(w, ty)
    if ur == NONE: return ty
    ref []u32 ms
    for m in w.t.list(ur):
        ms = #append(ms, s_dmember(w, m))
    return w.t.make(types.T_UNION, w.t.a[ur], 0, ms[:])

// A Dado union's member as the script holds it.
u32 s_dmember(^World w, u32 m):
    if s_denum(w, m) != NONE || s_ddist(w, m) != NONE || s_dunion(w, m) != NONE: return s_dview(w, m)
    u8 k = seam_kind(w, m, false)
    if k == SK_INT || k == SK_FLOAT || k == SK_BOOL || sk_str(k): return sk_script(w, k)
    return m

// Why Dado union `ty` does not cross (its member `part`), or "".
string8 s_union_refused(^World w, u32 ty, ^u32 part):
    u32 ur = s_dunion(w, ty)
    []u32 ms = w.t.list(ur)
    for m in ms:
        u8 k = seam_kind(w, m, false)
        if k == SK_NONE || k == SK_INST || k == SK_CB:
            part^ = m
            return "member"
    for i in 0..<#len(ms):
        for j in i + 1..<#len(ms):
            if s_sview(w, seam_sty(w, ms[i], false)) == s_sview(w, seam_sty(w, ms[j], false)): return "two of its members cross as one script type"
    return ""

// The declaration type `ty` names, or NONE.
u32 s_tdecl(^World w, u32 ty):
    if ty == NONE || !(ty in w.type_decl): return NONE
    try u32 d = w.type_decl[ty] else: return NONE
    return d

// The Dado type script type `st` (a union's or a `distinct` type's view)
// is the view of, or `st`.
u32 s_dado_of(^World w, u32 st):
    for t, d in w.type_decl:
        if s_decl_ds(w, d) || w.decls[d].kind != K_TYPE && w.decls[d].kind != K_UNION: continue
        if t != st && s_dview(w, t) == st: return t
    return st

// The member of a script's union `st` Dado type `dt` crosses into: its
// index, or -1.
i64 s_umember(^World w, u32 st, u32 dt):
    []u32 ms = w.t.list(union_of(w, st))
    u32 sv = s_sview(w, seam_sty(w, dt, false))
    for i in 0..<#len(ms):
        if w.t.resolve(ms[i]) == sv: return i
    return -1

// `ty` as Rust shows it beside a class: a handle as `pkg.Class`.
string8 s_cshown(^World w, u32 ty):
    u32 ci = s_class_of_ty(w, ty)
    if ci != NONE: return index.hold(#format(name_of(w, w.p.pkgs[w.decls[w.classes[ci].decl].pkg].name), ".", s_short(w, w.classes[ci].decl)))
    u32 r = w.t.resolve(ty)
    if r != NONE && w.t.tag[r] == types.T_SLICE && s_class_of_ty(w, w.t.a[r]) != NONE: return index.hold(#format("[]", s_cshown(w, w.t.a[r])))
    return shown(w, ty)

const u8 B_SENUM_OF = 164   // dst = Dado enum a's value of number b
const u8 B_SENUM_INT = 165  // dst = the number of Dado enum a's value b

// The name value `v` of Dado enum `d` crosses as (the first member declared
// with it), or "".
string8 s_ename(^World w, u32 d, i64 v):
    for key in w.order:
        if u32(key >> 32) != d: continue
        try u32 c = w.members[key] else: continue
        if c != NONE && w.k.kind[c] == types.C_INT && i64(w.k.w0[c]) == v: return name_of(w, u32(key & 0xFFFFFFFF))
    return ""

// Dado enum `ty`'s value `v` as a script holds it: its member's name, else
// its number.
Val s_evalue(^World w, u32 ty, i64 v):
    string8 nm = s_ename(w, s_denum(w, ty), v)
    if #len(nm) > 0: return value(ir.konst(w.k.str(&w.t, nm)), ty)
    return value(ir.konst(w.k.small(&w.t, v)), ty)

// A constant of Dado enum `ty` as a script holds it, or `cv`.
Val s_eknst(^World w, Val cv, u32 ty):
    if !ir.is_const(cv.opd): return cv
    u32 k = cv.opd & ~ir.OPD_CONST
    if w.k.kind[k] != types.C_INT: return cv
    return s_evalue(w, ty, i64(w.k.w0[k]))

// `Dir(n)` in a script: the value of Dado enum `ty` whose number is `n`.
Val s_enum_make(^World w, ^Body b, u32 n, u32 ty):
    syntax.Ast a = tree(w, b)
    []u32 xs = call_args(w, b, n)
    string8 sp = index.hold(strings.clone(src(w, b, a.list(a.b[n])[0])))
    if #len(xs) != 1:
        for g in xs:
            _ = expr(w, b, arg_value(w, b, g), NONE)
        err(w, b, n, 601, index.hold(#format("`", sp, "(n)` makes a `", sp, "` of one number, and this call passes ", #len(xs))), index.hold(#format("pass exactly one `int`: `", sp, "(n)`")))
        return bad()
    u32 g = arg_value(w, b, xs[0])
    Val v = finish(w, b, expr(w, b, g, NONE), g)
    if v.ty == NONE: return bad()
    if s_denum(w, v.ty) != NONE && s_denum(w, v.ty) == s_denum(w, ty): return value(v.opd, ty)
    if v.ty != u32(types.P_INT):
        string8 rep = "pass an `int`"
        if v.ty == u32(types.P_FLOAT): rep = index.hold(#format("convert it first: `", sp, "(int(", src(w, b, g), "))`"))
        err(w, b, g, 504, index.hold(#format("`", sp, "(n)` makes a `", sp, "` of its number, an `int`, and this is `", shown(w, v.ty), "`")), rep)
        return bad()
    if ir.is_const(v.opd) && w.k.kind[v.opd & ~ir.OPD_CONST] == types.C_INT: return s_evalue(w, ty, i64(w.k.w0[v.opd & ~ir.OPD_CONST]))
    u32 t = temp(w, b, ty, n)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SENUM_OF, ty, n, t, NONE)
    ir.arg(&b.f, ir.konst(w.k.small(&w.t, i64(s_denum(w, ty)))))
    ir.arg(&b.f, v.opd)
    return value(t, ty)

// `int(d)` of a value of Dado enum `d`'s type.
Val s_enum_int(^World w, ^Body b, u32 n, Val v):
    u32 d = s_denum(w, v.ty)
    if ir.is_const(v.opd):
        u32 k = v.opd & ~ir.OPD_CONST
        if w.k.kind[k] == types.C_INT: return value(v.opd, u32(types.P_INT))
        if w.k.kind[k] == types.C_STR:
            string8 nm = w.t.text(w.k.a[k])
            for key in w.order:
                if u32(key >> 32) != d || name_of(w, u32(key & 0xFFFFFFFF)) != nm: continue
                try u32 c = w.members[key] else: continue
                return value(ir.konst(w.k.small(&w.t, i64(w.k.w0[c]))), u32(types.P_INT))
    u32 t = temp(w, b, u32(types.P_INT), n)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_SENUM_INT, u32(types.P_INT), n, t, NONE)
    ir.arg(&b.f, ir.konst(w.k.small(&w.t, i64(d))))
    ir.arg(&b.f, v.opd)
    return value(t, u32(types.P_INT))

// The zero of Dado enum `ty` as a script holds it.
u32 s_ezero(^World w, u32 ty):
    return s_evalue(w, ty, 0).opd
