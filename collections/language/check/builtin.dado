// Every `#` name the compiler owns, as data: one row per spelling, with
// where it is written, what it means, its arity, its documentation and
// its DadoScript column.
package check

const u8 POS_VALUE = 0
const u8 POS_CALL = 1
const u8 POS_SPLAT = 2
const u8 POS_PREDICATE = 3
const u8 POS_TYPE = 4
const u8 POS_MARKER = 5
const u8 POS_PACK = 6

const u8 FAM_NONE = 0
const u8 FAM_DIAGNOSTICS = 1
const u8 FAM_LAYOUTS = 2

const u8 DS_SPELLED = 0
const u8 DS_SAME = 1
const u8 DS_ABSENT = 2

// A verb prints its arguments as `#render` does.
const u8 PRINTS = 1

// Meanings: a verb (`B_*`, `dado_check::Builtin` order), or what else a name is (`M_*`).
const u8 B_BREAKPOINT = 0
const u8 B_PANIC = 1
const u8 B_QUIT = 2
const u8 B_TRANSPOSE = 3
const u8 B_LEN = 4
const u8 B_ASSERT = 5
const u8 B_EXPECT = 6
const u8 B_SIZE = 7
const u8 B_ALIGN_OF = 8
const u8 B_NEW = 9
const u8 B_MAKE = 10
const u8 B_RESIZE = 11
const u8 B_DELETE = 12
const u8 B_COPY = 13
const u8 B_FORMAT = 14
const u8 B_RENDER = 15
const u8 B_APPEND = 16
const u8 B_RESERVE = 17
const u8 B_TRUNCATE = 18
const u8 B_CAP = 19
const u8 B_POPCOUNT = 20
const u8 B_CLZ = 21
const u8 B_CTZ = 22
const u8 B_BSWAP = 23
const u8 B_MUL_WIDE = 24
const u8 B_ADD_OVERFLOW = 25
const u8 B_SUB_OVERFLOW = 26
const u8 B_MUL_OVERFLOW = 27
const u8 B_ROTL = 28
const u8 B_ROTR = 29
const u8 B_ALIGN_FORWARD = 30
const u8 B_ATOMIC_LOAD = 31
const u8 B_ATOMIC_STORE = 32
const u8 B_ATOMIC_EXCHANGE = 33
const u8 B_ATOMIC_COMPARE_EXCHANGE = 34
const u8 B_ATOMIC_FETCH_ADD = 35
const u8 B_ATOMIC_FETCH_SUB = 36
const u8 B_ATOMIC_FETCH_AND = 37
const u8 B_ATOMIC_FETCH_OR = 38
const u8 B_ATOMIC_FETCH_XOR = 39
const u8 B_FENCE = 40
const u8 B_NAMES = 41
const u8 B_SEND = 42
const u8 B_PEEK = 43
const u8 B_DRAIN = 44
const u8 B_RELEASE = 45
const u8 B_SHADER_LOAD = 46
const u8 B_SCRIPT_VM = 47
const u8 B_SCRIPT_RUN = 48
const u8 B_SCRIPT_NEW = 49
const u8 B_SCRIPT_STOP = 50
const u8 B_SCRIPT_PAUSE = 51
const u8 B_SCRIPT_RESUME = 52
const u8 B_SCRIPT_IS_RUNNING = 53
const u8 B_SCRIPT_IS_PAUSED = 54
const u8 B_SCRIPT_PUMP = 55
const u8 B_SCRIPT_RELOAD = 56
const u8 B_SCRIPT_ERROR = 57
const u8 B_TRACE = 58
const u8 B_LOCATION = 59
const u8 M_DEFAULT_ALLOCATOR = 100
const u8 M_STACK_RUNG = 101
const u8 M_RETURN_ALLOCATOR = 102
const u8 M_CALLER_ALLOCATOR = 103
const u8 M_HEAP_ALLOCATOR = 104
const u8 M_FOLDED_LENGTH = 105
const u8 M_SPLAT_SLOTS = 106
const u8 M_TYPE_PREDICATE = 107
const u8 M_LAYOUT = 108
const u8 M_NO_BOUNDS_CHECK = 109
const u8 M_ANY_PACK = 110
const u8 M_TYPE_SPELLING = 111
const u8 M_STATIC_ASSERT = 112
const u8 M_ASSERT_RAISES = 113
const u8 M_CHANNEL = 114

// `hi` 255 takes any number of arguments (a non-verb's arity is its usage's). `sub` is a predicate's or a layout's own number.
type Builtin:
    string8 name
    u8 position
    u8 meaning
    u8 sub
    u8 family
    u8 lo
    u8 hi
    u8 flags
    string8 usage
    string8 describes
    u8 dados
    string8 dados_text
    string8 dados_why

const string8 NO_ALLOCATOR = "an allocator is memory management, and the DadoScript runtime owns memory; a DadoScript value needs no allocator"
const string8 NO_ATOMIC = "an atomic access is a thread primitive, and a script shares no memory between threads; write it in Dado"
const string8 NO_CHANNEL = "a channel is a lock-free mailbox between threads, a thread primitive, and a script has no threads; declare it and send into it in Dado, and a script consumes one by `receive(ch, handler)`"
const string8 NO_FIT = "DadoScript's `int` wraps at 2^63 and never asks whether an operation fit; write the checked arithmetic in Dado"
const string8 NO_HOST_VERB = "a `#script_*` verb is how a Dado host loads and runs a script; a script loads another by its path, `Script.load(path)`, and calls a method of what it answers"
const string8 NO_LAYOUT = "a layout is representation, which the DadoScript runtime owns; lay it out in Dado"
const string8 NO_SUCH_TYPE = "no DadoScript type satisfies it, so asking is refused rather than answered `false`"
const string8 NO_TRACE = "a script's trace is its `Error`'s: `e.trace` is a `[]Location`, innermost first; the place it is written is `Location()`, as it is `#location()` in Dado"
const string8 NO_WIDTH = "the answer depends on an integer's width, and DadoScript's `int` has one width it never writes; write it in Dado"

const [88]Builtin BUILTINS = (
    Builtin("#default", POS_VALUE, M_DEFAULT_ALLOCATOR, 0, FAM_NONE, 0, 0, 0, "#default", "names the ambient working allocator, as its two words `(proc, data)`", DS_ABSENT, "", NO_ALLOCATOR),
    Builtin("#stack", POS_VALUE, M_STACK_RUNG, 0, FAM_NONE, 0, 0, 0, "#stack", "puts an allocation in the enclosing frame, and is an allocator argument rather than an allocator value", DS_ABSENT, "", NO_ALLOCATOR),
    Builtin("#return", POS_VALUE, M_RETURN_ALLOCATOR, 0, FAM_NONE, 0, 0, 0, "#return", "allocates with the caller's lifetime, which is the ambient allocator seen from outside any suite that shadowed it", DS_ABSENT, "", NO_ALLOCATOR),
    Builtin("#caller", POS_VALUE, M_CALLER_ALLOCATOR, 0, FAM_NONE, 0, 0, 0, "#caller", "allocates with the lifetime the immediate caller was given, which is the ambient that caller saw before any `using` it opened around the call, handed over by a direct call and only to a function that names it", DS_ABSENT, "", NO_ALLOCATOR),
    Builtin("#heap", POS_VALUE, M_HEAP_ALLOCATOR, 0, FAM_NONE, 0, 0, 0, "#heap", "allocates from the root rung, which is C's heap behind the allocator interface and the nil allocator where a target has none", DS_ABSENT, "", NO_ALLOCATOR),
    Builtin("#make", POS_CALL, B_MAKE, 0, FAM_NONE, 2, 3, 0, "#make([]T, n[, alloc]) -> ref([]T)", "mints a `ref([]T)` of `n` zeroed elements, from `#default` or from the allocator written last", DS_SPELLED, "xs.resize(n)", "the allocation half is memory management, which the runtime owns, and goes; the sizing half is `resize` on a new `[]T xs = []`, whose new elements are zero"),
    Builtin("#new", POS_CALL, B_NEW, 0, FAM_NONE, 1, 2, 0, "#new(T[, alloc]) -> ref(T)", "mints a `ref(T)`, zeroed, from `#default` or from the allocator written last", DS_ABSENT, "", "mints a `ref(T)`, which is memory management; a DadoScript value is a value, so write the value, or construct a class, `Name(…)`"),
    Builtin("#delete", POS_CALL, B_DELETE, 0, FAM_NONE, 1, 2, 0, "#delete(r)", "ends the allocation a reference holds and leaves the place it named `nil`, so a second delete of that place does nothing; a copy of the reference is not nilled, and a second delete through one is a double free nothing detects. Of a script handle `#script_load` answered, it ends the script's engine and everything in it, and nils the place the same way", DS_SPELLED, "m.delete(k)", "over a map key it is the container method `m.delete(k)`; over a reference it ends an allocation, which DadoScript has none of, since the runtime owns memory"),
    Builtin("#resize", POS_CALL, B_RESIZE, 0, FAM_NONE, 2, 2, 0, "#resize(xs, n) -> ref([]T)", "grows or shrinks the block behind a `ref([]T)` within its own allocator, so it takes no allocator argument, and answers the handle, which may have moved: `xs = #resize(xs, n)`; a `nil` run takes the current allocator, and a growth the allocator declines traps", DS_SPELLED, "xs.resize(n)", "a container method, and new elements are zero; no allocator to name"),
    Builtin("#copy", POS_CALL, B_COPY, 0, FAM_NONE, 1, 2, 0, "#copy(x[, alloc]) -> ref(T) · ref([]T)", "duplicates a value into a new allocation, shallowly, answering a `ref(T)` for one and a `ref([]T)` for many", DS_SPELLED, "xs.copy()", "`[]T` and `{K: V}` are held by reference in DadoScript, so a copy is asked for, shallowly; `m.copy()` for a map"),
    Builtin("#format", POS_CALL, B_FORMAT, 0, FAM_NONE, 1, 255, PRINTS, "#format(args…[, alloc]) -> ref []char8", "renders its arguments as `#render` does and answers the bytes instead of writing them, allocated from `#default` or from the allocator written last", DS_SPELLED, "string(v)", "a value becomes text by the conversion shape `T(x)`, and texts join with `+`"),
    Builtin("#len", POS_CALL, B_LEN, 0, FAM_NONE, 1, 1, 0, "#len(xs) -> i64", "answers how many elements a container holds as an `i64`, whatever the container and wherever the answer stands, taking an inert place because it never runs its operand; over a channel it answers how many messages are queued, from any thread, exact only from the consumer while no producer runs", DS_SPELLED, "xs.len()", "a container method; a `string8`'s `#len` counts bytes, so it is `s.bytes().len()`, because `s.len()` counts UTF-16 code units"),
    Builtin("#size", POS_CALL, B_SIZE, 0, FAM_NONE, 1, 1, 0, "#size(T) · #size(x) -> u64", "emits a `sizeof`, so the byte count is the C compiler's answer as a `u64` and never folds", DS_ABSENT, "", "a byte count of a representation the DadoScript runtime owns, and it never folds; ask it in Dado"),
    Builtin("#alignof", POS_CALL, B_ALIGN_OF, 0, FAM_NONE, 1, 1, 0, "#alignof(T) -> u64", "emits an `_Alignof`, so the alignment is the C compiler's answer as a `u64` and never folds", DS_ABSENT, "", "a layout query about a representation the DadoScript runtime owns; ask it in Dado"),
    Builtin("#assert", POS_CALL, B_ASSERT, 0, FAM_DIAGNOSTICS, 1, 255, PRINTS, "#assert(cond[, message…])", "reports and aborts where its condition is false (on `#NONE`, which has no stream to report on, traps), and returns wherever the claim holds", DS_SPELLED, "assert cond, \"message\"", "a statement word, and a failed assert raises an `Error` a script may catch"),
    Builtin("#expect", POS_CALL, B_EXPECT, 0, FAM_DIAGNOSTICS, 2, 255, PRINTS, "#expect(cond, message…) -> bool", "reports where its condition is false and answers the claim, handing the decision back to the caller", DS_ABSENT, "", "reports and hands the verdict back, which is a testing library's verb; write `if !cond:` and `print`"),
    Builtin("#breakpoint", POS_CALL, B_BREAKPOINT, 0, FAM_DIAGNOSTICS, 0, 255, PRINTS, "#breakpoint([message…])", "writes its message to stderr and traps into a debugger", DS_ABSENT, "", "a debugger trap, which an editor's breakpoints serve; a script ordinarily needs none"),
    Builtin("#transpose", POS_CALL, B_TRANSPOSE, 0, FAM_NONE, 1, 1, 0, "#transpose(m)", "swaps the two levels of a nested tuple, so `[3](i32, f32)` and `([3]i32, [3]f32)` are each other's answer", DS_ABSENT, "", "reshapes a nested tuple's layout, numeric-kernel work that belongs in Dado; write it in Dado"),
    Builtin("#render", POS_CALL, B_RENDER, 0, FAM_NONE, 2, 2, PRINTS, "#render(v, sink)", "renders a value into the sink it is handed, and answers how many bytes that sink took", DS_SPELLED, "print(v)", "a sink is Dado's output machinery; a script writes to its output with `print`, and makes text with `string(v)`"),
    Builtin("#append", POS_CALL, B_APPEND, 0, FAM_NONE, 2, 2, 0, "#append(xs, v) · #append(xs, ..ys) -> ref([]T)", "puts one more element on the end of a run, or every element of `..ys`, growing the block where there is no room, and answers the handle, which may have moved: `xs = #append(xs, v)`; a `nil` run takes the current allocator, and a growth the allocator declines traps", DS_SPELLED, "xs.append(v)", "a container method; it answers nothing, since a DadoScript array always has room"),
    Builtin("#reserve", POS_CALL, B_RESERVE, 0, FAM_NONE, 2, 2, 0, "#reserve(xs, n) -> ref([]T)", "makes room for `n` elements without changing the length, never lowering a capacity, and answers the handle, which may have moved: `xs = #reserve(xs, n)`", DS_ABSENT, "", "capacity is representation, which the DadoScript runtime owns; a script's array grows as it is written"),
    Builtin("#cap", POS_CALL, B_CAP, 0, FAM_NONE, 1, 1, 0, "#cap(xs) -> i64", "answers how many elements a `ref([]T)`'s block holds, which is at least its length", DS_ABSENT, "", "capacity is representation, which the DadoScript runtime owns; a script asks `xs.len()`"),
    Builtin("#copy_into", POS_CALL, B_COPY_INTO, 0, FAM_NONE, 2, 2, 0, "#copy_into(dst, src) -> i64", "copies the shorter of two runs of one element type into the first, from its start, overlapping or not, and answers how many elements moved; `dst[i..<j] = src` copies an exact window instead", DS_ABSENT, "", "a script's `xs[i..<j]` answers a new array rather than a window into storage, so there is no existing run to copy into; build the array with its methods"),
    Builtin("#truncate", POS_CALL, B_TRUNCATE, 0, FAM_NONE, 2, 2, 0, "#truncate(xs, n)", "shortens a `ref([]T)` to `n` elements where it lives, keeping the capacity and asking no allocator; the dropped elements are zeroed and not destroyed, and `n` past the length traps", DS_SPELLED, "xs.resize(n)", "a DadoScript array keeps no capacity, so shortening one is `resize`, the one method that sets a length; a second word for it would be surface with nothing behind it"),
    Builtin("#popcount", POS_CALL, B_POPCOUNT, 0, FAM_NONE, 1, 1, 0, "#popcount(x)", "counts the set bits of an unsigned integer", DS_ABSENT, "", NO_WIDTH),
    Builtin("#clz", POS_CALL, B_CLZ, 0, FAM_NONE, 1, 1, 0, "#clz(x)", "counts the zero bits above the highest set one, and answers the operand's width for zero", DS_ABSENT, "", NO_WIDTH),
    Builtin("#ctz", POS_CALL, B_CTZ, 0, FAM_NONE, 1, 1, 0, "#ctz(x)", "counts the zero bits below the lowest set one, and answers the operand's width for zero", DS_ABSENT, "", NO_WIDTH),
    Builtin("#bswap", POS_CALL, B_BSWAP, 0, FAM_NONE, 1, 1, 0, "#bswap(x)", "reverses the bytes of a `u16`, `u32` or `u64`, and refuses the `u8` whose swap is the identity", DS_ABSENT, "", "reverses the bytes of a sized integer, which is representation; write it in Dado"),
    Builtin("#add_fits", POS_CALL, B_ADD_OVERFLOW, 0, FAM_NONE, 2, 2, 0, "#add_fits(a, b) -> (T sum, bool fits)", "answers the sum and whether it fit: the `bool` is true when the operation did **not** overflow, which is what the name says", DS_ABSENT, "", NO_FIT),
    Builtin("#sub_fits", POS_CALL, B_SUB_OVERFLOW, 0, FAM_NONE, 2, 2, 0, "#sub_fits(a, b) -> (T difference, bool fits)", "answers the difference and whether it fit, with `#add_fits`'s polarity", DS_ABSENT, "", NO_FIT),
    Builtin("#mul_fits", POS_CALL, B_MUL_OVERFLOW, 0, FAM_NONE, 2, 2, 0, "#mul_fits(a, b) -> (T product, bool fits)", "answers the product and whether it fit, with `#add_fits`'s polarity", DS_ABSENT, "", NO_FIT),
    Builtin("#LEN", POS_CALL, M_FOLDED_LENGTH, 0, FAM_NONE, 1, 1, 0, "#LEN(xs)", "asks `#len` and asserts the count is in the type, so a count that lives in the value is refused rather than read at run time; the answer is a number with no type of its own, which takes the type its position wants as an integer literal does", DS_SPELLED, "xs.len()", "in DadoScript `len()` folds wherever the count is in the type, so one spelling serves both halves of `#len`"),
    Builtin("#is_int", POS_PREDICATE, M_TYPE_PREDICATE, 0, FAM_NONE, 1, 1, 0, "where #is_int(T)", "holds in a `where` where the type is in the `int` category", DS_SPELLED, "T is int", "the shared infix `is`; `int` is DadoScript's one integer"),
    Builtin("#is_float", POS_PREDICATE, M_TYPE_PREDICATE, 1, FAM_NONE, 1, 1, 0, "where #is_float(T)", "holds in a `where` where the type is in the `float` category", DS_SPELLED, "T is float", "the shared infix `is`; `float` is DadoScript's one floating type"),
    Builtin("#is_number", POS_PREDICATE, M_TYPE_PREDICATE, 2, FAM_NONE, 1, 1, 0, "where #is_number(T)", "holds in a `where` where the type is in the `scalar` category", DS_SPELLED, "T is scalar", "the category `scalar` under its current name, with the shared infix `is`"),
    Builtin("#is_bool", POS_PREDICATE, M_TYPE_PREDICATE, 3, FAM_NONE, 1, 1, 0, "where #is_bool(T)", "holds in a `where` where the type is `bool`", DS_SPELLED, "T is bool", "the shared infix `is`"),
    Builtin("#is_char", POS_PREDICATE, M_TYPE_PREDICATE, 4, FAM_NONE, 1, 1, 0, "where #is_char(T)", "holds in a `where` where the type is `char8`, `char16` or `char32`", DS_ABSENT, "", "DadoScript has no character type, so no DadoScript type satisfies it and asking is refused; a character is a one-code-point `string`"),
    Builtin("#is_string", POS_PREDICATE, M_TYPE_PREDICATE, 5, FAM_NONE, 1, 1, 0, "where #is_string(T)", "holds in a `where` where the type is `string8`", DS_SPELLED, "T is string", "the shared infix `is`; `string` is DadoScript's one string type"),
    Builtin("#is_slice", POS_PREDICATE, M_TYPE_PREDICATE, 6, FAM_NONE, 1, 1, 0, "where #is_slice(T)", "holds in a `where` where the type is a `[]T` window rather than the two-slot shape it is represented as", DS_SPELLED, "T.is_slice()", "no category name means any `[]E`, so it is a built-in method on the type, and it folds"),
    Builtin("#is_map", POS_PREDICATE, M_TYPE_PREDICATE, 7, FAM_NONE, 1, 1, 0, "where #is_map(T)", "holds in a `where` where the type is a `{K: V}`", DS_SPELLED, "T.is_map()", "as `#is_slice`: a built-in method on the type"),
    Builtin("#is_ref", POS_PREDICATE, M_TYPE_PREDICATE, 8, FAM_NONE, 1, 1, 0, "where #is_ref(T)", "holds in a `where` where the type is a `ref(T)` or a `ref([]T)`", DS_ABSENT, "", NO_SUCH_TYPE),
    Builtin("#is_pointer", POS_PREDICATE, M_TYPE_PREDICATE, 9, FAM_NONE, 1, 1, 0, "where #is_pointer(T)", "holds in a `where` where the type is a `^T`", DS_ABSENT, "", NO_SUCH_TYPE),
    Builtin("#has_eq", POS_PREDICATE, M_TYPE_PREDICATE, 10, FAM_NONE, 1, 1, 0, "where #has_eq(T)", "holds in a `where` where `==` applies to the type — exactly where `a == a` compiles; a map key asks more, and that is `#is_key`", DS_SPELLED, "T has ==", "the shared `has` form asks the same"),
    Builtin("#is_key", POS_PREDICATE, M_TYPE_PREDICATE, 11, FAM_NONE, 1, 1, 0, "where #is_key(T)", "holds in a `where` where the type may key a `{K: V}` — its `==` is stable and Dado lays it out, so a float, a pointer, a slice, a `#c` scalar and any shape holding one do not hold", DS_SPELLED, "T.is_key()", "asks DadoScript's own key rule, which refuses mutable containers, so it is a built-in method on the type"),
    Builtin("#is_declared", POS_PREDICATE, M_TYPE_PREDICATE, 12, FAM_NONE, 1, 1, 0, "where #is_declared(T)", "holds in a `where` where the call bound the type by a declared name rather than as a shape written out; asking it instantiates the template once per declaration, which is how a template carries a declaration to one it calls", DS_ABSENT, "", "steers instantiation per declaration, and DadoScript generics are erased where they are emitted; write the template in Dado"),
    Builtin("#mul_wide", POS_CALL, B_MUL_WIDE, 0, FAM_NONE, 2, 2, 0, "#mul_wide(a, b) -> (i64 hi, u64 lo)", "answers the full 128-bit product of two `i64`s as the pair `(i64 hi, u64 lo)`", DS_ABSENT, "", "a 128-bit product is a width DadoScript never writes; write it in Dado"),
    Builtin("#panic", POS_CALL, B_PANIC, 0, FAM_DIAGNOSTICS, 1, 255, PRINTS, "#panic(message…)", "reports and aborts, and never returns", DS_SPELLED, "fail \"message\"", "a script never ends its host: DadoScript fails, and the failure can be caught"),
    Builtin("#rotl", POS_CALL, B_ROTL, 0, FAM_NONE, 2, 2, 0, "#rotl(x, n)", "turns a bit pattern left by `n` places, the bits leaving the top arriving at the bottom, with the count taken modulo the width", DS_ABSENT, "", NO_WIDTH),
    Builtin("#rotr", POS_CALL, B_ROTR, 0, FAM_NONE, 2, 2, 0, "#rotr(x, n)", "turns a bit pattern right by `n` places, with `#rotl`'s count rule", DS_ABSENT, "", NO_WIDTH),
    Builtin("#align_forward", POS_CALL, B_ALIGN_FORWARD, 0, FAM_NONE, 2, 2, 0, "#align_forward(p, n)", "answers the first address at or after a pointer that is a multiple of `n`, where a written `n` is a power of two", DS_ABSENT, "", "pointer arithmetic, and a script holds no address; write it in Dado"),
    Builtin("#atomic_load", POS_CALL, B_ATOMIC_LOAD, 0, FAM_NONE, 2, 2, 0, "#atomic_load(p, order) -> T", "reads the value at a `^T` atomically, under the ordering it is given", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#atomic_store", POS_CALL, B_ATOMIC_STORE, 0, FAM_NONE, 3, 3, 0, "#atomic_store(p, v, order)", "writes a value through a `^T` atomically, and answers `void`", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#atomic_exchange", POS_CALL, B_ATOMIC_EXCHANGE, 0, FAM_NONE, 3, 3, 0, "#atomic_exchange(p, v, order) -> T", "writes a value through a `^T` atomically and answers the value that was there", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#atomic_compare_exchange", POS_CALL, B_ATOMIC_COMPARE_EXCHANGE, 0, FAM_NONE, 6, 6, 0, "#atomic_compare_exchange(p, expected, desired, weak, success, failure) -> (T observed, bool swapped)", "writes `desired` through a `^T` where what is there is `expected`, and answers `(T observed, bool swapped)` either way", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#atomic_fetch_add", POS_CALL, B_ATOMIC_FETCH_ADD, 0, FAM_NONE, 3, 3, 0, "#atomic_fetch_add(p, v, order) -> T", "adds to what is at a `^T` atomically and answers the value that was there **before**", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#atomic_fetch_sub", POS_CALL, B_ATOMIC_FETCH_SUB, 0, FAM_NONE, 3, 3, 0, "#atomic_fetch_sub(p, v, order) -> T", "subtracts from what is at a `^T` atomically and answers the value that was there before", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#atomic_fetch_and", POS_CALL, B_ATOMIC_FETCH_AND, 0, FAM_NONE, 3, 3, 0, "#atomic_fetch_and(p, v, order) -> T", "ands into what is at a `^T` atomically and answers the value that was there before", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#atomic_fetch_or", POS_CALL, B_ATOMIC_FETCH_OR, 0, FAM_NONE, 3, 3, 0, "#atomic_fetch_or(p, v, order) -> T", "ors into what is at a `^T` atomically and answers the value that was there before", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#atomic_fetch_xor", POS_CALL, B_ATOMIC_FETCH_XOR, 0, FAM_NONE, 3, 3, 0, "#atomic_fetch_xor(p, v, order) -> T", "xors into what is at a `^T` atomically and answers the value that was there before", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#fence", POS_CALL, B_FENCE, 0, FAM_NONE, 1, 1, 0, "#fence(order)", "orders the accesses around it without being an access itself, so it takes an ordering and no location", DS_ABSENT, "", NO_ATOMIC),
    Builtin("#soa", POS_TYPE, M_LAYOUT, 0, FAM_LAYOUTS, 0, 0, 0, "#soa [N]T", "lays a `[N]T` out as one run per slot of the element, which is a layout and not a rewrite", DS_ABSENT, "", NO_LAYOUT),
    Builtin("#aos", POS_TYPE, M_LAYOUT, 1, FAM_LAYOUTS, 0, 0, 0, "#aos [N]T", "lays a `[N]T` out as one run of whole elements, which is the arrangement it already has", DS_ABSENT, "", NO_LAYOUT),
    Builtin("#no_bounds", POS_MARKER, M_NO_BOUNDS_CHECK, 0, FAM_NONE, 0, 0, 0, "xs[#no_bounds i]", "marks the operand it stands in front of — a subscript's index, or the value of a store into a bitfield — as one whose check the author is opting out of", DS_ABSENT, "", "opts one operation out of a safety check, and DadoScript is safe to the extent a language can be; write the unchecked loop in Dado"),
    Builtin("#slots", POS_SPLAT, M_SPLAT_SLOTS, 0, FAM_NONE, 1, 1, 0, "..#slots(v) · for name, value in #slots(v):", "names a value's slots: as a splat's operand, the positions `..` splices out of its one argument — a tuple's elements, and a tagged value as one; as what a `for` walks, the slots its declaration names, the body written out once per slot with each slot's name and value; refuses a `#soa`, whose slots are lanes", DS_SPELLED, "..v", "`f(..#slots(v))` is `f(..v)`: the splat is shared; in a `for` header, the walk over a value's slots is the built-in function `slots`, `for name, value in slots(v)`, over an instance of a class, `name` a `string` and `value` an `any`"),
    Builtin("#any", POS_PACK, M_ANY_PACK, 0, FAM_NONE, 0, 0, 0, "..#any xs", "written after a parameter's `..` in place of the element type: the pack takes whatever arguments the call writes, each of its own type, and the function is instantiated once per sequence of argument types", DS_SPELLED, "..any xs", "a pack of whatever the call writes is a variadic of checked `any`, boxed rather than instantiated per argument type"),
    Builtin("#names", POS_CALL, B_NAMES, 0, FAM_NONE, 1, 1, 0, "#names(T) · #names(v)", "answers the names a declared type's view binds to its slots, as `string8` constants, and refuses a shape no declaration was named for", DS_SPELLED, "T.names()", "a question about a type is a built-in method on it, and it folds"),
    Builtin("#spell", POS_CALL, M_TYPE_SPELLING, 0, FAM_NONE, 1, 1, 0, "#spell(T) -> string8", "folds a type — one written out, a `type` binding, or a type value — to its spelling as a `string8` constant, the one `--emit=types` and every diagnostic print", DS_SPELLED, "T.spell()", "a question about a type is a built-in method on it, and it folds"),
    Builtin("#static_assert", POS_CALL, M_STATIC_ASSERT, 0, FAM_NONE, 2, 2, 0, "#static_assert(COND, \"message\")", "written at package level, `#static_assert(COND, \"message\")`: folds `COND` as a `when` condition is folded, and refuses the build with the message, and where each operand's value came from, when it is `false`", DS_ABSENT, "", "a build invariant folded by the compiler is a compiler query; check at run time with `assert`, or state the invariant in Dado"),
    Builtin("#assert_raises", POS_CALL, M_ASSERT_RAISES, 0, FAM_NONE, 0, 255, 0, "#assert_raises · #assert_raises(f, g)", "written alone on the line above a function, or above a method in its type's body, `#assert_raises`, or at package level as a list of functions, `#assert_raises(dot, cross)`: promises that the function or method, or each named function of this package, and every function it reaches (a generic one at each instantiation), raises into a script — no `foreign` call but `<math.h>`'s correctly rounded `sqrt` and `sqrtf`, no `export`, `@symbol` or `@c_body`, no `#align_forward`, atomic, `#fence` or `#no_bounds`, and no value whose type is an address (`rawptr`, `cstring`, a `#c.*` scalar, an opaque C type, a C qualifier) — and refuses the build naming the first node that does not, the chain of calls that reached it, and the repair", DS_ABSENT, "", "a script's functions are script already; the promise that a Dado function raises into one is written in the Dado package that declares it"),
    Builtin("#channel", POS_CALL, M_CHANNEL, 0, FAM_NONE, 1, 1, 0, "#channel(N) name(params) · #channel(latest) name(params)", "declares a channel, `#channel(N) name(params)` at package level or as a member of a `type`: a typed, bounded, lock-free mailbox of `N` messages, or of the newest one only with `#channel(latest)`, many producers and one consumer, whose zero bytes are the empty channel", DS_ABSENT, "", NO_CHANNEL),
    Builtin("#send", POS_CALL, B_SEND, 0, FAM_NONE, 1, 255, 0, "#send(ch, args…)", "hands a message to a channel from any thread without blocking, its arguments checked as a call's; a queue's `#send` fails when the queue is full and is written `try #send(…) else CODE` or with an `else:` suite, a `latest` channel's never fails, and a `ref` argument moves to the consumer", DS_ABSENT, "", NO_CHANNEL),
    Builtin("#peek", POS_CALL, B_PEEK, 0, FAM_NONE, 1, 1, 0, "for args… in #peek(ch):", "walks what a channel holds without consuming it, written at the head of a `for` and binding each message's parameters", DS_ABSENT, "", NO_CHANNEL),
    Builtin("#drain", POS_CALL, B_DRAIN, 0, FAM_NONE, 1, 2, 0, "for args… in #drain(ch[, n]): · #drain(ch)", "walks what a channel holds and consumes it, at most `n` with `#drain(ch, n)`, committing when the loop exits by any edge; alone as a statement it discards what is queued now and frees every `ref` in it", DS_ABSENT, "", NO_CHANNEL),
    Builtin("#shader_load", POS_CALL, B_SHADER_LOAD, 0, FAM_NONE, 1, 1, 0, "#shader_load(Unit) · #shader_load(pkg.Unit)", "loads a compiled DadoGL shader unit — `#shader_load(Lit)` for `Lit.dadogl` in this package, `#shader_load(pkg.Lit)` for one in an imported package — answering a `core:shader` `Shader`; DadoGL is reserved and not built, so it is refused `ERR0001`", DS_ABSENT, "", "loads a DadoGL unit, and DadoGL is reserved and not built; it has no DadoScript answer until DadoGL has one"),
    Builtin("#script_vm", POS_CALL, B_SCRIPT_VM, 0, FAM_NONE, 0, 1, 0, "try VM vm = #script_vm([alloc][, out: s][, err: e][, on_error: p])", "makes a VM — `try VM vm = #script_vm()` — the engine a program's scripts run in, on the allocator written (`#heap` when none is), for the thread that made it; failable, and `#delete(vm)` ends it and every instance in it. `out:` and `err:`, named after the allocator, are the `Sink`s its scripts' `print` and their failures' text go to — standard output and standard error when left out — and `on_error:` is its failure policy, `script.QUIT` (the default: an untried call through a handle that fails ends the program) or `script.CONTINUE` (it answers its zero value and the program goes on). Its runs come only from the thread that made it (`script.THREAD` from another); its stop, pause, resume and queries from any", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_run", POS_CALL, B_SCRIPT_RUN, 0, FAM_NONE, 1, 255, 0, "#script_run(g, args…) -> i64", "runs an instance's `ready` — `i64 status = #script_run(g)`, or `#script_run(g, 60, \"Ann\")` for a `ready` that takes arguments, each checked as a method call's are — as a program's `main` is run: it waits for it, is never failable, and answers `ready`'s `int`, 0 when `ready` returns nothing, and for a failure escaping it the status a failing `main` exits with (its code when the low eight bits are nonzero, 70 when they are 0), its text on the error sink. A class with no `ready` is refused. Every other method is called through the handle, `g.hit(3)`; the retired `#script_run(s, \"hit\", 3)` is refused naming it", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_new", POS_CALL, B_SCRIPT_NEW, 0, FAM_NONE, 2, 255, 0, "try pkg.Class g = #script_new(vm, pkg.Class, args…)", "makes an instance of a class in a VM — `try npc.Goblin g = #script_new(vm, npc.Goblin, 3, 4.0)` — passing its `init` the arguments after the class, each checked to cross as a method call's are, and answers a handle typed by the class, which member calls (`g.hit(3)`) and `#script_run` go through and `#delete` releases; the VM loads the class's module the first time. Failable: a failing `init` is the call's, with the script's code or one of `core:script`'s reserved codes (`script.STALE`, `script.THREAD`, `script.OTHER_VM`, …), and `#script_error()` reads its text", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_stop", POS_CALL, B_SCRIPT_STOP, 0, FAM_NONE, 2, 2, 0, "#script_stop(vm, timeout_ms)", "stops the script running in a VM — `#script_stop(vm, 100)`, from any thread — asking it first, as an `Error` its `defer`s and `try` see, then forcing it once the timeout's milliseconds pass, which runs no more of it; `#script_stop(vm, 0)` forces at once, and the timeout is always written. The VM's engine then ends, its values released and its heap freed, and a later call through any handle on it fails `script.STOPPED`; the call it stopped answers `script.STOPPED` under `try`, and its type's zero value without one", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_pause", POS_CALL, B_SCRIPT_PAUSE, 0, FAM_NONE, 1, 1, 0, "#script_pause(vm)", "pauses the run in progress in a VM at its next loop or call until `#script_resume`, from any thread; a paused VM is busy, and a call or a `#script_new` on it fails `script.BUSY`", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_resume", POS_CALL, B_SCRIPT_RESUME, 0, FAM_NONE, 1, 1, 0, "#script_resume(vm)", "lets a run `#script_pause` held in a VM go on, from any thread", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_is_running", POS_CALL, B_SCRIPT_IS_RUNNING, 0, FAM_NONE, 1, 1, 0, "#script_is_running(vm) -> bool", "answers whether a run is in progress in a VM, asked from any thread, paused or not", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_is_paused", POS_CALL, B_SCRIPT_IS_PAUSED, 0, FAM_NONE, 1, 1, 0, "#script_is_paused(vm) -> bool", "answers whether a VM is paused, asked from any thread", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_pump", POS_CALL, B_SCRIPT_PUMP, 0, FAM_NONE, 1, 1, 0, "#script_pump(vm) -> i64", "delivers every message waiting for a VM's channel handlers — `i64 n = #script_pump(vm)` — the functions its scripts bound to the program's channels with `receive`, each on the VM's thread, in the order sent, and answers how many; a VM it cannot enter answers a negative reserved code (`script.THREAD`, `script.STALE`, `script.STOPPED`), its text on the error sink. The host's frame boundary: a call into a script delivers them as it returns too", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_reload", POS_CALL, B_SCRIPT_RELOAD, 0, FAM_NONE, 2, 3, 0, "try #script_reload(vm, Class[, dir])", "swaps new code in under a class a VM has loaded — `try #script_reload(vm, Goblin)` reads `reload/<package>/Goblin.js` under the working directory, `#script_reload(vm, Goblin, dir)` the same path under `dir`, the module `dadoc --emit=reload` wrote — after checking it against what this build bound: every Dado function it calls bound with the same signature, every method this program runs kept with its signature, every field this program reads or writes through a handle kept with its type, every other field it keeps of the same type; the class is any the build carries, and the VM must have made an instance of it. Every instance keeps its fields' values, a new field starts at its initializer, `init` does not run again, and each instance a handle holds runs its `reloaded()` method when it has one. Failable: on any miss the code running now stays, and `#script_error()` names every miss. Called from inside the script's own run, the new code is checked at once and takes over when that run leaves. Refused in a `--release` build unless it is built with `--reload`", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#script_error", POS_CALL, B_SCRIPT_ERROR, 0, FAM_NONE, 0, 0, 0, "#script_error() -> string8", "answers the text of the failure the `try` around a `#script_vm`, a `#script_new`, a method called through a handle or a `#script_reload` caught — the script's `Error` and its trace, or the runtime's sentence, what the error sink was given — as a `string8` borrowed until the `else` it is written in ends (`#format(#script_error())` keeps a copy); legal only in that `else`", DS_ABSENT, "", NO_HOST_VERB),
    Builtin("#trace", POS_CALL, B_TRACE, 0, FAM_NONE, 0, 0, 0, "#trace() -> ref []Location", "answers where the program is — `ref []Location t = #trace()` — as a run of `Location`s, innermost first: the place `#trace()` is written, then the place of each call the run is inside, each with its file, line, column and function (`main.update`), minted on the ambient allocator, which the caller frees with `#delete(t)`. A build with the full call stack (`dado test`, `--debug`, `--full-trace`) knows each call from it, up to 4,096 calls deep (a deeper call is counted, not kept); any other build answers the one place it is written, the first element either way", DS_ABSENT, "", NO_TRACE),
    Builtin("#location", POS_CALL, B_LOCATION, 0, FAM_NONE, 0, 0, 0, "#location() -> Location", "answers where it is written — `Location here = #location()` — as one `Location`: its file, line, column and function (`main.update`), the place `#trace()` names for itself. A constant of static strings, the same in every build and on every target: nothing is allocated and nothing is freed. A `#trace()` with no call stack (a build without `--full-trace`) answers one element, equal to `#location()` written at the same place. As a parameter's default, `Location at = #location()`, it is the caller's place: each call that leaves the argument out passes its own. In a `const` or package variable's initializer it folds to the place it is written", DS_SPELLED, "Location()", "a place is a `Location`, and `Location()` with no argument is where it is written, the same four fields"),
    Builtin("#release", POS_CALL, B_RELEASE, 0, FAM_NONE, 1, 1, 0, "#release(ch)", "a statement by a channel's consumer thread giving the channel up, so the next thread to walk it becomes its consumer: a hand-off, checked in a debug build and compiled to nothing without assertions", DS_ABSENT, "", NO_CHANNEL),
)

// Type predicates, in `sub` order.
const [13]string8 PREDICATES = ("#is_int", "#is_float", "#is_number", "#is_bool", "#is_char", "#is_string", "#is_slice", "#is_map", "#is_ref", "#is_pointer", "#has_eq", "#is_key", "#is_declared")

// Spellings retired, each with what replaced it and the repair.
const u8 R_ACCEPTED = 0
const u8 R_SILENT = 1
const u8 R_REFUSED = 2

type Retired:
    string8 spelling
    string8 replacement
    string8 repair
    u8 status

const string8 CHANNEL_REPAIR = "the construct was renamed before 1.0.0 and only its words changed: `#signal` is `#channel`, `#emit` is `#send` and a script's `connect` is `receive`, with the same meaning, the same rules and the same layout, so rename it and change nothing else"
const string8 FITS_REPAIR = "the name now says what the `bool` answers — `true` when the result fits, as it always was. Only the name changed, so every existing use keeps its meaning under the new one: rename it and change no branch"
const string8 PRINT_REPAIR = "the printing verbs are a library now: `import \"core:fmt\"` and write the call qualified. They take the same arguments in the same order, rendered one after another with nothing between them, and they write through `core:io`'s standard-output sink. `fmt.write(out, …)` and `fmt.writeln(out, …)` take a `Sink` first where some other destination is wanted. They exist only where `#OS` is not `#NONE`, because a freestanding target has no stream to write to. **A type is the one argument that does not carry over**: the builtin substituted a type's spelling at the call and a function cannot take a type at all (ERR0913), so `println(i32)` is `fmt.println(#spell(i32))` — `#spell` folds a type to the same spelling the builtin printed"
const string8 VERB_REPAIR = "every builtin is spelled with a `#`, and the sigil is what says the compiler owns the name. The bare word is an ordinary name and nothing here declares it — write the `#` spelling for the builtin, or declare a function of this name and the call reaches it"

const [23]Retired RETIRED = (
    Retired("context.allocator", "#default", "write `#default`, which is the same allocator and is immutable within a scope", R_REFUSED),
    Retired("context.temp", "runtime.temp()", "the scratch allocator is a library and no longer a slot of an ambient container: `import \"core:runtime\"`, configure it once with `runtime.init_scratch`, and open a scope with `using runtime.temp():` — inside it `#default` is the arena and `#return` is still the caller's, so a survivor needs no escape analysis. Where the old spelling was a trailing allocator argument, `runtime.temp()` goes in the same position", R_REFUSED),
    Retired("context", "#default", "there is no container left to reify, because `#default` is the allocator itself — write `auto a = #default` — the two words `(proc, data)` — where a whole context used to be taken", R_REFUSED),
    Retired("print", "fmt.print", PRINT_REPAIR, R_REFUSED),
    Retired("println", "fmt.println", PRINT_REPAIR, R_REFUSED),
    Retired("#add_overflow", "#add_fits", FITS_REPAIR, R_REFUSED),
    Retired("#sub_overflow", "#sub_fits", FITS_REPAIR, R_REFUSED),
    Retired("#mul_overflow", "#mul_fits", FITS_REPAIR, R_REFUSED),
    Retired("#signal", "#channel", CHANNEL_REPAIR, R_REFUSED),
    Retired("#emit", "#send", CHANNEL_REPAIR, R_REFUSED),
    Retired("connect", "receive", CHANNEL_REPAIR, R_REFUSED),
    Retired("make", "#make", VERB_REPAIR, R_REFUSED),
    Retired("new", "#new", VERB_REPAIR, R_REFUSED),
    Retired("delete", "#delete", VERB_REPAIR, R_REFUSED),
    Retired("resize", "#resize", VERB_REPAIR, R_REFUSED),
    Retired("copy", "#copy", VERB_REPAIR, R_REFUSED),
    Retired("format", "#format", VERB_REPAIR, R_REFUSED),
    Retired("len", "#len", VERB_REPAIR, R_REFUSED),
    Retired("size", "#size", VERB_REPAIR, R_REFUSED),
    Retired("assert", "#assert", VERB_REPAIR, R_REFUSED),
    Retired("expect", "#expect", VERB_REPAIR, R_REFUSED),
    Retired("breakpoint", "#breakpoint", VERB_REPAIR, R_REFUSED),
    Retired("transpose", "#transpose", VERB_REPAIR, R_REFUSED),
)

// The `#UPPER` enumerations and the queries that answer one member.
const u8 Q_OS = 0
const u8 Q_ARCH = 1
const u8 Q_ENDIAN = 2
const u8 Q_ORDERING = 3

type Member:
    string8 name
    u8 query
    i32 value
    u8 dados
    string8 dados_text
    string8 dados_why

const string8 NO_ARCH = "the CPU architecture is the target's machinery, and a script branches on the operating system or the web; ask `#ARCH` in Dado and give the script a Dado function that answers what it needs"
const string8 NO_ENDIAN = "byte order is a fact about representation, and a script never sees memory; ask it in Dado"
const string8 NO_ORDERING = "a memory ordering is a thread primitive, and a script shares no memory between threads; write the atomic in Dado"
const string8 NO_TOOLCHAIN_OS = "a toolchain, not a host a script runs on: a host there answers `Platform.UNKNOWN_OS`, and a script on the web asks `Platform.WEB`"
const string8 PLATFORM_MEMBER = "a member of `Platform`: `#UPPER` is `Platform.UPPER`, one mechanical rule, and it folds so `when` can use it"

const [26]Member MEMBERS = (
    Member("#LINUX", Q_OS, 10, DS_SPELLED, "Platform.LINUX", PLATFORM_MEMBER),
    Member("#DARWIN", Q_OS, 20, DS_SPELLED, "Platform.DARWIN", PLATFORM_MEMBER),
    Member("#WINDOWS", Q_OS, 30, DS_SPELLED, "Platform.WINDOWS", PLATFORM_MEMBER),
    Member("#FREEBSD", Q_OS, 40, DS_SPELLED, "Platform.FREEBSD", PLATFORM_MEMBER),
    Member("#OPENBSD", Q_OS, 50, DS_SPELLED, "Platform.OPENBSD", PLATFORM_MEMBER),
    Member("#NETBSD", Q_OS, 60, DS_SPELLED, "Platform.NETBSD", PLATFORM_MEMBER),
    Member("#WASI", Q_OS, 70, DS_ABSENT, "", NO_TOOLCHAIN_OS),
    Member("#EMSCRIPTEN", Q_OS, 75, DS_ABSENT, "", NO_TOOLCHAIN_OS),
    Member("#NONE", Q_OS, 80, DS_ABSENT, "", "a target with no operating system has no DadoScript runtime, so no script runs there to ask"),
    Member("#WEB", Q_OS, 85, DS_SPELLED, "Platform.WEB", PLATFORM_MEMBER),
    Member("#UNKNOWN_OS", Q_OS, 90, DS_SPELLED, "Platform.UNKNOWN_OS", PLATFORM_MEMBER),
    Member("#X86_64", Q_ARCH, 10, DS_ABSENT, "", NO_ARCH),
    Member("#X86", Q_ARCH, 20, DS_ABSENT, "", NO_ARCH),
    Member("#AARCH64", Q_ARCH, 30, DS_ABSENT, "", NO_ARCH),
    Member("#ARM", Q_ARCH, 40, DS_ABSENT, "", NO_ARCH),
    Member("#RISCV64", Q_ARCH, 50, DS_ABSENT, "", NO_ARCH),
    Member("#WASM32", Q_ARCH, 60, DS_ABSENT, "", NO_ARCH),
    Member("#UNKNOWN_ARCH", Q_ARCH, 70, DS_ABSENT, "", NO_ARCH),
    Member("#LITTLE", Q_ENDIAN, 10, DS_ABSENT, "", NO_ENDIAN),
    Member("#BIG", Q_ENDIAN, 20, DS_ABSENT, "", NO_ENDIAN),
    Member("#UNKNOWN_ENDIAN", Q_ENDIAN, 30, DS_ABSENT, "", NO_ENDIAN),
    Member("#RELAXED", Q_ORDERING, 10, DS_ABSENT, "", NO_ORDERING),
    Member("#ACQUIRE", Q_ORDERING, 20, DS_ABSENT, "", NO_ORDERING),
    Member("#RELEASE", Q_ORDERING, 30, DS_ABSENT, "", NO_ORDERING),
    Member("#ACQ_REL", Q_ORDERING, 40, DS_ABSENT, "", NO_ORDERING),
    Member("#SEQ_CST", Q_ORDERING, 50, DS_ABSENT, "", NO_ORDERING),
)

// The queries: `#OS`, `#ARCH`, `#ENDIAN`, and two answered by a string.
const [5]string8 QUERIES = ("#OS", "#ARCH", "#ENDIAN", "#TRIPLE", "#DADO_VERSION")

// The allocator ladder, outermost last.
const [5]string8 LADDER = ("#stack", "#default", "#return", "#caller", "#heap")

// The row spelled `name`, or -1.
i64 builtin(string8 name):
    for i in 0..<#len(BUILTINS):
        if BUILTINS[i].name == name: return i
    return -1

// The retirement row of `spelling`, or -1.
i64 retired(string8 spelling):
    for i in 0..<#len(RETIRED):
        if RETIRED[i].spelling == spelling: return i
    return -1
