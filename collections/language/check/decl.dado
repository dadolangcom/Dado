// Declarations past functions and types: enums, constants and package
// variables. A constant's initializer is checked as any expression is, into
// a scratch body, and the IR it wrote is run here (`fold`): one evaluator.
package check

import "language:diag"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"

// An enum: its backing (a tag over it when `distinct`), members counted on
// from the last written value.
void enum_body(^World w, u32 d, u32 ty):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u32 n = w.decls[d].node
    []u32 ks = a.list(a.b[n])
    u32 back = u32(types.P_I32) if ks[0] == NONE else resolve_type(w, f, ks[0])
    if back == NONE: return
    if (a.a[n] & syntax.F_DISTINCT) != 0: w.t.define(ty, w.t.distinct_of(index.hold(#format(name_of(w, w.p.pkgs[w.decls[d].pkg].name), ".", name_of(w, w.decls[d].name))), back), nil)
    else: w.t.define(ty, back, nil)
    u64 next = 0
    i64 high = 0
    string8 en = name_of(w, w.decls[d].name)
    bool counted = false
    u32 prev = NONE
    u32 prevc = NONE
    ref []u32 seen
    ref []u32 wn
    ref []u32 wc
    for m in ks[1..<#len(ks)]:
        if m == NONE || a.tag[m] != syntax.N_ENUM_MEMBER: continue
        string8 mn = w.p.spell(f, m)
        bool dup = false
        for x in seen:
            if w.p.sym(f, x) == w.p.sym(f, m): dup = true
        if dup:
            say_tok(w, f, 0, m, 409, index.hold(#format("`", mn, "` already names a member of `", en, "`; the second is unreachable")), "")
            continue
        seen = #append(seen, m)
        if #len(mn) >= 5 && mn[0..<5] == "dado_":
            say_tok(w, f, 0, m, 411, index.hold(#format("`dado_` starts every name the compiler emits, so it cannot start `", mn, "`")), "")
            continue
        u32 c = NONE
        if a.a[m] != NONE: c = const_value(w, d, a.a[m], back, false, "the backing type is")
        else if is_int(w, back) && (prev == NONE || prevc != NONE):
            c = w.k.int(&w.t, next, high)
            for j in 0..<#len(wn):
                u32 xc = wc[j]
                if xc != NONE && w.k.kind[xc] == types.C_INT && w.k.w0[xc] == next && i64(w.k.w1[xc]) == high: say_tok(w, f, 0, m, 508, index.hold(#format("`", mn, "` counts to ", i64(next), ", which `", w.p.spell(f, wn[j]), "` is already written as; two names for one value are allowed when both say so, and this one did not")), "")
        else if !counted && prev != NONE && !is_int(w, back) && a.a[prev] != NONE:
            counted = true
            say_tok(w, f, 0, m, 509, index.hold(#format("`", mn, "` has no value and the member before it is not an integer, so there is nothing to count from; auto-increment is defined for integers and nothing else")), "")
        else if !counted && !is_int(w, back):
            counted = true
            say(w, f, 0, a.lo[ks[0]], a.hi[ks[0]], 509, index.hold(#format("a member of `", en, "` has no value written, and values are counted only for an integer backing type; ", shown(w, back), " is not an integer, so give every member an explicit value")), "")
        if a.a[m] != NONE:
            wn = #append(wn, m)
            wc = #append(wc, c)
        prevc = c
        prev = m
        w.members[(u64(d) << 32) | u64(w.p.sym(f, m))] = c
        w.order = #append(w.order, (u64(d) << 32) | u64(w.p.sym(f, m)))
        if c != NONE && w.k.kind[c] == types.C_INT:
            next = w.k.w0[c] + 1
            high = i64(w.k.w1[c]) + (1 if next == 0 else 0)

// A `foreign` enum: its backing; each member is the enumerator C names.
void fenum_body(^World w, u32 d, u32 ty):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    []u32 ks = a.list(a.b[w.decls[d].node])
    u32 back = w.t.make(types.T_CSCALAR, 5, 0, nil) if ks[1] == NONE else resolve_type(w, f, ks[1])
    if back == NONE: return
    if !is_int(w, back) || c_bool(w, w.t.resolve(back)):
        say(w, f, 0, a.lo[ks[1]], a.hi[ks[1]], 1021, index.hold(#format("`", w.p.files[f].src[i64(a.lo[ks[1]])..<i64(a.hi[ks[1]])], "` is written as the backing of `foreign enum ", name_of(w, w.decls[d].name), "`, and a backing is an integer type")), "write an integer type, or nothing for `#c.int`", "A backing is the integer type a C signature passes the enum as — `i32` for raylib's `int key`, `#c.uint` for an `unsigned int`")
        return
    w.t.define(ty, back, nil)
    for m in ks[2..<#len(ks)]:
        if m == NONE || a.tag[m] != syntax.N_F_ENUM_MEMBER: continue
        string8 cn = w.p.spell(f, m)
        if a.a[m] != NONE && a.main[a.a[m]] != NONE:
            ref []char8 v
            u32 t = a.main[a.a[m]]
            syntax.string_value(w.p.files[f].src[i64(w.p.files[f].t.start[t])..<i64(w.p.files[f].t.end[t])], &v)
            cn = index.hold(v)
        u64 key = (u64(d) << 32) | u64(w.p.sym(f, m))
        w.members[key] = w.k.make(&w.t, types.C_FOREIGN, tstr(w, cn), 0, 0, 0, nil)
        w.order = #append(w.order, key)

// A constant's or variable's type; its value lands in `decls[d].value`.
// An untyped constant is a literal: `untyped` (or `ufloat`) is its type.
u32 global_type(^World w, u32 d):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u32 n = w.decls[d].node
    string8 gn = name_of(w, w.decls[d].name)
    if w.decls[d].kind == K_VAR && ks0_contract(w, d): return NONE
    if #len(gn) >= 5 && gn[0..<5] == "dado_":
        say_tok(w, f, 0, n, 411, index.hold(#format("`dado_` starts every name the compiler emits, so it cannot start `", gn, "`")), "")
        return NONE
    []u32 ks = a.list(a.b[n])
    bool var_ = w.decls[d].kind == K_VAR
    u32 ty = resolve_type(w, f, ks[0]) if ks[0] != NONE && a.tag[ks[0]] != syntax.T_CHANNEL else NONE
    if ks[0] != NONE && a.tag[ks[0]] == syntax.T_CHANNEL: ty = chan_type(w, d, f, ks[0], index.hold(#format(name_of(w, w.p.pkgs[w.decls[d].pkg].name), ".", name_of(w, w.decls[d].name))))
    if ks[0] != NONE && ty == NONE: return NONE
    if var_ && #len(ks) > 2 && ks[2] != NONE:
        u64 al = align_n(w, f, ks[2])
        if al > 0: w.galign[d] = al
    if ks[1] == NONE:
        if ty != NONE: w.decls[d].value = zero(w, ty) & ~ir.OPD_CONST
        return ty
    // Bound first: folding may declare a package and move `w.decls` (the Rust
    // dadoc's C takes the place's address before the call).
    u32 cv = const_value(w, d, ks[1], ty, var_)
    if !var_: cv = overridden(w, d, ty, cv)
    w.decls[d].value = cv
    if ty != NONE || w.decls[d].value == NONE: return ty
    u8 k = w.k.kind[w.decls[d].value]
    if k == types.C_STR: return types.STRING8
    if k == types.C_BOOL: return u32(types.P_BOOL)
    return w.ufloat if k == types.C_FLOAT else w.untyped

// The value of `vn` as a `want` (NONE: a literal), folded; NONE when
// reported.
u32 const_value(^World w, u32 d, u32 vn, u32 want, bool var_, string8 site = "", bool ds = false):
    Body b
    b.ds = ds
    b.decl = d
    b.file = w.decls[d].file
    syntax.Ast a = w.p.files[b.file].a
    b.base = a.lo[w.decls[d].node]
    b.ret = NONE
    b.pack = NONE
    b.pack_name = NONE
    b.grown = NONE
    b.f.item = w.decls[d].node
    b.f.file = b.file
    u8 phase = w.d.phase
    i64 errs = #len(w.d.list)
    Val v = bad()
    // Literal arithmetic folds as Rust's constants do, in i128, then meets the type.
    u64 flo = 0
    i64 fhi = 0
    string8 fop = ""
    i8 fl = lit_fold(w, &b, vn, &flo, &fhi, &fop)
    if fl == 2:
        err(w, &b, vn, 539, index.hold(#format("`", fop, "` overflows `i128` while folding, which is as wide as a constant expression is evaluated — and wider than any type could hold the answer")), "fold it in steps a 64-bit type holds, or compute it at run time")
        w.d.phase = phase
        return NONE
    if fl == 1 && want != NONE && is_int(w, want) && !is_float(w, want): v = coerce(w, &b, Val(V_LIT, NONE, w.untyped, NONE, flo, fhi), want, vn)
    else: v = expr(w, &b, vn, want)
    u32 out = NONE
    if b.named && (v.ty != NONE || #len(w.d.list) == errs):
        string8 head = "a package variable's initialiser is folded before the program runs, and the compiler cannot evaluate " if var_ else "a constant is folded before the program runs, and the compiler cannot evaluate "
        err(w, &b, b.named_at, 901, index.hold(#format(head, "a construction naming its slots\x1fA slot's name is read off its declaration, and declarations are read after every constant is folded, so a constant cannot place its values by name\x1epass the slots in order")))
        v.ty = NONE
    if v.ty != NONE && want == NONE:
        if v.kind == V_LIT: out = w.k.int(&w.t, v.lo, v.hi)
        else if v.kind == V_FLIT: out = w.k.make(&w.t, types.C_FLOAT, 64, 0, v.lo, 0, nil)
        else if v.kind == V_VAL && (typed_name(w, &b, vn) != NONE || w.t.tag[w.t.resolve(v.ty)] == types.T_TUPLE): untyped_refused(w, &b, d, vn, v)
        else if v.kind == V_VAL: want = v.ty
    if v.ty != NONE && want != NONE:
        v = coerce(w, &b, v, want, vn, site if #len(site) > 0 else ("the declared type is" if var_ else "the declared shape is"))
        if v.ty != NONE:
            ref []u32 env
            for _ in b.f.slot_ty:
                env = #append(env, NONE)
            w.fold_win = var_
            u32 at = run(w, &b.f, &env, 0, ir.count(&b.f))
            w.fold_win = false
            if at == NONE: out = get(w, &b.f, &env, v.opd)
            ref []u32 said
            if out != NONE: tagless(w, &b, want, out, vn, &said)
            #delete(said)
            if out != NONE && w.k.kind[out] == types.C_FLOAT:
                // A fold reaching an infinity has no C99 spelling (Rust's `check_constant`).
                f64 fx = fval(w.k.w0[out])
                if fx > 1.7976931348623157e308 || fx < -1.7976931348623157e308 || fx != fx:
                    string8 fs = shown(w, want)
                    string8 fv = "NaN"
                    if fx > 0.0: fv = "inf"
                    if fx < 0.0: fv = "-inf"
                    string8 fh = index.hold(#format("write a number `", fs, "` holds, at most about 1.8e308"))
                    if float_bits(w, want) == 32: fh = index.hold(#format("write a number `", fs, "` holds — at most about 3.4e38 — or give it the type `f64`"))
                    err(w, &b, vn, 539, index.hold(#format("this folds to ", fv, ", which no `", fs, "` holds and C99 has no literal for")), fh)
                    out = NONE
            if out == NONE && #len(w.d.list) == errs: unfoldable(w, &b, at, var_)
    w.d.phase = phase
    b.f.free()
    return out

private void untyped_refused(^World w, ^Body b, u32 d, u32 vn, Val v):
    string8 nm = name_of(w, w.decls[d].name)
    u32 r = w.t.resolve(v.ty)
    if r != NONE && w.t.tag[r] == types.T_TUPLE:
        []u32 xs = w.t.list(r)
        string8 el = "f32" if xs[0] == u32(types.P_F64) else shown(w, xs[0])
        err(w, b, vn, 901, index.hold(#format("`", nm, "` has no type written, so it is a **literal** and adapts to wherever it is used — and a tuple or array is not a literal in that sense: it has a shape, and a shape is a type. Write it: `const [", #len(xs), "]", el, " ", nm, " = ...`")))
        return
    u32 tn = typed_name(w, b, vn)
    string8 typed = spell(w, b, tn)
    err(w, b, tn, 901, index.hold(#format("`", nm, "` has no type written, so it is a literal — and `", typed, "` has a type, so this expression is not one. A constant never takes its type from something it names: write `", nm, "`'s type, or make `", typed, "` untyped too")))

// The first name under `n` that is a typed constant.
private u32 typed_name(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    if a.tag[n] == syntax.E_NAME:
        u32 d = lookup(w, w.p.files[b.file].pkg, w.p.sym(b.file, n))
        if d != NONE && w.decls[d].kind == K_CONST && w.decls[d].ty != w.untyped && w.decls[d].ty != w.ufloat: return n
    ref []u32 ks
    a.kids(n, &ks)
    for k in ks:
        u32 s = typed_name(w, b, k)
        if s != NONE: return s
    return NONE

// ERR0915: a folded union value whose member shares its sort with another.
void tagless(^World w, ^Body b, u32 ty, u32 c, u32 vn, ^ref []u32 said):
    u32 r = w.t.resolve(ty)
    if r == NONE: return
    if w.k.kind[c] == types.C_TUPLE:
        []u32 sl = w.t.slots(r)
        []u32 xs = w.k.list(c)
        for i in 0..<#len(xs):
            if i < #len(sl): tagless(w, b, sl[i], xs[i], vn, said)
        return
    if w.k.kind[c] != types.C_UNION || w.t.tag[r] != types.T_UNION: return
    for x in said^:
        if x == r: return
    []u32 ms = w.t.list(r)
    u32 k = sort_of(w, ms[w.k.a[c]])
    ref []char8 o
    i64 n = 0
    for m in ms:
        if sort_of(w, m) != k: continue
        if n > 0: o = #append(o, ..string8(" and "))
        string8 sm = index.hold(#format("`", shown(w, m), "`"))
        o = #append(o, ..sm)
        n += 1
    if n < 2: return
    said^ = #append(said^, r)
    err(w, b, vn, 915, index.hold(#format("this compile-time value of ", shown(w, ty), " does not say which member it is: ", n, " of them hold a constant of its sort, ", o)), "give the name **no initializer**, which is the first member holding its own zero, and assign it inside a function: there the conversion is a call, and a call keeps its tag", "A union is built by ordinary conversion and a conversion folds to the value it converts, so the tag is gone by the time an initializer is written and every one of those members would emit this same constant. Where the members differ in sort — an integer beside a `bool`, a `string` beside a number — the type still answers what the value cannot, and that is the ordinary case and not this one")

private u32 sort_of(^World w, u32 t):
    u32 r = under(&w.t, t)
    if types.is_text(r) || r == types.CSTRING: return 4
    if r == u32(types.P_BOOL): return 3
    if is_float(w, r): return 2
    if is_int(w, r): return 1
    if r != NONE && w.t.tag[r] == types.T_TUPLE:
        []u32 sl = w.t.slots(r)
        return 0x10000 | u32(#len(sl))
    return 0x20000 | r

const string8 SLICE_UNFOLDED = "a slice, which windows storage that exists when the program runs"

// ERR0901 at the op the evaluator could not run.
private void unfoldable(^World w, ^Body b, u32 at, bool var_):
    string8 head = "a package variable's initialiser is folded before the program runs, and the compiler cannot evaluate " if var_ else "a constant is folded before the program runs, and the compiler cannot evaluate "
    u32 node = b.f.node[at] if at != NONE else b.f.item
    string8 what = "this"
    if at != NONE && (b.f.op[at] == ir.O_CALL || b.f.op[at] == ir.O_CALL_INDIRECT): what = "a call"
    else if at != NONE && b.f.op[at] == ir.O_INTRINSIC && b.f.sub[at] == B_LEN: what = "a `len` of a slice, whose count is in the value rather than in its type — a fixed array's `len` folds and a window's cannot, at any width"
    else if at != NONE && b.f.op[at] == ir.O_VIEW: what = SLICE_UNFOLDED
    string8 help = ""
    if at != NONE && b.f.op[at] == ir.O_INTRINSIC && b.f.sub[at] == B_ALIGN_OF:
        what = "an `alignof`"
        help = "bind it where it is used instead, `u64 n = #alignof(T)` inside a function, whose initializer *is* that C constant expression"
    if at != NONE && b.f.op[at] == ir.O_INTRINSIC && b.f.sub[at] == B_SIZE:
        what = "a `size`"
        help = "bind it where it is used instead, `u64 n = #size(T)` inside a function, whose initializer *is* that C constant expression"
    for x in [b.f.b[at] if at != NONE else NONE, b.f.a[at] if at != NONE else NONE]:
        if x != NONE && ir.is_const(x) && w.k.kind[x & ~ir.OPD_CONST] == types.C_FOREIGN: what = index.hold(#format("`", w.t.text(w.k.a[x & ~ir.OPD_CONST]), "`, a foreign constant whose value C supplies — usable as a value, not as one this compiler can evaluate"))
    if at != NONE && ((u64(b.file) << 32) | u64(node)) in w.mprod:
        err(w, b, node, 901, "a matrix product is not a constant expression: which product `*` means comes from the operand types, and a constant is folded before any type is resolved. Write the result out, or compute it in a function")
        return
    if at != NONE && b.f.op[at] == ir.O_VIEW && var_:
        u32 g = glob_decl(w, &b.f, b.f.a[at])
        what = "a window of anything but a package-level array"
        if g != NONE && w.decls[g].kind != K_VAR: g = NONE
        if g != NONE && thread_local(w, g): what = "a window into a `@thread_local` variable, one per thread"
        else if g != NONE && b.f.plo[b.f.a[at]] == b.f.phi[b.f.a[at]] && win_len(w, w.decls[g].ty) < 0: what = "a window into a package variable that is no array"
    err(w, b, node, 901, index.hold(#format(head, what)), help)

// The constant an operand holds, or NONE.
private u32 get(^World w, ^ir.Fn f, ^ref []u32 env, u32 x):
    if x == NONE: return NONE
    if ir.is_const(x): return x & ~ir.OPD_CONST
    if (f.root[x] & ir.ROOT_GLOBAL) != 0: return NONE
    u32 v = env^[f.root[x]]
    for j in f.plo[x]..<f.phi[x]:
        if v == NONE || w.k.kind[v] != types.C_TUPLE: return NONE
        u32 at = f.step_val[j]
        if f.step[j] == ir.ST_INDEX:
            u32 i = get(w, f, env, at)
            if i == NONE: return NONE
            at = u32(w.k.w0[i])
        else if f.step[j] != ir.ST_FIELD: return NONE
        []u32 xs = w.k.list(v)
        if i64(at) >= #len(xs): return NONE
        v = xs[at]
    return v

// The constant operand `x` holds when the ops from `lo` on fold, or NONE.
u32 folded(^World w, ^Body b, u32 lo, u32 x):
    if x == NONE: return NONE
    if ir.is_const(x): return x & ~ir.OPD_CONST
    ref []u32 env
    for _ in b.f.slot_ty:
        env = #append(env, NONE)
    u32 r = NONE
    if run(w, &b.f, &env, lo, ir.count(&b.f)) == NONE: r = get(w, &b.f, &env, x)
    #delete(env)
    return r

// Runs ops `lo..<hi`; the first it cannot, or NONE.
private u32 run(^World w, ^ir.Fn f, ^ref []u32 env, u32 lo, u32 hi):
    u32 i = lo
    for i < hi:
        u8 o = f.op[i]
        u32 v = NONE
        if o == ir.O_CHECK || o == ir.O_SCOPE_END:
            i += 1
            continue
        if o == ir.O_IF:
            u32 c = get(w, f, env, f.a[i])
            if c == NONE: return i
            u32 then = i + 1
            u32 other = then + f.b[i]
            u32 r = run(w, f, env, then, other) if w.k.a[c] != 0 else run(w, f, env, other, other + f.c[i])
            if r != NONE: return r
            i += 1 + ir.span(f, i)
            continue
        if o == ir.O_SET: v = get(w, f, env, f.a[i])
        else if o == ir.O_MAKE:
            ref []u32 xs
            for x in ir.args(f, i):
                u32 e = get(w, f, env, x)
                if e == NONE: return i
                xs = #append(xs, e)
            v = w.k.tuple(&w.t, xs)
        else if o == ir.O_BIN || o == ir.O_UN || o == ir.O_CONV: v = arith(w, f, env, i)
        else if o == ir.O_VIEW && w.fold_win: v = fold_window(w, f, env, i)
        if v == NONE || f.dst[i] == NONE || f.plo[f.dst[i]] != f.phi[f.dst[i]] || (f.root[f.dst[i]] & ir.ROOT_GLOBAL) != 0: return i
        env^[f.root[f.dst[i]]] = v
        i += 1
    return NONE

// The package variable place `p` roots in, or NONE.
private u32 glob_decl(^World w, ^ir.Fn f, u32 p):
    if p == NONE || ir.is_const(p) || (f.root[p] & ir.ROOT_GLOBAL) == 0: return NONE
    u32 gi = f.root[p] & ~ir.ROOT_GLOBAL
    for d in w.globals:
        if tstr(w, pkg_key(w, w.decls[d].pkg)) == f.glob_pkg[gi] && tstr(w, name_of(w, w.decls[d].name)) == f.glob_name[gi]: return d
    return NONE

// A fixed array's count, else -1.
private i64 win_len(^World w, u32 ty):
    u32 r = under(&w.t, ty)
    u32 e = NONE
    i64 n = 0
    if r == NONE || w.t.tag[r] != types.T_TUPLE || !w.t.uniform(r, &e, &n): return -1
    return n

// A window of a whole package array, as an address C writes: C_WINDOW.
private u32 fold_window(^World w, ^ir.Fn f, ^ref []u32 env, u32 i):
    u32 p = f.a[i]
    u32 g = glob_decl(w, f, p)
    if g == NONE || w.decls[g].kind != K_VAR || f.plo[p] != f.phi[p] || f.ahi[i] > f.alo[i] || thread_local(w, g): return NONE
    i64 n = win_len(w, w.decls[g].ty)
    if n < 0: return NONE
    i64 lo = 0
    i64 hi = n
    if f.b[i] != NONE:
        u32 x = get(w, f, env, f.b[i])
        if x == NONE: return NONE
        lo = i64(w.k.w0[x])
    if f.c[i] != NONE:
        u32 x = get(w, f, env, f.c[i])
        if x == NONE: return NONE
        hi = i64(w.k.w0[x])
    if lo < 0 || hi > n || lo > hi: return NONE
    u32 gi = f.root[p] & ~ir.ROOT_GLOBAL
    string8 cn = index.hold(#format("dado_g_", w.t.text(f.glob_pkg[gi]), "_", w.t.text(f.glob_name[gi])))
    return w.k.make(&w.t, types.C_WINDOW, tstr(w, cn), w.decls[g].ty, u64(lo), u64(hi - lo), nil)

// `x` wrapped to integer type `ty`.
private u32 wrap(^World w, u32 ty, u64 x):
    u8 p = int_prim(w, ty)
    u8 bits = types.integer_bits(p)
    if bits == 0: return w.k.boolean(&w.t, x != 0)
    u64 top = 0xFFFFFFFFFFFFFFFF if bits == 64 else (u64(1) << u64(bits)) - 1
    u64 v = x & top
    bool neg = types.is_signed(p) && (v >> u64(bits - 1)) != 0
    if neg: v = v | ~top
    return w.k.int(&w.t, v, -1 if neg else 0)

private f64 as_f(^World w, u32 c):
    if w.k.kind[c] == types.C_FLOAT: return fval(w.k.w0[c])
    if i64(w.k.w1[c]) < 0: return f64(i64(w.k.w0[c]))
    return f64(w.k.w0[c])

private u32 arith(^World w, ^ir.Fn f, ^ref []u32 env, u32 i):
    u8 o = f.op[i]
    u8 s = f.sub[i]
    u32 ty = f.ty_of[i]
    u32 x = get(w, f, env, f.a[i])
    if x == NONE: return NONE
    if o == ir.O_CONV:
        if s == ir.CV_UNION: return w.k.union_(&w.t, f.b[i], x)
        if s == ir.CV_CROSS: return x
        if s == ir.CV_WIDEN || s == ir.CV_WRAP: return wrap(w, ty, w.k.w0[x])
        if s == ir.CV_INT_FLOAT || s == ir.CV_FLOAT_WIDTH: return fconst(w, as_f(w, x), ty)
        if s == ir.CV_FLOAT_INT:
            f64 v = as_f(w, x)
            return wrap(w, ty, u64(i64(v)) if v < 0.0 else u64(v))
        return NONE
    bool fl = w.k.kind[x] == types.C_FLOAT
    if o == ir.O_UN:
        if s == ir.U_NOT: return w.k.boolean(&w.t, w.k.a[x] == 0)
        if fl: return fconst(w, 0.0 - as_f(w, x), ty)
        return wrap(w, ty, 0 - w.k.w0[x] if s == ir.U_NEG else ~w.k.w0[x])
    u32 y = get(w, f, env, f.b[i])
    if y == NONE: return NONE
    if w.k.kind[x] == types.C_BOOL:
        bool p = w.k.a[x] != 0
        bool q = w.k.a[y] != 0
        if s == ir.B_AND: return w.k.boolean(&w.t, p && q)
        if s == ir.B_OR: return w.k.boolean(&w.t, p || q)
        if s == ir.B_EQ || s == ir.B_NE: return w.k.boolean(&w.t, (p == q) == (s == ir.B_EQ))
        return NONE
    if fl:
        f64 p = as_f(w, x)
        f64 q = as_f(w, y)
        if s >= ir.B_EQ: return w.k.boolean(&w.t, p == q if s == ir.B_EQ else (p != q if s == ir.B_NE else (p < q if s == ir.B_LT else (p <= q if s == ir.B_LE else (p > q if s == ir.B_GT else p >= q)))))
        if s > ir.B_DIV: return NONE
        return fconst(w, p + q if s == ir.B_ADD else (p - q if s == ir.B_SUB else (p * q if s == ir.B_MUL else p / q)), ty)
    if w.k.kind[x] != types.C_INT: return NONE
    u64 p = w.k.w0[x]
    u64 q = w.k.w0[y]
    bool signed = types.is_signed(int_prim(w, ty))
    if s >= ir.B_EQ:
        bool lt = i64(p) < i64(q) if signed else p < q
        return w.k.boolean(&w.t, p == q if s == ir.B_EQ else (p != q if s == ir.B_NE else (lt if s == ir.B_LT else (lt || p == q if s == ir.B_LE else (!lt && p != q if s == ir.B_GT else !lt)))))
    if (s == ir.B_DIV || s == ir.B_REM) && q == 0: return NONE
    if s == ir.B_ADD: return wrap(w, ty, p + q)
    if s == ir.B_SUB: return wrap(w, ty, p - q)
    if s == ir.B_MUL: return wrap(w, ty, p * q)
    if s == ir.B_DIV: return wrap(w, ty, u64(i64(p) / i64(q)) if signed else p / q)
    if s == ir.B_REM: return wrap(w, ty, u64(i64(p) % i64(q)) if signed else p % q)
    if s == ir.B_AND: return wrap(w, ty, p & q)
    if s == ir.B_OR: return wrap(w, ty, p | q)
    if s == ir.B_XOR: return wrap(w, ty, p ~ q)
    if q >= 64: return wrap(w, ty, 0)
    if s == ir.B_SHL: return wrap(w, ty, p << q)
    return wrap(w, ty, u64(i64(p) >> i64(q)) if signed else p >> q)

// A declaration's value as an expression.
Val const_val(^World w, ^Body b, u32 d, u32 n):
    u32 ty = resolve(w, d)
    u32 c = w.decls[d].value
    if ty == NONE || c == NONE: return bad()
    return konst_val(w, b, c, ty, n)

// A constant as an operand; a tuple is set into a temporary first.
Val konst_val(^World w, ^Body b, u32 c, u32 ty, u32 n):
    if ty == w.untyped: return Val(V_LIT, NONE, w.untyped, NONE, w.k.w0[c], i64(w.k.w1[c]))
    if ty == w.ufloat: return Val(V_FLIT, NONE, w.untyped, NONE, w.k.w0[c], 0)
    if w.k.kind[c] != types.C_TUPLE && w.k.kind[c] != types.C_UNION: return value(ir.konst(c), ty)
    u32 t = temp(w, b, ty, n)
    _ = ir.op(&b.f, ir.O_SET, 0, ty, n, t, ir.konst(c))
    return value(t, ty)

// A package variable as a place: its global in this body's table.
Val global(^World w, ^Body b, u32 d):
    u32 ty = resolve(w, d)
    if ty == NONE: return bad()
    u32 pk = tstr(w, pkg_key(w, w.decls[d].pkg))
    u32 nm = tstr(w, name_of(w, w.decls[d].name))
    bool seen = false
    for g in w.globals:
        if g == d: seen = true
    if !seen: w.globals = #append(w.globals, d)
    for i in 0..<#len(b.f.glob_pkg):
        if b.f.glob_pkg[i] == pk && b.f.glob_name[i] == nm: return value(ir.at(&b.f, ir.ROOT_GLOBAL | u32(i)), ty)
    b.f.glob_pkg = #append(b.f.glob_pkg, pk)
    b.f.glob_name = #append(b.f.glob_name, nm)
    b.f.glob_ty = #append(b.f.glob_ty, ty)
    return value(ir.at(&b.f, ir.ROOT_GLOBAL | u32(#len(b.f.glob_pkg) - 1)), ty)

// A `foreign` object as a place: a global the header defines, by its C name.
Val foreign_var(^World w, ^Body b, u32 d):
    u32 ty = resolve(w, d)
    if ty == NONE: return bad()
    u32 pk = tstr(w, "#c")
    u32 nm = c_name(w, d)
    for i in 0..<#len(b.f.glob_pkg):
        if b.f.glob_pkg[i] == pk && b.f.glob_name[i] == nm: return value(ir.at(&b.f, ir.ROOT_GLOBAL | u32(i)), ty)
    b.f.glob_pkg = #append(b.f.glob_pkg, pk)
    b.f.glob_name = #append(b.f.glob_name, nm)
    b.f.glob_ty = #append(b.f.glob_ty, ty)
    return value(ir.at(&b.f, ir.ROOT_GLOBAL | u32(#len(b.f.glob_pkg) - 1)), ty)

// Literal-only arithmetic (`+ - *`, unary `-`, at least one operator)
// folded in i128 into `lo`/`hi`: 1 folded, 2 overflowed (`op` says where),
// 0 not such an expression.
private i8 lit_fold(^World w, ^Body b, u32 n, ^u64 lo, ^i64 hi, ^string8 op):
    syntax.Ast a = tree(w, b)
    if a.tag[n] != syntax.E_BINARY: return 0
    return lit_fold_(w, b, n, lo, hi, op)

private i8 lit_fold_(^World w, ^Body b, u32 n, ^u64 lo, ^i64 hi, ^string8 op):
    syntax.Ast a = tree(w, b)
    u8 g = a.tag[n]
    if g == syntax.E_INT:
        lo^ = u64(a.a[n]) | (u64(a.b[n]) << 32)
        hi^ = 0
        return 1
    if g == syntax.E_UNARY && spell(w, b, n) == "-":
        i8 r = lit_fold_(w, b, a.a[n], lo, hi, op)
        if r != 1: return r
        neg128(lo, hi)
        return 1
    if g != syntax.E_BINARY: return 0
    string8 s = spell(w, b, n)
    if s != "+" && s != "-" && s != "*": return 0
    u64 al = 0
    i64 ah = 0
    u64 bl = 0
    i64 bh = 0
    i8 x = lit_fold_(w, b, a.a[n], &al, &ah, op)
    if x != 1: return x
    i8 y = lit_fold_(w, b, a.b[n], &bl, &bh, op)
    if y != 1: return y
    if s == "-": neg128(&bl, &bh)
    if s == "+" || s == "-":
        u64 l = al + bl
        i64 h = ah + bh + (1 if l < al else 0)
        // Overflow: operands of one sign, an answer of the other.
        if (ah < 0) == (bh < 0) && (h < 0) != (ah < 0):
            op^ = s
            return 2
        lo^ = l
        hi^ = h
        return 1
    // `*`: by magnitude, each within 64 bits, product within 127.
    bool na = ah < 0
    bool nb = bh < 0
    if na: neg128(&al, &ah)
    if nb: neg128(&bl, &bh)
    if ah != 0 || bh != 0:
        op^ = s
        return 2
    u64 a0 = al & 0xFFFFFFFF
    u64 a1 = al >> 32
    u64 b0 = bl & 0xFFFFFFFF
    u64 b1 = bl >> 32
    u64 p00 = a0 * b0
    u64 p01 = a0 * b1
    u64 p10 = a1 * b0
    u64 p11 = a1 * b1
    u64 mid = (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF)
    u64 h = p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)
    u64 l = (mid << 32) | (p00 & 0xFFFFFFFF)
    if (h >> 63) != 0:
        op^ = s
        return 2
    lo^ = l
    hi^ = i64(h)
    if na != nb: neg128(lo, hi)
    return 1

private void neg128(^u64 lo, ^i64 hi):
    u64 l = ~lo^ + 1
    i64 h = ~hi^ + (1 if l == 0 else 0)
    lo^ = l
    hi^ = h

// ERR0921 for a package variable of a contract.
private bool ks0_contract(^World w, u32 d):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    []u32 ks = a.list(a.b[w.decls[d].node])
    if ks[0] == NONE || a.tag[ks[0]] == syntax.T_CHANNEL: return false
    u32 ty = resolve_type(w, f, ks[0])
    return ty != NONE && contract_refused(w, f, 0, a.lo[ks[0]], a.hi[ks[0]], ty, "a package-level variable")
