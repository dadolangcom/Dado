// Traits: a trait's method set (parents first; ERR0535), conformance of a
// `type … using T` (ERR0536), defaults as methods of each implementer that
// re-walk the trait's node, and a trait as a parameter's whole type, a
// binder (`instance.dado`) taking any implementer (ERR0919).
package check

import "language:diag"
import "language:index"
import "language:syntax"
import "core:strings"

// One method a trait prescribes: the trait declaring it and its node.
type Need:
    u32 name
    u32 trait
    u32 node
    bool body

// What trait `t` prescribes, its parents' first. ERR0535 for an `extends`
// that names a type, a cycle, a default replacing a parent's.
ref []Need needs(^World w, u32 t):
    ref []Need out
    gather(w, t, &out, 0)
    return out

private void gather(^World w, u32 t, ^ref []Need out, i64 depth):
    if depth > 32: return
    u32 f = w.decls[t].file
    syntax.Ast a = w.p.files[f].a
    for x in a.list(a.b[w.decls[t].node]):
        if x == NONE || a.tag[x] == syntax.N_BINDER: continue
        if a.tag[x] != syntax.N_FN:
            u32 p = parent(w, t, f, x)
            if p != NONE: gather(w, p, out, depth + 1)
            continue
        bool body = (a.a[x] & syntax.F_REQUIRED) == 0
        u32 s = w.p.sym(f, x)
        bool seen = false
        for i in 0..<#len(out^):
            if out^[i].name != s: continue
            seen = true
            if out^[i].body && body && depth == 0 && out^[i].trait != t:
                w.d.phase = diag.PH_INTERFACE
                string8 m = name_of(w, s)
                say_tok(w, f, 0, x, 535, index.hold(#format("`", name_of(w, w.decls[t].name), "` gives `", m, "` a body, and `", name_of(w, w.decls[out^[i].trait].name), "` already defaults it: a child trait may default a parent's required method, never replace a parent's default")), index.hold(#format("only an implementer overrides a default — write `", m, "` in the `type`, and drop it from `", name_of(w, w.decls[t].name), "`")))
            else if body: out^[i] = Need(s, t, x, true)
        if !seen: out^ = #append(out^, Need(s, t, x, body))

// The trait `extends` node `x` of `t` names, or NONE (reported once, by
// the interface pass).
private u32 parent(^World w, u32 t, u32 f, u32 x):
    syntax.Ast a = w.p.files[f].a
    if a.tag[x] != syntax.T_NAME: return NONE
    u32 p = lookup(w, w.p.files[f].pkg, w.p.sym(f, x))
    if p == NONE || w.decls[p].kind != K_TRAIT || reaches(w, p, t, 0): return NONE
    return p

bool reaches(^World w, u32 from, u32 to, i64 depth):
    if from == to: return true
    if depth > 32: return false
    u32 f = w.decls[from].file
    syntax.Ast a = w.p.files[f].a
    for x in a.list(a.b[w.decls[from].node]):
        if x == NONE || a.tag[x] != syntax.T_NAME: continue
        u32 p = lookup(w, w.p.files[f].pkg, w.p.sym(f, x))
        if p != NONE && w.decls[p].kind == K_TRAIT && reaches(w, p, to, depth + 1): return true
    return false

// A trait's head, once: ERR0535 for an `extends` naming a type, and for a
// trait reaching itself.
void trait_head(^World w, u32 t):
    u32 f = w.decls[t].file
    syntax.Ast a = w.p.files[f].a
    string8 tn = name_of(w, w.decls[t].name)
    w.d.phase = diag.PH_INTERFACE
    for x in a.list(a.b[w.decls[t].node]):
        if x == NONE || a.tag[x] != syntax.T_NAME: continue
        u32 p = lookup(w, w.p.files[f].pkg, w.p.sym(f, x))
        if p == NONE:
            _ = resolve_type(w, f, x)
            continue
        string8 pn = name_of(w, w.decls[p].name)
        if w.decls[p].kind != K_TRAIT:
            say(w, f, 0, a.lo[x], a.hi[x], 535, index.hold(#format("`", pn, "` is a type, and a trait extends traits only — a trait prescribes methods and never a shape")), index.hold(#format("a type is embedded, not extended: name the methods `", tn, "` needs in the trait, and let an implementer embed `", pn, "`")))
        else if reaches(w, p, t, 0) && p != t && !(p in w.cycled):
            w.cycled[t] = 1
            say_tok(w, f, 0, w.decls[t].node, 535, index.hold(#format("`", tn, "` extends `", pn, "` extends `", tn, "`: a trait never extends itself, through any number of parents")), index.hold(#format("drop one `extends` on the path — the methods `", tn, "` shares with its ancestors belong in the ancestor")))
    for x in a.list(a.b[w.decls[t].node]):
        if x == NONE || a.tag[x] != syntax.N_FN || a.list(a.b[x])[3] != NONE: continue
        u32 ret = a.list(a.b[x])[0]
        string8 rt = "void"
        if ret != NONE: rt = w.p.files[f].src[i64(a.lo[ret])..<i64(a.hi[ret])]
        string8 mn = w.p.spell(f, x)
        say_tok(w, f, 0, x, 533, index.hold(#format("`", tn, ".", mn, "` takes no receiver, and every method a trait prescribes is called on an implementer")), index.hold(#format("take `self` or `^self` first — `", rt, " ", mn, "(self…)`")))
    ref []u32 ps
    for x in a.list(a.b[w.decls[t].node]):
        if x == NONE || a.tag[x] == syntax.N_BINDER || a.tag[x] == syntax.N_FN: continue
        u32 p = parent(w, t, f, x)
        if p != NONE: ps = #append(ps, p)
    ref []u32 cs = clashes(w, ps, f, w.decls[t].node, t, NONE)
    #delete(cs)
    ref []Need ns = needs(w, t)
    #delete(ns)

// ERR0407: traits extended (by trait `t`) or taken on (by type `d`) that
// prescribe one name two ways, or default it twice. The names, to skip.
private ref []u32 clashes(^World w, []u32 ts, u32 f, u32 at, u32 t, u32 d, u32 hi = 0):
    ref []u32 out
    for i in 0..<#len(ts):
        ref []Need ni = needs(w, ts[i])
        for j in i + 1..<#len(ts):
            ref []Need nj = needs(w, ts[j])
            for x in ni:
                for y in nj:
                    if x.name != y.name || x.node == y.node: continue
                    string8 hx = head_text(w, w.decls[x.trait].file, x.node)
                    string8 hy = head_text(w, w.decls[y.trait].file, y.node)
                    if hx == hy && !(x.body && y.body): continue
                    out = #append(out, x.name)
                    string8 m = name_of(w, x.name)
                    string8 l = name_of(w, w.decls[ts[i]].name)
                    string8 r = name_of(w, w.decls[ts[j]].name)
                    if d == NONE:
                        string8 tn = name_of(w, w.decls[t].name)
                        string8 why = index.hold(#format("two signatures, `", hx, "` and `", hy, "`, so an implementer would not know which it meets"))
                        if hx == hy: why = index.hold(#format("two defaults for `", hx, "`, so which body an implementer gets has two answers"))
                        say_tok(w, f, 0, at, 407, index.hold(#format("`", tn, "` extends `", l, "` and `", r, "`, and both prescribe `", m, "` — ", why)), index.hold(#format("rename `", m, "` in one of the two traits, or give them one signature with at most one default")))
                        continue
                    string8 dn = name_of(w, w.decls[d].name)
                    syntax.Ast a = w.p.files[f].a
                    if hx == hy:
                        u32 own = method_named(w, d, m)
                        if own == NONE: say(w, f, 0, a.lo[at], hi, 407, index.hold(#format("`", dn, "` takes on `", l, "` and `", r, "`, and both give `", hx, "` a default, so which body `", dn, "` gets has two answers")), index.hold(#format("write `", m, "` in `", dn, "`'s body — an own method answers both defaults")))
                    else: say(w, f, 0, a.lo[at], hi, 407, index.hold(#format("`", dn, "` takes on `", l, "` and `", r, "`, and both prescribe `", m, "` — `", hx, "` and `", hy, "` — so one method cannot meet both")), index.hold(#format("take on one of the two, or rename `", m, "` in one of the traits")))
            #delete(nj)
        #delete(ni)
    return out

// `void draw(self)`: a method's head as written.
string8 head_text(^World w, u32 f, u32 n):
    syntax.Ast a = w.p.files[f].a
    u32 body = a.list(a.b[n])[5]
    u32 hi = a.hi[n] if body == NONE || (a.a[n] & syntax.F_REQUIRED) != 0 else a.lo[body]
    string8 src = w.p.files[f].src
    for hi > a.lo[n] && src[hi - 1] != ')':
        hi -= 1
    return src[i64(a.lo[n])..<i64(hi)]

// Type `d` (row `ty`) takes on each trait its head names: ERR0535, ERR0536,
// and a default becomes `d`'s method, the trait's node re-walked.
void conform(^World w, u32 d, u32 ty, u32 env = NONE):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    string8 dn = named(w, ty)
    []u32 ks = a.list(a.b[w.decls[d].node])
    ref []u32 ts
    u32 first = NONE
    u32 last = 0
    for u in ks[3..<#len(ks)]:
        if u == NONE || a.tag[u] != syntax.T_NAME && a.tag[u] != syntax.T_PATH: continue
        u32 t = using_decl(w, f, u)
        if t != NONE && w.decls[t].kind == K_TRAIT:
            ts = #append(ts, t)
            if first == NONE: first = u
            last = a.hi[u]
    ref []u32 skip = clashes(w, ts, f, first, NONE, d, last)
    for u in ks[3..<#len(ks)]:
        if u == NONE || a.tag[u] == syntax.N_BINDER || a.tag[u] == syntax.N_FN || a.tag[u] == syntax.N_ASSERT_RAISES: continue
        w.d.phase = diag.PH_INTERFACE
        if a.tag[u] != syntax.T_NAME && a.tag[u] != syntax.T_PATH:
            say(w, f, 0, a.lo[u], a.hi[u], 1, "this `using` is outside the slice the port builds so far", "")
            continue
        u32 t = using_decl(w, f, u)
        if t == NONE:
            _ = resolve_type(w, f, u)
            continue
        string8 tn = name_of(w, w.decls[t].name)
        if w.decls[t].kind != K_TRAIT:
            say(w, f, 0, a.lo[u], a.hi[u], 535, index.hold(#format("`", tn, "` is a type, and `using` at a declaration's head takes a trait on — a type's slots are shared by embedding")), index.hold(#format("embed it: `type ", dn, ": (", tn, ", …)`")))
            continue
        if env == NONE || !implements(w, ty, t): w.impls = #append(w.impls, (u64(t) << 32) | u64(d))
        ref []Need ns = needs(w, t)
        for nd in ns:
            bool clash = false
            for x in skip:
                if x == nd.name: clash = true
            if clash: continue
            u32 tf = w.decls[nd.trait].file
            string8 head = head_text(w, tf, nd.node)
            string8 mn = name_of(w, nd.name)
            string8 asks = index.hold(#format("`", dn, "` takes on `", tn, "`, which asks `", head, "`, and "))
            u32 at = NONE
            u32 own = method(w, ty, nd.name, &at)
            if own == NONE && nd.body:
                if ((u64(d) << 32) | u64(nd.name)) in w.methods: continue
                u32 v = u32(#len(w.decls))
                w.decls = #append(w.decls, Decl(nd.name, K_METHOD, w.decls[d].pkg, tf, nd.node, d, 0, NONE, false, nd.trait))
                w.methods[(u64(d) << 32) | u64(nd.name)] = v
                w.dflt_using[v] = (u64(f) << 32) | u64(u)
                continue
            if own == NONE:
                say(w, f, 0, a.lo[u], a.hi[u], 536, index.hold(#format(asks, "`", dn, "` has no method `", mn, "`")), index.hold(#format("write it in `", dn, "`'s body — `", head, ":` and its body")))
                continue
            u32 v = u32(#len(w.decls))
            w.decls = #append(w.decls, Decl(nd.name, K_METHOD, w.decls[d].pkg, tf, nd.node, d, 0, NONE, false, nd.trait))
            // The implementer's own signature first, as Rust resolves it.
            // Asked by the signature, not by the instance's body: a fresh origin.
            u32 ask = w.asking
            w.asking = NONE
            u32 got = sig(w, own, env)
            u32 want = sig(w, v, env)
            w.asking = ask
            if want == NONE || got == NONE: continue
            syntax.Ast oa = w.p.files[w.decls[own].file].a
            syntax.Ast ta = w.p.files[tf].a
            u32 orc = oa.list(oa.b[w.decls[own].node])[3]
            u32 trc = ta.list(ta.b[nd.node])[3]
            string8 why = ""
            if !agree(w, w.t.a[got], w.t.a[want], ty):
                string8 gs = shown(w, w.t.a[got])
                string8 ws = shown(w, w.t.a[want])
                if gs == ws:
                    gs = told(w, w.t.a[got], gs)
                    ws = told(w, w.t.a[want], ws)
                why = index.hold(#format("`", dn, "`'s `", mn, "` returns ", gs, " where the trait's returns ", ws))
            else if (orc == NONE) != (trc == NONE) || orc != NONE && oa.a[orc] != ta.a[trc]:
                why = index.hold(#format("`", dn, "`'s `", mn, "` takes `", receiver(&oa, orc), "` where the trait's takes `", receiver(&ta, trc), "`"))
            else if !same_params(w, got, want, ty): why = index.hold(#format("`", dn, "`'s `", mn, "` takes other parameters than the trait's"))
            string8 narrow = ""
            if env != NONE: narrow = index.hold(#format(", or narrow `", name_of(w, w.decls[d].name), "`'s domain with a `where` that leaves `", dn, "` out"))
            if #len(why) > 0: say(w, f, 0, a.lo[u], a.hi[u], 536, index.hold(#format(asks, why)), index.hold(#format("write `", mn, "` in `", name_of(w, w.decls[d].name), "`'s body as `", tn, "` asks it — `", head, "`", narrow)))
        #delete(ns)

// A type shown beside another that reads alike: with its declaring package.
private string8 told(^World w, u32 ty, string8 shown_):
    u32 d = decl_of(w, ty)
    if d == NONE: return index.hold(#format(shown_, " (a shape no declaration names)"))
    return index.hold(#format(shown_, " (declared in package `", pkg_label(w, w.decls[d].pkg), "`)"))

private string8 receiver(^syntax.Ast a, u32 rc):
    if rc == NONE: return "no receiver"
    return "^self" if a.a[rc] == 1 else "self"

private bool same_params(^World w, u32 x, u32 y, u32 self_):
    []u32 xs = w.t.list(x)
    []u32 ys = w.t.list(y)
    if #len(xs) != #len(ys): return false
    for i in 1..<#len(xs):
        if !agree(w, xs[i], ys[i], self_): return false
    return true

// A method's type meets the trait's at one position: structurally, but
// nominally where the trait names `Self`.
private bool agree(^World w, u32 got, u32 want, u32 self_):
    return got == want || want != self_ && same_shape(w, got, want)

// Whether the type declaration behind `ty` takes trait `t` on.
bool implements(^World w, u32 ty, u32 t):
    if !(ty in w.type_decl): return false
    try u32 d = w.type_decl[ty] else: return false
    if w.decls[d].kind == K_TRAIT: return reaches(w, d, t, 0)
    _ = resolve(w, d)
    for x in w.impls:
        if u32(x & 0xFFFFFFFF) == d && (u32(x >> 32) == t || reaches(w, u32(x >> 32), t, 0)): return true
    return false

// How file `f` spells trait `t`: bare in its own package, through `f`'s
// import when `f` is the file being checked (`here`), else by the last
// segment of its package's path.
string8 trait_spelled(^World w, u32 t, u32 f, u32 here):
    u32 tp = w.decls[t].pkg
    string8 tn = name_of(w, w.decls[t].name)
    if f != NONE && tp == w.p.files[f].pkg: return tn
    if f == here:
        for im in w.p.pkgs[w.p.files[f].pkg].imports:
            if im.file == f && im.pkg == tp: return index.hold(#format(name_of(w, im.name if im.name != NONE else w.p.pkgs[tp].name), ".", tn))
    string8 k = w.p.pkgs[tp].key
    k = k[strings.last_index_of(k, ':') + 1..<#len(k)]
    return index.hold(#format(k[strings.last_index_of(k, '/') + 1..<#len(k)], ".", tn))

// A package as a repair names it: its name.
string8 pkg_label(^World w, u32 p):
    return name_of(w, w.p.pkgs[p].name) if w.p.pkgs[p].name != NONE else "main"

// Whether declaration `d` is visible from file `f`.
bool visible(^World w, u32 d, u32 f):
    u32 v = w.p.files[w.decls[d].file].a.a[w.decls[d].node] & syntax.F_VIS
    if v == syntax.VIS_FILE: return w.decls[d].file == f
    return v != syntax.VIS_PACKAGE || w.decls[d].pkg == w.p.files[f].pkg

// How file `f` spells some declaration taking `t` on, the first by
// (package, name) that it can see, or "".
string8 an_implementer(^World w, u32 t, u32 f):
    string8 best = ""
    string8 bk = ""
    for x in w.impls:
        u32 d = u32(x & 0xFFFFFFFF)
        if u32(x >> 32) != t || !visible(w, d, f): continue
        string8 sp = name_of(w, w.decls[d].name)
        if w.decls[d].pkg != w.p.files[f].pkg:
            string8 bind = ""
            for im in w.p.pkgs[w.p.files[f].pkg].imports:
                if im.file == f && im.pkg == w.decls[d].pkg: bind = name_of(w, im.name if im.name != NONE else w.p.pkgs[im.pkg].name)
            if bind == "": continue
            sp = index.hold(#format(bind, ".", sp))
        string8 key = index.hold(#format(pkg_label(w, w.decls[d].pkg), "\x00", name_of(w, w.decls[d].name)))
        if best == "" || bytes_less(key, bk):
            best = sp
            bk = key
    return best

// The repair for a value whose declaration `dd` (NONE: a shape) does not
// take `t` on, asked in file `f`.
string8 using_repair(^World w, u32 t, u32 dd, u32 f, string8 fname, string8 verb):
    string8 tn = name_of(w, w.decls[t].name)
    string8 tp = pkg_label(w, w.decls[t].pkg)
    if !visible(w, t, f) && verb == "convert": return index.hold(#format("`", tn, "` is private to `", tp, "`, so nothing declared here can take it on"))
    if !visible(w, t, f): return index.hold(#format("`", fname, "` cannot be called from outside `", tp, "`: its trait `", tn, "` is private to that package, so nothing declared here can take it on"))
    string8 add = ""
    if dd != NONE: add = index.hold(#format("add `using ", trait_spelled(w, t, w.decls[dd].file, f), "` to `", name_of(w, w.decls[dd].name), "`'s declaration in `", pkg_label(w, w.decls[dd].pkg), "`"))
    else: add = index.hold(#format("declare a `type` that writes `using ", trait_spelled(w, t, f, f), "` and type the value by it"))
    string8 im = an_implementer(w, t, f)
    if im == "": return add
    return index.hold(#format(add, ", or ", verb, " a declaration that takes it on, such as `", im, "`"))

// The type declaration behind `ty`, or NONE.
u32 decl_of(^World w, u32 ty):
    if ty == NONE || !(ty in w.type_decl): return NONE
    try u32 d = w.type_decl[ty] else: return NONE
    return d if w.decls[d].kind != K_TRAIT else NONE

// ERR0919: what binds a trait parameter is a declaration that takes it on.
bool takes_on(^World w, ^Body b, u32 d, u32 t, Val v, u32 at):
    string8 fname = name_of(w, w.decls[d].name)
    string8 sp = trait_spelled(w, t, b.file, b.file)
    syntax.Ast a = tree(w, b)
    u32 ty = v.ty
    string8 why = index.hold(#format("\x1f`", sp, "` is answered by a declaration's `using`, so the argument has to be typed by a declaration that writes `using ", sp, "`"))
    string8 head = index.hold(#format("`", fname, "` takes any declaration that takes `", sp, "` on, and "))
    string8 im = an_implementer(w, t, b.file)
    if v.kind == V_LIT || v.kind == V_FLIT || a.tag[at] == syntax.E_TUPLE || a.tag[at] == syntax.E_ARRAY:
        string8 help = index.hold(#format("declare a `type` that writes `using ", sp, "` and bind the value to it first"))
        if im != "": help = index.hold(#format("bind it to an implementer first — `", im, " v = ", src(w, b, at), "`, then `", fname, "(v)`"))
        err(w, b, at, 919, index.hold(#format(head, "this is a literal, a shape, which implements nothing", why)), help)
        return false
    if implements(w, ty, t): return true
    u32 dd = decl_of(w, ty)
    string8 help = using_repair(w, t, dd, b.file, fname, "pass")
    if dd == NONE && im != "" && visible(w, t, b.file): help = index.hold(#format("type the value by an implementer — `", im, " v = …`, then `", fname, "(v)`"))
    if dd == NONE:
        err(w, b, w.bind_call, 919, index.hold(#format(head, "`", w.bind_param, "` is bound to ", shown(w, ty), ", a shape with no declaration, which implements nothing", why)), help)
        return false
    string8 instead = ""
    for x in w.impls:
        u32 o = u32(x >> 32)
        if u32(x & 0xFFFFFFFF) == dd && o != t && w.decls[o].name == w.decls[t].name: instead = index.hold(#format(": it takes `", trait_spelled(w, o, b.file, b.file), "` on, package `", pkg_label(w, w.decls[o].pkg), "`'s"))
    err(w, b, w.bind_call, 919, index.hold(#format(head, "`", name_of(w, w.decls[dd].name), "` does not take `", sp, "` on", instead)), help)
    return false

// A default's provenance: the `using` that gave it, then the asking call.
string8 default_note(^World w, u32 d, u32 of, u32 at):
    try u64 u = w.dflt_using[d] else: return ""
    u32 uf = u32(u >> 32)
    diag.Place up = w.p.map.place(w.p.map.base[uf] + w.p.files[uf].a.lo[u32(u & 0xFFFFFFFF)])
    diag.Place cp = w.p.map.place(w.p.map.base[of] + at)
    u32 im = w.decls[d].block
    string8 tn = name_of(w, w.decls[w.decls[d].value].name)
    string8 dn = name_of(w, w.decls[im].name)
    return index.hold(#format(", while instantiating `", tn, ".", name_of(w, w.decls[d].name), "` for `", name_of(w, w.p.pkgs[w.decls[im].pkg].name), ".", dn, "` — the default `", dn, "` takes on by the `using` at ", w.p.map.names[uf], ":", up.line, ":", up.col, ", asked for by the call at ", w.p.map.names[of], ":", cp.line, ":", cp.col))

// ERR0410: a default body reaches `self` only through its trait's methods.
bool shapeless(^World w, ^Body b, u32 base, u32 n):
    if b.decl == NONE: return false
    u32 t = w.decls[b.decl].value
    if w.decls[b.decl].kind != K_METHOD || t == NONE || tree(w, b).tag[base] != syntax.E_NAME || spell(w, b, base) != "self": return false
    u32 s = w.p.sym(b.file, n)
    ref []Need ns = needs(w, t)
    for x in ns:
        if x.name == s: return false
    string8 tn = name_of(w, w.decls[t].name)
    string8 m = spell(w, b, n)
    err_tok(w, b, n, 410, index.hold(#format("`", m, "` is no method of `", tn, "`, and a default body reaches `self` only through `", tn, "`'s methods — a trait prescribes methods, never a shape")), index.hold(#format("make `", m, "` a required method of `", tn, "`, or give the implementers an embedded type that has it")))
    return true

// The declaration a `using` names: `T`, or `pkg.T` through this file's imports.
u32 using_decl(^World w, u32 f, u32 u):
    syntax.Ast a = w.p.files[f].a
    if a.tag[u] == syntax.T_NAME: return lookup(w, w.p.files[f].pkg, w.p.sym(f, u))
    u32 ps = w.p.files[f].t.sym[a.a[u]]
    u32 bd = lookup(w, w.p.files[f].pkg, ps)
    if bd != NONE && w.decls[bd].kind == K_FBIND: return lookup(w, BOUND_PKG | bd, w.p.sym(f, u))
    for im in w.p.pkgs[w.p.files[f].pkg].imports:
        if im.file == f && (im.name if im.name != NONE else w.p.pkgs[im.pkg].name) == ps: return lookup(w, im.pkg, w.p.sym(f, u))
    return NONE
