// A class embedding a `type`: the type's named
// slots are fields of the class; its name, as a member, is the slots whole,
// read as one value and stored by a plain `=`.
package check

import "language:diag"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"

// One `type` a class embeds: its line, the class's own fields above it, the
// type (NONE: refused), its slots' names and script types (`live` false: a
// name refused).
type SEmbed:
    u32 node
    i64 at
    u32 ty
    ref []u32 syms
    ref []u32 tys
    ref []bool live
    bool done

// A field of a class: its own (`emb` -1), or slot `slot` of embedding `emb`.
type SField:
    u32 file
    u32 node
    u32 sym
    u32 cls
    i64 emb
    i64 slot

// Rust's `lower_first`: "value" when lowering changes nothing.
private string8 se_lower(string8 s):
    if #len(s) == 0 || s[0] < 'A' || s[0] > 'Z': return "value"
    ref []char8 o
    o = #append(o, s[0] + 32)
    for c in s[1..<#len(s)]:
        o = #append(o, c)
    return index.hold(o)

// Every field of class `ci`, inherited ones first, in written order.
ref []SField s_fields_of(^World w, u32 ci):
    ref []SField out
    u32 pc = s_parent(w, ci)
    if pc != NONE: out = s_fields_of(w, pc)
    se_ready(w, ci)
    SClass c = w.classes[ci]
    i64 nf = #len(c.fields)
    for i in 0..<nf + 1:
        for k in 0..<#len(c.embs):
            if c.embs[k].at != i || c.embs[k].ty == NONE: continue
            for j in 0..<#len(c.embs[k].syms):
                if c.embs[k].live[j]: out = #append(out, SField(c.file, c.embs[k].node, c.embs[k].syms[j], ci, k, j))
        if i < nf: out = #append(out, SField(c.file, c.fields[i], w.p.sym(c.file, c.fields[i]), ci, -1, -1))
    return out

// The script type of field `x`, NONE for an own field (resolved from its node).
u32 se_field_ty(^World w, SField x):
    if x.emb < 0: return NONE
    return w.classes[x.cls].embs[x.emb].tys[x.slot]

// Each class's embeddings declared (their errors said), once.
void se_all(^World w):
    for ci in 0..<#len(w.classes):
        se_ready(w, u32(ci))
    se_promotions(w)

void se_ready(^World w, u32 ci):
    bool any = false
    for k in 0..<#len(w.classes[ci].embs):
        if w.classes[ci].embs[k].done: continue
        w.classes[ci].embs[k].done = true
        se_declare(w, ci, k)
        any = true
    if any: se_after(w, ci)

private string8 se_taken(string8 cn, string8 lb, string8 nm, string8 kind):
    return index.hold(#format("`", cn, "` embeds `", lb, "`, whose slot `", nm, "` is a field of `", cn, "`, and `", cn, "` has a ", kind, " `", nm, "` too; a collision is refused, never an override"))

private string8 se_taken_help(string8 lb, string8 kind):
    string8 lo = se_lower(lb)
    return index.hold(#format("rename the ", kind, ", or hold `", lb, "` in a field of its own (`", lb, " ", lo, "`) so its slots are reached through it"))

// Embedding `k` of class `ci`: ERR1310 for what is no `type` with named
// slots, ERR0409/ERR0534 for a name the class already has.
private void se_declare(^World w, u32 ci, i64 k):
    SClass c = w.classes[ci]
    u32 f = c.file
    syntax.Ast a = w.p.files[f].a
    u32 n = c.embs[k].node
    u32 tn = a.list(a.b[n])[0]
    string8 cn = name_of(w, w.decls[c.decl].name)
    string8 lb = w.p.spell(f, n)
    string8 wr = w.p.files[f].src[i64(a.lo[tn])..<i64(a.hi[tn])]
    string8 lo = se_lower(lb)
    u32 ty = resolve_type(w, f, tn)
    if ty == NONE: return
    w.d.phase = diag.PH_INTERFACE
    if s_class_of_ty(w, ty) != NONE:
        string8 m = index.hold(#format("`", cn, "` embeds `", wr, "`, which is a class: embedding makes the slots of a `type` fields of the class, and a class is never embedded"))
        say(w, f, 0, a.lo[tn], a.hi[tn], 1310, m, index.hold(#format("inherit it, `class ", cn, " extends ", wr, "`, or hold it in a field, `", wr, " ", lo, " = ", wr, "(…)`")))
        return
    u32 d = NONE
    if ty in w.type_decl:
        try d = w.type_decl[ty] else: pass
    string8 held = index.hold(#format("hold it in a field, `", wr, " ", lo, "`"))
    if d == NONE || w.decls[d].kind != K_TYPE && w.decls[d].kind != K_UNION && w.decls[d].kind != K_ENUM:
        say(w, f, 0, a.lo[tn], a.hi[tn], 1310, index.hold(#format("`", cn, "` embeds `", wr, "`, which is no `type`: embedding makes the named slots of a `type` fields of the class")), held)
        return
    if w.decls[d].kind == K_UNION:
        say(w, f, 0, a.lo[tn], a.hi[tn], 1310, index.hold(#format("`", cn, "` embeds `", wr, "`, which is a union: a value that is one of its members at a time has no slots to make fields of")), held)
        return
    []u32 ss = w.t.slots(ty)
    []u32 sn = w.t.slot_names(ty)
    i64 un = -1
    if #len(ss) == 0: un = 0
    for i in 0..<#len(ss):
        if un >= 0: continue
        if i >= #len(sn):
            un = i
            continue
        string8 tx = w.t.text(sn[i])
        if #len(tx) == 0: un = i
    if un >= 0:
        string8 m = index.hold(#format("`", cn, "` embeds `", wr, "`, whose slot ", un, " has no name: embedding makes each slot a field of the class, reached by its name"))
        say(w, f, 0, a.lo[tn], a.hi[tn], 1310, m, index.hold(#format("name every slot where `", lb, "` is declared, or hold it in a field, `", wr, " ", lo, "`")))
        return
    u32 ls = w.p.sym(f, n)
    string8 kind = ""
    if se_above(w, ci, k, ls) != 0: kind = "field"
    else if se_method(w, ci, ls) != NONE: kind = "method"
    if #len(kind) > 0:
        string8 m = index.hold(#format("`", cn, "` embeds `", wr, "`, reached whole as `", lb, "`, and already has a ", kind, " `", lb, "`; a collision is refused, never an override"))
        say_tok(w, f, 0, n, 409, m, index.hold(#format("rename the ", kind)))
        return
    bool dado = !ds_at(w, w.decls[d].file, w.decls[d].node)
    ref []u32 syms
    ref []u32 tys
    ref []bool live
    for i in 0..<#len(ss):
        string8 nm = w.t.text(sn[i])
        u32 sy = w.p.names.intern(nm)
        u32 st = ss[i]
        if dado: st = seam_sty(w, st, false)
        u8 at = se_above(w, ci, k, sy)
        u32 m = se_method(w, ci, sy)
        bool ok = at == 0
        if at == 1:
            say_tok(w, f, 0, n, 409, se_taken(cn, lb, nm, "field"), se_taken_help(lb, "field"))
        else if at == 0 && m != NONE:
            say_tok(w, w.decls[m].file, 0, w.decls[m].node, 534, se_taken(cn, lb, nm, "method"), se_taken_help(lb, "method"))
            ok = false
        syms = #append(syms, sy)
        tys = #append(tys, st)
        live = #append(live, ok)
    w.classes[ci].embs[k].ty = ty
    w.classes[ci].embs[k].syms = syms
    w.classes[ci].embs[k].tys = tys
    w.classes[ci].embs[k].live = live

// Whether `sym` is a field of class `ci` above embedding `k`: 1 its own, 2 an
// earlier embedded slot, 0 neither.
private u8 se_above(^World w, u32 ci, i64 k, u32 sym):
    SClass c = w.classes[ci]
    for x in c.fields[0..<c.embs[k].at]:
        if w.p.sym(c.file, x) == sym: return 1
    for q in 0..<k:
        if c.embs[q].ty == NONE: continue
        for j in 0..<#len(c.embs[q].syms):
            if c.embs[q].live[j] && c.embs[q].syms[j] == sym: return 2
    return 0

private u32 se_method(^World w, u32 ci, u32 sym):
    for m in w.classes[ci].methods:
        if w.decls[m].name == sym: return m
    for m in w.classes[ci].gens:
        if w.decls[m].name == sym: return m
    return NONE

// Once a class's embeddings are declared: two bringing one slot (ERR0407),
// and an own field below one named like it whole (ERR0409).
private void se_after(^World w, u32 ci):
    SClass c = w.classes[ci]
    u32 f = c.file
    syntax.Ast a = w.p.files[f].a
    string8 cn = name_of(w, w.decls[c.decl].name)
    ref []u32 said
    for k in 0..<#len(c.embs):
        if c.embs[k].ty == NONE: continue
        for j in 0..<#len(c.embs[k].syms):
            u32 sy = c.embs[k].syms[j]
            if c.embs[k].live[j] || se_has(said[:], sy): continue
            for q in 0..<k:
                if c.embs[q].ty == NONE || se_has(said[:], sy): continue
                for x in 0..<#len(c.embs[q].syms):
                    if !c.embs[q].live[x] || c.embs[q].syms[x] != sy: continue
                    said = #append(said, sy)
                    u32 tn = a.list(a.b[c.embs[k].node])[0]
                    string8 l1 = w.p.spell(f, c.embs[q].node)
                    string8 l2 = w.p.spell(f, c.embs[k].node)
                    string8 nm = name_of(w, sy)
                    w.d.phase = diag.PH_INTERFACE
                    say(w, f, 0, a.lo[tn], a.hi[tn], 407, index.hold(#format("`", l1, "` and `", l2, "` are both embedded in `", cn, "` and both contribute `", nm, "`, so the unqualified name has no winner")), "rename one of the contributing slots, or embed only one of the two")
                    break
    for e in c.embs:
        u32 ls = w.p.sym(f, e.node)
        string8 lb = w.p.spell(f, e.node)
        for x in c.fields[e.at..<#len(c.fields)]:
            if w.p.sym(f, x) != ls: continue
            w.d.phase = diag.PH_INTERFACE
            say_tok(w, f, 0, x, 409, index.hold(#format("`", cn, "` embeds `", lb, "`, reached whole as `", lb, "`, so a field of `", cn, "` may not be named `", lb, "`; a collision is refused, never an override")), "rename the field")

private bool se_has([]u32 xs, u32 x):
    for y in xs:
        if y == x: return true
    return false

// The member `sym` class `ci` or a parent embeds, read whole: its type, and
// its first slot's index among the class's fields (`full` false: a slot was
// refused a name). NONE when there is none. A type embedded through another
// is a member too.
u32 se_member(^World w, u32 ci, u32 sym, ^i64 first, ^bool full):
    if ci == NONE: return NONE
    ref []SField fl = s_fields_of(w, ci)
    u32 cc = ci
    for _ in 0..<64:
        if cc == NONE: break
        SClass c = w.classes[cc]
        for k in 0..<#len(c.embs):
            if c.embs[k].ty == NONE: continue
            i64 at = -1
            bool all = true
            for j in 0..<#len(c.embs[k].live):
                if !c.embs[k].live[j]: all = false
            for p in 0..<#len(fl):
                if at < 0 && fl[p].cls == cc && fl[p].emb == k: at = p
            i64 off = 0
            u32 t = se_inner(w, c.embs[k].ty, w.p.sym(c.file, c.embs[k].node), sym, &off)
            if t == NONE: continue
            full^ = all && at >= 0
            first^ = at + off
            return t
        cc = s_parent(w, cc)
    return NONE

// `sym` names type `ty` (embedded as `label`) or one it embeds: that type,
// its slots' offset in `ty`'s.
private u32 se_inner(^World w, u32 ty, u32 label, u32 sym, ^i64 off):
    if label == sym: return ty
    for e in w.embeds:
        if e.outer != ty || !(e.inner in w.type_decl): continue
        try u32 d = w.type_decl[e.inner] else: continue
        i64 o = 0
        u32 t = se_inner(w, e.inner, w.decls[d].name, sym, &o)
        if t == NONE: continue
        off^ = i64(e.at) + o
        return t
    return NONE

// Slot `i` of the class's fields: of `self` when `base` is NONE, else of
// the instance `base` holds.
private Val se_slot(^World w, ^Body b, u32 n, u32 base, u32 bty, i64 i):
    if base == NONE:
        ref []SField fl = s_fields_of(w, b.cls)
        return s_field_use(w, b, n, fl[i].sym, i)
    []u32 sl = w.t.slots(bty)
    if i >= #len(sl): return bad()
    return value(ir.step(&b.f, base, ir.ST_FIELD, u32(i), sl[i]), sl[i])

// Member `ty` (first slot `first`) read whole.
Val se_read(^World w, ^Body b, u32 n, u32 ty, i64 first, bool full, u32 base, u32 bty):
    if !full: return bad()
    []u32 ss = w.t.slots(ty)
    ref []u32 opds
    for j in 0..<#len(ss):
        Val v = se_slot(w, b, n, base, bty, first + j)
        if v.ty == NONE: return bad()
        opds = #append(opds, v.opd)
    u32 t = temp(w, b, ty, n)
    _ = ir.op(&b.f, ir.O_MAKE, 0, ty, n, t, NONE)
    for x in opds:
        ir.arg(&b.f, x)
    return value(t, ty)

// `place = value` where the place is an embedded member named whole: each
// slot stored. ERR0606 for a compound assignment. Whether it was one.
bool se_assign(^World w, ^Body b, u32 n, u32 pn, u32 rhs, string8 op):
    syntax.Ast a = tree(w, b)
    u32 ci = b.cls
    u32 base = NONE
    u32 bty = NONE
    u32 sym = w.p.sym(b.file, pn)
    if ci == NONE: return false
    if a.tag[pn] == syntax.E_NAME:
        if find_local(w, b, sym, false) != NONE || s_field_ix(w, b, sym) >= 0: return false
    else if a.tag[pn] == syntax.E_FIELD && a.tag[a.a[pn]] == syntax.E_NAME:
        u32 q = a.a[pn]
        u32 ql = find_local(w, b, w.p.sym(b.file, q), false)
        if spell(w, b, q) == "self":
            if s_field_ix(w, b, sym) >= 0: return false
        else:
            if ql == NONE: return false
            u32 qt = b.f.slot_ty[ql]
            ci = s_class_of_ty(w, qt)
            if ci == NONE || w.t.tag[w.t.resolve(qt)] == types.T_PTR: return false
            for x in s_fields_of(w, ci):
                if x.sym == sym: return false
            bty = qt
    else:
        return false
    i64 first = 0
    bool full = false
    u32 ty = se_member(w, ci, sym, &first, &full)
    if ty == NONE: return false
    if op != "=":
        string8 x = src(w, b, pn)
        err(w, b, pn, 606, index.hold(#format("`", x, "` is an embedded member, stored whole by a plain `=`, and here it is the place of a compound assignment")), index.hold(#format("assign it whole, `", x, " = …`, or write its slots one at a time")))
        return true
    if bty != NONE:
        Val bv = local_val(w, b, find_local(w, b, w.p.sym(b.file, a.a[pn]), true))
        if bv.ty == NONE: return true
        base = spill(w, b, bv, a.a[pn])
    Val v = coerce(w, b, expr(w, b, rhs, ty), ty, rhs, "the place assigned to is")
    if v.ty == NONE || !full: return true
    u32 t = spill(w, b, v, rhs)
    []u32 ss = w.t.slots(ty)
    for j in 0..<#len(ss):
        Val fp = se_slot(w, b, pn, base, bty, first + j)
        if fp.ty == NONE: return true
        _ = ir.op(&b.f, ir.O_SET, 0, fp.ty, pn, fp.opd, ir.step(&b.f, t, ir.ST_FIELD, u32(j), ss[j]))
    return true

// ── promoted methods ─────────────────────────────────────────────────────────

// Method `sym` of Dado type `ty` or a type it embeds (one with a receiver):
// the method, and the declaring type's slots' offset in `ty`'s.
private u32 se_find(^World w, u32 ty, u32 sym, ^i64 off, ^u32 decl_ty):
    if !(ty in w.type_decl): return NONE
    try u32 td = w.type_decl[ty] else: return NONE
    u64 key = (u64(td) << 32) | u64(sym)
    if key in w.methods:
        try u32 m = w.methods[key] else: return NONE
        if se_recv(w, m):
            off^ = 0
            decl_ty^ = ty
            return m
    for e in w.embeds:
        if e.outer != ty: continue
        i64 o = 0
        u32 m = se_find(w, e.inner, sym, &o, decl_ty)
        if m == NONE: continue
        off^ = i64(e.at) + o
        return m
    return NONE

// Whether method `m` takes a receiver (`self` or `^self`).
private bool se_recv(^World w, u32 m):
    syntax.Ast ma = w.p.files[w.decls[m].file].a
    []u32 ks = ma.list(ma.b[w.decls[m].node])
    return #len(ks) > 3 && ks[3] != NONE

// The promoted method `sym` of class `ci` or a parent: the method, the type
// declaring it and its slots' place among the class's fields; `owner` the
// class embedding it, `ek` the embedding.
u32 se_promoted(^World w, u32 ci, u32 sym, ^u32 mt, ^i64 first, ^bool full, ^u32 owner):
    if ci == NONE: return NONE
    ref []SField fl = s_fields_of(w, ci)
    u32 cc = ci
    for _ in 0..<64:
        if cc == NONE: break
        SClass c = w.classes[cc]
        for k in 0..<#len(c.embs):
            if c.embs[k].ty == NONE: continue
            i64 off = 0
            u32 dt = NONE
            u32 m = se_find(w, c.embs[k].ty, sym, &off, &dt)
            if m == NONE: continue
            i64 at = -1
            for p in 0..<#len(fl):
                if at < 0 && fl[p].cls == cc && fl[p].emb == k: at = p
            bool all = at >= 0
            for j in 0..<#len(c.embs[k].live):
                if !c.embs[k].live[j]: all = false
            mt^ = dt
            first^ = at + off
            full^ = all
            owner^ = cc
            return m
        cc = s_parent(w, cc)
    return NONE

// ERR0536's help when a promoted method has the name a trait asks.
string8 se_answers(^World w, u32 ci, u32 sym):
    u32 mt = NONE
    i64 first = 0
    bool full = false
    u32 owner = NONE
    u32 m = se_promoted(w, ci, sym, &mt, &first, &full, &owner)
    if m == NONE: return ""
    string8 nm = name_of(w, sym)
    return index.hold(#format("`", nm, "` is a method of `", name_of(w, w.decls[w.decls[m].block].name), "`, which the class embeds, and embedding takes on no trait: write `", nm, "` in the class, calling the embedded one"))

// A promoted method called (`cn` its name's node), on `self` when `base` is
// NONE: the Dado method with a copy of the slots.
Val se_call(^World w, ^Body b, u32 n, u32 cn, u32 m, u32 mt, i64 first, bool full, u32 owner, u32 base, u32 bty):
    string8 mn = name_of(w, w.decls[m].name)
    string8 en = name_of(w, w.decls[w.decls[m].block].name)
    string8 on = name_of(w, w.decls[w.classes[owner].decl].name)
    if m in w.dflt_using:
        err_tok(w, b, cn, 1, index.hold(#format("calling `", mn, "`, which a trait's default gives `", en, "` and `", en, "` does not write, on the type `", on, "` embeds, is DadoScript that is not built yet")), index.hold(#format("write `", mn, "` in `", en, "`'s body, or call it from a Dado function of the package that the script calls")))
        return bad()
    syntax.Ast ma = w.p.files[w.decls[m].file].a
    u32 rc = ma.list(ma.b[w.decls[m].node])[3]
    if ma.a[rc] == 1:
        err_tok(w, b, cn, 606, index.hold(#format("`", mn, "` takes `^self`, and `", on, "` embeds `", en, "` by making its slots fields, so there is no `", en, "` inside a `", on, "` for `^self` to point at")), index.hold(#format("write the change in a method of `", on, "` and store the member whole, `", en, " = …`")))
        return bad()
    Val rv = se_read(w, b, cn, mt, first, full, base, bty)
    if rv.ty == NONE: return bad()
    return s_dado_call(w, b, n, m, spill(w, b, rv, cn))

// Each promoted method's name a set: `ty`'s own (with a receiver) and those
// of the types it embeds.
private void se_names(^World w, u32 ty, ^ref []u32 out, ^ref []u32 from):
    if !(ty in w.type_decl): return
    try u32 td = w.type_decl[ty] else: return
    for d in 0..<#len(w.decls):
        if w.decls[d].kind != K_METHOD || w.decls[d].block != td || !se_recv(w, u32(d)): continue
        if se_has(out^[:], w.decls[d].name): continue
        out^ = #append(out^, w.decls[d].name)
        from^ = #append(from^, td)
    for e in w.embeds:
        if e.outer == ty: se_names(w, e.inner, out, from)

// ERR0407 for two embeddings bringing one method; ERR0534 for a class's own
// member named like a method one it or a parent embeds promotes, ERR0409 for
// one named like what a parent embeds whole.
void se_promotions(^World w):
    for ci in 0..<#len(w.classes):
        SClass c = w.classes[ci]
        u32 f = c.file
        syntax.Ast a = w.p.files[f].a
        string8 cn = name_of(w, w.decls[c.decl].name)
        ref []u32 seen
        ref []u32 seen_from
        // Said at the last type embedded, as Rust's.
        u32 last = NONE
        for e in c.embs:
            if e.ty != NONE: last = a.list(a.b[e.node])[0]
        for k in 0..<#len(c.embs):
            if c.embs[k].ty == NONE: continue
            ref []u32 ns
            ref []u32 fr
            se_names(w, c.embs[k].ty, &ns, &fr)
            u32 tn = last
            for i in 0..<#len(ns):
                for j in 0..<#len(seen):
                    if seen[j] != ns[i]: continue
                    string8 l = name_of(w, w.decls[seen_from[j]].name)
                    string8 r = name_of(w, w.decls[fr[i]].name)
                    string8 s = name_of(w, ns[i])
                    w.d.phase = diag.PH_INTERFACE
                    say(w, f, 0, a.lo[tn], a.hi[tn], 407, index.hold(#format("`", cn, "` embeds `", l, "` and `", r, "`, and both bring a method `", s, "`, so `v.", s, "()` would have two answers")), index.hold(#format("hold one of them as a named member (`", r, " inner`) so its methods are reached through it, or rename one of the two `", s, "` methods")))
            for i in 0..<#len(ns):
                if se_has(seen[:], ns[i]): continue
                seen = #append(seen, ns[i])
                seen_from = #append(seen_from, fr[i])
        u32 oc = u32(ci)
        for _ in 0..<64:
            if oc == NONE: break
            se_against(w, u32(ci), oc)
            oc = s_parent(w, oc)

// Class `ci`'s own members against what class `oc` (itself or a parent) embeds.
private void se_against(^World w, u32 ci, u32 oc):
    SClass c = w.classes[ci]
    SClass o = w.classes[oc]
    u32 f = c.file
    string8 cn = name_of(w, w.decls[c.decl].name)
    string8 own = name_of(w, w.decls[o.decl].name)
    ref []u32 ns
    ref []u32 fr
    for e in o.embs:
        if e.ty != NONE: se_names(w, e.ty, &ns, &fr)
    for i in 0..<#len(ns):
        if se_has(ns[0..<i], ns[i]): continue
        string8 s = name_of(w, ns[i])
        string8 en = name_of(w, w.decls[fr[i]].name)
        string8 whose = index.hold(#format("`", cn, "` embeds `", en, "`"))
        if oc != ci: whose = index.hold(#format("`", own, "`, which `", cn, "` extends, embeds `", en, "`"))
        u32 at = NONE
        string8 kind = "method"
        u32 m = se_method(w, ci, ns[i])
        if m != NONE: at = w.decls[m].node
        else:
            for x in c.fields:
                if at == NONE && w.p.sym(f, x) == ns[i]: at = x
            kind = "field"
        if at == NONE: continue
        string8 lo = se_lower(en)
        w.d.phase = diag.PH_INTERFACE
        say_tok(w, f, 0, at, 534, index.hold(#format(whose, ", which brings a method `", s, "`, and `", cn, "` has a ", kind, " `", s, "`; a collision is refused, never an override")), index.hold(#format("rename the ", kind, ", or hold `", en, "` in a field of its own (`", en, " ", lo, "`) so its methods are reached through it")))
    if oc == ci: return
    for e in o.embs:
        u32 ls = w.p.sym(o.file, e.node)
        string8 lb = w.p.spell(o.file, e.node)
        u32 at = NONE
        string8 kind = "method"
        u32 m = se_method(w, ci, ls)
        if m != NONE: at = w.decls[m].node
        else:
            for x in c.fields:
                if at == NONE && w.p.sym(f, x) == ls: at = x
            kind = "field"
        if at == NONE: continue
        w.d.phase = diag.PH_INTERFACE
        say_tok(w, f, 0, at, 409, index.hold(#format("`", own, "`, which `", cn, "` extends, embeds `", lb, "`, reached whole as `", lb, "`, and `", cn, "` has a ", kind, " `", lb, "`; a collision is refused, never an override")), index.hold(#format("rename the ", kind)))
