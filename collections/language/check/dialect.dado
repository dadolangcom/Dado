// The dialect pass: what each node may be written in (Dado, DadoScript,
// both), ERR1301/ERR1302 for the other dialect's, ERR0001 for DadoScript
// not built yet. A refusal stops the program before the checker. A `.dados` file and a `class` block are DadoScript.
package check

import "language:diag"
import "language:index"
import "language:syntax"
import "language:types"
import "core:strings"

type Said:
    u32 f
    u32 lo
    u32 hi
    u16 code
    string8 msg
    string8 help

type Dia:
    u32 f
    ref []bool stack
    u32 quiet
    u32 conds
    u32 bases
    u32 classes
    u32 types
    bool trefused
    bool element
    // Names in scope, each with the type node it was written with.
    ref []u64 names
    ref []Said refused
    ref []Said unbuilt

const string8 BANG_WHY = "the failable mark: `!T` is `T` and `!R(A)` is `R(A)`, because any DadoScript function may fail; the prefix `!x`, logical not, is the same in both"
const string8 UNBUILT_TYPE_HELP = "write one of the types a script holds: `int`, `float`, `bool`, `string`, `any`, `[]T`, `[N]T`, `{K: V}`, a tuple, a class, a trait, an enum, a function type, `async T`, `Error` or `Location`"
const string8 NO_SHARPS = "DadoScript has no `#` spellings — a `#` name is a compiler query or machinery Dado makes visible — so this is written in Dado"
const string8 SINKS_WHY = "a script's sinks are its host's to scope — a script's `print` writes to the `out:` the Dado call into it put in force — so a script scopes none"
// Never grown: an empty argument list.
ref []string8 NOARGS
const string8 LEN_OVER_TEXT = "a DadoScript string is UTF-16 code units, so `s.len()` would count those: the rewrite is `s.bytes().len()`, the bytes Dado's `#len` counted"

// The pass over every file: whether the program stops here.
bool dialects(^World w):
    Dia d
    for f in 0..<#len(w.p.files):
        if strings.starts_with(w.p.pkgs[w.p.files[f].pkg].key, "core:"): continue
        d.f = u32(f)
        d.quiet = 0
        d.conds = 0
        d.bases = 0
        d.types = 0
        #truncate(d.stack, 0)
        #truncate(d.names, 0)
        syntax.Ast a = w.p.files[f].a
        bool ds = a.a[a.root] == 1
        d.stack = #append(d.stack, ds)
        d.classes = 1 if ds else 0
        dl_file(w, &d)
    w.d.phase = diag.PH_DIALECT
    if #len(d.refused) > 0:
        for s in d.refused:
            say(w, s.f, 0, s.lo, s.hi, s.code, s.msg, s.help)
        return true
    for s in d.unbuilt:
        say(w, s.f, 0, s.lo, s.hi, s.code, s.msg, s.help)
    return #len(d.unbuilt) > 0

private bool dl_in_ds(^Dia d):
    return d.stack[#len(d.stack) - 1]

private syntax.Ast dl_ast(^World w, ^Dia d):
    return w.p.files[d.f].a

private string8 dl_text(^World w, ^Dia d, u32 lo, u32 hi):
    return w.p.files[d.f].src[i64(lo)..<i64(hi)]

private string8 dl_nsrc(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    return dl_text(w, d, a.lo[n], a.hi[n])

private string8 dl_tok(^World w, ^Dia d, u32 k):
    return dl_text(w, d, w.p.files[d.f].t.start[k], w.p.files[d.f].t.end[k])

private void dl_dado(^World w, ^Dia d, u32 lo, u32 hi, string8 what, string8 help):
    d.refused = #append(d.refused, Said(d.f, lo, hi, 1301, index.hold(#format("`", what, "` is Dado, not DadoScript")), help))

private void dl_dado_n(^World w, ^Dia d, u32 n, string8 what, string8 help):
    syntax.Ast a = dl_ast(w, d)
    dl_dado(w, d, a.lo[n], a.hi[n], what, help)

private void dl_dados(^World w, ^Dia d, u32 lo, u32 hi, string8 what, string8 help):
    d.refused = #append(d.refused, Said(d.f, lo, hi, 1302, index.hold(#format(what, " is DadoScript, not Dado")), help))

private void dl_unbuilt(^World w, ^Dia d, u32 lo, u32 hi, string8 what, string8 help):
    if d.quiet == 0: d.unbuilt = #append(d.unbuilt, Said(d.f, lo, hi, 1, index.hold(#format(what, " is DadoScript that is not built yet")), help))

private void dl_unbuilt_n(^World w, ^Dia d, u32 n, string8 what, string8 help):
    syntax.Ast a = dl_ast(w, d)
    dl_unbuilt(w, d, a.lo[n], a.hi[n], what, help)

private void dl_unbuilt_tok(^World w, ^Dia d, u32 n, string8 what, string8 help):
    u32 k = dl_ast(w, d).main[n]
    dl_unbuilt(w, d, w.p.files[d.f].t.start[k], w.p.files[d.f].t.end[k], what, help)

private bool dl_is_type(u8 g):
    return g >= syntax.T_NAME && g <= syntax.T_CHANNEL

private u64 dl_named(^World w, ^Dia d, u32 n, u32 ty):
    return (u64(w.p.sym(d.f, n)) << 32) | u64(ty)

private void dl_file(^World w, ^Dia d):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[a.root])
    if ks[2] != NONE:
        if dl_in_ds(d): dl_bases(w, d, a.list(a.b[ks[2]]))
        else: dl_dados(w, d, a.lo[ks[2]], a.hi[ks[2]], "a script's header", "a header opens a `.dados` file: rename the file to `.dados`, or keep it Dado and write a class block — the same line ending in `:`, with the members indented under it")
    if dl_in_ds(d) && ks[0] != NONE: dl_dado_n(w, d, ks[0], "@test", "a test is a `.dado` file of the package, since only Dado's harness runs one; move the test there")
    if dl_in_ds(d) && ks[1] != NONE: dl_dado_n(w, d, ks[1], "package", "a script's package is its directory's, which the package's `.dado` files name; delete the line")
    dl_members(w, d, ks[3..<#len(ks)])

// A class's items, its fields in scope over all of them.
private void dl_members(^World w, ^Dia d, []u32 ks):
    syntax.Ast a = dl_ast(w, d)
    i64 mark = #len(d.names)
    for n in ks:
        if n != NONE && a.tag[n] == syntax.N_VAR: d.names = #append(d.names, dl_named(w, d, n, a.list(a.b[n])[0]))
    for n in ks:
        if n != NONE && !dl_is_type(a.tag[n]): dl_item(w, d, n)
    #truncate(d.names, mark)

private void dl_bases(^World w, ^Dia d, []u32 ts):
    syntax.Ast a = dl_ast(w, d)
    d.bases += 1
    for t in ts:
        if t != NONE && dl_is_type(a.tag[t]): dl_ty(w, d, t)
    d.bases -= 1

private void dl_quietly(^Dia d, bool r, i64 by):
    if r: d.quiet = u32(i64(d.quiet) + by)

private void dl_item(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    u8 g = a.tag[n]
    if g == syntax.N_FN:
        bool r = dl_in_ds(d) && dl_method_not_built(w, d, n)
        dl_quietly(d, r, 1)
        dl_fn_decl(w, d, n)
        dl_quietly(d, r, -1)
    else if g == syntax.N_TYPE: dl_type_decl(w, d, n)
    else if g == syntax.N_TRAIT: dl_trait_decl(w, d, n)
    else if g == syntax.N_CONST:
        bool r = dl_in_ds(d)
        if r: dl_unbuilt_n(w, d, n, "a `const` in a class", "write it as a field — `int max_hp = 10`")
        dl_quietly(d, r, 1)
        dl_const_decl(w, d, n)
        dl_quietly(d, r, -1)
    else if g == syntax.N_VAR: dl_var_decl(w, d, n)
    else if g == syntax.N_SIGNAL: dl_params(w, d, a.list(a.b[n]))
    else if g == syntax.N_ENUM: dl_enum_decl(w, d, n)
    else if g == syntax.N_UNION: dl_union_decl(w, d, n)
    else if g == syntax.N_FOREIGN: dl_foreign(w, d, n)
    else if g == syntax.N_WHEN:
        for arm in a.list(a.b[n]):
            if arm == NONE: continue
            []u32 ks = a.list(a.b[arm])
            if a.tag[arm] == syntax.N_WHEN_ELSE:
                for k in ks:
                    if k != NONE: dl_item(w, d, k)
                continue
            d.conds += 1
            dl_expr(w, d, ks[0])
            d.conds -= 1
            for k in ks[1..<#len(ks)]:
                if k != NONE: dl_item(w, d, k)
    else if g == syntax.N_STATIC_ASSERT:
        if dl_in_ds(d): dl_dado_n(w, d, n, "#static_assert", "a compiler-folded build invariant is a compiler query; assert it at run time with `assert cond, \"message\"`, or keep the invariant in Dado")
        else:
            dl_expr(w, d, a.a[n])
            dl_expr(w, d, a.b[n])
    else if g == syntax.N_ASSERT_RAISES:
        if dl_in_ds(d): dl_dado_n(w, d, n, "#assert_raises", "a script's functions are script already; the promise that a Dado function raises into one is written in the Dado package that declares it")
    else if g == syntax.N_CLASS:
        d.classes += 1
        bool r = d.classes > 2 && dl_in_ds(d)
        if r: dl_unbuilt_tok(w, d, n, "a class inside an inner class", "inner classes go one level deep: write it beside the inner class, in the outer one")
        dl_quietly(d, r, 1)
        d.stack = #append(d.stack, true)
        []u32 ks = a.list(a.b[n])
        dl_bases(w, d, ks)
        dl_members(w, d, ks)
        #truncate(d.stack, #len(d.stack) - 1)
        dl_quietly(d, r, -1)
        d.classes -= 1

private void dl_trait_decl(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[n])
    bool generic = false
    if dl_in_ds(d):
        for k in ks:
            if k != NONE && a.tag[k] == syntax.N_BINDER:
                dl_unbuilt_n(w, d, k, "a generic trait", "write the trait over the types it takes")
                generic = true
                break
    dl_quietly(d, generic, 1)
    dl_visibility(w, d, n, "a trait")
    dl_bases(w, d, ks)
    for m in ks:
        if m == NONE || a.tag[m] != syntax.N_FN: continue
        u32 dq = NONE
        if dl_in_ds(d):
            []u32 ms = a.list(a.b[m])
            for q in ms[6..<#len(ms)]:
                if q != NONE && a.b[q] != NONE:
                    dq = q
                    break
        if dq != NONE: dl_unbuilt_n(w, d, dq, "a default argument in a trait method", "pass every argument; an implementer's own method may still take a default")
        dl_quietly(d, dq != NONE, 1)
        dl_fn_decl(w, d, m)
        dl_quietly(d, dq != NONE, -1)
    dl_quietly(d, generic, -1)

private bool dl_tdecl_unbuilt(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[n])
    for k in ks[3..<#len(ks)]:
        if k != NONE && a.tag[k] == syntax.N_BINDER:
            dl_unbuilt_n(w, d, k, "a generic type", "write the type over the types it holds")
            return true
    if ks[1] != NONE:
        dl_unbuilt_n(w, d, ks[1], "a `where` clause on a type", "write the type over the types it holds")
        return true
    for k in ks[3..<#len(ks)]:
        if k != NONE && dl_is_type(a.tag[k]):
            dl_unbuilt_n(w, d, k, "a type taking on a trait", "a script's type is data: take the trait on in a class, which may hold the value as a field")
            return true
    for k in ks[3..<#len(ks)]:
        if k != NONE && a.tag[k] == syntax.N_FN:
            dl_unbuilt_tok(w, d, k, "a method on a type", "a script's type is data, and behaviour written in a script lives in classes: write it as a method of the class, taking the value as a parameter")
            return true
    return false

// Whether the signature binds a type (`$T`), and the first `[$N]` it binds.
private bool dl_binds(^World w, ^Dia d, u32 t, ^u32 arity):
    syntax.Ast a = dl_ast(w, d)
    if t == NONE: return false
    u8 g = a.tag[t]
    if g == syntax.T_ARRAY && a.main[t] != NONE && arity^ == NONE: arity^ = t
    if g == syntax.T_BINDING: return true
    ref []u32 ks
    a.kids(t, &ks)
    bool any = false
    for k in ks:
        if dl_is_type(a.tag[k]) && dl_binds(w, d, k, arity): any = true
    return any

private bool dl_method_not_built(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[n])
    u32 arity = NONE
    bool typed = false
    for q in ks[6..<#len(ks)]:
        if q != NONE && dl_binds(w, d, a.a[q], &arity): typed = true
    if dl_binds(w, d, ks[0], &arity): typed = true
    if arity != NONE:
        u32 k = a.main[arity]
        dl_unbuilt(w, d, w.p.files[d.f].t.start[k] - 1, w.p.files[d.f].t.end[k], index.hold(#format("`$", dl_tok(w, d, k), "` binds an array's length, and DadoScript has no fixed-length array: `[]T` is the one sequence type")), "take a `[]T` and ask its `len()`")
        return true
    if typed: return false
    if ks[4] != NONE:
        dl_unbuilt_n(w, d, ks[4], "a `where` clause", "write the method over the types it takes")
        return true
    for q in ks[6..<#len(ks)]:
        if q != NONE && a.tag[q] == syntax.N_PARAM_V:
            dl_unbuilt_n(w, d, q, "a variadic parameter", "take the values one by one")
            return true
    return false

private void dl_visibility(^World w, ^Dia d, u32 n, string8 kind):
    syntax.Ast a = dl_ast(w, d)
    if !dl_in_ds(d) || #len(kind) == 0 || (a.a[n] & syntax.F_VIS) != syntax.VIS_EXPORT: return
    u32 lo = a.lo[n]
    u32 hi = a.hi[n]
    if lo + 6 <= hi && dl_text(w, d, lo, lo + 6) == "export": hi = lo + 6
    d.refused = #append(d.refused, Said(d.f, lo, hi, 1301, index.hold(#format("`export` on ", kind, " publishes nothing in DadoScript: a script's `export` publishes a class, a method or a field to a JavaScript caller, and what their signatures name is published with them")), "write `public`, or nothing, which means the same inside Dado and DadoScript"))

// The `!` before a return type.
private void dl_bang(^World w, ^Dia d, u32 lo, u32 ret):
    syntax.Ast a = dl_ast(w, d)
    u32 at = lo
    u32 end = lo + 1
    if ret != NONE: end = a.lo[ret]
    for i in lo..<end:
        if w.p.files[d.f].src[i64(i)] == '!': at = i
    string8 r = dl_dados_type(w, d, ret)
    if #len(r) == 0: r = "T"
    dl_dado(w, d, at, at + 1, "!", index.hold(#format("in DadoScript write `", r, "`: ", BANG_WHY)))

private void dl_fn_decl(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[n])
    if dl_in_ds(d):
        if (a.a[n] & syntax.F_FAILABLE) != 0: dl_bang(w, d, a.lo[n], ks[0])
        if ks[2] != NONE: dl_dado_n(w, d, ks[2], "@symbol", "a symbol attribute tells the C compiler about an emitted function, and a script emits no C; delete it")
        if ks[3] != NONE && a.a[ks[3]] == 1: dl_dado_n(w, d, ks[3], "^self", "a DadoScript object is held by reference, so a method writes it through `self`; write `self`")
    else if (a.a[n] & syntax.F_ASYNC) != 0:
        dl_dados(w, d, a.lo[n], a.lo[n] + 5, "`async`", "Dado has no async: drop `async` and call the function where it is needed, or declare it in a `class` block or a `.dados` file, where a function may wait")
    dl_ty(w, d, ks[0])
    i64 mark = #len(d.names)
    dl_params(w, d, ks[6..<#len(ks)])
    if ks[4] != NONE:
        d.conds += 1
        dl_expr(w, d, a.a[ks[4]])
        d.conds -= 1
    dl_block(w, d, ks[5])
    #truncate(d.names, mark)

private void dl_params(^World w, ^Dia d, []u32 qs):
    syntax.Ast a = dl_ast(w, d)
    u32 last = NONE
    for q in qs:
        if q == NONE: continue
        u32 t = a.a[q]
        if t != NONE:
            if a.tag[t] != syntax.T_KIND: dl_ty(w, d, t)
            last = t
        if last != NONE: d.names = #append(d.names, dl_named(w, d, q, last))
        if a.b[q] != NONE: dl_expr(w, d, a.b[q])

private void dl_type_decl(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[n])
    dl_visibility(w, d, n, "a type")
    for k in ks[3..<#len(ks)]:
        if k != NONE && a.tag[k] == syntax.N_ASSERT_RAISES && dl_in_ds(d): dl_dado_n(w, d, k, "#assert_raises", "a script's functions are script already; the promise that a Dado function raises into one is written in the Dado package that declares it")
    if dl_in_ds(d):
        if (a.a[n] & syntax.F_CONTRACT) != 0: dl_dado(w, d, w.p.files[d.f].t.start[a.main[n]], w.p.files[d.f].t.end[a.main[n]], "contract", "a contract is a compile-time value Dado erases, and DadoScript has none; declare a `type` or a `trait`")
        if ks[0] != NONE: dl_c_name(w, d, ks[0])
        if (a.a[n] & syntax.F_DISTINCT) != 0:
            u32 lo = a.lo[n]
            u32 hi = lo + 8
            if dl_text(w, d, lo, hi) != "distinct":
                lo = w.p.files[d.f].t.start[a.main[n]]
                hi = w.p.files[d.f].t.end[a.main[n]]
            dl_dado(w, d, lo, hi, "distinct", index.hold(#format("a script's `type` is a value with no identity, and `distinct` gives one; write `type ", w.p.spell(d.f, n), ":`, or a class where the value needs an identity")))
        if dl_tdecl_unbuilt(w, d, n): return
    for k in ks[3..<#len(ks)]:
        if k != NONE && dl_is_type(a.tag[k]): dl_ty(w, d, k)
    if ks[1] != NONE: dl_expr(w, d, a.a[ks[1]])
    dl_body_of(w, d, ks[2])
    for k in ks[3..<#len(ks)]:
        if k != NONE && a.tag[k] == syntax.N_FN: dl_fn_decl(w, d, k)

private void dl_body_of(^World w, ^Dia d, u32 b):
    syntax.Ast a = dl_ast(w, d)
    if b == NONE: return
    if a.tag[b] == syntax.N_MEMBERS: dl_member_list(w, d, a.list(a.b[b]))
    else if a.tag[b] == syntax.N_ALIAS: dl_ty(w, d, a.a[b])
    else: dl_ty(w, d, b)

private void dl_c_name(^World w, ^Dia d, u32 c):
    dl_dado_n(w, d, c, "@c", "a C name says what the header calls a declaration, and a script writes no C; delete it")

private void dl_const_decl(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[n])
    dl_visibility(w, d, n, "a constant")
    if (a.a[n] & syntax.F_BUILD) != 0 && dl_in_ds(d): dl_dado_n(w, d, n, "@const", "a build constant is one a `-D` replaces when the C is built, and a script is not built by a C compiler; write `const`")
    dl_ty(w, d, ks[0])
    dl_expr(w, d, ks[1])

private void dl_var_decl(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[n])
    if dl_in_ds(d):
        if ks[2] != NONE: dl_align(w, d, ks[2])
        if ks[3] != NONE: dl_c_body(w, d, ks[3])
        if ks[4] != NONE: dl_dado_n(w, d, ks[4], "@thread_local", "a thread-local is a thread primitive, and a script has no threads; delete it")
    dl_ty(w, d, ks[0])
    dl_expr(w, d, ks[1])

private void dl_align(^World w, ^Dia d, u32 n):
    dl_dado_n(w, d, n, "@align", "an alignment places storage, and the DadoScript runtime owns storage; delete it")

private void dl_c_body(^World w, ^Dia d, u32 n):
    dl_dado_n(w, d, n, "@c_body", "verbatim C is the C boundary's, and a script emits no C; write it in a `.dado` file of the package and call it")

private void dl_enum_decl(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[n])
    dl_visibility(w, d, n, "an enum")
    if ks[0] != NONE && dl_in_ds(d):
        string8 bk = dl_nsrc(w, d, ks[0])
        dl_dado_n(w, d, ks[0], index.hold(#format("enum ", bk)), index.hold(#format("a backing type is a width, and DadoScript writes no width; write `enum ", w.p.spell(d.f, n), ":`")))
    else if ks[0] != NONE: dl_ty(w, d, ks[0])
    u32 valued = NONE
    if dl_in_ds(d):
        for m in ks[1..<#len(ks)]:
            if m != NONE && a.a[m] != NONE:
                valued = m
                break
    if valued != NONE: dl_unbuilt_n(w, d, valued, "a value written for an enum member", index.hold(#format("leave `= …` off `", w.p.spell(d.f, valued), "`: a script's enum members are names, and each prints as its name")))
    dl_quietly(d, valued != NONE, 1)
    for m in ks[1..<#len(ks)]:
        if m != NONE && a.a[m] != NONE: dl_expr(w, d, a.a[m])
    dl_quietly(d, valued != NONE, -1)

private void dl_union_decl(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[n])
    dl_visibility(w, d, n, "a union")
    if dl_in_ds(d):
        if (a.a[n] & syntax.F_RAW) != 0:
            u32 k = a.main[n]
            dl_dado(w, d, w.p.files[d.f].t.start[k], w.p.files[d.f].t.end[k], "cunion", index.hold(#format("C's untagged union is the C boundary's, and reading one needs a tag C never sent; write `union ", w.p.spell(d.f, n), ":`, which carries its tag")))
            return
        if ks[0] != NONE: dl_c_name(w, d, ks[0])
    dl_member_list(w, d, ks[1..<#len(ks)])

private void dl_member_list(^World w, ^Dia d, []u32 ms):
    syntax.Ast a = dl_ast(w, d)
    for m in ms:
        if m == NONE: continue
        if a.tag[m] != syntax.N_MEMBER:
            dl_ty(w, d, m)
            continue
        []u32 ks = a.list(a.b[m])
        if dl_in_ds(d):
            if ks[1] != NONE: dl_c_name(w, d, ks[1])
            if ks[2] != NONE: dl_dado_n(w, d, ks[2], index.hold(#format(": ", dl_nsrc(w, d, a.a[ks[2]]))), "a bitfield width is C's layout, and the DadoScript runtime owns layout; delete the width")
            if ks[3] != NONE: dl_align(w, d, ks[3])
        dl_ty(w, d, ks[0])

private bool dl_js_path(string8 h):
    return strings.ends_with(h, ".js\"") || strings.ends_with(h, ".mjs\"")

private void dl_foreign(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    dl_visibility(w, d, n, "a `foreign` block")
    string8 h = w.p.spell(d.f, n)
    bool js = dl_js_path(h)
    u32 k = a.main[n]
    u32 hlo = w.p.files[d.f].t.start[k]
    u32 hhi = w.p.files[d.f].t.end[k]
    if dl_in_ds(d) && !js:
        dl_dado(w, d, hlo, hhi, index.hold(#format("foreign ", h, ":")), "a script calls C through Dado: declare the block in a `.dado` file of the package and call its functions from here; a DadoScript `foreign` block names a `.js` file")
        return
    if !dl_in_ds(d) && js:
        dl_dados(w, d, hlo, hhi, index.hold(#format("`foreign ", h, ":`")), "a Dado `foreign` block declares C from a header: name a `.h` file, or move the block into a `.dados` file or a `class` block, where `foreign \"x.js\":` declares JavaScript")
        return
    for m in a.list(a.b[n]):
        if m == NONE: continue
        u8 g = a.tag[m]
        if js && g == syntax.N_CLAUSE:
            u32 wk = a.main[m]
            dl_dado(w, d, w.p.files[d.f].t.start[wk], w.p.files[d.f].t.end[wk], dl_tok(w, d, wk), "a clause asks something of the C build, and a `.js` file is not compiled by it; delete it")
        else if g == syntax.N_F_FN: dl_foreign_fn(w, d, m, js)
        else if js && g == syntax.N_F_OPAQUE: dl_foreign_item(w, d, m, "opaque type")
        else if js && g == syntax.N_F_CONST: dl_foreign_item(w, d, m, "constant")
        else if js && g == syntax.N_F_VAR: dl_foreign_item(w, d, m, "variable")
        else if js && g == syntax.N_F_ENUM: dl_foreign_item(w, d, m, "enum")
        else if js && g == syntax.N_TYPE: dl_foreign_item(w, d, m, "type")
        else if js && g == syntax.N_UNION: dl_foreign_item(w, d, m, "union")
        else if g == syntax.N_F_CONST || g == syntax.N_F_VAR: dl_ty(w, d, a.a[m])
        else if g == syntax.N_TYPE: dl_type_decl(w, d, m)
        else if g == syntax.N_UNION: dl_union_decl(w, d, m)

private void dl_foreign_item(^World w, ^Dia d, u32 m, string8 what):
    dl_dado_n(w, d, m, index.hold(#format("foreign ", what)), index.hold(#format("a `foreign` ", what, " restates the C boundary, and a `foreign \"x.js\":` block declares JavaScript functions alone: a JavaScript value of any other kind is an `any`, so declare the functions that take or answer one with `any`; a C ", what, " is declared in a `.dado` file of the package")))

private void dl_foreign_fn(^World w, ^Dia d, u32 m, bool js):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[m])
    dl_visibility(w, d, m, "a `foreign` declaration")
    if js:
        if ks[2] != NONE: dl_c_name(w, d, ks[2])
        if (a.a[m] & syntax.F_MACRO) != 0: dl_dado(w, d, a.lo[m], a.lo[m] + 6, "@macro", "a claim that a C header spells the function as a macro, and a `.js` file has none; delete it")
        if (a.a[m] & syntax.F_FAILABLE) != 0: dl_bang(w, d, a.lo[m], ks[0])
        if (a.a[m] & syntax.F_CVAR) != 0: dl_dado(w, d, a.hi[m] - 4, a.hi[m] - 1, "...", "C's `...` is C's calling convention; a JavaScript function taking any number of arguments is declared `..any xs`")
    dl_ty(w, d, ks[0])
    i64 mark = #len(d.names)
    dl_params(w, d, ks[3..<#len(ks)])
    #truncate(d.names, mark)

// -- types

private void dl_ty(^World w, ^Dia d, u32 t):
    if t == NONE: return
    bool el = d.element
    d.element = false
    if d.types == 0: d.trefused = false
    bool r = dl_in_ds(d) && d.bases == 0 && !d.trefused && dl_type_not_built(w, d, t, el)
    if r: d.trefused = true
    d.types += 1
    dl_quietly(d, r, 1)
    dl_type_parts(w, d, t)
    dl_quietly(d, r, -1)
    d.types -= 1

private bool dl_type_not_built(^World w, ^Dia d, u32 t, bool el):
    syntax.Ast a = dl_ast(w, d)
    u8 g = a.tag[t]
    if g == syntax.T_MATRIX || g == syntax.T_KIND:
        dl_unbuilt_n(w, d, t, "a type written this way", UNBUILT_TYPE_HELP)
        return true
    if g == syntax.T_NAME:
        string8 s = w.p.spell(d.f, t)
        if s == "byte" && !el: dl_unbuilt_n(w, d, t, "`byte` on its own, outside `[]byte`,", "hold one byte in an `int`, and bytes in a `[]byte`")
        else if s == "Script": dl_unbuilt_n(w, d, t, "the type `Script`, any script,", "name the class a value is — `Goblin`, `npc.Goblin` — which extends `Script` already")
        else if s == "Platform": dl_unbuilt_n(w, d, t, "the type `Platform`", "use `int`, `float`, `bool` or `string`")
        else: return false
        return true
    []u32 ms = a.list(NONE)
    if g == syntax.T_TUPLE: ms = a.list(a.b[t])
    if g == syntax.T_TUPLE && a.a[t] != 1 && #len(ms) == 0:
        dl_unbuilt_n(w, d, t, "this shape", "write a tuple of one or more types: `(int, string)`")
        return true
    return false

private void dl_type_parts(^World w, ^Dia d, u32 t):
    syntax.Ast a = dl_ast(w, d)
    u8 g = a.tag[t]
    bool ds = dl_in_ds(d)
    if g == syntax.T_NAME:
        if ds: dl_type_name(w, d, a.lo[t], a.hi[t], w.p.spell(d.f, t))
    else if g == syntax.T_PATH:
        string8 pk = dl_tok(w, d, a.a[t])
        if ds && strings.starts_with(pk, "#"): dl_type_name(w, d, a.lo[t], a.hi[t], index.hold(#format(pk, ".", w.p.spell(d.f, t))))
    else if g == syntax.T_POINTER:
        if ds:
            string8 inner = dl_dados_type(w, d, a.a[t])
            if #len(inner) > 0: dl_dado_n(w, d, t, "^", index.hold(#format("a script never holds an address — an object or a container is already held by reference; write `", inner, "`")))
            else: dl_dado_n(w, d, t, "^", "a script never holds an address; an object or a container is already held by reference")
        else: dl_ty(w, d, a.a[t])
    else if g == syntax.T_REF:
        if ds:
            string8 inner = dl_dados_type(w, d, a.a[t])
            if #len(inner) > 0: dl_dado_n(w, d, t, "ref", index.hold(#format("the DadoScript runtime owns memory, so nothing is held through a reference it hands out; write `", inner, "`")))
            else: dl_dado_n(w, d, t, "ref", "the DadoScript runtime owns memory, so nothing is held through a reference it hands out")
        else: dl_ty(w, d, a.a[t])
    else if g == syntax.T_SLICE:
        d.element = true
        dl_ty(w, d, a.a[t])
    else if g == syntax.T_ARRAY:
        dl_expr(w, d, a.a[t])
        dl_ty(w, d, a.b[t])
    else if g == syntax.T_MATRIX:
        []u32 ks = a.list(a.b[t])
        dl_expr(w, d, ks[0])
        dl_expr(w, d, ks[1])
        dl_ty(w, d, ks[2])
    else if g == syntax.T_SHAPEOF:
        if ds: dl_dado_n(w, d, t, "shapeof", "a shape query asks about representation, which the DadoScript runtime owns; name the type instead")
        else: dl_expr(w, d, a.a[t])
    else if g == syntax.T_MAP:
        dl_ty(w, d, a.a[t])
        dl_ty(w, d, a.b[t])
    else if g == syntax.T_TUPLE:
        if a.a[t] == 1 && ds:
            dl_dado_n(w, d, t, "union (…)", "C's anonymous union is the C boundary's; declare a `union` with a name, which carries its tag")
            return
        dl_member_list(w, d, a.list(a.b[t]))
    else if g == syntax.T_FN:
        []u32 ks = a.list(a.b[t])
        if ds && (a.a[t] & syntax.F_FAILABLE) != 0:
            string8 plain = dl_dados_type(w, d, t)
            if #len(plain) == 0: plain = "R(A)"
            dl_dado_n(w, d, t, "!", index.hold(#format("in DadoScript write `", plain, "`: ", BANG_WHY)))
            return
        if !ds && (a.a[t] & syntax.F_ASYNC) != 0:
            dl_dados(w, d, a.lo[t], a.lo[t] + 5, "`async`", "Dado has no async, so no function reference waits: drop `async` from the type")
            return
        dl_ty(w, d, ks[0])
        for k in ks[2..<#len(ks)]:
            dl_ty(w, d, k)
    else if g == syntax.T_BOUND:
        if ds: dl_dado_n(w, d, t, "$", "a category binder is Dado's spelling for a generic number; in DadoScript write `int` or `float`")
    else if g == syntax.T_LAYOUT:
        string8 l = w.p.spell(d.f, t)
        if ds: dl_dado_n(w, d, t, l, table_help(w, l, NOARGS[:]))
        else: dl_ty(w, d, a.a[t])
    else if g == syntax.T_QUAL:
        string8 q = w.p.spell(d.f, t)
        if q == "async":
            if ds: dl_ty(w, d, a.a[t])
            else:
                u32 k = a.main[t]
                dl_dados(w, d, w.p.files[d.f].t.start[k], w.p.files[d.f].t.end[k], "`async`", "Dado has no async, so no value waits to be awaited: call the function directly and hold what it returns")
        else if ds:
            string8 inner = dl_dados_type(w, d, a.a[t])
            if #len(inner) > 0: dl_dado_n(w, d, t, q, index.hold(#format("a C qualifier is the C boundary's, which a script never writes; write `", inner, "`")))
            else: dl_dado_n(w, d, t, q, "a C qualifier is the C boundary's, which a script never writes")
        else: dl_ty(w, d, a.a[t])
    else if g == syntax.T_PACK:
        if ds:
            string8 mk = w.p.spell(d.f, t)
            dl_dado_n(w, d, t, index.hold(#format("..", mk)), table_help(w, mk, NOARGS[:]))
    else if g == syntax.T_CHANNEL:
        if ds: dl_dado(w, d, a.lo[t], a.lo[t] + 8, "#channel", NO_CHANNEL)
        else:
            []u32 ks = a.list(a.b[t])
            dl_params(w, d, ks[1..<#len(ks)])

// A type name's row: a width, a `#c` scalar, `string8`, `cstring`, …
private void dl_type_name(^World w, ^Dia d, u32 lo, u32 hi, string8 s):
    u8 k = 0
    string8 sp = ""
    string8 why = ""
    if !spelling(s, &k, &sp, &why): return
    if k == DS_SPELLED: dl_dado(w, d, lo, hi, s, index.hold(#format("in DadoScript write `", sp, "`: ", why)))
    else if k == DS_ABSENT: dl_dado(w, d, lo, hi, s, index.hold(#format("not in DadoScript: ", why)))

// -- statements

private void dl_block(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    if n == NONE: return
    if a.tag[n] != syntax.S_BLOCK:
        dl_stmt(w, d, n)
        return
    i64 mark = #len(d.names)
    for s in a.list(a.b[n]):
        if s != NONE: dl_stmt(w, d, s)
    #truncate(d.names, mark)

private void dl_stmt(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    u8 g = a.tag[n]
    bool ds = dl_in_ds(d)
    if g == syntax.S_BLOCK: dl_block(w, d, n)
    else if g == syntax.S_RETURN: dl_expr(w, d, a.a[n])
    else if g == syntax.S_VIEW:
        if ds: dl_unbuilt_n(w, d, n, "a `view`", "name the values as locals")
    else if g == syntax.S_FALLTHROUGH:
        if ds: dl_unbuilt_n(w, d, n, "`fallthrough`", "write an `if`/`else` chain")
    else if g == syntax.S_FOR: dl_for_(w, d, n)
    else if g == syntax.S_IF:
        []u32 ks = a.list(a.b[n])
        dl_expr(w, d, ks[0])
        dl_block(w, d, ks[1])
        dl_block(w, d, ks[2])
    else if g == syntax.S_SWITCH:
        []u32 ks = a.list(a.b[n])
        dl_expr(w, d, ks[0])
        for c in ks[2..<#len(ks)]:
            if c == NONE: continue
            []u32 cs = a.list(a.b[c])
            for v in cs[1..<#len(cs)]:
                dl_expr(w, d, v)
            dl_block(w, d, cs[0])
        dl_block(w, d, ks[1])
    else if g == syntax.S_DEFER:
        if a.main[n] != NONE && ds:
            u32 k = a.main[n]
            dl_dado(w, d, w.p.files[d.f].t.start[k], w.p.files[d.f].t.end[k], "defer!", "in DadoScript write `defer`: Dado's `defer!` passes a cleanup's failure on at the exit; in DadoScript any call may fail and propagation is unmarked, so a `defer` over a failing call does that")
        dl_stmt(w, d, a.a[n])
    else if g == syntax.S_QUIT:
        if ds: dl_dado_n(w, d, n, "quit", "a script never ends the process that hosts it; `return` from the function, or `fail` to raise an `Error` a caller may catch")
        else: dl_expr(w, d, a.a[n])
    else if g == syntax.S_LET:
        []u32 ks = a.list(a.b[n])
        if ks[2] != NONE && ds: dl_c_body(w, d, ks[2])
        if ks[0] != NONE && a.tag[ks[0]] == syntax.T_KIND:
            if ks[1] != NONE && a.tag[ks[1]] == syntax.E_TYPE: dl_ty(w, d, a.a[ks[1]])
            else: dl_expr(w, d, ks[1])
        else:
            dl_ty(w, d, ks[0])
            dl_expr(w, d, ks[1])
        if a.main[n] != NONE && ks[0] != NONE: d.names = #append(d.names, dl_named(w, d, n, ks[0]))
    else if g == syntax.N_CONST:
        bool r = ds
        if r: dl_unbuilt_n(w, d, n, "a `const` in a method", "declare a local: `int max = 10`")
        dl_quietly(d, r, 1)
        dl_const_decl(w, d, n)
        dl_quietly(d, r, -1)
    else if g == syntax.S_ASSIGN:
        []u32 ks = a.list(a.b[n])
        if a.a[n] != NONE && ds: dl_marker(w, d, a.a[n])
        dl_expr(w, d, ks[0])
        dl_expr(w, d, ks[1])
    else if g == syntax.S_EXPR: dl_expr(w, d, a.a[n])
    else if g == syntax.S_WHEN:
        for arm in a.list(a.b[n]):
            if arm == NONE: continue
            if a.tag[arm] != syntax.S_WHEN_ARM:
                dl_block(w, d, arm)
                continue
            d.conds += 1
            dl_expr(w, d, a.a[arm])
            d.conds -= 1
            dl_block(w, d, a.b[arm])
    else if g == syntax.S_SUITE:
        if ds:
            u32 k = a.main[n]
            u32 h = a.a[n]
            string8 word = dl_tok(w, d, k)
            string8 subj = dl_nsrc(w, d, h)
            dl_dado(w, d, w.p.files[d.f].t.start[k], a.hi[h], index.hold(#format(word, " ", subj, ":")), index.hold(#format(dl_using_why(w, d, h), "; write the suite's statements without it")))
            return
        dl_expr(w, d, a.a[n])
        dl_block(w, d, a.b[n])
    else if g == syntax.S_FAIL: dl_expr(w, d, a.a[n])
    else if g == syntax.S_TRY:
        dl_stmt(w, d, a.a[n])
        u32 e = a.b[n]
        if e != NONE:
            if a.b[e] == 1: dl_expr(w, d, a.a[e])
            else: dl_block(w, d, a.a[e])
    else if g == syntax.S_AWAIT:
        if !ds:
            dl_dados(w, d, a.lo[n], a.hi[n], "`await`", index.hold(#format("Dado has no async: call the function directly — `", dl_nsrc(w, d, a.a[n]), "` — or move this function into a `class` block or a `.dados` file, where it may wait")))
            return
        dl_stmt(w, d, a.a[n])
    else if g == syntax.S_ASSERT:
        if !ds:
            string8 c = dl_nsrc(w, d, a.a[n])
            string8 sp = index.hold(#format("#assert(", c, ")"))
            if a.b[n] != NONE: sp = index.hold(#format("#assert(", c, ", ", dl_nsrc(w, d, a.b[n]), ")"))
            dl_dados(w, d, a.lo[n], a.hi[n], "`assert`", index.hold(#format("Dado asserts with the `#` verb, which reports and aborts where the condition is false; write `", sp, "`")))
            return
        dl_expr(w, d, a.a[n])
        dl_expr(w, d, a.b[n])

private void dl_for_(^World w, ^Dia d, u32 n):
    syntax.Ast a = dl_ast(w, d)
    u32 h = a.a[n]
    i64 mark = #len(d.names)
    if h != NONE && a.tag[h] == syntax.S_FOR_IN:
        []u32 ks = a.list(a.b[h])
        u32 it = ks[#len(ks) - 1]
        bool counted = dl_in_ds(d) && it != NONE && a.tag[it] == syntax.E_RANGE
        bool r = counted && #len(ks) > 2
        if r: dl_unbuilt_n(w, d, n, "a `for … in` over a range binding more than its count", "count with one name: `for i in 0..<n:`")
        dl_quietly(d, r, 1)
        if dl_in_ds(d):
            for bn in ks[0..<#len(ks) - 1]:
                if bn != NONE && a.a[bn] == 1:
                    string8 nm = w.p.spell(d.f, bn)
                    dl_dado(w, d, a.lo[bn] - 1, a.hi[bn], index.hold(#format("for &", nm)), index.hold(#format("a script binds each element, never its address; write `for ", nm, " in …:`, and index to write an element back: `xs[i] = …`")))
                    break
        if counted:
            dl_expr(w, d, a.a[it])
            dl_expr(w, d, a.b[it])
        else: dl_expr(w, d, it)
        dl_block(w, d, a.b[n])
        dl_quietly(d, r, -1)
    else:
        dl_expr(w, d, h)
        dl_block(w, d, a.b[n])
    #truncate(d.names, mark)

private void dl_marker(^World w, ^Dia d, u32 k):
    string8 m = dl_tok(w, d, k)
    dl_dado(w, d, w.p.files[d.f].t.start[k], w.p.files[d.f].t.end[k], m, table_help(w, m, NOARGS[:]))

private string8 dl_using_why(^World w, ^Dia d, u32 h):
    syntax.Ast a = dl_ast(w, d)
    if a.tag[h] == syntax.E_USING && a.list(a.b[h])[0] == NONE: return SINKS_WHY
    return NO_ALLOCATOR

// -- expressions

private void dl_expr(^World w, ^Dia d, u32 e):
    if e == NONE: return
    bool r = dl_in_ds(d) && d.conds == 0 && dl_expr_not_built(w, d, e)
    dl_quietly(d, r, 1)
    dl_expr_parts(w, d, e)
    dl_quietly(d, r, -1)

private bool dl_expr_not_built(^World w, ^Dia d, u32 e):
    syntax.Ast a = dl_ast(w, d)
    u8 g = a.tag[e]
    if g == syntax.E_IS || g == syntax.E_HAS: dl_unbuilt_n(w, d, e, "a type question", "the types are written, so ask nothing")
    else if g == syntax.E_NARROW: dl_unbuilt_n(w, d, e, "a union read", "hold the value in a field of its type")
    else if g == syntax.E_TYPE: dl_unbuilt_n(w, d, e, "a type as a value", "write a value of the type")
    else if g == syntax.E_RANGE: dl_unbuilt_n(w, d, e, "a range outside a `for` header", "count with `for i in a..<b:`")
    else if g == syntax.E_NAME && w.p.spell(d.f, e) == "nil": dl_unbuilt_n(w, d, e, "`nil`", "give the field or local its type's zero — `0`, `0.0`, `false`, `\"\"`")
    else if g == syntax.E_BINARY && w.p.spell(d.f, e) == "++": dl_unbuilt_n(w, d, e, "`++`", "join strings with `+`")
    else: return false
    return true

private void dl_exprs(^World w, ^Dia d, []u32 es):
    for e in es:
        dl_expr(w, d, e)

private void dl_expr_parts(^World w, ^Dia d, u32 e):
    syntax.Ast a = dl_ast(w, d)
    u8 g = a.tag[e]
    bool ds = dl_in_ds(d)
    if g == syntax.E_CHAR:
        if ds:
            string8 t = dl_nsrc(w, d, e)
            dl_dado_n(w, d, e, t, index.hold(#format("DadoScript has no character type — a character is a one-code-point `string`; write `", dl_char_as_string(t), "`")))
    else if g == syntax.E_NAME: dl_name(w, d, e)
    else if g == syntax.E_TUPLE || g == syntax.E_ARRAY || g == syntax.E_MAP: dl_exprs(w, d, a.list(a.b[e]))
    else if g == syntax.E_ENTRY || g == syntax.E_IN || g == syntax.E_BINARY || g == syntax.E_RANGE:
        dl_expr(w, d, a.a[e])
        dl_expr(w, d, a.b[e])
    else if g == syntax.E_IS:
        dl_expr(w, d, a.a[e])
        u32 t = a.b[e]
        if t != NONE && a.tag[t] == syntax.E_NAME && ds:
            _ = dl_type_not_built(w, d, t, false)
        dl_expr(w, d, t)
    else if g == syntax.E_HAS:
        []u32 ks = a.list(a.b[e])
        dl_expr(w, d, ks[0])
        if a.a[e] == 1: dl_exprs(w, d, ks[1..<#len(ks)])
    else if g == syntax.E_CALL: dl_call(w, d, e)
    else if g == syntax.E_FIELD || g == syntax.E_SPLAT || g == syntax.E_ARG: dl_expr(w, d, a.a[e])
    else if g == syntax.E_INDEX:
        if a.main[e] != NONE && ds: dl_marker(w, d, a.main[e])
        dl_expr(w, d, a.a[e])
        dl_expr(w, d, a.b[e])
    else if g == syntax.E_SLICE: dl_exprs(w, d, a.list(a.b[e]))
    else if g == syntax.E_UNARY || g == syntax.E_DEREF: dl_unary(w, d, e)
    else if g == syntax.E_TYPE: dl_ty(w, d, a.a[e])
    else if g == syntax.E_NARROW:
        dl_expr(w, d, a.a[e])
        dl_ty(w, d, a.b[e])
    else if g == syntax.E_COND: dl_exprs(w, d, a.list(a.b[e]))
    else if g == syntax.E_LAMBDA:
        if !ds:
            dl_dados(w, d, a.lo[e], a.hi[e], "a lambda", "Dado has no closures: declare a named function and pass it by name, and where it needs state, pass that state beside it as a `rawptr` the function reads (a `(proc, rawptr data)` pair)")
            return
        []u32 ks = a.list(a.b[e])
        dl_ty(w, d, ks[0])
        i64 mark = #len(d.names)
        dl_params(w, d, ks[2..<#len(ks)])
        dl_block(w, d, ks[1])
        #truncate(d.names, mark)

private void dl_name(^World w, ^Dia d, u32 n):
    string8 s = w.p.spell(d.f, n)
    syntax.Ast a = dl_ast(w, d)
    if dl_in_ds(d):
        if strings.starts_with(s, "#"): dl_dado_n(w, d, n, s, table_help(w, s, NOARGS[:]))
    else if s == "super":
        dl_dados(w, d, a.lo[n], a.hi[n], "`super`", "Dado has no inheritance, so there is no parent to name; call the function meant by its own name, or move this code into a `class` block")

private void dl_unary(^World w, ^Dia d, u32 u):
    syntax.Ast a = dl_ast(w, d)
    string8 op = "^" if a.tag[u] == syntax.E_DEREF else w.p.spell(d.f, u)
    if dl_in_ds(d) && op == "^":
        dl_dado_n(w, d, u, "^", index.hold(#format("a script never holds an address, so there is nothing to dereference; write `", dl_nsrc(w, d, a.a[u]), "`")))
    else if dl_in_ds(d) && op == "&":
        dl_dado_n(w, d, u, "&", index.hold(#format("a script never takes an address — an object or a container is passed by reference already; write `", dl_nsrc(w, d, a.a[u]), "`")))
    else: dl_expr(w, d, a.a[u])

private void dl_call(^World w, ^Dia d, u32 c):
    syntax.Ast a = dl_ast(w, d)
    []u32 ks = a.list(a.b[c])
    u32 cal = ks[0]
    if dl_in_ds(d):
        if a.tag[cal] == syntax.E_NAME && strings.starts_with(w.p.spell(d.f, cal), "#"):
            string8 s = w.p.spell(d.f, cal)
            ref []string8 args
            for g in ks[2..<#len(ks)]:
                if g != NONE: args = #append(args, dl_nsrc(w, d, a.a[g]))
            string8 help = ""
            if s == "#len":
                string8 one = "xs"
                if #len(args) > 0: one = args[0]
                u8 k = 0
                if #len(ks) > 2 && a.tag[a.a[ks[2]]] == syntax.E_NAME: k = dl_operand(w, d, w.p.sym(d.f, a.a[ks[2]]))
                help = dl_len_help(one, k)
            else: help = table_help(w, s, args[:])
            dl_dado_n(w, d, c, s, help)
            return
        if ks[1] != NONE:
            string8 al = dl_nsrc(w, d, ks[1])
            dl_dado_n(w, d, ks[1], index.hold(#format("using ", al)), index.hold(#format(dl_using_why(w, d, ks[1]), "; drop `using ", al, "` and make the call alone")))
    else if ks[1] != NONE: dl_expr(w, d, ks[1])
    dl_expr(w, d, cal)
    for g in ks[2..<#len(ks)]:
        if g != NONE: dl_expr(w, d, a.a[g])

// What a name was written as: 1 text, 2 a container, 0 unknown.
private u8 dl_operand(^World w, ^Dia d, u32 sym):
    syntax.Ast a = dl_ast(w, d)
    i64 i = #len(d.names)
    for i > 0:
        i -= 1
        if u32(d.names[i] >> 32) != sym: continue
        u32 t = u32(d.names[i] & 0xFFFFFFFF)
        u8 g = a.tag[t]
        if g == syntax.T_REF:
            t = a.a[t]
            g = a.tag[t]
            return 2 if g == syntax.T_SLICE || g == syntax.T_ARRAY || g == syntax.T_MAP else 0
        if g == syntax.T_NAME:
            string8 s = w.p.spell(d.f, t)
            return 1 if s == "string" || s == "string8" || s == "string16" || s == "string32" else 0
        return 2 if g == syntax.T_SLICE || g == syntax.T_ARRAY || g == syntax.T_MAP || g == syntax.T_MATRIX else 0
    return 0

private string8 dl_len_help(string8 x, u8 k):
    if k == 2: return index.hold(#format("in DadoScript write `", x, ".len()`: a container's length is a method on it"))
    if k == 1: return index.hold(#format("in DadoScript write `", x, ".bytes().len()` for the byte count Dado's `#len` gives a `string8`, or `", x, ".len()` for its length in UTF-16 code units"))
    return index.hold(#format("in DadoScript write `", x, ".len()`; over a string, `", x, ".len()` counts UTF-16 code units and `", x, ".bytes().len()` the bytes Dado's `#len` counts"))

private string8 dl_char_as_string(string8 t):
    string8 inner = t
    if #len(t) >= 2 && t[0] == '\'' && t[#len(t) - 1] == '\'': inner = t[1..<#len(t) - 1]
    if inner == "\\'": inner = "'"
    else if inner == "\"": inner = "\\\""
    return index.hold(#format("\"", inner, "\""))

// -- the translation table

const string8 WIDTH_INT = "a width is Dado's to write; DadoScript's one integer is `int`, exactly `i64`, and a Dado slot of this type reads as `int` and is narrowed into on a store"

// What DadoScript writes for the Dado spelling `s`: false when nothing is said.
bool spelling(string8 s, ^u8 k, ^string8 sp, ^string8 why):
    i64 b = builtin(s)
    if b >= 0:
        k^ = BUILTINS[b].dados
        sp^ = BUILTINS[b].dados_text
        why^ = BUILTINS[b].dados_why
        return true
    for m in MEMBERS:
        if m.name == s:
            k^ = m.dados
            sp^ = m.dados_text
            why^ = m.dados_why
            return true
    k^ = DS_ABSENT
    sp^ = ""
    if s == "#OS":
        k^ = DS_SPELLED
        sp^ = "Platform.os()"
        why^ = "a question about the target is a method on `Platform`, marked compile-time so `when Platform.os() == Platform.LINUX:` folds"
    else if s == "#ARCH": why^ = NO_ARCH
    else if s == "#ENDIAN": why^ = NO_ENDIAN
    else if s == "#TRIPLE": why^ = "a toolchain's target string is a question about the C compiler, which a script never meets; ask it in Dado"
    else if s == "#DADO_VERSION": why^ = "the compiler's version is a question for the Dado program that hosts the script; ask it there and pass the answer in"
    else if dl_prim(s, k, sp, why): pass
    else if strings.starts_with(s, "#c."): return dl_cscalar(s[3..<#len(s)], k, why)
    else if s == "cstring": why^ = "a NUL-terminated C string is the C ABI's, which a script never writes; a script's text is `string`"
    else if s == "string8":
        k^ = DS_SPELLED
        sp^ = "string"
        why^ = "a string's width is Dado's to write; DadoScript's `string` is the engine's, counted in UTF-16 code units"
    else if s == "string16" || s == "string32":
        k^ = DS_SPELLED
        sp^ = "string"
        why^ = "as `string8`: DadoScript writes no width"
    else if s == "AllocatorMode": why^ = NO_ALLOCATOR
    else if s == "Sink": why^ = "a render sink is Dado's output machinery; a script writes with `print`, or builds text with `string(v)`"
    else if s == "Location":
        k^ = DS_SAME
        why^ = "the same four fields, `file`, `line`, `column` and `function`, read the same way; a script's is the engine's object and Dado's a record, and a value does not cross between them yet"
    else: return false
    return true

private bool dl_prim(string8 s, ^u8 k, ^string8 sp, ^string8 why):
    u8 p = types.prim_named(s)
    if p >= types.PRIMS: return false
    k^ = DS_SPELLED
    if s == "void" || s == "bool" || s == "byte" || s == "int" || s == "float":
        k^ = DS_SAME
        why^ = ""
    else if s == "f32":
        sp^ = "float"
        why^ = "a width is Dado's to write; DadoScript's one floating type is `float`, and a Dado `f32` slot reads as `float` and rounds on a store"
    else if s == "f64":
        sp^ = "float"
        why^ = "`f64` is DadoScript's `float`, under its one name"
    else if s == "rawptr":
        k^ = DS_ABSENT
        why^ = "an untyped address, which a script never holds; write it in Dado"
    else if strings.starts_with(s, "char"):
        sp^ = "string"
        why^ = "DadoScript has no character type: a character is a one-code-point `string`"
    else:
        sp^ = "int"
        why^ = WIDTH_INT
    return true

private bool dl_cscalar(string8 s, ^u8 k, ^string8 why):
    for c in types.C_SCALARS:
        if c.name != s: continue
        k^ = DS_ABSENT
        string8 abi = "a C scalar is the C ABI's representation, which a script never writes; "
        if s == "ldouble": why^ = "`long double` has no exact `float` reading on every target, so it is refused rather than rounded; write it in Dado"
        else if s == "intptr_t" || s == "uintptr_t": why^ = "an address as an integer, which a script never holds; write it in Dado"
        else if c.class == types.CS_FLOAT: why^ = index.hold(#format(abi, "a script's floating type is `float`"))
        else if c.class == types.CS_BOOL: why^ = index.hold(#format(abi, "a script's truth value is `bool`"))
        else if c.class == types.CS_CHARACTER: why^ = "a C character type is C's representation, and DadoScript has no character type; a script's text is `string`"
        else: why^ = index.hold(#format(abi, "a script's integer is `int`"))
        return true
    return false

// The help a Dado spelling's row gives, its placeholders filled from `args`.
string8 table_help(^World w, string8 s, []string8 args):
    u8 k = 0
    string8 sp = ""
    string8 why = ""
    if !spelling(s, &k, &sp, &why): return NO_SHARPS
    if k == DS_SPELLED: return index.hold(#format("in DadoScript write `", dl_fill(sp, args), "`: ", why))
    if k == DS_SAME: return index.hold(#format("DadoScript writes it as Dado does: ", why))
    return index.hold(#format("not in DadoScript: ", why))

const [13]string8 KEPT = ("is", "has", "int", "float", "scalar", "bool", "string", "any", "fail", "assert", "print", "Platform", "defer")

private bool dl_word_ch(char8 c):
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'

// The spelling with its placeholder words replaced by the call's arguments,
// when they are as many.
private string8 dl_fill(string8 sp, []string8 xs):
    ref []u64 pieces
    ref []string8 dist
    bool quoted = false
    i64 i = 0
    for i < #len(sp):
        char8 c = sp[i]
        if c == '"':
            quoted = !quoted
            i += 1
            continue
        if !quoted && (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'):
            i64 st = i
            for i < #len(sp) && dl_word_ch(sp[i]):
                i += 1
            bool method = st > 0 && sp[st - 1] == '.' && !(st > 1 && sp[st - 2] == '.')
            string8 wd = sp[st..<i]
            bool kept = false
            for x in KEPT:
                if x == wd: kept = true
            if !method && !kept:
                pieces = #append(pieces, (u64(st) << 32) | u64(i))
                bool seen = false
                for x in dist:
                    if x == wd: seen = true
                if !seen: dist = #append(dist, wd)
            continue
        i += 1
    if #len(dist) == 0 || #len(dist) != #len(xs): return sp
    ref []char8 out
    i64 at = 0
    for pc in pieces:
        i64 s = i64(pc >> 32)
        i64 e = i64(pc & 0xFFFFFFFF)
        out = #append(out, ..sp[at..<s])
        for j in 0..<#len(dist):
            if dist[j] == sp[s..<e]: out = #append(out, ..xs[j])
        at = e
    out = #append(out, ..sp[at..<#len(sp)])
    return index.hold(out)

// A type as DadoScript writes it (widths and `^`/`ref` dropped), or "".
private string8 dl_dados_type(^World w, ^Dia d, u32 t):
    ref []char8 out
    if !dl_strip(w, d, t, &out): return ""
    return index.hold(out)

private bool dl_strip(^World w, ^Dia d, u32 t, ^ref []char8 out):
    syntax.Ast a = dl_ast(w, d)
    if t == NONE: return false
    u8 g = a.tag[t]
    if g == syntax.T_REF || g == syntax.T_POINTER || g == syntax.T_QUAL || g == syntax.T_LAYOUT: return dl_strip(w, d, a.a[t], out)
    if g == syntax.T_NAME:
        string8 s = w.p.spell(d.f, t)
        u8 k = 0
        string8 sp = ""
        string8 why = ""
        if spelling(s, &k, &sp, &why):
            if k == DS_ABSENT: return false
            if k == DS_SPELLED: s = sp
        out^ = #append(out^, ..s)
        return true
    if g == syntax.T_PATH:
        string8 pk = dl_tok(w, d, a.a[t])
        if strings.starts_with(pk, "#"): return false
        out^ = #append(out^, ..dl_nsrc(w, d, t))
        return true
    if g == syntax.T_SLICE:
        out^ = #append(out^, ..string8("[]"))
        return dl_strip(w, d, a.a[t], out)
    if g == syntax.T_ARRAY:
        out^ = #append(out^, '[')
        out^ = #append(out^, ..dl_nsrc(w, d, a.a[t]))
        out^ = #append(out^, ']')
        return dl_strip(w, d, a.b[t], out)
    if g == syntax.T_MAP:
        out^ = #append(out^, '{')
        if !dl_strip(w, d, a.a[t], out): return false
        out^ = #append(out^, ..string8(": "))
        if !dl_strip(w, d, a.b[t], out): return false
        out^ = #append(out^, '}')
        return true
    if g == syntax.T_FN:
        []u32 ks = a.list(a.b[t])
        if !dl_strip(w, d, ks[0], out): return false
        out^ = #append(out^, '(')
        for i in 2..<#len(ks):
            if i > 2: out^ = #append(out^, ..string8(", "))
            if !dl_strip(w, d, ks[i], out): return false
        out^ = #append(out^, ')')
        return true
    if g == syntax.T_BINDING || g == syntax.T_KIND || g == syntax.T_TUPLE:
        if g == syntax.T_TUPLE && a.a[t] == 1: return false
        out^ = #append(out^, ..dl_nsrc(w, d, t))
        return true
    return false
