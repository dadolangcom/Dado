// `#location()` and `#trace()`: where the program is, as Dado's `Location`
// (`(string8 file, i32 line, i32 column, string8 function)`), which the
// compiler provides by name (a package's own `Location` is its own).
package check

import "language:diag"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:strings"

// Dado's `Location`, named on first mention (a script's is `w.sloc`).
u32 dloc(^World w):
    if w.dloc != NONE: return w.dloc
    [4]u32 sl = [types.STRING8, u32(types.P_I32), u32(types.P_I32), types.STRING8]
    u32 s = w.t.named("", "Location")
    [4]u32 ns = [tstr(w, "file"), tstr(w, "line"), tstr(w, "column"), tstr(w, "function")]
    w.t.define(s, w.t.tuple(sl[:]), ns[:])
    w.dloc = s
    return s

// The function body `b` is in, as a trace names it: `pkg.f`, `pkg.Type.m`;
// "" outside a function (a package constant's or variable's initializer).
string8 here_fn(^World w, ^Body b):
    u32 d = b.decl
    if d == NONE || w.decls[d].kind != K_FN && w.decls[d].kind != K_METHOD: return ""
    u32 p = w.decls[d].pkg
    string8 pn = "main"
    if w.p.pkgs[p].name != NONE: pn = name_of(w, w.p.pkgs[p].name)
    string8 dn = name_of(w, w.decls[d].name)
    if strings.starts_with(dn, "test__file"): dn = "test"
    u32 bl = w.decls[d].block
    if bl != NONE && w.decls[d].kind == K_METHOD: return index.hold(#format(pn, ".", name_of(w, w.decls[bl].name), ".", dn))
    return index.hold(#format(pn, ".", dn))

// The place `n` of the body's file is, in function `fname`, as a constant.
private Val here(^World w, ^Body b, u32 n, string8 fname):
    diag.Place pl = w.p.map.place(w.p.map.base[b.file] + tree(w, b).lo[n])
    [4]u32 xs = [w.k.str(&w.t, w.p.files[b.file].path), w.k.small(&w.t, pl.line), w.k.small(&w.t, pl.col), w.k.str(&w.t, fname)]
    return konst_val(w, b, w.k.tuple(&w.t, xs[:]), dloc(w), n)

// A default `#location()` at call `n`: the call's own place.
Val caller_place(^World w, ^Body b, u32 n):
    return here(w, b, n, here_fn(w, b))

// Whether node `x` of file `f` is `#location()` itself.
bool location_default(^World w, u32 f, u32 x):
    syntax.Ast a = w.p.files[f].a
    if x == NONE || a.tag[x] != syntax.E_CALL: return false
    []u32 ks = a.list(a.b[x])
    return #len(ks) >= 1 && a.tag[ks[0]] == syntax.E_NAME && w.p.spell(f, ks[0]) == "#location"

// A `#location()` under `x` (file `f`), or NONE.
u32 location_inside(^World w, u32 f, u32 x):
    if x == NONE: return NONE
    if location_default(w, f, x): return x
    syntax.Ast a = w.p.files[f].a
    ref []u32 ks
    a.kids(x, &ks)
    u32 r = NONE
    for k in ks:
        if r == NONE: r = location_inside(w, f, k)
    #delete(ks)
    return r

// A parameter's default with a `#location()` inside a larger value: ERR0901.
void location_nested(^World w, u32 f, u32 at):
    syntax.Ast a = w.p.files[f].a
    say(w, f, 0, a.lo[at], a.hi[at], 901, "`#location()` inside a default is not a value the declaration can fold\x1fA default written `= #location()` is the place of each call that leaves the argument out, and a `#location()` inside a larger value would be neither that place nor a constant", "default a `Location` parameter to `#location()` itself — `Location at = #location()` — and build the larger value in the body")

// `#location()`, and `#trace()`: a `ref []Location` from the ambient
// allocator, `B_TRACE` its count (1 without the shadow stack), `B_LOCATION`
// filling it from the place written and the stack's frames.
Val here_call(^World w, ^Body b, u32 n, u8 m):
    []u32 args = call_args(w, b, n)
    string8 verb = "#trace" if m == B_TRACE else "#location"
    if #len(args) > 0:
        string8 help = "write `#location()` where the place is wanted; for the calls around it, `#trace()`"
        if m == B_TRACE: help = "write `#trace()`, and read the place you want out of the run it answers: `t[0]` is where `#trace()` is written, `t[1]` the call around it"
        string8 what = "it answers where it is written, and in a sanitized build each call the run is inside" if m == B_TRACE else "it answers the place it is written"
        err(w, b, arg_value(w, b, args[0]), 601, index.hold(#format("`", verb, "()` takes nothing: ", what, "\x1fThe place is the call's own, so there is nothing to tell it")), help)
        for g in args:
            _ = expr(w, b, arg_value(w, b, g), NONE)
        return bad()
    Val at = here(w, b, n, here_fn(w, b))
    if m == B_LOCATION: return at
    u32 i64t = u32(types.P_I64)
    u32 cnt = temp(w, b, i64t, n)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_TRACE, i64t, n, cnt, NONE)
    u32 rt = w.t.ref_of(w.t.slice_of(dloc(w)))
    u32 t = temp(w, b, rt, n)
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_MAKE, rt, n, t, NONE)
    ir.arg(&b.f, cnt)
    ir.arg(&b.f, ir.konst(w.k.small(&w.t, 1)))
    _ = ir.op(&b.f, ir.O_INTRINSIC, B_LOCATION, u32(types.P_VOID), n, NONE, NONE)
    ir.arg(&b.f, t)
    ir.arg(&b.f, at.opd)
    return value(t, rt)
