// Matrices: `[R,C]T` is a tag over the `[C][R]T` it lays out as (column
// major, `m[c][r]`); `*` is the product, `/` and `%` are refused, the rest
// is the shape's.
package check

import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"

u32 matrix_type(^World w, u32 f, u32 n):
    syntax.Ast a = w.p.files[f].a
    []u32 ks = a.list(a.b[n])
    u32 rows = binder_dim(w, w.p.files[f].t.sym[a.a[n]]) if a.a[n] != NONE else dim(w, f, ks[0])
    u32 cols = binder_dim(w, w.p.sym(f, n)) if a.main[n] != NONE else dim(w, f, ks[1])
    if a.a[n] != NONE && rows == NONE || a.main[n] != NONE && cols == NONE:
        arity_here(w, f, a.a[n] if a.a[n] != NONE && rows == NONE else a.main[n])
        return NONE
    if rows == NONE || cols == NONE:
        say(w, f, 0, a.lo[n], a.hi[n], 1, "this type is outside the slice the port builds so far", "")
        return NONE
    u32 e = resolve_type(w, f, ks[2])
    if e == NONE: return NONE
    return matrix_of(w, e, rows, cols)

private u32 binder_dim(^World w, u32 sym):
    u8 bk = 0
    u32 v = bound(w, sym, &bk)
    return w.t.a[v] if v != NONE && bk == BK_LEN else NONE

// A dimension: a literal, a `const`, or a length binder's value; else NONE.
private u32 dim(^World w, u32 f, u32 x):
    syntax.Ast a = w.p.files[f].a
    if a.tag[x] == syntax.E_INT && a.b[x] == 0: return a.a[x]
    if a.tag[x] == syntax.E_CALL && a.tag[a.list(a.b[x])[0]] == syntax.E_NAME && w.p.spell(f, a.list(a.b[x])[0]) == "#LEN":
        i64 k = folded_len(w, f, x)
        return NONE if k < 0 else u32(k)
    if a.tag[x] != syntax.E_NAME: return NONE
    u8 bk = 0
    u32 v = bound(w, w.p.sym(f, x), &bk)
    if v != NONE: return w.t.a[v] if bk == BK_LEN else NONE
    u32 d = lookup(w, w.p.files[f].pkg, w.p.sym(f, x))
    if d == NONE || w.decls[d].kind != K_CONST || resolve(w, d) == NONE: return NONE
    u32 c = w.decls[d].value
    if c == NONE || w.k.kind[c] != types.C_INT: return NONE
    return u32(w.k.w0[c])

u32 matrix_of(^World w, u32 e, u32 rows, u32 cols):
    u32 col = repeat(w, e, rows)
    [1]u32 u = [repeat(w, col, cols)]
    return w.t.make(types.T_MATRIX, rows, cols, u[:])

private u32 repeat(^World w, u32 e, u32 n):
    if n == 1: return e
    ref []u32 xs
    for _ in 0..<n:
        xs = #append(xs, e)
    u32 t = w.t.tuple(xs)
    #delete(xs)
    return t

// The matrix row under names, qualifiers and tags, or NONE.
u32 matrix(^World w, u32 ty):
    u32 x = ty
    for _ in 0..<64:
        if x == NONE: return NONE
        u8 g = w.t.tag[x]
        if g == types.T_MATRIX: return x
        if g == types.T_NAMED: x = w.t.body[x]
        else if g == types.T_QUAL || g == types.T_DISTINCT: x = w.t.b[x]
        else: return NONE
    return NONE

// A matrix row's element type.
u32 melem(^World w, u32 m):
    u32 e = w.t.list(m)[0]
    if w.t.b[m] > 1: e = w.t.list(w.t.resolve(e))[0]
    if w.t.a[m] > 1: e = w.t.list(w.t.resolve(e))[0]
    return e

// The column vector `[C]T` a matrix row takes on its right.
u32 matrix_col(^World w, u32 m):
    return repeat(w, melem(w, m), w.t.b[m])

private bool user_tagged(^World w, u32 ty):
    u32 x = ty
    for _ in 0..<64:
        if x == NONE: return false
        u8 g = w.t.tag[x]
        if g == types.T_DISTINCT: return true
        if g == types.T_NAMED: x = w.t.body[x]
        else if g == types.T_QUAL: x = w.t.b[x]
        else: return false
    return false

// `l op r` when a side is a matrix and the tag answers it; `ok` false to
// fall through to the shape's slot walk.
Val matrix_op(^World w, ^Body b, u32 n, string8 op, Val l, Val r, u32 at, u32 rn, ^bool ok):
    ok^ = true
    u32 lm = matrix(w, l.ty) if l.kind == V_VAL else NONE
    u32 rm = matrix(w, r.ty) if r.kind == V_VAL else NONE
    if lm == NONE && rm == NONE || op != "*" && op != "/" && op != "%":
        ok^ = false
        return bad()
    if op != "*":
        string8 rem = ". A remainder needs a division to be left over from, so it goes the same way" if op == "%" else ""
        err(w, b, n, 607, index.hold(#format("`", op, "` is not defined for a matrix, deliberately: there is no matrix division\x1f`a / b` would have to mean `a * inverse(b)`, and inversion is partial — a singular matrix has none — so it belongs to a function that can say a matrix had no inverse rather than to an operator that cannot", rem, "\x1emultiply by an inverse your program computes, where it can say a matrix had none")))
        return bad()
    u32 other = r.ty if lm != NONE else l.ty
    u32 orr = under(&w.t, other)
    bool shape = l.kind == V_VAL && r.kind == V_VAL && orr != NONE && w.t.tag[orr] == types.T_TUPLE
    if !shape:
        ok^ = false
        return bad()
    if lm == NONE:
        string8 lt = shown(w, l.ty)
        err(w, b, n, 607, index.hold(#format("`", lt, "` on the left of a matrix is not defined, deliberately\x1f`m * v` reads `v` as a column and `v * m` reads it as a row, and a ", lt, " is neither — which of the two it became would be decided by which side of the operator it landed on\x1ewrite `m * v`, or `#transpose(m) * v` if the row product is what you meant")))
        return bad()
    u32 lr = w.t.a[lm]
    u32 lc = w.t.b[lm]
    u32 e = melem(w, lm)
    if rm != NONE:
        u32 rr = w.t.a[rm]
        u32 rc = w.t.b[rm]
        u32 re = melem(w, rm)
        u32 res = NONE
        if user_tagged(w, l.ty) || user_tagged(w, r.ty):
            if l.ty != r.ty:
                err(w, b, n, 504, index.hold(#format("`*` is inherited within a tag and never across it; these are ", shown(w, l.ty), " and ", shown(w, r.ty))))
                return bad()
            if lc != rr:
                err(w, b, n, 609, index.hold(#format(shown(w, l.ty), " times itself has nothing to sum over: it has ", lr, " row(s) and ", lc, " column(s), and only a square matrix multiplies by one of its own type")))
                return bad()
            res = l.ty
        else:
            if lc != rr:
                string8 ls = shown(w, l.ty)
                err(w, b, n, 609, index.hold(#format(ls, " times ", shown(w, r.ty), " has nothing to sum over: the left has ", lc, " column(s) and the right has ", rr, " row(s), and a product pairs one with the other")))
                return bad()
            if w.t.resolve(e) != w.t.resolve(re):
                string8 es = shown(w, e)
                err(w, b, n, 504, index.hold(#format("a matrix product needs one element type; these are ", es, " and ", shown(w, re))))
                return bad()
            res = matrix_of(w, e, lr, rc)
        return product(w, b, n, l, r, at, rn, lr, lc, rc, true, e, res)
    if w.t.resolve(other) == w.t.resolve(l.ty):
        string8 ls = shown(w, l.ty)
        err(w, b, n, 607, index.hold(#format("`*` between ", ls, " and ", shown(w, r.ty), " is refused: two spellings of one layout, which mean different products\x1erebind one of them — `[C][R]T` gives the componentwise product and `[R,C]T` the matrix one")))
        return bad()
    u32 column = repeat(w, e, lc)
    if w.t.resolve(column) != orr:
        string8 ls = shown(w, l.ty)
        string8 rs = shown(w, r.ty)
        err(w, b, n, 609, index.hold(#format(ls, " times ", rs, " is not a product: a matrix takes a column vector of ", shown(w, column), " on its right, one per column")))
        return bad()
    return product(w, b, n, l, r, at, rn, lr, lc, 1, false, e, repeat(w, e, lr))

// Cell (`row`, `col`) of a value of `rows` by `cols` at place `p`.
private u32 cell(^World w, ^Body b, u32 p, u32 rows, u32 cols, u32 row, u32 col, u32 e):
    u32 x = p
    if cols > 1: x = ir.step(&b.f, x, ir.ST_FIELD, col, repeat(w, e, rows))
    if rows > 1: x = ir.step(&b.f, x, ir.ST_FIELD, row, e)
    return x

// The product, written out: `out[c][r] = sum over k of l[k][r] * r[c][k]`.
private Val product(^World w, ^Body b, u32 n, Val l, Val r, u32 at, u32 rn, u32 rows, u32 inner, u32 cols, bool mat, u32 e, u32 res):
    w.mprod[(u64(b.file) << 32) | u64(n)] = 1
    u32 lp = spill(w, b, l, at)
    u32 rp = spill(w, b, r, rn)
    ref []u32 cells
    for c in 0..<cols:
        for i in 0..<rows:
            u32 acc = temp(w, b, e, n)
            for k in 0..<inner:
                u32 x = cell(w, b, lp, rows, inner, i, k, e)
                u32 y = cell(w, b, rp, inner, cols, k, c, e) if mat else cell(w, b, rp, inner, 1, k, 0, e)
                if k == 0:
                    _ = ir.op(&b.f, ir.O_BIN, ir.B_MUL, e, n, acc, x, y)
                    continue
                u32 m = temp(w, b, e, n)
                _ = ir.op(&b.f, ir.O_BIN, ir.B_MUL, e, n, m, x, y)
                _ = ir.op(&b.f, ir.O_BIN, ir.B_ADD, e, n, acc, acc, m)
            cells = #append(cells, acc)
    u32 t = temp(w, b, res, n)
    if rows > 1 && cols > 1:
        u32 col = repeat(w, e, rows)
        for c in 0..<cols:
            u32 ct = ir.step(&b.f, t, ir.ST_FIELD, c, col)
            _ = ir.op(&b.f, ir.O_MAKE, 0, col, n, ct, NONE)
            for i in 0..<rows:
                ir.arg(&b.f, cells[i64(c * rows + i)])
    else if #len(cells) > 1:
        _ = ir.op(&b.f, ir.O_MAKE, 0, res, n, t, NONE)
        for x in cells:
            ir.arg(&b.f, x)
    else: _ = ir.op(&b.f, ir.O_SET, 0, res, n, t, cells[0])
    #delete(cells)
    return value(t, res)

// `#transpose(m)`: a matrix's two dimensions swapped (it keeps its tag), or
// a nested tuple's two levels.
Val transpose_(^World w, ^Body b, u32 n, []u32 args, string8 said):
    if #len(args) != 1:
        err(w, b, n, 601, index.hold(#format("`", said, "` takes #transpose(m)")))
        return bad()
    u32 an = arg_value(w, b, args[0])
    Val v = finish(w, b, expr(w, b, an, NONE), an)
    if v.ty == NONE: return bad()
    u32 m = matrix(w, v.ty)
    u32 p = spill(w, b, v, an)
    u32 res = NONE
    if m != NONE:
        u32 rows = w.t.a[m]
        u32 cols = w.t.b[m]
        u32 e = melem(w, m)
        res = matrix_of(w, e, cols, rows)
        u32 t = temp(w, b, res, n)
        for j in 0..<rows:
            u32 ct = t
            if rows > 1 && cols > 1:
                ct = ir.step(&b.f, t, ir.ST_FIELD, j, repeat(w, e, cols))
                _ = ir.op(&b.f, ir.O_MAKE, 0, repeat(w, e, cols), n, ct, NONE)
            else if j == 0 && rows * cols > 1: _ = ir.op(&b.f, ir.O_MAKE, 0, res, n, t, NONE)
            for i in 0..<cols:
                u32 x = cell(w, b, p, rows, cols, j, i, e)
                if rows * cols == 1: _ = ir.op(&b.f, ir.O_SET, 0, e, n, t, x)
                else: ir.arg(&b.f, x)
        return value(t, res)
    []u32 outer = w.t.slots(v.ty)
    bool flat = true
    for x in outer:
        u32 r = under(&w.t, x)
        if r != NONE && w.t.tag[r] == types.T_TUPLE: flat = false
    if flat:
        err(w, b, an, 607, index.hold(#format("`transpose` needs two levels to swap, and ", shown(w, v.ty), " is one: a bare vector is neither a row nor a column, so there is nothing to turn. `[4,1]f32` is a column and `[1,4]f32` is a row")))
        return bad()
    for i in 0..<#len(outer):
        for s in w.t.slots(outer[i]):
            u32 r = under(&w.t, s)
            if r != NONE && w.t.tag[r] == types.T_TUPLE:
                err(w, b, an, 607, index.hold(#format("`transpose` swaps two levels and ", shown(w, v.ty), " has three or more — slot ", i, " is itself nested. Reversing every axis is a convention rather than a meaning, and anything else needs the axes named")))
                return bad()
    []u32 first = w.t.slots(outer[0])
    i64 width = #len(first)
    for i in 0..<#len(outer):
        []u32 si = w.t.slots(outer[i])
        i64 k = #len(si)
        if k != width:
            err(w, b, an, 504, index.hold(#format("`transpose` needs a rectangle: slot 0 of ", shown(w, v.ty), " has ", width, " slot(s) and slot ", i, " has ", k)))
            return bad()
    ref []u32 cs
    for j in 0..<width:
        ref []u32 col
        for x in outer:
            col = #append(col, w.t.slots(x)[j])
        cs = #append(cs, w.t.tuple(col))
        #delete(col)
    res = w.t.tuple(cs)
    u32 t = temp(w, b, res, n)
    for j in 0..<width:
        u32 ct = ir.step(&b.f, t, ir.ST_FIELD, u32(j), cs[j])
        _ = ir.op(&b.f, ir.O_MAKE, 0, cs[j], n, ct, NONE)
        for i in 0..<#len(outer):
            u32 row = ir.step(&b.f, p, ir.ST_FIELD, u32(i), outer[i])
            ir.arg(&b.f, ir.step(&b.f, row, ir.ST_FIELD, u32(j), w.t.slots(outer[i])[j]))
    #delete(cs)
    return value(t, res)

// `typeof(p)`: the type of an inert place; `shapeof(p)` its shape (no name,
// tag or matrix).
u32 shape_of(^World w, u32 f, u32 n):
    syntax.Ast a = w.p.files[f].a
    u32 x = a.a[n]
    string8 kw = "typeof" if a.b[n] == 1 else "shapeof"
    if !inert_place(&a, x):
        say(w, f, 0, a.lo[x], a.hi[x], 511, index.hold(#format("`", kw, "` takes an **inert** place — a name, a slot of one, or what a named pointer points at")), "bind the value first", "An arbitrary expression here would be typed and never run, which is an evaluation rule this language does not have and does not need, and a constant has no storage to be a place of")
        return NONE
    ^Body b = ^Body(w.body)
    if b == nil || b.file != f:
        say(w, f, 0, a.lo[n], a.hi[n], 1, "this type is outside the slice the port builds so far", "")
        return NONE
    Val v = expr(w, b, x, NONE)
    if v.ty == NONE: return NONE
    if v.kind != V_VAL:
        say(w, f, 0, a.lo[n], a.hi[n], 1, "this type is outside the slice the port builds so far", "")
        return NONE
    return v.ty if a.b[n] == 1 else under(&w.t, v.ty)

private bool inert_place(^syntax.Ast a, u32 x):
    u8 g = a.tag[x]
    if g == syntax.E_NAME: return true
    if g == syntax.E_FIELD: return inert_place(a, a.a[x])
    return g == syntax.E_DEREF && a.tag[a.a[x]] == syntax.E_NAME
