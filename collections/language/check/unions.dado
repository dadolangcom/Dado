// Unions: a closed choice of member types, nominal by its tag. The type is
// a NAMED over a T_UNION row (tag `pkg.Name`); C holds a tag and the members.
package check

import "core:strings"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"

// Declaration `d`'s members, checked, as the union under `ty`.
void union_body(^World w, u32 d, u32 ty):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u32 n = w.decls[d].node
    string8 un = s_qual(w, d)
    if (a.a[n] & syntax.F_RAW) != 0:
        raw_union(w, d, ty, un)
        return
    if (a.a[n] & syntax.F_DISTINCT) != 0: say(w, f, 0, a.lo[n], a.lo[n] + 8, 515, index.hold(#format("`distinct` adds nothing to a union: `", un, "` is already nominal by its tag set, so it is already no other type's equal however its members are spelled — delete the word")), "")
    ref []u32 ms
    []u32 ks = a.list(a.b[n])
    for m in ks[1..<#len(ks)]:
        if m == NONE: continue
        if a.main[m] != NONE && a.tag[a.list(a.b[m])[0]] != syntax.T_CHANNEL:
            u32 tk = a.main[m]
            say(w, f, 0, w.p.files[f].t.start[tk], w.p.files[f].t.end[tk], 513, index.hold(#format("a member of `", un, "` is a **type** and takes no name", "\x1fThe discriminant *is* the type, so `case [2]f32 v:` is how an arm names this one")), index.hold(#format("delete `", w.p.spell(f, m), "` — or, if two members would otherwise be one type, make them differ with `distinct`")))
            continue
        w.chan_at = 3
        w.chan_union = d
        u32 t = resolve_type(w, f, a.list(a.b[m])[0])
        w.chan_at = 0
        if t == NONE: continue
        i64 dup = -1
        for j in 0..<#len(ms):
            if w.t.resolve(ms[j]) == w.t.resolve(t): dup = j
        if dup >= 0:
            if ds_at(w, f, m): t = w.t.resolve(t)
            say(w, f, 0, a.lo[m], a.hi[m], 513, index.hold(#format("`", un, "` already has a member of this type — member ", dup, " is ", shown(w, t))), "make them differ with `distinct`, or write one member", "A name is not identity, so two `type` declarations over one shape are one type. A discriminant *is* the member's type, so two of them leave the tag saying nothing. C's union has no tag and admits both, and `cunion` is how one is restated")
            continue
        ms = #append(ms, t)
    if #len(ks) <= 1:
        say_tok(w, f, 0, n, 514, index.hold(#format("`", un, "` declares no members, so no value of it could exist: a union is exactly one of a closed set of shapes, and an empty set has no `one of`")), "")
    string8 pn = name_of(w, w.p.pkgs[w.decls[d].pkg].name) if w.p.pkgs[w.decls[d].pkg].name != NONE else "main"
    w.t.define(ty, w.t.make(types.T_UNION, tstr(w, index.hold(#format(pn, ".", un))), 0, ms), nil)

// `cunion`: members share one storage and are read by name, unguarded
// (a T_UNION row with `b` set).
private void raw_union(^World w, u32 d, u32 ty, string8 un):
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    []u32 ks = a.list(a.b[w.decls[d].node])
    bool fs = w.decls[d].block != NONE && a.tag[w.decls[d].block] == syntax.N_FOREIGN
    if !fs && ks[0] != NONE && a.main[ks[0]] != NONE:
        say(w, f, 0, a.lo[ks[0]], a.hi[ks[0]], 1024, index.hold(#format("`", w.p.files[f].src[i64(a.lo[ks[0]])..<i64(a.hi[ks[0]])], "` is the name a C header gave a union, and `", un, "` is declared outside a `foreign` block, so no header gave it one")), "move the declaration into the `foreign` block that includes the header, or drop the attribute", "Dado emits this union itself")
    ref []u32 ms
    ref []u32 names
    for m in ks[1..<#len(ks)]:
        if m == NONE: continue
        []u32 mk = a.list(a.b[m])
        if fs && #len(mk) > 2 && mk[2] != NONE && a.main[m] != NONE && w.p.spell(f, m) == "_":
            say(w, f, 0, a.lo[m], a.hi[m], 1024, index.hold(#format("an unnamed bitfield reserves bits the members after it are laid out past, and every member of `", un, "` is laid out at offset zero", "\x1fSo there are no bits for `#c.uint` to reserve and no storage unit for a `: 0` to end")), "give the member a name, or write the width into the member that uses it")
            continue
        if !fs && #len(mk) > 2 && mk[2] != NONE:
            say(w, f, 0, a.lo[mk[2]], a.hi[mk[2]], 1023, "`: W` gives a member the width in bits C lays it out in, and only a member list restating C inside a `foreign` block carries one", "drop the `: W`, or restate the C declaration inside a `foreign` block")
            continue
        if a.main[m] == NONE:
            say(w, f, 0, a.lo[m], a.hi[m], 513, index.hold(#format("every member of a `cunion` is named, because a name is the only thing that reaches one\x1fC's union carries no tag to select on, so the name is the whole of the access — the same rule a transparent `type` follows\x1e`", un, "` is C's union, so write its member names")), "")
            continue
        u32 t = resolve_type(w, f, mk[0])
        if t == NONE: continue
        if a.tag[mk[0]] == syntax.T_ARRAY && !c_array(w, t): w.carray[(u64(ty) << 32) | u64(#len(ms))] = 1
        if fs && #len(mk) > 2 && mk[2] != NONE:
            i64 bw = bitfield(w, f, m, t, un)
            if bw < 0: continue
            w.cwidth[(u64(ty) << 32) | u64(#len(ms))] = u32(bw)
        ms = #append(ms, t)
        names = #append(names, tstr(w, w.p.spell(f, m)) if a.main[m] != NONE else tstr(w, ""))
    string8 pn = name_of(w, w.p.pkgs[w.decls[d].pkg].name) if w.p.pkgs[w.decls[d].pkg].name != NONE else "main"
    u32 ur = w.t.make(types.T_UNION, tstr(w, index.hold(#format(pn, ".", un))), 1, ms)
    // Its row names its members too: C's union is shown member by name.
    w.t.define(ur, w.t.body[ur], names)
    w.t.define(ty, ur, names)

// The union row under `ty`, or NONE (a `cunion`'s too: it has slots).
u32 union_of(^World w, u32 ty):
    u32 r = w.t.resolve(ty)
    if r == NONE || w.t.tag[r] != types.T_UNION || w.t.b[r] != 0: return NONE
    return r

// The `cunion` row under `ty`, or NONE.
u32 raw_of(^types.Types t, u32 ty):
    u32 r = t.resolve(ty)
    if r == NONE || t.tag[r] != types.T_UNION || t.b[r] == 0: return NONE
    return r

// Member `ty`'s place in union row `u`, or -1.
i64 member_at(^World w, u32 u, u32 ty):
    if u == NONE: return -1
    []u32 ms = w.t.list(u)
    for i in 0..<#len(ms):
        if w.t.resolve(ms[i]) == w.t.resolve(ty): return i
    return -1

string8 members_text(^World w, u32 u):
    string8 o = ""
    []u32 ms = w.t.list(u)
    for i in 0..<#len(ms):
        string8 sep = ", " if i > 0 else ""
        o = index.hold(#format(o, sep, "`", shown(w, w.t.list(u)[i]), "`"))
    return o

// `U(x)`: `x` tagged as the member it is.
Val union_make(^World w, ^Body b, u32 n, u32 ty, u32 vn):
    u32 rw = raw_of(&w.t, ty)
    if rw != NONE:
        Val rv = finish(w, b, expr(w, b, vn, NONE), vn)
        if rv.ty == NONE: return bad()
        []u32 rs = w.t.list(rw)
        []u32 rn = w.t.slot_names(rw)
        ref []string8 hit
        for i in 0..<#len(rs):
            if w.t.resolve(rs[i]) == w.t.resolve(rv.ty) && i < #len(rn): hit = #append(hit, index.hold(#format("`", w.t.text(rn[i]), "`")))
        if #len(hit) > 1:
            err(w, b, vn, 1024, index.hold(#format(shown(w, rv.ty), " is the type of ", #len(hit), " members of ", shown(w, ty), " — ", strings.join(hit[:], " and "), " — and a value is built from exactly one, chosen by its type")), index.hold(#format("declare the zero and write the member you mean, `e.", w.t.text(rn[0]), " = …`")), "C's union has no tag to tell them apart, and neither has this")
            return bad()
        for i in 0..<#len(rs):
            if w.t.resolve(rs[i]) != w.t.resolve(rv.ty): continue
            u32 t = temp(w, b, ty, n)
            _ = ir.op(&b.f, ir.O_SET, 0, ty, n, t, zero(w, ty))
            _ = ir.op(&b.f, ir.O_SET, 0, rs[i], n, ir.step(&b.f, t, ir.ST_FIELD, u32(i), rs[i]), spill(w, b, rv, vn))
            return value(t, ty)
        err(w, b, vn, 504, index.hold(#format(shown(w, rv.ty), " is not the type of any member of ", shown(w, ty), "; its members are ", raw_members(w, rw), ". C's union is built from exactly one member, chosen by its type")))
        return bad()
    u32 u = union_of(w, ty)
    Val v = finish(w, b, expr(w, b, vn, NONE), vn)
    if v.ty == NONE || u == NONE: return bad()
    i64 i = member_at(w, u, v.ty)
    if i < 0:
        err(w, b, vn, 504, index.hold(#format(shown(w, v.ty), " is not a member of ", shown(w, ty), ", so there is no discriminant for it to take; its members are ", members_text(w, u), "\x1fA literal has no type of its own to discriminate on, so a written one has to say which member it is")), "convert it to the member's type first, or bind it to a name of that type and convert that")
        return bad()
    // A header struct crosses into the member's own spelling first.
    u32 mt = w.t.list(u)[i]
    if v.ty != mt && (is_fstruct(&w.t, v.ty) || is_fstruct(&w.t, mt)): v = coerce(w, b, v, mt, vn)
    if v.ty == NONE: return bad()
    u32 t = temp(w, b, ty, n)
    _ = ir.op(&b.f, ir.O_CONV, ir.CV_UNION, ty, n, t, spill(w, b, v, vn), u32(i))
    return value(t, ty)

// The member type a `case` value or `.(T)` names, or NONE (reported).
private u32 named_member(^World w, ^Body b, u32 vn, u32 ty, bool arm):
    syntax.Ast a = tree(w, b)
    u32 mt = NONE
    if b.ds && a.tag[vn] == syntax.E_NAME: mt = s_type_name(w, b.file, vn)
    if mt != NONE && mt != NONE - 1: pass
    else if a.tag[vn] == syntax.E_TYPE: mt = resolve_type(w, b.file, a.a[vn])
    else if a.tag[vn] >= syntax.T_NAME && a.tag[vn] <= syntax.T_CHANNEL: mt = resolve_type(w, b.file, vn)
    else if a.tag[vn] == syntax.E_TUPLE:
        ref []u32 xs
        for e in a.list(a.b[vn]):
            Val tv = expr(w, b, e, NONE)
            if tv.ty == NONE: return NONE
            if tv.kind != V_TYPE:
                err(w, b, vn, 416, index.hold(#format("an arm of a `switch` over ", shown(w, ty), " names a **type**, and this is a value")), "write `case <type>:`, with an optional name to bind the member to")
                return NONE
            xs = #append(xs, tv.x)
        mt = w.t.tuple(xs)
    else:
        Val tv = expr(w, b, vn, NONE)
        if tv.ty == NONE: return NONE
        if tv.kind != V_TYPE:
            err(w, b, vn, 416, index.hold(#format("an arm of a `switch` over ", shown(w, ty), " names a **type**, and this is a value")), "write `case <type>:`, with an optional name to bind the member to")
            return NONE
        mt = tv.x
    if mt == NONE: return NONE
    if member_at(w, union_of(w, ty), mt) < 0:
        string8 why = ", so it could never be its discriminant" if arm else ""
        err(w, b, vn, 416, index.hold(#format(shown(w, mt), " is not a member of ", shown(w, ty), why, "; its members are ", members_text(w, union_of(w, ty)))))
        return NONE
    return mt

// `v.(T)`: member `T` and whether the tag says so, as `(T, bool)`.
Val narrow(^World w, ^Body b, u32 n):
    syntax.Ast a = tree(w, b)
    Val v = finish(w, b, expr(w, b, a.a[n], NONE), a.a[n])
    if v.ty == NONE: return bad()
    u32 u = union_of(w, v.ty)
    u32 rw = raw_of(&w.t, v.ty)
    if rw != NONE:
        err(w, b, n, 1024, index.hold(#format("`.( )` gives back a member **and whether the tag said so**, and ", shown(w, v.ty), " is C's union, which carries no tag", "\x1fC does not say which member was written last")), index.hold(#format("read the member by name — `.", w.t.text(w.t.slot_names(rw)[0]), "` — which is what C does and what the header's own code does; its members are ", raw_members(w, rw))))
        return bad()
    if u == NONE:
        err(w, b, n, 416, index.hold(#format("`.( )` reads a member of a union, and ", shown(w, final_ty(w, v)), " is not one")))
        return bad()
    u32 mt = named_member(w, b, a.b[n], v.ty, false)
    if mt == NONE: return bad()
    u32 x = spill(w, b, v, a.a[n])
    u32 i = u32(member_at(w, u, mt))
    u32 bt = u32(types.P_BOOL)
    u32 m = temp(w, b, mt, n)
    _ = ir.op(&b.f, ir.O_CONV, ir.CV_MEMBER, mt, n, m, x, i, 1)
    u32 tg = temp(w, b, u32(types.P_U32), n)
    _ = ir.op(&b.f, ir.O_CONV, ir.CV_TAG, u32(types.P_U32), n, tg, x)
    u32 ok = temp(w, b, bt, n)
    _ = ir.op(&b.f, ir.O_BIN, ir.B_EQ, u32(types.P_U32), n, ok, tg, ir.konst(w.k.small(&w.t, i64(i))))
    [2]u32 sl = [mt, bt]
    u32 tt = w.t.tuple(sl[:])
    u32 t = temp(w, b, tt, n)
    _ = ir.op(&b.f, ir.O_MAKE, 0, tt, n, t, NONE)
    ir.arg(&b.f, m)
    ir.arg(&b.f, ok)
    return value(t, tt)

// A `switch` over a union: an arm per member named, its binding the member.
void union_switch(^World w, ^Body b, u32 n, Val v):
    syntax.Ast a = tree(w, b)
    []u32 ks = a.list(a.b[n])
    u32 u = union_of(w, v.ty)
    u32 x = spill(w, b, v, ks[0])
    u32 tg = temp(w, b, u32(types.P_U32), ks[0])
    _ = ir.op(&b.f, ir.O_CONV, ir.CV_TAG, u32(types.P_U32), ks[0], tg, x)
    u32 bt = u32(types.P_BOOL)
    ref []i64 seen
    ref []u32 seen_at
    ref []u32 opened
    if !b.ds: fall_check(w, b, n, true)
    for c in ks[2..<#len(ks)]:
        if c == NONE: continue
        []u32 vs = a.list(a.b[c])
        u32 any = temp(w, b, bt, c)
        _ = ir.op(&b.f, ir.O_SET, 0, bt, c, any, ir.konst(w.k.boolean(&w.t, false)))
        i64 one = -1
        bool dupd = false
        for vn in vs[1..<#len(vs)]:
            u32 mt = named_member(w, b, vn, v.ty, true)
            if mt == NONE: continue
            i64 i = member_at(w, u, mt)
            i64 dup = -1
            for j in 0..<#len(seen):
                if seen[j] == i: dup = j
            if vn != vs[1]: err(w, b, vn, 718, index.hold(#format("a `case` arm over ", shown(w, v.ty), " names one member", "\x1fIts body sees the value as that member's type, and one body cannot see it as two")), index.hold(#format("write an arm per member — `case ", src(w, b, vs[1]), ":` here, and each of the others in an arm of its own below it")))
            if dup >= 0:
                Where at = where(w, b.file, 0, seen_at[dup])
                err(w, b, vn, 706, index.hold(#format("the arm on line ", at.line, " already matches this member, and a `switch` takes the first arm that matches; this one could never run")))
                dupd = true
                continue
            seen = #append(seen, i)
            seen_at = #append(seen_at, vn)
            one = i
            u32 e = temp(w, b, bt, vn)
            _ = ir.op(&b.f, ir.O_BIN, ir.B_EQ, u32(types.P_U32), vn, e, tg, ir.konst(w.k.small(&w.t, i)))
            _ = ir.op(&b.f, ir.O_BIN, ir.B_OR, bt, vn, any, any, e)
        u32 h = open(w, b, ir.O_IF, c, any, false)
        b.heads[#len(b.heads) - 1].arm = true
        scope_in(w, b)
        if a.main[c] != NONE && spell(w, b, c) != "_" && one >= 0 && #len(vs) == 2:
            u32 mt = w.t.list(u)[one]
            string8 mn = named(w, mt)
            _ = chan_bound(w, b, c, mt, index.hold(#format("let the union hold `^", mn, "` or `ref ", mn, "` instead, so the arm binds a pointer to the one channel")))
            u32 sl = declare_local(w, b, w.p.sym(b.file, c), mt, c)
            if sl != NONE: b.locals[#len(b.locals) - 1].read = true
            if sl != NONE: _ = ir.op(&b.f, ir.O_CONV, ir.CV_MEMBER, mt, c, ir.at(&b.f, sl), x, u32(one))
        if !dupd || one >= 0: block(w, b, vs[0], false)
        scope_out(w, b)
        ir.otherwise(&b.f, h)
        opened = #append(opened, h)
    if ks[1] != NONE:
        if #len(opened) == 0:
            opened = #append(opened, open(w, b, ir.O_BLOCK, n, NONE, false))
            b.heads[#len(b.heads) - 1].arm = true
        block(w, b, ks[1])
    else:
        string8 left = ""
        []u32 ms = w.t.list(u)
        for i in 0..<#len(ms):
            bool named_ = false
            for s in seen:
                if s == i: named_ = true
            if named_: continue
            string8 sep = ", " if #len(left) > 0 else ""
            left = index.hold(#format(left, sep, "`", shown(w, w.t.list(u)[i]), "`"))
        if #len(left) > 0: say(w, b.file, b.base, a.lo[n], a.hi[ks[0]] + 1, 705, index.hold(#format("this `switch` over ", shown(w, v.ty), " has no `else`, and its arms leave ", left, " unnamed")), "name the missing members in arms, or write an `else`", "A `switch` over a union discriminant may omit its `else` only when the arms name every member, since the union is closed by construction")
        else if #len(opened) > 0: _ = ir.op(&b.f, ir.O_QUIT, 0, NONE, n, NONE, ir.konst(w.k.small(&w.t, 70)))
    i64 i = #len(opened)
    for i > 0:
        i -= 1
        close(w, b, opened[i])

// A `cunion`'s members as `` `T name` ``, joined.
string8 raw_members(^World w, u32 rw):
    []u32 ms = w.t.list(rw)
    []u32 ns = w.t.slot_names(rw)
    ref []string8 o
    for i in 0..<#len(ms):
        string8 nm = ""
        if i < #len(ns): nm = index.hold(#format(" ", w.t.text(ns[i])))
        o = #append(o, index.hold(#format("`", shown(w, ms[i]), nm, "`")))
    return index.hold(strings.join(o[:], ", "))
