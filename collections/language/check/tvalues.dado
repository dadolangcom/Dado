// Trait values: a trait as a slot or local is a view of an implementer
// (`data`) and the implementer's number (`type`); a method call on one is a
// call of a dispatch function, a switch over the implementers.
package check

import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:strings"

// One arm of a dispatch: an implementer's number, its method's C name,
// whether it takes `^self`, and the implementer's type.
type Arm:
    u32 number
    u32 cname
    bool pointer
    u32 ty

type Dispatch:
    u32 name
    u32 trait
    u32 method
    u32 fty
    ref []Arm arms

bool is_trait(^World w, u32 ty):
    u32 r = w.t.resolve(ty) if ty != NONE else NONE
    return r != NONE && w.t.tag[r] == types.T_TRAIT

// Implementer `ty`'s number in every trait value (1 and up; 0 is empty).
u32 impl_number(^World w, u32 ty):
    if ty in w.impl_no:
        try u32 x = w.impl_no[ty] else: return 0
        return x
    u32 x = u32(#len(w.impl_no)) + 1
    w.impl_no[ty] = x
    return x

u32 trait_decl(^World w, u32 ty):
    u32 r = w.t.resolve(ty)
    if !(r in w.type_decl): return NONE
    try u32 d = w.type_decl[r] else: return NONE
    return d

// `v` as trait value `ty`: a place of an implementer, or a pointer to one.
Val to_trait(^World w, ^Body b, Val v, u32 ty, u32 at):
    u32 t = trait_decl(w, ty)
    if t == NONE: return bad()
    u32 src = v.ty
    u32 r = w.t.resolve(v.ty)
    bool ptr = r != NONE && w.t.tag[r] == types.T_PTR && !implements(w, v.ty, t)
    if ptr: src = w.t.a[r]
    string8 tn = name_of(w, w.decls[t].name)
    if (w.t.quals(src) & 1) != 0:
        u32 inner = w.t.bare(src)
        string8 sh = shown(w, inner)
        if inner in w.type_decl:
            try u32 id = w.type_decl[inner] else: return bad()
            sh = name_of(w, w.decls[id].name)
        string8 wr = w.p.files[b.file].src[i64(tree(w, b).lo[at])..<i64(tree(w, b).hi[at])]
        string8 sp = trait_spelled(w, t, b.file, b.file)
        err(w, b, at, 606, index.hold(#format("`", wr, "` reaches a `const ", sh, "`, and a `", sp, "` may write its implementer — a `^self` method called through it writes where it points — so it views only storage that may be written")), index.hold(#format("convert a `^", sh, "` or a place that is not `const`, or copy it first: `", sh, " b = ", wr, "^" if ptr else "", "`, then `", sp, " d = b`")))
        return Val(V_VAL, NONE, NONE, 1, 0, 0)
    if !(src in w.type_decl) && w.t.tag[w.t.resolve(src)] == types.T_SLICE && is_trait(w, w.t.a[w.t.resolve(ty)]): return bad()
    string8 sp = trait_spelled(w, t, b.file, b.file)
    if !(src in w.type_decl):
        string8 im = an_implementer(w, t, b.file)
        string8 help = index.hold(#format("declare a `type` that writes `using ", sp, "` and type the value by it"))
        if im != "": help = index.hold(#format("type the value by an implementer — `", im, " b = …`, then `", sp, " d = b`"))
        err(w, b, at, 537, index.hold(#format("a `", sp, "` is made from an implementer, and this is `", shown(w, v.ty), "`, a shape with no declaration, which implements nothing\x1f`", sp, "` is answered by a declaration's `using`, so the value has to be typed by a declaration that writes `using ", tn, "`")), help)
        return Val(V_VAL, NONE, NONE, 1, 0, 0)
    if !implements(w, src, t):
        try u32 sd = w.type_decl[src] else: return bad()
        err(w, b, at, 537, index.hold(#format("a `", sp, "` is made from an implementer, and `", name_of(w, w.decls[sd].name), "` does not take `", sp, "` on")), using_repair(w, t, sd, b.file, sp, "convert"))
        return Val(V_VAL, NONE, NONE, 1, 0, 0)
    u32 bn = shape_binder(w, src)
    if bn != NONE:
        u64 key = (u64(w.envd) << 32) | u64(w.t.resolve(src))
        if key in w.shape_said: return Val(V_VAL, NONE, NONE, 1, 0, 0)
        w.shape_said[key] = 1
        string8 fname = name_of(w, w.decls[w.envd].name)
        string8 bs = name_of(w, bn)
        err(w, b, at, 922, index.hold(#format("this makes a `", tn, "` of a value of `", bs, "`, and `", fname, "` holds `", bs, "` as a shape, with no declaration to carry", "\x1f`put_global` is one instantiation for every declaration of `T`, so the pair would carry the first caller's declaration and every other declaration's value would call that one's methods")), index.hold(#format("add `where #is_declared(", bs, ")` to `", fname, "`'s header, and `", fname, "` is instantiated once per declaration")))
        return Val(V_VAL, NONE, NONE, 1, 0, 0)
    if ptr && !ir.is_const(v.opd):
        u32 q = temp(w, b, ty, at)
        _ = ir.op(&b.f, ir.O_MAKE, 0, ty, at, q, NONE)
        ir.arg(&b.f, v.opd)
        ir.arg(&b.f, ir.konst(w.k.small(&w.t, i64(impl_number(w, src)))))
        return value(q, ty)
    syntax.Ast a = tree(w, b)
    if embedded(w, b, at) != "" || ir.is_const(v.opd) || a.tag[at] == syntax.E_CALL || a.tag[at] == syntax.E_COND:
        try u32 sd = w.type_decl[src] else: return bad()
        string8 im = name_of(w, w.decls[sd].name)
        string8 help = ""
        if a.tag[at] == syntax.E_COND:
            []u32 cs = a.list(a.b[at])
            help = index.hold(#format("convert in each branch, where each value has a place: `", sp, " d = ", written(w, b, cs[0]), "` where `", written(w, b, cs[1]), "` holds and `", written(w, b, cs[2]), "` where it does not — a conditional's value is a temporary, and its two branches need not be one implementer"))
        else:
            ref []char8 low
            for i in 0..<#len(im):
                low = #append(low, char8(u8(im[i]) + 32) if i == 0 && im[i] >= 'A' && im[i] <= 'Z' else im[i])
            string8 fresh = index.hold(low)
            for find_local(w, b, w.p.names.intern(fresh), false) != NONE:
                fresh = index.hold(#format(fresh, "2"))
            help = index.hold(#format("bind it first: `", im, " ", fresh, " = ", written(w, b, at), "`, then `", sp, " d = ", fresh, "`"))
        err(w, b, at, 606, index.hold(#format("`", written(w, b, at), "` is a value with no place, and a `", sp, "` views its implementer where it is stored — a temporary or a constant is stored nowhere")), help)
        return Val(V_VAL, NONE, NONE, 1, 0, 0)
    if ir.is_const(v.opd) || a.tag[at] != syntax.E_NAME && a.tag[at] != syntax.E_FIELD && a.tag[at] != syntax.E_INDEX && a.tag[at] != syntax.E_DEREF:
        err(w, b, at, 1, "this conversion is outside the slice the port builds so far")
        return Val(V_VAL, NONE, NONE, 1, 0, 0)
    u32 root = b.f.root[v.opd]
    if (root & ir.ROOT_GLOBAL) == 0 && in_copied_self(w, b, v.opd):
        bool writes = false
        for x in needs(w, t):
            syntax.Ast na = w.p.files[w.decls[x.trait].file].a
            u32 rc = na.list(na.b[x.node])[3]
            if rc != NONE && na.a[rc] == 1: writes = true
        if writes:
            err(w, b, at, 615, index.hold(#format("a `", tn, "` made of `self` views it where it is stored, and a `^self` method called through the pair writes `self`, ", COPY_LOST(w, b))), self_help(w, b))
            return Val(V_VAL, NONE, NONE, 1, 0, 0)
    u32 pt = w.t.ptr_of(src)
    u32 p = temp(w, b, pt, at)
    if (root & ir.ROOT_GLOBAL) == 0: b.f.slot_flags[root] = b.f.slot_flags[root] | ir.S_ADDR_TAKEN
    _ = ir.op(&b.f, ir.O_ADDR, 0, pt, at, p, v.opd)
    u32 q = temp(w, b, ty, at)
    _ = ir.op(&b.f, ir.O_MAKE, 0, ty, at, q, NONE)
    ir.arg(&b.f, p)
    ir.arg(&b.f, ir.konst(w.k.small(&w.t, i64(impl_number(w, src)))))
    return value(q, ty)

// `v.data()` over an `Allocator` trait value: its two words.
Val trait_data(^World w, ^Body b, Val base, u32 n):
    u32 t = trait_decl(w, base.ty)
    u32 sym = w.p.names.intern("data")
    u32 node = NONE
    u32 owner = NONE
    for x in needs(w, t):
        if x.name == sym:
            node = x.node
            owner = x.trait
    if node == NONE: return bad()
    u32 fty = resolve(w, trait_method(w, owner, node))
    if fty == NONE: return bad()
    u32 p = spill(w, b, base, n)
    u32 dst = temp(w, b, alloc_ty(w), n)
    u32 r = ir.fn_ref(&b.f, tstr(w, ""), dispatch(w, t, sym, fty), ir.R_FOREIGN)
    _ = ir.op(&b.f, ir.O_CALL, 0, w.t.a[fty], n, dst, r, NONE, NONE)
    ir.arg(&b.f, p)
    return value(dst, alloc_ty(w))

// `v.m(args)` over a trait value: the dispatch function for `(trait, m)`.
Val trait_call(^World w, ^Body b, u32 n, u32 cn, Val base):
    u32 t = trait_decl(w, base.ty)
    u32 sym = w.p.sym(b.file, cn)
    u32 node = NONE
    u32 owner = NONE
    for x in needs(w, t):
        if x.name == sym:
            node = x.node
            owner = x.trait
    if node == NONE:
        err(w, b, cn, 410, index.hold(#format("`", name_of(w, w.decls[t].name), "` has no method `", spell(w, b, cn), "`")))
        return bad()
    syntax.Ast ta = w.p.files[w.decls[owner].file].a
    u32 rn = ta.list(ta.b[node])[0]
    if rn != NONE && ta.tag[rn] == syntax.T_NAME && w.p.spell(w.decls[owner].file, rn) == "Self":
        string8 tn = name_of(w, w.decls[t].name)
        err_tok(w, b, cn, 616, index.hold(#format("`", spell(w, b, cn), "` returns `Self`, which a `", tn, "` cannot name — a trait value knows its implementer only at run time")), index.hold(#format("call it through a binder, `render(", tn, " v)`, or on the implementer itself")))
        return bad()
    u32 md = trait_method(w, owner, node)
    u32 fty = resolve(w, md)
    if fty == NONE: return bad()
    []u32 all = w.t.params(fty)
    []u32 args = call_args(w, b, n)
    if #len(args) != #len(all) - 1:
        err(w, b, n, 601, index.hold(#format("`", name_of(w, w.decls[t].name), ".", spell(w, b, cn), "` takes ", #len(all) - 1, " argument(s) and this call writes ", #len(args))))
        return bad()
    ref []u32 opds
    opds = #append(opds, spill(w, b, base, n))
    _ = ir.op(&b.f, ir.O_CHECK, ir.CK_STALE, NONE, tree(w, b).a[cn], NONE, NONE, NONE)
    ir.arg(&b.f, opds[0])
    for i in 0..<#len(args):
        u32 vn = arg_value(w, b, args[i])
        Val v = coerce(w, b, expr(w, b, vn, all[i + 1]), all[i + 1], vn)
        if v.ty == NONE: return bad()
        opds = #append(opds, v.opd)
    for x in w.impls:
        u32 id = u32(x & 0xFFFFFFFF)
        if !reaches(w, u32(x >> 32), t, 0) || templated(w, id): continue
        u32 pa = NONE
        u32 pm = method(w, resolve(w, id), sym, &pa)
        if pm != NONE && pa == NONE && names_caller(w, pm):
            string8 ml = fn_label(w, pm)
            err_tok(w, b, cn, 822, index.hold(#format("`", spell(w, b, cn), "` is called through a `", name_of(w, w.decls[t].name), "` here, and `", ml, "` names `#caller` in its body — a call through a trait value does not know which implementer it reaches, so it cannot hand over the caller's allocator")), index.hold(#format("call `", spell(w, b, cn), "` on the implementer directly, or have `", ml, "` take the allocator as a parameter — the two words `(proc, data)`, or the `Allocator` trait as a binder — in place of `#caller`")))
            return bad()
        if pm == NONE || pa == NONE: continue
        string8 im = name_of(w, w.decls[id].name)
        string8 mn = spell(w, b, cn)
        err_tok(w, b, cn, 1, index.hold(#format("`", mn, "` reaches `", im, "` through a trait value by a method embedding promotes from `", name_of(w, w.decls[w.decls[pm].block].name), "`, which is not implemented", "\x1fThe pair points at the implementer, whose embedded member's slots are spliced in rather than held as one value")), index.hold(#format("write `", mn, "` in `", im, "`'s own body, calling the embedded member's")))
        return bad()
    u32 dn = dispatch(w, t, sym, fty)
    u32 ret = w.t.a[fty]
    bool void_ = ret == u32(types.P_VOID)
    u32 dst = NONE if void_ else temp(w, b, ret, n)
    u32 code = NONE if w.t.b[fty] == types.F_NONE else temp(w, b, code_type(w, fty), n)
    u32 r = ir.fn_ref(&b.f, tstr(w, ""), dn, ir.R_FOREIGN)
    _ = ir.op(&b.f, ir.O_CALL, 0, ret, n, dst, r, NONE, code)
    for x in opds:
        ir.arg(&b.f, x)
    if code != NONE:
        string8 callee = index.hold(#format(name_of(w, w.decls[t].name), ".", spell(w, b, cn)))
        if !failable_call(w, b, n, callee, code): return bad()
    if void_: return Val(V_VAL, NONE, ret, NONE, 0, 0)
    return value(dst, ret)

// The declaration of trait `t`'s method at `node`, made once.
private u32 trait_method(^World w, u32 t, u32 node):
    u64 key = (u64(t) << 32) | u64(node)
    if key in w.tmethods:
        try u32 d = w.tmethods[key] else: return NONE
        return d
    u32 f = w.decls[t].file
    u32 d = u32(#len(w.decls))
    w.decls = #append(w.decls, Decl(w.p.sym(f, node), K_METHOD, w.decls[t].pkg, f, node, t, 0, NONE, false, NONE))
    w.tmethods[key] = d
    return d

// The C name of trait `t`'s dispatch for method `sym`, its arms gathered once.
private u32 dispatch(^World w, u32 t, u32 sym, u32 fty):
    string8 pn = name_of(w, w.p.pkgs[w.decls[t].pkg].name) if w.p.pkgs[w.decls[t].pkg].name != NONE else "main"
    u32 name = tstr(w, index.hold(#format("dado_dispatch_", mangle(pn), "_", mangle(name_of(w, w.decls[t].name)), "_", mangle(name_of(w, sym)))))
    for d in w.dispatches:
        if d.name == name: return name
    w.dispatches = #append(w.dispatches, Dispatch(name, t, sym, fty, nil))
    return name

// Every dispatch's arms, once the bodies are checked: each implementer of
// its trait (each instance of a generic one) and its method's job. Answers
// whether a job was added.
bool settle_dispatches(^World w):
    i64 before = #len(w.jobs)
    // A generic implementer's instances, in the order they were made (a type's
    // number), not the map's: an arm's place gives its job and its number, so
    // the map's order, which changes with the hash seed, reached the C.
    ref []u64 insts
    defer #delete(insts)
    for i in 0..<#len(w.dispatches):
        Dispatch dp = w.dispatches[i]
        #truncate(w.dispatches[i].arms, 0)
        for x in w.impls:
            if !reaches(w, u32(x >> 32), dp.trait, 0): continue
            u32 id = u32(x & 0xFFFFFFFF)
            if !templated(w, id):
                arm(w, i, resolve(w, id), NONE)
                continue
            #truncate(insts, 0)
            for ity, env in w.inst_env:
                if ity in w.type_decl:
                    try u32 dd = w.type_decl[ity] else: continue
                    if dd == id: insts = #append(insts, (u64(ity) << 32) | u64(env))
            for a in 1..<#len(insts):
                u64 k = insts[a]
                i64 j = a - 1
                for j >= 0 && insts[j] > k:
                    insts[j + 1] = insts[j]
                    j -= 1
                insts[j + 1] = k
            for k in insts:
                arm(w, i, u32(k >> 32), u32(k & 0xFFFFFFFF))
    return #len(w.jobs) > before

private void arm(^World w, i64 i, u32 ity, u32 env):
    u32 at = NONE
    u32 m = method(w, ity, w.dispatches[i].method, &at)
    if m == NONE: return
    syntax.Ast ma = w.p.files[w.decls[m].file].a
    u32 rc = ma.list(ma.b[w.decls[m].node])[3]
    w.dispatches[i].arms = #append(w.dispatches[i].arms, Arm(impl_number(w, ity), job(w, m, env), rc != NONE && ma.a[rc] == 1, ity))

// An implementer of trait `t` to name in a repair, or "".
string8 some_implementer(^World w, u32 t):
    for x in w.impls:
        if u32(x >> 32) == t: return name_of(w, w.decls[u32(x & 0xFFFFFFFF)].name)
    return ""

// The binder of the instance being checked that `ty` binds as a shape (no
// `where #is_declared`), or NONE.
private u32 shape_binder(^World w, u32 ty):
    if w.env == NONE || w.envd == NONE || nominal(w, w.envd): return NONE
    u32 x = where_of(w, w.envd)
    if x != NONE:
        syntax.Ast a = w.p.files[w.decls[w.envd].file].a
        if strings.contains(w.p.files[w.decls[w.envd].file].src[i64(a.lo[x])..<i64(a.hi[x])], "#is_declared"): return NONE
    []u32 bs = binders(w, w.envd)
    []u32 vs = w.t.list(w.env)
    for i in 0..<#len(bs):
        if i < #len(vs) && vs[i] == ty && binder_kind(w, w.envd, i) == BK_TYPE: return bs[i]
    return NONE

// ERR0922: inside an instance holding a binder as a shape, a call handing it
// to template `d`, which asks the declaration of the binder it fills.
bool unforwarded(^World w, ^Body b, u32 n, u32 d, u32 env, []u32 args, []u32 ps):
    u32 f = w.decls[d].file
    syntax.Ast ca = w.p.files[f].a
    string8 dsrc = w.p.files[f].src[i64(ca.lo[w.decls[d].node])..<i64(ca.hi[w.decls[d].node])]
    []u32 bs = binders(w, d)
    []u32 vs = w.t.list(env)
    for i in 0..<#len(bs):
        if i >= #len(vs) || binder_kind(w, d, i) != BK_TYPE: continue
        string8 un = name_of(w, bs[i])
        if !strings.contains(dsrc, index.hold(#format("#names(", un, ")"))): continue
        u32 held = shape_binder(w, vs[i])
        if held == NONE: continue
        // A caller asking a declaration itself is instantiated per declaration.
        syntax.Ast oa = w.p.files[w.decls[w.envd].file].a
        u32 ob = oa.list(oa.b[w.decls[w.envd].node])[5]
        if ob != NONE && strings.contains(w.p.files[w.decls[w.envd].file].src[i64(oa.lo[ob])..<i64(oa.hi[ob])], "#names("): continue
        string8 hn = name_of(w, held)
        // A `type T` parameter: its argument is the call's own, as written.
        []u32 qs = ca.list(ca.b[w.decls[d].node])
        syntax.Ast ta = tree(w, b)
        []u32 raw = ta.list(ta.b[n])
        if #len(qs) > 6:
            qs = qs[6..<#len(qs)]
            for p in 0..<#len(qs):
                if qs[p] == NONE || !kind_at(&ca, qs, p) || w.p.spell(f, qs[p]) != un || 2 + p >= #len(raw): continue
                u32 av = raw[2 + p]
                if ta.tag[av] == syntax.E_ARG: av = ta.a[av]
                if refuse_forward(w, b, d, av, un, hn): return true
        for p in 0..<#len(ps):
            if p >= #len(args) || ps[p] == NONE: continue
            bool fills = w.p.spell(f, ps[p]) == un && kind_at(&ca, ps, p)
            if !fills && ca.a[ps[p]] != NONE:
                string8 pt = w.p.files[f].src[i64(ca.lo[ca.a[ps[p]]])..<i64(ca.hi[ca.a[ps[p]]])]
                fills = strings.contains(pt, index.hold(#format("$", un)))
            if !fills: continue
            if refuse_forward(w, b, d, arg_value(w, b, args[p]), un, hn): return true
    return false

private bool refuse_forward(^World w, ^Body b, u32 d, u32 av, string8 un, string8 hn):
    u64 key = (u64(w.envd) << 32) | u64(d | 0x80000000)
    if key in w.shape_said: return true
    w.shape_said[key] = 1
    string8 passed = index.hold(#format("a value of `", hn, "`"))
    if tree(w, b).tag[av] == syntax.E_NAME && spell(w, b, av) == hn: passed = index.hold(#format("`", hn, "`"))
    string8 own = name_of(w, w.decls[w.envd].name)
    err(w, b, av, 922, index.hold(#format("this passes ", passed, " to `", name_of(w, w.decls[d].name), "`, which asks the declaration of its `", un, "`, and `", own, "` has none to hand over\x1f`", own, "` holds `", hn, "` as a shape, one instantiation for every declaration of it. A template that forwards a binding to one that asks its declaration carries the declaration itself: with the `where`, `", own, "` is instantiated once per declaration and passes its caller's on")), index.hold(#format("add `where #is_declared(", hn, ")` to `", own, "`'s header")))
    return true

// Whether template `d` writes a trait, or a type holding a trait value, in
// its header or a declaration: then it is instantiated per declaration.
private bool nominal(^World w, u32 d):
    if d in w.nominal:
        try u8 x = w.nominal[d] else: return false
        return x == 1
    w.nominal[d] = 0
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    []u32 ks = a.list(a.b[w.decls[d].node])
    bool y = writes_trait(w, f, ks[0])
    if #len(ks) > 6:
        for q in ks[6..<#len(ks)]:
            if q != NONE && writes_trait(w, f, a.a[q]): y = true
    if #len(ks) > 5 && lets_trait(w, f, ks[5]): y = true
    w.nominal[d] = 1 if y else 0
    return y

private bool lets_trait(^World w, u32 f, u32 n):
    if n == NONE: return false
    syntax.Ast a = w.p.files[f].a
    if a.tag[n] == syntax.S_LET && writes_trait(w, f, a.list(a.b[n])[0]): return true
    ref []u32 kids
    a.kids(n, &kids)
    for k in kids:
        if lets_trait(w, f, k): return true
    return false

private bool writes_trait(^World w, u32 f, u32 n):
    if n == NONE: return false
    syntax.Ast a = w.p.files[f].a
    if a.tag[n] == syntax.T_NAME || a.tag[n] == syntax.T_PATH:
        u32 x = using_decl(w, f, n)
        if x != NONE && w.decls[x].kind == K_TRAIT: return true
        if x != NONE && w.decls[x].kind == K_TYPE && !templated(w, x) && holds_trait(w, resolve(w, x), 0): return true
    ref []u32 kids
    a.kids(n, &kids)
    for k in kids:
        if writes_trait(w, f, k): return true
    return false

private bool holds_trait(^World w, u32 ty, i64 depth):
    u32 r = w.t.resolve(ty) if ty != NONE else NONE
    if r == NONE || depth > 8: return false
    if w.t.tag[r] == types.T_TRAIT: return true
    if w.t.tag[r] != types.T_TUPLE: return false
    for s in w.t.slots(r):
        if holds_trait(w, s, depth + 1): return true
    return false

private string8 written(^World w, ^Body b, u32 n):
    return src(w, b, n)
