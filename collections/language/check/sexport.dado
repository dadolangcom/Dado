// `export` in scripts, its checks: what a package
// of scripts publishes, refused (ERR1340) where a declaration cannot say it.
package check

import "language:diag"
import "language:index"
import "language:syntax"
import "language:types"
import "core:strings"

private bool sx_exported(^World w, u32 f, u32 n):
    return (w.p.files[f].a.a[n] & syntax.F_VIS) == syntax.VIS_EXPORT

// Why a published `ty` has no declaration's spelling: `cross` 0 in, 1 out, 2 both.
private string8 sx_problem(^World w, u32 ty, u8 cross, ^string8 help):
    if ty == NONE: return ""
    u8 k = s_kind(w, ty)
    u32 r = w.t.resolve(ty)
    if k == 1:
        if w.t.a[r] == u32(types.P_U8): return ""
        return sx_problem(w, w.t.a[r], cross, help)
    if k == 2:
        string8 p = sx_problem(w, w.t.a[r], cross, help)
        if #len(p) > 0: return p
        return sx_problem(w, w.t.b[r], cross, help)
    u32 inner = sa_inner(w, ty)
    if inner != NONE:
        if cross != 1:
            help^ = "take the value itself and let the caller `await` it first, or answer the `async` value instead"
            return index.hold(#format("`", shown(w, ty), "` would be a promise a JavaScript caller hands the script, which the boundary cannot check before it settles"))
        if inner == u32(types.P_VOID): return ""
        return sx_problem(w, inner, cross, help)
    if s_fn(w, ty):
        u8 fl = cross
        if cross == 0: fl = 1
        else if cross == 1: fl = 0
        for p in w.t.params(r):
            string8 x = sx_problem(w, p, fl, help)
            if #len(x) > 0: return x
        if w.t.a[r] == u32(types.P_VOID): return ""
        return sx_problem(w, w.t.a[r], cross, help)
    if ty == w.serror || ty == w.sloc || ty == w.sany: return ""
    u32 ci = s_class_of_ty(w, ty)
    if ci != NONE:
        u32 cd = w.classes[ci].decl
        if sx_exported(w, w.decls[cd].file, w.decls[cd].node) && s_outer(w, ci) == NONE: return ""
        string8 cn = name_of(w, w.decls[cd].name)
        help^ = index.hold(#format("write `export class ", cn, "` to publish it too, or answer what a JavaScript caller needs of it — its fields, or `any`"))
        return index.hold(#format("`", cn, "` is a class that is not exported, so the package declares no type for it"))
    bool sf = false
    if st_of_ty(w, ty, &sf) != NONE:
        help^ = "take or answer an exported class that takes the trait on, or `any`"
        return index.hold(#format("`", shown(w, ty), "` is a trait value, for which the package declares no type"))
    if s_enum(w, ty): return ""
    if s_tup(w, ty):
        for x in w.t.slots(ty):
            string8 p = sx_problem(w, x, cross, help)
            if #len(p) > 0: return p
        return ""
    if ty == w.sstr || r == u32(types.P_INT) || r == u32(types.P_FLOAT) || r == u32(types.P_BOOL): return ""
    if r == u32(types.P_VOID) && cross == 1: return ""
    help^ = "publish a scalar, an array, a map, a tuple, an enum, `any` or an exported class instead"
    return index.hold(#format("`", shown(w, ty), "` has no spelling in a declaration"))

// A method's parameters (In) and answer (Out), published as `what`.
private void sx_signature(^World w, u32 m, string8 what):
    u32 ft = resolve(w, m)
    if ft == NONE: return
    u32 f = w.decls[m].file
    syntax.Ast a = w.p.files[f].a
    []u32 ks = a.list(a.b[w.decls[m].node])
    []u32 qs = ks[6..<#len(ks)]
    ref []u32 ps = s_mparams(w, ft)
    w.d.phase = diag.PH_INTERFACE
    for i in 0..<#len(ps):
        string8 h = ""
        string8 p = sx_problem(w, ps[i], 0, &h)
        if #len(p) == 0 || i >= #len(qs): continue
        u32 tn = a.a[qs[i]]
        if tn == NONE: tn = qs[i]
        say(w, f, 0, a.lo[tn], a.hi[tn], 1340, index.hold(#format("the parameter `", w.p.spell(f, qs[i]), "` of ", what, " is published, and ", p)), h)
    string8 h = ""
    string8 p = sx_problem(w, w.t.a[ft], 1, &h)
    if #len(p) > 0 && ks[0] != NONE: say(w, f, 0, a.lo[ks[0]], a.hi[ks[0]], 1340, index.hold(#format("what ", what, " answers is published, and ", p)), h)

private bool sx_publishes(^World w, u32 f, u32 n):
    u32 v = w.p.files[f].a.a[n] & syntax.F_VIS
    return v == syntax.VIS_UNMARKED || v == syntax.VIS_PUBLIC || v == syntax.VIS_EXPORT

// The first expression of method `m`'s body that reaches `self`, or NONE.
private u32 sx_reaches(^World w, u32 ci, u32 m):
    u32 f = w.decls[m].file
    syntax.Ast a = w.p.files[f].a
    u32 body = a.list(a.b[w.decls[m].node])[5]
    if body == NONE: return NONE
    ref []u32 locals
    []u32 ks = a.list(a.b[w.decls[m].node])
    for q in ks[6..<#len(ks)]:
        if q != NONE: locals = #append(locals, w.p.sym(f, q))
    ref []u32 todo
    todo = #append(todo, body)
    ref []u32 order
    for #len(todo) > 0:
        u32 n = todo[#len(todo) - 1]
        #truncate(todo, #len(todo) - 1)
        if n == NONE: continue
        order = #append(order, n)
        if a.tag[n] == syntax.S_LET && a.main[n] != NONE: locals = #append(locals, w.p.sym(f, n))
        ref []u32 kids
        a.kids(n, &kids)
        i64 i = #len(kids)
        for i > 0:
            i -= 1
            todo = #append(todo, kids[i])
    for n in order:
        u8 g = a.tag[n]
        if g == syntax.E_CALL:
            u32 c = a.list(a.b[n])[0]
            if a.tag[c] == syntax.E_FIELD && a.tag[a.a[c]] == syntax.E_NAME && w.p.spell(f, a.a[c]) == "self": return n
            if a.tag[c] == syntax.E_NAME && !sx_has(locals[:], w.p.sym(f, c)) && s_method_in(w, ci, w.p.sym(f, c)) != NONE: return n
        if g == syntax.E_FIELD && a.tag[a.a[n]] == syntax.E_NAME && w.p.spell(f, a.a[n]) == "self": return n
        if g == syntax.E_NAME:
            string8 s = w.p.spell(f, n)
            if s == "self" || s == "super": return n
            if sx_has(locals[:], w.p.sym(f, n)): continue
            for x in s_fields_of(w, ci):
                if x.sym == w.p.sym(f, n): return n
    return NONE

private bool sx_has([]u32 xs, u32 x):
    for y in xs:
        if y == x: return true
    return false

// Every class's published surface, checked.
void sx_publish(^World w):
    {u32: u8} seen
    ref []string8 names
    ref []string8 whats
    for ci in 0..<#len(w.classes):
        u32 cd = w.classes[ci].decl
        u32 cf = w.decls[cd].file
        string8 cn = name_of(w, w.decls[cd].name)
        bool exported = sx_exported(w, cf, w.decls[cd].node)
        w.d.phase = diag.PH_INTERFACE
        if exported && s_outer(w, u32(ci)) != NONE:
            i64 dot = strings.last_index_of(cn, '.')
            say_tok(w, cf, 0, w.decls[cd].node, 1340, index.hold(#format("`export class ", cn, "` publishes an inner class, which a JavaScript caller would reach by a name holding a `.`")), index.hold(#format("move `", cn, "` to a `.dados` file of its own, `export class ", cn[dot + 1..<#len(cn)], "`, or leave it unexported and publish what it answers through its outer class")))
            continue
        if exported:
            if !sx_name(w, cf, w.decls[cd].node, cn, index.hold(#format("the class `", cn, "`")), &names, &whats): pass
            u32 init = s_method_in(w, u32(ci), w.p.names.intern("init"))
            if init != NONE: sx_signature(w, init, index.hold(#format("`", cn, "`'s constructor")))
            ref []u32 done
            u32 at = u32(ci)
            for _ in 0..<64:
                if at == NONE: break
                for m in w.classes[at].methods:
                    if name_of(w, w.decls[m].name) == "init" || sx_has(done[:], w.decls[m].name): continue
                    done = #append(done, w.decls[m].name)
                    u32 r = s_method_in(w, u32(ci), w.decls[m].name)
                    if r != NONE && sx_publishes(w, w.decls[r].file, w.decls[r].node): sx_signature(w, r, index.hold(#format("`", cn, ".", name_of(w, w.decls[r].name), "`")))
                at = s_parent(w, at)
            ref []u32 ffs
            ref []u32 fns
            s_all_fields(w, u32(ci), &ffs, &fns)
            u32 row = resolve(w, cd)
            []u32 fts = w.t.slots(row)
            for k in 0..<#len(fns):
                if !sx_publishes(w, ffs[k], fns[k]) || k >= #len(fts): continue
                string8 h = ""
                string8 p = sx_problem(w, fts[k], 2, &h)
                if #len(p) == 0: continue
                syntax.Ast fa = w.p.files[ffs[k]].a
                u32 tn = fa.list(fa.b[fns[k]])[0]
                say(w, ffs[k], 0, fa.lo[tn], fa.hi[tn], 1340, index.hold(#format("the field `", cn, ".", w.p.spell(ffs[k], fns[k]), "` is published by `export class ", cn, "`, and ", p)), h)
        // Members marked `export`.
        syntax.Ast a = w.p.files[cf].a
        for m in w.classes[ci].gens:
            if !sx_exported(w, cf, w.decls[m].node): continue
            say_tok(w, cf, 0, w.decls[m].node, 1340, index.hold(#format("`export` publishes `", cn, ".", name_of(w, w.decls[m].name), "`, a generic method, which has a signature per instantiation and none a declaration can say")), "write `private` on it and export a method of fixed types that calls it, or take `any`")
        for m in w.classes[ci].methods:
            if !sx_exported(w, cf, w.decls[m].node): continue
            string8 mn = name_of(w, w.decls[m].name)
            u32 rs = sx_reaches(w, u32(ci), m)
            if rs == NONE && mn != "init":
                string8 what = index.hold(#format("the function `", mn, "` (`", cn, ".", mn, "`)"))
                if sx_name(w, cf, w.decls[m].node, mn, what, &names, &whats) && !exported: sx_signature(w, m, what)
            else if rs != NONE && !exported:
                say_tok(w, cf, 0, w.decls[m].node, 1340, index.hold(#format("`export` on `", cn, ".", mn, "` publishes it as a function, and it reaches `self` through `", w.p.files[cf].src[i64(a.lo[rs])..<i64(a.hi[rs])], "`, while `", cn, "` is not exported, so there is no instance to call it on")), index.hold(#format("write `export class ", cn, "` to publish the class with the method, or pass what the method reads as parameters")))
        if exported: continue
        for x in w.classes[ci].fields:
            if !sx_exported(w, cf, x): continue
            say_tok(w, cf, 0, x, 1340, index.hold(#format("`export` on the field `", cn, ".", w.p.spell(cf, x), "` publishes it, and a field is published only with its class, which is not exported")), index.hold(#format("write `export class ", cn, "`, or write `public` on the field")))
    #delete(seen)

// One name `index.js` exports; false (refused) when taken.
private bool sx_name(^World w, u32 f, u32 n, string8 nm, string8 what, ^ref []string8 names, ^ref []string8 whats):
    for i in 0..<#len(names^):
        if names^[i] != nm: continue
        say_tok(w, f, 0, n, 1340, index.hold(#format(what, " is published as `", nm, "`, and ", whats^[i], " is published under that name already: the package's `index.js` exports one item per name")), "rename one of them, or leave one unexported")
        return false
    names^ = #append(names^, nm)
    whats^ = #append(whats^, what)
    return true

// Whether method `m` of class `ci` is published as a package function: it reaches no `self`.
bool s_published_fn(^World w, u32 ci, u32 m):
    return sx_reaches(w, ci, m) == NONE
