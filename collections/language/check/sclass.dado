// A script class's `super`: `super(…)` as a
// statement of `init`, `super.m(…)`, the parent's argument-free `init` run
// first by an `init` that writes none, and `super` refused as a value.
package check

import "language:diag"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:strings"

// The parent of `b`'s class, or NONE after ERR1310 (none for a refused `extends`).
private u32 sc_parent(^World w, ^Body b, u32 at):
    u32 p = s_parent(w, b.cls)
    if p != NONE || w.classes[b.cls].pnode != NONE: return p
    string8 cn = name_of(w, w.decls[w.classes[b.cls].decl].name)
    err(w, b, at, 1310, index.hold(#format("`super` reaches the class `", cn, "` extends, and `", cn, "` extends `Script` alone, whose methods a script does not call through `super`")), index.hold(#format("call `", cn, "`'s own methods — `m(…)` or `self.m(…)` — or make `", cn, "` extend a script class, `class ", cn, " extends Base`")))
    return NONE

// The first `super(…)` statement of method `d`'s own body, if it is `init`.
u32 sc_top_super(^World w, u32 d):
    if name_of(w, w.decls[d].name) != "init": return NONE
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u32 bn = a.list(a.b[w.decls[d].node])[5]
    if bn == NONE || a.tag[bn] != syntax.S_BLOCK: return NONE
    for s in a.list(a.b[bn]):
        if s == NONE || a.tag[s] != syntax.S_EXPR: continue
        u32 e = a.a[s]
        if a.tag[e] == syntax.E_CALL && a.tag[a.list(a.b[e])[0]] == syntax.E_NAME && w.p.spell(f, a.list(a.b[e])[0]) == "super": return e
    return NONE

// `super(…)` (`c` NONE) or `super.m(…)` (`c` the callee).
Val sc_call(^World w, ^Body b, u32 n, u32 c):
    syntax.Ast a = tree(w, b)
    u32 sn = a.list(a.b[n])[0]
    if c != NONE: sn = a.a[c]
    u32 p = sc_parent(w, b, sn)
    if p == NONE:
        for g in call_args(w, b, n):
            _ = expr(w, b, arg_value(w, b, g), NONE)
        return bad()
    string8 pn = name_of(w, w.decls[w.classes[p].decl].name)
    u32 m = NONE
    string8 mn = "super"
    if c == NONE:
        bool in_init = name_of(w, w.decls[b.decl].name) == "init"
        if !in_init || sc_top_super(w, b.decl) != n:
            for g in call_args(w, b, n):
                _ = expr(w, b, arg_value(w, b, g), NONE)
            if in_init: err(w, b, n, 1310, index.hold(#format("`super(…)` runs `", pn, "`'s construction, so it is written as a statement of `init`'s own body — not inside a block or an expression, and once")), "write `super(…)` once, as a line of `init` itself")
            else: err(w, b, n, 1310, index.hold(#format("`super(…)` runs `", pn, "`'s construction, so it is written in `init`, the construction it is part of")), index.hold(#format("call a method of `", pn, "` instead — `super.m(…)` — or move this into `init`")))
            return bad()
        m = s_method_in(w, p, w.p.names.intern("init"))
    else:
        mn = index.hold(strings.clone(spell(w, b, c)))
        if mn == "init":
            for g in call_args(w, b, n):
                _ = expr(w, b, arg_value(w, b, g), NONE)
            err_tok(w, b, c, 1310, "`super.init(…)` is spelled `super(…)`: the parent's construction, written in `init`", "write `super(…)` as a line of `init`")
            return bad()
        m = s_method_in(w, p, w.p.sym(b.file, c))
        if m != NONE && templated(w, m): return sg_elsewhere(w, b, n, c, m)
        if m == NONE:
            for g in call_args(w, b, n):
                _ = expr(w, b, arg_value(w, b, g), NONE)
            sc_no_method(w, b, c, p)
            return bad()
    ref []u32 opds
    Val sv = s_self(w, b, n)
    if sv.ty == NONE: return bad()
    opds = #append(opds, sv.opd)
    u32 rt = u32(types.P_VOID)
    if m != NONE:
        if !s_args(w, b, n, m, mn, &opds): return bad()
        u32 ft = resolve(w, m)
        rt = w.t.a[ft]
    []u32 cas = call_args(w, b, n)
    i64 na = #len(cas)
    if m == NONE && na > 0:
        err(w, b, n, 601, index.hold(#format("`super` takes 0 arguments and this call passes ", na)), "pass one value for each: `super()`")
        return bad()
    u32 t = NONE
    if rt != u32(types.P_VOID): t = temp(w, b, rt, n)
    string8 tn = "init"
    if c != NONE: tn = mn
    u32 r = ir.fn_ref(&b.f, b.f.pkg, tstr(w, index.hold(strings.clone(tn))), 0)
    _ = ir.op(&b.f, ir.O_CALL, 1, rt, n, t, r)
    for o in opds:
        ir.arg(&b.f, o)
    return value(t, rt)

// ERR0405: no method `c` names in class `ci`'s chain.
private void sc_no_method(^World w, ^Body b, u32 c, u32 ci):
    ref []string8 pool
    u32 at = ci
    for _ in 0..<64:
        if at == NONE: break
        for m in w.classes[at].methods:
            pool = #append(pool, name_of(w, w.decls[m].name))
        at = s_parent(w, at)
    string8 cn = name_of(w, w.decls[w.classes[ci].decl].name)
    string8 s = spell(w, b, c)
    string8 help = nearest(s, pool[:])
    if #len(help) > 0: help = index.hold(#format("did you mean `", help, "`?"))
    else if #len(pool) == 0: help = index.hold(#format("`", cn, "` has no methods; declare one in the class"))
    else:
        ref []string8 ls
        for x in pool:
            ls = #append(ls, index.hold(#format("`", x, "`")))
        help = index.hold(#format("the methods of `", cn, "` are ", strings.join(ls[:], ", ")))
    err_tok(w, b, c, 405, index.hold(#format("`", cn, "` has no method `", s, "`")), help)

// `super` read as a value or a field: ERR1310.
Val sc_value(^World w, ^Body b, u32 n, u32 sn):
    if sc_parent(w, b, sn) == NONE: return bad()
    err(w, b, n, 1310, "`super` is not a value: it calls the parent's methods, `super.hit(n)`, and its construction, `super(…)` in `init`", "reach an inherited field as `hp` or `self.hp`, and pass the instance itself as `self`")
    return bad()

// Before `init`'s body: with no `super(…)`, the parent's `init` runs first
// when it takes nothing (`w.simplicit`), else ERR1310.
void sc_enter(^World w, ^Body b):
    if b.cls == NONE || name_of(w, w.decls[b.decl].name) != "init" || sc_top_super(w, b.decl) != NONE: return
    u32 p = s_parent(w, b.cls)
    if p == NONE: return
    u32 m = s_method_in(w, p, w.p.names.intern("init"))
    if m == NONE: return
    []u32 ps = params(w, m)
    if #len(ps) == 0:
        w.simplicit[b.cls] = 1
        return
    string8 cn = name_of(w, w.decls[w.classes[b.cls].decl].name)
    string8 on = name_of(w, w.decls[w.decls[m].block].name)
    u32 mf = w.decls[m].file
    ref []string8 pns
    for q in ps:
        pns = #append(pns, w.p.spell(mf, q))
    string8 art = h_article(on)
    string8 pl = "s"
    if #len(ps) == 1: pl = ""
    say_tok(w, b.file, 0, w.decls[b.decl].node, 1310, index.hold(#format("`", cn, "`'s `init` constructs ", art, " `", on, "` too, whose `init` takes ", #len(ps), " argument", pl, ", so it passes them with `super(…)`")), index.hold(#format("write `super(", strings.join(pns[:], ", "), ")` as the first line of `", cn, "`'s `init`")))

// Whether an instance of class type `got` is one of `want`: `want` is in its chain.
bool sc_upcast(^World w, u32 got, u32 want):
    u32 g = s_class_of_ty(w, got)
    u32 c = s_class_of_ty(w, want)
    if g == NONE || c == NONE: return false
    for _ in 0..<64:
        if g == NONE: return false
        if g == c: return true
        g = s_parent(w, g)
    return false

// A subclass's field naming an inherited one (ERR0409), and an override of
// another signature (ERR1310).
void sc_rules(^World w):
    for ci in 0..<#len(w.classes):
        u32 p = s_parent(w, u32(ci))
        if p == NONE: continue
        u32 f = w.classes[ci].file
        string8 cn = name_of(w, w.decls[w.classes[ci].decl].name)
        w.d.phase = diag.PH_INTERFACE
        for x in w.classes[ci].fields:
            u32 at = p
            for _ in 0..<64:
                if at == NONE: break
                bool hit = false
                string8 via = ""
                for y in w.classes[at].fields:
                    if w.p.sym(w.classes[at].file, y) == w.p.sym(f, x): hit = true
                for e in w.classes[at].embs:
                    if e.ty == NONE: continue
                    for j in 0..<#len(e.syms):
                        if e.live[j] && e.syms[j] == w.p.sym(f, x):
                            hit = true
                            via = index.hold(#format(" (of the `", w.p.spell(w.classes[at].file, e.node), "` it embeds)"))
                if hit:
                    say_tok(w, f, 0, x, 409, index.hold(#format("`", w.p.spell(f, x), "` is already a field of `", name_of(w, w.decls[w.classes[at].decl].name), "`", via, ", which `", cn, "` extends: a subclass has its parent's fields, and one name is one field")), "use the inherited field — set it in `init` — or give this one a name of its own")
                    break
                at = s_parent(w, at)
        for m in w.classes[ci].methods:
            string8 mn = name_of(w, w.decls[m].name)
            if mn == "init": continue
            u32 o = s_method_in(w, p, w.decls[m].name)
            if o == NONE || w.decls[w.decls[o].block].kind != K_CLASS: continue
            u32 mt = resolve(w, m)
            u32 ot = resolve(w, o)
            if mt == NONE || ot == NONE: continue
            ref []u32 mp = s_mparams(w, mt)
            ref []u32 op = s_mparams(w, ot)
            bool same = #len(mp) == #len(op) && w.t.a[mt] == w.t.a[ot]
            if same:
                for i in 0..<#len(mp):
                    if mp[i] != op[i]: same = false
            if same: continue
            string8 theirs = st_sig_written(w, o, NONE)
            say_tok(w, f, 0, w.decls[m].node, 1310, index.hold(#format("`", cn, ".", mn, "` overrides `", name_of(w, w.decls[w.decls[o].block].name), ".", mn, "`, which is `", theirs, "`, and this is `", st_sig_written(w, m, NONE), "`: an override is called wherever the method it overrides is, so it takes and answers what that one does")), index.hold(#format("write it `", theirs, "`, or give it a name of its own so it overrides nothing")))
