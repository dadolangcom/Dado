// A type's slot names and an instance's slots in scripts:
// `T.names()` folded into an array of its names,
// and `for name, value in slots(v)` (`O_LOOP` sub 3 an instance, 4 an `any`).
package check

import "language:index"
import "language:ir"
import "language:syntax"
import "core:strings"

// The declaration a written path `x` names as a type (a class, an enum, a Dado type), or NONE.
private u32 sr_decl(^World w, ^Body b, u32 x):
    syntax.Ast a = tree(w, b)
    string8 tx = index.hold(strings.clone(src(w, b, x)))
    u32 d = lookup(w, w.p.files[b.file].pkg, w.p.names.intern(tx))
    if d != NONE && typeish(w.decls[d].kind): return d
    if a.tag[x] == syntax.E_NAME:
        d = bare(w, b.file, x)
        if d != NONE && typeish(w.decls[d].kind): return d
        return NONE
    if a.tag[x] != syntax.E_FIELD: return NONE
    ref []u32 eps = s_epath(w, b.file, x)
    d = s_path_decl(w, b.file, eps[:])
    if d != NONE && typeish(w.decls[d].kind): return d
    d = lookup(w, w.p.files[b.file].pkg, w.p.sym(b.file, x))
    if d == NONE || !typeish(w.decls[d].kind): return NONE
    string8 tq = index.hold(#format(".", s_qual(w, d)))
    string8 tw = index.hold(#format(".", tx))
    if strings.ends_with(tq, tw): return d
    return NONE

// Whether `x` heads a value: a local, `self`, `super` or a field of the chain.
private bool sr_value(^World w, ^Body b, u32 x):
    syntax.Ast a = tree(w, b)
    u32 r = x
    for a.tag[r] == syntax.E_FIELD:
        r = a.a[r]
    if a.tag[r] != syntax.E_NAME: return true
    string8 s = spell(w, b, r)
    return s == "self" || s == "super" || find_local(w, b, w.p.sym(b.file, r), false) != NONE || s_field_ix(w, b, w.p.sym(b.file, r)) >= 0

// `T.names()`; `done` unset when `T` is no type.
Val sr_names(^World w, ^Body b, u32 n, u32 c, ^bool done):
    syntax.Ast a = tree(w, b)
    u32 x = a.a[c]
    if sr_value(w, b, x): return bad()
    u32 d = sr_decl(w, b, x)
    if d == NONE: return bad()
    done^ = true
    string8 tx = index.hold(strings.clone(src(w, b, x)))
    []u32 args = call_args(w, b, n)
    ref []string8 ns
    if w.decls[d].kind == K_CLASS:
        u32 ci = s_class_of_ty(w, resolve(w, d))
        u32 inner = lookup(w, w.p.files[b.file].pkg, w.p.names.intern(index.hold(#format(name_of(w, w.decls[d].name), ".names"))))
        if inner != NONE && w.decls[inner].kind == K_CLASS:
            for g in args:
                _ = expr(w, b, arg_value(w, b, g), NONE)
            err(w, b, c, 1350, index.hold(#format("`", tx, ".names()` could ask the class `", tx, "` for its slot names or construct its inner class `", tx, ".names`")), index.hold(#format("rename the inner class — `class Names:` — so `", tx, ".names()` asks for the slot names")))
            return bad()
        if ci != NONE:
            for x in s_fields_of(w, ci):
                ns = #append(ns, name_of(w, x.sym))
    else if w.decls[d].kind == K_ENUM:
        _ = resolve(w, d)
        ns = s_enum_names(w, d, nil)
    else:
        u32 ty = resolve(w, d)
        if ty == NONE: return bad()
        for sn in w.t.slot_names(ty):
            ns = #append(ns, index.hold(strings.clone(w.t.text(sn))))
    if #len(args) > 0:
        for g in args:
            _ = expr(w, b, arg_value(w, b, g), NONE)
        err(w, b, n, 601, index.hold(#format("`", tx, ".names()` asks a type for its slot names and takes no arguments, and this call passes ", #len(args))), index.hold(#format("write `", tx, ".names()`")))
        return bad()
    ref []u32 xs
    for s in ns:
        xs = #append(xs, ir.konst(w.k.str(&w.t, s)))
    return s_op(w, b, n, B_SARRAY, w.t.slice_of(w.sstr), xs[:])

// What else a bare `slots(…)` could call here, or "".
string8 sr_other(^World w, ^Body b, ^string8 through):
    u32 sym = w.p.names.intern("slots")
    through^ = "write `self.slots(…)` to walk what it answers"
    u32 m = s_method_of(w, b, sym)
    if m != NONE: return index.hold(#format("the method `slots` of `", name_of(w, w.decls[w.decls[m].block].name), "`"))
    if s_field_ix(w, b, sym) >= 0: return index.hold(#format("the field `slots` of `", s_cname(w, b), "`"))
    u32 fd = lookup(w, w.p.files[b.file].pkg, sym)
    if fd != NONE && w.decls[fd].kind == K_FN && !ds_at(w, w.decls[fd].file, w.decls[fd].node):
        through^ = "hold what it answers in a local first — `xs = slots(…)` — and walk that"
        return index.hold(#format("the Dado function `slots` of package `", name_of(w, w.p.pkgs[w.decls[fd].pkg].name), "`"))
    return ""

// Whether `it` is a header's `slots(…)`.
bool sr_header(^World w, ^Body b, u32 it):
    syntax.Ast a = tree(w, b)
    if a.tag[it] != syntax.E_CALL: return false
    u32 c = a.list(a.b[it])[0]
    return a.tag[c] == syntax.E_NAME && spell(w, b, c) == "slots" && find_local(w, b, w.p.sym(b.file, c), false) == NONE

// `for name, value in slots(v)` / `for value in slots(v)`.
void sr_walk(^World w, ^Body b, u32 n, []u32 binds, u32 it):
    syntax.Ast a = tree(w, b)
    []u32 args = call_args(w, b, it)
    string8 through = ""
    string8 other = sr_other(w, b, &through)
    if #len(other) > 0:
        for g in args:
            _ = expr(w, b, arg_value(w, b, g), NONE)
        err(w, b, a.list(a.b[it])[0], 1350, index.hold(#format("`", src(w, b, it), "` here could walk the slots of an instance or call ", other)), index.hold(#format("rename ", other, " to keep the walk, or ", through)))
        return
    if #len(args) != 1:
        for g in args:
            _ = expr(w, b, arg_value(w, b, g), NONE)
        err(w, b, it, 601, index.hold(#format("`slots(v)` walks one instance, and this call passes ", #len(args))), "pass exactly one instance: `for name, value in slots(v):`")
        return
    u32 vn = arg_value(w, b, args[0])
    Val v = finish(w, b, expr(w, b, vn, NONE), vn)
    if v.ty == NONE: return
    u8 sub = 3
    if v.ty == w.sany: sub = 4
    else if s_class_of_ty(w, v.ty) == NONE:
        string8 x = src(w, b, vn)
        string8 h = index.hold(#format("walk an instance of a class: put `", x, "` in one, or ask a class for its names alone, `Hero.names()`"))
        u8 k = s_kind(w, v.ty)
        if k == 1: h = index.hold(#format("walk the array itself: `for x in ", x, ":`"))
        if k == 2: h = index.hold(#format("walk the map itself: `for k, v in ", x, ":`"))
        err(w, b, vn, 1350, index.hold(#format("`slots` walks the slots of an instance of a class, a trait's value or an `any`, and this is `", shown(w, v.ty), "`")), h)
        return
    if #len(binds) > 2:
        err_tok(w, b, binds[2], 503, "`for … in slots(v)` binds a slot's name and its value — `for name, value in slots(v)` — or its value alone", "bind fewer names")
        return
    u32 co = spill(w, b, v, vn)
    scope_in(w, b)
    u32 s1 = NONE
    u32 s2 = NONE
    if #len(binds) == 2: s1 = declare_local(w, b, w.p.sym(b.file, binds[0]), w.sstr, binds[0])
    s2 = declare_local(w, b, w.p.sym(b.file, binds[#len(binds) - 1]), w.sany, binds[#len(binds) - 1])
    u32 p1 = NONE
    if s1 != NONE: p1 = ir.at(&b.f, s1)
    u32 lp = ir.op(&b.f, ir.O_LOOP, sub, NONE, n, p1, NONE, co, ir.at(&b.f, s2))
    b.heads = #append(b.heads, Head(lp, true, NONE, false, b.depth, false))
    for j in 0..<#len(b.locals):
        if b.locals[j].depth == b.depth: b.locals[j].read = true
    u32 bl = open(w, b, ir.O_BLOCK, n, NONE, false)
    block(w, b, tree(w, b).b[n])
    close(w, b, bl)
    close(w, b, lp)
    scope_out(w, b)

// `slots(v)` anywhere but a header: ERR1350.
Val sr_elsewhere(^World w, ^Body b, u32 n):
    []u32 args = call_args(w, b, n)
    string8 walked = "v"
    string8 names = ""
    if #len(args) == 1:
        u32 vn = arg_value(w, b, args[0])
        Val v = finish(w, b, expr(w, b, vn, NONE), vn)
        walked = index.hold(strings.clone(src(w, b, vn)))
        u32 ci = NONE
        if v.ty != NONE: ci = s_class_of_ty(w, v.ty)
        if ci != NONE: names = index.hold(#format(", or ask the class for its names alone: `", s_short(w, w.classes[ci].decl), ".names()`"))
    else:
        for g in args:
            _ = expr(w, b, arg_value(w, b, g), NONE)
    err(w, b, n, 1350, index.hold(#format("`slots(", walked, ")` walks an instance's slots, and only as the iterable of a `for` header: it is no value a script holds")), index.hold(#format("walk it in a header — `for name, value in slots(", walked, "):`", names)))
    return bad()
