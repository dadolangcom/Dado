// Diagnostics: the code table's rows, the builder, and the one sort by
// `(phase, unit, file, position)` with `(code, span)` dedup.
package diag

import "core:slices"

// A code is its class's base plus its number: ERR0504 is 504, LNT0412 is
// `LNT + 412`, WRN0803 is `WRN + 803`.
const u16 ERR = 0
const u16 LNT = 10000
const u16 WRN = 20000

type Code:
    u16 id
    bool program
    string8 title
    string8 rule

const u8 ERROR = 0
const u8 WARNING = 1

// Phases, in the order their diagnostics print.
const u8 PH_LOAD = 0
const u8 PH_LEX = 1
const u8 PH_PARSE = 2
const u8 PH_DIALECT = 3
const u8 PH_INTERFACE = 4
const u8 PH_BODY = 5
const u8 PH_FACTS = 6
const u8 PH_ANALYSIS = 7
const u8 PH_LOWER = 8

// The mark between a message and why, and before a repair, for a message
// built where the three cannot be told apart.
const char8 WHY = '\x1f'
const char8 REPAIR = '\x1e'

// `start` and `end` are relative to `base`, the item's offset in `file`
// (an index into the compilation's `Files`). Texts are runs of `text`:
// message `msg..help`, help `help..why`, explanation `why..stop`.
type Diag:
    u16 code
    u8 sev
    u8 phase
    u32 unit
    u32 file
    u32 base
    u32 start
    u32 end
    u32 msg
    u32 help
    u32 why
    u32 stop
    u32 lab
    u32 lab_end

type Label:
    u32 file
    u32 base
    u32 start
    u32 end
    u32 msg
    u32 stop

// The row of code `id`, or -1.
i64 row(u16 id):
    for i in 0..<#len(CODES):
        if CODES[i].id == id: return i
    return -1

// One job's diagnostics. Set `phase`, `unit`, `file` and `base` for where
// the job is, then `add`; `label` adds to the last one added.
type Diags:
    bool strict
    u8 phase
    u32 unit
    u32 file
    u32 base
    ref []Diag list
    ref []Label labels
    ref []char8 text

    void free(^self):
        #delete(self.list)
        #delete(self.labels)
        #delete(self.text)

    string8 run(^self, u32 a, u32 b):
        return string8(self.text[i64(a)..<i64(b)])

    private u32 put(^self, string8 s):
        for c in s:
            self.text = #append(self.text, c)
        return u32(#len(self.text))

    // Severity from the class: a lint is an error under `strict`. `warn`
    // is ERR0805's retirement window, a refusal accepted with a warning.
    void add(^self, u16 code, u32 start, u32 end, string8 msg, string8 help = "", string8 why = "", bool warn = false):
        u8 sev = ERROR
        if code >= WRN || (code >= LNT && !self.strict) || warn: sev = WARNING
        string8 m = msg
        string8 h = help
        string8 rest = ""
        i64 r = find(m, REPAIR)
        if r >= 0:
            if #len(h) == 0: h = m[r + 1..<#len(m)]
            m = m[0..<r]
        i64 w = find(m, WHY)
        if w >= 0:
            rest = m[w + 1..<#len(m)]
            m = m[0..<w]
            for #len(m) > 0 && (m[#len(m) - 1] == ' ' || m[#len(m) - 1] == '.'):
                m = m[0..<#len(m) - 1]
        u32 at = u32(#len(self.text))
        u32 hp = self.put(m)
        u32 wy = self.put(h)
        _ = self.put(rest)
        if #len(rest) > 0 && #len(why) > 0: _ = self.put(". ")
        u32 st = self.put(why)
        u32 l = u32(#len(self.labels))
        self.list = #append(self.list, Diag(code, sev, self.phase, self.unit, self.file, self.base, start, end, at, hp, wy, st, l, l))

    void label(^self, u32 file, u32 base, u32 start, u32 end, string8 msg):
        u32 at = u32(#len(self.text))
        u32 st = self.put(msg)
        self.labels = #append(self.labels, Label(file, base, start, end, at, st))
        self.list[#len(self.list) - 1].lab_end = u32(#len(self.labels))

    // Another job's diagnostics, appended.
    void take(^self, ^Diags o):
        u32 t = u32(#len(self.text))
        u32 l = u32(#len(self.labels))
        for c in o.text:
            self.text = #append(self.text, c)
        for x in o.labels:
            self.labels = #append(self.labels, Label(x.file, x.base, x.start, x.end, x.msg + t, x.stop + t))
        for d in o.list:
            self.list = #append(self.list, Diag(d.code, d.sev, d.phase, d.unit, d.file, d.base, d.start, d.end, d.msg + t, d.help + t, d.why + t, d.stop + t, d.lab + l, d.lab_end + l))

    i64 errors(^self):
        i64 n = 0
        for d in self.list:
            if d.sev == ERROR: n += 1
        return n

    bool has_errors(^self):
        for d in self.list:
            if d.sev == ERROR: return true
        return false

    // The once-sort by `(phase, unit, file, position)`, stable, then one of
    // each `(code, span, message)`.
    void settle(^self):
        slices.sort_stable(self.list, before)
        i64 keep = 0
        {u64: i64} at
        for i in 0..<#len(self.list):
            Diag d = self.list[i]
            u64 key = (u64(d.code) << 48) ~ (u64(d.file) << 40) ~ (u64(d.base + d.start) << 20) ~ u64(d.base + d.end)
            if key in at:
                i64 j = 0
                try j = at[key] else: pass
                Diag o = self.list[j]
                if o.file == d.file && o.base + o.start == d.base + d.start && o.base + o.end == d.base + d.end && o.code == d.code && self.run(o.msg, o.help) == self.run(d.msg, d.help): continue
            at[key] = keep
            self.list[keep] = d
            keep += 1
        #truncate(self.list, keep)
        #delete(at)

private i64 find(string8 s, char8 c):
    for i in 0..<#len(s):
        if s[i] == c: return i
    return -1

private bool before(Diag a, Diag b):
    if a.phase != b.phase: return a.phase < b.phase
    if a.unit != b.unit: return a.unit < b.unit
    if a.file != b.file: return a.file < b.file
    return a.base + a.start < b.base + b.start
