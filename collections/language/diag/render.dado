// The one renderer: dadoc's machine, explained and human forms, and the
// count and cap policy for a run's human diagnostics.
package diag

import "core:slices"

// A line and a column (in characters), from 1.
type Place:
    i64 line
    i64 col

// The compilation's files end to end, as dadoc's source map lays them: a
// file that does not end in a newline is given one before the next.
type Files:
    ref []string8 names
    ref []string8 srcs
    ref []u32 base
    bool nl
    u32 len
    // Line starts, per file on first use.
    ref []u32 lo
    ref []u32 hi
    ref []u32 starts

    void free(^self):
        #delete(self.names)
        #delete(self.srcs)
        #delete(self.base)
        #delete(self.lo)
        #delete(self.hi)
        #delete(self.starts)

    // Adds a file; its index is what a `Diag`'s `file` names.
    u32 add(^self, string8 name, string8 src):
        if self.len > 0 && !self.nl: self.len += 1
        self.names = #append(self.names, name)
        self.srcs = #append(self.srcs, src)
        self.base = #append(self.base, self.len)
        self.lo = #append(self.lo, 0)
        self.hi = #append(self.hi, 0)
        self.len += u32(#len(src))
        if #len(src) > 0: self.nl = src[#len(src) - 1] == '\n'
        return u32(#len(self.names) - 1)

    // The file an offset of the compilation lands in.
    u32 at(^self, u32 off):
        i64 lo = 0
        i64 hi = #len(self.base)
        for lo + 1 < hi:
            i64 mid = (lo + hi) / 2
            if self.base[mid] <= off: lo = mid
            else: hi = mid
        return u32(lo)

    private void index(^self, u32 f):
        if self.hi[f] > 0: return
        self.lo[f] = u32(#len(self.starts))
        self.starts = #append(self.starts, 0)
        string8 s = self.srcs[f]
        for i in 0..<#len(s):
            if s[i] == '\n': self.starts = #append(self.starts, u32(i + 1))
        self.hi[f] = u32(#len(self.starts))

    // Which line of file `f` holds `at` (from 0), and where it starts.
    private i64 line_of(^self, u32 f, u32 at, ^u32 start):
        self.index(f)
        i64 lo = i64(self.lo[f])
        i64 hi = i64(self.hi[f])
        for lo + 1 < hi:
            i64 mid = (lo + hi) / 2
            if self.starts[mid] <= at: lo = mid
            else: hi = mid
        start^ = self.starts[lo]
        return lo - i64(self.lo[f])

    Place place(^self, u32 off):
        u32 o = off if off < self.len else self.len
        u32 f = self.at(o)
        u32 at = o - self.base[f]
        u32 s = 0
        i64 line = self.line_of(f, at, &s)
        string8 src = self.srcs[f]
        i64 end = i64(at) if i64(at) < #len(src) else #len(src)
        return Place(line + 1, chars(src[i64(s)..<end]) + 1)

    // The line holding `off`, without its line ending.
    string8 line_text(^self, u32 off):
        u32 o = off if off < self.len else self.len
        u32 f = self.at(o)
        u32 s = 0
        _ = self.line_of(f, o - self.base[f], &s)
        string8 src = self.srcs[f]
        i64 b = i64(s)
        for b < #len(src) && src[b] != '\n':
            b += 1
        if b > i64(s) && src[b - 1] == '\r': b -= 1
        return src[i64(s)..<b]

private i64 chars(string8 s):
    i64 n = 0
    for c in s:
        u8 b = u8(c)
        if b < 0x80 || b >= 0xC0: n += 1
    return n

void put(^ref []char8 out, string8 s):
    for c in s:
        out^ = #append(out^, c)

void put_num(^ref []char8 out, i64 n):
    u64 v = u64(n)
    u64 p = 1
    for p * 10 <= v:
        p *= 10
    for p > 0:
        out^ = #append(out^, char8(u8('0') + u8(v / p % 10)))
        p /= 10

private void pad(^ref []char8 out, i64 n):
    for _ in 0..<n:
        out^ = #append(out^, ' ')

// `ERR0504`, `LNT0412`, `WRN0803`.
void put_code(^ref []char8 out, u16 id):
    put(out, "ERR" if id < LNT else ("LNT" if id < WRN else "WRN"))
    i64 n = i64(id % 10000)
    for d in (1000, 100, 10):
        if n < d: out^ = #append(out^, '0')
    put_num(out, n)

private void put_place(^ref []char8 out, Place p):
    put_num(out, p.line)
    out^ = #append(out^, ':')
    put_num(out, p.col)

private string8 sev_word(u8 s):
    return "error" if s == ERROR else "warning"

// Where a diagnostic starts and ends in the compilation.
private u32 abs(^Files fs, u32 file, u32 base, u32 off):
    return fs.base[file] + base + off

// `--emit=diagnostics`: severity, code, span and place; no text.
void machine(^ref []char8 out, ^Diags ds, ^Files fs):
    for d in ds.list:
        u32 s = abs(fs, d.file, d.base, d.start)
        put(out, sev_word(d.sev))
        out^ = #append(out^, ' ')
        put_code(out, d.code)
        put(out, " @ ")
        put_num(out, i64(s))
        put(out, "..")
        put_num(out, i64(abs(fs, d.file, d.base, d.end)))
        put(out, " (")
        put_place(out, fs.place(s))
        put(out, ")\n")

// `--emit=explained`: eight tab-separated fields, the span the file's own.
void explained(^ref []char8 out, ^Diags ds, ^Files fs):
    for d in ds.list:
        u32 s = abs(fs, d.file, d.base, d.start)
        u32 f = fs.at(s if s < fs.len else fs.len)
        i64 fo = i64(s) - i64(fs.base[f])
        if fo < 0: fo = 0
        i64 c = row(d.code)
        put(out, sev_word(d.sev))
        out^ = #append(out^, '\t')
        put_code(out, d.code)
        put(out, "\tprogram\t" if c >= 0 && CODES[c].program else "\tfile\t")
        put(out, fs.names[f])
        out^ = #append(out^, '\t')
        put_num(out, fo)
        put(out, "..")
        put_num(out, fo + i64(d.end) - i64(d.start))
        out^ = #append(out^, '\t')
        put_place(out, fs.place(s))
        out^ = #append(out^, '\t')
        put(out, ds.run(d.msg, d.help))
        out^ = #append(out^, '\t')
        put(out, ds.run(d.help, d.why))
        out^ = #append(out^, '\n')

// One source line with a caret run under `s..e`, and `trailer` after it.
private void excerpt(^ref []char8 out, ^Files fs, u32 s, u32 e, string8 trailer):
    Place p = fs.place(s)
    Place q = fs.place(e)
    string8 line = fs.line_text(s)
    i64 w = 1
    i64 x = p.line
    for x >= 10:
        x /= 10
        w += 1
    pad(out, 4 - w)
    put_num(out, p.line)
    put(out, " | ")
    put(out, line)
    out^ = #append(out^, '\n')
    pad(out, (4 if w < 4 else w) + 3 + p.col - 1)
    i64 n = q.col - p.col if q.line == p.line else chars(line) - (p.col - 1)
    if n < 1: n = 1
    for _ in 0..<n:
        out^ = #append(out^, '^')
    if #len(trailer) > 0:
        out^ = #append(out^, ' ')
        put(out, trailer)
    out^ = #append(out^, '\n')

// The human form: header, excerpt, labels, help; with `explain`, the notes.
void human_one(^ref []char8 out, ^Diags ds, ^Files fs, Diag d, bool explain):
    u32 s = abs(fs, d.file, d.base, d.start)
    put(out, sev_word(d.sev))
    out^ = #append(out^, '[')
    put_code(out, d.code)
    put(out, "]: ")
    put(out, ds.run(d.msg, d.help))
    put(out, "\n  --> ")
    put(out, fs.names[fs.at(s if s < fs.len else fs.len)])
    out^ = #append(out^, ':')
    put_place(out, fs.place(s))
    out^ = #append(out^, '\n')
    excerpt(out, fs, s, abs(fs, d.file, d.base, d.end), "")
    for l in ds.labels[i64(d.lab)..<i64(d.lab_end)]:
        u32 ls = abs(fs, l.file, l.base, l.start)
        put(out, "  --> ")
        put(out, fs.names[fs.at(ls if ls < fs.len else fs.len)])
        out^ = #append(out^, ':')
        put_place(out, fs.place(ls))
        out^ = #append(out^, '\n')
        excerpt(out, fs, ls, abs(fs, l.file, l.base, l.end), ds.run(l.msg, l.stop))
    if d.why > d.help:
        put(out, "  help: ")
        put(out, ds.run(d.help, d.why))
        out^ = #append(out^, '\n')
    if !explain: return
    if d.stop > d.why:
        put(out, "  note: ")
        put(out, ds.run(d.why, d.stop))
        out^ = #append(out^, '\n')
    i64 c = row(d.code)
    if c < 0: return
    put(out, "  note: ")
    put(out, CODES[c].title)
    put(out, " (")
    put(out, CODES[c].rule)
    put(out, ")\n")

const string8 EXPLAIN_HINT = "(--explain prints why, and the rule behind each code)\n"

// What a run's human diagnostics leave out, counted by code.
type Told:
    i64 cap
    i64 shown
    ref []u32 counted
    ref []u32 capped
    bool logging
    ref []char8 log

    // `cap` errors are shown in full; -1 shows every one.
    void free(^self):
        #delete(self.counted)
        #delete(self.capped)
        #delete(self.log)

    // Each in full, except: under `count`, the warnings and lints are only
    // counted; past `cap` (-1: none), errors are only counted. With
    // `logging`, every one goes to `log` in full.
    void human(^self, ^ref []char8 out, ^Diags ds, ^Files fs, bool explain, bool count):
        ref []char8 one
        for d in ds.list:
            bool shown = true
            if d.sev != ERROR:
                if count: tally(&self.counted, d.code)
                shown = !count
            else if self.cap >= 0 && self.shown >= self.cap:
                tally(&self.capped, d.code)
                shown = false
            else:
                self.shown += 1
            if !shown && !self.logging: continue
            #truncate(one, 0)
            human_one(&one, ds, fs, d, explain)
            if self.logging: put(&self.log, one)
            if shown: put(out, one)
        #delete(one)

    // The lines standing for what was left out; `log` names the log file.
    void tail(^self, ^ref []char8 out, string8 log = ""):
        if #len(self.capped) > 0:
            i64 n = total(self.capped)
            put_num(out, n)
            put(out, " more error not shown (" if n == 1 else " more errors not shown (")
            by_count(out, self.capped)
            put(out, "): ")
            where_all(out, log, "--log=FILE writes them all")
        if #len(self.counted) == 0: return
        i64 lints = 0
        i64 i = 0
        for i < #len(self.counted):
            if self.counted[i] >= u32(LNT) && self.counted[i] < u32(WRN): lints += i64(self.counted[i + 1])
            i += 2
        i64 warns = total(self.counted) - lints
        if warns > 0:
            put_num(out, warns)
            put(out, " warning" if warns == 1 else " warnings")
        if lints > 0:
            if warns > 0: put(out, " and ")
            put_num(out, lints)
            put(out, " lint" if lints == 1 else " lints")
        put(out, " not shown (")
        by_count(out, self.counted)
        put(out, "): ")
        where_all(out, log, "dado warnings lists them")

Told told(i64 cap = -1, bool logging = false):
    Told t
    t.cap = cap
    t.logging = logging
    return t

private void where_all(^ref []char8 out, string8 log, string8 otherwise):
    if #len(log) > 0:
        put(out, log)
        put(out, " has them all\n")
    else:
        put(out, otherwise)
        out^ = #append(out^, '\n')

// `(code, count)` pairs, in the order first seen.
private void tally(^ref []u32 xs, u16 code):
    i64 i = 0
    for i < #len(xs^):
        if xs^[i] == u32(code):
            xs^[i + 1] += 1
            return
        i += 2
    xs^ = #append(xs^, u32(code))
    xs^ = #append(xs^, 1)

private i64 total([]u32 xs):
    i64 n = 0
    i64 i = 1
    for i < #len(xs):
        n += i64(xs[i])
        i += 2
    return n

// `CODE n, …`, most first, then by code.
private void by_count(^ref []char8 out, []u32 xs):
    ref []u64 keys
    i64 i = 0
    for i < #len(xs):
        keys = #append(keys, (u64(0xFFFFFFFF - xs[i + 1]) << 32) | u64(xs[i]))
        i += 2
    slices.sort_ascending(keys)
    for k in 0..<#len(keys):
        if k > 0: put(out, ", ")
        put_code(out, u16(keys[k] & 0xFFFF))
        out^ = #append(out^, ' ')
        put_num(out, i64(0xFFFFFFFF - (keys[k] >> 32)))
    #delete(keys)

// `--explain CODE`: false when no code has that spelling's number.
bool explanation(^ref []char8 out, string8 written):
    if #len(written) != 7: return false
    string8 pre = written[0..<3]
    i64 n = 0
    for c in written[3..<7]:
        if c < '0' || c > '9': return false
        n = n * 10 + i64(u8(c) - u8('0'))
    u16 base = 0
    if pre == "LNT": base = LNT
    else if pre == "WRN": base = WRN
    else if pre != "ERR" && pre != "TOY": return false
    i64 r = row(base + u16(n)) if pre != "TOY" else -1
    if r < 0:
        for i in 0..<#len(CODES):
            if CODES[i].id % 10000 == u16(n):
                r = i
                break
    if r < 0: return false
    Code c = CODES[r]
    put_code(out, c.id)
    put(out, ": ")
    put(out, c.title)
    put(out, "\n  class: ")
    if c.id < LNT: put(out, "error — an error, always")
    else if c.id < WRN: put(out, "lint — a warning, an error under `--strict`")
    else: put(out, "warning — a warning, never an error")
    put(out, "\n  rule: ")
    put(out, c.rule)
    out^ = #append(out^, '\n')
    if pre == "TOY":
        put(out, "  `")
        put(out, written)
        put(out, "` is the former spelling.\n")
    else if c.id != base + u16(n):
        put(out, "  `")
        put(out, written)
        put(out, "` is this number under another class's letters; the code is `")
        put_code(out, c.id)
        put(out, "`.\n")
    put(out, "  A diagnostic with this code names what was written and, under `help:`, the repair. Compile with `--explain` for why that site refused it.\n")
    return true
