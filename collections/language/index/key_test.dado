@test
// Which package keys are a collection's: the checker skips a collection's
// bodies and the manifest calls its headers the toolchain's. The main
// package's key is its path as the driver wrote it, which on Windows starts
// with a drive (P22): taken for a collection's, `tools/lsp`'s `wait.h` was a
// toolchain header and its bodies went unchecked.
package index

private bool key_is(string8 key, bool want):
    bool got = collection_key(key)
    return #expect(got == want, "collection_key(\"", key, "\") is ", got)

i32 test():
    bool ok = true
    // A collection's packages, however deep.
    ok = key_is("core:os", true) && ok
    ok = key_is("core:os/fs", true) && ok
    ok = key_is("language:check", true) && ok
    ok = key_is("project:lib/x", true) && ok
    ok = key_is("imports:name/pkg", true) && ok
    // A one-letter collection is still one: no separator follows its `:`.
    ok = key_is("x:pkg", true) && ok
    // Directories on POSIX, relative or not.
    ok = key_is("/home/sam/DadoLang/tools/lsp", false) && ok
    ok = key_is("tools/lsp", false) && ok
    ok = key_is(".", false) && ok
    ok = key_is("main.dado", false) && ok
    ok = key_is("/srv/a:b/pkg", false) && ok
    // Directories on Windows, as the driver writes them there.
    ok = key_is("D:\\a\\DadoLang\\DadoLang\\tools/lsp", false) && ok
    ok = key_is("D:\\a\\DadoLang\\DadoLang\\tools\\lsp", false) && ok
    ok = key_is("D:/a/DadoLang/DadoLang/tools/lsp", false) && ok
    ok = key_is("c:\\work\\pkg/sub", false) && ok
    ok = key_is("D:", false) && ok
    ok = key_is("\\\\server\\share\\pkg", false) && ok
    return 0 if ok else 1
