@test
// Where a path's last separator is, which names a package's directory and
// shows its files (`base_name`, `dir_of`). On Windows the driver can hand
// dadoc `D:/a/ci/hello\hello` (P23): split at `/` alone, the directory's
// name was `hello\hello`, the unit `hello\hello_main.c` went into a
// directory nobody made, and `dado build` failed "cannot write".
package index

private bool sep_is(string8 p, bool windows, i64 want):
    i64 got = last_separator_in(p, windows)
    return #expect(got == want, "last_separator_in(\"", p, "\", ", windows, ") is ", got, ", not ", want)

i32 test():
    bool ok = true
    // POSIX: `/` alone; `\` is a byte of a name.
    ok = sep_is("tools/lsp", false, 5) && ok
    ok = sep_is("main.dado", false, 0 - 1) && ok
    ok = sep_is("/srv/a\\b", false, 4) && ok
    ok = sep_is("", false, 0 - 1) && ok
    // Windows: either one, whichever is last.
    ok = sep_is("D:/a/ci/hello\\hello", true, 13) && ok
    ok = sep_is("D:\\a\\DadoLang\\DadoLang\\tools/lsp", true, 28) && ok
    ok = sep_is("D:\\a\\b", true, 4) && ok
    ok = sep_is("hello\\main.dado", true, 5) && ok
    ok = sep_is("C:main.dado", true, 0 - 1) && ok
    // The host's rule is one of the two.
    when #OS == #WINDOWS:
        ok = #expect(last_separator("a/b\\c") == 3, "Windows split at `/`") && ok
    else:
        ok = #expect(last_separator("a/b\\c") == 1, "POSIX split at `\\`") && ok
    return 0 if ok else 1
