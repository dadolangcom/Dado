// An interner: byte keys to dense `u32` handles, by first insertion. Strings
// (`StrId`) are one; types and constants intern their encoded rows in one.
// A key's text never moves once interned.
package types

const u32 NONE = 0xFFFFFFFF

type Interner:
    Pool(char8) text
    ref []u64 hash
    ref []u32 slots

    void free(^self):
        self.text.free()
        #delete(self.hash)
        #delete(self.slots)

    i64 count(^self):
        return #len(self.hash)

    string8 key(^self, u32 id):
        []char8 s = self.text.get(id)
        return string8(s)

    // The handle of `k`, or `NONE`.
    u32 find(^self, string8 k):
        if #len(self.slots) == 0: return NONE
        u64 h = hash_of(k).lo
        u64 mask = u64(#len(self.slots) - 1)
        u64 i = h & mask
        for:
            u32 v = self.slots[i64(i)]
            if v == 0: return NONE
            if self.hash[v - 1] == h && self.key(v - 1) == k: return v - 1
            i = (i + 1) & mask
        return NONE

    u32 intern(^self, string8 k):
        if #len(self.slots) == 0: self.grow(256)
        u64 h = hash_of(k).lo
        u64 mask = u64(#len(self.slots) - 1)
        u64 i = h & mask
        for:
            u32 v = self.slots[i64(i)]
            if v == 0: break
            if self.hash[v - 1] == h && self.key(v - 1) == k: return v - 1
            i = (i + 1) & mask
        u32 id = u32(#len(self.hash))
        _ = self.text.open(#len(k))
        for c in k:
            self.text.add(c)
        self.hash = #append(self.hash, h)
        self.slots[i64(i)] = id + 1
        if i64(id + 1) * 2 > #len(self.slots): self.grow(#len(self.slots) * 2)
        return id

    private void grow(^self, i64 n):
        #delete(self.slots)
        ref []u32 fresh = #make([]u32, n)
        self.slots = fresh
        u64 mask = u64(n - 1)
        for id in 0..<#len(self.hash):
            u64 i = self.hash[id] & mask
            for self.slots[i64(i)] != 0:
                i = (i + 1) & mask
            self.slots[i64(i)] = u32(id) + 1

// Key building: rows are encoded as bytes, four per `u32`.
void put32(^ref []char8 k, u32 x):
    for j in 0..<4:
        k^ = #append(k^, char8(u8((x >> u32(8 * j)) & 0xFF)))

void put64(^ref []char8 k, u64 x):
    put32(k, u32(x & 0xFFFFFFFF))
    put32(k, u32(x >> 32))

u32 get32(string8 k, i64 at):
    u32 v = 0
    for j in 0..<4:
        v = v | (u32(u8(k[at + j])) << u32(8 * j))
    return v
