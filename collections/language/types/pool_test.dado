@test
// A window into a pool list stays good while lists are added past a chunk.
package types

i32 test():
    bool ok = true
    Types t = new_types()
    [3]u32 e = [1, 2, 3]
    u32 first = t.tuple(e[:])
    []u32 held = t.list(first)
    for i in 0..<20000:
        [2]u32 p = [u32(i), first]
        _ = t.tuple(p[:])
    ok = #expect(#len(held) == 3 && held[0] == 1 && held[2] == 3, "held window survived") && ok
    []u32 again = t.list(first)
    ok = #expect(again[1] == 2, "list read back") && ok
    t.free()
    return 0 if ok else 1
