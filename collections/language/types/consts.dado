// Interned compile-time values (`ConstId`s), each with its content hash.
package types

const u8 C_INT = 0
const u8 C_FLOAT = 1
const u8 C_BOOL = 2
const u8 C_STR = 3
const u8 C_FOREIGN = 4
const u8 C_FN = 5
const u8 C_TYPE = 6
const u8 C_TUPLE = 7
const u8 C_WINDOW = 8
const u8 C_CALLER = 9
const u8 C_UNION = 10

// Per kind: INT w=(lo, hi) of an i128 · FLOAT w0=bits · BOOL a
//   STR a=text as written · FOREIGN a=C name · FN a=package, b=name, w0=foreign
//   TYPE a=TypeId · TUPLE xs=slots · WINDOW a=var, b=of, w=(start, len)
//   UNION a=member, xs=(value)
private const [11]u8 KA = (0, 0, 0, 2, 2, 2, 1, 0, 2, 0, 0)
private const [11]u8 KB = (0, 0, 0, 0, 0, 2, 0, 0, 1, 0, 0)

type Consts:
    Interner keys
    ref []u8 kind
    ref []u32 a
    ref []u32 b
    ref []u64 w0
    ref []u64 w1
    Pool(u32) xs
    ref []u64 hlo
    ref []u64 hhi
    ref []char8 scratch

    void free(^self):
        self.keys.free()
        #delete(self.kind)
        #delete(self.a)
        #delete(self.b)
        #delete(self.w0)
        #delete(self.w1)
        self.xs.free()
        #delete(self.hlo)
        #delete(self.hhi)
        #delete(self.scratch)

    Hash hash(^self, u32 c):
        return Hash(self.hlo[c], self.hhi[c])

    []u32 list(^self, u32 c):
        return self.xs.get(c)

    // `xs` may be a window into this table.
    u32 make(^self, ^Types t, u8 k, u32 a, u32 b, u64 w0, u64 w1, []u32 xs):
        #truncate(self.scratch, 0)
        self.scratch = #append(self.scratch, char8(k))
        put32(&self.scratch, a)
        put32(&self.scratch, b)
        put64(&self.scratch, w0)
        put64(&self.scratch, w1)
        for x in xs:
            put32(&self.scratch, x)
        string8 key = self.scratch
        i64 before = self.keys.count()
        u32 id = self.keys.intern(key)
        if self.keys.count() == before: return id
        key = self.keys.key(id)
        Hasher h = hasher(1)
        h.byte(k)
        for f in 0..<2:
            u8 kind = KA[k] if f == 0 else KB[k]
            u32 v = a if f == 0 else b
            if kind == 1: h.hash(t.hash(v))
            else if kind == 2: h.text(t.text(v))
            else: h.word(u64(v))
        h.word(w0)
        h.word(w1)
        i64 n = (#len(key) - 25) / 4
        h.word(u64(n))
        _ = self.xs.open(n)
        for i in 0..<n:
            u32 x = get32(key, 25 + 4 * i)
            h.hash(self.hash(x))
            self.xs.add(x)
        Hash c = h.finish()
        self.kind = #append(self.kind, k)
        self.a = #append(self.a, a)
        self.b = #append(self.b, b)
        self.w0 = #append(self.w0, w0)
        self.w1 = #append(self.w1, w1)
        self.hlo = #append(self.hlo, c.lo)
        self.hhi = #append(self.hhi, c.hi)
        return id

    // An integer as an i128: `hi` is its top half, sign included.
    u32 int(^self, ^Types t, u64 lo, i64 hi):
        return self.make(t, C_INT, 0, 0, lo, u64(hi), nil)

    u32 small(^self, ^Types t, i64 v):
        return self.int(t, u64(v), -1 if v < 0 else 0)

    u32 float_bits(^self, ^Types t, u64 bits):
        return self.make(t, C_FLOAT, 0, 0, bits, 0, nil)

    u32 boolean(^self, ^Types t, bool v):
        return self.make(t, C_BOOL, 1 if v else 0, 0, 0, 0, nil)

    u32 str(^self, ^Types t, string8 written):
        return self.make(t, C_STR, t.str(written), 0, 0, 0, nil)

    u32 of_type(^self, ^Types t, u32 ty):
        return self.make(t, C_TYPE, ty, 0, 0, 0, nil)

    u32 tuple(^self, ^Types t, []u32 slots):
        return self.make(t, C_TUPLE, 0, 0, 0, 0, slots)

    u32 union_(^self, ^Types t, u32 at, u32 x):
        [1]u32 one = [x]
        return self.make(t, C_UNION, at, 0, 0, 0, one[:])

    u32 fn_ref(^self, ^Types t, string8 pkg, string8 name, bool in_c):
        return self.make(t, C_FN, t.str(pkg), t.str(name), 1 if in_c else 0, 0, nil)
