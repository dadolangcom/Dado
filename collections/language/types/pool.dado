// Lists that stay where they are written: a chunk never grows past its
// capacity, so a window into one stays good while more lists are added.
package types

type Pool($T):
    ref [](ref []T) chunks
    ref []u32 ck
    ref []u32 lo
    ref []u32 hi

    void free(^self):
        for i in 0..<#len(self.chunks):
            #delete(self.chunks[i])
        #delete(self.chunks)
        #delete(self.ck)
        #delete(self.lo)
        #delete(self.hi)

    // Starts list `count()` with room for `n`; `add` fills it.
    u32 open(^self, i64 n):
        i64 k = #len(self.chunks) - 1
        if k < 0 || #cap(self.chunks[k]) - #len(self.chunks[k]) < n:
            ref []T c
            c = #reserve(c, n if n > 4096 else 4096)
            self.chunks = #append(self.chunks, c)
            k += 1
        self.ck = #append(self.ck, u32(k))
        self.lo = #append(self.lo, u32(#len(self.chunks[k])))
        self.hi = #append(self.hi, u32(#len(self.chunks[k])))
        return u32(#len(self.ck) - 1)

    void add(^self, T x):
        i64 l = #len(self.ck) - 1
        i64 k = i64(self.ck[l])
        self.chunks[k] = #append(self.chunks[k], x)
        self.hi[l] += 1

    // `xs` may be a window into this pool.
    u32 put(^self, []T xs):
        u32 id = self.open(#len(xs))
        for x in xs:
            self.add(x)
        return id

    []T get(^self, u32 id):
        []T none
        if id == NONE: return none
        i64 k = i64(self.ck[id])
        return self.chunks[k][i64(self.lo[id])..<i64(self.hi[id])]
