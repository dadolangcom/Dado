@test
// The interner, and types and constants interned by structure with hashes
// that do not depend on the order they were made in.
package types

private string8 word(i64 i, ^ref []char8 b):
    #truncate(b^, 0)
    b^ = #append(b^, 'k')
    put_u64(b, u64(i * 7919))
    return b^

i32 test():
    bool ok = true
    Interner n
    ref []char8 b
    for i in 0..<5000:
        ok = #expect(n.intern(word(i, &b)) == u32(i), "dense at ", i) && ok
    for i in 0..<5000:
        string8 w = word(i, &b)
        ok = #expect(n.intern(w) == u32(i) && n.find(w) == u32(i) && n.key(u32(i)) == w, "again at ", i) && ok
    ok = #expect(n.find("absent") == NONE && n.count() == 5000, "find") && ok
    ok = #expect(n.intern("") == 5000 && n.key(5000) == "", "empty key") && ok
    n.free()
    #delete(b)

    Types t = new_types()
    Types u = new_types()
    _ = u.named("p", "Point")
    [2]u32 two = (u32(P_I32), u32(P_I32))
    u32 i32s = t.tuple(two[:])
    ok = #expect(t.tuple(two[:]) == i32s, "a tuple interns once") && ok
    two[1] = u32(P_I64)
    ok = #expect(t.tuple(two[:]) != i32s, "another tuple") && ok
    u32 pt = t.named("p", "Point")
    t.define(pt, i32s, nil)
    [2]u32 ps = (u32(P_BOOL), t.ref_of(t.slice_of(STRING8)))
    u32 f = t.func(t.slice_of(pt), F_PLAIN, ps[:])
    [2]u32 us = (u32(P_BOOL), u.ref_of(u.slice_of(STRING8)))
    u32 uf = u.func(u.slice_of(u.named("p", "Point")), F_PLAIN, us[:])
    ok = #expect(f != uf && t.hash(f).same(u.hash(uf)), "content hash, not handle") && ok
    ok = #expect(!t.hash(t.slice_of(pt)).same(t.hash(t.slice_of(i32s))), "a name is not its body") && ok
    ok = #expect(t.make(T_NAMED, t.str("p"), t.str("Point"), nil) == pt, "a declaration interns by name") && ok

    Consts c
    Consts d
    _ = d.small(&u, 1)
    u32 one = c.small(&t, 1)
    ok = #expect(c.small(&t, 1) == one && c.small(&t, -1) != one, "ints") && ok
    [3]u32 cs = (one, c.str(&t, "\"x\""), c.of_type(&t, f))
    u32 tup = c.tuple(&t, cs[:])
    [3]u32 ds = (d.small(&u, 1), d.str(&u, "\"x\""), d.of_type(&u, uf))
    u32 dup = d.tuple(&u, ds[:])
    ok = #expect(c.hash(tup).same(d.hash(dup)), "constant content hash") && ok
    ok = #expect(!c.hash(c.small(&t, 0)).same(c.hash(c.boolean(&t, false))), "kinds differ") && ok
    c.free()
    d.free()
    t.free()
    u.free()
    return 0 if ok else 1
