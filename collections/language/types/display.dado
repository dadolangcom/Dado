// A type's spelling, as `--emit=types` and every diagnostic print it.
package types

private void put(^ref []char8 out, string8 s):
    for c in s:
        out^ = #append(out^, c)

void put_u64(^ref []char8 out, u64 n):
    u64 p = 1
    for p * 10 <= n:
        p *= 10
    for p > 0:
        out^ = #append(out^, char8(u8('0') + u8(n / p % 10)))
        p /= 10

// `x` written out; `by_name` stops at a declared type's name.
void display(^Types t, u32 x, ^ref []char8 out, bool by_name = false):
    ref []u32 path
    render(t, x, out, &path, by_name)
    #delete(path)

private void list(^Types t, []u32 xs, []u32 names, ^ref []char8 out, ^ref []u32 path, bool by_name):
    out^ = #append(out^, '(')
    for i in 0..<#len(xs):
        if i > 0: put(out, ", ")
        render(t, xs[i], out, path, by_name)
        if i < #len(names):
            out^ = #append(out^, ' ')
            put(out, t.text(names[i]))
    out^ = #append(out^, ')')

// Whether a function's return spelling needs parentheses before its own.
private bool prefixed(string8 s):
    if #len(s) == 0: return false
    if s[0] == '[' || s[0] == '^' || s[0] == '@': return true
    for w in QUALS:
        if #len(s) > #len(w) && s[0..<#len(w)] == w && s[#len(w)] == ' ': return true
    for w in ("distinct ", "async ", "#soa "):
        if #len(s) >= #len(w) && s[0..<#len(w)] == w: return true
    return false

private void render(^Types t, u32 x, ^ref []char8 out, ^ref []u32 path, bool by_name):
    for p in path^:
        if p == x:
            put(out, "...")
            return
    path^ = #append(path^, x)
    u8 g = t.tag[x]
    u32 a = t.a[x]
    u32 b = t.b[x]
    []u32 xs = t.list(x)
    if g == T_PRIM:
        PrimRow p = PRIM[a]
        string8 pn = p.name if p.flexible else PRIM[p.canon].name
        // A script's spelling (Rust's `dados_spelling`): `int`, `float`, `byte`.
        if t.dspell && !p.flexible && p.canon == P_I64: pn = "int"
        if t.dspell && !p.flexible && p.canon == P_F64: pn = "float"
        if t.dspell && !p.flexible && p.canon == P_U8: pn = "byte"
        put(out, pn)
    else if g == T_BUILTIN || g == T_OPAQUE || g == T_TRAIT:
        put(out, t.text(a))
        if g == T_OPAQUE && !by_name:
            put(out, " = ")
            put(out, t.text(a))
    else if g == T_CSCALAR:
        put(out, "#c.")
        put(out, C_SCALARS[a].name)
    else if g == T_REF:
        put(out, "ref(")
        render(t, a, out, path, by_name)
        put(out, ")")
    else if g == T_TUPLE:
        u32 e = NONE
        i64 n = 0
        if t.uniform(x, &e, &n):
            put(out, "[")
            put_u64(out, u64(n))
            put(out, "]")
            render(t, e, out, path, by_name)
        else:
            list(t, xs, nil, out, path, by_name)
    else if g == T_SLICE || g == T_PTR:
        put(out, "[]" if g == T_SLICE else "^")
        render(t, a, out, path, by_name)
    else if g == T_MAP:
        put(out, "{")
        render(t, a, out, path, by_name)
        put(out, ": ")
        render(t, b, out, path, by_name)
        put(out, "}")
    else if g == T_FUNC:
        []u32 params = xs
        if b == F_PLAIN: put(out, "!")
        if b == F_TYPED:
            render(t, xs[0], out, path, true)
            put(out, "!")
            params = xs[1..<#len(xs)]
        ref []char8 ret
        render(t, a, &ret, path, by_name)
        string8 r = ret
        bool wrap = prefixed(r)
        if wrap: put(out, "(")
        put(out, r)
        if wrap: put(out, ")")
        #delete(ret)
        list(t, params, nil, out, path, by_name)
    else if g == T_MATRIX:
        put(out, "[")
        put_u64(out, u64(a))
        put(out, ",")
        put_u64(out, u64(b))
        put(out, "]")
        u32 e = NONE
        i64 n = 0
        u32 col = xs[0]
        if t.uniform(col, &e, &n): col = e
        if t.uniform(col, &e, &n): col = e
        render(t, col, out, path, by_name)
    else if g == T_DISTINCT:
        put(out, "distinct ")
        put(out, t.text(a))
        put(out, ": ")
        render(t, b, out, path, by_name)
    else if g == T_UNION:
        put(out, "union ")
        put(out, t.text(a))
        put(out, ": ")
        list(t, xs, t.slot_names(x), out, path, by_name)
    else if g == T_CHANNEL:
        put(out, "#channel(")
        if b == 0: put(out, "latest")
        else: put_u64(out, u64(b - 1))
        put(out, ") ")
        put(out, t.text(a))
        list(t, xs, t.slot_names(x), out, path, by_name)
    else if g == T_SOA:
        put(out, "#soa ")
        render(t, a, out, path, by_name)
    else if g == T_QUAL:
        bool first = true
        for i in 0..<4:
            if a & (1 << u32(i)) != 0:
                if !first: put(out, " ")
                put(out, QUALS[i])
                first = false
        put(out, " ")
        render(t, b, out, path, by_name)
    else if g == T_ALIGNED:
        put(out, "@align(")
        put_u64(out, u64(a))
        put(out, ") ")
        render(t, b, out, path, by_name)
    else if g == T_TYPE:
        put(out, "type")
    else if g == T_NAMED:
        put(out, t.text(b))
        if !by_name:
            put(out, " = ")
            if x in t.ftag:
                u32 tg = 0
                try tg = t.ftag[x] else: tg = 0
                put(out, "distinct ")
                put(out, t.text(tg))
                put(out, ": ")
            if t.body[x] == NONE: put(out, "?")
            else: render(t, t.body[x], out, path, by_name)
    #truncate(path^, #len(path^) - 1)
