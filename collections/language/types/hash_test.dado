@test
// MurmurHash3 x64_128 against the reference, and streaming against one shot.
package types


private bool is(Hash h, u64 lo, u64 hi, string8 what):
    return #expect(h.lo == lo && h.hi == hi, what, ": ", h.lo, " ", h.hi)

i32 test():
    bool ok = is(hash_of(""), 0, 0, "empty")
    ok = is(hash_of("", 1), 0x4610ABE56EFF5CB5, 0x51622DAA78F83583, "empty, seed 1") && ok
    ok = is(hash_of("hello"), 0xCBD8A7B341BD9B02, 0x5B1E906A48AE1D19, "hello") && ok
    ok = is(hash_of("The quick brown fox jumps over the lazy dog"), 0xE34BBC7BBC071B6C, 0x7A433CA9C49A9347, "fox") && ok
    ref []char8 pb
    for i in 0..<40:
        pb = #append(pb, char8(u8((i * 7 + 3) % 256)))
    string8 p = pb
    ok = is(hash_of(p), 0x673BFF07BD120303, 0xF0656121415A2357, "pattern") && ok
    for cut in 0..<41:
        Hasher h = hasher()
        h.bytes(p[0..<cut])
        h.bytes(p[cut..<40])
        ok = #expect(h.finish().same(hash_of(p)), "split at ", cut) && ok
    for lead in 0..<17:
        Hasher w = hasher()
        Hasher b = hasher()
        w.bytes(p[0..<lead])
        b.bytes(p[0..<lead])
        w.word(0x0807060504030201)
        b.bytes("\x01\x02\x03\x04\x05\x06\x07\x08")
        ok = #expect(w.finish().same(b.finish()), "word after ", lead) && ok
    Hasher x = hasher()
    x.text("ab")
    x.text("c")
    Hasher y = hasher()
    y.text("a")
    y.text("bc")
    ok = #expect(!x.finish().same(y.finish()), "text is framed") && ok
    ok = #expect(hash_of("a").order(hash_of("a")) == 0, "order") && ok
    #delete(pb)
    return 0 if ok else 1
