// C layout: size, alignment and member offsets, computed once per type.
package types

private const u8 L_OPEN = 1
private const u8 L_DONE = 2
private const u8 L_NONE = 3

type Layout:
    u64 size
    u64 align

private u64 round_up(u64 n, u64 to):
    return n if to <= 1 else (n + to - 1) / to * to

// Whether `x` has a C layout; then `size_of`, `align_of` and `offsets` answer.
bool laid(^Types t, u32 x):
    u32 r = t.lres(x)
    if r == NONE: return false
    u8 s = t.lstate[r]
    if s != 0: return s == L_DONE
    t.lstate[r] = L_OPEN
    bool ok = lay(t, r)
    t.lstate[r] = L_DONE if ok else L_NONE
    return ok

u64 size_of(^Types t, u32 x):
    return t.size[t.lres(x)]

u64 align_of(^Types t, u32 x):
    return t.align[t.lres(x)]

// One offset per member: a tuple's slots, a run's pointer and length, a
// union's payload and tag. A tag (`distinct`, a qualifier) has its shape's.
[]u64 offsets(^Types t, u32 x):
    u32 r = t.lres(x)
    return t.offs.get(t.ol[r])

private void set(^Types t, u32 r, u64 size, u64 align, u32 l):
    t.size[r] = size
    t.align[r] = align
    t.ol[r] = l

private void scalar(^Types t, u32 r, u64 n):
    u32 l = t.offs.open(1)
    t.offs.add(0)
    set(t, r, n, n, l)

// Members of these sizes and alignments, end to end.
private void seq(^Types t, u32 r, ..u64 sa):
    seq_of(t, r, sa)

private void seq_of(^Types t, u32 r, []u64 sa):
    u32 l = t.offs.open(#len(sa) / 2)
    u64 size = 0
    u64 align = 1
    i64 i = 0
    for i < #len(sa):
        size = round_up(size, sa[i + 1])
        t.offs.add(size)
        size += sa[i]
        if sa[i + 1] > align: align = sa[i + 1]
        i += 2
    set(t, r, round_up(size, align), align, l)

private void same(^Types t, u32 r, u32 x):
    u32 q = t.lres(x)
    t.size[r] = t.size[q]
    t.align[r] = t.align[q]
    t.ol[r] = t.ol[q]

private bool lay(^Types t, u32 r):
    u64 w = t.word
    u8 g = t.tag[r]
    if g == T_PRIM:
        PrimRow p = PRIM[t.a[r]]
        if p.kind == K_VOID: return false
        scalar(t, r, w if p.kind == K_PTR else u64(p.bits / 8))
        return true
    if g == T_PTR || g == T_FUNC:
        scalar(t, r, w)
        return true
    if g == T_CSCALAR:
        u8 z = C_SCALARS[t.a[r]].size
        if z == 255: return false
        scalar(t, r, w if z == 0 else u64(z))
        return true
    if g == T_BUILTIN:
        string8 n = t.text(t.a[r])
        if n == "cstring":
            scalar(t, r, w)
            return true
        if n != "string8" && n != "string16" && n != "string32": return false
        seq(t, r, w, w, 8, 8)
        return true
    if g == T_SLICE:
        seq(t, r, w, w, 8, 8)
        return true
    if g == T_REF || g == T_MAP:
        u32 h = t.resolve(t.a[r])
        if g == T_REF && h != NONE && t.tag[h] == T_SLICE:
            seq(t, r, w, w, 8, 8, 2 * w, w, 4, 4, 1, 1, 3, 1)
        else:
            seq(t, r, w, w, 2 * w, w)
        return true
    if g == T_TRAIT:
        seq(t, r, w, w, 4, 4)
        return true
    if g == T_DISTINCT || g == T_QUAL || g == T_MATRIX || g == T_ALIGNED:
        u32 under = t.list(r)[0] if g == T_MATRIX else t.b[r]
        if !laid(t, under): return false
        same(t, r, under)
        if g == T_ALIGNED && u64(t.a[r]) > t.align[r]:
            t.align[r] = u64(t.a[r])
            t.size[r] = round_up(t.size[r], t.align[r])
        return true
    ref []u64 sa
    bool ok = members(t, r, &sa)
    if ok && g == T_UNION:
        u64 size = 0
        u64 align = 1
        i64 i = 0
        for i < #len(sa):
            if sa[i] > size: size = sa[i]
            if sa[i + 1] > align: align = sa[i + 1]
            i += 2
        size = round_up(size, align)
        if t.b[r] != 0:
            scalar(t, r, size)
            t.align[r] = align
        else:
            seq(t, r, size, align, 4, 4)
    else if ok:
        seq_of(t, r, sa)
    #delete(sa)
    return ok

// Sizes and alignments of a tuple's slots, a union's members or a `#soa`'s runs.
private bool members(^Types t, u32 r, ^ref []u64 sa):
    u8 g = t.tag[r]
    u64 n = 1
    []u32 ms = t.list(r)
    if g == T_SOA:
        u32 e = NONE
        i64 k = 0
        if !t.uniform(t.a[r], &e, &k): return false
        n = u64(k)
        ms = t.slots(e)
    else if g != T_TUPLE && g != T_UNION:
        return false
    if #len(ms) == 0 && g == T_TUPLE: return false
    for m in ms:
        if !laid(t, m): return false
        u32 q = t.lres(m)
        sa^ = #append(sa^, t.size[q] * n)
        sa^ = #append(sa^, t.align[q])
    return true
