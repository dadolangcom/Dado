// The 128-bit content hash: MurmurHash3 x64_128, streamed. A hash is what
// names content in a key; a handle never does.
package types

type Hash:
    u64 lo
    u64 hi

    bool same(self, Hash o):
        return self.lo == o.lo && self.hi == o.hi

    // Orders hashes, for sorting by content: -1, 0 or 1.
    i32 order(self, Hash o):
        if self.hi != o.hi: return -1 if self.hi < o.hi else 1
        if self.lo != o.lo: return -1 if self.lo < o.lo else 1
        return 0

private const u64 C1 = 0x87C37B91114253D5
private const u64 C2 = 0x4CF5AD432745937F

private u64 rotl(u64 x, u64 n):
    return (x << n) | (x >> (64 - n))

private u64 fmix(u64 k):
    u64 x = k
    x = (x ~ (x >> 33)) * 0xFF51AFD7ED558CCD
    x = (x ~ (x >> 33)) * 0xC4CEB9FE1A85EC53
    return x ~ (x >> 33)

private u64 le64(string8 s, i64 at):
    u64 v = 0
    for j in 0..<8:
        v = v | (u64(u8(s[at + j])) << u64(8 * j))
    return v

// A running hash. `bytes(a); bytes(b)` is `bytes(a ++ b)`; `text` and the
// typed adds are framed, so two fields never run into each other.
type Hasher:
    u64 h1
    u64 h2
    u64 k1
    u64 k2
    u64 len

    private void block(^self):
        u64 k1 = rotl(self.k1 * C1, 31) * C2
        self.h1 = (rotl(self.h1 ~ k1, 27) + self.h2) * 5 + 0x52DCE729
        u64 k2 = rotl(self.k2 * C2, 33) * C1
        self.h2 = (rotl(self.h2 ~ k2, 31) + self.h1) * 5 + 0x38495AB5
        self.k1 = 0
        self.k2 = 0

    void byte(^self, u8 b):
        u64 i = self.len & 15
        if i < 8: self.k1 = self.k1 | (u64(b) << (8 * i))
        else: self.k2 = self.k2 | (u64(b) << (8 * (i - 8)))
        self.len += 1
        if self.len & 15 == 0: self.block()

    // Eight bytes, least significant first.
    void word(^self, u64 x):
        u64 i = self.len & 15
        if i == 0 || i == 8:
            if i == 0: self.k1 = x
            else: self.k2 = x
            self.len += 8
            if i == 8: self.block()
            return
        for j in 0..<8:
            self.byte(u8((x >> u64(8 * j)) & 0xFF))

    void bytes(^self, string8 s):
        i64 i = 0
        i64 n = #len(s)
        for i < n && self.len & 15 != 0:
            self.byte(u8(s[i]))
            i += 1
        for i + 16 <= n:
            self.k1 = le64(s, i)
            self.k2 = le64(s, i + 8)
            self.len += 16
            self.block()
            i += 16
        for i < n:
            self.byte(u8(s[i]))
            i += 1

    // Its length, then its bytes.
    void text(^self, string8 s):
        self.word(u64(#len(s)))
        self.bytes(s)

    void hash(^self, Hash h):
        self.word(h.lo)
        self.word(h.hi)

    Hash finish(self):
        u64 h1 = self.h1
        u64 h2 = self.h2
        u64 t = self.len & 15
        if t > 8: h2 = h2 ~ (rotl(self.k2 * C2, 33) * C1)
        if t > 0: h1 = h1 ~ (rotl(self.k1 * C1, 31) * C2)
        h1 = h1 ~ self.len
        h2 = h2 ~ self.len
        h1 += h2
        h2 += h1
        h1 = fmix(h1)
        h2 = fmix(h2)
        h1 += h2
        h2 += h1
        return Hash(h1, h2)

Hasher hasher(u64 seed = 0):
    return Hasher(seed, seed, 0, 0, 0)

// The hash of `s`'s bytes alone (MurmurHash3_x64_128 with `seed`).
Hash hash_of(string8 s, u64 seed = 0):
    Hasher h = hasher(seed)
    h.bytes(s)
    return h.finish()
