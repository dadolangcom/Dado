// The `Prim` row table and the `#c` scalars: semantic columns only (C
// spellings are `lower`'s).
package types

const u8 P_VOID = 0
const u8 P_BOOL = 1
const u8 P_I8 = 2
const u8 P_I16 = 3
const u8 P_I32 = 4
const u8 P_I64 = 5
const u8 P_U8 = 6
const u8 P_U16 = 7
const u8 P_U32 = 8
const u8 P_U64 = 9
const u8 P_F32 = 10
const u8 P_F64 = 11
const u8 P_RAWPTR = 12
const u8 P_BYTE = 13
const u8 P_INT = 14
const u8 P_FLOAT = 15
const u8 P_CHAR8 = 16
const u8 P_CHAR16 = 17
const u8 P_CHAR32 = 18
const u8 PRIMS = 19

// Kinds of value a prim holds.
const u8 K_VOID = 0
const u8 K_BOOL = 1
const u8 K_SINT = 2
const u8 K_UINT = 3
const u8 K_FLOAT = 4
const u8 K_PTR = 5
const u8 K_CHAR = 6

// `bits` is the width (0 for `void`; a pointer's is the target's word).
type PrimRow:
    string8 name
    u8 canon
    u8 kind
    u8 bits
    bool flexible

const [19]PrimRow PRIM = (
    PrimRow("void", P_VOID, K_VOID, 0, false),
    PrimRow("bool", P_BOOL, K_BOOL, 8, false),
    PrimRow("i8", P_I8, K_SINT, 8, false),
    PrimRow("i16", P_I16, K_SINT, 16, false),
    PrimRow("i32", P_I32, K_SINT, 32, false),
    PrimRow("i64", P_I64, K_SINT, 64, false),
    PrimRow("u8", P_U8, K_UINT, 8, false),
    PrimRow("u16", P_U16, K_UINT, 16, false),
    PrimRow("u32", P_U32, K_UINT, 32, false),
    PrimRow("u64", P_U64, K_UINT, 64, false),
    PrimRow("f32", P_F32, K_FLOAT, 32, false),
    PrimRow("f64", P_F64, K_FLOAT, 64, false),
    PrimRow("rawptr", P_RAWPTR, K_PTR, 0, false),
    PrimRow("byte", P_U8, K_UINT, 8, false),
    PrimRow("int", P_I64, K_SINT, 64, true),
    PrimRow("float", P_F64, K_FLOAT, 64, true),
    PrimRow("char8", P_CHAR8, K_CHAR, 8, false),
    PrimRow("char16", P_CHAR16, K_CHAR, 16, false),
    PrimRow("char32", P_CHAR32, K_CHAR, 32, false),
)

// The prim spelled `s`, or `PRIMS`.
u8 prim_named(string8 s):
    for i in 0..<#len(PRIM):
        if PRIM[i].name == s: return u8(i)
    return PRIMS

// Integer bits of the canonical prim, 0 when it is no integer (`char` is).
u8 integer_bits(u8 p):
    if p >= PRIMS: return 0
    PrimRow r = PRIM[p]
    return r.bits if r.kind == K_SINT || r.kind == K_UINT || r.kind == K_CHAR else 0

bool is_signed(u8 p):
    if p >= PRIMS: return false
    return PRIM[p].kind == K_SINT

bool is_numeric(u8 p):
    u8 k = PRIM[p].kind
    return k == K_SINT || k == K_UINT || k == K_FLOAT || k == K_CHAR

// The categories a `where` names: `int`, `float`, `scalar`.
bool in_int(u8 p):
    u8 k = PRIM[p].kind
    return k == K_SINT || k == K_UINT

bool in_float(u8 p):
    return PRIM[p].kind == K_FLOAT

bool in_scalar(u8 p):
    return in_int(p) || in_float(p)

// C's own scalars, `#c.<name>`.
const u8 CS_SIGNED = 0
const u8 CS_UNSIGNED = 1
const u8 CS_IMPL_INT = 2
const u8 CS_FLOAT = 3
const u8 CS_BOOL = 4
const u8 CS_CHARACTER = 5

// `size` 0 is the target's word; 255 has no size Dado knows.
type CScalar:
    string8 name
    string8 c
    u8 class
    u8 size

const [22]CScalar C_SCALARS = (
    CScalar("char", "char", CS_IMPL_INT, 1),
    CScalar("schar", "signed char", CS_SIGNED, 1),
    CScalar("uchar", "unsigned char", CS_UNSIGNED, 1),
    CScalar("short", "short", CS_SIGNED, 2),
    CScalar("ushort", "unsigned short", CS_UNSIGNED, 2),
    CScalar("int", "int", CS_SIGNED, 4),
    CScalar("uint", "unsigned int", CS_UNSIGNED, 4),
    CScalar("long", "long", CS_SIGNED, 255),
    CScalar("ulong", "unsigned long", CS_UNSIGNED, 255),
    CScalar("llong", "long long", CS_SIGNED, 8),
    CScalar("ullong", "unsigned long long", CS_UNSIGNED, 8),
    CScalar("float", "float", CS_FLOAT, 4),
    CScalar("double", "double", CS_FLOAT, 8),
    CScalar("ldouble", "long double", CS_FLOAT, 255),
    CScalar("bool", "_Bool", CS_BOOL, 1),
    CScalar("size_t", "size_t", CS_UNSIGNED, 0),
    CScalar("ptrdiff_t", "ptrdiff_t", CS_SIGNED, 0),
    CScalar("intptr_t", "intptr_t", CS_SIGNED, 0),
    CScalar("uintptr_t", "uintptr_t", CS_UNSIGNED, 0),
    CScalar("wchar_t", "wchar_t", CS_CHARACTER, 255),
    CScalar("char16_t", "char16_t", CS_CHARACTER, 255),
    CScalar("char32_t", "char32_t", CS_CHARACTER, 255),
)
