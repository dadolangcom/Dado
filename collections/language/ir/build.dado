// Building a `Fn` in the check walk: slots, interned places, ops, and the
// structured bodies (a head's length is the ops after it, nested ones too).
package ir

u32 konst(u32 c):
    return OPD_CONST | c

bool is_const(u32 opd):
    return opd != NONE && (opd & OPD_CONST) != 0

u32 slot(^Fn f, u32 ty, u32 name, u16 flags, u32 node):
    f.slot_ty = #append(f.slot_ty, ty)
    f.slot_name = #append(f.slot_name, name)
    f.slot_flags = #append(f.slot_flags, flags)
    f.slot_node = #append(f.slot_node, node)
    return u32(#len(f.slot_ty) - 1)

private u32 intern(^Fn f, u64 key, u32 root, u32 parent, u8 step, u32 val, u32 ty):
    if key in f.pmap:
        try u32 p = f.pmap[key] else: return NONE
        return p
    u32 id = u32(#len(f.root))
    f.root = #append(f.root, root)
    f.plo = #append(f.plo, u32(#len(f.step)))
    if parent != NONE:
        for i in f.plo[parent]..<f.phi[parent]:
            f.step = #append(f.step, f.step[i])
            f.step_val = #append(f.step_val, f.step_val[i])
        f.step = #append(f.step, step)
        f.step_val = #append(f.step_val, val)
    f.phi = #append(f.phi, u32(#len(f.step)))
    f.place_ty = #append(f.place_ty, ty)
    f.pmap[key] = id
    return id

// The place that is slot `s` (or a global, `ROOT_GLOBAL | g`).
u32 at(^Fn f, u32 s):
    u32 ty = f.glob_ty[s & ~ROOT_GLOBAL] if (s & ROOT_GLOBAL) != 0 else f.slot_ty[s]
    return intern(f, (u64(1) << 63) | u64(s), s, NONE, 0, 0, ty)

// `p` and one more step.
u32 step(^Fn f, u32 p, u8 st, u32 val, u32 ty):
    if p == NONE: return NONE
    return intern(f, (u64(p) << 40) | (u64(st) << 32) | u64(val), f.root[p], p, st, val, ty)

u32 op(^Fn f, u8 o, u8 sub, u32 ty, u32 node, u32 dst, u32 a, u32 b = NONE, u32 c = NONE):
    f.op = #append(f.op, o)
    f.sub = #append(f.sub, sub)
    f.facts = #append(f.facts, 0)
    f.ty_of = #append(f.ty_of, ty)
    f.node = #append(f.node, node)
    f.dst = #append(f.dst, dst)
    f.a = #append(f.a, a)
    f.b = #append(f.b, b)
    f.c = #append(f.c, c)
    f.alo = #append(f.alo, u32(#len(f.args)))
    f.ahi = #append(f.ahi, u32(#len(f.args)))
    return u32(#len(f.op) - 1)

// An operand of the last op.
void arg(^Fn f, u32 opd, u8 pass = PASS_VALUE):
    f.args = #append(f.args, opd)
    f.pass = #append(f.pass, pass)
    f.ahi[#len(f.ahi) - 1] = u32(#len(f.args))

[]u32 args(^Fn f, u32 i):
    return f.args[i64(f.alo[i])..<i64(f.ahi[i])]

u32 count(^Fn f):
    return u32(#len(f.op))

// Ends a head's body (an IF's else, after `otherwise`).
void close(^Fn f, u32 head):
    u32 n = count(f) - head - 1
    if f.op[head] == O_IF:
        if f.b[head] == NONE: f.b[head] = n
        else: f.c[head] = n - f.b[head]
        if f.c[head] == NONE: f.c[head] = 0
    else:
        f.a[head] = n

// An IF's then-body ends here and its else-body starts.
void otherwise(^Fn f, u32 head):
    f.b[head] = count(f) - head - 1

// A head's whole length.
u32 span(^Fn f, u32 i):
    u8 o = f.op[i]
    if o == O_IF: return f.b[i] + f.c[i]
    if o == O_BLOCK || o == O_LOOP: return f.a[i]
    return 0

// The function reference `(pkg, name)`, added once.
u32 fn_ref(^Fn f, u32 pkg, u32 name, u8 flags):
    for i in 0..<#len(f.ref_name):
        if f.ref_name[i] == name && f.ref_pkg[i] == pkg: return u32(i)
    f.ref_pkg = #append(f.ref_pkg, pkg)
    f.ref_name = #append(f.ref_name, name)
    f.ref_flags = #append(f.ref_flags, flags)
    return u32(#len(f.ref_name) - 1)

// Structure holds: every body ends inside its parent, operands name slots,
// places or constants that exist. Answers the first bad op, or NONE.
u32 verify(^Fn f):
    ref []u32 ends
    ends = #append(ends, count(f))
    for i in 0..<count(f):
        for #len(ends) > 0 && ends[#len(ends) - 1] <= i:
            #truncate(ends, #len(ends) - 1)
        u32 e = i + 1 + span(f, i)
        if #len(ends) > 0 && e > ends[#len(ends) - 1]: return i
        if span(f, i) > 0 || f.op[i] == O_IF || f.op[i] == O_BLOCK || f.op[i] == O_LOOP: ends = #append(ends, e)
        if f.dst[i] != NONE && f.dst[i] >= u32(#len(f.root)): return i
        for x in args(f, i):
            if !is_const(x) && x >= u32(#len(f.root)): return i
    #delete(ends)
    return NONE
