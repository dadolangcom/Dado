// The IR: typed, structured, flat, one `Fn` per function, method, instance,
// default body or script function. Monomorphic, not SSA. Outside references
// are `TypeId`, `StrId`, `ConstId` and the function's own `refs` (package +
// mangled name). Definitions for P3's subset; the rest of the op set joins
// with its family.
package ir

const u32 NONE = 0xFFFFFFFF

// Ops. A body is the ops after its head, `len` of them; `break n` and
// `continue n` count enclosing bodies outward from 0.
const u8 O_BLOCK = 0          // a=len
const u8 O_LOOP = 1           // a=len; falling off the end continues; a walk: b=the place walked, c=its node
const u8 O_IF = 2             // a=cond, b=then len, c=else len: then, then else
const u8 O_BREAK = 3          // a=depth
const u8 O_CONTINUE = 4       // a=depth
const u8 O_RETURN = 5         // a=value or NONE
const u8 O_RETURN_FAIL = 6    // a=code; sub 1: known nonzero; b, c: the constant named, its alias
const u8 O_SET = 7            // dst = a
const u8 O_UN = 8             // dst = sub a
const u8 O_BIN = 9            // dst = a sub b
const u8 O_CONV = 10          // dst = conv(sub) a
const u8 O_CHECK = 11         // check(sub) over a, b (already filtered by build mode)
const u8 O_MAKE = 12          // dst = (args…), a tuple
const u8 O_CALL = 13          // dst = refs[a](args…); c = failure out-slot or NONE
const u8 O_CALL_INDIRECT = 14 // dst = a(args…); c as O_CALL
const u8 O_INTRINSIC = 15     // dst = sub(args…); sub is a `check.B_*` verb
const u8 O_C_INLINE = 16      // a=text StrId, b=effects (E_*)
const u8 O_ADDR = 17          // dst = &a, a place; its root slot is address-taken
const u8 O_SCOPE_END = 18     // args = the slots whose scope ends here
const u8 O_VIEW = 19          // dst = a view of place a from b to c (NONE: its ends); an arg: a run of one
const u8 O_MOVE = 20          // the block under handle place a may move (sub=MV_*); node: the handle; b: the verb's node
const u8 O_QUIT = 21          // the program exits with status a

// `sub` of O_MOVE.
const u8 MV_FREE = 0
const u8 MV_APPEND = 1
const u8 MV_RESIZE = 2
const u8 MV_REBIND = 3
const u8 MV_INSERT = 4
const u8 MV_REMOVE = 5
const u8 MV_SEND = 6
const u8 MV_DRAIN = 7
const u8 MV_RESET = 8         // `arena.reset`/`destroy` of the arena that minted it

// `sub` of O_UN and O_BIN.
const u8 U_NEG = 0
const u8 U_NOT = 1
const u8 U_BITNOT = 2
const u8 B_ADD = 0
const u8 B_SUB = 1
const u8 B_MUL = 2
const u8 B_DIV = 3
const u8 B_REM = 4
const u8 B_AND = 5
const u8 B_OR = 6
const u8 B_XOR = 7
const u8 B_SHL = 8
const u8 B_SHR = 9
const u8 B_EQ = 10
const u8 B_NE = 11
const u8 B_LT = 12
const u8 B_LE = 13
const u8 B_GT = 14
const u8 B_GE = 15

// `sub` of O_CONV: the closed list, so far the slice's.
const u8 CV_WIDEN = 0         // an integer to a wider one, sign from the source
const u8 CV_WRAP = 1          // an integer to a narrower one, or across signedness
const u8 CV_INT_FLOAT = 2
const u8 CV_FLOAT_INT = 3
const u8 CV_FLOAT_WIDTH = 4
const u8 CV_TO_RAWPTR = 5     // `^T` or a function value to `rawptr`
const u8 CV_FROM_RAWPTR = 6
const u8 CV_LEND = 7          // `ref []T` to `[]T`, `ref []char8` to `string8`
const u8 CV_CSTRING = 8       // `[]char8` / `ref []char8` to `cstring`
const u8 CV_FROM_CSTRING = 9  // `cstring` to `string8`, borrowed (nil is empty)
const u8 CV_RETAG = 10        // a view conversion written as a call: as CV_LEND, never exact
const u8 CV_CROSS = 11        // one shape between a `foreign` type's C spelling and another
const u8 CV_UNION = 12        // a member tagged as union member b
const u8 CV_TAG = 13          // a union's tag
const u8 CV_MEMBER = 14       // a union's member b, whatever its tag
const u8 CV_TAIL = 15         // `^S` to its `[_]T` tail's first element, C member b

// `sub` of O_CHECK.
const u8 CK_BOUNDS = 0        // a=index, b=length; an arg: the place indexed (node: its base)
const u8 CK_WINDOW = 1
const u8 CK_NARROW = 2        // the value changes in a narrowing: a=from, b=to
const u8 CK_BITS = 3
const u8 CK_OVERFLOW = 4      // the O_BIN before it
const u8 CK_STALE = 5
const u8 CK_FLOAT_INT = 6
const u8 CK_SENT = 7          // a=a handle place read here (a `#send` may have moved it)

// Op facts.
const u8 F_PURE = 1
const u8 F_MAY_TRAP = 2

// O_C_INLINE effects.
const u8 E_READS = 1
const u8 E_WRITES = 2
const u8 E_DIVERGES = 4

// An operand is a place, or a constant with `OPD_CONST` set.
const u32 OPD_CONST = 0x80000000

// A place's root is a slot, or a global with `ROOT_GLOBAL` set. Steps:
const u32 ROOT_GLOBAL = 0x80000000
const u8 ST_FIELD = 0         // val=slot index of a tuple (its name comes from the type)
const u8 ST_INDEX = 1         // val=an operand
const u8 ST_DEREF = 2

// Slot flags.
const u16 S_PARAM = 1
const u16 S_USER = 2
const u16 S_TEMP = 4
const u16 S_RECEIVER = 8
const u16 S_COPY = 16
const u16 S_ADDR_TAKEN = 32
const u16 S_READ = 64         // still read after build-mode filtering
const u16 S_ONE = 128         // written `[1]T`: windows as a run of one
const u16 S_WATCH = 256       // a view whose reads a dev build checks for staleness (WRN0803)
const u16 S_CONST = 512       // a local `const`: no place

// Argument passing.
const u8 PASS_VALUE = 0
const u8 PASS_POINTER = 1
const u8 PASS_REF = 2
const u8 PASS_LENT = 3

// A function reference's flags.
const u8 R_DIVERGES = 1
const u8 R_FAILABLE = 2
const u8 R_RETURNLESS = 4
const u8 R_FOREIGN = 8

const u8 D_DADO = 0
const u8 D_SCRIPT = 1

// Function header flags.
const u8 H_ENTRY = 1
const u8 H_NAMES_CALLER = 2
const u8 H_FAILABLE = 4
// Its check raised an error: analysis skips it.
const u8 H_BROKEN = 8

// One function's IR. `node` is item-relative (from the item's first node),
// so a body that moves keeps its IR and its hash.
type Fn:
    u32 pkg
    u32 name
    u32 file
    u32 item
    u8 dialect
    u8 flags
    u32 ty
    u32 params
    // Ops.
    ref []u8 op
    ref []u8 sub
    ref []u8 facts
    ref []u32 ty_of
    ref []u32 node
    ref []u32 dst
    ref []u32 a
    ref []u32 b
    ref []u32 c
    ref []u32 alo
    ref []u32 ahi
    // Operands of calls and makes, with how each is passed.
    ref []u32 args
    ref []u8 pass
    // Slots; params first, in order.
    ref []u32 slot_ty
    ref []u32 slot_name
    ref []u16 slot_flags
    ref []u32 slot_node
    // Places, interned per function: a root and its steps.
    ref []u32 root
    ref []u32 plo
    ref []u32 phi
    ref []u8 step
    ref []u32 step_val
    ref []u32 place_ty
    // Function references: package, mangled name, R_* flags.
    ref []u32 ref_pkg
    ref []u32 ref_name
    ref []u8 ref_flags
    // Globals a place may root at: package, name, type.
    ref []u32 glob_pkg
    ref []u32 glob_name
    ref []u32 glob_ty
    {u64: u32} pmap

    void free(^self):
        #delete(self.op)
        #delete(self.sub)
        #delete(self.facts)
        #delete(self.ty_of)
        #delete(self.node)
        #delete(self.dst)
        #delete(self.a)
        #delete(self.b)
        #delete(self.c)
        #delete(self.alo)
        #delete(self.ahi)
        #delete(self.args)
        #delete(self.pass)
        #delete(self.slot_ty)
        #delete(self.slot_name)
        #delete(self.slot_flags)
        #delete(self.slot_node)
        #delete(self.root)
        #delete(self.plo)
        #delete(self.phi)
        #delete(self.step)
        #delete(self.step_val)
        #delete(self.place_ty)
        #delete(self.ref_pkg)
        #delete(self.ref_name)
        #delete(self.ref_flags)
        #delete(self.glob_pkg)
        #delete(self.glob_name)
        #delete(self.glob_ty)
