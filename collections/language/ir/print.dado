// A debug dump of a `Fn`: one op per line, bodies indented. Not an oracle stream.
package ir

private const [22]string8 OPS = ("block", "loop", "if", "break", "continue", "return", "return.fail", "set", "un", "bin", "conv", "check", "make", "call", "call.indirect", "intrinsic", "c.inline", "addr", "scope.end", "view", "move", "quit")

private void put(^ref []char8 out, string8 s):
    for c in s:
        out^ = #append(out^, c)

private void opd(^ref []char8 out, ^Fn f, u32 x):
    if x == NONE: put(out, "_")
    else if is_const(x): put(out, #format("k", x & ~OPD_CONST))
    else if x >= #len(f.root): put(out, #format("?", x))
    else:
        put(out, #format("s", f.root[x]))
        for j in f.plo[x]..<f.phi[x]:
            if f.step[j] == ST_FIELD: put(out, #format(".", f.step_val[j]))
            else: put(out, "[]")

void print(^Fn f, ^ref []char8 out):
    ref []u32 ends
    for i in 0..<count(f):
        for #len(ends) > 0 && ends[#len(ends) - 1] <= i:
            #truncate(ends, #len(ends) - 1)
        for _ in 0..<#len(ends):
            put(out, "  ")
        if f.dst[i] != NONE:
            opd(out, f, f.dst[i])
            put(out, " = ")
        put(out, OPS[f.op[i]])
        put(out, #format(" ", f.sub[i], " "))
        u8 o = f.op[i]
        // `a` and scope-end args are not places for these.
        if o == O_BREAK || o == O_CONTINUE || o == O_CALL || o == O_C_INLINE: put(out, #format("#", f.a[i]))
        else if o != O_BLOCK && o != O_LOOP: opd(out, f, f.a[i])
        for x in args(f, i):
            out^ = #append(out^, ' ')
            if o == O_SCOPE_END: put(out, #format("s", x))
            else: opd(out, f, x)
        out^ = #append(out^, '\n')
        u32 s = span(f, i)
        if s > 0 || f.op[i] == O_IF || f.op[i] == O_LOOP || f.op[i] == O_BLOCK: ends = #append(ends, i + 1 + s)
    #delete(ends)
