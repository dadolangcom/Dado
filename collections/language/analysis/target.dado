// ERR1032: a live `foreign` block naming a hosted
// header on a build with no C library (`#WEB`, `#NONE`). The refused
// package's other diagnostics follow from it, so they are dropped.
package analysis

import "core:strings"
import "language:check"
import "language:diag"
import "language:index"
import "language:ir"
import "language:syntax"

private const [9]string8 FREE_H = ("float.h", "iso646.h", "limits.h", "stdalign.h", "stdarg.h", "stdbool.h", "stddef.h", "stdint.h", "stdnoreturn.h")
private const [3]string8 WEB_H = ("math.h", "dado/web.h", "quickjs.h")

void hosted_headers(^check.World w):
    if w.os != "WEB" && w.os != "NONE": return
    i64 np = #len(w.p.pkgs)
    ref []bool live = live_pkgs(w)
    ref []u32 parent
    for _ in 0..<np:
        parent = #append(parent, check.NONE)
    // Shortest import chains from the root, neighbours in key order.
    ref []u32 work
    work = #append(work, 0)
    ref []bool seen
    for _ in 0..<np:
        seen = #append(seen, false)
    seen[0] = true
    i64 at = 0
    for at < #len(work):
        u32 p = work[at]
        at += 1
        ref []string8 ks
        ref []u32 ps
        for im in w.p.pkgs[p].imports:
            if im.pkg == check.NONE || seen[im.pkg]: continue
            bool dup = false
            for x in ps:
                if x == im.pkg: dup = true
            if dup: continue
            ks = #append(ks, w.p.pkgs[im.pkg].key)
            ps = #append(ps, im.pkg)
            i64 k = #len(ks) - 1
            for k > 0 && strings.before(ks[k], ks[k - 1]):
                string8 tk = ks[k]
                ks[k] = ks[k - 1]
                ks[k - 1] = tk
                u32 tp = ps[k]
                ps[k] = ps[k - 1]
                ps[k - 1] = tp
                k -= 1
        for x in ps:
            seen[x] = true
            parent[x] = p
            work = #append(work, x)
    ref []bool refused
    for _ in 0..<np:
        refused = #append(refused, false)
    for p in 0..<u32(np):
        if !live[p]: continue
        for f in w.p.pkgs[p].flo..<w.p.pkgs[p].fhi:
            // A script's `foreign "x.js":` names JavaScript, not a C header.
            if check.ds_file(w, f): continue
            syntax.Ast a = w.p.files[f].a
            ref []u32 fbs
            check.file_blocks(w, f, &fbs)
            for n in fbs:
                if (a.a[n] & syntax.F_FREE) != 0: continue
                string8 h = lit(w, f, a.main[n])
                if strings.starts_with(h, "./") || strings.starts_with(h, "../") || one_of(h, FREE_H[:]) || w.os == "WEB" && one_of(h, WEB_H[:]): continue
                refused[p] = true
                ref []string8 back
                u32 x = p
                for _ in 0..<np:
                    if parent[x] == check.NONE:
                        back = #append(back, check.name_of(w, w.p.pkgs[x].name))
                        break
                    back = #append(back, imp_spelled(w, parent[x], x))
                    x = parent[x]
                ref []string8 hops
                for k in 0..<#len(back):
                    hops = #append(hops, back[#len(back) - 1 - k])
                string8 ch = index.hold(strings.join(hops[:], " → "))
                string8 msg = index.hold(#format("this web build (`#OS` is `#WEB`) has no C library, and it reaches `foreign \"", h, "\"`\x1fIt is reached through ", ch, " → foreign \"", h, "\". `<", h, ">` is not one of the nine headers C11 §4p6 gives a freestanding implementation, and a web program has no C library behind it: files and the environment reach a web program through DadoScript, the JavaScript the compiler emits beside the module, not through a C header"))
                if w.os == "NONE": msg = index.hold(#format("this build's target has no operating system (`#OS` is `#NONE`), and it reaches `foreign \"", h, "\"`\x1fIt is reached through ", ch, " → foreign \"", h, "\". `<", h, ">` is not one of the nine headers C11 §4p6 gives a freestanding implementation, so the C compiler would refuse the `#include` and name nothing in Dado"))
                w.d.phase = diag.PH_FACTS
                check.say(w, f, 0, w.p.files[f].t.start[a.main[n]], w.p.files[f].t.end[a.main[n]], 1032, msg, index.hold(#format("guard the block with `when #OS != #", w.os, ":`, keep this build from reaching `", hops[#len(hops) - 1], "`, or, if the program supplies the header, write `@freestanding foreign \"", h, "\":`")))
    quiet(w, &w.d, refused[:])
    quiet(w, &w.p.diags, refused[:])

// The packages the program reaches: the root's, and each a live body is in.
private ref []bool live_pkgs(^check.World w):
    // Once: prune keeps what the live bodies reach.
    if #len(w.live) == 0: prune(w)
    ref []bool live
    for _ in 0..<#len(w.p.pkgs):
        live = #append(live, false)
    live[0] = true
    for i in 0..<#len(w.live):
        if w.live[i] && w.jobs[i].decl != check.NONE: live[w.decls[w.jobs[i].decl].pkg] = true
    return live

private const [37]string8 POSIX_H = ("aio.h", "cpio.h", "dirent.h", "dlfcn.h", "fcntl.h", "fmtmsg.h", "fnmatch.h", "ftw.h", "glob.h", "grp.h", "iconv.h", "langinfo.h", "libgen.h", "monetary.h", "mqueue.h", "ndbm.h", "netdb.h", "nl_types.h", "poll.h", "pthread.h", "pwd.h", "regex.h", "sched.h", "search.h", "semaphore.h", "spawn.h", "strings.h", "stropts.h", "syslog.h", "tar.h", "termios.h", "trace.h", "ulimit.h", "unistd.h", "utime.h", "utmpx.h", "wordexp.h")
private const [9]string8 POSIX_MACROS = ("_POSIX_C_SOURCE", "_POSIX_SOURCE", "_XOPEN_SOURCE", "_XOPEN_SOURCE_EXTENDED", "_GNU_SOURCE", "_DEFAULT_SOURCE", "_BSD_SOURCE", "_SVID_SOURCE", "_DARWIN_C_SOURCE")

// WRN0923 (Rust's `no_arm_for_target`): on `#WINDOWS`, each live package with a
// package-level `foreign` block written against POSIX, once, at its header.
void no_arm_for_target(^check.World w):
    if w.os != "WINDOWS": return
    ref []bool live = live_pkgs(w)
    for p in 0..<u32(#len(w.p.pkgs)):
        if !live[p]: continue
        bool said = false
        for f in w.p.pkgs[p].flo..<w.p.pkgs[p].fhi:
            if said: break
            syntax.Ast a = w.p.files[f].a
            for n in a.list(a.b[a.root]):
                if n == check.NONE || a.tag[n] != syntax.N_FOREIGN: continue
                string8 h = lit(w, f, a.main[n])
                string8 why = ""
                if strings.starts_with(h, "sys/") || strings.starts_with(h, "arpa/") || strings.starts_with(h, "netinet/") || strings.starts_with(h, "net/") || one_of(h, POSIX_H[:]): why = index.hold(#format("`", h, "` is a POSIX header"))
                for m in a.list(a.b[n]):
                    if #len(why) > 0: break
                    if m == check.NONE || a.tag[m] != syntax.N_CLAUSE || w.p.spell(f, m) != "define": continue
                    string8 d = lit(w, f, a.a[m])
                    i64 eq = strings.index_of(d, '=')
                    if eq >= 0: d = d[0..<eq]
                    if one_of(d, POSIX_MACROS[:]): why = index.hold(#format("`", h, "` is asked for with `", d, "`, which is how a C library is asked for its POSIX surface"))
                if #len(why) == 0: continue
                string8 pk = check.name_of(w, w.p.pkgs[p].name)
                w.d.phase = diag.PH_FACTS
                check.say(w, f, 0, w.p.files[f].t.start[a.main[n]], w.p.files[f].t.end[a.main[n]], diag.WRN + 923, index.hold(#format("`--target=", w.triple, "` is `#WINDOWS`, and package `", pk, "`, which this program reaches, has no arm for it: it was written against POSIX")), index.hold(#format("give `", pk, "` a `when #OS == #WINDOWS` arm, or build for a supported target")), index.hold(#format(why, ". `#WINDOWS` is not a supported platform. The C this emits calls what Windows's C library does not declare unless a POSIX layer such as MinGW's or Cygwin's supplies it, and nothing has checked that one does")))
                said = true
                break

// Drops each diagnostic of a refused package but the no-C-library refusals.
private void quiet(^check.World w, ^diag.Diags ds, []bool refused):
    ref []diag.Diag keep
    for d in ds.list:
        if d.file < u32(#len(w.p.files)) && refused[w.p.files[d.file].pkg] && d.code != 1004 && d.code != 1017 && d.code != 1032: continue
        keep = #append(keep, d)
    ds.list = keep

// How package `from` spelled its `import` of `to`, else `to`'s key.
private string8 imp_spelled(^check.World w, u32 from, u32 to):
    for im in w.p.pkgs[from].imports:
        if im.pkg == to: return lit(w, im.file, w.p.files[im.file].a.main[im.node])
    return w.p.pkgs[to].key

// A string token's text.
private string8 lit(^check.World w, u32 f, u32 t):
    ref []char8 v
    syntax.string_value(w.p.files[f].src[i64(w.p.files[f].t.start[t])..<i64(w.p.files[f].t.end[t])], &v)
    return index.hold(v)

private bool one_of(string8 s, []const string8 xs):
    for x in xs:
        if x == s: return true
    return false

// ERR1033 on each `threads.spawn` a live body writes, or one outside every
// body, on an unthreaded web build (Rust's `web_spawn_refusals`). A program
// with no entry has every body live.
void web_spawns(^check.World w):
    if #len(w.spawns) == 0: return
    bool entry = false
    for f in w.fns:
        if (f.flags & ir.H_ENTRY) != 0: entry = true
    if entry && #len(w.live) == 0: prune(w)
    w.d.phase = diag.PH_BODY
    for s in w.spawns:
        bool live = !entry || s.decl == check.NONE
        if !live:
            for i in 0..<#len(w.fns):
                if i < #len(w.live) && w.live[i] && w.jobs[i].decl == s.decl: live = true
        if !live: continue
        check.say(w, s.file, s.base, s.lo, s.hi, 1033, "`threads.spawn` starts a thread, and this web build (`#OS` is `#WEB`) is single-threaded, which is the default\x1fA web module has a thread only when it is compiled with wasm's atomics over a shared memory, which `--web-threads` asks for: each spawn is answered with a worker on that memory. The page is then served with `Cross-Origin-Opener-Policy: same-origin` and `Cross-Origin-Embedder-Policy: require-corp`, without which a page has no shared memory", "build with `--web-threads`, or keep a web build from reaching this call with `when #OS != #WEB:`")
