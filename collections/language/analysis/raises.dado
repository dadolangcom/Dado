// `#assert_raises`: a promised function, and everything it reaches, raises
// into a script (ERR1227 names the first blocker found, breadth first;
// ERR1228 a promise that names nothing).
package analysis

import "language:check"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"

void raises(^check.World w):
    for f in 0..<u32(#len(w.p.files)):
        syntax.Ast a = w.p.files[f].a
        []u32 items = a.list(a.b[a.root])
        for i in 0..<#len(items):
            u32 n = items[i]
            if n == NONE: continue
            if a.tag[n] == syntax.N_ASSERT_RAISES: promise_top(w, f, items, i)
            if a.tag[n] != syntax.N_TYPE: continue
            for p in a.list(a.b[n]):
                if p != NONE && a.tag[p] == syntax.N_ASSERT_RAISES: promise_in(w, f, n, p)

private const string8 AGAIN = "another `#assert_raises`, and one promise is written once"

private void promise_top(^check.World w, u32 f, []u32 items, i64 i):
    syntax.Ast a = w.p.files[f].a
    u32 n = items[i]
    u32 pkg = w.p.files[f].pkg
    if a.a[n] == 1:
        u32 next = items[i + 1] if i + 1 < #len(items) else NONE
        if next != NONE && a.tag[next] == syntax.N_FN:
            promised(w, f, n, next, pkg, w.p.spell(f, next))
            return
        string8 what = AGAIN if next != NONE && a.tag[next] == syntax.N_ASSERT_RAISES else "no function"
        check.say(w, f, 0, a.lo[n], a.hi[n], 1228, index.hold(#format("`#assert_raises` on its own line promises the function declared on the line below it, and that is ", what)), "write it directly above the package-level function it promises, or delete it")
        return
    for x in a.list(a.b[n]):
        if x == NONE: continue
        string8 s = w.p.spell(f, x)
        bool any = false
        bool hit = false
        for j in 0..<#len(w.fns):
            u32 d = w.jobs[j].decl
            if w.decls[d].pkg != pkg || w.decls[d].kind != check.K_FN || check.name_of(w, w.decls[d].name) != s: continue
            any = true
            if !hit: hit = blocked(w, f, x, NONE, u32(j), s)
        if any: continue
        bool declared = false
        for d in w.decls:
            if d.pkg == pkg && d.kind == check.K_FN && check.name_of(w, d.name) == s: declared = true
        if declared: continue
        check.say(w, f, 0, a.lo[x], a.hi[x], 1228, index.hold(#format("`#assert_raises` names `", s, "`, and package `", check.name_of(w, w.p.pkgs[pkg].name), "` declares no function of that name with a body this program checks")), "name a function this package declares at package level by its bare name — a generic one by its template's name; promise a method on the line above it")

// A promise alone in a `type` body: the method on the line below it.
private void promise_in(^check.World w, u32 f, u32 t, u32 n):
    syntax.Ast a = tree_of(w, f)
    u32 next = NONE
    []u32 ks = a.list(a.b[t])
    ref []u32 cands
    for k in ks[3..<#len(ks)]:
        if k != NONE: cands = #append(cands, k)
    if ks[2] != NONE && a.tag[ks[2]] == syntax.N_MEMBERS:
        for m in a.list(a.b[ks[2]]):
            if m != NONE: cands = #append(cands, m)
    for k in cands:
        if a.lo[k] > a.lo[n] && (next == NONE || a.lo[k] < a.lo[next]): next = k
    if next != NONE && a.tag[next] == syntax.N_FN:
        promised(w, f, n, next, w.p.files[f].pkg, index.hold(#format(w.p.spell(f, t), ".", w.p.spell(f, next))))
        return
    string8 what = AGAIN if next != NONE && a.tag[next] == syntax.N_ASSERT_RAISES else "a slot"
    check.say(w, f, 0, a.lo[n], a.hi[n], 1228, index.hold(#format("`#assert_raises` alone in a `type` body promises the method on the line below it, and that is ", what)), "write it directly above the method it promises, or delete it")

private syntax.Ast tree_of(^check.World w, u32 f):
    return w.p.files[f].a

// The function declared by node `fnode`, promised by `n` on the line above.
private void promised(^check.World w, u32 f, u32 n, u32 fnode, u32 pkg, string8 s):
    for j in 0..<#len(w.fns):
        u32 d = w.jobs[j].decl
        if w.decls[d].file == f && w.decls[d].node == fnode && blocked(w, f, fnode, n, u32(j), s): return

private type Blocker:
    u32 file
    u32 node
    bool tok
    string8 what
    string8 repair

// ERR1227 at `at` (a name node, or a declaration's name token) when job `root`
// reaches a blocker.
private bool blocked(^check.World w, u32 f, u32 at, u32 decl_at, u32 root, string8 s):
    {u32: u32} by_name
    for i in 0..<#len(w.fns):
        by_name[w.fns[i].name] = u32(i)
    ref []u32 queue
    ref []u32 parent
    for _ in 0..<#len(w.fns):
        parent = #append(parent, NONE)
    queue = #append(queue, root)
    parent[root] = root
    i64 q = 0
    for q < #len(queue):
        u32 j = queue[q]
        q += 1
        Blocker bk = blocker(w, j)
        if #len(bk.what) > 0:
            ref []string8 chain
            u32 x = j
            for x != root:
                chain = #append(chain, shown(w, x, f))
                x = parent[x]
            ref []char8 m
            m = #append(m, ..s)
            i64 k = #len(chain)
            for k > 0:
                k -= 1
                m = #append(m, .." → ")
                m = #append(m, ..chain[k])
            string8 drop = "delete the `#assert_raises` line above it" if decl_at != NONE else "drop it from the `#assert_raises`"
            string8 msg = index.hold(#format("`", s, "` is promised to raise into a script, and does not: ", index.hold(m), " → ", bk.what))
            string8 help = index.hold(#format(bk.repair, "; or, if `", s, "` is meant to stay C-shaped, ", drop))
            syntax.Ast a = w.p.files[f].a
            if decl_at != NONE: check.say_tok(w, f, 0, at, 1227, msg, help)
            else: check.say(w, f, 0, a.lo[at], a.hi[at], 1227, msg, help)
            string8 last = s if #len(chain) == 0 else chain[0]
            syntax.Ast ba = w.p.files[bk.file].a
            u32 k0 = ba.main[bk.node]
            if bk.tok && k0 != NONE: w.d.label(bk.file, 0, w.p.files[bk.file].t.start[k0], w.p.files[bk.file].t.end[k0], index.hold(#format(last, " does not raise")))
            else: w.d.label(bk.file, 0, ba.lo[bk.node], ba.hi[bk.node], index.hold(#format(last, " does not raise")))
            if decl_at != NONE: w.d.label(f, 0, a.lo[decl_at], a.hi[decl_at], index.hold(#format("`", s, "` is promised here")))
            return true
        ^ir.Fn fn = &w.fns[j]
        for i in 0..<#len(fn.op):
            if fn.op[i] != ir.O_CALL || (fn.ref_flags[fn.a[i]] & ir.R_FOREIGN) != 0: continue
            u32 nm = fn.ref_name[fn.a[i]]
            if !(nm in by_name): continue
            try u32 t = by_name[nm] else: continue
            if parent[t] != NONE: continue
            parent[t] = j
            queue = #append(queue, t)
    return false

private string8 shown(^check.World w, u32 j, u32 f):
    u32 d = w.jobs[j].decl
    string8 s = check.name_of(w, w.decls[d].name)
    if w.decls[d].kind == check.K_METHOD: s = index.hold(#format(check.name_of(w, w.decls[w.decls[d].block].name), ".", s))
    if w.decls[d].pkg != w.p.files[f].pkg: s = index.hold(#format(check.name_of(w, w.p.pkgs[w.decls[d].pkg].name), ".", s))
    return s

// The first blocker in job `j`'s body by position, or one with no `what`.
private Blocker blocker(^check.World w, u32 j):
    ^ir.Fn fn = &w.fns[j]
    u32 d = w.jobs[j].decl
    u32 f = w.decls[d].file
    syntax.Ast a = w.p.files[f].a
    u32 dn = w.decls[d].node
    if a.tag[dn] == syntax.N_FN && (a.a[dn] & syntax.F_VIS) == syntax.VIS_EXPORT: return Blocker(f, dn, true, "an `export`, a symbol promised to C", "a function written for C stays out of a raisable closure: call a plain Dado function that does the same arithmetic")
    if a.tag[dn] == syntax.N_FN && a.list(a.b[dn])[2] != NONE: return Blocker(f, dn, true, "`@symbol`, a fact about the C it emits", "a function written for C stays out of a raisable closure: call a plain Dado function that does the same arithmetic")
    // An address-shaped parameter blocks at the signature.
    for sl in 0..<u32(#len(fn.slot_ty)):
        if (fn.slot_flags[sl] & ir.S_PARAM) == 0: continue
        string8 pa = address(w, fn.slot_ty[sl])
        if #len(pa) > 0: return Blocker(f, dn, true, index.hold(#format("a value of type `", check.shown(w, fn.slot_ty[sl]), "`, ", pa)), "a script has no addresses: compute with values, and keep the address-shaped code outside what the promised function reaches")
    Blocker best = Blocker(f, NONE, false, "", "")
    for i in 0..<#len(fn.op):
        u32 n = fn.node[i]
        if n == NONE || best.node != NONE && a.lo[n] >= a.lo[best.node]: continue
        u8 o = fn.op[i]
        if o == ir.O_CALL && (fn.ref_flags[fn.a[i]] & ir.R_FOREIGN) != 0:
            string8 c = w.t.text(fn.ref_name[fn.a[i]])
            if !vetted(w, c): best = Blocker(f, n, false, index.hold(#format("a call of the `foreign` function `", c, "`")), "a foreign call never raises: compute it in Dado, or move the call out of what the promised function reaches")
            continue
        if o == ir.O_INTRINSIC && (fn.sub[i] >= check.B_ATOMIC_LOAD && fn.sub[i] <= check.B_FENCE || fn.sub[i] == check.B_ALIGN_FORWARD):
            string8 sp = "`#align_forward`" if fn.sub[i] == check.B_ALIGN_FORWARD else "`#fence`" if fn.sub[i] == check.B_FENCE else "an atomic"
            best = Blocker(f, n, false, index.hold(#format(sp, ", C's memory model")), "a script has one thread and no addresses: keep the promised function to plain values")
            continue
        // `#size(T)` is a constant whatever `T` is.
        if o == ir.O_INTRINSIC && (fn.sub[i] == check.B_SIZE || fn.sub[i] == check.B_ALIGN_OF): continue
        u32 ty = fn.ty_of[i]
        if o == ir.O_SET && fn.dst[i] != NONE: ty = fn.place_ty[fn.dst[i]]
        string8 adr = address(w, ty)
        if #len(adr) > 0: best = Blocker(f, n, false, index.hold(#format("a value of type `", check.shown(w, ty), "`, ", adr)), "a script has no addresses: compute with values, and keep the address-shaped code outside what the promised function reaches")
    u32 item = fn.item
    for x in 0..<u32(#len(a.tag)):
        if a.tag[x] != syntax.E_INDEX || a.main[x] == NONE || a.lo[x] < a.lo[item] || a.hi[x] > a.hi[item]: continue
        if best.node == NONE || a.lo[x] < a.lo[best.node]: best = Blocker(f, x, false, "a `#no_bounds` subscript, whose out-of-range meaning is C's", "index with the check, `a[i]`")
    return best

// C's correctly rounded functions, which raise to the script's own.
private bool vetted(^check.World w, string8 c):
    if c != "sqrt" && c != "sqrtf": return false
    for d in w.decls:
        if d.kind != check.K_FFN || check.name_of(w, d.name) != c: continue
        if w.p.spell(d.file, d.block) == "\"math.h\"": return true
    return false

// What makes `ty` address-shaped, or "".
private string8 address(^check.World w, u32 ty):
    u32 t = ty
    for _ in 0..<64:
        if t == NONE: return ""
        u8 g = w.t.tag[t]
        if t == u32(types.P_RAWPTR): return "an untyped address"
        if t == types.CSTRING: return "C's terminated string, an address"
        if g == types.T_CSCALAR: return "a C scalar"
        if g == types.T_OPAQUE: return "an opaque C type"
        if g == types.T_QUAL && w.t.a[t] != 1: return "a C-qualified type"
        if g == types.T_QUAL || g == types.T_DISTINCT || g == types.T_ALIGNED: t = w.t.b[t]
        else if g == types.T_NAMED: t = w.t.body[t]
        else: return ""
    return ""
