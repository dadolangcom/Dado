// The call-graph summary driver, generic over the summary: the client asks
// `next` for a body to (re)compute and says `changed` when its summary grew,
// which queues its callers again; summaries only grow, so cycles settle.
package analysis

import "language:check"
import "language:ir"

type Settle:
    ref []u64 edges
    // Callers of body `c`: `callers[lo[c]..<lo[c + 1]]`, in edge order.
    ref []u32 lo
    ref []u32 callers
    ref []bool queued
    // Every body, callees first (`post_order`); walked round and round in
    // that order, each queued body when the sweep reaches it.
    ref []u32 work
    i64 at
    // Bodies queued.
    i64 nq

Settle settler(^check.World w):
    Settle q
    {u32: u32} by_name
    for i in 0..<#len(w.fns):
        by_name[w.fns[i].name] = u32(i)
    for i in 0..<#len(w.fns):
        ^ir.Fn f = &w.fns[i]
        for k in 0..<ir.count(f):
            if f.op[k] != ir.O_CALL || !(f.ref_name[f.a[k]] in by_name): continue
            try u32 c = by_name[f.ref_name[f.a[k]]] else: continue
            q.edges = #append(q.edges, (u64(c) << 32) | u64(i))
        q.queued = #append(q.queued, true)
    #delete(by_name)
    q.nq = #len(w.fns)
    for _ in 0..=#len(w.fns):
        q.lo = #append(q.lo, 0)
    for e in q.edges:
        q.lo[i64(e >> 32) + 1] += 1
    for i in 0..<#len(w.fns):
        q.lo[i + 1] += q.lo[i]
    ref []u32 at
    for i in 0..<#len(w.fns):
        at = #append(at, q.lo[i])
    for _ in q.edges:
        q.callers = #append(q.callers, 0)
    for e in q.edges:
        u32 c = u32(e >> 32)
        q.callers[at[c]] = u32(e & 0xFFFFFFFF)
        at[c] += 1
    #delete(at)
    post_order(&q, #len(w.fns))
    return q

// The first round's order: callees before their callers (a post-order of the
// call graph), so most bodies are walked once their callees have settled.
private void post_order(^Settle q, i64 n):
    // Callees of body `i`: `cs[clo[i]..<clo[i + 1]]`.
    ref []u32 clo
    ref []u32 cs
    for _ in 0..=n:
        clo = #append(clo, 0)
    for e in q.edges:
        clo[i64(e & 0xFFFFFFFF) + 1] += 1
    for i in 0..<n:
        clo[i + 1] += clo[i]
    ref []u32 at
    for i in 0..<n:
        at = #append(at, clo[i])
    for _ in q.edges:
        cs = #append(cs, 0)
    for e in q.edges:
        u32 i = u32(e & 0xFFFFFFFF)
        cs[at[i]] = u32(e >> 32)
        at[i] += 1
    ref []bool seen
    for _ in 0..<n:
        seen = #append(seen, false)
    // An explicit stack of (body, next callee index).
    ref []u32 sb
    ref []u32 sk
    for r in 0..<n:
        if seen[r]: continue
        seen[r] = true
        sb = #append(sb, u32(r))
        sk = #append(sk, clo[r])
        for #len(sb) > 0:
            i64 t = #len(sb) - 1
            u32 v = sb[t]
            if sk[t] < clo[v + 1]:
                u32 c = cs[sk[t]]
                sk[t] += 1
                if !seen[c]:
                    seen[c] = true
                    sb = #append(sb, c)
                    sk = #append(sk, clo[c])
                continue
            q.work = #append(q.work, v)
            #truncate(sb, t)
            #truncate(sk, t)
    #delete(clo)
    #delete(cs)
    #delete(at)
    #delete(seen)
    #delete(sb)
    #delete(sk)

// The next body to visit, or NONE when every summary has settled.
// A body queued again is walked when the sweep next reaches it, not after
// every body queued before it: in call-graph order, its callees that are
// queued too are walked first (FIFO walked a cycle's bodies about twice).
u32 next(^Settle q):
    for q.nq > 0:
        if q.at >= #len(q.work): q.at = 0
        u32 fi = q.work[q.at]
        q.at += 1
        if !q.queued[fi]: continue
        q.queued[fi] = false
        q.nq -= 1
        return fi
    #delete(q.edges)
    #delete(q.lo)
    #delete(q.callers)
    #delete(q.queued)
    #delete(q.work)
    return NONE

void changed(^Settle q, u32 fi):
    for k in q.lo[fi]..<q.lo[fi + 1]:
        u32 caller = q.callers[k]
        if q.queued[caller]: continue
        q.queued[caller] = true
        q.nq += 1
