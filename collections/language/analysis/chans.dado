// LNT0825: a package-level channel walked from two thread roots (the entry
// point, and each function handed to `threads.spawn`), unless released.
package analysis

import "language:check"
import "language:diag"
import "language:index"
import "language:ir"
import "language:types"

void consumers(^check.World w):
    {u32: u32} by_name
    for i in 0..<#len(w.fns):
        by_name[w.fns[i].name] = u32(i)
    // Each name's first job decides whether a call spawns.
    {u32: bool} spawn
    for j in w.jobs:
        if !(j.cname in spawn): spawn[j.cname] = spawns(w, j.decl)
    ref []u32 roots
    ref []u32 freed
    for i in 0..<#len(w.fns):
        if (w.fns[i].flags & ir.H_ENTRY) != 0: roots = #append(roots, u32(i))
    for i in 0..<#len(w.fns):
        ^ir.Fn f = &w.fns[i]
        for k in 0..<ir.count(f):
            if f.op[k] == ir.O_INTRINSIC && f.sub[k] == check.B_CH_RELEASE: freed = #append(freed, w.t.a[w.t.resolve(f.ty_of[k])])
            if f.op[k] != ir.O_CALL || !(f.ref_name[f.a[k]] in spawn): continue
            try bool sp = spawn[f.ref_name[f.a[k]]] else: continue
            if !sp: continue
            for x in ir.args(f, k):
                if !ir.is_const(x) || w.k.kind[x & ~ir.OPD_CONST] != types.C_FN || !(w.k.b[x & ~ir.OPD_CONST] in by_name): continue
                try u32 r = by_name[w.k.b[x & ~ir.OPD_CONST]] else: continue
                bool have = false
                for y in roots:
                    if y == r: have = true
                if !have: roots = #append(roots, r)
    if #len(roots) < 2: return
    {u32: u32} first
    for r in roots:
        ref []bool seen
        for _ in w.fns:
            seen = #append(seen, false)
        ref []u32 work
        work = #append(work, r)
        i64 at = 0
        for at < #len(work):
            u32 fi = work[at]
            at += 1
            if seen[fi]: continue
            seen[fi] = true
            ^ir.Fn f = &w.fns[fi]
            for k in 0..<ir.count(f):
                if f.op[k] == ir.O_CALL && f.ref_name[f.a[k]] in by_name:
                    try u32 c = by_name[f.ref_name[f.a[k]]] else: continue
                    work = #append(work, c)
        ref []u32 linted
        for fi in 0..<#len(w.fns):
            if !seen[fi]: continue
            ^ir.Fn f = &w.fns[fi]
            for k in 0..<ir.count(f):
                if f.op[k] != ir.O_INTRINSIC || f.sub[k] != check.B_CH_BEGIN: continue
                u32 p = ir.args(f, k)[0]
                if (f.root[p] & ir.ROOT_GLOBAL) == 0 || f.plo[p] != f.phi[p]: continue
                u32 ch = w.t.a[w.t.resolve(f.ty_of[k])]
                bool skip = false
                for x in freed:
                    if x == ch: skip = true
                for x in linted:
                    if x == ch: skip = true
                if skip: continue
                if !(ch in first):
                    first[ch] = r
                    continue
                try u32 o = first[ch] else: continue
                if o == r: continue
                linted = #append(linted, ch)
                string8 msg = index.hold(#format("`", w.t.text(ch), "` is walked from two thread roots, `", root(w, o), "` and `", root(w, r), "`, and a channel has one consumer\x1fIf both run at once the second's walk traps in a debug build and races in a release one. This is a warning while you are writing and an error under `--strict`, which is what the gate builds with\x1ewalk it from one thread root"))
                syntax_say(w, f, f.node[k], msg)

private string8 root(^check.World w, u32 fi):
    check.Decl d = w.decls[w.jobs[fi].decl]
    return index.hold(#format(check.name_of(w, w.p.pkgs[d.pkg].name), ".", check.name_of(w, d.name)))

private bool spawns(^check.World w, u32 decl):
    check.Decl d = w.decls[decl]
    return check.name_of(w, d.name) == "spawn" && check.name_of(w, w.p.pkgs[d.pkg].name) == "threads"

private void syntax_say(^check.World w, ^ir.Fn f, u32 n, string8 msg):
    check.say(w, f.file, w.p.files[f.file].a.lo[f.item], w.p.files[f.file].a.lo[n], w.p.files[f.file].a.hi[n], diag.LNT + 825, msg, "")
