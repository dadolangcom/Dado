// What reaches the build: the bodies a closure from the entry point (and
// `export`s, and the functions package variables hold) calls or names, and
// the `foreign` blocks they or the interfaces of their packages reach.
package analysis

import "language:check"
import "language:ir"
import "language:syntax"
import "language:types"

void prune(^check.World w):
    {u32: u32} by_name
    for i in 0..<#len(w.fns):
        by_name[w.fns[i].name] = u32(i)
        w.live = #append(w.live, false)
    ref []u32 work
    for i in 0..<#len(w.fns):
        if (w.fns[i].flags & ir.H_ENTRY) != 0 || exported(w, w.jobs[i].decl): work = #append(work, u32(i))
    for d in w.globals:
        named_fns(w, w.decls[d].value, &by_name, &work)
    for d in 0..<u32(#len(w.decls)):
        if w.decls[d].kind == check.K_CONST && exported(w, d): named_fns(w, w.decls[d].value, &by_name, &work)
    for x in w.seam_roots:
        if x in by_name:
            try u32 y = by_name[x] else: continue
            work = #append(work, y)
    for dp in w.dispatches:
        for arm in dp.arms:
            if arm.cname in by_name:
                try u32 x = by_name[arm.cname] else: continue
                work = #append(work, x)
    i64 at = 0
    for at < #len(work):
        u32 fi = work[at]
        at += 1
        if w.live[fi]: continue
        w.live[fi] = true
        ^ir.Fn f = &w.fns[fi]
        for k in 0..<ir.count(f):
            if f.op[k] == ir.O_CALL && f.ref_name[f.a[k]] in by_name:
                try u32 c = by_name[f.ref_name[f.a[k]]] else: continue
                work = #append(work, c)
            for x in [f.a[k], f.b[k], f.c[k]]:
                if x != NONE && ir.is_const(x): named_fns(w, x & ~ir.OPD_CONST, &by_name, &work)
        for x in f.args:
            if ir.is_const(x): named_fns(w, x & ~ir.OPD_CONST, &by_name, &work)
    // A block stays when a live body reached it, or its package's interface
    // did and something there lives.
    ref []bool pkg_live
    for _ in w.p.pkgs:
        pkg_live = #append(pkg_live, false)
    pkg_live[0] = true
    for i in 0..<#len(w.fns):
        if w.live[i]: pkg_live[w.decls[w.jobs[i].decl].pkg] = true
    // A package whose variables are written keeps what their types reach.
    for d in w.globals:
        pkg_live[w.decls[d].pkg] = true
    ref []u64 kept
    for j in 0..<#len(w.rkey):
        u64 key = w.reached[w.rkey[j]]
        u32 o = w.rjob[j]
        bool keep = o != NONE && w.live[o] || o == NONE && pkg_live[w.p.files[u32(key >> 32)].pkg]
        bool have = false
        for x in kept:
            if x == key: have = true
        if keep && !have: kept = #append(kept, key)
    // A block that declares nothing (a `when` arm's `define`) stays with any
    // block of its package that does.
    for j in 0..<#len(w.rkey):
        u64 key = w.reached[w.rkey[j]]
        if w.rjob[j] != NONE: continue
        u32 pk = w.p.files[u32(key >> 32)].pkg
        bool with = false
        bool have = false
        for x in kept:
            if x == key: have = true
            if w.p.files[u32(x >> 32)].pkg == pk: with = true
        if with && !have: kept = #append(kept, key)
    #truncate(w.reached, 0)
    for x in kept:
        w.reached = #append(w.reached, x)
    ref []string8 links
    for j in 0..<#len(w.cc_links):
        if j >= #len(w.link_key) || reached_key(w, w.link_key[j]): links = #append(links, w.cc_links[j])
    #truncate(w.cc_links, 0)
    for x in links:
        w.cc_links = #append(w.cc_links, x)
    ref []string8 flags
    for j in 0..<#len(w.cc_flags):
        if j >= #len(w.flag_key) || reached_key(w, w.flag_key[j]): flags = #append(flags, w.cc_flags[j])
    #truncate(w.cc_flags, 0)
    for x in flags:
        w.cc_flags = #append(w.cc_flags, x)
    #delete(kept)
    #delete(pkg_live)
    #delete(work)
    #delete(by_name)

// The functions constant `k` names, through tuples, onto `work`.
private void named_fns(^check.World w, u32 k, ^{u32: u32} by_name, ^ref []u32 work):
    if k == NONE: return
    if w.k.kind[k] == types.C_FN && w.k.b[k] in by_name^:
        try u32 c = by_name^[w.k.b[k]] else: return
        work^ = #append(work^, c)
    if w.k.kind[k] != types.C_TUPLE: return
    for x in w.k.list(k):
        named_fns(w, x, by_name, work)

private bool exported(^check.World w, u32 d):
    syntax.Ast a = w.p.files[w.decls[d].file].a
    return (a.a[w.decls[d].node] & syntax.F_VIS) == syntax.VIS_EXPORT

private bool reached_key(^check.World w, u64 key):
    for x in w.reached:
        if x == key: return true
    return false
