// Shape: which bodies can fall off their end, as the 1-bit instance of
// `flow` (the state is only whether it is reached).
package analysis

import "language:ir"

// Whether control reaches the end of `f`'s body.
bool falls(^ir.Fn f):
    Flow fl = flow(f, 0, nil, idle)
    ref []u64 s = entry(&fl)
    bool r = walk(&fl, &s)
    #delete(s)
    done(&fl)
    return r

private void idle(rawptr ctx, ^Flow fl, u32 i, ^ref []u64 s):
    pass
