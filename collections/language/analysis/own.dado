// Ownership and provenance over the IR, one `flow` instance per body: which
// views point into which handle's block, which moves and frees reach their
// reads (WRN0803 may, ERR0803 must), walks a body moves (WRN0803), and
// growths of a `ref` parameter neither answered nor kept (LNT0830, and the
// summary callers read).
package analysis

import "language:check"
import "language:diag"
import "language:index"
import "language:ir"
import "language:syntax"
import "language:types"
import "core:slices"
import "core:strings"

type Own:
    ^check.World w
    ^ir.Fn f
    bool quiet
    // Dense numbers of view slots, handle slots and move ops (NONE: none).
    ref []u32 vi
    ref []u32 hi
    ref []u32 mi
    ref []u32 moves
    i64 nv
    i64 nh
    i64 nm
    ref []u32 grown_at
    ref []u32 handed_at
    // The `#stack` `#make` whose block a handle was bound to, or NONE.
    ref []u32 stack_at
    u64 now
    // Per function: bit j, a `ref` parameter j grown and neither answered
    // nor kept on some way out.
    ref []u64 grows
    // Per function: bit j, it may answer a view of parameter j.
    ref []u64 rets
    u64 now_rets
    // Per function: bit j, it may answer what parameter j points at (`p^`).
    ref []u64 rets1
    u64 now_rets1
    // Per function: bit j, it may keep views of parameter j in package
    // storage; per handle, where its block's views were first kept so.
    ref []u64 keeps
    u64 now_keeps
    // Per function: bit j, it may keep a copy of what parameter j points at.
    ref []u64 keeps1
    u64 now_keeps1
    // Per slot: the view slot a pointer local points at (`qq = &q`); per
    // frame slot: its address went where this pass cannot follow, views of
    // it were stored through such a pointer; pairs (holder, frame) a call
    // through a function value may have stored.
    ref []u32 pt2
    ref []bool loose_addr
    ref []bool loose_store
    ref []u64 mayin
    ref []u32 exp_at
    // Exposing sites (ops that may store views in package storage): per op its
    // site (NONE), per site its node, call (NONE: a store) and the handles it
    // exposed; a state bit per site. Per handle: the sites that exposed it.
    ref []u32 esite
    ref []u32 es_at
    ref []u32 es_by
    ref [](ref []u32) es_h
    i64 nes
    // The call that kept them there (NONE: a store, named at `exp_at`).
    ref []u32 exp_by
    // Per function: bit j, `ref` parameter j freed on every way out; per
    // handle, the call that freed it so.
    ref []u64 frees
    u64 now_frees
    i64 leaves
    ref []u32 killed_at
    // Handle places, frame slots, call moves, temps' defining ops, pointer
    // locals copied from a parameter.
    ref []u32 hp
    ref []u32 hplace
    ref []u32 fk
    ref []u32 fslot
    i64 nk
    ref []u32 mv_h
    ref []u8 mv_verb
    ref []u32 mv_call
    ref []u32 def
    ref []u32 alias
    ref []bool weak
    // Call-graph summaries (settled over rounds), per body: what it moves
    // through a pointer parameter, and which parameter it uses after.
    ref [](ref []Sum) sums
    ref [](ref []u32) sfx
    ref []Sum next
    ref []u32 nsfx
    {u32: u32} by_name
    // Global summaries, per body: package handles it may move or answer
    // views of; per view, the callee that answered it.
    ref [](ref []GSum) gs
    ref []GSum gnext
    ref []u32 ans
    ref []bool vholds
    u32 cur
    // Per parameter k, the ops using it: `uops[ulo[k]..<ulo[k + 1]]`, ascending;
    // built on the body's first `note`.
    ref []u32 ulo
    ref []u32 uops
    // Per op, the outermost loop holding it (NONE: none).
    ref []u32 oloop
    bool uready
    ref []u64 ptab
    u64 pgen
    // Per handle: an under-handle (a pointer place, or a record `&` lends,
    // standing for every handle under it); the nearest one above it.
    ref []bool uh
    ref []u32 up
    ref []i64 hvw
    // Places views may point at (static), places to give under-handles.
    ref []u32 sp
    ref []bool insp
    ref []u32 ubase
    // Per move of a call: the callee's summary entry (NONE: none).
    ref []u32 mv_text
    // Per move of a call: what it stands for (index into `stand`, NONE: only
    // itself): (type << 1 | deep) of the callee's moves a view sees whole
    // under one place, which the move a read names stands for (P10h).
    ref []u32 mv_stand
    ref [](ref []u64) stand
    ref []u32 st_op
    ref []u32 st_x
    i64 nstand
    // Per view: the argument a call answered it out of, as written (NONE).
    ref []u32 vsp
    // Nodes a finding was made at (one each, Rust's).
    ref []u32 said
    // Per place of a local: parameters whose views (d0) or whose pointee's
    // views (d1) were stored there.
    ref []u64 d0
    ref []u64 d1
    ref []u32 rlo
    ref []u32 rpl
    // Per parameter: what this body stores where it points (read back with
    // anything read through it, Rust's `param_stores`).
    ref []u64 ps0
    ref []u64 ps1
    // Records whose handle slots are taken apart (Rust's K3c): per slot its
    // record number (NONE: none); a state bit per record, "two slots may
    // hold one block", and one for any record. Per view: the record a call
    // answered it out of one slot of (NONE). Per function: bit j, it reads a
    // view of one slot of `j^` after moving another (callers keep them apart).
    ref []u32 rec_of
    ref []u32 recs
    i64 nrec
    ref []u32 vrec
    ref []u32 vslot
    ref []u64 apart
    u64 now_apart
    // Per body its key's first body (see `keys`); per such, the bodies; and
    // the joined summaries callers read.
    ref []u32 rep
    ref [](ref []u32) members
    ref [](ref []Sum) rsums
    ref [](ref []u32) rsfx
    ref [](ref []GSum) rgs
    ref []u64 rgrows
    ref []u64 rrets
    ref []u64 rrets1
    ref []u64 rkeeps
    ref []u64 rkeeps1
    ref []u64 rfrees
    ref []u64 rapart
    // Per key: its single moves are `rsums[..<rm1]`, its pairs `[rm1..<rm2]`,
    // its answers and shared rebinds `[rm2..]` (`order_sums`).
    ref []u32 rm1
    ref []u32 rm2
    // Per argument of the call at hand: its base (see `arg_base`).
    ref []u32 abase
    ref []bool aderef
    bool apart_say
    // Per place through a copy of a `^` parameter: the parameter's own
    // place (NONE: none).
    ref []u32 canon
    // Package storage (`storage`): global types; per body, bit g of `kt[fi *
    // gw..]`: it or a callee names a global of type `gty[g]`; `kt_any`: it
    // calls a function value. Per site: a store's global type (NONE: a call).
    ref []u32 gty
    i64 gw
    ref []u64 kt
    ref []bool kt_any
    ref []u32 es_g
    ref []u64 es_q
    ref []bool es_a
    {u64: u8} smemo
    {u64: u8} cmemo
    // Per slot of the body: `fresh_local`, `unique_local` (0: not known,
    // 1: no, 2: yes).
    ref []u8 fmemo
    ref []u8 umemo
    // Some view of `u8`s becomes text, or text a view of `u8`s; element
    // types of views made from a `rawptr`, a C shape, a member or a tail.
    bool u8text
    ref []u32 punned
    // A library: callers may pun any element type (P10j).
    bool punall
    // Per local record: the one call answer it holds, under `rbase` (`^` with
    // `rderef`) + fields `rsx[rslo..<rshi]` (P10i); NONE: none.
    ref []u32 rbase
    ref []bool rderef
    ref []u32 rslo
    ref []u32 rshi
    ref []u32 rsx
    ref []u32 rdef
    // View fields `R.F` (resolve(R) << 32 | F) that view nothing under their
    // own record (`foreign_fields`); per place of the body: through one
    // (0 not known, 1 no, 2 yes).
    {u64: u8} ffield
    ref []u8 pfm
    bool ff_on
    {u64: u8} ffcand
    {u32: u8} ffbad
    ref []u64 ffedges
    {u32: u8} ffpriv

// `fi` moves the block at `j^` + fields `sfx[lo..<hi]` (`verb`); with `i`
// set, it then uses parameter `i`, so a caller must hand the two apart.
type Sum:
    u32 fi
    u32 i
    u32 j
    u8 verb
    u32 lo
    u32 hi

// Body `fi`: G_MOVE package handle `key` (`verb`; `ty` its type), G_ANS a
// view of its block; G_INTO views of parameter `key >> 32` stored into the
// block behind pointer parameter `key & 0xFFFFFFFF`; G_HOLDS an answer
// holding views of parameter `key`.
type GSum:
    u32 fi
    u64 key
    u32 ty
    u8 verb
    u8 kind

private const u8 G_MOVE = 0
private const u8 G_ANS = 1
private const u8 G_INTO = 2
private const u8 G_HOLDS = 3

private const u32 NONE = 0xFFFFFFFF

// `Sum.verb` of an answer: a view into the block of the handle at `j^` +
// `sfx`, or of any handle under `j^`. In a `sfx`, D_STEP is a `^`.
private const u8 A_PLACED = 200
private const u8 A_UNDER = 201
private const u32 D_STEP = 0xFFFFFFFE
// `Sum.verb`: the handle at `j^` + `sfx` may be rebound from another handle.
private const u8 S_SHARED = 202
// Rust's order of verbs (MV_*), for which move of a call is named first.
private const [9]u8 RANK = (3, 0, 1, 6, 5, 4, 8, 9, 11)

// Every body's findings, after the summaries settle.
void own(^check.World w):
    Own o
    o.w = w
    for _ in w.fns:
        o.grows = #append(o.grows, 0)
        o.rets = #append(o.rets, 0)
        o.rets1 = #append(o.rets1, 0)
        o.keeps = #append(o.keeps, 0)
        o.keeps1 = #append(o.keeps1, 0)
        o.frees = #append(o.frees, 0)
        o.apart = #append(o.apart, 0)
        ref []Sum s0
        o.sums = #append(o.sums, s0)
        ref []u32 x0
        o.sfx = #append(o.sfx, x0)
        ref []GSum g0
        o.gs = #append(o.gs, g0)
        ref []Sum s1
        o.rsums = #append(o.rsums, s1)
        ref []u32 x1
        o.rsfx = #append(o.rsfx, x1)
        ref []GSum g1
        o.rgs = #append(o.rgs, g1)
        ref []u32 m0
        o.members = #append(o.members, m0)
        o.rgrows = #append(o.rgrows, 0)
        o.rrets = #append(o.rrets, 0)
        o.rrets1 = #append(o.rrets1, 0)
        o.rkeeps = #append(o.rkeeps, 0)
        o.rkeeps1 = #append(o.rkeeps1, 0)
        o.rfrees = #append(o.rfrees, 0)
        o.rapart = #append(o.rapart, 0)
        o.rm1 = #append(o.rm1, 0)
        o.rm2 = #append(o.rm2, 0)
    for i in 0..<#len(w.fns):
        o.by_name[w.fns[i].name] = u32(i)
    keys(&o)
    storage(&o)
    foreign_fields(&o)
    o.quiet = true
    Settle q = settler(w)
    for:
        u32 fi = next(&q)
        if fi == NONE: break
        #truncate(o.next, 0)
        #truncate(o.nsfx, 0)
        #truncate(o.gnext, 0)
        u64 g = body(&o, fi)
        if g == o.grows[fi] && o.now_rets == o.rets[fi] && o.now_rets1 == o.rets1[fi] && o.now_keeps == o.keeps[fi] && o.now_keeps1 == o.keeps1[fi] && o.now_frees == o.frees[fi] && o.now_apart == o.apart[fi] && same_sums(&o, fi) && same_gs(&o, fi): continue
        #truncate(o.gs[fi], 0)
        for x in o.gnext:
            o.gs[fi] = #append(o.gs[fi], x)
        o.grows[fi] = g
        o.rets[fi] = o.now_rets
        o.rets1[fi] = o.now_rets1
        o.keeps[fi] = o.now_keeps
        o.keeps1[fi] = o.now_keeps1
        o.frees[fi] = o.now_frees
        o.apart[fi] = o.now_apart
        #truncate(o.sums[fi], 0)
        #truncate(o.sfx[fi], 0)
        for x in o.next:
            Sum e = x
            e.lo = u32(#len(o.sfx[fi]))
            for k in x.lo..<x.hi:
                o.sfx[fi] = #append(o.sfx[fi], o.nsfx[k])
            e.hi = u32(#len(o.sfx[fi]))
            o.sums[fi] = #append(o.sums[fi], e)
        u32 rp = o.rep[fi]
        if join_key(&o, rp):
            for m in o.members[rp]:
                changed(&q, m)
    o.quiet = false
    // Each body's note: the last job of its name.
    {u32: u32} job_of
    for j in 0..<#len(w.jobs):
        job_of[w.jobs[j].cname] = u32(j)
    for i in 0..<#len(w.fns):
        if w.fns[i].name in job_of:
            try u32 j = job_of[w.fns[i].name] else: continue
            w.note = w.jobs[j].note
        // Summaries are settled: what this pass pushes is read by nothing.
        #truncate(o.next, 0)
        #truncate(o.nsfx, 0)
        #truncate(o.gnext, 0)
        _ = body(&o, u32(i))
        w.note = ""

private bool same_gs(^Own o, u32 fi):
    if #len(o.gs[fi]) != #len(o.gnext): return false
    for e in o.gnext:
        if !has_g(o.gs[fi], fi, e.key, e.verb, e.kind): return false
    return true

private bool has_g([]GSum xs, u32 fi, u64 key, u8 verb, u8 kind):
    for x in xs:
        if x.fi == fi && x.key == key && x.kind == kind && (kind != G_MOVE || x.verb == verb): return true
    return false

private void add_g(^Own o, u32 fi, u64 key, u32 ty, u8 verb, u8 kind):
    if !has_g(o.gnext, fi, key, verb, kind): o.gnext = #append(o.gnext, GSum(fi, key, ty, verb, kind))

// A global's key across bodies: its package and name.
private u64 gkey(^ir.Fn f, u32 r):
    u32 g = r & ~ir.ROOT_GLOBAL
    return (u64(f.glob_pkg[g]) << 32) | u64(f.glob_name[g])

// The handle that is package handle `key` itself here, or -1.
private i64 global_handle(^Own o, u64 key):
    for h in 0..<o.nh:
        u32 p = o.hplace[h]
        if (o.f.root[p] & ir.ROOT_GLOBAL) != 0 && o.f.plo[p] == o.f.phi[p] && gkey(o.f, o.f.root[p]) == key: return h
    return -1

// Places for the package handles this body's callees move or answer.
private void globals_in(^Own o):
    ^ir.Fn f = o.f
    for i in 0..<ir.count(f):
        if f.op[i] != ir.O_CALL: continue
        u32 c = callee(o, i)
        if c == NONE: continue
        for e in o.rgs[c]:
            if e.kind > G_ANS: continue
            u32 gi = NONE
            for g in 0..<#len(f.glob_pkg):
                if (u64(f.glob_pkg[g]) << 32) | u64(f.glob_name[g]) == e.key: gi = u32(g)
            if gi == NONE:
                f.glob_pkg = #append(f.glob_pkg, u32(e.key >> 32))
                f.glob_name = #append(f.glob_name, u32(e.key & 0xFFFFFFFF))
                f.glob_ty = #append(f.glob_ty, e.ty)
                gi = u32(#len(f.glob_pkg) - 1)
            _ = ir.at(f, ir.ROOT_GLOBAL | gi)

// Whether body `fi`'s new summary (`next`) is the one it had (by push's
// table over `next`).
private bool same_sums(^Own o, u32 fi):
    if #len(o.sums[fi]) != #len(o.next): return false
    if #len(o.next) == 0: return true
    u64 mask = u64(#len(o.ptab) - 1)
    for x in o.sums[fi]:
        []u32 sfx = o.sfx[fi][i64(x.lo)..<i64(x.hi)]
        u64 k = sum_hash(x, sfx) & mask
        bool found = false
        for (o.ptab[k] >> 32) == o.pgen:
            Sum y = o.next[i64(o.ptab[k] & 0xFFFFFFFF) - 1]
            if y.i == x.i && y.j == x.j && (x.i != NONE || y.verb == x.verb) && y.hi - y.lo == x.hi - x.lo:
                bool same = true
                for q in 0..<x.hi - x.lo:
                    if o.nsfx[y.lo + q] != sfx[q]: same = false
                if same:
                    found = true
                    break
            k = (k + 1) & mask
        if !found: return false
    return true

private bool is_view(^types.Types t, u32 ty):
    u32 r = t.resolve(ty)
    return r != NONE && (r == types.STRING8 || t.tag[r] == types.T_SLICE || t.tag[r] == types.T_PTR || t.tag[r] == types.T_TRAIT)

private bool is_handle(^types.Types t, u32 ty):
    u32 r = t.resolve(ty)
    return r != NONE && (t.tag[r] == types.T_REF || t.tag[r] == types.T_MAP || t.tag[r] == types.T_CHANNEL && refs(t, r))

// A channel that carries a `ref`: its `#drain` moves what views lend.
private bool refs(^types.Types t, u32 r):
    for x in t.list(r):
        u32 q = t.resolve(x)
        if q != NONE && t.tag[q] == types.T_REF: return true
    return false

private bool is_ptr(^types.Types t, u32 ty):
    u32 r = t.resolve(ty)
    return r != NONE && t.tag[r] == types.T_PTR

private u64 body(^Own o, u32 fi):
    ^ir.Fn f = &o.w.fns[fi]
    if (f.flags & ir.H_BROKEN) != 0: return 0
    o.f = f
    o.cur = fi
    o.uready = false
    #truncate(o.vi, 0)
    #truncate(o.hi, 0)
    #truncate(o.mi, 0)
    #truncate(o.moves, 0)
    #truncate(o.grown_at, 0)
    #truncate(o.handed_at, 0)
    #truncate(o.stack_at, 0)
    o.nv = 0
    o.nh = 0
    o.now = 0
    o.now_rets = 0
    o.now_rets1 = 0
    o.now_keeps = 0
    o.now_keeps1 = 0
    #truncate(o.pt2, 0)
    #truncate(o.loose_addr, 0)
    #truncate(o.loose_store, 0)
    #truncate(o.mayin, 0)
    o.now_frees = 0
    o.now_apart = 0
    #truncate(o.killed_at, 0)
    #truncate(o.exp_at, 0)
    #truncate(o.exp_by, 0)
    #truncate(o.uh, 0)
    #truncate(o.up, 0)
    #truncate(o.said, 0)
    #truncate(o.mv_text, 0)
    #truncate(o.mv_stand, 0)
    #truncate(o.hp, 0)
    #truncate(o.hplace, 0)
    #truncate(o.fk, 0)
    #truncate(o.fslot, 0)
    #truncate(o.mv_h, 0)
    #truncate(o.mv_verb, 0)
    #truncate(o.mv_call, 0)
    #truncate(o.def, 0)
    #truncate(o.alias, 0)
    #truncate(o.weak, 0)
    o.nk = 0
    #truncate(o.ans, 0)
    globals_in(o)
    #truncate(o.vslot, 0)
    #truncate(o.fmemo, 0)
    #truncate(o.umemo, 0)
    for s in 0..<#len(f.slot_ty):
        o.fmemo = #append(o.fmemo, 0)
        o.umemo = #append(o.umemo, 0)
        u32 t = f.slot_ty[s]
        bool v = t != NONE && (is_view(&o.w.t, t) || is_handle(&o.w.t, t))
        o.vi = #append(o.vi, u32(o.nv) if v else NONE)
        if v: o.vslot = #append(o.vslot, u32(s))
        if v: o.nv += 1
        o.fk = #append(o.fk, NONE)
        o.def = #append(o.def, NONE)
        o.alias = #append(o.alias, NONE)
        o.weak = #append(o.weak, false)
        o.pt2 = #append(o.pt2, NONE)
    #truncate(o.vholds, 0)
    #truncate(o.vsp, 0)
    #truncate(o.vrec, 0)
    for _ in 0..<o.nv:
        o.ans = #append(o.ans, NONE)
        o.vholds = #append(o.vholds, false)
        o.vsp = #append(o.vsp, NONE)
        o.vrec = #append(o.vrec, NONE)
    for i in 0..<ir.count(f):
        u32 d = f.dst[i]
        if d != NONE && !ir.is_const(d) && bare(o, d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && (f.slot_flags[f.root[d]] & ir.S_TEMP) != 0: o.def[f.root[d]] = i
        if f.op[i] == ir.O_SET && d != NONE && bare(o, d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && is_ptr(&o.w.t, f.slot_ty[f.root[d]]) && bare(o, f.a[i]) && (f.root[f.a[i]] & ir.ROOT_GLOBAL) == 0 && (f.root[f.a[i]] < f.params || o.alias[f.root[f.a[i]]] != NONE): o.alias[f.root[d]] = f.root[f.a[i]] if f.root[f.a[i]] < f.params else o.alias[f.root[f.a[i]]]
        if f.op[i] == ir.O_VIEW || f.op[i] == ir.O_ADDR: frame_slot(o, f.a[i])
        // A view converted by a call is never proven freed (WRN, not ERR).
        if d != NONE && !ir.is_const(d) && bare(o, d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && (f.op[i] == ir.O_CONV && f.sub[i] == ir.CV_RETAG || (f.op[i] == ir.O_SET || f.op[i] == ir.O_CONV) && bare(o, f.a[i]) && (f.root[f.a[i]] & ir.ROOT_GLOBAL) == 0 && o.weak[f.root[f.a[i]]]): o.weak[f.root[d]] = true
        u32 ta = f.args[f.alo[i]] if f.op[i] == ir.O_MAKE && f.ahi[i] > f.alo[i] else NONE
        if d != NONE && !ir.is_const(d) && bare(o, d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && ta != NONE && o.w.t.tag[o.w.t.resolve(f.ty_of[i])] == types.T_TRAIT && bare(o, ta) && (f.root[ta] & ir.ROOT_GLOBAL) == 0 && o.weak[f.root[ta]]: o.weak[f.root[d]] = true
    params_in(o)
    for #len(o.canon) < #len(f.root):
        o.canon = #append(o.canon, NONE)
    derive(o)
    for p in 0..<#len(f.root):
        bool h = hplace_ok(o, u32(p)) && o.canon[p] == NONE
        o.hp = #append(o.hp, u32(o.nh) if h else NONE)
        if h: add_h(o, u32(p), false)
    for p in 0..<#len(f.root):
        if o.canon[p] != NONE: o.hp[p] = o.hp[o.canon[p]]
    for b in o.ubase:
        if o.hp[b] == NONE: add_h(o, b, true)
    for h in 0..<o.nh:
        u32 best = NONE
        for u in 0..<o.nh:
            if !o.uh[u] || u == h || !above(o, o.hplace[u], o.hplace[h]): continue
            if best == NONE || above(o, o.hplace[best], o.hplace[u]): best = u32(u)
        o.up[h] = best
    // Per handle: the view number of its place when bare, or -1.
    #truncate(o.hvw, 0)
    for h in 0..<o.nh:
        o.hvw = #append(o.hvw, view_of(o, o.hplace[h]) if bare(o, o.hplace[h]) else -1)
    // Records: `^` parameters and local records holding handles.
    #truncate(o.rec_of, 0)
    #truncate(o.recs, 0)
    o.nrec = 0
    for sl in 0..<#len(f.slot_ty):
        u32 t = f.slot_ty[sl]
        bool rec = false
        if t != NONE && u32(sl) < f.params && is_ptr(&o.w.t, t): rec = holds_h(o, pointee(o, t))
        else if t != NONE && u32(sl) >= f.params && !is_view(&o.w.t, t) && !is_handle(&o.w.t, t): rec = holds_h(o, t)
        o.rec_of = #append(o.rec_of, u32(o.nrec) if rec else NONE)
        if rec:
            o.recs = #append(o.recs, u32(sl))
            o.nrec += 1
    for i in 0..<ir.count(f):
        u32 rv = f.a[i]
        if f.op[i] == ir.O_RETURN && bare(o, rv) && (f.root[rv] & ir.ROOT_GLOBAL) == 0 && f.root[rv] < f.params && f.root[rv] < 64 && view_of(o, rv) >= 0: o.now_rets = o.now_rets | (u64(1) << u64(f.root[rv]))
        if f.op[i] == ir.O_RETURN && rv != NONE && !ir.is_const(rv) && (f.root[rv] & ir.ROOT_GLOBAL) == 0 && f.root[rv] < f.params && f.root[rv] < 64 && f.phi[rv] == f.plo[rv] + 1 && f.step[f.plo[rv]] == ir.ST_DEREF && is_view(&o.w.t, f.place_ty[rv]): o.now_rets1 = o.now_rets1 | (u64(1) << u64(f.root[rv]))
        // An answer read through a parameter (`return w.name`) carries what
        // its pointee does (Rust's level 1).
        if f.op[i] == ir.O_RETURN && rv != NONE && !ir.is_const(rv) && (is_view(&o.w.t, f.place_ty[rv]) || rec_h(o, f.place_ty[rv])):
            u64 r0 = 0
            u64 r1 = 0
            pbits(o, rv, &r0, &r1, false)
            o.now_rets1 = o.now_rets1 | r1
        i64 h = handle_of(o, f.dst[i]) if f.op[i] == ir.O_SET && bare(o, f.dst[i]) else -1
        u32 m = origin(o, f.a[i]) if h >= 0 else NONE
        if m != NONE && f.op[m] == ir.O_INTRINSIC && (f.sub[m] == check.B_MAKE && ir.args(f, m)[1] == ir.konst(o.w.k.small(&o.w.t, 3)) || f.sub[m] == check.B_AL_NEW && ir.args(f, m)[0] == ir.konst(o.w.k.small(&o.w.t, 3))): o.stack_at[h] = m
    for i in 0..<ir.count(f):
        o.mi = #append(o.mi, u32(#len(o.moves)) if f.op[i] == ir.O_MOVE || f.op[i] == ir.O_CALL else NONE)
        if f.op[i] == ir.O_MOVE:
            o.moves = #append(o.moves, i)
            o.mv_h = #append(o.mv_h, u32(handle_of(o, f.a[i])))
            o.mv_verb = #append(o.mv_verb, f.sub[i])
            o.mv_call = #append(o.mv_call, NONE)
            o.mv_text = #append(o.mv_text, NONE)
            o.mv_stand = #append(o.mv_stand, NONE)
        else if f.op[i] == ir.O_CALL: call_moves(o, i)
    o.nm = #len(o.moves)
    loose(o)
    rec_origins(o)
    sites(o)
    // Summaries only while they settle; the reporting walk reads none.
    if o.quiet:
        rec_answers(o)
        summarize(o, fi)
        into(o, fi)
    kept(o)
    if !o.quiet: aliased(o)
    if o.nh == 0 && o.nk == 0: return 0
    Flow fl = flow(f, bits(o), rawptr(o), step)
    for v in 0..<o.nv:
        must_bit(&fl, freed(o, v))
    for h in 0..<o.nh:
        must_bit(&fl, killed(o, h))
    o.now_frees = 0xFFFFFFFFFFFFFFFF
    o.leaves = 0
    ref []u64 s = entry(&fl)
    if walk(&fl, &s): leave(o, &fl, &s, NONE, NONE)
    if o.leaves == 0: o.now_frees = 0
    #delete(s)
    done(&fl)
    return o.now

// Bit layout: points (view, handle), moved (view, move), freed (view, must),
// grown (handle), handed (handle), frame (view, frame slot), held (handle,
// frame slot).
private i64 bits(^Own o):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + o.nh * o.nk + o.nk + 3 * o.nh + o.nk * o.nk + o.nes + o.nrec + 1 + o.nh

// Handle `h` was bound afresh to nothing since its views were last stored
// in package storage (`ref []T x` in a loop).
private i64 afresh(^Own o, i64 h):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + o.nh * o.nk + o.nk + 3 * o.nh + o.nk * o.nk + o.nes + o.nrec + 1 + h

// Two handle slots of record `r` may hold one block (`r` = nrec: any record).
private i64 shared(^Own o, i64 r):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + o.nh * o.nk + o.nk + 3 * o.nh + o.nk * o.nk + o.nes + r

// Exposing site `k` was passed on the way here.
private i64 esite(^Own o, i64 k):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + o.nh * o.nk + o.nk + 3 * o.nh + o.nk * o.nk + k

// Frame slot `a` (a value whose address was taken) holds views of frame slot `k`.
private i64 inside(^Own o, i64 a, i64 k):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + o.nh * o.nk + o.nk + 3 * o.nh + a * o.nk + k

// Handle `h` was handed by value to a callee that frees it on every path.
private i64 killed(^Own o, i64 h):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + o.nh * o.nk + o.nk + 2 * o.nh + h

// Views of handle `h`'s block were stored in package storage.
private i64 exposed(^Own o, i64 h):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + o.nh * o.nk + o.nk + o.nh + h

// Handle `h`'s `ref` may have moved into a channel (a `#send`).
private i64 sent(^Own o, i64 h):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + o.nh * o.nk + o.nk + h

// Frame slot `k`'s block has ended (its storage is gone until declared again).
private i64 ended(^Own o, i64 k):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + o.nh * o.nk + k

private i64 frame(^Own o, i64 v, i64 k):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + v * o.nk + k

private i64 held(^Own o, i64 h, i64 k):
    return o.nv * o.nh + o.nv * o.nm + o.nv + 2 * o.nh + o.nv * o.nk + h * o.nk + k

private i64 points(^Own o, i64 v, i64 h):
    return v * o.nh + h

private i64 moved(^Own o, i64 v, i64 m):
    return o.nv * o.nh + v * o.nm + m

private i64 freed(^Own o, i64 v):
    return o.nv * o.nh + o.nv * o.nm + v

private i64 grown(^Own o, i64 h):
    return o.nv * o.nh + o.nv * o.nm + o.nv + h

private i64 handed(^Own o, i64 h):
    return o.nv * o.nh + o.nv * o.nm + o.nv + o.nh + h

// The dense view or handle number of place `p`'s root, or -1.
private i64 view_of(^Own o, u32 p):
    if p == NONE || ir.is_const(p) || (o.f.root[p] & ir.ROOT_GLOBAL) != 0: return -1
    u32 v = o.vi[o.f.root[p]]
    return -1 if v == NONE else i64(v)

private i64 handle_of(^Own o, u32 p):
    if p == NONE || ir.is_const(p): return -1
    u32 h = o.hp[p]
    return -1 if h == NONE else i64(h)

// The handle of slot `sl` itself, or -1.
private i64 slot_handle(^Own o, u32 sl):
    for h in 0..<o.nh:
        u32 p = o.hplace[h]
        if o.f.root[p] == sl && o.f.plo[p] == o.f.phi[p]: return h
    return -1

// The place rooted like `p` with its first `n` steps and then fields
// `sfx`, or NONE when this body never names it.
private u32 prefix(^Own o, u32 p, u32 n, []u32 sfx):
    ^ir.Fn f = o.f
    for q in 0..<u32(#len(f.root)):
        if f.root[q] != f.root[p] || f.phi[q] - f.plo[q] != n + u32(#len(sfx)): continue
        bool same = true
        for j in 0..<n:
            if f.step[f.plo[q] + j] != f.step[f.plo[p] + j] || f.step_val[f.plo[q] + j] != f.step_val[f.plo[p] + j]: same = false
        for j in 0..<u32(#len(sfx)):
            u8 st = ir.ST_DEREF if sfx[j] == D_STEP else ir.ST_FIELD
            u32 sv = 0 if sfx[j] == D_STEP else sfx[j]
            if f.step[f.plo[q] + n + j] != st || f.step_val[f.plo[q] + n + j] != sv: same = false
        if same: return q
    return NONE

// The handle whose block place `p` reaches into (the part before its first
// index, or `p` itself), or -1.
private i64 under(^Own o, u32 p):
    return handle_of(o, under_place(o, p))

// Notes the root of place `p` as frame storage when a view or pointer is
// taken into it.
private void frame_slot(^Own o, u32 p):
    ^ir.Fn f = o.f
    if p == NONE || ir.is_const(p) || (f.root[p] & ir.ROOT_GLOBAL) != 0: return
    u32 r = f.root[p]
    u32 t = f.slot_ty[r]
    if t == NONE || is_view(&o.w.t, t) || is_handle(&o.w.t, t) || o.fk[r] != NONE: return
    for j in f.plo[p]..<f.phi[p]:
        if f.step[j] == ir.ST_DEREF: return
    o.fk[r] = u32(o.nk)
    o.fslot = #append(o.fslot, r)
    o.nk += 1

private i64 frame_of(^Own o, u32 p):
    if p == NONE || ir.is_const(p) || (o.f.root[p] & ir.ROOT_GLOBAL) != 0: return -1
    for j in o.f.plo[p]..<o.f.phi[p]:
        if o.f.step[j] == ir.ST_DEREF: return -1
    // A window held in a frame slot views what it points at, not the slot.
    u32 pt = o.w.t.resolve(o.f.place_ty[p])
    if o.f.plo[p] < o.f.phi[p] && pt != NONE && (pt == types.STRING8 || o.w.t.tag[pt] == types.T_SLICE || o.w.t.tag[pt] == types.T_REF): return -1
    u32 k = o.fk[o.f.root[p]]
    return -1 if k == NONE else i64(k)

// The op that wrote temporary `x`, through copies and lends, or NONE.
private u32 origin(^Own o, u32 x):
    u32 p = x
    for _ in 0..<16:
        if !bare(o, p) || (o.f.root[p] & ir.ROOT_GLOBAL) != 0: return NONE
        u32 d = o.def[o.f.root[p]]
        if d == NONE: return NONE
        u8 op = o.f.op[d]
        if op != ir.O_SET && !(op == ir.O_CONV && (o.f.sub[d] == ir.CV_LEND || o.f.sub[d] == ir.CV_RETAG)): return d
        p = o.f.a[d]
    return NONE

private u32 callee(^Own o, u32 i):
    if o.f.ref_flags[o.f.a[i]] & ir.R_FOREIGN != 0 || !(o.f.ref_name[o.f.a[i]] in o.by_name): return NONE
    try u32 c = o.by_name[o.f.ref_name[o.f.a[i]]] else: return NONE
    return o.rep[c]

// The body call op `i` of `f` names, or NONE.
private u32 callee_fn(^Own o, ^ir.Fn f, u32 i):
    if f.ref_flags[f.a[i]] & ir.R_FOREIGN != 0 || !(f.ref_name[f.a[i]] in o.by_name): return NONE
    try u32 c = o.by_name[f.ref_name[f.a[i]]] else: return NONE
    return c

// The body call op `i` names itself, or NONE.
private u32 callee_body(^Own o, u32 i):
    if o.f.ref_flags[o.f.a[i]] & ir.R_FOREIGN != 0 || !(o.f.ref_name[o.f.a[i]] in o.by_name): return NONE
    try u32 c = o.by_name[o.f.ref_name[o.f.a[i]]] else: return NONE
    return c

// A call whose callee moves the block behind a `^` it is handed: a move of
// that place here, one per handle a view here may see (Rust's order).
private void call_moves(^Own o, u32 i):
    ^ir.Fn f = o.f
    u32 c = callee(o, i)
    if c == NONE: return
    []u32 xs = ir.args(f, i)
    if o.rm1[c] > 0: bases(o, i)
    for x in 0..<o.rm1[c]:
        Sum e = o.rsums[c][x]
        if e.j >= u32(#len(xs)): continue
        bool deref = o.aderef[e.j]
        u32 b = o.abase[e.j]
        if b == NONE: continue
        u32 hq = mapped(o, b, deref, o.rsfx[c][i64(e.lo)..<i64(e.hi)], false)
        i64 h = handle_of(o, hq)
        if h < 0: continue
        o.moves = #append(o.moves, i)
        o.mv_h = #append(o.mv_h, u32(h))
        o.mv_verb = #append(o.mv_verb, e.verb)
        o.mv_call = #append(o.mv_call, c)
        o.mv_text = #append(o.mv_text, u32(x))
        u32 sd = NONE
        for z in 0..<o.nstand:
            if o.st_op[z] == i && o.st_x[z] == x: sd = u32(z)
        o.mv_stand = #append(o.mv_stand, sd)
    for e in o.rgs[c]:
        if e.kind != G_MOVE: continue
        i64 gh = global_handle(o, e.key)
        if gh < 0: continue
        o.moves = #append(o.moves, i)
        o.mv_h = #append(o.mv_h, u32(gh))
        o.mv_verb = #append(o.mv_verb, e.verb)
        o.mv_call = #append(o.mv_call, c)
        o.mv_text = #append(o.mv_text, NONE)
        o.mv_stand = #append(o.mv_stand, NONE)

// Move `m`'s handle as messages name it: `w.t.a` inside `f`.
private string8 move_text(^Own o, u32 m):
    ^ir.Fn f = o.f
    u32 i = o.moves[m]
    if o.mv_call[m] == NONE:
        return spell(o, o.hplace[o.mv_h[m]]) if o.mv_h[m] != NONE else spell(o, f.a[i])
    string8 ct = call_text(o, i)
    u32 x = o.mv_text[m]
    if x == NONE: return index.hold(#format(spell(o, o.hplace[o.mv_h[m]]), "` inside `", ct))
    u32 c = o.mv_call[m]
    Sum e = o.rsums[c][x]
    return index.hold(#format(sum_written(o, i, e, c), "` inside `", ct))

// A callee's move `e` (of `c`) at call `i`, as written here: `w.t.a`.
private string8 sum_written(^Own o, u32 i, Sum e, u32 c):
    []u32 xs = ir.args(o.f, i)
    bool deref = false
    u32 b = arg_base(o, xs[e.j], &deref)
    u32 t = o.f.place_ty[b] if b != NONE else NONE
    if deref: t = pointee(o, t)
    return index.hold(#format(arg_text(o, i, e.j), sfx_text(o, t, o.rsfx[c][i64(e.lo)..<i64(e.hi)])))

// Places for what callees answer out of, keep through or move under a `^`
// this body hands them (a move only where a view here may see it), and the
// under-handles they need.
private void params_in(^Own o):
    ^ir.Fn f = o.f
    o.nstand = 0
    #truncate(o.st_op, 0)
    #truncate(o.st_x, 0)
    for x in o.sp:
        if x < u32(#len(o.insp)): o.insp[x] = false
    #truncate(o.sp, 0)
    #truncate(o.ubase, 0)
    // A place through a copy of a `^` parameter is the parameter's own.
    #truncate(o.canon, 0)
    for r in 0..<f.params:
        _ = ir.at(f, r)
    u32 np = u32(#len(f.root))
    for _ in 0..<np:
        o.canon = #append(o.canon, NONE)
    for p in 0..<np:
        u32 r = f.root[p]
        if (r & ir.ROOT_GLOBAL) != 0 || r < f.params || o.alias[r] == NONE || f.plo[p] == f.phi[p] || f.step[f.plo[p]] != ir.ST_DEREF: continue
        u32 q = ir.at(f, o.alias[r])
        for j in f.plo[p]..<f.phi[p]:
            if q == NONE: break
            q = ir.step(f, q, f.step[j], f.step_val[j], f.place_ty[p] if j + 1 == f.phi[p] else pstep_ty(o, p, j))
        o.canon[p] = q
    for r in 0..<f.params:
        if is_ptr(&o.w.t, f.slot_ty[r]) && holds_h(o, pointee(o, f.slot_ty[r])): o.ubase = #append(o.ubase, ir.at(f, r))
    for i in 0..<ir.count(f):
        u8 op = f.op[i]
        u32 x = NONE
        if op == ir.O_VIEW || op == ir.O_ADDR: x = under_place(o, f.a[i])
        else if (op == ir.O_SET || op == ir.O_CONV) && f.a[i] != NONE && !ir.is_const(f.a[i]) && hplace_ok(o, f.a[i]): x = f.a[i]
        if x != NONE && o.canon[x] != NONE: x = o.canon[x]
        if x != NONE: sp_add(o, x)
    bool any = false
    for i in 0..<ir.count(f):
        if f.op[i] != ir.O_CALL: continue
        u32 c = callee(o, i)
        if c == NONE: continue
        []u32 xs = ir.args(f, i)
        for e in o.rsums[c]:
            if e.i != NONE || e.j >= u32(#len(xs)): continue
            if e.verb < A_PLACED:
                any = true
                continue
            if e.verb == S_SHARED: continue
            bool deref = false
            u32 b = arg_base(o, xs[e.j], &deref)
            if b == NONE: continue
            if e.verb == A_UNDER:
                u32 ub = under_base(o, b, deref, o.rsfx[c][i64(e.lo)..<i64(e.hi)], true)
                if !hplace_ok(o, ub) && !has_u32(&o.ubase, ub): o.ubase = #append(o.ubase, ub)
                sp_add(o, ub)
                continue
            u32 q = mapped(o, b, deref, o.rsfx[c][i64(e.lo)..<i64(e.hi)], true)
            if q != NONE && hplace_ok(o, q): sp_add(o, q)
        u32 dd = f.dst[i]
        bool vres = dd != NONE && !ir.is_const(dd) && is_view(&o.w.t, f.place_ty[dd])
        for j in 0..<#len(xs):
            if !vres || j >= 64 || (o.rrets1[c] >> u64(j)) & 1 == 0 || placed_for(o, c, u32(j)): continue
            bool deref = false
            u32 b = arg_base(o, xs[j], &deref)
            if b == NONE: continue
            u32 t = f.place_ty[b]
            if deref: t = pointee(o, t)
            if !view_reaches(o, f.place_ty[dd], t): continue
            if !hplace_ok(o, b) && !has_u32(&o.ubase, b): o.ubase = #append(o.ubase, b)
            sp_add(o, b)
        for j in 0..<#len(xs):
            if j >= 64 || (o.rkeeps1[c] >> u64(j)) & 1 == 0: continue
            bool deref = false
            u32 b = arg_base(o, xs[j], &deref)
            if b == NONE || hplace_ok(o, b) || has_u32(&o.ubase, b): continue
            u32 t = f.place_ty[b]
            if deref: t = pointee(o, t)
            if holds_h(o, t): o.ubase = #append(o.ubase, b)
    if !any || #len(o.sp) == 0: return
    ref []u32 cands
    ref []u32 best
    ref []u64 bkey
    for i in 0..<ir.count(f):
        if f.op[i] != ir.O_CALL: continue
        u32 c = callee(o, i)
        if c == NONE: continue
        []u32 xs = ir.args(f, i)
        for j in 0..<u32(#len(xs)):
            bool deref = false
            u32 b = NONE
            // The places a view here may see that this argument reaches.
            #truncate(cands, 0)
            for e in o.rsums[c][0..<i64(o.rm1[c])]:
                if e.j != j: continue
                if b == NONE:
                    b = arg_base(o, xs[j], &deref)
                    if b == NONE: break
                    for x in o.sp:
                        if f.root[x] == f.root[b] && (x == b || above(o, x, b) || above(o, b, x)): cands = #append(cands, x)
                break
            if #len(cands) == 0: continue
            #truncate(best, 0)
            #truncate(bkey, 0)
            for _ in cands:
                best = #append(best, NONE)
                bkey = #append(bkey, 0xFFFFFFFFFFFFFFFF)
            for x in 0..<o.rm1[c]:
                Sum e = o.rsums[c][x]
                if e.j != j: continue
                []u32 sfx = o.rsfx[c][i64(e.lo)..<i64(e.hi)]
                for k in 0..<#len(cands):
                    u32 y = cands[k]
                    if hplace_ok(o, y):
                        if on_path(o, y, b, deref, sfx, true): _ = mapped(o, b, deref, sfx, true)
                        continue
                    // Under a place a view sees whole: the move a read names
                    // first (Rust's: by verb, then as written) stands for all.
                    if !on_path(o, y, b, deref, sfx, false): continue
                    u64 key = (u64(RANK[e.verb] if e.verb < 9 else 63) << 56) | u64(x)
                    if key < bkey[k]:
                        bkey[k] = key
                        best[k] = u32(x)
            u32 bt = f.place_ty[b]
            if deref: bt = pointee(o, bt)
            for k in 0..<#len(cands):
                if best[k] == NONE: continue
                Sum e = o.rsums[c][best[k]]
                _ = mapped(o, b, deref, o.rsfx[c][i64(e.lo)..<i64(e.hi)], true)
                // The types it stands for (P10h: views are moved by type).
                i64 sd = -1
                for z in 0..<o.nstand:
                    if o.st_op[z] == i && o.st_x[z] == best[k]: sd = z
                if sd < 0:
                    sd = o.nstand
                    o.nstand += 1
                    if #len(o.stand) < o.nstand:
                        ref []u64 s0
                        o.stand = #append(o.stand, s0)
                    #truncate(o.stand[sd], 0)
                    o.st_op = #append(o.st_op, i)
                    o.st_x = #append(o.st_x, best[k])
                for x in 0..<o.rm1[c]:
                    Sum e2 = o.rsums[c][x]
                    if e2.j != j: continue
                    []u32 sfx = o.rsfx[c][i64(e2.lo)..<i64(e2.hi)]
                    if !on_path(o, cands[k], b, deref, sfx, false): continue
                    u64 cls = (u64(sfx_type(o, bt, sfx)) << 1) | u64(1 if e2.verb != ir.MV_APPEND && e2.verb != ir.MV_INSERT else 0)
                    bool dup = false
                    for q in o.stand[sd]:
                        if q == cls: dup = true
                    if !dup: o.stand[sd] = #append(o.stand[sd], cls)
    #delete(cands)
    #delete(best)
    #delete(bkey)

// The handle place a view of place `p` points into: `p` before its first
// subscript, when that is a handle; else NONE.
private u32 under_place(^Own o, u32 p):
    ^ir.Fn f = o.f
    if p == NONE || ir.is_const(p): return NONE
    for j in f.plo[p]..<f.phi[p]:
        if f.step[j] == ir.ST_INDEX:
            u32 q = prefix(o, p, j - f.plo[p], nil)
            return q if q != NONE && hplace_ok(o, q) else NONE
    return p if hplace_ok(o, p) else NONE

private void add_h(^Own o, u32 p, bool u):
    o.hplace = #append(o.hplace, p)
    o.uh = #append(o.uh, u)
    o.up = #append(o.up, NONE)
    o.nh += 1
    o.grown_at = #append(o.grown_at, NONE)
    o.handed_at = #append(o.handed_at, NONE)
    o.stack_at = #append(o.stack_at, NONE)
    o.exp_at = #append(o.exp_at, NONE)
    o.exp_by = #append(o.exp_by, NONE)
    o.killed_at = #append(o.killed_at, NONE)

// This body's summary: moves through a pointer parameter (directly, or
// forwarded to a callee), and the parameters used after one.
private void summarize(^Own o, u32 fi):
    ^ir.Fn f = o.f
    u32 n = ir.count(f)
    for i in 0..<n:
        if f.op[i] == ir.O_MOVE && bare(o, f.a[i]) && (f.root[f.a[i]] & ir.ROOT_GLOBAL) != 0:
            u32 g = f.root[f.a[i]]
            add_g(o, fi, gkey(f, g), f.glob_ty[g & ~ir.ROOT_GLOBAL], f.sub[i], G_MOVE)
        else if f.op[i] == ir.O_SET && shares(o, f.dst[i], f.a[i]) && ptr_root(o, f.dst[i]) != NONE:
            ref []u32 sx
            tail(o, f.dst[i], &sx)
            if !has_u32(&sx, D_STEP): push(o, Sum(fi, NONE, ptr_root(o, f.dst[i]), S_SHARED, 0, 0), sx[:])
            #delete(sx)
        else if f.op[i] == ir.O_MOVE:
            u32 p = f.a[i]
            u32 r = f.root[p]
            if (r & ir.ROOT_GLOBAL) == 0 && r >= f.params: r = o.alias[r]
            if r == NONE || (r & ir.ROOT_GLOBAL) != 0 || r >= f.params || f.plo[p] == f.phi[p] || f.step[f.plo[p]] != ir.ST_DEREF: continue
            ref []u32 sfx
            bool ok = true
            for j in f.plo[p] + 1..<f.phi[p]:
                if f.step[j] != ir.ST_FIELD && f.step[j] != ir.ST_DEREF: ok = false
                sfx = #append(sfx, D_STEP if f.step[j] == ir.ST_DEREF else f.step_val[j])
            if ok: note(o, fi, i, r, f.sub[i], sfx)
            #delete(sfx)
        else if f.op[i] == ir.O_CALL:
            u32 c = callee(o, i)
            if c == NONE: continue
            for e in o.rgs[c]:
                if e.kind == G_MOVE: add_g(o, fi, e.key, e.ty, e.verb, G_MOVE)
            []u32 xs = ir.args(f, i)
            bool one = #len(o.members[c]) == 1
            if #len(o.rsums[c]) > 0: bases(o, i)
            for e in o.rsums[c]:
                if e.j >= u32(#len(xs)) || e.verb == A_PLACED || e.verb == A_UNDER: continue
                u32 m = param_of(o, xs[e.j])
                if e.verb == S_SHARED:
                    if e.i != NONE: continue
                    bool sd = o.aderef[e.j]
                    u32 sb = o.abase[e.j]
                    if sb == NONE: continue
                    bool whole = sd && bare(o, sb) && f.root[sb] < f.params
                    u32 sr = f.root[sb] if whole else ptr_root(o, sb)
                    if sr == NONE: continue
                    ref []u32 sx
                    if !whole: tail(o, sb, &sx)
                    if sd && !whole: sx = #append(sx, D_STEP)
                    for y in o.rsfx[c][i64(e.lo)..<i64(e.hi)]:
                        sx = #append(sx, y)
                    push(o, Sum(fi, NONE, sr, S_SHARED, 0, 0), sx[:])
                    #delete(sx)
                    continue
                if m == NONE && e.i == NONE:
                    // A `^` reached through a parameter (`w.d`, `&w.t`).
                    bool deref = o.aderef[e.j]
                    u32 b = o.abase[e.j]
                    if b == NONE: continue
                    bool whole = deref && bare(o, b) && f.root[b] < f.params
                    u32 r = f.root[b] if whole else ptr_root(o, b)
                    if r == NONE: continue
                    ref []u32 sx
                    if !whole: tail(o, b, &sx)
                    if deref && !whole: sx = #append(sx, D_STEP)
                    for y in o.rsfx[c][i64(e.lo)..<i64(e.hi)]:
                        sx = #append(sx, y)
                    note(o, fi, i, r, e.verb, sx[:], one)
                    #delete(sx)
                    continue
                if m == NONE: continue
                if e.i == NONE:
                    note(o, fi, i, m, e.verb, o.rsfx[c][i64(e.lo)..<i64(e.hi)], one)
                    continue
                u32 k = param_of(o, xs[e.i]) if e.i < u32(#len(xs)) else NONE
                if k != NONE && k != m: push(o, Sum(fi, k, m, e.verb, 0, 0), o.rsfx[c][i64(e.lo)..<i64(e.hi)])

// G_INTO and G_HOLDS: views of parameters stored behind a pointer
// parameter, or in a handle this body answers.
private void into(^Own o, u32 fi):
    ^ir.Fn f = o.f
    ref []u64 hp
    for _ in 0..<#len(f.slot_ty):
        hp = #append(hp, 0)
    for i in 0..<ir.count(f):
        u8 op = f.op[i]
        u32 d = f.dst[i]
        if op == ir.O_INTRINSIC && f.sub[i] == check.B_APPEND:
            []u32 xs = ir.args(f, i)
            if #len(xs) < 2 || ir.is_const(xs[0]) || (f.root[xs[0]] & ir.ROOT_GLOBAL) != 0: continue
            u64 bs = 0
            for x in xs[1..<#len(xs)]:
                bs = bs | from_params(o, x, 0)
            into_bits(o, fi, xs[0], bs, &hp)
        else if op == ir.O_SET && d != NONE && !ir.is_const(d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && f.plo[d] < f.phi[d]:
            into_bits(o, fi, d, from_params(o, f.a[i], 0), &hp)
        else if op == ir.O_CALL:
            u32 c = callee(o, i)
            if c == NONE: continue
            []u32 xs = ir.args(f, i)
            for e in o.rgs[c]:
                if e.kind == G_INTO && (e.key >> 32) < u64(#len(xs)) && (e.key & 0xFFFFFFFF) < u64(#len(xs)):
                    u64 bs = from_params(o, xs[i64(e.key >> 32)], 0)
                    u32 k = xs[i64(e.key & 0xFFFFFFFF)]
                    u32 pk = param_of(o, k)
                    if pk != NONE && pk < 64:
                        for j in 0..<64:
                            if (bs >> u64(j)) & 1 != 0: add_g(o, fi, (u64(j) << 32) | u64(pk), 0, 0, G_INTO)
                    u32 m = origin(o, k)
                    if m != NONE && f.op[m] == ir.O_ADDR && bare(o, f.a[m]) && (f.root[f.a[m]] & ir.ROOT_GLOBAL) == 0: hp[f.root[f.a[m]]] = hp[f.root[f.a[m]]] | bs
                if e.kind == G_HOLDS && e.key < u64(#len(xs)) && bare(o, d) && (f.root[d] & ir.ROOT_GLOBAL) == 0: hp[f.root[d]] = hp[f.root[d]] | from_params(o, xs[i64(e.key)], 0)
    for i in 0..<ir.count(f):
        if f.op[i] != ir.O_RETURN: continue
        ref []i64 hs
        sources(o, f.a[i], &hs, 0)
        for h in hs:
            if h < 0 || (f.root[o.hplace[h]] & ir.ROOT_GLOBAL) != 0: continue
            u64 bs = hp[f.root[o.hplace[h]]]
            for j in 0..<64:
                if (bs >> u64(j)) & 1 != 0: add_g(o, fi, u64(j), 0, 0, G_HOLDS)
        #delete(hs)
    #delete(hp)

// Views of parameters `bs` stored into place `p`: behind pointer parameter
// k (G_INTO), or into a local handle's block.
private void into_bits(^Own o, u32 fi, u32 p, u64 bs, ^ref []u64 hp):
    ^ir.Fn f = o.f
    if bs == 0: return
    u32 r = f.root[p]
    if f.plo[p] < f.phi[p] && f.step[f.plo[p]] == ir.ST_DEREF && r < f.params && r < 64:
        for j in 0..<64:
            if (bs >> u64(j)) & 1 != 0: add_g(o, fi, (u64(j) << 32) | u64(r), 0, 0, G_INTO)
        return
    for j in f.plo[p]..<f.phi[p]:
        if f.step[j] == ir.ST_DEREF: return
    if is_handle(&o.w.t, f.slot_ty[r]): hp^[r] = hp^[r] | bs

// The parameter a bare argument is, or NONE.
private u32 param_of(^Own o, u32 x):
    if !bare(o, x) || (o.f.root[x] & ir.ROOT_GLOBAL) != 0 || o.f.root[x] >= o.f.params: return NONE
    return o.f.root[x]

// `next` gains `e` unless it holds one of the same `fi`, `i`, `j` and fields.
// `ptab`: open addressing over `next`, `pgen << 32 | index + 1` (another
// generation's is empty; `next` empty starts one).
private void push(^Own o, Sum e, []u32 sfx):
    // A path through a recursive key grows each round: cut (Rust walks a
    // bounded number of rounds).
    if #len(sfx) > 12: return
    if #len(o.next) == 0: o.pgen += 1
    if #len(o.ptab) < 2 * (#len(o.next) + 1):
        i64 n = 64
        for n < 4 * (#len(o.next) + 1):
            n = n * 2
        #delete(o.ptab)
        o.ptab = #make([]u64, n)
        for q in 0..<#len(o.next):
            Sum y = o.next[q]
            u64 k = sum_hash(y, o.nsfx[i64(y.lo)..<i64(y.hi)]) & u64(n - 1)
            for (o.ptab[k] >> 32) == o.pgen:
                k = (k + 1) & u64(n - 1)
            o.ptab[k] = (o.pgen << 32) | u64(q + 1)
    u64 mask = u64(#len(o.ptab) - 1)
    u64 k = sum_hash(e, sfx) & mask
    for (o.ptab[k] >> 32) == o.pgen:
        Sum x = o.next[i64(o.ptab[k] & 0xFFFFFFFF) - 1]
        if x.fi == e.fi && x.i == e.i && x.j == e.j && (e.i != NONE || x.verb == e.verb) && x.hi - x.lo == u32(#len(sfx)):
            bool same = true
            for q in 0..<#len(sfx):
                if o.nsfx[i64(x.lo) + q] != sfx[q]: same = false
            if same: return
        k = (k + 1) & mask
    e.lo = u32(#len(o.nsfx))
    for x in sfx:
        o.nsfx = #append(o.nsfx, x)
    e.hi = u32(#len(o.nsfx))
    o.next = #append(o.next, e)
    o.ptab[k] = (o.pgen << 32) | u64(#len(o.next))

private u64 sum_hash(Sum e, []u32 sfx):
    u64 h = 0xcbf29ce484222325
    h = (h ~ u64(e.fi)) * 0x100000001b3
    h = (h ~ u64(e.i)) * 0x100000001b3
    h = (h ~ u64(e.j)) * 0x100000001b3
    for x in sfx:
        h = (h ~ u64(x)) * 0x100000001b3
    return h ~ (h >> 29)

// A move through parameter `j` at op `m`: noted, with every other parameter
// used after it (later, or anywhere in a loop around it).
private void note(^Own o, u32 fi, u32 m, u32 j, u8 verb, []u32 sfx, bool typed = true):
    ^ir.Fn f = o.f
    // Only a path the parameter's type has, to a handle (a joined key's
    // other bodies may name another type's).
    if !typed && !typed_path(o, pointee(o, f.slot_ty[j]), sfx): return
    push(o, Sum(fi, NONE, j, verb, 0, 0), sfx)
    if !o.uready: index_uses(o)
    u32 from = m + 1
    if o.oloop[m] != NONE: from = o.oloop[m]
    // Pairs (ERR0827) only for handles named by fields from `j^`.
    for x in sfx:
        if x == D_STEP: return
    for k in 0..<f.params:
        if k != j && used_after(o, k, from, m): push(o, Sum(fi, k, j, verb, 0, 0), sfx)

// The ops using each parameter (see `ulo`).
private void index_uses(^Own o):
    ^ir.Fn f = o.f
    o.uready = true
    #truncate(o.ulo, 0)
    #truncate(o.uops, 0)
    #truncate(o.oloop, 0)
    ref []u32 lh
    for i in 0..<ir.count(f):
        for #len(lh) > 0 && lh[#len(lh) - 1] + ir.span(f, lh[#len(lh) - 1]) < i:
            #truncate(lh, #len(lh) - 1)
        u32 ol = NONE
        if #len(lh) > 0: ol = lh[0]
        o.oloop = #append(o.oloop, ol)
        if f.op[i] == ir.O_LOOP: lh = #append(lh, i)
    #delete(lh)
    ref []bool used
    for _ in 0..<f.params:
        used = #append(used, false)
    ref []u64 pairs
    for i in 0..<ir.count(f):
        mark_uses(o, i, &used)
        for k in 0..<f.params:
            if !used[k]: continue
            used[k] = false
            pairs = #append(pairs, (u64(k) << 32) | u64(i))
    for _ in 0..=f.params:
        o.ulo = #append(o.ulo, 0)
    for x in pairs:
        o.ulo[i64(x >> 32) + 1] += 1
    for k in 0..<f.params:
        o.ulo[k + 1] += o.ulo[k]
    ref []u32 at
    for k in 0..<f.params:
        at = #append(at, o.ulo[k])
    for _ in pairs:
        o.uops = #append(o.uops, 0)
    for x in pairs:
        u32 k = u32(x >> 32)
        o.uops[at[k]] = u32(x & 0xFFFFFFFF)
        at[k] += 1
    #delete(at)
    #delete(pairs)
    #delete(used)

// Whether an op from `from` on, other than `m`, uses parameter `k`.
private bool used_after(^Own o, u32 k, u32 from, u32 m):
    u32 lo = o.ulo[k]
    u32 hi = o.ulo[k + 1]
    u32 end = hi
    for lo < hi:
        u32 mid = lo + (hi - lo) / 2
        if o.uops[mid] < from: lo = mid + 1
        else: hi = mid
    if lo < end && o.uops[lo] != m: return true
    return lo + 1 < end

// `uses` for every parameter at once: `used[k]` set if op `i` uses `k`.
private void mark_uses(^Own o, u32 i, ^ref []bool used):
    ^ir.Fn f = o.f
    if f.op[i] == ir.O_BLOCK || f.op[i] == ir.O_LOOP: return
    mark_root(o, f.dst[i], used)
    mark_root(o, f.a[i], used)
    if f.op[i] != ir.O_IF:
        mark_root(o, f.b[i], used)
        mark_root(o, f.c[i], used)
    for x in ir.args(f, i):
        mark_root(o, x, used)

private void mark_root(^Own o, u32 x, ^ref []bool used):
    if x == NONE || ir.is_const(x) || x >= u32(#len(o.f.root)): return
    u32 r = o.f.root[x]
    if r < u32(#len(used^)): used^[r] = true

// ERR0827: a call handed a view into a block and a `^` through which the
// callee may move that block before it uses the view.
private void aliased(^Own o):
    ^ir.Fn f = o.f
    for i in 0..<ir.count(f):
        if f.op[i] != ir.O_CALL: continue
        u32 c = callee(o, i)
        if c == NONE: continue
        []u32 xs = ir.args(f, i)
        for e in o.rsums[c]:
            if e.i == NONE || e.i >= u32(#len(xs)) || e.j >= u32(#len(xs)): continue
            u32 dj = origin(o, xs[e.j])
            u32 di = origin(o, xs[e.i])
            if dj == NONE || di == NONE || f.op[dj] != ir.O_ADDR || f.op[di] != ir.O_ADDR && f.op[di] != ir.O_VIEW: continue
            u32 p = f.a[dj]
            if (f.root[p] & ir.ROOT_GLOBAL) != 0: continue
            u32 hq = prefix(o, p, f.phi[p] - f.plo[p], o.rsfx[c][i64(e.lo)..<i64(e.hi)])
            i64 h = handle_of(o, hq)
            if h < 0 || under(o, f.a[di]) != h: continue
            syntax.Ast a = o.w.p.files[f.file].a
            string8 cn = callee_name(o, f.ref_name[f.a[i]])
            string8 vt = text(o, f.node[di])
            bool recv = e.i == 0 && (o.w.fns[c].slot_flags[0] & ir.S_RECEIVER) != 0
            string8 what = index.hold(#format("the receiver `", vt, "`")) if recv else index.hold(#format("`", vt, "`"))
            string8 hn = spell(o, hq)
            string8 pn = text(o, a.a[f.node[dj]])
            say(o, f.node[di], 827, index.hold(#format("`", cn, "` is handed ", what, ", which points into the block under `", hn, "`, and a `^` to `", pn, "`, through which it may free that block\x1f`", cn, "` may grow or free the block through `", pn, "` and then use ", what, ", which would then point into a block that is gone\x1ecopy the element out of `", hn, "` first and hand `", cn, "` the copy, or hand it an index instead of a pointer and let it take the element again after it grows `", hn, "`")), "")
            label(o, f.node[dj], index.hold(#format("`", cn, "` may grow or free `", hn, "` through this")))

// The source text of node `n`.
// The name under an `x^` inside `n`, spelled `nm`; else NONE.
private u32 deref_of(^Own o, u32 n, string8 nm):
    syntax.Ast a = o.w.p.files[o.f.file].a
    if a.tag[n] == syntax.E_DEREF && a.tag[a.a[n]] == syntax.E_NAME && text(o, a.a[n]) == nm: return a.a[n]
    ref []u32 ks
    a.kids(n, &ks)
    for k in ks:
        u32 r = deref_of(o, k, nm)
        if r != NONE:
            #delete(ks)
            return r
    #delete(ks)
    return NONE

// Whether places `x` and `y` are both the whole of one local.
private bool whole_root(^ir.Fn f, u32 x, u32 y):
    if x == NONE || y == NONE || ir.is_const(x) || ir.is_const(y): return false
    return f.root[x] == f.root[y] && (f.root[x] & ir.ROOT_GLOBAL) == 0 && f.plo[x] == f.phi[x] && f.plo[y] == f.phi[y]

// The local a growth at move `g` lands in, when not the parameter `sl`; else NONE.
private u32 grown_into(^ir.Fn f, u32 g, u32 sl):
    for i in g + 1..<ir.count(f):
        if f.op[i] != ir.O_INTRINSIC: continue
        u32 t = f.dst[i]
        if t == NONE || ir.is_const(t): return NONE
        for j in i + 1..<ir.count(f):
            if f.op[j] != ir.O_SET || !whole_root(f, f.a[j], t): continue
            u32 d = f.dst[j]
            if d == NONE || ir.is_const(d) || (f.root[d] & ir.ROOT_GLOBAL) != 0 || f.plo[d] != f.phi[d] || f.root[d] == sl || (f.slot_flags[f.root[d]] & ir.S_TEMP) != 0: return NONE
            return f.root[d]
        return NONE
    return NONE

// Whether local `sl` is stored somewhere that outlives the call: through a pointer or in a global.
private bool stored_out(^ir.Fn f, u32 sl):
    for i in 0..<ir.count(f):
        if f.op[i] != ir.O_SET || f.a[i] == NONE || ir.is_const(f.a[i]) || f.root[f.a[i]] != sl || f.plo[f.a[i]] != f.phi[f.a[i]]: continue
        u32 d = f.dst[i]
        if d == NONE || ir.is_const(d): continue
        if (f.root[d] & ir.ROOT_GLOBAL) != 0: return true
        for j in f.plo[d]..<f.phi[d]:
            if f.step[j] == ir.ST_DEREF: return true
    return false

// Whether node `n` is the handle a `#reserve(` call is handed.
private bool reserving(^Own o, u32 n):
    syntax.Ast a = o.w.p.files[o.f.file].a
    string8 src = o.w.p.files[o.f.file].src
    i64 lo = i64(a.lo[n])
    return lo >= 9 && src[lo - 9..<lo] == "#reserve("

private string8 text(^Own o, u32 n):
    syntax.Ast a = o.w.p.files[o.f.file].a
    return index.hold(strings.clone(o.w.p.files[o.f.file].src[i64(a.lo[n])..<i64(a.hi[n])]))

// A place as messages spell it: `b.items`.
private string8 spell(^Own o, u32 p):
    ^ir.Fn f = o.f
    ref []char8 s
    u32 r = f.root[p]
    s = #append(s, ..slot(o, r))
    u32 t = f.glob_ty[r & ~ir.ROOT_GLOBAL] if (r & ir.ROOT_GLOBAL) != 0 else f.slot_ty[r]
    for j in f.plo[p]..<f.phi[p]:
        if f.step[j] == ir.ST_FIELD:
            []u32 ns = o.w.t.slot_names(t)
            if f.step_val[j] < u32(#len(ns)): s = #append(s, ..#format(".", o.w.t.text(ns[f.step_val[j]])))
            t = check.slot_ty(&o.w.t, t, f.step_val[j])
        else if f.step[j] == ir.ST_DEREF:
            // `p.a` reads through `p`: written without the `^`.
            if j + 1 == f.phi[p]: s = #append(s, '^')
            t = o.w.t.a[o.w.t.resolve(t)]
    return index.hold(s)

private bool bare(^Own o, u32 p):
    return p != NONE && !ir.is_const(p) && o.f.plo[p] == o.f.phi[p]

// View `d` now holds what `src` points into: a handle's block, or a view's.
private void mint(^Own o, ^ref []u64 s, i64 d, u32 src, bool take):
    i64 u = view_of(o, src)
    if u == d && !take: return
    for h in 0..<o.nh:
        set(s, points(o, d, h), false)
    for m in 0..<o.nm:
        set(s, moved(o, d, m), false)
    set(s, freed(o, d), false)
    for k in 0..<o.nk:
        set(s, frame(o, d, k), false)
    o.ans[d] = NONE
    o.vholds[d] = false
    o.vsp[d] = NONE
    o.vrec[d] = NONE
    i64 h = under(o, src) if take else handle_of(o, src)
    if h >= 0:
        set(s, points(o, d, h), true)
        if !take && u >= 0: o.vholds[d] = o.vholds[u]
        return
    i64 fr = frame_of(o, src) if take else -1
    if fr >= 0:
        set(s, frame(o, d, fr), true)
        return
    if u < 0 || u == d: return
    o.ans[d] = o.ans[u]
    o.vholds[d] = o.vholds[u]
    o.vsp[d] = o.vsp[u]
    o.vrec[d] = o.vrec[u]
    // Of another type (an element of `u`): only blocks `d`'s type can view.
    u32 dt = o.f.slot_ty[o.vslot[d]]
    bool same = o.w.t.resolve(dt) == o.w.t.resolve(o.f.slot_ty[o.vslot[u]])
    for k in 0..<o.nh:
        set(s, points(o, d, k), has(s, points(o, u, k)) && (same || stores_into(o, dt, o.f.place_ty[o.hplace[k]], false, true)))
    for m in 0..<o.nm:
        bool mm = has(s, moved(o, u, m))
        if mm && !same && o.mv_h[m] != NONE:
            u8 vb = o.mv_verb[m]
            mm = stores_into(o, dt, o.f.place_ty[o.hplace[o.mv_h[m]]], vb != ir.MV_APPEND && vb != ir.MV_INSERT, true)
        set(s, moved(o, d, m), mm)
    set(s, freed(o, d), has(s, freed(o, u)))
    for k in 0..<o.nk:
        set(s, frame(o, d, k), has(s, frame(o, u, k)))

// The parameters whose views operand `x` may carry (bit j).
private u64 from_params(^Own o, u32 x, i64 depth):
    ^ir.Fn f = o.f
    if x == NONE || ir.is_const(x) || depth > 16 || (f.root[x] & ir.ROOT_GLOBAL) != 0: return 0
    u32 r = f.root[x]
    for j in f.plo[x]..<f.phi[x]:
        if f.step[j] == ir.ST_DEREF: return 0
    // An element read out of a view is a value.
    u32 pr = o.w.t.resolve(f.place_ty[x])
    if f.plo[x] != f.phi[x] && pr != NONE && o.w.t.tag[pr] == types.T_PRIM: return 0
    if r < f.params:
        if r < 64 && is_view(&o.w.t, f.slot_ty[r]): return u64(1) << u64(r)
        return 0
    u32 m = o.def[r]
    if m == NONE: return 0
    u8 op = f.op[m]
    if op == ir.O_VIEW || op == ir.O_ADDR || op == ir.O_SET || op == ir.O_CONV: return from_params(o, f.a[m], depth + 1)
    u64 bs = 0
    if op == ir.O_MAKE:
        for y in ir.args(f, m):
            bs = bs | from_params(o, y, depth + 1)
    return bs

// `now_keeps` (`now_keeps1`): parameters whose views (whose pointee's
// views) this body stores into package storage, or hands to a callee that
// keeps them there.
private void kept(^Own o):
    ^ir.Fn f = o.f
    for i in 0..<ir.count(f):
        u32 d = f.dst[i]
        u64 b0 = 0
        u64 b1 = 0
        if f.op[i] == ir.O_SET && d != NONE && !ir.is_const(d) && (f.root[d] & ir.ROOT_GLOBAL) != 0: pbits(o, f.a[i], &b0, &b1, false)
        if f.op[i] == ir.O_INTRINSIC && f.sub[i] == check.B_APPEND:
            []u32 xs = ir.args(f, i)
            if #len(xs) > 1 && !ir.is_const(xs[0]) && (f.root[xs[0]] & ir.ROOT_GLOBAL) != 0:
                for x in xs[1..<#len(xs)]:
                    pbits(o, x, &b0, &b1, false)
        if f.op[i] == ir.O_CALL:
            u32 c = callee(o, i)
            if c != NONE:
                []u32 xs = ir.args(f, i)
                for j in 0..<#len(xs):
                    if j < 64 && (o.rkeeps[c] >> u64(j)) & 1 != 0: pbits(o, xs[j], &b0, &b1, false)
                    if j < 64 && (o.rkeeps1[c] >> u64(j)) & 1 != 0: b1 = b1 | lvl1(o, xs[j])
        o.now_keeps = o.now_keeps | b0
        o.now_keeps1 = o.now_keeps1 | b1
    // A view stored through a pointer parameter whose target is kept is kept.
    for i in 0..<ir.count(f):
        u32 d = f.dst[i]
        if f.op[i] != ir.O_SET || d == NONE || ir.is_const(d) || (f.root[d] & ir.ROOT_GLOBAL) != 0 || f.plo[d] == f.phi[d] || f.step[f.plo[d]] != ir.ST_DEREF: continue
        u32 pr = f.root[d]
        if pr < f.params && pr < 64 && (o.now_keeps1 >> u64(pr)) & 1 != 0: o.now_keeps = o.now_keeps | from_params(o, f.a[i], 0)

// Whether a value of type `t` can point anywhere: a view, a handle, or a
// shape holding one.
private bool carries(^Own o, u32 t, i64 depth = 0):
    u32 r = o.w.t.resolve(t)
    if r == NONE || depth > 8: return false
    if is_view(&o.w.t, r) || is_handle(&o.w.t, r): return true
    if o.w.t.tag[r] != types.T_TUPLE: return false
    for x in o.w.t.slots(r):
        if carries(o, x, depth + 1): return true
    return false

// The parameters operand `x` may carry views of: where they point (`b0`), or
// what is read through them (`b1`: through a `^` or a subscript, Rust's
// level 1); `addr`: `x` is lent (`&x`, a window of it).
private void pbits(^Own o, u32 x, ^u64 b0, ^u64 b1, bool addr):
    ^ir.Fn f = o.f
    if x == NONE || ir.is_const(x) || (f.root[x] & ir.ROOT_GLOBAL) != 0: return
    u32 r = f.root[x]
    if !addr && f.plo[x] != f.phi[x] && !carries(o, f.place_ty[x]): return
    u32 hi = f.phi[x]
    if addr:
        for hi > f.plo[x] && f.step[hi - 1] == ir.ST_FIELD:
            hi -= 1
        if hi > f.plo[x]: hi -= 1
    bool deep = false
    for j in f.plo[x]..<hi:
        if f.step[j] == ir.ST_DEREF || f.step[j] == ir.ST_INDEX: deep = true
    u32 pr = r if r < f.params else o.alias[r]
    if pr != NONE:
        if pr >= 64: return
        // A view field that views nothing under `pr^`: what the others may.
        if deep && via_ff(o, x):
            for k in 0..<f.params:
                if k == pr || k >= 64: continue
                if is_ptr(&o.w.t, f.slot_ty[k]): b1^ = b1^ | (u64(1) << u64(k))
                else if carries(o, f.slot_ty[k]): b0^ = b0^ | (u64(1) << u64(k))
            b0^ = b0^ | o.ps0[pr]
            b1^ = b1^ | o.ps1[pr]
            return
        if deep:
            b1^ = b1^ | (u64(1) << u64(pr))
            b0^ = b0^ | o.ps0[pr]
            b1^ = b1^ | o.ps1[pr]
        else if carries(o, f.slot_ty[pr]): b0^ = b0^ | (u64(1) << u64(pr))
        return
    // What was stored at, over or under this place of the local.
    for k in o.rlo[r]..<o.rlo[r + 1]:
        u32 q = o.rpl[k]
        if q == x || above(o, q, x) || above(o, x, q):
            if deep: b1^ = b1^ | o.d0[q] | o.d1[q]
            else:
                b0^ = b0^ | o.d0[q]
                b1^ = b1^ | o.d1[q]

private bool win_read(^Own o, u32 x):
    if x == NONE || ir.is_const(x) || (o.f.root[x] & ir.ROOT_GLOBAL) != 0: return false
    u32 t = o.f.place_ty[x]
    return is_view(&o.w.t, t) || is_handle(&o.w.t, t)

// What operand `x` carries, read one level deeper (Rust's `deeper`).
private u64 lvl1(^Own o, u32 x):
    u64 b0 = 0
    u64 b1 = 0
    pbits(o, x, &b0, &b1, false)
    return b0 | b1

// `d0`, `d1` per slot (see `Own`), flow-insensitively.
private void derive(^Own o):
    ^ir.Fn f = o.f
    #truncate(o.d0, 0)
    #truncate(o.pfm, 0)
    #truncate(o.d1, 0)
    #truncate(o.rlo, 0)
    #truncate(o.rpl, 0)
    for _ in 0..<#len(f.root):
        o.d0 = #append(o.d0, 0)
        o.d1 = #append(o.d1, 0)
    #truncate(o.ps0, 0)
    #truncate(o.ps1, 0)
    for _ in 0..<f.params:
        o.ps0 = #append(o.ps0, 0)
        o.ps1 = #append(o.ps1, 0)
    // Each local's places: `rpl[rlo[r]..<rlo[r + 1]]`.
    for _ in 0..=#len(f.slot_ty):
        o.rlo = #append(o.rlo, 0)
    for p in 0..<#len(f.root):
        if (f.root[p] & ir.ROOT_GLOBAL) == 0: o.rlo[i64(f.root[p]) + 1] += 1
    for r in 0..<#len(f.slot_ty):
        o.rlo[r + 1] += o.rlo[r]
    ref []u32 at
    for r in 0..<#len(f.slot_ty):
        at = #append(at, o.rlo[r])
    for _ in 0..<o.rlo[#len(f.slot_ty)]:
        o.rpl = #append(o.rpl, 0)
    for p in 0..<#len(f.root):
        if (f.root[p] & ir.ROOT_GLOBAL) != 0: continue
        o.rpl[at[f.root[p]]] = u32(p)
        at[f.root[p]] += 1
    #delete(at)
    for _ in 0..<4:
        bool grew = false
        for i in 0..<ir.count(f):
            u8 op = f.op[i]
            u32 d = f.dst[i]
            u64 b0 = 0
            u64 b1 = 0
            // A window over a view or handle reads it: where it points (Rust's).
            if op == ir.O_SET || op == ir.O_CONV || op == ir.O_VIEW || op == ir.O_ADDR: pbits(o, f.a[i], &b0, &b1, op == ir.O_ADDR || op == ir.O_VIEW && !win_read(o, f.a[i]))
            else if op == ir.O_MAKE:
                for y in ir.args(f, i):
                    pbits(o, y, &b0, &b1, false)
            else if op == ir.O_INTRINSIC && f.sub[i] == check.B_APPEND:
                []u32 xs = ir.args(f, i)
                for y in xs:
                    pbits(o, y, &b0, &b1, false)
                if #len(xs) > 0 && grow_bits(o, xs[0], b0, b1): grew = true
                if #len(xs) > 0 && stored_bits(o, xs[0], b0, b1): grew = true
            else if op == ir.O_CALL:
                u32 c = callee(o, i)
                if c == NONE: continue
                []u32 xs = ir.args(f, i)
                for j in 0..<#len(xs):
                    if j < 64 && (o.rrets[c] >> u64(j)) & 1 != 0: pbits(o, xs[j], &b0, &b1, false)
                    if j < 64 && (o.rrets1[c] >> u64(j)) & 1 != 0: b1 = b1 | lvl1(o, xs[j])
                for e in o.rsums[c][i64(o.rm2[c])..<#len(o.rsums[c])]:
                    if (e.verb == A_PLACED || e.verb == A_UNDER) && e.i == NONE && e.j < u32(#len(xs)): b1 = b1 | lvl1(o, xs[e.j])
                for e in o.rgs[c]:
                    if e.kind == G_HOLDS && e.key < u64(#len(xs)): pbits(o, xs[i64(e.key)], &b0, &b1, false)
            else: continue
            if op != ir.O_CALL && stored_bits(o, d, b0, b1): grew = true
            if grow_bits(o, d, b0, b1): grew = true
        if !grew: break

// A store through a `^` parameter: what is read through it carries it too.
private bool stored_bits(^Own o, u32 d, u64 b0, u64 b1):
    ^ir.Fn f = o.f
    if (b0 | b1) == 0 || d == NONE || ir.is_const(d) || (f.root[d] & ir.ROOT_GLOBAL) != 0 || f.plo[d] == f.phi[d] || f.step[f.plo[d]] != ir.ST_DEREF: return false
    u32 r = f.root[d]
    u32 pr = r if r < f.params else o.alias[r]
    if pr == NONE || pr >= f.params: return false
    if (o.ps0[pr] | b0) == o.ps0[pr] && (o.ps1[pr] | b1) == o.ps1[pr]: return false
    o.ps0[pr] = o.ps0[pr] | b0
    o.ps1[pr] = o.ps1[pr] | b1
    return true

private bool grow_bits(^Own o, u32 d, u64 b0, u64 b1):
    ^ir.Fn f = o.f
    if d == NONE || ir.is_const(d) || (f.root[d] & ir.ROOT_GLOBAL) != 0 || f.root[d] < f.params: return false
    if (o.d0[d] | b0) == o.d0[d] && (o.d1[d] | b1) == o.d1[d]: return false
    o.d0[d] = o.d0[d] | b0
    o.d1[d] = o.d1[d] | b1
    return true

// The parameters (bit j) whose pointee operand `x` may be a copy of: `p^`,
// through locals.
private u64 copied(^Own o, u32 x, i64 depth):
    ^ir.Fn f = o.f
    if x == NONE || ir.is_const(x) || depth > 16 || (f.root[x] & ir.ROOT_GLOBAL) != 0: return 0
    u32 r = f.root[x]
    if f.plo[x] < f.phi[x] && f.step[f.plo[x]] == ir.ST_DEREF:
        return u64(1) << u64(r) if r < f.params && r < 64 else 0
    if f.plo[x] != f.phi[x] || r < f.params: return 0
    u64 bs = 0
    for i in 0..<ir.count(f):
        u32 d = f.dst[i]
        if f.op[i] == ir.O_SET && bare(o, d) && f.root[d] == r: bs = bs | copied(o, f.a[i], depth + 1)
    return bs

// The pointer parameter a bare argument is (through a copy), as a bit.
private u64 ptr_param(^Own o, u32 x):
    u32 m = param_of(o, x)
    if m == NONE && bare(o, x) && (o.f.root[x] & ir.ROOT_GLOBAL) == 0: m = o.alias[o.f.root[x]]
    if m == NONE || m >= 64 || !is_ptr(&o.w.t, o.f.slot_ty[m]): return 0
    return u64(1) << u64(m)

// The static facts `pt2`, `loose_addr`, `loose_store` and `mayin`.
private void loose(^Own o):
    ^ir.Fn f = o.f
    for _ in 0..<o.nk:
        o.loose_addr = #append(o.loose_addr, false)
        o.loose_store = #append(o.loose_store, false)
    for i in 0..<ir.count(f):
        u8 op = f.op[i]
        u32 d = f.dst[i]
        if op == ir.O_SET && bare(o, d) && (f.root[d] & ir.ROOT_GLOBAL) == 0:
            u32 m = origin(o, f.a[i])
            if m != NONE && f.op[m] == ir.O_ADDR && bare(o, f.a[m]) && (f.root[f.a[m]] & ir.ROOT_GLOBAL) == 0 && view_of(o, f.a[m]) >= 0: o.pt2[f.root[d]] = f.root[f.a[m]]
        if op == ir.O_CONV && f.sub[i] == ir.CV_TO_RAWPTR:
            u32 m = origin(o, f.a[i])
            if m == NONE || f.op[m] != ir.O_ADDR: continue
            i64 k = frame_of(o, f.a[m])
            if k >= 0: o.loose_addr[k] = true
        if op == ir.O_CALL_INDIRECT:
            []u32 xs = ir.args(f, i)
            for x in xs:
                u32 m = origin(o, x)
                if m == NONE || f.op[m] != ir.O_ADDR: continue
                i64 a = frame_of(o, f.a[m])
                if a < 0: continue
                for y in xs:
                    u32 n = origin(o, y)
                    if n == NONE || f.op[n] != ir.O_VIEW: continue
                    i64 k = frame_of(o, f.a[n])
                    if k >= 0: o.mayin = #append(o.mayin, (u64(a) << 32) | u64(k))

// The first frame slot operand `x` (or a tuple built for it) points at, or -1.
private i64 frame_in(^Own o, ^ref []u64 s, u32 x, i64 depth):
    ^ir.Fn f = o.f
    if x == NONE || ir.is_const(x) || depth > 16 || (f.root[x] & ir.ROOT_GLOBAL) != 0: return -1
    i64 v = view_of(o, x)
    if v >= 0:
        for k in 0..<o.nk:
            if has(s, frame(o, v, k)): return k
        return -1
    u32 m = o.def[f.root[x]]
    if m == NONE || f.op[m] != ir.O_MAKE: return -1
    for y in ir.args(f, m):
        i64 k = frame_in(o, s, y, depth + 1)
        if k >= 0: return k
    return -1

// Argument `j` of call op `i` (of `n`) as written, else the call.
private u32 arg_node(^Own o, u32 i, u32 j, u32 n):
    syntax.Ast a = o.w.p.files[o.f.file].a
    u32 c = o.f.node[i]
    if a.tag[c] != syntax.E_CALL: return c
    []u32 ks = a.list(a.b[c])
    u32 at = NONE
    if u32(#len(ks)) == n + 2: at = ks[2 + j]
    else if u32(#len(ks)) == n + 1 && j > 0: at = ks[1 + j]
    if at == NONE: return c
    if a.tag[at] == syntax.E_ARG: return a.a[at]
    return at

// The blocks operand `x`'s views point into are now in package storage.
private void expose(^Own o, ^ref []u64 s, u32 x, u32 i):
    i64 v = view_of(o, x)
    if v < 0: return
    for h in 0..<o.nh:
        if has(s, points(o, v, h)): expose_h(o, s, h, i)

// Handle `h`'s block's views are in package storage, put there at op `i`.
private void expose_h(^Own o, ^ref []u64 s, i64 h, u32 i):
    u32 k = o.esite[i]
    if h < 0 || k == NONE || (o.f.root[o.hplace[h]] & ir.ROOT_GLOBAL) != 0: return
    set(s, exposed(o, h), true)
    set(s, esite(o, i64(k)), true)
    set(s, afresh(o, h), false)
    if !has_u32(&o.es_h[h], k): o.es_h[h] = #append(o.es_h[h], k)

// The first site on the way here that exposed handle `h` (Rust keeps the
// first per path), or NONE.
private u32 exp_site(^Own o, ^ref []u64 s, i64 h):
    if !has(s, exposed(o, h)): return NONE
    u32 best = NONE
    for k in o.es_h[h]:
        if has(s, esite(o, i64(k))) && k < best: best = k
    return best

// Where site `k` put views, as messages say it.
private string8 exp_into(^Own o, u32 k):
    if o.es_by[k] != NONE: return index.hold(#format("package storage, by `", call_text(o, o.es_by[k]), "`"))
    return index.hold(#format("`", text(o, o.es_at[k]), "`"))

// The ops that may store views in package storage.
private void sites(^Own o):
    ^ir.Fn f = o.f
    #truncate(o.esite, 0)
    #truncate(o.es_at, 0)
    #truncate(o.es_by, 0)
    #truncate(o.es_g, 0)
    #truncate(o.es_q, 0)
    #truncate(o.es_a, 0)
    for x in o.es_h:
        #truncate(x, 0)
    for #len(o.es_h) < o.nh:
        ref []u32 e0
        o.es_h = #append(o.es_h, e0)
    o.nes = 0
    syntax.Ast a = o.w.p.files[f.file].a
    for i in 0..<ir.count(f):
        u32 d = f.dst[i]
        u32 at = NONE
        u32 by = NONE
        if f.op[i] == ir.O_CALL:
            u32 c = callee(o, i)
            if c != NONE && (o.rkeeps[c] | o.rkeeps1[c]) != 0:
                at = f.node[i]
                by = i
        else if f.op[i] == ir.O_SET && d != NONE && !ir.is_const(d) && (f.root[d] & ir.ROOT_GLOBAL) != 0:
            at = f.node[i]
            if a.tag[at] == syntax.S_ASSIGN: at = a.list(a.b[at])[0]
        else if f.op[i] == ir.O_INTRINSIC && f.sub[i] == check.B_APPEND:
            []u32 xs = ir.args(f, i)
            if #len(xs) >= 2 && !ir.is_const(xs[0]) && (f.root[xs[0]] & ir.ROOT_GLOBAL) != 0: at = f.node[i]
        if at == NONE:
            o.esite = #append(o.esite, NONE)
            continue
        o.esite = #append(o.esite, u32(o.nes))
        o.es_at = #append(o.es_at, at)
        o.es_by = #append(o.es_by, by)
        u32 gt = NONE
        if by == NONE:
            u32 r = NONE
            if f.op[i] == ir.O_SET: r = f.root[d]
            else: r = f.root[ir.args(f, i)[0]]
            gt = f.glob_ty[r & ~ir.ROOT_GLOBAL]
        o.es_g = #append(o.es_g, gt)
        o.nes += 1

// A move a callee makes under a block whose views package storage holds:
// WRN0803 at the call, naming the first such move (Rust's order).
private void exposed_at(^Own o, u32 i, ^ref []u64 s, u32 c):
    ^ir.Fn f = o.f
    bool any = false
    for h in 0..<o.nh:
        if has(s, exposed(o, h)): any = true
    if !any || has_u32(&o.said, f.node[i]): return
    []u32 xs = ir.args(f, i)
    ref []i64 ex
    for h in 0..<o.nh:
        if exp_site(o, s, h) != NONE && !has(s, afresh(o, h)): ex = #append(ex, h)
    if #len(ex) == 0 || o.rm1[c] == 0:
        #delete(ex)
        return
    bases(o, i)
    for e in o.rsums[c][0..<i64(o.rm1[c])]:
        if e.j >= u32(#len(xs)): continue
        bool deref = o.aderef[e.j]
        u32 b = o.abase[e.j]
        if b == NONE: continue
        []u32 sfx = o.rsfx[c][i64(e.lo)..<i64(e.hi)]
        i64 hit = -1
        u32 mt = f.place_ty[b]
        if deref: mt = pointee(o, mt)
        mt = sfx_type(o, mt, sfx)
        for h in ex:
            if !on_path(o, o.hplace[h], b, deref, sfx, !o.uh[h]) || held_site(o, s, h, mt, e.verb != ir.MV_APPEND && e.verb != ir.MV_INSERT) == NONE: continue
            if hit < 0 || above(o, o.hplace[h], o.hplace[hit]): hit = h
        if hit < 0: continue
        string8 hn = index.hold(#format(sum_written(o, i, e, c), "` inside `", call_text(o, i)))
        say_exposed(o, f.node[i], e.verb, hn, hit, held_site(o, s, hit, mt, e.verb != ir.MV_APPEND && e.verb != ir.MV_INSERT))
        #delete(ex)
        return
    #delete(ex)

private void say_exposed(^Own o, u32 n, u8 verb, string8 hn, i64 h, u32 k):
    if !once(o, n): return
    ^ir.Fn f = o.f
    string8 bn = spell(o, o.hplace[h])
    string8 into = exp_into(o, k)
    check.Where at = check.where(o.w, f.file, f.item, o.es_at[k])
    say(o, n, diag.WRN + 803, index.hold(#format(GERUND[verb], " `", hn, "` may move or free the block under `", bn, "`, whose views were stored in ", into, " at ", at.line, ":", at.col, " and would dangle")), index.hold(#format("store a `#copy` there instead, or keep `", bn, "`'s block alive and unmoved while package storage holds its views")))
    label(o, o.es_at[k], index.hold(#format("views of `", bn, "` stored in ", into, " here")))

// This body's answer `rv` views what a `^` parameter points at: in one slot's
// block (A_PLACED), or anywhere under it (A_UNDER).
private void answers(^Own o, i64 rv, u32 rp, ^ref []u64 s):
    ^ir.Fn f = o.f
    for h in 0..<o.nh:
        if !has(s, points(o, rv, h)): continue
        u32 x = o.hplace[h]
        u32 r = f.root[x]
        // Into a local record holding a call's answer: under that (P10i).
        if (r & ir.ROOT_GLOBAL) == 0 && r >= f.params && r < u32(#len(o.rbase)) && o.rbase[r] != NONE:
            u32 r2 = NONE
            ref []u32 sx
            if rec_path(o, r, &r2, &sx): push(o, Sum(o.cur, NONE, r2, A_UNDER, 0, 0), sx[..<to_step(&sx)])
            #delete(sx)
            continue
        if (r & ir.ROOT_GLOBAL) != 0 || r >= f.params: continue
        // A_UNDER keeps the fields of `r^` down to the first `^` (P10h).
        ref []u32 sx
        if o.uh[h]:
            if bare(o, x) || ptr_root(o, x) == r:
                tail(o, x, &sx)
                push(o, Sum(o.cur, NONE, r, A_UNDER, 0, 0), sx[..<to_step(&sx)])
            #delete(sx)
            continue
        if ptr_root(o, x) != r: continue
        tail(o, x, &sx)
        // Answered by a call not handed `r` itself, it names no slot of `r^`
        // (Rust's): under its path.
        bool fwd = o.vsp[rv] == NONE || o.vrec[rv] != NONE && bare(o, o.vrec[rv]) && f.root[o.vrec[rv]] == r
        if !fwd || has_u32(&sx, D_STEP): push(o, Sum(o.cur, NONE, r, A_UNDER, 0, 0), sx[..<to_step(&sx)])
        else: push(o, Sum(o.cur, NONE, r, A_PLACED, 0, 0), sx[:])
        #delete(sx)

private void step(rawptr ctx, ^Flow fl, u32 i, ^ref []u64 s):
    ^Own o = ^Own(ctx)
    ^ir.Fn f = o.f
    u8 op = f.op[i]
    u32 d = f.dst[i]
    if op == ir.O_SCOPE_END:
        for x in ir.args(f, i):
            if o.fk[x] != NONE: set(s, ended(o, i64(o.fk[x])), true)
            // Its block next time is another: what was exposed is not.
            for h in 0..<o.nh:
                if o.f.root[o.hplace[h]] == x: set(s, exposed(o, h), false)
        return
    // A local bound afresh to nothing (`ref []T x` in a loop): its block is
    // another; its moves (its own or a callee's through `&x`) no longer reach
    // what was exposed (the Rust dadoc's warning in the callee case was false).
    if op == ir.O_SET && d != NONE && !ir.is_const(d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && f.plo[d] == f.phi[d] && ir.is_const(f.a[i]):
        for h in 0..<o.nh:
            if o.f.root[o.hplace[h]] == f.root[d]: set(s, afresh(o, h), true)
    if op == ir.O_SET || op == ir.O_UN || op == ir.O_BIN || op == ir.O_CONV || op == ir.O_RETURN:
        through_read(o, fl, i, f.a[i], s, false)
        if op == ir.O_BIN: through_read(o, fl, i, f.b[i], s, true)
        // A view's value used (compared, copied into a name, answered).
        bool named = op != ir.O_SET && op != ir.O_CONV || d != NONE && !ir.is_const(d) && ((f.root[d] & ir.ROOT_GLOBAL) != 0 || (f.slot_flags[f.root[d]] & ir.S_USER) != 0)
        if named: value_read(o, fl, i, f.a[i], s, false)
        if op == ir.O_BIN: value_read(o, fl, i, f.b[i], s, true)
    if op == ir.O_LOOP && f.b[i] != NONE && bare(o, f.b[i]) && view_of(o, f.b[i]) >= 0 && is_view(&o.w.t, f.place_ty[f.b[i]]): read(o, fl, i, f.b[i], s, f.c[i])
    if op == ir.O_INTRINSIC && f.sub[i] == check.B_AL_FORMAT:
        []u32 fa = ir.args(f, i)
        for j in 0..<#len(fa):
            if !bare(o, fa[j]) || view_of(o, fa[j]) < 0 || !is_view(&o.w.t, f.place_ty[fa[j]]): continue
            // Its first argument is the allocator.
            u32 an = arg_node(o, i, u32(j - 1), u32(#len(fa) - 1)) if j > 0 else f.node[i]
            if an != f.node[i]: read(o, fl, i, fa[j], s, an)
    if o.nk > 0 && (op == ir.O_SET || op == ir.O_UN || op == ir.O_BIN || op == ir.O_CONV || op == ir.O_RETURN):
        dead_read(o, fl, i, f.a[i], s)
        if op == ir.O_BIN: dead_read(o, fl, i, f.b[i], s)
    if o.nk > 0:
        if d != NONE && !ir.is_const(d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && o.fk[f.root[d]] != NONE: set(s, ended(o, i64(o.fk[f.root[d]])), false)
    if op == ir.O_SET && d != NONE && !ir.is_const(d) && handle_of(o, d) >= 0: set(s, sent(o, handle_of(o, d)), false)
    // A view handed to a call is read (`p.say(written)`).
    if op == ir.O_CALL:
        []u32 ra = ir.args(f, i)
        for j in 0..<#len(ra):
            u32 x = ra[j]
            if x == NONE || ir.is_const(x) || view_of(o, x) < 0 || !bare(o, x) && f.step[f.plo[x]] != ir.ST_DEREF: continue
            u32 an = arg_node(o, i, u32(j), u32(#len(ra)))
            if an != f.node[i]: read(o, fl, i, ra[j], s, an)
    if (op == ir.O_CALL || op == ir.O_CALL_INDIRECT) && (op == ir.O_CALL_INDIRECT || f.ref_flags[f.a[i]] & ir.R_FOREIGN != 0): no_body(o, i, s)
    if op == ir.O_SET && shares(o, d, f.a[i]): mark_shared(o, s, d)
    if op == ir.O_SET && d != NONE && !ir.is_const(d):
        stored(o, fl, i, s)
        // A handle copied: the source now shares the destination's block.
        i64 k = view_of(o, f.a[i]) if bare(o, f.a[i]) && handle_of(o, f.a[i]) >= 0 else -1
        i64 h = handle_of(o, d)
        if h >= 0 && k >= 0 && k != view_of(o, d): set(s, points(o, k, h), true)
    if op == ir.O_MAKE && d != NONE && !ir.is_const(d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && o.fk[f.root[d]] != NONE:
        for y in ir.args(f, i):
            holds(o, s, d, y, i)
    if op == ir.O_MAKE && bare(o, d) && view_of(o, d) >= 0 && check.is_trait(o.w, f.place_ty[d]):
        mint(o, s, view_of(o, d), ir.args(f, i)[0], false)
        return
    // A window over a view reads it (`w[3..<n]`).
    if op == ir.O_VIEW && win_read(o, f.a[i]) && view_of(o, f.a[i]) >= 0: read(o, fl, i, f.a[i], s)
    if (op == ir.O_VIEW || op == ir.O_ADDR || op == ir.O_CONV && (f.sub[i] == ir.CV_LEND || f.sub[i] == ir.CV_RETAG) || op == ir.O_SET) && bare(o, d) && view_of(o, d) >= 0:
        mint(o, s, view_of(o, d), f.a[i], op == ir.O_VIEW || op == ir.O_ADDR)
        // A view copied into a name is minted now (Rust's).
        if op == ir.O_SET && (f.root[d] & ir.ROOT_GLOBAL) == 0 && (f.slot_flags[f.root[d]] & ir.S_USER) != 0 && is_view(&o.w.t, f.place_ty[d]) && bare(o, f.a[i]) && view_of(o, f.a[i]) >= 0 && (f.slot_flags[f.root[f.a[i]]] & ir.S_USER) != 0:
            i64 dv = view_of(o, d)
            for m in 0..<o.nm:
                set(s, moved(o, dv, m), false)
            set(s, freed(o, dv), false)
        return
    if op == ir.O_MOVE:
        moving(o, fl, i, s, i64(o.mi[i]))
        i64 sh = handle_of(o, f.a[i])
        if sh >= 0 && f.sub[i] == ir.MV_SEND: set(s, sent(o, sh), true)
        if sh >= 0 && f.sub[i] == ir.MV_REBIND: set(s, sent(o, sh), false)
        return
    if op == ir.O_CHECK && f.sub[i] == ir.CK_SENT:
        sent_read(o, fl, i, s)
        return
    if op == ir.O_INTRINSIC && f.sub[i] == check.B_CH_FIELD && bare(o, d) && view_of(o, d) >= 0 && handle_of(o, d) < 0:
        mint(o, s, view_of(o, d), ir.args(f, i)[0], false)
        return
    if op == ir.O_INTRINSIC && (f.sub[i] == check.B_MAP_GET || f.sub[i] == check.B_MAP_HAS):
        []u32 ms = ir.args(f, i)
        if #len(ms) > 0: read(o, fl, i, ms[0], s)
        return
    if op == ir.O_INTRINSIC && f.sub[i] == check.B_APPEND:
        appended(o, fl, i, s)
        return
    if op == ir.O_CHECK:
        []u32 xs = ir.args(f, i)
        if #len(xs) > 0: read(o, fl, i, xs[0], s)
        return
    if op == ir.O_CALL && f.ref_flags[f.a[i]] & ir.R_FOREIGN == 0:
        u32 c = callee(o, i)
        []u32 xs = ir.args(f, i)
        // What the callee needs kept apart, keeps, then moves (Rust's order).
        if c != NONE: apart_at(o, fl, i, s, c)
        if c != NONE:
            for j in 0..<#len(xs):
                if j >= 64 || (o.rkeeps[c] >> u64(j)) & 1 == 0: continue
                expose(o, s, xs[j], i)
                if bare(o, xs[j]): expose_h(o, s, handle_of(o, xs[j]), i)
                if !fl.report || o.quiet: continue
                string8 cn = callee_name(o, f.ref_name[f.a[i]])
                u32 an = arg_node(o, i, u32(j), u32(#len(xs)))
                string8 fname = callee_name(o, f.name)
                i64 k = frame_in(o, s, xs[j], 0)
                u32 sm = stack_of(o, s, xs[j])
                if k >= 0:
                    string8 x = slot(o, o.fslot[k])
                    say(o, an, 826, index.hold(#format("this hands a pointer to `", x, "`, which is stored on `", fname, "`'s frame, to `", cn, "`, which keeps it in package storage, which outlives every frame")), index.hold(#format("hold `", x, "` where `", cn, "` keeps it — declare it in the caller and pass a `^` down — or allocate it with `#new`/`#make` on the ambient allocator so it outlives `", fname, "`")))
                else if sm != NONE:
                    say(o, an, 821, index.hold(#format("this hands storage `#stack` put in this block to `", cn, "`, which keeps it in package storage, which outlives every frame. `#stack` lowers to a C99 compound literal, which lives until the end of the **block** that wrote it")), index.hold(#format("allocate what `", cn, "` keeps with `#new`/`#make` on the ambient allocator, or have `", cn, "` copy it")))
                    label(o, f.node[sm], "`#stack` storage minted here")
            for j in 0..<#len(xs):
                if j >= 64 || (o.rkeeps1[c] >> u64(j)) & 1 == 0: continue
                bool deref = false
                u32 b = arg_base(o, xs[j], &deref)
                if b != NONE:
                    i64 kh = handle_of(o, b) if !deref else -1
                    if kh < 0: kh = uof(o, b)
                    expose_h(o, s, kh, i)
                else: expose(o, s, xs[j], i)
                if fl.report && !o.quiet: copy_kept(o, s, i, u32(j), xs)
            if fl.report && !o.quiet: exposed_at(o, i, s, c)
        if c != NONE:
            for e in o.rsums[c][i64(o.rm2[c])..<#len(o.rsums[c])]:
                if e.verb != S_SHARED || e.i != NONE || e.j >= u32(#len(xs)): continue
                bool deref = false
                u32 b = arg_base(o, xs[e.j], &deref)
                if b != NONE: mark_shared(o, s, b)
                else: set(s, shared(o, o.nrec), true)
        else: no_body(o, i, s)
        u32 mm = o.mi[i]
        for mm != NONE && mm < u32(o.nm) && o.moves[mm] == i:
            moving(o, fl, i, s, i64(mm))
            mm += 1
        if c == NONE: return
        i64 callee = i64(c)
        if bare(o, d) && view_of(o, d) >= 0:
            i64 dv = view_of(o, d)
            bool fresh = true
            for e in o.rgs[c]:
                if e.kind != G_ANS: continue
                i64 gh = global_handle(o, e.key)
                if gh < 0: continue
                if fresh: mint(o, s, dv, NONE, false)
                fresh = false
                set(s, points(o, dv, gh), true)
                o.ans[dv] = c
            for e in o.rgs[c]:
                if e.kind != G_HOLDS || e.key >= u64(#len(xs)) || handle_of(o, d) < 0: continue
                mint(o, s, dv, xs[i64(e.key)], false)
                fresh = false
                o.vholds[dv] = true
            for j in 0..<#len(xs):
                if j < 64 && (o.rrets[callee] >> u64(j)) & 1 != 0:
                    mint(o, s, dv, xs[j], false)
                    fresh = false
                u32 am = origin(o, xs[j]) if j < 64 && (o.rrets1[callee] >> u64(j)) & 1 != 0 else NONE
                if am != NONE && f.op[am] == ir.O_ADDR && bare(o, f.a[am]) && view_of(o, f.a[am]) >= 0:
                    mint(o, s, dv, f.a[am], false)
                    fresh = false
            for e in o.rsums[c][i64(o.rm2[c])..<#len(o.rsums[c])]:
                if e.verb != A_PLACED && e.verb != A_UNDER || e.i != NONE || e.j >= u32(#len(xs)): continue
                bool deref = false
                u32 b = arg_base(o, xs[e.j], &deref)
                i64 av = view_of(o, xs[e.j]) if bare(o, xs[e.j]) else -1
                if b == NONE && e.verb == A_UNDER && av >= 0:
                    // Under what a window points into.
                    for k in 0..<o.nh:
                        if !has(s, points(o, av, k)): continue
                        if fresh: mint(o, s, dv, NONE, false)
                        fresh = false
                        set(s, points(o, dv, k), true)
                    continue
                if b == NONE: continue
                i64 h = -1
                if e.verb == A_UNDER:
                    u32 ub = under_base(o, b, deref, o.rsfx[c][i64(e.lo)..<i64(e.hi)], false)
                    h = handle_of(o, ub)
                    if h < 0: h = uof(o, ub)
                    if h < 0: h = handle_of(o, b)
                    if h < 0: h = uof(o, b)
                else: h = handle_of(o, mapped(o, b, deref, o.rsfx[c][i64(e.lo)..<i64(e.hi)], false))
                if h < 0: continue
                if fresh: mint(o, s, dv, NONE, false)
                fresh = false
                set(s, points(o, dv, h), true)
                if o.vsp[dv] == NONE: o.vsp[dv] = arg_expr(o, i, e.j)
                if e.verb == A_PLACED: o.vrec[dv] = b
            // A view read through `j^` and placed in no slot: anywhere under
            // what the argument points at (Rust's level-1 roots).
            for j in 0..<#len(xs):
                if j >= 64 || (o.rrets1[callee] >> u64(j)) & 1 == 0 || placed_for(o, c, u32(j)): continue
                bool deref = false
                u32 b = arg_base(o, xs[j], &deref)
                if b == NONE: continue
                u32 bt = pointee(o, f.place_ty[b]) if deref else f.place_ty[b]
                if !view_reaches(o, f.place_ty[d], bt): continue
                i64 h = handle_of(o, b) if !deref else -1
                if h < 0: h = uof(o, b)
                if h < 0: continue
                if fresh: mint(o, s, dv, NONE, false)
                fresh = false
                set(s, points(o, dv, h), true)
                if o.vsp[dv] == NONE: o.vsp[dv] = arg_expr(o, i, u32(j))
        for j in 0..<#len(xs):
            i64 kh = handle_of(o, xs[j]) if bare(o, xs[j]) else -1
            if kh < 0 || j >= 64 || (o.rfrees[callee] >> u64(j)) & 1 == 0: continue
            set(s, killed(o, kh), true)
            if o.killed_at[kh] == NONE: o.killed_at[kh] = i
        for j in 0..<#len(xs):
            i64 h = handle_of(o, xs[j])
            if h < 0 || !bare(o, xs[j]) || j >= 64 || (o.rgrows[callee] >> u64(j)) & 1 == 0: continue
            set(s, handed(o, h), true)
            if o.handed_at[h] == NONE: o.handed_at[h] = i
        return
    if op == ir.O_RETURN:
        i64 rv = -1
        if bare(o, f.a[i]): rv = view_of(o, f.a[i])
        if rv >= 0 && is_view(&o.w.t, f.slot_ty[f.root[f.a[i]]]): answers(o, rv, f.a[i], s)
        for h in 0..<o.nh:
            u32 hp = o.hplace[h]
            if rv >= 0 && has(s, points(o, rv, h)) && (f.root[hp] & ir.ROOT_GLOBAL) != 0 && f.plo[hp] == f.phi[hp]: add_g(o, o.cur, gkey(f, f.root[hp]), f.glob_ty[f.root[hp] & ~ir.ROOT_GLOBAL], 0, G_ANS)
        escapes(o, fl, i, s)
        leave(o, fl, s, f.a[i], i)

// Call `i` keeps a copy of what argument `j` points at: ERR0826 when that
// holds a view of this frame, WRN0826 when it may.
private void copy_kept(^Own o, ^ref []u64 s, u32 i, u32 j, []u32 xs):
    ^ir.Fn f = o.f
    i64 a = frame_in(o, s, xs[j], 0)
    if a < 0: return
    string8 cn = callee_name(o, f.ref_name[f.a[i]])
    string8 fname = callee_name(o, f.name)
    u32 an = arg_node(o, i, j, u32(#len(xs)))
    for k in 0..<o.nk:
        if !has(s, inside(o, a, k)): continue
        string8 x = slot(o, o.fslot[k])
        say(o, an, 826, index.hold(#format("`", cn, "` keeps a copy of this value in package storage, which outlives every frame, and the copy points at `", x, "`, which is stored on `", fname, "`'s frame")), index.hold(#format("allocate `", x, "` with `#new`/`#make` so it outlives `", fname, "`, or have `", cn, "` copy what the value's views read")))
        return
    for k in 0..<o.nk:
        bool may = o.loose_addr[a] && o.loose_store[k]
        for m in o.mayin:
            if m == (u64(a) << 32) | u64(k): may = true
        if !may: continue
        string8 x = slot(o, o.fslot[k])
        string8 b = slot(o, o.fslot[a])
        say(o, an, diag.WRN + 826, index.hold(#format("`", cn, "` keeps a copy of `", b, "`, which may point at `", x, "` on `", fname, "`'s frame\x1f`", b, "` was handed to a call, or written through a pointer, that the compiler cannot follow, so it may hold a view of `", x, "`, and `", cn, "` keeps the copy in package storage, which outlives every frame. This is possible, not certain: the program builds\x1eallocate `", x, "` with `#new`/`#make`, or keep its view out of `", b, "`")), "")
        return

// A store: a pointer to this frame through a parameter (ERR0826), or into
// a block a handle here owns (the handle then holds the frame).
private void stored(^Own o, ^Flow fl, u32 i, ^ref []u64 s):
    ^ir.Fn f = o.f
    u32 d = f.dst[i]
    holds(o, s, d, f.a[i], i)
    if (f.root[d] & ir.ROOT_GLOBAL) != 0:
        expose(o, s, f.a[i], i)
    u32 sm = stack_of(o, s, f.a[i])
    if sm != NONE && (f.root[d] & ir.ROOT_GLOBAL) == 0:
        u32 pr = through(o, d)
        if pr != NONE && fl.report && !o.quiet:
            syntax.Ast a = o.w.p.files[f.file].a
            u32 pn = f.node[i]
            if a.tag[pn] == syntax.S_ASSIGN: pn = a.list(a.b[pn])[0]
            stack_out(o, pn, pr, sm)
    bool loaded = false
    bool held_ = (f.root[d] & ir.ROOT_GLOBAL) != 0 || is_handle(&o.w.t, f.slot_ty[f.root[d]])
    for j in f.plo[d]..<f.phi[d]:
        if f.step[j] == ir.ST_DEREF && j > f.plo[d] && held_: loaded = true
    if loaded && fl.report && !o.quiet:
        i64 lk = frame_in(o, s, f.a[i], 0)
        if lk >= 0:
            syntax.Ast la = o.w.p.files[f.file].a
            u32 ln = f.node[i]
            if la.tag[ln] == syntax.S_ASSIGN: ln = la.list(la.b[ln])[0]
            string8 lt = text(o, ln)
            if #len(lt) > 0 && lt[#len(lt) - 1] == '^': lt = lt[0..<#len(lt) - 1]
            string8 lx = slot(o, o.fslot[lk])
            string8 lf = callee_name(o, f.name)
            say(o, ln, 826, index.hold(#format("this stores a pointer to `", lx, "`, on `", lf, "`'s frame, through `", lt, "`, read from storage that may outlive it")), index.hold(#format("allocate `", lx, "` with `#new`/`#make` so it outlives `", lf, "`, or store it only where `", lf, "` owns the storage")))
            return
    i64 v = view_of(o, f.a[i])
    if v < 0: return
    i64 k = -1
    for x in 0..<o.nk:
        if has(s, frame(o, v, x)) && k < 0: k = x
    if k < 0: return
    if (f.root[d] & ir.ROOT_GLOBAL) != 0:
        if !fl.report || o.quiet: return
        syntax.Ast ga = o.w.p.files[f.file].a
        u32 gn = f.node[i]
        if ga.tag[gn] == syntax.S_ASSIGN: gn = ga.list(ga.b[gn])[0]
        string8 gx = slot(o, o.fslot[k])
        string8 gf = callee_name(o, f.name)
        say(o, gn, 826, index.hold(#format("this stores a pointer to `", gx, "`, which is stored on `", gf, "`'s frame, into the package-level variable `", text(o, gn), "`, which outlives every frame")), index.hold(#format("hold `", gx, "` where `", text(o, gn), "` lives — declare it in the caller and pass a `^` down — or allocate it with `#new`/`#make` on the ambient allocator so it outlives `", gf, "`")))
        return
    i64 h = under(o, d)
    if h >= 0 && !bare(o, d):
        set(s, held(o, h, k), true)
        return
    bool deref = false
    for j in f.plo[d]..<f.phi[d]:
        if f.step[j] == ir.ST_DEREF: deref = true
    u32 r = f.root[d]
    u32 pr = r if r < f.params else o.alias[r]
    if !deref || pr == NONE || !fl.report || o.quiet: return
    syntax.Ast a = o.w.p.files[f.file].a
    u32 pn = f.node[i]
    if a.tag[pn] == syntax.S_ASSIGN: pn = a.list(a.b[pn])[0]
    string8 x = slot(o, o.fslot[k])
    string8 fname = callee_name(o, f.name)
    say(o, pn, 826, index.hold(#format("this stores a pointer to `", x, "`, which is stored on `", fname, "`'s frame, through the parameter `", slot(o, pr), "`, so the caller holds it after `", fname, "` has returned")), index.hold(#format("hold `", x, "` where `", text(o, pn), "` lives — declare it in the caller and pass a `^` down — or allocate it with `#new`/`#make` on the ambient allocator so it outlives `", fname, "`")))

// A store of `x` into place `d`: frame slots `d` reaches now hold the frame
// views `x` carries.
private void holds(^Own o, ^ref []u64 s, u32 d, u32 x, u32 i):
    ^ir.Fn f = o.f
    if o.nk == 0 || d == NONE || ir.is_const(d) || (f.root[d] & ir.ROOT_GLOBAL) != 0: return
    i64 k = frame_in(o, s, x, 0)
    if f.plo[d] == f.phi[d] || f.step[f.plo[d]] != ir.ST_DEREF:
        for j in f.plo[d]..<f.phi[d]:
            if f.step[j] == ir.ST_DEREF: return
        u32 a = o.fk[f.root[d]]
        if a == NONE: return
        if f.plo[d] == f.phi[d]:
            for q in 0..<o.nk:
                set(s, inside(o, i64(a), q), false)
        if k >= 0: set(s, inside(o, i64(a), k), true)
        return
    if k < 0: return
    i64 v = view_of(o, d)
    u32 r = f.root[d]
    if o.pt2[r] != NONE && f.phi[d] - f.plo[d] >= 2 && f.step[f.plo[d] + 1] == ir.ST_DEREF: v = i64(o.vi[o.pt2[r]])
    if v < 0: return
    bool known = false
    for a in 0..<o.nk:
        if !has(s, frame(o, v, a)): continue
        set(s, inside(o, a, k), true)
        known = true
    for h in 0..<o.nh:
        if has(s, points(o, v, h)): known = true
    if !known && r >= f.params && o.alias[r] == NONE: o.loose_store[k] = true

// The parameter a store into place `d` goes through, or NONE.
private u32 through(^Own o, u32 d):
    ^ir.Fn f = o.f
    bool deref = false
    for j in f.plo[d]..<f.phi[d]:
        if f.step[j] == ir.ST_DEREF: deref = true
    u32 r = f.root[d]
    if !deref: return NONE
    return r if r < f.params else o.alias[r]

// The `#stack` mint operand `x` holds or points into, or NONE.
private u32 stack_of(^Own o, ^ref []u64 s, u32 x):
    ^ir.Fn f = o.f
    if x == NONE || ir.is_const(x): return NONE
    i64 h = handle_of(o, x)
    if h >= 0 && o.stack_at[h] != NONE: return o.stack_at[h]
    i64 v = view_of(o, x)
    for k in 0..<o.nh:
        if o.stack_at[k] != NONE && v >= 0 && has(s, points(o, v, k)): return o.stack_at[k]
    u32 m = origin(o, x)
    if m == NONE || f.op[m] != ir.O_ADDR && f.op[m] != ir.O_VIEW || (f.root[f.a[m]] & ir.ROOT_GLOBAL) != 0: return NONE
    i64 sh = slot_handle(o, f.root[f.a[m]])
    return o.stack_at[sh] if sh >= 0 else NONE

private void stack_out(^Own o, u32 n, u32 pr, u32 sm):
    string8 fname = callee_name(o, o.f.name)
    say(o, n, 821, index.hold(#format("this stores storage `#stack` put on this frame through the parameter `", slot(o, pr), "`, so the caller holds it after `", fname, "` has returned", "\x1f`#stack` lowers to a C99 compound literal, which lives until the end of the **block** that wrote it — a suite such as `if:` or `for:` ends a block while the frame goes on")), "allocate what has to outlive the block with `#new`/`#make` on the ambient allocator, or declare the binding inside the block that mints the storage")
    label(o, o.f.node[sm], "`#stack` storage minted here")

// A read through pointer place `p` (`p.a`, `p^`): its block may have moved.
private void through_read(^Own o, ^Flow fl, u32 i, u32 p, ^ref []u64 s, bool right):
    ^ir.Fn f = o.f
    if p == NONE || ir.is_const(p) || f.plo[p] == f.phi[p] || view_of(o, p) < 0: return
    syntax.Ast a = o.w.p.files[f.file].a
    u32 n = f.node[i]
    // An element read with no check (a walk's `s[i]`): the name walked.
    if f.step[f.plo[p]] == ir.ST_INDEX && is_view(&o.w.t, f.slot_ty[f.root[p]]) && (f.slot_flags[f.root[p]] & ir.S_USER) != 0:
        u32 nn = name_in(o, n, slot(o, f.root[p]))
        if nn == NONE: nn = name_after(o, n, slot(o, f.root[p]))
        read(o, fl, i, p, s, nn if nn != NONE else n)
        return
    if f.step[f.plo[p]] != ir.ST_DEREF: return
    if a.tag[n] == syntax.S_RETURN: n = a.a[n]
    if n != NONE && a.tag[n] == syntax.E_BINARY: n = a.b[n] if right else a.a[n]
    for _ in 0..<8:
        if n == NONE || a.tag[n] != syntax.E_FIELD && a.tag[n] != syntax.E_DEREF: break
        n = a.a[n]
    read(o, fl, i, p, s, n)

// A bare view's value read by op `i` (`s == "="`, `c = s`).
private void value_read(^Own o, ^Flow fl, u32 i, u32 p, ^ref []u64 s, bool right):
    ^ir.Fn f = o.f
    if p == NONE || ir.is_const(p) || !bare(o, p) || view_of(o, p) < 0 || !is_view(&o.w.t, f.place_ty[p]): return
    syntax.Ast a = o.w.p.files[f.file].a
    u32 n = f.node[i]
    if n != NONE && a.tag[n] == syntax.S_RETURN: n = a.a[n]
    if n != NONE && a.tag[n] == syntax.E_BINARY: n = a.b[n] if right else a.a[n]
    if f.op[i] == ir.O_SET || f.op[i] == ir.O_CONV:
        u32 nn = name_in(o, n, slot(o, f.root[p]))
        if nn != NONE: n = nn
    read(o, fl, i, p, s, n)

// The first name `nm` after node `n` in this body (`for ch in s`), or NONE.
private u32 name_after(^Own o, u32 n, string8 nm):
    if n == NONE: return NONE
    syntax.Ast a = o.w.p.files[o.f.file].a
    u32 best = NONE
    for x in 0..<u32(#len(a.tag)):
        if a.tag[x] != syntax.E_NAME || a.lo[x] <= a.lo[n] || a.hi[x] > a.hi[o.f.item]: continue
        if best != NONE && a.lo[x] >= a.lo[best]: continue
        if text(o, x) == nm: best = x
    return best

// The first name `nm` under node `n`, or NONE.
private u32 name_in(^Own o, u32 n, string8 nm):
    if n == NONE: return NONE
    syntax.Ast a = o.w.p.files[o.f.file].a
    if a.tag[n] == syntax.E_NAME && text(o, n) == nm: return n
    ref []u32 ks
    a.kids(n, &ks)
    for k in ks:
        if k == NONE: continue
        u32 r = name_in(o, k, nm)
        if r != NONE:
            #delete(ks)
            return r
    #delete(ks)
    return NONE

// ERR0826: a read through view place `p` into a frame slot whose block ended.
private void dead_read(^Own o, ^Flow fl, u32 i, u32 p, ^ref []u64 s):
    ^ir.Fn f = o.f
    if p == NONE || ir.is_const(p) || f.plo[p] == f.phi[p] || f.step[f.plo[p]] != ir.ST_DEREF || !fl.report || o.quiet: return
    i64 v = view_of(o, p)
    if v < 0: return
    for k in 0..<o.nk:
        if !has(s, frame(o, v, k)) || !has(s, ended(o, k)): continue
        syntax.Ast a = o.w.p.files[f.file].a
        u32 n = f.node[i]
        if a.tag[n] == syntax.S_RETURN: n = a.a[n]
        if a.tag[n] == syntax.E_DEREF: n = a.a[n]
        u32 dn = f.slot_node[o.fslot[k]]
        check.Where at = check.where(o.w, f.file, f.item, dn)
        string8 x = slot(o, o.fslot[k])
        string8 pn = slot(o, f.root[p])
        say(o, n, 826, index.hold(#format("`", pn, "` points at `", x, "`, which was declared in a block that ended at ", at.line, ":", at.col, " — its storage is gone, so this reads through a pointer into a dead frame")), index.hold(#format("declare `", x, "` in the block that reads `", pn, "` (outside the loop or suite), or finish with `", pn, "` inside the block that declares `", x, "`")))
        label(o, dn, index.hold(#format("`", x, "`'s block ends here")))
        set(s, ended(o, k), false)
        return

// ERR0826: a view of this frame appended to a run reached through a parameter.
private void appended(^Own o, ^Flow fl, u32 i, ^ref []u64 s):
    ^ir.Fn f = o.f
    []u32 xs = ir.args(f, i)
    if #len(xs) >= 2 && !ir.is_const(xs[0]) && (f.root[xs[0]] & ir.ROOT_GLOBAL) != 0:
        for x in xs[1..<#len(xs)]:
            expose(o, s, x, i)
    // A splat copies the elements, not the run (Rust's).
    if #len(xs) < 2 || !fl.report || o.quiet || ir.is_const(xs[0]) || (f.root[xs[0]] & ir.ROOT_GLOBAL) != 0 || f.c[i] == 1: return
    bool deref = false
    for j in f.plo[xs[0]]..<f.phi[xs[0]]:
        if f.step[j] == ir.ST_DEREF: deref = true
    u32 r = f.root[xs[0]]
    u32 pr = r if r < f.params else o.alias[r]
    if !deref || pr == NONE: return
    for x in xs[1..<#len(xs)]:
        u32 sm = stack_of(o, s, x)
        if sm != NONE:
            syntax.Ast sa = o.w.p.files[f.file].a
            u32 sn = sa.list(sa.b[f.node[i]])[2]
            if sa.tag[sn] == syntax.E_ARG: sn = sa.a[sn]
            stack_out(o, sn, pr, sm)
            return
        i64 v = view_of(o, x)
        if v < 0: continue
        for k in 0..<o.nk:
            if !has(s, frame(o, v, k)): continue
            syntax.Ast a = o.w.p.files[f.file].a
            u32 an = a.list(a.b[f.node[i]])[2]
            if a.tag[an] == syntax.E_ARG: an = a.a[an]
            string8 nm = slot(o, o.fslot[k])
            string8 fname = callee_name(o, f.name)
            say(o, an, 826, index.hold(#format("this appends a pointer to `", nm, "`, which is stored on `", fname, "`'s frame, through the parameter `", slot(o, pr), "`, so the caller holds it after `", fname, "` has returned")), index.hold(#format("hold `", nm, "` where `", text(o, an), "` lives — declare it in the caller and pass a `^` down — or allocate it with `#new`/`#make` on the ambient allocator so it outlives `", fname, "`")))
            return

// ERR0826 at a `return` whose value points at this frame's storage.
private void escapes(^Own o, ^Flow fl, u32 i, ^ref []u64 s):
    ^ir.Fn f = o.f
    u32 r = f.a[i]
    if r == NONE || !fl.report || o.quiet: return
    syntax.Ast a = o.w.p.files[f.file].a
    u32 n = a.a[f.node[i]] if a.tag[f.node[i]] == syntax.S_RETURN else f.node[i]
    string8 fname = callee_name(o, f.name)
    // A window in a returned tuple's slot escapes with the tuple.
    if a.tag[n] == syntax.E_TUPLE:
        for el in a.list(a.b[n]):
            u32 wb = a.list(a.b[el])[0] if a.tag[el] == syntax.E_SLICE else NONE
            if wb == NONE || a.tag[wb] != syntax.E_NAME: continue
            string8 wx = o.w.p.spell(f.file, wb)
            for k in 0..<o.nk:
                if slot(o, o.fslot[k]) != wx: continue
                say(o, el, 826, index.hold(#format("`", fname, "` returns ", check.shown(o.w, f.slot_ty[f.root[r]]), ", and `", wx, "` is an array whose storage is on **`", fname, "`'s own frame** — that frame is gone by the time the caller reads through the window")), "return something that owns the elements — a `ref([]T)` from `make` — or window storage the caller already has")
                return
    if !bare(o, r): return
    i64 v = view_of(o, r)
    i64 h = handle_of(o, r)
    for m in 0..<o.nm:
        if v < 0 || o.mv_verb[m] != ir.MV_FREE || o.mv_h[m] == NONE || !has(s, moved(o, v, m)) || !in_defer(o, f.node[o.moves[m]]): continue
        string8 hn = spell(o, o.hplace[o.mv_h[m]])
        check.Where at = check.where(o.w, f.file, f.item, f.node[o.moves[m]])
        string8 what = "a copy of the handle to" if is_handle(&o.w.t, f.slot_ty[f.root[r]]) else "a view into"
        string8 help = index.hold(#format("return the `ref` itself, so the caller owns the block and frees it, or copy what you return out of `", hn, "` before the `defer` runs"))
        if is_handle(&o.w.t, f.slot_ty[f.root[r]]): help = index.hold(#format("a returned `ref` belongs to the caller: drop the `defer` that frees `", hn, "`, or free it only on the paths that do not return it"))
        say(o, n, diag.WRN + 803, index.hold(#format("`", fname, "` returns ", what, " the block under `", hn, "`, and a `defer` pending at this `return` — freeing `", hn, "` at ", at.line, ":", at.col, " — runs before the caller reads it, so the caller receives a pointer that may dangle")), help)
        label(o, f.node[o.moves[m]], index.hold(#format("`", hn, "` may move here, after the `return`")))
        return
    if reset_out(o, i, r, n, fname): return
    for x in 0..<o.nh:
        if o.stack_at[x] == NONE || x != h && (v < 0 || !has(s, points(o, v, x))): continue
        u32 mk = f.node[o.stack_at[x]]
        check.Where at = check.where(o.w, f.file, f.item, mk)
        say(o, n, 821, index.hold(#format("`", fname, "` returns storage `#stack` put on its own frame at ", at.line, ":", at.col, ", and that frame is gone by the time the caller reads it", "\x1f`#stack` lowers to a C99 compound literal, which lives until the end of the block that wrote it")), "return something that owns its storage — `#new`/`#make` on the ambient allocator, or `#return` — or let the caller own the storage and pass it down")
        label(o, mk, "`#stack` storage minted here")
        return
    for k in 0..<o.nk:
        string8 x = slot(o, o.fslot[k])
        if h >= 0 && has(s, held(o, h, k)):
            say(o, n, 826, index.hold(#format("`", fname, "` returns `", text(o, n), "`, whose block holds a pointer to `", x, "`, and `", x, "` is stored on `", fname, "`'s own frame — that frame is gone by the time the caller reads through the pointer")), index.hold(#format("store `", x, "` itself in the block rather than its address, or allocate `", x, "` with `#new`/`#make` on the ambient allocator so it outlives `", fname, "`")))
            return
        if v < 0 || !has(s, frame(o, v, k)): continue
        if check.is_trait(o.w, f.place_ty[r]) && (f.slot_flags[f.root[r]] & ir.S_USER) == 0 && a.tag[n] != syntax.E_CALL:
            u32 im = f.slot_ty[o.fslot[k]]
            string8 tn = check.name_of(o.w, o.w.decls[check.trait_decl(o.w, f.place_ty[r])].name)
            string8 imn = check.named(o.w, im)
            if (f.slot_flags[o.fslot[k]] & ir.S_RECEIVER) != 0:
                say(o, n, 826, index.hold(#format("`", fname, "` returns a `", tn, "` viewing `", x, "`, which is stored on `", fname, "`'s own frame — that frame is gone by the time the caller calls through the pair")), index.hold(#format("take `^self` in `", fname[strings.last_index_of(fname, '.') + 1..<#len(fname)], "` and return `self`, which then points at the caller's `", imn, "` rather than at this call's copy of it")))
                return
            say(o, n, 826, index.hold(#format("`", fname, "` returns a `", tn, "` viewing `", x, "`, which is stored on `", fname, "`'s own frame — that frame is gone by the time the caller calls through the pair")), index.hold(#format("return a pair of an implementer the caller can still reach: take it by pointer — `^", imn, " p` — and return `p`, or store it where it outlives the call")))
            return
        u32 wn = n
        if a.tag[n] == syntax.E_COND:
            for arm in [a.list(a.b[n])[0], a.list(a.b[n])[2]]:
                u32 rt = a.list(a.b[arm])[0] if a.tag[arm] == syntax.E_SLICE else NONE
                if rt != NONE && a.tag[rt] == syntax.E_NAME && o.w.p.spell(f.file, rt) == x: wn = arm
        u32 wb = a.list(a.b[wn])[0] if a.tag[wn] == syntax.E_SLICE else NONE
        string8 wfs = o.w.p.spell(f.file, wb) if wb != NONE else ""
        if wb != NONE && a.tag[wb] == syntax.E_FIELD && (f.slot_flags[o.fslot[k]] & ir.S_TEMP) != 0 && #len(wfs) > 1:
            say(o, wn, 826, index.hold(#format("`", fname, "` returns ", check.shown(o.w, f.slot_ty[f.root[r]]), ", and `", o.w.p.spell(f.file, wb), "` is several axes, so the window addresses a value built on **`", fname, "`'s own frame** — that frame is gone by the time the caller reads through the window")), "return something that owns the elements — a `ref([]T)` from `make` — or window storage the caller already has")
            return
        if a.tag[wn] == syntax.E_SLICE:
            say(o, wn, 826, index.hold(#format("`", fname, "` returns ", check.shown(o.w, f.slot_ty[f.root[r]]), ", and `", x, "` is an array whose storage is on **`", fname, "`'s own frame** — that frame is gone by the time the caller reads through the window")), "return something that owns the elements — a `ref([]T)` from `make` — or window storage the caller already has")
            return
        string8 how = ", handed back through the call" if a.tag[n] == syntax.E_CALL else ""
        say(o, n, 826, index.hold(#format("`", fname, "` returns a pointer to `", x, "`", how, ", and `", x, "` is stored on `", fname, "`'s own frame — that frame is gone by the time the caller reads through it")), index.hold(#format("return the value itself rather than a pointer to it, or let the caller own the storage and pass a `^` down; storage that must outlive `", fname, "` comes from `#new`/`#make` on the ambient allocator")))
        return

// The handles operand `x` was copied from, through temps and tuples.
private void sources(^Own o, u32 x, ^ref []i64 hs, i64 depth):
    ^ir.Fn f = o.f
    if !bare(o, x) || (f.root[x] & ir.ROOT_GLOBAL) != 0 || depth > 16: return
    hs^ = #append(hs^, handle_of(o, x))
    u32 m = o.def[f.root[x]]
    if m == NONE: return
    if f.op[m] == ir.O_SET: sources(o, f.a[m], hs, depth + 1)
    if f.op[m] == ir.O_MAKE:
        for y in ir.args(f, m):
            sources(o, y, hs, depth + 1)

// WRN0803: `return r` hands back a handle an arena minted, and a pending
// `defer` resets or destroys that arena.
private bool reset_out(^Own o, u32 i, u32 r, u32 n, string8 fname):
    ^ir.Fn f = o.f
    ref []i64 hs
    sources(o, r, &hs, 0)
    syntax.Ast a = o.w.p.files[f.file].a
    for k in 0..<o.nm:
        if o.mv_verb[k] != ir.MV_RESET || o.mv_h[k] == NONE || !in_defer(o, f.node[o.moves[k]]): continue
        bool hit = false
        for h in hs:
            if h >= 0 && h == i64(o.mv_h[k]): hit = true
        if !hit: continue
        u32 rc = f.node[o.moves[k]]
        u32 arg = a.list(a.b[rc])[2]
        if a.tag[arg] == syntax.E_ARG: arg = a.a[arg]
        string8 ar = text(o, a.a[arg])
        bool gone = text(o, a.list(a.b[rc])[0]) == "arena.destroy"
        string8 verb = "destroying" if gone else "resetting"
        string8 rt = text(o, n)
        check.Where at = check.where(o.w, f.file, f.item, rc)
        string8 help = index.hold(#format("reset `", ar, "` after the last use of what it minted, or mint `", rt, "` on an allocator that outlives the reset"))
        if gone: help = index.hold(#format("destroy after the last use — `defer arena.destroy(&", ar, ")` where `", ar, "` is declared — or mint `", rt, "` on an allocator that outlives the arena"))
        say(o, n, diag.WRN + 803, index.hold(#format("`", fname, "` returns `", rt, "`, which was minted by arena `", ar, "`, and ", verb, " `", ar, "` at ", at.line, ":", at.col, " — in a `defer` pending at this `return` — takes that memory back before the caller reads it")), help)
        label(o, rc, "the memory is taken back here, after the `return`")
        #delete(hs)
        return true
    #delete(hs)
    return false

// A move of the block under a handle: each view into it may now dangle, a
// walk over it is broken, a grown parameter noted.
private void moving(^Own o, ^Flow fl, u32 i, ^ref []u64 s, i64 m):
    ^ir.Fn f = o.f
    if m < 0 || m >= o.nm: return
    if o.mv_h[m] != NONE:
        moved_h(o, fl, i, s, m, i64(o.mv_h[m]))
        return
    u32 p = f.a[i]
    // Only `p^` itself: a handle inside what `p` points at is no handle it views.
    if f.op[i] != ir.O_MOVE || p == NONE || ir.is_const(p) || f.phi[p] != f.plo[p] + 1 || f.step[f.plo[p]] != ir.ST_DEREF: return
    i64 pv = view_of(o, p)
    if pv < 0: return
    for k in 0..<o.nh:
        if has(s, points(o, pv, k)): moved_h(o, fl, i, s, m, k)

private void moved_h(^Own o, ^Flow fl, u32 i, ^ref []u64 s, i64 m, i64 h):
    ^ir.Fn f = o.f
    u8 verb = o.mv_verb[m]
    if verb == ir.MV_REBIND:
        for k in 0..<o.nk:
            set(s, held(o, h, k), false)
    // The handles whose views this move reaches: `h`, the under-handles
    // above it, and handles copied from it.
    ref []i64 ks
    ks = #append(ks, h)
    u32 uu = o.up[h]
    for uu != NONE:
        ks = #append(ks, i64(uu))
        uu = o.up[uu]
    for k in 0..<o.nh:
        i64 kv = o.hvw[k]
        if k != h && kv >= 0 && has(s, points(o, kv, h)) && !has_i64(&ks, k): ks = #append(ks, k)
    // A walk over the handle (not through a callee: the walk re-reads it),
    // or over a view into it.
    if fl.report && !o.quiet:
        for li in 0..<#len(fl.heads):
            u32 hd = fl.heads[li]
            if f.op[hd] != ir.O_LOOP || f.b[hd] == NONE: continue
            if f.op[i] == ir.O_MOVE && handle_of(o, f.b[hd]) == h && next_step(o, fl, i, li): walked(o, i, hd, "", spell(o, o.hplace[h]), verb)
            else if bare(o, f.b[hd]) && handle_of(o, f.b[hd]) < 0 && view_of(o, f.b[hd]) >= 0 && next_step(o, fl, i, li):
                bool hit = false
                for k in ks:
                    if has(s, points(o, view_of(o, f.b[hd]), k)): hit = true
                if hit: walked(o, i, hd, text(o, f.c[hd]), move_text(o, u32(m)), verb)
    if verb == ir.MV_FREE && has(s, handed(o, h)) && fl.report && !o.quiet: handed_read(o, h, i)
    if f.op[i] == ir.O_MOVE && verb != ir.MV_REBIND && has(s, killed(o, h)) && fl.report && !o.quiet: killed_read(o, h, i)
    if verb == ir.MV_REBIND: set(s, killed(o, h), false)
    if verb == ir.MV_FREE && f.op[i] == ir.O_MOVE && o.f.root[o.hplace[h]] < o.f.params && bare(o, o.hplace[h]): set(s, killed(o, h), true)
    if verb == ir.MV_REBIND: set(s, exposed(o, h), false)
    else if f.op[i] == ir.O_MOVE && fl.report && !o.quiet:
        // The outermost exposed block over the moved handle.
        i64 eh = -1
        i64 k = h
        for k >= 0:
            if held_site(o, s, k, f.place_ty[f.a[i]], verb != ir.MV_APPEND && verb != ir.MV_INSERT) != NONE && !has(s, afresh(o, k)): eh = k
            k = -1 if o.up[k] == NONE else i64(o.up[k])
        if eh >= 0: say_exposed(o, f.node[i], verb, spell(o, f.a[i]), eh, held_site(o, s, eh, f.place_ty[f.a[i]], verb != ir.MV_APPEND && verb != ir.MV_INSERT))
    i64 hv = view_of(o, o.hplace[h]) if bare(o, o.hplace[h]) else -1
    if verb == ir.MV_FREE && f.op[i] == ir.O_MOVE && hv >= 0 && has(s, freed(o, hv)): read(o, fl, i, o.hplace[h], s)
    u32 hrec = rec_place(o, o.hplace[h])
    u32 mt = f.place_ty[o.hplace[h]]
    bool deep = verb != ir.MV_APPEND && verb != ir.MV_INSERT
    for v in 0..<o.nv:
        bool hit = false
        for k in ks:
            if has(s, points(o, v, k)): hit = true
        if !hit && hrec != NONE && (f.slot_flags[o.vslot[v]] & ir.S_USER) != 0: hit = slot_hit(o, s, v, h, hrec)
        // A view of a type that cannot point into `h`'s block (or, `deep`,
        // a block under it) is not moved (P10h).
        if hit && !moves_view(o, f.slot_ty[o.vslot[v]], m, mt, deep): hit = false
        if !hit: continue
        set(s, moved(o, v, m), true)
        // A callee's free through a `^` parameter is no must (Rust's).
        bool sure = f.op[i] == ir.O_MOVE || (f.root[o.hplace[h]] & ir.ROOT_GLOBAL) != 0 || f.root[o.hplace[h]] >= f.params && o.alias[f.root[o.hplace[h]]] == NONE
        if verb == ir.MV_FREE && !o.vholds[v] && sure: set(s, freed(o, v), true)
    #delete(ks)
    if f.op[i] == ir.O_MOVE && (verb == ir.MV_APPEND || verb == ir.MV_RESIZE):
        if (f.root[f.a[i]] & ir.ROOT_GLOBAL) == 0 && (f.slot_flags[f.root[f.a[i]]] & ir.S_PARAM) != 0:
            set(s, grown(o, h), true)
            if o.grown_at[h] == NONE: o.grown_at[h] = i
    if verb == ir.MV_FREE || verb == ir.MV_REBIND: set(s, handed(o, h), false)

// A way out of the body (`r`: what it answers): LNT0830 for each `ref`
// parameter grown and not answered.
private void leave(^Own o, ^Flow fl, ^ref []u64 s, u32 r, u32 at):
    ^ir.Fn f = o.f
    o.leaves += 1
    u64 fr = 0
    for sl in 0..<f.params:
        i64 h = slot_handle(o, sl)
        if h >= 0 && sl < 64 && has(s, killed(o, h)): fr = fr | (u64(1) << u64(sl))
    o.now_frees = o.now_frees & fr
    for sl in 0..<f.params:
        i64 h = slot_handle(o, sl)
        if h < 0 || !has(s, grown(o, h)): continue
        if r != NONE && !ir.is_const(r) && (f.root[r] == sl || regrown(f, r, sl)): continue
        if stored_out(f, sl): continue
        o.now = o.now | (u64(1) << u64(sl))
        if !fl.report || o.quiet: continue
        u32 g = o.grown_at[h]
        string8 fname = callee_name(o, f.name)
        string8 pn = slot(o, sl)
        string8 held = ""
        // Grown into another local: that one is what to answer.
        u32 gi = grown_into(f, g, sl)
        if gi != NONE:
            pn = slot(o, gi)
            held = index.hold(#format(" (held in `", pn, "`)"))
        say(o, f.b[g], diag.LNT + 830, index.hold(#format("`", fname, "` grows a `ref` parameter here", held, " and, on some way out, neither answers nor keeps it: the caller's handle is stale, the block lost")), index.hold(#format("answer it — `return ", pn, "`, the caller writing `xs = ", fname, "(xs, …)` — or take a `^ref []T` and grow `p^` in place")))
        if at != NONE: label(o, f.node[at], index.hold(#format("`", fname, "` leaves here without answering or keeping `", pn, "`")))

// Whether op `i` may reach the next step of the loop at `fl.heads[li]`
// (no `break` out of it or `return` on every way on).
private bool next_step(^Own o, ^Flow fl, u32 i, i64 li):
    ^ir.Fn f = o.f
    u32 pos = i + 1
    i64 l = #len(fl.heads) - 1
    for l >= li:
        u32 hd = fl.heads[l]
        u32 end = hd + 1 + ir.span(f, hd)
        if f.op[hd] == ir.O_IF && i < hd + 1 + f.b[hd]: end = hd + 1 + f.b[hd]
        u32 j = pos
        for j < end:
            u8 op = f.op[j]
            if op == ir.O_RETURN || op == ir.O_RETURN_FAIL || op == ir.O_QUIT: return false
            if op == ir.O_BREAK && l - i64(f.a[j]) <= li: return false
            if op == ir.O_CONTINUE || op == ir.O_BREAK: return true
            j += 1 + ir.span(f, j)
        pos = hd + 1 + ir.span(f, hd)
        l -= 1
    return true

private const [9]string8 GERUND = ("freeing", "appending to", "resizing", "rebinding", "inserting into", "deleting from", "`#send`ing", "draining", "resetting")
private const [9]string8 WALK_HELP = ("Move the `delete` after the loop, which is what a `defer` at the point of allocation already does", "Collect what you want into a second run and apply it after the loop, or walk a count and index instead", "Collect what you want into a second run and apply it after the loop, or walk a count and index instead", "Bind the new run to a second name and swap after the loop", "", "", "Make the `#send` after the loop, once the walk is done with the block", "", "")

// `sv`: the view the loop walks, when not the handle itself.
private void walked(^Own o, u32 i, u32 hd, string8 sv, string8 h, u8 v):
    ^ir.Fn f = o.f
    if f.op[i] == ir.O_MOVE && check.is_map(o.w, f.place_ty[f.a[i]]):
        bool del = v == ir.MV_FREE || v == ir.MV_REMOVE
        say(o, f.node[i], 820, index.hold(#format("`", h, "` is the map this loop is walking, and ", "deleting from" if del else "assigning to", " it here is not something the loop can survive")), "collect what you want to change into a `[]` first and apply it after the loop, or write to a second map")
        label(o, f.c[hd], "the walk reads this again on its next step")
        return
    string8 gv = GERUND[v]
    if v == ir.MV_RESIZE && reserving(o, f.node[i]): gv = "reserving room in"
    if !once(o, f.node[i]): return
    if #len(sv) > 0: say(o, f.node[i], diag.WRN + 803, index.hold(#format("this loop is walking `", sv, "`, which reads the block under `", h, "`, and ", gv, " `", h, "` here is not something the loop can survive")), WALK_HELP[v])
    else: say(o, f.node[i], diag.WRN + 803, index.hold(#format("`", h, "` is the run this loop is walking, and ", gv, " it here is not something the loop can survive")), WALK_HELP[v])
    label(o, f.c[hd], "the walk reads this again on its next step")

// ERR0824: a handle read after a `#send` may have moved its `ref`.
private void sent_read(^Own o, ^Flow fl, u32 i, ^ref []u64 s):
    ^ir.Fn f = o.f
    i64 h = handle_of(o, f.a[i])
    if h < 0 || !has(s, sent(o, h)) || !fl.report || o.quiet: return
    u32 at = NONE
    syntax.Ast a = o.w.p.files[f.file].a
    for m in 0..<o.nm:
        u32 x = o.moves[m]
        if f.op[x] == ir.O_MOVE && f.sub[x] == ir.MV_SEND && i64(o.mv_h[m]) == h && (at == NONE || a.lo[f.b[x]] < a.lo[f.b[at]]): at = x
    if at == NONE: return
    string8 nm = spell(o, f.a[i])
    check.Where w = check.where(o.w, f.file, f.item, f.b[at])
    say(o, f.node[i], 824, index.hold(#format("`", nm, "` held a `ref` that moved into a channel at the `#send` on line ", w.line, ": the channel's consumer owns it now, and here `", nm, "` is nil")), index.hold(#format("read what you need before the `#send`, or write `", nm, "` again before reading it; on the `else` path, where the queue was full, `", nm, "` is still yours")))
    label(o, f.b[at], "the `ref` moved here")

// A handle handed by value to a callee that may grow it, read after.
private void handed_read(^Own o, i64 h, u32 i):
    ^ir.Fn f = o.f
    u32 c = o.handed_at[h]
    string8 nm = slot(o, f.root[f.a[i]])
    string8 callee = callee_name(o, f.ref_name[f.a[c]])
    check.Where at = check.where(o.w, f.file, f.item, f.node[c])
    say(o, f.node[i], diag.WRN + 803, index.hold(#format("`", nm, "` was handed by value to `", callee, "` at ", at.line, ":", at.col, ", which may grow it — so `", nm, "` may be stale, and this reads or frees a block that may be gone")), index.hold(#format("`", callee, "` keeps or drops the run it grew: read it where `", callee, "` put it, or hand it `&", nm, "` as a `^ref` to grow it in place")))
    label(o, f.node[c], index.hold(#format("`", callee, "` may grow `", nm, "`'s block here")))

// ERR0803: a handle read or freed after a callee freed its block.
private void killed_read(^Own o, i64 h, u32 i):
    ^ir.Fn f = o.f
    u32 c = o.killed_at[h]
    if c == NONE: return
    string8 nm = spell(o, o.hplace[h])
    string8 cn = callee_name(o, f.ref_name[f.a[c]])
    check.Where at = check.where(o.w, f.file, f.item, f.node[c])
    say(o, f.node[i], 803, index.hold(#format("`", nm, "` was handed by value to `", cn, "` at ", at.line, ":", at.col, ", which frees the block it holds on every path — so `", nm, "` is dead, and this reads or frees a block that is gone")), index.hold(#format("a `ref` handed by value to a function that frees it belongs to that function: do not use `", nm, "` after the call — rebind it, or set it to `nil`, if the name is still needed")))
    label(o, f.node[c], index.hold(#format("`", cn, "` frees `", nm, "`'s block here")))

// A read through place `p`: its view may point into a moved block.
private void read(^Own o, ^Flow fl, u32 i, u32 p, ^ref []u64 s, u32 rat = NONE):
    ^ir.Fn f = o.f
    i64 h = handle_of(o, p)
    if h >= 0 && has(s, handed(o, h)) && fl.report && !o.quiet: handed_read(o, h, i)
    if h >= 0 && has(s, killed(o, h)) && fl.report && !o.quiet: killed_read(o, h, i)
    i64 v = view_of(o, p)
    if v < 0 || o.vholds[v] && !bare(o, p): return
    // A pinned copy (`k[#len(k) - 1]`) reads as what it copied.
    u32 nr = f.root[p]
    if (f.slot_flags[nr] & ir.S_USER) == 0:
        u32 dd = o.def[nr]
        if dd == NONE || f.op[dd] != ir.O_SET || !bare(o, f.a[dd]) || (f.root[f.a[dd]] & ir.ROOT_GLOBAL) != 0 || (f.slot_flags[f.root[f.a[dd]]] & ir.S_USER) == 0: return
        nr = f.root[f.a[dd]]
    ref []u32 sites
    for m in 0..<o.nm:
        if o.mv_h[m] != NONE && f.root[o.hplace[o.mv_h[m]]] == f.root[p] && f.plo[o.hplace[o.mv_h[m]]] == f.phi[o.hplace[o.mv_h[m]]]: continue
        if has(s, moved(o, v, m)): sites = #append(sites, u32(m))
    // A move written after the read, inside the op's own expression, ran
    // after it (`f(x, g())` reads `x` before `g`).
    if rat != NONE && f.node[i] != NONE:
        syntax.Ast xa = o.w.p.files[f.file].a
        i64 keep = 0
        for x in sites:
            u32 mn = f.node[o.moves[x]]
            if mn != NONE && xa.lo[mn] > xa.lo[rat] && xa.hi[mn] <= xa.hi[f.node[i]] && xa.lo[mn] >= xa.lo[f.node[i]]: continue
            sites[keep] = x
            keep += 1
        #truncate(sites, keep)
    if #len(sites) == 0: return
    bool must = has(s, freed(o, v)) && !o.weak[f.root[p]]
    if must:
        ref []u32 fs
        for x in sites:
            if o.mv_verb[x] == ir.MV_FREE: fs = #append(fs, x)
        if #len(fs) > 0:
            #truncate(sites, 0)
            for x in fs: sites = #append(sites, x)
        #delete(fs)
    if !must && !o.w.no_sanitize: f.slot_flags[f.root[p]] = f.slot_flags[f.root[p]] | ir.S_WATCH
    if !fl.report || o.quiet: return
    u32 rn = f.node[i] if rat == NONE else rat
    syntax.Ast ra = o.w.p.files[f.file].a
    if f.op[i] == ir.O_INTRINSIC && ra.tag[rn] == syntax.E_INDEX: rn = ra.a[rn]
    // A read through `p^` in a statement: the name dereferenced.
    if ra.tag[rn] != syntax.E_DEREF && f.plo[p] < f.phi[p] && f.step[f.plo[p]] == ir.ST_DEREF:
        u32 dn = deref_of(o, rn, slot(o, nr))
        if dn != NONE: rn = dn
    // The first site in the source, as the message names it.
    u32 first = sites[0]
    for x in sites:
        if o.w.p.files[f.file].a.lo[f.node[o.moves[x]]] < o.w.p.files[f.file].a.lo[f.node[o.moves[first]]]: first = x
    u32 at_op = o.moves[first]
    string8 vn = slot(o, nr)
    u32 mh = o.mv_h[first]
    string8 hn = move_text(o, first)
    string8 un = spell(o, o.hplace[mh]) if mh != NONE else hn
    if o.vsp[v] != NONE: un = text(o, o.vsp[v])
    else if mh == NONE || !has(s, points(o, v, i64(mh))):
        for k in 0..<o.nh:
            if has(s, points(o, v, k)) && bare(o, o.hplace[k]) && o.f.root[o.hplace[k]] != f.root[p] && o.f.root[o.hplace[k]] != nr: un = spell(o, o.hplace[k])
    u8 verb = o.mv_verb[first]
    string8 inside = ""
    check.Where at = check.where(o.w, f.file, f.item, f.node[at_op])
    string8 later = " (this `defer` runs when its scope ends, after that)" if in_defer(o, f.node[i]) else ""
    string8 gv = GERUND[verb]
    if verb == ir.MV_RESIZE && reserving(o, f.node[at_op]): gv = "reserving room in"
    string8 did = index.hold(#format(gv, " `", hn, "`", inside, " at ", at.line, ":", at.col, later))
    bool copy = is_handle(&o.w.t, f.slot_ty[nr])
    if o.vholds[v]:
        string8 dv = index.hold(#format(gv, " `", hn, "`", inside, " at ", at.line, ":", at.col, later))
        say(o, rn, diag.WRN + 803, index.hold(#format("`", vn, "` holds views into the block under `", hn, "`, and ", dv, " may have moved or freed it\x1fThis is possible, not certain: the block may have moved or been freed since `", vn, "` was minted — on some path to this read, or by a growth that may have stayed in place — so this reads through a pointer that may dangle. The program builds; a sanitized run catches the read if it happens\x1efill `", vn, "` again after the move, or finish with `", vn, "` before it")), "")
        label(o, f.node[at_op], index.hold(#format("`", hn, "`", inside, " may move here, and `", vn, "` still holds views into it")))
        #delete(sites)
        return
    if verb == ir.MV_RESET:
        syntax.Ast ra = o.w.p.files[f.file].a
        u32 rc = f.node[at_op]
        u32 arg = ra.list(ra.b[rc])[2]
        if ra.tag[arg] == syntax.E_ARG: arg = ra.a[arg]
        string8 ar = text(o, ra.a[arg])
        bool gone = text(o, ra.list(ra.b[rc])[0]) == "arena.destroy"
        string8 subj = "was minted by arena `"
        if vn != hn: subj = index.hold(#format("points into `", hn, "`, which was minted by arena `"))
        string8 help = index.hold(#format("reset `", ar, "` after the last use of what it minted, or mint `", vn, "` on an allocator that outlives the reset"))
        if gone: help = index.hold(#format("destroy after the last use — `defer arena.destroy(&", ar, ")` where `", ar, "` is declared — or mint `", vn, "` on an allocator that outlives the arena"))
        say(o, rn, diag.WRN + 803, index.hold(#format("`", vn, "` ", subj, ar, "`, and ", "destroying" if gone else "resetting", " `", ar, "` at ", at.line, ":", at.col, " took that memory back — so this reads, writes or hands on memory that may be gone or reused")), help)
        label(o, rc, "the memory is taken back here")
        #delete(sites)
        return
    if must && copy:
        say(o, rn, 803, index.hold(#format("`", vn, "` is a copy of the handle `", hn, "`, and ", did, " freed their block on every path to here — so `", vn, "` is stale, and this reads or frees a block that is gone")), index.hold(#format("a `ref` copy shares its block rather than owning one: after the move, use `", hn, "` itself, or copy the handle again (`", vn, " = ", hn, "`) once the move is done; free the block through one handle only")))
        label(o, f.node[at_op], index.hold(#format("`", hn, "`", inside, " is freed here, and `", vn, "` still holds the old block")))
    else if must:
        say(o, rn, 803, index.hold(#format("`", vn, "` points into the block under `", hn, "`, and ", did, " freed it on every path to this read\x1fThe block was freed after `", vn, "` was minted on every path that reaches this read, so this reads through a pointer that dangles\x1emint the view again after the free, or finish with `", vn, "` before it")), "")
        label(o, f.node[at_op], index.hold(#format("`", hn, "`", inside, " is freed here, and `", vn, "` still points into it")))
    else if copy:
        say(o, rn, diag.WRN + 803, index.hold(#format("`", vn, "` is a copy of the handle `", hn, "`, and ", did, " may have moved or freed their block — so `", vn, "` may be stale, and this reads or frees a block that may be gone")), index.hold(#format("a `ref` copy shares its block rather than owning one: after the move, use `", hn, "` itself, or copy the handle again (`", vn, " = ", hn, "`) once the move is done; free the block through one handle only")))
        label(o, f.node[at_op], index.hold(#format("`", hn, "` may move here, and `", vn, "` still holds the old block")))
    else:
        string8 again = "mint the view again after the move"
        if verb == ir.MV_REBIND && o.mv_call[first] != NONE: again = "mint the view again after the rebinding"
        else if verb == ir.MV_REBIND: again = "rebinding"
        string8 by = ""
        if o.ans[v] != NONE:
            string8 anm = callee_name(o, o.w.fns[o.ans[v]].name)
            by = index.hold(#format(", answered by `", anm, "`"))
            again = index.hold(#format("call `", anm, "` again after the move"))
        say(o, rn, diag.WRN + 803, index.hold(#format("`", vn, "` points into the block under `", un, "`", by, ", and ", did, " may have moved or freed it\x1fThis is possible, not certain: the block may have moved or been freed since `", vn, "` was minted — on some path to this read, or by a growth that may have stayed in place — so this reads through a pointer that may dangle. The program builds; a sanitized run catches the read if it happens\x1e", again, ", or finish with `", vn, "` before it")), "")
        label(o, f.node[at_op], index.hold(#format("`", hn, "`", inside, " may move here, and `", vn, "` still points into it")))
    i64 more = 0
    for x in sites:
        if x == first || more == 4: continue
        label(o, f.node[o.moves[x]], index.hold(#format("`", hn, "` ", "is freed" if must else "may move", " here too")))
        more += 1
    #delete(sites)

// Whether node `n` is inside a `defer` of this body.
private bool in_defer(^Own o, u32 n):
    syntax.Ast a = o.w.p.files[o.f.file].a
    u32 lo = a.lo[o.f.item]
    u32 hi = a.hi[o.f.item]
    for x in 0..<u32(#len(a.tag)):
        if a.tag[x] == syntax.S_DEFER && a.lo[x] >= lo && a.hi[x] <= hi && a.lo[x] <= a.lo[n] && a.hi[n] <= a.hi[x]: return true
    return false

private string8 slot(^Own o, u32 s):
    if (s & ir.ROOT_GLOBAL) != 0: return name(o, o.f.glob_name[s & ~ir.ROOT_GLOBAL])
    u32 n = o.f.slot_name[s]
    return "?" if n == NONE else name(o, n)

private string8 name(^Own o, u32 s):
    return index.hold(strings.clone(o.w.t.text(s)))

// A callee's Dado name, from its job.
private string8 callee_name(^Own o, u32 cname):
    for j in o.w.jobs:
        if j.cname != cname: continue
        check.Decl d = o.w.decls[j.decl]
        if d.kind == check.K_METHOD && d.value != NONE: return index.hold(#format(check.name_of(o.w, o.w.decls[d.block].name), ".", check.name_of(o.w, d.name)))
        return check.name_of(o.w, d.name)
    return name(o, cname)

private void say(^Own o, u32 n, u16 code, string8 msg, string8 help):
    syntax.Ast a = o.w.p.files[o.f.file].a
    check.say(o.w, o.f.file, a.lo[o.f.item], a.lo[n], a.hi[n], code, msg, help)

private void label(^Own o, u32 n, string8 msg):
    syntax.Ast a = o.w.p.files[o.f.file].a
    o.w.d.label(o.f.file, a.lo[o.f.item], a.lo[n] - a.lo[o.f.item], a.hi[n] - a.lo[o.f.item], msg)

// Whether `r` is what a growth of parameter `sl`'s run answered (`return #append(xs, v)`).
private bool regrown(^ir.Fn f, u32 r, u32 sl, i64 depth = 0):
    if depth > 16: return false
    for i in 0..<ir.count(f):
        // `ys = t`, `t` a growth's answer: `ys` answers it too.
        if f.op[i] == ir.O_SET && f.dst[i] != NONE && whole_root(f, f.dst[i], r) && f.a[i] != NONE && !ir.is_const(f.a[i]) && f.root[f.a[i]] != f.root[r] && (f.slot_flags[f.root[f.a[i]]] & ir.S_TEMP) != 0 && regrown(f, f.a[i], sl, depth + 1): return true
        if f.op[i] != ir.O_INTRINSIC || f.dst[i] == NONE || f.dst[i] != r && !whole_root(f, f.dst[i], r) || f.sub[i] != check.B_APPEND && f.sub[i] != check.B_RESIZE && f.sub[i] != check.B_RESERVE: continue
        []u32 xs = ir.args(f, i)
        if #len(xs) > 0 && !ir.is_const(xs[0]) && (f.root[xs[0]] == sl || regrown(f, xs[0], sl, depth + 1)): return true
    return false

// Pointer parameters (P10e): a handle under a `^` parameter is a place
// `p^.a.b` (a `^` again through a pointer field), a view answered out of
// what a `^` points at points into one slot's block (A_PLACED) or anywhere
// under it (A_UNDER, an under-handle), and a callee's moves through a `^`
// land on the caller's place. Moves are named in Rust's order.

private type SK:
    [8]u64 k
    u32 x

private bool sk_less(SK a, SK b):
    for q in 0..<8:
        if a.k[q] != b.k[q]: return a.k[q] < b.k[q]
    return a.x < b.x

// A field name's first eight bytes, big-endian: its order among names.
private u64 name_key(string8 s):
    u64 k = 0
    for q in 0..<8:
        k = k << 8
        if q < #len(s): k = k | u64(u8(s[q]))
    return k

private void order_sums(^Own o, u32 fi):
    ^ir.Fn g = &o.w.fns[fi]
    if #len(o.rsums[fi]) < 2:
        bounds(o, fi)
        return
    ref []SK ks
    for x in 0..<#len(o.rsums[fi]):
        Sum e = o.rsums[fi][x]
        SK k
        k.x = u32(x)
        k.k[0] = (u64(1 if e.verb >= A_PLACED else 0) << 56) | (u64(0 if e.i == NONE else 1) << 48) | (u64(e.j) << 16)
        u32 t = pointee(o, g.slot_ty[e.j]) if e.j < u32(#len(g.slot_ty)) else NONE
        i64 n = 1
        for q in e.lo..<e.hi:
            u32 v = o.rsfx[fi][q]
            if t == NONE || n >= 7: break
            if v == D_STEP:
                t = pointee(o, t)
                continue
            k.k[n] = name_key(field_name(o, t, v)) | 1
            n += 1
            t = slot_t(o, t, v)
        k.k[7] = u64(RANK[e.verb] + 1 if e.verb < 9 else 64)
        ks = #append(ks, k)
    slices.sort_stable(ks[:], sk_less)
    ref []Sum out
    for k in ks:
        out = #append(out, o.rsums[fi][k.x])
    #delete(ks)
    #truncate(o.rsums[fi], 0)
    for e in out:
        o.rsums[fi] = #append(o.rsums[fi], e)
    bounds(o, fi)
    #delete(out)

private u32 pointee(^Own o, u32 t):
    if t == NONE: return NONE
    u32 r = o.w.t.resolve(t)
    if r == NONE || o.w.t.tag[r] != types.T_PTR: return NONE
    return o.w.t.a[r]

private string8 field_name(^Own o, u32 t, u32 x):
    []u32 ns = o.w.t.slot_names(t)
    if x < u32(#len(ns)): return o.w.t.text(ns[x])
    return ""

// Rust's `pv_targets(t, true)`: the types a value of `t` points at, and
// string units; `any`: a trait value.
private void targets(^Own o, u32 t, ^ref []u32 out, ^ref []u8 units, ^bool any):
    ^types.Types tt = &o.w.t
    ref []u32 st
    ref []bool su
    st = #append(st, t)
    su = #append(su, false)
    i64 n = 0
    for #len(st) > 0 && n < 256:
        n += 1
        u32 r = tt.resolve(st[#len(st) - 1])
        bool under = su[#len(su) - 1]
        #truncate(st, #len(st) - 1)
        #truncate(su, #len(su) - 1)
        if r == NONE: continue
        if types.text_unit(r) != types.PRIMS:
            units^ = #append(units^, types.text_unit(r))
            continue
        u8 g = tt.tag[r]
        if g == types.T_TRAIT:
            any^ = true
            continue
        if under:
            out^ = #append(out^, r)
            continue
        if g == types.T_SLICE || g == types.T_REF || g == types.T_PTR:
            st = #append(st, tt.a[r])
            su = #append(su, true)
        else if g == types.T_MAP:
            st = #append(st, tt.a[r])
            su = #append(su, true)
            st = #append(st, tt.b[r])
            su = #append(su, true)
        else if g == types.T_TUPLE || g == types.T_UNION || g == types.T_MATRIX:
            for x in tt.list(r):
                st = #append(st, x)
                su = #append(su, false)
        else if g == types.T_DISTINCT || g == types.T_QUAL || g == types.T_ALIGNED:
            st = #append(st, tt.b[r])
            su = #append(su, false)
        else if g == types.T_SOA:
            st = #append(st, tt.a[r])
            su = #append(su, false)
    #delete(st)
    #delete(su)

// Rust's `pv_view_into`: a view of `vt` may point into the block a handle
// of `ht` holds, at an element or a slot of one held by value.
private bool view_into(^Own o, u32 vt, u32 ht):
    ^types.Types tt = &o.w.t
    ref []u32 tg
    ref []u8 un
    bool any = false
    targets(o, vt, &tg, &un, &any)
    u32 hr = tt.resolve(ht)
    ref []u32 st
    if hr != NONE && tt.tag[hr] == types.T_REF:
        u32 e = tt.resolve(tt.a[hr])
        st = #append(st, tt.a[e] if e != NONE && tt.tag[e] == types.T_SLICE else tt.a[hr])
    else if hr != NONE && tt.tag[hr] == types.T_MAP:
        st = #append(st, tt.a[hr])
        st = #append(st, tt.b[hr])
    else: any = true
    bool hit = any
    i64 n = 0
    for !hit && #len(st) > 0 && n < 256:
        n += 1
        u32 r = tt.resolve(st[#len(st) - 1])
        #truncate(st, #len(st) - 1)
        if r == NONE: continue
        for x in tg:
            if x == r: hit = true
        for u in un:
            if tt.tag[r] == types.T_PRIM && tt.a[r] == u32(u): hit = true
        u8 g = tt.tag[r]
        if g == types.T_TUPLE || g == types.T_UNION || g == types.T_MATRIX:
            for x in tt.list(r):
                st = #append(st, x)
        else if g == types.T_DISTINCT || g == types.T_QUAL || g == types.T_ALIGNED: st = #append(st, tt.b[r])
        else if g == types.T_SOA: st = #append(st, tt.a[r])
    #delete(tg)
    #delete(un)
    #delete(st)
    return hit

// Whether a view of `vt` may point into the block of a handle a value of
// `rt` reaches (Rust's `pv_handles_reached` and `pv_view_into`).
private bool view_reaches(^Own o, u32 vt, u32 rt):
    ^types.Types tt = &o.w.t
    ref []u32 st
    ref []u32 seen
    st = #append(st, rt)
    bool hit = false
    for !hit && #len(st) > 0 && #len(seen) < 256:
        u32 r = tt.resolve(st[#len(st) - 1])
        #truncate(st, #len(st) - 1)
        if r == NONE || has_u32(&seen, r): continue
        seen = #append(seen, r)
        if is_handle(tt, r) && view_into(o, vt, r): hit = true
        u8 g = tt.tag[r]
        if g == types.T_SLICE || g == types.T_REF || g == types.T_PTR || g == types.T_SOA: st = #append(st, tt.a[r])
        else if g == types.T_MAP:
            st = #append(st, tt.a[r])
            st = #append(st, tt.b[r])
        else if g == types.T_TUPLE || g == types.T_UNION || g == types.T_MATRIX:
            for x in tt.list(r):
                st = #append(st, x)
        else if g == types.T_DISTINCT || g == types.T_QUAL || g == types.T_ALIGNED: st = #append(st, tt.b[r])
    #delete(st)
    #delete(seen)
    return hit

// A record holding handles, not itself a view or handle.
private bool rec_h(^Own o, u32 t):
    return t != NONE && !is_view(&o.w.t, t) && !is_handle(&o.w.t, t) && holds_h(o, t)

// Whether callee `c` answers a view placed in one slot of `j^`.
private bool placed_for(^Own o, u32 c, u32 j):
    for e in o.rsums[c][i64(o.rm2[c])..<#len(o.rsums[c])]:
        if (e.verb == A_PLACED || e.verb == A_UNDER) && e.i == NONE && e.j == j: return true
    return false

// Whether a value of type `t` holds a handle by value (a slot at any depth).
private bool holds_h(^Own o, u32 t, i64 depth = 0):
    u32 r = o.w.t.resolve(t)
    if r == NONE || depth > 8: return false
    if is_handle(&o.w.t, r): return true
    if o.w.t.tag[r] != types.T_TUPLE: return false
    for x in o.w.t.slots(r):
        if holds_h(o, x, depth + 1): return true
    return false

// `.a.b` for `sfx` read from type `t`.
private string8 sfx_text(^Own o, u32 t, []u32 sfx):
    ref []char8 s
    u32 ty = t
    for x in sfx:
        if ty == NONE: break
        if x == D_STEP:
            ty = pointee(o, ty)
            continue
        s = #append(s, '.')
        s = #append(s, ..field_name(o, ty, x))
        ty = slot_t(o, ty, x)
    return index.hold(s)

// The pointer parameter place `p` is reached through (`p^`, `p.a`, `p.a^.b`),
// or NONE.
private u32 ptr_root(^Own o, u32 p):
    ^ir.Fn f = o.f
    if p == NONE || ir.is_const(p) || (f.root[p] & ir.ROOT_GLOBAL) != 0: return NONE
    u32 r = f.root[p]
    if r >= f.params: r = o.alias[r]
    if r == NONE || r >= f.params || f.plo[p] == f.phi[p] || f.step[f.plo[p]] != ir.ST_DEREF: return NONE
    for j in f.plo[p]..<f.phi[p]:
        if f.step[j] != ir.ST_FIELD && f.step[j] != ir.ST_DEREF: return NONE
    return r

// Whether place `p` is a handle this pass follows: reached by fields from a
// local or a package variable, or through a pointer parameter.
private bool hplace_ok(^Own o, u32 p):
    ^ir.Fn f = o.f
    if !is_handle(&o.w.t, f.place_ty[p]): return false
    bool fields = true
    bool fd = true
    for j in f.plo[p]..<f.phi[p]:
        if f.step[j] != ir.ST_FIELD: fields = false
        if f.step[j] != ir.ST_FIELD && f.step[j] != ir.ST_DEREF: fd = false
    // Through a pointer slot of a local record (`d.out^`): under it.
    if fd && !fields && (f.root[p] & ir.ROOT_GLOBAL) == 0 && f.root[p] >= f.params && f.plo[p] < f.phi[p] && f.step[f.plo[p]] == ir.ST_FIELD: return true
    return fields || ptr_root(o, p) != NONE

// The steps of `p` after its first, `^`s as D_STEP.
private void tail(^Own o, u32 p, ^ref []u32 out):
    ^ir.Fn f = o.f
    for j in f.plo[p] + 1..<f.phi[p]:
        out^ = #append(out^, D_STEP if f.step[j] == ir.ST_DEREF else f.step_val[j])

// What a callee's `j^` is here, for argument `x`: a pointer place
// (`deref`: its target is `x^`), or the place `&q` names; else NONE.
private u32 arg_base(^Own o, u32 x, ^bool deref):
    ^ir.Fn f = o.f
    u32 p = x
    for _ in 0..<16:
        if p == NONE || ir.is_const(p) || (f.root[p] & ir.ROOT_GLOBAL) != 0: return NONE
        if !bare(o, p) || f.root[p] < f.params || o.def[f.root[p]] == NONE: break
        u32 d = o.def[f.root[p]]
        if f.op[d] == ir.O_ADDR:
            deref^ = false
            return f.a[d]
        if f.op[d] != ir.O_SET && !(f.op[d] == ir.O_CONV && (f.sub[d] == ir.CV_LEND || f.sub[d] == ir.CV_RETAG)): return NONE
        p = f.a[d]
    if p == NONE || ir.is_const(p) || (f.root[p] & ir.ROOT_GLOBAL) != 0 || !is_ptr(&o.w.t, f.place_ty[p]): return NONE
    if bare(o, p) && f.root[p] >= f.params && o.alias[f.root[p]] != NONE: p = ir.at(f, o.alias[f.root[p]])
    if p < u32(#len(o.canon)) && o.canon[p] != NONE: p = o.canon[p]
    if bare(o, p) && f.root[p] < f.params || ptr_root(o, p) != NONE:
        deref^ = true
        return p
    return NONE

// The place `base` (then `^` with `deref`) and `sfx`, interned when `make`;
// else only an existing one, or NONE.
private u32 mapped(^Own o, u32 base, bool deref, []u32 sfx, bool make):
    ^ir.Fn f = o.f
    u32 q = base
    u32 t = f.place_ty[base]
    if deref:
        t = pointee(o, t)
        if t == NONE: return NONE
        q = next_place(o, q, ir.ST_DEREF, 0, t, make)
    for x in sfx:
        if q == NONE: return NONE
        if x == D_STEP:
            t = pointee(o, t)
            if t == NONE: return NONE
            q = next_place(o, q, ir.ST_DEREF, 0, t, make)
            continue
        u32 r = o.w.t.resolve(t)
        if r == NONE || o.w.t.tag[r] != types.T_TUPLE: return NONE
        []u32 sl = o.w.t.slots(r)
        if x >= u32(#len(sl)): return NONE
        t = check.slot_ty(&o.w.t, t, x)
        q = next_place(o, q, ir.ST_FIELD, x, t, make)
    return q

private u32 next_place(^Own o, u32 p, u8 st, u32 v, u32 t, bool make):
    if make: return ir.step(o.f, p, st, v, t)
    u64 key = (u64(p) << 40) | (u64(st) << 32) | u64(v)
    if key in o.f.pmap:
        try u32 q = o.f.pmap[key] else: return NONE
        return q
    return NONE

// Whether place `x` is a prefix of (`exact`: is) `base` (`^` with `deref`)
// + `sfx`.
private bool on_path(^Own o, u32 x, u32 base, bool deref, []u32 sfx, bool exact):
    ^ir.Fn f = o.f
    if f.root[x] != f.root[base]: return false
    u32 nb = f.phi[base] - f.plo[base]
    u32 dd = 1 if deref else 0
    u32 n = nb + dd + u32(#len(sfx))
    u32 nx = f.phi[x] - f.plo[x]
    if nx > n || exact && nx != n: return false
    for k in 0..<nx:
        u8 st = ir.ST_DEREF
        u32 v = 0
        if k < nb:
            st = f.step[f.plo[base] + k]
            v = f.step_val[f.plo[base] + k]
        else if k >= nb + dd:
            u32 sv = sfx[k - nb - dd]
            if sv != D_STEP:
                st = ir.ST_FIELD
                v = sv
        if f.step[f.plo[x] + k] != st || f.step_val[f.plo[x] + k] != v: return false
    return true

// Whether place `a` is a strict prefix of place `b`.
private bool above(^Own o, u32 a, u32 b):
    ^ir.Fn f = o.f
    if f.root[a] != f.root[b] || f.phi[a] - f.plo[a] >= f.phi[b] - f.plo[b]: return false
    for k in 0..<f.phi[a] - f.plo[a]:
        if f.step[f.plo[a] + k] != f.step[f.plo[b] + k] || f.step_val[f.plo[a] + k] != f.step_val[f.plo[b] + k]: return false
    return true

// The under-handle at place `p`, or -1.
private i64 uof(^Own o, u32 p):
    for h in 0..<o.nh:
        if o.uh[h] && o.hplace[h] == p: return h
    return -1

private bool has_u32(^ref []u32 xs, u32 x):
    for y in xs^:
        if y == x: return true
    return false

// Argument `j` of call op `i` as written, `&` off, or NONE.
private u32 arg_expr(^Own o, u32 i, u32 j):
    syntax.Ast a = o.w.p.files[o.f.file].a
    u32 c = o.f.node[i]
    if c == NONE || a.tag[c] != syntax.E_CALL: return NONE
    []u32 ks = a.list(a.b[c])
    []u32 xs = ir.args(o.f, i)
    u32 n = u32(#len(xs))
    u32 at = NONE
    u32 c0 = callee_body(o, i)
    bool recv = c0 != NONE && #len(o.w.fns[c0].slot_flags) > 0 && (o.w.fns[c0].slot_flags[0] & ir.S_RECEIVER) != 0 && a.tag[ks[0]] == syntax.E_FIELD
    if c0 == NONE: recv = u32(#len(ks)) == n + 1 && a.tag[ks[0]] == syntax.E_FIELD
    if recv:
        if j == 0: at = a.a[ks[0]]
        else if 1 + j < u32(#len(ks)): at = ks[1 + j]
    else if 2 + j < u32(#len(ks)): at = ks[2 + j]
    if at == NONE: return NONE
    if a.tag[at] == syntax.E_ARG: at = a.a[at]
    if at != NONE && a.tag[at] == syntax.E_UNARY && o.w.p.files[o.f.file].src[i64(a.lo[at])] == '&': at = a.a[at]
    return at

// The callee of call op `i` as written.
private string8 call_text(^Own o, u32 i):
    syntax.Ast a = o.w.p.files[o.f.file].a
    u32 c = o.f.node[i]
    if c != NONE && a.tag[c] == syntax.E_CALL: return text(o, a.list(a.b[c])[0])
    return callee_name(o, o.f.ref_name[o.f.a[i]])

// Argument `j` of call op `i` as written, or "it".
private string8 arg_text(^Own o, u32 i, u32 j):
    u32 n = arg_expr(o, i, j)
    return "it" if n == NONE else text(o, n)

// A finding at node `n` is made once (Rust's).
private bool once(^Own o, u32 n):
    if has_u32(&o.said, n): return false
    o.said = #append(o.said, n)
    return true


// The type of place `p` after its step `j`, from its prefix's.
private u32 pstep_ty(^Own o, u32 p, u32 j):
    u32 q = prefix(o, p, j + 1 - o.f.plo[p], nil)
    return o.f.place_ty[q] if q != NONE else NONE

// The record number of the root place `p` is a handle slot of (through an
// alias of a `^` parameter), or NONE.
private u32 rec_place(^Own o, u32 p):
    ^ir.Fn f = o.f
    if p == NONE || ir.is_const(p) || (f.root[p] & ir.ROOT_GLOBAL) != 0: return NONE
    for j in f.plo[p]..<f.phi[p]:
        if f.step[j] == ir.ST_INDEX: return NONE
    u32 r = f.root[p]
    if r >= f.params && o.alias[r] != NONE: r = o.alias[r]
    return o.rec_of[r]

// Two handle slots of the record at place `p` may now hold one block.
private void mark_shared(^Own o, ^ref []u64 s, u32 p):
    u32 k = rec_place(o, p)
    set(s, shared(o, i64(o.nrec) if k == NONE else i64(k)), true)

// Whether the slots of record `k` are taken to hold distinct blocks here.
private bool apart_in(^Own o, ^ref []u64 s, u32 k):
    return k != NONE && !has(s, shared(o, o.nrec)) && !has(s, shared(o, i64(k)))

// Whether operand `x` is a fresh block or no handle (a `#make`, `nil`, a
// call's answer), not a copy of another handle.
private bool fresh(^Own o, u32 x, i64 depth = 0):
    ^ir.Fn f = o.f
    if x == NONE || ir.is_const(x): return true
    if (f.root[x] & ir.ROOT_GLOBAL) != 0 || depth > 8: return false
    u32 r = f.root[x]
    u32 d = o.def[r]
    if !bare(o, x):
        // A field of a call's answer (`(a, b) = f()`).
        for j in f.plo[x]..<f.phi[x]:
            if f.step[j] != ir.ST_FIELD: return false
        return d != NONE && f.op[d] == ir.O_CALL
    if d == NONE: return r >= f.params && (f.slot_flags[r] & ir.S_TEMP) == 0 && fresh_local(o, r, depth)
    u8 op = f.op[d]
    if op == ir.O_SET || op == ir.O_CONV: return fresh(o, f.a[d], depth + 1)
    return op == ir.O_MAKE || op == ir.O_INTRINSIC || op == ir.O_CALL

// A local handle every store of which is a fresh block (P10h) and whose
// address is never taken.
private bool fresh_local(^Own o, u32 r, i64 depth):
    if o.fmemo[r] != 0: return o.fmemo[r] == 2
    o.fmemo[r] = 1
    bool y = fresh_scan(o, r, depth)
    if y: o.fmemo[r] = 2
    return y

private bool fresh_scan(^Own o, u32 r, i64 depth):
    ^ir.Fn f = o.f
    for i in 0..<ir.count(f):
        u8 op = f.op[i]
        if op == ir.O_ADDR && f.a[i] != NONE && !ir.is_const(f.a[i]) && f.root[f.a[i]] == r: return false
        u32 d = f.dst[i]
        if d == NONE || ir.is_const(d) || f.root[d] != r: continue
        if !bare(o, d): return false
        if op == ir.O_SET || op == ir.O_CONV:
            if f.a[i] != NONE && !ir.is_const(f.a[i]) && f.root[f.a[i]] == r: continue
            if !fresh(o, f.a[i], depth + 1): return false
        else if op != ir.O_MAKE && op != ir.O_INTRINSIC && op != ir.O_CALL: return false
    return true

// A store into place `d` (a handle slot) from a value that may be another
// handle: its record may hold one block twice (Rust's `e.ops = e.pool`).
private bool shares(^Own o, u32 d, u32 x):
    ^ir.Fn f = o.f
    return d != NONE && !ir.is_const(d) && !bare(o, d) && holds_h(o, f.place_ty[d]) && !fresh(o, x)

// The record a call's `^` argument `x` reaches, by its root place, or NONE.
private u32 arg_record(^Own o, u32 x):
    bool deref = false
    u32 b = arg_base(o, x, &deref)
    return NONE if b == NONE else rec_place(o, b)

// WRN0803 at a call whose callee reads a view of one slot of a record after
// moving another, handed a record two of whose slots may hold one block;
// a `^` parameter handed on passes the need to this body's callers.
private void apart_at(^Own o, ^Flow fl, u32 i, ^ref []u64 s, u32 c):
    ^ir.Fn f = o.f
    if o.rapart[c] == 0: return
    []u32 xs = ir.args(f, i)
    for j in 0..<#len(xs):
        if j >= 64 || (o.rapart[c] >> u64(j)) & 1 == 0: continue
        bool deref = false
        u32 b = arg_base(o, xs[j], &deref)
        u32 k = rec_place(o, b) if b != NONE else NONE
        u32 r = NONE
        if b != NONE && (f.root[b] & ir.ROOT_GLOBAL) == 0:
            r = f.root[b]
            if r >= f.params && o.alias[r] != NONE: r = o.alias[r]
        bool self_ = j == 0 && r == 0 && (f.slot_flags[0] & ir.S_RECEIVER) != 0
        if apart_in(o, s, k) || self_ && !has(s, shared(o, o.nrec)):
            if r != NONE && r < f.params && r < 64: o.now_apart = o.now_apart | (u64(1) << u64(r))
            continue
        // Rust reports these only where function values elsewhere in the
        // program make a record shared (not followed here): kept silent.
        if !fl.report || o.quiet || !o.apart_say || !once(o, f.node[i]): continue
        string8 cn = call_text(o, i)
        string8 x = spell(o, b) if b != NONE && bare(o, b) || b != NONE && deref else arg_text(o, i, u32(j))
        if b != NONE && !deref: x = arg_text(o, i, u32(j))
        say(o, f.node[i], diag.WRN + 803, index.hold(#format("`", cn, "` reads a pointer or window it took into one handle slot of `", x, "` after it moves or frees another slot, and two of `", x, "`'s handle slots may hold one block here, so that move may free what the pointer reads")), index.hold(#format("give each handle slot of `", x, "` a block of its own before the call, or have `", cn, "` take the pointer again after the move")))

// Whether moving handle `h`, a slot of record `k`, reaches view `v` through
// another slot of `k`: one a call answered `v` out of, while two slots may
// hold one block; one `v` was taken in place from, once this body or a
// callee may have written one slot from another. While they are apart, a
// parameter's callers are asked to keep them so.
private bool slot_hit(^Own o, ^ref []u64 s, i64 v, i64 h, u32 k):
    ^ir.Fn f = o.f
    u32 r = o.recs[k]
    bool ask = r < f.params && r < 64 && (o.now_apart >> u64(r)) & 1 == 0
    if o.vrec[v] != NONE:
        // Placed in one slot of the record at place `vrec`: a move under it.
        if rec_place(o, o.vrec[v]) != k || !above(o, o.vrec[v], o.hplace[h]): return false
        if !apart_in(o, s, k): return true
        if ask: o.now_apart = o.now_apart | (u64(1) << u64(r))
        return false
    bool sh = has(s, shared(o, i64(k)))
    if !sh && !(ask && !has(s, shared(o, o.nrec))): return false
    // A fresh local handle copied out once: its block is in one slot only (P10h).
    if sh && unique_local(o, o.vslot[v]): return false
    u32 hp = o.hplace[h]
    for x in 0..<o.nh:
        if x == h || o.uh[x] || !has(s, points(o, v, x)): continue
        u32 xp = o.hplace[x]
        if rec_place(o, xp) != k || above(o, xp, hp) || above(o, hp, xp): continue
        if o.w.t.resolve(f.place_ty[xp]) != o.w.t.resolve(f.place_ty[hp]): continue
        if sh: return true
        o.now_apart = o.now_apart | (u64(1) << u64(r))
        return false
    return false

// A callee with no body (`foreign`, a function value): what it writes is not
// followed, so a record it is handed a `^` to may hold one block twice.
private void no_body(^Own o, u32 i, ^ref []u64 s):
    ^ir.Fn f = o.f
    for x in ir.args(f, i):
        bool deref = false
        u32 b = arg_base(o, x, &deref)
        if b == NONE: continue
        u32 t = pointee(o, f.place_ty[b]) if deref else f.place_ty[b]
        if t != NONE && holds_h(o, t): mark_shared(o, s, b)

// Each body's key. Rust's is its declaration's package and name, so that
// methods and functions of one name in a package share one summary, joined;
// followed alone that over-reaches here (P10e, measured), so a body is its own.
private void keys(^Own o):
    for i in 0..<#len(o.w.fns):
        o.rep = #append(o.rep, u32(i))
        o.members[i] = #append(o.members[i], u32(i))

// The joined summary of key `rp` from its bodies' own; whether it changed.
private bool join_key(^Own o, u32 rp):
    u64 g = 0
    u64 r0 = 0
    u64 r1 = 0
    u64 k0 = 0
    u64 k1 = 0
    u64 ap = 0
    u64 fr = 0xFFFFFFFFFFFFFFFF
    ref []Sum ns
    ref []u32 nx
    ref []GSum ng
    for m in o.members[rp]:
        g = g | o.grows[m]
        r0 = r0 | o.rets[m]
        r1 = r1 | o.rets1[m]
        k0 = k0 | o.keeps[m]
        k1 = k1 | o.keeps1[m]
        ap = ap | o.apart[m]
        fr = fr & o.frees[m]
        for e in o.sums[m]:
            bool dup = false
            if #len(o.members[rp]) > 1:
                for y in ns:
                    if y.i != e.i || y.j != e.j || y.verb != e.verb || y.hi - y.lo != e.hi - e.lo: continue
                    bool same = true
                    for q in 0..<e.hi - e.lo:
                        if nx[y.lo + q] != o.sfx[m][e.lo + q]: same = false
                    if same: dup = true
            if dup: continue
            Sum x = e
            x.lo = u32(#len(nx))
            for q in e.lo..<e.hi:
                nx = #append(nx, o.sfx[m][q])
            x.hi = u32(#len(nx))
            ns = #append(ns, x)
        for e in o.gs[m]:
            if !has_g(ng, e.fi, e.key, e.verb, e.kind): ng = #append(ng, GSum(rp, e.key, e.ty, e.verb, e.kind))
    bool same = g == o.rgrows[rp] && r0 == o.rrets[rp] && r1 == o.rrets1[rp] && k0 == o.rkeeps[rp] && k1 == o.rkeeps1[rp] && ap == o.rapart[rp] && fr == o.rfrees[rp] && #len(ns) == #len(o.rsums[rp]) && #len(ng) == #len(o.rgs[rp])
    if same:
        for e in ns:
            bool found = false
            for y in o.rsums[rp]:
                if y.i != e.i || y.j != e.j || y.verb != e.verb || y.hi - y.lo != e.hi - e.lo: continue
                bool eq = true
                for q in 0..<e.hi - e.lo:
                    if o.rsfx[rp][y.lo + q] != nx[e.lo + q]: eq = false
                if eq: found = true
            if !found: same = false
    if same:
        #delete(ns)
        #delete(nx)
        #delete(ng)
        return false
    o.rgrows[rp] = g
    o.rrets[rp] = r0
    o.rrets1[rp] = r1
    o.rkeeps[rp] = k0
    o.rkeeps1[rp] = k1
    o.rapart[rp] = ap
    o.rfrees[rp] = fr
    #delete(o.rsums[rp])
    #delete(o.rsfx[rp])
    #delete(o.rgs[rp])
    o.rsums[rp] = ns
    o.rsfx[rp] = nx
    o.rgs[rp] = ng
    order_sums(o, rp)
    return true

// Slot `x`'s type of `t`, or NONE past its slots.
private u32 slot_t(^Own o, u32 t, u32 x):
    u32 r = o.w.t.resolve(t)
    if r == NONE || o.w.t.tag[r] != types.T_TUPLE: return NONE
    []u32 sl = o.w.t.slots(r)
    if x >= u32(#len(sl)): return NONE
    return check.slot_ty(&o.w.t, t, x)


// Whether `sfx` read from type `t` is a path of it that ends at a handle.
private bool typed_path(^Own o, u32 t, []u32 sfx):
    u32 ty = t
    for x in sfx:
        if ty == NONE: return false
        if x == D_STEP: ty = pointee(o, ty)
        else: ty = slot_t(o, ty, x)
    return ty != NONE && is_handle(&o.w.t, ty)

private void bounds(^Own o, u32 rp):
    u32 a = 0
    for a < u32(#len(o.rsums[rp])) && o.rsums[rp][a].i == NONE && o.rsums[rp][a].verb < A_PLACED:
        a += 1
    u32 b = a
    for b < u32(#len(o.rsums[rp])) && o.rsums[rp][b].verb < A_PLACED:
        b += 1
    o.rm1[rp] = a
    o.rm2[rp] = b

// The bases of call op `i`'s arguments, into `abase`/`aderef`.
private void bases(^Own o, u32 i):
    #truncate(o.abase, 0)
    #truncate(o.aderef, 0)
    for x in ir.args(o.f, i):
        bool deref = false
        o.abase = #append(o.abase, arg_base(o, x, &deref))
        o.aderef = #append(o.aderef, deref)

private void sp_add(^Own o, u32 x):
    for #len(o.insp) <= i64(x):
        o.insp = #append(o.insp, false)
    if o.insp[x]: return
    o.insp[x] = true
    o.sp = #append(o.sp, x)

// Package storage keeps only views its type can hold (P10h): per body, the
// global types it or a callee names (`kt`), over-approximating what it may
// store into; a call through a function value may store anywhere.
private void storage(^Own o):
    ^check.World w = o.w
    // A library's callers are not known: they may make bytes text (P10i) or
// pun (P10j).
    if w.library:
        o.u8text = true
        o.punall = true
    {u32: u32} gix
    for i in 0..<#len(w.fns):
        ^ir.Fn f = &w.fns[i]
        for t in f.glob_ty:
            if !(t in gix):
                gix[t] = u32(#len(o.gty))
                o.gty = #append(o.gty, t)
    o.gw = (#len(o.gty) + 63) / 64
    for _ in 0..<#len(w.fns):
        o.kt_any = #append(o.kt_any, false)
        for _ in 0..<o.gw:
            o.kt = #append(o.kt, 0)
    ref []u32 elo
    ref []u32 eto
    for i in 0..<#len(w.fns):
        ^ir.Fn f = &w.fns[i]
        i64 rp = i64(o.rep[i])
        for t in f.glob_ty:
            try u32 g = gix[t] else: continue
            i64 at = rp * o.gw + i64(g / 64)
            o.kt[at] = o.kt[at] | (u64(1) << u64(g % 64))
        elo = #append(elo, u32(#len(eto)))
        for j in 0..<ir.count(f):
            u8 sub = f.sub[j]
            if f.op[j] == ir.O_CONV && !ir.is_const(f.a[j]): convs(o, sub, f.place_ty[f.a[j]], f.ty_of[j])
            if f.op[j] == ir.O_CALL_INDIRECT: o.kt_any[rp] = true
            else if f.op[j] == ir.O_CALL:
                u32 c = callee_in(o, f, j)
                if c != NONE && i64(c) != rp: eto = #append(eto, c)
    elo = #append(elo, u32(#len(eto)))
    bool more = true
    for more:
        more = false
        for ii in 0..<#len(w.fns):
            i64 i = #len(w.fns) - 1 - ii
            i64 rp = i64(o.rep[i])
            for c in eto[i64(elo[i])..<i64(elo[i + 1])]:
                if o.kt_any[c] && !o.kt_any[rp]:
                    o.kt_any[rp] = true
                    more = true
                for g in 0..<o.gw:
                    u64 x = o.kt[i64(c) * o.gw + g]
                    u64 y = o.kt[rp * o.gw + g]
                    if (x | y) != y:
                        o.kt[rp * o.gw + g] = x | y
                        more = true
    #delete(elo)
    #delete(eto)

private u32 callee_in(^Own o, ^ir.Fn f, u32 i):
    if f.ref_flags[f.a[i]] & ir.R_FOREIGN != 0 || !(f.ref_name[f.a[i]] in o.by_name): return NONE
    try u32 c = o.by_name[f.ref_name[f.a[i]]] else: return NONE
    return o.rep[c]

// The first site on the way here that exposed handle `h` into storage that
// can hold a view into the block of `mt` (`deep`: or one under it), or NONE.
private u32 held_site(^Own o, ^ref []u64 s, i64 h, u32 mt, bool deep):
    if !has(s, exposed(o, h)): return NONE
    u32 best = NONE
    u64 q = (u64(mt) << 1) | u64(1 if deep else 0)
    for #len(o.es_q) < o.nes:
        o.es_q = #append(o.es_q, 0xFFFFFFFFFFFFFFFF)
        o.es_a = #append(o.es_a, false)
    for k in o.es_h[h]:
        if !has(s, esite(o, i64(k))) || k >= best: continue
        // Each site's last answer, kept for the type asked (P10i).
        if o.es_q[k] != q:
            o.es_q[k] = q
            o.es_a[k] = can_hold(o, k, mt, deep)
        if o.es_a[k]: best = k
    return best

// Whether site `k`'s package storage can hold a view into the block of
// handle type `mt` (`deep`: or a block under it; a growth moves only its own).
private bool can_hold(^Own o, u32 k, u32 mt, bool deep):
    if mt == NONE: return true
    if o.es_by[k] == NONE: return o.es_g[k] == NONE || stores_into(o, o.es_g[k], mt, deep)
    u32 c = callee(o, o.es_by[k])
    if c == NONE || o.kt_any[c]: return true
    u64 key = (u64(c) << 32) | u64(mt)
    u8 m = 0
    if key in o.cmemo:
        try u8 v = o.cmemo[key] else: return true
        m = v
    u8 kb = 1
    if deep: kb = 4
    if (m & kb) != 0: return (m & (kb << 1)) != 0
    bool hit = false
    for g in 0..<#len(o.gty):
        u64 x = o.kt[i64(c) * o.gw + g / 64]
        if !hit && (x >> u64(g % 64)) & 1 != 0 && stores_into(o, o.gty[g], mt, deep): hit = true
    m = m | kb
    if hit: m = m | (kb << 1)
    o.cmemo[key] = m
    return hit

// The type `sfx` reaches from `t` (NONE: unknown).
private u32 sfx_type(^Own o, u32 t, []u32 sfx):
    u32 ty = t
    for x in sfx:
        if ty == NONE: return NONE
        if x == D_STEP: ty = pointee(o, ty)
        else: ty = slot_t(o, ty, x)
    return ty

// Whether storage of type `g` can hold a view into the block of handle type
// `ht` (`deep`: or into a block that one holds).
// `top`: `g` is a view or handle itself, pointing into the block it names.
private bool stores_into(^Own o, u32 g, u32 ht, bool deep, bool top = false):
    u64 key = (u64(g) << 32) | u64(ht)
    u8 m = 0
    if key in o.smemo:
        try u8 v = o.smemo[key] else: return true
        m = v
    u8 kb = 1
    if deep: kb = 4
    if top: kb = kb << 4
    if (m & kb) != 0: return (m & (kb << 1)) != 0
    ref []u32 tg
    u64 sb = 0
    u64 pb = 0
    bool any = false
    pointees(o, g, &tg, &sb, &pb, &any, top)
    ref []u32 hs
    hs = #append(hs, ht)
    if deep: inner_handles(o, ht, &hs)
    bool hit = any
    for h in hs:
        if !hit && handle_hit(o, h, &tg, sb, pb): hit = true
    #delete(tg)
    #delete(hs)
    m = m | kb
    if hit: m = m | (kb << 1)
    o.smemo[key] = m
    return hit

// Primitive `p` as a bit, with `u8` and `char8` one where some conversion
// in the program makes a view of `u8`s text or back.
private u64 pbit(^Own o, u32 p):
    if o.u8text && (p == u32(types.P_U8) || p == u32(types.P_CHAR8)): return (u64(1) << u64(types.P_U8)) | (u64(1) << u64(types.P_CHAR8))
    if p >= 64: return 0
    return u64(1) << u64(p)

// A conversion `sub` from `from` to `to`: does it make bytes text (or back),
// or a view out of a `rawptr`, a C shape, a union member or a tail?
private void convs(^Own o, u8 sub, u32 from, u32 to):
    ^types.Types tt = &o.w.t
    u32 r = tt.resolve(to)
    if r == NONE: return
    bool text = types.is_text(r) || r == types.CSTRING || bytes_of(o, r, types.P_CHAR8)
    bool ftext = from != NONE && (types.is_text(tt.resolve(from)) || bytes_of(o, from, types.P_CHAR8))
    if sub == ir.CV_RETAG && (text && bytes_of(o, from, types.P_U8) || ftext && bytes_of(o, r, types.P_U8)): o.u8text = true
    if (sub == ir.CV_FROM_RAWPTR || sub == ir.CV_CSTRING) && r == types.CSTRING && bytes_of(o, from, types.P_U8): o.u8text = true
    if (sub == ir.CV_FROM_RAWPTR || sub == ir.CV_CROSS || sub == ir.CV_MEMBER || sub == ir.CV_TAIL) && (tt.tag[r] == types.T_PTR || tt.tag[r] == types.T_SLICE):
        u32 q = tt.resolve(tt.a[r])
        if q != NONE && !has_u32(&o.punned, q): o.punned = #append(o.punned, q)

// A slice, `ref` or pointer of primitive `p`.
private bool bytes_of(^Own o, u32 t, u8 p):
    ^types.Types tt = &o.w.t
    if t == NONE: return false
    u32 r = tt.resolve(t)
    if r == NONE || tt.tag[r] != types.T_SLICE && tt.tag[r] != types.T_REF && tt.tag[r] != types.T_PTR: return false
    u32 e = tt.resolve(tt.a[r])
    if e != NONE && tt.tag[e] == types.T_SLICE: e = tt.resolve(tt.a[e])
    return e == u32(p)

// What a value of type `t` may point at, at any depth: element types into
// `tg`; primitives a slice or handle may view (`sb`) or a pointer point at
// (`pb`); `any`: unknown. `top`: `t`'s own block counts, if a handle.
private void pointees(^Own o, u32 t, ^ref []u32 tg, ^u64 sb, ^u64 pb, ^bool any, bool top):
    ^types.Types tt = &o.w.t
    ref []u32 st
    ref []u32 seen
    st = #append(st, t)
    for #len(st) > 0 && #len(seen) < 512:
        u32 r = tt.resolve(st[#len(st) - 1])
        #truncate(st, #len(st) - 1)
        if r == NONE || has_u32(&seen, r): continue
        seen = #append(seen, r)
        u8 u = types.text_unit(r)
        if u != types.PRIMS:
            sb^ = sb^ | pbit(o, u32(u))
            continue
        if r == types.CSTRING:
            sb^ = sb^ | pbit(o, u32(types.P_CHAR8))
            continue
        u8 g = tt.tag[r]
        ref []u32 el
        // A handle's elements are held, not pointed at; its primitives count
        // as viewed (Rust counts spread text as views).
        bool held = (g == types.T_REF || g == types.T_MAP || g == types.T_CHANNEL) && !(top && r == tt.resolve(t))
        bool slice = g != types.T_PTR
        if g == types.T_TRAIT || g == types.T_OPAQUE || g == types.T_BUILTIN || g == types.T_PRIM && tt.a[r] == u32(types.P_RAWPTR): any^ = true
        else if g == types.T_SLICE || g == types.T_PTR || g == types.T_SOA: el = #append(el, tt.a[r])
        else if g == types.T_REF:
            u32 e = tt.resolve(tt.a[r])
            if e != NONE && tt.tag[e] == types.T_SLICE: el = #append(el, tt.a[e])
            else: el = #append(el, tt.a[r])
        else if g == types.T_MAP:
            el = #append(el, tt.a[r])
            el = #append(el, tt.b[r])
        else if g == types.T_CHANNEL:
            for x in tt.list(r):
                el = #append(el, x)
        else if g == types.T_TUPLE || g == types.T_UNION || g == types.T_MATRIX:
            for x in tt.list(r):
                st = #append(st, x)
        else if g == types.T_DISTINCT || g == types.T_QUAL || g == types.T_ALIGNED: st = #append(st, tt.b[r])
        for x in el:
            u32 q = tt.resolve(x)
            if q == NONE: continue
            if (g == types.T_PTR || g == types.T_SLICE) && (o.punall || has_u32(&o.punned, q)): any^ = true
            if tt.tag[q] == types.T_PRIM && slice: sb^ = sb^ | pbit(o, tt.a[q])
            else if tt.tag[q] == types.T_PRIM: pb^ = pb^ | pbit(o, tt.a[q])
            else if !held && !has_u32(tg, q): tg^ = #append(tg^, q)
            st = #append(st, q)
        #delete(el)
    #delete(st)
    #delete(seen)

// The handles a value of handle type `ht` reaches below its own block.
private void inner_handles(^Own o, u32 ht, ^ref []u32 hs):
    ^types.Types tt = &o.w.t
    ref []u32 st
    ref []u32 seen
    st = #append(st, ht)
    for #len(st) > 0 && #len(seen) < 512:
        u32 r = tt.resolve(st[#len(st) - 1])
        #truncate(st, #len(st) - 1)
        if r == NONE || has_u32(&seen, r): continue
        seen = #append(seen, r)
        if r != tt.resolve(ht) && is_handle(tt, r): hs^ = #append(hs^, r)
        u8 g = tt.tag[r]
        if g == types.T_SLICE || g == types.T_REF || g == types.T_PTR || g == types.T_SOA: st = #append(st, tt.a[r])
        else if g == types.T_MAP:
            st = #append(st, tt.a[r])
            st = #append(st, tt.b[r])
        else if g == types.T_TUPLE || g == types.T_UNION || g == types.T_MATRIX || g == types.T_CHANNEL:
            for x in tt.list(r):
                st = #append(st, x)
        else if g == types.T_DISTINCT || g == types.T_QUAL || g == types.T_ALIGNED: st = #append(st, tt.b[r])
    #delete(st)
    #delete(seen)

// Whether a view to one of `tg`, or a slice of (`sb`) or pointer to (`pb`) a
// primitive, may point into the block of handle type `h`: at an element, a
// slot of one, or an element of an array held by value.
private bool handle_hit(^Own o, u32 h, ^ref []u32 tg, u64 sb, u64 pb):
    ^types.Types tt = &o.w.t
    u32 r = tt.resolve(h)
    if r == NONE: return true
    ref []u32 st
    ref []bool run
    u8 g = tt.tag[r]
    if g == types.T_REF:
        u32 e = tt.resolve(tt.a[r])
        if e != NONE && tt.tag[e] == types.T_SLICE: st = #append(st, tt.a[e])
        else: st = #append(st, tt.a[r])
    else if g == types.T_MAP:
        st = #append(st, tt.a[r])
        st = #append(st, tt.b[r])
    else if g == types.T_CHANNEL:
        for x in tt.list(r):
            st = #append(st, x)
    else: return true
    for _ in st:
        run = #append(run, true)
    bool hit = false
    i64 n = 0
    for !hit && #len(st) > 0 && n < 512:
        n += 1
        u32 q = tt.resolve(st[#len(st) - 1])
        bool rn = run[#len(run) - 1]
        #truncate(st, #len(st) - 1)
        #truncate(run, #len(run) - 1)
        if q == NONE: continue
        if has_u32(tg, q): hit = true
        u8 k = tt.tag[q]
        if k == types.T_PRIM:
            u64 b = pbit(o, tt.a[q])
            if (pb & b) != 0 || rn && (sb & b) != 0: hit = true
        else if types.text_unit(q) != types.PRIMS: continue
        else if k == types.T_TUPLE || k == types.T_UNION:
            for x in tt.list(q):
                st = #append(st, x)
                run = #append(run, false)
        else if k == types.T_MATRIX:
            for x in tt.list(q):
                st = #append(st, x)
                run = #append(run, true)
        else if k == types.T_DISTINCT || k == types.T_QUAL || k == types.T_ALIGNED:
            st = #append(st, tt.b[q])
            run = #append(run, rn)
        else if k == types.T_SOA:
            st = #append(st, tt.a[q])
            run = #append(run, rn)
        else if k == types.T_OPAQUE: hit = true
    #delete(st)
    #delete(run)
    return hit

// The length of `sx` before its first `^`.
private i64 to_step(^ref []u32 sx):
    for k in 0..<#len(sx^):
        if sx^[k] == D_STEP: return k
    return #len(sx^)

// The place an A_UNDER answer of `b` (`^` with `deref`) + `sfx` is under:
// `b` itself with no `sfx`.
private u32 under_base(^Own o, u32 b, bool deref, []u32 sfx, bool make):
    if #len(sfx) == 0: return b
    u32 q = mapped(o, b, deref, sfx, make)
    return b if q == NONE else q

// A local handle holding only fresh blocks, copied out at most once, never
// handed whole to a call.
private bool unique_local(^Own o, u32 r):
    if o.umemo[r] != 0: return o.umemo[r] == 2
    bool y = unique_scan(o, r)
    o.umemo[r] = 2 if y else 1
    return y

private bool unique_scan(^Own o, u32 r):
    ^ir.Fn f = o.f
    if r < f.params || (f.slot_flags[r] & ir.S_TEMP) != 0 || !is_handle(&o.w.t, f.slot_ty[r]) || !fresh_local(o, r, 0): return false
    i64 outs = 0
    for i in 0..<ir.count(f):
        u8 op = f.op[i]
        if op == ir.O_SET || op == ir.O_CONV:
            u32 x = f.a[i]
            u32 d = f.dst[i]
            if x == NONE || ir.is_const(x) || !bare(o, x) || f.root[x] != r || d != NONE && !ir.is_const(d) && f.root[d] == r: continue
            // Into a name or temp: it may go on to other slots.
            if d == NONE || ir.is_const(d) || bare(o, d): return false
            outs += 1
        else if op == ir.O_CALL || op == ir.O_CALL_INDIRECT || op == ir.O_MAKE || op == ir.O_RETURN:
            for y in ir.args(f, i):
                if y != NONE && !ir.is_const(y) && bare(o, y) && f.root[y] == r: return false
            if op == ir.O_RETURN && f.a[i] != NONE && !ir.is_const(f.a[i]) && f.root[f.a[i]] == r: return false
    return outs <= 1

// Whether move `m` (of a handle of type `mt`) may move a view of type `vt`:
// it, or a move it stands for.
private bool moves_view(^Own o, u32 vt, i64 m, u32 mt, bool deep):
    u32 sd = o.mv_stand[m]
    if sd == NONE: return stores_into(o, vt, mt, deep, true)
    for c in o.stand[sd]:
        if u32(c >> 1) == NONE || stores_into(o, vt, u32(c >> 1), (c & 1) != 0, true): return true
    return false

// Local records holding one call's answer under `j^` + a path (P10i): their
// handles are under that place while nothing here rebinds or moves them.
private void rec_origins(^Own o):
    ^ir.Fn f = o.f
    #truncate(o.rbase, 0)
    #truncate(o.rsx, 0)
    bool any = false
    for i in 0..<ir.count(f):
        if f.op[i] == ir.O_CALL && f.dst[i] != NONE && !ir.is_const(f.dst[i]) && (f.root[f.dst[i]] & ir.ROOT_GLOBAL) == 0 && f.root[f.dst[i]] >= f.params: any = true
    if !any: return
    i64 ns = #len(f.slot_ty)
    #truncate(o.rderef, 0)
    #truncate(o.rslo, 0)
    #truncate(o.rshi, 0)
    #truncate(o.rdef, 0)
    for _ in 0..<ns:
        o.rbase = #append(o.rbase, NONE)
        o.rderef = #append(o.rderef, false)
        o.rslo = #append(o.rslo, 0)
        o.rshi = #append(o.rshi, 0)
        o.rdef = #append(o.rdef, NONE)
    // Each local's one writing op (NONE - 1: more than one).
    for i in 0..<ir.count(f):
        u32 d = f.dst[i]
        if d == NONE || ir.is_const(d) || (f.root[d] & ir.ROOT_GLOBAL) != 0 || f.root[d] < f.params: continue
        u32 a = f.root[d]
        o.rdef[a] = i if o.rdef[a] == NONE && bare(o, d) else NONE - 1
    any = false
    for a in u32(f.params)..<u32(ns):
        u32 k = o.rdef[a]
        if k >= NONE - 1 || (f.slot_flags[a] & ir.S_USER) == 0 || !rec_h(o, f.slot_ty[a]): continue
        u32 i = k
        if f.op[k] == ir.O_SET && bare(o, f.a[k]) && (f.root[f.a[k]] & ir.ROOT_GLOBAL) == 0: i = origin(o, f.a[k])
        if i == NONE || f.op[i] != ir.O_CALL: continue
        u32 c = callee(o, i)
        if c == NONE || o.rrets[c] != 0: continue
        bool ok = true
        for e in o.rgs[c]:
            if e.kind == G_ANS || e.kind == G_HOLDS: ok = false
        u32 x = NONE
        for e in o.rsums[c][i64(o.rm2[c])..<#len(o.rsums[c])]:
            if e.verb != A_PLACED && e.verb != A_UNDER: continue
            if x != NONE || e.verb != A_UNDER || e.i != NONE: ok = false
            x = u32(e.lo)
            if ok && (o.rrets1[c] & ~(u64(1) << u64(e.j & 63))) != 0: ok = false
            if ok:
                []u32 xs = ir.args(f, i)
                bool deref = false
                u32 b = NONE
                if e.j < u32(#len(xs)): b = arg_base(o, xs[e.j], &deref)
                if b == NONE: ok = false
                else:
                    o.rbase[a] = b
                    o.rderef[a] = deref
                    o.rslo[a] = u32(#len(o.rsx))
                    for y in o.rsfx[c][i64(e.lo)..<i64(e.hi)]:
                        o.rsx = #append(o.rsx, y)
                    o.rshi[a] = u32(#len(o.rsx))
        if !ok || x == NONE: o.rbase[a] = NONE
        else: any = true
    if !any:
        #truncate(o.rbase, 0)
        return
    // Nothing moves, rebinds or lets a callee change what it holds.
    for i in 0..<ir.count(f):
        u8 op = f.op[i]
        if op == ir.O_MOVE: rec_drop(o, f.a[i])
        else if op == ir.O_ADDR:
            u32 d = f.dst[i]
            if d == NONE || ir.is_const(d) || (f.root[d] & ir.ROOT_GLOBAL) != 0 || (f.slot_flags[f.root[d]] & ir.S_TEMP) == 0: rec_drop(o, f.a[i])
        else if op == ir.O_CALL_INDIRECT:
            for y in ir.args(f, i):
                u32 m = origin(o, y)
                if m != NONE && f.op[m] == ir.O_ADDR: rec_drop(o, f.a[m])
        else if op == ir.O_CALL:
            u32 c = callee(o, i)
            []u32 xs = ir.args(f, i)
            for j in 0..<#len(xs):
                u32 m = origin(o, xs[j])
                if m == NONE || f.op[m] != ir.O_ADDR: continue
                u32 q = f.a[m]
                if q == NONE || ir.is_const(q) || (f.root[q] & ir.ROOT_GLOBAL) != 0 || o.rbase[f.root[q]] == NONE: continue
                bool bad = c == NONE || j >= 64 || ((o.rgrows[c] | o.rfrees[c]) >> u64(j)) & 1 != 0
                if !bad:
                    for e in o.rsums[c]:
                        if e.j == u32(j) && e.verb != A_PLACED && e.verb != A_UNDER: bad = true
                if bad: rec_drop(o, q)

private void rec_drop(^Own o, u32 p):
    if p == NONE || ir.is_const(p) || (o.f.root[p] & ir.ROOT_GLOBAL) != 0: return
    u32 r = o.f.root[p]
    if r < u32(#len(o.rbase)): o.rbase[r] = NONE

// Record local `a`'s answer place as parameter `r^` + fields `sx`.
private bool rec_path(^Own o, u32 a, ^u32 r, ^ref []u32 sx):
    ^ir.Fn f = o.f
    u32 b = o.rbase[a]
    bool whole = o.rderef[a] && bare(o, b) && f.root[b] < f.params
    u32 sr = f.root[b] if whole else ptr_root(o, b)
    if sr == NONE: return false
    if !whole: tail(o, b, sx)
    if o.rderef[a] && !whole: sx^ = #append(sx^, D_STEP)
    for k in o.rslo[a]..<o.rshi[a]:
        sx^ = #append(sx^, o.rsx[k])
    r^ = sr
    return true

// A record answer read through a `^` parameter (`return w.p.files[i].a`):
// A_UNDER the fields down to the first index or `^` (P10i); every record
// answer so, or none.
private void rec_answers(^Own o):
    ^ir.Fn f = o.f
    ref []u32 rj
    ref []u32 lo
    ref []u32 xs
    bool ok = true
    for i in 0..<ir.count(f):
        if f.op[i] != ir.O_RETURN: continue
        u32 rv = f.a[i]
        if rv == NONE || ir.is_const(rv) || !rec_h(o, f.place_ty[rv]): continue
        u32 r = f.root[rv]
        if (r & ir.ROOT_GLOBAL) != 0:
            ok = false
            break
        lo = #append(lo, u32(#len(xs)))
        if bare(o, rv) && r < u32(#len(o.rbase)) && o.rbase[r] != NONE:
            u32 r2 = NONE
            ref []u32 sx
            if rec_path(o, r, &r2, &sx):
                rj = #append(rj, r2)
                for y in sx[..<to_step(&sx)]:
                    xs = #append(xs, y)
            else: ok = false
            #delete(sx)
            if !ok: break
            continue
        if r >= f.params: r = o.alias[r]
        if r == NONE || r >= f.params || f.plo[rv] == f.phi[rv] || f.step[f.plo[rv]] != ir.ST_DEREF:
            ok = false
            break
        rj = #append(rj, r)
        for j in f.plo[rv] + 1..<f.phi[rv]:
            if f.step[j] != ir.ST_FIELD: break
            xs = #append(xs, f.step_val[j])
    lo = #append(lo, u32(#len(xs)))
    if ok:
        for k in 0..<#len(rj):
            push(o, Sum(o.cur, NONE, rj[k], A_UNDER, 0, 0), xs[i64(lo[k])..<i64(lo[k + 1])])
    #delete(rj)
    #delete(lo)
    #delete(xs)

// View fields `R.F` that view nothing under their own `R` (P10i): R reaches
// no pointer and no handle holding handles or pointers; every store into
// `.F` is a parameter stored into a local R by fields (made before any
// block of that R); every handle under an R, or under what `&` lends out of
// one, is written only fresh or grown in place. Then moves through `^R`
// never reach what `.F` views. In a library only for a `private` R: values
// of a private type originate in its package (P10j); a public R a caller
// outside may build.
private void foreign_fields(^Own o):
    ^check.World w = o.w
    o.ff_on = true
    if w.library:
        // Shapes every type naming them keeps private: 1; else 2.
        for d in w.decls:
            if !check.typeish(d.kind) || d.ty == NONE: continue
            u32 r = w.t.resolve(d.ty)
            if r == NONE: continue
            // `private` (package or file); a foreign or script type: not so.
            bool pv = false
            if d.kind == check.K_TYPE || d.kind == check.K_UNION || d.kind == check.K_ENUM:
                u32 vis = w.p.files[d.file].a.a[d.node] & syntax.F_VIS
                pv = vis == syntax.VIS_PACKAGE || vis == syntax.VIS_FILE
            if !pv: o.ffpriv[r] = 2
            else if !(r in o.ffpriv): o.ffpriv[r] = 1
    {u64: u8} pmemo
    {u64: u8} eseen
    ref []u32 def
    ref []u32 tys
    for i in 0..<#len(w.fns):
        ^ir.Fn f = &w.fns[i]
        #truncate(def, 0)
        for _ in 0..<#len(f.slot_ty):
            def = #append(def, NONE)
        for k in 0..<ir.count(f):
            u32 d = f.dst[k]
            if d != NONE && !ir.is_const(d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && f.plo[d] == f.phi[d]: def[f.root[d]] = k
        for k in 0..<ir.count(f):
            u8 op = f.op[k]
            if op == ir.O_MAKE: o.ffbad[w.t.resolve(f.ty_of[k])] = 1
            if op == ir.O_ADDR && f.a[k] != NONE && !ir.is_const(f.a[k]):
                u32 x = f.a[k]
                u64 lf = path_tys(o, f, x, &tys)
                if lf != NO_FIELD:
                    o.ffcand[lf] = 2
                u32 u = w.t.resolve(f.place_ty[x])
                u32 ad = f.dst[k]
                // `&` of a handle: only into calls that grow it in place.
                if u != NONE && is_handle(&w.t, u) && (ad == NONE || ir.is_const(ad) || (f.root[ad] & ir.ROOT_GLOBAL) != 0 || (f.slot_flags[f.root[ad]] & ir.S_TEMP) == 0):
                    for t in tys:
                        o.ffbad[t] = 1
                else if u != NONE && holds_h(o, u) && !is_handle(&w.t, u):
                    for t in tys:
                        u64 key = (u64(t) << 32) | u64(u)
                        if t != u && !(key in eseen):
                            eseen[key] = 1
                            o.ffedges = #append(o.ffedges, key)
            if op == ir.O_CALL || op == ir.O_CALL_INDIRECT:
                []u32 xs = ir.args(f, k)
                for j in 0..<#len(xs):
                    u32 y = xs[j]
                    if y == NONE || ir.is_const(y) || f.plo[y] != f.phi[y] || (f.root[y] & ir.ROOT_GLOBAL) != 0: continue
                    u32 m = def[f.root[y]]
                    if m == NONE || f.op[m] != ir.O_ADDR || ir.is_const(f.a[m]) || !is_handle(&w.t, f.place_ty[f.a[m]]): continue
                    if op == ir.O_CALL && grows_only(o, &pmemo, callee_fn(o, f, k), u32(j)): continue
                    _ = path_tys(o, f, f.a[m], &tys)
                    for t in tys:
                        o.ffbad[t] = 1
            u32 d = f.dst[k]
            if d == NONE || ir.is_const(d) || f.plo[d] == f.phi[d]: continue
            u64 lf = path_tys(o, f, d, &tys)
            if holds_h(o, f.place_ty[d]) && !fresh_write(o, f, def[:], k):
                for t in tys:
                    o.ffbad[t] = 1
            if lf == NO_FIELD: continue
            bool ok = op == ir.O_SET && (f.root[d] & ir.ROOT_GLOBAL) == 0 && f.root[d] >= f.params
            for j in f.plo[d]..<f.phi[d]:
                if f.step[j] != ir.ST_FIELD: ok = false
            u32 a = f.a[k]
            if ok && !ir.is_const(a) && !(a != NONE && f.plo[a] == f.phi[a] && (f.root[a] & ir.ROOT_GLOBAL) == 0 && f.root[a] < f.params): ok = false
            if !(lf in o.ffcand): o.ffcand[lf] = 1
            if !ok: o.ffcand[lf] = 2
    #delete(def)
    #delete(tys)

// Whether view field `key` (R << 32 | F) is one `foreign_fields` allows:
// no store refused, R's shape, and no type `&` lends out of R written
// otherwise.
private bool ff_valid(^Own o, u64 key):
    if key in o.ffield:
        try u8 m = o.ffield[key] else: return false
        return m == 1
    bool ok = true
    if key in o.ffcand:
        try u8 v = o.ffcand[key] else: return false
        if v != 1: ok = false
    u32 r = u32(key >> 32)
    if ok && (r in o.ffbad || !rec_ok(o, r, false, 0)): ok = false
    if ok && o.w.library:
        u8 pv = 2
        if r in o.ffpriv:
            try pv = o.ffpriv[r] else: pass
        if pv != 1: ok = false
    if ok:
        ref []u32 seen
        seen = #append(seen, r)
        i64 q = 0
        for q < #len(seen) && ok:
            for e in o.ffedges:
                if u32(e >> 32) != seen[q]: continue
                u32 u = u32(e & 0xFFFFFFFF)
                if u in o.ffbad: ok = false
                if !has_u32(&seen, u): seen = #append(seen, u)
            q += 1
        #delete(seen)
    o.ffield[key] = 1 if ok else 2
    return ok

private const u64 NO_FIELD = 0xFFFFFFFFFFFFFFFF

// Whether body `fi` only grows in place (or freshly rebinds) the handle its
// pointer parameter `j` points at, and keeps that pointer nowhere: through
// its callees too (a cycle counts as so: a greatest fixed point). A "yes"
// found under a cycle's provisional "yes" holds only if the root's does:
// on a root "no" those are dropped (P10j).
private bool grows_only(^Own o, ^{u64: u8} memo, u32 fi, u32 j):
    ref []u64 trail
    bool ok = grows_rec(o, memo, fi, j, 0, &trail)
    if !ok:
        for t in trail:
            u8 v = 0
            if t in memo^:
                try v = memo^[t] else: pass
            if v == 1: #delete(memo^, t)
    #delete(trail)
    return ok

private bool grows_rec(^Own o, ^{u64: u8} memo, u32 fi, u32 j, i64 depth, ^ref []u64 trail):
    if fi == NONE || depth > 32: return false
    u64 key = (u64(fi) << 32) | u64(j)
    if key in memo^:
        try u8 v = memo^[key] else: return false
        return v == 1
    ^ir.Fn f = &o.w.fns[fi]
    if j >= f.params: return false
    memo^[key] = 1
    trail^ = #append(trail^, key)
    ref []u32 def
    for _ in 0..<#len(f.slot_ty):
        def = #append(def, NONE)
    for k in 0..<ir.count(f):
        u32 d = f.dst[k]
        if d != NONE && !ir.is_const(d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && f.plo[d] == f.phi[d]: def[f.root[d]] = k
    bool ok = true
    for k in 0..<ir.count(f):
        if !ok: break
        u8 op = f.op[k]
        u32 d = f.dst[k]
        if d != NONE && !ir.is_const(d) && (f.root[d] & ir.ROOT_GLOBAL) == 0 && copy_root(f, def[:], f.root[d]) == j && f.plo[d] < f.phi[d] && holds_h(o, f.place_ty[d]) && !fresh_write(o, f, def[:], k): ok = false
        u32 a = f.a[k]
        bool pa = (op == ir.O_SET || op == ir.O_RETURN) && a != NONE && !ir.is_const(a) && f.plo[a] == f.phi[a] && (f.root[a] & ir.ROOT_GLOBAL) == 0 && copy_root(f, def[:], f.root[a]) == j
        if op == ir.O_SET && pa && d != NONE && !ir.is_const(d) && (f.plo[d] != f.phi[d] || (f.root[d] & ir.ROOT_GLOBAL) != 0): ok = false
        if op == ir.O_RETURN && pa: ok = false
        if op == ir.O_CALL || op == ir.O_CALL_INDIRECT || op == ir.O_MAKE:
            []u32 xs = ir.args(f, k)
            for y in 0..<#len(xs):
                u32 x = xs[y]
                if x == NONE || ir.is_const(x) || f.plo[x] != f.phi[x] || (f.root[x] & ir.ROOT_GLOBAL) != 0 || copy_root(f, def[:], f.root[x]) != j: continue
                if op != ir.O_CALL || !grows_rec(o, memo, callee_fn(o, f, k), u32(y), depth + 1, trail): ok = false
    #delete(def)
    memo^[key] = 1 if ok else 2
    return ok

// The types place `x` passes through (each step's own, and what a last `^`
// reaches), resolved, into `tys`; its last step as `R << 32 | F` when that
// is a view field of a record, else NO_FIELD.
private u64 path_tys(^Own o, ^ir.Fn f, u32 x, ^ref []u32 tys):
    #truncate(tys^, 0)
    u32 r = f.root[x]
    u32 t = f.glob_ty[r & ~ir.ROOT_GLOBAL] if (r & ir.ROOT_GLOBAL) != 0 else f.slot_ty[r]
    u64 lf = NO_FIELD
    for j in f.plo[x]..<f.phi[x]:
        u32 rt = o.w.t.resolve(t)
        if rt == NONE: return NO_FIELD
        tys^ = #append(tys^, rt)
        lf = NO_FIELD
        u8 st = f.step[j]
        if st == ir.ST_FIELD:
            if o.w.t.tag[rt] != types.T_TUPLE: return NO_FIELD
            t = slot_t(o, rt, f.step_val[j])
            if t != NONE && is_view(&o.w.t, t) && !is_ptr(&o.w.t, t) && o.w.t.tag[o.w.t.resolve(t)] != types.T_TRAIT: lf = (u64(rt) << 32) | u64(f.step_val[j])
        else if st == ir.ST_DEREF:
            t = pointee(o, rt)
            if j + 1 == f.phi[x] && t != NONE: tys^ = #append(tys^, o.w.t.resolve(t))
        else: t = elem_ty(o, rt)
        if t == NONE: return lf
    return lf

private u32 elem_ty(^Own o, u32 rt):
    u8 tg = o.w.t.tag[rt]
    if tg == types.T_SLICE || tg == types.T_REF || tg == types.T_SOA: return o.w.t.a[rt]
    if tg == types.T_MAP: return o.w.t.b[rt]
    if tg == types.T_TUPLE:
        []u32 sl = o.w.t.slots(rt)
        if #len(sl) > 0: return sl[0]
    return NONE

// Write op `k` puts a fresh block, or the same place grown, there.
private bool fresh_write(^Own o, ^ir.Fn f, []u32 def, u32 k):
    if f.op[k] != ir.O_SET: return false
    u32 a = f.a[k]
    if ir.is_const(a): return true
    if a == NONE || f.plo[a] != f.phi[a] || (f.root[a] & ir.ROOT_GLOBAL) != 0: return false
    u32 m = def[f.root[a]]
    if m == NONE || f.op[m] != ir.O_INTRINSIC: return false
    u8 sb = f.sub[m]
    if sb == check.B_MAKE || sb == check.B_COPY: return true
    if sb != check.B_APPEND && sb != check.B_RESERVE && sb != check.B_RESIZE && sb != check.B_TRUNCATE: return false
    []u32 xs = ir.args(f, m)
    return #len(xs) > 0 && same_place(f, def, xs[0], f.dst[k])

// Places `p` and `q` are one: the same steps from one root, through copies.
private bool same_place(^ir.Fn f, []u32 def, u32 p, u32 q):
    if p == NONE || q == NONE || ir.is_const(p) || ir.is_const(q) || f.phi[p] - f.plo[p] != f.phi[q] - f.plo[q]: return false
    for j in 0..<f.phi[p] - f.plo[p]:
        if f.step[f.plo[p] + j] != f.step[f.plo[q] + j] || f.step_val[f.plo[p] + j] != f.step_val[f.plo[q] + j]: return false
    return copy_root(f, def, f.root[p]) == copy_root(f, def, f.root[q])

private u32 copy_root(^ir.Fn f, []u32 def, u32 r):
    u32 x = r
    for _ in 0..<8:
        if (x & ir.ROOT_GLOBAL) != 0: return x
        u32 m = def[x]
        if m == NONE || f.op[m] != ir.O_SET: return x
        u32 a = f.a[m]
        if a == NONE || ir.is_const(a) || f.plo[a] != f.phi[a]: return x
        x = f.root[a]
    return x

// Whether a record of type `t` reaches no pointer (`plain`: nor any handle)
// by its slots and its views' and handles' elements.
private bool rec_ok(^Own o, u32 t, bool plain, i64 depth):
    u32 r = o.w.t.resolve(t)
    if r == NONE || depth > 8: return false
    if r == types.STRING8: return true
    u8 tg = o.w.t.tag[r]
    if tg == types.T_TUPLE:
        for x in o.w.t.slots(r):
            if !rec_ok(o, x, plain, depth + 1): return false
        return true
    if tg == types.T_SLICE: return rec_ok(o, o.w.t.a[r], true, depth + 1)
    if tg == types.T_REF: return !plain && rec_ok(o, o.w.t.a[r], true, depth + 1)
    return !carries(o, r)

// Place `x` (of this body) reads through a view field `foreign_fields` found.
private bool via_ff(^Own o, u32 x):
    if !o.ff_on: return false
    ^ir.Fn f = o.f
    for #len(o.pfm) < #len(f.root):
        o.pfm = #append(o.pfm, 0)
    if o.pfm[x] != 0: return o.pfm[x] == 2
    bool hit = false
    u32 r = f.root[x]
    u32 t = f.glob_ty[r & ~ir.ROOT_GLOBAL] if (r & ir.ROOT_GLOBAL) != 0 else f.slot_ty[r]
    for j in f.plo[x]..<f.phi[x]:
        u32 rt = o.w.t.resolve(t)
        if rt == NONE: break
        u8 st = f.step[j]
        if st == ir.ST_FIELD:
            if o.w.t.tag[rt] != types.T_TUPLE: break
            t = slot_t(o, rt, f.step_val[j])
            if t != NONE && is_view(&o.w.t, t) && !is_ptr(&o.w.t, t) && o.w.t.tag[o.w.t.resolve(t)] != types.T_TRAIT && ff_valid(o, (u64(rt) << 32) | u64(f.step_val[j])):
                hit = true
                break
        else if st == ir.ST_DEREF: t = pointee(o, rt)
        else: break
        if t == NONE: break
    o.pfm[x] = 2 if hit else 1
    return hit

private bool has_i64(^ref []i64 xs, i64 x):
    for y in xs^:
        if y == x: return true
    return false
