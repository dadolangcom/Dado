diff --git a/tests/test_dados_strings.js b/tests/test_dados_strings.js
new file mode 100644
index 0000000..af8d90a
--- /dev/null
+++ b/tests/test_dados_strings.js
@@ -0,0 +1,47 @@
+// DadoScript fork (F1-F3): join of flat strings, forward indexOf, and === on
+// strings must equal their generic definitions.
+import { assert } from "./assert.js";
+
+function naiveJoin(a, sep) {
+    sep = sep === undefined ? "," : String(sep);
+    let r = "";
+    for (let i = 0; i < a.length; i++) {
+        if (i > 0) r += sep;
+        const e = a[i];
+        if (e !== null && e !== undefined) r += String(e);
+    }
+    return r;
+}
+function naiveIndexOf(h, n, from) {
+    from = Math.min(Math.max(from | 0, 0), h.length);
+    for (let i = from; i + n.length <= h.length; i++)
+        if (h.substring(i, i + n.length) == n) return i;
+    return -1;
+}
+const cases = [[], ["a"], ["a", "b"], ["αβ", "x"], ["x", "世"], ["", ""],
+    ["a", 1, "b"], ["a", null, undefined, "b"], ["a", { toString() { return "Z"; } }],
+    ["é", "e"], new Array(3), ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"]];
+const seps = [undefined, ",", "", "--", "✓", "ab世", "é"];
+for (const c of cases)
+    for (const s of seps)
+        assert(c.join(s), naiveJoin(c, s), JSON.stringify([c, s]));
+
+const hays = ["the quick brown fox jumps over the lazy dog éé end",
+    "wide 世界 text 世 again 世界", "", "aaaaab"];
+const needles = ["the", "fox", "dog", "end", "x", "", "é", "é e", "zz", "t",
+    "世界", "世 a", " ", "aab", "b", "aaaaab", "aaaaaab"];
+for (const h of hays)
+    for (const n of needles)
+        for (const f of [undefined, 0, 1, 5, 100, -3])
+            assert(h.indexOf(n, f), naiveIndexOf(h, n, f), JSON.stringify([h, n, f]));
+
+const a = "abcdefghijklmnopqrst", b = "abcdefghijklmnopqrs".concat("t");
+const c = "abc".concat("世");
+assert(a === b, true);
+assert(a !== b, false);
+assert(a === c, false);
+assert(c === "abc世", true);
+assert(c !== "abc世", false);
+assert(a === 1, false);
+assert(("x" + "y") === "xy", true);
+assert("é" === "é".concat(""), true);
