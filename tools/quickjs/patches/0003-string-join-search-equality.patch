+/* DadoScript fork (F1): join n flat strings with separator c (a Latin-1 char) or
+   sep (when c < 0). Returns JS_UNDEFINED when an element is not a flat
+   string (the caller then takes the generic path), JS_EXCEPTION on OOM. */
+static JSValue js_array_join_strings(JSContext *ctx, JSValue *arr, uint32_t n,
+                                     int c, JSString *sep)
+{
+    uint64_t total = 0;
+    int wide = sep && c < 0 ? sep->is_wide_char : 0;
+    uint32_t i, seplen = c >= 0 ? 1 : sep->len, pos;
+    JSString *r;
+
+    for (i = 0; i < n; i++) {
+        JSString *e;
+        if (JS_VALUE_GET_TAG(arr[i]) != JS_TAG_STRING)
+            return JS_UNDEFINED;
+        e = JS_VALUE_GET_STRING(arr[i]);
+        total += e->len;
+        wide |= e->is_wide_char;
+    }
+    if (n > 1)
+        total += (uint64_t)seplen * (n - 1);
+    if (total > JS_STRING_LEN_MAX)
+        return JS_UNDEFINED; /* the generic path throws the right error */
+    r = js_alloc_string(ctx, total, wide);
+    if (!r)
+        return JS_EXCEPTION;
+    pos = 0;
+    for (i = 0; i < n; i++) {
+        JSString *e = JS_VALUE_GET_STRING(arr[i]);
+        uint32_t j;
+        if (i > 0) {
+            if (c >= 0) {
+                if (wide) str16(r)[pos] = c; else str8(r)[pos] = c;
+                pos++;
+            } else {
+                if (!wide)
+                    memcpy(str8(r) + pos, str8(sep), seplen);
+                else if (sep->is_wide_char)
+                    memcpy(str16(r) + pos, str16(sep), seplen * 2);
+                else
+                    for (j = 0; j < seplen; j++) str16(r)[pos + j] = str8(sep)[j];
+                pos += seplen;
+            }
+        }
+        if (!wide)
+            memcpy(str8(r) + pos, str8(e), e->len);
+        else if (e->is_wide_char)
+            memcpy(str16(r) + pos, str16(e), e->len * 2);
+        else
+            for (j = 0; j < e->len; j++) str16(r)[pos + j] = str8(e)[j];
+        pos += e->len;
+    }
+    if (!wide)
+        str8(r)[pos] = '\0';
+    return JS_MKPTR(JS_TAG_STRING, r);
+}
+
 static JSValue js_array_join(JSContext *ctx, JSValueConst this_val,
                              int argc, JSValueConst *argv, int toLocaleString)
 {
@@ -44350,6 +44435,19 @@ static JSValue js_array_join(JSContext *ctx, JSValueConst this_val,
         else
             c = -1;
