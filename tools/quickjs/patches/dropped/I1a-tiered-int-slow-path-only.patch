From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: S2a lab <s2a@lab>
Date: Wed, 30 Sep 2026 12:00:00 +0000
Subject: [PATCH] Tiered TOYS int opcodes (i64, wrapping, canonical tiers)

TOYS fork patch I1 (additive; on 0002). TOYS `int` is exactly i64,
wrapping at 2^63, held in the smallest of three canonical tiers:
(1) the int32 tag; (2) a float64, exact, for 2^31 <= |v| <= 2^53 - 1;
(3) a BigInt beyond (asIntN(64)).

With JS_EVAL_FLAG_TOYS, __toys_int_add, __toys_int_sub and
__toys_int_mul compile to three new sub-opcodes of OP_toys_op2 (no
opcode slot is left: 252-254 are 0002's). The int32 x int32 path is
OP_add's fast path; any other operand, or a result outside int32,
goes to toys_int_arith_slow: both operands to i64 (a BigInt mod 2^64,
a float64 only when integral and safe, anything else TypeError), the
wrapping operation in uint64, and toys_int_canon picks the tier.

The web glue defines the same names as ordinary functions ("f64 with
an exactness check", falling back to BigInt.asIntN(64)); the test is
toys-lab/quickjs-ng/test/int-tiers.js.
---
 quickjs.c | 98 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 98 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index 474aabe..f2e92be 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -18078,8 +18078,23 @@ enum {
     TOYS_OP2_SUB64,    /* __toys_sub64(a, b) BigInt.asIntN(64, a - b) */
     TOYS_OP2_MUL64,    /* __toys_mul64(a, b) BigInt.asIntN(64, a * b) */
     TOYS_OP2_ADD_I32,  /* __toys_add32(a, b) (a + b) | 0 */
+    TOYS_OP2_INT_ADD,  /* __toys_int_add(a, b) TOYS int a + b: i64, wrapping, tiered */
+    TOYS_OP2_INT_SUB,  /* __toys_int_sub(a, b) TOYS int a - b */
+    TOYS_OP2_INT_MUL,  /* __toys_int_mul(a, b) TOYS int a * b */
     TOYS_OP2_COUNT
 };
+/* TOYS fork (I1): TOYS `int` is exactly i64, wrapping at 2^63, held in the
+   smallest of three canonical tiers: (1) the int32 tag; (2) a float64, exact,
+   for 2^31 <= |v| <= 2^53 - 1; (3) a BigInt (asIntN(64)) beyond. */
+static JSValue toys_int_canon(JSContext *ctx, int64_t r)
+{
+    if (likely(r == (int32_t)r))
+        return js_int32((int32_t)r);
+    if (r >= -(((int64_t)1 << 53) - 1) && r <= (((int64_t)1 << 53) - 1))
+        return js_float64((double)r);
+    return JS_NewBigInt64(ctx, r);
+}
+static int toys_int_arith_slow(JSContext *ctx, JSValue *sp, int sub);
 #define TOYS_APPLY_MAGIC 0x7000 /* OP_apply operand carrying an intrinsic to phase 3 */
 static double js_math_fround(double a);
 static JSValue js_bigint_asUintN(JSContext *ctx, JSValueConst this_val,
@@ -21083,6 +21098,30 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
                         goto exception;
                     sp--;
                     goto toys_to_i32;
+                /* TOYS fork (I1): tiered int. The int32 x int32 path is OP_add's;
+                   everything else (tier 2 or 3 operands, a result past 2^53)
+                   goes through toys_int_arith_slow. */
+#define TOYS_INT_CASE(SUB, EXPR)                                            \
+                case SUB:                                                   \
+                    if (likely(JS_VALUE_IS_BOTH_INT(op1, op2))) {           \
+                        int64_t a64 = JS_VALUE_GET_INT(op1);                \
+                        int64_t b64 = JS_VALUE_GET_INT(op2);                \
+                        int64_t r64 = EXPR;                                 \
+                        if (likely(r64 == (int32_t)r64)) {                  \
+                            sp[-2] = js_int32((int32_t)r64);                \
+                            sp--;                                           \
+                            BREAK;                                          \
+                        }                                                   \
+                    }                                                       \
+                    sf->cur_pc = pc;                                        \
+                    if (toys_int_arith_slow(ctx, sp, SUB))                  \
+                        goto exception;                                     \
+                    sp--;                                                   \
+                    BREAK;
+                TOYS_INT_CASE(TOYS_OP2_INT_ADD, a64 + b64)
+                TOYS_INT_CASE(TOYS_OP2_INT_SUB, a64 - b64)
+                TOYS_INT_CASE(TOYS_OP2_INT_MUL, a64 * b64)
+#undef TOYS_INT_CASE
                 case TOYS_OP2_ADD64:
                 case TOYS_OP2_SUB64:
                 case TOYS_OP2_MUL64:
@@ -24268,6 +24307,9 @@ static const struct { const char *name; uint8_t arity, sub; } toys_intrinsics[]
     { "__toys_sub64", 2, TOYS_OP2_SUB64 },
     { "__toys_mul64", 2, TOYS_OP2_MUL64 },
     { "__toys_add32", 2, TOYS_OP2_ADD_I32 },
+    { "__toys_int_add", 2, TOYS_OP2_INT_ADD },
+    { "__toys_int_sub", 2, TOYS_OP2_INT_SUB },
+    { "__toys_int_mul", 2, TOYS_OP2_INT_MUL },
 };
 
 /* returns the index in toys_intrinsics[], or -1 */
@@ -24287,6 +24329,62 @@ static int toys_intrinsic_find(JSContext *ctx, JSAtom name)
     return -1;
 }
 
+/* TOYS fork (I1): an operand of a tiered-int opcode as an i64. Tiers 1 and 2
+   are exact; a BigInt is taken mod 2^64 (exact for a canonical tier 3 value).
+   Anything else is not a TOYS int: toyc never emits one, and the web
+   definition (a + b on a number and a BigInt) throws TypeError too. */
+static int toys_int_get(JSContext *ctx, int64_t *pres, JSValueConst v)
+{
+    switch (JS_VALUE_GET_TAG(v)) {
+    case JS_TAG_INT:
+        *pres = JS_VALUE_GET_INT(v);
+        return 0;
+    case JS_TAG_SHORT_BIG_INT:
+    case JS_TAG_BIG_INT:
+        return JS_ToBigInt64(ctx, pres, v);
+    default:
+        if (JS_TAG_IS_FLOAT64(JS_VALUE_GET_TAG(v))) {
+            double d = JS_VALUE_GET_FLOAT64(v);
+            if (d >= -9007199254740991.0 && d <= 9007199254740991.0 && d == (double)(int64_t)d) {
+                *pres = (int64_t)d;
+                return 0;
+            }
+        }
+        JS_ThrowTypeError(ctx, "not a TOYS int");
+        return -1;
+    }
+}
+
+/* sp[-2] = sp[-2] op sp[-1] in i64 (wrapping), canonicalised; frees both */
+static int toys_int_arith_slow(JSContext *ctx, JSValue *sp, int sub)
+{
+    int64_t a, b;
+    uint64_t r;
+    JSValue v;
+    if (toys_int_get(ctx, &a, sp[-2]) || toys_int_get(ctx, &b, sp[-1]))
+        goto fail;
+    if (sub == TOYS_OP2_INT_ADD)
+        r = (uint64_t)a + (uint64_t)b;
+    else if (sub == TOYS_OP2_INT_SUB)
+        r = (uint64_t)a - (uint64_t)b;
+    else
+        r = (uint64_t)a * (uint64_t)b;
+    v = toys_int_canon(ctx, (int64_t)r);
+    if (JS_IsException(v))
+        goto fail;
+    JS_FreeValue(ctx, sp[-2]);
+    JS_FreeValue(ctx, sp[-1]);
+    sp[-2] = v;
+    sp[-1] = JS_UNDEFINED;
+    return 0;
+ fail:
+    JS_FreeValue(ctx, sp[-2]);
+    JS_FreeValue(ctx, sp[-1]);
+    sp[-2] = JS_UNDEFINED;
+    sp[-1] = JS_UNDEFINED;
+    return -1;
+}
+
 static void emit_source_loc_at(JSParseState *s, int line_num, int col_num)
 {
     JSFunctionDef *fd = s->cur_func;
-- 
