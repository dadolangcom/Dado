From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: S2a lab <s2a@lab>
Date: Fri, 25 Sep 2026 15:11:52 -0800
Subject: [PATCH] Strings: remember that an 8-bit string is ASCII (U1b)

DadoScript fork patch U1b (additive field in padding). JS_ToCStringLen scans an
8-bit string to learn whether it is ASCII - its own UTF-8 - on every
crossing. Remember the answer in a 32-bit field that occupies what was
padding before first_weak_ref, so sizeof(JSString) is unchanged on 64-bit
hosts.
---
 quickjs.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index c8a5412..055cac9 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -704,6 +704,10 @@ struct JSString {
     uint32_t kind : 2;
     uint32_t atom_type : 2; /* != 0 if atom, JS_ATOM_TYPE_x */
     uint32_t hash_next; /* atom_index for JS_ATOM_TYPE_SYMBOL */
+    /* DadoScript fork (U1b): set once JS_ToCStringLen has found this 8-bit string
+       to be ASCII (its own UTF-8), so the next crossing skips the scan.
+       Lives in what was padding before first_weak_ref on 64-bit hosts. */
+    uint32_t dados_ascii;
     JSWeakRefRecord *first_weak_ref;
 #ifdef ENABLE_DUMPS // JS_DUMP_LEAKS
     struct list_head link; /* string list */
@@ -2595,6 +2599,7 @@ static JSString *js_alloc_string_rt(JSRuntime *rt, int max_len, int is_wide_char
     str->atom_type = 0;
     str->hash = 0;          /* optional but costless */
     str->hash_next = 0;     /* optional */
+    str->dados_ascii = 0;    /* DadoScript fork (U1b) */
 #ifdef ENABLE_DUMPS // JS_DUMP_LEAKS
     list_add_tail(&str->link, &rt->string_list);
 #endif
@@ -3566,6 +3571,7 @@ static JSAtom __JS_NewAtom(JSRuntime *rt, JSString *str, int atom_type)
             p->is_wide_char = str->is_wide_char;
             p->len = str->len;
             p->kind = JS_STRING_KIND_NORMAL;
+            p->dados_ascii = 0; /* DadoScript fork (U1b) */
 #ifdef ENABLE_DUMPS // JS_DUMP_LEAKS
             list_add_tail(&p->link, &rt->string_list);
 #endif
@@ -3581,6 +3587,7 @@ static JSAtom __JS_NewAtom(JSRuntime *rt, JSString *str, int atom_type)
         p->is_wide_char = 1;    /* Hack to represent NULL as a JSString */
         p->len = 0;
         p->kind = JS_STRING_KIND_NORMAL;
+        p->dados_ascii = 0; /* DadoScript fork (U1b) */
 #ifdef ENABLE_DUMPS // JS_DUMP_LEAKS
         list_add_tail(&p->link, &rt->string_list);
 #endif
@@ -4894,6 +4901,12 @@ const char *JS_ToCStringLen2(JSContext *ctx, size_t *plen, JSValueConst val1,
         const uint8_t *src = str8(str);
         int count;
 
+        if (str->dados_ascii && str->kind == JS_STRING_KIND_NORMAL) { /* DadoScript fork (U1b) */
+            if (plen)
+                *plen = len;
+            return (const char *)src;
+        }
+
         /* count the number of non-ASCII characters */
         /* Scanning the whole string is required for ASCII strings,
            and computing the number of non-ASCII bytes is less expensive
@@ -4905,6 +4918,7 @@ const char *JS_ToCStringLen2(JSContext *ctx, size_t *plen, JSValueConst val1,
             count += src[pos] >> 7;
         }
         if (count == 0 && str->kind == JS_STRING_KIND_NORMAL) {
+            str->dados_ascii = 1; /* DadoScript fork (U1b) */
             if (plen)
                 *plen = len;
             return (const char *)src;
-- 
