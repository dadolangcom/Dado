From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: S2a lab <s2a@lab>
Date: Fri, 25 Sep 2026 14:03:31 -0800
Subject: [PATCH] Map/Set: finalise number and object key hashes so they spread

DadoScript fork patch A1 (additive). map_hash_key hashes a number through its
float64 bits times 3163 and an object through its pointer times 3163;
both leave the low bits, from which the bucket index is taken, nearly
constant, so small integer keys pile into a few buckets (~25x slower
lookups at 1024 keys). Apply a 32-bit avalanche finaliser (lowbias32)
on those two paths. String hashes are unchanged.
---
 quickjs.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index 6ca030b..6f9952d 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -53371,6 +53371,21 @@ static JSValueConst map_normalize_key_const(JSContext *ctx, JSValueConst key)
 }
 
 /* XXX: better hash ? */
+/* DadoScript fork (A1): a 32-bit avalanche finaliser (lowbias32). The bucket index
+   is taken from a hash's low bits; the float64 path (every integer and number
+   key) and the pointer path (every object key, aligned) left those bits nearly
+   constant, so small integer keys piled into a few buckets. String hashes are
+   already mixed and are left alone. */
+static inline uint32_t map_hash_fin(uint32_t h)
+{
+    h ^= h >> 16;
+    h *= 0x7feb352d;
+    h ^= h >> 15;
+    h *= 0x846ca68b;
+    h ^= h >> 16;
+    return h;
+}
+
 static uint32_t map_hash_key(JSContext *ctx, JSValueConst key)
 {
     uint32_t tag = JS_VALUE_GET_NORM_TAG(key);
@@ -53392,6 +53407,7 @@ static uint32_t map_hash_key(JSContext *ctx, JSValueConst key)
     case JS_TAG_OBJECT:
     case JS_TAG_SYMBOL:
         h = (uintptr_t)JS_VALUE_GET_PTR(key) * 3163;
+        h = map_hash_fin(h); /* DadoScript fork (A1) */
         break;
     case JS_TAG_INT:
         d = JS_VALUE_GET_INT(key);
@@ -53411,6 +53427,7 @@ static uint32_t map_hash_key(JSContext *ctx, JSValueConst key)
     hash_float64:
         u.d = d;
         h = (u.u32[0] ^ u.u32[1]) * 3163;
+        h = map_hash_fin(h); /* DadoScript fork (A1) */
         tag = JS_TAG_FLOAT64;
         break;
     default:
