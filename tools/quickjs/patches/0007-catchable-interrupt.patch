From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dado <dado@lab>
Date: Thu, 1 Oct 2026 10:30:00 +0000
Subject: [PATCH] Interrupts: a handler may raise a catchable exception

DadoScript fork patch 0007 (additive; toya0.15 row 1.4's graceful stop). The
interrupt handler can only make the engine throw its uncatchable
"interrupted", which skips every catch and finally - right for a forced
stop and wrong for the polite one before it, which must run a script's
`defer`s and reach its `try`. A handler that has thrown an exception of
its own (JS_Throw) and answers JS_INTERRUPT_RAISE now has that exception
raised, catchable, at the same back-edge or call; any other nonzero answer,
or this one with nothing thrown, interrupts exactly as before. Regular
expressions poll through the same answer.
---
 quickjs.c | 23 +++++++++++++++++++++--
 quickjs.h |  6 ++++++
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/quickjs.c b/quickjs.c
index 45547f1..85e413c 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -382,6 +382,8 @@ struct JSRuntime {
 
     JSInterruptHandler *interrupt_handler;
     void *interrupt_opaque;
+    /* DadoScript fork (0007): the handler's last answer was JS_INTERRUPT_RAISE */
+    bool interrupt_raised;
 
     JSPromiseHook *promise_hook;
     void *promise_hook_opaque;
@@ -8674,16 +8676,33 @@ static JSValue JS_ThrowTypeErrorInvalidClass(JSContext *ctx, int class_id)
 
 static void JS_ThrowInterrupted(JSContext *ctx)
 {
+    JSRuntime *rt = ctx->rt;
+    /* DadoScript fork (0007): a handler that answered JS_INTERRUPT_RAISE has thrown
+       an exception of its own, which is raised as it was thrown - a catch
+       and a finally see it - in place of the uncatchable one. */
+    if (rt->interrupt_raised) {
+        rt->interrupt_raised = false;
+        if (JS_HasException(ctx))
+            return;
+    }
     JS_ThrowInternalError(ctx, "interrupted");
     JS_SetUncatchableError(ctx, ctx->rt->current_exception);
 }
 
+/* DadoScript fork (0007): the handler's answer, remembered for JS_ThrowInterrupted. */
+static int js_call_interrupt_handler(JSRuntime *rt)
+{
+    int r = rt->interrupt_handler(rt, rt->interrupt_opaque);
+    rt->interrupt_raised = (r == JS_INTERRUPT_RAISE);
+    return r;
+}
+
 static no_inline __exception int __js_poll_interrupts(JSContext *ctx)
 {
     JSRuntime *rt = ctx->rt;
     ctx->interrupt_counter = JS_INTERRUPT_COUNTER_INIT;
     if (rt->interrupt_handler) {
-        if (rt->interrupt_handler(rt, rt->interrupt_opaque)) {
+        if (js_call_interrupt_handler(rt)) {
             JS_ThrowInterrupted(ctx);
             return -1;
         }
@@ -50251,7 +50270,7 @@ int lre_check_timeout(void *opaque)
     JSContext *ctx = opaque;
     JSRuntime *rt = ctx->rt;
     return (rt->interrupt_handler &&
-            rt->interrupt_handler(rt, rt->interrupt_opaque));
+            js_call_interrupt_handler(rt));
 }
 
 void *lre_realloc(void *opaque, void *ptr, size_t size)
diff --git a/quickjs.h b/quickjs.h
index 47a1d39..16bf80e 100644
--- a/quickjs.h
+++ b/quickjs.h
@@ -1187,6 +1187,12 @@ JS_EXTERN void JS_SetHostPromiseRejectionTracker(JSRuntime *rt, JSHostPromiseRej
 
 /* return != 0 if the JS code needs to be interrupted */
 typedef int JSInterruptHandler(JSRuntime *rt, void *opaque);
+/* DadoScript fork (0007): what a handler answers when it has thrown an exception of
+   its own (JS_Throw) for the engine to raise, catchable, in place of the
+   uncatchable "interrupted". Raised at the same points an interrupt is; any
+   other nonzero answer interrupts as before, and so does this one when
+   nothing was thrown. */
+#define JS_INTERRUPT_RAISE 2
 JS_EXTERN void JS_SetInterruptHandler(JSRuntime *rt, JSInterruptHandler *cb, void *opaque);
 /* if can_block is true, Atomics.wait() can be used */
 JS_EXTERN void JS_SetCanBlock(JSRuntime *rt, bool can_block);
