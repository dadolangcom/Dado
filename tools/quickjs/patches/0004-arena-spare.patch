From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: S2a lab <s2a@lab>
Date: Fri, 25 Sep 2026 15:17:05 -0800
Subject: [PATCH] Arena allocator: keep one empty arena per size class

DadoScript fork patch A2 (additive). js_arena_free released an arena as soon as
its last block was freed, so a loop that allocates and frees one object
of a size class whose other arenas are full created and destroyed a 4 KB
arena on every iteration (found measuring U1: +59% instructions on a
native-crossing loop after an 8-byte change in string size). Keep one
empty arena per size class as a spare; spares are freed with the
runtime.
---
 quickjs.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index cdb6b6e..c8a5412 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -310,6 +310,7 @@ typedef struct JSArena {
 typedef struct JSArenaState {
     struct list_head arena_list[JS_ARENA_BLOCK_SIZE_COUNT];
     struct list_head free_arena_list[JS_ARENA_BLOCK_SIZE_COUNT];
+    struct JSArena *dados_spare[JS_ARENA_BLOCK_SIZE_COUNT]; /* DadoScript fork (A2): an empty arena kept */
     _Alignas(JS_ARENA_ALIGN) uint8_t zero_size_block[sizeof(JSMallocBlockHeader)];
 } JSArenaState;
 
@@ -1735,6 +1736,7 @@ static void js_arena_init(JSRuntime *rt)
     int i;
     arena_zero_block(rt)->u.block_idx = JS_ARENA_FREE_NIL;
     for (i = 0; i < JS_ARENA_BLOCK_SIZE_COUNT; i++) {
+        s->dados_spare[i] = NULL; /* DadoScript fork (A2) */
         init_list_head(&s->arena_list[i]);
         init_list_head(&s->free_arena_list[i]);
     }
@@ -1825,6 +1827,9 @@ static void *js_arena_malloc(JSRuntime *rt, size_t size)
         } else {
             ar = list_entry(el, JSArena, free_link);
         }
+        if (unlikely(ar->n_used_blocks == 0) &&
+            ar == rt->arena_state.dados_spare[block_size_idx])
+            rt->arena_state.dados_spare[block_size_idx] = NULL; /* DadoScript fork (A2) */
         block_idx = ar->first_free_block;
         b = arena_get_block(ar, block_idx, block_size);
         ar->first_free_block = b->u.free_next;
@@ -1866,6 +1871,14 @@ static void js_arena_free(JSRuntime *rt, void *ptr)
                      &rt->arena_state.free_arena_list[block_size_idx]);
         ar->n_used_blocks--;
         if (unlikely(ar->n_used_blocks == 0)) {
+            /* DadoScript fork (A2): keep one empty arena per size class. Freeing
+               every empty arena made a loop that allocates and frees one
+               object of a size class create and destroy a 4 KB arena on
+               every iteration. The spare is freed with the runtime. */
+            if (!rt->arena_state.dados_spare[block_size_idx]) {
+                rt->arena_state.dados_spare[block_size_idx] = ar;
+                return;
+            }
             list_del(&ar->link);
             list_del(&ar->free_link);
             rt->mf.js_free(rt->malloc_state.opaque, ar);
@@ -1971,6 +1984,7 @@ static void js_arena_free_all(JSRuntime *rt)
             JSArena *ar = list_entry(el, JSArena, link);
             rt->mf.js_free(rt->malloc_state.opaque, ar);
         }
+        s->dados_spare[i] = NULL; /* DadoScript fork (A2) */
         init_list_head(&s->arena_list[i]);
         init_list_head(&s->free_arena_list[i]);
     }
