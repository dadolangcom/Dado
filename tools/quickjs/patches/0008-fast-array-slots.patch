From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dado <dado@lab>
Date: Fri, 2 Oct 2026 12:00:00 +0000
Subject: [PATCH] Arrays: export an Array's own slots (JS_GetFastArray)

DadoScript fork patch 0008 (additive; toya0.17 row 7.2). An embedder copying a
script's Array out reads it today one JS_GetPropertyInt64 at a time, a
property lookup and a reference per element. JS_GetFastArray exports the
engine's own js_get_fast_array: for a fast Array it answers the run of
slots and their count, borrowed until code that could write the array
runs; for anything else (a holey or accessor-bearing array, a Proxy, an
object that is no Array) it answers false and the embedder takes the
property path, so what any script can observe is unchanged. Tested in
api-test.c (get_fast_array).
---
 api-test.c | 46 ++++++++++++++++++++++++++++++++++++++++++++++
 quickjs.c  |  8 ++++++++
 quickjs.h  |  8 ++++++++
 3 files changed, 62 insertions(+)

diff --git a/api-test.c b/api-test.c
index 8a3ce9e..42fdb5b 100644
--- a/api-test.c
+++ b/api-test.c
@@ -370,6 +370,51 @@ static void is_array(void)
     JS_FreeRuntime(rt);
 }
 
+// DadoScript fork (0008): a fast array answers its own slots; a holey or
+// otherwise slow array, a Proxy and a non-array answer false.
+static void get_fast_array(void)
+{
+    JSRuntime *rt = new_runtime();
+    JSContext *ctx = JS_NewContext(rt);
+    JSValue *values = NULL;
+    uint32_t count = 99;
+    {
+        JSValue ret = eval(ctx, "[7, 8.5, 'x']");
+        assert(JS_GetFastArray(ctx, ret, &values, &count));
+        assert(count == 3);
+        assert(JS_VALUE_GET_TAG(values[0]) == JS_TAG_INT);
+        assert(JS_VALUE_GET_INT(values[0]) == 7);
+        assert(JS_VALUE_GET_TAG(values[1]) == JS_TAG_FLOAT64);
+        assert(JS_IsString(values[2]));
+        JS_FreeValue(ctx, ret);
+    }
+    {
+        JSValue ret = eval(ctx, "[]");
+        assert(JS_GetFastArray(ctx, ret, &values, &count));
+        assert(count == 0);
+        JS_FreeValue(ctx, ret);
+    }
+    static const char *const slow[] = {
+        "var a = [1, 2]; a[10] = 3; a",
+        "var b = [1, 2]; Object.defineProperty(b, 0, { get() { return 1; } }); b",
+        "new Proxy([1, 2], {})",
+        "({ length: 2, 0: 1, 1: 2 })",
+        "new Int32Array(2)",
+        "5",
+    };
+    for (size_t i = 0; i < sizeof(slow) / sizeof(slow[0]); i++) {
+        JSValue ret = eval(ctx, slow[i]);
+        assert(!JS_IsException(ret));
+        count = 99;
+        values = NULL;
+        assert(!JS_GetFastArray(ctx, ret, &values, &count));
+        assert(count == 99 && values == NULL);
+        JS_FreeValue(ctx, ret);
+    }
+    JS_FreeContext(ctx);
+    JS_FreeRuntime(rt);
+}
+
 static int loader_calls;
 
 static JSModuleDef *loader(JSContext *ctx, const char *name, void *opaque)
@@ -2203,6 +2248,7 @@ int main(void)
     async_call_stack_overflow();
     raw_context_global_var();
     is_array();
+    get_fast_array();
     module_serde();
     module_unhandled_rejection();
     promise_mark_as_handled();
diff --git a/quickjs.c b/quickjs.c
index 85e413c..5006523 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -17357,6 +17357,14 @@ static bool js_get_fast_array(JSContext *ctx, JSValue obj,
     return false;
 }
 
+/* DadoScript fork (0008): js_get_fast_array, exported for an embedder that
+   copies an Array out in one validated loop. */
+bool JS_GetFastArray(JSContext *ctx, JSValueConst obj, JSValue **values,
+                     uint32_t *count)
+{
+    return js_get_fast_array(ctx, obj, values, count);
+}
+
 static __exception int js_append_enumerate(JSContext *ctx, JSValue *sp)
 {
     JSValue iterator, enumobj, method, value;
diff --git a/quickjs.h b/quickjs.h
index 16bf80e..a30ef64 100644
--- a/quickjs.h
+++ b/quickjs.h
@@ -957,6 +957,14 @@ JS_EXTERN JSValue JS_NewArray(JSContext *ctx);
 // takes ownership of the values
 JS_EXTERN JSValue JS_NewArrayFrom(JSContext *ctx, int count,
                                   const JSValue *values);
+// DadoScript fork (0008): an Array's own slots, when it keeps them as one run
+// (a fast array: no holes, no accessors, no extra indexed properties). On
+// true, *values points at *count elements, borrowed: valid until any code
+// runs that could write the array, so read them and copy out, run nothing.
+// False, and nothing written, for anything else - a slow array, a Proxy,
+// an object that is no Array - which the caller reads property by property.
+JS_EXTERN bool JS_GetFastArray(JSContext *ctx, JSValueConst obj,
+                               JSValue **values, uint32_t *count);
 // reader beware: JS_IsArray used to "punch" through proxies and check
 // if the target object is an array but it no longer does; use JS_IsProxy
 // and JS_GetProxyTarget instead, and remember that the target itself can
