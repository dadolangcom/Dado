From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: S2a lab <s2a@lab>
Date: Wed, 30 Sep 2026 12:00:00 +0000
Subject: [PATCH] Tiered DadoScript int opcodes (i64, wrapping, canonical
 tiers)

DadoScript fork patch I1 (additive; on 0002). DadoScript `int` is exactly i64,
wrapping at 2^63, held in the smallest of three canonical tiers:
(1) the int32 tag; (2) a float64, exact, for 2^31 <= |v| <= 2^53 - 1;
(3) a BigInt beyond (asIntN(64)).

With JS_EVAL_FLAG_DADOS, __dados_int_add, _sub, _mul, _div, _mod and
_and compile to six new sub-opcodes of OP_dados_op2 (no opcode slot is
left: 252-254 are 0002's). Inline paths, each putting the result in
its tier:
- + - *: int32 x int32 is OP_add's path (the i64 result is exact); a
  float64 operand takes the double operation, exact whenever the
  result is within 2^53 - 1 (an integer result rounds monotonically
  and 2^53 is representable). Like the web definition, this path does
  not check that a float64 operand is integral: dadoc's types
  guarantee it.
- / % &: both operands read as i64 (a float64 only when integral and
  within 2^53), the i64 operation (division and remainder truncate).
A BigInt operand, a division by zero, a result past 2^53, or an
operand that is not a number leaves for dados_int_arith_slow: both
operands to i64 (a BigInt mod 2^64, a float64 only when integral and
safe, anything else TypeError), the wrapping operation, x / 0 and
x % 0 raise RangeError, and dados_int_canon picks the tier (allocating
the BigInt).

The web glue defines the same names as ordinary functions ("f64 with
an exactness check", falling back to BigInt.asIntN(64)); the test is
toys-lab/quickjs-ng/test/int-tiers.js.
---
 quickjs.c | 203 ++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 203 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index 055cac9..45547f1 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -18078,8 +18078,48 @@ enum {
     DADOS_OP2_SUB64,    /* __dados_sub64(a, b) BigInt.asIntN(64, a - b) */
     DADOS_OP2_MUL64,    /* __dados_mul64(a, b) BigInt.asIntN(64, a * b) */
     DADOS_OP2_ADD_I32,  /* __dados_add32(a, b) (a + b) | 0 */
+    DADOS_OP2_INT_ADD,  /* __dados_int_add(a, b) DadoScript int a + b: i64, wrapping, tiered */
+    DADOS_OP2_INT_SUB,  /* __dados_int_sub(a, b) DadoScript int a - b */
+    DADOS_OP2_INT_MUL,  /* __dados_int_mul(a, b) DadoScript int a * b */
+    DADOS_OP2_INT_DIV,  /* __dados_int_div(a, b) DadoScript int a / b (truncating; / 0 raises) */
+    DADOS_OP2_INT_MOD,  /* __dados_int_mod(a, b) DadoScript int a % b (sign of a; % 0 raises) */
+    DADOS_OP2_INT_AND,  /* __dados_int_and(a, b) DadoScript int a & b */
     DADOS_OP2_COUNT
 };
+/* DadoScript fork (I1): DadoScript `int` is exactly i64, wrapping at 2^63, held in the
+   smallest of three canonical tiers: (1) the int32 tag; (2) a float64, exact,
+   for 2^31 <= |v| <= 2^53 - 1; (3) a BigInt (asIntN(64)) beyond. */
+#define DADOS_SAFE ((((int64_t)1) << 53) - 1)
+static JSValue dados_int_canon(JSContext *ctx, int64_t r)
+{
+    if (likely(r == (int32_t)r))
+        return js_int32((int32_t)r);
+    if (r >= -(((int64_t)1 << 53) - 1) && r <= (((int64_t)1 << 53) - 1))
+        return js_float64((double)r);
+    return JS_NewBigInt64(ctx, r);
+}
+static int dados_int_arith_slow(JSContext *ctx, JSValue *sp, int sub);
+/* a tier 1 or 2 operand as i64; false for anything else (a BigInt, a
+   float64 that is not an integer within 2^53, a non-number) */
+static inline bool dados_int_get_fast(JSValueConst v, int64_t *pres)
+{
+    double d;
+    int64_t i;
+    if (JS_VALUE_GET_TAG(v) == JS_TAG_INT) {
+        *pres = JS_VALUE_GET_INT(v);
+        return true;
+    }
+    if (!JS_TAG_IS_FLOAT64(JS_VALUE_GET_TAG(v)))
+        return false;
+    d = JS_VALUE_GET_FLOAT64(v);
+    if (!(d >= -(double)DADOS_SAFE && d <= (double)DADOS_SAFE))
+        return false;
+    i = (int64_t)d;
+    if ((double)i != d)
+        return false;
+    *pres = i;
+    return true;
+}
 #define DADOS_APPLY_MAGIC 0x7000 /* OP_apply operand carrying an intrinsic to phase 3 */
 static double js_math_fround(double a);
 static JSValue js_bigint_asUintN(JSContext *ctx, JSValueConst this_val,
@@ -21083,6 +21123,97 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
                         goto exception;
                     sp--;
                     goto dados_to_i32;
+                /* DadoScript fork (I1): tiered int. Each op has inline paths for
+                   operands in tier 1 or 2 (the int tag, or a float64 holding an
+                   integer within 2^53); the result is put in its tier inline.
+                   A BigInt operand, a division by zero or a result past 2^53
+                   leaves for dados_int_arith_slow. */
+#define DADOS_INT_SLOW(SUB)                                                 \
+                SUB ## _slow:                                               \
+                    sf->cur_pc = pc;                                        \
+                    if (dados_int_arith_slow(ctx, sp, SUB))                 \
+                        goto exception;                                     \
+                    sp--;                                                   \
+                    BREAK;
+                /* + - *: int32 x int32 is OP_add's path (the i64 result is
+                   exact); a float64 operand takes the double operation, exact
+                   whenever its result is within 2^53 - 1 (an integer result
+                   rounds monotonically and 2^53 is representable). Like the web
+                   definition, this path does not check that a float64 operand is
+                   integral: dadoc's types guarantee it. */
+#define DADOS_INT_CASE_D(SUB, EXPR, DEXPR)                                  \
+                case SUB:                                                   \
+                    if (likely(JS_VALUE_IS_BOTH_INT(op1, op2))) {           \
+                        int64_t a64 = JS_VALUE_GET_INT(op1);                \
+                        int64_t b64 = JS_VALUE_GET_INT(op2);                \
+                        int64_t r64 = EXPR;                                 \
+                        if (likely(r64 == (int32_t)r64)) {                  \
+                            sp[-2] = js_int32((int32_t)r64);                \
+                        } else if (r64 >= -DADOS_SAFE && r64 <= DADOS_SAFE) { \
+                            sp[-2] = js_float64((double)r64);               \
+                        } else {                                            \
+                            goto SUB ## _slow;                              \
+                        }                                                   \
+                        sp--;                                               \
+                        BREAK;                                              \
+                    } else if ((JS_VALUE_GET_TAG(op1) == JS_TAG_INT ||      \
+                                JS_TAG_IS_FLOAT64(JS_VALUE_GET_TAG(op1))) && \
+                               (JS_VALUE_GET_TAG(op2) == JS_TAG_INT ||      \
+                                JS_TAG_IS_FLOAT64(JS_VALUE_GET_TAG(op2)))) { \
+                        double ad = JS_VALUE_GET_TAG(op1) == JS_TAG_INT ?   \
+                            JS_VALUE_GET_INT(op1) : JS_VALUE_GET_FLOAT64(op1); \
+                        double bd = JS_VALUE_GET_TAG(op2) == JS_TAG_INT ?   \
+                            JS_VALUE_GET_INT(op2) : JS_VALUE_GET_FLOAT64(op2); \
+                        double rd = DEXPR;                                  \
+                        if (rd >= -(double)DADOS_SAFE && rd <= (double)DADOS_SAFE) { \
+                            if (rd >= INT32_MIN && rd <= INT32_MAX &&       \
+                                rd == (double)(int32_t)rd)                  \
+                                sp[-2] = js_int32((int32_t)rd);             \
+                            else                                            \
+                                sp[-2] = js_float64(rd);                    \
+                            sp--;                                           \
+                            BREAK;                                          \
+                        }                                                   \
+                    }                                                       \
+                    DADOS_INT_SLOW(SUB)
+                DADOS_INT_CASE_D(DADOS_OP2_INT_ADD, a64 + b64, ad + bd)
+                DADOS_INT_CASE_D(DADOS_OP2_INT_SUB, a64 - b64, ad - bd)
+                DADOS_INT_CASE_D(DADOS_OP2_INT_MUL, a64 * b64, ad * bd)
+                /* / % &: both operands read as i64 (dados_int_get_fast checks a
+                   float64 is an integer within 2^53), the i64 operation (division
+                   and remainder truncate; a64 is never INT64_MIN here), the
+                   result put in its tier */
+#define DADOS_INT_CASE_I(SUB, EXPR, OK)                                     \
+                case SUB:                                                   \
+                    {                                                       \
+                        int64_t a64, b64, r64;                              \
+                        if (likely(JS_VALUE_IS_BOTH_INT(op1, op2))) {       \
+                            a64 = JS_VALUE_GET_INT(op1);                    \
+                            b64 = JS_VALUE_GET_INT(op2);                    \
+                        } else if (!dados_int_get_fast(op1, &a64) ||        \
+                                   !dados_int_get_fast(op2, &b64)) {        \
+                            goto SUB ## _slow;                              \
+                        }                                                   \
+                        if (unlikely(!(OK)))                                \
+                            goto SUB ## _slow;                              \
+                        r64 = EXPR;                                         \
+                        if (likely(r64 == (int32_t)r64)) {                  \
+                            sp[-2] = js_int32((int32_t)r64);                \
+                        } else if (r64 >= -DADOS_SAFE && r64 <= DADOS_SAFE) { \
+                            sp[-2] = js_float64((double)r64);               \
+                        } else {                                            \
+                            goto SUB ## _slow;                              \
+                        }                                                   \
+                        sp--;                                               \
+                        BREAK;                                              \
+                    }                                                       \
+                    DADOS_INT_SLOW(SUB)
+                DADOS_INT_CASE_I(DADOS_OP2_INT_DIV, a64 / b64, b64 != 0)
+                DADOS_INT_CASE_I(DADOS_OP2_INT_MOD, a64 % b64, b64 != 0)
+                DADOS_INT_CASE_I(DADOS_OP2_INT_AND, a64 & b64, 1)
+#undef DADOS_INT_CASE_D
+#undef DADOS_INT_CASE_I
+#undef DADOS_INT_SLOW
                 case DADOS_OP2_ADD64:
                 case DADOS_OP2_SUB64:
                 case DADOS_OP2_MUL64:
@@ -24268,6 +24399,12 @@ static const struct { const char *name; uint8_t arity, sub; } dados_intrinsics[]
     { "__dados_sub64", 2, DADOS_OP2_SUB64 },
     { "__dados_mul64", 2, DADOS_OP2_MUL64 },
     { "__dados_add32", 2, DADOS_OP2_ADD_I32 },
+    { "__dados_int_add", 2, DADOS_OP2_INT_ADD },
+    { "__dados_int_sub", 2, DADOS_OP2_INT_SUB },
+    { "__dados_int_mul", 2, DADOS_OP2_INT_MUL },
+    { "__dados_int_div", 2, DADOS_OP2_INT_DIV },
+    { "__dados_int_mod", 2, DADOS_OP2_INT_MOD },
+    { "__dados_int_and", 2, DADOS_OP2_INT_AND },
 };
 
 /* returns the index in dados_intrinsics[], or -1 */
@@ -24287,6 +24424,72 @@ static int dados_intrinsic_find(JSContext *ctx, JSAtom name)
     return -1;
 }
 
+/* DadoScript fork (I1): an operand of a tiered-int opcode as an i64. Tiers 1 and 2
+   are exact; a BigInt is taken mod 2^64 (exact for a canonical tier 3 value).
+   Anything else is not a DadoScript int: dadoc never emits one, and the web
+   definition (a + b on a number and a BigInt) throws TypeError too. */
+static int dados_int_get(JSContext *ctx, int64_t *pres, JSValueConst v)
+{
+    switch (JS_VALUE_GET_TAG(v)) {
+    case JS_TAG_INT:
+        *pres = JS_VALUE_GET_INT(v);
+        return 0;
+    case JS_TAG_SHORT_BIG_INT:
+    case JS_TAG_BIG_INT:
+        return JS_ToBigInt64(ctx, pres, v);
+    default:
+        if (JS_TAG_IS_FLOAT64(JS_VALUE_GET_TAG(v))) {
+            double d = JS_VALUE_GET_FLOAT64(v);
+            if (d >= -9007199254740991.0 && d <= 9007199254740991.0 && d == (double)(int64_t)d) {
+                *pres = (int64_t)d;
+                return 0;
+            }
+        }
+        JS_ThrowTypeError(ctx, "not a DadoScript int");
+        return -1;
+    }
+}
+
+/* sp[-2] = sp[-2] op sp[-1] in i64 (wrapping), canonicalised; frees both */
+static int dados_int_arith_slow(JSContext *ctx, JSValue *sp, int sub)
+{
+    int64_t a, b;
+    uint64_t r;
+    JSValue v;
+    if (dados_int_get(ctx, &a, sp[-2]) || dados_int_get(ctx, &b, sp[-1]))
+        goto fail;
+    switch (sub) {
+    case DADOS_OP2_INT_ADD: r = (uint64_t)a + (uint64_t)b; break;
+    case DADOS_OP2_INT_SUB: r = (uint64_t)a - (uint64_t)b; break;
+    case DADOS_OP2_INT_MUL: r = (uint64_t)a * (uint64_t)b; break;
+    case DADOS_OP2_INT_AND: r = (uint64_t)a & (uint64_t)b; break;
+    default: /* DIV, MOD: truncating; INT64_MIN / -1 wraps, as i64 does */
+        if (b == 0) {
+            JS_ThrowRangeError(ctx, "integer division by zero");
+            goto fail;
+        }
+        if (b == -1)
+            r = sub == DADOS_OP2_INT_DIV ? -(uint64_t)a : 0;
+        else
+            r = sub == DADOS_OP2_INT_DIV ? (uint64_t)(a / b) : (uint64_t)(a % b);
+        break;
+    }
+    v = dados_int_canon(ctx, (int64_t)r);
+    if (JS_IsException(v))
+        goto fail;
+    JS_FreeValue(ctx, sp[-2]);
+    JS_FreeValue(ctx, sp[-1]);
+    sp[-2] = v;
+    sp[-1] = JS_UNDEFINED;
+    return 0;
+ fail:
+    JS_FreeValue(ctx, sp[-2]);
+    JS_FreeValue(ctx, sp[-1]);
+    sp[-2] = JS_UNDEFINED;
+    sp[-1] = JS_UNDEFINED;
+    return -1;
+}
+
 static void emit_source_loc_at(JSParseState *s, int line_num, int col_num)
 {
     JSFunctionDef *fd = s->cur_func;
-- 
