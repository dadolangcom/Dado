{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest/1",
  "title": "The build manifest, schema manifest/1",
  "description": "What `dadoc --emit=manifest` writes: the public surface of one build, both dialects. Public declarations only. Hand-written; the gate validates every manifest against it (crates/dadoc/tests/e2e/manifest.rs). A change a reader could notice changes the version in `schema`.",
  "type": "object",
  "required": ["schema", "producer", "package", "target", "dado", "dados"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "description": "The format's name and version. A reader checks it first.",
      "const": "manifest/1"
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "package": {
      "type": "object",
      "required": ["name", "version", "root"],
      "additionalProperties": false,
      "properties": {
        "name": { "description": "What the package is published as: `--package-name=`, or its directory's name, or the root package's.", "type": "string", "minLength": 1 },
        "version": { "description": "`--package-version=`, or 0.0.0.", "type": "string" },
        "root": { "description": "The root package's name, as the compiler knows it.", "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "description": "The target this build was for. Every layout in the document is this target's.",
      "type": "object",
      "required": ["triple", "os", "arch", "pointer_bytes"],
      "additionalProperties": false,
      "properties": {
        "triple": { "description": "`--target=`'s triple, or `-` when none was given.", "type": "string" },
        "os": { "type": "string", "pattern": "^#[A-Z_0-9]+$" },
        "arch": { "type": "string", "pattern": "^#[A-Z_0-9]+$" },
        "pointer_bytes": { "description": "The pointer width layouts were computed for; null when the target's is unknown, and then no layout is stated.", "type": ["integer", "null"], "enum": [4, 8, null] }
      }
    },
    "dado": {
      "type": "object",
      "required": ["header", "functions", "types", "channels"],
      "additionalProperties": false,
      "properties": {
        "header": {
          "description": "What a C header of these exports needs that is the compiler's own C; null for a build that emitted no C (scripts alone).",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/c_header" }]
        },
        "functions": { "type": "array", "items": { "$ref": "#/$defs/dado_function" } },
        "types": { "type": "array", "items": { "$ref": "#/$defs/dado_type" } },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/dado_channel" } }
      }
    },
    "dados": {
      "type": "object",
      "required": ["classes", "functions"],
      "additionalProperties": false,
      "properties": {
        "classes": { "type": "array", "items": { "$ref": "#/$defs/dados_class" } },
        "functions": { "type": "array", "items": { "$ref": "#/$defs/dados_method" } }
      }
    }
  },
  "$defs": {
    "c_header": {
      "type": "object",
      "required": ["guard", "includes", "declarations"],
      "additionalProperties": false,
      "properties": {
        "guard": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
        "includes": { "type": "array", "items": { "type": "string", "pattern": "^(<[^>]+>|\"[^\"]+\")$" } },
        "declarations": { "description": "The C of the string typedefs and of every shape the prototypes name, as `dadoc --emit=h` writes it.", "type": "string" }
      }
    },
    "span": {
      "description": "Where a declaration is named: its file as the compiler names it, 1-based line and column, and the byte range within the file.",
      "type": "object",
      "required": ["file", "line", "column", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "doc": {
      "description": "The `//` lines directly above the declaration, their markers taken off; null for none.",
      "type": ["string", "null"]
    },
    "c_identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "dado_kind": {
      "enum": ["scalar", "c-scalar", "cstring", "pointer", "qualified", "aligned", "string", "slice", "array", "tuple", "map", "union", "c-union", "enum", "distinct", "matrix", "soa", "function", "trait", "opaque", "ref", "other"]
    },
    "dado_type_ref": {
      "description": "A Dado type as a signature names it.",
      "type": "object",
      "required": ["dado", "c", "kind", "decl"],
      "additionalProperties": false,
      "properties": {
        "dado": { "description": "Dado's spelling, by declared names.", "type": "string", "minLength": 1 },
        "c": { "description": "The C spelling.", "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/dado_kind" },
        "decl": { "description": "The `key` of the `dado.types` entry describing it, or null.", "type": ["string", "null"] }
      }
    },
    "dado_function": {
      "description": "A Dado `export`.",
      "type": "object",
      "required": ["dialect", "name", "package", "signature", "returns", "params", "failable", "c", "wasm", "span", "doc"],
      "additionalProperties": false,
      "properties": {
        "dialect": { "const": "dado" },
        "name": { "description": "The body's Dado name.", "type": "string" },
        "package": { "type": "string" },
        "signature": { "description": "Dado's signature, `!` leading a failable one.", "type": "string" },
        "returns": { "$ref": "#/$defs/dado_type_ref" },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "type": { "$ref": "#/$defs/dado_type_ref" }
            }
          }
        },
        "failable": {
          "description": "null for an ordinary export; for a failable one, the code it answers and whether its value goes through a leading destination.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["code", "destination"],
              "additionalProperties": false,
              "properties": {
                "code": { "const": "int32_t" },
                "destination": { "type": "boolean" }
              }
            }
          ]
        },
        "c": {
          "description": "The C ABI: one symbol, one prototype, on every target.",
          "type": "object",
          "required": ["symbol", "abi", "returns", "params", "noreturn", "attributes", "prototype"],
          "additionalProperties": false,
          "properties": {
            "symbol": { "$ref": "#/$defs/c_identifier" },
            "abi": { "const": "c" },
            "returns": { "type": "string", "minLength": 1 },
            "params": {
              "description": "Every C parameter in order — the destination, those Dado wrote, the caller's allocator. Empty is `(void)`.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["role", "type", "name", "unused"],
                "additionalProperties": false,
                "properties": {
                  "role": { "enum": ["destination", "parameter", "caller"] },
                  "type": { "type": "string", "minLength": 1 },
                  "name": { "$ref": "#/$defs/c_identifier" },
                  "unused": { "type": "boolean" }
                }
              }
            },
            "noreturn": { "type": "boolean" },
            "attributes": { "type": "array", "items": { "$ref": "#/$defs/c_identifier" } },
            "prototype": { "description": "The prototype `dadoc --emit=h` writes, failable mark aside.", "type": "string" }
          }
        },
        "wasm": { "description": "On the web, the wasm signature the C ABI gives it; null elsewhere.", "type": ["string", "null"], "pattern": "^\\((i32|i64|f32|f64|,)*\\)->\\((i32|i64|f32|f64|,)*\\)$" },
        "span": { "$ref": "#/$defs/span" },
        "doc": { "$ref": "#/$defs/doc" }
      }
    },
    "dado_type": {
      "description": "A shape a signature reaches.",
      "type": "object",
      "required": ["dialect", "key", "name", "dado", "c", "kind", "layout", "members", "values", "underlying", "span", "doc"],
      "additionalProperties": false,
      "properties": {
        "dialect": { "const": "dado" },
        "key": { "description": "Unique in `dado.types`: the C name, or `<kind> <name>` for a tag that erases.", "type": "string", "minLength": 1 },
        "name": { "description": "The Dado declaration's name, or null for a shape nothing named.", "type": ["string", "null"] },
        "dado": { "type": "string" },
        "c": { "type": "string" },
        "kind": { "$ref": "#/$defs/dado_kind" },
        "layout": {
          "description": "Size and alignment in bytes on `target`, or null where the layout is C's alone.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["size", "align"],
              "additionalProperties": false,
              "properties": {
                "size": { "type": "integer", "minimum": 0 },
                "align": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "c", "count", "offset"],
            "additionalProperties": false,
            "properties": {
              "name": { "description": "The C member designator: `id`, `s`, `ptr`, `payload.m0`.", "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?$" },
              "type": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/dado_type_ref" }] },
              "c": { "type": "string" },
              "count": { "description": "Elements, for an array member.", "type": ["integer", "null"], "minimum": 1 },
              "offset": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        },
        "values": {
          "description": "An enum's members.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "integer" }
            }
          }
        },
        "underlying": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/dado_type_ref" }] },
        "span": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/span" }] },
        "doc": { "$ref": "#/$defs/doc" }
      }
    },
    "dado_channel": {
      "description": "A package-level channel not written `private`.",
      "type": "object",
      "required": ["dialect", "name", "kind", "capacity", "index", "message", "span", "doc"],
      "additionalProperties": false,
      "properties": {
        "dialect": { "const": "dado" },
        "name": { "description": "Qualified: `package.name`.", "type": "string" },
        "kind": { "enum": ["queue", "latest"] },
        "capacity": { "type": "integer", "minimum": 1 },
        "index": { "description": "Its index in the channel directory.", "type": "integer", "minimum": 0 },
        "message": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "dado"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": ["string", "null"] },
              "dado": { "type": "string" }
            }
          }
        },
        "span": { "$ref": "#/$defs/span" },
        "doc": { "$ref": "#/$defs/doc" }
      }
    },
    "ts_type": {
      "description": "A value at the DadoScript boundary, as a JavaScript caller receives it.",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["int", "float", "bool", "string", "byte", "any", "void", "error", "location", "array", "map", "tuple", "enum", "function", "async", "class"] },
        "of": { "$ref": "#/$defs/ts_type" },
        "key": { "$ref": "#/$defs/ts_type" },
        "value": { "$ref": "#/$defs/ts_type" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/ts_type" } },
        "members": { "type": "array", "items": { "type": "string" } },
        "params": { "type": "array", "items": { "$ref": "#/$defs/ts_type" } },
        "returns": { "$ref": "#/$defs/ts_type" },
        "name": { "type": "string" }
      }
    },
    "dados_param": {
      "type": "object",
      "required": ["name", "js_name", "dados", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "js_name": { "type": "string" },
        "dados": { "description": "The DadoScript spelling.", "type": "string" },
        "type": { "$ref": "#/$defs/ts_type" }
      }
    },
    "dados_method": {
      "description": "A published method, or a package function.",
      "type": "object",
      "required": ["dialect", "name", "declared_in", "params", "returns", "dados_returns", "span", "doc"],
      "additionalProperties": false,
      "properties": {
        "dialect": { "const": "dados" },
        "name": { "type": "string" },
        "declared_in": { "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/$defs/dados_param" } },
        "returns": { "$ref": "#/$defs/ts_type" },
        "dados_returns": { "type": "string" },
        "span": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/span" }] },
        "doc": { "$ref": "#/$defs/doc" }
      }
    },
    "dados_class": {
      "description": "An exported DadoScript class.",
      "type": "object",
      "required": ["dialect", "name", "js_name", "package", "constructor", "fields", "methods", "span", "doc"],
      "additionalProperties": false,
      "properties": {
        "dialect": { "const": "dados" },
        "name": { "type": "string" },
        "js_name": { "type": "string" },
        "package": { "type": "string" },
        "constructor": { "type": "array", "items": { "$ref": "#/$defs/dados_param" } },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dialect", "name", "declared_in", "dados", "type", "span", "doc"],
            "additionalProperties": false,
            "properties": {
              "dialect": { "const": "dados" },
              "name": { "type": "string" },
              "declared_in": { "type": "string" },
              "dados": { "type": "string" },
              "type": { "$ref": "#/$defs/ts_type" },
              "span": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/span" }] },
              "doc": { "$ref": "#/$defs/doc" }
            }
          }
        },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/dados_method" } },
        "span": { "$ref": "#/$defs/span" },
        "doc": { "$ref": "#/$defs/doc" }
      }
    }
  }
}
