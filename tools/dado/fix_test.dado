@test
// `dado fix`'s words for `dadoc`: the rewrite named, the flags passed on,
// and here when no path is given.
package driver

import "core:mem/arena"
import "core:mem/libc"

private bool words():
    []string8 nothing
    ref []string8 none = fix_words("append", nothing, false, true)
    bool ok = #expect(#len(none) == 3, "three words, not ", #len(none))
    ok = #expect(none[0] == "--fix=append" && none[1] == "--check" && none[2] == ".", "the default words") && ok
    ref []string8 two = fix_words("append", ["a", "b.dado"], true, false)
    ok = #expect(#len(two) == 4 && two[1] == "--dry-run" && two[2] == "a" && two[3] == "b.dado", "two paths") && ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        if words(): return 0
        return 1
