// Where the toolchain is, and the settings it shares with everything else
// that builds Dado.
//
// **One rule finds the toolchain, in two layouts.** Starting at the directory
// that holds this program's own executable (`os.executable_path`, every
// symlink followed) and walking up, the first directory that holds
// `collections/core` and `tools/dado/defaults` is the root of a checkout of
// the repository, and the first whose `src` holds both is an install, whose
// root is that `src`. A checkout keeps `dadoc` where its build puts it (the
// `DADOC_CANDIDATES` list of `defaults`); an install keeps `dadoc` and
// `dado-lsp` at its top, beside `bin/`, and the pinned zig under
// `zig/<version>/`.
//
// **`defaults` is read, never restated.** The C flags, the sanitizer flags
// and their runtime options and where `dadoc` is looked for are `NAME="value"`
// lines in `tools/dado/defaults` under the root, read once at start; a name
// this program asks for and the file lacks is an error naming the file.
package driver

import "core:os"
import "core:os/fs"
import "core:path"
import "core:strings"

// ── the layout ──────────────────────────────────────────────────────────────

// Which layout the toolchain is in, and where its parts are.
type Layout:
    string8 kind          // "monorepo" or "install"
    string8 root          // the directory holding `collections/core`
    string8 install       // the install's own directory; "" in a checkout
    bool found

// A run of new bytes, read as text. The bytes stay where they were made.
string8 txt(ref []char8 r):
    string8 s = r
    return s

// Whether `p` is a directory.
bool is_dir(string8 p):
    ref []char8 c = strings.clone_to_cstring(p, #default)
    return fs.is_dir(cstring(c))

// Whether `p` is a regular file.
bool is_file(string8 p):
    ref []char8 c = strings.clone_to_cstring(p, #default)
    return fs.is_file(cstring(c))

// Whether anything is at `p`.
bool exists(string8 p):
    ref []char8 c = strings.clone_to_cstring(p, #default)
    return fs.exists(cstring(c))

// `parts` joined and cleaned, as text.
string8 join2(string8 a, string8 b):
    ref []char8 j = path.join(a, b)
    string8 s = j
    return s

string8 join3(string8 a, string8 b, string8 c):
    ref []char8 j = path.join(a, b, c)
    string8 s = j
    return s

// The directory part of `p`, cleaned.
string8 dir_of(string8 p):
    ref []char8 d = path.dir(p)
    string8 s = d
    return s

// Whether `dir` is a toolchain's root: it holds `collections/core` and the
// driver's `tools/dado/defaults`. Both, because a build directory mirrors the
// paths of what it built, and `build/collections/core/...` is the ordinary
// leftover of a test run.
bool is_root(string8 dir):
    return is_dir(join3(dir, "collections", "core")) && is_file(join3(dir, "tools", join2("dado", "defaults")))

// The layout found from `start`, a directory, walking up: the nearest
// ancestor (`start` included) that is a root (`is_root`) is a checkout, and
// the nearest whose `src` is one an install. `found` is false when no
// ancestor is either.
Layout locate(string8 start):
    Layout l
    l.kind = ""
    l.root = ""
    l.install = ""
    l.found = false
    string8 at = start
    for:
        if is_root(at):
            l.kind = "monorepo"
            l.root = at
            l.found = true
            return l
        string8 src = join2(at, "src")
        if is_root(src):
            l.kind = "install"
            l.install = at
            l.root = src
            l.found = true
            return l
        string8 up = dir_of(at)
        if up == at || #len(up) == 0 || up == ".":
            return l
        at = up
    return l

// ── defaults ────────────────────────────────────────────────────────────────

// One `NAME="value"` line of `defaults`.
type Setting:
    string8 name
    string8 value

// `text` read as `defaults` lines: `NAME="value"`, the value running to the
// next `"` and so across lines; blank lines and lines starting `#` are
// skipped. `ok` false, with `why` naming the line, on anything else.
(ref []Setting settings, bool ok, string8 why) parse_defaults(string8 text):
    ref []Setting out = #make([]Setting, 0)
    string8 rest = text
    i64 line_no = 0
    for #len(rest) > 0:
        (string8 line, string8 tail, bool more) = strings.line(rest)
        line_no += 1
        string8 t = strings.trim(line)
        if #len(t) == 0 || t[0] == '#':
            rest = tail
            if !more: break
            continue
        (string8 name, string8 after, bool eq) = strings.split_first(t, "=")
        if !eq || !well_named(name) || #len(after) == 0 || after[0] != '"':
            return (out, false, txt(#format("line ", line_no, " is not NAME=\"value\": ", t)))
        // The value is everything from the opening quote to the next one,
        // which may be lines further on: cut it out of `rest`, not `line`.
        (i64 at, bool inside) = strings.offset_in(rest, after)
        if !inside:
            return (out, false, "the parser lost its place")
        string8 from = rest[at + 1..<#len(rest)]
        i64 close = strings.index_of(from, '"')
        if close < 0:
            return (out, false, txt(#format("line ", line_no, ": the value of ", name, " has no closing quote")))
        string8 value = from[0..<close]
        Setting s
        s.name = name
        s.value = value
        _ = #append(out, s)
        line_no += strings.count_byte(value, '\n')
        string8 after_value = from[close + 1..<#len(from)]
        (string8 _, string8 next, bool more2) = strings.line(after_value)
        rest = next
        if !more2: break
    return (out, true, "")

private bool well_named(string8 name):
    if #len(name) == 0: return false
    for c in name:
        bool ok = (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
        if !ok: return false
    return true

// The value of `name`, and whether `settings` holds it.
(string8 value, bool found) setting_in([]Setting settings, string8 name):
    for s in settings:
        if s.name == name:
            return (s.value, true)
    return ("", false)

// `text` with every `$ROOT` replaced by `root`.
string8 with_root(string8 text, string8 root):
    strings.Builder b = strings.builder(#len(text) + 64)
    string8 rest = text
    for:
        (string8 head, string8 tail, bool found) = strings.split_first(rest, "$ROOT")
        _ = strings.append(&b, head)
        if !found: break
        _ = strings.append(&b, root)
        rest = tail
    ref []char8 done = strings.finish(&b)
    string8 s = done
    return s

// `text`'s whitespace-separated words, in order.
ref []string8 words_of(string8 text):
    ref []string8 out = #make([]string8, 0)
    string8 rest = text
    for:
        (string8 w, string8 tail, bool more) = strings.field(rest)
        if #len(w) > 0:
            _ = #append(out, w)
        if !more: break
        rest = tail
    return out

// `text`'s lines, without their newlines, blank ones dropped.
ref []string8 lines_of(string8 text):
    ref []string8 out = #make([]string8, 0)
    string8 rest = text
    for #len(rest) > 0:
        (string8 l, string8 tail, bool more) = strings.line(rest)
        string8 t = strings.trim(l)
        if #len(t) > 0:
            _ = #append(out, t)
        if !more: break
        rest = tail
    return out

// The `version` line of `ZIG_PIN`'s text: `version 0.16.0`.
string8 pinned_zig(string8 pin):
    for l in lines_of(pin):
        (string8 key, string8 value, bool _) = strings.field(l)
        if key == "version":
            return strings.trim(value)
    return ""

// The suffix of a Markdown document. The driver reads and writes documents (the
// generated pages, the agents' guide), and spells their names with this, so that
// a name it opens is never mistaken for a document it cites.
const string8 MD = ".md"

// The value of an environment variable, and whether it is set and not empty.
(string8 value, bool set) env(string8 name):
    (ref []char8 v, bool found) = os.get_env(name)
    string8 s = v
    return (s, found && #len(s) > 0)
