@test
// The test caches' pure parts: the digest's framing, the slot names and the
// emit key, against values computed independently with Python's `hashlib`
// (each item as eight bytes of little-endian length, then its bytes), and a
// package directory's items over a fake tree.
//
// What is not here, and is exercised by running `dado test` twice instead:
// the hits and misses themselves, which start `dadoc` and a C compiler.
package driver

import "core:mem/arena"
import "core:mem/libc"
import "core:os"
import "core:os/fs"

private bool hex_is(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is ", got, ", not ", want)

private string8 of_texts([]string8 items):
    Digest d = digest()
    for i in items:
        put_text(&d, i)
    return finish_digest(&d)

private bool framing():
    bool ok = true
    ref []string8 abc = words_of("a bc")
    ok = hex_is(of_texts(abc[:]), "9a8acca1b6c6c0befd3fbc756aed625da998c998f7252e738c4ef061906b9b21", "a, bc") && ok
    ref []string8 abc2 = words_of("ab c")
    ok = hex_is(of_texts(abc2[:]), "43ee655579de01ca739b3f95c1c2d3f46d353b2c0df818064ea594506cdb2617", "ab, c — the same bytes, framed apart") && ok
    ref []string8 none = words_of("")
    ok = hex_is(of_texts(none[:]), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "no items") && ok
    Digest e = digest()
    put_text(&e, "")
    ok = hex_is(finish_digest(&e), "af5570f5a1810b7af78caf4bc70a660f0df51e42baf91d4de5b2328de0e83dfc", "one empty item") && ok

    // The preprocessed text with the unit's path taken out, framed by what is left.
    Digest u = digest()
    put_text(&u, "id")
    put_unsaid(&u, "# 1 \"/s/impl.c\"\nint x;\n", "/s/impl.c")
    ok = hex_is(finish_digest(&u), "cc7821ba8b99b6da31011ac421b01cc9b7d5345a60e99bf767a194deddbd3b20", "the unit's path unsaid") && ok
    Digest u2 = digest()
    put_unsaid(&u2, "A/sB/s", "/s")
    ok = hex_is(finish_digest(&u2), "ab97f2664a93bf38259541960c9125d1ecb6eec39e4dd2d14b5ca010c4971898", "two occurrences unsaid") && ok
    Digest u3 = digest()
    put_unsaid(&u3, "AB", "")
    ok = hex_is(finish_digest(&u3), "ab97f2664a93bf38259541960c9125d1ecb6eec39e4dd2d14b5ca010c4971898", "nothing to unsay") && ok

    Digest missing = digest()
    put_file(&missing, "/no/such/file/anywhere")
    ok = #expect(finish_digest(&missing) == "", "a file that cannot be read gave a digest") && ok
    return ok

private bool slots():
    bool ok = true
    ref []string8 args = words_of("--collections=/c --test=/p/x_test.dado /p")
    ok = hex_is(slot_name(args[:]), "021b027164717604", "the slot's name") && ok
    ok = hex_is(emit_slot("/b/.dado-cache", args[:]), "/b/.dado-cache/emit/021b027164717604", "the slot's path") && ok
    // No `include` line: the key is the dadoc digest and the arguments.
    ok = hex_is(emit_key("DADOCID", args[:], "os #LINUX\n"), "c15063a6bb6b5aa92e9324d0fea0f727d422e8234ed57ecc754bc7ed23e4e49e", "the key with no directory") && ok
    ok = #expect(emit_key("DADOCID", args[:], "include /no/such/dir\n") == "", "a directory that cannot be read gave a key") && ok
    ref []string8 dirs = included_dirs("include /a\nsource /a/x.c\ninclude /b c\ninclude \nos #LINUX")
    ok = #expect(#len(dirs) == 2 && dirs[0] == "/a" && dirs[1] == "/b c", "the include lines read wrong") && ok
    return ok

private bool write(string8 p, string8 text):
    try fs.write_file(p, text) else:
        return false
    return true

// A directory's items: `.dado` and `.dados` names and bytes, `.c` names, in
// byte order, nothing else.
private bool directory():
    bool ok = true
    try ref []char8 made = fs.make_temp_dir("dado-cache-test") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 t = txt(made)
    ok = #expect(write(join2(t, "b.dado"), "x"), "writing b.dado") && ok
    ok = #expect(write(join2(t, "a.dados"), "yy"), "writing a.dados") && ok
    ok = #expect(write(join2(t, "c.c"), "the body is not read"), "writing c.c") && ok
    ok = #expect(write(join2(t, "d.txt"), "ignored"), "writing d.txt") && ok
    ok = #expect(write(join2(t, ".e.dado"), ""), "writing .e.dado") && ok
    Digest got = digest()
    put_dir(&got, t)
    Digest want = digest()
    put_text(&want, txt(#format("%", t)))
    put_text(&want, ".e.dado")
    put_text(&want, "")
    put_text(&want, "a.dados")
    put_text(&want, "yy")
    put_text(&want, "b.dado")
    put_text(&want, "x")
    put_text(&want, "c.c")
    ok = hex_is(finish_digest(&got), finish_digest(&want), "the directory's digest") && ok

    // A source changed after a mark has moved; one older has not.
    ok = #expect(!sources_moved(txt(#format("include ", t, "\n")), i64(9) * 1000000000000000000), "nothing is newer than the far future") && ok
    ok = #expect(sources_moved(txt(#format("include ", t, "\n")), 0), "every source is newer than 1970") && ok

    try fs.remove_all(t) else code:
        ok = #expect(false, "removing the fake tree: ", os.message(code)) && ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = framing()
        ok = slots() && ok
        ok = directory() && ok
        if ok: return 0
        return 1
