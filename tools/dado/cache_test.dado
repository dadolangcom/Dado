@test
// The test caches' pure parts: the digest's framing, the slot names and the
// emit key, against values computed independently with Python's `hashlib`
// (each item as eight bytes of little-endian length, then its bytes), and a
// package directory's items over a fake tree.
//
// What is not here, and is exercised by running `dado test` twice instead:
// the hits and misses themselves, which start `dadoc` and a C compiler.
package driver

import "core:mem/arena"
import "core:mem/libc"
import "core:os"
import "core:os/fs"

private bool hex_is(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is ", got, ", not ", want)

private string8 of_texts([]string8 items):
    Digest d = digest()
    for i in items:
        put_text(&d, i)
    return finish_digest(&d)

private bool framing():
    bool ok = true
    ref []string8 abc = words_of("a bc")
    ok = hex_is(of_texts(abc[:]), "9a8acca1b6c6c0befd3fbc756aed625da998c998f7252e738c4ef061906b9b21", "a, bc") && ok
    ref []string8 abc2 = words_of("ab c")
    ok = hex_is(of_texts(abc2[:]), "43ee655579de01ca739b3f95c1c2d3f46d353b2c0df818064ea594506cdb2617", "ab, c — the same bytes, framed apart") && ok
    ref []string8 none = words_of("")
    ok = hex_is(of_texts(none[:]), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "no items") && ok
    Digest e = digest()
    put_text(&e, "")
    ok = hex_is(finish_digest(&e), "af5570f5a1810b7af78caf4bc70a660f0df51e42baf91d4de5b2328de0e83dfc", "one empty item") && ok

    // The preprocessed text with the unit's path taken out, framed by what is left.
    Digest u = digest()
    put_text(&u, "id")
    put_unsaid(&u, "# 1 \"/s/impl.c\"\nint x;\n", "/s/impl.c")
    ok = hex_is(finish_digest(&u), "cc7821ba8b99b6da31011ac421b01cc9b7d5345a60e99bf767a194deddbd3b20", "the unit's path unsaid") && ok
    Digest u2 = digest()
    put_unsaid(&u2, "A/sB/s", "/s")
    ok = hex_is(finish_digest(&u2), "ab97f2664a93bf38259541960c9125d1ecb6eec39e4dd2d14b5ca010c4971898", "two occurrences unsaid") && ok
    Digest u3 = digest()
    put_unsaid(&u3, "AB", "")
    ok = hex_is(finish_digest(&u3), "ab97f2664a93bf38259541960c9125d1ecb6eec39e4dd2d14b5ca010c4971898", "nothing to unsay") && ok

    Digest missing = digest()
    put_file(&missing, "/no/such/file/anywhere")
    ok = #expect(finish_digest(&missing) == "", "a file that cannot be read gave a digest") && ok
    return ok

private bool slots():
    bool ok = true
    ref []string8 args = words_of("--collections=/c --test=/p/x_test.dado /p")
    ok = hex_is(slot_name(args[:]), "021b027164717604", "the slot's name") && ok
    // Joined as this system writes paths: `\` on Windows.
    ok = hex_is(emit_slot("/b/.dado-cache", args[:]), join3("/b/.dado-cache", "emit", "021b027164717604"), "the slot's path") && ok
    // No `include` line: the key is the dadoc digest and the arguments.
    ok = hex_is(emit_key("DADOCID", args[:], "os #LINUX\n"), "c15063a6bb6b5aa92e9324d0fea0f727d422e8234ed57ecc754bc7ed23e4e49e", "the key with no directory") && ok
    ok = #expect(emit_key("DADOCID", args[:], "include /no/such/dir\n") == "", "a directory that cannot be read gave a key") && ok
    ref []string8 dirs = included_dirs("include /a\nsource /a/x.c\ninclude /b c\ninclude \nos #LINUX")
    ok = #expect(#len(dirs) == 2 && dirs[0] == "/a" && dirs[1] == "/b c", "the include lines read wrong") && ok
    return ok

private bool write(string8 p, string8 text):
    try fs.write_file(p, text) else:
        return false
    return true

// A directory's items: `.dado` and `.dados` names and bytes (`put_large`), `.c` names, in
// byte order, nothing else.
private bool directory():
    bool ok = true
    try ref []char8 made = fs.make_temp_dir("dado-cache-test") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 t = txt(made)
    ok = #expect(write(join2(t, "b.dado"), "x"), "writing b.dado") && ok
    ok = #expect(write(join2(t, "a.dados"), "yy"), "writing a.dados") && ok
    ok = #expect(write(join2(t, "c.c"), "the body is not read"), "writing c.c") && ok
    ok = #expect(write(join2(t, "d.txt"), "ignored"), "writing d.txt") && ok
    ok = #expect(write(join2(t, ".e.dado"), ""), "writing .e.dado") && ok
    Digest got = digest()
    put_dir(&got, t)
    Digest want = digest()
    put_text(&want, txt(#format("%", t)))
    put_text(&want, ".e.dado")
    put_large(&want, "")
    put_text(&want, "a.dados")
    put_large(&want, "yy")
    put_text(&want, "b.dado")
    put_large(&want, "x")
    put_text(&want, "c.c")
    ok = hex_is(finish_digest(&got), finish_digest(&want), "the directory's digest") && ok

    // A file skipped by path, its name and its bytes both, so an edit to it,
    // or its removal, leaves the digest as it was.
    ref []string8 skip = #make([]string8, 0)
    skip = #append(skip, join2(t, "b.dado"))
    Digest skipped = digest()
    put_dir(&skipped, t, skip[:])
    ok = #expect(write(join2(t, "b.dado"), "edited"), "editing b.dado") && ok
    Digest edited = digest()
    put_dir(&edited, t, skip[:])
    Digest none = digest()
    put_text(&none, txt(#format("%", t)))
    put_text(&none, ".e.dado")
    put_large(&none, "")
    put_text(&none, "a.dados")
    put_large(&none, "yy")
    put_text(&none, "c.c")
    string8 without = finish_digest(&none)
    ok = hex_is(finish_digest(&skipped), without, "the digest with b.dado skipped") && ok
    ok = hex_is(finish_digest(&edited), without, "the digest with b.dado skipped and edited") && ok

    // The same file skipped when `skip` names it through a link to the
    // directory, as a package reached through a link names its test files,
    // while the manifest names the directory with the link followed.
    when #OS != #WINDOWS:
        string8 link = txt(#format(t, ".link"))
        try fs.make_symlink(t, link) else code:
            ok = #expect(false, "no link to the directory: ", os.message(code)) && ok
        try ref []char8 real_t = fs.canonical(t) else code:
            return #expect(false, "the temp directory does not resolve: ", os.message(code))
        ref []string8 linked = #make([]string8, 0)
        linked = #append(linked, join2(link, "b.dado"))
        Digest through = digest()
        put_dir(&through, txt(real_t), linked[:])
        Digest none_real = digest()
        put_text(&none_real, txt(#format("%", txt(real_t))))
        put_text(&none_real, ".e.dado")
        put_large(&none_real, "")
        put_text(&none_real, "a.dados")
        put_large(&none_real, "yy")
        put_text(&none_real, "c.c")
        ok = hex_is(finish_digest(&through), finish_digest(&none_real), "the digest with b.dado skipped through a link") && ok
        remove_quietly(link)

    // A source changed after a mark has moved; one older has not.
    ok = #expect(!sources_moved(txt(#format("include ", t, "\n")), i64(9) * 1000000000000000000), "nothing is newer than the far future") && ok
    ok = #expect(sources_moved(txt(#format("include ", t, "\n")), 0), "every source is newer than 1970") && ok

    try fs.remove_all(t) else code:
        ok = #expect(false, "removing the fake tree: ", os.message(code)) && ok
    return ok

// The prerequisites of a compiler's `-MD` file: the object's own name left
// out, continuations, escaped spaces and `#`, `$$`, CR LF, a Windows path.
private bool depfiles():
    bool ok = true
    ref []string8 d = depfile_paths("/b/u.o: /s/u.c /s/a\\ b.h \\\n  /usr/x.h \\\r\n C:\\inc\\w.h /s/\\#h.h /s/$$d.h\n")
    ok = #expect(#len(d) == 6, "a -MD file read as ", #len(d), " paths") && ok
    if #len(d) == 6:
        ok = #expect(d[0] == "/s/u.c", "the unit is ", d[0]) && ok
        ok = #expect(d[1] == "/s/a b.h", "an escaped space read as ", d[1]) && ok
        ok = #expect(d[2] == "/usr/x.h", "a continued line read as ", d[2]) && ok
        ok = #expect(d[3] == "C:\\inc\\w.h", "a Windows path read as ", d[3]) && ok
        ok = #expect(d[4] == "/s/#h.h", "an escaped # read as ", d[4]) && ok
        ok = #expect(d[5] == "/s/$d.h", "$$ read as ", d[5]) && ok
    ref []string8 none = depfile_paths("u.o:\n")
    ok = #expect(#len(none) == 0, "a -MD file with no prerequisites") && ok
    return ok

// A unit's book: written from a `-MD` file, it names one object while the
// headers' bytes stay, another when one changes, the first again when it is
// changed back; a header newer than the compile's mark leaves no book.
private bool books():
    bool ok = true
    try ref []char8 made = fs.make_temp_dir("dado-book-test") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 t = txt(made)
    string8 unit = join2(t, "u.c")
    string8 header = join2(t, "h.h")
    string8 dep = join2(t, "u.d")
    ok = #expect(write(unit, "#include \"h.h\"\n"), "writing u.c") && ok
    ok = #expect(write(header, "int x;\n"), "writing h.h") && ok
    ok = #expect(write(dep, txt(#format("u.o: ", unit, " ", header, "\n"))), "writing u.d") && ok
    i64 later = fs_now(t) + i64(10) * 1000000000
    ok = #expect(later > 0, "the file system's clock") && ok
    UnitFound f = find_unit(t, "BASE", unit, "", later)
    ok = #expect(#len(f.book) > 0 && #len(f.object) == 0, "a unit never compiled was found") && ok
    string8 obj = book_unit(f.book, dep, unit, false, later)
    ok = #expect(#len(obj) > 0, "no book was written") && ok
    ok = #expect(write(obj, "an object"), "writing the object") && ok
    ok = #expect(find_unit(t, "BASE", unit, "", later).object == obj, "the book did not name its object") && ok
    ok = #expect(find_unit(t, "OTHER", unit, "", later).object == "", "another base found the object") && ok
    ok = #expect(write(header, "int yy;\n"), "editing h.h") && ok
    ok = #expect(find_unit(t, "BASE", unit, "", later).object == "", "an edited header found the old object") && ok
    ok = #expect(write(header, "int x;\n"), "restoring h.h") && ok
    ok = #expect(find_unit(t, "BASE", unit, "", later).object == obj, "the header restored did not find its object") && ok
    ok = #expect(write(unit, "#include \"h.h\"\nint z;\n"), "editing u.c") && ok
    ok = #expect(find_unit(t, "BASE", unit, "", later).object == "", "an edited unit found the old object") && ok
    // Compiled while the header was being written: no book.
    ok = #expect(book_unit(f.book, dep, unit, true, fs_now(t) - i64(10) * 1000000000) == "", "a header newer than the compile was booked") && ok
    try fs.remove_all(t) else code:
        ok = #expect(false, "removing the fake tree: ", os.message(code)) && ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = framing()
        ok = slots() && ok
        ok = directory() && ok
        ok = depfiles() && ok
        ok = books() && ok
        if ok: return 0
        return 1
