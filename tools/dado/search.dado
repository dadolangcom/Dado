// `dado search <term>`: the generated documentation and every diagnostic
// code's title and rule, ranked.
//
// **What is searched.** The codes come from `dadoc --emit=lexicon` (the
// compiler's own list, so a code is found even where `docs/` is missing),
// and the pages are the generated ones under the root: the language guide
// and the reference under `docs/`, the signals guide and `docs/packages/`. The code
// pages under `docs/codes/` are not searched as pages: each is one code's
// title and rule again, which the code itself already answers, and finding
// every code twice would push everything else down the list.
//
// **What matches.** Case is ignored. The term matches a line (or a code's
// title and rule) when every word of it occurs there as a word (`has_word`
// says what that is), in any order; the
// whole term, as written, ranks higher than its words scattered. A code
// named exactly ranks first, then codes whose title holds the term, then
// pages by their best line, a heading before body text. Ties go in byte
// order of the code or the path, so one question always gets one list.
package driver

import "core:chars"
import "core:fmt"
import "core:os/fs"
import "core:strings"

// One answer: a code (`id` is the code, `line` 0, `text` its rule) or a page
// (`id` its path from the root, `line` and `text` its best line, `title` its
// first heading).
type Hit:
    string8 kind
    string8 id
    string8 title
    i64 line
    string8 text
    i64 matches
    i64 score

// The answers `search` gives when `--limit` is not.
private const i64 SEARCH_LIMIT = 20

// Whether `w` occurs in `hay` as a word: starting where a word starts, and
// for a word of three letters or fewer also ending where one ends, so `no`
// does not find `cannot` or `nobody` while `alloc` still finds `allocator`.
bool has_word(string8 hay, string8 w):
    i64 n = #len(hay)
    i64 m = #len(w)
    if m == 0 || m > n: return false
    for at in 0..<((n - m) + 1):
        if at > 0 && chars.is_alnum(hay[at - 1]): continue
        bool same = true
        for i in 0..<m:
            if hay[at + i] != w[i]:
                same = false
                break
        if !same: continue
        if m <= 3 && at + m < n && chars.is_alnum(hay[at + m]): continue
        return true
    return false

// Whether every word of `words` occurs in `hay` as a word; both already
// folded.
bool has_all(string8 hay, []string8 words):
    if #len(words) == 0: return false
    for w in words:
        if !has_word(hay, w): return false
    return true

// How well a code answers `term` (folded) and its `words`; 0 is not at all.
i64 code_score(string8 term, []string8 words, CodeRow r):
    string8 code = folded(r.code)
    string8 title = folded(r.title)
    string8 rule = folded(r.rule)
    if code == term: return 1000
    if #len(term) >= 3 && strings.starts_with(code, term): return 500
    if strings.contains(title, term): return 300
    if strings.contains(rule, term): return 200
    if has_all(title, words): return 150
    if has_all(txt(#format(title, " ", rule)), words): return 100
    return 0

// How well one line of a page answers `term` (folded) and its `words`.
i64 line_score(string8 term, []string8 words, string8 line):
    string8 l = folded(line)
    bool heading = strings.starts_with(strings.trim(line), "#")
    if strings.contains(l, term): return 60 if heading else 40
    if has_all(l, words): return 30 if heading else 20
    return 0

// The answer a page gives, its best line and how many lines matched, or a
// hit with score 0. `id` is its path from the root.
Hit page_hit(string8 term, []string8 words, string8 id, string8 text):
    Hit h
    h.kind = "page"
    h.id = id
    i64 n = 0
    i64 best = 0
    for l in raw_lines(text):
        n += 1
        if #len(h.title) == 0 && strings.starts_with(l, "# "):
            h.title = strings.trim(l[2..<#len(l)])
        i64 s = line_score(term, words, l)
        if s > 0:
            h.matches += 1
            if s > best:
                best = s
                h.line = n
                h.text = strings.trim(l)
    if best == 0: return h
    i64 extra = h.matches
    if extra > 20: extra = 20
    h.score = best + extra
    return h

// The hits for every code that answers.
ref []Hit code_hits(string8 term, []string8 words, []CodeRow codes):
    ref []Hit out = #make([]Hit, 0)
    for r in codes:
        i64 s = code_score(term, words, r)
        if s == 0: continue
        Hit h
        h.kind = "code"
        h.id = r.code
        h.title = r.title
        h.text = r.rule
        h.score = s
        _ = #append(out, h)
    return out

// Whether `a` goes before `b`: the higher score, then byte order of the id.
bool ranks_before(Hit a, Hit b):
    if a.score != b.score: return a.score > b.score
    return strings.compare(a.id, b.id) < 0

// `hits` ranked, in place.
void rank([]Hit hits):
    for i in 1..<#len(hits):
        Hit v = hits[i]
        i64 j = i - 1
        for j >= 0 && ranks_before(v, hits[j]):
            hits[j + 1] = hits[j]
            j -= 1
        hits[j + 1] = v

// One hit as `--format=json` writes it.
string8 hit_json(Hit h):
    ref []string8 f = #make([]string8, 0)
    _ = #append(f, json_text("kind", h.kind))
    _ = #append(f, json_text("id", h.id))
    _ = #append(f, json_text("title", h.title))
    _ = #append(f, json_number("line", h.line))
    _ = #append(f, json_text("text", h.text))
    _ = #append(f, json_number("matches", h.matches))
    _ = #append(f, json_number("score", h.score))
    return json_object(f[:])

// One hit as a line: `ERR0301  <title>`, or a page's path, line and text.
string8 hit_line(Hit h):
    if h.kind == "code":
        return txt(#format(h.id, "  ", h.title))
    return txt(#format(h.id, ":", h.line, "  ", h.text))

// The generated pages `search` reads, as paths from the root, in byte order.
ref []string8 searched_pages(string8 at):
    ref []string8 out = #make([]string8, 0)
    for p in [txt(#format("docs/language", MD)), txt(#format("docs/reference", MD)), txt(#format("SIGNALS", MD))]:
        if is_file(join2(at, p)): _ = #append(out, p)
    ref []string8 under = #make([]string8, 0)
    string8 pkgs = join3(at, "docs", "packages")
    fs.Listing l = fs.walk(pkgs, #default)
    for e in l.entries:
        if e.is_dir || !strings.ends_with(e.path, ".md"): continue
        string8 rel = e.path[#len(at) + 1..<#len(e.path)]
        ref []char8 own = #format(rel)
        _ = #append(under, txt(own))
    sort_bytes(under[:])
    for p in under:
        _ = #append(out, p)
    return out

// `dado search <term>`.
//
// JSON: {"query": "search", "term": ..., "total": <hits before the limit>,
// "results": [{"kind": "code"|"page", "id": ..., "title": ..., "line": N,
// "text": ..., "matches": N, "score": N}, ...]}, best first.
i32 search_verb([]string8 terms, string8 limit_given, bool json):
    ref []char8 joined = strings.join(terms, " ")
    string8 term = strings.trim(txt(joined))
    if #len(term) == 0:
        return answer_error("search", json, "no term given. Try: dado search \"no main\"")
    i64 limit = SEARCH_LIMIT
    if #len(limit_given) > 0:
        (i64 n, bool ok) = decimal(limit_given)
        if !ok || n == 0:
            return answer_error("search", json, txt(#format("--limit takes a whole number above 0, not `", limit_given, "`")))
        limit = n
    string8 t = folded(term)
    ref []string8 words = words_of(t)
    ref []CodeRow codes = parse_codes(lexicon_text())
    ref []Hit hits = code_hits(t, words[:], codes[:])
    string8 at = root()
    ref []string8 pages = searched_pages(at)
    for p in pages:
        try ref []char8 text = fs.read_file(join2(at, p)) else:
            continue
        Hit h = page_hit(t, words[:], p, txt(text))
        if h.score > 0: _ = #append(hits, h)
    rank(hits[:])
    i64 total = #len(hits)
    i64 shown_n = total if total < limit else limit
    if json:
        ref []string8 rs = #make([]string8, 0)
        for i in 0..<shown_n:
            _ = #append(rs, hit_json(hits[i]))
        ref []string8 f = #make([]string8, 0)
        _ = #append(f, json_text("query", "search"))
        _ = #append(f, json_text("term", term))
        _ = #append(f, json_number("total", total))
        _ = #append(f, json_field("results", json_array(rs[:])))
        fmt.println(json_object(f[:]))
        return 0
    if #len(pages) == 0:
        warn(txt(#format("no generated documentation under ", at, ": only the diagnostic codes were searched. `dado doc --write` generates it")))
    if total == 0:
        fmt.println("no match for `", term, "`")
        return 0
    for i in 0..<shown_n:
        fmt.println(hit_line(hits[i]))
    if total > shown_n:
        fmt.println("(", total - shown_n, " more: --limit=", total, ")")
    return 0
