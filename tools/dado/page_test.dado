@test
// The page writer: SHA-384 and its base64 against FIPS 180-4's vectors, and
// a page over a fixture (`DADO_PAGE_FIXTURE`, a module directory, when set).
package driver

import "core:mem/arena"
import "core:mem/libc"
import "core:os"

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    using arena.allocator(&a):
        return checks()

private i32 checks():
    bool ok = true
    ok = #expect(integrity("abc") == "sha384-ywB1P0WjXou1oD1pmsZQBycsMqsO3tFjGotgWkP/W+2AhgcroefMI1i67KE0yCWn", "SHA-384 of abc") && ok
    ok = #expect(integrity("") == "sha384-OLBgp1GsljhM2TJ+sbHjaiH9txEUvgdDTAzHv2P24donTt6/529l+9Ua0vFImLlb", "SHA-384 of nothing") && ok
    (string8 dir, bool set) = env("DADO_PAGE_FIXTURE")
    if set && #len(dir) > 0:
        Page p = write_page(join2(dir, "m.wasm"), join3(root(), "tools", join2("web", "load.mjs")), "", "/app/")
        ok = #expect(#len(p.headers) > 0 && p.files == 7 && p.loader_files == 3 && p.script_files == 2, "the fixture's counts") && ok
        os.quit_with(0 if ok else 1)
    return 0 if ok else 1
