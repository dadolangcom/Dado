// `dado test`: build and run packages' `@test` files, one process each. The
// queue that drives many packages at once, and the batches their programs
// link into, are `suite.dado`; this file holds what one test needs.
//
// **One process per test**, because a test's result is its exit status: a
// failed `assert` aborts, and nothing here could catch that and carry on.
// `@test <status>` names the status a file passes with, so a test of a
// deliberate failure is written `@test 134` (an abort).
//
// The compiler says which files are tests and which build together
// (`dadoc --emit=test-groups`, one `test <path> <status> <group>` line each;
// from a `dadoc` without it, `--emit=tests`, each file alone). **A group is
// one program**: the package and the group's files transpiled once, with
// `--test=<path>` for each and one build manifest, because a test file may be
// the only thing importing a package and so reach headers, `.c` files and
// link clauses the ordinary build does not; its C `main` runs the test its
// argument names, so each test is still its own process. Two files that
// declare one package-level name are in different groups, and a group that
// does not compile is built a file at a time. The web builds each file alone.
//
// **Sanitized by default** with the `defaults` flags, because Dado
// bounds-checks nothing and a test is where an out-of-bounds goes unwatched.
// A compiler with no runtime here warns once and runs unsanitized;
// `--sanitize=thread` swaps AddressSanitizer for ThreadSanitizer and is an
// error where it cannot run. The pinned zig has no AddressSanitizer on Linux
// and links a combined list without it, so with no `--cc` a gcc or clang
// that has one is used instead (`run_compiler`); where zig is still the
// compiler (`--cc zig`, none here that can, Windows) `address` is dropped,
// the build says so once, the binaries are named `.ubsan`, and the summary
// says `(sanitized: ubsan)` rather than claim a check that did not run; with
// AddressSanitizer it says `(sanitized: asan, ubsan)`. A web test (run under
// node) is sanitized by default too, with C's UBSan alone, there being no
// AddressSanitizer for wasm: `(sanitized: ubsan)`.
//
// **The summary counts what ran.** `(sanitized…)` is printed only when every
// test that ran was built with a sanitizer, and a test's standard error is
// shown only when it failed.
package driver

import "core:fmt"
import "core:hash"
import "core:io"
import "core:mem/arena"
import "core:mem/libc"
import "core:os"
import "core:os/fs"
import "core:os/proc"
import "core:path"
import "core:strings"
import "core:time"

// What `--filter` and `--shard` asked for, set before the command runs.
private string8 g_filter = ""
private string8 g_shard = ""
// What `test` reads off the command line beyond the shared options: the
// filter and the slice.
void set_test_selection(string8 filter, string8 shard):
    g_filter = filter
    g_shard = shard

// What `-j` asked for, as written, or "": how many processes at once.
private string8 g_jobs = ""

void set_test_jobs(string8 jobs):
    g_jobs = jobs

// `FAIL …`, its first word in red.
void say_red(string8 word, string8 rest):
    colour()
    fmt.println(g_red, word, g_reset, rest)

// Remove `p` and everything under it, if it is there.
void remove_tree_quietly(string8 p):
    if !exists(p): return
    try fs.remove_all(p) else:
        return

// The refusals for a program that embeds the script engine `engine` on a
// target whose `#OS` is `os`: only quickjs is built, and a freestanding
// target has no C library for it.
void engine_refusals(string8 engine, string8 os):
    if engine != "quickjs":
        die(txt(#format("the build manifest asks for an engine called `", engine, "`, and the only one this driver builds is quickjs.\n  The compiler and the driver disagree about what a DadoScript program runs on: rebuild dadoc from this tree.")))
    if os == "#NONE":
        die("this program runs DadoScript scripts, and the resolved target's `#OS` is `#NONE`.\n  Scripting needs a hosted C library: QuickJS-ng allocates, formats numbers and\n  reads the clock through one, even with its allocator routed through Dado's, so\n  there is no engine for a freestanding target. Build the scripting half for a\n  hosted target, or keep the freestanding build from reaching `core:script`.")

// ── the pure parts ──────────────────────────────────────────────────────────

// `text` read as a non-negative decimal number, and whether it was one.
(i64 n, bool ok) decimal(string8 text):
    if #len(text) == 0 || #len(text) > 9: return (0, false)
    i64 n = 0
    for c in text:
        if c < '0' || c > '9': return (0, false)
        n = n * 10 + i64(c - '0')
    return (n, true)

// `--shard`'s `<k>/<n>`, with `1 <= k <= n`.
(i64 k, i64 n, bool ok) parse_shard(string8 text):
    (string8 a, string8 b, bool slash) = split_byte(text, '/')
    if !slash: return (0, 0, false)
    (i64 k, bool kok) = decimal(a)
    (i64 n, bool nok) = decimal(b)
    if !kok || !nok || k < 1 || n < 1 || k > n: return (0, 0, false)
    return (k, n, true)

// Whether the `i`-th test (from 0, in manifest order) is in slice `k` of `n`;
// every test is when `n` is 0.
bool in_slice(i64 i, i64 k, i64 n):
    if n == 0: return true
    return i % n == k - 1

// One line of `dadoc --emit=tests`, or of `--emit=test-groups`, which adds
// the group the file builds in (-1 when the line has none).
type TestEntry:
    string8 path
    i32 status
    i64 group

// `text` read as the tests manifest: `test <path> <status>` lines, each with
// its group after it when `dadoc --emit=test-groups` wrote it. `ok` false,
// and `why` the line, at a line that is neither.
(ref []TestEntry tests, bool ok, string8 why) parse_tests(string8 text):
    ref []TestEntry out = #make([]TestEntry, 0)
    for l in lines_of(text):
        ref []string8 w = words_of(l)
        if #len(w) == 0: continue
        if w[0] != "test" || (#len(w) != 3 && #len(w) != 4):
            return (out, false, txt(#format("unrecognised test manifest line: ", l)))
        (i64 status, bool sok) = decimal(w[2])
        if !sok:
            return (out, false, txt(#format("unrecognised test manifest line: ", l)))
        TestEntry e
        e.path = w[1]
        e.status = i32(status)
        e.group = 0 - 1
        if #len(w) == 4:
            (i64 g, bool gok) = decimal(w[3])
            if !gok:
                return (out, false, txt(#format("unrecognised test manifest line: ", l)))
            e.group = g
        out = #append(out, e)
    return (out, true, "")

// **Which tests build as one program**: `group[i]` is the place in `tests`
// of the first selected test of test `i`'s group, when that group holds
// two or more of the selected tests, and -1 for a test built alone (no
// group, or the only one of its group selected); `member[i]` is test `i`'s
// place among its group's selected tests, the argument its program runs it
// by. `tests` is in manifest order, and so is each group.
(ref []i64 group, ref []i64 member) program_groups([]TestEntry tests):
    ref []i64 group = #make([]i64, 0)
    ref []i64 member = #make([]i64, 0)
    {i64: i64} first = {}
    {i64: i64} count = {}
    for i in 0..<#len(tests):
        i64 g = tests[i].group
        group = #append(group, 0 - 1)
        member = #append(member, 0)
        if g < 0: continue
        if !(g in first):
            first[g] = i64(i)
            count[g] = 0
        (i64 n, bool _) = count[g]
        member[i] = n
        count[g] = n + 1
    for i in 0..<#len(tests):
        i64 g = tests[i].group
        if g < 0: continue
        (i64 n, bool _) = count[g]
        if n < 2: continue
        (i64 at, bool _) = first[g]
        group[i] = at
    return (group, member)

// A test file's name in the report: its base name without `.dado`.
string8 test_name(string8 file):
    string8 n = path.base(file)
    if strings.ends_with(n, ".dado"): n = n[0..<#len(n) - 5]
    return n

// What the summary says about the sanitizers: nothing unless the tests that
// ran were sanitized (the sanitizers are chosen once per run, so one
// sanitized run means all were), and then which ran, by name:
// `tsan, ubsan` for `--sanitize=thread`; `ubsan` alone under the pinned zig,
// which has no AddressSanitizer, on the web, which has none for wasm, or when
// the compiler's hung at start-up;
// otherwise `asan, ubsan`. A reader asking whether AddressSanitizer ran looks
// for `(sanitized: asan`.
string8 sanitizer_marker(i64 sanitized_runs, string8 kind, bool ubsan_alone):
    if sanitized_runs == 0: return ""
    if kind == "thread": return " (sanitized: tsan, ubsan)"
    if ubsan_alone: return " (sanitized: ubsan)"
    return " (sanitized: asan, ubsan)"

// The result line: `P passed, F failed`, the slice when sharded, how many
// `--filter` left out when it left any out, and the sanitizer marker.
string8 summary_line(i64 passed, i64 failed, i64 filtered, i64 k, i64 n, i64 other_slices, string8 marker):
    strings.Builder b = strings.builder(96)
    strings.append(&b, txt(#format(passed, " passed, ", failed, " failed")))
    if n > 0:
        strings.append(&b, txt(#format(" (slice ", k, "/", n, "; ", other_slices, " in the other slices)")))
    if filtered > 0:
        strings.append(&b, txt(#format(", ", filtered, " filtered out")))
    strings.append(&b, marker)
    return txt(strings.finish(&b))

// `text` with every line, blank ones too, indented by seven spaces, each
// ending in a newline: a failing test's standard error under its line.
string8 indented(string8 text):
    strings.Builder b = strings.builder(#len(text) + 64)
    string8 rest = text
    for #len(rest) > 0:
        (string8 l, string8 tail, bool more) = strings.line(rest)
        strings.append(&b, "       ")
        strings.append(&b, l)
        strings.append_char(&b, '\n')
        if !more: break
        rest = tail
    return txt(strings.finish(&b))

// A build manifest as a web module's loader reads it beside the module:
// each `js-module` line's first directory replaced by `scripts`, the
// directory the module's scripts were copied to. Every line ends in a
// newline.
string8 web_manifest(string8 text, string8 scripts):
    strings.Builder b = strings.builder(#len(text) + 64)
    string8 rest = text
    for #len(rest) > 0:
        (string8 l, string8 tail, bool more) = strings.line(rest)
        string8 line = l
        if strings.starts_with(l, "js-module "):
            string8 value = l[10..<#len(l)]
            i64 slash = strings.index_of(value, '/')
            if slash >= 0:
                line = txt(#format("js-module ", scripts, "/", value[slash + 1..<#len(value)]))
        strings.append(&b, line)
        strings.append_char(&b, '\n')
        if !more: break
        rest = tail
    return txt(strings.finish(&b))

// Where a test's C goes: `<build>/<stem>.<test>.<configuration>.c`, beside
// its binary and named for the same configuration (`gcc.asan`, `zig.ubsan`,
// `web`), so a native and a web run of one package at once never compile
// each other's C. Without the caches the transpile's slot is `<this>.d`, kept
// apart the same way.
string8 test_c_path(string8 build_dir, string8 stem, string8 name, string8 cfg):
    return txt(#format(build_dir, "/", stem, ".", name, ".", cfg, ".c"))

// ── running one test ────────────────────────────────────────────────────────

// A Windows program's exit status read as POSIX's, so one `@test <status>`
// holds on both. Windows' C runtime ends an `abort` with exit code 3, where a
// process killed by `SIGABRT` reports 134; that is the one status a test is
// written against (`@test 134`, a failed `assert`) that Windows spells
// differently.
private i32 as_posix_status(i32 status, string8 os):
    if os == "#WINDOWS" && status == 3:
        return 134
    return status

// The test's line, then what it printed on standard output (every test's),
// then, when it failed, on standard error.
private void report(string8 name, i32 status, i32 wanted, string8 printed, string8 said, ^i64 passed, ^i64 failed):
    if status == wanted:
        say_green("ok", txt(#format(" ", name)))
        if #len(printed) > 0: fmt.print(indented(printed))
        passed^ += 1
        return
    if wanted == 0:
        say_red("FAIL", txt(#format(" ", name, " (exit ", status, ")")))
    else:
        say_red("FAIL", txt(#format(" ", name, " (exit ", status, ", wanted ", wanted, ")")))
    failed^ += 1
    if #len(printed) > 0: fmt.print(indented(printed))
    if #len(said) > 0:
        fmt.print(indented(said))

// Every file under `from` copied to the same place under `to`.
private void copy_tree(string8 from, string8 to):
    try fs.make_dirs(to) else: pass
    fs.Listing l = fs.walk(from)
    for e in l.entries:
        string8 rel = e.path[#len(from)..<#len(e.path)]
        for #len(rel) > 0 && path.is_separator(rel[0]):
            rel = rel[1..<#len(rel)]
        string8 dest = join2(to, rel)
        if e.is_dir:
            try fs.make_dirs(dest) else: pass
        else:
            try fs.copy_file(e.path, dest) else:
                continue

// `p` removed, when it is there.
private void remove_if_there(string8 p):
    if exists(p): remove_quietly(p)

// `from` renamed to `to`, or the run ends saying why.
void move_or_die(string8 from, string8 to):
    try fs.rename(from, to) else code:
        die(txt(#format("cannot move ", from, " to ", to, ": ", os.message(code))))

// When the file at `p` was last changed, in nanoseconds, if it can be asked.
(i64 t, bool ok) file_mtime(string8 p):
    try i64 t = fs.mtime(p) else:
        return (0, false)
    return (t, true)

// The link line's compile half without the `-I` list: the compiler, the
// driver's flags, the `flags` clauses and the sanitizer.
private Command compile_flags(^Link k):
    Command c = command_of(k.cc[:])
    add_all(&c, k.base[:])
    add_all(&c, k.interop[:])
    add_all(&c, k.werror[:])
    add_all(&c, k.opt[:])
    add_all(&c, k.extra[:])
    add_all(&c, k.san_c[:])
    respond(&c, i64(#len(k.cc)), "")
    return c

// ── many at once ────────────────────────────────────────────────────────────

// How many processes `dado test` runs at once: `-j N` when it was written,
// else `DADO_JOBS`, else `cores` (at least one). `ok` false for a count that
// is not a whole number of at least 1.
(i32 jobs, bool ok) jobs_of(string8 flag, string8 from_env, i32 cores):
    string8 t = flag
    if #len(t) == 0: t = from_env
    if #len(t) == 0: return (cores if cores >= 1 else 1, true)
    (i64 n, bool nok) = decimal(t)
    if !nok || n < 1: return (0, false)
    return (i32(n), true)

// What one command of a pool said and how it ended: its status (127 when it
// did not start), its standard output (when the pool keeps it) and its
// standard error.
type Ran:
    i32 status
    ref []char8 out
    ref []char8 err
    i64 ms                   // how long it ran
    string8 cmd              // the command, when it failed

// **Commands run at most `jobs` at a time, each one's output read into its
// own buffers**, so nothing two of them print is interleaved and the caller
// shows each where it belongs, in the order a run of one at a time would.
// `pool_step` starts what fits and answers the commands that ended.
type Pool:
    ref []Command commands
    i32 jobs
    ref []bool keep          // its standard output kept
    ref []bool excl          // never two such at once (`--log`'s transpiles, LTO links)
    ref []i32 prio           // the higher first; in order among equals
    ref []Ran ran
    ref []proc.Duplex ds
    ref []bool out_open
    ref []bool err_open
    ref []i32 state          // 0 not started, 1 running, 2 ended
    ref []i64 began
    i64 next                 // the first not started
    ref []i64 early          // ended without starting, not yet answered
    i64 live
    i64 live_excl
    i64 ended

Pool pool_of([]Command commands, i32 jobs, bool keep_out):
    Pool p
    p.commands = #make([]Command, 0)
    p.jobs = jobs if jobs >= 1 else 1
    p.keep = #make([]bool, 0)
    p.excl = #make([]bool, 0)
    p.prio = #make([]i32, 0)
    p.ran = #make([]Ran, 0)
    p.ds = #make([]proc.Duplex, 0)
    p.out_open = #make([]bool, 0)
    p.err_open = #make([]bool, 0)
    p.state = #make([]i32, 0)
    p.began = #make([]i64, 0)
    p.next = 0
    p.early = #make([]i64, 0)
    p.live = 0
    p.live_excl = 0
    p.ended = 0
    for c in commands:
        _ = pool_add(&p, c, keep_out, false, 0)
    return p

// `c` queued behind what is there at its priority; its place in the pool.
i64 pool_add(^Pool p, Command c, bool keep, bool excl, i32 prio):
    p.commands = #append(p.commands, c)
    p.keep = #append(p.keep, keep)
    p.excl = #append(p.excl, excl)
    p.prio = #append(p.prio, prio)
    Ran r
    r.status = 127
    r.out = #make([]char8, 0)
    r.err = #make([]char8, 0)
    r.ms = 0
    r.cmd = ""
    p.ran = #append(p.ran, r)
    proc.Duplex d
    p.ds = #append(p.ds, d)
    p.out_open = #append(p.out_open, false)
    p.err_open = #append(p.err_open, false)
    p.state = #append(p.state, 0)
    p.began = #append(p.began, i64(0))
    return i64(#len(p.commands) - 1)

// Every command ended and answered.
bool pool_done(^Pool p):
    return p.ended == i64(#len(p.commands)) && #len(p.early) == 0

// Start commands while fewer than `jobs` run, then read what the running ones
// say until at least one has ended; answer those that ended, in list order.
// Nothing when every command has ended.
// Start what fits, the highest priority first, without waiting; a command
// that cannot start has ended, and the next `pool_step` answers it.
void pool_fill(^Pool p):
    for p.live < i64(p.jobs):
        i64 i = 0 - 1
        for x in p.next..<i64(#len(p.commands)):
            if p.state[x] != 0 || (p.excl[x] && p.live_excl > 0): continue
            if i < 0 || p.prio[x] > p.prio[i]: i = x
        if i < 0: break
        Command c = p.commands[i]
        if verbose(): note(txt(#format("  $ ", shown(c))))
        _ = io.flush(io.stdout())
        _ = io.flush(io.stderr())
        bool started = false
        (Command f, string8 why) = fitted(c)
        if #len(why) == 0 && #len(f.words) > proc.ARG_CAP: why = too_long(f)
        if #len(why) == 0:
            (proc.Duplex d, bool sok) = start_child(f.words[:])
            started = sok
            if sok: p.ds[i] = d
            if !sok: why = txt(#format("cannot start ", shown(c)))
        if !started:
            string8 line = txt(#format(why, "\n"))
            for k in 0..<#len(line):
                p.ran[i].err = #append(p.ran[i].err, line[k])
            p.ran[i].cmd = shown(c)
            if long_command(c): remove_quietly(c.args_file)
            p.state[i] = 2
            p.ended += 1
            p.early = #append(p.early, i)
            continue
        _ = proc.close_input(&p.ds[i])
        p.out_open[i] = true
        p.err_open[i] = true
        p.state[i] = 1
        p.began[i] = time.unix_nanos()
        p.live += 1
        if p.excl[i]: p.live_excl += 1
    for p.next < i64(#len(p.commands)) && p.state[p.next] != 0:
        p.next += 1

// Start what fits, then read what the running ones say until at least one
// has ended; answer those that ended, in list order. Nothing when every
// command has ended.
ref []i64 pool_step(^Pool p):
    ref []i64 done = #make([]i64, 0)
    [16384]char8 chunk
    for:
        pool_fill(p)
        for e in p.early:
            done = #append(done, e)
        p.early = #make([]i64, 0)
        if #len(done) > 0 || p.live == 0: return done
        bool read_any = false
        for i2 in 0..<#len(p.commands):
            if p.state[i2] != 1: continue
            if read_child(p, i2, chunk[:]): read_any = true
            if !p.out_open[i2] && !p.err_open[i2]:
                proc.close_pipes(&p.ds[i2])
                p.ran[i2].status = finish_status(&p.ds[i2])
                p.ran[i2].ms = (time.unix_nanos() - p.began[i2]) / 1000000
                if p.ran[i2].status != 0: p.ran[i2].cmd = shown(p.commands[i2])
                if long_command(p.commands[i2]): remove_quietly(p.commands[i2].args_file)
                p.state[i2] = 2
                p.live -= 1
                if p.excl[i2]: p.live_excl -= 1
                p.ended += 1
                done = #append(done, i2)
        if #len(done) > 0: return done
        if !read_any: time.sleep(time.milliseconds(5))
    return done

// Run every one of `commands`, `jobs` at a time; what each said, in order.
ref []Ran run_pool([]Command commands, i32 jobs, bool keep_out):
    Pool p = pool_of(commands, jobs, keep_out)
    for !pool_done(&p):
        _ = pool_step(&p)
    return p.ran

// Read what child `i` has written so far without waiting; whether anything
// was read. A pipe that ends or breaks is closed.
private bool read_child(^Pool p, i64 i, []char8 chunk):
    bool any = false
    for p.out_open[i]:
        i64 got = 0 - 1
        try got = proc.receive(&p.ds[i], chunk, 0) else why:
            if why == proc.Pipe.BROKE: p.out_open[i] = false
            break
        if got == 0:
            p.out_open[i] = false
            break
        any = true
        if p.keep[i]:
            for k in 0..<got:
                p.ran[i].out = #append(p.ran[i].out, chunk[k])
    for p.err_open[i]:
        i64 got = 0 - 1
        try got = proc.receive_errors(&p.ds[i], chunk, 0) else why2:
            if why2 == proc.Pipe.BROKE: p.err_open[i] = false
            break
        if got == 0:
            p.err_open[i] = false
            break
        any = true
        for k in 0..<got:
            p.ran[i].err = #append(p.ran[i].err, chunk[k])
    return any

private (proc.Duplex d, bool ok) start_child([]string8 words):
    try proc.Duplex d = proc.duplex(words, proc.Errors.Pipe) else:
        proc.Duplex none
        return (none, false)
    return (d, true)

private i32 finish_status(^proc.Duplex d):
    try proc.Ended e = proc.finish(d, 0 - 1) else:
        return 127
    return shell_status(e)

// ── the units, every test's at once ─────────────────────────────────────────

// One C file of one test to compile to an object: the units `dadoc
// --split-out` wrote and the implementation unit (`moved`: each copied to a
// name made of what it holds first), or one of the manifest's `source` files,
// compiled where it is.
type UnitTask:
    Command flags            // the compiler and every flag before the `-I`s
    ref []string8 includes   // the `-I` list, `DADO_CFLAGS` on its tail
    string8 cc_id
    string8 unit
    bool moved
    // A dropped slot's unit (P10j): its digest and the name it was
    // compiled from, so its object is found without its C.
    string8 own_kept
    string8 named_kept
    i64 owner                // the test, by its place in the run

// Where `unit` is compiled from: `<dir>/<xxhash of its text>-<length>-<its
// name>`, written there (aside, then renamed) unless it already is; `unit`
// itself when it cannot be written. And its text's `content_digest`, "" when
// it cannot be read.
private (string8 named, string8 own) content_name(string8 dir, string8 unit, i64 mark):
    // Remembered beside the unit by its length and time, when they are
    // trusted (`trusted_stat`): a warm run reads no unit.
    string8 memo = txt(#format(unit, ".named"))
    string8 st = trusted_stat(unit, mark)
    if st != "-":
        ref []string8 m = words_of(read_or_empty(memo))
        if #len(m) == 4 && m[0] == st && is_file(m[1]):
            write_quietly(txt(#format(m[1], ".used")), "")
            return (m[1], txt(#format(m[2], " ", m[3])))
    try ref []char8 text = fs.read_file(unit) else:
        return (unit, "")
    u64 x = hash.xxh64_text(0, txt(text))
    string8 own = txt(#format(#len(text), " ", x))
    string8 named = join2(dir, txt(#format(x, "-", #len(text), "-", path.base(unit))))
    write_quietly(txt(#format(named, ".used")), "")
    if !is_file(named):
        string8 tmp = txt(#format(named, ".", os.pid(), ".tmp"))
        try fs.write_file(tmp, txt(text)) else:
            return (unit, own)
        try fs.rename(tmp, named) else:
            remove_quietly(tmp)
            return (unit, own)
    if st != "-": replace_quietly(memo, txt(#format(st, " ", named, " ", own)))
    return (named, own)

// What `emit_key` calls the `dadoc` at `program`: its bytes, by
// `put_large`, read again only when its length or time moved since the last
// run (`own_digest`, kept under `cache`): it is megabytes, and the driver
// that hashes it is built at `-O0`. "" when it cannot be read.
string8 dadoc_identity(string8 program, string8 cache):
    try fs.make_dirs(cache) else: pass
    string8 h = own_digest(cache, program, fs_now(cache))
    if #len(h) == 0: return ""
    Digest d = digest()
    put_text(&d, h)
    return finish_digest(&d)

// ── the command ─────────────────────────────────────────────────────────────

// How a test that did not get to run failed, said where its result goes.
private const i32 NOT_FAILED = 0
private const i32 DID_NOT_COMPILE = 1
private const i32 ENGINE_DID_NOT_BUILD = 2
private const i32 C_DID_NOT_BUILD = 3
private const i32 WASM_DID_NOT_BUILD = 4
private const i32 DID_NOT_START = 5

// One selected test, through the phases.
type TestRun:
    TestEntry t
    string8 name
    string8 t_c
    Command x                // the transpile, its outputs not yet added
    ref []string8 args       // the transpile's arguments: its slot and key
    string8 slot
    bool fresh
    bool caching
    bool from_owns           // its units' objects found by `owns` (P10j)
    string8 started
    i64 mark
    bool marked
    ref []char8 out          // what it printed before its result, replayed
    ref []char8 err
    i32 failure
    string8 unstarted
    bool web
    string8 bin
    Command run
    i32 status
    string8 said
    string8 printed          // its standard output
    string8 failed_cmd       // the compile or link that failed
    bool done
    // **One program per group** (`program_groups`): -1 for a test built
    // alone; else the place in the run of its group's first test, which
    // transpiles, compiles and links the group's program for all of them.
    i64 lead
    // The argument the group's program runs this test by, or "".
    string8 selector
    // `name`, or for a group's first test `name+N` (N the others): the C's
    // and the binary's name.
    string8 label
    // The package's test files this program does not hold, which its
    // transpile's key leaves out (`put_dir`).
    ref []string8 skip
    // Its place in the queue (`suite.dado`).
    i64 pkg
    i64 first_task
    i64 n_tasks
    i64 pending              // its units not yet compiled
    Link k
    string8 os
    string8 lkey             // the key its link is recorded under once it ends
    i32 stage                // in its batch: 0 on the way, 1 its part is ready, 2 not in it
    string8 part
    string8 entry            // the part's `main`, renamed
    i64 at                   // the runner's number for `entry`
    i64 ms                   // how long it ran, -1 when it did not
    i64 was                  // how long it ran last time (`test-times`), 0 when not known

// Whether `r` is built by its group's first test rather than by itself.
private bool built_by_lead(^TestRun r, i64 i):
    return r.lead >= 0 && r.lead != i

// The transpile of the selected `tests` (one for a test built alone, several
// for a group), before its outputs are added.
private Command transpile_of(^Plan p, ^Options o, []string8 tests):
    Command x = dadoc_command(p, o, true, false)
    if o.release: add(&x, "--release")
    if o.strict: add(&x, "--strict")
    for t in tests:
        add(&x, txt(#format("--test=", t)))
    if o.line_directives: add(&x, "--line-directives")
    string8 handlers = ubsan_handlers_flag(o)
    if #len(handlers) > 0: add(&x, handlers)
    add_all(&x, p.prefix_map[:])
    add(&x, p.pkg_abs)
    return x

// `r`'s transpile set to `x`: its arguments, its slot and whether the slot
// already answers it.
private void set_transpile(^TestRun r, Command x, string8 t_c, bool caching, string8 cache, string8 dadoc_id, []TestEntry all, []string8 held):
    ref []string8 skip = #make([]string8, 0)
    for t in all:
        bool in_it = false
        for h in held:
            if h == t.path: in_it = true
        if !in_it: skip = #append(skip, t.path)
    r.skip = skip
    ref []string8 args = #make([]string8, 0)
    for i in 1..<#len(x.words):
        args = #append(args, x.words[i])
    r.args = args
    r.x = x
    r.t_c = t_c
    r.caching = caching
    r.from_owns = false
    r.slot = txt(#format(t_c, ".d"))
    if caching: r.slot = emit_slot(cache, args[:])
    // A slot whose C was dropped (P10j) is fresh while `owns` keeps its
    // units' digests; `lay_out` finds their objects or runs it again.
    r.fresh = caching && emit_fresh(r.slot, dadoc_id, args[:], skip[:]) && is_file(join3(r.slot, "units", "units")) && (is_file(join2(r.slot, "prog.c")) || is_file(join3(r.slot, "units", "owns")))

// `r` built alone again (its transpile set after): its group's did not compile.
private void build_alone(^TestRun r):
    r.lead = 0 - 1
    r.selector = ""
    r.label = r.name
    r.failure = NOT_FAILED
    r.out = #make([]char8, 0)
    r.err = #make([]char8, 0)

private void keep_said(^TestRun r, Ran said):
    for c in said.out:
        r.out = #append(r.out, c)
    for c in said.err:
        r.err = #append(r.err, c)

// `text` ending in a newline: what comes next starts a line of its own.
string8 ended_line(string8 text):
    if #len(text) == 0: return text
    char8 last = text[#len(text) - 1]
    if last == '\n': return text
    return txt(#format(text, "\n"))

// The test's line, after what it printed on the way.
private void say_result(^TestRun r, ^i64 passed, ^i64 failed, Compiler cc, []string8 san_c, []string8 san_l, bool sanitized):
    if #len(r.out) > 0: fmt.print(ended_line(txt(r.out)))
    if #len(r.err) > 0:
        _ = io.flush(io.stdout())
        fmt.eprint(ended_line(txt(r.err)))
        _ = io.flush(io.stderr())
    if r.failure == DID_NOT_COMPILE:
        say_red("FAIL", txt(#format(" ", r.name, " (did not compile)")))
    else if r.failure == ENGINE_DID_NOT_BUILD:
        say_red("FAIL", txt(#format(" ", r.name, " (the DadoScript engine did not build: tools/quickjs/build.sh --cc ", cc.name, " says why)")))
    else if r.failure == C_DID_NOT_BUILD:
        if sanitized: recheck_sanitizer(cc, san_c, san_l)
        say_red("FAIL", txt(#format(" ", r.name, " (the C did not build: generated C the C compiler rejects is a compiler bug; rerun with --keep-c to keep it)")))
        if #len(r.err) == 0 && #len(r.failed_cmd) > 0:
            fmt.print(indented(txt(#format("it said nothing: ", r.failed_cmd, "\n-v shows every command"))))
    else if r.failure == WASM_DID_NOT_BUILD:
        say_red("FAIL", txt(#format(" ", r.name, " (the C did not build for wasm32: generated C the C compiler rejects is a compiler bug; rerun with --keep-c to keep it)")))
    else if r.failure == DID_NOT_START:
        say_red("FAIL", txt(#format(" ", r.name, " (", r.unstarted, ")")))
    else:
        report(r.name, r.status, r.t.status, r.printed, r.said, passed, failed)
        return
    failed^ += 1

// A transpile's outputs moved from their `.<pid>` names into the slot, and
// the slot's key written last, so a slot whose key matches is never
// half-written; or, when `dadoc` failed, the test marked and the slot's
// leftovers removed.
private void settle_slot(^TestRun r, bool ok, bool caching, string8 dadoc_id, i64 pid):
    string8 slot_c = join2(r.slot, "prog.c")
    string8 slot_build = join2(r.slot, "build")
    string8 slot_impl = join2(r.slot, "impl.c")
    string8 slot_units = join2(r.slot, "units")
    string8 slot_key = join2(r.slot, "key")
    string8 t_scripts = join2(r.slot, "scripts")
    string8 tmp_c = txt(#format(slot_c, ".", pid))
    string8 tmp_build = txt(#format(slot_build, ".", pid))
    string8 tmp_impl = txt(#format(slot_impl, ".", pid))
    string8 tmp_units = txt(#format(slot_units, ".", pid))
    string8 tmp_scripts = txt(#format(t_scripts, ".", pid))
    if !ok:
        remove_if_there(tmp_c)
        remove_if_there(tmp_build)
        remove_if_there(tmp_impl)
        remove_tree_quietly(tmp_units)
        remove_if_there(slot_key)
        remove_if_there(r.started)
        remove_tree_quietly(tmp_scripts)
        r.failure = DID_NOT_COMPILE
        return
    remove_if_there(slot_key)
    move_or_die(tmp_c, slot_c)
    move_or_die(tmp_build, slot_build)
    if exists(tmp_impl):
        move_or_die(tmp_impl, slot_impl)
    else:
        remove_if_there(slot_impl)
    remove_tree_quietly(slot_units)
    if exists(tmp_units): move_or_die(tmp_units, slot_units)
    remove_tree_quietly(t_scripts)
    if exists(tmp_scripts): move_or_die(tmp_scripts, t_scripts)
    string8 written = read_or_empty(slot_build)
    bool moved = !r.marked || sources_moved(written, r.mark)
    remove_if_there(r.started)
    if caching && !moved:
        string8 key = emit_key(dadoc_id, r.args[:], written, r.skip[:])
        if #len(key) > 0:
            string8 tmp_key = txt(#format(slot_key, ".", pid))
            try fs.write_file(tmp_key, key) else:
                key = ""
            if #len(key) > 0:
                try fs.rename(tmp_key, slot_key) else:
                    remove_if_there(tmp_key)
