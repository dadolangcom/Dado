// Running the programs a build is made of: `dadoc`, the C compiler, the
// program built, and the probes that ask a compiler what it can do.
//
// **Every command is an argument list, never a shell line**, so a path with a
// space or a quote in it is one argument and nothing else. `core:os/proc`
// starts each one: `exec` when it should talk to the terminal directly, and a
// `Duplex` when its output is read or thrown away.
//
// **Standard output is flushed before every child starts**, so this
// program's own lines and the child's arrive in the order they were made.
//
// Exit statuses are the shell's: a program that returned is its status, one a
// signal ended is 128 plus the signal, and one that could not be started is
// 127, as `sh` reports a command it cannot run.
package driver

import "core:fmt"
import "core:io"
import "core:os"
import "core:os/fs"
import "core:os/proc"
import "core:path"
import "core:strings"

// Whether `-v` was given: each command is echoed before it runs.
private bool g_verbose

void set_verbose(bool on):
    g_verbose = on

bool verbose():
    return g_verbose

// ── colour, and the three kinds of line ─────────────────────────────────────

// The escape sequences, each empty when this run does not colour
// (`colour.dado` decides: `--color`, `NO_COLOR`, a terminal). `g_red` is
// the brand's copper and `g_dim` its slate; `g_yellow`, a warning's, is
// bold, as the compiler writes one.
private string8 g_bold = ""
private string8 g_red = ""
private string8 g_green = ""
private string8 g_dim = ""
private string8 g_yellow = ""
private string8 g_reset = ""
private bool g_colour_asked

private void colour():
    if g_colour_asked: return
    g_colour_asked = true
    g_bold = ""
    g_red = ""
    g_green = ""
    g_dim = ""
    g_yellow = ""
    g_reset = ""
    if colour_on():
        bool deep = colour_deep()
        g_bold = "\x1b[1m"
        g_red = copper_escape(deep)
        g_green = "\x1b[32m"
        g_dim = slate_escape(deep)
        g_yellow = "\x1b[1m"
        g_reset = "\x1b[0m"

// Decide again at the next line: `--color` was read after a line may
// already have been written.
void recolour():
    g_colour_asked = false

// A line of the driver's own framing, in bold: `dadoc  corpus/tour`.
void say(string8 line):
    colour()
    fmt.println(g_bold, line, g_reset)

// A framing line whose first word is green: `built <path>`, `ok <name>`.
void say_green(string8 word, string8 rest):
    colour()
    fmt.println(g_bold, g_green, word, g_reset, rest, g_reset)

// A line in dim: where each artifact went.
void note(string8 line):
    colour()
    fmt.println(g_dim, line, g_reset)

// `note: <text>` on standard error: a fact about this build worth seeing,
// that is neither wrong nor a risk to fix.
void note_err(string8 text):
    colour()
    _ = io.flush(io.stdout())
    fmt.eprintln(g_dim, "note:", g_reset, " ", text)

// `warning: <text>` on standard error.
void warn(string8 text):
    colour()
    _ = io.flush(io.stdout())
    fmt.eprintln(g_yellow, "warning:", g_reset, " ", text)

// `error: <text>` on standard error, and the process goes on.
void say_error(string8 text):
    colour()
    _ = io.flush(io.stdout())
    fmt.eprintln(g_red, "error:", g_reset, " ", text)

// `error: <text>` on standard error, and the process ends with status 1.
void die(string8 text):
    drop_c()
    colour()
    _ = io.flush(io.stdout())
    fmt.eprintln(g_red, "error:", g_reset, " ", text)
    _ = io.flush(io.stderr())
    os.quit_with(1)

// Generated C written only to hand to cc (P10j): removed once cc has run,
// whether it built or not (`drop_c`; `die` too). `--keep-c` registers none.
private ref []string8 g_c_trash

void c_trash(string8 p):
    g_c_trash = #append(g_c_trash, txt(#format(p)))

void drop_c():
    for p in g_c_trash:
        if is_dir(p): remove_tree_quietly(p)
        else if exists(p): remove_quietly(p)
    #truncate(g_c_trash, 0)

// Why the program at `program`, which ended with status 127 (the shell's
// "could not run"), could not be started, or "" when it is there and
// runnable, so the 127 is its own: `exec_failure_text` over what the file
// system says. On Windows a file's name makes it runnable, so only a
// missing program is a failure to start.
string8 exec_failure(string8 program):
    bool there = is_file(program)
    bool runnable = there
    when #OS != #WINDOWS:
        runnable = there && fs.is_executable(program)
    return exec_failure_text(program, there, runnable)

// What `exec_failure` says: nothing for a program that is there and may be
// run; that it is not there; or that it may not be run, which is a
// directory mounted `noexec` when the build itself made it executable.
string8 exec_failure_text(string8 program, bool there, bool runnable):
    if !there: return txt(#format("cannot run ", program, ": it is not there"))
    if !runnable:
        return txt(#format("cannot run ", program, ": permission denied (a build directory on a noexec mount does this:\n  DADO_BUILD_DIR=<a directory programs can run from> builds there instead)"))
    return ""

// The dim `---` that brackets a program's own output under `run`.
void rule():
    colour()
    fmt.println(g_dim, "---", g_reset)

// ── commands ────────────────────────────────────────────────────────────────

// An argument list being assembled, and whether `-v` echoes it.
type Command:
    ref []string8 words
    bool echoed
    // A compiler's: past `ARGS_WORDS` words or `ARGS_BYTES` bytes, the words
    // after its first `args_from` go to `args_file`, read as `@<file>`
    // (`fitted`). 0: never.
    i64 args_from
    string8 args_file
    // The reader of `@<file>` is GNU's whatever the program is called
    // (`zig wasm-ld`: LLD reads the file, not zig).
    bool args_gnu

Command command(string8 program):
    ref []string8 w = #make([]string8, 0)
    w = #append(w, program)
    Command c
    c.words = w
    c.echoed = true
    c.args_from = 0
    c.args_file = ""
    return c

Command command_of([]string8 words):
    ref []string8 all = #make([]string8, 0)
    for w in words:
        all = #append(all, w)
    Command c
    c.words = all
    c.echoed = true
    c.args_from = 0
    c.args_file = ""
    return c

void add(^Command c, string8 word):
    c.words = #append(c.words, word)

// Every word of `words`, in order.
void add_all(^Command c, []string8 words):
    for w in words:
        c.words = #append(c.words, w)

// Each whitespace-separated word of `text`: a flag list from `defaults` or
// from the environment, which the shell would have split the same way.
void add_split(^Command c, string8 text):
    for w in words_of(text):
        c.words = #append(c.words, w)

// The command as one line, words separated by a space, for `-v` and for
// messages.
string8 shown(Command c):
    ref []char8 j = strings.join(c.words[:], " ")
    return txt(j)


const i64 ARGS_WORDS = 128
const i64 ARGS_BYTES = 8000

// `c` given a response file: its first `from` words (the compiler) stay on
// the line when it is long.
void respond(^Command c, i64 from, string8 file):
    c.args_from = from
    c.args_file = file

// Whether `c` goes through its response file when started.
bool long_command(Command c):
    if c.args_from <= 0 || #len(c.args_file) == 0: return false
    if c.args_from >= i64(#len(c.words)): return false
    if i64(#len(c.words)) > ARGS_WORDS: return true
    i64 bytes = 0
    for w in c.words:
        bytes += i64(#len(w)) + 1
    return bytes > ARGS_BYTES

// `c` as started: when `long_command`, its words after `args_from` written
// to `args_file` and `@<file>` in their place. `why`: "" or why the file
// could not be written.
(Command fit, string8 why) fitted(Command c):
    if !long_command(c): return (c, "")
    i64 n = i64(#len(c.words))
    bool zig = zig_program(c.words[0]) && !c.args_gnu
    if !fits_response(c.words[c.args_from..<n], zig): return (c, "")
    string8 text = response_text(c.words[c.args_from..<n], zig)
    try fs.write_file(c.args_file, text) else code:
        return (c, txt(#format("cannot write ", c.args_file, ": ", os.message(code))))
    ref []string8 head = #make([]string8, 0)
    for i in 0..<c.args_from:
        head = #append(head, c.words[i])
    Command f = command_of(head[:])
    add(&f, txt(#format("@", c.args_file)))
    f.echoed = c.echoed
    return (f, "")

// Whether `program` is zig (`zig cc`), whose response-file reader is not GCC's.
bool zig_program(string8 program):
    string8 b = path.base(program)
    return strings.starts_with(b, "zig")

// `words` as the compiler reads them back from `@<file>`, a word a line.
//
// GCC's reader (libiberty's `buildargv`), clang's (LLVM's GNU tokenizer) and
// tcc's take a word in double quotes with `\"` and `\\` inside: every word is
// written so. zig's (`std.process.Args`' general iterator, on every host) is
// Windows' rule — the one `CommandLineToArgvW` and Rust's `Command` quote for —
// where a backslash is itself unless quotes follow it: a word is quoted
// when it is empty, holds whitespace or starts a `#` comment, and a run of
// backslashes is doubled only in front of a `"`. zig also reads `'` as a
// quote and no escape gives it back, so a word holding one cannot be
// written for zig (`fits_response`).
string8 response_text([]string8 words, bool zig = false):
    strings.Builder b = strings.builder(4096)
    for w in words:
        if zig: zig_word(&b, w)
        else:
            strings.append_char(&b, '"')
            for ch in w:
                if ch == '"' || ch == '\\': strings.append_char(&b, '\\')
                strings.append_char(&b, ch)
            strings.append_char(&b, '"')
        strings.append_char(&b, '\n')
    return txt(strings.finish(&b))

private void zig_word(^strings.Builder b, string8 w):
    bool quote = #len(w) == 0 || w[0] == '#'
    for ch in w:
        if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r': quote = true
    if quote: strings.append_char(b, '"')
    i64 slashes = 0
    for ch in w:
        if ch == '\\':
            slashes += 1
        else:
            if ch == '"':
                for _ in 0..<slashes + 1: strings.append_char(b, '\\')
            slashes = 0
        strings.append_char(b, ch)
    if quote:
        for _ in 0..<slashes: strings.append_char(b, '\\')
        strings.append_char(b, '"')

// Whether every word can be written to `@<file>` for this compiler: for zig,
// none may hold a `'`.
bool fits_response([]string8 words, bool zig):
    if !zig: return true
    for w in words:
        if strings.has_byte(w, '\''): return false
    return true

// Why `c` cannot be started: too many words.
string8 too_long(Command c):
    return txt(#format("a command of ", #len(c.words), " words is more than the ", proc.ARG_CAP, " this driver can start: ", shown(c)))

private void echo(Command c):
    if g_verbose && c.echoed:
        note(txt(#format("  $ ", shown(c))))

// The shell's reading of an ending: the exit code, or 128 and the signal.
private i32 shell_status(proc.Ended e):
    switch e:
        case proc.Exited x: return x.code
        case proc.Signaled s: return 128 + s.signal

// Run `c` with this process's own standard streams, and answer its status.
i32 run(Command c):
    echo(c)
    return run_quietly(c)

// `run`, not echoed even under `-v`.
i32 run_quietly(Command c):
    (Command f, string8 why) = fitted(c)
    if #len(why) > 0: die(why)
    if #len(f.words) > proc.ARG_CAP: die(too_long(f))
    _ = io.flush(io.stdout())
    _ = io.flush(io.stderr())
    i32 st = exec_status(f)
    if long_command(c): remove_quietly(c.args_file)
    return st

private i32 exec_status(Command c):
    try proc.Ended e = proc.exec(c.words[:]) else:
        return 127
    return shell_status(e)

// What a command printed on standard output, and how it ended.
type Captured:
    i32 status
    ref []char8 out
    bool started

// Run `c`, reading its standard output; its standard error goes to this
// process's own unless `quiet`, when it is thrown away. `input`, when not
// empty, is written to its standard input.
Captured capture(Command c, bool quiet, string8 input = ""):
    proc.Errors errors = proc.Errors.Discard if quiet else proc.Errors.Inherit
    return capture_with(c, errors, input)

// `capture`, with standard error folded into what is read, as `2>&1`.
Captured capture_merged(Command c):
    return capture_with(c, proc.Errors.Merge, "")

private Captured capture_with(Command c, proc.Errors errors, string8 input):
    Captured r
    r.status = 127
    r.out = #make([]char8, 0)
    r.started = false
    (Command f, string8 why) = fitted(c)
    if #len(why) > 0 || #len(f.words) > proc.ARG_CAP: return r
    _ = io.flush(io.stdout())
    _ = io.flush(io.stderr())
    try proc.Duplex d = proc.duplex(f.words[:], errors) else:
        return r
    r.started = true
    []char8 bytes = strings.bytes(input)
    i64 sent = 0
    if #len(bytes) == 0:
        _ = proc.close_input(&d)
    [16384]char8 chunk
    for:
        if sent < #len(bytes):
            i64 n = 0
            try n = proc.send(&d, bytes[sent..<#len(bytes)], 10) else why:
                // `BROKE`: the child stopped reading; nothing more goes in.
                if why == proc.Pipe.BROKE: sent = #len(bytes)
            sent += n
            if sent >= #len(bytes):
                _ = proc.close_input(&d)
        i64 got = 0
        try got = proc.receive(&d, chunk[:], 10 if sent < #len(bytes) else 0 - 1) else why2:
            if why2 == proc.Pipe.BROKE: break
            got = 0 - 1
        if got == 0: break
        if got > 0:
            for i in 0..<got:
                r.out = #append(r.out, chunk[i])
    proc.close_pipes(&d)
    try proc.Ended e = proc.finish(&d, 0 - 1) else:
        return r
    r.status = shell_status(e)
    if long_command(c): remove_quietly(c.args_file)
    return r

// The first line `c` prints, trimmed; empty when it fails or says nothing.
string8 first_line(Command c, bool quiet):
    Captured r = capture(c, quiet)
    if !r.started || r.status != 0: return ""
    string8 out = r.out
    (string8 l, string8 _, bool _) = strings.line(out)
    return strings.trim(l)

// Whether `c` starts and exits 0, everything it prints thrown away.
bool succeeds(Command c):
    Captured r = capture(c, true)
    return r.started && r.status == 0

// Whether `c` starts and exits 0 within `limit_ms`, everything it prints
// thrown away. `hung` is true when it was still running at the limit; it is
// killed then, and its process tree with it.
(bool ok, bool hung) succeeds_within(Command c, i32 limit_ms):
    if #len(c.words) > proc.ARG_CAP: return (false, false)
    try proc.Duplex d = proc.duplex(c.words[:], proc.Errors.Discard) else:
        return (false, false)
    proc.close_pipes(&d)
    try proc.Ended e = proc.finish(&d, limit_ms) else why:
        if why == proc.Pipe.WAITED:
            try _ = proc.stop(&d, 0) else: pass
            return (false, true)
        return (false, false)
    return (shell_status(e) == 0, false)

// ── signals, for the program `run` starts ───────────────────────────────────
//
// Reading a child's output through a `Duplex` sets `SIGPIPE` to ignored in
// this process, and an ignored signal survives `exec`: the program `run`
// starts would inherit it, and a `run … | head` would no longer stop it. So
// the default is put back just before that program starts.
when #OS == #WINDOWS:
    void default_sigpipe():
        return
else:
    private type SigHandler: void(i32)

    private foreign sig "signal.h" define "_POSIX_C_SOURCE=200809L" define "_DARWIN_C_SOURCE=1":
        const i32 SIGPIPE
        const SigHandler SIG_DFL
        SigHandler signal(i32 signum, SigHandler handler)

    void default_sigpipe():
        _ = sig.signal(sig.SIGPIPE, sig.SIG_DFL)

// ── finding a program ───────────────────────────────────────────────────────

when #OS == #WINDOWS:
    private const char8 PATH_LIST = ';'
else:
    private const char8 PATH_LIST = ':'

// The file `name` runs as when looked up on `PATH`, or "" when no directory
// on it holds one. A name with a separator in it is not looked up: it is
// answered as written when it is a file that runs.
string8 on_path(string8 name):
    if strings.has_byte(name, '/') || strings.has_byte(name, '\\'):
        if runs_as_written(name): return name
        return ""
    (string8 dirs, bool set) = env("PATH")
    if !set: return ""
    string8 rest = dirs
    for:
        (string8 d, string8 tail, bool more) = split_byte(rest, PATH_LIST)
        if #len(d) > 0:
            string8 candidate = join2(d, name)
            if runs_as_written(candidate): return candidate
            when #OS == #WINDOWS:
                string8 exe = txt(#format(candidate, ".exe"))
                if runs_as_written(exe): return exe
        if !more: break
        rest = tail
    return ""

private bool runs_as_written(string8 p):
    return fs.is_executable(p)

// `s` cut at the first `sep`.
(string8 head, string8 rest, bool found) split_byte(string8 s, char8 sep):
    i64 at = strings.index_of(s, sep)
    if at < 0: return (s, s[#len(s)..<#len(s)], false)
    return (s[0..<at], s[at + 1..<#len(s)], true)
