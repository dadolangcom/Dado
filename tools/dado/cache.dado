// What `dado test` keeps between passes, under `<build>/.dado-cache`.
//
// **The same packages are tested again and again** — under gcc and clang,
// sanitized and not — and most of what a pass does is the last pass's work
// over again: the transpile, the test's own C, and the vendored libraries'
// bodies (sokol, stb_truetype) that every test reaching them compiles. Measured
// on a 2-core box with gcc 13.3.0 and clang 18.1.3, one `collections/app/ui`
// test under gcc `-O2` was 1.8 s user for `dadoc`, 3.7 s for its own C and
// 5.2 s for the vendored bodies. These caches answer that, all keyed by what
// decides their content and nothing looser, all safe to delete at any time:
//
//   * `emit/` — one `dadoc` run per test per argument list: the C (`prog.c`),
//     the build manifest (`build`), the units (`units/`, `--split-out`) and
//     the implementation unit (`impl.c`, when `dadoc` split one out), reused
//     while `key` matches. See `emit_key`.
//   * `emit/` serves `dado build` too (`front_end`, engine.dado), and
//     `digests` keeps each source's stat and hash between runs.
//   * `units/` — one object per C file per compiler per flag set per set of
//     headers it read, shared by `dado build` and every test
//     (`unit_objects`, `task_objects`). The run happens every time: a test's
//     result is what the binary does.
//
// **A key that cannot be taken is a miss**, never a guess: a directory or file
// that cannot be read, a compile whose headers moved while it ran. When the `dadoc` binary
// itself cannot be read, `emit/` is off for the run and every test is
// transpiled every pass.
package driver

import "core:hash"
import "core:io"
import "core:mem/libc"
import "core:os"
import "core:os/fs"
import "core:os/proc"
import "core:path"
import "core:strings"
import "core:time"

// ── the digest ──────────────────────────────────────────────────────────────

// One SHA-256 over a list of items, each **length-framed** (eight bytes of
// little-endian length, then the bytes) so no two lists hash alike: `a`,`bc`
// and `ab`,`c` are different keys. `ok` goes false at the first item that
// cannot be read, and a digest that is not ok has no answer.
type Digest:
    hash.Sha256 h
    bool ok

Digest digest():
    Digest d
    d.h = hash.sha256_init()
    d.ok = true
    return d

private void put_length(^Digest d, i64 n):
    [8]u8 b
    u64 v = u64(n)
    for i in 0..<8:
        b[i] = u8((v >> u64(8 * i)) & 0xFF)
    d.h.update(b[:])

// An item: `text`'s bytes.
void put_text(^Digest d, string8 text):
    put_length(d, #len(text))
    d.h.update_text(text)

// An item: the bytes of the file at `p`.
void put_file(^Digest d, string8 p):
    try ref []char8 bytes = fs.read_file(p) else:
        d.ok = false
        return
    put_text(d, txt(bytes))

// An item: the file at `p`, by `put_large`, through `file_digest`.
void put_file_large(^Digest d, string8 p):
    string8 h = file_digest(p)
    if #len(h) == 0:
        d.ok = false
        return
    put_text(d, h)

// Every file's `content_digest` this run has taken, by path, after the
// `trusted_stat` it was taken at: `dado test` keys every test's sources
// (`emit_key`), and the tests of one package read the same packages, so
// each file is read once a run rather than once a test.
private {string8: string8} g_digests

// The file at `p`'s length and xxHash64 (`content_digest`, which `put_large`
// frames the same), read again only when this run has not read it, or its
// length or time moved since, or it was too new then to vouch for its bytes.
// "" when it cannot be read.
string8 file_digest(string8 p):
    string8 now = stat_of(p)
    if #len(now) == 0: return ""
    if p in g_digests:
        (string8 kept, bool _) = g_digests[p]
        (string8 sig, string8 held, bool _) = strings.split_first(kept, " ")
        if sig != "-" && sig == now: return held
    string8 h = content_digest(p)
    if #len(h) == 0: return ""
    ref []char8 own_p = #format(p)
    if !(p in g_digests): g_digest_paths = #append(g_digest_paths, txt(own_p))
    g_digests[txt(own_p)] = txt(#format(trusted_stat(p, time.unix_nanos()), " ", h))
    g_digests_moved = true
    return h

private bool g_digests_moved
private ref []string8 g_digest_paths

// `file_digest`'s answers kept between runs in the file at `p`, one
// `<path>\t<trusted stat> <digest>` line each: a build whose sources did not
// move reads their stats, not their bytes.
void load_digests(string8 p):
    for l in lines_of(read_or_empty(p)):
        (string8 path, string8 kept, bool ok) = strings.split_first(l, "\t")
        if !ok || path in g_digests: continue
        ref []char8 own_p = #format(path)
        ref []char8 own_k = #format(kept)
        g_digests[txt(own_p)] = txt(own_k)
        g_digest_paths = #append(g_digest_paths, txt(own_p))

void save_digests(string8 p):
    if !g_digests_moved: return
    strings.Builder b = strings.builder(16384)
    for path in g_digest_paths:
        (string8 kept, bool _) = g_digests[path]
        strings.append(&b, txt(#format(path, "\t", kept, "\n")))
    replace_quietly(p, strings.text(b))
    g_digests_moved = false

// An item that is large, by its length and its xxHash64: one SHA-256 over a
// megabyte took a third of a second in the driver as `dadoc launch` builds
// it, at `-O0`, and the xxHash a tenth of that. 64 bits keep two different
// texts of one length apart well past any number of entries a cache holds;
// the key is still the SHA-256 of every item.
void put_large(^Digest d, string8 text):
    put_text(d, txt(#format(#len(text), " ", hash.xxh64_text(0, text))))

// An item: `text` with every occurrence of `unsaid` taken out, framed by the
// length of what is left. Nothing is taken out when `unsaid` is empty.
void put_unsaid(^Digest d, string8 text, string8 unsaid):
    if #len(unsaid) == 0:
        put_text(d, text)
        return
    i64 n = #len(text)
    string8 rest = text
    for:
        (string8 _, string8 tail, bool found) = strings.split_first(rest, unsaid)
        if !found: break
        n -= #len(unsaid)
        rest = tail
    put_length(d, n)
    rest = text
    for:
        (string8 head, string8 tail, bool found) = strings.split_first(rest, unsaid)
        d.h.update_text(head)
        if !found: break
        rest = tail

// The items a package directory is to `dadoc`: `%<dir>` itself, then in
// byte order of name each `*.dado` and `*.dados` file's name and bytes, by
// `put_large`, since a test's packages are megabytes of source and its emit
// key is taken on every run (a
// `.dados` script is a source of the package like any `.dado`) and each
// `*.c` and `*.dadogl` file's name — `dadoc` reads those names and never those bodies.
//
// `skip` names files, by path, the compilation is known not to read: a
// package's `@test` files other than the ones it holds, as `dadoc
// --emit=tests` lists them, so an edit to one test file moves only the keys
// of the programs that hold it. **Compared with links followed**
// (`skipped_here`): the manifest names a directory as `dadoc` resolved it,
// and the test files are named as the person typed the package, so a
// package reached through a link (a `target` that is one) skipped nothing,
// and an edit to one test file moved every program's key.
void put_dir(^Digest d, string8 dir, []string8 skip = nil):
    put_text(d, txt(#format("%", dir)))
    try fs.Listing l = fs.read_dir(dir) else:
        d.ok = false
        return
    ref []string8 unread = skipped_here(dir, skip)
    ref []string8 names = #make([]string8, 0)
    for e in l.entries:
        string8 n = e.path
        if #len(unread) > 0 && is_source(n) && in_names(n, unread[:]): continue
        if is_source(n) || strings.ends_with(n, ".c") || strings.ends_with(n, ".dadogl"):
            ref []char8 own = #format(n)
            names = #append(names, txt(own))
    l.destroy()
    sort_bytes(names[:])
    for n in names:
        put_text(d, n)
        if is_source(n): put_file_large(d, join2(dir, n))

// The names of the files of `skip` that are in `dir`, the directories
// compared by `comparable_path` (links followed). The files of `skip` are one
// package's, so its directory is resolved once, not once per file.
private ref []string8 skipped_here(string8 dir, []string8 skip):
    ref []string8 out = #make([]string8, 0)
    if #len(skip) == 0: return out
    string8 here_dir = comparable_path(dir)
    string8 last = ""
    bool last_here = false
    for s in skip:
        string8 s_dir = dir_of(s)
        if #len(last) == 0 || s_dir != last:
            last = s_dir
            last_here = comparable_path(s_dir) == here_dir
        if last_here: out = #append(out, base_name(s))
    return out

// Whether `n` is one of `names`.
private bool in_names(string8 n, []string8 names):
    for m in names:
        if m == n: return true
    return false

private bool is_source(string8 name):
    return strings.ends_with(name, ".dado") || strings.ends_with(name, ".dados")

// The digest as 64 hex digits, or "" when an item could not be read.
string8 finish_digest(^Digest d):
    hash.Sha256Digest out = d.h.finish()
    if !d.ok: return ""
    return txt(hash.hex(out))

// ── emit/ ───────────────────────────────────────────────────────────────────

// Where one `dadoc` argument list's outputs live: `<cache>/emit/<name>`.
//
// **Per argument list and not per test**, because gcc and clang answer
// `-dumpmachine` differently (`x86_64-linux-gnu`, `x86_64-pc-linux-gnu`), so
// the two compilers' passes ask `dadoc` two questions and would evict each
// other from one slot every pass. The name is the first 16 hex digits of the
// list's digest: a collision would only make two lists share a slot and
// re-transpile each other, because `emit_key`, which decides, is the whole
// digest.
string8 emit_slot(string8 cache, []string8 args):
    return join3(cache, "emit", slot_name(args))

string8 slot_name([]string8 args):
    Digest d = digest()
    for a in args:
        put_text(&d, a)
    string8 full = finish_digest(&d)
    if #len(full) < 16: return full
    return full[0..<16]

// The `include` directories of a build manifest, in order: each line's text
// after `include `, exactly as written.
ref []string8 included_dirs(string8 manifest):
    return manifest_lines(manifest, "include ")

// `input` lines: other files the front end read (the new one's `runtime.js`).
ref []string8 input_files(string8 manifest):
    return manifest_lines(manifest, "input ")

private ref []string8 manifest_lines(string8 manifest, string8 kind):
    ref []string8 out = #make([]string8, 0)
    string8 rest = manifest
    for #len(rest) > 0:
        (string8 l, string8 tail, bool more) = strings.line(rest)
        if strings.starts_with(l, kind) && #len(l) > #len(kind):
            out = #append(out, l[#len(kind)..<#len(l)])
        if !more: break
        rest = tail
    return out

// The environment variables `dadoc` reads when it compiles to C, as its
// transpile cache keys them (`KEYED_ENV` there): each one set is part of
// `emit_key`.
const string8 DADOC_ENV = "DADO_UNIT_BYTES DADO_HOST_PRUNED DADO_WEB_INLINE DADO_NODE"

// What a slot's C was transpiled from: this `dadoc` (`dadoc_id`, the digest
// of its bytes), the argument list, the variables of `DADOC_ENV` that are
// set, and every package directory the slot's
// own manifest says the compilation loaded. "" when any of it cannot be read.
//
// **The directory list is the stored one, and that is sound**: `dadoc` reads
// nothing but the `.dado`/`.dados` files of the packages it loads (and the
// names of their `.c` files), so a change that would make it load a different
// set is an edit to an `import` in a file of a package it already loaded —
// which is in this digest. What it does not cover is a file changed *while*
// that one `dadoc` ran; `test_command` refuses to store a key then.
//
// `skip` is `put_dir`'s: test files the compilation does not hold.
string8 emit_key(string8 dadoc_id, []string8 args, string8 manifest, []string8 skip = nil):
    Digest d = digest()
    put_text(&d, dadoc_id)
    for a in args:
        put_text(&d, a)
    for name in words_of(DADOC_ENV):
        (string8 v, bool set) = env(name)
        if set: put_text(&d, txt(#format(name, "=", v)))
    for dir in included_dirs(manifest):
        put_dir(&d, dir, skip)
    for f in input_files(manifest):
        put_text(&d, txt(#format("<", f)))
        put_file_large(&d, f)
    return finish_digest(&d)

// Whether `slot` already holds this argument list's answer for the sources
// as they are now. Its C may be dropped (P10j): callers ask for it or `owns`.
bool emit_fresh(string8 slot, string8 dadoc_id, []string8 args, []string8 skip = nil):
    if #len(dadoc_id) == 0: return false
    string8 key_file = join2(slot, "key")
    if !is_file(key_file) || !is_file(join2(slot, "build")):
        return false
    try ref []char8 manifest = fs.read_file(join2(slot, "build")) else:
        return false
    string8 key = emit_key(dadoc_id, args, txt(manifest), skip)
    if #len(key) == 0: return false
    return strings.trim(read_or_empty(key_file)) == key

// Whether a `.dado` or `.dados` file in one of the manifest's directories
// changed after `mark` (nanoseconds), or cannot be asked: then the C may be
// the old text's, and must not be stored under the new text's key.
bool sources_moved(string8 manifest, i64 mark):
    for f in input_files(manifest):
        try i64 t = fs.mtime(f) else:
            return true
        if t > mark: return true
    for dir in included_dirs(manifest):
        if !is_dir(dir): continue
        try fs.Listing l = fs.read_dir(dir) else:
            return true
        bool moved = false
        for e in l.entries:
            string8 n = e.path
            if !is_source(n): continue
            try i64 t = fs.mtime(join2(dir, n)) else:
                moved = true
                break
            if t > mark:
                moved = true
                break
        l.destroy()
        if moved: return true
    return false

// ── units/ ──────────────────────────────────────────────────────────────────

// What the object caches call this C compiler: the program its first word
// runs as, every word, what `--version` prints, and the file the program is
// and when it was last written (`program_stamp`), so a compiler replaced in
// place is another compiler even when it says the same `--version`.
string8 compiler_identity(Compiler cc):
    Command v = command_of(cc.words[:])
    add(&v, "--version")
    Captured r = capture(v, true)
    string8 said = ""
    if r.started && r.status == 0: said = strings.trim_right(txt(r.out))
    return txt(#format(on_path(cc.words[0]), " ", shown(command_of(cc.words[:])), " ", said, " ", program_stamp(cc.words[0])))

// `text` written to `p`, or nothing when it cannot be.
void write_quietly(string8 p, string8 text):
    try fs.write_file(p, text) else:
        return

// `text` written to `p` whole or not at all: aside, then renamed, so a
// concurrent reader sees the old file or the new one.
void replace_quietly(string8 p, string8 text):
    string8 tmp = txt(#format(p, ".", os.pid(), ".tmp"))
    try fs.write_file(tmp, text) else:
        return
    try fs.rename(tmp, p) else:
        remove_quietly(tmp)

// A build's objects (CP-13 step 4): the many-file form
// `dadoc --split-out` writes, units of a package or so and a runtime file,
// each compiled at most once for what it holds, several at a time.
//
// **The key takes no compiler start.** A unit's object is found by what it
// was made of, in two steps:
//
//   * **its book**, `units/<digest>.dep`, named by the unit's path and the
//     length and xxHash64 of its own bytes, the compiler's identity
//     (`compiler_identity`), every flag, the `-I` list, `DADO_CFLAGS`, and
//     the environment a compiler finds headers and dates by
//     (`HEADER_ENV`). It lists every file the compile read besides the unit,
//     each with its length and xxHash64: the headers the compiler's own
//     `-MD -MF` file named (every one, the system's included, in whatever
//     directory and under whatever name `#include` found it);
//   * **its object**, `units/<digest>.o`, named by the book's name and those
//     headers' paths and hashes as they are now.
//
// So an edited header, a changed flag or compiler or `DADO_CFLAGS` is a
// different object, and a unit whose book is not there, or names a file
// that is gone, is compiled. A file is hashed again only when its length or
// time moved (`file_digest`); a change that keeps both, made within two
// seconds of the build that last recorded the file, is caught because a
// time that recent is never trusted.
//
// **A file changed while its unit compiled** leaves no book: the object is
// compiled for this build alone (`unkeyed.<pid>.<n>.o`), and the next build
// compiles it again.
//
// Two builds sharing the directory each compile into a file of their own
// pid and rename it into place, so the worst a race costs is a compile.
// Every build that uses an object writes its `<key>.o.used` beside it, and
// its book's `.used` (`core:os/fs` sets no file times), and an object whose
// last use is a week old is swept by the next build (`sweep_units`), never
// one this build uses; should one go between the check and the link anyway,
// the build compiles it again (`unit_objects` is asked twice by its caller).
type UnitsJob:
    string8 cache                  // `<build>/.dado-cache`
    string8 cc_id
    Command flags                  // the compiler and every flag before the `-I`s
    ref []string8 includes         // the `-I` list, `DADO_CFLAGS` on its tail
    i32 jobs                       // at most this many compiles at once

// The environment variables a C compiler reads headers, dates or a target
// by, each part of every unit's key: where the `-MD` file can name only what
// was found, these say where else it could have been.
const string8 HEADER_ENV = "CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH GCC_EXEC_PREFIX COMPILER_PATH SDKROOT MACOSX_DEPLOYMENT_TARGET SOURCE_DATE_EPOCH ZIG_LIB_DIR"

// The part of every unit's key that is the same for the whole build.
string8 units_key(^UnitsJob j):
    return unit_base(j.cc_id, j.flags.words[:], j.includes[:])

// What a unit's key holds besides the unit: see `UnitsJob`. The working
// directory too when a relative `-I` or any `DADO_CFLAGS` could be read
// against it.
string8 unit_base(string8 cc_id, []string8 flags, []string8 includes):
    Digest d = digest()
    put_text(&d, "dado unit key 2")
    put_text(&d, cc_id)
    for w in flags:
        put_text(&d, w)
    for w in includes:
        put_text(&d, w)
    (string8 user_cflags, bool _) = env("DADO_CFLAGS")
    put_text(&d, user_cflags)
    for name in words_of(HEADER_ENV):
        (string8 v, bool set) = env(name)
        if set: put_text(&d, txt(#format(name, "=", v)))
        else: put_text(&d, txt(#format(name, " unset")))
    bool relative = #len(user_cflags) > 0
    for w in includes:
        if strings.starts_with(w, "-I") && !path.is_abs(w[2..<#len(w)]): relative = true
    if relative: put_text(&d, txt(#format("in ", here())))
    return finish_digest(&d)

// The working directory, or "" when it cannot be read.
private string8 here():
    try ref []char8 own = fs.current_dir() else:
        return ""
    return txt(own)

// `p` as an absolute path, read against the working directory.
private string8 abs_path(string8 p):
    if path.is_abs(p): return p
    return join2(here(), p)

// `content_digest` of a header, once a run for its path and stat: the units
// of one build read the same few dozen. Kept on the C heap, past any scratch
// arena a caller resets.
private {string8: string8} g_heads
private bool g_heads_made

string8 header_digest(string8 p):
    string8 now = stat_of(p)
    if #len(now) == 0: return ""
    using libc.allocator():
        if !g_heads_made:
            g_heads = {}
            g_heads_made = true
        string8 key = txt(#format(p, " ", now))
        if key in g_heads:
            (string8 kept, bool _) = g_heads[key]
            return kept
        string8 h = content_digest(p)
        if #len(h) > 0: g_heads[key] = h
        return h
    return ""

// A file's length and xxHash64, as `put_large` frames them; "" when it
// cannot be read.
string8 content_digest(string8 p):
    try ref []char8 bytes = fs.read_file(p) else:
        return ""
    return txt(#format(#len(bytes), " ", hash.xxh64_text(0, txt(bytes))))

// A file's length and last write, the two things a change of its bytes
// moves; "" when it cannot be asked.
string8 stat_of(string8 p):
    try fs.FileInfo i = fs.info(p) else:
        return ""
    return txt(#format(i.size, ":", i.mtime))

// The mark `stat_of` is trusted against: a file whose last write is two
// seconds or more before `mark` (this build's own start, by the file
// system's clock) is one whose length and time are taken for its bytes. A
// newer one is hashed: a file system that keeps whole seconds, or a write in
// the same tick, could change it again with the same length and time. `-`
// when it is not trusted.
string8 trusted_stat(string8 p, i64 mark):
    try fs.FileInfo i = fs.info(p) else:
        return "-"
    i64 settled = i64(2) * 1000000000
    if i.mtime + settled > mark: return "-"
    return txt(#format(i.size, ":", i.mtime))

// The time by the file system's own clock, which file times are written
// by: the last write of a file written now. `0 - 1` when it cannot be read.
i64 fs_now(string8 dir):
    string8 p = join2(dir, txt(#format("now.", os.pid())))
    try fs.write_file(p, "") else:
        return 0 - 1
    try i64 t = fs.mtime(p) else:
        remove_quietly(p)
        return 0 - 1
    remove_quietly(p)
    return t

// What `unit`'s own bytes are, by `content_digest`, through
// `units/<digest of its path>.own` (`<stat> <length> <xxhash>`): read again
// only when its length or time moved. "" when it cannot be read.
string8 own_digest(string8 dir, string8 unit, i64 mark):
    string8 now = stat_of(unit)
    if #len(now) == 0: return ""
    Digest d = digest()
    put_text(&d, "dado unit own 1")
    put_text(&d, abs_path(unit))
    string8 name = finish_digest(&d)
    if #len(name) == 0: return content_digest(unit)
    string8 stamp = join2(dir, txt(#format(name, ".own")))
    string8 kept = strings.trim(read_or_empty(stamp))
    (string8 sig, string8 held, bool found) = strings.split_first(kept, " ")
    if found && sig != "-" && sig == now: return held
    string8 h = content_digest(unit)
    if #len(h) == 0: return ""
    string8 again = txt(#format(trusted_stat(unit, mark), " ", h))
    if again != kept: replace_quietly(stamp, again)
    return h

// One unit's place in the cache, found before anything compiles: its book,
// "" when no key could be taken, and its object when the book still holds
// and the object is there, else "".
type UnitFound:
    string8 book
    string8 object

// Where `unit` stands in `dir`, for the build-wide `base` (`unit_base`).
// `own` is its bytes' `content_digest` when the caller already has it, else
// "" and it is taken (`own_digest`).
UnitFound find_unit(string8 dir, string8 base, string8 unit, string8 own, i64 mark):
    UnitFound f
    f.book = ""
    f.object = ""
    if #len(base) == 0 || mark < 0: return f
    string8 mine = own
    if #len(mine) == 0: mine = own_digest(dir, unit, mark)
    if #len(mine) == 0: return f
    Digest d = digest()
    put_text(&d, "dado unit book 1")
    put_text(&d, base)
    put_text(&d, abs_path(unit))
    put_text(&d, mine)
    string8 name = finish_digest(&d)
    if #len(name) == 0: return f
    f.book = join2(dir, txt(#format(name, ".dep")))
    f.object = booked_object(f.book, mark)
    return f

// The first line of every book.
private const string8 BOOK_HEAD = "dado unit book 1"

// The object `book` names for the files it lists as they are now, when it is
// there; "" when the book is missing, a file it lists changed or is gone, or
// the object is not there. A file whose time moved and bytes did not is
// written back with its new time, so the next build need not read it.
string8 booked_object(string8 book, i64 mark):
    try ref []char8 text = fs.read_file(book) else:
        return ""
    (string8 head, string8 rest, bool _) = strings.line(txt(text))
    if head != BOOK_HEAD: return ""
    Digest k = digest()
    put_text(&k, path.base(book))
    strings.Builder again = strings.builder(#len(text))
    strings.append(&again, BOOK_HEAD)
    strings.append(&again, "\n")
    bool moved = false
    string8 left = rest
    for #len(left) > 0:
        (string8 l, string8 tail, bool more) = strings.line(left)
        left = tail if more else ""
        if #len(l) == 0: continue
        // `<stat> <length> <xxhash> <path>`
        (string8 sig, string8 r1, bool f1) = strings.split_first(l, " ")
        (string8 size, string8 r2, bool f2) = strings.split_first(r1, " ")
        (string8 xxh, string8 p, bool f3) = strings.split_first(r2, " ")
        if !f1 || !f2 || !f3: return ""
        string8 was = txt(#format(size, " ", xxh))
        string8 now = stat_of(p)
        if #len(now) == 0: return ""
        string8 sig_now = sig
        if sig == "-" || sig != now:
            if header_digest(p) != was: return ""
            sig_now = trusted_stat(p, mark)
            if sig_now != sig: moved = true
        put_text(&k, p)
        put_text(&k, was)
        strings.append(&again, txt(#format(sig_now, " ", was, " ", p, "\n")))
    string8 key = finish_digest(&k)
    if #len(key) == 0: return ""
    if moved: replace_quietly(book, strings.text(again))
    string8 obj = join2(dir_of(book), txt(#format(key, ".o")))
    if !is_file(obj): return ""
    return obj

// After `unit` compiled with `-MD -MF depfile`: its book written, naming each
// file the compiler read besides the unit; the object's place for the files
// as they were. "" when a file the compiler read changed while it ran (its
// time is `mark` or later), or cannot be read: then nothing is written, and
// the object is this build's alone. The unit itself is asked too unless it
// is `named` by what it holds (`dado test`'s), so written once and never
// changed, however recently.
string8 book_unit(string8 book, string8 depfile, string8 unit, bool named, i64 mark):
    if #len(book) == 0: return ""
    string8 unit_abs = abs_path(unit)
    if !named:
        try fs.FileInfo ui = fs.info(unit_abs) else:
            return ""
        if ui.mtime >= mark: return ""
    try ref []char8 deps = fs.read_file(depfile) else:
        return ""
    Digest k = digest()
    put_text(&k, path.base(book))
    strings.Builder out = strings.builder(4096)
    strings.append(&out, BOOK_HEAD)
    strings.append(&out, "\n")
    {string8: bool} seen = {}
    for p0 in depfile_paths(txt(deps)):
        string8 p = abs_path(p0)
        if p == unit_abs || p in seen: continue
        seen[p] = true
        try fs.FileInfo i = fs.info(p) else:
            return ""
        if i.mtime >= mark: return ""
        string8 h = header_digest(p)
        if #len(h) == 0: return ""
        put_text(&k, p)
        put_text(&k, h)
        strings.append(&out, txt(#format(trusted_stat(p, mark), " ", h, " ", p, "\n")))
    string8 key = finish_digest(&k)
    if #len(key) == 0: return ""
    replace_quietly(book, strings.text(out))
    return join2(dir_of(book), txt(#format(key, ".o")))

// The files a compiler's `-MD` output names as the object's prerequisites,
// in order: every word after the first that ends in `:` (the object), where
// a backslash before a newline makes a space, `\ ` and `\#` are the
// character, and `$$` is `$`. A backslash before anything else is itself,
// as in a Windows path.
ref []string8 depfile_paths(string8 text):
    ref []string8 out = #make([]string8, 0)
    strings.Builder word = strings.builder(256)
    bool target_done = false
    i64 n = #len(text)
    i64 i = 0
    for i <= n:
        bool cut = i == n
        if !cut:
            char8 c = text[i]
            if c == '\\' && i + 1 < n && (text[i + 1] == '\n' || text[i + 1] == '\r'):
                cut = true
                i += 1
                if text[i] == '\r' && i + 1 < n && text[i + 1] == '\n': i += 1
            else if c == '\\' && i + 1 < n && (text[i + 1] == ' ' || text[i + 1] == '#'):
                strings.append_char(&word, text[i + 1])
                i += 1
            else if c == '$' && i + 1 < n && text[i + 1] == '$':
                strings.append_char(&word, '$')
                i += 1
            else if c == ' ' || c == '\t' || c == '\n' || c == '\r':
                cut = true
            else:
                strings.append_char(&word, c)
        i += 1
        if !cut: continue
        string8 w = strings.text(word)
        if #len(w) == 0: continue
        bool is_target = !target_done
        if is_target && strings.ends_with(w, ":"): target_done = true
        ref []char8 own = #format(w)
        word = strings.builder(256)
        if is_target: continue
        out = #append(out, txt(own))
    return out

// `commands`, at most `jobs` at a time; each one's status, in order (127
// for one that did not start).
ref []i32 run_all([]Command commands, i32 jobs):
    ref []i32 status = #make([]i32, 0)
    ref []proc.Child running = #make([]proc.Child, 0)
    ref []i64 slot = #make([]i64, 0)
    i64 waited = 0
    ref []string8 written = #make([]string8, 0)
    for i in 0..<#len(commands):
        status = #append(status, 127)
        if i64(#len(running)) - waited >= i64(jobs):
            status[slot[waited]] = wait_status(running[waited])
            waited += 1
        Command c = commands[i]
        if verbose(): note(txt(#format("  $ ", shown(c))))
        _ = io.flush(io.stdout())
        _ = io.flush(io.stderr())
        (Command f, string8 why) = fitted(c)
        if #len(why) == 0 && #len(f.words) > proc.ARG_CAP: why = too_long(f)
        if #len(why) > 0:
            warn(why)
            continue
        if long_command(c): written = #append(written, c.args_file)
        try proc.Child child = proc.spawn(f.words[:]) else:
            continue
        running = #append(running, child)
        slot = #append(slot, i64(i))
    for k in waited..<i64(#len(running)):
        status[slot[k]] = wait_status(running[k])
    for w in written:
        remove_quietly(w)
    return status

private i32 wait_status(proc.Child c):
    try proc.Ended e = proc.wait(c) else:
        return 127
    if proc.ok(e): return 0
    return 1

// Mark `object` and its `book` used now, which the sweep reads.
void mark_used(string8 object, string8 book):
    write_quietly(txt(#format(object, ".used")), "")
    if #len(book) > 0: write_quietly(txt(#format(book, ".used")), "")

// The object of each of `units`, in order; `ok` false when one did not
// compile (its compiler has said why on standard error). A unit whose
// object is already in the cache compiles nothing.
(ref []string8 objects, bool ok) unit_objects(^UnitsJob j, []string8 units):
    ref []string8 objects = #make([]string8, 0)
    string8 dir = join2(j.cache, "units")
    try fs.make_dirs(dir) else: pass
    string8 base = units_key(j)
    i64 mark = fs_now(dir)

    ref []Command compiles = #make([]Command, 0)
    ref []i64 compiled = #make([]i64, 0)
    ref []string8 tmps = #make([]string8, 0)
    ref []string8 books = #make([]string8, 0)
    for i in 0..<#len(units):
        string8 u = units[i]
        UnitFound f = find_unit(dir, base, u, "", mark)
        if #len(f.object) > 0:
            mark_used(f.object, f.book)
            objects = #append(objects, f.object)
            continue
        objects = #append(objects, "")
        string8 tmp = join2(dir, txt(#format("unit.", os.pid(), ".", i, ".o.tmp")))
        Command c = command_of(j.flags.words[:])
        add_all(&c, j.includes[:])
        add(&c, "-c")
        add(&c, u)
        add(&c, "-o")
        add(&c, tmp)
        add_all(&c, depfile_words(tmp))
        respond(&c, j.flags.args_from, txt(#format(tmp, ".args")))
        compiles = #append(compiles, c)
        compiled = #append(compiled, i64(i))
        tmps = #append(tmps, tmp)
        books = #append(books, f.book)
    ref []i32 status = run_all(compiles[:], j.jobs)
    bool ok = true
    for k in 0..<#len(compiles):
        i64 i = compiled[k]
        string8 tmp = tmps[k]
        string8 depfile = txt(#format(tmp, ".d"))
        // No key: compiled for this build alone, under its place in the list.
        string8 obj = join2(dir, txt(#format("unkeyed.", os.pid(), ".", i, ".o")))
        objects[i] = obj
        if status[k] != 0:
            remove_quietly(tmp)
            remove_quietly(depfile)
            ok = false
            continue
        string8 keyed = book_unit(books[k], depfile, units[i], false, mark)
        remove_quietly(depfile)
        if #len(keyed) > 0: obj = keyed
        try fs.rename(tmp, obj) else:
            remove_quietly(tmp)
            ok = false
            continue
        objects[i] = obj
        if #len(keyed) > 0: mark_used(obj, books[k])
    return (objects, ok)

// The words that have a compile of `tmp` write its `-MD` file, `<tmp>.d`:
// every header it read, the system's included, which the unit's book lists.
// gcc, clang and `zig cc` all spell it so.
ref []string8 depfile_words(string8 tmp):
    ref []string8 w = #make([]string8, 0)
    w = #append(w, "-MD")
    w = #append(w, "-MF")
    w = #append(w, txt(#format(tmp, ".d")))
    return w

// ── links/ ──────────────────────────────────────────────────────────────────

// What a link made of: every word of the command `c` (the objects, the
// libraries, `-o` and where), the compiler's identity `cc_id`, and each word
// that names a file it reads (an object, an archive) by its length and time.
// A unit's object is named by what it holds, so a changed object is a
// changed word; an archive rebuilt in place is a changed time.
string8 link_key(Command c, string8 cc_id):
    Digest d = digest()
    put_text(&d, "dado link 1")
    put_text(&d, cc_id)
    bool output = false
    for w in c.words:
        put_text(&d, w)
        if !output && is_file(w): put_text(&d, stat_of(w))
        output = w == "-o"
    return finish_digest(&d)

// Where the record of the last link into `out` is kept:
// `<cache>/links/<digest of out's path>`, holding the link's key and the
// length and time `out` had once it was written.
private string8 link_record(string8 cache, string8 out):
    Digest d = digest()
    put_text(&d, "dado link record 1")
    put_text(&d, abs_path(out))
    return join3(cache, "links", finish_digest(&d))

// Whether `out` is what a link with `key` would write: the last link into it
// had that key, and it has not been written since.
bool link_current(string8 cache, string8 out, string8 key):
    if #len(key) == 0: return false
    string8 now = stat_of(out)
    if #len(now) == 0: return false
    return strings.trim(read_or_empty(link_record(cache, out))) == txt(#format(key, " ", now))

// `out` was just linked with `key`; or, with `key` "", nothing is known of
// what it holds.
void link_done(string8 cache, string8 out, string8 key):
    string8 record = link_record(cache, out)
    string8 now = stat_of(out)
    if #len(key) == 0 || #len(now) == 0:
        remove_quietly(record)
        return
    try fs.make_dirs(join2(cache, "links")) else: pass
    replace_quietly(record, txt(#format(key, " ", now)))

// Whether every one of `objects` is still there: a concurrent build's sweep
// can, in a narrow window, take one this build checked.
bool all_there([]string8 objects):
    for o in objects:
        if !is_file(o): return false
    return true

// Remove what under `<cache>/units` was last used (its `.used`, else the
// file itself) more than a week ago, never one of `used`: objects, their
// books, the `.own` records; and a compile's `.tmp` a crashed build left as
// old. Quiet: a sweep that cannot read or remove something leaves it for the
// next.
void sweep_units(string8 cache, []string8 used):
    string8 dir = join2(cache, "units")
    try fs.Listing l = fs.read_dir(dir) else:
        return
    i64 week = i64(7) * 24 * 3600 * 1000000000
    i64 now = time.unix_nanos()
    for e in l.entries:
        string8 p = join2(dir, e.path)
        if strings.ends_with(p, ".used"): continue
        bool in_use = false
        for u in used:
            if u == p:
                in_use = true
                break
        if in_use: continue
        string8 stamp = txt(#format(p, ".used"))
        string8 aged = p
        if is_file(stamp): aged = stamp
        try i64 t = fs.mtime(aged) else:
            continue
        if now - t > week:
            remove_quietly(p)
            remove_quietly(stamp)
    l.destroy()

// ── a slot's C dropped (P10j) ───────────────────────────────────────────────

// After a slot's units compiled: each unit's digest and the path its object
// is keyed by (`find_unit`), a line `<digest>\t<unit>\t<key path>` per unit
// into `owns`, so the slot's C can go and its objects still be found.
void write_owns(string8 owns, []string8 units, []string8 digests, []string8 keys):
    strings.Builder b = strings.builder(128 * #len(units) + 1)
    for i in 0..<#len(units):
        if #len(digests[i]) == 0 || #len(keys[i]) == 0: return
        strings.append(&b, txt(#format(digests[i], "\t", units[i], "\t", keys[i], "\n")))
    replace_quietly(owns, strings.text(b))

// `dado build`'s: a unit is keyed by its own path and `own_digest`.
void record_owns(string8 cache, []string8 units, string8 owns):
    string8 dir = join2(cache, "units")
    i64 mark = fs_now(dir)
    ref []string8 ds = #make([]string8, 0)
    for u in units:
        ds = #append(ds, own_digest(dir, u, mark))
    write_owns(owns, units, ds[:], units)

// What `owns` says of `unit`: its digest and key path; "" when it is not listed.
(string8 digest, string8 key) owned(string8 owns_text, string8 unit):
    for l in strings.split(owns_text, "\n"):
        (string8 h, string8 rest, bool f1) = strings.split_first(l, "\t")
        (string8 u, string8 k, bool f2) = strings.split_first(rest, "\t")
        if f1 && f2 && u == unit: return (h, k)
    return ("", "")

// A dropped slot's objects for `units`, by `owns`, under build-wide `base`
// (`unit_base`): every one found, or false and the front end runs again.
(ref []string8 objects, bool ok) owned_objects(string8 cache, string8 base, []string8 units, string8 owns):
    ref []string8 objects = #make([]string8, 0)
    string8 dir = join2(cache, "units")
    i64 mark = fs_now(dir)
    string8 text = read_or_empty(owns)
    if #len(text) == 0: return (objects, false)
    for u in units:
        (string8 h, string8 k) = owned(text, u)
        if #len(h) == 0: return (objects, false)
        UnitFound f = find_unit(dir, base, k, h, mark)
        if #len(f.object) == 0: return (objects, false)
        mark_used(f.object, f.book)
        objects = #append(objects, f.object)
    return (objects, true)
