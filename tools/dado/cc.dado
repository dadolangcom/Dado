// The C compiler, and the argument lists handed to it.
//
// **Which compiler.** `--cc <program>` uses that program, as one word, except
// `--cc zig`, which is the pinned zig. Without it, the pinned zig, run as
// `zig cc`: in an install the one under `zig/<version>/`, in a checkout a
// `zig` on `PATH` whose `zig version` is the one `ZIG_PIN` names. `$CC` does
// not choose, but for a sanitized build (below). A `ZIG_TARGET` in the
// environment becomes `-target <it>` on every `zig cc` line; without one, a
// `DADO_TARGET` naming another hosted system or another architecture's
// freestanding target gives zig's own spelling of it (`zig_target_of`), and
// a triple it cannot read needs `ZIG_TARGET` beside it, one for each half of
// the build.
//
// **A build with C's sanitizers and no `--cc`** (`dado test`, `--debug`, and
// `--sanitize` or `--c-sanitize`) on a native target is the exception: the
// pinned zig has no AddressSanitizer, so the driver uses the first compiler
// `c_compilers` finds (`CC` first, when set) that builds and runs an empty
// AddressSanitizer program, and says which, once. None that can: the pinned
// zig, UBSan alone, and a warning saying why. On a Windows host none is
// tried, since MinGW's gcc and clang ASan runtimes are unreliable: the build
// is UBSan alone, with a warning. `--cc zig`, a cross-compile, `--target=web`
// and `--sanitize=thread` (zig has ThreadSanitizer) keep the pinned zig.
//
// **What zig changes.** Two things the pinned zig does differently from
// clang and gcc, each answered here rather than at every caller:
//
// * it has no AddressSanitizer runtime on Linux, and given `address` in a
//   combined `-fsanitize=` list it links the program anyway with no ASan in
//   it. So under zig `address` is taken out of every list, and the build says
//   once that it was;
// * its linker refuses `--export-dynamic-symbol`, so an executable's exports
//   are put in its dynamic table with `-rdynamic` instead, which exports every
//   external symbol rather than only the listed ones;
// * with no `-mcpu` it compiles for the CPU it runs on, so every zig compile
//   here, dev and `--release`, says `-mcpu=baseline` (T36): a program built,
//   or an object cached, on one machine runs on any machine of its
//   architecture. `DADO_CFLAGS=-mcpu=native` comes later on the line and
//   wins, for a build that only ever runs where it was made.
//
// **The order of the compile line is a contract**, weakest first: the
// driver's own flags, the program's `flags` clauses, the sanitizer (so a
// clause cannot turn it off), then the include directories with
// `DADO_CFLAGS` last, so the person at the keyboard has the last word on
// `-O` and `-D`. `-I` is searched first-wins, so a `flags "-I…"` clause is
// searched before the package's own directory. On the link half, Homebrew's
// `-L` comes first, then the command line's `-l`, the `link` clauses and the
// engine, then the exports, the sanitizer and `DADO_LDFLAGS` last.
package driver

import "core:path"
import "core:strings"

// A C compiler: the words that start it, and what a line calls it.
type Compiler:
    ref []string8 words
    string8 name
    bool zig
    bool found
    string8 why       // when not found: what was looked for, and the repair

// The compiler `--cc` names: one program, run as written.
Compiler given_compiler(string8 program):
    Compiler c
    ref []string8 w = #make([]string8, 0)
    _ = #append(w, program)
    c.words = w
    c.name = program
    c.zig = strings.starts_with(path.base(program), "zig")
    c.found = true
    c.why = ""
    return c

// The pinned zig at `zig`, as `zig cc`, with `-target` when `target` is not
// empty, and always `-mcpu=baseline` (T36): with no `-mcpu` zig compiles for
// the CPU it runs on, so a program, a cached object or the driver itself
// built on one machine traps with SIGILL on another of the same
// architecture that lacks an extension the first had (AVX-512 FP16, seen).
// Baseline is the architecture's generic CPU, for native and cross targets
// alike; a gcc or clang named by `--cc` is generic by default and is left so.
Compiler zig_compiler(string8 zig, string8 target):
    Compiler c
    ref []string8 w = #make([]string8, 0)
    _ = #append(w, zig)
    _ = #append(w, "cc")
    if #len(target) > 0:
        _ = #append(w, "-target")
        _ = #append(w, target)
    _ = #append(w, "-mcpu=baseline")
    c.words = w
    c.name = "zig cc"
    c.zig = true
    c.found = true
    c.why = ""
    return c

Compiler no_compiler(string8 why):
    Compiler c
    c.words = #make([]string8, 0)
    c.name = ""
    c.zig = false
    c.found = false
    c.why = why
    return c

// ── sanitizers ──────────────────────────────────────────────────────────────

// `words` with `address` taken out of every `-fsanitize=` list, and a list
// left empty dropped; every other word as it was.
ref []string8 without_address([]string8 words):
    ref []string8 out = #make([]string8, 0)
    for w in words:
        if !strings.starts_with(w, "-fsanitize="):
            _ = #append(out, w)
            continue
        string8 list = w[11..<#len(w)]     // after `-fsanitize=`
        strings.Builder b = strings.builder(#len(w))
        _ = strings.append(&b, "-fsanitize=")
        bool any = false
        string8 rest = list
        for:
            (string8 item, string8 tail, bool more) = split_byte(rest, ',')
            if #len(item) > 0 && item != "address":
                if any:
                    _ = strings.append_char(&b, ',')
                _ = strings.append(&b, item)
                any = true
            if !more: break
            rest = tail
        ref []char8 made = strings.finish(&b)
        if any:
            _ = #append(out, txt(made))
    return out

// The compile and link flags a sanitized build takes: `cflags` and `ldflags`
// as `defaults` writes them for the kind asked, split into words, and under
// zig with `address` taken out (see the head of this file).
(ref []string8 cflags, ref []string8 ldflags) sanitizer_words(string8 cflags, string8 ldflags, bool zig):
    ref []string8 c = words_of(cflags)
    ref []string8 l = words_of(ldflags)
    if zig:
        return (without_address(c[:]), without_address(l[:]))
    return (c, l)

// Whether a build looks for a compiler with AddressSanitizer instead of the
// pinned zig: it is sanitized (`Options.sanitize`, the one predicate for
// that, set in `options`) for `address`, with no `--cc` (`given`), and not
// `cross`-compiled (`DADO_TARGET` or `ZIG_TARGET` set, or the web). `thread`
// is not: the pinned zig has ThreadSanitizer.
bool wants_sanitizing_cc(bool sanitized, string8 kind, string8 given, bool cross):
    return sanitized && kind == "address" && #len(given) == 0 && !cross

// zig's `-target` for `DADO_TARGET`'s `triple`, when it names a
// hosted system other than `host` (this one's `#OS`): the vendor dropped
// (`x86_64-pc-windows-gnu` is `x86_64-windows-gnu`, `aarch64-apple-darwin`
// is `aarch64-macos`, MinGW's `x86_64-w64-mingw32` is `x86_64-windows-gnu`).
// A freestanding (`#NONE`) triple for an architecture other than
// `host_arch` (zig's name for this machine's, `this_arch()` when empty) is
// zig's freestanding target for it: `i386-unknown-none` is
// `x86-freestanding`, `arm-none-eabi` is `arm-freestanding-eabi`,
// `riscv64-unknown-elf` is `riscv64-freestanding`, `wasm32-unknown-unknown`
// is `wasm32-freestanding` (`zig_arch_of` names the architectures).
// "" otherwise: this system's own (zig's default is right), a freestanding
// target for this machine's architecture (compiled for its ABI, as before),
// the web (compiled by `web.dado`), or one it cannot read, for which
// `ZIG_TARGET` names zig's.
string8 zig_target_of(string8 triple, string8 host, string8 host_arch = ""):
    ref []string8 f = #make([]string8, 0)
    string8 rest = triple
    for:
        (string8 part, string8 tail, bool more) = split_byte(rest, '-')
        _ = #append(f, part)
        if !more: break
        rest = tail
    if #len(f) < 2 || #len(f) > 4: return ""
    string8 arch = f[0]
    i64 at = 1
    if #len(f) == 4 || (#len(f) == 3 && (f[1] == "pc" || f[1] == "unknown" || f[1] == "apple" || f[1] == "w64")):
        at = 2
    string8 sys = f[at]
    string8 abi = f[at + 1] if at + 1 < #len(f) else ""
    if freestanding_sys(sys) || (strings.starts_with(arch, "wasm") && sys == "unknown"):
        string8 zarch = zig_arch_of(arch)
        string8 mine = host_arch if #len(host_arch) > 0 else this_arch()
        if #len(zarch) == 0 || zarch == mine: return ""
        if sys == "eabi" || sys == "eabihf": return txt(#format(zarch, "-freestanding-", sys))
        if abi == "eabi" || abi == "eabihf": return txt(#format(zarch, "-freestanding-", abi))
        return txt(#format(zarch, "-freestanding"))
    string8 os = ""
    if sys == "windows" || sys == "mingw32":
        os = "#WINDOWS"
        sys = "windows"
        if abi == "" && f[at] == "mingw32": abi = "gnu"
    else if sys == "linux":
        os = "#LINUX"
    else if sys == "darwin" || sys == "macos" || sys == "macosx":
        os = "#DARWIN"
        sys = "macos"
    if #len(os) == 0 || os == host: return ""
    if #len(abi) > 0: return txt(#format(arch, "-", sys, "-", abi))
    return txt(#format(arch, "-", sys))

// Whether a triple's OS field `sys` is one a freestanding triple uses, as
// the compiler reads `#NONE` from it: `none`, or the `elf`, `eabi` and
// `eabihf` that stand there when the OS is left out (`riscv64-unknown-elf`,
// `arm-none-eabi`).
bool freestanding_sys(string8 sys):
    return sys == "none" || sys == "elf" || sys == "eabi" || sys == "eabihf"

// zig's name for a triple's architecture `arch`, by family, as the
// compiler's `#ARCH` reads them: `i386` to `i686` are `x86`, `arm64` is
// `aarch64`, every `armv…` revision `arm` and every `thumbv…` one `thumb`
// (the revision is `-mcpu`'s, and `DADO_CFLAGS=-mcpu=<cpu>` after the
// driver's `-mcpu=baseline` names it). "" for one it does not know.
string8 zig_arch_of(string8 arch):
    if arch == "x86_64" || arch == "amd64" || arch == "x86_64h": return "x86_64"
    if arch == "i386" || arch == "i486" || arch == "i586" || arch == "i686" || arch == "x86": return "x86"
    if arch == "aarch64" || arch == "arm64" || arch == "arm64e": return "aarch64"
    if arch == "aarch64_be": return "aarch64_be"
    if arch == "riscv64" || arch == "riscv32" || arch == "wasm32" || arch == "wasm64": return arch
    if strings.starts_with(arch, "armeb"): return "armeb"
    if strings.starts_with(arch, "thumbeb"): return "thumbeb"
    if strings.starts_with(arch, "arm"): return "arm"
    if strings.starts_with(arch, "thumb"): return "thumb"
    return ""

// A triple's architecture family, for telling whether two triples build for
// one machine: `zig_arch_of` its first field, or the field as written.
string8 arch_family(string8 triple):
    (string8 arch, string8 _, bool _) = split_byte(triple, '-')
    string8 z = zig_arch_of(arch)
    if #len(z) > 0: return z
    return arch

// This host's architecture, as `zig_arch_of` names it.
string8 this_arch():
    when #ARCH == #X86_64:
        return "x86_64"
    else when #ARCH == #X86:
        return "x86"
    else when #ARCH == #AARCH64:
        return "aarch64"
    else when #ARCH == #RISCV64:
        return "riscv64"
    else when #ARCH == #ARM:
        return "arm"
    else:
        return ""

// This host's `#OS`, as `zig_target_of` takes it.
string8 this_os():
    when #OS == #WINDOWS:
        return "#WINDOWS"
    else when #OS == #DARWIN:
        return "#DARWIN"
    else when #OS == #LINUX:
        return "#LINUX"
    else:
        return "#OTHER"

// ── the link line ───────────────────────────────────────────────────────────

// The flags that put each `export`'s C symbol in a native executable's
// dynamic symbol table, for target `os`. Nothing when there are none, and
// nothing on Windows or a freestanding target; `-export_dynamic` on Darwin;
// elsewhere one `--export-dynamic-symbol` per symbol, or `-rdynamic` under
// zig, whose linker refuses that flag.
ref []string8 export_flags(string8 os, []string8 symbols, bool zig):
    ref []string8 out = #make([]string8, 0)
    if #len(symbols) == 0: return out
    if os == "#DARWIN":
        _ = #append(out, "-Wl,-export_dynamic")
        return out
    if os == "#WINDOWS" || os == "#NONE":
        return out
    if zig:
        _ = #append(out, "-rdynamic")
        return out
    for s in symbols:
        _ = #append(out, txt(#format("-Wl,--export-dynamic-symbol=", s)))
    return out

// **The optimisation level, chosen here and nowhere else** (CP-13 step 1,
// Q12): `-O0` for a dev `build`, `run` and `test`, which compiles about twice
// as fast; `--release` for `-O2`, the shipped program; `--debug` for
// `-g -O0`, over `--release` when both are given. Native and web alike.
ref []string8 opt_words(^Options o):
    if o.debug: return words_of("-g -O0")
    if o.release: return words_of("-O2")
    return words_of("-O0")

// Everything a native compile and link is made of, in the order it goes on
// the line.
type Link:
    ref []string8 cc
    ref []string8 base          // `CFLAGS_BASE`
    ref []string8 interop       // `CFLAGS_INTEROP`
    ref []string8 werror        // `CFLAGS_WERROR`, or nothing under --no-werror
    ref []string8 opt           // `opt_words`: `-O0`, `-O2` under --release, `-g -O0` under --debug
    ref []string8 freestanding  // `CFLAGS_NONE` for a `#NONE` build: `-ffreestanding`, no UBSan, no stack protector
    ref []string8 extra         // the program's `flags` clauses
    ref []string8 san_c
    ref []string8 includes      // `-I` per package, the engine's, Homebrew's, then DADO_CFLAGS
    string8 c_file
    ref []string8 sources
    string8 out
    ref []string8 libs          // Homebrew's `-L`, the command line's `-l`, `link` clauses, the engine
    ref []string8 exports       // `export_flags`' answer
    ref []string8 san_l
    ref []string8 ldflags       // DADO_LDFLAGS

// An empty `Link`, every list made.
Link new_link():
    Link k
    k.cc = #make([]string8, 0)
    k.base = #make([]string8, 0)
    k.interop = #make([]string8, 0)
    k.werror = #make([]string8, 0)
    k.opt = #make([]string8, 0)
    k.freestanding = #make([]string8, 0)
    k.extra = #make([]string8, 0)
    k.san_c = #make([]string8, 0)
    k.includes = #make([]string8, 0)
    k.c_file = ""
    k.sources = #make([]string8, 0)
    k.out = ""
    k.libs = #make([]string8, 0)
    k.exports = #make([]string8, 0)
    k.san_l = #make([]string8, 0)
    k.ldflags = #make([]string8, 0)
    return k

// The one command that compiles and links a hosted program.
Command link_command(^Link k):
    Command c = command_of(k.cc[:])
    add_all(&c, k.base[:])
    add_all(&c, k.interop[:])
    add_all(&c, k.werror[:])
    add_all(&c, k.opt[:])
    add_all(&c, k.freestanding[:])
    add_all(&c, k.extra[:])
    add_all(&c, k.san_c[:])
    add_all(&c, k.includes[:])
    add(&c, k.c_file)
    add_all(&c, k.sources[:])
    add(&c, "-o")
    add(&c, k.out)
    add_all(&c, k.libs[:])
    add_all(&c, k.exports[:])
    add_all(&c, k.san_l[:])
    add_all(&c, k.ldflags[:])
    return c

// The command that compiles one translation unit `unit` of a freestanding
// build to the object `object`, linking nothing: the link line's compile half
// with `k.freestanding` (`-ffreestanding` when it is empty) and `-c` after
// the optimisation flags.
Command object_command(^Link k, string8 unit, string8 object):
    Command c = command_of(k.cc[:])
    add_all(&c, k.base[:])
    add_all(&c, k.interop[:])
    add_all(&c, k.werror[:])
    add_all(&c, k.opt[:])
    if #len(k.freestanding) == 0:
        add(&c, "-ffreestanding")
    else:
        add_all(&c, k.freestanding[:])
    add(&c, "-c")
    add_all(&c, k.extra[:])
    add_all(&c, k.san_c[:])
    add_all(&c, k.includes[:])
    add(&c, unit)
    add(&c, "-o")
    add(&c, object)
    return c
