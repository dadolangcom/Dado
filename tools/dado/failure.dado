// Why the C compiler rejected a build, said so the reader knows whose
// mistake it is.
//
// The compiler guarantees warning-clean C11, so C it wrote alone that does
// not compile is a compiler bug. But a build is not always that alone, and
// blaming the compiler for somebody's own typo sends them to file an issue
// about it. So, in order:
//
// 1. **The arguments.** If the C compiler refuses a translation unit that
//    includes nothing, with the build's own compile arguments, it refused an
//    argument — usually a `flags` clause, which is split on whitespace and
//    has no spelling for one argument holding a space.
// 2. **A `.c` file beside the sources**, found by directory and compiled
//    whatever the program declares, in a program with no `foreign` block.
// 3. **No `foreign` block and no `.c`**: every line was the compiler's, and
//    that is a bug to report.
// 4. **A header a `foreign` block names is not on this machine**, asked of
//    the C compiler one header at a time; a header found that includes a
//    missing one is reported as that one, included by it.
// 5. Otherwise the restatement in a `foreign` block is the likeliest culprit,
//    and the message lists what each kind of C error means.
//
// The probes run only on the way out of a failed build, so a build that
// works pays for none of them.
package driver

import "core:os"
import "core:os/fs"
import "core:strings"

// What a failed compile is explained from.
type Failure:
    Compiler cc
    string8 cmd
    string8 pkg
    string8 c_file
    ref []string8 headers
    ref []string8 sources
    ref []string8 extra
    ref []string8 includes

private string8 probe_file(string8 name):
    ref []char8 tmp = os.temp_dir()
    return txt(#format(txt(tmp), "/", name, "-", os.pid(), ".c"))

// `cc -fsyntax-only -std=c11 <extra> <includes> <file>`, and what it said on
// standard error. zig 0.16's `-fsyntax-only` fails on every input
// (`error: FileNotFound`), so under zig the probe is a real compile to an
// object file beside the probe, removed afterwards: the same question asked a
// way that compiler answers.
private (bool ok, string8 said) syntax_only(^Failure f, string8 file):
    Command c = command_of(f.cc.words[:])
    string8 object = txt(#format(file, ".o"))
    if f.cc.zig:
        add(&c, "-c")
    else:
        add(&c, "-fsyntax-only")
    add(&c, "-std=c11")
    add_all(&c, f.extra[:])
    add_all(&c, f.includes[:])
    add(&c, file)
    if f.cc.zig:
        add(&c, "-o")
        add(&c, object)
    // The compiler's diagnostics arrive on its standard error; folded into
    // what is read here by a shell-free `2>&1`.
    Captured r = capture_merged(c)
    if f.cc.zig:
        remove_probe(object)
    return (r.started && r.status == 0, txt(r.out))

private bool rejected_arguments(^Failure f):
    string8 probe = probe_file("dado-argprobe")
    try fs.write_file(probe, "typedef int dado_argument_probe_t;\n") else:
        return false
    (bool ok, string8 _) = syntax_only(f, probe)
    remove_probe(probe)
    return !ok

private void remove_probe(string8 p):
    try fs.remove_file(p) else:
        return

// The header a C compiler's message says it could not find: gcc's
// `fatal error: X: No such file or directory`, clang's
// `fatal error: 'X' file not found`. Empty when it names none.
string8 missing_include(string8 said):
    for l in lines_of(said):
        (string8 _, string8 after, bool found) = strings.split_first(l, "error: '")
        if found:
            (string8 name, string8 tail, bool closed) = strings.split_first(after, "'")
            if closed && strings.contains(tail, "file not found"):
                return name
        (string8 _, string8 after2, bool found2) = strings.split_first(l, "error: ")
        if found2:
            (string8 name2, string8 tail2, bool sep) = strings.split_first(after2, ": No such file or directory")
            if sep && !strings.has_byte(name2, ' '):
                _ = tail2
                return name2
    return ""

// One line per header that is not found: the header named, or the missing
// one and the header that includes it.
private ref []char8 missing_headers(^Failure f):
    strings.Builder b = strings.builder(128)
    string8 probe = probe_file("dado-probe")
    for h in f.headers:
        string8 line = txt(#format("#include <", h, ">\n"))
        if strings.starts_with(h, "./") || strings.starts_with(h, "../"):
            line = txt(#format("#include \"", h, "\"\n"))
        try fs.write_file(probe, line) else:
            continue
        (bool ok, string8 said) = syntax_only(f, probe)
        if ok: continue
        string8 miss = missing_include(said)
        if #len(miss) > 0 && miss != h:
            _ = strings.append(&b, txt(#format("    ", miss, "   (included by ", h, ", which a `foreign` block names)\n")))
        else:
            _ = strings.append(&b, txt(#format("    ", h, "\n")))
    remove_probe(probe)
    return strings.finish(&b)

private string8 listed_lines([]string8 items):
    strings.Builder b = strings.builder(128)
    for s in items:
        _ = strings.append(&b, txt(#format("    ", s, "\n")))
    ref []char8 done = strings.finish(&b)
    return txt(done)

// Say why the C compiler refused the build, and end the process.
void explain_cc_failure(^Failure f):
    if rejected_arguments(f):
        ref []char8 extra = strings.join(f.extra[:], " ")
        string8 e = txt(extra)
        if #len(e) == 0: e = "(none)"
        (string8 user, bool set) = env("DADO_CFLAGS")
        if !set: user = "(none)"
        die(txt(#format("the C compiler rejected an argument this build was given.\n\n  Not the generated C — a translation unit that includes nothing is refused\n  with the same arguments. The build's own compile arguments are:\n\n    flags clauses:  ", e, "\n    DADO_CFLAGS:     ", user, "\n\n  A `flags` clause is a **whitespace-separated list of arguments**, the way\n  a `link` clause is, and the manifest carries no quoting: there is no\n  spelling for one argument containing a space, and a clause that wants one\n  is a clause to move into a header as a `#define`.\n\n  Run again with -v to see the exact command line.")))
    if #len(f.headers) == 0 && #len(f.sources) > 0:
        die(txt(#format("the C compiler rejected this build, and it was not handed only generated C.\n\n  A package directory's `.c` files are compiled and linked with the program.\n  They are found by **directory** and not by a `foreign` block, so a .c file\n  that happens to sit beside the .dado sources is in the build whether or not\n  anything declares it. This build compiled:\n", listed_lines(f.sources[:]), "  Read the message above for the file it names. A sidecar that defines `main`,\n  or any other name the generated program already defines, is a **link** error\n  — 'multiple definition of ...' — and names both files. A .c in that directory\n  that is not meant to be part of the package has to move out of it.\n\n  The generated C is kept at\n    ", f.c_file, "\n  If the message names only that file, it may be a compiler bug: Dado\n  guarantees warning-clean C11. Any line it names is a .dado line, because the\n  generated C carries `#line` directives; pass --no-line-directives to see\n  the C's own numbering.\n\n  To get moving meanwhile: --no-werror")))
    if #len(f.headers) == 0:
        die(txt(#format("the C compiler rejected the generated C.\n\n  That is a compiler bug, not a bug in your program: Dado guarantees warning-\n  clean C11; this program declares no `foreign` block and the build compiled\n  no .c sidecar, so every line of that file was written by the compiler. It is\n  kept at\n    ", f.c_file, "\n  Any line it names is a .dado line, because the generated C carries `#line`\n  directives; pass --no-line-directives to see the C's own numbering.\n\n  Please report it with that file. To get moving meanwhile: --no-werror")))
    ref []char8 absent = missing_headers(f)
    string8 a = txt(absent)
    if #len(a) > 0:
        die(txt(#format("a header this build needs is not on this machine:\n\n", a, "  `foreign` restates what a header contains; it does not ship the header.\n  A system header comes from having the library installed, and\n  a `./` path is relative to the .dado file that wrote it.\n\n  On macOS a library is usually `brew install <name>`; on Debian or Ubuntu,\n  `apt install lib<name>-dev`. Then link it: dado ", f.cmd, " ", f.pkg, " -l <name>\n\n  If it *is* installed, the compiler is looking somewhere else. This driver\n  adds `brew --prefix`'s include and lib directories when `brew` is on the\n  PATH, which is what Apple's clang does not do for itself. Anywhere else:\n    DADO_CFLAGS=-I/path/include DADO_LDFLAGS=-L/path/lib dado ", f.cmd, " ", f.pkg, "\n\n  `corpus/raylib` is the same program against a stand-in that ships with the\n  repository, so it builds and runs with nothing installed at all.")))
    string8 sidecars = ""
    if #len(f.sources) > 0:
        sidecars = txt(#format("\n  This build also compiled .c files found **in the package directories** —\n", listed_lines(f.sources[:]), "  — so a message naming one of those is about that file and not about Dado.\n"))
    die(txt(#format("the C compiler rejected the generated C.\n\n  Look first at what your `foreign` block restates. A wrong declaration is\n  *meant* to be a build error here — a `foreign` declaration is checked\n  against the real header by the C compiler, and that is the whole point of\n  writing one — and the message above names the C function or the type it\n  disagreed about:\n\n    'implicit declaration of ...'    a name no header declares: check spelling\n    'too many/few arguments ...'     the parameter list does not match\n    '... restates `f` as ...'        a parameter, the return or `...` is not\n                                     the header's type\n    'toy_assert__fieldtype__X__m'    member `m` of `type X` is not the header's type\n    'toy_assert__sizeof__X ...'      `type X: (...)` states the wrong layout\n", sidecars, "\n  If none of those fit, it may be a compiler bug after all: Dado guarantees\n  warning-clean C11. The offending file is kept at\n    ", f.c_file, "\n  Any line it names is a .dado line, because the generated C carries `#line`\n  directives; pass --no-line-directives to see the C's own numbering.\n  Please report it with that file. To get moving meanwhile: --no-werror")))
