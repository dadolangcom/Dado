@test
// The pure half of `dado new` and `dado init`: the kinds, the refusals, the
// files each kind starts with, and the README's shape as `dado package`
// reads it (its summary placeholder is no description; its markers are
// found and rewritten).
package driver

import "core:mem/arena"
import "core:mem/libc"
import "core:strings"

private bool same(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is `", got, "`, not `", want, "`")

private bool has(string8 text, string8 part, string8 what):
    return #expect(strings.contains(text, part), what, " lacks `", part, "`: ", text)

private bool kinds():
    bool ok = true
    ok = #expect(is_project_kind("library") && is_project_kind("program"), "a kind was refused") && ok
    ok = #expect(!is_project_kind("cli") && !is_project_kind("Library") && !is_project_kind(""), "a word that is no kind was taken") && ok
    ok = same(kind_refusal("init", "library"), "", "library's refusal") && ok
    ok = has(kind_refusal("init", "module"), "library and program", "a wrong kind's refusal") && ok
    ok = has(kind_refusal("new", "module"), "dado new <library|program> <name>", "new's spelling") && ok
    ok = has(kinds_listing("new"), "dado new library <name>", "new's listing") && ok
    ok = has(kinds_listing("init"), "dado init program)", "init's listing") && ok
    ok = same(library_package("Clipper2"), "clipper2", "Clipper2's package") && ok
    ok = same(library_package("my-geo"), "my_geo", "my-geo's package") && ok
    return ok

private bool refusals():
    bool ok = true
    ok = same(new_refusal("Clipper2", "", 0, "library"), "", "a library's name") && ok
    ok = has(new_refusal("core", "", 0, "library"), "standard collection", "a collection's name") && ok
    ok = has(new_refusal("geo.x", "", 0, "library"), "holds `.`", "a dot in a library's name") && ok
    // A program is held to the library's character rule too.
    ok = has(new_refusal("geo.x", "", 0), "holds `.`", "a program's name with a dot") && ok
    ok = has(new_refusal("hello", "dir", 2, "library"), "dado init library", "a full folder's repair") && ok
    ok = same(init_refusal("geo", "library"), "", "init in geo") && ok
    ok = has(init_refusal("my geo", "library"), "Rename the folder", "init in a folder whose name is no library's") && ok
    ok = has(init_refusal("my geo", "program"), "Rename the folder", "a program in a folder named with a space") && ok
    ok = has(init_refusal("", "program"), "no name", "the root") && ok
    ref []string8 none = #make([]string8, 0)
    ref []string8 some = #make([]string8, 0)
    _ = #append(some, "a.dado")
    ok = same(skip_reason("x.dado", false, false, true, none[:]), "", "a file to write") && ok
    ok = has(skip_reason("x.dado", true, false, true, none[:]), "already there", "a file that is there") && ok
    ok = has(skip_reason("x.dado", true, true, true, none[:]), "a folder named", "a folder in the way") && ok
    ok = has(skip_reason("x.dado", false, false, true, some[:]), "a.dado", "a second package's source") && ok
    ok = same(skip_reason("dado.json", false, false, false, some[:]), "", "a manifest beside sources") && ok
    ok = #expect(ignores_build("x\nbuild/\n") && ignores_build("/build\n") && !ignores_build("builds/\n"), "build/ in .gitignore") && ok
    return ok

private string8 file_of([]Starter files, string8 name):
    for s in files:
        if s.file == name: return s.text
    return ""

private bool files():
    bool ok = true
    ref []Starter p = starter_files("program", "hello")
    ok = #expect(#len(p) == 6, "a program starts with ", #len(p), " files") && ok
    ok = same(p[0].file, "main.dado", "a program's source") && ok
    ok = same(p[1].file, "hello_test.dado", "a program's test") && ok
    ok = has(p[0].text, "package main\n", "main.dado") && ok
    ok = has(p[1].text, "@test\npackage main\n", "the program's test") && ok
    ok = has(p[1].text, "i32 test():", "the program's test") && ok
    ok = same(file_of(p[:], "dado.json"), "{\n  \"name\": \"hello\",\n  \"targets\": [\n    \"native\"\n  ]\n}\n", "a program's dado.json") && ok
    ok = same(file_of(p[:], ".gitignore"), "build/\n", ".gitignore") && ok
    ref []Starter l = starter_files("library", "My-Geo")
    ok = same(l[0].file, "my-geo.dado", "a library's source") && ok
    ok = same(l[1].file, "my-geo_test.dado", "a library's test") && ok
    ok = has(l[0].text, "\npackage my_geo\n", "the library's source") && ok
    ok = has(l[0].text, "// The sum of", "the function's doc comment") && ok
    ok = has(l[1].text, "@test\npackage my_geo\n", "the library's test") && ok
    string8 manifest = file_of(l[:], "dado.json")
    (Library lib, bool good, string8 why) = parse_library(manifest)
    ok = #expect(good, "the library's dado.json does not read: ", why) && ok
    ok = same(lib.name, "My-Geo", "its name") && ok
    ok = #expect(#len(lib.description) == 0 && #len(lib.version) == 0, "a description or version was guessed") && ok
    return ok

private bool readmes():
    bool ok = true
    string8 r = new_readme("library", "Clipper2")
    ok = #expect(strings.starts_with(r, "# Clipper2\n\n<!-- dado:tests -->\n"), "the title and tests marker come first: ", r) && ok
    ok = has(r, "<!-- dado:install -->\n`dado get Clipper2`\n<!-- /dado:install -->\n", "the install marker") && ok
    ok = has(r, "import \"lib:clipper2\"", "the import line") && ok
    ok = #expect(strings.find(r, "<!-- /dado:install -->") < strings.find(r, "## Summary"), "the markers come before the summary") && ok
    // The placeholder is no description: `dado package` asks.
    ok = same(readme_summary(r), "", "the starter's summary") && ok
    // Once written, it is.
    string8 filled = txt(strings.replace(r, "<!-- One sentence on what Clipper2 does, in place of this comment: `dado package` offers it as the library's description in the package index. -->", "Polygon clipping."))
    ok = same(readme_summary(filled), "Polygon clipping.", "the written summary") && ok
    (string8 out, bool found) = rewrite_markers(r, tests_status("linux-x86_64", "1.0.0-rc.7"), install_status("Clipper2"))
    ok = #expect(found, "the starter's markers were not found") && ok
    ok = has(out, "<!-- dado:tests -->\nTests: passing on linux-x86_64 with Dado 1.0.0-rc.7\n<!-- /dado:tests -->", "the rewritten tests marker") && ok
    string8 p = new_readme("program", "hello")
    ok = #expect(!strings.contains(p, "dado:install"), "a program has an install marker") && ok
    ok = has(p, "<!-- dado:tests -->", "a program's tests marker") && ok
    ok = same(readme_summary(p), "", "a program's starter summary") && ok
    return ok

// The reviewer's items: names, the import line, escaping, the README's
// summary and what a release may commit of it.
private bool review():
    bool ok = true
    // Keywords and `main`, by their package form, for libraries and programs.
    for bad in ["Type", "for", "In", "super", "main", "Main"]:
        string8 as_library = library_name_refusal(bad)
        string8 as_program = new_refusal(bad, "", 0)
        ok = #expect(#len(as_library) > 0, "the library name ", bad, " was taken") && ok
        ok = #expect(#len(as_program) > 0, "the program name ", bad, " was taken") && ok
    ok = has(library_name_refusal("Type"), "keyword", "Type's refusal") && ok
    ok = has(library_name_refusal("main"), "program's package", "main's refusal") && ok
    ok = same(library_name_refusal("types"), "", "types") && ok
    ok = same(library_name_refusal("try"), "", "a contextual word") && ok
    // Programs: the library's character rule, but a collection's name is fine.
    for bad in ["my app", "a\"b", "x\ty", "q'"]:
        string8 by_new = new_refusal(bad, "", 0)
        string8 by_init = init_refusal(bad, "program")
        ok = #expect(#len(by_new) > 0, "the program name ", bad, " was taken") && ok
        ok = #expect(#len(by_init) > 0, "init took the folder ", bad) && ok
    ok = same(new_refusal("app", "", 0), "", "a program named app") && ok
    ok = same(new_refusal("hello", "", 0), "", "hello") && ok
    ok = same(string_literal_body("a\"b\\c\n"), "a\\\"b\\\\c\\x0a", "an escaped literal") && ok
    // The import line: the alias form when the folder and package differ.
    ok = same(library_import("Geo"), "import \"lib:geo\"", "Geo's import") && ok
    ok = same(library_import("My-Geo"), "import my_geo \"lib:my-geo\"", "My-Geo's import") && ok
    ok = has(new_readme("library", "My-Geo"), "import my_geo \"lib:my-geo\"\n\ni32 five = my_geo.add(2, 3)", "My-Geo's README") && ok
    // The summary: fences, and text beside comments.
    ok = same(readme_summary("## Summary\n\n```\ncode\n```\n\nReal.\n"), "Real.", "a summary after a fence") && ok
    ok = same(readme_summary("## Summary\n\nOne\n```\ncode\n```\n"), "One", "a fence ends the paragraph") && ok
    ok = same(readme_summary("## Summary\n\n<!-- x --> Kept.\n"), "Kept.", "text after a one-line comment") && ok
    ok = same(readme_summary("## Summary\n<!-- a\nb --> After.\n"), "After.", "text after a long comment's end") && ok
    ok = same(readme_summary("```\n## Summary\nNo.\n```\n"), "", "a fenced heading") && ok
    // A release commits the README only when it changed inside the markers.
    string8 head = new_readme("library", "Geo")
    (string8 released, bool _) = rewrite_markers(head, tests_status("linux-x86_64", "1"), "")
    ok = #expect(readme_only_markers_changed(head, head), "an unchanged README") && ok
    ok = #expect(readme_only_markers_changed(head, released), "a README changed in its markers") && ok
    ok = #expect(!readme_only_markers_changed(head, txt(#format(released, "more\n"))), "a README changed outside them") && ok
    ok = #expect(!readme_only_markers_changed("# X\n", "# X\n"), "a README without markers") && ok
    ok = same(tests_not_run("0.1.2"), "Tests: not run for v0.1.2", "--no-test's line") && ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = kinds()
        ok = refusals() && ok
        ok = files() && ok
        ok = readmes() && ok
        ok = review() && ok
        if ok: return 0
        return 1
