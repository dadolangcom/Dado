// `dado doc`: a page for a package, a diagnostic code or a topic; and the
// generated documentation under `docs/`, regenerated and compared.
//
//     dado doc core:strings              a collection package's page
//     dado doc ./mypkg                   any package's page
//     dado doc ERR0301                   a diagnostic code's page
//     dado doc reference                 every roster the compiler prints
//     dado doc language                  a page under docs/ by name (also channels,
//                                        codes, packages)
//     dado doc --check                   regenerate docs/ elsewhere and compare
//     dado doc --write                   regenerate docs/ in place
//
// A page goes to standard output (or, with `-o`, to a file), as markdown, or
// with `--format=json` as {"query": "doc", "topic": <as given>, "kind":
// "package"|"code"|"reference"|"page", "source": <the package's address or
// the page's path>, "text": <the markdown>}.
//
// **What is generated** (paths from the root):
//
//     docs/codes/           a page per diagnostic code, from `dadoc --explain`,
//                           and an index page
//     docs/packages/        a page per collection package, as `dado doc
//                           <package>` prints it, and an index page
//     the reference         `dado doc reference`, under docs/
//     the language guide    woven from the compiler's source and the spine
//                           under docs/, where that source is (a checkout of
//                           the repository)
//     the channels guide     woven from core:threads and its spine under docs/,
//                           at the root
//
// The last three are made by exactly the commands that have always made
// them, so their bytes do not change; the code and package pages, and their
// indexes, start with two comment lines naming the `dadoc` that made them
// (`dadoc --version`'s first two lines).
//
// **The comparison ignores those two lines**, because the version names the
// compiler's commit: every commit changes it, so a stamped page compared
// whole would differ after every commit whether or not anything it documents
// changed, and a check that is always red says nothing. For the same reason
// `--write` leaves a page alone when only its stamp would change: a page's
// stamp names the `dadoc` that last changed what it says.
//
// `--check` lists every file that differs, is missing, or is under
// docs/codes/ or docs/packages/ and no longer generated, and exits 1 when
// there is any; `--write` makes `docs/` what `--check` would accept. JSON:
// {"query": "doc", "mode": "check"|"write", "files": <generated>, "changes":
// [{"path": ..., "status": "differs"|"missing"|"stale"}], "skipped": [{"path":
// ..., "reason": ...}]}.
package driver

import "core:flags"
import "core:fmt"
import "core:os"
import "core:os/fs"
import "core:strings"

// ── stamps, and the pure pieces of a page ──────────────────────────────────

// The stamp for pages made by the `dadoc` whose `--version` printed
// `version`: its first two lines, each as a comment line.
string8 stamp_of(string8 version):
    ref []string8 ls = raw_lines(version)
    strings.Builder b = strings.builder(128)
    i64 n = 0
    for l in ls:
        if n == 2: break
        _ = strings.append(&b, txt(#format("<!-- ", strings.trim(l), " -->\n")))
        n += 1
    ref []char8 done = strings.finish(&b)
    return txt(done)

// `text` without the stamp at its top, when it has one.
string8 unstamped(string8 text):
    if !strings.starts_with(text, "<!-- dadoc "): return text
    (string8 _, string8 rest, bool more) = strings.line(text)
    if !more: return ""
    if strings.starts_with(rest, "<!-- ") :
        (string8 second, string8 after, bool more2) = strings.line(rest)
        if strings.ends_with(second, " -->"):
            if !more2: return ""
            return after
    return rest

// A line of `--explain`'s page that is a `name: value` property, such as
// `  class: error — an error, always`.
private bool is_property(string8 line):
    string8 t = strings.trim(line)
    i64 colon = strings.index_of(t, ':')
    if colon < 1 || colon + 1 >= #len(t) || t[colon + 1] != ' ': return false
    for i in 0..<colon:
        if t[i] < 'a' || t[i] > 'z': return false
    return true

// `dadoc --explain`'s page as markdown: its first line the heading, each
// `name: value` line a bullet, the rest paragraphs.
string8 code_markdown(string8 explain):
    ref []string8 ls = raw_lines(explain)
    strings.Builder b = strings.builder(#len(explain) + 64)
    string8 prev = ""
    bool first = true
    for l in ls:
        if first:
            _ = strings.append(&b, txt(#format("# ", strings.trim(l), "\n")))
            first = false
            prev = "heading"
            continue
        string8 t = strings.trim(l)
        if #len(t) == 0:
            if prev == "para": prev = "gap"
            continue
        string8 kind = "item" if is_property(l) else "para"
        if kind != prev || prev == "heading":
            _ = strings.append(&b, "\n")
        if kind == "item":
            _ = strings.append(&b, txt(#format("* ", t, "\n")))
        else:
            _ = strings.append(&b, txt(#format(t, "\n")))
        prev = kind
    ref []char8 done = strings.finish(&b)
    return txt(done)

// `s` safe in a markdown table cell.
string8 cell(string8 s):
    strings.Builder b = strings.builder(#len(s) + 8)
    for c in s:
        if c == '|':
            _ = strings.append(&b, "\\|")
        else:
            _ = strings.append_char(&b, c)
    ref []char8 done = strings.finish(&b)
    return txt(done)

// The index of the code pages.
string8 codes_index([]CodeRow codes):
    strings.Builder b = strings.builder(16384)
    _ = strings.append(&b, "# Diagnostic codes\n\nEvery code `dadoc` reports. Each is stable within a major version; its page says what it means and the rule behind it. `dado explain <CODE>` prints the same page, and `dado search <words>` finds a code by what it says.\n\n| Code | Class | Title |\n|---|---|---|\n")
    for r in codes:
        _ = strings.append(&b, txt(#format("| [", r.code, "](", r.code, ".md) | ", cell(r.class), " | ", cell(r.title), " |\n")))
    ref []char8 done = strings.finish(&b)
    return txt(done)

// The one-line summary of a package page: the first line of the package's
// comment, after its `core:x — ` when it opens with one. Empty when the page
// has no comment.
string8 page_summary(string8 page):
    ref []string8 ls = raw_lines(unstamped(page))
    i64 i = 0
    for i < #len(ls) && !strings.starts_with(ls[i], "# "):
        i += 1
    i += 1
    for i < #len(ls) && strings.is_empty(strings.trim(ls[i])):
        i += 1
    if i >= #len(ls) || strings.starts_with(ls[i], "## "): return ""
    string8 l = strings.trim(ls[i])
    (string8 head, string8 rest, bool found) = strings.split_first(l, " — ")
    if found && !strings.has_byte(head, ' '): l = strings.trim(rest)
    // A comment's first line may stop mid-sentence; an ellipsis says so.
    if #len(l) > 0 && !ends_sentence(l[#len(l) - 1]): return txt(#format(l, "…"))
    return l

// Whether a line ending in `c` ends where a sentence can.
bool ends_sentence(char8 c):
    return c == '.' || c == ':' || c == '!' || c == '?' || c == ')' || c == '`' || c == '*'

// A package's address, `core:os/fs`, from its path under the collections
// (`core/os/fs`).
string8 address_of(string8 rel):
    (string8 head, string8 rest, bool found) = split_byte(rel, '/')
    if !found: return rel
    return txt(#format(head, ":", rest))

// The index of the package pages. `rels` are the packages' paths under the
// collections, in byte order; `summaries` their summaries, in the same order.
string8 packages_index([]string8 rels, []string8 summaries):
    strings.Builder b = strings.builder(16384)
    _ = strings.append(&b, "# Collection packages\n\nEvery package in the collections, with the first line of its own comment. `dado doc <package>` prints a page, and `dado api <package>` only its signatures.\n")
    string8 last = ""
    for i in 0..<#len(rels):
        (string8 coll, string8 _, bool _) = split_byte(rels[i], '/')
        if coll != last:
            _ = strings.append(&b, txt(#format("\n## ", coll, "\n\n")))
            last = coll
        string8 s = summaries[i]
        _ = strings.append(&b, txt(#format("* [", address_of(rels[i]), "](", rels[i], ".md)")))
        if #len(s) > 0:
            _ = strings.append(&b, txt(#format(" — ", s)))
        _ = strings.append(&b, "\n")
    ref []char8 done = strings.finish(&b)
    return txt(done)

// ── making a page ───────────────────────────────────────────────────────────

// The doc tool, built once per run into the build directory.
private string8 g_doc_bin = ""

private string8 doc_tool_dir():
    return join2(root(), join2("tools", "doc"))

// The doc tool's program, built when this run has not yet. Ends the process
// when it cannot be built.
private string8 doc_bin():
    if #len(g_doc_bin) > 0: return g_doc_bin
    string8 tool = doc_tool_dir()
    if !is_dir(tool):
        die(txt(#format("dado doc: this toolchain ships no doc tool (", tool, " is not there). Reinstall, or restore tools/doc from the repository")))
    string8 dir = join2(build_dir(), "doc-tool")
    _ = fs.make_dirs(dir, #default)
    string8 bin = join2(dir, exe_name("doc"))
    ref []string8 w = #make([]string8, 0)
    _ = #append(w, "build")
    _ = #append(w, tool)
    _ = #append(w, "-o")
    _ = #append(w, bin)
    if again(w[:], true) != 0:
        die(txt(#format("dado doc: building the doc tool failed. Run it by hand to read why: dado build ", tool)))
    g_doc_bin = bin
    return bin

// The page for the package in `dir`, titled `title`; `address` is what
// `dadoc query inspect` is asked about. `ok` is false, with the reason in
// `text`, when the doc tool fails.
(string8 text, bool ok) package_page(string8 dir, string8 title, string8 address, string8 ext):
    string8 bin = doc_bin()
    string8 work = join2(build_dir(), "doc-tool")
    string8 api_file = join2(work, "declarations.txt")
    string8 out_file = join2(work, txt(#format("page", MD)))
    Command q = command(dadoc())
    add(&q, "query")
    add(&q, "inspect")
    add(&q, txt(#format("--collections=", collections())))
    ref []string8 imports = imports_flags(working_dir())
    add_all(&q, imports[:])
    add(&q, address)
    Captured qr = capture(q, true)
    // Not a package dadoc can read (a tree of other files, documented by its
    // blocks alone): the page has no declarations.
    string8 api = txt(qr.out) if qr.started && qr.status == 0 else ""
    try fs.write_file(api_file, api) else code:
        return (txt(#format("cannot write ", api_file, ": ", os.message(code))), false)
    Command c = command(bin)
    add(&c, "page")
    add(&c, dir)
    add(&c, title)
    add(&c, api_file)
    add(&c, out_file)
    add(&c, "--ext")
    add(&c, ext)
    Captured r = capture(c, true)
    if !r.started || r.status != 0:
        return (txt(#format("the doc tool could not write the page for ", title, ": ", txt(r.out))), false)
    try ref []char8 page = fs.read_file(out_file) else code:
        return (txt(#format("cannot read ", out_file, ": ", os.message(code))), false)
    return (txt(page), true)

// `p` relative to `base` when it is under it, else "".
private string8 under(string8 p, string8 base):
    string8 cp = clean_path(p)
    string8 cb = clean_path(base)
    if #len(cp) > #len(cb) + 1 && strings.starts_with(cp, cb) && (cp[#len(cb)] == '/' || cp[#len(cb)] == '\\'):
        return cp[#len(cb) + 1..<#len(cp)]
    return ""

// The page a topic names under the root, as a path from the root, or "".
private string8 topic_page(string8 what):
    string8 r = root()
    if what == "channels":
        if is_file(join2(r, txt(#format("CHANNELS", MD)))): return txt(#format("CHANNELS", MD))
        return ""
    if strings.has_byte(what, ' ') || strings.contains(what, ".."): return ""
    string8 docs = join2(r, "docs")
    string8 plain = txt(#format(what, ".md"))
    if strings.ends_with(what, ".md"): plain = what
    if is_file(join2(docs, plain)): return txt(#format("docs/", plain))
    if is_file(join3(docs, what, txt(#format("README", MD)))): return txt(#format("docs/", what, txt(#format("/README", MD))))
    return ""

// A page, written to `out` when it is given, else printed as text or JSON.
private i32 give_page(string8 topic, string8 kind, string8 source, string8 text, string8 out, bool json):
    if #len(out) > 0:
        _ = fs.make_dirs(dir_of(out), #default)
        try fs.write_file(out, text) else code:
            return answer_error("doc", json, txt(#format("cannot write ", out, ": ", os.message(code))))
        return 0
    if !json:
        print_raw(text)
        return 0
    ref []string8 f = #make([]string8, 0)
    _ = #append(f, json_text("query", "doc"))
    _ = #append(f, json_text("topic", topic))
    _ = #append(f, json_text("kind", kind))
    _ = #append(f, json_text("source", source))
    _ = #append(f, json_text("text", text))
    fmt.println(json_object(f[:]))
    return 0

// A temporary file's path for this run, in the build directory.
private string8 scratch(string8 name):
    string8 dir = join2(build_dir(), "doc-tool")
    _ = fs.make_dirs(dir, #default)
    return join2(dir, name)

// `dado doc …`: see the header. The `-o`/`--spine`/`params` forms are the
// doc tool's, as before.
i32 doc_verb(^flags.Parser p, string8 what, []string8 paths, string8 out, string8 spine, string8 ext, string8 captions):
    bool json = json_wanted(p)
    (bool check, bool write) = doc_modes(p)
    if check || write:
        if #len(what) > 0:
            return answer_error("doc", json, "--check and --write regenerate all of docs/, and take no package. Try: dado doc --check")
        if check && write:
            return answer_error("doc", json, "--check writes nothing and --write writes; give one")
        return regenerate(write, json)
    if #len(what) == 0:
        return answer_error("doc", json, "which package or topic? Try: dado doc core:strings, dado doc ERR0301, dado doc reference, or dado doc --check")
    if what == "params" || #len(spine) > 0:
        return doc(what, paths, out, spine, ext, captions)
    if #len(paths) > 0:
        return answer_error("doc", json, txt(#format("dado doc: unknown option ", paths[0])))
    if what == "reference":
        if #len(out) > 0 && !json:
            return doc(what, paths, out, spine, ext, captions)
        string8 tmp = scratch(txt(#format("reference", MD)))
        ref []string8 w = #make([]string8, 0)
        _ = #append(w, "doc")
        _ = #append(w, "reference")
        _ = #append(w, "-o")
        _ = #append(w, tmp)
        if #len(captions) > 0:
            _ = #append(w, "--captions")
            _ = #append(w, captions)
        if again(w[:], true) != 0:
            return answer_error("doc", json, "could not render the reference. Run it by hand to read why: dado doc reference -o /dev/null")
        try ref []char8 text = fs.read_file(tmp) else code:
            return answer_error("doc", json, txt(#format("cannot read ", tmp, ": ", os.message(code))))
        return give_page(what, "reference", "dadoc --emit=lexicon", txt(text), "", json)
    // A diagnostic code.
    if #len(what) >= 4 && !strings.has_byte(what, '/') && !strings.has_byte(what, ':') && !exists(what):
        ref []CodeRow codes = parse_codes(lexicon_text())
        (CodeRow row, bool found) = code_named(codes[:], what)
        if found:
            Command c = command(dadoc())
            add(&c, "--explain")
            add(&c, row.code)
            Captured r = capture(c, false)
            if !r.started || r.status != 0:
                return answer_error("doc", json, txt(#format(shown(c), " failed. `dado doctor` checks the compiler.")))
            return give_page(what, "code", row.code, code_markdown(txt(r.out)), out, json)
    // A collection package by its address.
    if strings.has_byte(what, ':') && !exists(what):
        (string8 coll, string8 rest, bool _) = split_byte(what, ':')
        string8 dir = join3(collections(), coll, rest)
        // `imports:` is the project's `imports/`, then the install's.
        if coll == "imports": dir = imports_dir(rest)
        if !is_dir(dir):
            return answer_error("doc", json, txt(#format("there is no package `", what, "` (", dir, " is not a directory). `dado doc packages` lists them")))
        (string8 text, bool ok) = package_page(dir, what, what, ext)
        if !ok: return answer_error("doc", json, text)
        return give_page(what, "package", what, text, out, json)
    // A package by its path; one inside the collections is titled by its
    // address, so its page is the one docs/packages/ holds.
    if exists(what):
        string8 rel = under(absolute(what, working_dir()), collections())
        string8 title = what
        if #len(rel) > 0: title = address_of(rel)
        (string8 text, bool ok) = package_page(what, title, title if #len(rel) > 0 else what, ext)
        if !ok: return answer_error("doc", json, text)
        return give_page(what, "package", title, text, out, json)
    string8 page = topic_page(what)
    if #len(page) > 0:
        try ref []char8 text = fs.read_file(join2(root(), page)) else code:
            return answer_error("doc", json, txt(#format("cannot read ", page, ": ", os.message(code))))
        return give_page(what, "page", page, txt(text), out, json)
    return answer_error("doc", json, txt(#format("no package, diagnostic code or topic `", what, "`. Topics are the pages under docs/ (language, reference, channels, codes, packages); `dado search ", what, "` looks everywhere")))

// ── generating docs/ ────────────────────────────────────────────────────────

// The files this run generated, as paths from the root, and the generators
// it skipped, each as its path and then why.
private ref []string8 g_made
private ref []string8 g_skipped

// Write `text` at `rel` under `base`, and remember it.
private bool put_generated(string8 base, string8 rel, string8 text):
    string8 p = join2(base, rel)
    _ = fs.make_dirs(dir_of(p), #default)
    try fs.write_file(p, text) else code:
        warn(txt(#format("cannot write ", p, ": ", os.message(code))))
        return false
    _ = #append(g_made, rel)
    return true

// A generator that could not run here, and why.
private void skip_generated(string8 rel, string8 why):
    _ = #append(g_skipped, rel)
    _ = #append(g_skipped, why)

// The paths, from the collections, of every collection package: each
// directory holding a `.dado` file that is not a test. In byte order.
ref []string8 collection_packages(string8 coll):
    ref []string8 dirs = #make([]string8, 0)
    fs.Listing l = fs.walk(coll, #default)
    for e in l.entries:
        if e.is_dir || !strings.ends_with(e.path, ".dado") || strings.ends_with(e.path, "_test.dado"): continue
        string8 rel = under(dir_of(e.path), coll)
        if #len(rel) == 0: continue
        ref []char8 own = #format(rel)
        _ = #append(dirs, txt(own))
    sort_bytes(dirs[:])
    ref []string8 out = #make([]string8, 0)
    for d in dirs:
        if #len(out) == 0 || out[#len(out) - 1] != d:
            _ = #append(out, d)
    return out

// Everything `docs/` is generated from, written under `base`.
private void generate(string8 base):
    g_made = #make([]string8, 0)
    g_skipped = #make([]string8, 0)
    Command v = command(dadoc())
    add(&v, "--version")
    Captured vr = capture(v, true)
    if !vr.started || vr.status != 0:
        die(txt(#format(shown(v), " failed. `dado doctor` checks the compiler.")))
    string8 stamp = stamp_of(txt(vr.out))

    ref []CodeRow codes = parse_codes(lexicon_text())
    for r in codes:
        Command c = command(dadoc())
        add(&c, "--explain")
        add(&c, r.code)
        Captured er = capture(c, false)
        if !er.started || er.status != 0:
            die(txt(#format(shown(c), " failed: the compiler lists a code it cannot explain.")))
        _ = put_generated(base, txt(#format("docs/codes/", r.code, ".md")), txt(#format(stamp, code_markdown(txt(er.out)))))
    _ = put_generated(base, txt(#format("docs/codes/README", MD)), txt(#format(stamp, codes_index(codes[:]))))

    string8 coll = collections()
    ref []string8 pkgs = collection_packages(coll)
    ref []string8 summaries = #make([]string8, 0)
    for rel in pkgs:
        string8 address = address_of(rel)
        (string8 text, bool ok) = package_page(join2(coll, rel), address, address, ".dado")
        if !ok: die(text)
        _ = put_generated(base, txt(#format("docs/packages/", rel, ".md")), txt(#format(stamp, text)))
        _ = #append(summaries, page_summary(text))
    _ = put_generated(base, txt(#format("docs/packages/README", MD)), txt(#format(stamp, packages_index(pkgs[:], summaries[:]))))

    string8 r = root()
    ref []string8 w = #make([]string8, 0)
    _ = #append(w, "doc")
    _ = #append(w, "reference")
    _ = #append(w, "-o")
    _ = #append(w, join3(base, "docs", txt(#format("reference", MD))))
    if again(w[:], true) != 0:
        die(txt(#format("could not render docs/reference", MD, ". Run it by hand to read why: dado doc reference -o /dev/null")))
    _ = #append(g_made, txt(#format("docs/reference", MD)))

    string8 spine = join3(r, "docs", txt(#format("spine", MD)))
    string8 source = join2(r, "crates")
    if is_dir(source) && is_file(spine):
        ref []string8 lw = #make([]string8, 0)
        _ = #append(lw, "doc")
        _ = #append(lw, source)
        _ = #append(lw, "--ext")
        _ = #append(lw, ".rs")
        _ = #append(lw, "--spine")
        _ = #append(lw, spine)
        _ = #append(lw, "-o")
        _ = #append(lw, join3(base, "docs", txt(#format("language", MD))))
        if again(lw[:], true) != 0:
            die(txt(#format("the doc tool refused to weave docs/language", MD, ". Run it by hand to read why: ./dado doc crates --ext .rs --spine docs/spine", MD, " -o /dev/null")))
        _ = #append(g_made, txt(#format("docs/language", MD)))
    else:
        skip_generated(txt(#format("docs/language", MD)), "it is woven from the compiler's source, which is not here")

    string8 sspine = join3(r, "docs", txt(#format("channels-spine", MD)))
    string8 threads = join3(coll, "core", "threads")
    if is_dir(threads) && is_file(sspine):
        ref []string8 sw = #make([]string8, 0)
        _ = #append(sw, "doc")
        _ = #append(sw, threads)
        _ = #append(sw, "--spine")
        _ = #append(sw, sspine)
        _ = #append(sw, "-o")
        _ = #append(sw, join2(base, txt(#format("CHANNELS", MD))))
        if again(sw[:], true) != 0:
            die(txt(#format("the doc tool refused to weave the channels guide. Run it by hand to read why: dado doc collections/core/threads --spine docs/channels-spine", MD, " -o /dev/null")))
        _ = #append(g_made, txt(#format("CHANNELS", MD)))
    else:
        skip_generated(txt(#format("CHANNELS", MD)), txt(#format("docs/channels-spine", MD, " or core:threads is not here")))

// The text of the file at `p`, and whether it could be read.
private (string8 text, bool ok) read_text(string8 p):
    try ref []char8 t = fs.read_file(p) else:
        return ("", false)
    return (txt(t), true)

// `dado doc --check` and `dado doc --write`.
private i32 regenerate(bool write, bool json):
    try ref []char8 made_dir = fs.make_temp_dir("dado-docs") else code:
        return answer_error("doc", json, txt(#format("cannot make a temporary directory: ", os.message(code), ". Set TMPDIR to a writable directory")))
    string8 tmp = txt(made_dir)
    generate(tmp)
    string8 r = root()
    ref []string8 paths = #make([]string8, 0)
    ref []string8 statuses = #make([]string8, 0)
    i64 unchanged = 0
    for rel in g_made:
        (string8 fresh, bool _) = read_text(join2(tmp, rel))
        (string8 committed, bool there) = read_text(join2(r, rel))
        if !there:
            _ = #append(paths, rel)
            _ = #append(statuses, "missing")
        else if unstamped(fresh) != unstamped(committed):
            _ = #append(paths, rel)
            _ = #append(statuses, "differs")
        else:
            unchanged += 1
    for sub in ["docs/codes", "docs/packages"]:
        string8 dir = join2(r, sub)
        fs.Listing l = fs.walk(dir, #default)
        ref []string8 found = #make([]string8, 0)
        for e in l.entries:
            if e.is_dir || !strings.ends_with(e.path, ".md"): continue
            string8 rel = under(e.path, r)
            bool generated = false
            for m in g_made:
                if m == rel: generated = true
            if !generated:
                ref []char8 own = #format(rel)
                _ = #append(found, txt(own))
        sort_bytes(found[:])
        for s in found:
            _ = #append(paths, s)
            _ = #append(statuses, "stale")
    i64 removed = 0
    i64 wrote = 0
    if write:
        for i in 0..<#len(paths):
            string8 target = join2(r, paths[i])
            if statuses[i] == "stale":
                try fs.remove_file(target) else code:
                    die(txt(#format("cannot remove ", target, ": ", os.message(code))))
                removed += 1
                continue
            (string8 fresh, bool _) = read_text(join2(tmp, paths[i]))
            _ = fs.make_dirs(dir_of(target), #default)
            try fs.write_file(target, fresh) else code:
                die(txt(#format("cannot write ", target, ": ", os.message(code))))
            wrote += 1
    try fs.remove_all(tmp) else:
        warn(txt(#format("cannot remove the temporary directory ", tmp)))
    if json:
        ref []string8 changes = #make([]string8, 0)
        for i in 0..<#len(paths):
            ref []string8 cf = #make([]string8, 0)
            _ = #append(cf, json_text("path", paths[i]))
            _ = #append(cf, json_text("status", statuses[i]))
            _ = #append(changes, json_object(cf[:]))
        ref []string8 skips = #make([]string8, 0)
        i64 k = 0
        for k + 1 < #len(g_skipped):
            ref []string8 sf = #make([]string8, 0)
            _ = #append(sf, json_text("path", g_skipped[k]))
            _ = #append(sf, json_text("reason", g_skipped[k + 1]))
            _ = #append(skips, json_object(sf[:]))
            k += 2
        ref []string8 f = #make([]string8, 0)
        _ = #append(f, json_text("query", "doc"))
        _ = #append(f, json_text("mode", "write" if write else "check"))
        _ = #append(f, json_number("files", #len(g_made)))
        _ = #append(f, json_field("changes", json_array(changes[:])))
        _ = #append(f, json_field("skipped", json_array(skips[:])))
        fmt.println(json_object(f[:]))
    else:
        for i in 0..<#len(paths):
            string8 word = statuses[i]
            if write: word = "removed" if statuses[i] == "stale" else "wrote"
            fmt.println(word, " ", paths[i])
        i64 k = 0
        for k + 1 < #len(g_skipped):
            fmt.println("skipped ", g_skipped[k], " (", g_skipped[k + 1], ")")
            k += 2
        if write:
            fmt.println("docs: ", #len(g_made), " generated, ", wrote, " written, ", removed, " removed, ", unchanged, " unchanged")
        else if #len(paths) == 0:
            fmt.println("docs: ", #len(g_made), " generated files match")
        else:
            fmt.println("docs: ", #len(paths), " of ", #len(g_made), " generated files differ. Run: dado doc --write")
    if !write && #len(paths) > 0: return 1
    return 0
