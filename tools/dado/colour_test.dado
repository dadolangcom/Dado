@test
// `--color`: the choice, when it colours, and the escapes it writes.
//
//   * the flag wins over `DADO_COLOR`, and an unknown `DADO_COLOR` is `auto`;
//   * `auto` colours only a terminal with `NO_COLOR` unset or empty, and
//     `always` and `never` ignore both;
//   * **forced on**, as `--color=always` is with this test's output on a
//     pipe, a `FAIL` line carries copper and a dim line slate, in 24-bit or
//     256 colours as `COLORTERM` says; forced off, neither does.
package driver

import "core:flags"
import "core:mem/arena"
import "core:mem/libc"
import "core:os"
import "core:strings"

private bool choices():
    bool ok = true
    ok = #expect(colour_choice("never", true, "always") == "never", "the flag did not win over DADO_COLOR") && ok
    ok = #expect(colour_choice("auto", false, "always") == "always", "DADO_COLOR was not the choice without the flag") && ok
    ok = #expect(colour_choice("auto", false, "purple") == "auto", "an unknown DADO_COLOR was not auto") && ok
    ok = #expect(colour_choice("auto", false, "") == "auto", "no choice at all was not auto") && ok
    ok = #expect(colour_wanted("auto", "", true), "auto on a terminal did not colour") && ok
    ok = #expect(!colour_wanted("auto", "", false), "auto on a pipe coloured") && ok
    ok = #expect(!colour_wanted("auto", "1", true), "auto with NO_COLOR coloured") && ok
    ok = #expect(colour_wanted("always", "1", false), "always did not colour a pipe with NO_COLOR") && ok
    ok = #expect(!colour_wanted("never", "", true), "never coloured a terminal") && ok
    ok = #expect(copper_escape(true) == "\x1b[38;2;229;139;87m" && copper_escape(false) == "\x1b[38;5;173m", "copper's escapes moved") && ok
    ok = #expect(slate_escape(true) == "\x1b[38;2;154;163;173m" && slate_escape(false) == "\x1b[38;5;247m", "slate's escapes moved") && ok
    return ok

// Parse `words` with the colour flag declared, and settle it.
private void settle_with([]string8 words):
    flags.Parser p = flags.parser("dado", "")
    p.command("build", "")
    declare_colour(&p)
    try string8 _ = p.parse(words) else:
        return
    settle_colour(&p)

private bool forced():
    bool ok = true
    settle_with(["build", "--color=always"])
    (string8 exported, bool set) = env("DADO_COLOR")
    ok = #expect(set && exported == "always", "DADO_COLOR was not exported as always: `", exported, "`") && ok
    colour()
    bool deep = colour_deep()
    ok = #expect(g_red == copper_escape(deep), "a forced FAIL is not copper: `", g_red, "`") && ok
    ok = #expect(g_dim == slate_escape(deep), "a forced dim line is not slate") && ok
    ok = #expect(strings.starts_with(g_reset, "\x1b["), "a forced line is not reset") && ok
    settle_with(["build", "--color=never"])
    colour()
    ok = #expect(#len(g_red) == 0 && #len(g_dim) == 0 && #len(g_bold) == 0, "--color=never still coloured") && ok
    try os.unset_env("DADO_COLOR") else:
        pass
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = choices()
        ok = forced() && ok
        if ok: return 0
        return 1
