// A library's manifest, `dado.json`, and the package index's lines: the pure
// half of `dado package` (package.dado runs git, `gh` and the prompts).
//
// `dado.json` (T73, T74) marks a project's root, and a library's holds what
// the index and `dado get` need:
//
//     {
//       "name": "Clipper2",
//       "version": "1.4.2",
//       "description": "Polygon clipping and offsetting.",
//       "licence": "BSL-1.0",
//       "repository": "https://github.com/owner/clipper2",
//       "targets": ["native", "web"]
//     }
//
// A project's holds the libraries `dado get` fetched for it (T76), each
// pinned to the repository, version and commit every build checks; a library
// vendored into the project (`--project`) also has `hash`, its files' content
// hash (`hash_vendored_file`), which is what a build checks for it:
//
//     {
//       "libraries": {
//         "Clipper2": {
//           "repository": "https://github.com/owner/clipper2",
//           "version": "1.4.2",
//           "commit": "0123456789abcdef0123456789abcdef01234567"
//         }
//       }
//     }
//
// `dadoc` (the minimum compiler) is optional. Any other key is refused by
// name, so a misspelt one is never silently ignored. An empty file is `{}`:
// it still marks a project.
//
// The index is the readme of the DadoPKG repository: `## Category` headings, and under each
// one line per library in exactly this form, sorted by name:
//
//     - [Clipper2](https://github.com/owner/clipper2) — Polygon clipping and offsetting.
//
// Any other line is prose and is left alone.
package driver

import "core:hash"
import "core:json"
import "core:strings"
import "core:strings/parse"

// The manifest's file name.
const string8 MANIFEST_FILE = "dado.json"

// What `dado.json` holds. A field that was absent is "" (`targets`: empty).
type Library:
    string8 name
    string8 version
    string8 description
    string8 licence
    string8 repository
    string8 dadoc
    ref []string8 targets
    ref []Pin libraries     // `libraries`, in the file's order

// One library a project pins: `dado get` wrote it, and every build checks the
// checkout is at `commit`. `version` is a semver version without its `v`, or a
// tag that is not semver, by its exact name. `hash` is set for a library
// vendored into the project: the content hash of its files there.
type Pin:
    string8 name
    string8 repository
    string8 version
    string8 commit
    string8 hash

private const string8 LIBRARY_KEYS = "name version description licence repository targets dadoc libraries"
private const string8 PIN_KEYS = "repository version commit hash"

// `text` read as `dado.json`. `ok` false, and `why` the reason, when it is not
// JSON, not an object, or holds a key or value this driver does not take.
(Library lib, bool ok, string8 why) parse_library(string8 text):
    Library lib
    lib.targets = #make([]string8, 0)
    lib.libraries = #make([]Pin, 0)
    string8 trimmed = strings.trim(text)
    if #len(trimmed) == 0:
        return (lib, true, "")
    try json.Document doc = json.parse_text(text) else code:
        return (lib, false, txt(#format("is not JSON: ", json.message(code))))
    defer doc.destroy()
    json.Value top = doc.root()
    if top.kind() != json.Kind.Object:
        return (lib, false, "is not a JSON object: write { … } around its keys")
    for i in 0..<top.len():
        try string8 key = top.key(i) else:
            return (lib, false, "has an unreadable key")
        try json.Value v = top.at(i) else:
            return (lib, false, "has an unreadable value")
        if key == "license":
            return (lib, false, "has the key `license`: the manifest spells it `licence`")
        if !in_words(LIBRARY_KEYS, key):
            return (lib, false, txt(#format("has the key `", key, "`, which is not one of: ", LIBRARY_KEYS)))
        if key == "targets":
            if v.kind() != json.Kind.Array:
                return (lib, false, "`targets` is not an array of strings, e.g. [\"native\", \"web\"]")
            for j in 0..<v.len():
                try json.Value t = v.at(j) else:
                    return (lib, false, "`targets` has an unreadable element")
                try string8 s = t.text() else:
                    return (lib, false, "`targets` holds something other than a string")
                string8 bad = field_refusal("targets", s)
                if #len(bad) > 0: return (lib, false, bad)
                _ = #append(lib.targets, txt(strings.clone(s)))
            continue
        if key == "libraries":
            if v.kind() != json.Kind.Object:
                return (lib, false, "`libraries` is not an object of pins, e.g. {\"Clipper2\": {\"repository\": \"https://…\", \"version\": \"1.4.2\", \"commit\": \"<40 hex digits>\"}}")
            for j in 0..<v.len():
                try string8 pname = v.key(j) else:
                    return (lib, false, "`libraries` has an unreadable key")
                try json.Value pv = v.at(j) else:
                    return (lib, false, "`libraries` has an unreadable value")
                (Pin p, string8 bad) = parse_pin(pname, pv)
                if #len(bad) > 0: return (lib, false, bad)
                for q in lib.libraries:
                    if strings.equal_fold(q.name, p.name):
                        return (lib, false, txt(#format("`libraries` pins both `", q.name, "` and `", p.name, "`: names are matched ignoring case, so keep one")))
                _ = #append(lib.libraries, p)
            continue
        try string8 s = v.text() else:
            return (lib, false, txt(#format("`", key, "` is not a string")))
        string8 bad = field_refusal(key, s)
        if #len(bad) > 0: return (lib, false, bad)
        string8 owned = txt(strings.clone(s))
        if key == "name": lib.name = owned
        else if key == "version": lib.version = owned
        else if key == "description": lib.description = owned
        else if key == "licence": lib.licence = owned
        else if key == "repository": lib.repository = owned
        else if key == "dadoc": lib.dadoc = owned
    if #len(lib.version) > 0:
        (SemVer _, bool good) = parse_semver(lib.version)
        if !good:
            return (lib, false, txt(#format("`version` is `", lib.version, "`, which is not a semver version like 1.4.2")))
    return (lib, true, "")

// One entry of `libraries`, read: the name, then an object of exactly
// `repository`, `version` and `commit`. `why` is set when it cannot be taken.
private (Pin p, string8 why) parse_pin(string8 name, json.Value v):
    Pin p
    string8 bad_name = library_name_refusal(name)
    if #len(bad_name) > 0:
        return (p, txt(#format("`libraries`: ", bad_name)))
    p.name = txt(strings.clone(name))
    string8 at = txt(#format("`libraries`.`", name, "`"))
    if v.kind() != json.Kind.Object:
        return (p, txt(#format(at, " is not an object of repository, version and commit")))
    for i in 0..<v.len():
        try string8 key = v.key(i) else:
            return (p, txt(#format(at, " has an unreadable key")))
        if !in_words(PIN_KEYS, key):
            return (p, txt(#format(at, " has the key `", key, "`, which is not one of: ", PIN_KEYS)))
        try json.Value fv = v.at(i) else:
            return (p, txt(#format(at, " has an unreadable value")))
        try string8 s = fv.text() else:
            return (p, txt(#format(at, ".`", key, "` is not a string")))
        string8 owned = txt(strings.clone(s))
        if key == "repository":
            string8 bad = field_refusal("repository", owned)
            if #len(bad) > 0: return (p, txt(#format(at, ": ", bad)))
            p.repository = owned
        else if key == "version":
            string8 bad = tag_refusal(owned)
            if #len(bad) > 0: return (p, txt(#format(at, ": `version` ", bad)))
            p.version = owned
        else if key == "hash":
            if !is_sha256(owned):
                return (p, txt(#format(at, ": `hash` is `", owned, "`, not a SHA-256's 64 lowercase hex digits")))
            p.hash = owned
        else:
            if !is_commit(owned):
                return (p, txt(#format(at, ": `commit` is `", owned, "`, not a commit's 40 lowercase hex digits")))
            p.commit = owned
    if #len(p.repository) == 0 || #len(p.version) == 0 || #len(p.commit) == 0:
        return (p, txt(#format(at, " needs all of repository, version and commit: dado get ", name, "@<version> writes them")))
    return (p, "")

// Whether `s` is a commit as git names it in full: 40 lowercase hex digits.
bool is_commit(string8 s):
    if #len(s) != 40: return false
    return lower_hex(s)

// Whether `s` is a SHA-256 written out: 64 lowercase hex digits.
bool is_sha256(string8 s):
    if #len(s) != 64: return false
    return lower_hex(s)

private bool lower_hex(string8 s):
    for i in 0..<#len(s):
        char8 c = s[i]
        if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')): return false
    return true

// Why `tag` cannot name a git tag (a pinned version, or one asked for), or
// "": git's own rules for a ref's name, the ones a typo meets.
string8 tag_refusal(string8 tag):
    if #len(tag) == 0: return "is empty"
    if tag[0] == '-' || tag[0] == '.': return txt(#format("`", tag, "` starts with `", tag[0..<1], "`, which no tag does"))
    if strings.contains(tag, "..") || strings.contains(tag, "@{") || strings.ends_with(tag, ".lock") || strings.ends_with(tag, "."):
        return txt(#format("`", tag, "` is not a tag's name"))
    for i in 0..<#len(tag):
        char8 c = tag[i]
        if u8(c) <= 0x20 || u8(c) == 0x7f || c == '~' || c == '^' || c == ':' || c == '?' || c == '*' || c == '[' || c == '\\':
            return txt(#format("`", tag, "` holds `", tag[i..<i + 1], "`, which a tag's name cannot"))
    return ""

// `lib` with `p` pinned: in place of a pin of the same name (ignoring case,
// T59), else after the others.
Library with_pin(Library lib, Pin p):
    Library out = lib
    ref []Pin pins = #make([]Pin, 0)
    bool placed = false
    for q in lib.libraries:
        if strings.equal_fold(q.name, p.name):
            _ = #append(pins, p)
            placed = true
        else:
            _ = #append(pins, q)
    if !placed: _ = #append(pins, p)
    out.libraries = pins
    return out

// Why `value` cannot be the manifest's `key`, or "". No field holds a control
// character (a newline or tab included): each is one line of the index, a
// commit message or a tag's. `repository` is also a URL inside the index
// line's `(…)`, so it holds no space and none of `()[]<>` or a backtick.
string8 field_refusal(string8 key, string8 value):
    for i in 0..<#len(value):
        char8 c = value[i]
        if u8(c) < 0x20 || u8(c) == 0x7f:
            return txt(#format("`", key, "` holds a control character (byte ", u8(c), "): write it on one line, without tabs"))
    if key != "repository": return ""
    string8 bad = url_refusal(value)
    if #len(bad) > 0: return txt(#format("`repository` ", bad))
    for i in 0..<#len(value):
        char8 c = value[i]
        if c == ' ' || c == '(' || c == ')' || c == '[' || c == ']' || c == '<' || c == '>' || c == '`':
            return txt(#format("`repository` holds `", value[i..<i + 1], "`, which a URL in the index cannot: write the address users clone, like https://github.com/owner/name"))
    return ""

// Why `url` cannot be a repository's address git is handed, or "": one
// starting with `-` would be read as an option (`--upload-pack=…` runs a
// program), so none does, wherever it came from: `dado.json`, the index, a
// pin or the command line.
string8 url_refusal(string8 url):
    if #len(url) > 0 && url[0] == '-':
        return txt(#format("`", url, "` starts with `-`, which git would read as an option; no repository's address does"))
    return ""

// Why `lib` cannot be written, or "": `field_refusal` for each field, for
// what was typed at a prompt rather than read from `dado.json`.
string8 library_refusal(Library lib):
    []string8 keys = ["name", "version", "description", "licence", "repository", "dadoc"]
    []string8 values = [lib.name, lib.version, lib.description, lib.licence, lib.repository, lib.dadoc]
    for i in 0..<#len(keys):
        string8 why = field_refusal(keys[i], values[i])
        if #len(why) > 0: return why
    for t in lib.targets:
        string8 why = field_refusal("targets", t)
        if #len(why) > 0: return why
    return ""

// `lib` as the text of `dado.json`: two-space indent, keys in a fixed order,
// empty fields left out, and a final newline.
string8 render_library(Library lib):
    json.Writer w = json.writer(indent: 2)
    w.object()
    library_field(&w, "name", lib.name)
    library_field(&w, "version", lib.version)
    library_field(&w, "description", lib.description)
    library_field(&w, "licence", lib.licence)
    library_field(&w, "repository", lib.repository)
    library_field(&w, "dadoc", lib.dadoc)
    if #len(lib.targets) > 0:
        w.key("targets")
        w.array()
        for t in lib.targets:
            w.text(t)
        w.end_array()
    if #len(lib.libraries) > 0:
        w.key("libraries")
        w.object()
        for p in lib.libraries:
            w.key(p.name)
            w.object()
            library_field(&w, "repository", p.repository)
            library_field(&w, "version", p.version)
            library_field(&w, "commit", p.commit)
            library_field(&w, "hash", p.hash)
            w.end_object()
        w.end_object()
    w.end_object()
    try ref []char8 text = w.finish() else:
        return "{}\n"
    return txt(#format(txt(text), "\n"))

private void library_field(^json.Writer w, string8 key, string8 value):
    if #len(value) == 0: return
    w.key(key)
    w.text(value)

private bool in_words(string8 words, string8 word):
    for w in words_of(words):
        if w == word: return true
    return false

// ── names ───────────────────────────────────────────────────────────────────

// Why `name` cannot name a library, or "": a letter first, then letters,
// digits, `-` and `_`; at most 64 bytes; and never a standard collection's
// name, which its `lib:` folder would read as.
string8 library_name_refusal(string8 name):
    string8 why = name_rule_refusal(name)
    if #len(why) > 0: return why
    string8 low = txt(strings.to_lower(name))
    if low == "core" || low == "app" || low == "vendor" || low == "lib":
        return txt(#format("`", name, "` is a standard collection's name"))
    return ""

// Why `name` cannot name a project, library or program, or "": the
// characters and length `library_name_refusal` holds a library to, and a
// package form (`package_word`) that is neither a keyword nor `main`.
string8 name_rule_refusal(string8 name):
    if #len(name) == 0: return "the name is empty"
    if #len(name) > 64: return txt(#format("`", name, "` is longer than 64 characters"))
    if !is_letter(name[0]):
        return txt(#format("`", name, "` must start with a letter"))
    for i in 0..<#len(name):
        char8 c = name[i]
        if !(is_letter(c) || (c >= '0' && c <= '9') || c == '-' || c == '_'):
            return txt(#format("`", name, "` holds `", name[i..<i + 1], "`; a name is letters, digits, `-` and `_`"))
    return package_word_refusal(name)

// The eighteen words the lexer reserves, which can never be a package's
// name or qualifier (`dadoc --emit=lexicon` lists the language's words).
// Contextual words (`try`, `nil`, `i32`, …) are not here: each was checked to
// work as a package's name and qualifier.
private const string8 DADO_KEYWORDS = "package import type distinct const enum foreign view for in if else return break continue async await super"

// The package name `name` is written as: lowercase, `-` as `_`.
string8 package_word(string8 name):
    return txt(strings.replace(txt(strings.to_lower(name)), "-", "_"))

// Why `name`'s package form cannot name a package, or "": a keyword is not an
// identifier, and `main` is a program's package, never a library's.
string8 package_word_refusal(string8 name):
    string8 word = package_word(name)
    if word == "main":
        return txt(#format("`", name, "` would be `package main`, which is a program's package"))
    if in_words(DADO_KEYWORDS, word):
        return txt(#format("`", name, "` would be `package ", word, "`, and `", word, "` is a Dado keyword"))
    return ""

// The package a source file declares: the word on its `package` line, which
// comes after any comments and an `@test`; "" when it opens with none.
string8 declared_package(string8 source):
    for l in lines_of(source):
        string8 t = strings.trim(l)
        if strings.starts_with(t, "package "):
            string8 rest = strings.trim(t[8..<#len(t)])
            for i in 0..<#len(rest):
                if rest[i] == ' ' || rest[i] == '\t' || rest[i] == '/': return rest[0..<i]
            return rest
        if #len(t) > 0 && !strings.starts_with(t, "//") && !strings.starts_with(t, "@"): break
    return ""

// The import line for the package at `path` (`lib:my-geo`, `lib:geo/sub`)
// whose files declare `pkg`: plain when the path's last part is the package's
// name, since that part is the qualifier at the use site; otherwise the alias
// form, `import my_geo "lib:my-geo"` (a folder named `my-geo` is no
// identifier). `pkg` "" (not known) gives the plain form.
string8 import_line(string8 path, string8 pkg):
    i64 cut = 0
    for i in 0..<#len(path):
        if path[i] == '/' || path[i] == ':': cut = i + 1
    string8 last = path[cut..<#len(path)]
    if #len(pkg) == 0 || pkg == last: return txt(#format("import \"", path, "\""))
    return txt(#format("import ", pkg, " \"", path, "\""))

private bool is_letter(char8 c):
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')

// ── versions ────────────────────────────────────────────────────────────────

// A semver version: `1.4.2`, or `1.4.2-rc.1`. Build metadata (`+…`) is kept
// out: a tag names one release.
type SemVer:
    i64 major
    i64 minor
    i64 patch
    string8 pre

// `s` as a version, with or without a leading `v`.
(SemVer v, bool ok) parse_semver(string8 s):
    SemVer v
    string8 t = s
    if #len(t) > 0 && (t[0] == 'v' || t[0] == 'V'):
        t = t[1..<#len(t)]
    (string8 core, string8 pre, bool has_pre) = strings.split_first(t, "-")
    if has_pre:
        if #len(pre) == 0: return (v, false)
        for i in 0..<#len(pre):
            char8 c = pre[i]
            if !(is_letter(c) || (c >= '0' && c <= '9') || c == '.' || c == '-'):
                return (v, false)
        v.pre = pre
    ref []string8 parts = strings.split(core, ".")
    if #len(parts) != 3: return (v, false)
    [3]i64 n
    for i in 0..<3:
        string8 p = parts[i]
        if #len(p) == 0 || (#len(p) > 1 && p[0] == '0'): return (v, false)
        for j in 0..<#len(p):
            if p[j] < '0' || p[j] > '9': return (v, false)
        try n[i] = parse.to_i64(p) else:
            return (v, false)
    v.major = n[0]
    v.minor = n[1]
    v.patch = n[2]
    return (v, true)

// `v` written out, without a `v`.
string8 semver_text(SemVer v):
    if #len(v.pre) > 0:
        return txt(#format(v.major, ".", v.minor, ".", v.patch, "-", v.pre))
    return txt(#format(v.major, ".", v.minor, ".", v.patch))

// Whether `a` comes before `b`. A pre-release comes before its release; two
// pre-releases compare dot by dot, numbers as numbers and below words.
bool semver_less(SemVer a, SemVer b):
    if a.major != b.major: return a.major < b.major
    if a.minor != b.minor: return a.minor < b.minor
    if a.patch != b.patch: return a.patch < b.patch
    if a.pre == b.pre: return false
    if #len(a.pre) == 0: return false
    if #len(b.pre) == 0: return true
    ref []string8 x = strings.split(a.pre, ".")
    ref []string8 y = strings.split(b.pre, ".")
    i64 n = #len(x) if #len(x) < #len(y) else #len(y)
    for i in 0..<n:
        if x[i] == y[i]: continue
        bool xn = all_digits(x[i])
        bool yn = all_digits(y[i])
        if xn && yn:
            if #len(x[i]) != #len(y[i]): return #len(x[i]) < #len(y[i])
            return strings.compare(x[i], y[i]) < 0
        if xn != yn: return xn
        return strings.compare(x[i], y[i]) < 0
    return #len(x) < #len(y)

private bool all_digits(string8 s):
    if #len(s) == 0: return false
    for i in 0..<#len(s):
        if s[i] < '0' || s[i] > '9': return false
    return true

// The version a release takes: `answer` is a version (newer than `current`),
// or `patch`, `minor` or `major` to bump `current` (a first release, with
// `current` "", bumps from 0.0.0). Bumping a pre-release releases it when the
// bump is no bigger than it (`1.3.0-rc.2` + minor is `1.3.0`), as npm does.
// "" for `answer` is `patch` (the prompt offers `minor` for a first release
// itself). Only the whole words are taken: `m` could be minor or major. `why`
// is set when the answer cannot be taken.
(string8 next, string8 why) next_version(string8 current, string8 answer):
    SemVer cur
    if #len(current) > 0:
        (SemVer c, bool good) = parse_semver(current)
        if !good:
            return ("", txt(#format("the current version `", current, "` is not semver; type the next one in full, like 1.0.0")))
        cur = c
    string8 a = strings.trim(answer)
    if #len(a) == 0: a = "patch"
    string8 low = txt(strings.to_lower(a))
    SemVer v = cur
    bool pre = #len(cur.pre) > 0
    v.pre = ""
    if low == "patch":
        if !pre: v.patch += 1
    else if low == "minor":
        if !(pre && cur.patch == 0):
            v.minor += 1
            v.patch = 0
    else if low == "major":
        if !(pre && cur.patch == 0 && cur.minor == 0):
            v.major += 1
            v.minor = 0
            v.patch = 0
    else:
        (SemVer typed, bool good) = parse_semver(a)
        if !good:
            return ("", txt(#format("`", a, "` is not a version (like 1.4.2) or one of patch, minor, major")))
        if #len(current) > 0 && !semver_less(cur, typed):
            return ("", txt(#format(semver_text(typed), " is not newer than the current ", current)))
        return (semver_text(typed), "")
    return (semver_text(v), "")

// The newest semver tag among `tags` (one per line, as `git tag` prints
// them), without its `v`, or "". Tags that are not semver are passed over.
string8 newest_semver_tag(string8 tags):
    SemVer best
    bool any = false
    for t in lines_of(tags):
        (SemVer v, bool good) = parse_semver(strings.trim(t))
        if !good: continue
        if !any || semver_less(best, v):
            best = v
            any = true
    return semver_text(best) if any else ""

// The tag among `tags` (one per line) that `asked` names, and the version a
// pin records for it. `asked` "" is the newest release: the newest semver tag
// that is not a pre-release. A semver `asked` (`v` optional) is the tag of
// that version, spelt as typed if there is one, else with or without a `v`;
// anything else is a tag by its exact name. The version is the semver one
// without its `v`, or the tag's name when it is not semver. ("", "") when no
// tag fits.
(string8 tag, string8 version) resolve_tag(string8 tags, string8 asked):
    string8 want = strings.trim(asked)
    if #len(want) == 0:
        SemVer best
        string8 best_tag = ""
        for t in lines_of(tags):
            (SemVer v, bool good) = parse_semver(t)
            if !good || #len(v.pre) > 0: continue
            if #len(best_tag) == 0 || semver_less(best, v) || (!semver_less(v, best) && t[0] == 'v'):
                best = v
                best_tag = t
        if #len(best_tag) == 0: return ("", "")
        return (best_tag, semver_text(best))
    (SemVer w, bool semver) = parse_semver(want)
    if has_tag(tags, want):
        return (want, semver_text(w) if semver else want)
    if !semver: return ("", "")
    string8 text = semver_text(w)
    for t in [txt(#format("v", text)), text]:
        if has_tag(tags, t): return (t, text)
    return ("", "")

// The commit tag `tag` names in `git ls-remote --tags` output: its peeled
// (`^{}`) line's for an annotated tag, else its own line's; "" when absent.
string8 remote_tag_commit(string8 listing, string8 tag):
    string8 plain = ""
    string8 want = txt(#format("refs/tags/", tag))
    string8 peeled = txt(#format(want, "^{}"))
    for l in all_lines(listing):
        (string8 sha, string8 ref_name, bool tab) = strings.split_first(l, "\t")
        if !tab: continue
        string8 r = strings.trim(ref_name)
        if r == peeled: return strings.trim(sha)
        if r == want: plain = strings.trim(sha)
    return plain

// The tag to restore a pin of `version` at `commit` from, given `git
// ls-remote --tags` output: of the tags that name the version (`1.4.2` and
// `v1.4.2` may both), the one at `commit`; otherwise `resolve_tag`'s, which a
// restore then finds moved; "" when no tag names it.
string8 restore_tag(string8 listing, string8 version, string8 commit):
    string8 names = remote_tag_names(listing)
    ref []string8 candidates = #make([]string8, 0)
    _ = #append(candidates, version)
    (SemVer v, bool semver) = parse_semver(version)
    if semver:
        _ = #append(candidates, txt(#format("v", semver_text(v))))
        _ = #append(candidates, semver_text(v))
    for c in candidates:
        if has_tag(names, c) && remote_tag_commit(listing, c) == commit: return c
    (string8 tag, string8 _) = resolve_tag(names, version)
    return tag

// One file of a vendored library, fed to the content hash `hash` its pin
// records. The recipe, which every build and `dado get` compute alike:
//
//   * every regular file under the library's folder, hidden ones included,
//     by its path relative to the folder with `/` between parts, in byte
//     order of those paths; but none with a part named `.git…` (`.gitignore`,
//     `.gitattributes`, `.github/`: not vendored at all, `vendored_skips`).
//     A symbolic link anywhere under the folder leaves it without a hash;
//     the copy is refused;
//   * for each, into one SHA-256: the path's bytes, a 0 byte, the length of
//     the content below as decimal ASCII digits, a 0 byte, then the content:
//     the file's bytes with every CR LF pair written as LF, so a checkout
//     that converted line endings (git's `core.autocrlf` on Windows) hashes
//     the same;
//   * the digest as 64 lowercase hex digits.
void hash_vendored_file(^hash.Sha256 h, string8 rel, string8 bytes):
    string8 content = bytes
    if strings.contains(bytes, "\r\n"): content = txt(strings.replace(bytes, "\r\n", "\n"))
    h.update_text(rel)
    h.update_text("\x00")
    h.update_text(txt(#format(#len(content))))
    h.update_text("\x00")
    h.update_text(content)

// The finished digest of a vendored library's hash, as `hash` holds it.
string8 vendored_digest(^hash.Sha256 h):
    hash.Sha256Digest d = h.finish()
    return txt(hash.hex(d))

// `what` from `dado get <what>`: a name or an address, and what follows its
// last `@` when that is a version (`Clipper2@1.4.2`, `https://h/o/r@v2`),
// not part of the address (`git@host:o/r`, whose `@` is followed by a `:`
// and a `/`).
(string8 target, string8 version, bool has_version) split_get_arg(string8 what):
    i64 at = strings.last_index_of(what, '@')
    if at <= 0: return (what, "", false)
    string8 after = what[at + 1..<#len(what)]
    if strings.contains(after, "/") || strings.contains(after, ":") || strings.contains(after, "\\"):
        return (what, "", false)
    return (what[0..<at], after, true)

// Whether `target` is an address (`dado get <url>`) rather than a name: a
// name holds no `/`, `\` or `:`.
bool looks_like_url(string8 target):
    return strings.contains(target, "/") || strings.contains(target, ":") || strings.contains(target, "\\")

// The name a library fetched by address goes under: the address's last part,
// without `.git` (`https://github.com/o/Clipper2.git` is `Clipper2`).
string8 url_library_name(string8 url):
    string8 u = strings.trim_suffix(strings.trim_suffix(public_url(url), "/"), "\\")
    string8 last = u
    for sep in ['/', '\\', ':']:
        i64 at = strings.last_index_of(last, sep)
        if at >= 0: last = last[at + 1..<#len(last)]
    return strings.trim_suffix(last, ".git")

// `xs` sorted by byte, in place.
void sort_texts([]string8 xs):
    for i in 1..<#len(xs):
        i64 j = i
        for j > 0 && strings.compare(xs[j - 1], xs[j]) > 0:
            string8 t = xs[j]
            xs[j] = xs[j - 1]
            xs[j - 1] = t
            j -= 1

// The tag names in `git ls-remote --tags` output (`<sha>\trefs/tags/<name>`,
// and `<name>^{}` for an annotated tag's commit), one per line.
string8 remote_tag_names(string8 listing):
    strings.Builder b = strings.builder(128)
    for l in all_lines(listing):
        (string8 _, string8 ref_name, bool tab) = strings.split_first(l, "\t")
        if !tab: continue
        string8 r = strings.trim(ref_name)
        if !strings.starts_with(r, "refs/tags/"): continue
        string8 name = strings.trim_suffix(r[10..<#len(r)], "^{}")
        _ = strings.append(&b, name)
        _ = strings.append(&b, "\n")
    return strings.text(b)

// Whether the line-per-tag `tags` holds `tag`.
bool has_tag(string8 tags, string8 tag):
    for l in all_lines(tags):
        if strings.trim(l) == tag: return true
    return false

// ── repositories ────────────────────────────────────────────────────────────

// A remote's URL as the HTTPS address anyone can fetch: `git@host:o/r.git`
// and `ssh://git@host/o/r.git` become `https://host/o/r`, and on an http(s)
// address a trailing `.git` or `/` goes. A path on this machine, or a
// `file://` one, keeps its `.git`: there the name is the directory's own, and
// cutting it names a directory that is not there.
string8 public_url(string8 remote):
    string8 u = strings.trim(remote)
    if strings.starts_with(u, "ssh://"):
        u = u[6..<#len(u)]
        (string8 _, string8 after, bool had_user) = strings.split_first(u, "@")
        if had_user: u = after
        u = txt(#format("https://", u))
    else if !strings.contains(u, "://"):
        // git's own rule: `host:path` is the scp form only when no `/` comes
        // before the colon, so `/srv/r.git` and `C:\r` are paths.
        (string8 user_host, string8 path, bool colon) = strings.split_first(u, ":")
        if !colon || #len(path) == 0 || #len(user_host) < 2 || strings.contains(user_host, "/") || strings.contains(user_host, "\\"):
            return strings.trim_suffix(u, "/")
        (string8 _, string8 host, bool had_user) = strings.split_first(user_host, "@")
        if !had_user: host = user_host
        u = txt(#format("https://", host, "/", path))
    u = strings.trim_suffix(u, "/")
    if is_web_url(u): u = strings.trim_suffix(u, ".git")
    return u

// Whether two repository addresses name one repository: equal as
// `public_url`s, ignoring case (hosts are, and GitHub's paths are too).
bool same_repository(string8 a, string8 b):
    return strings.equal_fold(public_url(a), public_url(b))

// Whether `url` is an http(s) address with a host: what a user's `dado get`
// can fetch from anywhere, which a path or `file://` URL is not.
bool is_web_url(string8 url):
    string8 rest = ""
    if strings.starts_with(url, "https://"): rest = url[8..<#len(url)]
    else if strings.starts_with(url, "http://"): rest = url[7..<#len(url)]
    else: return false
    (string8 host, string8 _, bool _) = strings.split_first(rest, "/")
    return #len(host) > 0

// ── the README ──────────────────────────────────────────────────────────────

// The first paragraph under the README's `## Summary` (T62), joined onto one
// line, or "". The section ends at the next heading, so a summary left empty
// is "" rather than whatever paragraph follows it. HTML comments (a starter
// README's placeholder is one) are not text, on one line or over several;
// what is beside one on its line is. Fenced code is never the summary, and a
// fence ends the paragraph.
string8 readme_summary(string8 readme):
    ref []string8 lines = all_lines(readme)
    ref []bool code = fenced(lines[:])
    bool inside = false
    bool in_comment = false
    strings.Builder b = strings.builder(128)
    bool any = false
    for i in 0..<#len(lines):
        string8 l = strings.trim(lines[i])
        if !inside:
            if !code[i] && strings.equal_fold(l, "## Summary"): inside = true
            continue
        if code[i]:
            if any: break
            continue
        bool commented = in_comment
        (string8 text, bool still) = without_comments(l, in_comment)
        in_comment = still
        if !commented && strings.starts_with(l, "#"): break
        if #len(text) == 0:
            if any: break
            continue
        if any: _ = strings.append(&b, " ")
        _ = strings.append(&b, text)
        any = true
    return strings.text(b)

// `line` without its HTML comments, trimmed, given whether a comment was
// open as it starts; `open` is whether one is open at its end.
private (string8 text, bool open) without_comments(string8 line, bool open_at_start):
    strings.Builder b = strings.builder(64)
    string8 rest = line
    bool open = open_at_start
    for #len(rest) > 0:
        if open:
            i64 end = strings.find(rest, "-->")
            if end < 0: return (strings.trim(strings.text(b)), true)
            rest = rest[end + 3..<#len(rest)]
            open = false
            continue
        i64 start = strings.find(rest, "<!--")
        if start < 0:
            _ = strings.append(&b, rest)
            break
        _ = strings.append(&b, rest[0..<start])
        _ = strings.append(&b, " ")
        rest = rest[start + 4..<#len(rest)]
        open = true
    return (strings.trim(strings.text(b)), open)

// The README's markers (T62). `dado package` rewrites only the lines between
// each pair, and only when the README has them.
const string8 TESTS_OPEN = "<!-- dado:tests -->"
const string8 TESTS_CLOSE = "<!-- /dado:tests -->"
const string8 INSTALL_OPEN = "<!-- dado:install -->"
const string8 INSTALL_CLOSE = "<!-- /dado:install -->"

// The tests marker's text after a passing `dado test` on `platform`
// (`linux-x86_64`) with Dado `version`.
string8 tests_status(string8 platform, string8 version):
    return txt(#format("Tests: passing on ", platform, " with Dado ", version))

// The tests marker's text after a release made with `--no-test`.
string8 tests_not_run(string8 version):
    return txt(#format("Tests: not run for v", version))

// Whether the README `work` differs from `head`, its committed text, only
// inside the marker blocks, which `head` has: what a release may commit as
// its own. Any other edit is the author's, and is committed by the author.
bool readme_only_markers_changed(string8 head, string8 work):
    (string8 h, bool marked) = rewrite_markers(head, "\x01", "\x01")
    if !marked: return false
    (string8 w, bool _) = rewrite_markers(work, "\x01", "\x01")
    return h == w

// The install marker's text for the library `name`.
string8 install_status(string8 name):
    return txt(#format("`dado get ", name, "`"))

// `readme` with the lines between the tests markers replaced by the line
// `tests`, and those between the install markers by `install`; an empty
// text leaves its block as it is. Everything outside the markers is kept
// byte for byte, line endings included. `found` is false when the README has
// neither pair (each marker on a line of its own, outside fenced code).
(string8 text, bool found) rewrite_markers(string8 readme, string8 tests, string8 install):
    (string8 a, bool ft) = rewrite_marker(readme, TESTS_OPEN, TESTS_CLOSE, tests)
    (string8 b, bool fi) = rewrite_marker(a, INSTALL_OPEN, INSTALL_CLOSE, install)
    return (b, ft || fi)

// `text` with the lines between the first `open` line and the `close` line
// after it replaced by `body` (unchanged when `body` is ""); `found` false,
// and `text` unchanged, when there is no such pair.
private (string8 text, bool found) rewrite_marker(string8 text, string8 open, string8 close, string8 body):
    ref []string8 lines = all_lines(text)
    ref []bool code = fenced(lines[:])
    i64 from = -1
    i64 to = -1
    for i in 0..<#len(lines):
        if code[i]: continue
        string8 l = strings.trim(lines[i])
        if from < 0:
            if l == open: from = i
            continue
        if l == close:
            to = i
            break
    if from < 0 || to < 0: return (text, false)
    if #len(body) == 0: return (text, true)
    string8 nl = "\r\n" if strings.contains(text, "\r\n") else "\n"
    // The first byte after the open line, and the first of the close line.
    i64 start = line_start(text, from + 1)
    i64 end = line_start(text, to)
    return (txt(#format(text[0..<start], body, nl, text[end..<#len(text)])), true)

// The byte offset at which line `n` (from 0) of `text` starts.
private i64 line_start(string8 text, i64 n):
    i64 line = 0
    i64 i = 0
    for i < #len(text) && line < n:
        if text[i] == '\n': line += 1
        i += 1
    return i

// ── R24: a package fetches nothing of its own ───────────────────────────────

// The first line of `source` that imports through `lib:` or `imports:`, which
// a library may not (R24: it bundles what it needs and imports it by
// relative path), with its 1-based number; 0 when there is none.
(i64 line, string8 text) remote_import(string8 source):
    i64 n = 0
    for raw in all_lines(source):
        n += 1
        string8 l = strings.trim(raw)
        if !strings.starts_with(l, "import"): continue
        if strings.contains(l, "\"lib:") || strings.contains(l, "\"imports:"):
            return (n, l)
    return (0, "")

// Whether R24's scan passes over `rel`, a file's path relative to the
// library's root (either separator): the top-level `build/`, which `dado`
// writes, and anything under a `.git`.
bool r24_skips(string8 rel):
    ref []string8 parts = strings.split(txt(strings.replace(rel, "\\", "/")), "/")
    if #len(parts) > 1 && parts[0] == "build": return true
    for p in parts:
        if p == ".git": return true
    return false

// ── the index ───────────────────────────────────────────────────────────────

// One library's line in the index.
type IndexEntry:
    string8 name
    string8 url
    string8 description
    string8 category

private const string8 DASH = " — "

// The index line for a library.
string8 index_line(string8 name, string8 url, string8 description):
    string8 d = strings.trim(description)
    return txt(#format("- [", name, "](", url, ")", DASH, d))

// Why the index line for `name`, `url` and `description` would not read back
// as the same three, or "": what the index's lint would refuse, caught before
// a release is tagged with them.
string8 index_line_refusal(string8 name, string8 url, string8 description):
    string8 d = strings.trim(description)
    if #len(d) == 0: return "the description is empty"
    (IndexEntry e, bool ok) = parse_index_line(index_line(name, url, description))
    if !ok || e.name != name || e.url != url || strings.trim(e.description) != d:
        return txt(#format("the index line for `", name, "` (", url, ") would not read back as written: keep `name` to letters, digits, `-` and `_`, and `repository` to a plain https:// address"))
    return ""

// `line` read as an index entry: `ok` only for the exact form.
(IndexEntry e, bool ok) parse_index_line(string8 line):
    IndexEntry e
    string8 l = strings.trim_right_cr(line)
    if !strings.starts_with(l, "- ["): return (e, false)
    (string8 name, string8 rest, bool closed) = strings.split_first(l[3..<#len(l)], "](")
    if !closed || #len(name) == 0: return (e, false)
    (string8 url, string8 tail, bool ended) = strings.split_first(rest, ")")
    if !ended || #len(url) == 0 || strings.contains(url, " "): return (e, false)
    string8 bad_url = url_refusal(url)
    if #len(bad_url) > 0: return (e, false)
    if !strings.starts_with(tail, DASH): return (e, false)
    string8 d = tail[#len(DASH)..<#len(tail)]
    string8 dt = strings.trim(d)
    if #len(dt) == 0: return (e, false)
    string8 refusal = library_name_refusal(name)
    if #len(refusal) > 0: return (e, false)
    e.name = name
    e.url = url
    e.description = d
    return (e, true)

// Which of `lines` are inside a fenced code block (``` or ~~~), the fences
// included. A fenced example of an entry or a `## ` heading is prose: it is
// never read as the index, and an insertion never lands in it.
//
// As CommonMark has it: a fence is three or more of one of the characters;
// the block closes at a line of only that character, at least as many of it
// as opened it (and nothing else on the line), so a four-backtick fence can
// hold a three-backtick example, and `~~~` never closes a backtick block.
ref []bool fenced([]string8 lines):
    ref []bool out = #make([]bool, 0)
    char8 open = ' '
    i64 width = 0
    for l in lines:
        string8 t = strings.trim(l)
        i64 run = fence_run(t)
        if width == 0:
            if run >= 3:
                open = t[0]
                width = run
            _ = #append(out, run >= 3)
            continue
        if run >= width && t[0] == open && run == #len(t): width = 0
        _ = #append(out, true)
    return out

// How many of `t`'s first character, a backtick or `~`, it starts with.
private i64 fence_run(string8 t):
    if #len(t) == 0 || (t[0] != '`' && t[0] != '~'): return 0
    i64 n = 0
    for n < #len(t) && t[n] == t[0]:
        n += 1
    return n

// Every entry in `index`, each with the `## ` heading it is under.
ref []IndexEntry index_entries(string8 index):
    ref []IndexEntry out = #make([]IndexEntry, 0)
    string8 category = ""
    ref []string8 lines = all_lines(index)
    ref []bool code = fenced(lines[:])
    for i in 0..<#len(lines):
        string8 l = lines[i]
        if code[i]: continue
        if strings.starts_with(l, "## "):
            category = strings.trim(l[3..<#len(l)])
            continue
        (IndexEntry e, bool ok) = parse_index_line(l)
        if !ok: continue
        e.category = category
        _ = #append(out, e)
    return out

// The entry named `name`, case-insensitively (T59).
(IndexEntry e, bool found) index_find(string8 index, string8 name):
    for e in index_entries(index):
        if strings.equal_fold(e.name, name): return (e, true)
    IndexEntry none
    return (none, false)

// The `## ` headings in `index`, in order, but `Unmaintained` (T51).
ref []string8 index_categories(string8 index):
    ref []string8 out = #make([]string8, 0)
    ref []string8 lines = all_lines(index)
    ref []bool code = fenced(lines[:])
    for i in 0..<#len(lines):
        string8 l = lines[i]
        if code[i] || !strings.starts_with(l, "## "): continue
        string8 c = strings.trim(l[3..<#len(l)])
        if strings.equal_fold(c, "Unmaintained"): continue
        _ = #append(out, c)
    return out

// Why `category` cannot head a new listing, or "": it is a short heading's
// text, and never `Unmaintained`, where only the index's maintainers move a
// library (T51).
string8 category_refusal(string8 category):
    string8 c = strings.trim(category)
    if #len(c) == 0: return "the category is empty"
    if strings.equal_fold(c, "Unmaintained"):
        return "`Unmaintained` is where the index's maintainers move abandoned libraries; a new listing goes under another heading"
    if #len(c) > 40: return txt(#format("`", c, "` is longer than 40 characters"))
    if strings.contains(c, "\n") || strings.starts_with(c, "#"):
        return txt(#format("`", c, "` is not a heading's text"))
    return ""

// `category` as the index already spells it (`geometry` is `Geometry`), or
// trimmed when it is a new heading.
string8 index_heading(string8 index, string8 category):
    string8 c = strings.trim(category)
    for h in index_categories(index):
        if strings.equal_fold(h, c): return h
    return c

// `index` with `line` (an entry named `name`) added under `## category`, in
// its sorted place by name, case-insensitively. A heading that does not exist
// yet is added after the last one, before `## Unmaintained` if that is
// there, or at the end. Fenced code blocks are passed over (`fenced`).
string8 index_insert(string8 index, string8 category, string8 name, string8 line):
    ref []string8 lines = all_lines(index)
    ref []bool code = fenced(lines[:])
    i64 at = -1
    i64 heading = -1
    for i in 0..<#len(lines):
        string8 l = lines[i]
        if code[i] || !strings.starts_with(l, "## "): continue
        if strings.equal_fold(strings.trim(l[3..<#len(l)]), category):
            heading = i
            break
    if heading >= 0:
        // Past the heading: before the first entry whose name sorts after
        // ours, else after the section's last entry.
        i64 last_entry = heading
        for i in (heading + 1)..<#len(lines):
            string8 l = lines[i]
            if code[i]: continue
            if strings.starts_with(l, "## "): break
            (IndexEntry e, bool ok) = parse_index_line(l)
            if !ok: continue
            if strings.compare(txt(strings.to_lower(e.name)), txt(strings.to_lower(name))) > 0:
                at = i
                break
            last_entry = i
        if at < 0:
            at = last_entry + 1
            if last_entry == heading:
                // An empty section: under the heading, past one blank line.
                at = heading + 1
                if at < #len(lines) && is_blank(lines[at]):
                    at += 1
                // Whatever follows (a heading, prose, a fence) keeps a
                // blank line between it and the entry.
                if at < #len(lines) && !is_blank(lines[at]):
                    return join_lines_with(lines[:], at, line, "")
        return join_lines_with(lines[:], at, line)
    // A new section.
    i64 before = #len(lines)
    for i in 0..<#len(lines):
        string8 l = lines[i]
        if !code[i] && strings.starts_with(l, "## ") && strings.equal_fold(strings.trim(l[3..<#len(l)]), "Unmaintained"):
            before = i
            break
    // Trim blank lines before the insertion point, then write the section
    // with one blank line around it.
    i64 cut = before
    for cut > 0 && is_blank(lines[cut - 1]):
        cut -= 1
    ref []string8 section = #make([]string8, 0)
    if cut > 0: _ = #append(section, "")
    _ = #append(section, txt(#format("## ", category)))
    _ = #append(section, "")
    _ = #append(section, line)
    if before < #len(lines): _ = #append(section, "")
    ref []string8 head = #make([]string8, 0)
    for i in 0..<cut:
        _ = #append(head, lines[i])
    for s in section:
        _ = #append(head, s)
    for i in before..<#len(lines):
        _ = #append(head, lines[i])
    return join_lines_with(head[:], #len(head))

// Whether `l` is empty or only spaces.
private bool is_blank(string8 l):
    string8 t = strings.trim(l)
    return #len(t) == 0

// `text`'s lines as written, blank ones kept, without their newlines (or a
// `\r` before one). A final newline ends the last line rather than starting
// an empty one.
ref []string8 all_lines(string8 text):
    ref []string8 out = #make([]string8, 0)
    string8 rest = text
    for #len(rest) > 0:
        (string8 l, string8 tail, bool more) = strings.line(rest)
        _ = #append(out, strings.trim_right_cr(l))
        if !more: break
        rest = tail
    return out

// `lines` joined with newlines and ending in one, with `extra` inserted
// before line `at`.
private string8 join_lines_with([]string8 lines, i64 at, ..string8 extra):
    strings.Builder b = strings.builder(256)
    for i in 0..<#len(lines):
        if i == at:
            for x in extra:
                _ = strings.append(&b, x)
                _ = strings.append(&b, "\n")
        _ = strings.append(&b, lines[i])
        _ = strings.append(&b, "\n")
    if at >= #len(lines):
        for x in extra:
            _ = strings.append(&b, x)
            _ = strings.append(&b, "\n")
    return strings.text(b)
