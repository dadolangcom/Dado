@test
// The pure logic of the documentation and query verbs: reading the
// lexicon's codes, `search`'s matching and ranking, the JSON each verb
// prints, the stamp and how `doc --check` sees past it, a code's page, a
// package page's summary, and when `new` refuses.
//
// What is not here, and is exercised by running the driver instead: every
// verb end to end (they start `dadoc` and the doc tool), `doc --check` and
// `--write` over the real `docs/`, and `new` writing files.
package driver

import "core:mem/arena"
import "core:mem/libc"
import "core:strings"

private bool same(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is `", got, "`, not `", want, "`")

private const string8 LEXICON = "category\tlayout\ncode\tERR0301\tprogram\ta program needs an entry point, and it lives in the main package\tprogram has no 'main' function\terror\ncode\tERR0102\tfile\tindentation is spaces; a tab in it is refused rather than given a width\ttab used in indentation\terror\ncode\tshort\nquery\t#OS\tos\n"

private bool codes_read():
    bool ok = true
    ref []CodeRow codes = parse_codes(LEXICON)
    ok = #expect(#len(codes) == 2, "the lexicon holds ", #len(codes), " codes, not 2 (a short row is skipped)") && ok
    if #len(codes) != 2: return false
    ok = same(codes[0].code, "ERR0301", "the first code") && ok
    ok = same(codes[0].scope, "program", "its scope") && ok
    ok = same(codes[0].title, "program has no 'main' function", "its title") && ok
    ok = same(codes[0].class, "error", "its class") && ok
    (CodeRow r, bool found) = code_named(codes[:], "err0102")
    ok = #expect(found && r.code == "ERR0102", "a code in lower case was not found") && ok
    (CodeRow _, bool none) = code_named(codes[:], "ERR9999")
    ok = #expect(!none, "a code that does not exist was found") && ok
    ok = #expect(strings.contains(no_such_code(codes[:], "ERR0103"), "did you mean `ERR0102`"), "no nearest code: ", no_such_code(codes[:], "ERR0103")) && ok
    return ok

private bool matching():
    bool ok = true
    ok = #expect(has_word("program has no 'main' function", "main"), "`main` inside quotes is a word") && ok
    ok = #expect(!has_word("cannot be read", "no"), "`no` was found inside `cannot`") && ok
    ok = #expect(!has_word("nobody reads it", "no"), "`no` was found at the start of `nobody`") && ok
    ok = #expect(has_word("the allocator", "alloc"), "a long word did not find its longer form") && ok
    ok = #expect(!has_word("realloc", "alloc"), "`alloc` was found inside `realloc`") && ok
    ref []string8 words = words_of("no main")
    ok = #expect(has_all("main has no entry", words[:]), "words in another order did not match") && ok
    ok = #expect(!has_all("main entry", words[:]), "a missing word matched") && ok
    ok = same(folded("ERR0301 Tab"), "err0301 tab", "folded") && ok
    ok = same(upper("err0301"), "ERR0301", "upper") && ok
    return ok

private bool ranking():
    bool ok = true
    ref []CodeRow codes = parse_codes(LEXICON)
    ref []string8 tab = words_of("tab")
    ref []string8 exact = words_of("err0301")
    ok = #expect(code_score("err0301", exact[:], codes[0]) == 1000, "an exact code is not first") && ok
    ok = #expect(code_score("tab", tab[:], codes[1]) == 300, "a title holding the term scores ", code_score("tab", tab[:], codes[1])) && ok
    ok = #expect(code_score("tab", tab[:], codes[0]) == 0, "a code without the term scored") && ok
    ok = #expect(line_score("tab", tab[:], "## A tab") > line_score("tab", tab[:], "a tab"), "a heading does not outrank body text") && ok
    Hit h = page_hit("tab", tab[:], txt(#format("docs/x", MD)), "# Spaces\n\nno match here\na tab, and\nanother tab\n")
    ok = #expect(h.score == 42 && h.line == 4 && h.matches == 2, "the page hit is score ", h.score, " line ", h.line, " matches ", h.matches) && ok
    ok = same(h.title, "Spaces", "the page's title") && ok
    ok = same(hit_line(h), txt(#format("docs/x", MD, ":4  a tab, and")), "a page's line") && ok
    ref []Hit hits = #make([]Hit, 0)
    Hit a
    a.id = "b"
    a.score = 10
    Hit b
    b.id = "a"
    b.score = 10
    Hit c
    c.id = "z"
    c.score = 50
    _ = #append(hits, a)
    _ = #append(hits, b)
    _ = #append(hits, c)
    rank(hits[:])
    ok = same(txt(#format(hits[0].id, hits[1].id, hits[2].id)), "zab", "the ranked order") && ok
    return ok

private bool shapes():
    bool ok = true
    ok = same(json_quote("a\"b\\c\nd"), "\"a\\\"b\\\\c\\nd\"", "a quoted string") && ok
    ok = same(error_json("explain", "no such code"), "{\"query\": \"explain\", \"error\": \"no such code\"}", "the error object") && ok
    ref []CodeRow codes = parse_codes(LEXICON)
    ok = same(explain_json(codes[1], "page\n"), "{\"query\": \"explain\", \"code\": \"ERR0102\", \"title\": \"tab used in indentation\", \"class\": \"error\", \"scope\": \"file\", \"rule\": \"indentation is spaces; a tab in it is refused rather than given a width\", \"text\": \"page\\n\"}", "explain's object") && ok
    ok = same(lexicon_json("category\tlayout\nquery\t#OS\tos\n"), "{\"query\": \"lexicon\", \"rows\": [[\"category\", \"layout\"], [\"query\", \"#OS\", \"os\"]]}", "lexicon's object") && ok
    Hit h
    h.kind = "code"
    h.id = "ERR0301"
    h.title = "t"
    h.text = "r"
    h.score = 150
    ok = same(hit_json(h), "{\"kind\": \"code\", \"id\": \"ERR0301\", \"title\": \"t\", \"line\": 0, \"text\": \"r\", \"matches\": 0, \"score\": 150}", "a search hit") && ok
    return ok

private bool stamps():
    bool ok = true
    string8 stamp = stamp_of("dadoc 1.0.0+abc\ncommit abc\nbuilt  2026-10-04\n")
    ok = same(stamp, "<!-- dadoc 1.0.0+abc -->\n<!-- commit abc -->\n", "the stamp") && ok
    ok = same(unstamped(txt(#format(stamp, "# page\n"))), "# page\n", "a page without its stamp") && ok
    string8 other = stamp_of("dadoc 1.0.1+def\ncommit def\n")
    ok = #expect(unstamped(txt(#format(stamp, "# page\n"))) == unstamped(txt(#format(other, "# page\n"))), "two stamps of one page compare different") && ok
    ok = same(unstamped("<!-- Generated by `dado doc reference` -->\nx\n"), "<!-- Generated by `dado doc reference` -->\nx\n", "an unstamped page") && ok
    return ok

private bool pages():
    bool ok = true
    string8 explain = "ERR0301: program has no 'main' function\n  class: error — an error, always\n  rule: a program needs an entry point\n  A diagnostic with this code names what was written.\n"
    ok = same(code_markdown(explain), "# ERR0301: program has no 'main' function\n\n* class: error — an error, always\n* rule: a program needs an entry point\n\nA diagnostic with this code names what was written.\n", "a code's page") && ok
    ok = same(page_summary("<!-- dadoc x -->\n<!-- commit y -->\n# core:path\n\ncore:path — paths, as text.\n\nMore.\n"), "paths, as text.", "a summary") && ok
    ok = same(page_summary("# app:body2d\n\napp:body2d — an axis-aligned box swept against\n"), "an axis-aligned box swept against…", "a summary cut mid-sentence") && ok
    ok = same(page_summary("# x\n\n## Declarations\n"), "", "a page with no comment") && ok
    ok = same(address_of("core/os/fs"), "core:os/fs", "an address") && ok
    ok = same(cell("a|b"), "a\\|b", "a table cell") && ok
    ref []string8 rels = #make([]string8, 0)
    _ = #append(rels, "app/ui")
    _ = #append(rels, "core/path")
    ref []string8 sums = #make([]string8, 0)
    _ = #append(sums, "a UI.")
    _ = #append(sums, "")
    string8 index = packages_index(rels[:], sums[:])
    ok = #expect(strings.contains(index, txt(#format("\n## app\n\n* [app:ui](app/ui", MD, ") — a UI.\n\n## core\n\n* [core:path](core/path", MD, ")\n"))), "the packages index: ", index) && ok
    return ok

private bool refusals():
    bool ok = true
    ok = same(new_refusal("hello", "", 0), "", "a new name") && ok
    ok = same(new_refusal("hello", "dir", 0), "", "an empty directory") && ok
    ok = #expect(strings.contains(new_refusal("hello", "dir", 1), "1 entry in it"), "a directory holding one entry") && ok
    ok = #expect(strings.contains(new_refusal("hello", "dir", 3), "3 entries"), "a directory holding three") && ok
    ok = #expect(strings.contains(new_refusal("hello", "file", 0), "already a file"), "a file") && ok
    ok = #expect(strings.contains(new_refusal("a/b", "", 0), "is a path"), "a path") && ok
    ok = #expect(strings.contains(new_refusal("", "", 0), "no name"), "no name") && ok
    ok = #expect(strings.contains(new_refusal(".x", "", 0), "cannot start"), "a hidden name") && ok
    ok = #expect(strings.contains(new_refusal("-x", "", 0), "cannot start"), "a flag-like name") && ok
    ok = #expect(strings.starts_with(new_main("hi"), "package main\n") && strings.contains(new_main("hi"), "hello from hi"), "the program") && ok
    ok = #expect(strings.contains(new_agents("hi"), "`dado check hi` after each edit"), txt(#format("the AGENTS", MD))) && ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = codes_read()
        ok = matching() && ok
        ok = ranking() && ok
        ok = shapes() && ok
        ok = stamps() && ok
        ok = pages() && ok
        ok = refusals() && ok
        if ok: return 0
        return 1
