@test
// The pure logic of install, editors and uninstall: the journal's lines and
// the order uninstall takes them back in, a PATH entry taken out of a Windows
// PATH, the line each shell is told, the extension's id, finding editors over
// a fake tree and choosing among them, a marked block, and the reversals
// themselves over a fake home.
//
// What is not here, and is exercised by installing into a temp home instead:
// the bootstrap, building the tools and the engine, and running an editor's
// own command.
package driver

import "core:mem/arena"
import "core:mem/libc"
import "core:os/fs"
import "core:strings"

private bool same(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is `", got, "`, not `", want, "`")

private bool put(string8 file, string8 text):
    try fs.write_file(file, text) else:
        return false
    return true

private string8 temp(string8 prefix):
    try ref []char8 made = fs.make_temp_dir(prefix) else:
        return ""
    return txt(made)

private bool mkdir(string8 d):
    return fs.make_dirs(d, #default)

private bool runnable(string8 file):
    if !put(file, "#!/bin/sh\n"): return false
    ref []char8 c = strings.clone_to_cstring(file, #default)
    return fs.make_executable(cstring(c))

// ── the journal ─────────────────────────────────────────────────────────────

private bool journals_read():
    bool ok = true
    ref []Record rs = parse_journal("begin\t1.0.0\nmkdir\t/h/.local\n\nsymlink\t/h/.local/bin/dado\t/i/bin/dado\nvscode\t/usr/bin/code\tdado-lang.dado-lang\nmystery\ta\n")
    ok = #expect(#len(rs) == 5, "5 records, not ", #len(rs)) && ok
    ok = same(rs[2].kind, "symlink", "the third record's kind") && ok
    ok = #expect(#len(rs[2].fields) == 2, "a symlink record has 2 fields, not ", #len(rs[2].fields)) && ok
    ok = same(rs[2].fields[1], "/i/bin/dado", "the link's target") && ok
    ok = same(rs[4].kind, "mystery", "a kind this version does not know, kept") && ok
    ok = same(record_line("file", fields2("/a\tb", "c\nd")), "file\t/a b\tc d", "a record whose fields hold a tab and a newline") && ok
    ok = #expect(journal_has(rs[:], "mkdir\t/h/.local"), "journal_has missed a line") && ok
    ok = #expect(!journal_has(rs[:], "mkdir\t/h"), "journal_has found a line that is not there") && ok
    return ok

private bool reversed_lifo():
    bool ok = true
    ref []Record rs = parse_journal("begin\t1.0.0\nmkdir\t/h/.local\nmkdir\t/h/.local/bin\nsymlink\t/h/.local/bin/dado\t/i/bin/dado\nupdate\ta\tb\nbegin\t1.0.0\nsymlink\t/h/.local/bin/dado\t/i/bin/dado\nvscode\tcode\tx.y\ndone\t1.0.0\n")
    ref []Record plan = reversal_plan(rs[:])
    ref []string8 order = #make([]string8, 0)
    for r in plan:
        _ = #append(order, txt(#format(r.kind, " ", r.fields[0])))
    ref []char8 j = strings.join(order[:], ", ")
    ok = same(txt(j), "vscode code, symlink /h/.local/bin/dado, mkdir /h/.local/bin, mkdir /h/.local", "the reversal plan (last first, bookkeeping skipped, a repeat undone once)") && ok
    ok = #expect(journal_done(rs[:]), "a journal ending in done is done") && ok
    ref []Record cut = parse_journal("begin\t1.0.0\nmkdir\t/x\ndone\t1.0.0\nbegin\t1.0.1\nmkdir\t/y\n")
    ok = #expect(!journal_done(cut[:]), "a bootstrap begun again after done, and not finished, is not done") && ok
    return ok

private bool journal_written():
    bool ok = true
    string8 dir = temp("dado-journal-test")
    if #len(dir) == 0: return #expect(false, "no temp directory")
    ok = put(journal_path(dir), "begin\t1.0.0") && ok
    journal1(dir, "mkdir", "/h/.local")
    journal2(dir, "symlink", "/h/.local/bin/dado", "/i/bin/dado")
    ok = same(read_or_empty(journal_path(dir)), "begin\t1.0.0\nmkdir\t/h/.local\nsymlink\t/h/.local/bin/dado\t/i/bin/dado\n", "the journal after two appends to one without a final newline") && ok
    ref []Record back = read_journal(dir)
    ok = #expect(#len(back) == 3, "3 records read back, not ", #len(back)) && ok
    try fs.remove_all(dir) else:
        return ok
    return ok

// ── PATH ────────────────────────────────────────────────────────────────────

private bool windows_paths():
    bool ok = true
    string8 v = "C:\\Windows;C:\\Users\\a\\dado\\bin;D:\\tools;c:\\users\\A\\Dado\\bin\\;;E:\\x"
    (string8 left, bool removed) = without_path_entry(v, "C:\\Users\\a\\dado\\bin")
    ok = #expect(removed, "our entry was not found") && ok
    ok = same(left, "C:\\Windows;D:\\tools;;E:\\x", "the PATH without our entry (any case, a trailing \\), the rest exactly kept") && ok
    (string8 same_v, bool none) = without_path_entry("C:\\a;C:\\b", "C:\\Users\\a\\dado\\bin")
    ok = #expect(!none, "an entry that is not there was removed") && ok
    ok = same(same_v, "C:\\a;C:\\b", "a PATH without our entry, untouched") && ok
    (string8 near, bool _) = without_path_entry("C:\\Users\\a\\dado\\bin2;C:\\Users\\a\\dado", "C:\\Users\\a\\dado\\bin")
    ok = same(near, "C:\\Users\\a\\dado\\bin2;C:\\Users\\a\\dado", "entries that only begin like ours") && ok
    ok = #expect(has_path_entry(v, "C:\\USERS\\A\\DADO\\BIN"), "has_path_entry ignores case") && ok
    ok = #expect(!has_path_entry("", "C:\\x"), "an empty PATH has no entries") && ok
    ok = same(with_path_entry("", "C:\\d\\bin"), "C:\\d\\bin", "an entry added to an empty PATH") && ok
    ok = same(with_path_entry("C:\\a;", "C:\\d\\bin"), "C:\\a;C:\\d\\bin", "an entry added after a trailing ;") && ok
    ok = same(with_path_entry("C:\\a", "C:\\d\\bin"), "C:\\a;C:\\d\\bin", "an entry added") && ok
    return ok

private bool shells_told():
    bool ok = true
    string8 e = "echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> "
    ok = same(path_line("/bin/zsh", false), txt(#format(e, "~/.zshrc")), "zsh") && ok
    ok = same(path_line("/usr/bin/bash", false), txt(#format(e, "~/.bashrc")), "bash on Linux") && ok
    ok = same(path_line("/bin/bash", true), txt(#format(e, "~/.bash_profile")), "bash on macOS") && ok
    ok = same(path_line("/usr/local/bin/fish", true), "fish_add_path ~/.local/bin", "fish") && ok
    ok = same(path_line("/bin/dash", false), txt(#format(e, "~/.profile")), "another shell") && ok
    ok = same(path_line("", false), txt(#format(e, "~/.profile")), "no SHELL") && ok
    ok = #expect(dir_on_path("/usr/bin:/h/.local/bin/:/bin", "/h/.local/bin"), "a PATH entry with a trailing /") && ok
    ok = #expect(!dir_on_path("/usr/bin:/h/.local/binx", "/h/.local/bin"), "an entry that only begins like it") && ok
    ok = #expect(!dir_on_path("", "/h/.local/bin"), "an empty PATH") && ok
    ok = #expect(points_into("/i/bin/dado", "/i") && points_into("/i", "/i"), "a target inside the install") && ok
    ok = #expect(!points_into("/i2/dadoc", "/i") && !points_into("/other/dadoc", "/i"), "a target outside it") && ok
    return ok

// ── the extension's id ──────────────────────────────────────────────────────

private bool ids_read():
    bool ok = true
    string8 pj = "{\n  \"name\": \"dado-lang\",\n  \"displayName\": \"Dado \\\"lang\\\"\",\n  \"version\": \"0.2.0\",\n  \"contributes\": {\"languages\": [{\"id\": \"dado\", \"name\": \"inner\"}]},\n  \"publisher\": \"Dado-Lang\"\n}\n"
    ok = same(extension_id(pj), "dado-lang.dado-lang", "the id, publisher.name, lower-cased") && ok
    ok = same(json_top_string(pj, "version"), "0.2.0", "the version") && ok
    string8 nested = "{\"contributes\": {\"name\": \"inner\", \"publisher\": \"p\"}, \"publisher\": \"outer\"}"
    ok = same(json_top_string(nested, "name"), "", "a name only inside a nested object") && ok
    ok = same(extension_id(nested), "", "an id with no top-level name") && ok
    ok = same(json_top_string("{\"a\": \"x,y\", \"b\": \"z\"}", "b"), "z", "a key after a value holding a comma") && ok
    (string8 v, bool found) = extension_version(["ms-python.python@2024.1.0", "dado-lang.dado-lang@0.2.0"], "dado-lang.dado-lang")
    ok = #expect(found, "the extension was not found in --show-versions lines") && ok
    ok = same(v, "0.2.0", "its version") && ok
    return ok

// ── editors over a fake tree ────────────────────────────────────────────────

private string8 ids_of([]Found fs_):
    ref []string8 out = #make([]string8, 0)
    for f in fs_:
        _ = #append(out, f.e.id)
    ref []char8 j = strings.join(out[:], " ")
    return txt(j)

private bool editors_found():
    bool ok = true
    when #OS == #WINDOWS:
        return ok
    string8 t = temp("dado-editors-test")
    if #len(t) == 0: return #expect(false, "no temp directory")
    ok = mkdir(join3(t, "usr/share/code", "bin")) && ok
    ok = runnable(join3(t, "usr/share/code", "bin/code")) && ok
    ok = mkdir(join2(t, "bin")) && ok
    ok = runnable(join2(t, "bin/cursor")) && ok
    ok = runnable(join2(t, "bin/nvim")) && ok
    ok = put(join2(t, "bin/windsurf"), "not runnable\n") && ok
    ok = mkdir(join3(t, "home", ".claude/local")) && ok
    ok = runnable(join3(t, "home", ".claude/local/claude")) && ok
    Surroundings s
    s.path = txt(#format(join2(t, "nowhere"), ":", join2(t, "bin")))
    s.root = t
    s.home = join2(t, "home")
    s.local_app = ""
    s.program_files = ""
    ref []Editor known = known_editors()
    ref []Found found = detect_editors(known[:], s)
    ok = same(ids_of(found[:]), "vscode cursor claude-code neovim", "the editors found") && ok
    if #len(found) == 4:
        ok = same(found[0].cli, join3(t, "usr/share/code", "bin/code"), "VS Code, found where its installer puts it") && ok
        ok = same(found[1].how, "on PATH", "Cursor, found on PATH") && ok
        ok = same(found[3].cli, join2(t, "bin/nvim"), "Neovim's command") && ok
    ref []Found can = settable(found[:])
    ok = same(ids_of(can[:]), "vscode cursor claude-code", "what can be set up") && ok

    (ref []Found all, string8 m1, string8 w1) = choose_editors("all", known[:], found[:])
    ok = same(ids_of(all[:]), "vscode cursor claude-code", "--editors=all") && ok
    ok = #expect(#len(m1) == 0 && #len(w1) == 0, "--editors=all said something") && ok
    (ref []Found none, string8 _, string8 _) = choose_editors("none", known[:], found[:])
    ok = #expect(#len(none) == 0, "--editors=none chose some") && ok
    (ref []Found two, string8 m2, string8 _) = choose_editors("claude,code,windsurf,cursor,code", known[:], found[:])
    ok = same(ids_of(two[:]), "claude-code vscode cursor", "--editors=claude,code,windsurf,cursor,code") && ok
    ok = same(m2, "windsurf", "the one named and not found") && ok
    (ref []Found _, string8 _, string8 w3) = choose_editors("vscode,emacsen", known[:], found[:])
    ok = #expect(strings.contains(w3, "emacsen") && strings.contains(w3, "cursor"), "an unknown editor names it and the known ones: ", w3) && ok

    (ref []Found a1, bool g1) = parse_answer("", can[:])
    ok = #expect(g1, "Enter was refused") && ok
    ok = same(ids_of(a1[:]), "vscode cursor claude-code", "Enter") && ok
    (ref []Found a2, bool g2) = parse_answer(" 3, 1 ", can[:])
    ok = #expect(g2, "`3, 1` was refused") && ok
    ok = same(ids_of(a2[:]), "claude-code vscode", "`3, 1`") && ok
    (ref []Found a3, bool g3) = parse_answer("None", can[:])
    ok = #expect(g3 && #len(a3) == 0, "`None`") && ok
    (ref []Found a4, bool g4) = parse_answer("cursor 2", can[:])
    ok = #expect(g4, "`cursor 2` was refused") && ok
    ok = same(ids_of(a4[:]), "cursor", "`cursor 2`, one editor twice") && ok
    (ref []Found _, bool g5) = parse_answer("4", can[:])
    ok = #expect(!g5, "`4`, past the list, was accepted") && ok
    (ref []Found _, bool g6) = parse_answer("vim", can[:])
    ok = #expect(!g6, "`vim` was accepted") && ok
    try fs.remove_all(t) else:
        return ok
    return ok

// ── a marked block ──────────────────────────────────────────────────────────

private bool blocks_removed():
    bool ok = true
    string8 block = "# added by dado install; dado uninstall removes it\n[[language]]\nname = \"dado\"\n# end of the block dado install added\n"
    string8 text = txt(#format("[editor]\ntheme = \"x\"\n", block, "[keys]\n"))
    (string8 left, string8 o1) = without_block(text, sha256_of(block))
    ok = same(o1, "removed", "an unchanged block") && ok
    ok = same(left, "[editor]\ntheme = \"x\"\n[keys]\n", "the file without it") && ok
    string8 edited = txt(#format("[editor]\n", "# added by dado install\nname = \"mine\"\n# end of the block dado install added\n"))
    (string8 kept, string8 o2) = without_block(edited, sha256_of(block))
    ok = same(o2, "changed", "a block edited since") && ok
    ok = same(kept, edited, "the file with an edited block") && ok
    (string8 _, string8 o3) = without_block("[editor]\n", sha256_of(block))
    ok = same(o3, "absent", "a file with no block") && ok
    (string8 last, string8 o4) = without_block(txt(#format("a\n", strings.trim_right(block))), sha256_of(strings.trim_right(block)))
    ok = same(o4, "removed", "a block at the end with no final newline") && ok
    ok = same(last, "a\n", "what is left of it") && ok
    return ok

// ── reversals over a fake home ──────────────────────────────────────────────

private bool reversals_safe():
    bool ok = true
    when #OS == #WINDOWS:
        return ok
    string8 t = temp("dado-undo-test")
    if #len(t) == 0: return #expect(false, "no temp directory")
    string8 inst = join2(t, "inst")
    string8 bin = join3(t, "home", ".local/bin")
    ok = mkdir(join2(inst, "bin")) && mkdir(bin) && mkdir(join2(t, "home/mine")) && ok
    ok = put(join3(inst, "bin", "dado"), "x") && put(join2(t, "home/mine/notes"), "mine") && ok
    try fs.make_symlink(join3(inst, "bin", "dado"), join2(bin, "dado")) else:
        ok = #expect(false, "no symlink") && ok
    try fs.make_symlink("/somewhere/else/dadoc", join2(bin, "dadoc")) else:
        ok = #expect(false, "no symlink") && ok
    ok = put(join2(bin, "dado-lsp"), "a file of the user's") && ok
    string8 written = join2(t, "home/written")
    ok = put(written, "ours\n") && ok
    string8 j = txt(#format("mkdir\t", join2(t, "home/mine"), "\nmkdir\t", join2(t, "home/.local"), "\nmkdir\t", bin, "\nsymlink\t", join2(bin, "dado"), "\t", join3(inst, "bin", "dado"), "\nsymlink\t", join2(bin, "dadoc"), "\t", join2(inst, "dadoc"), "\nsymlink\t", join2(bin, "dado-lsp"), "\t", join2(inst, "dado-lsp"), "\nsymlink\t", join2(bin, "gone"), "\t", join2(inst, "gone"), "\nfile\t", written, "\t", sha256_of("ours\n"), "\nfile\t", join2(t, "home/mine/notes"), "\t", sha256_of("not mine"), "\nsurprise\tx\n"))
    ref []Record rs = parse_journal(j)
    ref []Record plan = reversal_plan(rs[:])
    ref []string8 got = #make([]string8, 0)
    for r in plan:
        Undo u = reverse_record(inst, r)
        _ = #append(got, txt(#format(r.kind, ":", u.outcome)))
    ref []char8 jo = strings.join(got[:], " ")
    ok = same(txt(jo), "surprise:kept file:kept file:undone symlink:gone symlink:kept symlink:kept symlink:undone mkdir:kept mkdir:kept mkdir:kept", "each reversal's outcome") && ok
    ok = #expect(!is_link(join2(bin, "dado")), "our link is still there") && ok
    ok = #expect(is_link(join2(bin, "dadoc")) && is_file(join2(bin, "dado-lsp")), "the user's link or file was removed") && ok
    ok = #expect(!exists(written) && is_file(join2(t, "home/mine/notes")), "the files: ours removed, the changed one kept") && ok
    // Now empty of the user's things, the directories go, and a second run
    // over the same journal finds everything gone.
    remove_quietly(join2(bin, "dadoc"))
    remove_quietly(join2(bin, "dado-lsp"))
    remove_quietly(join2(t, "home/mine/notes"))
    ref []string8 again = #make([]string8, 0)
    for r in plan:
        Undo u = reverse_record(inst, r)
        _ = #append(again, u.outcome)
    ref []char8 ja = strings.join(again[:], " ")
    ok = same(txt(ja), "kept gone gone gone gone gone gone undone undone undone", "the second run's outcomes") && ok
    ok = #expect(!exists(join2(t, "home/.local")) && !exists(join2(t, "home/mine")), "the emptied directories are still there") && ok
    try fs.remove_all(t) else:
        return ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = journals_read()
        ok = reversed_lifo() && ok
        ok = journal_written() && ok
        ok = windows_paths() && ok
        ok = shells_told() && ok
        ok = ids_read() && ok
        ok = editors_found() && ok
        ok = blocks_removed() && ok
        ok = reversals_safe() && ok
        if ok: return 0
        return 1
