// The commands: `where`, `clean`, and the four that take a package —
// `check`, `emit`, `build` and `run`.
//
// **Where a package's artifacts go is decided by the package**, not by this
// driver or the working directory: a package inside a project (`dado.json`,
// else the top of a git work tree) or a checkout (a directory holding a
// `dado` file and a `collections/` directory), the nearer of the two,
// builds into its `build/`, so every verb run anywhere in a project writes
// to one place; one outside every project into `build/` beside itself. Under
// it the artifacts mirror the package's own path, so two packages never share
// a name: `dado build corpus/tour` writes `build/corpus/tour` and
// `build/corpus/tour.c`, and the project's own package is named for the
// project. `DADO_BUILD_DIR` overrides the directory outright.
//
// **The `#line` paths in the C are relative**: the checkout's root maps to
// nothing (and a package's own build base, and the collections when they live
// elsewhere), so the C is the same bytes in any checkout.
package driver

import "core:fmt"
import "core:io"
import "core:os"
import "core:os/fs"
import "core:path"
import "core:strings"

// ── where, clean ────────────────────────────────────────────────────────────

// This toolchain's paths, one `key=value` per line, for an editor or a
// person: which layout, the root, the compiler, the language server, the
// collections, the two places `imports:` resolves (the project's, then the
// install's), the project `project:` resolves under, its collections overlay
// and the standard packages that overlay replaces, the build directory, the
// C compiler a build would use and the one a build with C's sanitizers
// (`dado test`, `--debug`) would. An empty value is one that is not there.
//
// JSON: {"query": "where", "root": ..., "compiler": ..., "lsp": ...,
// "collections": ..., "imports_project": ..., "imports_install": ...,
// "project": ..., "overlay": ..., "overlay_replaces": "core:geom core:x",
// "layout": "monorepo"|"install", "build": ..., "cc": ..., "cc_sanitized":
// ...}, the same keys and
// values.
i32 where(bool json = false):
    Layout l = layout()
    string8 cc = ""
    Compiler c = compiler("", true)
    if c.found: cc = shown(command_of(c.words[:]))
    ref []string8 keys = #make([]string8, 0)
    ref []string8 values = #make([]string8, 0)
    keys = #append(keys, "root")
    values = #append(values, l.root)
    keys = #append(keys, "compiler")
    values = #append(values, find_dadoc())
    keys = #append(keys, "lsp")
    values = #append(values, lsp_path())
    keys = #append(keys, "collections")
    values = #append(values, collections())
    // Where `imports:` resolves, in the order dadoc is told: the project's
    // (for a package in the working directory) and the install's.
    keys = #append(keys, "imports_project")
    values = #append(values, project_imports(working_dir()))
    keys = #append(keys, "imports_install")
    values = #append(values, install_imports())
    string8 project = project_root(working_dir())
    string8 overlay = project_overlay(project) if #len(project) > 0 else ""
    keys = #append(keys, "project")
    values = #append(values, project)
    keys = #append(keys, "overlay")
    values = #append(values, overlay)
    keys = #append(keys, "overlay_replaces")
    ref []char8 replaced = #make([]char8, 0)
    for name in overlay_shadows(overlay):
        if #len(replaced) > 0: replaced = #append(replaced, ' ')
        for c in name: replaced = #append(replaced, c)
    values = #append(values, txt(replaced))
    keys = #append(keys, "layout")
    values = #append(values, l.kind)
    keys = #append(keys, "build")
    values = #append(values, build_dir_for(working_dir()))
    keys = #append(keys, "cc")
    values = #append(values, cc)
    // What `dado test` and `--debug`, which have C's sanitizers, compile
    // with: the pinned zig has no AddressSanitizer, so the first compiler
    // found that has one, when there is (`c_compilers`).
    (string8 san_cc, bool _) = sanitized_build_compiler()
    keys = #append(keys, "cc_sanitized")
    values = #append(values, san_cc)
    if json:
        ref []string8 f = #make([]string8, 0)
        f = #append(f, json_text("query", "where"))
        for i in 0..<#len(keys):
            f = #append(f, json_text(keys[i], values[i]))
        fmt.println(json_object(f[:]))
        return 0
    for i in 0..<#len(keys):
        fmt.println(keys[i], "=", values[i])
    return 0

// Remove the build directory: the project's, when run in one.
i32 clean():
    string8 dir = build_dir_for(working_dir())
    if exists(dir):
        try fs.remove_all(dir) else code:
            die(txt(#format("cannot remove ", dir, ": ", os.message(code))))
            return 1
    say_green("cleaned", txt(#format(" ", dir)))
    return 0

// ── the package's place ─────────────────────────────────────────────────────

// The working directory as the shell names it: `PWD` when it is the same
// directory (so a path through a symlink stays the path the person used),
// else the system's answer.
string8 working_dir():
    try ref []char8 own = fs.current_dir() else why:
        die(txt(#format("cannot read the working directory: ", os.message(why))))
        quit 1
    string8 real_here = real(txt(own))
    (string8 pwd, bool set) = env("PWD")
    if set && path.is_abs(pwd) && real(pwd) == real_here:
        return pwd
    return txt(own)

private string8 real(string8 p):
    try ref []char8 out = fs.canonical(p) else:
        return p
    return txt(out)

// `p` made absolute against the working directory, as typed: no symlink
// followed and nothing cleaned, since it is the person's own name for it.
string8 absolute(string8 p, string8 cwd):
    if path.is_abs(p): return p
    when #OS == #WINDOWS:
        return txt(#format(cwd, "\\", p))
    else:
        return txt(#format(cwd, "/", p))

// The checkout a package belongs to: the nearest directory at or above `dir`
// that holds a file `dado` and a directory `collections`, or "".
string8 build_root(string8 dir):
    string8 at = clean_path(dir)
    for:
        if is_file(join2(at, "dado")) && is_dir(join2(at, "collections")):
            return at
        string8 up = dir_of(at)
        if up == at || #len(up) == 0 || up == ".": return ""
        at = up
    return ""

// The directory whose `build/` a package in `dir` builds into: the nearer of
// its checkout (`build_root`) and its project (`project_root`), both at or
// above `dir`; "" outside both.
string8 package_build_base(string8 dir):
    string8 checkout = build_root(dir)
    string8 project = project_root(dir)
    if #len(project) > #len(checkout): return clean_path(project)
    return checkout

// The build directory for packages in `dir`, as `where` reports it and
// `clean` removes it: `DADO_BUILD_DIR`, else the project's or checkout's
// `build/` (`build_dir_at`), else the toolchain's (`build_dir`).
string8 build_dir_for(string8 dir):
    (string8 over, bool set) = env("DADO_BUILD_DIR")
    if set: return over
    string8 base = package_build_base(dir)
    if #len(base) > 0: return build_dir_at(base)
    return build_dir()

// The `build/` of the packages whose build base is `base`: `<base>/build`,
// except in an install's own checkout, which builds into the install's
// `build/` beside it (`build_dir`). The checkout has no `.gitignore` (it is
// the repository as exported), so anything written under it is a change of
// its own to `dado update`, which refuses to move a checkout that has one
// rather than lose or mix it: a package of the collections or `tools/`
// tested or built there, or the update's own rebuild of `tools/dado`, whose
// caches are under its build directory.
string8 build_dir_at(string8 base):
    if layout().kind == "install":
        string8 r = clean_path(root())
        string8 b = clean_path(base)
        // With links followed when the text misses: the root is resolved
        // and `base` is as typed, so a package in the checkout reached
        // through a link otherwise built into it.
        if at_or_under(b, r, true) || at_or_under(real(b), real(r), true):
            return build_dir()
    return join2(base, "build")

// The `--source-prefix-map=` flags for a build: narrowest first, the
// collections `coll` when they live outside the root `r`, the package's own
// build base `base` when it is not the root, then the root. **Each named
// with links followed** (`real`, once per directory), since `dadoc` names
// the sources so: a project reached through a link otherwise matched
// nothing, and its C carried its absolute path. The typed name follows the
// resolved one when they differ, for a path `dadoc` could not resolve.
ref []string8 source_prefix_map(string8 coll, string8 base, string8 r):
    ref []string8 map = #make([]string8, 0)
    string8 real_coll = real(coll)
    string8 real_base = real(base)
    string8 real_r = real(r)
    if !at_or_under(real_coll, real_r, false) && !at_or_under(coll, r, false):
        map = #append(map, txt(#format("--source-prefix-map=", real_coll, "=collections")))
        if coll != real_coll: map = #append(map, txt(#format("--source-prefix-map=", coll, "=collections")))
    if real_base != real_r:
        map = #append(map, txt(#format("--source-prefix-map=", real_base, "=")))
        if base != real_base: map = #append(map, txt(#format("--source-prefix-map=", base, "=")))
    map = #append(map, txt(#format("--source-prefix-map=", real_r, "=")))
    if r != real_r: map = #append(map, txt(#format("--source-prefix-map=", r, "=")))
    return map

// Whether `p` is under the directory `dir` (or is it, when `at` is true),
// as text: both already cleaned or resolved.
private bool at_or_under(string8 p, string8 dir, bool at):
    if at && p == dir: return true
    return #len(p) > #len(dir) + 1 && strings.starts_with(p, dir) && path.is_separator(p[#len(dir)])

string8 clean_path(string8 p):
    ref []char8 c = path.clean(p)
    return txt(c)

// Where under the build directory a package's artifacts go: its path,
// cleaned, relative to `base` when it is inside it, else the absolute path
// with its root taken off. A trailing `.dado` is dropped.
string8 build_stem(string8 pkg, string8 base):
    string8 norm = clean_path(pkg)
    string8 stem = norm
    string8 b = clean_path(base)
    if norm == b:
        // The project's own package, `dado run .` at its root.
        stem = path.base(norm)
    else if #len(norm) > #len(b) + 1 && strings.starts_with(norm, b) && path.is_separator(norm[#len(b)]):
        stem = norm[#len(b) + 1..<#len(norm)]
    else:
        i64 skip = 0
        string8 vol = path.volume(norm)
        skip = #len(vol)
        for skip < #len(norm) && path.is_separator(norm[skip]):
            skip += 1
        stem = norm[skip..<#len(norm)]
        if #len(vol) > 0:
            // `C:\x` keeps its drive as a directory name, without the colon.
            stem = txt(#format(vol[0..<1], "/", stem))
    if strings.ends_with(stem, ".dado"):
        stem = stem[0..<#len(stem) - 5]
    return stem

// ── the package commands ────────────────────────────────────────────────────

// What every package command works out before it runs anything.
type Plan:
    string8 pkg_abs
    string8 name
    string8 build_base
    string8 build_dir
    string8 stem
    ref []string8 prefix_map
    string8 target_flag
    string8 dadoc
    string8 collections
    ref []string8 imports
    string8 test_file            // with test: the one test file named, or ""
    string8 written              // the package as the command line wrote it

// The plan of one package command for `pkg` as written; `target` is the
// `--target=` dadoc is told, or "" to ask the compiler.
Plan plan_for(^Options o, string8 pkg, string8 cwd, string8 target):
    string8 cmd = o.cmd
    if !exists(pkg):
        die(txt(#format("no such package: ", pkg)))
    Plan p
    p.dadoc = dadoc()
    p.collections = collections()
    p.test_file = ""
    p.written = pkg
    string8 pkg_abs = absolute(pkg, cwd)
    for #len(pkg_abs) > 1 && path.is_separator(pkg_abs[#len(pkg_abs) - 1]):
        pkg_abs = pkg_abs[0..<#len(pkg_abs) - 1]
    // `.` names its directory: `dir/.` would be another slot, and a C file `..c`.
    for #len(pkg_abs) > 2 && strings.ends_with(pkg_abs, ".") && path.is_separator(pkg_abs[#len(pkg_abs) - 2]):
        pkg_abs = pkg_abs[0..<#len(pkg_abs) - 2]
        for #len(pkg_abs) > 1 && path.is_separator(pkg_abs[#len(pkg_abs) - 1]):
            pkg_abs = pkg_abs[0..<#len(pkg_abs) - 1]
    // One test file of a library is tested and checked against its package
    // (`dado test q/q_test.dado`): the package is the directory, that test
    // selected. A lone `@test` program is checked as its test.
    if (cmd == "test" || cmd == "check" || cmd == "warnings") && strings.ends_with(pkg_abs, ".dado"):
        (string8 dir, bool member) = test_file_package(pkg_abs)
        if member:
            if cmd == "test": p.test_file = pkg_abs
            if cmd == "check" || cmd == "warnings": g_check_test_file = pkg_abs
            pkg_abs = dir
        else if (cmd == "check" || cmd == "warnings") && is_test_file(pkg_abs):
            g_check_test_file = pkg_abs
    p.pkg_abs = pkg_abs
    p.imports = imports_flags(dir_of(pkg_abs) if strings.ends_with(pkg_abs, ".dado") else pkg_abs)
    report_overlay(dir_of(pkg_abs) if strings.ends_with(pkg_abs, ".dado") else pkg_abs)
    // The libraries the project pins are where `dado.json` says (T76).
    if cmd != "emit": check_pins(dir_of(pkg_abs) if strings.ends_with(pkg_abs, ".dado") else pkg_abs)
    string8 name = path.base(pkg_abs)
    if strings.ends_with(name, ".dado"): name = name[0..<#len(name) - 5]
    p.name = name
    (string8 over, bool set) = env("DADO_BUILD_DIR")
    if set:
        p.build_base = root()
        p.build_dir = over
    else:
        string8 br = package_build_base(pkg_abs if is_dir(pkg_abs) else dir_of(pkg_abs))
        if #len(br) == 0:
            br = dir_of(clean_path(pkg_abs))
        p.build_base = br
        p.build_dir = build_dir_at(br)
    p.stem = build_stem(pkg_abs, p.build_base)

    p.prefix_map = source_prefix_map(p.collections, p.build_base, root())

    // Asked before `check` and `emit` too: a `when #OS` decides which
    // declarations exist, so every command asks the question a build does.
    p.target_flag = target
    if #len(target) == 0:
        Compiler quiet_cc = run_compiler(o, true)
        p.target_flag = target_flag(quiet_cc)
    return p


// The `--target=` dadoc is told: `DADO_TARGET`, or what the C compiler says
// it builds for, or nothing when there is no compiler to ask.
private string8 target_flag(Compiler c):
    (string8 t, bool set) = env("DADO_TARGET")
    if set: return txt(#format("--target=", t))
    if !c.found: return ""
    Command ask = command_of(c.words[:])
    add(&ask, "-dumpmachine")
    string8 triple = first_line(ask, true)
    if #len(triple) == 0: return ""
    return txt(#format("--target=", triple))

// The start of every dadoc command for this package: the collections, the
// target, and the web, shader, define and strip flags the command line gave.
private Command dadoc_command(^Plan p, ^Options o, bool shader, bool strip):
    Command c = command(p.dadoc)
    add(&c, txt(#format("--collections=", p.collections)))
    add_all(&c, p.imports[:])
    if #len(p.target_flag) > 0: add(&c, p.target_flag)
    if o.web_threads: add(&c, "--web-threads")
    if shader && #len(o.shader) > 0: add(&c, txt(#format("--shader=", o.shader)))
    add_all(&c, o.defines[:])
    if #len(o.cap) > 0: add(&c, o.cap)
    if strip: add_all(&c, o.strip[:])
    if strip && o.explain: add(&c, "--explain")
    return c

// **`--log FILE`**: every compile of a verb that prints its diagnostics adds
// them to the one file, which `start_log` emptied. Not on a run whose
// diagnostics another run prints again (`check_once`'s first, the
// manifest's), so each is in the file once.
void add_log(^Command c, ^Options o):
    if #len(o.log) > 0: add(c, txt(#format("--log-append=", o.log)))

// Empty the `--log` file before the verb's first compile, made absolute so
// every dadoc writes the same file. A path that cannot be written refuses
// the verb, naming it; a dadoc older than `--log-append=` cannot write it,
// and says so rather than leaving the file empty.
private void start_log(^Options o, string8 cwd):
    if #len(o.log) == 0: return
    o.log = absolute(o.log, cwd)
    if !dadoc_has_flag("--log-append"):
        die(txt(#format("this dadoc cannot write --log ", o.log, ": update it (dado upgrade), or leave --log out")))
    try fs.write_file(o.log, "") else code:
        die(txt(#format("cannot write the log ", o.log, ": ", os.message(code))))

bool targets_web():
    (string8 t, bool set) = env("DADO_TARGET")
    return set && t == "wasm32-unknown-web"

// Say, once per build, each standard package the project's collections
// overlay replaces: an override is never silent.
void report_overlay(string8 dir):
    string8 root = project_root(dir)
    if #len(root) == 0: return
    for name in overlay_shadows(project_overlay(root)):
        note_err(txt(#format("this project's collections/ replaces the standard `", name, "`")))

i32 package_command(^Options o):
    string8 cmd = o.cmd
    // `--target=web` is the web's triple, told to dadoc as any other is and
    // to every program this one starts.
    if o.target == "web":
        try os.set_env("DADO_TARGET", "wasm32-unknown-web") else:
            die("cannot set DADO_TARGET for --target=web")
    g_html_flag = web_flags(o)
    string8 cwd = working_dir()
    if cmd == "test" && #len(o.manifest) > 0:
        die(txt(#format("--manifest= writes files beside a build, which `dado test` does not make. Try: dado build ", o.pkg, " --manifest=", o.manifest)))
    if cmd == "test":
        start_log(o, cwd)
        return test_packages(test_plans(o, cwd), o)
    if #len(o.pkg) == 0:
        die(txt(#format("no package given. Try: dado ", cmd, " corpus/tour")))
    start_log(o, cwd)
    Plan p = plan_for(o, o.pkg, cwd, "")

    if cmd == "emit":
        Command c = dadoc_command(&p, o, true, true)
        if #len(o.emit) > 0: add(&c, txt(#format("--emit=", o.emit)))
        add(&c, p.pkg_abs)
        return run_quietly(c)

    if #len(o.manifest) > 0 && cmd != "build":
        die(txt(#format("--manifest= writes files beside a build, which `dado ", cmd, "` does not make. Try: dado build ", o.pkg, " --manifest=", o.manifest)))
    if #len(o.manifest) > 0:
        check_extensions(o.manifest)

    if cmd == "check" || cmd == "warnings":
        return check(&p, o)
    if o.target == "js":
        return js_library(&p, o)
    return build(&p, o)

// `--html=<abs>` for a web build with a page template, or "". The driver
// checks the template itself (`template_check`); dadoc is not told.
private string8 g_html_flag = ""

// ── check ───────────────────────────────────────────────────────────────────

private i32 check(^Plan p, ^Options o):
    Command c = dadoc_command(p, o, true, true)
    if o.strict: add(&c, "--strict")
    // A package that is not `package main` is a library: it has no entry
    // point to check for, and its surface is what it declares.
    if is_library(p.pkg_abs): add(&c, "--library")
    // **The `@test` files**, with `--tests`, each as `dado test` compiles
    // it: the package with that one file in it (`--test=`), a front end per
    // file, which is why it is asked for (a package of forty tests checks in
    // a second and a half alone, and in eighty with them). One test file
    // named (`dado check q/q_test.dado`) is checked alone, against its
    // package; a lone `@test` program, against itself.
    if #len(g_check_test_file) > 0:
        if !check_once(c, g_check_test_file, p.pkg_abs, o): return 1
        say_green("ok", txt(#format(" ", p.name)))
        return 0
    if !check_once(c, "", p.pkg_abs, o): return 1
    bool passed = true
    ref []string8 tests = test_files_of(p, o)
    if !o.check_tests:
        // Said, so "ok" is never read as covering what it did not check.
        if #len(tests) > 0:
            string8 files = "file" if #len(tests) == 1 else "files"
            note_err(txt(#format(#len(tests), " @test ", files, " not checked: --tests checks them, as dado test compiles them")))
        say_green("ok", txt(#format(" ", p.name)))
        return 0
    for t in tests:
        passed = check_once(c, t, p.pkg_abs, o) && passed
    if passed:
        say_green("ok", txt(#format(" ", p.name)))
        return 0
    return 1

// The one `@test` file `dado check` was named, or "".
private string8 g_check_test_file = ""

// Check `pkg` with the flags in `c`, and the `@test` file `test` in it when
// that is not "": whether it passed. The diagnostics are printed as `build`
// prints them, when there are any. A check that passes with warnings (or
// `--lenient`'s lints) shows them and still passes.
//
// **One `dadoc` run** (`--emit=check`): the diagnostics as a build prints
// them, counted, capped and logged, the status `--emit=diagnostics` gives,
// and no C. A `dadoc` older than it is asked twice, as before: a first run's
// answer is its status, and a line of it is a diagnostic; one with nothing
// to say is not run again, and the second run alone adds to `--log`.
private bool check_once(Command c, string8 test, string8 pkg, ^Options o):
    if dadoc_has_flag("explained | check"):
        Command once = command_of(c.words[:])
        if #len(test) > 0: add(&once, txt(#format("--test=", test)))
        add(&once, "--emit=check")
        add_log(&once, o)
        add(&once, pkg)
        Captured r = capture(once, false)
        check_ending(r.started, r.status)
        return r.started && r.status == 0
    Command first = command_of(c.words[:])
    if #len(test) > 0: add(&first, txt(#format("--test=", test)))
    add(&first, "--emit=diagnostics")
    add(&first, pkg)
    Captured r = capture(first, false)
    bool passed = r.started && r.status == 0
    string8 said = strings.trim(txt(r.out))
    if !passed || #len(said) > 0:
        Command again = command_of(c.words[:])
        if #len(test) > 0: add(&again, txt(#format("--test=", test)))
        add_log(&again, o)
        add(&again, pkg)
        _ = capture(again, false)
    check_ending(r.started, r.status)
    return passed

// A check whose compiler neither passed nor refused: how it ended is said,
// where the driver said nothing and exited 1.
private void check_ending(bool started, i32 status):
    if started && status > 1: say_error(txt(#format("checking stopped: ", compiler_ended(status, host_os() == "#WINDOWS"), ".")))

// The package's `@test` files, as `dadoc --emit=tests` lists them.
private ref []string8 test_files_of(^Plan p, ^Options o):
    ref []string8 out = #make([]string8, 0)
    Command tc = dadoc_command(p, o, true, false)
    add(&tc, "--emit=tests")
    add(&tc, p.pkg_abs)
    Captured listed = capture(tc, false)
    if !listed.started || listed.status != 0:
        die(txt(#format("cannot read the tests of ", o.pkg)))
    (ref []TestEntry tests, bool ok, string8 why) = parse_tests(txt(listed.out))
    if !ok: die(why)
    for t in tests:
        out = #append(out, t.path)
    return out

// Whether the file at `file` is an `@test` file: `@test` opens it, after
// any comments.
bool is_test_file(string8 file):
    try ref []char8 text = fs.read_file(file) else:
        return false
    for l in lines_of(txt(text)):
        string8 t = strings.trim(l)
        if #len(t) == 0 || strings.starts_with(t, "//"): continue
        return t == "@test" || strings.starts_with(t, "@test ")
    return false

// Whether the package at `pkg` names itself something other than `main`: the
// first `package` line of its first source file that has one. A package that
// writes none is `main`.
bool is_library(string8 pkg):
    if !is_dir(pkg): return library_named(pkg)
    string8 dir = clean_path(pkg)
    fs.Listing l = fs.walk(dir)
    defer l.destroy()
    for e in l.entries:
        if !e.is_dir && strings.ends_with(e.path, ".dado") && clean_path(dir_of(e.path)) == dir:
            string8 f = e.path
            try ref []char8 text = fs.read_file(f) else:
                continue
            (bool named, bool library) = package_line(txt(text))
            if named: return library
    return false

private bool library_named(string8 file):
    try ref []char8 text = fs.read_file(file) else:
        return false
    (bool _, bool library) = package_line(txt(text))
    return library

// Whether the `.dado` file at `file` is one file of the package its
// directory is, and that directory: it names a library (`package q`, not
// `main`) that another `.dado` file beside it names too. `dado test` runs
// such a file against its package, with that test alone selected; anything
// else, a single-file program among others included, stands alone.
(string8 dir, bool member) test_file_package(string8 file):
    string8 own = package_name_of(file)
    if #len(own) == 0 || own == "main": return ("", false)
    string8 dir = clean_path(dir_of(file))
    string8 me = clean_path(file)
    fs.Listing l = fs.walk(dir)
    defer l.destroy()
    for e in l.entries:
        if e.is_dir || !strings.ends_with(e.path, ".dado"): continue
        string8 f = clean_path(e.path)
        if f == me || clean_path(dir_of(f)) != dir: continue
        if package_name_of(f) == own: return (dir, true)
    return ("", false)

// The package the file at `file` names on its `package` line, or "" when it
// writes none or cannot be read.
private string8 package_name_of(string8 file):
    try ref []char8 text = fs.read_file(file) else:
        return ""
    for l in lines_of(txt(text)):
        string8 t = strings.trim(l)
        if strings.starts_with(t, "package "):
            return strings.trim(t[8..<#len(t)])
        if #len(t) > 0 && !strings.starts_with(t, "//") && !strings.starts_with(t, "@"):
            break
    return ""

// The file's `package` line, if it opens with one (after comments and an
// `@test`), and whether it names anything but `main`.
private (bool named, bool library) package_line(string8 text):
    for l in lines_of(text):
        string8 t = strings.trim(l)
        if strings.starts_with(t, "package "):
            return (true, strings.trim(t[8..<#len(t)]) != "main")
        if #len(t) > 0 && !strings.starts_with(t, "//") && !strings.starts_with(t, "@"):
            break
    return (false, false)

// ── the manifest's extensions ───────────────────────────────────────────────

private void check_extensions(string8 list):
    string8 rest = list
    for:
        (string8 ext, string8 tail, bool more) = split_byte(rest, ',')
        bool official = ext == "h" || ext == "dts"
        if !official && (strings.has_byte(ext, '/') || strings.has_byte(ext, '.')):
            if !is_file(ext):
                die(txt(#format("the manifest extension `", ext, "` is not a file. The official ones are `h` and `dts`; anything else is a path to a program that reads the manifest on standard input")))
        else if !official:
            die(txt(#format("unknown manifest extension `", ext, "`: the official ones are `h` (a C header) and `dts` (TypeScript declarations); a third-party one is named by its path, e.g. --manifest=h,./tools/mine.mjs")))
        if !more: break
        rest = tail

// Whether the manifest describes a package of scripts (`--target=js`).
private bool g_manifest_package

void set_manifest_package(bool on):
    g_manifest_package = on

// `dadoc --emit=manifest` beside the build, then each extension over it.
private void write_manifest_outputs(^Plan p, ^Options o):
    if #len(o.manifest) == 0: return
    string8 json = txt(#format(p.build_dir, "/", p.stem, ".manifest.json"))
    try fs.make_dirs(dir_of(json)) else: pass
    Command c = command(p.dadoc)
    add(&c, txt(#format("--collections=", p.collections)))
    add_all(&c, p.imports[:])
    if #len(p.target_flag) > 0: add(&c, p.target_flag)
    if o.web_threads: add(&c, "--web-threads")
    add_all(&c, o.defines[:])
    if #len(o.cap) > 0: add(&c, o.cap)
    if o.strict: add(&c, "--strict")
    if g_manifest_package: add(&c, "--package")
    add(&c, "--emit=manifest")
    add(&c, "-o")
    add(&c, json)
    add(&c, p.pkg_abs)
    if run(c) != 0:
        die(txt(#format("the manifest was not written; what was built is in ", p.build_dir)))
    say_green("built", txt(#format(" ", json)))
    try ref []char8 manifest_text = fs.read_file(json) else code:
        die(txt(#format("cannot read ", json, " back: ", os.message(code))))
        return
    string8 rest = o.manifest
    for:
        (string8 ext, string8 tail, bool more) = split_byte(rest, ',')
        string8 script = ""
        string8 out = ""
        if ext == "h":
            script = join3(root(), "tools", join2("manifest", "h.mjs"))
            out = txt(#format(p.build_dir, "/", p.stem, ".h"))
        else if ext == "dts":
            script = join3(root(), "tools", join2("manifest", "dts.mjs"))
            out = txt(#format(p.build_dir, "/", p.stem, ".d.ts"))
            if !is_file(script):
                die(txt(#format("the `dts` manifest extension is a script of the compiler's source, and this toolchain has none at\n    ", script, "\n  Build the manifest alone (--manifest=h), or run from a checkout of the repository.")))
        else:
            script = ext
            string8 base = path.base(ext)
            string8 e = path.ext(base)
            out = txt(#format(p.build_dir, "/", p.stem, ".", base[0..<#len(base) - #len(e)]))
        Command x = command("")
        if strings.ends_with(script, ".mjs") || strings.ends_with(script, ".js"):
            (string8 node, bool nset) = env("DADO_NODE")
            if !nset: node = "node"
            string8 node_path = on_path(node)
            if #len(node_path) == 0:
                die(txt(#format("the `", ext, "` manifest extension is a JavaScript program, and `", node, "` is not on this machine: install node, or name it with DADO_NODE=<path>")))
            x = command(node)
            add(&x, script)
        else:
            if !fs.is_executable(script):
                die(txt(#format("the manifest extension `", script, "` is not executable: chmod +x it, or write it as a .mjs file node runs")))
            x = command(script)
        if verbose():
            note(txt(#format("  $ ", shown(x), " < ", json, " > ", out)))
        Captured r = capture(x, false, txt(manifest_text))
        if !r.started || r.status != 0:
            die(txt(#format("the manifest extension `", ext, "` failed; the manifest it read is ", json)))
        try fs.write_file(out, txt(r.out)) else code:
            die(txt(#format("cannot write ", out, ": ", os.message(code))))
            return
        say_green("built", txt(#format(" ", out)))
        if !more: break
        rest = tail

// ── build and run ───────────────────────────────────────────────────────────

// Homebrew's prefix, asked once: `brew --prefix` when `brew` is on `PATH`.
// Apple's clang does not search `/opt/homebrew`, so a library `brew`
// installed is not found without it.
private string8 g_brew = ""
private bool g_brew_asked

private string8 brew_prefix():
    if g_brew_asked: return g_brew
    g_brew_asked = true
    string8 brew = on_path("brew")
    if #len(brew) == 0: return ""
    Command c = command(brew)
    add(&c, "--prefix")
    g_brew = first_line(c, true)
    return g_brew

// The compile and link flags a sanitized build takes with compiler `cc`, or
// none: `on` false, or this compiler cannot build and run a sanitized
// program here. `kind` is `address` or `thread`. A missing runtime is a
// warning and an unsanitized build for `address`, and an error for `thread`,
// which somebody asked for by name. Each runtime's options are defaulted in
// the environment, never forced.
(ref []string8 cflags, ref []string8 ldflags, bool on) configure_sanitizers(Compiler cc, bool on, string8 kind):
    ref []string8 none_c = #make([]string8, 0)
    ref []string8 none_l = #make([]string8, 0)
    if !on: return (none_c, none_l, false)
    if kind == "thread":
        (ref []string8 tc, ref []string8 tl) = sanitizer_words(setting("CFLAGS_SANITIZE_THREAD"), setting("LDFLAGS_SANITIZE_THREAD"), cc.zig)
        if cached_probe(cc, tc[:], tl[:]) != PROBE_RAN:
            die(txt(#format(cc.name, " cannot build and run a -fsanitize=thread program here.\n  install its runtime (Ubuntu: libtsan2 for gcc, libclang-rt-dev for clang), or --cc the other.")))
        default_env("TSAN_OPTIONS", setting("TSAN_OPTIONS_DEFAULT"))
        default_env("UBSAN_OPTIONS", setting("UBSAN_OPTIONS_DEFAULT"))
        return (tc, tl, true)
    (ref []string8 ac, ref []string8 al) = sanitizer_words(setting("CFLAGS_SANITIZE"), setting("LDFLAGS_SANITIZE"), cc.zig)
    i32 probe = cached_probe(cc, ac[:], al[:])
    if probe == PROBE_HUNG && !cc.zig:
        // AddressSanitizer that links but never lets `main` start. Seen with
        // Apple clang 17 on macOS 26, where an empty program hangs at start-up
        // under -fsanitize=address whatever ASAN_OPTIONS says. UBSan alone
        // still runs there, so the tests keep the checks that work.
        (ref []string8 uc, ref []string8 ul) = sanitizer_words(setting("CFLAGS_SANITIZE"), setting("LDFLAGS_SANITIZE"), true)
        if cached_probe(cc, uc[:], ul[:]) == PROBE_RAN:
            warn(txt(#format(cc.name, "'s AddressSanitizer hangs at start-up here: an empty program built with it did not exit in ", PROBE_LIMIT_MS / 1000, " s.\n  sanitizing with UBSan alone. For out-of-bounds checks, --cc another compiler (Homebrew's llvm, or gcc).")))
            g_ubsan_only = true
            default_env("UBSAN_OPTIONS", setting("UBSAN_OPTIONS_DEFAULT"))
            return (uc, ul, true)
    if probe != PROBE_RAN:
        warn(txt(#format(cc.name, " has no sanitizer runtime here — running unsanitized.\n  `dado test` and --debug ask for -fsanitize=address,undefined:\n  install it (Ubuntu: libclang-rt-dev, libasan8), or --cc gcc, or --no-c-sanitize.")))
        return (none_c, none_l, false)
    if cc.zig && g_asan_on_windows:
        warn("AddressSanitizer is unavailable on Windows (MinGW's gcc and clang runtimes are unreliable): sanitizing with UBSan alone.")
    else if cc.zig && g_no_sanitizing_cc:
        warn("no gcc or clang here can build and run an AddressSanitizer program (dado doctor lists those found): building with the pinned zig, UBSan alone.\n  Install one's runtime (Ubuntu: libasan8 for gcc, libclang-rt-dev for clang) for out-of-bounds and use-after-free checks.")
    else if cc.zig:
        warn("the pinned zig has no AddressSanitizer runtime: sanitizing with UBSan alone.\n  Pass --cc clang or --cc gcc for out-of-bounds checks.")
    else:
        default_env("ASAN_OPTIONS", setting("ASAN_OPTIONS_DEFAULT"))
    default_env("UBSAN_OPTIONS", setting("UBSAN_OPTIONS_DEFAULT"))
    return (ac, al, true)

// ── C's sanitizers where no runtime is: the web and `#NONE` ────────────────

// UBSan with every check a bare trap: what a sanitized web or `#NONE` build
// compiles with when its `dadoc` writes no handlers for the reporting checks
// (older than rc.8), so nothing is left for a runtime nobody links.
private const string8 CFLAGS_SANITIZE_TRAP = "-fsanitize=undefined,float-cast-overflow -fno-sanitize-recover=all -fsanitize-trap=all"

// Whether this run's `dadoc` writes C's UBSan handlers (`--ubsan-handlers`,
// rc.8 and later): its `--help` lists the flag (`dadoc_has_flag`), since every
// pre-release `dadoc` names the same version.
bool dadoc_writes_ubsan_handlers():
    return dadoc_has_flag("--ubsan-handlers")

// The flag a sanitized transpile hands `dadoc`, or "": `--ubsan-handlers`,
// which the web and `#NONE` act on and a target with a C library ignores, so
// it is given whatever the target turns out to be (`#NONE` is known only
// from the manifest the transpile writes).
string8 ubsan_handlers_flag(^Options o):
    if !o.sanitize || !dadoc_writes_ubsan_handlers(): return ""
    return "--ubsan-handlers"

private bool g_ubsan_alone_said
// The sanitizer flags of a build for `os`, a target with no sanitizer
// runtime (`#WEB` or `#NONE`): `setting`'s words, or trap mode alone under a
// `dadoc` that writes no handlers. Nothing when unsanitized.
// `--sanitize=thread` is an error there; `--sanitize=address`, written, says
// once that the build is UBSan alone, as the pinned zig's does natively.
ref []string8 runtime_free_sanitizer(^Options o, string8 os, string8 name):
    ref []string8 none = #make([]string8, 0)
    if !o.sanitize: return none
    string8 where = "--target=web" if os == "#WEB" else "a `#NONE` target"
    if o.sanitize_kind == "thread":
        die(txt(#format("`--sanitize=thread` cannot build for ", where, ": there is no ThreadSanitizer runtime there.\n  Drop =thread for C's UBSan alone, or run the threads natively.")))
    if o.sanitize_given && o.sanitize_kind == "address" && !g_ubsan_alone_said:
        g_ubsan_alone_said = true
        warn(txt(#format("there is no AddressSanitizer runtime for ", where, ": sanitizing with UBSan alone.\n  `dado test` natively runs AddressSanitizer over the same C.")))
    if dadoc_writes_ubsan_handlers(): return words_of(setting(name))
    return words_of(CFLAGS_SANITIZE_TRAP)

void default_env(string8 name, string8 value):
    (string8 _, bool set) = env(name)
    if set: return
    try os.set_env(name, value) else:
        return

// Whether this run sanitizes with UBSan alone: always under the pinned zig,
// which has no AddressSanitizer, and when the compiler's AddressSanitizer
// hung at start-up here.
private bool g_ubsan_only
bool ubsan_only(Compiler cc): return cc.zig || g_ubsan_only

// What running the probe program answered: it ran and exited 0, it could not
// be built or failed, or it was still running at `PROBE_LIMIT_MS` and was
// killed. An empty program needs well under a second, sanitized or not.
const i32 PROBE_RAN = 0
const i32 PROBE_FAILED = 1
const i32 PROBE_HUNG = 2
const i32 PROBE_LIMIT_MS = 20000

// `sanitizer_probe`'s answer, from this machine's cache when it has one
// (`probe_cache_dir`), keyed by the compiler's identity — the program its
// first word runs as, every word, and what `--version` prints — and the
// flags. A probe that ran or hung is kept: the first is the common answer and
// the second costs `PROBE_LIMIT_MS` every time it is asked. One that failed
// is asked again next time, cheaply, so installing a runtime is seen at once.
// A new compiler, a new version of one, or one whose file moved or changed
// (`program_stamp`) is a new key.
// A runtime removed after its probe was kept makes the answer stale:
// `recheck_sanitizer` asks again when a sanitized build fails.
i32 cached_probe(Compiler cc, []string8 cflags, []string8 ldflags):
    string8 entry = probe_entry(cc, cflags, ldflags)
    string8 dir = probe_cache_dir()
    string8 key = path.base(entry) if #len(entry) > 0 else ""
    if #len(key) > 0 && is_file(entry):
        i32 known = probe_of(strings.trim(read_or_empty(entry)))
        if known != PROBE_UNKNOWN: return known
    i32 answer = sanitizer_probe(cc, cflags, ldflags)
    if #len(key) > 0 && answer != PROBE_FAILED:
        // Written aside and renamed, so a concurrent run reads a whole entry
        // or none.
        try fs.make_dirs(dir) else: pass
        string8 tmp = txt(#format(entry, ".", os.pid()))
        try fs.write_file(tmp, probe_word(answer)) else:
            return answer
        try fs.rename(tmp, entry) else:
            remove_quietly(tmp)
    return answer

// The cache file `cached_probe` keeps its answer for `cc` and these flags
// in, or "" when the key cannot be taken.
private string8 probe_entry(Compiler cc, []string8 cflags, []string8 ldflags):
    Digest d = digest()
    put_text(&d, compiler_identity(cc))
    put_text(&d, program_stamp(cc.words[0]))
    ref []char8 cj = strings.join(cflags, " ")
    put_text(&d, txt(cj))
    ref []char8 lj = strings.join(ldflags, " ")
    put_text(&d, txt(lj))
    string8 key = finish_digest(&d)
    if #len(key) == 0: return ""
    return join2(probe_cache_dir(), key)

// The file `program` runs as, links followed, and when it was last written:
// a compiler replaced or moved is a new key even when it says the same
// `--version`. "" when it cannot be found.
string8 program_stamp(string8 program):
    string8 file = on_path(program)
    if #len(file) == 0: return ""
    string8 at = real(file)
    try i64 t = fs.mtime(at) else:
        return at
    return txt(#format(at, " ", t))

// A probe's answer as its cache entry says it, and back; anything else in an
// entry is `PROBE_UNKNOWN`, and the probe is run again.
const i32 PROBE_UNKNOWN = 3
string8 probe_word(i32 answer):
    if answer == PROBE_RAN: return "ran"
    if answer == PROBE_HUNG: return "hung"
    return "failed"
i32 probe_of(string8 word):
    if word == "ran": return PROBE_RAN
    if word == "hung": return PROBE_HUNG
    return PROBE_UNKNOWN

// ── the sanitizing compiler a build without --cc uses ───────────────────────

// Set when this run's sanitized build kept the pinned zig because no gcc or
// clang here could sanitize, and when it is on a Windows host, where none is
// tried: each changes what `configure_sanitizers` says about UBSan alone.
private bool g_no_sanitizing_cc
private bool g_asan_on_windows
private Compiler g_run_cc
private bool g_run_cc_chosen

// This host's `#OS`, as `sanitizing_candidates` takes it.
private string8 host_os():
    when #OS == #WINDOWS:
        return "#WINDOWS"
    else when #OS == #DARWIN:
        return "#DARWIN"
    else when #OS == #LINUX:
        return "#LINUX"
    else:
        return "#OTHER"

// The words that start `cc`, a gcc or clang `--cc` names, for a `#NONE`
// build told `target_flag` (`--target=<triple>`). The compiler's own
// `-dumpmachine` for the triple's architecture (`arch_family`): its words as
// they are. Another: a clang is told the triple with `--target=`, since every
// clang builds for every architecture it has; anything else is refused, as it
// would compile for its own machine an object named for another.
private ref []string8 none_cross_words(Compiler cc, string8 target_flag):
    ref []string8 words = command_of(cc.words[:]).words
    if !strings.starts_with(target_flag, "--target="): return words
    string8 triple = target_flag[9..<#len(target_flag)]
    Command ask = command_of(cc.words[:])
    add(&ask, "-dumpmachine")
    string8 own = first_line(ask, true)
    if #len(own) == 0 || arch_family(own) == arch_family(triple): return words
    Command v = command_of(cc.words[:])
    add(&v, "--version")
    if strings.contains(first_line(v, true), "clang"):
        words = #append(words, target_flag)
        return words
    die(txt(#format("DADO_TARGET=", triple, " builds for ", arch_family(triple), ", and --cc ", cc.name, " builds for ", own, ".\n  Name a cross compiler that builds for ", arch_family(triple), " with --cc, or --cc clang, which is told\n  --target=", triple, ", or drop --cc for the pinned zig.")))
    return words

// Whether this build is a cross-compile: `DADO_TARGET` or `ZIG_TARGET` set.
bool cross_compiling():
    (string8 _, bool dt) = env("DADO_TARGET")
    (string8 _, bool zt) = env("ZIG_TARGET")
    return dt || zt

// The C compiler `o`'s build uses: `compiler(o.cc)`, except for a native
// build with C's sanitizers and no `--cc` (`wants_sanitizing_cc`), which uses
// the first compiler `c_compilers` finds whose probe builds and runs an empty
// AddressSanitizer program, said once in a line. None that can, or a Windows
// host: the pinned zig, and `configure_sanitizers` says why it is UBSan
// alone. Chosen once a run; `quiet` as `compiler`'s.
Compiler run_compiler(^Options o, bool quiet):
    if g_run_cc_chosen && !g_run_cc.zig: return g_run_cc
    // A dev build on Linux compiles with the pinned tcc when it is there.
    if tcc_by_default(o): return pinned_tcc()
    bool sanitizing = wants_sanitizing_cc(o.sanitize, o.sanitize_kind, o.cc, cross_compiling() || targets_web())
    // A sanitized build reads `CC` itself (`sanitizing_compiler`), so
    // `compiler`'s note that it is ignored is not said of it, but on Windows,
    // where no compiler is tried over the pinned zig.
    Compiler c = compiler(o.cc, quiet || (sanitizing && host_os() != "#WINDOWS"))
    if !c.found || !c.zig || !sanitizing: return c
    return sanitizing_compiler(c, true)

// The compiler a sanitized native build with no `--cc` uses, given the
// pinned zig `zig`: the first of `c_compilers` (`CC` first, when it is set)
// whose probe runs, said once in a line when `say`, else `zig`. Chosen once
// a run. `dado where` and `dado doctor` ask it without `say`.
Compiler sanitizing_compiler(Compiler zig, bool say):
    if g_run_cc_chosen: return g_run_cc
    g_run_cc_chosen = true
    g_run_cc = zig
    if host_os() == "#WINDOWS":
        g_asan_on_windows = true
        return zig
    (ref []string8 ac, ref []string8 al) = sanitizer_words(setting("CFLAGS_SANITIZE"), setting("LDFLAGS_SANITIZE"), false)
    (string8 cc_env, bool cc_runs) = cc_variable()
    for f in c_compilers():
        Compiler cand = found_compiler(f)
        if cached_probe(cand, ac[:], al[:]) != PROBE_RAN: continue
        if say:
            note_err(sanitizing_note(f.name, f.via == "CC", cc_env, cc_runs))
        g_run_cc = cand
        return cand
    g_no_sanitizing_cc = true
    if say && #len(cc_env) > 0:
        note_err(cc_note(cc_env, cc_runs))
    return zig

// The line a sanitized build says when it uses `name` over the pinned zig,
// `from_cc` when `CC` named it. A `CC` that is set (`cc_env`) and was passed
// over is said, with why: it does not run here, or has no AddressSanitizer.
string8 sanitizing_note(string8 name, bool from_cc, string8 cc_env, bool cc_runs):
    string8 who = txt(#format(name, " (CC)")) if from_cc else name
    string8 line = txt(#format("sanitizing with ", who, ": the pinned zig has no AddressSanitizer, and ", name, " has one here (--cc zig keeps zig, UBSan alone)"))
    if !from_cc && #len(cc_env) > 0:
        line = txt(#format(line, ".\n  ", cc_note(cc_env, cc_runs)))
    return line

// Why a `CC` that is set was not what a sanitized build used.
string8 cc_note(string8 cc_env, bool cc_runs):
    if !cc_runs: return txt(#format("CC=", cc_env, " is not a program that runs here"))
    return txt(#format("CC=", cc_env, " cannot build and run an AddressSanitizer program here"))

// What `dado where` and `dado doctor` say a sanitized `dado test` here
// compiles with, and whether that build has AddressSanitizer: "" when there
// is no pinned zig to start from. Asks the probes (cached), says nothing.
(string8 compiler, bool asan) sanitized_build_compiler():
    Compiler z = compiler("zig", true)
    if !z.found: return ("", false)
    if cross_compiling(): return (shown(command_of(z.words[:])), false)
    Compiler c = sanitizing_compiler(z, false)
    return (shown(command_of(c.words[:])), !c.zig)

// After a sanitized compile or link with `cc` failed: the cached answer that
// `cc` can sanitize here is asked again, since a runtime removed after it was
// cached fails every link until it is. A probe that no longer runs is said,
// and the next run is built as one with no runtime is.
void recheck_sanitizer(Compiler cc, []string8 cflags, []string8 ldflags):
    string8 entry = probe_entry(cc, cflags, ldflags)
    if #len(entry) == 0 || !is_file(entry): return
    remove_quietly(entry)
    if cached_probe(cc, cflags, ldflags) == PROBE_RAN: return
    warn(txt(#format(cc.name, " can no longer build and run a sanitized program here (its sanitizer runtime was\n  there when this was last asked, and is not now): the next run builds without it, or --no-sanitize")))

// Whether `cc` can compile, link **and run** a program with these flags: the
// link is where a missing runtime shows, and the run is where one that links
// but cannot map its shadow memory does, or one that never starts.
i32 sanitizer_probe(Compiler cc, []string8 cflags, []string8 ldflags):
    ref []char8 tmp = os.temp_dir()
    string8 probe_c = txt(#format(txt(tmp), "/dado-san-probe-", os.pid(), ".c"))
    string8 probe_bin = txt(#format(txt(tmp), "/dado-san-probe-", os.pid()))
    try fs.write_file(probe_c, "int main(void) { return 0; }\n") else:
        return PROBE_FAILED
    Command c = command_of(cc.words[:])
    add_all(&c, cflags)
    add(&c, probe_c)
    add(&c, "-o")
    add(&c, probe_bin)
    add_all(&c, ldflags)
    i32 answer = PROBE_FAILED
    if succeeds(c):
        (bool ran, bool hung) = succeeds_within(command(probe_bin), PROBE_LIMIT_MS)
        if ran: answer = PROBE_RAN
        else if hung: answer = PROBE_HUNG
    remove_quietly(probe_c)
    if exists(probe_bin):
        remove_quietly(probe_bin)
    return answer

// The script engine's archive directory for this compiler, target and
// flags, built on a miss by `tools/quickjs/build.sh` and cached by it.
private string8 engine_archive(Compiler cc, string8 target_flag, []string8 san_c):
    Command c = command(join3(root(), "tools", join2("quickjs", "build.sh")))
    add(&c, "--cc")
    // One argument, as the build script reads it: `zig cc` and its `-target`
    // are several words, which the script splits where it runs the compiler.
    ref []char8 words = strings.join(cc.words[:], " ")
    add(&c, txt(words))
    // Under zig the target is already among the words.
    if !cc.zig && strings.starts_with(target_flag, "--target="):
        add(&c, "--triple")
        add(&c, target_flag[9..<#len(target_flag)])
    if #len(san_c) > 0:
        add(&c, "--extra")
        ref []char8 j = strings.join(san_c, " ")
        add(&c, txt(j))
    add(&c, "--quiet")
    if verbose():
        note(txt(#format("  $ ", shown(c))))
    Captured r = capture(c, false)
    if !r.started || r.status != 0: return ""
    ref []string8 ls = lines_of(txt(r.out))
    if #len(ls) == 0: return ""
    string8 dir = ls[#len(ls) - 1]
    if !is_file(join2(dir, "libquickjs.a")): return ""
    return dir

// Where a build whose one-file C is `c_file` has `dadoc` write the
// single-header libraries' implementations (`--implementations=`): beside it.
string8 impl_file_of(string8 c_file):
    return txt(#format(c_file[0..<#len(c_file) - 2], ".impl.c"))

private i32 build(^Plan p, ^Options o):
    string8 cmd = o.cmd
    // A web build compiles with clang for wasm32 (`web.dado`), so it asks
    // for no native compiler, and its sanitizer is its own (`web_compile_flags`),
    // as a `#NONE` one's is: each is chosen once the manifest names the target.
    bool web = targets_web()
    Compiler cc = no_compiler("")
    ref []string8 san_c = #make([]string8, 0)
    ref []string8 san_l = #make([]string8, 0)
    bool sanitized = false
    if !web: cc = need(run_compiler(o, false))

    // `-o` moves both artifacts: the C goes beside the program, named for
    // the package.
    string8 c_file = ""
    string8 out = o.out
    if o.out_given:
        c_file = join2(dir_of(o.out), txt(#format(p.name, ".c")))
    else:
        c_file = txt(#format(p.build_dir, "/", p.stem, ".c"))
        out = txt(#format(p.build_dir, "/", p.stem))
    try fs.make_dirs(dir_of(c_file)) else: pass

    say(txt(#format("dadoc  ", o.pkg)))
    // The transpile's own order: `--release` before the shader, the
    // defines and the strip flags.
    Command t = command(p.dadoc)
    add(&t, txt(#format("--collections=", p.collections)))
    add_all(&t, p.imports[:])
    if #len(p.target_flag) > 0: add(&t, p.target_flag)
    if o.web_threads: add(&t, "--web-threads")
    if o.release: add(&t, "--release")
    if #len(o.shader) > 0: add(&t, txt(#format("--shader=", o.shader)))
    add_all(&t, o.defines[:])
    if #len(o.cap) > 0: add(&t, o.cap)
    add_all(&t, o.strip[:])
    if o.strict: add(&t, "--strict")
    add_log(&t, o)
    if o.line_directives: add(&t, "--line-directives")
    string8 handlers = ubsan_handlers_flag(o)
    if #len(handlers) > 0: add(&t, handlers)
    add_all(&t, p.prefix_map[:])
    // **The build manifest from this one compile** (DI-0380): what the
    // program needs beyond its C, read back below, as `dado test` does. On
    // the web, also the scripts' directory beside the module, emptied first.
    string8 manifest_file = txt(#format(c_file, ".build"))
    Command fe_t = command_of(t.words[:])
    add(&t, txt(#format("--build-manifest=", manifest_file)))
    string8 web_scripts = ""
    if web:
        string8 scripts_dir = txt(#format(p.build_dir, "/", p.stem, ".scripts"))
        if o.out_given:
            scripts_dir = o.out
            if strings.ends_with(scripts_dir, ".wasm"): scripts_dir = scripts_dir[0..<#len(scripts_dir) - 5]
            scripts_dir = txt(#format(scripts_dir, ".scripts"))
        remove_tree_quietly(scripts_dir)
        web_scripts = scripts_dir
        add(&t, txt(#format("--scripts-out=", scripts_dir)))
    // **The many-file form, every build's** (CP-13 steps 3 and 4): beside
    // the one-file C, the bodies as units of a package or so each (about
    // 512 KiB of C; `DADO_UNIT_BYTES` to dadoc sets it) and a runtime file,
    // which the compile below makes objects of in parallel, each at most once
    // for what it holds (`unit_objects`). A release build's are optimised
    // together when linked (`lto_words`). The one file is for reading.
    string8 units_dir = txt(#format(c_file[0..<#len(c_file) - 2], ".units"))
    // The single-header libraries' implementations (a `define` named
    // `*_IMPL`) as a unit of their own, compiled once while nothing of
    // theirs moves; without it every unit that includes the header defined
    // them again, and the link refused the duplicates.
    string8 impl_file = impl_file_of(c_file)
    // **Units aligned with files** for a dev build: an edit recompiles its
    // own file's unit. `DADO_UNIT_BYTES`, when set, decides instead.
    (string8 _, bool sized) = env("DADO_UNIT_BYTES")
    if !sized && !o.release && !web:
        try os.set_env("DADO_UNIT_BYTES", "1") else: pass
    string8 cache_dir = join2(p.build_dir, ".dado-cache")
    i64 mark = inputs_mark(cache_dir)
    // **A build whose inputs are unchanged does not run the front end**: its
    // answer is the engine's (`front_end`), keyed by the bytes of what it read.
    // Not on the web, whose scripts go beside the module, nor under `--log`.
    bool from_slot = !web && #len(o.log) == 0
    bool atomics = false
    string8 not_tcc = ""
    string8 manifest_text = ""
    if from_slot:
        Emitted fe = front_end(fe_t, p.pkg_abs, cache_dir, o.keep_c, false)
        manifest_text = fe.manifest
        units_dir = fe.units_dir
        impl_file = fe.impl_file
        atomics = fe.atomics
        not_tcc = fe.not_tcc
        if o.keep_c:
            // Copied once per transpile: the slot says where, and the copy's stat.
            string8 copied = join2(fe.slot, "copied")
            if read_or_empty(copied) != txt(#format(c_file, " ", stat_of(c_file))):
                try fs.copy_file(fe.c_file, c_file) else: pass
                write_quietly(copied, txt(#format(c_file, " ", stat_of(c_file))))
            note(txt(#format("       -> ", c_file)))
        else:
            c_file = fe.c_file
    else if web && dadoc_writes_web(p.dadoc):
        manifest_text = web_transpile(fe_t, units_dir, web_scripts, p.pkg_abs)
    else:
        Command split = command_of(t.words[:])
        add(&split, txt(#format("--split-out=", units_dir)))
        add(&split, txt(#format("--implementations=", impl_file)))
        transpile(split, c_file, manifest_file, p.pkg_abs)
        manifest_text = read_or_empty(manifest_file)
        remove_quietly(manifest_file)
    // A freestanding build is one object for the person's own linker, so its
    // C is the one-file text a build without the split writes (`private`
    // `static`, names counted, not hashed): the target was known only now,
    // so `dadoc` runs again, without `--split-out`.
    (Manifest first, bool _, string8 _) = parse_manifest(manifest_text)
    if #len(units_dir) > 0 && first.os == "#NONE":
        if !from_slot:
            remove_tree_quietly(units_dir)
            remove_quietly(impl_file)
        if from_slot && !o.keep_c:
            ref []string8 su = slot_units(units_dir, impl_file, true)
            trash_slot(c_file, su[:])
            c_file = txt(#format(p.build_dir, "/", p.stem, ".c"))
        from_slot = false
        impl_file = impl_file_of(c_file)
        units_dir = ""
        transpile(t, c_file, manifest_file, p.pkg_abs)
        manifest_text = read_or_empty(manifest_file)
        remove_quietly(manifest_file)
    if web: manifest_text = js_modules_last(manifest_text)
    // The C written for cc goes once cc has run (P10j): a slot's units
    // below, when listed; the rest here.
    if !o.keep_c && !from_slot:
        c_trash(c_file)
        if #len(units_dir) > 0: c_trash(units_dir)
        c_trash(impl_file)
    (Manifest m, bool mok, string8 why) = parse_manifest(manifest_text)
    if !mok: die(why)

    ref []string8 includes = include_words(m.includes[:])
    ref []string8 libs = #make([]string8, 0)
    for l in o.libs:
        libs = #append(libs, l)
    for l in m.links:
        libs = #append(libs, l)

    // C's sanitizers: natively their runtime, probed; on `#NONE`, with no
    // runtime to link, the freestanding set (`runtime_free_sanitizer`), and
    // no probe, since nothing of this machine's runs.
    // tcc chosen by default steps aside for C it cannot compile.
    if cc.tcc && #len(not_tcc) > 0:
        if #len(o.cc) > 0: die(txt(#format("tcc cannot compile this program: it uses ", not_tcc, ". Pass --cc gcc, clang or zig")))
        o.cc_fallback = true
        cc = run_compiler(o, true)
        if !cc.found:
            for f in c_compilers():
                if !cc.found: cc = found_compiler(f)
        cc = need(cc)
        note(txt(#format("       tcc steps aside (", not_tcc, "): ", cc.name)))
    if cc.tcc && (o.release || o.sanitize):
        die("tcc compiles dev builds only: --release and C's sanitizers want gcc, clang or the pinned zig (--cc)")
    if !web && m.os != "#NONE":
        (ref []string8 sc, ref []string8 sl, bool son) = configure_sanitizers(cc, o.sanitize, o.sanitize_kind)
        san_c = sc
        san_l = sl
        sanitized = son
    else if m.os == "#NONE":
        san_c = runtime_free_sanitizer(o, m.os, "CFLAGS_SANITIZE_NONE")

    if #len(m.engine) > 0: engine_refusals(m.engine, m.os)
    if #len(m.engine) > 0 && m.os != "#WEB":
        string8 engine_dir = engine_archive(cc, p.target_flag, san_c[:])
        if #len(engine_dir) == 0:
            die(txt(#format("the DadoScript engine did not build, and this program runs scripts.\n  tools/quickjs/build.sh --cc ", cc.name, " builds it and says why it did not.")))
        note(txt(#format("       + engine: ", engine_dir)))
        includes = #append(includes, txt(#format("-I", engine_dir)))
        libs = #append(libs, join2(engine_dir, "libquickjs.a"))
        libs = #append(libs, "-lm")

    // The units, in link order; none for a freestanding build, whose single
    // object is what the person's own linker is handed.
    ref []string8 units = #make([]string8, 0)
    if #len(units_dir) > 0 && m.os != "#NONE": units = slot_units(units_dir, impl_file, from_slot)
    if from_slot && !o.keep_c: trash_slot(c_file, units[:])
    g_units = units
    g_units_cache = join2(p.build_dir, ".dado-cache")

    if m.os == "#WEB":
        return web_build(p, o, &m, manifest_text, c_file, g_html_flag)
    // The program's name for its target, known only now: `.exe` for
    // Windows, unless `-o` named it.
    if !o.out_given: out = program_name(out, m.os)

    string8 brew = brew_prefix()
    if #len(brew) > 0 && is_dir(join2(brew, "include")):
        includes = #append(includes, txt(#format("-I", join2(brew, "include"))))
    (string8 user_cflags, bool _) = env("DADO_CFLAGS")
    for w in words_of(user_cflags):
        includes = #append(includes, w)
    ref []string8 all_libs = #make([]string8, 0)
    if #len(brew) > 0 && is_dir(join2(brew, "lib")):
        all_libs = #append(all_libs, txt(#format("-L", join2(brew, "lib"))))
    for l in libs:
        all_libs = #append(all_libs, l)

    if #len(m.sources) > 0:
        ref []char8 listed_c = strings.join(m.sources[:], " ")
        note(txt(#format("       + C: ", txt(listed_c))))

    Link k = new_link()
    k.cc = command_of(cc.words[:]).words
    k.base = words_of(setting("CFLAGS_BASE"))
    k.interop = words_of(setting("CFLAGS_INTEROP"))
    if o.werror: k.werror = words_of(setting("CFLAGS_WERROR"))
    k.opt = opt_words(o, cc.zig)
    if cc.tcc:
        k.base = tcc_words(g_units_cache, atomics)
        k.interop = #make([]string8, 0)
        k.werror = #make([]string8, 0)
        k.opt = #make([]string8, 0)
    // No link-time optimisation for `#NONE`: its object goes to the person's
    // own linker, which may not read bitcode (binutils' `ld` without the
    // plugin sees a `bfd plugin:` symbol and none of the code), so it is
    // machine code at `-O2`, linked here or not.
    if m.os != "#NONE":
        for w in lto_words(o, cc_family(cc), m.os):
            k.opt = #append(k.opt, w)
    k.extra = m.flags
    k.san_c = san_c
    k.includes = includes
    k.c_file = c_file
    k.sources = m.sources
    k.out = out
    k.libs = all_libs
    k.exports = export_flags(m.os, m.exports[:], cc.zig || cc.tcc)
    k.san_l = san_l
    (string8 user_ldflags, bool _) = env("DADO_LDFLAGS")
    k.ldflags = words_of(user_ldflags)
    // Every `#NONE` compile, linked or not (`CFLAGS_NONE`): an object for
    // the person's own link, which has no UBSan runtime and no stack
    // protector's `__stack_chk_fail`, whatever the compiler's defaults.
    if m.os == "#NONE": k.freestanding = words_of(setting("CFLAGS_NONE"))
    // A `#NONE` triple for another machine: zig is told it (`zig_target_of`);
    // a gcc or clang `--cc` names is checked against it here.
    if m.os == "#NONE" && !cc.zig: k.cc = none_cross_words(cc, p.target_flag)

    Failure f
    f.kept = o.keep_c
    f.cc = cc
    f.cmd = cmd
    f.pkg = o.pkg
    f.c_file = c_file
    f.headers = m.headers
    f.toolchain = m.toolchain
    f.sources = m.sources
    f.extra = m.flags
    f.includes = includes
    // A lone file's directory is not its package: its C is not the program's.
    f.dir = "" if strings.ends_with(p.pkg_abs, ".dado") else p.pkg_abs

    // A freestanding target: compile, and stop at the object file.
    if m.os == "#NONE" && !o.link:
        if cmd != "build":
            die(txt(#format("`dado ", cmd, "` cannot run a freestanding build.\n\n  The resolved target's `#OS` is `#NONE`, which is the assertion that there\n  is no operating system and no libc here — so there is no process for this\n  machine to start. A freestanding implementation's entry point is\n  implementation-defined (C99 §5.1.2.1) and this driver has none to supply.\n\n  `dado build ", o.pkg, "` compiles the generated C and stops at the object file, which is the\n  thing to hand your own linker. `--link` links it here anyway, with your own\n  DADO_LDFLAGS — a linker script and an entry point are then yours to pass.")))
        if !o.out_given: out = txt(#format(p.build_dir, "/", p.stem, ".o"))
        say(txt(#format("cc     ", cc.name, " (freestanding: compile only)")))
        strings.Builder objects = strings.builder(128)
        ref []string8 units = #make([]string8, 0)
        units = #append(units, c_file)
        for s in m.sources:
            units = #append(units, s)
        for tu in units:
            string8 obj = out
            if tu != c_file:
                string8 b = path.base(tu)
                if strings.ends_with(b, ".c"): b = b[0..<#len(b) - 2]
                obj = join2(dir_of(c_file), txt(#format(b, ".o")))
            if run(object_command(&k, tu, obj)) != 0:
                explain_cc_failure(&f)
            note(txt(#format("       -> ", obj)))
            strings.append(&objects, " ")
            strings.append(&objects, obj)
        drop_c()
        note("       not linked: a freestanding entry point is implementation-defined")
        note("       (C99 §5.1.2.1). Link it with your own script, or pass --link.")
        say_green("compiled", strings.text(objects))
        return 0

    say(txt(#format("cc     ", cc.name)))
    if #len(units) > 0:
        // Each unit's object, then one link of them all.
        UnitsJob uj
        uj.cache = g_units_cache
        uj.cc_id = compiler_identity(cc)
        uj.flags = compile_flags(&k)
        uj.includes = includes
        // `DADO_JOBS` as `dado test` reads it; the output is the same whatever N.
        (string8 jobs_env, bool _) = env("DADO_JOBS")
        (i32 nj, bool jok) = jobs_of("", jobs_env, os.cpu_count())
        if !jok: die(txt(#format("DADO_JOBS takes a number of jobs, 1 or more, not `", jobs_env, "`")))
        uj.jobs = nj
        // The `C` sources the manifest names are compiled to objects of
        // their own, as the units are and cached the same way, so the link
        // compiles nothing: it can then take its own `-O` (`link_opt_words`).
        UnitsJob sj = uj
        sj.flags = compile_flags(&k)
        // A release build's units keep their symbols to the program
        // (ELF and Mach-O), so the link can drop and inline across files
        // what nobody outside calls; an `export` is `DADO_EXPORT`, seen
        // still. The manifest's own C keeps its visibility.
        if o.release && m.os != "#WINDOWS": add(&uj.flags, "-fvisibility=hidden")
        // A slot whose C an earlier build dropped (P10j): its objects, by
        // what its units held; one gone, the front end runs again for the C.
        ref []string8 objects = #make([]string8, 0)
        bool uok = true
        bool have = false
        if from_slot && !is_file(units[0]):
            (ref []string8 owned_objs, bool found) = owned_objects(uj.cache, units_key(&uj), units[:], join2(units_dir, "owns"))
            if found:
                objects = owned_objs
                have = true
            else:
                Emitted fe2 = front_end(fe_t, p.pkg_abs, cache_dir, true, true)
                units_dir = fe2.units_dir
                impl_file = fe2.impl_file
                units = slot_units(units_dir, impl_file, true)
                g_units = units
        if !have:
            (ref []string8 got, bool gok) = unit_objects(&uj, units[:])
            objects = got
            uok = gok
        (ref []string8 source_objects, bool sok) = unit_objects(&sj, m.sources[:])
        // An object a concurrent build swept between the check and here is
        // compiled again, once.
        if uok && !all_there(objects[:]):
            (ref []string8 again, bool aok) = unit_objects(&uj, units[:])
            objects = again
            uok = aok
        if sok && !all_there(source_objects[:]):
            (ref []string8 again, bool aok) = unit_objects(&sj, m.sources[:])
            source_objects = again
            sok = aok
        if !uok || !sok:
            if sanitized: recheck_sanitizer(cc, san_c[:], san_l[:])
            if !uok: f.c_file = units_dir
            explain_cc_failure(&f)
        if from_slot && !o.keep_c && !have: record_owns(uj.cache, units[:], join2(units_dir, "owns"))
        if o.keep_c: note(txt(#format("       ", #len(units), " files, each compiled once for what it holds: ", units_dir)))
        else: note(txt(#format("       ", #len(units), " files, each compiled once for what it holds")))
        k.c_file = objects[0]
        ref []string8 rest = #make([]string8, 0)
        for i in 1..<#len(objects):
            rest = #append(rest, objects[i])
        for so in source_objects:
            rest = #append(rest, so)
        k.sources = rest
        k.link_opt = link_opt_words(k.opt[:], cc.zig)
        // The link compiles no C of its own, but gcc's and clang's
        // optimisation across files can warn there (`CFLAGS_BASE` is on the
        // line for it), a warning no single file had, and seen only once the
        // files are put together: it is said, and the build is not refused
        // for it. The gate asks for `-Werror` there (`DADO_LDFLAGS`).
        k.werror = #make([]string8, 0)
        // **No object moved, no link**: the program is left as it is when
        // the last link into it read what this one would (`link_key`) and
        // nothing has written it since.
        Command lc = link_command(&k)
        string8 lkey = link_key(lc, uj.cc_id)
        if link_current(g_units_cache, out, lkey):
            if verbose(): note(txt(#format("       ", out, " is linked from these already")))
        else:
            link_done(g_units_cache, out, "")
            if run(lc) != 0:
                if sanitized: recheck_sanitizer(cc, san_c[:], san_l[:])
                explain_cc_failure(&f)
            link_done(g_units_cache, out, lkey)
        for so in source_objects:
            objects = #append(objects, so)
        sweep_units(g_units_cache, objects[:])
    else if run(link_command(&k)) != 0:
        if sanitized: recheck_sanitizer(cc, san_c[:], san_l[:])
        explain_cc_failure(&f)
    note(txt(#format("       -> ", out)))
    write_inputs(out, manifest_text, p.dadoc, mark)
    save_digests(join2(cache_dir, "digests"))
    drop_c()

    if cmd == "build":
        say_green("built", txt(#format(" ", out)))
        write_manifest_outputs(p, o)
        return 0

    // run
    say(txt(#format("run    ", out)))
    rule()
    (string8 runner, bool _) = env("DADO_RUNNER")
    ref []string8 runner_words = words_of(runner)
    Command prog = command_of(runner_words[:])
    add(&prog, out)
    add_all(&prog, o.args[:])
    default_sigpipe()
    i32 status = run_quietly(prog)
    rule()
    string8 unstarted = exec_failure(out) if status == 127 && #len(runner_words) == 0 else ""
    if #len(unstarted) > 0:
        say_error(unstarted)
        return status
    if status == 0:
        say_green(txt(#format("exit ", status)), "")
    else:
        say(txt(#format("exit ", status)))
    _ = sanitized
    return status

// A program built for a target whose `#OS` is `os`, at `out`, as that
// system names a program: with `.exe` on Windows.
string8 program_name(string8 out, string8 os):
    if os == "#WINDOWS" && !strings.ends_with(out, ".exe"): return txt(#format(out, ".exe"))
    return out

// A slot's or build's units, in link order: `units` names them, the
// implementations unit after. A slot's are listed whether or not its C is
// still there (`from_slot`).
private ref []string8 slot_units(string8 units_dir, string8 impl_file, bool from_slot):
    ref []string8 units = #make([]string8, 0)
    for name in words_of(read_or_empty(join2(units_dir, "units"))):
        units = #append(units, join2(units_dir, name))
    if is_file(impl_file): units = #append(units, impl_file)
    else if from_slot:
        (string8 h, string8 _) = owned(read_or_empty(join2(units_dir, "owns")), impl_file)
        if #len(h) > 0: units = #append(units, impl_file)
    return units

// A slot's C, dropped once cc has run: the one file and each unit; the
// listing, the manifest and `owns` stay (P10j).
private void trash_slot(string8 c_file, []string8 units):
    c_trash(c_file)
    if #len(units) > 0: c_trash(join2(dir_of(units[0]), "dado.h"))
    for u in units:
        c_trash(u)

// Run the transpile `t` (every word but the output and the package) into
// `c_file` by way of a temporary, so a failed run leaves nothing behind.
private void transpile(Command t, string8 c_file, string8 manifest_file, string8 pkg):
    string8 tmp_c = txt(#format(c_file, ".tmp"))
    Command c = command_of(t.words[:])
    add(&c, "-o")
    add(&c, tmp_c)
    add(&c, pkg)
    i32 st = run(c)
    if st != 0:
        if exists(tmp_c):
            remove_quietly(tmp_c)
        remove_quietly(manifest_file)
        die(transpile_failure(st, host_os() == "#WINDOWS"))
    try fs.rename(tmp_c, c_file) else code:
        die(txt(#format("cannot move ", tmp_c, " to ", c_file, ": ", os.message(code))))
        return
    note(txt(#format("       -> ", c_file)))

// Whether `dadoc` is the self-hosted one, which writes a web module's C
// itself (`--emit=web`), and not the frozen Rust dadoc (a rollback,
// `DADO_DADOC`), which took `--scripts-out` and `--split-out` and names its
// `rustc` in `--version`.
private bool dadoc_writes_web(string8 dadoc):
    Command c = command(dadoc)
    add(&c, "--version")
    Captured r = capture(c, true)
    return r.started && !strings.contains(txt(r.out), "\nrustc ")

// The Dado dadoc's web transpile: `--emit=web -o <units>/<stem>` writes
// dado.h, a unit per file, `<stem>.wasm.build` and the scripts; the units are
// listed in `units` and the scripts moved to `scripts`, beside the module.
// Answers the manifest, the whole build manifest (`include`, `source`,
// `flags`, `c-export` rows as natively; rc.10 read the flags from `.flags`
// and had no `source` rows, so a package's `.c` was never compiled).
private string8 web_transpile(Command t, string8 units_dir, string8 scripts, string8 pkg):
    remove_tree_quietly(units_dir)
    try fs.make_dirs(units_dir) else: pass
    string8 stem = path.base(scripts)
    if strings.ends_with(stem, ".scripts"): stem = stem[0..<#len(stem) - 8]
    string8 at = join2(units_dir, stem)
    Command c = command_of(t.words[:])
    add(&c, "--emit=web")
    add(&c, "-o")
    add(&c, at)
    add(&c, pkg)
    i32 st = run(c)
    if st != 0: die(transpile_failure(st, host_os() == "#WINDOWS"))
    ref []string8 names = #make([]string8, 0)
    try fs.Listing l = fs.read_dir(units_dir) else:
        die(txt(#format("cannot read ", units_dir)))
        return ""
    for e in l.entries:
        if !e.is_dir && strings.ends_with(e.path, ".c"):
            string8 nm = txt(strings.clone(e.path))
            i64 j = #len(names)
            names = #append(names, nm)
            for j > 0 && strings.compare(names[j - 1], nm) > 0:
                names[j] = names[j - 1]
                j -= 1
            names[j] = nm
    write_quietly(join2(units_dir, "units"), txt(strings.join(names[:], "\n")))
    if is_dir(txt(#format(at, ".scripts"))):
        remove_tree_quietly(scripts)
        try fs.rename(txt(#format(at, ".scripts")), scripts) else code:
            die(txt(#format("cannot move the scripts to ", scripts, ": ", os.message(code))))
    ref []char8 m = #make([]char8, 0)
    m = #append(m, ..read_or_empty(txt(#format(at, ".wasm.build"))))
    return txt(m)

// A dev build's units (`--split-out`), in link order, or none; and the
// cache their objects go in. Set by `build` for `web_build`.
private ref []string8 g_units
private string8 g_units_cache = ""

// A web build's manifest as the module's `.build` has always held it: the
// `js-module` lines, which `dadoc` writes before its `pass` lines, moved to
// the end, and everything else in its order.
string8 js_modules_last(string8 text):
    strings.Builder rest = strings.builder(#len(text) + 1)
    strings.Builder js = strings.builder(64)
    string8 left = text
    for #len(left) > 0:
        (string8 l, string8 tail, bool more) = strings.line(left)
        if strings.starts_with(l, "js-module "):
            strings.append_char(&js, '\n')
            strings.append(&js, l)
        else:
            strings.append(&rest, l)
            strings.append_char(&rest, '\n')
        if !more: break
        left = tail
    string8 head = txt(strings.finish(&rest))
    return txt(#format(strings.trim_right(head), txt(strings.finish(&js))))

// The text of the file at `p`, or "" when it cannot be read.
string8 read_or_empty(string8 p):
    try ref []char8 t = fs.read_file(p) else:
        return ""
    return txt(t)

void remove_quietly(string8 p):
    try fs.remove_file(p) else:
        return
