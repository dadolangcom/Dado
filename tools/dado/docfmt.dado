// `dado fmt` and `dado doc`.
//
// **`fmt` formats files, not packages**: each `.dado` file is rewritten in
// place with `dadoc --format`'s output, every comment kept. The new text goes
// over the old file's bytes rather than replacing the file, so its mode, an
// editor holding it open and a symlink to it all still see the file that was
// formatted. `--check` writes nothing and lists the files that would change,
// exiting 1 when any would. A file that does not parse is never rewritten:
// it is reported and the command fails.
//
// **`doc` builds and runs `tools/doc`**, through this driver's own `build`
// and `run`, so the tool is compiled the way every program is. These are
// the forms that write a file; `gendocs.dado` holds the rest of `dado doc`
// (a page on standard output, `--check`, `--write`) and comes here for them:
//
//     dado doc <package> --spine FILE [-o FILE] [--ext SUFFIX]
//     dado doc reference -o FILE [--captions FILE]
//     dado doc params [PATH...]
//
// `reference` renders every roster `dadoc --emit=lexicon` prints; `params`
// checks the `//` comment above each function, method and channel against the
// parameters `dadoc --emit=declarations` says it has (warnings only). The
// words `reference` and `params` are matched as written, so a directory of
// either name is still reachable as `./reference`.
package driver

import "core:io"
import "core:os"
import "core:os/fs"
import "core:strings"

// ── fmt ─────────────────────────────────────────────────────────────────────

// Write `text` over the bytes of the file at `p`, truncating it, keeping the
// file itself.
private bool write_over(string8 p, string8 text):
    ref []char8 cp = strings.clone_to_cstring(p, #default)
    ^io.FILE f = io.open(cstring(cp), "wb")
    if !io.opened(f): return false
    []char8 bytes = strings.bytes(text)
    i64 wrote = io.write_bytes(f, bytes)
    i32 closed = io.close(f)
    return wrote == #len(bytes) && closed == 0

i32 format_files([]string8 files, bool check):
    if #len(files) == 0:
        die("no file given. Try: dado fmt corpus/tour/main.dado")
    string8 dadoc_path = dadoc()
    i64 changed = 0
    i64 failed = 0
    for f in files:
        if !is_file(f):
            die(txt(#format("no such file: ", f, "\n\n  `fmt` takes .dado files and not a package: a package is a directory, and\n  which files in it are yours to format is a question your shell answers.\n  Try:  dado fmt ", f, "/*.dado")))
        Command c = command(dadoc_path)
        add(&c, "--format")
        add(&c, f)
        Captured r = capture(c, false)
        if !r.started || r.status != 0:
            say_red("FAIL", txt(#format(" ", f, " (not formatted)")))
            failed += 1
            continue
        string8 formatted = txt(r.out)
        if formatted == read_or_empty(f): continue
        changed += 1
        if check:
            fmt_line(f)
        else:
            if !write_over(f, formatted):
                die(txt(#format("cannot write ", f)))
            say_green("formatted", txt(#format(" ", f)))
    if failed > 0:
        die(txt(#format(failed, " file(s) were not formatted, because they do not parse.\n  A formatter that renders a tree the parser could not finish reading writes\n  back a file with the unreadable part missing, so it declines.")))
    if check && changed > 0: return 1
    return 0

private void fmt_line(string8 s):
    _ = io.flush(io.stdout())
    ref []char8 l = #format(s, "\n")
    string8 t = l
    _ = io.write_bytes(io.stdout(), strings.bytes(t))

// ── doc ─────────────────────────────────────────────────────────────────────

// This driver run again with `words`, its standard output thrown away when
// `quiet`; its status.
i32 again([]string8 words, bool quiet):
    Command c = command(executable())
    add_all(&c, words)
    if quiet:
        Captured r = capture(c, false)
        if !r.started: return 127
        return r.status
    default_sigpipe()
    return run_quietly(c)

// The `.dado` and `.dados` files under each of `roots` (a file is itself),
// in byte order of their paths.
ref []string8 sources_under([]string8 roots):
    ref []string8 out = #make([]string8, 0)
    for r in roots:
        if is_file(r):
            if strings.ends_with(r, ".dado") || strings.ends_with(r, ".dados"):
                _ = #append(out, r)
            continue
        fs.Listing l = fs.walk(r, #default)
        for e in l.entries:
            if e.is_dir: continue
            if strings.ends_with(e.path, ".dado") || strings.ends_with(e.path, ".dados"):
                ref []char8 copy = #format(e.path)
                _ = #append(out, txt(copy))
    sort_bytes(out[:])
    return out

// `items` in byte order, in place.
void sort_bytes([]string8 items):
    for i in 1..<#len(items):
        string8 v = items[i]
        i64 j = i - 1
        for j >= 0 && strings.compare(items[j], v) > 0:
            items[j + 1] = items[j]
            j -= 1
        items[j + 1] = v

i32 doc(string8 what, []string8 paths, string8 out_given, string8 spine, string8 ext, string8 captions_given):
    if #len(what) == 0:
        die("dado doc: which package? (dado doc <package> [-o <file>] [--spine <file>] [--ext <suffix>], dado doc reference, or dado doc params [path...])")
    string8 tool = join2(root(), join2("tools", "doc"))
    if !is_dir(tool):
        die(txt(#format("dado doc: this toolchain ships no doc tool (", tool, " is not there)")))
    string8 build = build_dir()
    if what == "params":
        return doc_params(tool, build, paths)
    if #len(paths) > 0:
        die(txt(#format("dado doc: unknown option ", paths[0])))
    string8 out = out_given
    if #len(out) == 0:
        string8 name = what
        for #len(name) > 1 && (name[#len(name) - 1] == '/' || name[#len(name) - 1] == '\\'):
            name = name[0..<#len(name) - 1]
        ref []char8 base = #format(build, "/", path_base(name), ".md")
        out = txt(base)
    _ = fs.make_dirs(dir_of(out), #default)
    ref []string8 w = #make([]string8, 0)
    _ = #append(w, "run")
    _ = #append(w, tool)
    _ = #append(w, "--")
    if what == "reference":
        if #len(spine) > 0:
            die("dado doc reference: --spine is for a scanned tree, not for the rosters")
        string8 dadoc_path = dadoc()
        _ = fs.make_dirs(build, #default)
        string8 lexicon = txt(#format(build, "/lexicon.tsv"))
        Command lc = command(dadoc_path)
        add(&lc, "--emit=lexicon")
        Captured lr = capture(lc, false)
        if !lr.started || lr.status != 0:
            die(txt(#format("dado doc reference: ", dadoc_path, " --emit=lexicon failed")))
        try fs.write_file(lexicon, txt(lr.out)) else code:
            die(txt(#format("cannot write ", lexicon, ": ", os.message(code))))
            return 1
        string8 captions = captions_given
        if #len(captions) == 0: captions = join3(root(), "tests", "doc-captions.txt")
        // An install with no captions still gets every roster, uncaptioned.
        if !is_file(captions):
            captions = txt(#format(build, "/no-captions.tsv"))
            try fs.write_file(captions, "") else code:
                die(txt(#format("cannot write ", captions, ": ", os.message(code))))
                return 1
        _ = #append(w, "reference")
        _ = #append(w, lexicon)
        _ = #append(w, captions)
        _ = #append(w, out)
        return again(w[:], false)
    if #len(spine) > 0:
        _ = #append(w, "build")
        _ = #append(w, what)
        _ = #append(w, spine)
        _ = #append(w, out)
    else:
        _ = #append(w, "bare")
        _ = #append(w, what)
        _ = #append(w, out)
    _ = #append(w, "--ext")
    _ = #append(w, ext)
    return again(w[:], false)

private string8 path_base(string8 p):
    i64 at = #len(p) - 1
    for at >= 0 && p[at] != '/' && p[at] != '\\':
        at -= 1
    return p[at + 1..<#len(p)]

// The most words one run of the doc tool is handed: the process starter's
// cap, less the program and `params`, rounded down to whole pairs.
private const i64 PAIRS_PER_RUN = 120

private i32 doc_params(string8 tool, string8 build, []string8 given):
    string8 dadoc_path = dadoc()
    string8 coll = collections()
    ref []string8 roots = #make([]string8, 0)
    for g in given:
        _ = #append(roots, g)
    if #len(roots) == 0:
        // Named relative to here when under here, so a warning's path is
        // one to click.
        string8 shown_coll = coll
        string8 here = working_dir()
        if #len(coll) > #len(here) + 1 && strings.starts_with(coll, here) && coll[#len(here)] == '/':
            shown_coll = coll[#len(here) + 1..<#len(coll)]
        _ = #append(roots, shown_coll)
    string8 tmp = txt(#format(build, "/doc-params"))
    remove_tree_quietly(tmp)
    if !fs.make_dirs(tmp, #default):
        die(txt(#format("dado doc params: cannot make ", tmp)))
    string8 doc_bin = txt(#format(tmp, "/doc"))
    ref []string8 bw = #make([]string8, 0)
    _ = #append(bw, "build")
    _ = #append(bw, tool)
    _ = #append(bw, "-o")
    _ = #append(bw, doc_bin)
    if again(bw[:], true) != 0:
        die("dado doc params: building the doc tool failed")
    ref []string8 files = sources_under(roots[:])
    if #len(files) == 0:
        ref []char8 rj = strings.join(roots[:], " ")
        die(txt(#format("dado doc params: no .dado or .dados file under ", txt(rj))))
    ref []string8 pairs = #make([]string8, 0)
    i64 n = 0
    for f in files:
        n += 1
        string8 decl = txt(#format(tmp, "/", n, ".decl"))
        Command dc = command(dadoc_path)
        add(&dc, txt(#format("--collections=", coll)))
        add(&dc, "--emit=declarations")
        add(&dc, f)
        Captured r = capture(dc, true)
        string8 dump = txt(r.out)
        (string8 first, string8 _, bool _) = strings.line(dump)
        if r.started && first == "declarations 1":
            try fs.write_file(decl, dump) else code:
                die(txt(#format("cannot write ", decl, ": ", os.message(code))))
                return 1
            _ = #append(pairs, decl)
            _ = #append(pairs, f)
        else:
            warn(txt(#format("dado doc params: ", f, ": ", dadoc_path, " dumped no declarations, so its comments were not checked")))
    // The tool takes the pairs in runs no longer than one process can be
    // handed; it prints only warnings, per pair and in order, so the runs'
    // output is the one run's.
    i64 at = 0
    for at < #len(pairs):
        i64 end = at + 2 * PAIRS_PER_RUN
        if end > #len(pairs): end = #len(pairs)
        Command tc = command(doc_bin)
        add(&tc, "params")
        add_all(&tc, pairs[at..<end])
        if run_quietly(tc) != 0:
            die("dado doc params: the doc tool failed")
        at = end
    remove_tree_quietly(tmp)
    return 0
