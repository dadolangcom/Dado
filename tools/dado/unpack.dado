// `dado install` from an unpacked release archive: the first half of
// installing Dado, which `install.sh` (`install.bat` on Windows) starts.
//
// An archive holds `dado`, `dadoc`, `dado-lsp` and a few files beside them;
// every line of Dado source arrives by a clone. So, from the folder this
// program sits in, when no toolchain is there yet (no `src/`):
//
// 1. `install.journal` gets its `begin <version>` (the record `dado uninstall`
//    reverses from);
// 2. the repository is cloned into `src/` at the tag of this driver's version
//    (`v1.0.0` for 1.0.0), so an install starts from the pair that was tested
//    together; a `-dev` driver takes the default branch; `DADO_BOOTSTRAP_REF`
//    names another. Where from is the archive's copy of `tools/dado/defaults`
//    (`REPO_URL`), or `DADO_REPO_URL`;
// 3. this program is copied to `bin/dado`, the one PATH links to.
//
// Then the install carries on as `dado install` does in an install: the
// pinned zig (`ensure_pinned_zig`), the tools, PATH, the editors. Each step
// is skipped when its result is already there, so running `install.sh` again
// after an interruption carries on from where it stopped.
package driver

import "core:fmt"
import "core:os"
import "core:os/fs"
import "core:strings"

private void unpack_said(string8 line):
    fmt.eprintln("install: ", line)

// Whether this run of `dado install` is from an unpacked archive, and if so
// lay the toolchain out under the archive's folder (above) so `start` finds
// an install there. Nothing happens when a toolchain is already found.
void unpack_archive():
    try string8 exe = os.executable_path() else code:
        die(txt(#format("cannot tell where this program is (", os.message(code), "), so there is no folder to install into.")))
        return
    string8 install = dir_of(exe)
    if locate(install).found: return
    if !is_file(join2(install, exe_name("dadoc"))):
        die(txt(#format("dado install sets up the folder a release archive was unpacked into, and\n    ", install, "\n  holds no dadoc beside this program. Unpack a release and run its install.sh there.")))
    string8 version = #DADO_VERSION
    begin_journal(install, version)
    clone_src(install, version)
    string8 bin = join2(install, "bin")
    try fs.make_dirs(bin) else code:
        die(txt(#format("cannot make ", bin, ": ", os.message(code))))
    string8 dest = join2(bin, exe_name("dado"))
    if !is_file(dest):
        string8 tmp = txt(#format(dest, ".", os.pid()))
        try fs.copy_file(exe, tmp) else code:
            die(txt(#format("cannot copy ", exe, " to ", tmp, ": ", os.message(code))))
        move_or_die(tmp, dest)
    unpack_said(txt(#format("dado ", version, ": ", dest)))

// `begin <version>` appended to the journal, which is made if there is none.
// Not a change outside the install, so not counted as one
// (`DADO_INSTALL_STOP_AFTER` counts `journal_append`'s).
private void begin_journal(string8 install, string8 version):
    string8 p = journal_path(install)
    string8 before = read_or_empty(p)
    string8 sep = "\n" if #len(before) > 0 && !strings.ends_with(before, "\n") else ""
    string8 line = txt(#format(before, sep, "begin\t", version, "\n"))
    try fs.write_file(p, line) else code:
        die(txt(#format("cannot write the install journal ", p, ": ", os.message(code), ".\n  Make the folder writable, then run install.sh again.")))

// Where the repository is cloned from: `DADO_REPO_URL`, else `REPO_URL` in
// the archive's copy of the driver's settings (`defaults`).
private string8 repo_url(string8 install):
    (string8 over, bool set) = env("DADO_REPO_URL")
    if set && #len(over) > 0: return over
    string8 p = join2(install, "defaults")
    try ref []char8 text = fs.read_file(p) else code:
        die(txt(#format("cannot read ", p, " (", os.message(code), "), which names the repository to install from.\n  Unpack the release archive again, or set DADO_REPO_URL.")))
        return ""
    (ref []Setting parsed, bool ok, string8 why) = parse_defaults(txt(text))
    if !ok: die(txt(#format(p, ": ", why)))
    (string8 url, bool found) = setting_in(parsed[:], "REPO_URL")
    if !found: die(txt(#format(p, " has no REPO_URL line: unpack the release archive again, or set DADO_REPO_URL")))
    return url

// `src/`: the repository, at this version's tag.
private void clone_src(string8 install, string8 version):
    string8 src = join2(install, "src")
    if is_dir(join2(src, ".git")) && is_dir(join3(src, "collections", "core")): return
    string8 repo = repo_url(install)
    string8 wanted = ""
    (string8 r, bool rset) = env("DADO_BOOTSTRAP_REF")
    if rset && #len(r) > 0: wanted = r
    else if !strings.contains(version, "-dev"): wanted = txt(#format("v", version))
    string8 staging = txt(#format(src, ".clone-", os.pid()))
    remove_tree_quietly(staging)
    string8 at = ""
    if #len(wanted) > 0: at = txt(#format(" at ", wanted))
    unpack_said(txt(#format("cloning ", repo, at)))
    Command c = command("git")
    add_all(&c, words_of("clone --quiet"))
    add(&c, repo)
    add(&c, staging)
    c.echoed = false
    if run(c) != 0:
        remove_tree_quietly(staging)
        die(txt(#format("git could not clone ", repo, ".\n  The collections and tools arrive by a clone: install git if there is none, then run install.sh again.")))
    if #len(wanted) > 0:
        Command k = command("git")
        add(&k, "-C")
        add(&k, staging)
        add_all(&k, words_of("-c advice.detachedHead=false checkout --quiet"))
        add(&k, wanted)
        k.echoed = false
        if run(k) != 0:
            remove_tree_quietly(staging)
            die(txt(#format(repo, " has no ", wanted, ", the tag this release was made as.\n  Set DADO_BOOTSTRAP_REF to the branch or tag to install from.")))
    move_or_die(staging, src)
