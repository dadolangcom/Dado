// Colour in the driver's own lines, and the choice it hands to `dadoc`.
//
//     dado build corpus/tour --color=never
//     NO_COLOR=1 dado test collections/core/strings
//
// `--color=auto|always|never` is declared on every verb. `auto`, the
// default, colours only when standard output is a terminal and `NO_COLOR` is
// unset or empty (https://no-color.org); `always` and `never` decide
// outright, `NO_COLOR` included. Without the flag, a `DADO_COLOR` already in
// the environment is the choice, so a parent `dado` and the one it starts to
// rebuild a tool agree.
//
// **The choice goes to every child as `DADO_COLOR`**, which is how `dadoc`
// hears it: its diagnostics are its own to colour, and it reads the variable
// before its own `NO_COLOR` and terminal checks.
//
// The colours are the brand's, as the compiler's are: copper for `FAIL` and
// `error:`, slate for the dim lines, bold for `warning:`. Truecolour when
// `COLORTERM` is `truecolor` or `24bit`, else the nearest of the 256-colour
// palette (copper is 173, slate 247). `ok`, `built` and the rest keep the
// terminal's own green, which every palette has.
package driver

import "core:flags"
import "core:os"

private flags.TextFlag g_color_flag
private string8 g_color_choice = "auto"

// The flag, on every verb and on the words before one.
void declare_colour(^flags.Parser p):
    g_color_flag = p.choice("--color", "=auto|always|never", "colour the output: on a terminal (auto), always or never; NO_COLOR=1 is never", "auto")

// Read `--color` off a parsed command line, export it as `DADO_COLOR`, and
// let the next line written ask again.
void settle_colour(^flags.Parser p):
    (string8 env_choice, bool _) = env("DADO_COLOR")
    g_color_choice = colour_choice(p.value(g_color_flag), p.given(g_color_flag), env_choice)
    try os.set_env("DADO_COLOR", g_color_choice) else:
        warn("cannot set DADO_COLOR for the compiler: its diagnostics decide colour by themselves")
    recolour()

// The choice: the flag when it was given, else a valid `DADO_COLOR`, else
// `auto`. Always one of the three literals, never a view of the command
// line, so it may be kept for the whole run.
string8 colour_choice(string8 flag, bool given, string8 env_choice):
    string8 v = flag if given else env_choice
    if v == "always": return "always"
    if v == "never": return "never"
    return "auto"

// Whether the driver colours its own lines, for a choice, a `NO_COLOR` value
// and whether standard output is a terminal.
bool colour_wanted(string8 choice, string8 no_color, bool terminal):
    if choice == "always": return true
    if choice == "never": return false
    return #len(no_color) == 0 && terminal

// Whether this run colours its own lines.
bool colour_on():
    (string8 no, bool _) = env("NO_COLOR")
    return colour_wanted(g_color_choice, no, os.is_terminal(1))

// Copper and slate as foreground escapes: 24-bit when `deep`, else the
// nearest 256-colour index.
string8 copper_escape(bool deep):
    if deep: return "\x1b[38;2;229;139;87m"
    return "\x1b[38;5;173m"

string8 slate_escape(bool deep):
    if deep: return "\x1b[38;2;154;163;173m"
    return "\x1b[38;5;247m"

// Whether the terminal says it draws 24-bit colour.
bool colour_deep():
    (string8 ct, bool _) = env("COLORTERM")
    return ct == "truecolor" || ct == "24bit"
