@test
// The pure half of `dado package`: `dado.json` read and written, names,
// semver and the bump, remote URLs, the README's summary, R24's scan, and the
// index's lines and insertion.
package driver

import "core:mem/arena"
import "core:mem/libc"
import "core:strings"

private bool same(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is `", got, "`, not `", want, "`")

private bool manifests():
    bool ok = true
    string8 text = "{\n  \"name\": \"Clipper2\",\n  \"version\": \"1.4.2\",\n  \"description\": \"Polygon clipping.\",\n  \"licence\": \"BSL-1.0\",\n  \"repository\": \"https://github.com/o/clipper2\",\n  \"targets\": [\n    \"native\",\n    \"web\"\n  ]\n}\n"
    (Library lib, bool good, string8 why) = parse_library(text)
    ok = #expect(good, "the manifest was refused: ", why) && ok
    ok = same(lib.name, "Clipper2", "name") && ok
    ok = same(lib.version, "1.4.2", "version") && ok
    ok = #expect(#len(lib.targets) == 2 && lib.targets[1] == "web", "targets read as ", #len(lib.targets)) && ok
    ok = same(render_library(lib), text, "the manifest written back") && ok
    // Empty marks a project.
    (Library _, bool empty, string8 _) = parse_library("  \n")
    ok = #expect(empty, "an empty dado.json was refused") && ok
    (Library _, bool braces, string8 _) = parse_library("{}")
    ok = #expect(braces, "{} was refused") && ok
    // Refusals name what is wrong.
    (Library _, bool k, string8 kwhy) = parse_library("{\"license\": \"MIT\"}")
    ok = #expect(!k && strings.contains(kwhy, "`licence`"), "license is not pointed at licence: ", kwhy) && ok
    (Library _, bool u, string8 uwhy) = parse_library("{\"homepage\": \"x\"}")
    ok = #expect(!u && strings.contains(uwhy, "`homepage`"), "an unknown key: ", uwhy) && ok
    (Library _, bool v, string8 vwhy) = parse_library("{\"version\": \"1.2\"}")
    ok = #expect(!v && strings.contains(vwhy, "semver"), "a bad version: ", vwhy) && ok
    (Library _, bool t, string8 _) = parse_library("{\"targets\": \"web\"}")
    ok = #expect(!t, "a string for targets was taken") && ok
    (Library _, bool arr, string8 _) = parse_library("[1]")
    ok = #expect(!arr, "an array was taken as the manifest") && ok
    (Library _, bool bad, string8 _) = parse_library("{name: 1}")
    ok = #expect(!bad, "bad JSON was taken") && ok
    // A field holds no control character; `repository` nothing a URL in
    // the index line cannot.
    for bad in ["{\"description\": \"a\\nb\"}", "{\"description\": \"a\\tb\"}", "{\"name\": \"a\\rb\"}", "{\"targets\": [\"na\\ntive\"]}", "{\"repository\": \"https://h/a b\"}", "{\"repository\": \"https://h/a)b\"}", "{\"repository\": \"https://h/<a>\"}", "{\"repository\": \"https://h/`a`\"}", "{\"repository\": \"https://h/[a]\"}"]:
        (Library _, bool taken, string8 bwhy) = parse_library(bad)
        ok = #expect(!taken && #len(bwhy) > 0, bad, " was taken") && ok
    Library typed
    typed.name = "x"
    typed.description = "tab\there"
    typed.targets = #make([]string8, 0)
    string8 twhy = library_refusal(typed)
    ok = #expect(strings.contains(twhy, "`description`"), "a typed tab was taken: ", twhy) && ok
    typed.description = "Fine — with a dash."
    string8 fine = library_refusal(typed)
    ok = #expect(#len(fine) == 0, "a fine library was refused: ", fine) && ok
    // Fields left empty stay out.
    Library small
    small.name = "x"
    small.targets = #make([]string8, 0)
    ok = same(render_library(small), "{\n  \"name\": \"x\"\n}\n", "a one-field manifest") && ok
    return ok

private bool names():
    bool ok = true
    for good in ["Clipper2", "libtess2", "a", "my-lib_2"]:
        string8 why = library_name_refusal(good)
        ok = #expect(#len(why) == 0, good, " was refused: ", why) && ok
    for bad in ["", "2d", "-x", "a b", "a/b", "a.b", "core", "Vendor", "LIB"]:
        string8 why = library_name_refusal(bad)
        ok = #expect(#len(why) > 0, "`", bad, "` was taken") && ok
    return ok

private bool versions():
    bool ok = true
    (SemVer v, bool good) = parse_semver("v1.20.3-rc.1")
    ok = #expect(good && v.major == 1 && v.minor == 20 && v.patch == 3 && v.pre == "rc.1", "v1.20.3-rc.1 read wrong") && ok
    for bad in ["1.2", "1.2.3.4", "01.2.3", "1.2.x", "1.2.3-", "", "v", "1..3", "1.2.3-a b"]:
        (SemVer _, bool taken) = parse_semver(bad)
        ok = #expect(!taken, "`", bad, "` was taken as semver") && ok
    // Order, pre-releases included (semver.org's own example chain).
    []string8 chain = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2", "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0", "1.0.1", "1.1.0", "2.0.0"]
    for i in 0..<(#len(chain) - 1):
        (SemVer a, bool _) = parse_semver(chain[i])
        (SemVer b, bool _) = parse_semver(chain[i + 1])
        ok = #expect(semver_less(a, b) && !semver_less(b, a), chain[i], " is not before ", chain[i + 1]) && ok
    // Bumps.
    []string8 cases = ["1.4.2 patch 1.4.3", "1.4.2 minor 1.5.0", "1.4.2 major 2.0.0", "1.4.2 _ 1.4.3", " patch 0.0.1", " minor 0.1.0", " major 1.0.0", "1.3.0-rc.2 minor 1.3.0", "1.3.1-rc.2 minor 1.4.0", "2.0.0-rc.1 major 2.0.0", "1.3.0-rc.2 patch 1.3.0", "1.4.2 2.0.0-beta.1 2.0.0-beta.1", "1.4.2 v1.5.0 1.5.0", " 0.3.0 0.3.0"]
    for c in cases:
        ref []string8 w = strings.split(c, " ")
        string8 answer = "" if w[1] == "_" else w[1]
        (string8 next, string8 why) = next_version(w[0], answer)
        ok = #expect(next == w[2], "`", w[0], "` + `", answer, "` is `", next, "` (", why, "), not ", w[2]) && ok
    for bad in ["1.4.2 1.4.2", "1.4.2 1.0.0", "1.4.2 huge", "1.4.2 1.5", "1.4.2 m", "1.4.2 M", "1.4.2 p"]:
        ref []string8 w = strings.split(bad, " ")
        (string8 next, string8 why) = next_version(w[0], w[1])
        ok = #expect(#len(next) == 0 && #len(why) > 0, "`", w[0], "` + `", w[1], "` was taken as ", next) && ok
    ok = same(newest_semver_tag("v0.1.0\nv1.10.0\nnightly\nv1.9.0\nv1.10.0-rc.1\n"), "1.10.0", "the newest tag") && ok
    ok = same(newest_semver_tag("nightly\n"), "", "the newest of no semver tags") && ok
    // The manifest's version and the tags, local and on origin, together.
    string8 remote = remote_tag_names("aaa\trefs/tags/v0.3.0\nbbb\trefs/tags/v0.3.0^{}\nccc\trefs/tags/v0.10.0\nddd\trefs/heads/main\n")
    ok = same(remote, "v0.3.0\nv0.3.0\nv0.10.0\n", "the tags of ls-remote") && ok
    ok = #expect(has_tag(remote, "v0.10.0") && !has_tag(remote, "v0.1.0"), "has_tag") && ok
    ok = same(newest_semver_tag(txt(#format("0.4.0\nv0.2.0\n", remote))), "0.10.0", "the newest of manifest and tags") && ok
    return ok

private bool urls():
    bool ok = true
    ok = same(public_url("git@forge:o/clipper2.git"), "https://forge/o/clipper2", "scp form") && ok
    ok = same(public_url("ssh://git@forge/o/r.git"), "https://forge/o/r", "ssh URL") && ok
    ok = same(public_url("https://github.com/o/r.git\n"), "https://github.com/o/r", "https with .git") && ok
    ok = same(public_url("https://codeberg.org/o/r/"), "https://codeberg.org/o/r", "https with /") && ok
    // A path or file:// URL keeps its `.git`: it names a directory.
    ok = same(public_url("/srv/git/geo.git"), "/srv/git/geo.git", "a local path") && ok
    ok = same(public_url("file:///srv/git/geo.git/"), "file:///srv/git/geo.git", "a file:// URL") && ok
    ok = same(public_url("C:\\git\\geo.git"), "C:\\git\\geo.git", "a Windows path") && ok
    ok = same(public_url("../geo.git"), "../geo.git", "a relative path") && ok
    ok = #expect(same_repository("git@forge:Owner/Geo.git", "https://forge/owner/geo/"), "one repository, two spellings") && ok
    ok = #expect(!same_repository("https://github.com/a/geo", "https://github.com/b/geo"), "two owners taken as one") && ok
    for web in ["https://github.com/o/r", "http://h/r"]:
        ok = #expect(is_web_url(web), web, " was not taken as a web address") && ok
    for not_web in ["/srv/r.git", "file:///srv/r.git", "https://", "git@h:o/r", ""]:
        ok = #expect(!is_web_url(not_web), not_web, " was taken as a web address") && ok
    return ok

// T62's markers, rewritten by `dado package` and nothing else.
private bool markers():
    bool ok = true
    string8 r = "# Geo\n\n<!-- dado:tests -->\nTests: not run yet.\n<!-- /dado:tests -->\n\n<!-- dado:install -->\nold\nlines\n<!-- /dado:install -->\n\n## Summary\n\nGeometry.\n"
    (string8 out, bool found) = rewrite_markers(r, "Tests: passing on linux-x86_64 with Dado 1.0.0", "`dado get Geo`")
    ok = #expect(found, "the markers were not found") && ok
    ok = same(out, "# Geo\n\n<!-- dado:tests -->\nTests: passing on linux-x86_64 with Dado 1.0.0\n<!-- /dado:tests -->\n\n<!-- dado:install -->\n`dado get Geo`\n<!-- /dado:install -->\n\n## Summary\n\nGeometry.\n", "the rewritten README") && ok
    // An empty text leaves its block alone.
    (string8 kept, bool _) = rewrite_markers(r, "", "`dado get Geo`")
    ok = #expect(strings.contains(kept, "Tests: not run yet.") && strings.contains(kept, "`dado get Geo`\n<!-- /dado:install -->"), "--no-test's README: ", kept) && ok
    // An empty block, CRLF kept, and the author's text outside untouched.
    (string8 crlf, bool fc) = rewrite_markers("A\r\n<!-- dado:tests -->\r\n<!-- /dado:tests -->\r\nB\r\n", "T", "")
    ok = #expect(fc, "an empty block was not found") && ok
    ok = same(crlf, "A\r\n<!-- dado:tests -->\r\nT\r\n<!-- /dado:tests -->\r\nB\r\n", "the CRLF README") && ok
    // No markers, an unclosed one, or one inside fenced code: nothing.
    (string8 none, bool fn) = rewrite_markers("# X\n\nText.\n", "T", "I")
    ok = #expect(!fn && none == "# X\n\nText.\n", "a README without markers was changed") && ok
    (string8 _, bool fu) = rewrite_markers("<!-- dado:tests -->\nx\n", "T", "I")
    ok = #expect(!fu, "an unclosed marker was rewritten") && ok
    string8 fenced_text = "```\n<!-- dado:tests -->\nx\n<!-- /dado:tests -->\n```\n"
    (string8 f, bool ff) = rewrite_markers(fenced_text, "T", "I")
    ok = #expect(!ff && f == fenced_text, "a fenced example was rewritten") && ok
    ok = same(tests_status("macos-aarch64", "1.0.0-rc.7"), "Tests: passing on macos-aarch64 with Dado 1.0.0-rc.7", "the tests line") && ok
    ok = same(install_status("Geo"), "`dado get Geo`", "the install line") && ok
    return ok

private bool readmes():
    bool ok = true
    string8 r = "# Clipper2\n\n<!-- dado:tests -->\nx\n<!-- /dado:tests -->\n\n## Summary\n\nPolygon clipping\nand offsetting.\n\nMore prose.\n\n## Use\n"
    ok = same(readme_summary(r), "Polygon clipping and offsetting.", "the summary") && ok
    ok = same(readme_summary("# X\n\nNo summary.\n"), "", "no summary") && ok
    // An empty summary is "", not the next section's paragraph; comments,
    // on one line or several, are not text.
    ok = same(readme_summary("## Summary\n\n<!-- placeholder -->\n\n## Use\n\nimport x\n"), "", "an empty summary") && ok
    ok = same(readme_summary("## Summary\n<!-- a\n  comment\n-->\nReal text.\n"), "Real text.", "the text after a long comment") && ok
    (i64 n, string8 l) = remote_import("package geo\n\nimport \"core:fmt\"\nimport \"./inner\"\n    import \"lib:other/x\"\n")
    ok = #expect(n == 5 && strings.contains(l, "lib:other"), "the lib: import was found at ", n) && ok
    (i64 m, string8 _) = remote_import("import \"imports:x/y\"\n")
    ok = #expect(m == 1, "an imports: import was missed") && ok
    (i64 z, string8 _) = remote_import("package a\nimport \"../vendored/x\"\n// \"lib:y\"\n")
    ok = #expect(z == 0, "a clean package was flagged at ", z) && ok
    // R24's scan skips the root's build/ and any .git, by the path below the
    // root: a library inside some other `build` folder is still scanned.
    for skipped in ["build/x.dado", "build\\c\\x.dado", ".git/x.dado", "src/.git/hooks/x.dado"]:
        ok = #expect(r24_skips(skipped), skipped, " was scanned") && ok
    for scanned in ["geo.dado", "src/build/x.dado", "src\\build\\x.dado", "builds/x.dado", "build.dado", "x.git/y.dado"]:
        ok = #expect(!r24_skips(scanned), scanned, " was skipped") && ok
    return ok

private bool indexes():
    bool ok = true
    string8 line = index_line("Clipper2", "https://github.com/o/clipper2", "Polygon clipping.")
    ok = same(line, "- [Clipper2](https://github.com/o/clipper2) — Polygon clipping.", "the line") && ok
    (IndexEntry e, bool good) = parse_index_line(line)
    ok = #expect(good && e.name == "Clipper2" && e.url == "https://github.com/o/clipper2" && e.description == "Polygon clipping.", "the line read back") && ok
    string8 good_line = index_line_refusal("Geo", "https://h/o/geo", " Areas — and more. ")
    ok = #expect(#len(good_line) == 0, "a good line was refused: ", good_line) && ok
    for bad in ["https://h/o/(geo)", "https://h/o geo", ""]:
        string8 why = index_line_refusal("Geo", bad, "Areas.")
        ok = #expect(#len(why) > 0, "the url `", bad, "` round-tripped") && ok
    string8 nodesc = index_line_refusal("Geo", "https://h/o/geo", "  ")
    ok = #expect(#len(nodesc) > 0, "an empty description round-tripped") && ok
    for bad in ["- [X](u)", "- [X](a b) — d", "* [X](u) — d", "- [](u) — d", "- [2x](u) — d", "- [X](u) - d", "- [X](u) — "]:
        (IndexEntry _, bool taken) = parse_index_line(bad)
        ok = #expect(!taken, "`", bad, "` was taken as an entry") && ok
    string8 idx = "# DadoPKG\n\nIntro prose.\n\n## Geometry\n\n- [Clipper2](https://a/c) — Clip.\n- [Tess](https://a/t) — Tessellate.\n\n## Unmaintained\n\n- [Old](https://a/o) — Old.\n"
    (IndexEntry f, bool found) = index_find(idx, "clipper2")
    ok = #expect(found && f.category == "Geometry", "clipper2 not found case-insensitively") && ok
    for good in ["Geometry", "Audio and music"]:
        string8 why = category_refusal(good)
        ok = #expect(#len(why) == 0, good, " was refused: ", why) && ok
    for bad in ["", "  ", "Unmaintained", "unMAINTAINED", "## Geo", "a\nb", "a category name far longer than forty characters"]:
        string8 why = category_refusal(bad)
        ok = #expect(#len(why) > 0, "the category `", bad, "` was taken") && ok
    ok = same(index_heading(idx, " geometry "), "Geometry", "an existing heading, matched") && ok
    ok = same(index_heading(idx, " Audio "), "Audio", "a new heading") && ok
    ref []string8 cats = index_categories(idx)
    ok = #expect(#len(cats) == 1 && cats[0] == "Geometry", "the categories are ", #len(cats)) && ok
    // Into an existing section, in sorted place.
    string8 mid = index_insert(idx, "geometry", "Earcut", "- [Earcut](https://a/e) — Ears.")
    ok = #expect(strings.contains(mid, "- [Clipper2](https://a/c) — Clip.\n- [Earcut](https://a/e) — Ears.\n- [Tess]"), "the middle insert:\n", mid) && ok
    string8 first = index_insert(idx, "Geometry", "Arc", "- [Arc](https://a/a) — A.")
    ok = #expect(strings.contains(first, "## Geometry\n\n- [Arc](https://a/a) — A.\n- [Clipper2]"), "the first insert:\n", first) && ok
    string8 last = index_insert(idx, "Geometry", "Zed", "- [Zed](https://a/z) — Z.")
    ok = #expect(strings.contains(last, "- [Tess](https://a/t) — Tessellate.\n- [Zed](https://a/z) — Z.\n\n## Unmaintained"), "the last insert:\n", last) && ok
    // A new section goes before Unmaintained.
    string8 fresh = index_insert(idx, "Audio", "Ogg", "- [Ogg](https://a/g) — Vorbis.")
    ok = #expect(strings.contains(fresh, "- [Tess](https://a/t) — Tessellate.\n\n## Audio\n\n- [Ogg](https://a/g) — Vorbis.\n\n## Unmaintained\n"), "the new section:\n", fresh) && ok
    // And at the end when there is no Unmaintained.
    string8 bare = index_insert("# DadoPKG\n\nProse.\n", "Audio", "Ogg", "- [Ogg](https://a/g) — Vorbis.")
    ok = same(bare, "# DadoPKG\n\nProse.\n\n## Audio\n\n- [Ogg](https://a/g) — Vorbis.\n", "a section in an empty index") && ok
    // An empty section, under its heading.
    string8 empty = index_insert("# I\n\n## Audio\n\n## Geometry\n", "Audio", "Ogg", "- [Ogg](https://a/g) — V.")
    ok = same(empty, "# I\n\n## Audio\n\n- [Ogg](https://a/g) — V.\n\n## Geometry\n", "an empty section") && ok
    string8 prose = index_insert("# I\n\n## Audio\n\nNothing yet.\n", "Audio", "Ogg", "- [Ogg](https://a/g) — V.")
    ok = same(prose, "# I\n\n## Audio\n\n- [Ogg](https://a/g) — V.\n\nNothing yet.\n", "an empty section before prose") && ok
    // A fenced example is prose: its entry and its heading are not read, and
    // an insertion leaves it as it is.
    string8 fence = "```"
    string8 example = txt(#format(fence, "md\n## Example\n\n- [Fake](https://a/f) — In a fence.\n", fence, "\n"))
    string8 tilde = "~~~\n- [Tilde](https://a/t) — In a fence.\n~~~\n"
    string8 doc = txt(#format("# DadoPKG\n\nEach line looks like:\n\n", example, "\n", tilde, "\n## Geometry\n\n- [Tess](https://a/t) — Tessellate.\n"))
    (IndexEntry _, bool fake) = index_find(doc, "Fake")
    ok = #expect(!fake, "an entry inside a ``` fence was read") && ok
    (IndexEntry _, bool tl) = index_find(doc, "Tilde")
    ok = #expect(!tl, "an entry inside a ~~~ fence was read") && ok
    ref []IndexEntry all = index_entries(doc)
    ok = #expect(#len(all) == 1 && all[0].category == "Geometry", "the fenced README has ", #len(all), " entries") && ok
    ref []string8 fcats = index_categories(doc)
    ok = #expect(#len(fcats) == 1 && fcats[0] == "Geometry", "a heading inside a fence was read: ", #len(fcats)) && ok
    string8 into = index_insert(doc, "Geometry", "Arc", "- [Arc](https://a/a) — A.")
    ok = #expect(strings.contains(into, example) && strings.contains(into, "## Geometry\n\n- [Arc](https://a/a) — A.\n- [Tess]"), "the insert beside a fence:\n", into) && ok
    // A fence closes only on its own character, at least as long, alone.
    string8 nested = "# I\n\n````\n```\n## Inner\n```\n- [In](https://a/i) — In.\n````\n\n~~~\n```\n- [Mixed](https://a/m) — M.\n~~~\n\n```\n```js\n- [Info](https://a/n) — N.\n```\n\n## Real\n\n- [Out](https://a/o) — Out.\n"
    ref []IndexEntry nested_entries = index_entries(nested)
    ok = #expect(#len(nested_entries) == 1 && nested_entries[0].name == "Out", "the nested fences read ", #len(nested_entries), " entries") && ok
    ref []string8 nested_cats = index_categories(nested)
    ok = #expect(#len(nested_cats) == 1, "a heading in a nested fence was read") && ok
    string8 example_cat = index_insert(doc, "Example", "Arc", "- [Arc](https://a/a) — A.")
    ok = #expect(strings.contains(example_cat, example) && strings.contains(example_cat, "- [Tess](https://a/t) — Tessellate.\n\n## Example\n\n- [Arc]"), "a fenced heading was taken as the section:\n", example_cat) && ok
    return ok

// The import line `dado get` prints: the alias form when the folder is not
// the package's name.
private bool imports():
    bool ok = true
    ok = same(declared_package("// Geo: helpers.\npackage geo\n\ni32 f():\n"), "geo", "a package after a comment") && ok
    ok = same(declared_package("@test\npackage my_geo // the tests\n"), "my_geo", "a test's package, a comment after it") && ok
    ok = same(declared_package("import \"core:fmt\"\npackage x\n"), "", "a file not opening with its package") && ok
    ok = same(import_line("lib:geo", "geo"), "import \"lib:geo\"", "geo's import") && ok
    ok = same(import_line("lib:my-geo", "my_geo"), "import my_geo \"lib:my-geo\"", "my-geo's import") && ok
    ok = same(import_line("lib:my-geo/shapes", "shapes"), "import \"lib:my-geo/shapes\"", "a subpackage's import") && ok
    ok = same(import_line("lib:geo/two-d", "two_d"), "import two_d \"lib:geo/two-d\"", "a hyphenated subpackage's import") && ok
    ok = same(import_line("lib:geo", ""), "import \"lib:geo\"", "an unknown package's import") && ok
    // What `dado new library` writes agrees.
    ok = same(import_line("lib:my-geo", library_package("My-Geo")), library_import("My-Geo"), "new's import for My-Geo") && ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = manifests()
        ok = names() && ok
        ok = versions() && ok
        ok = urls() && ok
        ok = readmes() && ok
        ok = markers() && ok
        ok = indexes() && ok
        ok = imports() && ok
        if ok: return 0
        return 1
