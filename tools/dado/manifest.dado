// The build manifest: what `dadoc --emit=build` says a program needs beyond
// its own C — include directories, `.c` files beside the sources, the link
// and compile clauses its `foreign` blocks wrote, what the target resolved
// to, and whether it runs DadoScript.
//
// One fact per line, `<kind> <value>`. **Every kind is named here**, the ones
// a build acts on and the ones it only lets past, so a line this driver has
// not been taught is an error rather than a fact dropped without a word: a
// compiler newer than the driver says so at the first build.
package driver

import "core:strings"

// What a build reads from the manifest.
type Manifest:
    ref []string8 includes     // `include`: a package directory, for `-I`
    ref []string8 sources      // `source`: a `.c` file compiled with the program
    ref []string8 headers      // `header`: a header a `foreign` block names
    ref []string8 links        // `link`: link arguments, split on whitespace
    ref []string8 flags        // `flags`: compile arguments, split on whitespace
    ref []string8 exports      // `c-export`: an `export`'s C symbol
    string8 os                 // `os`: the target's `#OS`, as `#LINUX`
    string8 engine             // `engine`: the script engine the program embeds

// The kinds a build has nothing to do with, each named so it is let past on
// purpose: what the compiler resolved the triple to (`target`, `arch`), which
// packages are live, its counts of inline C, macro claims and instances,
// implementation switches, a web module's imports and exports, channels, the
// scripts' JavaScript modules, and which passes ran with what costs and plan.
private const string8 PASSED_OVER = "target arch live inline-c foreign-macro instantiation implementation wasm-import wasm-export channel js-module pass costs plan"

// `text` read as a build manifest. `ok` false, and `why` the line, at the
// first kind this driver does not know.
(Manifest m, bool ok, string8 why) parse_manifest(string8 text):
    Manifest m
    ref []string8 includes = #make([]string8, 0)
    ref []string8 sources = #make([]string8, 0)
    ref []string8 headers = #make([]string8, 0)
    ref []string8 links = #make([]string8, 0)
    ref []string8 flags = #make([]string8, 0)
    ref []string8 exports = #make([]string8, 0)
    m.os = ""
    m.engine = ""
    bool ok = true
    string8 why = ""
    string8 rest = text
    for #len(rest) > 0:
        (string8 line, string8 tail, bool more) = strings.line(rest)
        (string8 kind, string8 after, bool _) = strings.field(line)
        string8 value = strings.trim(after)
        if #len(kind) == 0:
            rest = tail
            if !more: break
            continue
        if kind == "include":
            _ = #append(includes, value)
        else if kind == "source":
            _ = #append(sources, value)
        else if kind == "header":
            _ = #append(headers, value)
        else if kind == "link":
            for w in words_of(value):
                _ = #append(links, w)
        else if kind == "flags":
            for w in words_of(value):
                _ = #append(flags, w)
        else if kind == "c-export":
            _ = #append(exports, value)
        else if kind == "os":
            m.os = value
        else if kind == "engine":
            m.engine = value
        else if !listed(PASSED_OVER, kind):
            ok = false
            why = txt(#format("unrecognised build manifest line: ", kind, " ", value))
            break
        rest = tail
        if !more: break
    m.includes = includes
    m.sources = sources
    m.headers = headers
    m.links = links
    m.flags = flags
    m.exports = exports
    return (m, ok, why)

// Whether `word` is one of the space-separated words of `list`.
bool listed(string8 list, string8 word):
    for w in words_of(list):
        if w == word: return true
    return false
