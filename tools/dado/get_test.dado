@test
// The pure half of `dado get`: the `libraries` pins in `dado.json` read,
// refused and written back, a pin replaced by name, the command line's
// `<what>@<version>`, the name an address gives, and which tag a version
// names.
package driver

import "core:hash"
import "core:mem/arena"
import "core:mem/libc"
import "core:os"
import "core:os/fs"
import "core:strings"

private bool same(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is `", got, "`, not `", want, "`")

private const string8 SHA = "0123456789abcdef0123456789abcdef01234567"

private bool pins():
    bool ok = true
    string8 text = txt(#format("{\n  \"name\": \"app\",\n  \"targets\": [\n    \"native\"\n  ],\n  \"libraries\": {\n    \"Clipper2\": {\n      \"repository\": \"https://github.com/o/clipper2\",\n      \"version\": \"1.4.2\",\n      \"commit\": \"", SHA, "\"\n    },\n    \"geo\": {\n      \"repository\": \"/srv/geo.git\",\n      \"version\": \"release-3\",\n      \"commit\": \"", SHA, "\"\n    }\n  }\n}\n"))
    (Library lib, bool good, string8 why) = parse_library(text)
    ok = #expect(good, "the pins were refused: ", why) && ok
    ok = #expect(#len(lib.libraries) == 2, "the pins read as ", #len(lib.libraries)) && ok
    if #len(lib.libraries) == 2:
        ok = same(lib.libraries[0].name, "Clipper2", "the first pin's name") && ok
        ok = same(lib.libraries[1].version, "release-3", "a tag that is not semver") && ok
        ok = same(lib.libraries[0].commit, SHA, "the commit") && ok
    // Written back as read, the other fields kept.
    ok = same(render_library(lib), text, "the manifest with pins written back") && ok
    // A pin replaced by name, ignoring case, in its place; a new one after.
    Pin moved = Pin(name: "clipper2", repository: "https://github.com/o/clipper2", version: "1.5.0", commit: SHA, hash: "")
    Library after = with_pin(lib, moved)
    ok = #expect(#len(after.libraries) == 2 && after.libraries[0].version == "1.5.0" && after.libraries[0].name == "clipper2", "the pin was not replaced in place") && ok
    ok = same(lib.libraries[0].version, "1.4.2", "the old manifest's pin, after with_pin") && ok
    Library more = with_pin(after, Pin(name: "Tess", repository: "https://h/t", version: "0.1.0", commit: SHA, hash: ""))
    ok = #expect(#len(more.libraries) == 3 && more.libraries[2].name == "Tess", "a new pin was not added last") && ok
    // An empty manifest takes a pin.
    (Library empty, bool e, string8 _) = parse_library("")
    ok = #expect(e, "an empty dado.json was refused") && ok
    string8 one = render_library(with_pin(empty, moved))
    (Library back, bool b, string8 bwhy) = parse_library(one)
    ok = #expect(b && #len(back.libraries) == 1 && back.libraries[0].commit == SHA, "a pin written into an empty manifest did not read back: ", bwhy, "\n", one) && ok
    // Refusals name what is wrong.
    []string8 bads = [
        "{\"libraries\": []}",
        "{\"libraries\": {\"core\": {}}}",
        "{\"libraries\": {\"9x\": {}}}",
        "{\"libraries\": {\"X\": \"1.0\"}}",
        "{\"libraries\": {\"X\": {\"repository\": \"https://h/x\", \"version\": \"1.0.0\"}}}",
        txt(#format("{\"libraries\": {\"X\": {\"repository\": \"https://h/x\", \"version\": \"1.0.0\", \"commit\": \"", SHA, "\", \"tag\": \"v1\"}}}")),
        "{\"libraries\": {\"X\": {\"repository\": \"https://h/x\", \"version\": \"1.0.0\", \"commit\": \"abc\"}}}",
        txt(#format("{\"libraries\": {\"X\": {\"repository\": \"https://h/x\", \"version\": \"1.0.0\", \"commit\": \"", txt(strings.to_upper(SHA)), "\"}}}")),
        txt(#format("{\"libraries\": {\"X\": {\"repository\": \"https://h/a b\", \"version\": \"1.0.0\", \"commit\": \"", SHA, "\"}}}")),
        txt(#format("{\"libraries\": {\"X\": {\"repository\": \"https://h/x\", \"version\": \"a b\", \"commit\": \"", SHA, "\"}}}")),
        txt(#format("{\"libraries\": {\"X\": {\"repository\": \"https://h/x\", \"version\": 1, \"commit\": \"", SHA, "\"}}}")),
        txt(#format("{\"libraries\": {\"X\": {\"repository\": \"https://h/x\", \"version\": \"1.0.0\", \"commit\": \"", SHA, "\"}, \"x\": {\"repository\": \"https://h/y\", \"version\": \"1.0.0\", \"commit\": \"", SHA, "\"}}}")),
    ]
    for bad in bads:
        (Library _, bool taken, string8 bwhy2) = parse_library(bad)
        ok = #expect(!taken && #len(bwhy2) > 0, bad, " was taken") && ok
    (Library _, bool dup, string8 dwhy) = parse_library(bads[#len(bads) - 1])
    ok = #expect(!dup && strings.contains(dwhy, "ignoring case"), "two pins differing in case: ", dwhy) && ok
    return ok

private bool commits_and_tags():
    bool ok = true
    ok = #expect(is_commit(SHA), "a commit was refused") && ok
    ok = #expect(!is_commit("0123456"), "a short commit was taken") && ok
    ok = #expect(!is_commit("g123456789abcdef0123456789abcdef01234567"), "a non-hex commit was taken") && ok
    for good in ["v1.4.2", "1.4.2-rc.1", "release-3", "a/b"]:
        string8 why = tag_refusal(good)
        ok = #expect(#len(why) == 0, good, " was refused: ", why) && ok
    for bad in ["", "-x", "a b", "a..b", "a~1", "a^", "a:b", "x.lock", "a\tb", "a[1]"]:
        string8 why = tag_refusal(bad)
        ok = #expect(#len(why) > 0, "`", bad, "` was taken as a tag") && ok
    return ok

private bool arguments():
    bool ok = true
    (string8 t, string8 v, bool has) = split_get_arg("Clipper2@1.4.2")
    ok = #expect(t == "Clipper2" && v == "1.4.2" && has, "Clipper2@1.4.2 read as ", t, " ", v) && ok
    (string8 t2, string8 _, bool has2) = split_get_arg("Clipper2")
    ok = #expect(t2 == "Clipper2" && !has2, "a bare name read a version") && ok
    (string8 t3, string8 v3, bool has3) = split_get_arg("https://github.com/o/geo@v2.0.0")
    ok = #expect(t3 == "https://github.com/o/geo" && v3 == "v2.0.0" && has3, "a URL's version read as ", t3, " ", v3) && ok
    (string8 t4, string8 _, bool has4) = split_get_arg("git@forge:o/geo.git")
    ok = #expect(t4 == "git@forge:o/geo.git" && !has4, "an scp address's @ was read as a version") && ok
    (string8 t5, string8 v5, bool has5) = split_get_arg("git@forge:o/geo.git@1.0.0")
    ok = #expect(t5 == "git@forge:o/geo.git" && v5 == "1.0.0" && has5, "an scp address with a version read as ", t5, " ", v5) && ok
    (string8 _, string8 v6, bool has6) = split_get_arg("Geo@")
    ok = #expect(has6 && #len(v6) == 0, "an empty version was not seen") && ok
    ok = #expect(!looks_like_url("Clipper2") && looks_like_url("https://h/x") && looks_like_url("git@h:o/r") && looks_like_url("/srv/x.git"), "names and addresses are told apart wrongly") && ok
    ok = same(url_library_name("https://github.com/o/Clipper2.git"), "Clipper2", "an https address's name") && ok
    ok = same(url_library_name("https://github.com/o/geo/"), "geo", "an address with a trailing /") && ok
    ok = same(url_library_name("git@forge:o/geo.git"), "geo", "an scp address's name") && ok
    ok = same(url_library_name("/srv/git/geo.git"), "geo", "a path's name") && ok
    ok = same(url_library_name("C:\\repos\\geo"), "geo", "a Windows path's name") && ok
    return ok

private bool tags():
    bool ok = true
    string8 listing = txt(#format(SHA, "\trefs/tags/v1.0.0\n", SHA, "\trefs/tags/v1.2.0\n", SHA, "\trefs/tags/v1.2.0^{}\n", SHA, "\trefs/tags/v2.0.0-rc.1\n", SHA, "\trefs/tags/release-3\n", SHA, "\trefs/tags/1.1.0\n"))
    string8 names = remote_tag_names(listing)
    (string8 t, string8 v) = resolve_tag(names, "")
    ok = #expect(t == "v1.2.0" && v == "1.2.0", "the newest release is ", t, " ", v) && ok
    (string8 tp, string8 vp) = resolve_tag(names, "2.0.0-rc.1")
    ok = #expect(tp == "v2.0.0-rc.1" && vp == "2.0.0-rc.1", "a named pre-release is ", tp, " ", vp) && ok
    (string8 tv, string8 vv) = resolve_tag(names, "v1.0.0")
    ok = #expect(tv == "v1.0.0" && vv == "1.0.0", "v1.0.0 is ", tv, " ", vv) && ok
    (string8 tn, string8 vn) = resolve_tag(names, "1.1.0")
    ok = #expect(tn == "1.1.0" && vn == "1.1.0", "a tag without its v is ", tn, " ", vn) && ok
    (string8 tw, string8 vw) = resolve_tag(names, "v1.1.0")
    ok = #expect(tw == "1.1.0" && vw == "1.1.0", "v1.1.0 against the tag 1.1.0 is ", tw, " ", vw) && ok
    (string8 tr, string8 vr) = resolve_tag(names, "release-3")
    ok = #expect(tr == "release-3" && vr == "release-3", "a tag that is not semver is ", tr, " ", vr) && ok
    (string8 tm, string8 _) = resolve_tag(names, "3.0.0")
    ok = #expect(#len(tm) == 0, "a version with no tag found ", tm) && ok
    (string8 tx, string8 _) = resolve_tag(names, "release")
    ok = #expect(#len(tx) == 0, "a prefix of a tag found ", tx) && ok
    (string8 tpre, string8 _) = resolve_tag(txt(#format("v1.0.0-rc.1\nnightly\n")), "")
    ok = #expect(#len(tpre) == 0, "only pre-releases still gave a release: ", tpre) && ok
    // `v1.2.0` and `1.2.0` both there: the `v` one, whichever order.
    (string8 tb, string8 _) = resolve_tag("v1.2.0\n1.2.0\n", "")
    (string8 tb2, string8 _) = resolve_tag("1.2.0\nv1.2.0\n", "")
    ok = #expect(tb == "v1.2.0" && tb2 == "v1.2.0", "of 1.2.0 and v1.2.0 the newest was ", tb, " and ", tb2) && ok
    return ok

private const string8 HASH = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

// Addresses git would read as options are refused everywhere one comes in.
private bool options_refused():
    bool ok = true
    string8 evil = "--upload-pack=touch${IFS}/tmp/PWNED;git-upload-pack"
    string8 r1 = url_refusal(evil)
    string8 r2 = url_refusal("-x")
    ok = #expect(#len(r1) > 0 && #len(r2) > 0, "an address starting with - was taken") && ok
    string8 fine = url_refusal("https://h/o/r")
    ok = #expect(#len(fine) == 0, "an https address was refused: ", fine) && ok
    (Library _, bool pinned, string8 pwhy) = parse_library(txt(#format("{\"libraries\": {\"X\": {\"repository\": \"", evil, "\", \"version\": \"1.0.0\", \"commit\": \"", SHA, "\"}}}")))
    ok = #expect(!pinned && strings.contains(pwhy, "option"), "a pin's option-like repository: ", pwhy) && ok
    (Library _, bool own, string8 _) = parse_library("{\"repository\": \"-oops\"}")
    ok = #expect(!own, "dado.json's option-like repository was taken") && ok
    (IndexEntry _, bool listed) = parse_index_line("- [X](--upload-pack=x) — X.")
    ok = #expect(!listed, "an index line with an option-like address was read") && ok
    return ok

private bool hashes():
    bool ok = true
    string8 text = txt(#format("{\n  \"libraries\": {\n    \"Geo\": {\n      \"repository\": \"https://h/geo\",\n      \"version\": \"1.0.0\",\n      \"commit\": \"", SHA, "\",\n      \"hash\": \"", HASH, "\"\n    }\n  }\n}\n"))
    (Library lib, bool good, string8 why) = parse_library(text)
    ok = #expect(good && #len(lib.libraries) == 1 && lib.libraries[0].hash == HASH, "a vendored pin did not read: ", why) && ok
    ok = same(render_library(lib), text, "a vendored pin written back") && ok
    (Library _, bool short_hash, string8 _) = parse_library(txt(#format("{\"libraries\": {\"X\": {\"repository\": \"https://h/x\", \"version\": \"1.0.0\", \"commit\": \"", SHA, "\", \"hash\": \"abc\"}}}")))
    ok = #expect(!short_hash, "a short hash was taken") && ok
    // The recipe: path, 0, length, 0, content; CR LF hashed as LF.
    hash.Sha256 a = hash.sha256_init()
    hash_vendored_file(&a, "geo/geo.dado", "a\r\nb\n")
    hash.Sha256 b = hash.sha256_init()
    hash_vendored_file(&b, "geo/geo.dado", "a\nb\n")
    string8 da = vendored_digest(&a)
    string8 db = vendored_digest(&b)
    ok = same(da, db, "CR LF's hash against LF's") && ok
    // The same bytes fed to SHA-256 in one piece: the recipe, spelt out.
    hash.Sha256Digest whole = hash.sha256_text("geo/geo.dado\x004\x00a\nb\n")
    ok = same(db, txt(hash.hex(whole)), "the recipe's digest") && ok
    hash.Sha256 c = hash.sha256_init()
    hash_vendored_file(&c, "geo/geo.dado", "a\nb\nc")
    string8 dc = vendored_digest(&c)
    ok = #expect(dc != db, "an edit did not change the hash") && ok
    return ok

// Git's own files are not vendored, at any depth.
private bool skips():
    bool ok = true
    for skipped in [".gitignore", ".gitattributes", "sub/.gitignore", ".github/workflows/ci.yml", ".git/HEAD", "a\\.gitmodules"]:
        ok = #expect(vendored_skips(skipped), skipped, " would be vendored") && ok
    for kept in ["geo/geo.dado", ".hidden/x.dado", ".env", "git/x", "a.gitignore"]:
        ok = #expect(!vendored_skips(kept), kept, " would be left out") && ok
    return ok

private bool write(string8 file, string8 text):
    try fs.make_dirs(dir_of(file)) else:
        return false
    try fs.write_file(file, text) else:
        return false
    return true

// A vendored copy holding any of git's files (`.gitignore` at any depth, a
// nested `.git`) is refused by the build's check, though its hash, which
// passes over them, still matches; deleting the file is the repair.
private bool git_files_in_copy():
    bool ok = true
    try ref []char8 made = fs.make_temp_dir("dado-get-test") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 root = txt(made)
    string8 copy = join3(root, "collections", join2("lib", "geo"))
    ok = #expect(write(join2(copy, "geo.dado"), "package geo\n"), "writing the copy") && ok
    ok = #expect(write(join3(copy, "inner", "x.dado"), "package inner\n"), "writing the copy's subfolder") && ok
    (string8 digest, string8 bad) = tree_hash(copy)
    ok = same(bad, "", "the copy's hash refusal") && ok
    Pin p = Pin(name: "Geo", repository: "https://h/o/geo", version: "0.1.0", commit: SHA, hash: digest)
    ok = same(git_entry_in(copy), "", "git's files in a clean copy") && ok
    (string8 clean, string8 _, bool _) = pin_problem(root, p)
    ok = same(clean, "", "a clean copy's problem") && ok
    for rel in ["inner/.gitignore", ".gitattributes", "inner/.git/HEAD"]:
        string8 file = join2(copy, rel)
        ok = #expect(write(file, "*\n"), "writing ", rel) && ok
        (string8 still, string8 _) = tree_hash(copy)
        ok = same(still, digest, txt(#format("the hash with ", rel))) && ok
        string8 found = git_entry_in(copy)
        ok = #expect(#len(found) > 0 && strings.starts_with(found, copy), "git_entry_in missed ", rel, ": `", found, "`") && ok
        (string8 problem, string8 fix, bool restorable) = pin_problem(root, p)
        ok = #expect(strings.contains(problem, "one of git's own files") && strings.contains(problem, found), "the problem with ", rel, " is `", problem, "`") && ok
        ok = #expect(strings.starts_with(fix, txt(#format("delete ", found))), "the repair for ", rel, " is `", fix, "`") && ok
        ok = #expect(!restorable, "a bare dado get would restore over ", rel) && ok
        string8 top = rel if !strings.contains(rel, "/.git/") else "inner/.git"
        try fs.remove_all(join2(copy, top)) else:
            ok = #expect(false, "removing ", top) && ok
        (string8 after, string8 _, bool _) = pin_problem(root, p)
        ok = same(after, "", txt(#format("the problem once ", top, " is deleted"))) && ok
    try fs.remove_all(root) else code:
        ok = #expect(false, "removing the fake project: ", os.message(code)) && ok
    return ok

// Restoring a pin takes the tag at the pinned commit when two name it.
private bool restores():
    bool ok = true
    string8 other = "ffffffffffffffffffffffffffffffffffffffff"
    string8 listing = txt(#format(other, "\trefs/tags/v1.4.2\n", SHA, "\trefs/tags/1.4.2\n", other, "\trefs/tags/v2.0.0\n", SHA, "\trefs/tags/v2.0.0^{}\n"))
    ok = same(restore_tag(listing, "1.4.2", SHA), "1.4.2", "the tag at the pin, of 1.4.2 and v1.4.2") && ok
    ok = same(restore_tag(listing, "1.4.2", other), "v1.4.2", "the other one, for the other commit") && ok
    ok = same(restore_tag(listing, "1.4.2", "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"), "1.4.2", "neither at the pin: resolve_tag's, as typed") && ok
    ok = same(restore_tag(listing, "2.0.0", SHA), "v2.0.0", "an annotated tag, by its peeled commit") && ok
    ok = same(remote_tag_commit(listing, "v2.0.0"), SHA, "an annotated tag's commit") && ok
    ok = same(restore_tag(listing, "3.0.0", SHA), "", "a version no tag names") && ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = pins()
        ok = commits_and_tags() && ok
        ok = arguments() && ok
        ok = tags() && ok
        ok = options_refused() && ok
        ok = hashes() && ok
        ok = restores() && ok
        ok = skips() && ok
        ok = git_files_in_copy() && ok
        if ok: return 0
        return 1
