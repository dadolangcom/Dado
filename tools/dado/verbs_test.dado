@test
// The pure logic of the tiers and their switches (`resolve_switches`, the
// flags `dadoc` is handed for them), of `test`, the web target and `doc`: reading `--shard` and
// the tests manifest, choosing a slice, the result line and its sanitizer
// marker, a failing test's indented standard error, the manifest a web
// module's loader reads, and the byte order `doc params` reads files in.
//
// The commands themselves start `dadoc`, a C compiler and node, and are
// exercised by running the driver against the bash one instead.
package driver

import "core:mem/arena"
import "core:mem/libc"
import "core:strings"

private bool same(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is `", got, "`, not `", want, "`")

private bool shards_read():
    bool ok = true
    (i64 k, i64 n, bool good) = parse_shard("2/3")
    ok = #expect(good && k == 2 && n == 3, "2/3 read as ", k, "/", n) && ok
    (i64 k1, i64 n1, bool one) = parse_shard("1/1")
    ok = #expect(one && k1 == 1 && n1 == 1, "1/1 was refused") && ok
    for bad in ["0/3", "4/3", "3", "/3", "2/", "a/3", "2/b", "-1/3", "1/0", ""]:
        (i64 _, i64 _, bool accepted) = parse_shard(bad)
        ok = #expect(!accepted, "--shard ", bad, " was accepted") && ok
    // The i-th test is in slice k of n when i mod n is k - 1.
    ok = #expect(in_slice(0, 1, 3) && in_slice(3, 1, 3) && in_slice(4, 2, 3), "a test is missing from its slice") && ok
    ok = #expect(!in_slice(1, 1, 3) && !in_slice(2, 2, 3), "a test is in another's slice") && ok
    ok = #expect(in_slice(7, 0, 0), "an unsharded run left a test out") && ok
    (i64 d, bool dok) = decimal("134")
    ok = #expect(dok && d == 134, "134 read as ", d) && ok
    (i64 _, bool dbad) = decimal("13x")
    ok = #expect(!dbad, "13x read as a number") && ok
    return ok

private bool tests_read():
    bool ok = true
    (ref []TestEntry t, bool good, string8 why) = parse_tests("test /a/b/x_test.dado 0\ntest /a/b/abort_test.dado 134\n\n")
    ok = #expect(good, "the tests manifest did not read: ", why) && ok
    ok = #expect(#len(t) == 2, "the tests manifest holds ", #len(t), " tests, not 2") && ok
    if #len(t) == 2:
        ok = same(t[0].path, "/a/b/x_test.dado", "the first path") && ok
        ok = #expect(t[0].status == 0 && t[1].status == 134, "the statuses are ", t[0].status, " and ", t[1].status) && ok
        ok = same(test_name(t[1].path), "abort_test", "a test's name") && ok
    (ref []TestEntry _, bool bad, string8 why2) = parse_tests("bench /a/x.dado 0\n")
    ok = #expect(!bad && strings.contains(why2, "bench"), "a line that is not a test was accepted: ", why2) && ok
    (ref []TestEntry e, bool empty, string8 _) = parse_tests("")
    ok = #expect(empty && #len(e) == 0, "an empty manifest is not no tests") && ok
    return ok

private bool summaries():
    bool ok = true
    ok = same(sanitizer_marker(3, "address", false), " (sanitized: asan, ubsan)", "clang's marker") && ok
    ok = same(sanitizer_marker(3, "address", true), " (sanitized: ubsan)", "zig's marker") && ok
    ok = same(sanitizer_marker(3, "thread", true), " (sanitized: tsan, ubsan)", "TSan's marker under zig") && ok
    ok = same(sanitizer_marker(3, "thread", false), " (sanitized: tsan, ubsan)", "TSan's marker") && ok
    ok = same(sanitizer_marker(0, "address", false), "", "an unsanitized run's marker") && ok
    ok = same(summary_line(2, 0, 0, 0, 0, 0, ""), "2 passed, 0 failed", "the plain summary") && ok
    ok = same(summary_line(1, 1, 3, 2, 3, 4, " (sanitized)"), "1 passed, 1 failed (slice 2/3; 4 in the other slices), 3 filtered out (sanitized)", "the full summary") && ok
    ok = same(indented("one\n\ntwo"), "       one\n       \n       two\n", "a failing test's stderr") && ok
    ok = same(indented(""), "", "no stderr") && ok
    return ok

private bool web_manifests():
    bool ok = true
    string8 m = "os #WEB\njs-module scripts.123/dados/web.js\njs-module scripts.123/registry.js\nwasm-import env print"
    ok = same(web_manifest(m, "x_test.scripts"), "os #WEB\njs-module x_test.scripts/dados/web.js\njs-module x_test.scripts/registry.js\nwasm-import env print\n", "the web test's manifest") && ok
    // `build`'s one compile writes `js-module` before `pass`; the module's
    // `.build` has them last, as the two runs it replaced did (DI-0380).
    string8 one = "os #WEB\nwasm-import env print\njs-module m.scripts/registry.js\njs-module m.scripts/a.js\npass fold\ncosts c.tsv\n"
    ok = same(js_modules_last(one), "os #WEB\nwasm-import env print\npass fold\ncosts c.tsv\njs-module m.scripts/registry.js\njs-module m.scripts/a.js", "the web build's manifest") && ok
    ok = same(js_modules_last("os #WEB\n\n"), "os #WEB", "a manifest with no scripts") && ok
    return ok

private string8 level(^Options o, bool zig = false, string8 family = ""):
    ref []string8 w = opt_words(o, zig)
    for l in lto_words(o, family, "#LINUX"):
        w = #append(w, l)
    return txt(strings.join(w[:], " "))

private string8 lto_for(^Options o, string8 family, string8 os):
    ref []string8 w = lto_words(o, family, os)
    return txt(strings.join(w[:], " "))

private string8 linked(^Options o, bool zig, string8 family):
    ref []string8 w = opt_words(o, zig)
    for l in lto_words(o, family, "#LINUX"):
        w = #append(w, l)
    ref []string8 k = link_opt_words(w[:], zig)
    return txt(strings.join(k[:], " "))

// CP-13 step 1: `-O0` unless `--release`; `--debug` over both. A dev compile
// under zig turns off what `zig cc` turns on at `-O0` (UBSan, `-g`) unless
// C's sanitizers are asked for; a release one is optimised at the link, by
// each compiler's spelling, but under `--no-lto`.
private bool levels():
    bool ok = true
    Options o
    ok = same(level(&o), "-O0", "a dev build's level") && ok
    ok = same(level(&o, true, "zig"), "-O0 -fno-sanitize=undefined -g0", "a dev build's level under zig") && ok
    ok = same(linked(&o, true, "zig"), "-O2 -fno-sanitize=undefined -g0", "a dev link under zig") && ok
    ok = same(linked(&o, false, "gcc"), "-O0", "a dev link under gcc") && ok
    o.sanitize = true
    ok = same(level(&o, true, "zig"), "-O0", "a sanitized dev build's level under zig") && ok
    o.sanitize = false
    o.release = true
    ok = same(level(&o), "-O2", "--release's level") && ok
    ok = same(level(&o, true, "zig"), "-O2 -flto=thin", "--release under zig") && ok
    ok = same(lto_for(&o, "zig", "#DARWIN"), "", "--release under zig for macOS: no -flto, zig's Mach-O linker reads no bitcode") && ok
    ok = same(lto_for(&o, "zig", "#LINUX"), "-flto=thin", "--release under zig for Linux") && ok
    ok = same(lto_for(&o, "clang", "#DARWIN"), "-flto=thin", "--release under clang for macOS") && ok
    ok = same(level(&o, false, "clang"), "-O2 -flto=thin", "--release under clang") && ok
    ok = same(level(&o, false, "gcc"), "-O2 -flto=auto", "--release under gcc") && ok
    ok = same(linked(&o, true, "zig"), "-O2", "a release link under zig: no -flto") && ok
    ok = same(linked(&o, false, "gcc"), "-O2 -flto=auto", "a release link under gcc") && ok
    o.no_lto = true
    ok = same(level(&o, false, "clang"), "-O2", "--release --no-lto") && ok
    o.no_lto = false
    o.debug = true
    ok = same(level(&o, true, "zig"), "-g -O0", "--debug --release's level") && ok
    return ok

private bool sorted():
    ref []string8 v = #make([]string8, 0)
    v = #append(v, "b/z.dado")
    v = #append(v, "B/a.dado")
    v = #append(v, "a/x.dados")
    v = #append(v, "a/x.dado")
    sort_bytes(v[:])
    ref []char8 j = strings.join(v[:], " ")
    return same(txt(j), "B/a.dado a/x.dado a/x.dados b/z.dado", "byte order")

// `dado --version`: the driver's own version and checkout, then `dadoc`'s
// whole answer, or why there is none.
private bool versions():
    bool ok = true
    ok = same(version_report("1.0.0-rc.8\n", "b1edd03d1234567890", "dadoc 1.0.0-rc.8\ncommit 03a6ac34cfaf\n", "/r/bin/dadoc"), "dado 1.0.0-rc.8 (checkout b1edd03d1234)\ndadoc 1.0.0-rc.8\ncommit 03a6ac34cfaf\n", "the version report") && ok
    ok = same(version_report("1.0.0-rc.8", "", "dadoc 1.0.0-rc.8", "/r/bin/dadoc"), "dado 1.0.0-rc.8\ndadoc 1.0.0-rc.8\n", "a report with no git") && ok
    ok = same(version_report("", "", "", ""), "dado (no VERSION file)\ndadoc: none that runs here (dado where says where it looked)\n", "a report with nothing found") && ok
    return ok

// Each configuration's C has its own name, as its binary has: a native and
// a web run of one package at once never compile each other's C.
private bool test_c_paths():
    bool ok = true
    ok = same(test_c_path("/b", "q", "t_test", "gcc.asan"), "/b/q.t_test.gcc.asan.c", "a native test's C") && ok
    ok = same(test_c_path("/b", "q", "t_test", "web"), "/b/q.t_test.web.c", "a web test's C") && ok
    return ok

// ── the tiers and their switches ────────────────────────────────────────────

// The `Asked` a command line's words make, as `asked_of` would read them.
private Asked asked(string8 line):
    Asked a
    for w in words_of(line):
        if w == "--debug": a.debug = true
        else if w == "--release": a.release = true
        else if w == "--no-sanitize": a.no_sanitize = true
        else if w == "--dado-checks": a.dado_checks = true
        else if w == "--no-dado-checks": a.no_dado_checks = true
        else if w == "--full-trace": a.full_trace = true
        else if w == "--no-full-trace": a.no_full_trace = true
        else if w == "--no-c-sanitize": a.no_c_sanitize = true
        else if strings.starts_with(w, "--sanitize"):
            a.sanitize = true
            a.sanitize_kind = w[11..<#len(w)] if #len(w) > 11 else "address"
        else if strings.starts_with(w, "--c-sanitize"):
            a.c_sanitize = true
            a.c_sanitize_kind = w[13..<#len(w)] if #len(w) > 13 else "address"
    return a

// One row: `cmd` with `line` resolves to `want`, written `dado trace c`
// (each `on` or `off`), then C's kind when they are on, then `-g` when
// `--debug` asked for it, then `written` when C's were asked for by name.
private bool resolves(string8 cmd, string8 line, string8 want):
    Switches s = resolve_switches(cmd, asked(line))
    strings.Builder b = strings.builder(32)
    strings.append(&b, "on" if s.dado else "off")
    strings.append(&b, " on" if s.trace else " off")
    strings.append(&b, " on" if s.c else " off")
    if s.c:
        strings.append(&b, " ")
        strings.append(&b, s.kind)
    if s.debug: strings.append(&b, " -g")
    if s.c_written: strings.append(&b, " written")
    string8 got = txt(strings.finish(&b))
    return #expect(got == want, "dado ", cmd, " ", line, " resolves to `", got, "`, not `", want, "`")

// Every row of the tiers' mapping table, then the precedence (tier, then
// umbrella, then each switch) and the rule for a switch written both ways.
private bool switches():
    bool ok = true
    // The tiers.
    ok = resolves("build", "", "on off off") && ok
    ok = resolves("run", "", "on off off") && ok
    ok = resolves("build", "--debug", "on on on address -g") && ok
    ok = resolves("run", "--debug", "on on on address -g") && ok
    ok = resolves("test", "", "on on on address") && ok
    ok = resolves("test", "--debug", "on on on address -g") && ok
    ok = resolves("build", "--release", "off off off") && ok
    ok = resolves("run", "--release", "off off off") && ok
    ok = resolves("test", "--release", "off off off") && ok
    // `--debug` wins over `--release`.
    ok = resolves("build", "--debug --release", "on on on address -g") && ok
    ok = resolves("test", "--release --debug", "on on on address -g") && ok
    // The umbrella, which leaves the stack as the tier has it.
    ok = resolves("build", "--sanitize", "on off on address written") && ok
    ok = resolves("build", "--sanitize=address", "on off on address written") && ok
    ok = resolves("test", "--sanitize", "on on on address written") && ok
    ok = resolves("build", "--sanitize=thread", "on off on thread written") && ok
    ok = resolves("test", "--sanitize=thread", "on on on thread written") && ok
    ok = resolves("build", "--sanitize=dado", "on off off") && ok
    ok = resolves("test", "--sanitize=dado", "on on off") && ok
    ok = resolves("build", "--release --sanitize=dado", "on off off") && ok
    ok = resolves("build", "--no-sanitize", "off off off") && ok
    ok = resolves("test", "--no-sanitize", "off on off") && ok
    ok = resolves("build", "--debug --no-sanitize", "off on off -g") && ok
    ok = resolves("build", "--release --sanitize", "on off on address written") && ok
    ok = resolves("test", "--release --sanitize", "on off on address written") && ok
    // Each feature's own switch.
    ok = resolves("build", "--full-trace", "on on off") && ok
    ok = resolves("build", "--release --full-trace", "off on off") && ok
    ok = resolves("test", "--no-full-trace", "on off on address") && ok
    ok = resolves("build", "--debug --no-full-trace", "on off on address -g") && ok
    ok = resolves("build", "--release --dado-checks", "on off off") && ok
    ok = resolves("build", "--no-dado-checks", "off off off") && ok
    ok = resolves("build", "--c-sanitize", "on off on address written") && ok
    ok = resolves("build", "--release --c-sanitize=thread", "off off on thread written") && ok
    ok = resolves("test", "--no-c-sanitize", "on on off") && ok
    ok = resolves("build", "--debug --no-c-sanitize", "on on off -g") && ok
    // A feature's switch beats the umbrella, wherever each was written.
    ok = resolves("build", "--no-sanitize --dado-checks", "on off off") && ok
    ok = resolves("build", "--dado-checks --no-sanitize", "on off off") && ok
    ok = resolves("build", "--no-sanitize --c-sanitize", "off off on address written") && ok
    ok = resolves("build", "--sanitize --no-c-sanitize", "on off off") && ok
    ok = resolves("build", "--sanitize --no-dado-checks", "off off on address written") && ok
    ok = resolves("build", "--sanitize=thread --c-sanitize=address", "on off on address written") && ok
    // Both forms of one switch: off wins.
    ok = resolves("build", "--sanitize --no-sanitize", "off off off") && ok
    ok = resolves("test", "--full-trace --no-full-trace", "on off on address") && ok
    ok = resolves("build", "--dado-checks --no-dado-checks", "off off off") && ok
    ok = resolves("build", "--no-c-sanitize --c-sanitize", "on off off") && ok
    // `check` and `emit` compile no C.
    ok = resolves("check", "--debug", "on on off -g") && ok
    ok = resolves("warnings", "--debug", "on on off -g") && ok
    ok = resolves("emit", "--sanitize", "on off off") && ok
    return ok

private string8 flags_of(bool dado, bool trace, bool has_trace):
    (ref []string8 w, bool merged) = dadoc_switch_flags(dado, trace, has_trace)
    string8 j = txt(strings.join(w[:], " "))
    if merged: return txt(#format(j, " (merged)"))
    return j

// One flag per feature for a `dadoc` with `--full-trace`; `--sanitize` for
// either under one without it, said when the stack was wanted alone.
private bool dadoc_flags():
    bool ok = true
    ok = same(flags_of(true, false, true), "--sanitize --no-full-trace", "dev's flags") && ok
    ok = same(flags_of(true, true, true), "--sanitize --full-trace", "debug's flags") && ok
    ok = same(flags_of(false, false, true), "--no-sanitize --no-full-trace", "release's flags") && ok
    ok = same(flags_of(false, true, true), "--no-sanitize --full-trace", "the stack alone") && ok
    ok = same(flags_of(true, false, false), "--sanitize", "dev's flags, older dadoc") && ok
    ok = same(flags_of(true, true, false), "--sanitize", "debug's flags, older dadoc") && ok
    ok = same(flags_of(false, false, false), "--no-sanitize", "release's flags, older dadoc") && ok
    ok = same(flags_of(false, true, false), "--sanitize (merged)", "the stack alone, older dadoc") && ok
    // The help probe finds a flag as a word, not inside a longer one.
    string8 help = "options:\n    --sanitize       keep it\n    --ubsan-handlers on the web\n    --emit=<phase>   tokens\n"
    ok = #expect(help_names(help, "--ubsan-handlers"), "--ubsan-handlers is in the help") && ok
    ok = #expect(help_names(help, "--emit"), "--emit= is in the help") && ok
    ok = #expect(!help_names(help, "--full-trace"), "--full-trace was found where it is not") && ok
    ok = #expect(!help_names(help, "--ubsan"), "a flag's prefix was taken for it") && ok
    ok = #expect(!help_names("", "--full-trace"), "an empty help names a flag") && ok
    // The error cap: on every verb but `emit`, and only for a dadoc whose
    // help lists `--errors=`, as dadoc's own help writes it.
    for cmd in ["build", "run", "check", "test", "warnings"]:
        ok = same(errors_cap_flag(cmd, true), "--errors=12", cmd) && ok
        ok = same(errors_cap_flag(cmd, false), "", "an older dadoc") && ok
    ok = same(errors_cap_flag("emit", true), "", "emit prints what dadoc prints") && ok
    string8 caps = "    --errors=<n>     print the first n errors\n    --log-append=<file>  the log, added\n"
    ok = #expect(help_names(caps, "--errors"), "--errors= is in the help") && ok
    ok = #expect(help_names(caps, "--log-append"), "--log-append= is in the help") && ok
    ok = #expect(!help_names(caps, "--log"), "--log was taken from --log-append") && ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = switches()
        ok = dadoc_flags() && ok
        ok = shards_read() && ok
        ok = tests_read() && ok
        ok = summaries() && ok
        ok = web_manifests() && ok
        ok = levels() && ok
        ok = sorted() && ok
        ok = versions() && ok
        ok = test_c_paths() && ok
        if ok: return 0
        return 1
