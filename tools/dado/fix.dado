package driver

import "core:flags"

// `dado fix append [PATH...]`: the growth calls rewritten to the spelling that
// stores the handle they answer (`xs = #append(xs, v)`). The rewrite is
// `dadoc --fix=append`'s: it reads the tree the compiler's own parser builds,
// and it must run over sources the compiler already refuses, this driver's
// included, so it cannot live in the driver.

private flags.TextFlag g_fix_name
private flags.ListFlag g_fix_paths
private flags.BoolFlag g_fix_dry_run
private flags.BoolFlag g_fix_check

void declare_fix(^flags.Parser p):
    p.command("fix", "rewrite a package's sources across a language break: fix append [PATH...] stores what #append, #resize and #reserve answer, and lists what it cannot rewrite")
    g_fix_name = p.positional("FIX", "the rewrite: append", false, "fix")
    g_fix_paths = p.rest("PATH", "the packages, directories or .dado files to rewrite (default: here)", "fix")
    g_fix_dry_run = p.boolean("--dry-run", "write nothing; say what would change", "fix")
    g_fix_check = p.boolean("--check", "write nothing; fail when anything is left to rewrite or review", "fix")

// The words `dadoc` is handed for `dado fix`.
ref []string8 fix_words(string8 name, []string8 paths, bool dry_run, bool check):
    ref []string8 w = #make([]string8, 0)
    w = #append(w, txt(#format("--fix=", name)))
    if dry_run: w = #append(w, "--dry-run")
    if check: w = #append(w, "--check")
    if #len(paths) == 0:
        w = #append(w, ".")
    for p in paths:
        w = #append(w, p)
    return w

i32 fix_verb(^flags.Parser p):
    string8 name = p.value(g_fix_name)
    if #len(name) == 0:
        die("`dado fix` needs the rewrite to run. Try: dado fix append .")
    if name != "append":
        die(txt(#format("there is no rewrite `", name, "`; the one there is: dado fix append [PATH...]")))
    Command c = command(dadoc())
    for w in fix_words(name, p.values(g_fix_paths), p.on(g_fix_dry_run), p.on(g_fix_check)):
        add(&c, w)
    return run(c)
