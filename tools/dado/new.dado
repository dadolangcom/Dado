// `dado new <name>`: a package to start from, in the working directory.
//
//     <name>/main.dado     `package main` and a hello world `dado run <name>` runs
//     <name>/AGENTS        (a Markdown file) three lines pointing an agent at `dado agent`
//
// The guide itself is not copied in: `dado agent` prints the one that
// matches the installed toolchain, so a project made today never carries an
// older version's advice after an upgrade.
//
// **It never writes over anything.** An existing directory is used only when
// it is empty; a file of that name, or a directory holding anything at all
// (a hidden file included), is refused with nothing written.
package driver

import "core:fmt"
import "core:os"
import "core:os/fs"
import "core:strings"

// The program `new` writes.
string8 new_main(string8 name):
    return txt(#format("package main\n\nimport \"core:fmt\"\n\ni32 main():\n    fmt.println(\"hello from ", name, "\")\n    return 0\n"))

// The short agents' file `new` writes.
string8 new_agents(string8 name):
    return txt(#format("# ", name, "\n\nThis is a Dado project. Run `dado agent` for the guide that matches your installed version; `dado check ", name, "` after each edit; `dado explain <CODE>` for any diagnostic.\n"))

// Why `name` cannot be made here, or "" when it can: `kind` is what is
// already at that path ("" for nothing, "file", "dir"), and `entries` how
// many entries a directory there holds.
string8 new_refusal(string8 name, string8 kind, i64 entries):
    if #len(name) == 0:
        return "no name given. Try: dado new hello"
    if strings.has_byte(name, '/') || strings.has_byte(name, '\\'):
        return txt(#format("`", name, "` is a path; `dado new` makes a directory here. Change to where it should go, then: dado new <name>"))
    if name[0] == '.' || name[0] == '-':
        return txt(#format("`", name, "` cannot start with `", name[0..<1], "`; name the package with a letter, e.g. dado new hello"))
    if kind == "file":
        return txt(#format("`", name, "` is already a file here; choose another name, or move the file"))
    if kind == "dir" && entries > 0:
        return txt(#format("`", name, "` is already a directory with ", entries, " entr", "y" if entries == 1 else "ies", " in it; `dado new` writes only into an empty one. Choose another name, or empty it"))
    if kind != "" && kind != "dir" && kind != "file":
        return txt(#format("`", name, "` is already here and is neither a file nor a directory; choose another name"))
    return ""

// How many entries the directory `p` holds, hidden ones included.
private i64 entries_in(string8 p):
    ref []char8 c = strings.clone_to_cstring(p, #default)
    ^fs.Dir d = fs.open(cstring(c))
    if !fs.opened(d): return 0
    i64 n = 0
    for:
        (cstring entry, bool ok) = fs.next(d)
        if !ok: break
        string8 e = strings.borrow_from_cstring(entry)
        if e == "." || e == "..": continue
        n += 1
    fs.close(d)
    return n

// `dado new <name>`.
//
// JSON: {"query": "new", "dir": <the directory, absolute>, "files": [<each
// file written, absolute>]}
i32 new_verb(string8 name, bool json):
    string8 kind = ""
    i64 entries = 0
    if is_dir(name):
        kind = "dir"
        entries = entries_in(name)
    else if is_file(name):
        kind = "file"
    else if exists(name):
        kind = "other"
    string8 why = new_refusal(name, kind, entries)
    if #len(why) > 0:
        return answer_error("new", json, why)
    string8 here = strings.borrow_from_cstring(fs.cwd())
    ref []char8 here_own = #format(here)
    string8 dir = join2(txt(here_own), name)
    if kind == "" && !fs.make_dirs(dir, #default):
        return answer_error("new", json, txt(#format("cannot make the directory ", dir, ". Check that this directory is writable")))
    string8 main_file = join2(dir, "main.dado")
    string8 agents_file = join2(dir, txt(#format("AGENTS", MD)))
    try fs.write_file(main_file, new_main(name)) else code:
        return answer_error("new", json, txt(#format("cannot write ", main_file, ": ", os.message(code))))
    try fs.write_file(agents_file, new_agents(name)) else code:
        return answer_error("new", json, txt(#format("cannot write ", agents_file, ": ", os.message(code))))
    ref []string8 files = #make([]string8, 0)
    _ = #append(files, main_file)
    _ = #append(files, agents_file)
    if json:
        ref []string8 f = #make([]string8, 0)
        _ = #append(f, json_text("query", "new"))
        _ = #append(f, json_text("dir", dir))
        _ = #append(f, json_field("files", json_strings(files[:])))
        fmt.println(json_object(f[:]))
        return 0
    for p in files:
        say_green("wrote", txt(#format(" ", p)))
    fmt.println("next: dado run ", name)
    return 0
