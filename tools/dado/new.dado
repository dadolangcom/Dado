// `dado new` and `dado init` (T53, T62): a project to start from.
//
//     dado new hello                 a program in ./hello (as before T53)
//     dado new program hello         the same
//     dado new library Clipper2      a library in ./Clipper2
//     dado init library              the working directory, set up as a library
//     dado init program              ... or as a program
//
// A **program** gets:
//
//     main.dado            `package main`, a `greeting()` and a `main` printing it
//     <name>_test.dado     a starter test of `greeting()`, for `dado test`
//
// A **library** gets its package at the folder's root, so the folder is the
// package: `dado get` puts the repository at `collections/lib/<lowercase>/`,
// and `import "lib:<lowercase>"` names exactly that directory (`dadoc`
// resolves `<collection>:<rest>` to `<root>/<collection>/<rest>`, so further
// packages can be subfolders, `lib:<lowercase>/<sub>`):
//
//     <lowercase>.dado       `package <lowercase>` with one documented function
//     <lowercase>_test.dado  a starter test of it
//
// and both get `dado.json` (`name`, `targets`; a library's description,
// licence and version are not asked here, because `dado package` asks them),
// `.gitignore` (`build/`), the agents' guide (three lines pointing an agent at
// `dado agent`), and the readme, holding: the title, the tests marker, for a
// library the install marker, and `## Summary` holding only a placeholder comment, which
// `readme_summary` does not read, so `dado package` asks for the description.
//
// **It never writes over anything.** `new` refuses a folder that is a file or
// holds anything; `init` writes only what is missing and names each file it
// left alone, and why. A folder that already has `.dado` sources gets no new
// ones: they would be a second package's files in its directory.
//
// **Git:** with no repository at or above the folder, `git init` is asked on
// a terminal; off one nothing is run and the note says how (`--git`, or `git
// init`). `--git` and `--no-git` answer it beforehand. It never commits.
//
// **No kind:** `dado new` with no words, and `dado init` with none, list the
// kinds and ask on a terminal; off one they exit 1 naming the spelling, so an
// agent is never left at a prompt. The spelling is `new <kind> <name>`; there
// is no `--bootstrap=<kind>` flag.
package driver

import "core:fmt"
import "core:io"
import "core:os"
import "core:os/fs"
import "core:strings"

// The kinds of project.
const string8 PROJECT_KINDS = "library program"

private const string8 README_FILE_STEM = "README"

// What `--git` and `--no-git` said: ask (neither), yes, or no.
enum i32 GitChoice: (Ask, Yes, No)

// One file a project starts with: its name in the folder, and its text.
type Starter:
    string8 file
    string8 text

// Whether `word` names a kind of project.
bool is_project_kind(string8 word):
    return word == "library" || word == "program"

// The package name a library's files declare: `package_word`, its name
// lowercased with `-` as `_` (a package name is an identifier; the folder
// keeps the `-`).
string8 library_package(string8 name):
    return package_word(name)

// `s` escaped for the inside of a Dado string literal.
string8 string_literal_body(string8 s):
    strings.Builder b = strings.builder(#len(s) + 8)
    for i in 0..<#len(s):
        char8 c = s[i]
        if c == '"' || c == '\\':
            _ = strings.append(&b, "\\")
            _ = strings.append(&b, s[i..<i + 1])
        else if u8(c) < 0x20 || u8(c) == 0x7f:
            string8 hex = "0123456789abcdef"
            i64 hi = i64(u8(c) >> 4)
            i64 lo = i64(u8(c) & 15)
            _ = strings.append(&b, txt(#format("\\x", hex[hi..<hi + 1], hex[lo..<lo + 1])))
        else:
            _ = strings.append(&b, s[i..<i + 1])
    return strings.text(b)

// The README's import line for the library `name`: the alias form when the
// folder (`lib:` path) and the package name differ, as `my-geo` and `my_geo`.
string8 library_import(string8 name):
    string8 lower = txt(strings.to_lower(name))
    string8 pkg = library_package(name)
    if lower == pkg: return txt(#format("import \"lib:", lower, "\""))
    return txt(#format("import ", pkg, " \"lib:", lower, "\""))

// ── the files ───────────────────────────────────────────────────────────────

// A program's `main.dado`.
string8 new_main(string8 name):
    return txt(#format("package main\n\nimport \"core:fmt\"\n\n// What `main` prints.\nstring8 greeting():\n    return \"hello from ", string_literal_body(name), "\"\n\ni32 main():\n    fmt.println(greeting())\n    return 0\n"))

// A program's starter test.
string8 new_program_test(string8 name):
    return txt(#format("@test\npackage main\n\nimport \"core:strings\"\n\n// `dado test` runs this file as its own program: 0 is a pass.\ni32 test():\n    bool ok = #expect(strings.contains(greeting(), \"", string_literal_body(name), "\"), \"greeting() is \", greeting())\n    return 0 if ok else 1\n"))

// A library's package file.
string8 new_library_source(string8 name):
    string8 pkg = library_package(name)
    return txt(#format("// ", name, ": what it is for, in a sentence or two.\npackage ", pkg, "\n\n// The sum of `a` and `b`. Replace it with the library's first function:\n// a declaration is public unless marked `private`.\ni32 add(i32 a, i32 b):\n    return a + b\n"))

// A library's starter test.
string8 new_library_test(string8 name):
    string8 pkg = library_package(name)
    return txt(#format("@test\npackage ", pkg, "\n\n// `dado test` runs this file as its own program: 0 is a pass.\ni32 test():\n    bool ok = #expect(add(2, 3) == 5, \"add(2, 3) is \", add(2, 3))\n    return 0 if ok else 1\n"))

// The short agents' file.
string8 new_agents(string8 name):
    return txt(#format("# ", name, "\n\nThis is a Dado project. Run `dado agent` for the guide that matches your installed version; `dado check ", name, "` after each edit; `dado explain <CODE>` for any diagnostic.\n"))

// `dado.json`: the name and the targets claimed. Nothing a library releases
// with (version, description, licence, repository) is guessed here: `dado
// package` asks for what is absent.
string8 new_manifest(string8 name):
    Library lib
    lib.name = name
    lib.targets = #make([]string8, 0)
    _ = #append(lib.targets, "native")
    return render_library(lib)

// `.gitignore`: what `dado` writes.
string8 new_gitignore():
    return "build/\n"

// The README, in T62's shape.
string8 new_readme(string8 kind, string8 name):
    strings.Builder b = strings.builder(1024)
    _ = strings.append(&b, txt(#format("# ", name, "\n\n")))
    _ = strings.append(&b, txt(#format(TESTS_OPEN, "\nTests: not run yet.\n", TESTS_CLOSE, "\n\n")))
    if kind == "library":
        _ = strings.append(&b, txt(#format(INSTALL_OPEN, "\n", install_status(name), "\n", INSTALL_CLOSE, "\n\n")))
        _ = strings.append(&b, "<!-- `dado package` rewrites only the lines between the dado: markers above; the rest of this file is yours. -->\n\n")
    _ = strings.append(&b, "## Summary\n\n")
    if kind == "library":
        _ = strings.append(&b, txt(#format("<!-- One sentence on what ", name, " does, in place of this comment: `dado package` offers it as the library's description in the package index. -->\n\n")))
        _ = strings.append(&b, txt(#format("## Use\n\n```dado\n", library_import(name), "\n\ni32 five = ", library_package(name), ".add(2, 3)\n```\n")))
    else:
        _ = strings.append(&b, txt(#format("<!-- One sentence on what ", name, " does, in place of this comment. -->\n\n")))
        _ = strings.append(&b, "## Run\n\nIn this folder: `dado run .` builds and runs it, and `dado test .` runs its tests.\n")
    return strings.text(b)

// Every file a `kind` project named `name` starts with, in the order written.
ref []Starter starter_files(string8 kind, string8 name):
    ref []Starter out = #make([]Starter, 0)
    if kind == "library":
        string8 lower = txt(strings.to_lower(name))
        _ = #append(out, Starter(txt(#format(lower, ".dado")), new_library_source(name)))
        _ = #append(out, Starter(txt(#format(lower, "_test.dado")), new_library_test(name)))
    else:
        _ = #append(out, Starter("main.dado", new_main(name)))
        _ = #append(out, Starter(txt(#format(name, "_test.dado")), new_program_test(name)))
    _ = #append(out, Starter(MANIFEST_FILE, new_manifest(name)))
    _ = #append(out, Starter(".gitignore", new_gitignore()))
    _ = #append(out, Starter(txt(#format("AGENTS", MD)), new_agents(name)))
    _ = #append(out, Starter(txt(#format(README_FILE_STEM, MD)), new_readme(kind, name)))
    return out

// ── refusals ────────────────────────────────────────────────────────────────

// Why `name` cannot be made here by `new`, or "" when it can: `kind` is what
// is already at that path ("" for nothing, "file", "dir"), and `entries` how
// many entries a directory there holds. `project` is the kind asked for
// ("program" for bare `dado new <name>`), which a library's name is also held
// to the index's rules for.
string8 new_refusal(string8 name, string8 kind, i64 entries, string8 project = "program"):
    if #len(name) == 0:
        return txt(#format("no name given. Try: dado new ", project, " hello"))
    if strings.has_byte(name, '/') || strings.has_byte(name, '\\'):
        return txt(#format("`", name, "` is a path; `dado new` makes a directory here. Change to where it should go, then: dado new ", project, " <name>"))
    if name[0] == '.' || name[0] == '-':
        return txt(#format("`", name, "` cannot start with `", name[0..<1], "`; name the package with a letter, e.g. dado new ", project, " hello"))
    if project == "library":
        string8 why = library_name_refusal(name)
        if #len(why) > 0:
            return txt(#format("a library's name is how users fetch it (dado get <Name>), and ", why))
    else:
        string8 why = name_rule_refusal(name)
        if #len(why) > 0:
            return txt(#format("a program's name is its folder's and its test file's, and ", why))
    if kind == "file":
        return txt(#format("`", name, "` is already a file here; choose another name, or move the file"))
    if kind == "dir" && entries > 0:
        return txt(#format("`", name, "` is already a directory with ", entries, " entr", "y" if entries == 1 else "ies", " in it; `dado new` writes only into an empty one. Choose another name, or add what is missing to it: cd ", name, " && dado init ", project))
    if kind != "" && kind != "dir" && kind != "file":
        return txt(#format("`", name, "` is already here and is neither a file nor a directory; choose another name"))
    return ""

// Why the folder named `name` cannot be set up by `init` as `project`, or "".
string8 init_refusal(string8 name, string8 project):
    if #len(name) == 0:
        return "this folder has no name to give the project (it is the root of the file system); make a folder for it and run dado init there"
    if project == "library":
        string8 why = library_name_refusal(name)
        if #len(why) > 0:
            return txt(#format("a library takes its folder's name, how users fetch it (dado get <Name>), and ", why, ". Rename the folder, or make one: dado new library <Name>"))
        return ""
    string8 rule = name_rule_refusal(name)
    if #len(rule) > 0:
        return txt(#format("a program takes its folder's name, and ", rule, ". Rename the folder, or make one: dado new program <name>"))
    return ""

// Why `word` is not a kind of project, or "".
string8 kind_refusal(string8 verb, string8 word):
    if is_project_kind(word): return ""
    return txt(#format("`", word, "` is not a kind of project; the kinds are library and program: dado ", verb, " <library|program>", " <name>" if verb == "new" else ""))

// The line listing the kinds, for `dado new` and `dado init` with none.
string8 kinds_listing(string8 verb):
    string8 name = " <name>" if verb == "new" else ""
    return txt(#format("dado ", verb, " needs a kind of project:\n  library   a package others fetch with dado get (dado ", verb, " library", name, ")\n  program   a main.dado to build and run (dado ", verb, " program", name, ")"))

// Why the file `file` is left alone, or "" when it is to be written: `exists`
// is whether something is at its path, `is_dir` whether that is a folder,
// and `sources` the `.dado` files already in the folder (for the package's
// own files only, `is_source`).
string8 skip_reason(string8 file, bool exists_now, bool is_dir_now, bool is_source, []string8 sources):
    if exists_now && is_dir_now:
        return txt(#format("a folder named ", file, " is there"))
    if exists_now:
        return "it is already there"
    if is_source && #len(sources) > 0:
        ref []char8 listed = strings.join(sources, ", ")
        return txt(#format("the folder already has Dado sources (", txt(listed), "), and a new one would be a second package in it"))
    return ""

// ── the verbs ───────────────────────────────────────────────────────────────

private bool new_interactive(bool json):
    return !json && os.is_terminal(0) && os.is_terminal(2)

// A line typed at `question` on standard error, trimmed; "" at the end of
// the input.
private string8 ask_text(string8 question):
    _ = io.flush(io.stdout())
    fmt.eprint(question)
    _ = io.flush(io.stderr())
    [256]char8 buf
    try i64 n = io.read_line_into(io.stdin(), buf[:]) else:
        return ""
    return txt(strings.clone(strings.trim(string8(buf[0..<n]))))

// The kind, asked on a terminal until it is one; "" at the end of the input.
private string8 ask_kind(string8 verb):
    fmt.eprintln(kinds_listing(verb))
    for:
        string8 k = ask_text("Kind (library or program): ")
        if #len(k) == 0 || is_project_kind(k): return k
        fmt.eprintln("`", k, "` is not one: type library or program")
    return ""

// `ask`, but the end of the input (Ctrl-D) is no: only an empty line takes
// the default, yes.
private bool ask_git(string8 question):
    _ = io.flush(io.stdout())
    fmt.eprint(question)
    _ = io.flush(io.stderr())
    [256]char8 buf
    try i64 n = io.read_line_into(io.stdin(), buf[:]) else:
        fmt.eprintln("")
        return false
    string8 a = strings.trim(string8(buf[0..<n]))
    if #len(a) == 0: return true
    return a == "y" || a == "Y" || a == "yes" || a == "Yes" || a == "YES"

// How many entries the directory `p` holds, hidden ones included.
private i64 entries_in(string8 p):
    try fs.Listing l = fs.read_dir(p) else:
        return 0
    i64 n = #len(l.entries)
    l.destroy()
    return n

// The `.dado` files directly in `dir`, by name, sorted.
private ref []string8 dado_sources(string8 dir):
    ref []string8 out = #make([]string8, 0)
    try fs.Listing l = fs.read_dir(dir) else:
        return out
    for e in l.entries:
        if !e.is_dir && strings.ends_with(e.path, ".dado"):
            _ = #append(out, txt(strings.clone(e.path)))
    l.destroy()
    sort_bytes(out[:])
    return out

// `dado new [<kind>] <name>`: `first` and `second` are the words as typed.
//
// JSON: {"query": "new", "kind": …, "name": …, "dir": <absolute>, "files":
// [<each written, absolute>], "skipped": [{"path", "reason"}], "git":
// "initialised" | "existing" | "declined" | "not-asked" | "unavailable"}
i32 new_verb(string8 first, string8 second, GitChoice git, bool json):
    string8 kind = "program"
    string8 name = first
    if is_project_kind(first):
        kind = first
        name = second
    else if #len(second) > 0:
        return answer_error("new", json, kind_refusal("new", first))
    if #len(first) == 0:
        if !new_interactive(json):
            return answer_error("new", json, txt(#format(kinds_listing("new"), "\n  (there is no terminal to ask on)")))
        kind = ask_kind("new")
        if #len(kind) == 0: return 1
    if #len(name) == 0 && new_interactive(json):
        name = ask_text(txt(#format("Name of the ", kind, ": ")))
    if #len(name) == 0:
        return answer_error("new", json, txt(#format("no name given: dado new ", kind, " <name>")))
    string8 at = ""
    i64 entries = 0
    if is_dir(name):
        at = "dir"
        entries = entries_in(name)
    else if is_file(name):
        at = "file"
    else if exists(name):
        at = "other"
    string8 why = new_refusal(name, at, entries, kind)
    if #len(why) > 0:
        return answer_error("new", json, why)
    try ref []char8 here_own = fs.current_dir() else code:
        return answer_error("new", json, txt(#format("cannot read the working directory: ", os.message(code))))
    string8 dir = join2(txt(here_own), name)
    if at == "":
        try fs.make_dirs(dir) else code2:
            return answer_error("new", json, txt(#format("cannot make the directory ", dir, ": ", os.message(code2), ". Check that this directory is writable")))
    return set_up("new", kind, name, dir, git, json, txt(#format("next: dado ", "run " if kind == "program" else "test ", name)))

// `dado init [<kind>]`, in the working directory.
i32 init_verb(string8 word, GitChoice git, bool json):
    string8 kind = word
    if #len(kind) == 0:
        if !new_interactive(json):
            return answer_error("init", json, txt(#format(kinds_listing("init"), "\n  (there is no terminal to ask on)")))
        kind = ask_kind("init")
        if #len(kind) == 0: return 1
    string8 bad = kind_refusal("init", kind)
    if #len(bad) > 0:
        return answer_error("init", json, bad)
    try ref []char8 here_own = fs.current_dir() else code:
        return answer_error("init", json, txt(#format("cannot read the working directory: ", os.message(code))))
    string8 dir = strings.trim_suffix(txt(here_own), "/")
    string8 name = base_name(dir)
    string8 why = init_refusal(name, kind)
    if #len(why) > 0:
        return answer_error("init", json, why)
    return set_up("init", kind, name, dir, git, json, txt(#format("next: dado ", "run" if kind == "program" else "test", " .")))

// Write what is missing of a `kind` project named `name` into `dir`, then
// offer git.
private i32 set_up(string8 verb, string8 kind, string8 name, string8 dir, GitChoice git, bool json, string8 next):
    ref []string8 sources = dado_sources(dir)
    ref []Starter files = starter_files(kind, name)
    ref []string8 written = #make([]string8, 0)
    ref []string8 skipped = #make([]string8, 0)
    ref []string8 reasons = #make([]string8, 0)
    for i in 0..<#len(files):
        Starter s = files[i]
        string8 p = join2(dir, s.file)
        // The first two are the package's own sources.
        string8 skip = skip_reason(s.file, exists(p), is_dir(p), i < 2, sources[:])
        if #len(skip) > 0:
            if s.file == ".gitignore" && !is_dir(p) && !ignores_build(read_or_empty(p)):
                skip = txt(#format(skip, "; it does not ignore build/, which dado writes: add a line `build/`"))
            if strings.starts_with(s.file, README_FILE_STEM) && !is_dir(p):
                (string8 _, bool marked) = rewrite_markers(read_or_empty(p), "", "")
                if !marked:
                    skip = txt(#format(skip, "; it has no dado: markers, so dado package leaves it as it is"))
            _ = #append(skipped, p)
            _ = #append(reasons, skip)
            continue
        try fs.write_file(p, s.text) else code:
            return answer_error(verb, json, txt(#format("cannot write ", p, ": ", os.message(code))))
        _ = #append(written, p)
    string8 git_state = offer_git(dir, git, json)
    if json:
        ref []string8 sk = #make([]string8, 0)
        for i in 0..<#len(skipped):
            ref []string8 o = #make([]string8, 0)
            _ = #append(o, json_text("path", skipped[i]))
            _ = #append(o, json_text("reason", reasons[i]))
            _ = #append(sk, json_object(o[:]))
        ref []string8 f = #make([]string8, 0)
        _ = #append(f, json_text("query", verb))
        _ = #append(f, json_text("kind", kind))
        _ = #append(f, json_text("name", name))
        _ = #append(f, json_text("dir", dir))
        _ = #append(f, json_field("files", json_strings(written[:])))
        _ = #append(f, json_field("skipped", json_array(sk[:])))
        _ = #append(f, json_text("git", git_state))
        fmt.println(json_object(f[:]))
        return 0
    for p in written:
        say_green("wrote", txt(#format(" ", p)))
    for i in 0..<#len(skipped):
        say(txt(#format("skipped ", skipped[i], ": ", reasons[i])))
    if git_state == "initialised":
        say_green("git", txt(#format(" init ", dir)))
    else if git_state == "not-asked":
        note(txt(#format("not a git repository, and there is no terminal to ask on: run git init in ", dir, ", or pass --git (--no-git to say no)")))
    else if git_state == "unavailable":
        note("git is not on PATH, so the folder is not a repository; install git and run git init there (a library is released from one)")
    fmt.println(next)
    return 0

// Whether `gitignore` has a line ignoring `build/`.
bool ignores_build(string8 gitignore):
    for l in all_lines(gitignore):
        string8 t = strings.trim(l)
        if t == "build/" || t == "build" || t == "/build" || t == "/build/": return true
    return false

// `git init` in `dir` when it is in no repository and the answer is yes.
// Answers what happened: "existing", "initialised", "declined", "not-asked"
// (no terminal, no flag) or "unavailable" (no git).
private string8 offer_git(string8 dir, GitChoice git, bool json):
    if git == GitChoice.No: return "declined"
    string8 git_program = on_path("git")
    if #len(git_program) == 0: return "unavailable"
    if succeeds(git_in(dir, ["rev-parse", "--git-dir"])): return "existing"
    bool yes = git == GitChoice.Yes
    if git == GitChoice.Ask:
        if !new_interactive(json): return "not-asked"
        yes = ask_git(txt(#format("Make ", dir, " a git repository (git init)? [Y/n] ")))
    if !yes: return "declined"
    if run_quietly(git_in(dir, ["init", "-q"])) != 0:
        warn(txt(#format("git init failed in ", dir, "; run it there yourself")))
        return "declined"
    return "initialised"
