// Editors and coding agents: finding them, and setting Dado up in each one
// the least intrusive way it allows.
//
//     dado editors                     set up every editor found (asks which
//                                      on a terminal)
//     dado editors --editors=cursor    only the ones named
//     dado editors --remove            take back out what dado set up
//
// **Found by command and by place.** Many people have VS Code without the
// `code` command on PATH, so each editor is looked for both ways: its command
// on PATH, then where its installer usually puts it (`/Applications/…` on
// macOS, `/usr/share/…` and `/snap/bin` on Linux, `%LOCALAPPDATA%\Programs`
// on Windows).
//
// **What is set up.** The VS Code family (VS Code, Insiders, VSCodium,
// Cursor, Windsurf) gets the install's `dado.vsix` through its own command,
// `<cli> --install-extension <vsix> --force`; the extension carries no
// binaries and finds `dado-lsp` itself. Claude Code gets a plugin that
// registers `dado-lsp` as a language server, so every edit it makes is
// checked by the compiler: a local marketplace written into
// `<install>/claude-plugin/`, added and installed with `claude plugin`. Zed,
// Neovim, Helix and Emacs are found and reported; there is no Dado package
// for them yet, and nothing is written for them.
//
// **Every change is journalled** (`journal.dado`) before it is made. An
// extension or plugin that was already there before this ran is the user's:
// it is not journalled, so `dado uninstall` never removes it.
package driver

import "core:fmt"
import "core:io"
import "core:os"
import "core:os/fs"
import "core:strings"

// An editor or coding agent this driver knows.
type Editor:
    string8 id            // the name `--editors=` takes, and the doctor's check
    string8 name          // as people call it
    string8 kind          // "vscode", "claude", or "none": nothing to set up yet
    string8 commands      // its commands, space-separated
    string8 places        // where its installer puts it, one per line

// An editor found here: which, the program to run it as ("" when it was found
// as an application with no command), and how it was found.
type Found:
    Editor e
    string8 cli
    string8 how

private Editor editor(string8 id, string8 name, string8 kind, string8 commands, string8 places):
    Editor e
    e.id = id
    e.name = name
    e.kind = kind
    e.commands = commands
    e.places = places
    return e

// Every editor this driver knows, in the order they are listed. `$HOME`,
// `$LOCALAPPDATA` and `$PROGRAMFILES` in a place are replaced when it is
// looked at.
ref []Editor known_editors():
    ref []Editor out = #make([]Editor, 0)
    when #OS == #WINDOWS:
        _ = #append(out, editor("vscode", "VS Code", "vscode", "code", "$LOCALAPPDATA\\Programs\\Microsoft VS Code\\bin\\code.cmd\n$PROGRAMFILES\\Microsoft VS Code\\bin\\code.cmd"))
        _ = #append(out, editor("vscode-insiders", "VS Code Insiders", "vscode", "code-insiders", "$LOCALAPPDATA\\Programs\\Microsoft VS Code Insiders\\bin\\code-insiders.cmd"))
        _ = #append(out, editor("vscodium", "VSCodium", "vscode", "codium", "$LOCALAPPDATA\\Programs\\VSCodium\\bin\\codium.cmd\n$PROGRAMFILES\\VSCodium\\bin\\codium.cmd"))
        _ = #append(out, editor("cursor", "Cursor", "vscode", "cursor", "$LOCALAPPDATA\\Programs\\cursor\\resources\\app\\bin\\cursor.cmd"))
        _ = #append(out, editor("windsurf", "Windsurf", "vscode", "windsurf", "$LOCALAPPDATA\\Programs\\Windsurf\\bin\\windsurf.cmd"))
        _ = #append(out, editor("claude-code", "Claude Code", "claude", "claude", ""))
        _ = #append(out, editor("zed", "Zed", "none", "zed", "$LOCALAPPDATA\\Programs\\Zed\\Zed.exe"))
        _ = #append(out, editor("neovim", "Neovim", "none", "nvim", "$PROGRAMFILES\\Neovim\\bin\\nvim.exe"))
        _ = #append(out, editor("helix", "Helix", "none", "hx", ""))
        _ = #append(out, editor("emacs", "Emacs", "none", "emacs runemacs", ""))
    else when #OS == #DARWIN:
        _ = #append(out, editor("vscode", "VS Code", "vscode", "code", "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code\n$HOME/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"))
        _ = #append(out, editor("vscode-insiders", "VS Code Insiders", "vscode", "code-insiders", "/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code-insiders\n/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code"))
        _ = #append(out, editor("vscodium", "VSCodium", "vscode", "codium", "/Applications/VSCodium.app/Contents/Resources/app/bin/codium"))
        _ = #append(out, editor("cursor", "Cursor", "vscode", "cursor", "/Applications/Cursor.app/Contents/Resources/app/bin/cursor"))
        _ = #append(out, editor("windsurf", "Windsurf", "vscode", "windsurf", "/Applications/Windsurf.app/Contents/Resources/app/bin/windsurf"))
        _ = #append(out, editor("claude-code", "Claude Code", "claude", "claude", "$HOME/.claude/local/claude"))
        _ = #append(out, editor("zed", "Zed", "none", "zed", "/Applications/Zed.app"))
        _ = #append(out, editor("neovim", "Neovim", "none", "nvim", "/opt/homebrew/bin/nvim"))
        _ = #append(out, editor("helix", "Helix", "none", "hx", "/opt/homebrew/bin/hx"))
        _ = #append(out, editor("emacs", "Emacs", "none", "emacs", "/Applications/Emacs.app"))
    else:
        _ = #append(out, editor("vscode", "VS Code", "vscode", "code", "/usr/share/code/bin/code\n/snap/bin/code\n/usr/bin/code"))
        _ = #append(out, editor("vscode-insiders", "VS Code Insiders", "vscode", "code-insiders", "/usr/share/code-insiders/bin/code-insiders\n/snap/bin/code-insiders"))
        _ = #append(out, editor("vscodium", "VSCodium", "vscode", "codium", "/usr/share/codium/bin/codium\n/snap/bin/codium"))
        _ = #append(out, editor("cursor", "Cursor", "vscode", "cursor", "/usr/share/cursor/bin/cursor\n/opt/Cursor/resources/app/bin/cursor"))
        _ = #append(out, editor("windsurf", "Windsurf", "vscode", "windsurf", "/usr/share/windsurf/bin/windsurf"))
        _ = #append(out, editor("claude-code", "Claude Code", "claude", "claude", "$HOME/.claude/local/claude"))
        _ = #append(out, editor("zed", "Zed", "none", "zed zeditor", "$HOME/.local/zed.app/bin/zed"))
        _ = #append(out, editor("neovim", "Neovim", "none", "nvim", ""))
        _ = #append(out, editor("helix", "Helix", "none", "hx helix", ""))
        _ = #append(out, editor("emacs", "Emacs", "none", "emacs", ""))
    return out

// What the places of an editor are expanded against: in a run, this
// system's own; in a test, a fake tree.
type Surroundings:
    string8 path          // the PATH to look commands up on
    string8 root          // put before every place that starts at the root
    string8 home
    string8 local_app     // %LOCALAPPDATA%
    string8 program_files // %ProgramFiles%

// This system's surroundings.
Surroundings surroundings():
    Surroundings s
    (string8 p, bool _) = env("PATH")
    s.path = p
    s.root = ""
    s.home = home_or_empty()
    (string8 la, bool _) = env("LOCALAPPDATA")
    (string8 pf, bool _) = env("ProgramFiles")
    s.local_app = la
    s.program_files = pf
    return s

// The home directory, or "" when the system will not say.
string8 home_or_empty():
    try ref []char8 h = os.home_dir() else:
        return ""
    return txt(h)

// `place` with its variables replaced; "" when it names one that is not set.
string8 expand_place(string8 place, Surroundings s):
    if strings.starts_with(place, "$HOME"):
        if #len(s.home) == 0: return ""
        return txt(#format(s.home, place[5..<#len(place)]))
    if strings.starts_with(place, "$LOCALAPPDATA"):
        if #len(s.local_app) == 0: return ""
        return txt(#format(s.local_app, place[13..<#len(place)]))
    if strings.starts_with(place, "$PROGRAMFILES"):
        if #len(s.program_files) == 0: return ""
        return txt(#format(s.program_files, place[13..<#len(place)]))
    if strings.starts_with(place, "/"):
        return txt(#format(s.root, place))
    return place

// The file `name` runs as on the PATH `dirs`, or "". On Windows a command is
// also looked for as `.exe` and `.cmd`, which is what the VS Code family
// puts on PATH.
string8 on_path_in(string8 dirs, string8 name):
    string8 rest = dirs
    for #len(rest) > 0:
        (string8 d, string8 tail, bool more) = split_byte(rest, PATH_SEP)
        if #len(d) > 0:
            string8 c = join2(d, name)
            if is_executable(c): return c
            when #OS == #WINDOWS:
                string8 exe = txt(#format(c, ".exe"))
                if is_executable(exe): return exe
                string8 cmd = txt(#format(c, ".cmd"))
                if is_executable(cmd): return cmd
        if !more: break
        rest = tail
    return ""

when #OS == #WINDOWS:
    const char8 PATH_SEP = ';'
else:
    const char8 PATH_SEP = ':'

bool is_executable(string8 p):
    ref []char8 c = strings.clone_to_cstring(p, #default)
    return fs.executable(cstring(c))

// Every editor of `known` found in `s`, in `known`'s order.
//
// `DADO_NO_EDITORS=1` finds none: the install test sets it, because asking an
// editor's command what it has installed lets the editor write its own files
// (logs, a machine id) into the home folder the test holds unchanged.
ref []Found detect_editors([]Editor known, Surroundings s):
    ref []Found out = #make([]Found, 0)
    (string8 none, bool _) = env("DADO_NO_EDITORS")
    if none == "1": return out
    for e in known:
        Found f
        f.e = e
        f.cli = ""
        f.how = ""
        for c in words_of(e.commands):
            string8 p = on_path_in(s.path, c)
            if #len(p) > 0:
                f.cli = p
                f.how = "on PATH"
                break
        if #len(f.how) == 0:
            for place in lines_of(e.places):
                string8 p = expand_place(place, s)
                if #len(p) == 0: continue
                if is_executable(p):
                    f.cli = p
                    f.how = p
                    break
                if e.kind == "none" && exists(p):
                    f.how = p
                    break
        if #len(f.how) > 0: _ = #append(out, f)
    return out

// The editors of `found` that something can be set up in.
ref []Found settable([]Found found):
    ref []Found out = #make([]Found, 0)
    for f in found:
        if f.e.kind != "none" && #len(f.cli) > 0: _ = #append(out, f)
    return out

// What `--editors=` chose among `found`: `all`, `none`, or names separated by
// commas. `why` is not empty when a name is not one this driver knows, and
// `missing` lists the names known and not found here.
(ref []Found chosen, string8 missing, string8 why) choose_editors(string8 value, []Editor known, []Found found):
    ref []Found out = #make([]Found, 0)
    ref []Found can = settable(found)
    if value == "all":
        return (can, "", "")
    if value == "none" || #len(value) == 0:
        return (out, "", "")
    strings.Builder miss = strings.builder(32)
    for word in words_of(commas_to_spaces(value)):
        string8 id = editor_alias(word)
        bool is_known = false
        for e in known:
            if e.id == id: is_known = true
        if !is_known:
            ref []string8 ids = #make([]string8, 0)
            for e in known:
                if e.kind != "none": _ = #append(ids, e.id)
            ref []char8 j = strings.join(ids[:], ", ")
            return (out, "", txt(#format("no editor `", word, "`; --editors takes all, none, or names from: ", txt(j))))
        bool here = false
        for f in can:
            if f.e.id == id:
                here = true
                if !holds_found(out[:], id): _ = #append(out, f)
        if !here:
            string8 so_far = strings.text(miss)
            _ = strings.append(&miss, " " if #len(so_far) > 0 else "")
            _ = strings.append(&miss, id)
    return (out, strings.text(miss), "")

// The short names people type for some editors.
private string8 editor_alias(string8 word):
    if word == "code": return "vscode"
    if word == "insiders" || word == "code-insiders": return "vscode-insiders"
    if word == "codium": return "vscodium"
    if word == "claude": return "claude-code"
    if word == "nvim": return "neovim"
    return word

private bool holds_found([]Found fs_, string8 id):
    for f in fs_:
        if f.e.id == id: return true
    return false

private string8 commas_to_spaces(string8 s):
    strings.Builder b = strings.builder(#len(s) + 1)
    for c in s:
        _ = strings.append_char(&b, ' ' if c == ',' else c)
    ref []char8 done = strings.finish(&b)
    return txt(done)

// An answer to the question *set up Dado in: [1] VS Code [2] Cursor …*:
// Enter, `y` or `all` is every one; `n` or `none` is none; otherwise numbers
// from the list or names, separated by spaces or commas. `ok` false when a
// word is neither.
(ref []Found chosen, bool ok) parse_answer(string8 answer, []Found offered):
    ref []Found out = #make([]Found, 0)
    string8 a = lowered(strings.trim(answer))
    if #len(a) == 0 || a == "y" || a == "yes" || a == "all":
        for f in offered:
            _ = #append(out, f)
        return (out, true)
    if a == "n" || a == "no" || a == "none":
        return (out, true)
    for word in words_of(commas_to_spaces(a)):
        (i64 n, bool num) = decimal(word)
        bool hit = false
        if num && n >= 1 && n <= #len(offered):
            if !holds_found(out[:], offered[n - 1].e.id): _ = #append(out, offered[n - 1])
            hit = true
        else:
            string8 id = editor_alias(word)
            for f in offered:
                if f.e.id == id:
                    if !holds_found(out[:], id): _ = #append(out, f)
                    hit = true
        if !hit: return (out, false)
    return (out, true)

// `s` with ASCII capitals made small.
string8 lowered(string8 s):
    strings.Builder b = strings.builder(#len(s) + 1)
    for c in s:
        if c >= 'A' && c <= 'Z':
            _ = strings.append_char(&b, char8(u8(c) + 32))
        else:
            _ = strings.append_char(&b, c)
    ref []char8 done = strings.finish(&b)
    return txt(done)

// ── the extension's identity ────────────────────────────────────────────────

// The extension id the install's `.vsix` carries, when no `package.json`
// says otherwise: the one `editors/vscode/package.json` names today.
const string8 DEFAULT_EXTENSION = "dado-lang.dado-lang"

// The string value of top-level `key` in the JSON object `text`, or "". Only
// the outermost object's keys are read, so a `name` inside `contributes` is
// never taken for the extension's.
string8 json_top_string(string8 text, string8 key):
    i64 depth = 0
    i64 i = 0
    i64 n = #len(text)
    bool expect_key = false
    for i < n:
        char8 c = text[i]
        if c == '{' || c == '[':
            depth += 1
            expect_key = c == '{' && depth == 1
            i += 1
            continue
        if c == '}' || c == ']':
            depth -= 1
            i += 1
            continue
        if c == ',':
            expect_key = depth == 1
            i += 1
            continue
        if c == '"':
            (string8 s, i64 after) = json_string_at(text, i)
            i = after
            if depth == 1 && expect_key:
                expect_key = false
                // Past the colon and any space, to the value.
                i64 j = i
                for j < n && (text[j] == ' ' || text[j] == '\t' || text[j] == '\n' || text[j] == '\r' || text[j] == ':'):
                    j += 1
                if s == key && j < n && text[j] == '"':
                    (string8 v, i64 _) = json_string_at(text, j)
                    return v
            continue
        i += 1
    return ""

// The JSON string starting at `at` (its opening quote), its escapes left as
// they are, and the index after its closing quote.
private (string8 s, i64 after) json_string_at(string8 text, i64 at):
    i64 i = at + 1
    i64 n = #len(text)
    for i < n && text[i] != '"':
        if text[i] == '\\': i += 1
        i += 1
    if i >= n: return (text[at + 1..<n], n)
    return (text[at + 1..<i], i + 1)

// The extension id `publisher.name` of `package_json`'s text, lower-case, or
// "" when either is missing.
string8 extension_id(string8 package_json):
    string8 publisher = json_top_string(package_json, "publisher")
    string8 name = json_top_string(package_json, "name")
    if #len(publisher) == 0 || #len(name) == 0: return ""
    return lowered(txt(#format(publisher, ".", name)))

// The extension's `package.json` in the install's checkout.
private string8 extension_manifest():
    return join3(root(), "editors", join2("vscode", "package.json"))

// The id of the extension the install's `.vsix` holds, and where that answer
// came from, for saying so.
(string8 id, string8 from) install_extension_id():
    string8 p = extension_manifest()
    string8 id = extension_id(read_or_empty(p))
    if #len(id) > 0: return (id, p)
    return (DEFAULT_EXTENSION, "the default, since the checkout has no editors/vscode/package.json")

// The `.vsix` an install carries, or "".
string8 install_vsix():
    Layout l = layout()
    if l.kind != "install": return ""
    string8 v = join2(l.install, "dado.vsix")
    if is_file(v): return v
    return ""

// The version inside the `.vsix` at `vsix`, read from its
// `extension/package.json` with `unzip`, else with `tar` (bsdtar, on macOS and
// Windows, reads zip archives); else the checkout's `package.json`, which the
// release built it from. "" when none answers.
string8 vsix_version(string8 vsix):
    Command u = command("unzip")
    add(&u, "-p")
    add(&u, vsix)
    add(&u, "extension/package.json")
    Captured r = capture(u, true)
    string8 v = json_top_string(txt(r.out), "version") if r.started && r.status == 0 else ""
    if #len(v) > 0: return v
    Command t = command("tar")
    add(&t, "-xOf")
    add(&t, vsix)
    add(&t, "extension/package.json")
    Captured r2 = capture(t, true)
    v = json_top_string(txt(r2.out), "version") if r2.started && r2.status == 0 else ""
    if #len(v) > 0: return v
    return json_top_string(read_or_empty(extension_manifest()), "version")

// A VS Code-family command, ready to take its arguments. Windows runs a
// `.cmd` through `cmd /c`.
Command editor_command(string8 cli):
    when #OS == #WINDOWS:
        if strings.ends_with(lowered(cli), ".cmd"):
            Command c = command("cmd")
            add(&c, "/c")
            add(&c, cli)
            return c
    return command(cli)

// Each extension `cli` has, as `id@version` lower-cased; `ok` false when it
// would not say.
(ref []string8 exts, bool ok) installed_extensions(string8 cli):
    Command c = editor_command(cli)
    add(&c, "--list-extensions")
    add(&c, "--show-versions")
    Captured r = capture(c, true)
    ref []string8 out = #make([]string8, 0)
    if !r.started || r.status != 0: return (out, false)
    for l in lines_of(txt(r.out)):
        _ = #append(out, lowered(l))
    return (out, true)

// The version of extension `id` among `exts` (`id@version` lines), and
// whether it is there.
(string8 version, bool found) extension_version([]string8 exts, string8 id):
    for e in exts:
        (string8 name, string8 v, bool _) = strings.split_first(e, "@")
        if name == id: return (v, true)
    return ("", false)

// ── Claude Code ─────────────────────────────────────────────────────────────

const string8 PLUGIN = "dado@dado-local"
const string8 MARKETPLACE = "dado-local"

// Whether Claude Code lists the Dado plugin as installed. Read from its own
// record of installed plugins rather than by running `claude`, which writes
// its settings into the home directory the first time it runs.
bool claude_has_plugin():
    string8 dir = ""
    (string8 over, bool set) = env("CLAUDE_CONFIG_DIR")
    if set:
        dir = over
    else:
        string8 home = home_or_empty()
        if #len(home) == 0: return false
        dir = join2(home, ".claude")
    return strings.contains(read_or_empty(join3(dir, "plugins", "installed_plugins.json")), PLUGIN)

// The marketplace's catalogue, naming the one plugin in it.
string8 marketplace_json():
    return "{\n  \"name\": \"dado-local\",\n  \"owner\": {\"name\": \"Dado\"},\n  \"plugins\": [\n    {\"name\": \"dado\", \"source\": \"./plugins/dado\", \"description\": \"Dado's language server: compiler diagnostics after every edit\"}\n  ]\n}\n"

// The plugin's manifest: `dado-lsp` by its absolute path, so the plugin works
// whether or not the install is on PATH.
string8 plugin_json(string8 lsp, string8 version):
    return txt(#format("{\n  \"name\": \"dado\",\n  \"version\": ", json_quote(version), ",\n  \"description\": \"Dado's language server: compiler diagnostics after every edit\",\n  \"lspServers\": {\n    \"dado\": {\n      \"command\": ", json_quote(lsp), ",\n      \"extensionToLanguage\": {\".dado\": \"dado\", \".dados\": \"dadoscript\"}\n    }\n  }\n}\n"))

// ── setting up ──────────────────────────────────────────────────────────────

// Set Dado up in `f`, journalling first. `ok` false with `why` naming the
// repair when it could not be.
(bool ok, string8 why) set_up_editor(string8 install, Found f):
    if f.e.kind == "vscode": return set_up_vscode(install, f)
    if f.e.kind == "claude": return set_up_claude(install, f)
    return (true, "")

private (bool ok, string8 why) set_up_vscode(string8 install, Found f):
    string8 vsix = install_vsix()
    if #len(vsix) == 0:
        return (false, txt(#format("this install has no dado.vsix, so ", f.e.name, " cannot be set up from it.\n  Install the Dado extension from the release archive's dado.vsix: ", f.cli, " --install-extension <dado.vsix>")))
    (string8 id, string8 from) = install_extension_id()
    if !strings.ends_with(from, "package.json"):
        note(txt(#format("  the extension's id is ", id, ": ", from)))
    (ref []string8 before, bool listed_ok) = installed_extensions(f.cli)
    if !listed_ok:
        return (false, txt(#format(f.cli, " --list-extensions did not answer, so ", f.e.name, " was left alone.\n  Run it to see why, then: dado editors --editors=", f.e.id)))
    (string8 _, bool had) = extension_version(before[:], id)
    string8 line = record_line("vscode", fields2(f.cli, id))
    ref []Record records = read_journal(install)
    if had && !journal_has(records[:], line):
        note(txt(#format("  ", f.e.name, " already has ", id, ", installed by you: it is updated and will not be removed by dado uninstall")))
    else if !had && !journal_has(records[:], line):
        journal2(install, "vscode", f.cli, id)
    Command c = editor_command(f.cli)
    add(&c, "--install-extension")
    add(&c, vsix)
    add(&c, "--force")
    Captured r = capture_merged(c)
    if !r.started || r.status != 0:
        return (false, txt(#format(f.e.name, " did not install the extension: ", last_lines(txt(r.out), 3), "\n  Try it yourself: ", shown(c))))
    return (true, "")

private (bool ok, string8 why) set_up_claude(string8 install, Found f):
    string8 dir = join2(install, "claude-plugin")
    string8 plugin_dir = join3(dir, "plugins", join2("dado", ".claude-plugin"))
    string8 market_dir = join2(dir, ".claude-plugin")
    _ = fs.make_dirs(plugin_dir, #default)
    _ = fs.make_dirs(market_dir, #default)
    string8 version = version_word(dadoc_version_line())
    if #len(version) == 0: version = "0.0.0"
    try fs.write_file(join2(market_dir, "marketplace.json"), marketplace_json()) else code:
        return (false, txt(#format("cannot write ", market_dir, ": ", os.message(code), ".\n  Make the install folder writable, then: dado editors --editors=claude-code")))
    try fs.write_file(join2(plugin_dir, "plugin.json"), plugin_json(join2(install, exe_name("dado-lsp")), version)) else code:
        return (false, txt(#format("cannot write ", plugin_dir, ": ", os.message(code), ".\n  Make the install folder writable, then: dado editors --editors=claude-code")))
    bool had = claude_has_plugin()
    string8 line = record_line("claude-plugin", fields2(PLUGIN, MARKETPLACE))
    ref []Record records = read_journal(install)
    if had && !journal_has(records[:], line):
        note(txt(#format("  Claude Code already has ", PLUGIN, ", installed by you: it is left as it is")))
        return (true, "")
    if !journal_has(records[:], line):
        journal2(install, "claude-plugin", PLUGIN, MARKETPLACE)
    Command add_m = command(f.cli)
    add(&add_m, "plugin")
    add(&add_m, "marketplace")
    add(&add_m, "add")
    add(&add_m, dir)
    Captured a = capture_merged(add_m)
    // Added by an earlier run, the marketplace is refused as a duplicate;
    // the install below says whether it is usable.
    Command inst = command(f.cli)
    add(&inst, "plugin")
    add(&inst, "install")
    add(&inst, PLUGIN)
    Captured r = capture_merged(inst)
    if !r.started || r.status != 0:
        return (false, txt(#format("Claude Code did not install the plugin: ", last_lines(txt(r.out), 2), " (", last_lines(txt(a.out), 1), ")\n  Try it yourself: ", shown(add_m), " && ", shown(inst))))
    return (true, "")

ref []string8 fields2(string8 a, string8 b):
    ref []string8 f = #make([]string8, 0)
    _ = #append(f, a)
    _ = #append(f, b)
    return f

// Set Dado up in each of `chosen`, a line each. Answers how many failed.
i64 set_up_editors(string8 install, []Found chosen):
    i64 failed = 0
    for f in chosen:
        say(txt(#format("editor ", f.e.name)))
        (bool ok, string8 why) = set_up_editor(install, f)
        if ok:
            say_green("set up", txt(#format(" ", f.e.name)))
        else:
            warn(why)
            failed += 1
    return failed

// One line for each editor found that there is nothing to set up in yet.
void report_unsupported([]Found found):
    for f in found:
        if f.e.kind == "none":
            note(txt(#format("  ", f.e.name, " is here (", f.how, "): there is no Dado package for ", f.e.name, " yet, so nothing was set up")))

// Which editors to set up, from the flags and, on a terminal, one question:
// `--editors=` when given; none with `--no-editor`, or without a terminal;
// every one found with `--yes`; otherwise the question. `ok` false when
// `--editors=` names an editor this driver does not know.
(ref []Found chosen, bool ok) pick_editors(string8 flag, bool flag_given, bool no_editor, bool yes, []Found found):
    ref []Editor known = known_editors()
    ref []Found none = #make([]Found, 0)
    if flag_given:
        (ref []Found c, string8 missing, string8 why) = choose_editors(flag, known[:], found)
        if #len(why) > 0:
            warn(why)
            return (none, false)
        if #len(missing) > 0:
            warn(txt(#format("not found here, so not set up:", " ", missing)))
        return (c, true)
    ref []Found can = settable(found)
    if no_editor || #len(can) == 0: return (none, true)
    if !(os.is_terminal(0) && os.is_terminal(1)):
        note("  not a terminal, and no --editors=: no editor is set up (dado editors --editors=all does it later)")
        return (none, true)
    if yes: return (can, true)
    strings.Builder q = strings.builder(128)
    _ = strings.append(&q, "Set up Dado in:")
    i64 i = 1
    for f in can:
        _ = strings.append(&q, txt(#format("  [", i, "] ", f.e.name)))
        i += 1
    for _ in 0..<3:
        fmt.println(strings.text(q))
        fmt.print("Enter for all, `none`, or the numbers to set up: ")
        _ = io.flush(io.stdout())
        [512]char8 buf
        (i64 n, bool got) = io.read_line_into(io.stdin(), buf[:])
        if !got: return (none, true)
        string8 answer = string8(buf[0..<n])
        (ref []Found picked, bool good) = parse_answer(answer, can[:])
        if good: return (picked, true)
        fmt.println("  `", answer, "` is not an answer: numbers from the list, names, `all` or `none`.")
    return (none, true)

// ── the `editors` verb ──────────────────────────────────────────────────────

// `dado editors [--editors=…] [--remove] [--yes]`.
i32 editors_command(string8 flag, bool flag_given, bool remove, bool yes):
    Layout l = layout()
    if l.kind != "install":
        die("dado editors sets editors up from an install (its dado.vsix and dado-lsp), and this is a\n  checkout of the repository. In a checkout: ./build_lsp.sh --link")
    if remove:
        return remove_editors(l.install)
    ref []Editor known = known_editors()
    ref []Found found = detect_editors(known[:], surroundings())
    report_unsupported(found[:])
    (ref []Found chosen, bool ok) = pick_editors(flag, flag_given, false, yes, found[:])
    if !ok: return 1
    if #len(chosen) == 0:
        ref []Found can = settable(found[:])
        if #len(can) == 0:
            say("no editor that Dado can be set up in was found")
        return 0
    if set_up_editors(l.install, chosen[:]) > 0: return 1
    return 0

// ── what the doctor says ────────────────────────────────────────────────────

// A check for each editor found here, named by its id: `ok` when Dado is set
// up in it and matches the install, `warn` when it is out of date or not set
// up, `note` for an editor with no Dado package yet. When none is found, one
// `vscode` note says so.
ref []Check editor_checks(bool install):
    ref []Check out = #make([]Check, 0)
    ref []Editor known = known_editors()
    ref []Found found = detect_editors(known[:], surroundings())
    string8 set_up = "dado editors"
    if !install: set_up = "at the root of the checkout: ./build_lsp.sh --link"
    (string8 id, string8 _) = install_extension_id()
    string8 vsix = install_vsix()
    string8 want = ""
    if #len(vsix) > 0: want = vsix_version(vsix)
    for f in found:
        if f.e.kind == "none":
            _ = #append(out, editor_check(f.e.id, "note", txt(#format(f.e.name, " is here: there is no Dado package for it yet")), ""))
        else if f.e.kind == "claude":
            if claude_has_plugin():
                _ = #append(out, editor_check(f.e.id, "ok", txt(#format("Claude Code has the Dado plugin (", PLUGIN, "): dado-lsp checks its edits")), ""))
            else:
                _ = #append(out, editor_check(f.e.id, "warn", "Claude Code is here without the Dado plugin: its edits get no compiler diagnostics", txt(#format(set_up, " --editors=claude-code")) if install else ""))
        else if #len(f.cli) == 0:
            _ = #append(out, editor_check(f.e.id, "note", txt(#format(f.e.name, " is here (", f.how, ") without its command, so whether it has Dado cannot be asked")), ""))
        else:
            (ref []string8 exts, bool ok) = installed_extensions(f.cli)
            (string8 have, bool has) = extension_version(exts[:], id)
            if !ok:
                _ = #append(out, editor_check(f.e.id, "note", txt(#format(f.cli, " --list-extensions did not answer")), ""))
            else if !has:
                _ = #append(out, editor_check(f.e.id, "warn", txt(#format(f.e.name, " is here without the Dado extension (", id, ")")), txt(#format(set_up, " --editors=", f.e.id)) if install else set_up))
            else if #len(want) > 0 && have != want:
                _ = #append(out, editor_check(f.e.id, "warn", txt(#format(f.e.name, " has the Dado extension ", have, ", and this install's is ", want, ": out of date")), txt(#format("dado editors --editors=", f.e.id))))
            else:
                _ = #append(out, editor_check(f.e.id, "ok", txt(#format(f.e.name, " has the Dado extension (", id, "@", have, ")")), ""))
    if #len(found) == 0:
        _ = #append(out, editor_check("vscode", "note", "no editor Dado knows was found (VS Code, Cursor, Windsurf, VSCodium, Claude Code, Zed, Neovim, Helix, Emacs)", ""))
    return out

private Check editor_check(string8 name, string8 status, string8 detail, string8 repair):
    Check c
    c.name = name
    c.status = status
    c.detail = detail
    c.repair = repair
    return c
