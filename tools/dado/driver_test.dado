@test
// The driver's pure logic: reading `defaults`, finding the toolchain's root
// over a fake tree, reading a build manifest, the compiler's argument lists,
// and where a package's artifacts go.
//
// What is not here, and is exercised by running the driver instead: the
// commands themselves, which start `dadoc` and a C compiler.
package driver

import "core:mem/arena"
import "core:mem/libc"
import "core:os"
import "core:os/fs"
import "core:strings"

private bool is(string8 got, string8 want, string8 what):
    return #expect(got == want, what, " is `", got, "`, not `", want, "`")

private bool words_are([]string8 got, string8 want, string8 what):
    ref []char8 j = strings.join(got, " ")
    return #expect(txt(j) == want, what, " is `", txt(j), "`, not `", want, "`")

// ── defaults ────────────────────────────────────────────────────────────────

private const string8 DEFAULTS = "# a comment\n\nDADOC_CANDIDATES=\"$ROOT/bin/dadoc\n$ROOT/dadoc\"\n\nCFLAGS_BASE=\"-std=c11 -Wall\"\nEMPTY=\"\"\n  # indented comment\nLAST=\"x\""

private bool defaults_read():
    bool ok = true
    (ref []Setting s, bool good, string8 why) = parse_defaults(DEFAULTS)
    ok = #expect(good, "the defaults did not parse: ", why) && ok
    ok = #expect(#len(s) == 4, "the defaults hold ", #len(s), " settings, not 4") && ok
    (string8 cand, bool found) = setting_in(s[:], "DADOC_CANDIDATES")
    ok = #expect(found, "DADOC_CANDIDATES is missing") && ok
    ok = is(cand, "$ROOT/bin/dadoc\n$ROOT/dadoc", "a value across two lines") && ok
    ref []string8 lines = lines_of(with_root(cand, "/opt/dado"))
    ok = words_are(lines[:], "/opt/dado/bin/dadoc /opt/dado/dadoc", "the candidates with $ROOT replaced") && ok
    (string8 base, bool _) = setting_in(s[:], "CFLAGS_BASE")
    ok = is(base, "-std=c11 -Wall", "CFLAGS_BASE") && ok
    (string8 empty, bool efound) = setting_in(s[:], "EMPTY")
    ok = #expect(efound && #len(empty) == 0, "an empty value") && ok
    (string8 last, bool _) = setting_in(s[:], "LAST")
    ok = is(last, "x", "the last value, with no newline after it") && ok
    (string8 _, bool none) = setting_in(s[:], "NOPE")
    ok = #expect(!none, "a name that is not there was found") && ok

    (ref []Setting _, bool bad1, string8 why1) = parse_defaults("CFLAGS=-O2\n")
    ok = #expect(!bad1 && strings.contains(why1, "line 1"), "an unquoted value was accepted: ", why1) && ok
    (ref []Setting _, bool bad2, string8 why2) = parse_defaults("A=\"1\"\nB=\"never closed\n")
    ok = #expect(!bad2 && strings.contains(why2, "no closing quote"), "an unclosed value was accepted: ", why2) && ok
    (ref []Setting _, bool bad3, string8 why3) = parse_defaults("lower=\"x\"\n")
    ok = #expect(!bad3, "a lower-case name was accepted: ", why3) && ok
    ok = is(pinned_zig("# zig\nversion 0.16.0\n"), "0.16.0", "ZIG_PIN's version") && ok
    return ok

// ── the root, over a fake tree ──────────────────────────────────────────────

private bool make(string8 dir):
    try fs.make_dirs(dir) else:
        return false
    return true

private bool touch(string8 file):
    try fs.write_file(file, "") else:
        return false
    return true

private bool roots_found():
    bool ok = true
    try ref []char8 made = fs.make_temp_dir("dado-driver-test") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 t = txt(made)

    // A checkout, with a build directory that mirrors `collections/core`.
    string8 repo = join2(t, "repo")
    ok = #expect(make(join3(repo, "collections", "core")), "making the checkout") && ok
    ok = #expect(make(join3(repo, "tools", "dado")), "making tools/dado") && ok
    ok = #expect(touch(join3(repo, "tools", join2("dado", "defaults"))), "writing defaults") && ok
    ok = #expect(make(join3(repo, "build", join2("collections", "core"))), "making the decoy") && ok
    ok = #expect(make(join3(repo, "build", "tools")), "making build/tools") && ok
    Layout l = locate(join3(repo, "build", "tools"))
    ok = #expect(l.found, "no root above the checkout's build/tools") && ok
    ok = is(l.kind, "monorepo", "the checkout's layout") && ok
    ok = is(l.root, repo, "the checkout's root") && ok
    ok = is(l.install, "", "a checkout's install") && ok
    Layout at_root = locate(repo)
    ok = is(at_root.root, repo, "the root found from the root itself") && ok

    // An install: `bin/` beside `src/`, and the root is `src`.
    string8 inst = join2(t, "inst")
    string8 src = join2(inst, "src")
    ok = #expect(make(join3(src, "collections", "core")), "making the install") && ok
    ok = #expect(make(join3(src, "tools", "dado")), "making the install's tools/dado") && ok
    ok = #expect(touch(join3(src, "tools", join2("dado", "defaults"))), "writing the install's defaults") && ok
    ok = #expect(make(join2(inst, "bin")), "making bin") && ok
    Layout i = locate(join2(inst, "bin"))
    ok = #expect(i.found, "no root above the install's bin") && ok
    ok = is(i.kind, "install", "the install's layout") && ok
    ok = is(i.root, src, "the install's root") && ok
    ok = is(i.install, inst, "the install's directory") && ok

    // A tree with `collections/core` and no driver settings is neither.
    string8 bare = join2(t, "bare")
    ok = #expect(make(join3(bare, "collections", "core")), "making the bare tree") && ok
    ok = #expect(make(join2(bare, "x")), "making bare/x") && ok
    Layout n = locate(join2(bare, "x"))
    ok = #expect(!n.found || n.root != bare, "a tree without tools/dado/defaults was taken for a root") && ok

    try fs.remove_all(t) else code:
        ok = #expect(false, "removing the fake tree: ", os.message(code)) && ok
    return ok

// ── the project (F12) and its collections overlay ───────────────────────────

private bool projects_found():
    bool ok = true
    try ref []char8 made = fs.make_temp_dir("dado-project-test") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 t = txt(made)

    // A work tree: `.git` at its top, and a project with `dado.json` inside it.
    string8 tree = join2(t, "tree")
    ok = #expect(make(join2(tree, ".git")), "making .git") && ok
    ok = #expect(make(join3(tree, "libs", "db")), "making libs/db") && ok
    ok = is(project_root(join3(tree, "libs", "db")), tree, "the work tree's top, with no dado.json") && ok
    string8 proj = join2(tree, "game")
    ok = #expect(make(join3(proj, "features", "cabinet")), "making the project") && ok
    ok = #expect(touch(join2(proj, "dado.json")), "writing dado.json") && ok
    ok = is(project_root(join3(proj, "features", "cabinet")), proj, "dado.json before .git") && ok
    ok = is(project_root(proj), proj, "the project found from itself") && ok
    ok = is(project_root(join2(t, "elsewhere")), "", "no project") && ok
    // Every verb anywhere in a project builds into the project's `build/`:
    // `dado run .` at its root too, which wrote to the directory above it.
    ok = is(package_build_base(proj), proj, "the build base of the project's own package") && ok
    ok = is(package_build_base(join3(proj, "features", "cabinet")), proj, "the build base of a package in the project") && ok
    ok = is(package_build_base(join3(tree, "libs", "db")), tree, "the build base in a work tree") && ok
    ok = is(package_build_base(join2(t, "elsewhere")), "", "no build base outside every project") && ok
    ok = is(build_stem(proj, proj), "game", "the project's own package's stem") && ok
    // In an install, the checkout stays exactly the repository's, or `dado
    // update` refuses it: a package inside it builds into the install's own
    // `build/`, beside the checkout, as the toolchain's own builds do. A
    // project elsewhere keeps its own `build/`.
    Layout before = g_layout
    (string8 bd, bool bd_set) = env("DADO_BUILD_DIR")
    try os.unset_env("DADO_BUILD_DIR") else code:
        return #expect(false, "cannot unset DADO_BUILD_DIR: ", os.message(code))
    g_layout.kind = "install"
    g_layout.root = tree
    g_layout.install = join2(t, "install")
    ok = is(build_dir_for(join3(tree, "libs", "db")), join3(t, "install", "build"), "a package in an install's checkout builds beside it") && ok
    ok = is(build_dir_for(tree), join3(t, "install", "build"), "the install's checkout itself builds beside it") && ok
    ok = is(build_dir_for(join2(t, "elsewhere")), join3(t, "install", "build"), "outside every project, the install's build/") && ok
    g_layout.root = join2(t, "toolchain")
    ok = is(build_dir_for(join3(tree, "libs", "db")), join2(tree, "build"), "a work tree outside the install keeps its own build/") && ok
    g_layout = before
    if bd_set:
        try os.set_env("DADO_BUILD_DIR", bd) else code:
            ok = #expect(false, "cannot restore DADO_BUILD_DIR: ", os.message(code)) && ok

    // The overlay, and what it replaces: a standard package the collections
    // also have is reported; one they do not is not.
    string8 std = join2(t, "toolchain")
    ok = #expect(make(join3(std, "collections", join2("core", "strings"))), "making the standard collections") && ok
    Layout saved = g_layout
    g_layout.root = std
    // The collections root in use is `DADO_COLLECTIONS` when it is set (the
    // gate sets it for some runs): pinned to the fake toolchain's here.
    (string8 was, bool was_set) = env("DADO_COLLECTIONS")
    try os.set_env("DADO_COLLECTIONS", join2(std, "collections")) else code:
        return #expect(false, "cannot set DADO_COLLECTIONS: ", os.message(code))
    ok = is(project_overlay(proj), "", "no collections/ directory, no overlay") && ok
    string8 overlay = join2(proj, "collections")
    ok = #expect(make(join3(overlay, "core", "strings")), "making the overlay's strings") && ok
    ok = #expect(touch(join3(overlay, join2("core", "strings"), "s.dado")), "writing s.dado") && ok
    ok = #expect(make(join3(overlay, "core", "cbor")), "making the overlay's cbor") && ok
    ok = #expect(touch(join3(overlay, join2("core", "cbor"), "c.dado")), "writing c.dado") && ok
    ok = is(project_overlay(proj), overlay, "the project's collections/") && ok
    ref []string8 shadows = overlay_shadows(overlay)
    ok = words_are(shadows[:], "core:strings", "what the overlay replaces") && ok
    ok = is(project_overlay(std), "", "the toolchain's own collections are no overlay") && ok
    // Nor when a build points the collections elsewhere: a checkout of the
    // toolchain is a project whose `collections/` is the standard one.
    try os.set_env("DADO_COLLECTIONS", join2(t, "fixtures")) else code:
        return #expect(false, "cannot set DADO_COLLECTIONS: ", os.message(code))
    ok = is(project_overlay(std), "", "the toolchain's own collections, with the root moved") && ok
    try os.set_env("DADO_COLLECTIONS", join2(std, "collections")) else code:
        return #expect(false, "cannot set DADO_COLLECTIONS: ", os.message(code))
    ref []string8 flags = imports_flags(join3(proj, "features", "cabinet"))
    ok = words_are(flags[:], txt(#format("--project=", proj, " --overlay=", overlay)), "the lookup flags") && ok
    g_layout = saved
    if was_set:
        try os.set_env("DADO_COLLECTIONS", was) else code:
            ok = #expect(false, "cannot restore DADO_COLLECTIONS: ", os.message(code)) && ok
    else:
        try os.unset_env("DADO_COLLECTIONS") else code:
            ok = #expect(false, "cannot unset DADO_COLLECTIONS: ", os.message(code)) && ok

    try fs.remove_all(t) else code:
        ok = #expect(false, "removing the fake tree: ", os.message(code)) && ok
    return ok

// ── one test file of a library, run against its package ─────────────────

private bool write(string8 file, string8 text):
    try fs.write_file(file, text) else:
        return false
    return true

private bool test_files_placed():
    bool ok = true
    try ref []char8 made = fs.make_temp_dir("dado-testfile-test") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 t = txt(made)
    // A library and its test: the test belongs to the directory's package.
    string8 q = join2(t, "q")
    ok = #expect(make(q), "making q") && ok
    ok = #expect(write(join2(q, "q.dado"), "// q\npackage q\n\ni32 f(): return 7\n"), "writing q.dado") && ok
    ok = #expect(write(join2(q, "q_test.dado"), "@test\n// its test\npackage q\n"), "writing q_test.dado") && ok
    (string8 dir, bool member) = test_file_package(join2(q, "q_test.dado"))
    ok = #expect(member, "a library's test file was not run against its package") && ok
    ok = is(dir, q, "the test file's package") && ok
    // Single-file programs side by side (`package main`, written or not)
    // each stand alone, as does a library file with no sibling.
    string8 cases = join2(t, "cases")
    ok = #expect(make(cases), "making cases") && ok
    ok = #expect(write(join2(cases, "a.dado"), "@test\npackage main\n"), "writing a.dado") && ok
    ok = #expect(write(join2(cases, "b.dado"), "package main\n"), "writing b.dado") && ok
    ok = #expect(write(join2(cases, "c.dado"), "i32 main(): return 0\n"), "writing c.dado") && ok
    (string8 _, bool alone) = test_file_package(join2(cases, "a.dado"))
    ok = #expect(!alone, "a single-file program was run against its directory") && ok
    string8 lone = join2(t, "lone")
    ok = #expect(make(lone), "making lone") && ok
    ok = #expect(write(join2(lone, "l_test.dado"), "@test\npackage l\n"), "writing l_test.dado") && ok
    ok = #expect(write(join2(lone, "other.dado"), "package other\n"), "writing other.dado") && ok
    (string8 _, bool lone_member) = test_file_package(join2(lone, "l_test.dado"))
    ok = #expect(!lone_member, "a file with no sibling of its package was run against its directory") && ok
    try fs.remove_all(t) else code:
        ok = #expect(false, "removing the fake tree: ", os.message(code)) && ok
    return ok

// ── the build manifest ──────────────────────────────────────────────────────

private const string8 MANIFEST = "include /r/collections/core/fmt\ninclude /r/corpus/x\nsource /r/corpus/x/args.c\nheader args.h\nheader stdio.h\ntoolchain-header stdio.h\nlink -lm   -lpthread\nflags -DX=1 -I/opt/inc\nos #LINUX\ntarget x86_64-pc-linux-gnu\narch #X86_64\nlive core:fmt\ninline-c a.dado 3 top-level\nforeign-macro memcpy macro\ninstantiation 4 nominal\nimplementation SOKOL_IMPL\nwasm-import env f\nwasm-export main\nc-export dado_x__answer\nchannel s 0\nengine quickjs\njs-module m.js\npass inline on\ncosts abc\nplan def\n\n"

private bool manifest_read():
    bool ok = true
    (Manifest m, bool good, string8 why) = parse_manifest(MANIFEST)
    ok = #expect(good, "the manifest did not parse: ", why) && ok
    ok = words_are(m.includes[:], "/r/collections/core/fmt /r/corpus/x", "include") && ok
    ok = words_are(m.sources[:], "/r/corpus/x/args.c", "source") && ok
    ok = words_are(m.headers[:], "args.h stdio.h", "header") && ok
    ok = words_are(m.toolchain[:], "stdio.h", "toolchain-header") && ok
    ok = words_are(m.links[:], "-lm -lpthread", "link, split on whitespace") && ok
    ok = words_are(m.flags[:], "-DX=1 -I/opt/inc", "flags, split on whitespace") && ok
    ok = words_are(m.exports[:], "dado_x__answer", "c-export") && ok
    ok = is(m.os, "#LINUX", "os") && ok
    ok = is(m.engine, "quickjs", "engine") && ok
    (Manifest _, bool bad, string8 why2) = parse_manifest("include /a\nmystery line here\n")
    ok = #expect(!bad, "an unknown manifest line was accepted") && ok
    ok = is(why2, "unrecognised build manifest line: mystery line here", "the refusal") && ok
    (Manifest e, bool empty_ok, string8 _) = parse_manifest("")
    ok = #expect(empty_ok && #len(e.includes) == 0 && e.os == "", "an empty manifest") && ok
    return ok

// ── the compiler's argument lists ───────────────────────────────────────────

private bool flags_assembled():
    bool ok = true
    // F1: zig is never handed `address` in a combined list.
    ref []string8 cf = words_of("-fsanitize=address,undefined,float-cast-overflow -fno-sanitize-recover=undefined,float-cast-overflow -g1")
    ref []string8 cz = without_address(cf[:])
    ok = words_are(cz[:], "-fsanitize=undefined,float-cast-overflow -fno-sanitize-recover=undefined,float-cast-overflow -g1", "the flags without address") && ok
    ref []string8 alone = words_of("-fsanitize=address -O2")
    ref []string8 dropped = without_address(alone[:])
    ok = words_are(dropped[:], "-O2", "a list of address alone, dropped") && ok
    (ref []string8 zc, ref []string8 zl) = sanitizer_words("-fsanitize=address,undefined -g1", "-fsanitize=address,undefined", true)
    ok = words_are(zc[:], "-fsanitize=undefined -g1", "zig's sanitizer cflags") && ok
    ok = words_are(zl[:], "-fsanitize=undefined", "zig's sanitizer ldflags") && ok
    (ref []string8 gc, ref []string8 _) = sanitizer_words("-fsanitize=address,undefined -g1", "-fsanitize=address,undefined", false)
    ok = words_are(gc[:], "-fsanitize=address,undefined -g1", "clang's sanitizer cflags, untouched") && ok
    ref []string8 tsan = words_of("-fsanitize=thread,undefined")
    ref []string8 tz = without_address(tsan[:])
    ok = words_are(tz[:], "-fsanitize=thread,undefined", "a thread list under zig") && ok

    // F2: exports under zig are `-rdynamic`.
    ref []string8 syms = words_of("a b")
    ref []string8 elf = export_flags("#LINUX", syms[:], false)
    ok = words_are(elf[:], "-Wl,--export-dynamic-symbol=a -Wl,--export-dynamic-symbol=b", "ELF exports") && ok
    ref []string8 zelf = export_flags("#LINUX", syms[:], true)
    ok = words_are(zelf[:], "-rdynamic", "exports under zig") && ok
    ref []string8 mac = export_flags("#DARWIN", syms[:], false)
    ok = words_are(mac[:], "-Wl,-export_dynamic", "Darwin's exports") && ok
    ref []string8 win = export_flags("#WINDOWS", syms[:], true)
    ok = #expect(#len(win) == 0, "Windows takes no export flag") && ok
    ref []string8 none = words_of("")
    ref []string8 nothing = export_flags("#LINUX", none[:], false)
    ok = #expect(#len(nothing) == 0, "no export, no flag") && ok

    // The link line's order is the contract the head of cc.dado states.
    Link k = new_link()
    k.cc = words_of("zig cc")
    k.base = words_of("-std=c11")
    k.interop = words_of("-Werror=int-conversion")
    k.werror = words_of("-Werror")
    k.opt = words_of("-O2")
    k.extra = words_of("-DCLAUSE")
    k.san_c = words_of("-fsanitize=undefined")
    k.includes = words_of("-I/p -DUSER")
    k.c_file = "x.c"
    k.sources = words_of("s.c")
    k.out = "x"
    k.libs = words_of("-L/brew -lm")
    k.exports = words_of("-rdynamic")
    k.san_l = words_of("-fsanitize=undefined")
    k.ldflags = words_of("-L/mine")
    Command c = link_command(&k)
    ok = words_are(c.words[:], "zig cc -std=c11 -Werror=int-conversion -Werror -O2 -DCLAUSE -fsanitize=undefined -I/p -DUSER x.c s.c -o x -L/brew -lm -rdynamic -fsanitize=undefined -L/mine", "the link line") && ok
    // A library two packages each link (core:math and the compiler's own math
    // both `link "-lm"`), and the engine's: once, at its last place, which is
    // after the engine's archive (GNU ld reads the line once). Apple's ld warns
    // on the repeat. Words that are not `-l` stay, repeats and all.
    k.libs = words_of("-L/brew -lm -lpthread -lm -framework Cocoa -framework Metal /q/libquickjs.a -lm -lpthread")
    Command once = link_command(&k)
    ok = words_are(once.words[:], "zig cc -std=c11 -Werror=int-conversion -Werror -O2 -DCLAUSE -fsanitize=undefined -I/p -DUSER x.c s.c -o x -L/brew -framework Cocoa -framework Metal /q/libquickjs.a -lm -lpthread -rdynamic -fsanitize=undefined -L/mine", "the link line's libraries, each -l once and after the archive that needs it") && ok
    ref []string8 no_words = words_of("")
    ref []string8 none_libs = libraries_once(no_words[:])
    ok = #expect(#len(none_libs) == 0, "no libraries, none kept") && ok
    k.libs = words_of("-L/brew -lm")
    Command obj = object_command(&k, "s.c", "s.o")
    ok = words_are(obj.words[:], "zig cc -std=c11 -Werror=int-conversion -Werror -O2 -ffreestanding -c -DCLAUSE -fsanitize=undefined -I/p -DUSER s.c -o s.o", "a freestanding object's line") && ok
    // `#NONE`'s own words (`CFLAGS_NONE`) stand where `-ffreestanding` did,
    // before the clauses and the sanitizer, which turns UBSan back on.
    k.freestanding = words_of("-ffreestanding -fno-sanitize=undefined -fno-stack-protector")
    Command none_obj = object_command(&k, "s.c", "s.o")
    ok = words_are(none_obj.words[:], "zig cc -std=c11 -Werror=int-conversion -Werror -O2 -ffreestanding -fno-sanitize=undefined -fno-stack-protector -c -DCLAUSE -fsanitize=undefined -I/p -DUSER s.c -o s.o", "a #NONE object's line") && ok

    Compiler z = zig_compiler("/z/zig", "x86_64-windows-gnu")
    ok = words_are(z.words[:], "/z/zig cc -target x86_64-windows-gnu -mcpu=baseline", "zig with a target") && ok
    // T36: every zig compile is for the architecture's generic CPU, never the
    // one the build runs on.
    Compiler n = zig_compiler("/z/zig", "")
    ok = words_are(n.words[:], "/z/zig cc -mcpu=baseline", "zig for this machine") && ok
    ok = #expect(z.zig && z.name == "zig cc", "zig is zig") && ok
    Compiler g = given_compiler("clang")
    ok = #expect(!g.zig && g.name == "clang", "clang is not zig") && ok
    ok = #expect(given_compiler("scripts/zigcc").zig, "a program named zig* is taken for zig") && ok
    return ok

// ── the sanitizing compiler a build without --cc falls back to ─────────────

private string8 places_of(string8 os):
    ref []string8 w = #make([]string8, 0)
    for p in compiler_places(os):
        w = #append(w, txt(#format(p.how, ":", p.what)))
    return txt(strings.join(w[:], " "))

private bool sanitizing_fallback():
    bool ok = true
    // Where compilers are looked for, by host (`compiler_places`): gcc and
    // clang on PATH, then their versioned names, newest first, then the
    // system's own places.
    ok = is(places_of("#LINUX"), "path:gcc path:clang path:gcc-14 path:gcc-13 path:gcc-12 path:gcc-11 path:gcc-10 path:gcc-9 path:clang-20 path:clang-19 path:clang-18 path:clang-17 path:clang-16 path:clang-15 path:clang-14 file:/usr/bin/gcc file:/usr/bin/clang glob:/usr/bin/gcc-[0-9]* glob:/usr/bin/clang-[0-9]* file:/usr/local/bin/gcc file:/usr/local/bin/clang glob:/usr/local/bin/gcc-[0-9]* glob:/usr/local/bin/clang-[0-9]* glob:/usr/lib/llvm-*/bin/clang", "Linux's places") && ok
    string8 on_path_names = "path:gcc path:clang path:gcc-14 path:gcc-13 path:gcc-12 path:gcc-11 path:gcc-10 path:gcc-9 path:clang-20 path:clang-19 path:clang-18 path:clang-17 path:clang-16 path:clang-15 path:clang-14"
    ok = is(places_of("#DARWIN"), txt(#format(on_path_names, " xcrun:clang file:/opt/homebrew/opt/llvm/bin/clang file:/usr/local/opt/llvm/bin/clang glob:/opt/homebrew/bin/gcc-[0-9]* glob:/usr/local/bin/gcc-[0-9]*")), "macOS's places") && ok
    ok = is(places_of("#WINDOWS"), txt(#format(on_path_names, " file:C:\\msys64\\ucrt64\\bin\\gcc.exe file:C:\\msys64\\ucrt64\\bin\\clang.exe file:C:\\msys64\\mingw64\\bin\\gcc.exe file:C:\\msys64\\mingw64\\bin\\clang.exe file:C:\\msys64\\clang64\\bin\\gcc.exe file:C:\\msys64\\clang64\\bin\\clang.exe file:C:\\Program Files\\LLVM\\bin\\clang.exe")), "Windows' places") && ok
    ok = is(places_of("#FREEBSD"), on_path_names, "another host's places: PATH alone") && ok

    // A glob's matches, newest version first, whatever byte order said.
    ref []string8 g = #make([]string8, 0)
    g = #append(g, "/usr/bin/gcc-10")
    g = #append(g, "/usr/bin/gcc-13")
    g = #append(g, "/usr/bin/gcc-9")
    newest_first(g[:])
    ok = words_are(g[:], "/usr/bin/gcc-13 /usr/bin/gcc-10 /usr/bin/gcc-9", "versions newest first") && ok
    ok = #expect(version_number("/usr/lib/llvm-18/bin/clang") == 18, "llvm-18's version") && ok
    ok = #expect(version_number("/usr/bin/clang") == 0 - 1, "an unversioned name's version") && ok
    // The version a `--version` line names.
    ok = is(version_of("gcc (Ubuntu 13.3.0-6ubuntu2~24.04) 13.3.0"), "13.3.0", "gcc's version") && ok
    ok = is(version_of("Ubuntu clang version 18.1.3 (1ubuntu1)"), "18.1.3", "clang's version") && ok
    ok = is(version_of("Apple clang version 17.0.0 (clang-1700.0.13.5)"), "17.0.0", "Apple clang's version") && ok
    ok = is(version_of("gcc-14 (Homebrew GCC 14.2.0_1) 14.2.0"), "14.2.0", "Homebrew gcc's version") && ok
    ok = is(version_of(""), "", "no version") && ok

    // When: a sanitized `address` build, native, with no --cc. Whether a
    // build is sanitized is `Options.sanitize`'s answer alone.
    ok = #expect(wants_sanitizing_cc(true, "address", "", false), "a sanitized build falls back") && ok
    ok = #expect(!wants_sanitizing_cc(false, "address", "", false), "an unsanitized build does not") && ok
    ok = #expect(!wants_sanitizing_cc(true, "address", "zig", false), "`--cc zig` does not") && ok
    ok = #expect(!wants_sanitizing_cc(true, "address", "gcc", false), "an explicit `--cc` does not") && ok
    ok = #expect(!wants_sanitizing_cc(true, "address", "", true), "a cross-compile does not") && ok
    ok = #expect(!wants_sanitizing_cc(true, "thread", "", false), "TSan, which zig has, does not") && ok

    // The line a sanitized build says when it leaves zig: `CC` first when
    // it is set, and said when it was passed over, with why.
    ok = #expect(!strings.contains(sanitizing_note("gcc", false, "", false), "CC"), "no CC, and it was named") && ok
    ok = #expect(strings.contains(sanitizing_note("clang", true, "clang", true), "sanitizing with clang (CC):"), "CC's compiler was not said to be CC's: ", sanitizing_note("clang", true, "clang", true)) && ok
    ok = #expect(strings.contains(sanitizing_note("gcc", false, "clang", true), "CC=clang cannot build and run an AddressSanitizer program here"), "a CC passed over was not said: ", sanitizing_note("gcc", false, "clang", true)) && ok
    ok = #expect(strings.contains(sanitizing_note("gcc", false, "nocc", false), "CC=nocc is not a program that runs here"), "a CC that does not run was not said: ", sanitizing_note("gcc", false, "nocc", false)) && ok

    // `dado doctor`'s table: a row per compiler, the chosen one marked.
    ref []CompilerRow rows = #make([]CompilerRow, 0)
    CompilerRow r1
    r1.name = "gcc"
    r1.version = "13.3.0"
    r1.file = "/usr/bin/gcc"
    r1.via = "PATH"
    r1.asan = "yes"
    r1.ubsan = "yes"
    r1.chosen = true
    rows = #append(rows, r1)
    CompilerRow r2
    r2.name = "zig cc"
    r2.version = "0.16.0"
    r2.file = "/z/zig"
    r2.via = "pin"
    r2.asan = "no"
    r2.ubsan = "yes"
    r2.chosen = false
    rows = #append(rows, r2)
    ok = is(compilers_text(rows[:], "", false), "\nC compilers (CC, then PATH, then the usual places):\n    compiler  version  ASan   UBSan  found  path\n  * gcc       13.3.0   yes    yes    PATH   /usr/bin/gcc\n    zig cc    0.16.0   no     yes    pin    /z/zig\n  * dado test and --debug build with gcc\n", "doctor's compiler table") && ok
    ok = #expect(strings.contains(compilers_text(rows[:], "nocc", false), "CC=nocc is set, and is not a program that runs here"), "a CC that does not run is not in the table") && ok
    ok = is(compilers_json(rows[1..<2]), "[\n    {\"name\": \"zig cc\", \"version\": \"0.16.0\", \"path\": \"/z/zig\", \"found\": \"pin\", \"asan\": \"no\", \"ubsan\": \"yes\", \"chosen\": false}\n  ]", "doctor's compiler JSON") && ok
    ok = is(with_compilers("{\n  \"checks\": []\n}\n", "[]"), "{\n  \"checks\": [],\n  \"compilers\": []\n}\n", "the report with its compilers") && ok

    // One target spelling sets both: `DADO_TARGET` alone names zig's target
    // too when it is a hosted system other than this one, in zig's spelling.
    ok = is(zig_target_of("x86_64-pc-windows-gnu", "#LINUX"), "x86_64-windows-gnu", "the Windows target from Linux") && ok
    ok = is(zig_target_of("x86_64-w64-mingw32", "#LINUX"), "x86_64-windows-gnu", "MinGW's spelling") && ok
    ok = is(zig_target_of("aarch64-apple-darwin", "#LINUX"), "aarch64-macos", "macOS from Linux") && ok
    ok = is(zig_target_of("x86_64-unknown-linux-gnu", "#WINDOWS"), "x86_64-linux-gnu", "Linux from Windows") && ok
    ok = is(zig_target_of("x86_64-unknown-linux-gnu", "#LINUX"), "", "this system's own") && ok
    ok = is(zig_target_of("x86_64-unknown-none", "#LINUX", "x86_64"), "", "a freestanding target for this machine, compiled for its ABI as before") && ok
    ok = is(zig_target_of("x86_64-unknown-none", "#LINUX", "aarch64"), "x86_64-freestanding", "a freestanding x86-64 from another machine") && ok
    ok = is(zig_target_of("i386-unknown-none", "#LINUX", "x86_64"), "x86-freestanding", "i386 freestanding from x86-64") && ok
    ok = is(zig_target_of("i686-unknown-none", "#LINUX", "x86_64"), "x86-freestanding", "i686, the same family") && ok
    ok = is(zig_target_of("aarch64-unknown-none", "#LINUX", "x86_64"), "aarch64-freestanding", "aarch64 freestanding") && ok
    ok = is(zig_target_of("riscv64-unknown-elf", "#LINUX", "x86_64"), "riscv64-freestanding", "riscv64's elf spelling") && ok
    ok = is(zig_target_of("arm-none-eabi", "#LINUX", "x86_64"), "arm-freestanding-eabi", "arm's eabi") && ok
    ok = is(zig_target_of("thumbv7m-none-eabi", "#LINUX", "x86_64"), "thumb-freestanding-eabi", "a thumb revision, by family") && ok
    ok = is(zig_target_of("armv7-unknown-none-eabihf", "#LINUX", "x86_64"), "arm-freestanding-eabihf", "an abi after none") && ok
    ok = is(zig_target_of("wasm32-unknown-unknown", "#LINUX", "x86_64"), "wasm32-freestanding", "bare wasm, which is #NONE") && ok
    ok = is(zig_target_of("msp430-none-elf", "#LINUX", "x86_64"), "", "an architecture it does not know: ZIG_TARGET's") && ok
    ok = is(arch_family("i586-pc-none"), "x86", "a family") && ok
    ok = is(arch_family("x86_64-linux-gnu"), "x86_64", "gcc's -dumpmachine") && ok
    ok = is(arch_family("msp430-none-elf"), "msp430", "a family it does not know, as written") && ok
    ok = is(zig_target_of("wasm32-unknown-web", "#LINUX"), "", "the web, which zig does not compile here") && ok

    // The probe's answer as the cache keeps it.
    ok = #expect(probe_of(probe_word(PROBE_RAN)) == PROBE_RAN, "a probe that ran is read back") && ok
    ok = #expect(probe_of(probe_word(PROBE_HUNG)) == PROBE_HUNG, "a probe that hung is read back") && ok
    ok = #expect(probe_of("") == PROBE_UNKNOWN, "an empty entry is no answer") && ok
    ok = #expect(probe_of("garbage") == PROBE_UNKNOWN, "an unreadable entry is no answer") && ok
    return ok

// ── a package named through a link ──────────────────────────────────────────
//
// The toolchain's root is resolved (it is found from the executable), and
// `dadoc` names sources with links followed; a package is named as the
// person typed it. Each comparison of the two follows links.

private bool through_links():
    bool ok = true
    when #OS == #WINDOWS:
        return ok
    try ref []char8 made = fs.make_temp_dir("dado-link-test") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 t = real(txt(made))
    string8 tree = join2(t, "tree")
    ok = #expect(make(join2(tree, ".git")), "making .git") && ok
    ok = #expect(make(join3(tree, "libs", "db")), "making libs/db") && ok
    ok = #expect(make(join3(tree, "collections", join2("core", "fmt"))), "making the collections") && ok
    string8 proj = join2(t, "proj")
    ok = #expect(make(proj), "making the project") && ok
    string8 tree_link = join2(t, "tree.link")
    string8 proj_link = join2(t, "proj.link")
    try fs.make_symlink(tree, tree_link) else code:
        return #expect(false, "no link to the tree: ", os.message(code))
    try fs.make_symlink(proj, proj_link) else code:
        return #expect(false, "no link to the project: ", os.message(code))

    // An install's checkout, a package in it named through a link: it still
    // builds beside the checkout, not into it.
    Layout before = g_layout
    (string8 bd, bool bd_set) = env("DADO_BUILD_DIR")
    try os.unset_env("DADO_BUILD_DIR") else code:
        return #expect(false, "cannot unset DADO_BUILD_DIR: ", os.message(code))
    g_layout.kind = "install"
    g_layout.root = tree
    g_layout.install = join2(t, "install")
    ok = is(build_dir_for(join3(tree_link, "libs", "db")), join3(t, "install", "build"), "a package in an install's checkout named through a link builds beside it") && ok
    g_layout = before
    if bd_set:
        try os.set_env("DADO_BUILD_DIR", bd) else code:
            ok = #expect(false, "cannot restore DADO_BUILD_DIR: ", os.message(code)) && ok

    // The `#line` map names each root as `dadoc` names the sources: a
    // project reached through a link maps by where the link leads, and
    // collections inside the root through a link are the root's.
    ref []string8 m = source_prefix_map(join2(tree_link, "collections"), proj_link, tree)
    ok = words_are(m[:], txt(#format("--source-prefix-map=", proj, "= --source-prefix-map=", proj_link, "= --source-prefix-map=", tree, "=")), "the map for a project through a link") && ok
    ref []string8 plain = source_prefix_map(join2(tree, "collections"), tree, tree)
    ok = words_are(plain[:], txt(#format("--source-prefix-map=", tree, "=")), "the map in the checkout") && ok

    // `dado doc <path>` titles a package of the collections by its address
    // when the path reaches them through a link.
    ok = is(collection_rel(join3(tree_link, "collections", join2("core", "fmt")), join2(tree, "collections")), "core/fmt", "a collection package named through a link") && ok
    ok = is(collection_rel(join2(proj_link, "x"), join2(tree, "collections")), "", "a package outside the collections") && ok

    try fs.remove_all(t) else code:
        ok = #expect(false, "cannot remove the temp directory: ", os.message(code)) && ok
    return ok

// ── where artifacts go ──────────────────────────────────────────────────────

private bool stems():
    bool ok = true
    when #OS == #WINDOWS:
        ok = is(build_stem("C:\\r\\corpus\\tour", "C:\\r"), "corpus\\tour", "a package inside the base") && ok
        ok = is(build_stem("C:\\elsewhere\\pkg", "C:\\r"), "C/elsewhere\\pkg", "a package outside it") && ok
    else:
        ok = is(build_stem("/r/corpus/tour", "/r"), "corpus/tour", "a package inside the base") && ok
        ok = is(build_stem("/r/corpus/../corpus/./tour", "/r"), "corpus/tour", "one package however it is spelled") && ok
        ok = is(build_stem("/r/main.dado", "/r"), "main", "a file's stem without .dado") && ok
        ok = is(build_stem("/elsewhere/pkg", "/r"), "elsewhere/pkg", "a package outside the base") && ok
        ok = is(build_stem("/rx/pkg", "/r"), "rx/pkg", "a sibling sharing the base's prefix") && ok
        ok = is(absolute("corpus/tour", "/home/me"), "/home/me/corpus/tour", "a relative package") && ok
        ok = is(absolute("/abs/p", "/home/me"), "/abs/p", "an absolute package") && ok
    // A Windows target's program is named as Windows runs it.
    ok = is(program_name("/b/corpus/tour", "#WINDOWS"), "/b/corpus/tour.exe", "a Windows program") && ok
    ok = is(program_name("/b/corpus/tour", "#LINUX"), "/b/corpus/tour", "a Linux program") && ok
    ok = is(program_name("/b/x.exe", "#WINDOWS"), "/b/x.exe", "a Windows program already named so") && ok
    ok = is(missing_include("x.c:1:10: fatal error: 'foo.h' file not found"), "foo.h", "clang's missing header") && ok
    ok = is(missing_include("x.c:1:10: fatal error: foo/bar.h: No such file or directory"), "foo/bar.h", "gcc's missing header") && ok
    ok = is(missing_include("x.c:3:1: error: unknown type name"), "", "no missing header") && ok
    return ok

// A program that could not be started is said to be one, not `exit 127`.
private bool exec_failures():
    bool ok = true
    ok = is(exec_failure_text("/b/x", true, true), "", "a program that ran") && ok
    ok = is(exec_failure_text("/b/x", false, false), "cannot run /b/x: it is not there", "a program that is gone") && ok
    ok = #expect(strings.starts_with(exec_failure_text("/b/x", true, false), "cannot run /b/x: permission denied"), "a program on a noexec mount is `", exec_failure_text("/b/x", true, false), "`") && ok
    ok = #expect(strings.contains(exec_failure_text("/b/x", true, false), "DADO_BUILD_DIR"), "the repair is not named") && ok
    return ok

// A compiler that did not end 0: its own refusal says no more, a signal or
// any other status is named, and Windows, which has no signals, is told the
// status.
private bool transpile_failures():
    bool ok = true
    ok = is(transpile_failure(1, false), "transpiling failed. Nothing was written.", "the compiler's own refusal") && ok
    ok = is(transpile_failure(137, false), "transpiling failed: the compiler was killed (signal 9): the system may have run out of memory. Nothing was written.", "a compiler killed") && ok
    ok = is(transpile_failure(134, false), "transpiling failed: the compiler aborted (signal 6). Nothing was written.", "a compiler that aborted") && ok
    ok = is(transpile_failure(139, false), "transpiling failed: the compiler was ended by signal 11. Nothing was written.", "a compiler that faulted") && ok
    ok = is(transpile_failure(2, false), "transpiling failed: the compiler exited with status 2. Nothing was written.", "a status that is no refusal") && ok
    ok = is(transpile_failure(127, false), "transpiling failed: the compiler could not be started. Nothing was written.", "a compiler that is not there") && ok
    ok = is(transpile_failure(3, true), "transpiling failed: the compiler aborted (exit status 3). Nothing was written.", "an abort on Windows") && ok
    ok = is(transpile_failure(137, true), "transpiling failed: the compiler exited with status 137. Nothing was written.", "Windows has no signals") && ok
    ok = is(transpile_failure(1, true), "transpiling failed. Nothing was written.", "the compiler's own refusal on Windows") && ok
    ok = is(compiler_ended(1, false), "", "a refusal's ending") && ok
    ok = is(compiler_ended(137, false), "the compiler was killed (signal 9): the system may have run out of memory", "a kill's ending") && ok
    return ok

// A long compiler command goes through a response file; another too long
// to start ends with the reason, and is answered before the pool is done.
private bool long_commands():
    bool ok = true
    ref []string8 ws = #make([]string8, 0)
    ws = #append(ws, "a b")
    ws = #append(ws, "x\"y")
    ws = #append(ws, "c\\d")
    ws = #append(ws, "")
    ws = #append(ws, "e'f\tg")
    // GCC's, clang's and tcc's reading: every word quoted, `\"` and `\\` inside.
    ok = is(response_text(ws[:]), "\"a b\"\n\"x\\\"y\"\n\"c\\\\d\"\n\"\"\n\"e'f\tg\"\n", "a response file's quoting") && ok
    // zig's (Windows' rule): backslashes are themselves but before a quote.
    ok = #expect(!fits_response(ws[:], true), "a word with `'` written for zig") && ok
    ref []string8 zs = #make([]string8, 0)
    zs = #append(zs, "a b")
    zs = #append(zs, "x\"y")
    zs = #append(zs, "c\\d")
    zs = #append(zs, "")
    zs = #append(zs, "C:\\dir with space\\")
    zs = #append(zs, "#x")
    zs = #append(zs, "a\\\"b")
    ok = #expect(fits_response(zs[:], true), "plain words refused for zig") && ok
    ok = is(response_text(zs[:], true), "\"a b\"\nx\\\"y\nc\\d\n\"\"\n\"C:\\dir with space\\\\\"\n\"#x\"\na\\\\\\\"b\n", "a response file's quoting for zig") && ok
    Command short = command("cc")
    add(&short, "-c")
    respond(&short, 1, "x.args")
    ok = #expect(!long_command(short), "a short command uses its response file") && ok
    Command none = command("true")
    for k in 0..<299:
        add(&none, txt(#format("w", k)))
    ok = #expect(!long_command(none), "a command with no response file uses one") && ok
    ref []Command cs = #make([]Command, 0)
    cs = #append(cs, none)
    Pool p = pool_of(cs[:], 1, true)
    pool_fill(&p)
    ok = #expect(!pool_done(&p), "the pool is done before the unstarted command is answered") && ok
    ref []i64 got = pool_step(&p)
    ok = #expect(#len(got) == 1, "the unstarted command is not answered") && ok
    ok = #expect(pool_done(&p), "the pool is not done") && ok
    Ran r0 = p.ran[0]
    string8 said = txt(r0.err)
    ok = #expect(r0.status == 127, "an unstarted command's status is ", r0.status) && ok
    ok = #expect(strings.starts_with(said, "a command of 300 words is more than the 255 this driver can start: true w0"), "an unstarted command says `", said, "`") && ok
    // The web link (rc.10.2): 300 objects under the pinned zig go through a
    // response file LLD reads, so GNU's quoting, with the linker's own words
    // left on the line. rc.10 gave it none: "more than the 255".
    string8 was_zig = g_web_zig
    string8 was_ld = g_web_ld
    g_web_zig = "zig"
    g_web_ld = ""
    Command wl = web_link()
    ok = #expect(#len(wl.words) >= 2 && wl.words[0] == "zig" && wl.words[1] == "wasm-ld", "the pinned web link is not `zig wasm-ld`") && ok
    i64 wl_head = wl.args_from
    ok = #expect(wl_head == i64(#len(wl.words)) && wl.args_gnu, "the web link keeps its linker words on the line and writes GNU text") && ok
    for k in 0..<300:
        add(&wl, txt(#format("unit", k, ".o")))
    add(&wl, "c\\d.o")
    wl.args_file = "web-link-test.args"
    ok = #expect(long_command(wl), "a 300-object web link does not use its response file") && ok
    ok = #expect(fits_response(wl.words[wl_head..<#len(wl.words)], false), "the web link's words do not fit a GNU response file") && ok
    ok = #expect(strings.ends_with(response_text(wl.words[wl_head..<#len(wl.words)], false), "\"c\\\\d.o\"\n"), "a backslash in the web link's response file is not GNU-quoted") && ok
    g_web_ld = "wasm-ld"
    Command wc = web_link()
    ok = #expect(wc.words[0] == "wasm-ld" && wc.args_from == i64(#len(wc.words)) && wc.args_gnu, "the clang web link has no response file") && ok
    g_web_zig = was_zig
    g_web_ld = was_ld
    when #OS == #WINDOWS:
        return ok
    // 300 words to a C compiler, through `@<file>`.
    try ref []char8 made = fs.make_temp_dir("dado-rsp-test") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 t = txt(made)
    string8 src = join2(t, "a b.c")
    ok = #expect(write(src, "#if X299 != 299 || !defined(Y)\n#error lost\n#endif\nint x;\n"), "writing a b.c") && ok
    string8 args = join2(t, "o.args")
    Command c = command("cc")
    for k in 0..<300:
        add(&c, txt(#format("-DX", k, "=", k)))
    add(&c, "-DY=\"a b\\\\c\"")
    add(&c, "-fsyntax-only")
    add(&c, src)
    respond(&c, 1, args)
    ok = #expect(long_command(c), "a 304-word command does not use its response file") && ok
    ref []Command cc = #make([]Command, 0)
    cc = #append(cc, c)
    ref []Ran rs = run_pool(cc[:], 1, true)
    Ran r1 = rs[0]
    string8 said1 = txt(r1.err)
    ok = #expect(r1.status == 0, "the compile through a response file ended ", r1.status, ": ", said1) && ok
    ok = #expect(!exists(args), "the response file is left behind") && ok
    remove_tree_quietly(t)
    return ok

// The driver's rebuild of itself (`keep_current`) hears none of the cross
// settings of the command it interrupts, and gets them back after; a driver
// that does not start here never replaces the one that does.
private bool self_build_env():
    bool ok = true
    ref []string8 names = words_of(HOST_BUILD_CLEARS)
    ref []SavedEnv before = #make([]SavedEnv, 0)
    for n in names:
        SavedEnv e
        e.name = n
        e.value = ""
        e.set = true
        ref []char8 v = nil
        try v = os.get_env(n) else:
            e.set = false
        if e.set: e.value = txt(v)
        before = #append(before, e)
    try os.set_env("DADO_TARGET", "x86_64-pc-windows-gnu") else: pass
    try os.set_env("ZIG_TARGET", "x86_64-windows-gnu") else: pass
    try os.set_env("DADO_LDFLAGS", "-s") else: pass
    try os.set_env("CC", "x86_64-w64-mingw32-gcc") else: pass
    try os.unset_env("DADO_CFLAGS") else: pass
    ref []SavedEnv saved = host_build_env(names[:])
    for n in names:
        (string8 v, bool set) = env(n)
        ok = #expect(!set, n, " is still `", v, "` for the driver's own rebuild") && ok
    ok = #expect(#len(saved) >= 4, "the four set are kept to restore, not ", #len(saved)) && ok
    restore_env(saved[:])
    (string8 t, bool _) = env("DADO_TARGET")
    ok = is(t, "x86_64-pc-windows-gnu", "DADO_TARGET after the rebuild") && ok
    (string8 z, bool _) = env("ZIG_TARGET")
    ok = is(z, "x86_64-windows-gnu", "ZIG_TARGET after the rebuild") && ok
    (string8 l, bool _) = env("DADO_LDFLAGS")
    ok = is(l, "-s", "DADO_LDFLAGS after the rebuild") && ok
    (string8 c, bool _) = env("CC")
    ok = is(c, "x86_64-w64-mingw32-gcc", "CC after the rebuild") && ok
    (string8 _, bool cf) = env("DADO_CFLAGS")
    ok = #expect(!cf, "DADO_CFLAGS was unset and is set after the rebuild") && ok
    for e in before:
        if e.set:
            try os.set_env(e.name, e.value) else: pass
        else:
            try os.unset_env(e.name) else: pass

    // A driver for another machine: no program, or bytes that do not start.
    try ref []char8 made = fs.make_temp_dir("dado-driver-runs") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 d = txt(made)
    ok = #expect(!driver_runs(join2(d, "missing")), "a missing driver runs") && ok
    string8 pe = join2(d, "dado.exe")
    try fs.write_file(pe, "MZ: not a program for this machine") else: pass
    ok = #expect(!driver_runs(pe), "a file of foreign bytes runs as a driver") && ok
    remove_tree_quietly(d)
    return ok

// A failed build whose manifest lists no `foreign` header and no `.c` is
// blamed on the compiler's C only when the package's directory holds no C
// either: on Windows (P22) the manifest of `tools/lsp`, which has `wait.h`
// and `wait.c`, listed neither, and the driver said the program declared no
// `foreign` block.
private bool unlisted_c_found():
    bool ok = true
    try ref []char8 made = fs.make_temp_dir("dado-unlisted-c") else code:
        return #expect(false, "no temp directory: ", os.message(code))
    string8 d = txt(made)
    ok = #expect(touch(join2(d, "main.dado")), "writing main.dado") && ok
    Failure f
    f.dir = d
    ref []string8 none = unlisted_c(&f)
    ok = #expect(#len(none) == 0, "a directory of Dado alone listed C") && ok
    ok = #expect(touch(join2(d, "wait.h")), "writing wait.h") && ok
    ok = #expect(touch(join2(d, "wait.c")), "writing wait.c") && ok
    ref []string8 got = unlisted_c(&f)
    ok = #expect(#len(got) == 2, "the unlisted C is ", #len(got), " files, not 2") && ok
    bool both = true
    for g in got:
        if !strings.ends_with(g, "/wait.h") && !strings.ends_with(g, "/wait.c"): both = false
    ok = #expect(both, "the unlisted C is not wait.h and wait.c") && ok
    // A manifest that lists either is believed: nothing is unlisted.
    f.headers = #append(f.headers, "./wait.h")
    ref []string8 by_header = unlisted_c(&f)
    ok = #expect(#len(by_header) == 0, "C was unlisted beside a listed header") && ok
    Failure g2
    g2.dir = d
    g2.sources = #append(g2.sources, join2(d, "wait.c"))
    ref []string8 by_source = unlisted_c(&g2)
    ok = #expect(#len(by_source) == 0, "C was unlisted beside a listed sidecar") && ok
    // A lone file's build (no package directory) lists nothing.
    Failure lone
    lone.dir = ""
    ref []string8 alone = unlisted_c(&lone)
    ok = #expect(#len(alone) == 0, "a lone file's build listed C") && ok
    remove_tree_quietly(d)
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    using arena.allocator(&a):
        bool ok = defaults_read()
        ok = roots_found() && ok
        ok = projects_found() && ok
        ok = test_files_placed() && ok
        ok = manifest_read() && ok
        ok = flags_assembled() && ok
        ok = sanitizing_fallback() && ok
        ok = stems() && ok
        ok = through_links() && ok
        ok = exec_failures() && ok
        ok = transpile_failures() && ok
        ok = long_commands() && ok
        ok = self_build_env() && ok
        ok = unlisted_c_found() && ok
        if ok: return 0
        return 1
