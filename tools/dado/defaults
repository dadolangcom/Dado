# tools/dado/defaults — the driver's settings, as `NAME="value"` lines.
#
# Read by both drivers (the bash one sources it), and in the repository by
# the gate, the test harness and the compiler resolver, which must agree with
# the drivers about these values and so read them here. One line each, double
# quotes, no expansion except `$ROOT` in DADOC_CANDIDATES, which every reader
# replaces with the toolchain's root. A reader that finds a name missing fails
# loudly rather than falling back to a default of its own.

DADOC_CANDIDATES="$ROOT/bin/dadoc
$ROOT/dadoc
$ROOT/target/release/dadoc
$ROOT/target/gate/dadoc
$ROOT/target/debug/dadoc"

CFLAGS_BASE="-std=c11 -Wall -Wextra -pedantic -ffp-contract=off"
CFLAGS_WERROR="-Werror"
CFLAGS_INTEROP="-Werror=implicit-function-declaration -Werror=int-conversion"

CFLAGS_SANITIZE="-fsanitize=address,undefined,float-cast-overflow -fno-sanitize-recover=undefined,float-cast-overflow -fno-omit-frame-pointer -g1"
LDFLAGS_SANITIZE="-fsanitize=address,undefined,float-cast-overflow"
CFLAGS_SANITIZE_THREAD="-fsanitize=thread,undefined,float-cast-overflow -fno-sanitize-recover=undefined,float-cast-overflow -fno-omit-frame-pointer -g1"
LDFLAGS_SANITIZE_THREAD="-fsanitize=thread,undefined,float-cast-overflow"

ASAN_OPTIONS_DEFAULT="detect_leaks=0"
UBSAN_OPTIONS_DEFAULT="print_stacktrace=1"
TSAN_OPTIONS_DEFAULT="halt_on_error=1"

CFLAGS_WEB="--target=wasm32 -ffreestanding -nostdlib -msimd128"
LDFLAGS_WEB="--no-entry --export-table -z stack-size=1048576 --gc-sections"

# Where an install comes from, each in this one place. `dadoc bootstrap` reads
# them from the copy of this file built into it; `dado` reads them here. Each
# has an environment override, for the install test that points them at a
# local repository, a local folder of archives and a local zig:
# DADO_REPO_URL, DADO_RELEASE_BASE, DADO_ZIG_BASE.
REPO_URL="https://github.com/dadolangcom/Dado.git"
RELEASE_BASE="https://github.com/dadolangcom/Dado/releases"
ZIG_DOWNLOAD_BASE="https://ziglang.org/download"

# How often, in seconds, `dado` asks the repository whether the collections
# moved (`DADO_UPDATE_INTERVAL` overrides; 0 asks every time), and how long it
# waits for the answer.
UPDATE_INTERVAL="900"
UPDATE_TIMEOUT="2"
