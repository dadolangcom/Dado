// Positions (lines and UTF-16 columns) and folding ranges.
package main

import "core:json"
import "language:syntax"
import "language:types"

type Lines:
    string8 src
    ref []u32 starts

Lines lines(string8 src):
    Lines l
    l.src = src
    l.starts = #append(l.starts, 0)
    for i in 0..<#len(src):
        if src[i] == '\n': l.starts = #append(l.starts, u32(i + 1))
    return l

// The line holding byte `at` (past the end: one past the last line).
i64 line_of(^Lines l, u32 at):
    if i64(at) >= #len(l.src):
        i64 n = #len(l.starts) - 1
        if #len(l.src) > 0 && l.src[#len(l.src) - 1] != '\n': return n + 1
        return n
    i64 lo = 0
    i64 hi = #len(l.starts)
    for lo + 1 < hi:
        i64 m = (lo + hi) / 2
        if l.starts[m] <= at: lo = m
        else: hi = m
    return lo

void position(^json.Writer w, ^Lines l, u32 at):
    i64 ln = line_of(l, at)
    i64 col = 0
    if i64(at) < #len(l.src):
        for i in i64(l.starts[ln])..<i64(at):
            u8 b = u8(l.src[i])
            if (b & 0xC0) != 0x80: col += 1
            if b >= 0xF0: col += 1
    w.object()
    w.key("line")
    w.int(ln)
    w.key("character")
    w.int(col)
    w.end_object()

void range(^json.Writer w, ^Lines l, u32 lo, u32 hi):
    w.object()
    w.key("start")
    position(w, l, lo)
    w.key("end")
    position(w, l, hi)
    w.end_object()

// Bodies (from their header's `:` line), multi-line declarations, comment
// runs and the import block, each spanning two lines or more.
void folding(^json.Writer w, string8 uri, string8 src):
    types.Interner names = syntax.names()
    syntax.Tokens t = syntax.lex(src)
    syntax.intern(&t, src, &names)
    syntax.Ast a = syntax.parse(src, &t, #len(uri) > 6 && uri[#len(uri) - 6..<#len(uri)] == ".dados")
    Lines ls = lines(src)
    ref []i64 seen
    w.array()
    i64 imports = -1
    i64 last_import = -1
    for n in 0..<a.count():
        u8 g = a.tag[n]
        u32 lo = a.lo[n]
        if g == syntax.S_BLOCK || g == syntax.N_MEMBERS:
            i64 k = syntax.token_at(&t, lo) - 1
            for k > 0 && t.tag[k] <= syntax.EOF: k -= 1
            if k < 0 || t.tag[k] != syntax.COLON: continue
            lo = t.start[k]
        else if g == syntax.N_IMPORT:
            if imports < 0: imports = line_of(&ls, lo)
            last_import = line_of(&ls, lo)
            continue
        else if g != syntax.N_TYPE && g != syntax.N_ENUM && g != syntax.N_UNION && g != syntax.N_FOREIGN && g != syntax.N_TRAIT && g != syntax.N_CLASS && g != syntax.N_WHEN && g != syntax.S_SWITCH:
            continue
        i64 e = syntax.token_at(&t, a.hi[n]) - 1
        for e > 0 && t.tag[e] <= syntax.EOF: e -= 1
        if e >= 0: fold(w, &seen, line_of(&ls, lo), line_of(&ls, t.start[e]), "")
    if last_import > imports: fold(w, &seen, imports, last_import, "imports")
    i64 run = -1
    i64 prev = -2
    for i in 0..<#len(t.trivia) / 2:
        u32 s = t.trivia[2 * i]
        if src[i64(s)] != '/' || src[i64(s) + 1] != '/': continue
        i64 ln = line_of(&ls, s)
        bool own = s == ls.starts[ln] || only_blanks(src, ls.starts[ln], s)
        if own && ln == prev + 1:
            prev = ln
            continue
        if run >= 0 && prev > run: fold(w, &seen, run, prev, "comment")
        run = ln if own else -1
        prev = ln if own else -2
    if run >= 0 && prev > run: fold(w, &seen, run, prev, "comment")
    w.end_array()
    #delete(seen)
    #delete(ls.starts)
    a.free()
    t.free()
    names.free()

private bool only_blanks(string8 s, u32 a, u32 b):
    for i in i64(a)..<i64(b):
        if s[i] != ' ' && s[i] != '\t': return false
    return true

private void fold(^json.Writer w, ^ref []i64 seen, i64 a, i64 b, string8 kind):
    if b <= a: return
    for x in seen^:
        if x == a: return
    seen^ = #append(seen^, a)
    w.object()
    w.key("startLine")
    w.int(a)
    w.key("endLine")
    w.int(b)
    if #len(kind) > 0:
        w.key("kind")
        w.text(kind)
    w.end_object()
