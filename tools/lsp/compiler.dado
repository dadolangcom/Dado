// The compiler, run once per question over the editor's buffer:
// checker diagnostics (`--emit=explained`), hover
// (`--hover=`) and definition (`--define=`), each over the package around the
// file, the buffer standing in for it on stdin.
package main

import "core:os"
import "core:os/fs"
import "core:os/proc"
import "core:strings"
import "language:syntax"

// Where a `dadoc` was found, and the collections beside it.
type Compiler:
    bool found
    ref []char8 path
    ref []char8 collections

// What the open file is told when there is no compiler.
const string8 MISSING = "the Dado compiler was not found.\n\n  This server looks beside itself (an install keeps dadoc and dado-lsp in one\n  folder), then under the workspace: build/dadoc/dadoc, bin/dadoc, ./dadoc. Reinstall\n  Dado (dado doctor says what is missing), or set `dado.compilerPath`, or $DADO_DADOC,\n  to the dadoc to use. In a checkout of the repository, ./dado_build.sh builds it."

// The fixed offsets from a root, longest first (`collections_beside` tries
// them in this order): a checkout's build, an install's `bin/`, the zip layout.
private const [3]string8 OFFSETS = ("build/dadoc/dadoc", "bin/dadoc", "dadoc")

private ref []char8 own(string8 s):
    ref []char8 o
    syntax.put(&o, s)
    return o

private string8 parent(string8 p):
    i64 i = strings.last_index_of(p, '/')
    if i <= 0: return "/" if i == 0 else "."
    return p[0..<i]

// Find `dadoc`: the configured path, `$DADO_DADOC`, beside this server, then
// the fixed offsets under the root. No `PATH` search. Every candidate is a
// buffer of its own, freed here: nothing found keeps a view of the arguments.
Compiler find_compiler(string8 configured, string8 root):
    Compiler c
    ref [](ref []char8) cands
    if #len(configured) > 0: cands = #append(cands, own(configured))
    ref []char8 env = env_buffer("DADO_DADOC")
    if #len(env) > 0: cands = #append(cands, env)
    else: #delete(env)
    string8 me = exe_path()
    if #len(me) > 0: cands = #append(cands, path_in(parent(me), "dadoc"))
    if #len(root) > 0:
        for off in OFFSETS: cands = #append(cands, path_in(root, off))
    for i in 0..<#len(cands):
        string8 p = cands[i]
        if !c.found && fs.is_file(p):
            c.found = true
            c.path = own(p)
            c.collections = collections_beside(p)
    for i in 0..<#len(cands): #delete(cands[i])
    #delete(cands)
    return c

private ref []char8 env_buffer(string8 n):
    try ref []char8 v = os.get_env(n) else: return #make([]char8, 0)
    return v

private string8 exe_path():
    try string8 me = os.executable_path() else: return ""
    return me

// The collections of the toolchain `dadoc` is part of.
private ref []char8 collections_beside(string8 dadoc):
    for off in OFFSETS:
        if dadoc == off: return collections_under(".")
        i64 n = #len(dadoc) - #len(off)
        if n > 0 && dadoc[n - 1] == '/' && dadoc[n..<#len(dadoc)] == off: return collections_under(dadoc[0..<n - 1])
    return collections_under(parent(parent(dadoc)))

private ref []char8 collections_under(string8 root):
    ref []char8 checkout = path_in(root, "collections")
    ref []char8 install = path_in(root, "src/collections")
    string8 cs = checkout
    string8 is = install
    if !fs.is_dir(cs) && fs.is_dir(is):
        #delete(checkout)
        return install
    #delete(install)
    return checkout

// `--imports=`, `--project=` and `--overlay=` for `file` (Rust's
// `imports_flags`), each a buffer of its own in `out`.
private void imports_flags(^Compiler c, string8 file, ^ref [](ref []char8) out):
    string8 d = parent(file)
    for #len(d) > 1:
        ref []char8 im = path_in(d, "imports")
        string8 ims = im
        bool there = fs.is_dir(ims)
        if there: out^ = #append(out^, own2("--imports=", ims))
        #delete(im)
        if there: break
        string8 up = parent(d)
        if up == d: break
        d = up
    string8 cs = c.collections
    if strings.ends_with(cs, "/src/collections"):
        ref []char8 inst = path_in(cs[0..<#len(cs) - 16], "imports")
        string8 is = inst
        if fs.is_dir(is): out^ = #append(out^, own2("--imports=", is))
        #delete(inst)
    string8 project = project_root(file)
    if #len(project) == 0: return
    out^ = #append(out^, own2("--project=", project))
    ref []char8 overlay = path_in(project, "collections")
    string8 ov = overlay
    if fs.is_dir(ov) && !same_dir(ov, cs): out^ = #append(out^, own2("--overlay=", ov))
    #delete(overlay)

// `dir/leaf`, a buffer of its own.
private ref []char8 path_in(string8 dir, string8 leaf):
    ref []char8 o
    syntax.put(&o, dir)
    if #len(dir) > 0 && dir[#len(dir) - 1] != '/': o = #append(o, '/')
    syntax.put(&o, leaf)
    return o

private bool has_entry(string8 dir, string8 leaf, bool file):
    ref []char8 p = path_in(dir, leaf)
    string8 ps = p
    bool yes = fs.is_file(ps) if file else fs.exists(ps)
    #delete(p)
    return yes

private ref []char8 own2(string8 a, string8 b):
    ref []char8 o
    syntax.put(&o, a)
    syntax.put(&o, b)
    return o

private bool same_dir(string8 a, string8 b):
    try ref []char8 ra = fs.canonical(a) else: return a == b
    try ref []char8 rb = fs.canonical(b) else: return a == b
    string8 x = ra
    string8 y = rb
    return x == y

// The nearest directory above `file` holding `dado.json`, else the top of
// the git work tree; "" for neither.
private string8 project_root(string8 file):
    string8 d = parent(file)
    for:
        if has_entry(d, "dado.json", true): return d
        string8 up = parent(d)
        if up == d || #len(up) == 0 || up == ".": break
        d = up
    d = parent(file)
    for:
        if has_entry(d, ".git", false): return d
        string8 up = parent(d)
        if up == d || #len(up) == 0 || up == ".": break
        d = up
    return ""

// `dadoc ARGS… --stdin --package FILE` over `text`: what it printed.
ref []char8 ask(^Compiler c, []string8 extra, string8 file, string8 text):
    ref [](ref []char8) flags
    flags = #append(flags, own2("--collections=", c.collections))
    imports_flags(c, file, &flags)
    ref []string8 argv
    string8 cp = c.path
    argv = #append(argv, cp)
    for i in 0..<#len(flags):
        string8 fl = flags[i]
        argv = #append(argv, fl)
    for x in extra: argv = #append(argv, x)
    argv = #append(argv, "--stdin")
    argv = #append(argv, "--package")
    argv = #append(argv, file)
    ref []char8 got
    try proc.Duplex d = proc.duplex(argv[:], proc.Errors.Discard) else:
        free_all(&flags, &argv)
        return got
    ref []char8 tb = own(text)
    try proc.send_all(&d, tb[:], 120000) else: pass
    #delete(tb)
    _ = proc.close_input(&d)
    [65536]char8 chunk
    for:
        try i64 n = proc.receive(&d, chunk[:], 120000) else:
            break
        if n == 0: break
        got = #append(got, ..chunk[0..<n])
    try _ = proc.stop(&d, 2000) else: pass
    free_all(&flags, &argv)
    return got

private void free_all(^ref [](ref []char8) flags, ^ref []string8 argv):
    #delete(argv^)
    for i in 0..<#len(flags^): #delete(flags^[i])
    #delete(flags^)
