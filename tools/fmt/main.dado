// `fmt [--no-dadofmt] [--stdin] [--twice] FILE`: dadoc --format over
// language:fmt. The formatted text on stdout; 1 when the file does not parse.
// `--twice` formats the result again (the idempotence oracle); `--raw` writes
// a result that failed its own check.
package main

import "core:io"
import "core:os"
import "core:os/fs"
import "language:fmt"
import "language:syntax"

i32 main(i32 argc, ^rawptr argv):
    []string8 args = os.args(argc, argv)
    bool styled = true
    bool stdin = false
    bool raw = false
    bool twice = false
    string8 path = ""
    for i in 1..<#len(args):
        string8 a = args[i]
        if a == "--version": path = a
        else if a == "--no-dadofmt": styled = false
        else if a == "--stdin": stdin = true
        else if a == "--raw": raw = true
        else if a == "--twice": twice = true
        else: path = a
    ref []char8 err
    if path == "--version":
        syntax.put(&err, "fmt 1\n")
        _ = io.write_bytes(io.stdout(), err)
        return 0
    if #len(path) == 0:
        syntax.put(&err, "usage: fmt [--no-dadofmt] [--stdin] FILE\n")
        _ = io.write_bytes(io.stderr(), err)
        return 2
    ref []char8 where
    ref []char8 why
    fmt.Style s = fmt.style_for(path, &where, &why) if styled else fmt.defaults()
    if s.line > 0:
        syntax.put(&err, "dadoc: ")
        syntax.put(&err, where)
        syntax.put(&err, ":")
        syntax.put_num(&err, s.line)
        syntax.put(&err, ": ")
        syntax.put(&err, why)
        syntax.put(&err, "\n")
        _ = io.write_bytes(io.stderr(), err)
        return 2
    bool ok = true
    ref []char8 text = slurp(path, stdin, &ok)
    if !ok:
        syntax.put(&err, "dadoc: cannot read the input from standard input\n" if stdin else "dadoc: cannot read the file\n")
        _ = io.write_bytes(io.stderr(), err)
        return 2
    string8 src = text
    ref []char8 out
    i32 status = fmt.format_text(path, src, &s, &out, &err)
    if status == 0 && twice:
        ref []char8 again
        string8 o = out
        status = fmt.format_text(path, o, &s, &again, &err)
        #delete(out)
        out = again
    if status == 1: syntax.put(&err, "dadoc: the file is not formatted, because it does not parse\n")
    if status == 0 || (status == 3 && raw): _ = io.write_bytes(io.stdout(), out)
    _ = io.write_bytes(io.stderr(), err)
    #delete(out)
    #delete(err)
    #delete(text)
    #delete(where)
    return status

private ref []char8 slurp(string8 path, bool stdin, ^bool ok):
    if stdin:
        io.StreamReader sr = io.stdin_reader()
        try ref []char8 r = io.read_all(&sr) else:
            ok^ = false
            return #make([]char8, 0)
        return r
    try ref []char8 f = fs.read_file(path) else:
        ok^ = false
        return #make([]char8, 0)
    return f
