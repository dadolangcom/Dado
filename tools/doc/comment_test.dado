@test
// The doc-comment reader against the fixtures it shares with the language
// server, and the comment cutter against literals.
//
// **The fixtures are found from the working directory**, `tests/doccomments`
// there or in a directory above it, because `./dado test` runs a test where
// it was invoked and the repository's root is where the gate invokes it. A
// run that finds no fixtures, or fewer than the directory holds today, fails
// rather than passing over nothing.
package doc

import "core:fmt"
import "core:os/fs"
import "core:strings"
import "core:mem/arena"
import "core:mem/libc"

// How many cases `tests/doccomments` holds at least. A smaller count means
// the directory went missing or was emptied, which is a failure.
private const i32 FIXTURES_AT_LEAST = 20

// `tests/doccomments` in the working directory or one of the eight above it.
private (string8 dir, bool ok) fixtures((rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) al):
    ref []char8 up = #make([]char8, 0, al)
    i32 depth = 0
    for depth <= 8:
        ref []char8 dir = #format(up, "tests/doccomments", al)
        ref []char8 probe = #format(dir, "/summary_only.comment", al)
        ref []char8 rc = strings.clone_to_cstring(probe, al)
        if fs.is_file(cstring(rc)):
            string8 d = dir
            return (d, true)
        for c in "../":
            _ = #append(up, c)
        depth += 1
    return ("", false)

private bool fixture_cases((rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) al):
    (string8 dir, bool found) = fixtures(al)
    if !#expect(found, "no tests/doccomments here or above: run the test from the repository"):
        return false
    ref []FixtureMiss misses = #make([]FixtureMiss, 0, al)
    i32 cases = check_fixtures(dir, &misses, al)
    bool ok = #expect(cases >= FIXTURES_AT_LEAST, "only ", cases, " fixture(s) in ", dir,
                      ": is the directory whole?")
    for m in misses:
        if m.missing:
            ok = #expect(false, m.path, " has no .fields beside it; it reads as\n", m.got)
        else:
            ok = #expect(false, m.path, " reads differently from its .fields\n--- want\n",
                         m.want, "--- got\n", m.got)
    return ok

private bool field_position_cases((rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) al):
    DocComment d = read_comment("    // Cuts.\n    //\n    //   \n    // s: the source.\n    //at: where.\n", al)
    bool ok = #expect(#len(d.fields) == 2, "read ", i32(#len(d.fields)), " field(s), wanted 2")
    if #len(d.fields) != 2:
        return ok
    // The line is the field line's index among the comment's lines, and the
    // column is where its key starts in the source, 1-based.
    ok = #expect(d.fields[0].name == "s" && d.fields[0].line == 3 && d.fields[0].col == 8,
                 "the first field is ", d.fields[0].name, " at ", d.fields[0].line, ":", d.fields[0].col) && ok
    ok = #expect(d.fields[1].name == "at" && d.fields[1].line == 4 && d.fields[1].col == 7,
                 "the second field is ", d.fields[1].name, " at ", d.fields[1].line, ":", d.fields[1].col) && ok
    return ok

private bool cut_cases((rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) al):
    // Built from `MARKER` for the reason `doc_test.dado` gives: a line here
    // that began with the marker would be a block in every scan of this
    // package.
    ref []char8 b = #format(
        "package x\n",
        "\n",
        "// Not this: a blank line follows.\n",
        "\n",
        "// One.\n",
        "//\n",
        "// n: how many.\n",
        "i32 one(i32 n):\n",
        "    return n\n",
        "\n",
        MARKER, " slot 10\n",
        "// Two.\n",
        "i32 two():\n",
        "    return 2\n",
        "// ── a rule ──\n",
        "    // Three, indented.\n",
        "    i32 three():\n",
        "i32 four():\n",
        al)
    string8 text = b

    (string8 c1, i64 at1) = cut_comment(text, find_sub(text, "i32 one"))
    bool ok = #expect(c1 == "// One.\n//\n// n: how many.\n", "the first comment is [", c1, "]")
    ok = #expect(line_number(text, at1) == 5, "the first comment starts on line ",
                 line_number(text, at1)) && ok

    // A block line above is not part of the comment, and stops it.
    (string8 c2, i64 _) = cut_comment(text, find_sub(text, "i32 two"))
    ok = #expect(c2 == "// Two.\n", "the second comment is [", c2, "]") && ok

    // So does a rule line; an indented comment is read with its indentation,
    // and the start may be past the line's indentation.
    (string8 c3, i64 _) = cut_comment(text, find_sub(text, "i32 three"))
    ok = #expect(c3 == "    // Three, indented.\n", "the third comment is [", c3, "]") && ok

    // Code directly above: no comment at all.
    (string8 c4, i64 _) = cut_comment(text, find_sub(text, "i32 four"))
    ok = #expect(#len(c4) == 0, "the fourth comment is [", c4, "]") && ok

    // A declaration on the first line has nothing above it.
    (string8 c5, i64 _) = cut_comment("i32 f():\n", 0)
    ok = #expect(#len(c5) == 0, "a first-line declaration has the comment [", c5, "]") && ok
    return ok

private bool params_cases((rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) al):
    string8 source = "// Adds.\n//\n// a: the first.\n// c: gone.\n// a: again.\ni32 add(i32 a, i32 b):\n"
    ref []char8 d = #format("declarations 1\n",
                            "file\tx.dado\tdado\tx\tparsed\n",
                            "decl\tfunction\tadd\tprivate\tFunctions\t", find_sub(source, "i32 add"),
                            "\t60\t0\t0\t-\t-\ti32 add(i32 a, i32 b)\n",
                            "param\ta\ti32\n",
                            "param\tb\ti32\n",
                            "returns\ti32\n", al)
    string8 decls = d
    ref []string8 ws = #make([]string8, 0, al)
    (i32 checked, bool ok1) = param_warnings(decls, source, "x.dado", &ws, al)
    bool ok = #expect(ok1 && checked == 1, "param_warnings checked ", checked, " declaration(s)")
    ok = #expect(#len(ws) == 2, "param_warnings gave ", i32(#len(ws)), " warning(s), wanted 2") && ok
    if #len(ws) != 2:
        return ok
    // The line is the field line's in the source, the column its key's.
    ok = #expect(strings.starts_with(ws[0], "x.dado:4:4: warning: the comment above `add` describes `c`"),
                 "the first warning is ", ws[0]) && ok
    ok = #expect(strings.ends_with(ws[0], "it takes `a`, `b`: rename the line to one of them, or move it above the field lines so it reads as prose"),
                 "the first warning's repair is ", ws[0]) && ok
    ok = #expect(strings.starts_with(ws[1], "x.dado:5:4: warning: the comment above `add` describes `a` twice"),
                 "the second warning is ", ws[1]) && ok
    // Not a dump at all is a refusal, not an empty answer.
    (i32 _, bool ok2) = param_warnings("decl\tfunction", source, "x.dado", &ws, al)
    ok = #expect(!ok2, "a file that is not a dump was read as one") && ok
    return ok

i32 test():
    arena.Arena a = arena.over(libc.allocator())
    defer arena.destroy(&a)
    (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) al = arena.allocator(&a)

    bool ok = fixture_cases(al)
    ok = field_position_cases(al) && ok
    ok = cut_cases(al) && ok
    ok = params_cases(al) && ok
    if ok:
        return 0
    fmt.println("comment_test: failed")
    return 1
