// The checks that make the documentation honest.
//
// **This is the reason the whole thing is worth building.** Putting a sentence
// beside the code it describes reduces drift and does not remove it: a comment
// saying *"`is` is equality only"* will not update itself when `is` grows.
// This project deletes documents that drift — a specification, a guide, a
// surface map, four design analyses and a milestone board have all gone that
// way — so the claims have to be checkable, which is the same answer
// everything else here gets.
//
// **Nothing in this file runs a compiler.** It reads text: a record stream, a
// `--emit=lexicon` dump the caller produced, and a word list. That is
// deliberate rather than a limitation. Spawning a process from Dado today means
// `popen`, which takes a command *string* and inherits shell quoting — the
// defect `bundle` already has and the one `./dado`'s own manifest comment warns
// about — and an argv-array spawn is a later row. A check that reads two files
// needs none of it, and the caller that produced the dump is better placed to
// say which compiler it asked than this program would be.
package doc

import "core:mem"
import "core:slices"
import "core:strings"

//@ doc/check 10
//@ ### What a block may claim
//@
//@ A word in backticks inside a block is a claim about the language, and
//@ three shapes of claim are checked against `dadoc --emit=lexicon`:
//@
//@ * a diagnostic code — `ERR0504` — which must be declared;
//@ * a sigilled name — `#default`, `#OS`, `#c.int` — which must be in a
//@   roster;
//@ * a bare lowercase word — `defer`, `switch` — which must be a word the
//@   language has, **or** be listed as ordinary prose.
//@
//@ Anything else in backticks is left alone: a symbol like
//@ `Parser::at_has`, a type name like `TypeId`, a path, a flag. The check
//@ is deliberately asymmetric — it refuses what it can positively identify
//@ as a language claim and says nothing about the rest, because a check
//@ that flagged every backticked word would be turned off inside a week.

// What a backticked token is, as far as the check is concerned.
public const i32 CLAIM_NONE = 0
public const i32 CLAIM_CODE = 1
public const i32 CLAIM_SIGIL = 2
public const i32 CLAIM_WORD = 3

// One thing a block claimed that the language does not have.
public type Fault: (string8 token, i32 kind, string8 file, i32 line, string8 slot)

// What a diagnostic code is spelled as: a three-letter prefix, then exactly
// this many digits. The grammar `looks_like_code` holds a backticked token to.
private const i64 CODE_PREFIX_LEN = 3
private const i64 CODE_DIGITS = 4

// The prefixes a code is spelled with: one per class — `ERR` a refusal, `LNT`
// a lint, `WRN` a warning — and the legacy `TOY`, which the lexicon no longer
// prints, so a block still citing one is told so rather than passed over.
private bool code_prefix(string8 p):
    return p == "ERR" || p == "LNT" || p == "WRN" || p == "TOY"

// A code prefix followed by `CODE_DIGITS` digits, and nothing else.
private bool looks_like_code(string8 t):
    i64 n = CODE_PREFIX_LEN
    if #len(t) != n + CODE_DIGITS:
        return false
    if !code_prefix(strings.substring(t, 0, n)):
        return false
    i64 i = n
    for i < #len(t):
        char8 c = t[i]
        if c < '0' || c > '9':
            return false
        i += 1
    return true

// A lowercase identifier: `[a-z_][a-z0-9_]*`. **Lowercase only, and that is
// what keeps the check usable.** `TypeId`, `Parser`, `CScalar` and every other
// CamelCase name in this tree is an implementation symbol rather than a
// language word, and a rule that could not tell them apart would have to flag
// them all.
private bool looks_like_word(string8 t):
    i64 n = #len(t)
    if n == 0:
        return false
    char8 first = t[0]
    if (first < 'a' || first > 'z') && first != '_':
        return false
    i32 i = 1
    for i < n:
        char8 c = t[i]
        bool lower = c >= 'a' && c <= 'z'
        bool digit = c >= '0' && c <= '9'
        if !lower && !digit && c != '_':
            return false
        i += 1
    return true

public i32 claim_kind(string8 token):
    if looks_like_code(token):
        return CLAIM_CODE
    if strings.starts_with(token, "#") && #len(token) > 1:
        return CLAIM_SIGIL
    if looks_like_word(token):
        return CLAIM_WORD
    return CLAIM_NONE

// ── the vocabulary ──────────────────────────────────────────────────────────

//@ doc/check 20
//@ ### Where the vocabulary comes from
//@
//@ Every spelling the language has, read out of `dadoc --emit=lexicon` by
//@ **one rule**: the second field of every row, plus a `token` row's fourth
//@ field when its third is `keyword`.
//@
//@ A list of which rosters to read would be a second list to go stale, and
//@ the lexicon has grown a roster twice. One rule over every row grows with
//@ it and cannot be short a section nobody remembered to add.

// Every spelling in a `--emit=lexicon` dump, sorted.
//
// The rows are tab-separated and the second field is the name in every roster
// the dump has. A `token` row is the exception worth handling: its second
// field is a `TokenKind` (`KW_DEFER`) and the spelling a program writes is its
// fourth (`defer`), so both go in — the kind name is harmless and the spelling
// is the point.
public ref []string8 lexicon_words(string8 text, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []string8 out = #make([]string8, 0, alloc)
    i64 at = 0
    for:
        (string8 line, i64 next) = line_at(text, at)
        if #len(line) > 0:
            (string8 f1, i64 c1) = field_of(line)
            string8 rest1 = strings.rest(line, c1)
            (string8 f2, i64 c2) = field_of(rest1)
            if #len(f2) > 0:
                _ = #append(out, f2)
            if f1 == "token":
                string8 rest2 = strings.rest(rest1, c2)
                (string8 f3, i64 c3) = field_of(rest2)
                if f3 == "keyword":
                    string8 rest3 = strings.rest(rest2, c3)
                    (string8 f4, i64 _) = field_of(rest3)
                    if #len(f4) > 0 && f4 != "-":
                        _ = #append(out, f4)
        if next < 0:
            break
        at = next
    slices.sort(out[:], strings.before)
    return out

// The first tab-delimited field of `s`, and how far past it to continue. A
// line with no tab is one field, and `next` is then its length — so a caller
// asking for a field that is not there gets the empty string rather than a
// trap.
private (string8 field, i64 next) field_of(string8 s):
    i64 cut = strings.index_of(s, '\t')
    if cut < 0:
        return (s, #len(s))
    return (strings.substring(s, 0, cut), cut + 1)

// A word list: one word per line, `#` starting a comment, blanks ignored.
// Sorted, so membership is a binary search like the lexicon's.
public ref []string8 word_list(string8 text, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []string8 out = #make([]string8, 0, alloc)
    i64 at = 0
    for:
        (string8 raw, i64 next) = line_at(text, at)
        string8 line = strings.trim(raw)
        if #len(line) > 0 && !strings.starts_with(line, "#"):
            _ = #append(out, line)
        if next < 0:
            break
        at = next
    slices.sort(out[:], strings.before)
    return out

public bool holds(ref []string8 sorted, string8 token):
    (i64 _, bool found) = slices.binary_search(sorted[:], token, strings.before)
    return found

// ── what a body claims ──────────────────────────────────────────────────────

//@ doc/check 30
//@ ### What is read and what is skipped
//@
//@ Backticked spans are read out of a block's prose. **Fenced blocks and
//@ four-space-indented lines are skipped**, because both are code — a
//@ sample is held to compiling rather than to naming things that exist, and
//@ flagging the words inside one would refuse the very examples the
//@ documentation is for.

// Every backticked span in `body`, appended to `out`.
//
// A line opening or closing a fence toggles the fence and is itself skipped;
// so is any line indented four spaces or more, which is markdown's other way
// of writing code. Inside a line, spans are taken between backtick pairs — an
// unpaired backtick ends the line's scan rather than swallowing the next
// line's, because a stray backtick in prose is a typo and not a reason to
// mis-read everything after it.
public void spans(string8 body, ^ref []string8 out, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    i64 at = 0
    bool fenced = false
    for:
        (string8 raw, i64 next) = line_at(body, at)
        string8 line = strings.trim(raw)
        if strings.starts_with(line, "```"):
            fenced = !fenced
        else if !fenced && !strings.starts_with(raw, "    "):
            i32 i = 0
            i64 n = #len(raw)
            for i < n:
                if raw[i] == '`':
                    i32 j = i + 1
                    i32 stop = 0 - 1
                    for j < n:
                        if raw[j] == '`':
                            stop = j
                            break
                        j += 1
                    if stop < 0:
                        break
                    if stop > i + 1:
                        ref []char8 owned = #format(strings.substring(raw, i + 1, stop - i - 1), alloc)
                        string8 span = owned
                        _ = #append(out^, span)
                    i = stop + 1
                    continue
                i += 1
        if next < 0:
            break
        at = next

//@ doc/check 40
//@ ### A sample is compiled, not just printed
//@
//@ A fence tagged `dado` is written out as a package and handed to the
//@ compiler under `--library --strict`. `--library` is why a sample that is
//@ only declarations compiles at all — ERR0301 would otherwise refuse a
//@ package with no entry point — and `--strict` is the bar the rest of the
//@ tree is held to.
//@
//@ A sample that declares its own `package` line is compiled as written;
//@ one that does not has `package doc_sample` prepended and nothing else.
//@ A sample needing statements writes a function around them, which is the
//@ right answer rather than a concession: a statement with no function
//@ around it is not something a reader can copy either.
//@
//@ This block's own sample is one, so the check is never running over an
//@ empty population:
//@
//@ ```dado
//@ import "core:strings"
//@
//@ // The first tab-delimited field of a row, and where the next begins.
//@ public (string8 field, i64 next) first_field(string8 row):
//@     i64 cut = strings.index_of(row, '\t')
//@     if cut < 0:
//@         return (row, #len(row))
//@     return (strings.substring(row, 0, cut), cut + 1)
//@ ```

// The tag of a fence whose text is a sample to compile: ` ```dado `.
public const string8 FENCE_TAG = "dado"

// Whether a trimmed line opens a sample: exactly the fence and `FENCE_TAG`.
private bool opens_sample(string8 line):
    string8 tag = FENCE_TAG
    return #len(line) == 3 + #len(tag) && strings.starts_with(line, "```") && strings.ends_with(line, tag)

// Every ` ```dado ` fence's text in `body`, appended to `out`.
//
// The opening line must be exactly the fence and the tag, so a ` ```c ` or a
// bare ` ``` ` is not a Dado sample and is not compiled as one.
public void sample_fences(string8 body, ^ref []string8 out, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    i64 at = 0
    bool inside = false
    ref []char8 buf = #make([]char8, 0, alloc)
    for:
        (string8 raw, i64 next) = line_at(body, at)
        string8 line = strings.trim(raw)
        if inside:
            if strings.starts_with(line, "```"):
                inside = false
                string8 text = buf
                _ = #append(out^, text)
            else if !phantom_end(raw, next):
                for c in raw:
                    _ = #append(buf, c)
                _ = #append(buf, '\n')
        else if opens_sample(line):
            inside = true
            buf = #make([]char8, 0, alloc)
        if next < 0:
            break
        at = next
    // A fence nobody closed is still a sample, and compiling it is how its
    // author finds out. Dropping it would be the silent skip this whole file
    // exists to refuse.
    if inside:
        string8 text = buf
        _ = #append(out^, text)

// ── the checks ──────────────────────────────────────────────────────────────

// Every claim in `rs` that the language does not have.
public void faults(ref []Record rs, ref []string8 lex, ref []string8 allow,
                   ^ref []Fault out, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    for r in rs:
        ref []string8 tokens = #make([]string8, 0, alloc)
        spans(r.body, &tokens, alloc)
        for t in tokens:
            i32 kind = claim_kind(t)
            if kind == CLAIM_NONE:
                continue
            if holds(lex, t):
                continue
            // **A sigilled name written in its applied form is the same name.**
            // `#has_eq(T)` is how a reader writes it in a sentence, and the
            // roster holds `#has_eq`; refusing the applied form would push
            // every author to write the bare one, which is not how anybody
            // describes a predicate. Measured: two independent writers hit this
            // on their first block and both reworded around it.
            //
            // Only the sigilled class gets this. A bare word with a paren
            // after it is a call to something, not a claim about a word, and a
            // code never takes an argument.
            if kind == CLAIM_SIGIL:
                i64 paren = strings.index_of(t, '(')
                if paren > 1 && holds(lex, strings.substring(t, 0, paren)):
                    continue
            // **A code and a sigil have no allowlist**, deliberately. Both are
            // unambiguous: nothing but a diagnostic code is spelled `ERR0504`
            // and nothing but a compiler name carries the `#`, so there is no
            // ordinary prose for the allowlist to be protecting.
            if kind == CLAIM_WORD && holds(allow, t):
                continue
            _ = #append(out^, (t, kind, r.file, r.line, r.slot))

// How many of the lexicon's spellings are named by at least one block.
//
// **The denominator is every spelling**, which is a large number this will not
// reach soon and should not pretend to. That is the point of a ratchet: it
// records where the floor is and refuses to let it fall, and a percentage of a
// target nobody has is still a number that can only go up.
public (i32 named, i32 total) coverage(ref []Record rs, ref []string8 lex,
                                       (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []string8 seen = #make([]string8, 0, alloc)
    for r in rs:
        spans(r.body, &seen, alloc)
    slices.sort(seen[:], strings.before)
    i32 named = 0
    string8 last = ""
    for t in seen:
        if t == last:
            continue
        last = t
        if holds(lex, t):
            named += 1
    return (named, i32(#len(lex)))

// The name a fault's kind goes by in a report.
public string8 kind_name(i32 kind):
    if kind == CLAIM_CODE:
        return "diagnostic code"
    if kind == CLAIM_SIGIL:
        return "compiler name"
    if kind == CLAIM_WORD:
        return "word"
    return "token"
