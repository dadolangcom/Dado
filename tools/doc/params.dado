// `doc params`: a doc comment's parameter lines against the parameters the
// declaration has.
//
// The compiler says what the parameters are, in a `dadoc --emit=declarations`
// dump of the file; the comment is cut from the file's own text above each
// declaration's start offset and read by `comment.dado`'s reader, the one held
// to the language server's fixtures. A field line whose key names no
// parameter is the commonest way a comment drifts from its function: the
// parameter was renamed and the comment was not.
//
// Everything this reports is a **warning**: the comment is still read, and a
// reader of the docs page sees the line under a heading that names nothing.
package doc

import "core:strings"

// The `decl` kinds whose comments may describe parameters: a signal's payload
// fields are dumped as `param` lines too.
private bool takes_params(string8 kind):
    return kind == "function" || kind == "method" || kind == "signal"

// The tab-separated fields of one dump line.
private ref []string8 tab_fields(string8 line,
                                 (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []string8 out = #make([]string8, 0, alloc)
    string8 rest = line
    for:
        i64 cut = strings.index_of(rest, '\t')
        if cut < 0:
            _ = #append(out, rest)
            return out
        _ = #append(out, strings.substring(rest, 0, cut))
        rest = strings.rest(rest, cut + 1)
    return out

// One declaration of the dump, with the names of its `param` lines.
private type Decl: (string8 kind, string8 name, i64 start, ref []string8 params)

// The parameters a warning offers instead: `` `a`, `b` ``.
private string8 param_list(ref []string8 params,
                           (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []char8 b = #make([]char8, 0, alloc)
    for p, i in params:
        if i > 0:
            put(&b, ", ")
        _ = #append(b, '`')
        put(&b, p)
        _ = #append(b, '`')
    string8 s = b
    return s

private bool holds_name(ref []string8 names, string8 name):
    for n in names:
        if n == name:
            return true
    return false

// The warnings for one declaration's comment, appended to `out`.
private void check_decl(Decl d, string8 source, string8 source_name, ^ref []string8 out,
                        (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    (string8 comment, i64 at) = cut_comment(source, d.start)
    if #len(comment) == 0:
        return
    DocComment dc = read_comment(comment, alloc)
    i32 first_line = 0
    ref []string8 seen = #make([]string8, 0, alloc)
    for f in dc.fields:
        if f.kind != "param":
            continue
        // Counted only when there is something to say: most comments have
        // no wrong lines, and the count walks the file from its start.
        if first_line == 0:
            first_line = line_number(source, at)
        i32 line = first_line + f.line
        if !holds_name(d.params, f.name):
            ref []char8 w = #make([]char8, 0, alloc)
            if #len(d.params) == 0:
                w = #format(source_name, ":", line, ":", f.col, ": warning: the comment above `",
                            d.name, "` describes `", f.name, "`, which is not a parameter of it; ",
                            "it takes none, so move the line above the field lines so it reads ",
                            "as prose, or delete it", alloc)
            else:
                w = #format(source_name, ":", line, ":", f.col, ": warning: the comment above `",
                            d.name, "` describes `", f.name, "`, which is not a parameter of it; ",
                            "it takes ", param_list(d.params, alloc), ": rename the line to one of ",
                            "them, or move it above the field lines so it reads as prose", alloc)
            string8 ws = w
            _ = #append(out^, ws)
        else if holds_name(seen, f.name):
            ref []char8 w = #format(source_name, ":", line, ":", f.col, ": warning: the comment above `",
                                    d.name, "` describes `", f.name, "` twice; keep one line for it, ",
                                    "with both texts joined, and delete this one", alloc)
            string8 ws = w
            _ = #append(out^, ws)
        else:
            _ = #append(seen, f.name)

// Every warning for one file: `decls` is its `dadoc --emit=declarations`
// dump, `source` its text, and `source_name` what a warning calls it. `ok` is
// false, with nothing checked, when `decls` is not such a dump.
public (i32 checked, bool ok) param_warnings(string8 decls, string8 source, string8 source_name,
                                             ^ref []string8 out,
                                             (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    (string8 first, i64 next) = line_at(decls, 0)
    if first != "declarations 1":
        return (0, false)
    i32 checked = 0
    bool have = false
    Decl cur = ("", "", 0, #make([]string8, 0, alloc))
    i64 at = next
    for at >= 0:
        (string8 line, i64 after) = line_at(decls, at)
        ref []string8 fs2 = tab_fields(line, alloc)
        if #len(fs2) >= 6 && fs2[0] == "decl":
            if have && takes_params(cur.kind):
                check_decl(cur, source, source_name, out, alloc)
                checked += 1
            (i32 start, bool sok) = to_int(fs2[5])
            have = sok
            cur = (fs2[1], fs2[2], i64(start), #make([]string8, 0, alloc))
        else if have && #len(fs2) >= 2 && fs2[0] == "param":
            _ = #append(cur.params, fs2[1])
        at = after
    if have && takes_params(cur.kind):
        check_decl(cur, source, source_name, out, alloc)
        checked += 1
    return (checked, true)
