// `doc page`: one package's page, the one `dado doc <package>` prints and
// `docs/packages/` holds one of for every collection package.
//
//     # core:strings
//
//     <the package's own comment: the `//` lines that open its main file>
//
//     ## Declarations
//
//     * `bool contains(string8 haystack, string8 needle)` — its doc line
//     ...
//
//     ## <slot>                    any `//@` blocks in the package's files
//
// **The declarations come in as a file, not from here.** They are what
// `dadoc query inspect <package>` prints — every declaration's signature as
// the diagnostics write it, with the first line of its doc comment indented
// under it — and this tool only lays them out. The compiler is the one that
// knows what a package declares; a second reading of the source here would be
// a second answer that could disagree with it.
//
// **The package's comment is read from one file**: the one named after the
// directory (`strings/strings.dado`) when it opens with a comment, else the
// first in byte order that does. Test files are skipped. The comment is the
// run of `//` lines at the top of the file, ending at the first other line or
// at a `//@` block, with the `// ` taken off each line.
package doc

import "core:io"
import "core:os/fs"
import "core:strings"

// The comment that opens `source`, its `//` taken off, one line per line;
// empty when it opens with anything else (`@test` included).
public ref []string8 package_comment(string8 source, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []string8 out = #make([]string8, 0, alloc)
    i64 at = 0
    for:
        (string8 line, i64 next) = line_at(source, at)
        if !strings.starts_with(line, "//") || strings.starts_with(line, "//@"):
            break
        string8 body = line[2..<#len(line)]
        if strings.starts_with(body, " "):
            body = body[1..<#len(body)]
        _ = #append(out, strings.trim_right(body))
        if next < 0:
            break
        at = next
    // Trailing blank comment lines say nothing.
    for #len(out) > 0 && #len(out[#len(out) - 1]) == 0:
        _ = #resize(out, #len(out) - 1)
    return out

// `sig` as inline code: in single backticks, or double ones with spaces
// when it holds a backtick itself.
public ref []char8 inline_code(string8 sig, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    if strings.has_byte(sig, '`'):
        return #format("`` ", sig, " ``", alloc)
    return #format("`", sig, "`", alloc)

// Whether a line ending in `c` ends where a sentence can.
public bool ends_sentence(char8 c):
    return c == '.' || c == ':' || c == '!' || c == '?' || c == ')' || c == '`' || c == '*'

// What `dadoc query inspect <package>` printed, as markdown lines: its
// summary line (`36 declarations, 35 public`) as a sentence, then a bullet
// per declaration with its doc line after a dash. Empty when it printed
// nothing.
public ref []string8 declarations_markdown(string8 api, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []string8 out = #make([]string8, 0, alloc)
    i64 at = 0
    bool first = true
    for:
        (string8 line, i64 next) = line_at(api, at)
        if first:
            first = false
            // `core:strings  (36 declarations, 35 public)`
            i64 open = strings.index_of(line, '(')
            if open >= 0 && strings.ends_with(line, ")"):
                ref []char8 s = #format(line[open + 1..<#len(line) - 1], ".", alloc)
                _ = #append(out, string8(s[:]))
                _ = #append(out, "")
        else if strings.starts_with(line, "    ") && #len(out) > 0:
            // The doc line of the declaration above it.
            // The compiler gives a doc comment's first line, which may stop
            // mid-sentence; an ellipsis says so.
            string8 last = out[#len(out) - 1]
            string8 doc_line = strings.trim(line)
            string8 more = ""
            if #len(doc_line) > 0 && !ends_sentence(doc_line[#len(doc_line) - 1]):
                more = "…"
            ref []char8 joined = #format(last, " — ", doc_line, more, alloc)
            out[#len(out) - 1] = string8(joined[:])
        else if !strings.is_empty(strings.trim(line)):
            ref []char8 code = inline_code(strings.trim(line), alloc)
            ref []char8 item = #format("* ", string8(code[:]), alloc)
            _ = #append(out, string8(item[:]))
        if next < 0:
            break
        at = next
    return out

// The file whose opening comment is the package's: see the header.
private (ref []char8 text, bool found) comment_file(string8 dir, string8 ext, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []string8 names = #make([]string8, 0, alloc)
    ref []char8 dc = strings.clone_to_cstring(dir, alloc)
    ^fs.Dir d = fs.open(cstring(dc))
    if fs.opened(d):
        for:
            (cstring entry, bool ok) = fs.next(d)
            if !ok:
                break
            string8 e = strings.borrow_from_cstring(entry)
            ref []char8 test_suffix = #format("_test", ext, alloc)
            if strings.ends_with(e, ext) && !strings.ends_with(e, string8(test_suffix[:])):
                ref []char8 own = #format(e, alloc)
                _ = #append(names, string8(own[:]))
        fs.close(d)
    // Byte order, so the choice is the same on every machine.
    for i in 1..<#len(names):
        string8 v = names[i]
        i64 j = i - 1
        for j >= 0 && strings.compare(names[j], v) > 0:
            names[j + 1] = names[j]
            j -= 1
        names[j + 1] = v
    string8 base = dir
    for #len(base) > 1 && (base[#len(base) - 1] == '/' || base[#len(base) - 1] == '\\'):
        base = base[0..<#len(base) - 1]
    i64 cut = #len(base) - 1
    for cut >= 0 && base[cut] != '/' && base[cut] != '\\':
        cut -= 1
    ref []char8 own_name = #format(base[cut + 1..<#len(base)], ext, alloc)
    string8 preferred = string8(own_name[:])
    ref []string8 order = #make([]string8, 0, alloc)
    for n in names:
        if n == preferred:
            _ = #append(order, n)
    for n in names:
        if n != preferred:
            _ = #append(order, n)
    for n in order:
        ref []char8 pc = #format(dir, "/", n, alloc)
        ref []char8 cpath = strings.clone_to_cstring(string8(pc[:]), alloc)
        ref []char8 text = slurp(cstring(cpath), alloc)
        ref []string8 c = package_comment(string8(text[:]), alloc)
        if #len(c) > 0:
            return (text, true)
    return (#make([]char8, 0, alloc), false)

// Write `title`'s page to `out`. `api` is `dadoc query inspect`'s answer
// (empty when there is none); `rs` the package's own `//@` blocks, sorted.
public (i32 blocks, bool ok) page(cstring out, string8 dir, string8 title, string8 ext, string8 api, ref []Record rs,
                                  (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ^io.FILE f = io.open_write(out)
    if !io.opened(f):
        return (0, false)
    ref []char8 head = #format("# ", title, "\n", alloc)
    _ = io.write_bytes(f, head[:])
    (ref []char8 source, bool has_comment) = comment_file(dir, ext, alloc)
    if has_comment:
        _ = io.write_bytes(f, strings.bytes("\n"))
        for l in package_comment(string8(source[:]), alloc):
            ref []char8 b = #format(l, "\n", alloc)
            _ = io.write_bytes(f, b[:])
    ref []string8 decls = declarations_markdown(api, alloc)
    if #len(decls) > 0:
        _ = io.write_bytes(f, strings.bytes("\n## Declarations\n\n"))
        for l in decls:
            ref []char8 b = #format(l, "\n", alloc)
            _ = io.write_bytes(f, b[:])
    string8 last = ""
    i32 blocks = 0
    for r in rs:
        if r.slot != last:
            last = r.slot
            ref []char8 h = #format("\n## ", r.slot, "\n\n", alloc)
            _ = io.write_bytes(f, h[:])
        ref []char8 b = #format(r.body, "\n", alloc)
        _ = io.write_bytes(f, b[:])
        blocks += 1
    _ = io.close(f)
    return (blocks, true)
