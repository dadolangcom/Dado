// The generated half of the language reference: the compiler's own rosters,
// as markdown.
//
// **Three sections of the language tour were headed *"Generated. Do not hand-edit
// — re-derive with …"* and were generated by nothing.** Measured: no script,
// no gate step and no tool in the tree referenced that document at all, and
// each section instead *printed* the `awk` one-liner that would have produced
// it, to be run by a person who remembered. All three happened to be correct
// on the day they were checked, which is the worst possible state for a claim
// to be in: right, unguarded, and indistinguishable from one that has drifted.
//
// **This emits a section per roster and not a section per hand-written
// table**, which is the same argument the vocabulary check makes: a list of
// which rosters to render would be a second list to go stale, and the lexicon
// has grown a roster twice. Rendering every roster the dump contains means a
// new one appears in the reference the day it appears in the compiler, without
// anybody remembering — and two rosters that had never been documented
// anywhere, `hasop` and `namekind`, arrived in the reference the first time
// this ran.
//
// **What is NOT derived is the column names**, because the dump has no header
// row and there is nothing to derive them from. They come from a small
// captions file, and a roster with no caption is rendered anyway, with a
// visible note saying its columns are unnamed. A roster that went missing
// would be the failure; a roster whose columns are unlabelled is a blemish
// somebody fixes when they notice. **Never let the prettier half decide
// whether the honest half appears.**
package doc

import "core:io"
import "core:mem"
import "core:slices"
import "core:strings"

//@ reference/generated 10
//@ ### The reference is generated, and by something
//@
//@ The rosters below are rendered from `dadoc --emit=lexicon`, one section
//@ per roster, by `dado doc reference`. Adding a roster to the compiler adds
//@ a section here; nobody has to remember.
//@
//@ That is worth saying because it was not true of what this replaced.
//@ Three sections of the old tour were headed *"Generated. Do not
//@ hand-edit"* and were generated by no script at all — each one printed
//@ the command that would have produced it, for a person to run. They were
//@ correct when last checked, which is exactly the state in which a claim
//@ is most dangerous.

// A roster's column captions: `<roster>\t<col>\t<col>…`, one roster per line,
// `#` starting a comment.
public type Caption: (string8 roster, string8 columns)

public ref []Caption captions(string8 text, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []Caption out = #make([]Caption, 0, alloc)
    i64 at = 0
    for:
        (string8 raw, i64 next) = line_at(text, at)
        string8 line = strings.trim(raw)
        if #len(line) > 0 && !strings.starts_with(line, "#"):
            i64 cut = strings.index_of(line, '\t')
            if cut > 0:
                _ = #append(out, (strings.substring(line, 0, cut),
                                  strings.rest(line, cut + 1)))
        if next < 0:
            break
        at = next
    return out

private (string8 columns, bool named) caption_for(ref []Caption cs, string8 roster):
    for c in cs:
        if c.roster == roster:
            return (c.columns, true)
    return ("", false)

// Every roster name in a dump, sorted and unique. Sorted so the reference is
// reproducible: a generated file that reordered itself between runs could not
// be compared against a committed one, which is the only thing that would make
// it trustworthy.
public ref []string8 rosters(string8 text, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []string8 all = #make([]string8, 0, alloc)
    i64 at = 0
    for:
        (string8 line, i64 next) = line_at(text, at)
        if #len(line) > 0:
            i64 cut = strings.index_of(line, '\t')
            if cut > 0:
                _ = #append(all, strings.substring(line, 0, cut))
        if next < 0:
            break
        at = next
    slices.sort(all[:], strings.before)
    ref []string8 out = #make([]string8, 0, alloc)
    string8 last = ""
    for r in all:
        if r == last:
            continue
        last = r
        _ = #append(out, r)
    return out

// A field, with the one character a markdown table cannot hold escaped.
//
// **Six rows of the lexicon carry a `|` today** — a diagnostic's rule text
// spelling an alternation — and an unescaped one ends the cell early and
// silently shifts every column after it. Measured before it was written.
private ref []char8 cell(string8 field, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ref []char8 out = #make([]char8, 0, alloc)
    for c in field:
        if c == '|':
            _ = #append(out, '\\')
        _ = #append(out, c)
    return out

// How many tab-separated fields a line has.
private i64 arity(string8 line):
    return strings.count_byte(line, '\t') + 1

// One roster's rows, as a markdown table, written to `f`.
private i32 render_roster(^io.FILE f, string8 text, string8 roster,
                          ref []Caption cs, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    // The widest row decides the table's width. Rows of one roster have the
    // same arity today; taking the maximum rather than the first row's means a
    // roster that grows a field renders it instead of truncating it.
    i64 width = 0
    i32 rows = 0
    i64 at = 0
    for:
        (string8 line, i64 next) = line_at(text, at)
        if #len(line) > 0 && starts_field(line, roster):
            rows += 1
            i64 n = arity(line)
            if n > width:
                width = n
        if next < 0:
            break
        at = next
    if rows == 0:
        return 0
    // The roster name is field 1 and is not a column: it is the section's
    // heading. Every row therefore has `width - 1` cells, and the separator
    // and the caption row have to agree with that or the table renders with a
    // stray empty column.
    i64 cells = width - 1
    if cells < 1:
        cells = 1

    ref []char8 head = #format("## `", roster, "`\n\n", alloc)
    _ = io.write_bytes(f, head[:])
    #delete(head)

    (string8 cols, bool named) = caption_for(cs, roster)
    if named:
        ref []char8 h = #format("| ", cols, " |\n", alloc)
        // The captions file holds them tab-separated; a table wants pipes.
        ref []char8 bar = #make([]char8, 0, alloc)
        for c in h:
            if c == '\t':
                _ = #append(bar, ' ')
                _ = #append(bar, '|')
                _ = #append(bar, ' ')
            else:
                _ = #append(bar, c)
        _ = io.write_bytes(f, bar[:])
        #delete(bar)
        #delete(h)
    else:
        // **Rendered anyway, and said out loud.** A roster nobody has named
        // the columns of is still a roster, and leaving it out because it is
        // not pretty is how a reference comes to be short a section.
        ref []char8 note = #format(
            "*This roster has no column names yet; the fields are in the order",
            " the compiler prints them.*\n\n", alloc)
        _ = io.write_bytes(f, note[:])
        #delete(note)
        ref []char8 h = #make([]char8, 0, alloc)
        i32 i = 0
        for i < cells:
            for c in "|  ":
                _ = #append(h, c)
            i += 1
        _ = #append(h, '|')
        _ = #append(h, '\n')
        _ = io.write_bytes(f, h[:])
        #delete(h)

    ref []char8 sep = #make([]char8, 0, alloc)
    i32 j = 0
    for j < cells:
        for c in "|---":
            _ = #append(sep, c)
        j += 1
    _ = #append(sep, '|')
    _ = #append(sep, '\n')
    _ = io.write_bytes(f, sep[:])
    #delete(sep)

    at = 0
    for:
        (string8 line, i64 next) = line_at(text, at)
        if #len(line) > 0 && starts_field(line, roster):
            ref []char8 row = #make([]char8, 0, alloc)
            i32 k = 0
            i64 cursor = #len(roster) + 1
            for k < cells:
                string8 rest = strings.rest(line, cursor)
                i64 cut = strings.index_of(rest, '\t')
                string8 field = rest
                if cut >= 0:
                    field = strings.substring(rest, 0, cut)
                    cursor = cursor + cut + 1
                else:
                    cursor = #len(line)
                ref []char8 c2 = cell(field, alloc)
                string8 shown = c2
                for c in "| ":
                    _ = #append(row, c)
                for c in shown:
                    _ = #append(row, c)
                _ = #append(row, ' ')
                #delete(c2)
                k += 1
            _ = #append(row, '|')
            _ = #append(row, '\n')
            _ = io.write_bytes(f, row[:])
            #delete(row)
        if next < 0:
            break
        at = next

    ref []char8 gap = #format("\n", alloc)
    _ = io.write_bytes(f, gap[:])
    #delete(gap)
    return rows

// Whether a line's first tab-separated field is exactly `roster`.
private bool starts_field(string8 line, string8 roster):
    if !strings.starts_with(line, roster):
        return false
    i64 n = #len(roster)
    if #len(line) <= n:
        return false
    return line[n] == '\t'

// The whole reference. Returns `(rosters rendered, rows rendered)`.
public (i32 sections, i32 rows) reference(cstring out, string8 lexicon,
                                          ref []Caption cs, (rawptr(rawptr, AllocatorMode, u64, u64, rawptr, u64) proc, rawptr data) alloc):
    ^io.FILE f = io.open_write(out)
    if !io.opened(f):
        return (0, 0)
    ref []char8 head = #format(
        "<!-- Generated by `dado doc reference` from `dadoc --emit=lexicon`.\n",
        "     Do not hand-edit: regenerate it. Every roster the compiler\n",
        "     prints gets a section, so a new roster appears here without\n",
        "     anybody remembering to add one. -->\n",
        "\n# The language, as the compiler reports it\n\n", alloc)
    _ = io.write_bytes(f, head[:])
    #delete(head)

    ref []string8 names = rosters(lexicon, alloc)
    i32 sections = 0
    i32 rows = 0
    for r in names:
        i32 n = render_roster(f, lexicon, r, cs, alloc)
        if n > 0:
            sections += 1
            rows += n
    _ = io.close(f)
    return (sections, rows)
