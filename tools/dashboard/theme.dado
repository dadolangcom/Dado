// The Workshop palette, from the brand guide: Paper and Charcoal grounds,
// Slate for secondary text, Rule for borders, and copper — the brand's one
// channel colour — for focus, selection and errors alike, so an error stands
// out without red.
//
//                  dark        light
//     Paper        #15181C     #F3F4F5     the window's ground
//     Charcoal     #DDE1E6     #2B3036     body text (ink)
//     Slate        #9AA3AD     #5A636E     labels, secondary text
//     Rule         #2E343C     #D5DAE0     borders, hairlines
//     Copper       #E58B57 (front)  #AE5428 (back)
//
// The dark ground is the default and the light one is asked for, with
// `--theme=light` or `DADO_THEME=light`: a terminal does not say reliably
// which ground it has, and a light theme on a dark terminal is the worse of
// the two mistakes. On a light ground the accent is the back copper, because
// the front one is too pale to read as text on paper.
//
// Two fallbacks, chosen from what the terminal was found to draw
// (`tui.color_depth`): a **16-colour** palette of the terminal's own colours,
// where copper is yellow (dark) or red (light) and every ground is the
// terminal's, and **no colour** at all for `NO_COLOR` or `TERM=dumb`, where
// bold, reverse and the selection marker carry the structure.
package dashboard

import tui "vendor:tui"

private tui.Theme workshop(bool light):
    tui.Theme t = tui.DARK
    if light:
        t.base = tui.hex(0xF3F4F5)
        t.mantle = tui.hex(0xE8EAED)
        t.surface = tui.hex(0xFBFBFC)
        t.overlay = tui.hex(0xFFFFFF)
        t.text = tui.hex(0x2B3036)
        t.subtext = tui.hex(0x5A636E)
        t.muted = tui.hex(0x7C858F)
        t.faint = tui.hex(0xD5DAE0)
        t.accent = tui.hex(0xAE5428)
        t.on_accent = tui.hex(0xFFFFFF)
        t.ok = tui.hex(0x3F7A43)
        t.warn = tui.hex(0x8F6512)
        t.err = tui.hex(0xAE5428)
        t.info = tui.hex(0x5A636E)
        t.border = tui.hex(0xD5DAE0)
        t.border_focus = tui.hex(0xAE5428)
        return t
    t.base = tui.hex(0x15181C)
    t.mantle = tui.hex(0x101316)
    t.surface = tui.hex(0x1A1E23)
    t.overlay = tui.hex(0x21262C)
    t.text = tui.hex(0xDDE1E6)
    t.subtext = tui.hex(0x9AA3AD)
    t.muted = tui.hex(0x737C87)
    t.faint = tui.hex(0x2E343C)
    t.accent = tui.hex(0xE58B57)
    t.on_accent = tui.hex(0x15181C)
    t.ok = tui.hex(0x8DB38B)
    t.warn = tui.hex(0xD4A95E)
    t.err = tui.hex(0xE58B57)
    t.info = tui.hex(0x9AA3AD)
    t.border = tui.hex(0x2E343C)
    t.border_focus = tui.hex(0xE58B57)
    return t

private tui.Theme sixteen(bool light):
    tui.Theme t = tui.MONO
    t.frame = tui.ROUND
    t.wide_glyphs = true
    t.muted = tui.ansi(8)
    t.faint = tui.ansi(8)
    t.accent = tui.ansi(1) if light else tui.ansi(3)
    t.on_accent = tui.ansi(15) if light else tui.ansi(0)
    t.ok = tui.ansi(2)
    t.warn = tui.ansi(5) if light else tui.ansi(3)
    t.err = t.accent
    t.info = tui.ansi(6)
    t.border = tui.ansi(8)
    t.border_focus = t.accent
    return t

private tui.Theme colourless():
    tui.Theme t = tui.MONO
    t.frame = tui.ROUND
    t.wide_glyphs = true
    return t

// The theme for this terminal: the palette its colour depth can draw, on the
// ground asked for.
private void choose_theme(bool light):
    i32 depth = tui.color_depth()
    if depth == tui.COLORS_NONE:
        tui.theme(colourless())
        g_theme_name = "no colour"
        return
    if depth == tui.COLORS_16:
        tui.theme(sixteen(light))
        g_theme_name = "16 colours, light" if light else "16 colours, dark"
        return
    tui.theme(workshop(light))
    g_theme_name = "Workshop light" if light else "Workshop dark"
    if depth == tui.COLORS_256: g_theme_name = "Workshop light, 256 colours" if light else "Workshop dark, 256 colours"

private string8 g_theme_name = ""
