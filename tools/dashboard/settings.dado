// The dashboard's settings: `dashboard.<name>=value` lines in the state file
// the toolchain already keeps — `<install>/state` in an install, and
// `<build>/dashboard.state` in a checkout, where the build directory is the
// one place the repository's own files are not.
//
// **Every other line is kept**, byte for byte: the file is shared with
// `dado` (the tools' build records, the update check's `remote_head`), so it
// is read fresh, the dashboard's own lines are replaced or added, and the
// whole file is written back atomically (`fs.write_file`). A name the
// dashboard does not know is left alone, so an older dashboard and a newer
// one can share a file.
//
// Saved when a run starts and when the dashboard closes, so a choice
// survives a crash as well as a quit.
package dashboard

import tui "vendor:tui"
import "core:os"
import "core:os/fs"
import "core:path"
import "core:strings"

private ref []char8 g_state_path
private bool g_save_failed_told

private void settle_state_path():
    if in_install():
        ref []char8 p = path.join(txt(g_install), "state")
        g_state_path = own(g_state_path, txt(p))
        #delete(p)
        return
    if blank(txt(g_build_dir)): return
    ref []char8 q = path.join(txt(g_build_dir), "dashboard.state")
    g_state_path = own(g_state_path, txt(q))
    #delete(q)

private void load_settings():
    string8 p = txt(g_state_path)
    if #len(p) == 0: return
    try ref []char8 text = fs.read_file(p) else:
        return
    defer #delete(text)
    string8 t = text
    (string8 tab, bool has_tab) = value_of(t, "dashboard.tab")
    // An empty directory opens on Home, where the first-run guidance is,
    // whatever tab was open last time.
    if has_tab && node_count() > 0:
        (i64 n, bool ok) = number(strings.trim(tab))
        if ok && n >= 0 && n < i64(N_TABS): g_tab = i32(n)
    (string8 cc, bool _) = value_of(t, "dashboard.compiler")
    g_cc = index_in(COMPILERS[:], strings.trim(cc), g_cc)
    (string8 opt, bool _) = value_of(t, "dashboard.optimise")
    g_opt = index_in(OPTS[:], strings.trim(opt), g_opt)
    (string8 san, bool _) = value_of(t, "dashboard.sanitizer")
    g_san = index_in(SANITIZERS[:], strings.trim(san), g_san)
    (string8 tgt, bool _) = value_of(t, "dashboard.target")
    g_target = index_in(TARGETS[:], strings.trim(tgt), g_target)
    (string8 page_on, bool _) = value_of(t, "dashboard.page")
    g_page_on = strings.trim(page_on) == "on"
    (string8 tmpl, bool has_tmpl) = value_of(t, "dashboard.page_template")
    if has_tmpl: g_page = tui.set_text(g_page, strings.trim(tmpl))
    (string8 pkg, bool has_pkg) = value_of(t, "dashboard.package")
    if has_pkg: g_wanted_package = own(g_wanted_package, strings.trim(pkg))

private i32 index_in([]string8 names, string8 want, i32 otherwise):
    for i in 0..<i32(#len(names)):
        if names[i] == want: return i
    return otherwise

private void save_settings():
    string8 p = txt(g_state_path)
    if #len(p) == 0: return
    ref []char8 was = read_owned(p)
    string8 old = txt(was)
    strings.Builder a = strings.builder(#len(old) + 256)
    with_value(&a, old, "dashboard.tab", #format(g_tab, tui.mem))
    strings.Builder b = strings.builder(#len(old) + 256)
    with_value(&b, strings.text(a), "dashboard.compiler", COMPILERS[g_cc])
    #delete(a)
    strings.Builder c = strings.builder(#len(old) + 256)
    with_value(&c, strings.text(b), "dashboard.optimise", OPTS[g_opt])
    #delete(b)
    strings.Builder d = strings.builder(#len(old) + 256)
    with_value(&d, strings.text(c), "dashboard.sanitizer", SANITIZERS[g_san])
    #delete(c)
    strings.Builder e = strings.builder(#len(old) + 256)
    with_value(&e, strings.text(d), "dashboard.target", TARGETS[g_target])
    #delete(d)
    strings.Builder f = strings.builder(#len(old) + 256)
    with_value(&f, strings.text(e), "dashboard.page", "on" if g_page_on else "off")
    #delete(e)
    strings.Builder g = strings.builder(#len(old) + 256)
    with_value(&g, strings.text(f), "dashboard.page_template", tui.edited(g_page))
    #delete(f)
    strings.Builder h = strings.builder(#len(old) + 256)
    with_value(&h, strings.text(g), "dashboard.package", selected_package())
    #delete(g)
    #delete(was)
    ref []char8 dir = path.dir(p)
    _ = fs.make_dirs(txt(dir), #heap)
    #delete(dir)
    try fs.write_file(p, strings.text(h)) else code:
        if !g_save_failed_told:
            g_save_failed_told = true
            tui.toast(#format("settings not saved to ", p, ": ", os.message(code), ". Check that the directory is yours to write.", tui.mem), tui.now().err, 8.0)
    #delete(h)
