// The Diagnostics tab: what the compiler finds in the selected package, one
// row each, and the one picked shown whole with the source it points at.
//
// **The list is `dadoc --emit=explained`**, asked after every build, run,
// test or check and whenever the tab is opened on a package it has not read:
// one line per diagnostic — severity, code, scope, file, byte span,
// line:column, message, help — tab-separated, so nothing here parses the
// human form a terminal shows. It is asked with `--strict`, as `dado build`
// compiles, so the lints a build refuses are listed as the errors they are.
//
// **Enter opens the file at the line** in `$EDITOR` (`$EDITOR +LINE FILE`,
// which vi, vim, nvim, nano, emacs, helix and micro all take) or, with no
// `$EDITOR`, VS Code's `code -g FILE:LINE` when `code` is on the PATH. The
// terminal goes to the editor and comes back (`tui.shell_out`). Opening is
// all the dashboard does: editing source is never its job.
//
// **A diagnostic names its file relative to its package's parent** —
// `tour/main.dado` for `corpus/tour`, `strings/strings.dado` for a file of
// `core:strings` — so the file is looked for beside the package, under each
// collection, and under the working directory, in that order.
package dashboard

import tui "vendor:tui"
import "core:os"
import "core:os/fs"
import "core:os/proc"
import "core:path"
import "core:strings"

private tui.Log g_diags
private ref []char8 g_diags_for
private ref []char8 g_diags_error
private bool g_diags_known
private i32 g_diag_row
private i32 g_diag_shown = 0 - 1         // the row whose source is in g_excerpt
private tui.Log g_excerpt
private ref []char8 g_excerpt_path

private void explained_answered(string8 about, string8 text, bool ok):
    tui.log_clear(&g_diags)
    g_diags_for = own(g_diags_for, about)
    g_diags_error = own(g_diags_error, "")
    string8 rest = text
    bool odd = false
    for #len(rest) > 0:
        (string8 l, string8 tail, bool more) = strings.line(rest)
        string8 sev = field(l, 0)
        if sev == "error" || sev == "warning" || sev == "note" || sev == "lint":
            tui.log_say(&g_diags, l)
        else if filled(strings.trim(l)):
            odd = true
        if !more: break
        rest = tail
    g_diags_known = true
    g_diag_row = 0
    g_diag_shown = 0 - 1
    if odd && tui.log_lines(g_diags) == 0:
        explained_failed(about, #format("dadoc did not answer in the explained form: ", strings.trim(text), tui.mem))

private void explained_failed(string8 about, string8 why):
    g_diags_for = own(g_diags_for, about)
    g_diags_error = own(g_diags_error, why)
    g_diags_known = true

private i32 diag_count():
    if txt(g_diags_for) != selected_package(): return 0
    return tui.log_lines(g_diags)

private string8 diag_row(i32 i):
    string8 l = tui.log_at(&g_diags, i)
    string8 r = #format(field(l, 1), "  ", field(l, 3), ":", field(l, 5), "  ", field(l, 6), tui.mem)
    return r

// `4:13` -> 4.
private string8 diag_line_number(string8 l):
    (string8 line, string8 _, bool _) = strings.split_first(field(l, 5), ":")
    return line

// Where a diagnostic's file is on disk, or "".
private string8 diag_file(string8 named):
    string8 pkg = selected_package()
    ref []char8 base = path.join(txt(g_cwd), pkg) if pkg != "." else own(nil, txt(g_cwd))
    ref []char8 parent = path.dir(txt(base))
    #delete(base)
    ref []char8 a = path.join(txt(parent), named)
    #delete(parent)
    if exists(txt(a)):
        string8 s = #format(txt(a), tui.mem)
        #delete(a)
        return s
    #delete(a)
    for c in ["core", "app", "vendor"]:
        ref []char8 b = path.join(txt(g_collections), c, named)
        if exists(txt(b)):
            string8 t = #format(txt(b), tui.mem)
            #delete(b)
            return t
        #delete(b)
    ref []char8 d = path.join(txt(g_cwd), named)
    if exists(txt(d)):
        string8 u = #format(txt(d), tui.mem)
        #delete(d)
        return u
    #delete(d)
    return ""

private bool exists(string8 p):
    ref []char8 c = strings.clone_to_cstring(p, #heap)
    bool there = fs.is_file(cstring(c))
    #delete(c)
    return there

// Read the lines around the selected diagnostic's into `g_excerpt`, once per
// selection.
private void load_excerpt(i32 i):
    if i == g_diag_shown: return
    g_diag_shown = i
    tui.log_clear(&g_excerpt)
    string8 l = tui.log_at(&g_diags, i)
    string8 file = diag_file(field(l, 3))
    g_excerpt_path = own(g_excerpt_path, file)
    if #len(file) == 0: return
    (i64 want, bool ok) = number(diag_line_number(l))
    if !ok: return
    ref []char8 text = read_owned(file)
    if text == nil: return
    string8 rest = txt(text)
    i64 at = 1
    for #len(rest) > 0:
        (string8 one, string8 tail, bool more) = strings.line(rest)
        if at >= want - 1 && at <= want + 1:
            string8 mark = "▸" if at == want else " "
            string8 num = #format(at, tui.mem)
            string8 pad = "     "
            if size(num) < 5: pad = pad[0..<5 - i32(size(num))]
            else: pad = ""
            tui.log_say(&g_excerpt, #format(mark, pad, num, " │ ", strings.trim_right_cr(one), tui.mem))
        if at > want + 1 || !more: break
        at = at + 1
        rest = tail
    #delete(text)

private void diagnostics_tab():
    string8 pkg = selected_package()
    if #len(pkg) > 0 && txt(g_diags_for) != pkg && !querying(Q_EXPLAINED): want_explained(pkg)
    i32 n = diag_count()
    if tui.panel(title: diag_title(n), height: tui.pct(50), pad: 1):
        defer tui.end()
        if #len(pkg) == 0:
            _ = tui.paragraph(s: "Select a package under Packages (2); its diagnostics are listed here.", color: tui.now().subtext)
            return
        if txt(g_diags_for) == pkg && filled(txt(g_diags_error)):
            _ = tui.paragraph(s: txt(g_diags_error), color: tui.now().err)
            return
        if n == 0:
            if where_broken(): _ = tui.paragraph(s: txt(g_where_error), color: tui.now().err)
            else if querying(Q_EXPLAINED) || txt(g_diags_for) != pkg: tui.muted("asking the compiler… (esc cancels)")
            else: _ = tui.paragraph(s: #format("dadoc finds nothing to report in ", pkg, ". A build (b) or a check (c) reads it again.", tui.mem), color: tui.now().ok)
            return
        ref []string8 rows = #make([]string8, 0, tui.mem)
        for i in 0..<n:
            _ = #append(rows, diag_row(i))
        if g_diag_row >= n: g_diag_row = n - 1
        if tui.list(selected: &g_diag_row, items: rows[:], height: tui.REST, tag: "diags"):
            open_in_editor(g_diag_row)
    if tui.panel(title: "Detail", height: tui.REST, pad: 1):
        defer tui.end()
        if n == 0:
            tui.muted("enter on a diagnostic opens its file at the line")
            return
        load_excerpt(g_diag_row)
        string8 l = tui.log_at(&g_diags, g_diag_row)
        string8 sev = field(l, 0)
        tui.Color c = tui.now().err if sev == "error" else tui.now().warn
        tui.text(s: #format(sev, "[", field(l, 1), "]: ", field(l, 6), tui.mem), color: c, attr: tui.Attr.BOLD)
        string8 file = txt(g_excerpt_path)
        tui.text(s: #format("  --> ", field(l, 3), ":", field(l, 5), tui.mem), color: tui.now().subtext)
        for k in 0..<tui.log_lines(g_excerpt):
            tui.text(s: tui.log_at(&g_excerpt, k), color: tui.now().text)
        if filled(field(l, 7)): _ = tui.paragraph(s: #format("help: ", field(l, 7), tui.mem), color: tui.now().subtext)
        if #len(file) == 0: tui.text(s: "the file is not under this directory or the collections", color: tui.now().warn)
        else: tui.text(s: #format("enter opens ", shown_path(file), tui.mem), color: tui.now().muted)

private string8 diag_title(i32 n):
    if n == 0: return "Diagnostics"
    string8 t = #format("Diagnostics (", n, ")", tui.mem)
    return t

// Hand the terminal to an editor at the diagnostic's line.
private void open_in_editor(i32 i):
    if i < 0 || i >= diag_count(): return
    string8 l = tui.log_at(&g_diags, i)
    string8 file = diag_file(field(l, 3))
    string8 line = diag_line_number(l)
    if #len(file) == 0:
        tui.toast(#format("cannot find ", field(l, 3), " under this directory or the collections", tui.mem), tui.now().err, 6.0)
        return
    (ref []char8 ed, bool set) = os.get_env("EDITOR")
    string8 editor = strings.trim(txt(ed))
    string8 cmd = ""
    if set && #len(editor) > 0:
        cmd = #format(editor, " +", line, " ", quoted(file), tui.mem)
    else if on_path("code"):
        cmd = #format("code -g ", quoted(#format(file, ":", line, tui.mem)), tui.mem)
    #delete(ed)
    if #len(cmd) == 0:
        tui.toast("no editor: set $EDITOR (vi, nano, hx, …) or put VS Code's code on the PATH", tui.now().err, 8.0)
        return
    (bool exited, i32 status) = tui.shell_out(cstring(strings.clone_to_cstring(cmd, tui.mem)))
    if !proc.ok(exited, status):
        tui.toast(#format("the editor exited with ", status, ": `", cmd, "`", tui.mem), tui.now().err, 8.0)

// One argument for the shell `shell_out` runs: single quotes on POSIX,
// double on Windows.
private string8 quoted(string8 s):
    ref []char8 run = #make([]char8, 0, tui.mem)
    if run == nil: return s
    when #OS == #WINDOWS:
        _ = #append(run, '"')
        for c in s:
            if c != '"': _ = #append(run, c)
        _ = #append(run, '"')
    else:
        _ = #append(run, '\'')
        for c in s:
            if c == '\'':
                for q in "'\\''": _ = #append(run, q)
            else: _ = #append(run, c)
        _ = #append(run, '\'')
    string8 out = run
    return out

// Whether `program` is a file in one of the `PATH`'s directories.
private bool on_path(string8 program):
    (ref []char8 pv, bool set) = os.get_env("PATH")
    defer #delete(pv)
    if !set: return false
    char8 sep = ':'
    when #OS == #WINDOWS:
        sep = ';'
    string8 rest = txt(pv)
    for #len(rest) > 0:
        i64 cut = strings.index_of(rest, sep)
        string8 dir = rest if cut < 0 else strings.substring(rest, 0, cut)
        if #len(dir) > 0:
            ref []char8 p = path.join(dir, program)
            bool there = exists(txt(p))
            #delete(p)
            if there: return true
        if cut < 0: break
        rest = strings.rest(rest, cut + 1)
    return false

// `p` relative to the working directory when it is under it, as the rest of
// the screen names paths.
private string8 shown_path(string8 p):
    try ref []char8 rel = path.rel(txt(g_cwd), p) else:
        return p
    string8 r = #format(txt(rel), tui.mem)
    #delete(rel)
    if strings.starts_with(r, ".."): return p
    return r
