// Small text helpers: owned copies, the tab-separated fields every toolchain
// dump uses, `NAME=value` lines, one string out of a line of JSON, and
// version numbers.
//
// **What outlives a frame is copied to `#heap`** (`own`); what is built for
// one frame comes from `tui.mem` and is never kept. The frame arena is reset
// at the top of every frame, so a string formatted there and kept in a
// package variable reads as the next frame's bytes.
package dashboard

import tui "vendor:tui"
import "core:os/fs"
import "core:strings"

// A heap copy of `s`, after freeing `old`. The pair is the whole lifetime
// rule for a package variable holding text.
private ref []char8 own(ref []char8 old, string8 s):
    #delete(old)
    ref []char8 copy = #make([]char8, 0, #heap)
    if copy == nil: return copy
    for c in s:
        if !#append(copy, c): break
    return copy

// Whether `s` is empty, or not, and its length: `#len` asks for a named
// place, so a call's answer is measured through a parameter.
private bool blank(string8 s): return #len(s) == 0
private bool filled(string8 s): return #len(s) > 0
private i64 size(string8 s): return #len(s)

// The text an owned buffer holds, "" for none.
private string8 txt(ref []char8 r):
    if r == nil: return ""
    string8 s = r
    return s

// The `n`th tab-separated field of `line`, as a window over it.
private string8 field(string8 line, i32 n):
    i32 len = i32(#len(line))
    i32 at = 0
    i32 seen = 0
    i32 from = 0
    for at <= len:
        if at == len || line[at] == '\t':
            if seen == n: return line[from..<at]
            seen = seen + 1
            from = at + 1
        at = at + 1
    return ""

// The value of `name` in `NAME=value` text, and whether there is a line for
// it.
private (string8 value, bool found) value_of(string8 text, string8 name):
    string8 rest = text
    for #len(rest) > 0:
        (string8 l, string8 tail, bool more) = strings.line(rest)
        (string8 key, string8 value, bool eq) = strings.split_first(strings.trim_right_cr(l), "=")
        if eq && strings.trim(key) == name: return (value, true)
        if !more: break
        rest = tail
    return ("", false)

// `text` with `name=value` in place of the line for `name`, or added at the
// end; every other line kept as it was. `into` collects the result.
private void with_value(^strings.Builder into, string8 text, string8 name, string8 value):
    bool replaced = false
    string8 rest = text
    for #len(rest) > 0:
        (string8 l, string8 tail, bool more) = strings.line(rest)
        (string8 key, string8 _, bool eq) = strings.split_first(l, "=")
        if eq && strings.trim(key) == name:
            if !replaced:
                _ = strings.append(into, name)
                _ = strings.append(into, "=")
                _ = strings.append(into, value)
                _ = strings.append(into, "\n")
            replaced = true
        else:
            _ = strings.append(into, l)
            _ = strings.append(into, "\n")
        if !more: break
        rest = tail
    if !replaced:
        _ = strings.append(into, name)
        _ = strings.append(into, "=")
        _ = strings.append(into, value)
        _ = strings.append(into, "\n")

// The string value of `"key": "..."` in one line of JSON, unescaped into
// `tui.mem`; "" when the line has none. The toolchain's JSON reports write
// one record per line, which is what makes a line the unit here.
private string8 json_text(string8 line, string8 key):
    string8 want = #format("\"", key, "\": \"", tui.mem)
    (string8 _, string8 after, bool found) = strings.split_first(line, want)
    if !found: return ""
    ref []char8 out = #make([]char8, 0, tui.mem)
    if out == nil: return ""
    i64 i = 0
    i64 n = #len(after)
    for i < n:
        char8 c = after[i]
        if c == '"': break
        if c == '\\' && i + 1 < n:
            i = i + 1
            char8 e = after[i]
            if e == 'n': _ = #append(out, '\n')
            else if e == 't': _ = #append(out, '\t')
            else if e == 'r': pass
            else if e == 'u': i = i + 4          // a control character: dropped
            else: _ = #append(out, e)
        else:
            _ = #append(out, c)
        i = i + 1
    string8 s = out
    return s

// Whether version `a` is newer than `b`, compared as dotted numbers with a
// prerelease (`-rc.1`, `-dev`) older than the release it precedes. Build
// metadata after `+` is ignored. False when either does not read.
private bool newer(string8 a, string8 b):
    (string8 ac, string8 _, bool _) = strings.split_first(a, "+")
    (string8 bc, string8 _, bool _) = strings.split_first(b, "+")
    (string8 an, string8 apre, bool ahas) = strings.split_first(ac, "-")
    (string8 bn, string8 bpre, bool bhas) = strings.split_first(bc, "-")
    string8 x = an
    string8 y = bn
    for i in 0..<3:
        (string8 xh, string8 xt, bool _) = strings.split_first(x, ".")
        (string8 yh, string8 yt, bool _) = strings.split_first(y, ".")
        (i64 xv, bool xok) = number(xh)
        (i64 yv, bool yok) = number(yh)
        if !xok || !yok: return false
        if xv != yv: return xv > yv
        x = xt
        y = yt
    if ahas && !bhas: return false
    if bhas && !ahas: return true
    if ahas && bhas: return strings.after(apre, bpre)
    return false

// A whole decimal number.
private (i64 value, bool ok) number(string8 s):
    if #len(s) == 0: return (0, false)
    i64 v = 0
    for c in s:
        if c < '0' || c > '9': return (0, false)
        v = (v * 10) + (i64(c) - i64('0'))
    return (v, true)

// The last component of a path, either separator.
private string8 last_part(string8 p):
    i64 from = 0
    for i in 0..<#len(p):
        if p[i] == '/' || p[i] == '\\': from = i + 1
    return strings.rest(p, from)

// The whole of the file at `p`, owned by the caller, or nil when it cannot
// be read — a missing file and an unreadable one alike, for the callers that
// treat both as "nothing there yet".
private ref []char8 read_owned(string8 p):
    ref []char8 none = nil
    try ref []char8 t = fs.read_file(p) else:
        return none
    return t

// `s` in at most `w` columns, its start dropped for a `…` when it is longer:
// the end of a path is the part that tells two apart.
private string8 fit(string8 s, i32 w):
    i32 have = tui.measure(s)
    if have <= w || w < 2: return s
    i64 cut = #len(s)
    i32 cols = 0
    for cut > 0 && cols < w - 1:
        cut = cut - 1
        // Step back over UTF-8 continuation bytes to a character's start.
        for cut > 0 && (u8(s[cut]) & 0xC0) == 0x80:
            cut = cut - 1
        cols = cols + 1
    string8 r = #format("…", strings.rest(s, cut), tui.mem)
    return r

// A key and a value that may be long — a path, a version — fitted to the
// width left, so the key is never pushed out.
private void kv_path(string8 key, string8 value):
    i32 room = tui.available().w - tui.measure(key) - 3
    tui.kv_text(key, fit(value, room))
