// The Build tab: the four verbs on the selected package, the choices that
// become their flags, and the Output pane they stream into.
//
// **Every choice is a flag `dado` has**, so the preview line under the
// choices is exactly what runs, and a run can be repeated in a shell by
// copying it:
//
//     compiler     zig is the default (no flag); clang and gcc are --cc
//     optimise     -O2 is the default; debug is --debug (-g -O0)
//     sanitizer    the driver's default (on for test) | --sanitize=address
//                  | --sanitize=thread | --no-sanitize
//     target       native; a cross triple is DADO_TARGET for the compiler
//                  and ZIG_TARGET for the C compiler, one each half, and
//                  needs zig; web is --target=web, with --html[=PAGE]
//     overrides    each @const turned on under Constants, as -D NAME=VALUE
//
// A cross build cannot run or test here, so those buttons say why instead
// of failing at exec; the web target runs under node, which `dado` finds.
package dashboard

import tui "vendor:tui"
import "core:strings"

private const i32 N_COMPILERS = 3
private [N_COMPILERS]string8 COMPILERS = ["zig", "clang", "gcc"]

private const i32 N_OPTS = 2
private [N_OPTS]string8 OPTS = ["-O2", "debug"]

private const i32 N_SANITIZERS = 4
private [N_SANITIZERS]string8 SANITIZERS = ["default", "address", "thread", "off"]

private const i32 N_TARGETS = 7
private const i32 WEB = N_TARGETS - 1
private [N_TARGETS]string8 TARGETS = [
    "native",
    "x86_64-linux", "aarch64-linux",
    "x86_64-macos", "aarch64-macos",
    "x86_64-windows",
    "web",
]
// Each cross target as the compiler names it and as zig does.
private [N_TARGETS]string8 DADO_TRIPLES = [
    "",
    "x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
    "x86_64-apple-darwin", "aarch64-apple-darwin",
    "x86_64-pc-windows-gnu",
    "",
]
private [N_TARGETS]string8 ZIG_TRIPLES = [
    "",
    "x86_64-linux-gnu", "aarch64-linux-gnu",
    "x86_64-macos", "aarch64-macos",
    "x86_64-windows-gnu",
    "",
]

private i32 g_cc = 0
private i32 g_opt = 0
private i32 g_san = 0
private i32 g_target = 0
private bool g_page_on
private ref []char8 g_page

private bool cross(): return g_target > 0 && g_target < WEB
private bool web(): return g_target == WEB

// Why `verb` cannot run on the current choices, or "".
private string8 refusal(string8 verb):
    if blank(selected_package()): return "select a package first (Packages, 2)"
    if cross() && (verb == "run" || verb == "test"):
        string8 why = #format("a ", TARGETS[g_target], " program cannot run on this machine: build it, or pick native or web", tui.mem)
        return why
    return ""

// Build the argument list for `dado <verb>` on the selection, with `arg`.
private void command_for(string8 verb):
    args_reset()
    arg(txt(g_dado))
    arg(verb)
    arg(selected_package())
    if web():
        arg("--target=web")
        if g_page_on && (verb == "build" || verb == "run"):
            string8 page = strings.trim(tui.edited(g_page))
            if #len(page) > 0: arg(#format("--html=", page, tui.mem))
            else: arg("--html")
    else if cross():
        pass
    else if g_cc > 0:
        arg("--cc")
        arg(COMPILERS[g_cc])
    if g_opt == 1: arg("--debug")
    if g_san == 1: arg("--sanitize=address")
    else if g_san == 2: arg("--sanitize=thread")
    else if g_san == 3: arg("--no-sanitize")
    add_defines()

private string8 env_name(i32 which):
    if !cross(): return ""
    return "DADO_TARGET" if which == 0 else "ZIG_TARGET"

private string8 env_value(i32 which):
    if !cross(): return ""
    return DADO_TRIPLES[g_target] if which == 0 else ZIG_TRIPLES[g_target]

// The line a person would type for `verb`, for the preview.
private string8 preview(string8 verb):
    if blank(selected_package()): return "select a package under Packages (2)"
    command_for(verb)
    string8 shown = args_shown(false)
    args_reset()
    if cross():
        string8 c = #format(env_name(0), "=", env_value(0), " ", env_name(1), "=", env_value(1), " ", shown, tui.mem)
        return c
    return shown

private const i32 VERB_BUILD = 0
private const i32 VERB_RUN = 1
private const i32 VERB_TEST = 2
private const i32 VERB_CHECK = 3

private void act(i32 v):
    string8 verb = "build"
    i32 kind = RUN_BUILD
    if v == VERB_RUN:
        verb = "run"
        kind = RUN_RUN
    else if v == VERB_TEST:
        verb = "test"
        kind = RUN_TEST
    else if v == VERB_CHECK:
        verb = "check"
        kind = RUN_CHECK
    if g_running:
        tui.toast(#format(txt(g_run_label), " is still running: esc stops it", tui.mem), tui.now().warn)
        return
    string8 why = refusal(verb)
    if #len(why) > 0:
        tui.toast(why, tui.now().warn, 5.0)
        return
    string8 pkg = selected_package()
    command_for(verb)
    _ = start_run(kind, #format(verb, " ", pkg, tui.mem), pkg, env_name(0), env_value(0), env_name(1), env_value(1))
    if g_tab != TAB_BUILD && g_tab != TAB_TOOLCHAIN: g_tab = TAB_BUILD

private void do_build(): act(VERB_BUILD)
private void do_run(): act(VERB_RUN)
private void do_test(): act(VERB_TEST)
private void do_check(): act(VERB_CHECK)

private void build_tab():
    for tui.row(height: 1, gap: 1, tag: "verbs"):
        if tui.button(label: "Build", enabled: !g_running): do_build()
        if tui.button(label: "Run", enabled: !g_running && blank(refusal("run"))): do_run()
        if tui.button(label: "Test", enabled: !g_running && blank(refusal("test"))): do_test()
        if tui.button(label: "Check", enabled: !g_running): do_check()
        if tui.button(label: "Cancel", enabled: g_running): cancel_run()
        tui.align(tui.RIGHT)
        result_badge()
    for tui.row(height: tui.REST, gap: 1, tag: "build-body"):
        if tui.panel(title: "Choices", width: 36, height: tui.REST, pad: 1):
            defer tui.end()
            kv_path("package", selected_or_none())
            if cross(): tui.kv_text("compiler", "zig (cross)")
            else if web(): tui.kv_text("compiler", "clang for wasm32")
            else: _ = tui.select_of("compiler", &g_cc, COMPILERS[:])
            _ = tui.select_of("optimise", &g_opt, OPTS[:])
            _ = tui.select_of("sanitizer", &g_san, SANITIZERS[:])
            _ = tui.select_of("target", &g_target, TARGETS[:])
            if web():
                _ = tui.checkbox("write a page (--html)", &g_page_on)
                if g_page_on:
                    _ = tui.line_edit(label: "page", buf: &g_page, placeholder: "built-in, or your template")
            i32 n = defines_on()
            if n > 0: tui.kv_text("overrides", #format(n, " -D from Constants (5)", tui.mem))
            tui.rule("runs")
            _ = tui.paragraph(s: preview("build"), color: tui.now().info)
            if filled(txt(g_built)):
                tui.space()
                kv_path("last built", txt(g_built))
        for tui.panel(title: "Output", height: tui.REST, pad: 1):
            _ = tui.log(l: &g_out, height: tui.REST, tag: "out", paint: paint)

// The last run's result, or what is running, at the end of the verb row.
private void result_badge():
    if g_running:
        tui.spinner(#format(txt(g_run_label), "  esc stops", tui.mem))
        return
    if g_result == RESULT_OK:
        if g_run_kind == RUN_BUILD: tui.badge(#format("built in ", seconds(g_run_took), tui.mem), tui.now().ok)
        else: tui.badge(#format("ok in ", seconds(g_run_took), tui.mem), tui.now().ok)
    else if g_result == RESULT_FAILED: tui.badge("failed", tui.now().err)
    else if g_result == RESULT_CANCELLED: tui.badge("cancelled", tui.now().warn)
    else if g_result == RESULT_NOT_STARTED: tui.badge("did not start", tui.now().err)
    else: tui.badge_quiet("idle")

// How a line of the toolchain's output reads. The compiler's own text is
// never reworded; this only colours it.
private tui.Color paint(string8 line):
    if strings.starts_with(line, "error"): return tui.now().err
    if strings.starts_with(line, "FAIL"): return tui.now().err
    if strings.starts_with(line, "warning"): return tui.now().warn
    if strings.contains(line, " passed, 0 failed"): return tui.now().ok
    if strings.contains(line, " failed"): return tui.now().err
    if strings.starts_with(line, "built ") || strings.starts_with(line, "ok "): return tui.now().ok
    if strings.starts_with(line, "$ "): return tui.now().info
    if strings.starts_with(line, "  -->") || strings.starts_with(line, "  note:") || strings.starts_with(line, "  help:"): return tui.now().muted
    if strings.starts_with(line, "cancelled"): return tui.now().warn
    return tui.DEFAULT
