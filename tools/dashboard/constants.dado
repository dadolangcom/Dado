// The Constants tab: each `@const` the selected program holds, with the `-D`
// that overrides it.
//
// `dadoc --emit=constants` lists every `@const` of a compilation with its
// folded value and type — and only the `@const`s, because a plain `const` is
// not `-D`-overridable and listing one would offer a switch that does
// nothing. Turning a row on makes it `-D NAME=VALUE` on every run from the
// Build tab, with the value edited here (a checkbox for a `bool`).
//
// It needs a program: `--emit=constants` is a whole-compilation view and a
// compilation has a root, so a library has nothing to show, and the tab
// says so rather than looking broken.
package dashboard

import tui "vendor:tui"
import "core:chars"
import "core:strings"

private const i32 MAX_CONSTS = 64

private tui.Log g_consts
private ref []char8 g_consts_for
private ref []char8 g_consts_error
private i32 g_nconsts

private [MAX_CONSTS]bool c_on
private [MAX_CONSTS]bool c_bool
private [MAX_CONSTS]ref []char8 c_edit

private void constants_answered(string8 about, string8 text, bool ok):
    tui.log_clear(&g_consts)
    g_consts_for = own(g_consts_for, about)
    g_consts_error = own(g_consts_error, "")
    g_nconsts = 0
    string8 rest = text
    for #len(rest) > 0:
        (string8 l, string8 tail, bool more) = strings.line(rest)
        // NAME, package, type, value, ... : a line with a tab in it.
        if filled(field(l, 2)) && filled(field(l, 3)) && g_nconsts < MAX_CONSTS:
            tui.log_say(&g_consts, l)
            g_nconsts = g_nconsts + 1
        if !more: break
        rest = tail
    for i in 0..<MAX_CONSTS: c_on[i] = false
    // Each editor starts at the constant's own value, so turning an override
    // on and changing nothing is a no-op rather than a blank.
    for i in 0..<g_nconsts:
        string8 l = tui.log_at(&g_consts, i)
        string8 kind = field(l, 2)
        string8 val = as_typed(kind, field(l, 3))
        if kind == "bool": c_bool[i] = val == "true"
        else: c_edit[i] = tui.set_text(c_edit[i], val)
    if !ok && g_nconsts == 0 && filled(strings.trim(text)) && !strings.contains(text, "main"):
        constants_failed(about, #format("dadoc could not list the constants: ", strings.trim(text), tui.mem))

private void constants_failed(string8 about, string8 why):
    g_consts_for = own(g_consts_for, about)
    g_consts_error = own(g_consts_error, why)
    g_nconsts = 0

// `--emit=constants` prints a string with its quotes and a character as a
// code point; `-D` takes raw text for both, since the quoting a literal needs
// is the compiler's to add.
private string8 as_typed(string8 kind, string8 raw):
    if #len(raw) >= 2 && raw[0] == '"': return raw[1..<i32(#len(raw)) - 1]
    if strings.starts_with(kind, "char"):
        (i64 cp, bool digits) = number(raw)
        if digits:
            ref []char8 one = #make([]char8, 4, tui.mem)
            if one == nil: return raw
            i32 w = chars.encode(char32(cp), one, 0)
            if w > 0:
                string8 s = one
                return s[0..<w]
    return raw

private bool consts_current(): return txt(g_consts_for) == selected_package()

private i32 defines_on():
    if !consts_current(): return 0
    i32 n = 0
    for i in 0..<g_nconsts:
        if c_on[i]: n = n + 1
    return n

// `-D NAME=VALUE` for each row turned on, as two arguments each.
private void add_defines():
    if !consts_current(): return
    for i in 0..<g_nconsts:
        if !c_on[i]: continue
        arg("-D")
        arg(define_text(i))

private string8 define_text(i32 i):
    string8 l = tui.log_at(&g_consts, i)
    string8 name = field(l, 0)
    if field(l, 2) == "bool":
        string8 b = #format(name, "=", "true" if c_bool[i] else "false", tui.mem)
        return b
    string8 v = #format(name, "=", tui.edited(c_edit[i]), tui.mem)
    return v

private const i32 NCOLS = 5
private [NCOLS]string8 CHEAD = ["constant", "type", "default", "-D", "override"]
private [NCOLS]i32 CWIDE = [20, 8, 14, 4, tui.REST]

private void constants_tab():
    string8 pkg = selected_package()
    if #len(pkg) > 0 && !consts_current() && !querying(Q_CONSTANTS): want_constants(pkg)
    if tui.panel(title: "Constants", height: tui.REST, pad: 1):
        defer tui.end()
        if #len(pkg) == 0:
            _ = tui.paragraph(s: "Select a program under Packages (2); its @const declarations are listed here.", color: tui.now().subtext)
            return
        if !consts_current():
            if where_broken(): _ = tui.paragraph(s: txt(g_where_error), color: tui.now().err)
            else: tui.muted("asking the compiler… (esc cancels)")
            return
        if filled(txt(g_consts_error)):
            _ = tui.paragraph(s: txt(g_consts_error), color: tui.now().err)
            return
        if g_nconsts == 0:
            _ = tui.paragraph(s: "No @const here. --emit=constants needs a program with a main — a library has no root to fold against — and lists only @const, the declarations -D can replace.", color: tui.now().subtext)
            return
        for tui.table(headers: CHEAD[:], widths: CWIDE[:], height: tui.pct(70)):
            for i in 0..<g_nconsts:
                tui.push_id(i)
                const_row(i)
                tui.pop_id()
        tui.rule("on the command line")
        i32 n = defines_on()
        if n == 0: tui.muted("nothing overridden: turn a row's -D on")
        else:
            for i in 0..<g_nconsts:
                if c_on[i]: tui.text(s: #format("-D ", define_text(i), tui.mem), color: tui.now().info)

private void const_row(i32 i):
    string8 l = tui.log_at(&g_consts, i)
    string8 name = field(l, 0)
    string8 kind = field(l, 2)
    string8 val = as_typed(kind, field(l, 3))
    for tui.table_row():
        tui.text(name)
        tui.text(s: kind, color: tui.now().muted)
        tui.text(s: val, color: tui.now().subtext)
        _ = tui.checkbox("", &c_on[i])
        if !c_on[i]: tui.muted("—")
        else if kind == "bool": _ = tui.checkbox("", &c_bool[i])
        else: _ = tui.line_edit(label: "", buf: &c_edit[i])
